-- Definitions, as globals: `define` evaluates a definition's stored
-- syntax (the body has the definition itself as local 0) into its value,
-- tied as `Heff.Elab.Top.entryFor` ties it -- the self is a neutral of
-- the definition's name, described by the body's own evaluation.  `norm`
-- is the differential's probe: a body evaluated with an opaque self and
-- read back.

import compiler.eval as E
import compiler.globals as G
import compiler.params as P
import compiler.readback as R
import compiler.syntax as Sx
import compiler.value as V
import map as M
import prelude

emptyGlobals : E.Globals
emptyGlobals = G.emptyGlobals

typeOf : E.Globals -> Sx.Ty -> V.Ty
typeOf g tyStx = V.nom (E.evalTy g N tyStx LNil)

-- | the definition's value: a neutral of its name whose description is
-- | the body, evaluated with the value itself as local 0 (the knot; the
-- | thunk recomputes it where the original's laziness shares it)
valueOf : E.Globals -> String -> Sx.Ty -> Sx.Tm -> V.V
valueOf g k tyStx bodyStx =
  V.reflect
    (HGlobal k)
    (\u -> SpId)
    (\u -> typeOf g tyStx)
    (Just (E.eval g De bodyStx (LSnoc LNil (\u -> valueOf g k tyStx bodyStx))))

-- | a primitive has no definition to unfold: it is a neutral
primValueOf : E.Globals -> String -> Sx.Ty -> V.V
primValueOf g k tyStx =
  V.reflect (HGlobal k) (\u -> SpId) (\u -> typeOf g tyStx) Nothing

define : E.Globals -> String -> Sx.Ty -> Sx.Tm -> E.Globals
define g k tyStx bodyStx =
  G.addEntry
    k
    { syntax = bodyStx
    , tySyntax = tyStx
    , value = valueOf g k tyStx bodyStx
    , type_ = typeOf g tyStx
    }
    g

definePrim : E.Globals -> String -> Sx.Ty -> E.Globals
definePrim g k tyStx =
  G.addEntry
    k
    { syntax = SPrim k
    , tySyntax = tyStx
    , value = primValueOf g k tyStx
    , type_ = typeOf g tyStx
    }
    g

-- | the body's normal form: evaluated at case D with an opaque self (no
-- | description -- deterministic, nothing unfolds), read back
normEl : E.Globals -> String -> Sx.Ty -> Sx.Tm -> Sx.Tm
normEl g k tyStx bodyStx =
  R.readbEv
    0
    (E.eval
       g
       De
       bodyStx
       (LSnoc
          LNil
          (\u ->
             V.reflect
               (HGlobal k)
               (\u2 -> SpId)
               (\u2 -> typeOf g tyStx)
               Nothing)))

-- | a definition's type, evaluated and read back
normTy : E.Globals -> Sx.Ty -> Sx.Ty
normTy g tyStx = R.readbTy 0 (typeOf g tyStx)

-- >>> normTy emptyGlobals (SFunction Small SPrimInt (AbsConst SPrimInt) False)
-- SFunction Small SPrimInt (AbsConst SPrimInt) False

-- the body of `def two : Int; two = 2` is a literal: opaque statically
-- >>> normEl emptyGlobals "two" SPrimInt (SLitInt 2)
-- SOpaque
