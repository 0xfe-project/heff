-- The compiler, run: a Node.js program (`heff node compiler/main.hf
-- main OUT.mjs`).  Given file paths in dependency order, it reads them,
-- elaborates them with its own reader and elaborator, and either prints
-- every definition's stored core exactly as the reference's `dump-nbe`
-- does -- so the two compilers can be held to the same text, file by
-- file, by `test/self-check.mjs` -- or, as `node NAME OUT.mjs FILE...`,
-- compiles the computation NAME of the last file to a Node.js program,
-- with its own backend.

import co
import compiler.driver as Dr
import compiler.emit as Em
import compiler.toplevel as T
import fs
import prelude
import process
import stdio

eff : HFunctor
eff = stdio <+> process <+> fs

-- the evidence, once per world: an operation then takes it itself
-- (`print out s`, `args sys`), no wrapping call
out : (stdio <: eff)
out = first3 stdio process fs

sys : (process <: eff)
sys = mid3 stdio process fs

disk : (fs <: eff)
disk = last3 stdio process fs

-- the program's own theory of its world: the operations it uses, the
-- evidence paid once (repacking, as modules do)
type Io =
  { print : String -> Co eff Unit
  , printErr : String -> Co eff Unit
  , readFile : String -> Co eff (Maybe String)
  , writeFile : String -> String -> Co eff Bool
  , args : Co eff (List String)
  , exit : Int -> Co eff Unit
  }

io : Io
io =
  { print = print out
  , printErr = printErr out
  , readFile = readFile disk
  , writeFile = writeFile disk
  , args = args sys
  , exit = exit sys
  }

dotsGo : String -> Int -> String -> String
dotsGo p i acc =
  if i >= strLength p then acc
  else if charCode p i == 47 then dotsGo p (i + 1) (acc ++ ".")
  else dotsGo p (i + 1) (acc ++ strSlice p i (i + 1))

dotsOf : String -> String
dotsOf p = dotsGo p 0 ""

dropLib : String -> String
dropLib p = if startsWith "lib/" p then strSlice p 4 (strLength p) else p

dropHf : String -> String
dropHf p = if endsWith ".hf" p then strSlice p 0 (strLength p - 3) else p

-- | `lib/prelude.hf` is the module `prelude`; `compiler/dict.hf` is
-- | `compiler.dict` (the root's paths, as `Heff.Load` names them)
moduleOf : String -> String
moduleOf path = dotsOf (dropLib (dropHf path))

readAll : List String -> Co eff (List Dr.Source)
readAll Nil = pure Nil
readAll (Cons path rest) = do
  mSrc <- io.readFile path
  case mSrc of
    Nothing -> do
      io.printErr ("cannot read " ++ path)
      io.exit 1
      pure Nil
    Just src -> do
      more <- readAll rest
      pure (Cons { module = moduleOf path, source = src } more)

printLines : List String -> Co eff Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  io.print l
  printLines rest

printDefs : Dr.Checked -> List String -> Co eff Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Dr.dumpLines c k)
  printDefs c rest

printErrs : String -> List String -> Int -> Co eff Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  io.printErr (m ++ ": " ++ l)
  printErrs m rest (n + 1)

printAll : List Dr.Checked -> Int -> Co eff Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Dr.moduleKeys c)
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : List String -> Co eff Unit
selfcheck paths = do
  sources <- readAll paths
  bad <- printAll (Dr.checkProgram sources) 0
  if bad == 0 then pure MkUnit else io.exit 1

-- (the errors said, the count comes back)
diagCount : List Dr.Checked -> Co eff Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  m <- diagCount rest
  pure (n + m)

handledNode : List String
handledNode = ["stdio", "fs", "process", "time", "net", "state"]

emitErrs : List String -> Co eff Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  io.printErr ("heff: not compiled: " ++ e)
  emitErrs rest

writeOut : String -> Em.Output -> Co eff Unit
writeOut outPath o = do
  emitErrs o.errors
  if null o.errors
      then do
        ok <- io.writeFile outPath o.source
        if ok then io.print ("wrote " ++ outPath)
          else do
            io.printErr ("cannot write " ++ outPath)
            io.exit 1
    else io.exit 1

compileLast : String -> String -> List Dr.Checked -> Co eff Unit
compileLast name outPath cs = case Dr.lastChecked cs of
  Nothing -> do
    io.printErr "no files given"
    io.exit 1
  Just c -> case Dr.findRunnable handledNode c (Just name) of
    Left why -> do
      io.printErr ("heff: " ++ why)
      io.exit 1
    Right r -> writeOut outPath (Em.compileNode c.top.globals r.key r.effect)

compileChecked : String -> String -> List Dr.Checked -> Co eff Unit
compileChecked name outPath cs = do
  bad <- diagCount cs
  if bad == 0 then compileLast name outPath cs else io.exit 1

-- | compile the computation `name` of the last file given to a Node.js
-- | program, the sources elaborated as `selfcheck` elaborates them
compileCmd : String -> String -> List String -> Co eff Unit
compileCmd name outPath paths = do
  sources <- readAll paths
  compileChecked name outPath (Dr.checkProgram sources)

-- | the compiler's door: `FILE...` checks and dumps (the differential);
-- | `node NAME OUT.mjs FILE...` compiles
main : Co eff Unit
main = do
  as <- io.args
  case as of
    Cons "node" (Cons name (Cons outPath paths)) ->
      compileCmd name outPath paths
    _ -> selfcheck as
