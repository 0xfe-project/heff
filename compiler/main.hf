-- The compiler, run: a Node.js program (`heff node compiler/main.hf
-- main OUT.mjs`).  Given file paths in dependency order, it reads them,
-- elaborates them with its own reader and elaborator, and prints every
-- definition's stored core exactly as the reference's `dump-nbe` does
-- -- so the two compilers can be held to the same text, file by file,
-- by `test/self-check.mjs`.  As `node NAME OUT.mjs FILE`, it loads
-- FILE's import closure itself and compiles the computation NAME to a
-- Node.js program, with its own backend.

import co
import compiler.driver as Dr
import compiler.effect as Ef
import compiler.emit as Em
import compiler.load as L
import compiler.toplevel as T
import fs
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process <+> fs

-- the evidence, once per world: an operation then takes it itself
-- (`print out s`, `args sys`), no wrapping call
out : (stdio <: world)
out = \p -> InL (InL p)

sys : (process <: world)
sys = \p -> InL (InR p)

disk : (fs <: world)
disk = \p -> InR p

-- the program's own theory of its world: the operations it uses, the
-- evidence paid once (repacking, as modules do)
type HeffM =
  { print : String -> Co world Unit
  , printErr : String -> Co world Unit
  , readFile : String -> Co world (Maybe String)
  , writeFile : String -> String -> Co world Bool
  , args : Co world (List String)
  , exit : Int -> Co world Unit
  }

heffM : HeffM
heffM =
  { print = print out
  , printErr = printErr out
  , readFile = readFile disk
  , writeFile = writeFile disk
  , args = args sys
  , exit = exit sys
  }

readAll : List String -> Co world (List Dr.Source)
readAll Nil = pure Nil
readAll (Cons path rest) = do
  mSrc <- heffM.readFile path
  case mSrc of
    Nothing -> do
      heffM.printErr ("cannot read " ++ path)
      heffM.exit 1
      pure Nil
    Just src -> do
      more <- readAll rest
      pure (Cons { module = L.moduleOf path, source = src } more)

printLines : List String -> Co world Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  heffM.print l
  printLines rest

printDefs : Dr.Checked -> List String -> Co world Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Dr.dumpLines c k)
  printDefs c rest

printErrs : String -> List String -> Int -> Co world Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  heffM.printErr (m ++ ": " ++ l)
  printErrs m rest (n + 1)

printAll : List Dr.Checked -> Int -> Co world Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Dr.moduleKeys c)
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : List String -> Co world Unit
selfcheck paths = do
  sources <- readAll paths
  bad <- printAll (Dr.checkProgram sources) 0
  if bad == 0 then pure MkUnit else heffM.exit 1

-- (the errors said, the count comes back)
diagCount : List Dr.Checked -> Co world Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  m <- diagCount rest
  pure (n + m)

elemStrM : String -> List String -> Bool
elemStrM x Nil = False
elemStrM x (Cons y rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen Nil = Nil
nubStrGo seen (Cons x rest) =
  if elemStrM x seen then nubStrGo seen rest
  else Cons x (nubStrGo (Cons x seen) rest)

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- the provider of a module, M.provider.js beside M.hf: read as the
-- module itself is found (under the root, else lib/, else
-- node_modules/)
providerPathOf : String -> String
providerPathOf m = L.dropHf (L.importPath m) ++ ".provider.js"

readProviderAt : String -> Co world (Maybe Em.Provider)
readProviderAt m = do
  a <- heffM.readFile (providerPathOf m)
  case a of
    Just t -> pure (Just { module = m, text = t })
    Nothing -> do
      b <- heffM.readFile ("lib/" ++ providerPathOf m)
      case b of
        Just t -> pure (Just { module = m, text = t })
        Nothing -> do
          mc <- heffM.readFile ("node_modules/" ++ providerPathOf m)
          case mc of
            Just t -> pure (Just { module = m, text = t })
            Nothing -> pure Nothing

readProviders : List String -> Co world (List Em.Provider)
readProviders Nil = pure Nil
readProviders (Cons m rest) = do
  p <- readProviderAt m
  ps <- readProviders rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere; `heff node`'s is "node")
forHost : String -> Em.Provider -> Bool
forHost host p = case Em.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

providesLeaf : List Em.Provider -> String -> Bool
providesLeaf Nil k = False
providesLeaf (Cons p rest) k =
  if strEq p.module (Ef.moduleOfKey k)
  && elemStrM (Ef.nameOfKey k) (Em.exportedNames p.text)
    then True
  else providesLeaf rest k

emitErrs : List String -> Co world Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  heffM.printErr ("heff: not compiled: " ++ e)
  emitErrs rest

writeOut : String -> Em.Output -> Co world Unit
writeOut outPath o = do
  emitErrs o.errors
  if null o.errors
      then do
        ok <- heffM.writeFile outPath o.source
        if ok then heffM.print ("wrote " ++ outPath)
          else do
            heffM.printErr ("cannot write " ++ outPath)
            heffM.exit 1
    else heffM.exit 1

compileFound : String
             -> String
             -> Dr.Checked
             -> List Em.Provider
             -> Co world Unit
compileFound name outPath c available = case Dr.findRunnable
    (filter (\k -> providesLeaf available k) (Dr.candidateLeaves c))
    c
    (Just name) of
  Left why -> do
    heffM.printErr ("heff: " ++ why)
    heffM.exit 1
  Right r ->
    writeOut outPath (Em.compileProgram available c.top.globals r.key r.effect)

compileLast : String -> String -> List Dr.Checked -> Co world Unit
compileLast name outPath cs = case Dr.lastChecked cs of
  Nothing -> do
    heffM.printErr "no files given"
    heffM.exit 1
  Just c -> do
    found <-
      readProviders
        (nubStrM (map (\k -> Ef.moduleOfKey k) (Dr.candidateLeaves c)))
    compileFound name outPath c (filter (\p -> forHost "node" p) found)

compileChecked : String -> String -> List Dr.Checked -> Co world Unit
compileChecked name outPath cs = do
  bad <- diagCount cs
  if bad == 0 then compileLast name outPath cs else heffM.exit 1

-- | compile the computation `name` of FILE to a Node.js program:
-- | FILE's import closure loaded with the compiler's own loader
compileCmd : String -> String -> String -> Co world Unit
compileCmd name outPath file = do
  l <- L.loadProgram disk file
  bad <- printErrs "heff" l.errors 0
  if bad == 0 then compileChecked name outPath (Dr.checkProgram l.sources)
    else heffM.exit 1

printWatchVals : List Dr.WatchInfo -> Co world Unit
printWatchVals Nil = pure MkUnit
printWatchVals (Cons w rest) = do
  heffM.print (">>> " ++ w.expr ++ "\n" ++ w.value)
  printWatchVals rest

runLast : Int -> Maybe Dr.Checked -> Co world Unit
runLast bad Nothing = heffM.exit 1
runLast bad (Just c) = do
  printWatchVals (Dr.watches c)
  if bad == 0 then pure MkUnit else heffM.exit 1

runChecked : Int -> List Dr.Checked -> Co world Unit
runChecked badL cs = do
  bad <- diagCount cs
  runLast (badL + bad) (Dr.lastChecked cs)

-- | print what each watch (`-- >>> e`) of FILE evaluates to
runCmd : String -> Co world Unit
runCmd file = do
  l <- L.loadProgram disk file
  badL <- printErrs "heff" l.errors 0
  runChecked badL (Dr.checkProgram l.sources)

type TestRes = { total : Int, failed : Int, ok : Bool }

failLine : String -> Dr.TestReport -> String
failLine f r =
  "FAIL "
  ++ f
  ++ (case r.owner of
      Just n -> " (" ++ n ++ ")"
      Nothing -> "")
  ++ ": "
  ++ r.watch.expr
  ++ "\n  expected "
  ++ fromMaybe "" r.watch.expected
  ++ "\n  but got  "
  ++ r.watch.value

printFails : String -> List Dr.TestReport -> Co world Unit
printFails f Nil = pure MkUnit
printFails f (Cons r rest) = do
  heffM.print (failLine f r)
  printFails f rest

badReports : List Dr.TestReport -> List Dr.TestReport
badReports rs = filter (\(r : Dr.TestReport) -> not r.watch.holds) rs

testReport : String -> Int -> List Dr.TestReport -> Co world TestRes
testReport f bad ts = do
  printFails f (badReports ts)
  heffM.print
      ((if null (badReports ts) && bad == 0 then "ok    " else "FAIL  ")
       ++ f
       ++ "  "
       ++ showInt (length ts - length (badReports ts))
       ++ "/"
       ++ showInt (length ts))
  pure { total = length ts, failed = length (badReports ts), ok = bad == 0 }

testOneC : String -> Int -> List Dr.Checked -> Co world TestRes
testOneC f bad0 cs = do
  bad <- diagCount cs
  case Dr.lastChecked cs of
    Nothing -> do
      heffM.print ("FAIL  " ++ f ++ "  0/0")
      pure { total = 0, failed = 0, ok = False }
    Just c -> testReport f (bad0 + bad) (Dr.testFile c)

testOneF : String -> Co world TestRes
testOneF f = do
  l <- L.loadProgram disk f
  badL <- printErrs "heff" l.errors 0
  testOneC f badL (Dr.checkProgram l.sources)

-- | check the watches' expectations of every file given
testCmd : List String -> Int -> Int -> Bool -> Co world Unit
testCmd Nil total failed anyBad = do
  heffM.print
      (showInt (total - failed) ++ "/" ++ showInt total ++ " expectations hold")
  if failed > 0 || anyBad then heffM.exit 1 else pure MkUnit
testCmd (Cons f rest) total failed anyBad = do
  r <- testOneF f
  testCmd rest (total + r.total) (failed + r.failed) (anyBad || not r.ok)

-- | the compiler's door: `FILE...` checks and dumps (the differential);
-- | `node NAME OUT.mjs FILE` compiles, `run FILE` prints the watches'
-- | values, `test FILE...` checks their expectations
main : Co world Unit
main = do
  as <- heffM.args
  case as of
    Cons "node" (Cons name (Cons outPath (Cons file Nil))) ->
      compileCmd name outPath file
    Cons "run" (Cons file Nil) -> runCmd file
    Cons "test" files -> testCmd files 0 0 False
    _ -> selfcheck as
