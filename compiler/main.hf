-- The compiler, run: a Node.js program (`heff node compiler/main.hf
-- main OUT.mjs`), the one `bin/heff.mjs` runs for the commands of
-- `usage` it has (the rest are the reference's still).  `dump-core
-- FILE...` reads the files given in dependency order, elaborates them
-- with its own reader and elaborator, and prints every definition's
-- stored core exactly as the reference's `dump-nbe` does -- so the two
-- compilers can be held to the same text, file by file, by
-- `test/self-check.mjs`.

import co
import compiler.cache as Ca
import compiler.diagnostic as Dg
import compiler.driver as Dr
import compiler.effect as Ef
import compiler.emit as Em
import compiler.format as Fm
import compiler.load as L
import compiler.report as Rp
import compiler.toplevel as T
import fs
import map as Mp
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process <+> fs <+> Rp.report

-- the program asks for its worlds' evidence: every computation of it is
-- a `Heff`, whose operations find the evidence in scope -- given once,
-- by `main`, below
type Heff a =
  {{io : stdio <: world}}
  -> {{sys : process <: world}}
  -> {{disk : fs <: world}}
  -> {{rep : Rp.report <: world}}
  -> Co world a

-- | where the standard library is: `HEFF_LIB` (the host sets it, beside
-- | itself), else the working directory's `lib/`
libDir : Heff String
libDir = do
  v <- getEnv "HEFF_LIB"
  pure (fromMaybe "lib" v)

-- | FILE and its import closure, loaded from FILE's project
load : String -> Heff L.Loaded
load file = do
  lib <- libDir
  L.loadProgram lib file

readAll : List String -> Heff (List Dr.Source)
readAll Nil = pure Nil
readAll (Cons path rest) = do
  mSrc <- readFile path
  case mSrc of
    Nothing -> do
      printErr ("cannot read " ++ path)
      exit 1
      pure Nil
    Just src -> do
      more <- readAll rest
      pure
          (Cons
             { module = L.moduleOf L.here path, path = path, source = src }
             more)

printLines : List String -> Heff Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  print l
  printLines rest

printDefs : Dr.Checked -> List String -> Heff Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Dr.dumpLines c k)
  printDefs c rest

printErrs : String -> List String -> Int -> Heff Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  printErr (m ++ ": " ++ l)
  printErrs m rest (n + 1)

printAll : List Dr.Checked -> Int -> Heff Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Dr.moduleKeys c)
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : List String -> Heff Unit
selfcheck paths = do
  sources <- readAll paths
  bad <- printAll (Dr.checkProgram sources) 0
  if bad == 0 then pure MkUnit else exit 1

-- (the errors said, the count comes back)
diagCount : List Dr.Checked -> Heff Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  m <- diagCount rest
  pure (n + m)

elemStrM : String -> List String -> Bool
elemStrM x Nil = False
elemStrM x (Cons y rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen Nil = Nil
nubStrGo seen (Cons x rest) =
  if elemStrM x seen then nubStrGo seen rest
  else Cons x (nubStrGo (Cons x seen) rest)

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- the provider of a module, M.provider.js beside M.hf: read as the
-- module itself is found (under the root, else the library, else the
-- root's node_modules/)
providerPathOf : String -> String
providerPathOf m = L.dropHf (L.importPath m) ++ ".provider.js"

readProviderAt : L.Paths -> String -> Heff (Maybe Em.Provider)
readProviderAt ps m = do
  found <-
    L.readFound
      [ L.under ps.root (providerPathOf m)
      , L.under ps.lib (providerPathOf m)
      , L.under ps.root ("node_modules/" ++ providerPathOf m)
      ]
  pure (case found of
    Just f -> Just { module = m, text = f.source }
    Nothing -> Nothing)

readProviders : L.Paths -> List String -> Heff (List Em.Provider)
readProviders paths Nil = pure Nil
readProviders paths (Cons m rest) = do
  p <- readProviderAt paths m
  ps <- readProviders paths rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere; `heff node`'s is "node")
forHost : String -> Em.Provider -> Bool
forHost host p = case Em.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

providesLeaf : List Em.Provider -> String -> Bool
providesLeaf Nil k = False
providesLeaf (Cons p rest) k =
  if strEq p.module (Ef.moduleOfKey k)
  && elemStrM (Ef.nameOfKey k) (Em.exportedNames p.text)
    then True
  else providesLeaf rest k

emitErrs : List String -> Heff Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  printErr ("heff: not compiled: " ++ e)
  emitErrs rest

-- The cache: a module whose making is unchanged is thawed from
-- `.heff/<module>.hc` instead of elaborated again; a fresh module that
-- elaborated clean is frozen back (`compiler.cache`).  The file asked
-- for -- the last source -- is always elaborated: its watches and
-- spans are wanted.
type CacheAcc = { done : List Dr.Checked, hashes : Mp.Map String String }

cacheDir : String -> String
cacheDir root = L.under root ".heff"

cachePath : String -> String -> String
cachePath root m = cacheDir root ++ "/" ++ m ++ ".hc"

thawTry : String -> Dr.Source -> CacheAcc -> Heff (Maybe Dr.Thawed)
thawTry root s acc = do
  mtxt <- readFile (cachePath root s.module)
  pure (case mtxt of
    Just txt -> Ca.melt acc.hashes acc.done s txt
    Nothing -> Nothing)

cacheKeep : CacheAcc -> Dr.Checked -> CacheAcc
cacheKeep acc c =
  { done = concatList acc.done (Cons c Nil)
  , hashes = Ca.defHashesInto acc.hashes c
  }

cacheStep : CacheAcc -> Dr.Source -> Maybe Dr.Thawed -> CacheAcc
cacheStep acc s th = cacheKeep acc (Dr.elabNext acc.done s th)

cachedGo : String -> List Dr.Source -> CacheAcc -> Heff CacheAcc
cachedGo root Nil acc = pure acc
cachedGo root (Cons s Nil) acc = pure (cacheStep acc s Nothing)
cachedGo root (Cons s rest) acc = do
  th <- thawTry root s acc
  cachedGo root rest (cacheStep acc s th)

freezeOne : String -> CacheAcc -> Pair Dr.Source Dr.Checked -> Heff Unit
freezeOne root acc (MkPair s c) =
  if c.cached || not (null c.diags) then pure MkUnit
  else case Ca.freeze acc.hashes acc.done s c of
    Just out -> do
      ok <- writeFile (cachePath root c.module) out
      pure MkUnit
    Nothing -> pure MkUnit

freezeAll : String -> CacheAcc -> List (Pair Dr.Source Dr.Checked) -> Heff Unit
freezeAll root acc Nil = pure MkUnit
freezeAll root acc (Cons p rest) = do
  freezeOne root acc p
  freezeAll root acc rest

zipSC : List Dr.Source -> List Dr.Checked -> List (Pair Dr.Source Dr.Checked)
zipSC (Cons s ss) (Cons c cs) = Cons (MkPair s c) (zipSC ss cs)
zipSC _ _ = Nil

-- | the program, each module elaborated or thawed, the fresh clean
-- | ones frozen back
cachedProgram : L.Loaded -> Heff (List Dr.Checked)
cachedProgram l = do
  acc <- cachedGo l.paths.root l.sources { done = Nil, hashes = Mp.empty }
  ok <- mkDir (cacheDir l.paths.root)
  freezeAll l.paths.root acc (zipSC l.sources acc.done)
  pure acc.done

putFileDiags : List Dr.Checked -> Heff Unit
putFileDiags Nil = pure MkUnit
putFileDiags (Cons c rest) = do
  if null c.diags then pure MkUnit
    else writeErr (Dg.renderFileDiags c.path c.source c.diags)
  putFileDiags rest

anyErrors : List Dr.Checked -> Bool
anyErrors cs = any (\(c : Dr.Checked) -> not (null (Dr.errorsIn c))) cs

writeOut : String -> String -> Em.Output -> Heff Unit
writeOut outPath how o = do
  emitErrs o.errors
  if null o.errors
      then do
        ok <- writeFile outPath o.source
        if ok then print ("wrote " ++ outPath ++ ": " ++ how)
          else do
            printErr ("cannot write " ++ outPath)
            exit 1
    else exit 1

compileFound : String
             -> Maybe String
             -> String
             -> String
             -> Dr.Checked
             -> List Em.Provider
             -> Heff Unit
compileFound file name outPath how c available = case Dr.findRunnable
    (filter (\k -> providesLeaf available k) (Dr.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ++ file ++ ": " ++ why)
    exit 1
  Right r ->
    writeOut
      outPath
      how
      (Em.compileProgram available c.top.globals r.key r.effect)

-- (a computation whose effects all have providers for this host: each
-- world's algebra is bundled in from its module's M.provider.js)
compileLast : L.Paths
            -> String
            -> String
            -> Maybe String
            -> String
            -> String
            -> List Dr.Checked
            -> Heff Unit
compileLast paths host file name outPath how cs = case Dr.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProviders
        paths
        (nubStrM (map (\k -> Ef.moduleOfKey k) (Dr.candidateLeaves c)))
    compileFound file name outPath how c (filter (\p -> forHost host p) found)

compileDiags : L.Paths
             -> String
             -> String
             -> Maybe String
             -> String
             -> String
             -> Bool
             -> List Dr.Checked
             -> Heff Unit
compileDiags paths host file name outPath how badL cs = do
  putFileDiags cs
  if badL then exit 1 else compileLast paths host file name outPath how cs

-- | compile the computation `name` of FILE to a program of `host`:
-- | FILE's import closure loaded with the compiler's own loader
compileCmd : String -> Maybe String -> String -> String -> String -> Heff Unit
compileCmd host name outPath how file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  compileDiags l.paths host file name outPath how (badL > 0) cs

nodeCmd : Maybe String -> String -> String -> Heff Unit
nodeCmd name outPath file =
  compileCmd
    "node"
    name
    outPath
    ("run it with `node " ++ outPath ++ " ARGS...`")
    file

appCmd : Maybe String -> String -> String -> Heff Unit
appCmd name outPath file =
  compileCmd
    "page"
    name
    outPath
    "load it in a page with <script src=\"...\"> (it imports nothing: it opens from file:// too)"
    file

ownExport : Dr.Own -> Em.Export
ownExport o = Em.mkExport o.name o.key

compileJsOut : String -> Bool -> Em.Output -> Heff Unit
compileJsOut outPath bad o = do
  ok <- writeFile outPath o.source
  emitErrs o.errors
  if ok && not bad && null o.errors then pure MkUnit else exit 1

compileJsDiags : String -> String -> Bool -> List Dr.Checked -> Heff Unit
compileJsDiags file outPath badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      compileJsOut
        outPath
        (badL || anyErrors cs)
        (Em.compileJs c.top.globals (map (\o -> ownExport o) c.own))

-- | an ES module of FILE and what it imports
compileJsCmd : String -> String -> Heff Unit
compileJsCmd file outPath = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  compileJsDiags file outPath (badL > 0) cs

printEvals : List Dr.Evaluated -> Heff Unit
printEvals Nil = pure MkUnit
printEvals (Cons d rest) = do
  print (d.name ++ " = " ++ d.value)
  printEvals rest

evalDiags : Bool -> List Dr.Checked -> Heff Unit
evalDiags badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      printEvals (Dr.evaluate c)
      if badL || anyErrors cs then exit 1 else pure MkUnit

-- | print what each definition of FILE evaluates to
evalCmd : String -> Heff Unit
evalCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  evalDiags (badL > 0) cs

promoteDiags : String -> Bool -> List Dr.Checked -> Heff Unit
promoteDiags file badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      if badL || anyErrors cs then exit 1
      else do
        ok <- writeFile file (Dr.promote c)
        if ok then pure MkUnit else exit 1

-- | write each watch's value under it as its expectation
promoteCmd : String -> Heff Unit
promoteCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  promoteDiags file (badL > 0) cs

printWatchVals : List Dr.WatchInfo -> Heff Unit
printWatchVals Nil = pure MkUnit
printWatchVals (Cons w rest) = do
  print (">>> " ++ w.expr ++ "\n" ++ w.value)
  printWatchVals rest

runLast : Int -> Maybe Dr.Checked -> Heff Unit
runLast bad Nothing = exit 1
runLast bad (Just c) = do
  printWatchVals (Dr.watches c)
  if bad == 0 then pure MkUnit else exit 1

runChecked : Int -> List Dr.Checked -> Heff Unit
runChecked badL cs = do
  bad <- diagCount cs
  runLast (badL + bad) (Dr.lastChecked cs)

-- | print what each watch (`-- >>> e`) of FILE evaluates to
runCmd : String -> Heff Unit
runCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  runChecked badL cs

type TestRes = { total : Int, failed : Int, ok : Bool }

failLine : String -> Dr.TestReport -> Rp.Mismatch -> String
failLine f r m =
  "FAIL "
  ++ f
  ++ (case r.owner of
      Just n -> " (" ++ n ++ ")"
      Nothing -> "")
  ++ ": "
  ++ r.watch.expr
  ++ "\n  expected "
  ++ m.expected
  ++ "\n  but got  "
  ++ m.got
  ++ "\n  diff     "
  ++ m.diff

-- (each expectation that does not hold, and what differs, in colour on
-- a terminal)
printFails : String -> Bool -> List Dr.TestReport -> Heff Unit
printFails f color Nil = pure MkUnit
printFails f color (Cons r rest) = do
  m <- Rp.mismatch color (fromMaybe "" r.watch.expected) r.watch.value
  print (failLine f r m)
  printFails f color rest

badReports : List Dr.TestReport -> List Dr.TestReport
badReports rs = filter (\(r : Dr.TestReport) -> not r.watch.holds) rs

testReport : String -> Int -> List Dr.TestReport -> Heff TestRes
testReport f bad ts = do
  color <- Rp.useColor
  printFails f color (badReports ts)
  print
      ((if null (badReports ts) && bad == 0 then "ok    " else "FAIL  ")
       ++ f
       ++ "  "
       ++ showInt (length ts - length (badReports ts))
       ++ "/"
       ++ showInt (length ts))
  pure { total = length ts, failed = length (badReports ts), ok = bad == 0 }

testOneC : String -> Int -> List Dr.Checked -> Heff TestRes
testOneC f bad0 cs = do
  bad <- diagCount cs
  case Dr.lastChecked cs of
    Nothing -> do
      print ("FAIL  " ++ f ++ "  0/0")
      pure { total = 0, failed = 0, ok = False }
    Just c -> testReport f (bad0 + bad) (Dr.testFile c)

testOneF : String -> Heff TestRes
testOneF f = do
  l <- load f
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  testOneC f badL cs

-- | check the watches' expectations of every file given
testCmd : List String -> Int -> Int -> Bool -> Heff Unit
testCmd Nil total failed anyBad = do
  print
      (showInt (total - failed) ++ "/" ++ showInt total ++ " expectations hold")
  if failed > 0 || anyBad then exit 1 else pure MkUnit
testCmd (Cons f rest) total failed anyBad = do
  r <- testOneF f
  testCmd rest (total + r.total) (failed + r.failed) (anyBad || not r.ok)

checkLast : Bool -> List Dr.Checked -> Heff Unit
checkLast badLoad cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      write (Dr.interface c)
      if badLoad || anyErrors cs then exit 1 else pure MkUnit

-- | elaborate FILE and what it imports; print its interface
checkCmd : String -> Heff Unit
checkCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- cachedProgram l
  checkLast (badL > 0) cs

-- | a flag of a command, and what it does
type Flag = { flag : String, doc : String }

-- | a command: how it is called, what it does, and what its words
-- | complete to (`files`: the files' suffix; `flags`)
type Command =
  { name : String
  , args : String
  , doc : String
  , files : String
  , flags : List Flag
  }

cmd : String -> String -> String -> String -> Command
cmd name a doc files =
  { name = name, args = a, doc = doc, files = files, flags = Nil }

commands : List Command
commands =
  [ cmd
    "check"
    "FILE"
    "elaborate FILE and what it imports; print its interface"
    ".hf"
  , cmd "eval" "FILE" "print what each definition of FILE evaluates to" ".hf"
  , cmd
    "run"
    "FILE"
    "print what each watch (`-- >>> e`) of FILE evaluates to"
    ".hf"
  , cmd
    "test"
    "FILE..."
    "check the watches' expectations (the `-- ...` lines under them)"
    ".hf"
  , cmd
    "promote"
    "FILE"
    "write each watch's value under it as its expectation"
    ".hf"
  , cmd
    "compile-js"
    "FILE OUT.js"
    "an ES module of FILE and what it imports"
    ".hf"
  , cmd
    "app"
    "FILE [NAME] OUT.js"
    "a script running the app NAME (lib/dom.hf) in a page"
    ".hf"
  , cmd
    "node"
    "FILE [NAME] OUT.mjs"
    "a Node.js program running NAME, its worlds' providers bundled in"
    ".hf"
  , cmd "explain" "FILE" "the elaboration trace" ".hf"
  , cmd
    "dump-nbe"
    "FILE"
    "each definition over compiler/'s formers, with its normal forms (the port's differential)"
    ".hf"
  , cmd
    "type-at"
    "FILE OFFSET"
    "what the name at OFFSET resolved to, and its type"
    ".hf"
  , { name = "fmt"
    , args = "[--check] FILE..."
    , doc = "format FILEs in place (--check: only say which are not formatted)"
    , files = ".hf"
    , flags = [{ flag = "check", doc = "only say which are not formatted" }]
    }
  , cmd "lsp" "" "a language server, on stdin/stdout" ""
  , cmd "completions" "fish" "a completion script for the shell" ""
  ]

spaces : Int -> String
spaces n = joinWith "" (replicate n " ")

commandHead : Command -> String
commandHead c = c.name ++ (if strEq c.args "" then "" else " " ++ c.args)

-- (the head, padded to 24 columns -- a space at least -- and its doc)
usageLine : Command -> String
usageLine c =
  "  "
  ++ commandHead c
  ++ spaces (max 1 (24 - strLength (commandHead c)))
  ++ c.doc

usage : String
usage =
  joinWith
    "\n"
    (Cons "usage: heff COMMAND FILE ..." (Cons "" (map usageLine commands)))

-- (a fish string: quoted, its quotes escaped)
fishQuote : String -> String
fishQuote x = "'" ++ joinWith "\\'" (split "'" x) ++ "'"

seenFrom : String -> String
seenFrom name =
  "complete -c heff -n '__fish_seen_subcommand_from " ++ name ++ "'"

fishLines : Command -> List String
fishLines c =
  concatList
    (Cons
       ("complete -c heff -n __fish_use_subcommand -a "
        ++ c.name
        ++ " -d "
        ++ fishQuote c.doc)
       (if strEq c.files "" then Nil
        else [ seenFrom c.name
             ++ " -a '(__fish_complete_suffix "
             ++ c.files
             ++ ")'"
             ]))
    (concatList
       (map
          (\(f : Flag) ->
             seenFrom c.name ++ " -l " ++ f.flag ++ " -d " ++ fishQuote f.doc)
          c.flags)
       (if strEq c.name "completions"
          then [seenFrom "completions" ++ " -a fish"]
        else Nil))

-- | fish's completions of heff: `heff completions fish > ~/.config/fish/completions/heff.fish`
fishCompletions : String
fishCompletions =
  joinWith
    "\n"
    (concatList
       [ "# heff: written by `heff completions fish`"
       , "complete -c heff -e"
       , "complete -c heff -f"
       ]
       (concatMap fishLines commands))
  ++ "\n"

-- | 1 if the file is not formatted (with `--check`) or cannot be
fmtOne : Bool -> String -> Heff Int
fmtOne checkOnly f = do
  mSrc <- readFile f
  case mSrc of
    Nothing -> do
      printErr ("heff: cannot read " ++ f)
      pure 1
    Just src -> case Fm.format src of
      Left why -> do
        printErr ("heff: " ++ f ++ " not formatted: " ++ why)
        pure 1
      Right out ->
        if strEq out src then pure 0
        else if checkOnly
          then do
            print f
            pure 1
        else do
          ok <- writeFile f out
          pure 0

fmtAll : Bool -> List String -> Int -> Heff Int
fmtAll checkOnly Nil bad = pure bad
fmtAll checkOnly (Cons f rest) bad = do
  n <- fmtOne checkOnly f
  fmtAll checkOnly rest (bad + n)

-- | format FILEs in place; `--check`: only say which are not formatted
fmtCmd : List String -> Heff Unit
fmtCmd as = do
  bad <- case as of
    Cons "--check" files -> fmtAll True files 0
    _ -> fmtAll False as 0
  if bad > 0 then exit 1 else pure MkUnit

-- | the compiler's door: the commands of `usage`, and `dump-core
-- | FILE...`, which checks the files given (in dependency order) and
-- | prints their stored core -- the differential `test/self-check.mjs`
-- | holds to the reference's `dump-nbe`
program : Heff Unit
program = do
  as <- args
  case as of
    Cons "node" (Cons file (Cons name (Cons outPath Nil))) ->
      nodeCmd (Just name) outPath file
    Cons "node" (Cons file (Cons outPath Nil)) -> nodeCmd Nothing outPath file
    Cons "app" (Cons file (Cons name (Cons outPath Nil))) ->
      appCmd (Just name) outPath file
    Cons "app" (Cons file (Cons outPath Nil)) -> appCmd Nothing outPath file
    Cons "compile-js" (Cons file (Cons outPath Nil)) ->
      compileJsCmd file outPath
    Cons "check" (Cons file Nil) -> checkCmd file
    Cons "run" (Cons file Nil) -> runCmd file
    Cons "eval" (Cons file Nil) -> evalCmd file
    Cons "promote" (Cons file Nil) -> promoteCmd file
    Cons "test" (Cons f files) -> testCmd (Cons f files) 0 0 False
    Cons "fmt" (Cons f files) -> fmtCmd (Cons f files)
    Cons "completions" (Cons "fish" Nil) -> write fishCompletions
    Cons "dump-core" files -> selfcheck files
    Nil -> print usage
    Cons "help" Nil -> print usage
    -- (on stderr: what reads the output, a shell's completion, say, does
    -- not take it for an answer)
    _ -> do
      printErr usage
      exit 1

-- | where the world is: each sub-effect's evidence, given
main : Co world Unit
main =
  program
    (io := \p -> InL (InL (InL p)))
    (sys := \p -> InL (InL (InR p)))
    (disk := \p -> InL (InR p))
    (rep := \p -> InR p)
