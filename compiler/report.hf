-- A test's report, where it meets the terminal: what differs between an
-- expectation and a value (jsdiff's word difference, as the reference's
-- `Heff.Support.Diff` has it), and whether colour may be used.  An
-- effect, so that its side is JavaScript: compiler/report.provider.js.

import co
import prelude

data ReportF (m : Type -> Type) x
  = Differ Bool String String (String -> String -> String -> x)
  | UseColor (Bool -> x)

-- | A test's report, at the terminal, as an effect.
report : HFunctor
report =
  { f = ReportF
  , hfmap = \fm g p -> case p of
      Differ c e v k -> Differ c e v (\a b d -> g (k a b d))
      UseColor k -> UseColor (\b -> g (k b))
  , hmap = \nt p -> case p of
      Differ c e v k -> Differ c e v k
      UseColor k -> UseColor k
  }

-- | the expectation and the value, cut to where they differ, and the
-- | difference, `[-expected-]` and `{+got+}`
type Mismatch = { expected : String, got : String, diff : String }

mkMismatch : String -> String -> String -> Mismatch
mkMismatch e g d = { expected = e, got = g, diff = d }

-- | what differs between `expected` and `got` (in colour, if `color`)
mismatch : {e : HFunctor}
         -> {{ev : report <: e}}
         -> Bool
         -> String
         -> String
         -> Co e Mismatch
mismatch color expected got =
  op (ev (Differ color expected got (\a b d -> mkMismatch a b d))) val

-- | the standard output is a terminal, and `NO_COLOR` is not set
useColor : {e : HFunctor} -> {{ev : report <: e}} -> Co e Bool
useColor = op (ev (UseColor (\b -> b))) val
