-- The effect of a computation (`Co h a`, lib/co.hf) as a runtime sees
-- it: a port of `Heff.Effect`, and of the driver's reading of it.
-- Effects summed (`<+>`), and the library's that the runtimes have a
-- handler for.

import compiler.globals as G
import compiler.syntax as Sx
import prelude

data Effect = Leaf String | Plus Effect Effect

appendE : {a : Type} -> List a -> List a -> List a
appendE Nil ys = ys
appendE (Cons x xs) ys = Cons x (appendE xs ys)

leaves : Effect -> List String
leaves (Leaf x) = Cons x Nil
leaves (Plus a b) = appendE (leaves a) (leaves b)

plusM : Maybe Effect -> Maybe Effect -> Maybe Effect
plusM (Just a) (Just b) = Just (Plus a b)
plusM _ _ = Nothing

-- (the library's effects, by their globals' keys)
leafOf : String -> Maybe Effect
leafOf k =
  if strEq k "dom.dom"
    then Just (Leaf "dom")
    else if strEq k "stdio.stdio"
    then Just (Leaf "stdio")
    else if strEq k "fs.fs"
    then Just (Leaf "fs")
    else if strEq k "process.process"
    then Just (Leaf "process")
    else if strEq k "time.time"
    then Just (Leaf "time")
    else if strEq k "net.net"
    then Just (Leaf "net")
    else Nothing

-- | `h`, an effect: a sum, a leaf -- by what it is, a global's key, not
-- | its name -- or a definition that is one of those
effectOf : G.Globals -> Sx.Tm -> Maybe Effect
effectOf g e = case e of
  SIs e' -> effectOf g e'
  SApp (SApp (SGlobal p) a) b ->
    if strEq p "co.plus" || strEq p "co.<+>"
      then plusM (effectOf g a) (effectOf g b)
      else Nothing
  SApp (SGlobal p) _ ->
    if strEq p "state.state" then Just (Leaf "state") else Nothing
  SGlobal k -> case leafOf k of
    Just l -> Just l
    Nothing -> case G.lookupEntry g k of
      Just entry -> effectOf g entry.syntax
      Nothing -> Nothing
  _ -> Nothing

-- | a computation's effect, from its type: `Co h a`, which is a
-- | function taking a `Handler h`
computationEffect : G.Globals -> Sx.Ty -> Maybe Effect
computationEffect g t = case t of
  SFunction _ (SDecode (SApp (SGlobal p) h)) _ _ ->
    if strEq p "co.Handler" then effectOf g h else Nothing
  SDecode (SApp (SApp (SGlobal p) h) _) ->
    if strEq p "co.Co" then effectOf g h else Nothing
  _ -> Nothing

-- >>> leaves (Plus (Plus (Leaf "stdio") (Leaf "process")) (Leaf "fs"))
-- ["stdio", "process", "fs"]
