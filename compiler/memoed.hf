-- Syntax paired with its (thunked) value, so that elaboration never has
-- to evaluate a term it just built: a port of `Heff.Core.Memoed`.

import array as A
import compiler.dict as D
import compiler.eval as EV
import compiler.globals as G
import compiler.params as P
import compiler.readback as R
import compiler.syntax as Sx
import compiler.value as V
import prelude

type El = { stx : Sx.Tm, val : P.Th (V.Ev V.V) }

type Ty = { stx : Sx.Ty, val : P.Th (V.Ev V.Ty) }

valN : El -> V.V
valN m = V.nom (P.forceTh m.val)

tyN : Ty -> V.Ty
tyN m = V.nom (P.forceTh m.val)

levelOf : Ty -> P.Level
levelOf m = V.levelOfEv (P.forceTh m.val)

local : Int -> P.Th V.V -> El
local i v = { stx = SLocal i, val = \u -> Nom (v u) }

global : String -> V.V -> El
global x v = { stx = SGlobal x, val = \u -> Nom v }

code : Ty -> El
code g =
  { stx = SCode g.stx, val = \u -> V.emap (\t -> V.code t) (P.forceTh g.val) }

app : El -> El -> El
app g0 g1 =
  { stx = SApp g0.stx g1.stx
  , val = \u -> V.ebind (\f -> V.app f (\u2 -> valN g1)) (P.forceTh g0.val)
  }

-- | an application to an implicit argument (the binder's name kept, for
-- | printing)
iapp : String -> El -> El -> El
iapp x g0 g1 =
  { stx = SApp g0.stx (SImplicit x g1.stx)
  , val = \u -> V.ebind (\f -> V.app f (\u2 -> valN g1)) (P.forceTh g0.val)
  }

lam : P.Case -> G.Globals -> V.Locals V.V -> Ty -> Sx.Abs El -> El
lam c g vs gdom (MkAbs x gbody) =
  { stx = SLam gdom.stx (MkAbs x gbody.stx)
  , val = \u ->
        V.epure
          c
          (VLam
             (\u2 -> tyN gdom)
             (MkClo x vs (\vs2 -> EV.eval g c gbody.stx vs2)))
  }
lam c g vs gdom (AbsConst gbody) =
  { stx = SLam gdom.stx (AbsConst gbody.stx)
  , val = \u ->
        V.epure c (VLam (\u2 -> tyN gdom) (CloConst (P.forceTh gbody.val)))
  }

cons : P.Case -> D.Dict El -> El
cons c d =
  { stx = SCons (D.mapD (\(m : El) -> m.stx) d)
  , val = \u -> V.epure c (VCons (D.mapD (\(m : El) -> P.forceTh m.val) d))
  }

proj : El -> String -> El
proj g x =
  { stx = SProj g.stx x
  , val = \u -> V.ebind (\v -> V.proj v x) (P.forceTh g.val)
  }

tag : String -> Array El -> El
tag x gs =
  { stx = STag x (A.map (\(m : El) -> m.stx) gs), val = \u -> Nom VOpaque }

matchM : El -> D.Dict (Pair (Array String) Sx.Tm) -> El
matchM g cases = { stx = SMatch g.stx cases, val = \u -> Nom VOpaque }

specializeM : El -> String -> El -> El
specializeM g x g' =
  { stx = SSpecialize g.stx x g'.stx
  , val = \u -> Nom (V.specialize (valN g) x (valN g'))
  }

recM : El -> El
recM m = { stx = SRec m.stx, val = \u -> Nom VOpaque }

abandonM : El
abandonM = { stx = SAbandon, val = \u -> Nom VOpaque }

litInt : Int -> El
litInt i = { stx = SLitInt i, val = \u -> Nom VOpaque }

litFloat : Float -> El
litFloat x = { stx = SLitFloat x, val = \u -> Nom VOpaque }

litString : String -> El
litString s = { stx = SLitString s, val = \u -> Nom VOpaque }

isM : El -> El
isM g = { stx = SIs g.stx, val = \u -> Become (valN g) }

univ : P.Universe -> Ty
univ u = { stx = SU u, val = \u2 -> Nom (VU u) }

decode : El -> Ty
decode g = { stx = SDecode g.stx, val = \u -> V.decodeEv (P.forceTh g.val) }

-- | a function type whose argument may be implicit
-- | a function type whose argument may be implicit or an instance
functionI : P.Plicity -> G.Globals -> V.Locals V.V -> Ty -> Sx.Abs Ty -> Ty
functionI implicit g vs dom (MkAbs x body) =
  { stx = SFunction (levelOf body) dom.stx (MkAbs x body.stx) implicit
  , val = \u ->
        Nom
          (VFunction
             (levelOf body)
             (tyN dom)
             (MkClo x vs (\vs2 -> EV.evalTy g N body.stx vs2))
             implicit)
  }
functionI implicit g vs dom (AbsConst body) =
  { stx = SFunction (levelOf body) dom.stx (AbsConst body.stx) implicit
  , val = \u ->
        Nom
          (VFunction
             (levelOf body)
             (tyN dom)
             (CloConst (P.forceTh body.val))
             implicit)
  }

function : G.Globals -> V.Locals V.V -> Ty -> Sx.Abs Ty -> Ty
function g vs dom cod = functionI Expl g vs dom cod

fieldEval : G.Globals -> Sx.Ty -> V.Locals V.V -> V.Field
fieldEval g t vs2 = MkField (V.nom (EV.evalTy g N t vs2)) Nothing

recordM : G.Globals -> V.Locals V.V -> P.Level -> D.Dict Sx.Ty -> Ty
recordM g vs level fieldTypes =
  { stx = SRecord level fieldTypes
  , val = \u -> Describe (VRecord level vs (D.mapD (fieldEval g) fieldTypes))
  }

sumThunk : Ty -> P.Th V.Ty
sumThunk m u2 = tyN m

sumM : P.Variants Ty -> Ty
sumM st =
  { stx = SSum (P.variantsMap (\(m : Ty) -> m.stx) st)
  , val = \u -> Describe (VSum (P.variantsMap sumThunk st))
  }

isTy : Ty -> Ty
isTy m = { stx = SIsTy m.stx, val = \u -> Become (tyN m) }

primInt : Ty
primInt = { stx = SPrimInt, val = \u -> Nom VPrimInt }

primFloat : Ty
primFloat = { stx = SPrimFloat, val = \u -> Nom VPrimFloat }

primString : Ty
primString = { stx = SPrimString, val = \u -> Nom VPrimString }

primArray : Ty -> Ty
primArray a = { stx = SPrimArray a.stx, val = \u -> Nom (VPrimArray (tyN a)) }

fromVEl : P.Case -> Int -> V.V -> El
fromVEl c n v = { stx = R.readbEl n v, val = \u -> V.epure c v }

fromVTy : P.Case -> Int -> V.Ty -> Ty
fromVTy c n v = { stx = R.readbTy n v, val = \u -> V.epure c v }

-- >>> (app (lam N G.emptyGlobals LNil (function G.emptyGlobals LNil primInt (AbsConst primInt)) (MkAbs "x" (local 0 (\u -> V.local 0 VPrimInt)))) (global "k" (V.local 1 VPrimInt))).stx
