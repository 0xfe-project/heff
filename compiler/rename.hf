-- Renaming the globals inside syntax: a port of `Heff.Core.Rename` --
-- how the keys of other modules' definitions are shown by the names
-- they have in a file.

import array as A
import compiler.dict as D
import compiler.params as Pm
import compiler.syntax as Sx
import prelude

renameAbs : {a : Type} -> (a -> a) -> Sx.Abs a -> Sx.Abs a
renameAbs f (MkAbs x t) = MkAbs x (f t)
renameAbs f (AbsConst t) = AbsConst (f t)

-- | the two renamers, knotted
type RK = { el : Sx.Tm -> Sx.Tm, ty : Sx.Ty -> Sx.Ty }

renameCase : RK -> Pair (Array String) Sx.Tm -> Pair (Array String) Sx.Tm
renameCase k (MkPair xs b) = MkPair xs (k.el b)

renameElF : RK -> (String -> String) -> Sx.Tm -> Sx.Tm
renameElF k r e = case e of
  SGlobal x -> SGlobal (r x)
  SCode t -> SCode (k.ty t)
  SApp f a -> SApp (k.el f) (k.el a)
  SLam d b -> SLam (k.ty d) (renameAbs (\e2 -> k.el e2) b)
  SCons d -> SCons (D.mapD (\e2 -> k.el e2) d)
  SProj e2 l -> SProj (k.el e2) l
  STag t as -> STag t (A.fromList (map (\e2 -> k.el e2) (A.toList as)))
  SMatch e2 cs -> SMatch (k.el e2) (D.mapD (\p -> renameCase k p) cs)
  SSpecialize e2 l v -> SSpecialize (k.el e2) l (k.el v)
  SIs e2 -> SIs (k.el e2)
  SRec e2 -> SRec (k.el e2)
  SImplicit x e2 -> SImplicit x (k.el e2)
  SMetaApp m xs t -> SMetaApp m xs (k.ty t)
  _ -> e

renameTyF : RK -> (String -> String) -> Sx.Ty -> Sx.Ty
renameTyF k r t = case t of
  SDecode e -> SDecode (k.el e)
  SFunction level dom cod implicit ->
    SFunction level (k.ty dom) (renameAbs (\t2 -> k.ty t2) cod) implicit
  SRecord level fs -> SRecord level (D.mapD (\t2 -> k.ty t2) fs)
  SSum vs -> SSum (Pm.variantsMap (\t2 -> k.ty t2) vs)
  SIsTy t2 -> SIsTy (k.ty t2)
  SPrimArray t2 -> SPrimArray (k.ty t2)
  _ -> t

rkOf : (String -> String) -> RK
rkOf r =
  { el = \e -> renameElF (rkOf r) r e, ty = \t -> renameTyF (rkOf r) r t }

renameEl : (String -> String) -> Sx.Tm -> Sx.Tm
renameEl r e = (rkOf r).el e

renameTy : (String -> String) -> Sx.Ty -> Sx.Ty
renameTy r t = (rkOf r).ty t

-- | a synthesized key (no surface spelling: `m#` is the module as a
-- | value, `m#T` its theory) said in words
describeKey : String -> String
describeKey x =
  if endsWith "#T" x then "the theory of " ++ strSlice x 0 (strLength x - 2)
  else if endsWith "#" x then "the module " ++ strSlice x 0 (strLength x - 1)
  else x

