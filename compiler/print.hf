-- Core syntax, printed as the heff source that constructs it: the
-- canonical form the NbE differential compares (`Heff.Core.Dump` writes
-- the same text from the PureScript side, character for character).
-- Every constructor application is parenthesized; a nullary tag is bare.

import array as A
import compiler.dict as D
import compiler.params as P
import compiler.syntax as Sx
import prelude

escChar : String -> String
escChar c =
  if strEq c "\"" then "\\\""
  else if strEq c "\\" then "\\\\"
  else if strEq c "\n" then "\\n"
  else if strEq c "\r" then "\\r"
  else if strEq c "\t" then "\\t"
  else c

escFrom : String -> Int -> String
escFrom s i =
  if i < strLength s then escChar (strSlice s i (i + 1)) ++ escFrom s (i + 1)
  else ""

-- | a string literal, as JavaScript (and Hippogriff) write it
quote : String -> String
quote s = "\"" ++ escFrom s 0 ++ "\""

commaSep : List String -> String
commaSep Nil = ""
commaSep (Cons x Nil) = x
commaSep (Cons x rest) = x ++ ", " ++ commaSep rest

listOf : List String -> String
listOf xs = "[" ++ commaSep xs ++ "]"

showI : Int -> String
showI n = if n < 0 then "(0 - " ++ showInt (0 - n) ++ ")" else showInt n

showLevel : P.Level -> String
showLevel Small = "Small"
showLevel Large = "Large"
showLevel TopL = "TopL"

showUniverse : P.Universe -> String
showUniverse SmallU = "SmallU"
showUniverse LargeU = "LargeU"

showBool : Bool -> String
showBool True = "True"
showBool False = "False"

type Pr = { el : Sx.Tm -> String, ty : Sx.Ty -> String }

arrOf : {a : Type} -> (a -> String) -> Array a -> String
arrOf f xs = "(A.fromList " ++ listOf (map f (A.toList xs)) ++ ")"

dictOf : {a : Type} -> (a -> String) -> D.Dict a -> String
dictOf f d =
  "(D.fromList "
  ++ listOf
    (map
       (\p -> case p of
        MkPair k v -> "(MkPair " ++ quote k ++ " " ++ f v ++ ")")
       (D.toList d))
  ++ ")"

absOf : {a : Type} -> (a -> String) -> Sx.Abs a -> String
absOf f (MkAbs x b) = "(MkAbs " ++ quote x ++ " " ++ f b ++ ")"
absOf f (AbsConst b) = "(AbsConst " ++ f b ++ ")"

armOf : Pr -> Pair (Array String) Sx.Tm -> String
armOf r (MkPair xs b) = "(MkPair " ++ arrOf quote xs ++ " " ++ r.el b ++ ")"

showElF : Pr -> Sx.Tm -> String
showElF r (SLocal i) = "(SLocal " ++ showI i ++ ")"
showElF r (SGlobal x) = "(SGlobal " ++ quote x ++ ")"
showElF r (SCode a) = "(SCode " ++ r.ty a ++ ")"
showElF r (SApp f a) = "(SApp " ++ r.el f ++ " " ++ r.el a ++ ")"
showElF r (SLam a b) = "(SLam " ++ r.ty a ++ " " ++ absOf r.el b ++ ")"
showElF r (SCons d) = "(SCons " ++ dictOf r.el d ++ ")"
showElF r (SProj t x) = "(SProj " ++ r.el t ++ " " ++ quote x ++ ")"
showElF r (STag x ts) = "(STag " ++ quote x ++ " " ++ arrOf r.el ts ++ ")"
showElF r (SMatch t arms) =
  "(SMatch " ++ r.el t ++ " " ++ dictOf (armOf r) arms ++ ")"
showElF r (SSpecialize t x t') =
  "(SSpecialize " ++ r.el t ++ " " ++ quote x ++ " " ++ r.el t' ++ ")"
showElF r (SIs t) = "(SIs " ++ r.el t ++ ")"
showElF r SOpaque = "SOpaque"
showElF r SAbandon = "SAbandon"
showElF r (SRec t) = "(SRec " ++ r.el t ++ ")"
showElF r (SImplicit x t) = "(SImplicit " ++ quote x ++ " " ++ r.el t ++ ")"
showElF r (SPrim x) = "(SPrim " ++ quote x ++ ")"
showElF r (SMetaApp m idxs a) =
  "(SMetaApp " ++ showI m ++ " " ++ arrOf showI idxs ++ " " ++ r.ty a ++ ")"
showElF r (SLitInt n) = "(SLitInt " ++ showI n ++ ")"
showElF r (SLitFloat x) = "(SLitFloat " ++ showFloat x ++ ")"
showElF r (SLitString s) = "(SLitString " ++ quote s ++ ")"

showTyF : Pr -> Sx.Ty -> String
showTyF r (SU u) = "(SU " ++ showUniverse u ++ ")"
showTyF r (SDecode t) = "(SDecode " ++ r.el t ++ ")"
showTyF r (SFunction level dom cod implicit) =
  "(SFunction "
  ++ showLevel level
  ++ " "
  ++ r.ty dom
  ++ " "
  ++ absOf r.ty cod
  ++ " "
  ++ showBool implicit
  ++ ")"
showTyF r (SRecord level fieldTypes) =
  "(SRecord " ++ showLevel level ++ " " ++ dictOf r.ty fieldTypes ++ ")"
showTyF r (SSum st) = "(SSum " ++ dictOf (arrOf r.ty) st ++ ")"
showTyF r (SIsTy t) = "(SIsTy " ++ r.ty t ++ ")"
showTyF r SPrimInt = "SPrimInt"
showTyF r SPrimFloat = "SPrimFloat"
showTyF r SPrimString = "SPrimString"
showTyF r (SPrimArray a) = "(SPrimArray " ++ r.ty a ++ ")"

pr : Pr
pr = { el = \t -> showElF pr t, ty = \t -> showTyF pr t }

showEl : Sx.Tm -> String
showEl t = pr.el t

showTy : Sx.Ty -> String
showTy t = pr.ty t

-- >>> showEl (SApp (SLam SPrimInt (MkAbs "x" (SLocal 0))) (SLitString "hi\n"))
-- "(SApp (SLam SPrimInt (MkAbs \"x\" (SLocal 0))) (SLitString \"hi\\n\"))"
