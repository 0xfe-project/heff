-- The reader: text into notation, a port of `Heff.Parse.Surface`.  The
-- lexer is fmt/lex.hf, the one the formatter already runs on; the
-- expression grammar's functions call one another, so they are the
-- fields of one record, `gram`, as fmt/cst.hf's are.  `P` is the
-- reader's monad -- state threaded, a diagnostic thrown -- and this
-- module's `bind` is its.

import array as A
import compiler.fixity as F
import compiler.notation
import compiler.params as Pm
import fmt.lex as L
import prelude

type Binders = { f : String, names : List String, implicits : List String }

mkBinders : String -> List String -> List String -> Binders
mkBinders f names implicits = { f = f, names = names, implicits = implicits }

-- | `start`: the token that starts the current item; `binders`: the
-- | names each signature binds; `patVars`: those of the equation being
-- | read; `fix`: the fixities in scope; `lenient`: unrelated operators
-- | bind as one left-associative group (the formatter's reading)
type St =
  { toks : Array L.Tok
  , i : Int
  , top : Int
  , stack : List Int
  , scope : List String
  , known : String -> Bool
  , start : Int
  , binders : List Binders
  , patVars : List String
  , fix : F.Fixities
  , lenient : Bool
  }

type P a = St -> Pair (Either Diag a) St

bindStep : {a b : Type}
         -> Pair (Either Diag a) St
         -> (a -> P b)
         -> Pair (Either Diag b) St
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

bind : {a b : Type} -> P a -> (a -> P b) -> P b
bind m f = \st -> bindStep (m st) f

val : {a : Type} -> a -> P a
val x = \st -> MkPair (Right x) st

pGets : {a : Type} -> (St -> a) -> P a
pGets f = \st -> MkPair (Right (f st)) st

pModify : (St -> St) -> P Unit
pModify f = \st -> MkPair (Right MkUnit) (f st)

throwP : {a : Type} -> Diag -> P a
throwP d = \st -> MkPair (Left d) st

diag : Pm.Span -> String -> Diag
diag span msg =
  { code = 150, severity = SError, msg = msg, span = span, note = Nothing }

-- state updates, spelled once
setI : Int -> St -> St
setI i s =
  { toks = s.toks
  , i = i
  , top = s.top
  , stack = s.stack
  , scope = s.scope
  , known = s.known
  , start = s.start
  , binders = s.binders
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setStack : List Int -> St -> St
setStack k s =
  { toks = s.toks
  , i = s.i
  , top = s.top
  , stack = k
  , scope = s.scope
  , known = s.known
  , start = s.start
  , binders = s.binders
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setScope : List String -> St -> St
setScope sc s =
  { toks = s.toks
  , i = s.i
  , top = s.top
  , stack = s.stack
  , scope = sc
  , known = s.known
  , start = s.start
  , binders = s.binders
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setStart : Int -> St -> St
setStart x s =
  { toks = s.toks
  , i = s.i
  , top = s.top
  , stack = s.stack
  , scope = s.scope
  , known = s.known
  , start = x
  , binders = s.binders
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setTop : Int -> St -> St
setTop x s =
  { toks = s.toks
  , i = s.i
  , top = x
  , stack = s.stack
  , scope = s.scope
  , known = s.known
  , start = s.start
  , binders = s.binders
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setBinders : List Binders -> St -> St
setBinders b s =
  { toks = s.toks
  , i = s.i
  , top = s.top
  , stack = s.stack
  , scope = s.scope
  , known = s.known
  , start = s.start
  , binders = b
  , patVars = s.patVars
  , fix = s.fix
  , lenient = s.lenient
  }

setPatVars : List String -> St -> St
setPatVars pv s =
  { toks = s.toks
  , i = s.i
  , top = s.top
  , stack = s.stack
  , scope = s.scope
  , known = s.known
  , start = s.start
  , binders = s.binders
  , patVars = pv
  , fix = s.fix
  , lenient = s.lenient
  }

-- Tokens and layout
--------------------------------------------------------------------------------

eofTok : L.Tok
eofTok =
  { kind = "eof"
  , text = ""
  , start = 0
  , end = 0
  , line = 0
  , col = 0
  , first = True
  }

-- | `:` annotates (`::` is an operator: the prelude's cons)
isAnnText : String -> Bool
isAnnText x = strEq x ":"

spanOf : L.Tok -> Pm.Span
spanOf t = { start = t.start, end = t.end }

spanTT : L.Tok -> L.Tok -> Pm.Span
spanTT a b = { start = a.start, end = b.end }

spanTE : L.Tok -> Int -> Pm.Span
spanTE a e = { start = a.start, end = e }

mkSpan : Int -> Int -> Pm.Span
mkSpan a b = { start = a, end = b }

endBefore : St -> Int -> Int
endBefore s j = if j <= 0 then 0 else (A.index s.toks (j - 1)).end

atTok : St -> Int -> L.Tok -> L.Tok
atTok s j t =
  if j > s.top && t.first && t.col == 0 && not (strEq t.kind "eof")
    then { kind = "eof"
         , text = ""
         , start = endBefore s j
         , end = endBefore s j
         , line = 0
         , col = 0
         , first = True
         }
  else if strEq t.kind "eof"
    then { kind = "eof"
         , text = ""
         , start = endBefore s j
         , end = endBefore s j
         , line = 0
         , col = 0
         , first = True
         }
  else t

-- | the token at an index, as the declaration being read sees it: a line
-- | starting at the left margin ends it
tokAt : St -> Int -> L.Tok
tokAt s j =
  if j < 0 || j >= A.length s.toks
    then { kind = "eof"
         , text = ""
         , start = endBefore s j
         , end = endBefore s j
         , line = 0
         , col = 0
         , first = True
         }
  else atTok s j (A.index s.toks j)

cur : St -> L.Tok
cur s = tokAt s s.i

-- | a token, as an error says what it found
shown : L.Tok -> String
shown t =
  if strEq t.kind "eof" then "the end of the declaration"
  else "`" ++ t.text ++ "`"

peek : P L.Tok
peek = pGets cur

peekAt : Int -> P L.Tok
peekAt k = pGets (\s -> tokAt s (s.i + k))

-- | where the last token read ends
prevEnd : P Int
prevEnd = pGets (\s -> (tokAt s (s.i - 1)).end)

pure : {a : Type} -> a -> P a
pure x = val x

next : P L.Tok
next = do
  t <- peek
  pModify (\s -> setI (s.i + 1) s)
  pure t

lastD : List Int -> Int
lastD Nil = 0
lastD (Cons x Nil) = x
lastD (Cons x rest) = lastD rest

initL : {a : Type} -> List a -> List a
initL Nil = Nil
initL (Cons x Nil) = Nil
initL (Cons x rest) = Cons x (initL rest)

snocL : {a : Type} -> List a -> a -> List a
snocL Nil y = Cons y Nil
snocL (Cons x rest) y = Cons x (snocL rest y)

-- | the token ends what is being read: it is the end, or starts a line
-- | not indented past the current block
atBoundary : P Bool
atBoundary =
  pGets
    (\s ->
       strEq (cur s).kind "eof"
       || ((cur s).first
           && (cur s).col <= lastD s.stack
           && not (s.i == s.start)))

expectAnn : P L.Tok
expectAnn = do
  t <- peek
  if strEq t.kind "sym" && isAnnText t.text then next
    else throwP (diag (spanOf t) "expected `:`")

expectSym : String -> P L.Tok
expectSym x = do
  t <- peek
  if strEq t.kind "sym" && strEq t.text x then next
    else throwP (diag (spanOf t) ("expected `" ++ x ++ "`, not " ++ shown t))

expectPunct : String -> P L.Tok
expectPunct x = do
  t <- peek
  if strEq t.kind "punct" && strEq t.text x then next
    else throwP (diag (spanOf t) ("expected `" ++ x ++ "`, not " ++ shown t))

expectKw : String -> P L.Tok
expectKw x = do
  t <- peek
  if strEq t.kind "kw" && strEq t.text x then next
    else throwP (diag (spanOf t) ("expected `" ++ x ++ "`, not " ++ shown t))

expectKind : String -> String -> P L.Tok
expectKind k what = do
  t <- peek
  if strEq t.kind k then next
    else throwP (diag (spanOf t) ("expected " ++ what ++ ", not " ++ shown t))

-- | the items of a block: the first sets the column
blockGo : {a : Type} -> P a -> Int -> List a -> P (List a)
blockGo item col acc = do
  pModify (\s -> setStart s.i s)
  x <- item
  t' <- peek
  if not (strEq t'.kind "eof") && t'.first && t'.col == col
      then blockGo item col (Cons x acc)
    else pure (reverse (Cons x acc))

block : {a : Type} -> P a -> P (List a)
block item = do
  t <- peek
  if strEq t.kind "eof" then throwP (diag (spanOf t) "a block is empty")
    else do
      outer <- pGets (\s -> lastD s.stack)
      if t.first && t.col <= outer
          then throwP
              (diag (spanOf t) "a block must be indented past what it is in")
        else do
          pModify (\s -> setStack (snocL s.stack t.col) s)
          saved <- pGets (\s -> s.scope)
          xs <- blockGo item t.col Nil
          pModify (\s -> setScope saved (setStack (initL s.stack) s))
          pure xs

-- | inside brackets, lines do not end anything
inBrackets : {a : Type} -> P a -> P a
inBrackets p = do
  pModify (\s -> setStack (snocL s.stack (0 - 1)) s)
  x <- p
  pModify (\s -> setStack (initL s.stack) s)
  pure x

appendS : {a : Type} -> List a -> List a -> List a
appendS Nil ys = ys
appendS (Cons x xs) ys = Cons x (appendS xs ys)

withScope : {a : Type} -> List String -> P a -> P a
withScope xs p = do
  saved <- pGets (\s -> s.scope)
  pModify (\s -> setScope (appendS xs s.scope) s)
  x <- p
  pModify (\s -> setScope saved s)
  pure x

startsAtom : L.Tok -> Bool
startsAtom t =
  elemBy strEq t.kind ["var", "con", "tag", "int", "float", "str"]
  || (strEq t.kind "kw"
      && elemBy
        strEq
        t.text
        ["Type", "Int", "Float", "String", "Array", "data", "abandon"])
  || (strEq t.kind "punct"
      && (strEq t.text "(" || strEq t.text "{" || strEq t.text "["))

startsItem : L.Tok -> Bool
startsItem t =
  startsAtom t
  || strEq t.kind "var"
  || (strEq t.kind "punct" && strEq t.text "(")

-- | as many as there are (a failure that reads nothing ends them);
-- | gathered newest first, reversed at the end
manyGo : P Ntn -> List Ntn -> P (List Ntn)
manyGo p acc = do
  b <- atBoundary
  t <- peek
  if b || not (startsItem t) then pure (reverse acc)
    else do
      x <- p
      manyGo p (Cons x acc)

many : P Ntn -> P (List Ntn)
many p = manyGo p Nil

many1 : P Ntn -> P (List Ntn)
many1 p = do
  x <- p
  xs <- many p
  pure (Cons x xs)

sepGo : {a : Type} -> String -> P a -> List a -> P (List a)
sepGo sep p acc = do
  t <- peek
  if strEq t.text sep
      then do
        n <- next
        y <- p
        sepGo sep p (Cons y acc)
    else pure (reverse acc)

sepBy1 : {a : Type} -> String -> P a -> P (List a)
sepBy1 sep p = do
  x <- p
  sepGo sep p (Cons x Nil)

-- | a symbol that is an operator (not syntax)
isOperator : L.Tok -> Bool
isOperator t = strEq t.kind "sym" && not (elemBy strEq t.text F.reserved)

-- Number literals
--------------------------------------------------------------------------------

digitsVal : String -> Int -> Int -> Int -> Int
digitsVal s i stop n =
  if i >= stop then n
  else digitsVal s (i + 1) stop (n * 10 + (charCode s i - 48))

intOfText : String -> Int
intOfText s =
  if startsWith "-" s then 0 - digitsVal s 1 (strLength s) 0
  else if startsWith "+" s then digitsVal s 1 (strLength s) 0
  else digitsVal s 0 (strLength s) 0

ipow10 : Int -> Int
ipow10 k = if k <= 0 then 1 else 10 * ipow10 (k - 1)

expOf : String -> Int
expOf ex =
  if startsWith "-" ex then 0 - intOfText (strSlice ex 1 (strLength ex))
  else if startsWith "+" ex then intOfText (strSlice ex 1 (strLength ex))
  else intOfText ex

dotAt : String -> Int -> Int
dotAt s i =
  if i >= strLength s then strLength s
  else if charCode s i == 46 then i
  else dotAt s (i + 1)

-- (the digits with the dot taken out: an exact integer mantissa, and
-- how many digits were after the dot)
mantScale : String -> Int -> Int
mantScale m d = if d >= strLength m then 0 else strLength m - d - 1

mantInt : String -> Int -> Int
mantInt m d =
  if d >= strLength m then intOfText m
  else intOfText (strSlice m 0 d ++ strSlice m (d + 1) (strLength m))

splitExp : String -> Int -> Int
splitExp s i =
  if i >= strLength s then strLength s
  else if charCode s i == 101 || charCode s i == 69 then i
  else splitExp s (i + 1)

-- (one conversion, not a float computation per digit: `M * 10^p` is an
-- exact integer when `p >= 0`, and one division otherwise -- so the
-- value is the literal's, as the reference's `Number.fromString` reads
-- it)
floatAt : Int -> Int -> Float
floatAt m p =
  if p >= 0 then toFloat (m * ipow10 p)
  else toFloat m /. toFloat (ipow10 (0 - p))

floatSplit : String -> Int -> Float
floatSplit s eAt =
  floatAt
    (mantInt (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))
    ((if eAt >= strLength s then 0
      else expOf (strSlice s (eAt + 1) (strLength s)))
     - mantScale (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))

-- | `a.b`, with an optional sign and an optional `e`/`E` exponent, as
-- | the lexer writes floats
floatOfText : String -> Float
floatOfText s =
  if startsWith "-" s
    then 0.0
      -. floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else if startsWith "+" s
    then floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else floatSplit s (splitExp s 0)

-- The expression grammar
--------------------------------------------------------------------------------

type Gram =
  { expr : P Ntn
  , opExprN : Int -> P Ntn
  , userOps : P Ntn
  , app : P Ntn
  , atom : P Ntn
  , pattern_ : P Ntn
  , patAtom : P Ntn
  , lambda_ : P Ntn
  , caseE : P Ntn
  , ifE : P Ntn
  , doE : P Ntn
  }

type Operand = { op : L.Tok, e : Ntn }

mkOperand : L.Tok -> Ntn -> Operand
mkOperand t e = { op = t, e = e }

binderNames : Ntn -> List String
binderNames (Infix (Ident x _) (Keyword ":" _) _) = Cons x Nil
binderNames (NBrace n _) = binderNames n
binderNames _ = Nil

-- | the names a (function) type binds: `(x : A) -> ...`, `{x : A} -> ...`
piBinders : Ntn -> List String
piBinders (Infix b (Keyword "->" _) rest) =
  appendS (binderNames b) (piBinders rest)
piBinders _ = Nil

-- | the names of the implicit parameters, `{x : A} -> ...`
piImplicits : Ntn -> List String
piImplicits (Infix (NBrace b bsp) (Keyword "->" _) rest) =
  appendS (binderNames (NBrace b bsp)) (piImplicits rest)
piImplicits (Infix _ (Keyword "->" _) rest) = piImplicits rest
piImplicits _ = Nil

concatMapS : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapS f Nil = Nil
concatMapS f (Cons x xs) = appendS (f x) (concatMapS f xs)

patVarsOf : Ntn -> List String
patVarsOf n = case (getGroup n).head of
  Ident x _ ->
    if length (getGroup n).args == 0 && not (strEq x "_") then Cons x Nil
    else Nil
  NTag _ _ -> concatMapS (\m -> patVarsOf m) (getGroup n).args
  _ -> Nil

isIdentN : Ntn -> Bool
isIdentN (Ident _ _) = True
isIdentN _ = False

-- (a capitalised name, not a tag: `'x` is written one longer than `x`)
isNameN : Ntn -> Bool
isNameN (Ident _ _) = True
isNameN (NTag x sp) = sp.end - sp.start == strLength x
isNameN _ = False

asNameN : Ntn -> Ntn
asNameN (NTag x sp) = Ident x sp
asNameN n = n

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) xs) = Cons x (catMaybesS xs)
catMaybesS (Cons Nothing xs) = catMaybesS xs

identOf : Ntn -> Maybe String
identOf (Ident x _) = Just x
identOf (NTag x _) = Just x
identOf _ = Nothing

identsOfG : Ntn -> List String
identsOfG g =
  catMaybesS (map identOf (Cons (getGroup g).head (getGroup g).args))

asBinderOn : Ntn -> P Ntn
asBinderOn e = case e of
  Infix g (Keyword ":" _) _ -> do
    pModify (\s -> setScope (appendS (identsOfG g) s.scope) s)
    pure e
  _ -> pure e

allS : {a : Type} -> (a -> Bool) -> List a -> Bool
allS p Nil = True
allS p (Cons x xs) = p x && allS p xs

nameBinder : Ntn -> Ntn
nameBinder (Infix g (Keyword ":" ksp) t) =
  if allS isNameN (Cons (getGroup g).head (getGroup g).args)
    then Infix
        (group (asNameN (getGroup g).head) (map asNameN (getGroup g).args))
        (Keyword ":" ksp)
        t
  else Infix g (Keyword ":" ksp) t
nameBinder e0 = e0

-- | `A : T` as a binder: what is left of `:` is names (in scope after)
asBinder : Ntn -> P Ntn
asBinder e0 = asBinderOn (nameBinder e0)

foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

wrapB : Bool -> Ntn -> Pm.Span -> Ntn
wrapB True n sp = NBrace n sp
wrapB False n sp = n

arrowNames : Pm.Span
           -> Ntn
           -> Ntn
           -> Ntn
           -> Pm.Span
           -> Ntn
           -> Bool
           -> Ntn
           -> Ntn
arrowNames sp lhs rhs g ksp ty braced orig =
  if allS isIdentN (Cons (getGroup g).head (getGroup g).args)
  && length (getGroup g).args > 0
    then foldr
        (\x b ->
           Infix
             (wrapB braced (Infix x (Keyword ":" ksp) ty) (ntnSpan orig))
             (Keyword "->" sp)
             b)
        rhs
        (Cons (getGroup g).head (getGroup g).args)
  else Infix orig (Keyword "->" sp) rhs

-- `{a : T} -> B`: braces with one declaration, left of an arrow, bind
-- an implicit argument
bracedLhs : Ntn -> Ntn
bracedLhs (NBlock "sig" Nothing (Cons f Nil) bsp) = NBrace f bsp
bracedLhs n = n

arrowBinop : Pm.Span -> Ntn -> Ntn -> Ntn
arrowBinop sp lhs rhs = case lhs of
  Infix g (Keyword ":" ksp) ty -> arrowNames sp lhs rhs g ksp ty False lhs
  NBrace (Infix g (Keyword ":" ksp) ty) bsp ->
    arrowNames sp lhs rhs g ksp ty True lhs
  _ -> Infix lhs (Keyword "->" sp) rhs

specOne : Pm.Span -> Ntn -> Ntn -> Ntn
specOne sp acc (Infix (Ident x xsp) k v) =
  Infix
    acc
    (Keyword "~" sp)
    (NTuple
       (Cons (Infix (NField x xsp) k v) Nil)
       (ntnSpan (Infix (Ident x xsp) k v)))
specOne sp acc _ = acc

-- | `x -> y`, with `(a b : T) -> B` for `(a : T) -> (b : T) -> B`; and
-- | `T ~ { f = v }`, a specialisation
binop : String -> Pm.Span -> Ntn -> Ntn -> Ntn
binop "->" sp lhs0 rhs = arrowBinop sp (bracedLhs lhs0) rhs
binop "~" sp lhs rhs = case rhs of
  NBlock "struct" Nothing fields _ ->
    foldl (\acc f -> specOne sp acc f) lhs fields
  _ -> Infix lhs (Keyword "~" sp) rhs
binop o sp lhs rhs = Infix lhs (Keyword o sp) rhs

-- The shunting yard
--------------------------------------------------------------------------------

type Shunt = { ops : List L.Tok, out : List Ntn }

maxI : Int -> Int -> Int
maxI a b = if a < b then b else a

boolAnn : Pm.Span -> Ntn -> Ntn
boolAnn osp n = Infix n (Keyword ":" osp) (Ident "Bool" osp)

-- (the sides are annotated with the `Bool` in scope)
shortcut : L.Tok -> Ntn -> Ntn -> Ntn -> Ntn
shortcut op c a b =
  boolAnn
    (spanOf op)
    (NBlock
       "match"
       (Just (boolAnn (spanOf op) c))
       (Cons
          (Infix (NTag "True" (spanOf op)) (Keyword "=>" (spanOf op)) a)
          (Cons
             (Infix (NTag "False" (spanOf op)) (Keyword "=>" (spanOf op)) b)
             Nil))
       (mkSpan (ntnSpan c).start (maxI (ntnSpan a).end (ntnSpan b).end)))

-- | `&&` and `||` are `if`: the right side is computed only if needed
applyOp : L.Tok -> Ntn -> Ntn -> Ntn
applyOp op l r =
  if strEq op.text "&&" then shortcut op l r (NTag "False" (spanOf op))
  else if strEq op.text "||" then shortcut op l (NTag "True" (spanOf op)) r
  else Juxt (Juxt (Ident op.text (spanOf op)) l) r

-- (stacks newest first: push is `Cons`)
reduceS : Shunt -> Shunt
reduceS st = case st.ops of
  Cons o os -> case st.out of
    Cons r (Cons l rest) -> { ops = os, out = Cons (applyOp o l r) rest }
    _ -> st
  Nil -> st

-- | `before` is on the stack, `op` comes: does `before` reduce first?
firstS : F.Fixities -> Bool -> L.Tok -> L.Tok -> P Bool
firstS fix lenient before op = case F.relate fix before.text op.text of
  Tighter -> pure True
  Looser -> pure False
  Same AssocLeft -> pure True
  Same AssocRight -> pure False
  Same AssocNone ->
    throwP
      (diag
         (spanOf op)
         (if strEq before.text op.text
            then "`" ++ op.text ++ "` does not associate: add parentheses"
          else "`"
            ++ before.text
            ++ "` and `"
            ++ op.text
            ++ "` do not associate: add parentheses"))
  Unrelated ->
    if lenient then pure True
    else throwP
        (diag
           (spanOf op)
           ("`"
            ++ before.text
            ++ "` and `"
            ++ op.text
            ++ "` are not related: add parentheses, or declare which binds tighter (`above`, `below`)"))
  Undeclared x ->
    if lenient then pure True
    else throwP
        (diag
           (spanOf (if strEq x op.text then op else before))
           ("`"
            ++ x
            ++ "` has no fixity: declare it (`infixl "
            ++ x
            ++ "`), or import the module that does"))

pushS : F.Fixities -> Bool -> Shunt -> Operand -> P Shunt
pushS fix lenient st r = case st.ops of
  Nil -> pure { ops = Cons r.op st.ops, out = Cons r.e st.out }
  Cons before os -> do
    done <- firstS fix lenient before r.op
    if done then pushS fix lenient (reduceS st) r
      else pure { ops = Cons r.op st.ops, out = Cons r.e st.out }

pushAll : F.Fixities -> Bool -> Shunt -> List Operand -> P Shunt
pushAll fix lenient st Nil = pure st
pushAll fix lenient st (Cons r rest) = do
  st' <- pushS fix lenient st r
  pushAll fix lenient st' rest

checkFixOf : F.Fixities -> Bool -> List Operand -> P Unit
checkFixOf fix lenient Nil = pure MkUnit
checkFixOf fix lenient (Cons r rest) = case F.groupOf fix r.op.text of
  Just _ -> checkFixOf fix lenient rest
  Nothing ->
    if lenient then checkFixOf fix lenient rest
    else throwP
        (diag
           (spanOf r.op)
           ("`"
            ++ r.op.text
            ++ "` has no fixity: declare it (`infixl "
            ++ r.op.text
            ++ "`), or import the module that does"))

reduceAll : Shunt -> Shunt
reduceAll st = case st.ops of
  Nil -> st
  Cons o os -> reduceAll (reduceS st)

headOr : {a : Type} -> a -> List a -> a
headOr z Nil = z
headOr z (Cons x xs) = x

-- | operators and operands into a tree, refusing operators that do not
-- | go together
resolve : Ntn -> List Operand -> P Ntn
resolve e0 rest = do
  fix <- pGets (\s -> s.fix)
  lenient <- pGets (\s -> s.lenient)
  checkFixOf fix lenient rest
  st <- pushAll fix lenient { ops = Nil, out = Cons e0 Nil } rest
  pure (headOr e0 (reduceAll st).out)

-- The grammar's functions, knotted through `gram`
--------------------------------------------------------------------------------

-- | a token that starts a closed expression (one that runs to the end)
startsClosed : L.Tok -> Bool
startsClosed t =
  strEq t.text "\\"
  || (strEq t.kind "kw" && elemBy strEq t.text ["case", "if", "do"])

-- | the syntax's operators, loosest first: `->` (right), `~` (right)
symPrec : String -> Int
symPrec "->" = 1
symPrec "~" = 2
symPrec s = 0 - 1

exprHead : Gram -> L.Tok -> P Ntn
exprHead g t =
  if strEq t.text "\\" && strEq t.kind "sym" then g.lambda_
  else if strEq t.kind "kw" && strEq t.text "case" then g.caseE
  else if strEq t.kind "kw" && strEq t.text "if" then g.ifE
  else if strEq t.kind "kw" && strEq t.text "do" then g.doE
  else if strEq t.kind "kw" && strEq t.text "let"
    then throwP (diag (spanOf t) "`let` is not supported yet")
  else g.opExprN 0

exprF : Gram -> P Ntn
exprF g = do
  t <- peek
  e <- exprHead g t
  t' <- peek
  b <- atBoundary
  if isAnnText t'.text && strEq t'.kind "sym" && not b
      then do
        n <- next
        ty <- g.expr
        pure (Infix e (Keyword ":" (spanOf t')) ty)
    else pure e

-- the codomain of `->` may be a lambda, a case, ... as any expression
arrowRhsF : Gram -> P Ntn
arrowRhsF g = do
  t <- peek
  if startsClosed t then g.expr else g.opExprN 1

opLoopF : Gram -> Int -> Ntn -> P Ntn
opLoopF g minPrec lhs = do
  t <- peek
  b <- atBoundary
  if strEq t.kind "sym"
    && symPrec t.text >= 1
    && symPrec t.text >= minPrec
    && not b
      then do
        n <- next
        rhs <-
          if symPrec t.text == 1 then arrowRhsF g
          else g.opExprN (symPrec t.text)
        opLoopF g minPrec (binop t.text (spanOf t) lhs rhs)
    else pure lhs

opExprF : Gram -> Int -> P Ntn
opExprF g minPrec = do
  lhs <- g.userOps
  opLoopF g minPrec lhs

operandsF : Gram -> List Operand -> P (List Operand)
operandsF g acc = do
  t <- peek
  b <- atBoundary
  if isOperator t && not b
      then do
        n <- next
        u <- peek
        if startsClosed u
            then do
              e <- g.expr
              pure (reverse (Cons (mkOperand t e) acc))
          else do
            e <- g.app
            operandsF g (Cons (mkOperand t e) acc)
    else pure (reverse acc)

-- | `a + b * c`, as the fixities say.  An operand is an application,
-- | or, last, a lambda, `case`, `if` or `do`
userOpsF : Gram -> P Ntn
userOpsF g = do
  e0 <- g.app
  rest <- operandsF g Nil
  if length rest == 0 then pure e0 else resolve e0 rest

-- | application: a head and its arguments
appF : Gram -> P Ntn
appF g = do
  h <- g.atom
  args <- many g.atom
  pure (group h args)

fieldsGo : Ntn -> P Ntn
fieldsGo n = do
  t <- peek
  if strEq t.kind "field"
      then do
        f <- next
        fieldsGo (Juxt n (NField t.text (spanOf t)))
    else pure n

-- | `[a, b, c]`, `Cons a (Cons b (Cons c Nil))`, and `[]`, `Nil`
listOfF : Gram -> P Ntn -> P Ntn
listOfF g item = do
  o <- next
  inBrackets (do
    t <- peek
    xs <- if strEq t.text "]" then pure Nil else sepBy1 "," item
    c <- expectPunct "]"
    pure
        (foldr
           (\x rest ->
              group (NTag "Cons" (spanTT o c)) (Cons x (Cons rest Nil)))
           (NTag "Nil" (spanTT o c))
           xs))

-- | `, e, e ...` (after the first of a tuple's components)
many1SepF : Gram -> P (List Ntn)
many1SepF g = do
  t <- peek
  if strEq t.text ","
      then do
        n <- next
        e <- g.expr
        rest <- many1SepF g
        pure (Cons e rest)
    else pure Nil

-- | `x : T` in a binder's parentheses names its variable
binderOrExprF : Gram -> P Ntn
binderOrExprF g = do
  e <- g.expr
  asBinder e

settingF : Gram -> P Ntn
settingF g = do
  x <- next
  eq <- expectSym "="
  e <- g.expr
  pure (Infix (Ident x.text (spanOf x)) (Keyword ":=" (spanOf x)) e)

declarationF : Gram -> P Ntn
declarationF g = do
  e <- binderOrExprF g
  case e of
    Infix _ (Keyword ":" _) _ -> pure e
    _ -> throwP (diag (ntnSpan e) "a field is `name : Type`")

-- | `{ x : A, ... }` (a record type), `{ x = e, ... }` (a record), `{}`,
-- | and `{x : A}` (an implicit binder)
bracesF : Gram -> P Ntn
bracesF g = do
  o <- next
  inBrackets (do
    t <- peek
    t2 <- peekAt 1
    if strEq t.text "}"
        then do
          c <- next
          pure (NBlock "struct" Nothing Nil (spanTT o c))
      else if strEq t2.text "="
        then do
          fs <- sepBy1 "," (settingF g)
          c <- expectPunct "}"
          pure (NBlock "struct" Nothing fs (spanTT o c))
      else do
        fs <- sepBy1 "," (declarationF g)
        c <- expectPunct "}"
        pure (NBlock "sig" Nothing fs (spanTT o c)))

altConF : Gram -> P Ntn
altConF g = do
  c <- next
  args <- many g.atom
  pure (group (NTag c.text (spanOf c)) args)

-- | `data { A x | B }`, a sum type without a name
anonymousSumF : Gram -> P Ntn
anonymousSumF g = do
  kw <- next
  o <- expectPunct "{"
  inBrackets (do
    alts <- sepBy1 "|" (altConF g)
    c <- expectPunct "}"
    pure (NBlock "sum" Nothing alts (spanTT kw c)))

-- | `( e )`, `( e : T )`, `(x := e)` (a named argument), `(+)`
parensF : Gram -> P Ntn
parensF g = do
  o <- next
  inBrackets (do
    t <- peek
    t2 <- peekAt 1
    if isOperator t && strEq t2.text ")"
        then do
          n1 <- next
          n2 <- next
          pure (Ident t.text (spanOf t))
      else if (strEq t.kind "var" || strEq t.kind "con")
      && strEq t2.kind "sym"
      && strEq t2.text ":="
        then do
          n1 <- next
          n2 <- next
          e <- g.expr
          c <- expectPunct ")"
          pure
              (NBrace
                 (Infix (Ident t.text (spanOf t)) (Keyword ":=" (spanOf t2)) e)
                 (spanTT o c))
      else do
        e <- g.expr
        t' <- peek
        if strEq t'.text ","
            then do
              rest <- many1SepF g
              c <- expectPunct ")"
              pure (NTuple (Cons e rest) (spanTT o c))
          else do
            c <- expectPunct ")"
            after <- peek
            if strEq after.kind "sym" && strEq after.text "->" then asBinder e
              else pure e)

-- (`M.x`, a definition of the module imported as `M`, unless `M` is a
-- variable here)
conAtom : Gram -> L.Tok -> P Ntn
conAtom g t = do
  t2 <- peek
  local <- pGets (\s -> elemBy strEq t.text s.scope)
  qualified <-
    pGets (\s -> strEq t2.kind "field" && s.known (t.text ++ "." ++ t2.text))
  if qualified && not local
      then do
        n <- next
        pure (Ident (t.text ++ "." ++ t2.text) (spanTT t t2))
    else do
      inScope <- pGets (\s -> local || s.known t.text)
      pure (if inScope then Ident t.text (spanOf t) else NTag t.text (spanOf t))

atomBase : Gram -> L.Tok -> P Ntn
atomBase g t =
  if strEq t.kind "var"
    then do
      n <- next
      pure (Ident t.text (spanOf t))
  else if strEq t.kind "con"
    then do
      n <- next
      conAtom g t
  else if strEq t.kind "tag"
    then do
      n <- next
      pure (NTag t.text (spanOf t))
  else if strEq t.kind "int"
    then do
      n <- next
      pure (NInt (intOfText t.text) (spanOf t))
  else if strEq t.kind "float"
    then do
      n <- next
      pure (NFloat (floatOfText t.text) (spanOf t))
  else if strEq t.kind "str"
    then do
      n <- next
      pure (NString t.text (spanOf t))
  else if strEq t.kind "kw"
  && elemBy strEq t.text ["Type", "Int", "Float", "String", "Array", "abandon"]
    then do
      n <- next
      pure (Keyword t.text (spanOf t))
  else if strEq t.kind "kw" && strEq t.text "data" then anonymousSumF g
  else if strEq t.kind "punct" && strEq t.text "(" then parensF g
  else if strEq t.kind "punct" && strEq t.text "{" then bracesF g
  else if strEq t.kind "punct" && strEq t.text "["
    -- spike: `[x : T]`, an instance binder (left of `->`); a list
    -- otherwise
    then do
      t1 <- peekAt 1
      t2 <- peekAt 2
      if strEq t1.kind "var" && isAnnText t2.text
          then do
            o <- next
            x <- next
            cc <- next
            ty <- g.expr
            c2 <- expectPunct "]"
            pure
                (NBracket
                   (Infix (Ident x.text (spanOf x)) (Keyword ":" (spanOf x)) ty)
                   (spanTT o c2))
        else listOfF g g.expr
  else throwP (diag (spanOf t) ("expected an expression, not " ++ shown t))

-- | the arguments of an application, with fields: `x`, `C`, `3`, `"s"`,
-- | `(e)`, `{...}`, `p.x`
atomF : Gram -> P Ntn
atomF g = do
  t <- peek
  b <- atBoundary
  if b || not (startsAtom t)
      then throwP (diag (spanOf t) ("expected an expression, not " ++ shown t))
    else do
      base <- atomBase g t
      fieldsGo base

lamBinderF : Gram -> P Ntn
lamBinderF g = do
  t <- peek
  if strEq t.kind "var" || strEq t.kind "con"
      then do
        n <- next
        pure (Ident t.text (spanOf t))
    else if strEq t.kind "punct" && strEq t.text "{"
      then do
        n <- next
        x <- peek
        if not (strEq x.kind "var" || strEq x.kind "con")
            then throwP (diag (spanOf x) "expected an implicit argument's name")
          else do
            n2 <- next
            c <- expectPunct "}"
            pure (NBrace (Ident x.text (spanOf x)) (spanTT t c))
    else if strEq t.kind "punct" && strEq t.text "("
      then do
        n <- next
        inBrackets (do
          x <- peek
          if not (strEq x.kind "var" || strEq x.kind "con")
              then throwP
                  (diag (spanOf x) "expected a binder's name: `\\(x : T) -> e`")
            else do
              n2 <- next
              cc <- expectAnn
              ty <- g.expr
              c <- expectPunct ")"
              pure
                  (Infix
                     (Ident x.text (spanOf x))
                     (Keyword ":" (spanOf cc))
                     ty))
    else throwP
        (diag (spanOf t) "a lambda binds names: `\\x y -> e`, `\\(x : T) -> e`")

lamBound : Ntn -> List String
lamBound (Ident x _) = Cons x Nil
lamBound (NBrace (Ident x _) _) = Cons x Nil
lamBound (Infix (Ident x _) (Keyword ":" _) _) = Cons x Nil
lamBound _ = Nil

lamBinders : Gram -> List Ntn -> P (List Ntn)
lamBinders g acc = do
  t <- peek
  if strEq t.kind "var"
    || strEq t.kind "con"
    || (strEq t.kind "punct" && (strEq t.text "{" || strEq t.text "("))
      then do
        b <- lamBinderF g
        lamBinders g (Cons b acc)
    else pure (reverse acc)

-- | `\x {y} _ -> e`
lambdaF : Gram -> P Ntn
lambdaF g = do
  n <- next
  bs <- do
    b0 <- lamBinderF g
    more <- lamBinders g Nil
    pure (Cons b0 more)
  arrow <- expectSym "->"
  withScope (concatMapS lamBound bs) (do
    body <- g.expr
    pure (foldr (\b e -> Infix b (Keyword "=>" (ntnSpan b)) e) body bs))

alternativeF : Gram -> P Ntn
alternativeF g = do
  p <- g.pattern_
  arrow <- expectSym "->"
  withScope (patVarsOf p) (do
    e <- g.expr
    pure (Infix p (Keyword "=>" (spanOf arrow)) e))

-- | `case e of` and its alternatives, `C x y -> e`
caseExprF : Gram -> P Ntn
caseExprF g = do
  kw <- next
  scrut <- g.expr
  o <- expectKw "of"
  alts <- block (alternativeF g)
  end <- prevEnd
  pure (NBlock "match" (Just scrut) alts (spanTE kw end))

-- | `if c then a else b`, a `case` on `True` and `False`
ifExprF : Gram -> P Ntn
ifExprF g = do
  kw <- next
  c <- g.expr
  o1 <- expectKw "then"
  a <- g.expr
  o2 <- expectKw "else"
  b <- g.expr
  end <- prevEnd
  pure
      (NBlock
         "match"
         (Just c)
         (Cons
            (Infix
               (NTag "True" (spanTE kw end))
               (Keyword "=>" (spanTE kw end))
               a)
            (Cons
               (Infix
                  (NTag "False" (spanTE kw end))
                  (Keyword "=>" (spanTE kw end))
                  b)
               Nil))
         (spanTE kw end))

statementF : Gram -> P Ntn
statementF g = do
  t <- peek
  t2 <- peekAt 1
  if strEq t.kind "var" && strEq t2.text "<-"
      then do
        n <- next
        arrow <- next
        e <- g.expr
        -- (the rest of the block sees it)
        pModify (\s -> setScope (Cons t.text s.scope) s)
        pure (Infix (Ident t.text (spanOf t)) (Keyword "<-" (spanOf arrow)) e)
    else g.expr

-- | `do` and its statements, `x <- e` or `e`
doExprF : Gram -> P Ntn
doExprF g = do
  kw <- next
  stmts <- block (statementF g)
  end <- prevEnd
  pure (NBlock "do" Nothing stmts (spanTE kw end))

patHeadF : Gram -> P Ntn
patHeadF g = do
  t <- peek
  if strEq t.kind "con" || strEq t.kind "tag"
      then do
        n <- next
        args <- many g.patAtom
        pure (group (NTag t.text (spanOf t)) args)
    else g.patAtom

consTailF : Gram -> Ntn -> P Ntn
consTailF g l = do
  t <- peek
  b <- atBoundary
  if strEq t.kind "sym" && strEq t.text "::" && not b
      then do
        n <- next
        r <- g.pattern_
        pure (group (NTag "Cons" (spanOf t)) (Cons l (Cons r Nil)))
    else pure l

-- | a pattern: `C p ...`, or an atomic one; `x :: xs` is the `Cons` in
-- | scope, and binds right
patternF : Gram -> P Ntn
patternF g = do
  p <- patHeadF g
  consTailF g p

-- | `x`, `_`, `C` (with no arguments), a literal, `[...]`, `(p)`
patAtomF : Gram -> P Ntn
patAtomF g = do
  t <- peek
  b <- atBoundary
  if b then throwP (diag (spanOf t) "expected a pattern")
    else if strEq t.kind "var"
      then do
        n <- next
        pure (Ident t.text (spanOf t))
    else if strEq t.kind "con"
      then do
        n <- next
        -- (a capitalised parameter of the signature is a variable)
        isVar <- pGets (\s -> elemBy strEq t.text s.patVars)
        pure (if isVar then Ident t.text (spanOf t) else NTag t.text (spanOf t))
    else if strEq t.kind "tag"
      then do
        n <- next
        pure (NTag t.text (spanOf t))
    else if strEq t.kind "int"
      then do
        n <- next
        pure (NInt (intOfText t.text) (spanOf t))
    else if strEq t.kind "float"
      then do
        n <- next
        pure (NFloat (floatOfText t.text) (spanOf t))
    else if strEq t.kind "str"
      then do
        n <- next
        pure (NString t.text (spanOf t))
    else if strEq t.kind "punct" && strEq t.text "[" then listOfF g g.pattern_
    else if strEq t.kind "punct" && strEq t.text "("
      then do
        n <- next
        inBrackets (do
          p <- g.pattern_
          c <- expectPunct ")"
          pure p)
    else throwP (diag (spanOf t) ("expected a pattern, not " ++ shown t))

gram : Gram
gram =
  { expr = \st -> exprF gram st
  , opExprN = \minPrec st -> opExprF gram minPrec st
  , userOps = \st -> userOpsF gram st
  , app = \st -> appF gram st
  , atom = \st -> atomF gram st
  , pattern_ = \st -> patternF gram st
  , patAtom = \st -> patAtomF gram st
  , lambda_ = \st -> lambdaF gram st
  , caseE = \st -> caseExprF gram st
  , ifE = \st -> ifExprF gram st
  , doE = \st -> doExprF gram st
  }

expr : P Ntn
expr = \st -> gram.expr st

-- Declarations
--------------------------------------------------------------------------------

-- | what a top-level declaration is, before signatures meet equations:
-- | a signature (the name, where it is written, the type, where the
-- | signature is), an equation, or a declaration whole
data Item
  = Sig String Pm.Span Ntn Pm.Span Bool
  | Eqn String Ntn Pm.Span
  | Decl Ntn

-- | what a signature or an equation defines: `f`, `C`, or `(+)`
type DeclName = { name : String, len : Int, span : Pm.Span }

mkDeclName : String -> Int -> Pm.Span -> DeclName
mkDeclName name len span = { name = name, len = len, span = span }

declName : P (Maybe DeclName)
declName = do
  t <- peek
  t2 <- peekAt 1
  t3 <- peekAt 2
  pure
      (if strEq t.kind "var" || strEq t.kind "con"
         then Just (mkDeclName t.text 1 (spanOf t))
       else if strEq t.text "(" && isOperator t2 && strEq t3.text ")"
         then Just (mkDeclName t2.text 3 (spanOf t2))
       else Nothing)

bindersFor : St -> String -> List Binders
bindersFor s f = filter (\(b : Binders) -> strEq b.f f) s.binders

-- | `f p ... = e`
equation : DeclName -> P (List Item)
equation f = do
  start <- pGets (\s -> (cur s).start)
  pModify (\s -> setI (s.i + f.len) s)
  sig <- pGets (\s -> bindersFor s f.name)
  pModify (\s -> setPatVars (concatMapS (\(b : Binders) -> b.names) sig) s)
  pats <- many gram.patAtom
  pModify (\s -> setPatVars Nil s)
  eq <- expectSym "="
  -- (an implicit parameter is not written, but bound all the same, by
  -- the name the signature gives it)
  withScope
      (appendS
         (concatMapS patVarsOf pats)
         (concatMapS (\(b : Binders) -> b.implicits) sig)) (do
    rhs <- gram.expr
    pure
        (Cons
           (Eqn
              f.name
              (Infix
                 (group (Ident f.name f.span) pats)
                 (Keyword ":=" (mkSpan start (ntnSpan rhs).end))
                 rhs)
              (mkSpan start (ntnSpan rhs).end))
           Nil))

-- | a parameter of a type: `a` (a type), `(x : T)` or `{x : T}`
dataParam : P Ntn
dataParam = do
  t <- peek
  b <- atBoundary
  if b then throwP (diag (spanOf t) "no parameter here")
    else if strEq t.kind "con"
      then throwP
          (diag
             (spanOf t)
             ("a type's parameter is lower case, or given its type: `("
              ++ t.text
              ++ " :: Type)`"))
    else if strEq t.kind "var"
      then do
        n <- next
        pure
            (Infix
               (Ident t.text (spanOf t))
               (Keyword ":" (spanOf t))
               (Keyword "Type" (spanOf t)))
    else if strEq t.text "(" || strEq t.text "{"
      then do
        p0 <- gram.atom
        p <- if strEq t.text "(" then asBinder p0 else pure p0
        case p of
          Infix (Ident px psp) (Keyword ":" ksp) pty ->
            pure (Infix (Ident px psp) (Keyword ":" ksp) pty)
          NBlock "sig" Nothing (Cons (Infix (Ident px psp) (Keyword ":" ksp) pty) Nil) sp ->
            pure (NBrace (Infix (Ident px psp) (Keyword ":" ksp) pty) sp)
          _ ->
            throwP
              (diag (ntnSpan p) "a parameter is `a`, `(x : T)` or `{x : T}`")
    else throwP (diag (spanOf t) "no parameter here")

manyParams : List Ntn -> P (List Ntn)
manyParams acc = do
  b <- atBoundary
  t <- peek
  if b || not (startsItem t) then pure (reverse acc)
    else do
      x <- dataParam
      manyParams (Cons x acc)

dataAlternative : P Ntn
dataAlternative = do
  c <- next
  if strEq c.kind "con" || strEq c.kind "tag"
      then do
        args <- many gram.atom
        pure (group (NTag c.text (spanOf c)) args)
    else throwP (diag (spanOf c) "a constructor starts with a capital")

checkAltNames : String -> List Ntn -> P Unit
checkAltNames name Nil = pure MkUnit
checkAltNames name (Cons alt rest) = case (getGroup alt).head of
  NTag c csp ->
    if strEq c name
      then throwP
          (diag
             csp
             ("`"
              ++ c
              ++ "` names the type; its constructor needs another name, e.g. `Mk"
              ++ c
              ++ "`"))
    else checkAltNames name rest
  _ -> checkAltNames name rest

-- | `data T a = C x y | D`, and `data T : U = ...`
dataDecl : P Ntn
dataDecl = do
  kw <- next
  name <- expectKind "con" "the name of a type"
  params <- manyParams Nil
  withScope (concatMapS binderNames params) (do
    t0 <- peek
    universe <-
      if isAnnText t0.text && strEq t0.kind "sym"
        then do
          n <- next
          gram.app
      else pure (Keyword "Type" (spanOf name))
    t <- peek
    alts <-
      if strEq t.text "="
        then do
          n <- next
          sepBy1 "|" dataAlternative
      else pure Nil
    -- (a type is a term: its name cannot also be a constructor's)
    checkAltNames name.text alts
    end <- prevEnd
    pure
        (MDecl
           Nil
           "def"
           (Infix
              (Infix
                 (group (Ident name.text (spanOf name)) params)
                 (Keyword ":" (spanTE kw end))
                 universe)
              (Keyword ":=" (spanTE kw end))
              (NBlock "sum" Nothing alts (spanTE kw end)))
           (spanTE kw end)))

-- | `type T a = ...`
typeDecl : P Ntn
typeDecl = do
  kw <- next
  name <- expectKind "con" "the name of a type"
  params <- manyParams Nil
  eq <- expectSym "="
  withScope (concatMapS binderNames params) (do
    body <- gram.expr
    end <- prevEnd
    pure
        (MDecl
           Nil
           "def"
           (Infix
              (Infix
                 (group (Ident name.text (spanOf name)) params)
                 (Keyword ":" (spanTE kw end))
                 (Keyword "Type" (spanTE kw end)))
              (Keyword ":=" (spanTE kw end))
              body)
           (spanTE kw end)))

theoryField : P Ntn
theoryField = do
  x <- next
  if not (strEq x.kind "var" || strEq x.kind "con")
      then throwP (diag (spanOf x) "a field is `name : Type`")
    else do
      cc <- expectAnn
      ty <- gram.expr
      pModify (\s -> setScope (Cons x.text s.scope) s)
      pure (Infix (Ident x.text (spanOf x)) (Keyword ":" (spanOf x)) ty)

-- | `theory T a where` and its fields, each in scope in the next
theoryDecl : P Ntn
theoryDecl = do
  kw <- next
  name <- expectKind "con" "the name of a theory"
  params <- manyParams Nil
  w <- expectKw "where"
  withScope (concatMapS binderNames params) (do
    fields <- block theoryField
    end <- prevEnd
    pure
        (MDecl
           Nil
           "theory"
           (Infix
              (group (Ident name.text (spanOf name)) params)
              (Keyword ":=" (spanTE kw end))
              (NBlock "sig" Nothing fields (spanTE kw end)))
           (spanTE kw end)))

-- | `foreign import name : T`, a primitive
foreignDecl : P Ntn
foreignDecl = do
  kw <- next
  im <- expectKw "import"
  x <- expectKind "var" "the primitive's name"
  cc <- expectAnn
  ty <- gram.expr
  end <- prevEnd
  pure
      (MDecl
         Nil
         "primitive"
         (Infix (Ident x.text (spanOf x)) (Keyword ":" (spanTE kw end)) ty)
         (spanTE kw end))

skipFixity : P Unit
skipFixity = do
  u <- peek
  if strEq u.kind "eof" || (u.first && u.col == 0) then pure MkUnit
    else do
      n <- next
      skipFixity

declOf : Bool -> L.Tok -> Maybe DeclName -> P (List Item)
declOf inst t Nothing =
  throwP
    (diag (spanOf t) ("a declaration cannot start with `" ++ t.text ++ "`"))
declOf inst t (Just f) = do
  t2 <- peekAt f.len
  if isAnnText t2.text
      then do
        pModify (\s -> setI (s.i + f.len + 1) s)
        ty <- gram.expr
        end <- prevEnd
        pModify
            (\s ->
               setBinders
                 (Cons
                    (mkBinders f.name (piBinders ty) (piImplicits ty))
                    s.binders)
                 s)
        pure (Cons (Sig f.name f.span ty (spanTE t end) inst) Nil)
    else equation f

decl : P (List Item)
decl = do
  t <- peek
  if strEq t.kind "kw" && strEq t.text "data"
      then do
        d <- dataDecl
        pure (Cons (Decl d) Nil)
    else if strEq t.kind "kw" && strEq t.text "type"
      then do
        d <- typeDecl
        pure (Cons (Decl d) Nil)
    else if strEq t.kind "kw" && strEq t.text "theory"
      then do
        d <- theoryDecl
        pure (Cons (Decl d) Nil)
    else if strEq t.kind "kw" && strEq t.text "foreign"
      then do
        d <- foreignDecl
        pure (Cons (Decl d) Nil)
    -- (read before the rest, by `fixityDecls`)
    else if strEq t.kind "kw"
    && elemBy strEq t.text ["infixl", "infixr", "infix"]
      then do
        n <- next
        skipFixity
        pure Nil
    else if strEq t.kind "kw" && strEq t.text "test"
      then do
        n <- next
        x <- expectKind "var" "a test's name"
        pure
            (Cons
               (Decl (MDecl Nil "test" (Ident x.text (spanOf x)) (spanTT t x)))
               Nil)
    else if strEq t.kind "watch"
      then do
        n <- next
        e <- gram.expr
        end <- prevEnd
        pure (Cons (Decl (MDecl Nil ">" e (spanTE t end))) Nil)
    -- spike: `instance f : T` marks the signature's definition as a
    -- witness for instance search
    else if strEq t.kind "var" && strEq t.text "instance"
      then do
        t2 <- peekAt 1
        t3 <- peekAt 2
        if (strEq t2.kind "var" || strEq t2.kind "con") && isAnnText t3.text
            then do
              n <- next
              t2b <- peek
              name <- declName
              declOf True t2b name
          else do
            name <- declName
            declOf False t name
    else do
      name <- declName
      declOf False t name

-- The program
--------------------------------------------------------------------------------

-- | the names a file defines (so that a capitalised one is not a tag)
prescanGo : Array L.Tok -> Int -> List String -> List String
prescanGo ts k acc =
  if k >= A.length ts then reverse acc
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && strEq (A.index ts k).kind "kw"
  && elemBy strEq (A.index ts k).text ["data", "type", "theory"]
  && k + 1 < A.length ts
    then prescanGo ts (k + 1) (Cons (A.index ts (k + 1)).text acc)
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && (strEq (A.index ts k).kind "var" || strEq (A.index ts k).kind "con")
  && k + 1 < A.length ts
  && strEq (A.index ts (k + 1)).kind "sym"
  && isAnnText (A.index ts (k + 1)).text
    then prescanGo ts (k + 1) (Cons (A.index ts k).text acc)
  else prescanGo ts (k + 1) acc

prescan : Array L.Tok -> List String
prescan ts = prescanGo ts 0 Nil

-- Fixity declarations, read before the rest
--------------------------------------------------------------------------------

type FixDecl =
  { assoc : F.Assoc
  , ops : List L.Tok
  , above : List L.Tok
  , below : List L.Tok
  , errors : List Diag
  , span : Pm.Span
  }

restOfDecl : Array L.Tok -> Int -> List L.Tok -> List L.Tok
restOfDecl ts j acc =
  if j >= A.length ts then reverse acc
  else if strEq (A.index ts j).kind "eof"
  || ((A.index ts j).first && (A.index ts j).col == 0)
    then reverse acc
  else restOfDecl ts (j + 1) (Cons (A.index ts j) acc)

takeSyms : List L.Tok -> List L.Tok
takeSyms Nil = Nil
takeSyms (Cons u rest) =
  if strEq u.kind "sym" then Cons u (takeSyms rest) else Nil

dropN : {a : Type} -> Int -> List a -> List a
dropN n Nil = Nil
dropN n (Cons x rest) = if n <= 0 then Cons x rest else dropN (n - 1) rest

type AB = { above : List L.Tok, below : List L.Tok, errors : List Diag }

abGo : AB -> List L.Tok -> AB
abGo acc Nil = acc
abGo acc (Cons w tail) =
  if strEq w.kind "var" && strEq w.text "above"
    then abGo
        { above = appendS acc.above (takeSyms tail)
        , below = acc.below
        , errors = acc.errors
        }
        (dropN (length (takeSyms tail)) tail)
  else if strEq w.kind "var" && strEq w.text "below"
    then abGo
        { above = acc.above
        , below = appendS acc.below (takeSyms tail)
        , errors = acc.errors
        }
        (dropN (length (takeSyms tail)) tail)
  else { above = acc.above
       , below = acc.below
       , errors =
           Cons
             (diag
                (spanOf w)
                ("expected `above` or `below` and operators, not `"
                 ++ w.text
                 ++ "`"))
             acc.errors
       }

assocOf : String -> F.Assoc
assocOf "infixl" = AssocLeft
assocOf "infixr" = AssocRight
assocOf s = AssocNone

lastEnd : L.Tok -> List L.Tok -> Int
lastEnd t Nil = t.end
lastEnd t (Cons u Nil) = u.end
lastEnd t (Cons u rest) = lastEnd t rest

fixDeclDone : L.Tok -> List L.Tok -> List L.Tok -> AB -> FixDecl
fixDeclDone t rest ops r =
  { assoc = assocOf t.text
  , ops = ops
  , above = r.above
  , below = r.below
  , errors = reverse r.errors
  , span = mkSpan t.start (lastEnd t rest)
  }

fixDeclParts : L.Tok -> List L.Tok -> FixDecl
fixDeclParts t rest =
  fixDeclDone
    t
    rest
    (takeSyms rest)
    (abGo
       { above = Nil, below = Nil, errors = Nil }
       (dropN (length (takeSyms rest)) rest))

fixDeclOf : Array L.Tok -> Int -> L.Tok -> FixDecl
fixDeclOf ts k t = fixDeclParts t (restOfDecl ts (k + 1) Nil)

fixDeclAt : Array L.Tok -> Int -> L.Tok -> Maybe FixDecl
fixDeclAt ts k t =
  if t.first
  && t.col == 0
  && strEq t.kind "kw"
  && elemBy strEq t.text ["infixl", "infixr", "infix"]
    then Just (fixDeclOf ts k t)
  else Nothing

fixDecls : Array L.Tok -> Int -> List FixDecl -> List FixDecl
fixDecls ts k acc =
  if k >= A.length ts then reverse acc
  else case fixDeclAt ts k (A.index ts k) of
    Just d -> fixDecls ts (k + 1) (Cons d acc)
    Nothing -> fixDecls ts (k + 1) acc

groupOfDecl : FixDecl -> Maybe F.Group
groupOfDecl d = case d.ops of
  Nil -> Nothing
  Cons op rest ->
    Just
      { id = op.text
      , assoc = d.assoc
      , ops = map (\(u : L.Tok) -> u.text) d.ops
      }

mapMaybeG : {a : Type} -> (F.Group -> a) -> Maybe F.Group -> Maybe a
mapMaybeG f Nothing = Nothing
mapMaybeG f (Just g) = Just (f g)

mkEdge : String -> String -> F.Edge
mkEdge t l = { tighter = t, looser = l }

edgesOf : F.Fixities -> FixDecl -> List F.Edge
edgesOf scope d = case d.ops of
  Nil -> Nil
  Cons op rest ->
    appendS
      (catMaybesS
         (map
            (\(r : L.Tok) ->
               mapMaybeG (\g -> mkEdge op.text g.id) (F.groupOf scope r.text))
            d.above))
      (catMaybesS
         (map
            (\(r : L.Tok) ->
               mapMaybeG (\g -> mkEdge g.id op.text) (F.groupOf scope r.text))
            d.below))

anyS : {a : Type} -> (a -> Bool) -> List a -> Bool
anyS p Nil = False
anyS p (Cons x xs) = p x || anyS p xs

anyGroupHas : F.Fixities -> L.Tok -> L.Tok -> Bool
anyGroupHas all g u =
  anyS
    (\(h : F.Group) -> not (strEq h.id g.text) && elemBy strEq u.text h.ops)
    all.groups

cycleDiag : F.Fixities -> FixDecl -> List Diag
cycleDiag all d = case d.ops of
  Nil -> Nil
  Cons g rest ->
    appendS
      (map
         (\(u : L.Tok) ->
            diag
              (spanOf u)
              ("the fixity of `" ++ u.text ++ "` is declared twice"))
         (filter (\(u : L.Tok) -> anyGroupHas all g u) d.ops))
      (if F.bindsTighter all g.text g.text
         then Cons
             (diag
                d.span
                ("these fixities go round: `"
                 ++ g.text
                 ++ "` ends up above itself"))
             Nil
       else Nil)

noGroup : F.Fixities -> L.Tok -> Bool
noGroup scope u = case F.groupOf scope u.text of
  Just _ -> False
  Nothing -> True

fixDiagsOf : F.Fixities -> F.Fixities -> FixDecl -> List Diag
fixDiagsOf scope all d =
  appendS
    (map
       (\(u : L.Tok) ->
          diag (spanOf u) ("`" ++ u.text ++ "` is syntax, not an operator"))
       (filter (\(u : L.Tok) -> elemBy strEq u.text F.reserved) d.ops))
    (appendS
       (map
          (\(u : L.Tok) ->
             diag
               (spanOf u)
               ("`"
                ++ u.text
                ++ "` has no fixity to be above or below: declare it first"))
          (filter (\(u : L.Tok) -> noGroup scope u) (appendS d.above d.below)))
       (appendS
          (if length d.ops == 0
             then Cons
                 (diag
                    d.span
                    "a fixity declaration names its operators: `infixl + -`")
                 Nil
           else Nil)
          (appendS d.errors (cycleDiag all d))))

type FixRead = { fixities : F.Fixities, diags : List Diag }

fixityOut : F.Fixities -> List FixDecl -> List F.Group -> List F.Edge -> FixRead
fixityOut imported decls groups edges =
  { fixities = { groups = groups, above = edges }
  , diags =
      concatMapS
        (fixDiagsOf
           (F.union imported { groups = groups, above = Nil })
           (F.union imported { groups = groups, above = edges }))
        decls
  }

fixityDone : F.Fixities -> List FixDecl -> List F.Group -> FixRead
fixityDone imported decls groups =
  fixityOut
    imported
    decls
    groups
    (concatMapS
       (edgesOf (F.union imported { groups = groups, above = Nil }))
       decls)

fixityFrom : F.Fixities -> List FixDecl -> FixRead
fixityFrom imported decls =
  fixityDone
    imported
    decls
    (catMaybesS
       (map
          groupOfDecl
          (filter (\(d : FixDecl) -> not (length d.ops == 0)) decls)))

-- | the fixity declarations of a file, read before the rest
fixityDecls : F.Fixities -> Array L.Tok -> FixRead
fixityDecls imported ts = fixityFrom imported (fixDecls ts 0 Nil)

-- Signatures meet their equations
--------------------------------------------------------------------------------

defOf : Bool -> String -> Pm.Span -> Ntn -> Pm.Span -> List Ntn -> Ntn
defOf inst f fsp ty sp eqs =
  MDecl
    (if inst then Cons "instance" Nil else Nil)
    "def"
    (Infix
       (Ident f fsp)
       (Keyword ":" sp)
       (Juxt ty (NBlock "where" Nothing eqs sp)))
    sp

eqnsOf : String -> List Item -> List Ntn
eqnsOf f Nil = Nil
eqnsOf f (Cons (Eqn g e esp) rest) =
  if strEq g f then Cons e (eqnsOf f rest) else eqnsOf f rest
eqnsOf f (Cons _ rest) = eqnsOf f rest

eqnEnd : String -> List Item -> Int -> Int
eqnEnd f Nil e = e
eqnEnd f (Cons (Eqn g _ esp) rest) e =
  if strEq g f then eqnEnd f rest (maxI e esp.end) else eqnEnd f rest e
eqnEnd f (Cons _ rest) e = eqnEnd f rest e

assembleOne : List String -> List Item -> Item -> Maybe Ntn
assembleOne broken items (Decl n) = Just n
assembleOne broken items (Sig f fsp ty sp inst) =
  if elemBy strEq f broken
    then Just
        (defOf
           inst
           f
           fsp
           ty
           sp
           (Cons
              (Infix (Ident f fsp) (Keyword ":=" sp) (Keyword "abandon" sp))
              Nil))
  else if length (eqnsOf f items) == 0 then Nothing
  else Just
      (defOf
         inst
         f
         fsp
         ty
         (mkSpan sp.start (eqnEnd f items sp.end))
         (eqnsOf f items))
assembleOne broken items (Eqn _ _ _) = Nothing

assemble : List String -> List Item -> List Ntn
assemble broken items =
  catMaybesS (map (\it -> assembleOne broken items it) items)

sigNames : List Item -> List String
sigNames Nil = Nil
sigNames (Cons (Sig f _ _ _ _) rest) = Cons f (sigNames rest)
sigNames (Cons _ rest) = sigNames rest

eqnNames : List Item -> List String
eqnNames Nil = Nil
eqnNames (Cons (Eqn f _ _) rest) = Cons f (eqnNames rest)
eqnNames (Cons _ rest) = eqnNames rest

assembleDiagOne : List String
                -> List String
                -> List String
                -> Item
                -> Maybe Diag
assembleDiagOne broken sigs eqns (Sig f _ _ sp _) =
  if not (elemBy strEq f eqns) && not (elemBy strEq f broken)
    then Just (diag sp ("`" ++ f ++ "` has a type but no definition"))
  else Nothing
assembleDiagOne broken sigs eqns (Eqn f _ sp) =
  if not (elemBy strEq f sigs) && not (elemBy strEq f broken)
    then Just (diag sp ("`" ++ f ++ "` needs a type: `" ++ f ++ " : ...`"))
  else Nothing
assembleDiagOne broken sigs eqns (Decl _) = Nothing

assembleDiags : List String -> List Item -> List Diag
assembleDiags broken items =
  catMaybesS
    (map (assembleDiagOne broken (sigNames items) (eqnNames items)) items)

-- The program loop
--------------------------------------------------------------------------------

type ProgRes = { items : List Item, diags : List Diag, broken : List String }

skipFrom : St -> St
skipFrom s = if strEq (cur s).kind "eof" then s else skipFrom (setI (s.i + 1) s)

-- | on to the next declaration (the first token of this one, at least)
skipDecl : St -> St
skipDecl s =
  skipFrom
    (setScope Nil (setStack (Cons 0 Nil) (setI (maxI s.i (s.top + 1)) s)))

declaredOne : L.Tok -> Maybe String
declaredOne t =
  if strEq t.kind "var" || strEq t.kind "con" then Just t.text else Nothing

declaredTwo : L.Tok -> L.Tok -> Maybe String
declaredTwo t u =
  if strEq t.kind "kw" && elemBy strEq t.text ["data", "type", "theory"]
    then Just u.text
  else if strEq t.text "(" && strEq u.kind "sym" then Just u.text
  else declaredOne t

-- | the name the declaration starting at `top` defines, as far as it says
declaredAt : St -> Maybe String
declaredAt s =
  if s.top + 1 < A.length s.toks
    then declaredTwo (A.index s.toks s.top) (A.index s.toks (s.top + 1))
  else if s.top < A.length s.toks then declaredOne (A.index s.toks s.top)
  else Nothing

progReset : St -> St
progReset s = setScope Nil (setStack (Cons 0 Nil) (setStart s.i (setTop s.i s)))

withSt : {a : Type} -> St -> (St -> a) -> a
withSt st k = k st

appendRev : {a : Type} -> List a -> List a -> List a
appendRev Nil acc = acc
appendRev (Cons x xs) acc = appendRev xs (Cons x acc)

brokenPlus : Maybe String -> List String -> List String
brokenPlus Nothing broken = broken
brokenPlus (Just x) broken = Cons x broken

mkProgRes : List Item -> List Diag -> List String -> ProgRes
mkProgRes items diags broken = { items = items, diags = diags, broken = broken }

progGo : St -> List Item -> List Diag -> List String -> ProgRes
progGo s0 items diags broken =
  withSt
    (progReset s0)
    (\s ->
       if strEq (cur s).kind "eof"
         then mkProgRes (reverse items) (reverse diags) (reverse broken)
       else case decl s of
         MkPair (Right ds) s2 ->
           if strEq (cur s2).kind "eof"
             then progGo s2 (appendRev ds items) diags broken
           else progGo
               (skipDecl s2)
               (appendRev ds items)
               (Cons
                  (diag
                     (spanOf (cur s2))
                     ("unexpected `" ++ (cur s2).text ++ "`"))
                  diags)
               broken
         MkPair (Left d) s2 ->
           progGo
             (skipDecl s2)
             items
             (Cons d diags)
             (brokenPlus (declaredAt s2) broken))

-- Entry points
--------------------------------------------------------------------------------

type Options = { known : String -> Bool, fixities : F.Fixities, lenient : Bool }

type Read =
  { ntns : List Ntn
  , diags : List Diag
  , fixities : F.Fixities
  , broken : List String
  }

lexDiagOf : L.Err -> Diag
lexDiagOf e =
  { code = 150
  , severity = SError
  , msg = e.msg
  , span = { start = e.start, end = e.end }
  , note = Nothing
  }

initialSt : Options -> Array L.Tok -> List String -> F.Fixities -> St
initialSt o toks declared own =
  { toks = toks
  , i = 0
  , top = 0
  , stack = Cons 0 Nil
  , scope = Nil
  , known = \x -> o.known x || elemBy strEq x declared
  , start = 0
  , binders = Nil
  , patVars = Nil
  , fix = F.union o.fixities own
  , lenient = o.lenient
  }

readOut : List Diag -> FixRead -> ProgRes -> Read
readOut lexDiags own r =
  { ntns = assemble r.broken r.items
  , diags =
      appendS
        lexDiags
        (appendS own.diags (appendS r.diags (assembleDiags r.broken r.items)))
  , fixities = own.fixities
  , broken = r.broken
  }

readRun : Options -> Array L.Tok -> List Diag -> List String -> FixRead -> Read
readRun o toks lexDiags declared own =
  readOut
    lexDiags
    own
    (progGo (initialSt o toks declared own.fixities) Nil Nil Nil)

readToks : Options -> Array L.Tok -> List Diag -> Read
readToks o toks lexDiags =
  readRun o toks lexDiags (prescan toks) (fixityDecls o.fixities toks)

readLexed : Options -> L.Lexed -> Read
readLexed o l = readToks o (A.fromList l.tokens) (map lexDiagOf l.errors)

-- | `fixities`: those of what the file imports; the result's, the file's
-- | own.  `broken`: the declarations that do not parse.
readProgramWith : Options -> String -> Read
readProgramWith o src = readLexed o (L.lex src)

-- | the program, as declarations the elaborator takes
readProgram : (String -> Bool) -> String -> Read
readProgram known src =
  readProgramWith
    { known = known, fixities = F.emptyFixities, lenient = False }
    src

noKnown : String -> Bool
noKnown x = False

-- >>> length (readProgram noKnown "idInt : Int -> Int\nidInt x = x\n").ntns
-- 1

-- >>> length (readProgram noKnown "data Color = Red | Green\n\nnext : Color -> Color\nnext c = case c of\n  Red -> Green\n  Green -> Red\n").ntns
-- 2

-- >>> length (readProgram noKnown "x : Int\nx = ) oops\n").diags
-- 1
