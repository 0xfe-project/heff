-- The metavariable layer in the elaboration monad: a port of
-- `Heff.Elab.Unify`'s `E` half -- forcing, fresh metavariables,
-- unification entered from `E`, postponed problems and delayed checks
-- settled together, unsolved metavariables reported.  `do` here is
-- compiler/environment.hf's `bind`.

import array as A
import compiler.conversion as C
import compiler.environment
import compiler.eval as EV
import compiler.globals as G
import compiler.params as P
import compiler.readback as R
import compiler.syntax as Sx
import compiler.unify as U
import compiler.value as V
import map as M
import prelude

force : V.V -> E V.V
force v = gets (\st -> V.forceEl (core st).metas v)

forceT : V.Ty -> E V.Ty
forceT t = gets (\st -> V.forceTy (core st).metas t)

liftStep : {a : Type}
         -> Pair (Either C.EqErr a) ElabSt
         -> Pair (Either Diag (Either C.EqErr a)) ElabSt
liftStep (MkPair r st) = MkPair (Right r) st

-- | a unification, from the elaboration monad: its failure is a value
liftU : {a : Type} -> U.U a -> E (Either C.EqErr a)
liftU u = \st -> liftStep (u st)

unifyTy : G.Globals -> P.CtxShape -> V.Ty -> V.Ty -> E (Either C.EqErr Unit)
unifyTy g cs a b = liftU (U.uTy g cs a b)

unifyEl : G.Globals -> P.CtxShape -> V.V -> V.V -> E (Either C.EqErr Unit)
unifyEl g cs a b = liftU (U.uEl g cs a b)

blockedFlex : M.Map Int Unit -> V.Ty -> Bool
blockedFlex ps a = case U.flexTy a of
  Just (MkPair m _) -> M.member compareInt m ps
  Nothing -> False

-- | is a type one nothing can be asked of, for an error elsewhere: an
-- | error hole's, or a metavariable an error hole kept from being solved?
blockedTy : V.Ty -> E Bool
blockedTy a0 = do
  a <- forceT a0
  gets (\st -> V.isErrorTy a || blockedFlex (core st).poisoned a)

downFrom : Int -> List Int
downFrom n = if n < 0 then Nil else Cons n (downFrom (n - 1))

type Fresh = { stx : Sx.Tm, val : V.V }

-- | A metavariable of type `ty`, applied to every local in scope (so its
-- | solution may mention them).  `len` locals are in scope, with values
-- | `locals`.
freshMeta : Int -> V.Locals V.V -> V.Ty -> String -> P.Span -> E Fresh
freshMeta len locals ty name sp = do
  m <- gets (\st -> (core st).nextMeta)
  modify
      (withCore
         (\c ->
            setMetas
              (M.insert
                 compareInt
                 m
                 { ty = ty
                 , sol = Nothing
                 , solStx = Nothing
                 , arity = len
                 , name = name
                 , span = sp
                 }
                 c.metas)
              (m + 1)
              c))
  traceE sp "meta"
  pure
      { stx = SMetaApp m (A.fromList (downFrom (len - 1))) (R.readbTy len ty)
      , val =
          V.metaEl
            m
            (foldl
               (\sp' i -> SpApp sp' (V.localsAt locals i))
               SpId
               (downFrom (len - 1)))
            ty
      }

type Unsolved = { name : String, span : P.Span }

keepUnsolved : List Unsolved -> V.MetaEntry -> List Unsolved
keepUnsolved acc e = case e.sol of
  Nothing -> Cons { name = e.name, span = e.span } acc
  Just _ -> acc

-- | the metavariables that were created and never solved
unsolvedMetas : E (List Unsolved)
unsolvedMetas =
  gets (\st -> reverse (foldl keepUnsolved Nil (M.values (core st).metas)))

-- Postponed problems and delayed checks
--------------------------------------------------------------------------------

keepFailed : Postponed -> Either C.EqErr Unit -> E Unit
keepFailed p (Left _) =
  modify
    (withCore
       (\c ->
          setPostponed
            (Cons
               { shape = p.shape
               , left = p.left
               , right = p.right
               , failed = True
               }
               c.postponed)
            c))
keepFailed p (Right _) = pure MkUnit

retryEach : G.Globals -> List Postponed -> E Unit
retryEach g Nil = pure MkUnit
retryEach g (Cons p rest) = do
  r <- liftU (U.uEl g p.shape p.left p.right)
  keepFailed p r
  retryEach g rest

retryGo : G.Globals -> Int -> E (List Postponed)
retryGo g fuel = do
  ps <- gets (\st -> reverse (core st).postponed)
  modify (withCore (setPostponed Nil))
  retryEach g ps
  left <- gets (\st -> (core st).postponed)
  if length left == 0 || length left == length ps || fuel > 50
      then pure (reverse left)
      else retryGo g (fuel + 1)

-- | Retry the postponed problems until no more are solved; a problem
-- | that fails outright is kept, to be reported as stuck: it holds the
-- | contradiction.
retryPostponed : G.Globals -> E (List Postponed)
retryPostponed g = retryGo g 0

delayedReady : V.MetaCtx -> Bool -> Delayed ElabSt -> Bool
delayedReady mc all (MkDelayed ty chk) =
  all || not (U.isFlexTy (V.forceTy mc ty))

runCheckOf : Delayed ElabSt -> E Unit
runCheckOf (MkDelayed ty chk) = \st -> chk st

runEach : List (Delayed ElabSt) -> E Unit
runEach Nil = pure MkUnit
runEach (Cons d rest) = do
  runCheckOf d
  runEach rest

-- | Run the delayed checks whose types are now known (and those they
-- | delay in turn); with `all`, every one, known or not.
runDelayed : Bool -> E Unit
runDelayed all = do
  ds <- gets delayedOf
  mc <- gets (\st -> (core st).metas)
  if length (filter (delayedReady mc all) ds) == 0
      then pure MkUnit
      else do
        modify
            (withDelayed
               (\old -> filter (\d -> not (delayedReady mc all d)) ds))
        runEach (filter (delayedReady mc all) ds)
        runDelayed all

anyDelayed : V.MetaCtx -> List (Delayed ElabSt) -> Bool
anyDelayed mc Nil = False
anyDelayed mc (Cons d rest) = delayedReady mc False d || anyDelayed mc rest

settleGo : G.Globals -> Int -> E (List Postponed)
settleGo g fuel = do
  runDelayed False
  retryPostponed g
  ds <- gets delayedOf
  mc <- gets (\st -> (core st).metas)
  if anyDelayed mc ds && fuel <= 50
      then settleGo g (fuel + 1)
      else do
        runDelayed True
        retryPostponed g

-- | Let the postponed problems and the delayed checks feed one another
-- | until neither moves; then force what is left, and retry once more.
settle : G.Globals -> E (List Postponed)
settle g = settleGo g 0

fillHole : G.Globals -> Int -> V.MetaEntry -> Fresh -> E Unit
fillHole g m e arg =
  modify
    (withCore
       (\c ->
          setMetas
            (M.insert
               compareInt
               m
               { ty = e.ty
               , sol = Just (V.nom (EV.eval g N (U.lamsU e.arity arg.stx) LNil))
               , solStx = Just (U.lamsU e.arity arg.stx)
               , arity = e.arity
               , name = e.name
               , span = e.span
               }
               c.metas)
            c.nextMeta
            c))

-- | The hole standing for a delayed argument, filled with the argument
-- | once it is checked.  If unification got there first, the two must
-- | agree.
solveHole : G.Globals
          -> P.CtxShape
          -> Int
          -> V.V
          -> Fresh
          -> E (Either C.EqErr Unit)
solveHole g cs m holeVal arg = do
  mc <- gets (\st -> (core st).metas)
  case M.lookup compareInt m mc of
    Just e -> case e.sol of
      Nothing -> do
        fillHole g m e arg
        pure (Right MkUnit)
      Just _ -> unifyEl g cs holeVal arg.val
    Nothing -> unifyEl g cs holeVal arg.val

-- >>> downFrom 2
-- [2, 1, 0]
