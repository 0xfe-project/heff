-- A file and every module it imports, directly or not, each after what
-- it imports, over the fs effect.  A module
-- `foo.bar` is looked for at `foo/bar.hf` under the project's root
-- (the nearest directory above the file whose package.json has a
-- "heff" field), then under the library, then under the root's
-- `node_modules/`.

import co
import compiler.driver as Dr
import compiler.import as I
import fs
import prelude

dotsGo : String -> Int -> String -> String
dotsGo p i acc =
  if i >= strLength p then acc
  else if charCode p i == 47 then dotsGo p (i + 1) (acc ++ ".")
  else dotsGo p (i + 1) (acc ++ strSlice p i (i + 1))

dotsOf : String -> String
dotsOf p = dotsGo p 0 ""

dropHf : String -> String
dropHf p = if endsWith ".hf" p then strSlice p 0 (strLength p - 3) else p

-- | where the project is, and where the standard library
type Paths = { root : String, lib : String }

-- | the working directory's project, the library at `lib/`
here : Paths
here = { root = ".", lib = "lib" }

-- (a path under a directory: under `.`, the path itself)
dirPrefix : String -> String
dirPrefix d = if strEq d "." then "" else d ++ "/"

under : String -> String -> String
under d p = dirPrefix d ++ p

dropPrefix : String -> String -> Maybe String
dropPrefix pre s =
  if startsWith pre s then Just (strSlice s (strLength pre) (strLength s))
  else Nothing

-- | the module a file of the project is; one of the standard library is
-- | the library's (`lib/co.hf` is `co`), wherever the project's root is;
-- | `compiler/dict.hf` is `compiler.dict`
moduleOf : Paths -> String -> String
moduleOf ps path =
  dotsOf
    (dropHf (case dropPrefix (dirPrefix ps.lib) path of
     Just rel -> rel
     Nothing -> case dropPrefix (dirPrefix ps.root ++ "node_modules/") path of
       Just rel -> rel
       Nothing -> case dropPrefix (dirPrefix ps.root) path of
         Just rel -> rel
         Nothing -> path))

-- (where the last `/` is, from `i` down)
lastSlash : String -> Int -> Maybe Int
lastSlash p i =
  if i < 0 then Nothing
  else if charCode p i == 47 then Just i
  else lastSlash p (i - 1)

dirname : String -> String
dirname p = case lastSlash p (strLength p - 1) of
  Just 0 -> "/"
  Just i -> strSlice p 0 i
  Nothing -> "."

isRoot : {e : HFunctor} -> {{ev : fs <: e}} -> String -> Co e Bool
isRoot d = do
  pkg <- readFile (under d "package.json")
  val (case pkg of
    Just txt -> contains "\"heff\"" txt
    Nothing -> False)

rootFrom : {e : HFunctor} -> {{ev : fs <: e}} -> String -> String -> Co e String
rootFrom start d = do
  found <- isRoot d
  if found then val d
    else if strEq d "/" || strEq d "." || strEq d "" then val start
    else rootFrom start (dirname d)

-- | the paths of the project `file` is in, with the library at `lib`
pathsFor : {e : HFunctor} -> {{ev : fs <: e}} -> String -> String -> Co e Paths
pathsFor lib file = do
  root <- rootFrom (dirname file) (dirname file)
  val { root = root, lib = lib }

slashGo : String -> Int -> String -> String
slashGo m i acc =
  if i >= strLength m then acc
  else if charCode m i == 46 then slashGo m (i + 1) (acc ++ "/")
  else slashGo m (i + 1) (acc ++ strSlice m i (i + 1))

-- | where a module's file is: `foo.bar` is `foo/bar.hf`
importPath : String -> String
importPath m = slashGo m 0 "" ++ ".hf"

elemL : String -> List String -> Bool
elemL x xs = elemBy strEq x xs

type LoadSt =
  { done : List Dr.Source, doneMods : List String, errors : List String }

emptySt : LoadSt
emptySt = { done = Nil, doneMods = Nil, errors = Nil }

addErr : LoadSt -> String -> LoadSt
addErr st e =
  { done = st.done
  , doneMods = st.doneMods
  , errors = concatList st.errors (Cons e Nil)
  }

pushDone : LoadSt -> String -> String -> String -> LoadSt
pushDone st m path src =
  { done =
      concatList st.done (Cons { module = m, path = path, source = src } Nil)
  , doneMods = Cons m st.doneMods
  , errors = st.errors
  }

-- (the module's file, read: under the root, else the library, else
-- the root's node_modules/)
type Found = { path : String, source : String }

inRoot : Paths -> String -> String
inRoot ps m = under ps.root (importPath m)

inLib : Paths -> String -> String
inLib ps m = under ps.lib (importPath m)

inPkg : Paths -> String -> String
inPkg ps m = under ps.root ("node_modules/" ++ importPath m)

-- (the first of the paths that reads, by `read`)
readFirst : {e : HFunctor}
          -> (String -> Co e (Maybe String))
          -> List String
          -> Co e (Maybe Found)
readFirst read Nil = val Nothing
readFirst read (Cons path rest) = do
  a <- read path
  case a of
    Just s -> val (Just { path = path, source = s })
    Nothing -> readFirst read rest

readFound : {e : HFunctor}
          -> {{ev : fs <: e}}
          -> List String
          -> Co e (Maybe Found)
readFound paths = readFirst (\p -> readFile p) paths

cycleMsg : String -> String -> List String -> String
cycleMsg from m stack =
  from
  ++ ": importing "
  ++ m
  ++ " is a cycle: "
  ++ joinWith " -> " (concatList (reverse stack) (Cons m Nil))

missingMsg : Paths -> String -> String -> String
missingMsg ps from m =
  from
  ++ ": no module "
  ++ m
  ++ " (looked for "
  ++ inRoot ps m
  ++ ", "
  ++ inLib ps m
  ++ " and "
  ++ inPkg ps m
  ++ ")"

-- | the modules `ms`, imported by `from`, each visited after what it
-- | imports (`stack`: the modules being visited, newest first), each
-- | file read by `read`
loadMany : {e : HFunctor}
         -> (String -> Co e (Maybe String))
         -> Paths
         -> List String
         -> String
         -> List String
         -> LoadSt
         -> Co e LoadSt
loadMany read ps stack from Nil st = val st
loadMany read ps stack from (Cons m rest) st =
  if elemL m st.doneMods then loadMany read ps stack from rest st
  else if elemL m stack
    then loadMany read ps stack from rest (addErr st (cycleMsg from m stack))
  else do
    found <- readFirst read [inRoot ps m, inLib ps m, inPkg ps m]
    case found of
      Nothing ->
        loadMany read ps stack from rest (addErr st (missingMsg ps from m))
      Just found2 -> do
        inner <-
          loadMany
            read
            ps
            (Cons m stack)
            found2.path
            (Dr.importNames (I.readImports found2.source).imports)
            st
        loadMany
            read
            ps
            stack
            from
            rest
            (pushDone inner m found2.path found2.source)

type Loaded = { sources : List Dr.Source, errors : List String, paths : Paths }

loadDone : Paths -> LoadSt -> Loaded
loadDone ps st = { sources = st.done, errors = st.errors, paths = ps }

-- | the program rooted at `file`, the library at `lib`, each file read
-- | by `read` (an editor's unsaved text, say): its sources in dependency
-- | order, what could not be found, and where it looked
loadProgramWith : {e : HFunctor}
                -> {{ev : fs <: e}}
                -> (String -> Co e (Maybe String))
                -> String
                -> String
                -> Co e Loaded
loadProgramWith read lib file = do
  ps <- pathsFor lib file
  mSrc <- read file
  case mSrc of
    Nothing -> val (loadDone ps (addErr emptySt ("cannot read " ++ file)))
    Just src -> do
      st <-
        loadMany
          read
          ps
          (Cons (moduleOf ps file) Nil)
          file
          (Dr.importNames (I.readImports src).imports)
          emptySt
      val (loadDone ps (pushDone st (moduleOf ps file) file src))

-- | ... each file read from the disk
loadProgram : {e : HFunctor}
            -> {{ev : fs <: e}}
            -> String
            -> String
            -> Co e Loaded
loadProgram lib file = loadProgramWith (\p -> readFile p) lib file
