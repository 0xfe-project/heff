-- Calls with all their arguments at once: a port of `Heff.Lower.Arity`.
-- A definition that is a function of `n` parameters is called directly
-- (`ECall`) wherever it is given `n` arguments or more; the same for
-- primitives.

import compiler.ir as I
import compiler.prims as Pr
import map as M
import prelude

arityOne : M.Map String Int -> I.Def -> M.Map String Int
arityOne m d = case d.body of
  ELam xs _ -> M.insert compareString d.key (length xs) m
  _ -> m

-- | the definitions that are functions, and of how many parameters
arities : List I.Def -> M.Map String Int
arities defs = foldl arityOne M.empty defs

takeA : {a : Type} -> Int -> List a -> List a
takeA n Nil = Nil
takeA n (Cons x xs) = if n <= 0 then Nil else Cons x (takeA (n - 1) xs)

dropA : {a : Type} -> Int -> List a -> List a
dropA n Nil = Nil
dropA n (Cons x xs) = if n <= 0 then Cons x xs else dropA (n - 1) xs

restOf : I.Expr -> List I.Expr -> I.Expr
restOf f as = if length as == 0 then f else EApp f as

type SK = { go : I.Expr -> I.Expr }

callOf : SK -> M.Map String Int -> I.Expr -> List I.Expr -> I.Expr
callOf r ar h as = case h of
  EGlobal g -> case M.lookup compareString g ar of
    Just n ->
      if length as >= n
        then restOf (ECall g (takeA n as)) (dropA n as)
        else EApp (r.go h) as
    Nothing -> EApp (r.go h) as
  EPrim p -> case Pr.primArity p of
    Just n ->
      if length as >= n
        then restOf (EPrimCall p (takeA n as)) (dropA n as)
        else EApp (r.go h) as
    Nothing -> EApp (r.go h) as
  _ -> EApp (r.go h) as

satGo : SK -> M.Map String Int -> I.Expr -> I.Expr
satGo r ar e = case e of
  EApp f as0 -> case I.spine (EApp f as0) of
    MkPair h as -> callOf r ar h (map (\a -> r.go a) as)
  ELam xs b -> ELam xs (r.go b)
  ELet x a b -> ELet x (r.go a) (r.go b)
  ERecord fs ->
    ERecord
      (map
         (\p -> case p of
          MkPair l e2 -> MkPair l (r.go e2))
         fs)
  EProj e2 l -> EProj (r.go e2) l
  ETag t as -> ETag t (map (\a -> r.go a) as)
  EMatch s arms ->
    EMatch
      (r.go s)
      (map
         (\a -> case a of
          MkArm t vs b -> MkArm t vs (r.go b))
         arms)
  EPrimCall p as -> EPrimCall p (map (\a -> r.go a) as)
  ECall g as -> ECall g (map (\a -> r.go a) as)
  _ -> e

satOf : M.Map String Int -> SK
satOf ar = { go = \e -> satGo (satOf ar) ar e }

saturate : M.Map String Int -> I.Def -> I.Def
saturate ar d = { key = d.key, name = d.name, body = (satOf ar).go d.body }

-- >>> (saturate (arities [{ key = "f", name = "f", body = ELam ["x", "y"] (EVar "x") }]) { key = "g", name = "g", body = EApp (EGlobal "f") [EInt 1, EInt 2] }).body
-- ECall "f" [EInt 1, EInt 2]
