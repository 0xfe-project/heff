-- The IR (`compiler.lower`) to JavaScript: a port of
-- `Heff.Compile.JavaScript` -- an ES module.  Emitting is all this does
-- -- what is erased, inlined, dropped or called at once was decided
-- before.
--
--   tag      T a b    ~>  { $: "T", a: [a, b] }
--   record   { l = e } ~> { l: e }
--   match             ~>  a `switch` on `$`
--   a definition of n parameters  ~>  a function of n parameters (and,
--            where it is passed on, `name$c`, its curried form)
--   a definition that is not a function  ~>  a constant, or (if
--            computing it may fail) computed once, when first used
--
-- Arguments are evaluated before the call (call-by-value); the
-- interpreter is lazy.

import compiler.effect as Ef
import compiler.globals as G
import compiler.ir as I
import compiler.lower as L
import compiler.prims as Pr
import map as M
import prelude

type Output = { source : String, errors : List String }

type Export = { name : String, key : String }

mkExport : String -> String -> Export
mkExport name key = { name = name, key = key }

catMaybesL : {a : Type} -> List (Maybe a) -> List a
catMaybesL Nil = Nil
catMaybesL (Cons (Just x) xs) = Cons x (catMaybesL xs)
catMaybesL (Cons Nothing xs) = catMaybesL xs

elemStr : String -> List String -> Bool
elemStr x xs = elemBy strEq x xs

nubGo : List String -> List String -> List String
nubGo seen Nil = Nil
nubGo seen (Cons x xs) =
  if elemStr x seen then nubGo seen xs else Cons x (nubGo (Cons x seen) xs)

nubStr : List String -> List String
nubStr xs = nubGo Nil xs

unsnocCons : {a : Type} -> a -> Pair (List a) a -> Pair (List a) a
unsnocCons y (MkPair ini lst) = MkPair (Cons y ini) lst

unsnocGo : {a : Type} -> List a -> a -> Pair (List a) a
unsnocGo Nil y = MkPair Nil y
unsnocGo (Cons z rest) y = unsnocCons y (unsnocGo rest z)

-- | the list but its last element, and that element
unsnocE : {a : Type} -> List a -> Maybe (Pair (List a) a)
unsnocE Nil = Nothing
unsnocE (Cons x rest) = Just (unsnocGo rest x)

-- Names
--------------------------------------------------------------------------------

escAt : String -> Int -> String
escAt s i =
  if charCode s i == 34 then "\\\""
  else if charCode s i == 92 then "\\\\"
  else if charCode s i == 10 then "\\n"
  else if charCode s i == 13 then "\\r"
  else if charCode s i == 9 then "\\t"
  else strSlice s i (i + 1)

quoteGo : String -> Int -> String -> String
quoteGo s i acc =
  if i >= strLength s then acc else quoteGo s (i + 1) (acc ++ escAt s i)

quoteString : String -> String
quoteString s = "\"" ++ quoteGo s 0 "" ++ "\""

-- (an operator's characters as words, for the languages compiled to)
wordOf : Int -> Maybe String
wordOf c =
  if c == 43 then Just "plus"
  else if c == 45 then Just "minus"
  else if c == 42 then Just "times"
  else if c == 47 then Just "slash"
  else if c == 37 then Just "percent"
  else if c == 61 then Just "eq"
  else if c == 60 then Just "lt"
  else if c == 62 then Just "gt"
  else if c == 38 then Just "amp"
  else if c == 124 then Just "bar"
  else if c == 33 then Just "bang"
  else if c == 94 then Just "caret"
  else if c == 63 then Just "q"
  else if c == 64 then Just "at"
  else if c == 35 then Just "hash"
  else if c == 36 then Just "dollar"
  else if c == 126 then Just "tilde"
  else if c == 58 then Just "colon"
  else if c == 46 then Just "dot"
  else if c == 92 then Just "backslash"
  else Nothing

operatorGo : String -> Int -> List String -> Maybe (List String)
operatorGo x i acc =
  if i >= strLength x then Just (reverse acc)
  else case wordOf (charCode x i) of
    Just w -> operatorGo x (i + 1) (Cons w acc)
    Nothing -> Nothing

operatorDone : Maybe (List String) -> Maybe String
operatorDone (Just ws) = Just ("op_" ++ joinWith "_" ws)
operatorDone Nothing = Nothing

-- | an operator's name as a word: `+` is `op_plus`, `<=` `op_lt_eq`;
-- | nothing for a name that is not an operator
operatorName : String -> Maybe String
operatorName x =
  if strEq x "" then Nothing else operatorDone (operatorGo x 0 Nil)

lastDotFrom : String -> Int -> Maybe Int
lastDotFrom s i =
  if i < 0 then Nothing
  else if charCode s i == 46 then Just i
  else lastDotFrom s (i - 1)

spellAt : String -> Maybe Int -> String
spellAt k (Just i) = case operatorName (strSlice k (i + 1) (strLength k)) of
  Just w -> strSlice k 0 (i + 1) ++ w
  Nothing -> fromMaybe k (operatorName k)
spellAt k Nothing = fromMaybe k (operatorName k)

-- | a name, or a key (`module.name`), with its name spelt out if it is
-- | an operator: `prelude.+` is `prelude.op_plus`
spellOperator : String -> String
spellOperator k = spellAt k (lastDotFrom k (strLength k - 1))

reserved : List String
reserved =
  [ "break"
  , "case"
  , "catch"
  , "class"
  , "const"
  , "continue"
  , "debugger"
  , "default"
  , "delete"
  , "do"
  , "else"
  , "enum"
  , "export"
  , "extends"
  , "false"
  , "finally"
  , "for"
  , "function"
  , "if"
  , "import"
  , "in"
  , "instanceof"
  , "new"
  , "null"
  , "return"
  , "super"
  , "switch"
  , "this"
  , "throw"
  , "true"
  , "try"
  , "typeof"
  , "var"
  , "void"
  , "while"
  , "with"
  , "yield"
  , "let"
  , "static"
  , "implements"
  , "interface"
  , "package"
  , "private"
  , "protected"
  , "public"
  , "await"
  , "arguments"
  , "eval"
  , "undefined"
  , "NaN"
  , "Infinity"
  , "document"
  , "window"
  , "BigInt"
  , "String"
  , "Number"
  , "Object"
  , "Error"
  , "Math"
  , "JSON"
  , "setTimeout"
  , "fetch"
  , "process"
  , "console"
  , "globalThis"
  , "Promise"
  , "Array"
  , "Map"
  , "Set"
  , "Date"
  , "Symbol"
  , "RegExp"
  , "Buffer"
  , "setImmediate"
  , "queueMicrotask"
  , "structuredClone"
  , "URL"
  , "TextEncoder"
  , "TextDecoder"
  ]

isWordCode : Int -> Bool
isWordCode c =
  (97 <= c && c <= 122)
  || (65 <= c && c <= 90)
  || (48 <= c && c <= 57)
  || c == 95

safeChars : String -> Int -> String -> String
safeChars x i acc =
  if i >= strLength x then acc
  else safeChars
      x
      (i + 1)
      (acc ++ (if isWordCode (charCode x i) then strSlice x i (i + 1) else "_"))

safeRes : String -> String
safeRes s =
  if elemStr s reserved || (48 <= charCode s 0 && charCode s 0 <= 57)
    then "_" ++ s
  else s

safeFrom : String -> String
safeFrom s = safeRes (if strEq s "" then "x" else s)

safe : String -> String
safe x0 = safeFrom (safeChars (spellOperator x0) 0 "")

isIdent : String -> Bool
isIdent x = not (strEq x "") && strEq (safe x) x

propName : String -> String
propName x = if isIdent x then x else quoteString x

-- | the short name of a key (`co.bind` is `bind`)
shortName : String -> String
shortName k = fromMaybe k (last (split "." k))

-- Globals
--------------------------------------------------------------------------------

-- | how a definition is reached: its name, how many parameters it takes
-- | at once, whether it is computed when first used
type GInfo = { js : String, arity : Int, lazy : Bool }

-- | a global as a value
ref : M.Map String GInfo -> String -> String
ref gs k = case M.lookup compareString k gs of
  Just i ->
    if i.arity >= 2 then i.js ++ "$c" else if i.lazy then i.js ++ "()" else i.js
  Nothing -> "undefined"

-- | the globals an expression uses as values (not called at once)
valueRefs : I.Expr -> List String
valueRefs e = case e of
  EGlobal g -> Cons g Nil
  ELam _ b -> valueRefs b
  EApp f as -> concatList (valueRefs f) (concatMap (\a -> valueRefs a) as)
  ELet _ a b -> concatList (valueRefs a) (valueRefs b)
  ERecord fs ->
    concatMap
      (\p -> case p of
       MkPair _ e2 -> valueRefs e2)
      fs
  EProj e2 _ -> valueRefs e2
  ETag _ as -> concatMap (\a -> valueRefs a) as
  EMatch s arms ->
    concatList (valueRefs s) (concatMap (\a -> valueRefs (I.armBody a)) arms)
  EPrimCall _ as -> concatMap (\a -> valueRefs a) as
  ECall _ as -> concatMap (\a -> valueRefs a) as
  _ -> Nil

-- Loops
--------------------------------------------------------------------------------

appendEnd : String -> Int -> I.Expr -> Bool
appendEnd key n e = case e of
  ECall k as -> strEq k key && length as == n
  EPrimCall p as -> case as of
    Cons _ (Cons rr Nil) -> strEq p "strAppend" && appendEnd key n rr
    _ -> False
  _ -> False

-- | whether it does at the end of a chain of string appends,
-- | `a ++ b ++ f xs`
appendSelf : String -> Int -> I.Expr -> Bool
appendSelf key n e = case e of
  ELet _ _ b -> appendSelf key n b
  EMatch _ arms -> any (\a -> appendSelf key n (I.armBody a)) arms
  EPrimCall p as -> case as of
    Cons _ (Cons rr Nil) -> strEq p "strAppend" && appendEnd key n rr
    _ -> False
  _ -> False

consLast : String -> Int -> Maybe I.Expr -> Bool
consLast key n (Just (ECall k bs)) = strEq k key && length bs == n
consLast key n _ = False

-- | whether it does as a constructor's last argument
consSelf : String -> Int -> I.Expr -> Bool
consSelf key n e = case e of
  ELet _ _ b -> consSelf key n b
  EMatch _ arms -> any (\a -> consSelf key n (I.armBody a)) arms
  ETag _ as -> consLast key n (last as)
  _ -> False

-- | whether the function `key` calls itself last somewhere: directly,
-- | as a constructor's last argument, or right of a string append
tailSelf : String -> Int -> I.Expr -> Bool
tailSelf key n e = case e of
  ELet _ _ b -> tailSelf key n b
  EMatch _ arms -> any (\a -> tailSelf key n (I.armBody a)) arms
  ECall k as -> strEq k key && length as == n
  _ -> consSelf key n e || appendSelf key n e

-- Scope
--------------------------------------------------------------------------------

-- | a function that is a loop: its parameters (`x$`), whether a
-- | constructor with a call of it last is built in place, its hole
-- | filled by the next round (`$root`, `$hole`, `$at`), and whether a
-- | string append ends in a call of it, gathered left to right (`$s`)
type Self = { key : String, params : List String, trmc : Bool, sapp : Bool }

-- | the names in scope: the JavaScript name of each variable, and every
-- | name taken; and, in a function that is a loop, the function (where
-- | a call of it is last, it goes round again)
type Env =
  { gs : M.Map String GInfo
  , names : M.Map String String
  , used : M.Map String Unit
  , self : Maybe Self
  }

noSelf : Env -> Env
noSelf env = { gs = env.gs, names = env.names, used = env.used, self = Nothing }

withSelf : Maybe Self -> Env -> Env
withSelf s env = { gs = env.gs, names = env.names, used = env.used, self = s }

bound : String -> String -> Env -> Env
bound x v env =
  { gs = env.gs
  , names = M.insert compareString x v env.names
  , used = M.insert compareString v MkUnit env.used
  , self = env.self
  }

type BoundN = { js : String, env : Env }

bindFrom : Env -> String -> String -> Int -> BoundN
bindFrom env x base i =
  if M.member
    compareString
    (if i == 0 then base else base ++ showInt i)
    env.used
    then bindFrom env x base (i + 1)
  else { js = if i == 0 then base else base ++ showInt i
       , env = bound x (if i == 0 then base else base ++ showInt i) env
       }

bindName : Env -> String -> BoundN
bindName env x = bindFrom env x (safe (I.baseOf x)) 0

type BoundNs = { js : List String, env : Env }

bindSnoc : BoundNs -> BoundN -> BoundNs
bindSnoc acc r = { js = concatList acc.js (Cons r.js Nil), env = r.env }

bindAll : Env -> List String -> BoundNs
bindAll env xs =
  foldl (\acc x -> bindSnoc acc (bindName acc.env x)) { js = Nil, env = env } xs

indent : Int -> String
indent n = joinWith "" (replicate n "  ")

-- | precedences: 0 an arrow or a conditional, 1 a binary operation, 2 a
-- | unary one, 3 anything that can be called or projected
type Code = { code : String, prec : Int }

atLeast : Int -> Code -> String
atLeast p c = if c.prec < p then "(" ++ c.code ++ ")" else c.code

p3 : String -> Code
p3 code = { code = code, prec = 3 }

codeOfC : Code -> String
codeOfC c = c.code

-- | a primitive given all its arguments: an operator where JavaScript
-- | has one, else its function
primBin : String -> Code -> Code -> Code
primBin op a b =
  { code = atLeast 1 a ++ " " ++ op ++ " " ++ atLeast 2 b, prec = 1 }

primTest : String -> Code -> Code -> Code
primTest op a b =
  { code = atLeast 2 a ++ " " ++ op ++ " " ++ atLeast 2 b ++ " ? $T : $F"
  , prec = 0
  }

primDefault : String -> List Code -> Code
primDefault p as = p3 ("$" ++ p ++ "(" ++ joinWith ", " (map codeOfC as) ++ ")")

primCall : String -> List Code -> Code
primCall p as = case as of
  Cons a (Cons b Nil) ->
    if strEq p "intAdd" then primBin "+" a b
    else if strEq p "intSub" then primBin "-" a b
    else if strEq p "intMul" then primBin "*" a b
    else if strEq p "strAppend" then primBin "+" a b
    else if strEq p "intEq" then primTest "===" a b
    else if strEq p "strEq" then primTest "===" a b
    else if strEq p "intLt" then primTest "<" a b
    else if strEq p "strLt" then primTest "<" a b
    else if strEq p "intLe" then primTest "<=" a b
    else if strEq p "floatAdd" then primBin "+" a b
    else if strEq p "floatSub" then primBin "-" a b
    else if strEq p "floatMul" then primBin "*" a b
    else if strEq p "floatDiv" then primBin "/" a b
    else if strEq p "floatEq" then primTest "===" a b
    else if strEq p "floatLt" then primTest "<" a b
    else if strEq p "floatLe" then primTest "<=" a b
    else primDefault p as
  Cons a Nil ->
    if strEq p "intShow" then p3 (atLeast 3 a ++ ".toString()")
    else if strEq p "strLength" then p3 ("BigInt(" ++ atLeast 3 a ++ ".length)")
    else primDefault p as
  _ -> primDefault p as

-- Expressions
--------------------------------------------------------------------------------

-- | the emitter's judgments, knotted
type JK =
  { expr : Env -> Int -> I.Expr -> Code
  , body : Env -> Int -> I.Expr -> String
  , block : Env -> Int -> I.Expr -> String
  , stmts : Env -> Int -> I.Expr -> List String
  , last : Env -> Int -> I.Expr -> List String
  }

callName : Env -> String -> String
callName env g = case M.lookup compareString g env.gs of
  Just i -> i.js
  Nothing -> safe g

projSuffix : String -> String
projSuffix l = if isIdent l then "." ++ l else "[" ++ quoteString l ++ "]"

intCode : String -> Code
intCode s =
  if startsWith "-" s then { code = s ++ "n", prec = 2 } else p3 (s ++ "n")

-- (`2.0` is `2`, a number, not a BigInt)
floatCode : String -> Code
floatCode s = if startsWith "-" s then { code = s, prec = 2 } else p3 s

lamCode : JK -> Env -> Int -> I.Expr -> BoundNs -> Code
lamCode r env ind b rb =
  { code =
      joinWith "" (map (\p -> "(" ++ p ++ ") => ") rb.js) ++ r.body rb.env ind b
  , prec = 0
  }

fieldCode : JK -> Env -> Int -> Pair String I.Expr -> String
fieldCode r env ind (MkPair l e2) =
  propName l ++ ": " ++ (r.expr env ind e2).code

-- (what is inside an expression is not last in the function)
isUnitArgs : List I.Expr -> Bool
isUnitArgs (Cons (ETag t Nil) Nil) = strEq t "MkUnit"
isUnitArgs _ = False

exprGo : JK -> Env -> Int -> I.Expr -> Code
exprGo r env ind e = case e of
  EVar x -> p3 (fromMaybe (safe x) (M.lookup compareString x env.names))
  EGlobal g -> p3 (ref env.gs g)
  ELam xs b -> lamCode r env ind b (bindAll env xs)
  -- (a thunk forced: its value kept on it, so that forcing it again
  -- does not compute it again -- the language is pure, `f MkUnit` is
  -- the same value every time, and what abandons is not kept)
  EApp f as ->
    if isUnitArgs as then p3 ("$force(" ++ (r.expr env ind f).code ++ ")")
    else p3
        (atLeast 3 (r.expr env ind f)
         ++ joinWith "" (map (\a -> "(" ++ (r.expr env ind a).code ++ ")") as))
  ECall g as ->
    if isUnitArgs as then p3 ("$force(" ++ callName env g ++ ")")
    else p3
        (callName env g
         ++ "("
         ++ joinWith ", " (map (\a -> (r.expr env ind a).code) as)
         ++ ")")
  EProj e2 l -> p3 (atLeast 3 (r.expr env ind e2) ++ projSuffix l)
  ERecord fs ->
    p3 ("{ " ++ joinWith ", " (map (\p -> fieldCode r env ind p) fs) ++ " }")
  ETag t as ->
    p3
      ("{ $: "
       ++ quoteString t
       ++ ", a: ["
       ++ joinWith ", " (map (\a -> (r.expr env ind a).code) as)
       ++ "] }")
  EInt i -> intCode (showInt i)
  EFloat x -> floatCode (showFloat x)
  EStr s -> p3 (quoteString s)
  EAbandon -> p3 "$abandon()"
  EPrim p -> p3 ("$" ++ p ++ "$c")
  EPrimCall p as -> primCall p (map (\a -> r.expr env ind a) as)
  ELet x a b -> p3 ("(() => " ++ r.block env ind (ELet x a b) ++ ")()")
  EMatch s arms -> p3 ("(() => " ++ r.block env ind (EMatch s arms) ++ ")()")

exprF : JK -> Env -> Int -> I.Expr -> Code
exprF r env0 ind e = exprGo r (noSelf env0) ind e

bodyCode : String -> String
bodyCode c = if strEq (strSlice c 0 1) "{" then "(" ++ c ++ ")" else c

-- | a function's body: an expression, or a block if it binds or matches
bodyF : JK -> Env -> Int -> I.Expr -> String
bodyF r env ind e = case e of
  ELet x a b -> r.block env ind (ELet x a b)
  EMatch s arms -> r.block env ind (EMatch s arms)
  _ -> bodyCode ((r.expr env ind e).code)

blockF : JK -> Env -> Int -> I.Expr -> String
blockF r env ind e =
  "{\n" ++ joinWith "\n" (r.stmts env (ind + 1) e) ++ "\n" ++ indent ind ++ "}"

type Scrut = { js : String, env : Env, pre : List String }

scrutBound : JK -> Env -> Int -> I.Expr -> BoundN -> Scrut
scrutBound r env ind s b =
  { js = b.js
  , env = b.env
  , pre =
      Cons
        (indent ind
         ++ "const "
         ++ b.js
         ++ " = "
         ++ (r.expr env ind s).code
         ++ ";")
        Nil
  }

scrutOf : JK -> Env -> Int -> I.Expr -> Scrut
scrutOf r env ind s = case s of
  EVar x -> case M.lookup compareString x env.names of
    Just js -> { js = js, env = env, pre = Nil }
    Nothing -> scrutBound r env ind (EVar x) (bindName env "s")
  _ -> scrutBound r env ind s (bindName env "s")

declsOf : String -> Int -> List String -> Int -> List String
declsOf js ind Nil i = Nil
declsOf js ind (Cons v rest) i =
  Cons
    (indent ind ++ "const " ++ v ++ " = " ++ js ++ ".a[" ++ showInt i ++ "];")
    (declsOf js ind rest (i + 1))

armBound : JK -> Scrut -> Int -> String -> I.Expr -> BoundNs -> List String
armBound r sc ind tag bdy rb =
  concatList
    (Cons (indent (ind + 1) ++ "case " ++ quoteString tag ++ ": {") Nil)
    (concatList
       (declsOf sc.js (ind + 2) rb.js 0)
       (concatList
          (r.stmts rb.env (ind + 2) bdy)
          (Cons (indent (ind + 1) ++ "}") Nil)))

armLines : JK -> Scrut -> Int -> I.Arm -> List String
armLines r sc ind (MkArm tag vs bdy) =
  armBound r sc ind tag bdy (bindAll sc.env vs)

stmtsMatch2 : JK -> Int -> List I.Arm -> Scrut -> List String
stmtsMatch2 r ind arms sc =
  if null arms
    then concatList
        sc.pre
        (Cons (indent ind ++ "return $nomatch(" ++ sc.js ++ ");") Nil)
  else concatList
      sc.pre
      (concatList
         (Cons (indent ind ++ "switch (" ++ sc.js ++ ".$) {") Nil)
         (concatList
            (concatMap (\a -> armLines r sc ind a) arms)
            (Cons
               (indent ind ++ "}")
               (Cons (indent ind ++ "return $nomatch(" ++ sc.js ++ ");") Nil))))

stmtsLet2 : JK -> Int -> I.Expr -> Code -> BoundN -> List String
stmtsLet2 r ind b ac nb =
  Cons
    (indent ind ++ "const " ++ nb.js ++ " = " ++ ac.code ++ ";")
    (r.stmts nb.env ind b)

stmtsF : JK -> Env -> Int -> I.Expr -> List String
stmtsF r env ind e = case e of
  ELet x a b -> stmtsLet2 r ind b (r.expr env ind a) (bindName env x)
  EMatch s arms -> stmtsMatch2 r ind arms (scrutOf r env ind s)
  _ -> r.last env ind e

-- (the arguments are of this round's `const`s: assigned one by one)
again : JK -> Env -> Self -> Int -> List I.Expr -> List String
again r env s ind as =
  Cons
    (indent ind
     ++ joinWith
       " "
       (zipWith
          (\p a -> p ++ " = " ++ (r.expr env ind a).code ++ ";")
          s.params
          as)
     ++ " continue;")
    Nil

lastTrmc : JK -> Env -> Int -> I.Expr -> BoundN -> List String
lastTrmc r env ind e rr =
  [ indent ind ++ "const " ++ rr.js ++ " = " ++ (r.expr env ind e).code ++ ";"
  , indent ind ++ "if ($hole) { $hole.a[$at] = " ++ rr.js ++ "; return $root; }"
  , indent ind ++ "return " ++ rr.js ++ ";"
  ]

lastOther : JK -> Env -> Self -> Int -> I.Expr -> List String
lastOther r env s ind e =
  if s.trmc then lastTrmc r env ind e (bindName env "r")
  else if s.sapp
    then Cons
        (indent ind ++ "return $s + " ++ atLeast 2 (r.expr env ind e) ++ ";")
        Nil
  else Cons (indent ind ++ "return " ++ (r.expr env ind e).code ++ ";") Nil

lastCell : JK
         -> Env
         -> Self
         -> Int
         -> String
         -> List I.Expr
         -> List I.Expr
         -> BoundN
         -> List String
lastCell r env s ind t ini bs rr =
  concatList
    [ indent ind
    ++ "const "
    ++ rr.js
    ++ " = { $: "
    ++ quoteString t
    ++ ", a: ["
    ++ joinWith
      ", "
      (concatList
         (map (\a -> (r.expr env ind a).code) ini)
         (Cons "undefined" Nil))
    ++ "] };"
    , indent ind
    ++ "if ($hole) $hole.a[$at] = "
    ++ rr.js
    ++ "; else $root = "
    ++ rr.js
    ++ ";"
    , indent ind
    ++ "$hole = "
    ++ rr.js
    ++ "; $at = "
    ++ showInt (length ini)
    ++ ";"
    ]
    (again r env s ind bs)

lastTag : JK
        -> Env
        -> Self
        -> Int
        -> String
        -> List I.Expr
        -> Maybe (Pair (List I.Expr) I.Expr)
        -> List String
lastTag r env s ind t as (Just (MkPair ini (ECall k bs))) =
  if s.trmc && strEq k s.key && length bs == length s.params
    then lastCell r env s ind t ini bs (bindName env "cell")
  else lastOther r env s ind (ETag t as)
lastTag r env s ind t as _ = lastOther r env s ind (ETag t as)

lastSelf : JK -> Env -> Self -> Int -> I.Expr -> List String
lastSelf r env s ind e = case e of
  ECall k as ->
    if strEq k s.key && length as == length s.params then again r env s ind as
    else lastOther r env s ind (ECall k as)
  -- `a ++ ... ++ f xs`: the left is gathered into `$s`, and the call
  -- goes round; what returns gives `$s` its prefix back
  EPrimCall p args -> case args of
    Cons a (Cons rr Nil) ->
      if strEq p "strAppend" && s.sapp && appendEnd s.key (length s.params) rr
        then Cons
            (indent ind ++ "$s += " ++ (r.expr env ind a).code ++ ";")
            (r.last env ind rr)
      else lastOther r env s ind (EPrimCall p args)
    _ -> lastOther r env s ind (EPrimCall p args)
  ETag t as -> lastTag r env s ind t as (unsnocE as)
  _ -> lastOther r env s ind e

-- | what is last in a function: returned, or, in a loop, the next round
lastF : JK -> Env -> Int -> I.Expr -> List String
lastF r env ind e = case env.self of
  Just s -> lastSelf r env s ind e
  Nothing ->
    Cons (indent ind ++ "return " ++ (r.expr env ind e).code ++ ";") Nil

jk : JK
jk =
  { expr = \env ind e -> exprF jk env ind e
  , body = \env ind e -> bodyF jk env ind e
  , block = \env ind e -> blockF jk env ind e
  , stmts = \env ind e -> stmtsF jk env ind e
  , last = \env ind e -> lastF jk env ind e
  }

-- Definitions
--------------------------------------------------------------------------------

env0Of : M.Map String GInfo -> M.Map String Unit -> Env
env0Of gs globalNames =
  { gs = gs, names = M.empty, used = globalNames, self = Nothing }

-- where a function of several parameters is used as a value, it needs
-- its curried form
wrapper : M.Map String Unit -> String -> GInfo -> List String -> List String
wrapper curried key i js =
  if i.arity >= 2 && M.member compareString key curried
    then Cons
        ("const "
         ++ i.js
         ++ "$c = "
         ++ joinWith "" (map (\p -> "(" ++ p ++ ") => ") js)
         ++ i.js
         ++ "("
         ++ joinWith ", " js
         ++ ");")
        Nil
  else Nil

-- (a call of itself last: a loop; its parameters `x$`, each round's own
-- `const`, which what it closes over keeps)
looped : String -> GInfo -> I.Expr -> BoundNs -> Bool -> Bool -> List String
looped key i b r trmc sapp =
  concatList
    [ ""
    , "const "
    ++ i.js
    ++ " = ("
    ++ joinWith ", " (map (\x -> x ++ "$") r.js)
    ++ ") => {"
    ]
    (concatList
       (if trmc then Cons "  let $root, $hole = null, $at = 0;" Nil else Nil)
       (concatList
          (if sapp then Cons "  let $s = \"\";" Nil else Nil)
          (concatList
             [ "  for (;;) {"
             , "    const "
             ++ joinWith
               ", "
               (zipWith
                  (\x v -> x ++ " = " ++ v)
                  r.js
                  (map (\x -> x ++ "$") r.js))
             ++ ";"
             ]
             (concatList
                (jk.stmts
                   (withSelf
                      (Just
                         { key = key
                         , params = map (\x -> x ++ "$") r.js
                         , trmc = trmc
                         , sapp = sapp
                         })
                      r.env)
                   2
                   b)
                (Cons "  }" (Cons "};" Nil))))))

defFun : M.Map String Unit
       -> String
       -> GInfo
       -> List String
       -> I.Expr
       -> BoundNs
       -> List String
defFun curried key i xs b r =
  concatList
    (if tailSelf key (length xs) b
       then looped
           key
           i
           b
           r
           (consSelf key (length xs) b)
           (appendSelf key (length xs) b)
     else [ ""
          , "const "
          ++ i.js
          ++ " = ("
          ++ joinWith ", " r.js
          ++ ") => "
          ++ jk.body r.env 0 b
          ++ ";"
          ])
    (wrapper curried key i r.js)

defBody : M.Map String GInfo
        -> M.Map String Unit
        -> M.Map String Unit
        -> I.Def
        -> GInfo
        -> List String
defBody gs curried globalNames d i = case d.body of
  ELam xs b -> defFun curried d.key i xs b (bindAll (env0Of gs globalNames) xs)
  _ ->
    if i.lazy
      then [ ""
           , "const "
           ++ i.js
           ++ " = $lazy(() => "
           ++ jk.body (env0Of gs globalNames) 0 d.body
           ++ ");"
           ]
    else [ ""
         , "const "
         ++ i.js
         ++ " = "
         ++ (jk.expr (env0Of gs globalNames) 0 d.body).code
         ++ ";"
         ]

defLines : M.Map String GInfo
         -> M.Map String Unit
         -> M.Map String Unit
         -> I.Def
         -> List String
defLines gs curried globalNames d = case M.lookup compareString d.key gs of
  Nothing -> Nil
  Just i -> defBody gs curried globalNames d i

-- Programs
--------------------------------------------------------------------------------

whenHas : String -> String -> String -> Maybe String
whenHas code k line = if contains k code then Just line else Nothing

-- | what the code uses of the runtime
runtime : String -> List String
runtime code =
  catMaybesL
    [ whenHas
      code
      "$T"
      "const $T = { $: \"True\", a: [] }, $F = { $: \"False\", a: [] };"
    , whenHas
      code
      "$abandon"
      "const $abandon = () => { throw new Error(\"heff:abandon\"); };"
    , whenHas
      code
      "$nomatch"
      "const $nomatch = (s) => { throw new Error(\"heff: no case for '\" + (s && s.$) + \"'\"); };"
    , whenHas
      code
      "$force"
      "const $force = (f) => { if (f.$m !== undefined) return f.$m; const v = f({ $: \"MkUnit\", a: [] }); f.$m = v; return v; };"
    , whenHas
      code
      "$lazy"
      "const $lazy = (f) => { let state = 0, v; return () => { if (state === 2) return v; if (state === 1) throw new Error(\"heff: defined by itself\"); state = 1; try { v = f(); state = 2; return v; } finally { if (state === 1) state = 0; } }; };"
    ]

type Uncurried = { params : List String, body : String }

uncurryDone : List String -> String -> Uncurried
uncurryDone ps s = { params = reverse ps, body = s }

uncurryGo : List String -> String -> Uncurried
uncurryGo ps s =
  if startsWith "(" s
    then case indexOf ") => " (strSlice s 1 (strLength s)) of
      Just i ->
        if isIdent (strSlice (strSlice s 1 (strLength s)) 0 i)
          then uncurryGo
              (Cons (strSlice (strSlice s 1 (strLength s)) 0 i) ps)
              (strSlice (strSlice s 1 (strLength s)) (i + 5) (strLength s - 1))
        else uncurryDone ps s
      Nothing -> uncurryDone ps s
  else uncurryDone ps s

-- | `(a) => (b) => body` as its parameters and body
uncurryJs : String -> Uncurried
uncurryJs js = uncurryGo Nil js

primHelperU : String -> String -> Uncurried -> List String
primHelperU code p u =
  concatList
    (if contains ("$" ++ p ++ "(") code || contains ("$" ++ p ++ "$c") code
       then Cons
           ("const $"
            ++ p
            ++ " = ("
            ++ joinWith ", " u.params
            ++ ") => "
            ++ u.body
            ++ ";")
           Nil
     else Nil)
    (if contains ("$" ++ p ++ "$c") code
       then Cons
           ("const $"
            ++ p
            ++ "$c = "
            ++ joinWith "" (map (\x -> "(" ++ x ++ ") => ") u.params)
            ++ "$"
            ++ p
            ++ "("
            ++ joinWith ", " u.params
            ++ ");")
           Nil
     else Nil)

primHelperOne : String -> Pair String Pr.PrimImpl -> List String
primHelperOne code (MkPair p i) = primHelperU code p (uncurryJs i.js)

-- | the primitives the code uses: `$p(a, b)`, and `$p$c` (curried)
primHelpers : String -> List String
primHelpers code = concatMap (\p -> primHelperOne code p) Pr.prims

type Emitted = { lines : List String, globals : M.Map String GInfo }

shortsOf : List I.Def -> List String
shortsOf defs = map (\(d : I.Def) -> safe (shortName d.key)) defs

-- names: the short one, unless two definitions share it
jsPick : List String -> String -> String -> String
jsPick shorts key s =
  if length (filter (\t -> strEq t s) shorts) > 1 then safe key else s

jsNameOf : List String -> String -> String
jsNameOf shorts key = jsPick shorts key (safe (shortName key))

arityOfBody : I.Expr -> Int
arityOfBody b = case b of
  ELam xs _ -> length xs
  _ -> 0

depEager : M.Map String GInfo -> String -> Bool
depEager acc k = case M.lookup compareString k acc of
  Just i -> not i.lazy
  Nothing -> False

-- (a definition is computed at once when that cannot fail)
lazyOf : M.Map String GInfo -> String -> I.Expr -> Int -> Bool
lazyOf acc key b ar =
  ar == 0
  && not
    (I.isValue b
     && all (\k -> not (strEq k key) && depEager acc k) (I.globalsIn b))

infoOne : List String -> M.Map String GInfo -> I.Def -> M.Map String GInfo
infoOne shorts acc d =
  M.insert
    compareString
    d.key
    { js = jsNameOf shorts d.key
    , arity = arityOfBody d.body
    , lazy = lazyOf acc d.key d.body (arityOfBody d.body)
    }
    acc

setFrom : List String -> M.Map String Unit
setFrom xs = foldl (\m k -> M.insert compareString k MkUnit m) M.empty xs

emitLines : M.Map String GInfo -> List String -> List String -> Emitted
emitLines info code helpers =
  { lines =
      concatList
        (runtime (joinWith "\n" (concatList helpers code)))
        (concatList helpers code)
  , globals = info
  }

-- (a primitive's helper may use the runtime too: `$abandon`, `$T`)
emitDone : M.Map String GInfo -> List String -> Emitted
emitDone info code = emitLines info code (primHelpers (joinWith "\n" code))

emitCode : List I.Def
         -> M.Map String GInfo
         -> M.Map String Unit
         -> M.Map String Unit
         -> Emitted
emitCode defs info curried globalNames =
  emitDone info (concatMap (\d -> defLines info curried globalNames d) defs)

emitWithShorts : List I.Def -> List String -> List String -> Emitted
emitWithShorts defs roots shorts =
  emitCode
    defs
    (foldl (\acc d -> infoOne shorts acc d) M.empty defs)
    (setFrom
       (concatList (concatMap (\(d : I.Def) -> valueRefs d.body) defs) roots))
    (setFrom (map (\(d : I.Def) -> jsNameOf shorts d.key) defs))

emitDefs : List I.Def -> List String -> Emitted
emitDefs defs roots = emitWithShorts defs roots (shortsOf defs)

-- Runtime
--------------------------------------------------------------------------------

-- The runtime: a computation run by a handler whose (raw) monad is the
-- continuation monad, `(a -> ()) -> ()`.  An operation may finish later
-- (`Sleep`, `Fetch`, reading a file), and the rest of the computation
-- -- its continuation -- runs then: JavaScript's asynchrony, as a
-- handler, and the computation is the same whatever handles it.  There
-- is one monad for the whole program; each effect contributes an
-- algebra.  `perform` does an operation of the computation's effect:
-- `$sum` of two algebras gives each operation (`InL`, `InR`) to its
-- side's, and each world's algebra -- a provider's text, bundled
-- whole, its factories gathered (`$p0`, `$p1`, ...) -- knows its own
-- operations.  (An operation done at once goes on at once, the
-- stack deeper each time: every so often it goes on after the stack is
-- let go of, lest a long loop of them overflow it.)

runStr : String
runStr =
  joinWith
    "\n"
    [ "const $run = (main, perform) => {"
    , "  const done = () => {};"
    , "  const later = typeof setImmediate === \"function\" ? setImmediate : (f) => setTimeout(f, 0);"
    , "  let depth = 0;"
    , "  const now = (k) => (x) => { if (depth > 1000) { depth = 0; later(() => k(x)); return; } depth++; k(x); };"
    , "  // the handler: its monad's return and bind, and its algebra"
    , "  const hd = {"
    , "    ret: (x) => (k) => k(x),"
    , "    bind: (m) => (f) => (k) => m((x) => f(x)(k)),"
    , "    malg: (p) => (k) => perform(p, now(k)),"
    , "  };"
    , "  return main(hd)(hd.ret)(done);"
    , "};"
    ]

sumStr : String
sumStr =
  "const $sum = (l, r) => (p, k) => p.$ === \"InL\" ? l(p.a[0], k) : r(p.a[0], k);"

hasSum : Ef.Effect -> Bool
hasSum (Plus _ _) = True
hasSum (Leaf _) = False

-- | the world's side of an effect: a provider module's name and text
-- | (`M.provider.js` beside `M.hf`; lib/dom.provider.js says the shape)
type Provider = { module : String, text : String }

isImportLine : String -> Bool
isImportLine l = startsWith "import " l

-- (after `export const `, up to the ` `)
exportNameOf : String -> Maybe String
exportNameOf l =
  if startsWith "export const " l
    then case indexOf " " (strSlice l 13 (strLength l)) of
      Just i -> Just (strSlice l 13 (13 + i))
      Nothing -> Just (strSlice l 13 (strLength l))
  else Nothing

-- | the factories a provider exports, in the order it declares them
-- | (a `$`-named export is the provider speaking about itself, `$host`)
exportedNames : String -> List String
exportedNames text =
  filter
    (\n -> not (startsWith "$" n))
    (catMaybesL (map (\l -> exportNameOf l) (lines text)))

hostLineOf : String -> Maybe String
hostLineOf l =
  if startsWith "export const $host = \"" l
    then case indexOf "\"" (strSlice l 22 (strLength l)) of
      Just i -> Just (strSlice l 22 (22 + i))
      Nothing -> Just (strSlice l 22 (strLength l))
  else Nothing

-- | the one host a provider's world lives in (`export const $host =
-- | "page"`), if it says so; without it, any
hostOf : String -> Maybe String
hostOf text = head (catMaybesL (map (\l -> hostLineOf l) (lines text)))

unexportLine : String -> String
unexportLine l =
  if startsWith "export const " l then "const " ++ strSlice l 13 (strLength l)
  else l

-- the provider's own module, in a scope of its own: its import lines
-- are hoisted to the file's top, its exported factories handed out
bundleProvider : Int -> Provider -> String
bundleProvider i p =
  joinWith
    "\n"
    (concatList
       [ "// " ++ p.module ++ ".provider.js"
       , "const $p" ++ showInt i ++ " = (() => {"
       ]
       (concatList
          (map
             (\l -> unexportLine l)
             (filter (\l -> not (isImportLine l)) (lines p.text)))
          [ "return { " ++ joinWith ", " (exportedNames p.text) ++ " };"
          , "})();"
          ]))

bundleAll : Int -> List Provider -> List String
bundleAll i Nil = Nil
bundleAll i (Cons p rest) = Cons (bundleProvider i p) (bundleAll (i + 1) rest)

runtimeFor : List Provider -> Ef.Effect -> String
runtimeFor provs eff =
  joinWith
    "\n"
    (concatList
       (Cons runStr Nil)
       (concatList
          (if hasSum eff then Cons sumStr Nil else Nil)
          (bundleAll 0 provs)))

provIndexGo : Int -> String -> List Provider -> Int
provIndexGo i md Nil = 0
provIndexGo i md (Cons p rest) =
  if strEq p.module md then i else provIndexGo (i + 1) md rest

-- (each effect's handler, an operation of a sum going to its side's; a
-- leaf's is its provider's factory, called for a fresh algebra)
handlerOf : List Provider -> Ef.Effect -> String
handlerOf provs (Leaf k) =
  "$p"
  ++ showInt (provIndexGo 0 (Ef.moduleOfKey k) provs)
  ++ "."
  ++ Ef.nameOfKey k
  ++ "()"
handlerOf provs (Plus a b) =
  "$sum(" ++ handlerOf provs a ++ ", " ++ handlerOf provs b ++ ")"

-- Outputs
--------------------------------------------------------------------------------

findProv : String -> List Provider -> Maybe Provider
findProv md Nil = Nothing
findProv md (Cons p rest) =
  if strEq p.module md then Just p else findProv md rest

provsForGo : List Provider -> List String -> List Provider
provsForGo available Nil = Nil
provsForGo available (Cons md rest) = case findProv md available of
  Just p -> Cons p (provsForGo available rest)
  Nothing -> provsForGo available rest

-- (the chosen effect's providers, one per module, in the row's order)
provsFor : List Provider -> Ef.Effect -> List Provider
provsFor available eff =
  provsForGo available (nubStr (map (\k -> Ef.moduleOfKey k) (Ef.leaves eff)))

importLinesOf : List Provider -> List String
importLinesOf Nil = Nil
importLinesOf (Cons p rest) =
  concatList (filter (\l -> isImportLine l) (lines p.text)) (importLinesOf rest)

runSource : List Provider -> Ef.Effect -> String -> Emitted -> String
runSource provs eff key m =
  joinWith
    "\n"
    (concatList
       (Cons "// Generated from Hippogriff; do not edit." Nil)
       (concatList
          (nubStr (importLinesOf provs))
          (concatList
             m.lines
             [ ""
             , runtimeFor provs eff
             , ""
             , "$run("
             ++ ref m.globals key
             ++ ", "
             ++ handlerOf provs eff
             ++ ");"
             , ""
             ])))

compileLowered : List Provider -> Ef.Effect -> String -> L.Lowered -> Output
compileLowered provs eff key l =
  { source = runSource provs eff key (emitDefs l.defs (Cons key Nil))
  , errors = l.errors
  }

-- | one file that runs a computation (`key`) of the effect `eff`: the
-- | program, the runtime, and each world's algebra from its provider --
-- | it imports nothing but what the providers do (`node:` builtins,
-- | hoisted), so a page loads it from file:// too
compileProgram : List Provider -> G.Globals -> String -> Ef.Effect -> Output
compileProgram available g key eff =
  compileLowered (provsFor available eff) eff key (L.lower g (Cons key Nil))

getterOf : M.Map String GInfo -> Export -> String
getterOf gs o =
  "  get " ++ propName o.name ++ "() { return " ++ ref gs o.key ++ "; },"

jsSource : List Export -> Emitted -> String
jsSource exports m =
  joinWith
    "\n"
    (concatList
       (Cons "// Generated from Hippogriff; do not edit." Nil)
       (concatList
          m.lines
          (concatList
             ["", "export default {"]
             (concatList
                (map
                   (\o -> getterOf m.globals o)
                   (filter
                      (\(o : Export) -> M.member compareString o.key m.globals)
                      exports))
                (Cons "};" (Cons "" Nil))))))

compileExports : List Export -> L.Lowered -> Output
compileExports exports l =
  { source =
      jsSource exports (emitDefs l.defs (map (\(o : Export) -> o.key) exports))
  , errors = l.errors
  }

-- | a module whose default export has the given definitions by the
-- | given names (all of them, by their keys, if none is given)
compileJsWith : G.Globals -> List Export -> Output
compileJsWith g exports =
  compileExports exports (L.lower g (map (\(o : Export) -> o.key) exports))

compileJs : G.Globals -> List Export -> Output
compileJs g exports0 =
  compileJsWith
    g
    (if null exports0
       then map
           (\p -> case p of
            MkPair k _ -> mkExport k k)
           (G.globalsList g)
     else exports0)

