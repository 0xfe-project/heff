-- Globals: a port of `Heff.Core.Globals`, an insertion-ordered map of
-- names to elaborated definitions.  `syntax` is the definition at case D
-- with itself as local 0, `tySyntax` its type, closed; `value` and
-- `type_` their evaluations (`compiler/top.hf` ties the knot).

import compiler.syntax as Sx
import compiler.value as V
import map as M
import prelude

type Entry = { syntax : Sx.Tm, tySyntax : Sx.Ty, value : V.V, type_ : V.Ty }

-- | `aliases` maps a name to the key it stands for; `broken` the keys of
-- | definitions that did not elaborate (a use of one is not an error of
-- | its own)
type Globals =
  { order : List String
  , entries : M.Map String Entry
  , aliases : M.Map String String
  , broken : M.Map String Unit
  -- | spike: the definitions marked `instance` -- candidates for
  -- | instance search
  , instances : List String
  }

emptyGlobals : Globals
emptyGlobals =
  { order = Nil
  , entries = M.empty
  , aliases = M.empty
  , broken = M.empty
  , instances = Nil
  }

addBroken : String -> Globals -> Globals
addBroken k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = M.insert compareString k MkUnit g.broken
  , instances = g.instances
  }

isBroken : Globals -> String -> Bool
isBroken g x =
  if M.member compareString x g.broken then True
  else case M.lookup compareString x g.aliases of
    Just k -> M.member compareString k g.broken
    Nothing -> False

-- | (a redefinition moves the name to the end; `order` is kept backwards
-- | here, newest first, and reversed where it is read)
addEntry : String -> Entry -> Globals -> Globals
addEntry x e g =
  { order = Cons x (filter (\y -> not (strEq y x)) g.order)
  , entries = M.insert compareString x e g.entries
  , aliases = g.aliases
  , broken = g.broken
  , instances = g.instances
  }

addAlias : String -> String -> Globals -> Globals
addAlias name key g =
  { order = g.order
  , entries = g.entries
  , aliases = M.insert compareString name key g.aliases
  , broken = g.broken
  , instances = g.instances
  }

-- | spike: mark a definition as an instance -- a candidate for
-- | instance search (`instance x : T`)
markInstance : String -> Globals -> Globals
markInstance k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , instances =
      concatList (filter (\y -> not (strEq y k)) g.instances) (Cons k Nil)
  }

-- | resolve a name to its key and entry
lookupKey : Globals -> String -> Maybe (Pair String Entry)
lookupKey g x = case M.lookup compareString x g.entries of
  Just e -> Just (MkPair x e)
  Nothing -> case M.lookup compareString x g.aliases of
    Just k -> case M.lookup compareString k g.entries of
      Just e -> Just (MkPair k e)
      Nothing -> Nothing
    Nothing -> Nothing

lookupEntry : Globals -> String -> Maybe Entry
lookupEntry g x = case lookupKey g x of
  Just (MkPair _ e) -> Just e
  Nothing -> Nothing

-- | every definition, in the order declared (`order` is kept newest
-- | first)
globalsList : Globals -> List (Pair String Entry)
globalsList g =
  foldl
    (\acc k -> case M.lookup compareString k g.entries of
     Just e -> Cons (MkPair k e) acc
     Nothing -> acc)
    Nil
    g.order

-- | (evaluation only reaches globals that are there)
elemAt : Globals -> String -> Entry
elemAt g x = case M.lookup compareString x g.entries of
  Just e -> e
  Nothing -> abandon

-- >>> (elemAt (addEntry "k" { syntax = SOpaque, tySyntax = SPrimInt, value = VOpaque, type_ = VPrimInt } emptyGlobals) "k").tySyntax
-- SPrimInt
