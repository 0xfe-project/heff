-- Core syntax: a port of `Heff.Core.Syntax`.  Elements and types are
-- mutually recursive there; here `El` is parametric in the type it
-- mentions, and `Ty` closes the knot (`Tm = El Ty`), as definitions are
-- sequential.  The record types of the original are positional
-- constructor arguments, for the same reason.

import array as A
import compiler.dict as D
import compiler.params as P
import prelude

-- | abstractions (syntactic closures)
data Abs a = MkAbs String a | AbsConst a

-- | an element, over the types `t` it mentions.  `SMatch` holds for each
-- | tag the names its arguments bind, and the arm.
data El t
  = SLocal Int
  | SGlobal String
  | SCode t
  | SApp (El t) (El t)
  | SLam t (Abs (El t))
  | SCons (D.Dict (El t))
  | SProj (El t) String
  | STag String (Array (El t))
  | SMatch (El t) (D.Dict (Pair (Array String) (El t)))
  | SSpecialize (El t) String (El t)
  | SIs (El t)
  | SOpaque
  | SAbandon
  | SRec (El t)
  | SImplicit String (El t)
  | SPrim String
  | SMetaApp Int (Array Int) t
  | SLitInt Int
  | SLitFloat Float
  | SLitString String

-- | a type: `SFunction level dom cod implicit`, `SRecord level fieldTypes`
data Ty
  = SU P.Universe
  | SDecode (El Ty)
  | SFunction P.Level Ty (Abs Ty) Bool
  | SRecord P.Level (D.Dict Ty)
  | SSum (P.Variants Ty)
  | SIsTy Ty
  | SPrimInt
  | SPrimFloat
  | SPrimString
  | SPrimArray Ty

type Tm = El Ty

isApp : Tm -> Int
isApp (SApp _ _) = 1
isApp _ = 0

-- >>> isApp (SApp (SLocal 0) (SLitInt 7))
-- 1
