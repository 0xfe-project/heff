-- Levels, universes, the case index, variants: a port of
-- `Heff.Core.Params`.

import array as A
import compiler.dict as D
import prelude

-- | a thunk: the port's laziness (no memoization; the reference leans on
-- | Haskell's, the PureScript port on `Data.Lazy`)
type Th a = Unit -> a

forceTh : {a : Type} -> Th a -> a
forceTh t = t MkUnit

data Level = Small | Large | TopL

leq : Level -> Level -> Bool
leq Small _ = True
leq Large Small = False
leq Large _ = True
leq TopL TopL = True
leq TopL _ = False

maxLevel : Level -> Level -> Level
maxLevel l1 l2 = if leq l1 l2 then l2 else l1

eqLevel : Level -> Level -> Bool
eqLevel a b = if leq a b then leq b a else False

-- | `N` (nominative) is an ordinary element, `D` (descriptive) a
-- | description that gives a top-level name its behavior.
data Case = N | De

data Universe = SmallU | LargeU

eqUniverse : Universe -> Universe -> Bool
eqUniverse SmallU SmallU = True
eqUniverse LargeU LargeU = True
eqUniverse _ _ = False

codesInto : Universe -> Level
codesInto SmallU = Large
codesInto LargeU = TopL

decodesInto : Universe -> Level
decodesInto SmallU = Small
decodesInto LargeU = Large

-- | where in a file a thing is: offsets into the text
type Span = { start : Int, end : Int }

noSpan : Span
noSpan = { start = 0, end = 0 }

-- | the shape of a context: how many are bound, and their names,
-- | backwards (the head is the innermost binder)
type CtxShape = { len : Int, names : List String }

emptyShape : CtxShape
emptyShape = { len = 0, names = Nil }

bindShape : String -> CtxShape -> CtxShape
bindShape x cs = { len = cs.len + 1, names = Cons x cs.names }

-- | the variants of a sum type: for each tag, its argument types
type Variants a = D.Dict (Array a)

variantsMap : {a b : Type} -> (a -> b) -> Variants a -> Variants b
variantsMap f vs = D.mapD (A.map f) vs

-- >>> leq Large TopL
-- True
-- >>> maxLevel Large Small
-- Large
