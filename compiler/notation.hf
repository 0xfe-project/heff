-- Notation: what the parser reads text into and the elaborator takes, a
-- tree of juxtapositions, infixes and blocks; and the diagnostics.  A
-- port of `Heff.Parse.Notation` (from the fnotation Haskell library,
-- MPL-2.0).

import compiler.params as P
import prelude

data Severity = SError | SWarning | SDebug

-- | a diagnostic: `code` is already offset into its family (lexer 0,
-- | reader 100, parser 200, elaborator 300); its message is plain text
type Diag =
  { code : Int
  , severity : Severity
  , msg : String
  , span : P.Span
  , note : Maybe String
  }

data Ntn
  = Juxt Ntn Ntn
  | Infix Ntn Ntn Ntn
  | NBlock String (Maybe Ntn) (List Ntn) P.Span
  | MDecl (List String) String Ntn P.Span
  | NTuple (List Ntn) P.Span
  -- | extension: `{ e }`, for implicit arguments
  | NBrace Ntn P.Span
  | Ident String P.Span
  | Keyword String P.Span
  | NField String P.Span
  | NTag String P.Span
  | NInt Int P.Span
  | NFloat Float P.Span
  | NString String P.Span
  | NError P.Span

-- | a juxtaposition, read as head and arguments
type Group = { head : Ntn, args : List Ntn }

group : Ntn -> List Ntn -> Ntn
group h args = foldl (\f x -> Juxt f x) h args

groupGo : List Ntn -> Ntn -> Group
groupGo acc (Juxt f x) = groupGo (Cons x acc) f
groupGo acc f = { head = f, args = acc }

getGroup : Ntn -> Group
getGroup n = groupGo Nil n

startPos : Ntn -> Int
startPos (Juxt f _) = startPos f
startPos (Infix x _ _) = startPos x
startPos (NBlock _ _ _ s) = s.start
startPos (MDecl _ _ _ s) = s.start
startPos (NTuple _ s) = s.start
startPos (NBrace _ s) = s.start
startPos (Ident _ s) = s.start
startPos (Keyword _ s) = s.start
startPos (NField _ s) = s.start
startPos (NTag _ s) = s.start
startPos (NInt _ s) = s.start
startPos (NFloat _ s) = s.start
startPos (NString _ s) = s.start
startPos (NError s) = s.start

endPos : Ntn -> Int
endPos (Juxt _ x) = endPos x
endPos (Infix _ _ y) = endPos y
endPos (NBlock _ _ _ s) = s.end
endPos (MDecl _ _ _ s) = s.end
endPos (NTuple _ s) = s.end
endPos (NBrace _ s) = s.end
endPos (Ident _ s) = s.end
endPos (Keyword _ s) = s.end
endPos (NField _ s) = s.end
endPos (NTag _ s) = s.end
endPos (NInt _ s) = s.end
endPos (NFloat _ s) = s.end
endPos (NString _ s) = s.end
endPos (NError s) = s.end

ntnSpan : Ntn -> P.Span
ntnSpan n = { start = startPos n, end = endPos n }

-- >>> (getGroup (group (Ident "f" P.noSpan) [Ident "x" P.noSpan, Ident "y" P.noSpan])).args
-- [Ident "x" { start = 0, end = 0 }, Ident "y" { start = 0, end = 0 }]
