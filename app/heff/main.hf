-- The compiler, run: a program (`heff compile app/heff/main.hf OUT.c
-- --name main --backend=c`, built by `zig cc`), `heff` itself -- compiled
-- by itself, from the seed boot/heff.tar.xz (build.zig).  Its
-- command line is read by std.cli (`commands`, below), and each command's
-- work is the package's (`heff.build.commands`).  Besides the commands the usage
-- shows, `dump-core FILE...` reads the files given in dependency order,
-- elaborates them, and prints every definition's stored core, and
-- `dump-eval FILE` prints what each definition of FILE evaluates to (the
-- interpreter's values, which the tests hold the backend to), and
-- `dump-c FILE OUT` writes OUT, a C program that shows each definition
-- of FILE, as the tests hold the C backend to those values.

module app.heff.main

import co
import exception
import heff.build.benchmarks as Benchmarks
import heff.build.commands
import heff.build.dev as Dev
import heff.build.docpages as DocPages
import heff.build.fetch as Fetch
import heff.build.packaging as Packaging
import heff.build.testing as Testing
import heff.lsp.lsp as LSP
import heff.lsp.report as Report
import heff.lsp.rpc as RPC
import heff.util.files as Util
import std.cli as CLI
import std.cli.interactive as Interactive
import std.filesystem
import std.io
import std.path as Path
import std.process
import std.progress as Progress
import std.reactor as Reactor
import std.terminal as Terminal
import std.time as Time

-- each computation of the program asks for the effects it has, in any
-- world they are in; their evidence is found once, by `main`, below --
-- and what it is doing (`Progress.progress`), which `main` draws on the
-- terminal, if the standard error is one

-- The command line
--------------------------------------------------------------------------------

-- | `heff compile FILE OUT --backend=MODE [--name NAME] [--fuel]`
compileWith : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> String
            -> String
            -> Maybe String
            -> String
            -> Bool
            -> Co e Unit
compileWith file outPath name backend fuel =
  compileTo
    { file = file
    , outPath = outPath
    , name = name
    , backend = backend
    , fuel = fuel
    }

-- | the language server, on stdin/stdout (the flags clients add,
-- | `--stdio` say, are passed over: it is all there is)
lspCmd : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{wire : RPC.rpc <: e}}
       -> List String
       -> Co e Unit
lspCmd flags = do
  h <- hostNow
  LSP.serve h

-- heff's commands, as types: what each takes, for any result `r` -- the
-- program is one handler of them, the watches below another.  They are
-- in groups by what they are given to run: only the tools talk to an
-- editor.

-- | building and checking files
type Build (r : Type) =
  { check : String -> r
  , run : String -> List String -> r
  , tests :
        Maybe String
        -> Maybe String
        -> Maybe String
        -> Bool
        -> Bool
        -> List String
        -> r
  , bench :
        Maybe String
        -> Maybe String
        -> Maybe String
        -> Bool
        -> Bool
        -> List String
        -> r
  , promote : String -> r
  , compile : String -> String -> Maybe String -> String -> Bool -> r
  , explain : String -> r
  , typeAt : String -> List String -> r
  , fmt : Bool -> List String -> r
  , doc : Maybe String -> List String -> r
  }

-- | the project, and its packages
type Project (r : Type) =
  { init : Maybe String -> r
  , get : Maybe String -> r
  , build : r
  , install : Maybe String -> r
  , publish : String -> r
  , dev : List String -> r
  }

-- | the language server, which heff this is, and the compiler's own
-- | doors
type Tool (r : Type) =
  { lsp : List String -> r
  , version : r
  , dumpCore : List String -> r
  , dumpEval : String -> r
  , dumpC : String -> String -> r
  }

type Commands (r : Type) =
  { build : Build r, project : Project r, tool : Tool r }

hf : CLI.Complete
hf = Files ".hf"

-- (what `--fuel` says)
fuelSays : String
fuelSays =
  "with fuel (page, c): each loop ticked, so that std.fuel's `limited` stops a loop with no operation in it -- at a cost to every loop -- as a build.hf's `fuel = True`"

buildCommands : {r : Type} -> Build r -> List (CLI.Command r)
buildCommands c =
  [ CLI.command
    "check"
    "elaborate FILE and what it imports; print its interface"
    (\s -> CLI.with1 s c.check (CLI.arg s "FILE" hf))
  , CLI.command
    "run"
    "run FILE's main with ARGS, compiled through C (by zig at -O1, in .heff/run/)"
    (\s -> CLI.with2 s c.run (CLI.arg s "FILE" hf) (CLI.rest s "ARGS"))
  , CLI.command
    "test"
    "check the expectations of the watches (the `-- ...` lines under them) and doc tests (the `-- | ...` lines under them), and run the tests (the definitions of type `Test`, check's), of the FILEs (a directory's .hf files), else of the project's here (src/ and test/)"
    (\s ->
       s.ap
         (s.ap
            (CLI.with4
               s
               c.tests
               (CLI.option
                  s
                  "seed"
                  "s"
                  "N"
                  "the seed the properties draw from (the same seed, the same runs)")
               (CLI.option
                  s
                  "run"
                  "r"
                  "REGEXP"
                  "run only the tests whose names it matches, a level each between `/`s: `^lsp/hover`")
               (CLI.option
                  s
                  "jobs"
                  "j"
                  "N"
                  "how many integration tests run at once (HEFF_TEST_JOBS, else half the cores)")
               (CLI.switch
                  s
                  "update"
                  "u"
                  "write each golden text the tests keep, not hold them to it"))
            (CLI.switch
               s
               "watch"
               "w"
               "then test again at each change of the FILEs, of what they import, and of the project's sources, until ended (not with --update)"))
         (CLI.many s "FILE" hf))
  , CLI.command
    "bench"
    "run the benchmarks (the definitions of type `Bench`, bench's) of the FILEs (a directory's .hf files), else of the project's benchmarks here (bench/): each built through C (by zig at -O2), run until a run takes the bench time, and said a line each, as Go's are"
    (\s ->
       s.ap
         (s.ap
            (CLI.with4
               s
               c.bench
               (CLI.option
                  s
                  "run"
                  "r"
                  "REGEXP"
                  "run only the benchmarks whose names it matches, a level each between `/`s, as `heff test --run`")
               (CLI.option
                  s
                  "time"
                  "t"
                  "D"
                  "how long each is run, at least: a duration (1s, the default; 500ms, 1.5s), or a count (100x)")
               (CLI.option
                  s
                  "count"
                  "c"
                  "N"
                  "run each N times, a line each (1)")
               (CLI.switch s "json" "j" "say each as a line of JSON"))
            (CLI.switch s "fuel" "f" fuelSays))
         (CLI.many s "FILE" hf))
  , CLI.command
    "promote"
    "write each watch's and doc test's value under it as its expectation"
    (\s -> CLI.with1 s c.promote (CLI.arg s "FILE" hf))
  , CLI.command
    "compile"
    "FILE compiled, by MODE: esm (an ES module), page (a script running the app NAME in a page), c (a C program running NAME, for `zig cc`); NAME is main, without --name"
    (\s ->
       s.ap
         (CLI.with4
            s
            c.compile
            (CLI.arg s "FILE" hf)
            (CLI.arg s "OUT" None)
            (CLI.option
               s
               "name"
               "n"
               "NAME"
               "the computation run (page, c): main, without it")
            (CLI.choose
               s
               "backend"
               "b"
               "MODE"
               "what it is compiled to"
               ["esm", "page", "c"]))
         (CLI.switch s "fuel" "f" fuelSays))
  , CLI.command
    "explain"
    "the elaboration trace"
    (\s -> CLI.with1 s c.explain (CLI.arg s "FILE" hf))
  , CLI.command
    "type-at"
    "what the name at each OFFSET resolved to, and its type, a line each"
    (\s ->
       CLI.with2 s c.typeAt (CLI.arg s "FILE" hf) (CLI.some s "OFFSET" None))
  , CLI.command
    "fmt"
    "format FILEs in place"
    (\s ->
       CLI.with2
         s
         c.fmt
         (CLI.switch s "check" "c" "only say which are not formatted")
         (CLI.some s "FILE" hf))
  , CLI.command
    "doc"
    "a reference page, Markdown, of each module of the FILEs (a directory's .hf files), else of the project's here (src/): its header comment, then each definition it exposes, its signature and its doc comment; printed, or written under DIR"
    (\s ->
       CLI.with2
         s
         c.doc
         (CLI.option
            s
            "out"
            "o"
            "DIR"
            "write each page under DIR, at its module's path (std.path at DIR/std/path.md), and an index of them, DIR/index.md")
         (CLI.many s "FILE" hf))
  ]

projectCommands : {r : Type} -> Project r -> List (CLI.Command r)
projectCommands c =
  [ CLI.command
    "init"
    "a new project in DIR (here, without it)"
    (\s -> CLI.with1 s c.init (CLI.optional s "DIR" Dirs))
  , CLI.command
    "get"
    "fetch what the project requires, writing heff.sum; with PATH, require it (at VERSION or the commit REV names, PATH@REV, else its newest: its newest tag, or its default branch's commit) first"
    (\s -> CLI.with1 s c.get (CLI.optional s "PATH[@VERSION]" None))
  , CLI.command
    "build"
    "the whole project: every module of src/ checked, then every program, app/NAME/main.hf, compiled as app/NAME/build.hf says, to .heff/bin/ (C by zig at -O1: built quickly, not to run its fastest)"
    (\s -> s.give c.build)
  , CLI.command
    "install"
    "the project at DIR (here, without it) built as `heff build` builds it, but to run its fastest (C by zig at -O2), its programs into the heff home's bin/ (HEFF_HOME/bin, else ~/.heff/bin), and what they ship (their build.hf's `ships`) into the heff home, beside bin/"
    (\s -> CLI.with1 s c.install (CLI.optional s "DIR" Dirs))
  , CLI.command
    "publish"
    "check the project, then tag it vVERSION and push the tag"
    (\s -> CLI.with1 s c.publish (CLI.arg s "VERSION" None))
  , CLI.command
    "dev"
    "the project built as `heff build` builds it, its C programs (the APPs, else all) run, then built and run again at each change of its files"
    (\s -> CLI.with1 s c.dev (CLI.many s "APP" None))
  ]

toolCommands : {r : Type} -> Tool r -> List (CLI.Command r)
toolCommands c =
  [ CLI.command
    "lsp"
    "a language server, on stdin/stdout"
    (\s -> CLI.with1 s c.lsp (CLI.rest s "FLAGS"))
  , CLI.command
    "version"
    "which heff this is: its version, as the package.hf it came with says"
    (\s -> s.give c.version)
  , CLI.hidden "dump-core" (\s -> CLI.with1 s c.dumpCore (CLI.many s "FILE" hf))
  , CLI.hidden "dump-eval" (\s -> CLI.with1 s c.dumpEval (CLI.arg s "FILE" hf))
  , CLI.hidden
    "dump-c"
    (\s -> CLI.with2 s c.dumpC (CLI.arg s "FILE" hf) (CLI.arg s "OUT" None))
  ]

commands : {r : Type} -> Commands r -> List (CLI.Command r)
commands c =
  List.append
    (buildCommands c.build)
    (List.append (projectCommands c.project) (toolCommands c.tool))

build : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{rep : Report.report <: e}}
      -> {{prog : Progress.progress <: e}}
      -> {{clock : Time.time <: e}}
      -> {{rx : Reactor.reactor <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> Build (Co e Unit)
build =
  { check = checkCmd
  , run = runCmd
  , tests = \seed pattern jobs update watch given ->
        if watch then Testing.testsWatched seed pattern jobs update given
        else do
          opts <- Testing.testOptions seed pattern jobs update
          files <- Testing.testFiles given
          Testing.testsCmd opts files
  , bench = Benchmarks.benchCmd
  , promote = promoteCmd
  , compile = compileWith
  , explain = explainCmd
  , typeAt = typeAtCmd
  , fmt = fmtCmd
  , doc = DocPages.docCmd
  }

project : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{clock : Time.time <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Project (Co e Unit)
project =
  { init = \dir -> Packaging.initCmd (fromMaybe "." dir)
  , get = Fetch.getCmd
  , build = buildCmd
  , install = \dir -> installCmd (fromMaybe "." dir)
  , publish = Packaging.publishCmd
  , dev = Dev.devCmd
  }

tool : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{rep : Report.report <: e}}
     -> {{wire : RPC.rpc <: e}}
     -> {{ex : exception ProcessError <: e}}
     -> Tool (Co e Unit)
tool =
  { lsp = lspCmd
  , version = versionCmd
  , dumpCore = selfcheck
  , dumpEval = evalCmd
  , dumpC = dumpCCmd
  }

-- (what a command line is read as, said: for the watches)
-- | >>> CLI.readLine "heff" (commands said) ["compile", "a.hf", "-bc", "a.c"]
-- | Run "compile a.hf a.c - c"
-- | >>> CLI.readLine "heff" (commands said) ["run", "main.hf", "--verbose", "x"]
-- | Run "run main.hf [--verbose,x]"
-- | >>> CLI.readLine "heff" (commands said) ["fmt", "src", "-c", "test"]
-- | Run "fmt --check src,test"
-- | >>> CLI.readLine "heff" (commands said) ["init"]
-- | Run "init ."
-- | >>> CLI.readLine "heff" (commands said) ["build"]
-- | Run "build"
-- | >>> CLI.readLine "heff" (commands said) ["build", "heff"]
-- | Fail "heff build: too many words: heff\nusage: heff build\n"
-- | >>> CLI.readLine "heff" (commands said) ["install", "tools/x"]
-- | Run "install tools/x"
-- | >>> CLI.readLine "heff" (commands said) ["lsp", "--stdio"]
-- | Run "lsp --stdio"
-- | >>> CLI.readLine "heff" (commands said) ["version"]
-- | Run "version"
-- | >>> CLI.readLine "heff" (commands said) ["test", "--run", "^lsp/", "-j", "2", "-u", "test"]
-- | Run "test - ^lsp/ 2 --update test"
-- | >>> CLI.readLine "heff" (commands said) ["test", "-w", "test/a.hf"]
-- | Run "test - - - --watch test/a.hf"
-- | >>> CLI.readLine "heff" (commands said) ["bench", "--run", "fib/", "-t", "10ms", "--count", "3", "--json", "bench"]
-- | Run "bench fib/ 10ms 3 --json bench"
-- | >>> CLI.readLine "heff" (commands said) ["bench"]
-- | Run "bench - - - "
-- | >>> CLI.readLine "heff" (commands said) ["type-at", "a.hf", "3", "17"]
-- | Run "type-at a.hf 3,17"
-- | >>> CLI.readLine "heff" (commands said) ["doc", "lib", "--out", "docs/api"]
-- | Run "doc docs/api lib"
said : Commands String
said =
  { build =
      { check = \f -> "check " ^ f
      , run = \f argv -> "run " ^ f ^ " [" ^ joinWith "," argv ^ "]"
      , tests = \sd r j u w fs ->
            "test "
            ^ fromMaybe "-" sd
            ^ " "
            ^ fromMaybe "-" r
            ^ " "
            ^ fromMaybe "-" j
            ^ (if u then " --update " else " ")
            ^ (if w then "--watch " else "")
            ^ joinWith "," fs
      , bench = \r t c j f fs ->
            "bench "
            ^ fromMaybe "-" r
            ^ " "
            ^ fromMaybe "-" t
            ^ " "
            ^ fromMaybe "-" c
            ^ (if j then " --json " else " ")
            ^ (if f then "--fuel " else "")
            ^ joinWith "," fs
      , promote = \f -> "promote " ^ f
      , compile = \f o n b u ->
            "compile "
            ^ f
            ^ " "
            ^ o
            ^ " "
            ^ fromMaybe "-" n
            ^ " "
            ^ b
            ^ (if u then " --fuel" else "")
      , explain = \f -> "explain " ^ f
      , typeAt = \f os -> "type-at " ^ f ^ " " ^ joinWith "," os
      , fmt = \c fs -> "fmt " ^ (if c then "--check " else "") ^ joinWith "," fs
      , doc = \o fs -> "doc " ^ fromMaybe "-" o ^ " " ^ joinWith "," fs
      }
  , project =
      { init = \d -> "init " ^ fromMaybe "." d
      , get = \p -> "get " ^ fromMaybe "-" p
      , build = "build"
      , install = \d -> "install " ^ fromMaybe "." d
      , publish = \v -> "publish " ^ v
      , dev = \argv -> "dev " ^ joinWith "," argv
      }
  , tool =
      { lsp = \fs -> "lsp " ^ joinWith "," fs
      , version = "version"
      , dumpCore = \fs -> "dump-core " ^ joinWith "," fs
      , dumpEval = \f -> "dump-eval " ^ f
      , dumpC = \f o -> "dump-c " ^ f ^ " " ^ o
      }
  }

-- | the words given heff, read by its commands and run: what they are
-- | to do done, or what is wrong with them said
dispatch : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{clock : Time.time <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> List String
         -> Co e Unit
dispatch argv = case CLI.readLine
    "heff"
    (commands { build = build, project = project, tool = tool })
    argv of
  Run act -> act
  Out text -> write text
  Fail text -> do
    writeErr text
    exit 1

-- (a command line chosen in the commands' app, as a shell would be given
-- it: written to the file the shell's function names (std.cli's
-- `chosenVariable`), for the shell to keep in its history and run; else
-- said, then run)
chosenTo : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{clock : Time.time <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> List String
         -> String
         -> Co e Unit
chosenTo ws file =
  if strEq file ""
  then do
    printErr ("$ " ^ unwords ("heff" :: List.map Interactive.quoted ws))
    dispatch ws
  else do
    ok <-
      Util.writeFile
        (Path.parse file)
        (unwords ("heff" :: List.map Interactive.quoted ws))
    if ok then pure MkUnit
    else do
      printErr ("heff: cannot write the command line chosen to " ^ file)
      exit 1

-- (what the commands' app came to: a command line, run as chosen; or
-- nothing, the app left -- and then `left` done)
explored : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{clock : Time.time <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> Co e Unit
         -> Maybe (Maybe (List String))
         -> Co e Unit
explored left (Just (Just ws)) = do
  file <- getEnv (CLI.chosenVariable "heff")
  chosenTo ws (fromMaybe "" file)
explored left chosen = left

-- | heff with no words, on a terminal: its commands, to pick one of and
-- | fill in (std.cli.interactive), the command line made then run --
-- | so that what each takes is learned by using it; elsewhere, its usage
explore : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{con : Terminal.console <: e}}
        -> {{clock : Time.time <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Bool
        -> Co e Unit
explore False = dispatch Nil
explore True = do
  chosen <-
    Terminal.interactWith
      Interactive.listed
      (Interactive.app
         "heff"
         (Interactive.entries
            (commands
               (r := Co e Unit)
               { build = build, project = project, tool = tool })))
  explored (pure MkUnit) chosen

-- | words that lack only what a command wants, on a terminal: the
-- | command's form, filled in with them, to fill in the rest of
-- | (std.cli.interactive's `prompt`), the command line made then run;
-- | left, or elsewhere, the words run as they are -- what they lack said
prompted : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{con : Terminal.console <: e}}
         -> {{clock : Time.time <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> List String
         -> Maybe Interactive.Form
         -> Co e Unit
prompted argv Nothing = dispatch argv
prompted argv (Just fm) = do
  tty <- Terminal.interactive
  if tty
  then do
    chosen <-
      Terminal.interactWith
        Interactive.listed
        (Interactive.prompt "heff" (Interactive.entries (commands said)) fm)
    explored (dispatch argv) chosen
  else dispatch argv

-- | heff: its commands, given what they are to run with
program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{con : Terminal.console <: e}}
        -> {{clock : Time.time <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
program = do
  argv <- args
  if List.null argv
  then do
    tty <- Terminal.interactive
    explore tty
  else prompted
      argv
      (Interactive.lacking (Interactive.entries (commands said)) argv)

-- (the program ended by a throw no command heard: what was thrown
-- said, and heff failed)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> Either ProcessError Unit
        -> Co e Unit
unheard (Right u) = pure MkUnit
unheard (Left err) = do
  printErr ("heff: " ^ show err)
  exit 1

-- | where the world is: each effect's evidence, found -- the
-- | program's progress drawn on the terminal, or nowhere (`Progress.shown`);
-- | a throw no command heard -- a command not run -- said, heff failed
main : Co
       (stdio
        <+> process
        <+> filesystem
        <+> Report.report
        <+> RPC.rpc
        <+> Progress.terminal
        <+> Terminal.console
        <+> Time.time
        <+> Reactor.reactor)
       Unit
main =
  Progress.shown
    (sys := _)
    (term := _)
    (bind
       (attempt
          ProcessError
          (program
             (io := _)
             (sys := _)
             (disk := _)
             (rep := _)
             (wire := _)
             (prog := _)
             (con := _)
             (clock := _)
             (rx := _)
             (ex := _)))
       (unheard
          (io := _)
          (sys := _)))
