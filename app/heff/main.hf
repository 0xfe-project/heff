-- The compiler, run: a program (`heff compile app/heff/main.hf OUT.c
-- --name main --backend=c`, built by `zig cc`), `heff` itself -- compiled
-- by itself, from the seed boot/heff.tar.xz (build.zig).  Its
-- command line is read by std.cli (`commands`, below), and each command's
-- work is the package's (`heff.build.commands`).  Besides the commands the usage
-- shows, `dump-core FILE...` reads the files given in dependency order,
-- elaborates them, and prints every definition's stored core, and
-- `dump-eval FILE` prints what each definition of FILE evaluates to (the
-- interpreter's values, which the tests hold the backend to).

import co
import heff.build.commands
import heff.lsp.lsp as Lsp
import heff.lsp.report as Report
import heff.lsp.rpc as Rpc
import std.cli as Cli
import std.filesystem
import std.io
import std.process
import std.progress as Progress

world : HFunctor
world =
  stdio <+> process <+> fs <+> Report.report <+> Rpc.rpc <+> Progress.terminal

-- each computation of the program asks for the effects it has, in any
-- world they are in; their evidence is given once, by `main`, below --
-- and what it is doing (`Progress.progress`), which `main` draws on the
-- terminal, if the standard error is one

-- The command line
--------------------------------------------------------------------------------

-- | `heff compile FILE OUT --backend=MODE [--name NAME]`
compileWith : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> {{rep : Report.report <: e}}
            -> String
            -> String
            -> Maybe String
            -> String
            -> Co e Unit
compileWith file outPath name backend =
  compileTo { file = file, outPath = outPath, name = name, backend = backend }

-- | the language server, on stdin/stdout (the flags clients add,
-- | `--stdio` say, are passed over: it is all there is)
lspCmd : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{wire : Rpc.rpc <: e}}
       -> List String
       -> Co e Unit
lspCmd flags = do
  h <- hostNow
  Lsp.serve h

-- heff's commands, as types: what each takes, for any result `r` -- the
-- program is one handler of them, the watches below another.  They are
-- in groups by what they are given to run: only the tools talk to an
-- editor.

-- | building and checking files
type Build (r : Type) =
  { check : String -> r
  , run : String -> List String -> r
  , tests : Maybe String -> List String -> r
  , promote : String -> r
  , compile : String -> String -> Maybe String -> String -> r
  , explain : String -> r
  , typeAt : String -> List String -> r
  , fmt : Bool -> List String -> r
  }

-- | the project, and its packages
type Project (r : Type) =
  { init : Maybe String -> r
  , get : Maybe String -> r
  , build : r
  , install : Maybe String -> r
  , publish : String -> r
  }

-- | the language server, which heff this is, and the compiler's own
-- | doors
type Tool (r : Type) =
  { lsp : List String -> r
  , version : r
  , dumpCore : List String -> r
  , dumpEval : String -> r
  }

type Commands (r : Type) =
  { build : Build r, project : Project r, tool : Tool r }

hf : Cli.Complete
hf = Files ".hf"

buildCommands : {r : Type} -> Build r -> List (Cli.Command r)
buildCommands c =
  [ Cli.command
    "check"
    "elaborate FILE and what it imports; print its interface"
    (\s -> Cli.with1 s c.check (Cli.arg s "FILE" hf))
  , Cli.command
    "run"
    "run FILE's main with ARGS, compiled through C (by zig at -O1, in .heff/run/)"
    (\s -> Cli.with2 s c.run (Cli.arg s "FILE" hf) (Cli.rest s "ARGS"))
  , Cli.command
    "test"
    "check the expectations of the watches (the `-- ...` lines under them) and doc tests (the `-- | ...` lines under them), and run the tests (the definitions of type `Test`, lib/check.hf), of the FILEs (a directory's .hf files), else of the project's tests here (test/)"
    (\s ->
       Cli.with2
         s
         c.tests
         (Cli.option
            s
            "seed"
            "s"
            "N"
            "the seed the properties draw from (the same seed, the same runs)")
         (Cli.many s "FILE" hf))
  , Cli.command
    "promote"
    "write each watch's and doc test's value under it as its expectation"
    (\s -> Cli.with1 s c.promote (Cli.arg s "FILE" hf))
  , Cli.command
    "compile"
    "FILE compiled, by MODE: esm (an ES module), page (a script running the app NAME in a page), c (a C program running NAME, for `zig cc`)"
    (\s ->
       Cli.with4
         s
         c.compile
         (Cli.arg s "FILE" hf)
         (Cli.arg s "OUT" None)
         (Cli.option s "name" "n" "NAME" "the computation run (page, c)")
         (Cli.choose
            s
            "backend"
            "b"
            "MODE"
            "what it is compiled to"
            ["esm", "page", "c"]))
  , Cli.command
    "explain"
    "the elaboration trace"
    (\s -> Cli.with1 s c.explain (Cli.arg s "FILE" hf))
  , Cli.command
    "type-at"
    "what the name at each OFFSET resolved to, and its type, a line each"
    (\s ->
       Cli.with2 s c.typeAt (Cli.arg s "FILE" hf) (Cli.some s "OFFSET" None))
  , Cli.command
    "fmt"
    "format FILEs in place"
    (\s ->
       Cli.with2
         s
         c.fmt
         (Cli.switch s "check" "c" "only say which are not formatted")
         (Cli.some s "FILE" hf))
  ]

projectCommands : {r : Type} -> Project r -> List (Cli.Command r)
projectCommands c =
  [ Cli.command
    "init"
    "a new project in DIR (here, without it)"
    (\s -> Cli.with1 s c.init (Cli.optional s "DIR" Dirs))
  , Cli.command
    "get"
    "fetch what the project requires, writing heff.sum; with PATH, require it (at VERSION, else its newest) first"
    (\s -> Cli.with1 s c.get (Cli.optional s "PATH[@VERSION]" None))
  , Cli.command
    "build"
    "the whole project: every module of src/ checked, then every program, app/NAME/main.hf, compiled as app/NAME/build.hf says, to .heff/bin/ (C by zig at -O1: built quickly, not to run its fastest)"
    (\s -> s.give c.build)
  , Cli.command
    "install"
    "the project at DIR (here, without it) built as `heff build` builds it, but to run its fastest (C by zig at -O2), its programs into the heff home's bin/ (HEFF_HOME/bin, else ~/.heff/bin), and what they ship (their build.hf's `ships`) into the heff home, beside bin/"
    (\s -> Cli.with1 s c.install (Cli.optional s "DIR" Dirs))
  , Cli.command
    "publish"
    "check the project, then tag it vVERSION and push the tag"
    (\s -> Cli.with1 s c.publish (Cli.arg s "VERSION" None))
  ]

toolCommands : {r : Type} -> Tool r -> List (Cli.Command r)
toolCommands c =
  [ Cli.command
    "lsp"
    "a language server, on stdin/stdout"
    (\s -> Cli.with1 s c.lsp (Cli.rest s "FLAGS"))
  , Cli.command
    "version"
    "which heff this is: its version, as the package.hf it came with says"
    (\s -> s.give c.version)
  , Cli.hidden "dump-core" (\s -> Cli.with1 s c.dumpCore (Cli.many s "FILE" hf))
  , Cli.hidden "dump-eval" (\s -> Cli.with1 s c.dumpEval (Cli.arg s "FILE" hf))
  ]

commands : {r : Type} -> Commands r -> List (Cli.Command r)
commands c =
  List.append
    (buildCommands c.build)
    (List.append (projectCommands c.project) (toolCommands c.tool))

build : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : fs <: e}}
      -> {{rep : Report.report <: e}}
      -> {{prog : Progress.progress <: e}}
      -> Build (Co e Unit)
build =
  { check = checkCmd
  , run = runCmd
  , tests = \seed given -> do
      files <- testFiles given
      testsCmd (seedOf seed) files
  , promote = promoteCmd
  , compile = compileWith
  , explain = explainCmd
  , typeAt = typeAtCmd
  , fmt = fmtCmd
  }

project : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Project (Co e Unit)
project =
  { init = \dir -> initCmd (fromMaybe "." dir)
  , get = getCmd
  , build = buildCmd
  , install = \dir -> installCmd (fromMaybe "." dir)
  , publish = publishCmd
  }

tool : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : fs <: e}}
     -> {{rep : Report.report <: e}}
     -> {{wire : Rpc.rpc <: e}}
     -> Tool (Co e Unit)
tool =
  { lsp = lspCmd
  , version = versionCmd
  , dumpCore = selfcheck
  , dumpEval = evalCmd
  }

-- (what a command line is read as, said: for the watches)
-- | >>> Cli.readLine "heff" (commands said) ["compile", "a.hf", "-bc", "a.c"]
-- | Run "compile a.hf a.c - c"
-- | >>> Cli.readLine "heff" (commands said) ["run", "main.hf", "--verbose", "x"]
-- | Run "run main.hf [--verbose,x]"
-- | >>> Cli.readLine "heff" (commands said) ["fmt", "src", "-c", "test"]
-- | Run "fmt --check src,test"
-- | >>> Cli.readLine "heff" (commands said) ["init"]
-- | Run "init ."
-- | >>> Cli.readLine "heff" (commands said) ["build"]
-- | Run "build"
-- | >>> Cli.readLine "heff" (commands said) ["build", "heff"]
-- | Fail "heff build: too many words: heff\nusage: heff build\n"
-- | >>> Cli.readLine "heff" (commands said) ["install", "tools/x"]
-- | Run "install tools/x"
-- | >>> Cli.readLine "heff" (commands said) ["lsp", "--stdio"]
-- | Run "lsp --stdio"
-- | >>> Cli.readLine "heff" (commands said) ["version"]
-- | Run "version"
-- | >>> Cli.readLine "heff" (commands said) ["type-at", "a.hf", "3", "17"]
-- | Run "type-at a.hf 3,17"
said : Commands String
said =
  { build =
      { check = \f -> "check " ^ f
      , run = \f as -> "run " ^ f ^ " [" ^ joinWith "," as ^ "]"
      , tests = \sd fs -> "test " ^ fromMaybe "-" sd ^ " " ^ joinWith "," fs
      , promote = \f -> "promote " ^ f
      , compile = \f o n b ->
            "compile " ^ f ^ " " ^ o ^ " " ^ fromMaybe "-" n ^ " " ^ b
      , explain = \f -> "explain " ^ f
      , typeAt = \f os -> "type-at " ^ f ^ " " ^ joinWith "," os
      , fmt = \c fs -> "fmt " ^ (if c then "--check " else "") ^ joinWith "," fs
      }
  , project =
      { init = \d -> "init " ^ fromMaybe "." d
      , get = \p -> "get " ^ fromMaybe "-" p
      , build = "build"
      , install = \d -> "install " ^ fromMaybe "." d
      , publish = \v -> "publish " ^ v
      }
  , tool =
      { lsp = \fs -> "lsp " ^ joinWith "," fs
      , version = "version"
      , dumpCore = \fs -> "dump-core " ^ joinWith "," fs
      , dumpEval = \f -> "dump-eval " ^ f
      }
  }

-- | heff: its commands, given what they are to run with
program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Report.report <: e}}
        -> {{wire : Rpc.rpc <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Co e Unit
program = do
  as <- args
  case Cli.readLine
      "heff"
      (commands { build = build, project = project, tool = tool })
      as of
    Run act -> act
    Out text -> write text
    Fail text -> do
      writeErr text
      exit 1

-- | where the world is: each sub-effect's evidence, given -- the
-- | program's progress drawn on the terminal, or nowhere (`Progress.shown`)
main : Co world Unit
main =
  Progress.shown
    (sys := \p -> InL (InL (InL (InL (InR p)))))
    (term := \p -> InR p)
    (program
       (io := \p -> InR (InL (InL (InL (InL (InL p))))))
       (sys := \p -> InR (InL (InL (InL (InL (InR p))))))
       (disk := \p -> InR (InL (InL (InL (InR p)))))
       (rep := \p -> InR (InL (InL (InR p))))
       (wire := \p -> InR (InL (InR p)))
       (prog := \p -> InL p))
