---
// The title, and beside it the version picker: the versions are not
// known when a version is built (newer ones come later), so the picker
// reads their list, versions.json at the site's root, when the page is
// shown.  A version picked is the same page in it, if it has the page,
// else its first page.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import Select from '@astrojs/starlight/components/Select.astro';
import { base, root, version } from '../site.mjs';
---

<div class="title-and-version sl-flex">
  <Default />
  <heff-versions data-root={root} data-base={base} data-version={version}>
    <Select icon="seti:git" label="Version" options={[{ label: version, value: '', selected: true }]} width="6.5em" />
  </heff-versions>
</div>

<script>
  class HeffVersions extends HTMLElement {
    async connectedCallback() {
      const { root, base, version } = this.dataset;
      const select = this.querySelector('select');
      if (!select) return;
      let list;
      try {
        const response = await fetch(`${root}/versions.json`);
        if (!response.ok) return;
        list = await response.json();
      } catch {
        return;
      }
      select.replaceChildren(
        ...list.versions.map((v) => {
          const option = document.createElement('option');
          option.value = `${root}/${v.path}`;
          option.textContent = v.name === list.latest ? `${v.name} (latest)` : v.name;
          option.selected = v.name === version;
          return option;
        }),
      );
      select.addEventListener('change', async () => {
        const to = select.value;
        const here = location.pathname;
        const page = here.startsWith(`${base}/`) ? here.slice(base.length + 1) : '';
        let url = to;
        if (page) {
          try {
            const response = await fetch(to + page, { method: 'HEAD' });
            if (response.ok) url = to + page + location.hash;
          } catch {}
        }
        location.href = url;
      });
    }
  }
  customElements.define('heff-versions', HeffVersions);
</script>

<style>
  .title-and-version {
    align-items: center;
    gap: var(--sl-nav-gap);
    min-width: 0;
  }
</style>
