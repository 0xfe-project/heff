---
// Above each page: the page's own banner, if it has one, and, in main's
// version, that it is not released yet.
import Default from '@astrojs/starlight/components/Banner.astro';
import { version } from '../site.mjs';
---

<Default />
{version === 'dev' && <div class="dev-notice" data-pagefind-ignore>The documentation of main, not released yet.</div>}

<style>
  .dev-notice {
    padding: 0.25rem var(--sl-nav-pad-x);
    background-color: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
