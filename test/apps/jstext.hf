-- A world whose operations take and give JavaScript's strings (browser.js),
-- beside the page's (for a test whose page has `<p
-- id="out">`): jstext's provider is given a `JSString` field as the
-- JavaScript string it is, through no helper, and gives one back as it
-- is -- its length the UTF-16 code units of the text, not its bytes.

module test.apps.jstext

import co
import browser.dom
import browser.js
import resource

data JsTextF (m : Type -> Type) x
  = Units JSString (Int -> x)
  | Echo JSString (JSString -> x)

jstext : HFunctor
jstext =
  { f = JsTextF
  , hfmap = \m g p -> case p of
      Units t k -> Units t (\n -> g (k n))
      Echo t k -> Echo t (\u -> g (k u))
  , hmap = \m n nt p -> case p of
      Units t k -> Units t k
      Echo t k -> Echo t k
  }

-- | how many UTF-16 code units the text is, as JavaScript's `length`
units : {e : HFunctor} -> {{ev : jstext <: e}} -> JSString -> Co e Int
units t = op (ev (Units t (\n -> n))) val

-- | the text, given to the provider and back, as it is
echo : {e : HFunctor} -> {{ev : jstext <: e}} -> JSString -> Co e JSString
echo t = op (ev (Echo t (\u -> u))) val

-- (a string, its bytes, the code units of its text, and its text back:
-- a line of its own, in `out`)
said : {e : HFunctor}
     -> {s : Type}
     -> {{onDom : dom <: e}}
     -> {{js : jstext <: e}}
     -> With s Document
     -> Element
     -> String
     -> Co e Unit
said doc out s = do
  n <- units (toJS s)
  u <- echo (toJS s)
  line <- create doc "div"
  text
      line
      (show (strLength s) ^ " bytes, " ^ show n ^ " code units: " ^ fromJS u)
  append out line

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{js : jstext <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> do
      said doc o "plain"
      said doc o "é😀a"
      said doc o ("x" ^ fromByte 255 ^ "y"))

texts : Co (dom <+> jstext) Unit
texts = program (onDom := _) (js := _)
