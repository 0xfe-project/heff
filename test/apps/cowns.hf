-- An app of the page and boc on std.domain (for a test whose page has
-- `<p id="out">`): the program of test/node/cowns-program.hf, in
-- JavaScript's one domain, its lines written there.

module test.apps.cowns

import boc as BOC
import co
import browser.dom
import std.domain as Domain
import test.node.cowns-program as Program

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- BOC.scheduled (Program.said (w := e) (bc := _) (dm := _))
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

cowns : Co (dom <+> Domain.domain) Unit
cowns = program (onDom := _) (dm := _)
