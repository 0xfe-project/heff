-- An app of the page and boc, the runtime's effect (for a test whose
-- page has `<p id="out">`): the program of test/node/cowns-program.hf,
-- in JavaScript's one thread, its lines written there by its last
-- behaviour.

module test.apps.cowns

import boc as BOC
import co
import browser.dom
import custodian
import test.node.cowns-program as Program

-- (the lines written in the page's `#out`)
written : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{cu : custodian <: e}}
        -> List String
        -> Co e Unit
written ls = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{onDom : dom <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = Program.said 1 written

cowns : Co (dom <+> BOC.boc <+> custodian) Unit
cowns = program
