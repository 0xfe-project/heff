-- A world of the test's own beside the page's (for test/app-run.mjs,
-- whose page has `<p id="out">`): its provider, paint.provider.js,
-- paints an element browser.dom found, and makes one browser.dom puts on the
-- page -- each the world's, held for both providers (std.handle).

import co
import browser.dom
import std.handle

-- the operations: an element painted (its class), and a stamp, an
-- element of paint's own making with a text in it
data PaintF (m : Type -> Type) x
  = Paint Node String x
  | Stamp String (Node -> x)

paint : HFunctor
paint =
  { f = PaintF
  , hfmap = \m g p -> case p of
      Paint n c x -> Paint n c (g x)
      Stamp s k -> Stamp s (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Paint n c x -> Paint n c x
      Stamp s k -> Stamp s k
  }

paintAs : {e : HFunctor} -> {{ev : paint <: e}} -> Node -> String -> Co e Unit
paintAs n c = op (ev (Paint n c MkUnit)) val

stamp : {e : HFunctor} -> {{ev : paint <: e}} -> String -> Co e Node
stamp s = op (ev (Stamp s (\n -> n))) val

page : HFunctor
page = dom <+> paint

-- (whether the element found again is the one found first)
sameAs : {e : HFunctor} -> {{ev : dom <: e}} -> Node -> Maybe Node -> Co e Unit
sameAs o Nothing = pure MkUnit
sameAs o (Just again) = attr o "data-same" (if sameHandle o again then "yes" else "no")

program : {{onDom : dom <: page}} -> {{onPaint : paint <: page}} -> Co page Unit
program = do
  out <- select "#out"
  found out (\o -> do
    paintAs o "red"
    s <- stamp "stamped"
    append o s
    again <- select "#out"
    sameAs o again)

painted : Co page Unit
painted = program (onDom := inl dom paint) (onPaint := inr dom paint)
