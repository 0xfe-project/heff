-- A world of the test's own beside the page's (for a test whose page
-- has `<p id="out">`): its provider paints an element browser.dom
-- found, and makes one, given the page's document, which browser.dom
-- puts on the page -- each the host's own, given by value from one
-- effect's provider to the other's.

module test.apps.paint

import co
import browser.dom
import resource

-- the operations: an element painted (its class), and a stamp, an
-- element of paint's own making with a text in it
data PaintF (m : Type -> Type) x
  = Paint Element String x
  | Stamp Document String (Element -> x)

paint : HFunctor
paint =
  { f = PaintF
  , hfmap = \m g p -> case p of
      Paint n c x -> Paint n c (g x)
      Stamp d s k -> Stamp d s (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Paint n c x -> Paint n c x
      Stamp d s k -> Stamp d s k
  }

paintAs : {e : HFunctor}
        -> {{ev : paint <: e}}
        -> Element
        -> String
        -> Co e Unit
paintAs n c = op (ev (Paint n c MkUnit)) val

stamp : {e : HFunctor}
      -> {s : Type}
      -> {{ev : paint <: e}}
      -> With s Document
      -> String
      -> Co e Element
stamp doc s = op (ev (Stamp (inside doc) s (\n -> n))) val

page : HFunctor
page = dom <+> paint

-- (whether the element found again is the one found first)
sameAs : {e : HFunctor}
       -> {{ev : dom <: e}}
       -> Element
       -> Maybe Element
       -> Co e Unit
sameAs o Nothing = pure MkUnit
sameAs o (Just again) = do
  one <- same o again
  attr o "data-same" (if one then "yes" else "no")

program : {{onDom : dom <: page}} -> {{onPaint : paint <: page}} -> Co page Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> do
      paintAs o "red"
      s <- stamp doc "stamped"
      append o s
      again <- select doc "#out"
      sameAs o again)

painted : Co page Unit
painted = program (onDom := _) (onPaint := _)
