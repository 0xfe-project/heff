-- An app of the page and std.entropy, read by the page's provider (for
-- a test whose page has `<p id="out">`): what it writes is how many
-- bytes it gathered, past `crypto.getRandomValues`'s 65536 a call too,
-- and whether two gatherings, and two generators seeded so, differ.

module test.apps.gathered

import bytes as Bytes
import co
import browser.dom
import custodian
import std.entropy as Entropy
import std.random as Random
import uint64 as UInt64

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{ev : Entropy.entropy <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> do
      many <- Entropy.bytes 70000
      a <- Entropy.bytes 32
      b <- Entropy.bytes 32
      r <- Random.fromEntropy
      s <- Random.fromEntropy
      text
          o
          ("gathered: "
           ^ debug (Bytes.length many)
           ^ ", the same: "
           ^ debug (a == b)
           ^ ", drawn the same: "
           ^ debug
             (UInt64.toInt (fst (Random.next r))
              == UInt64.toInt (fst (Random.next s)))))

gathered : Co (dom <+> Entropy.entropy <+> custodian) Unit
gathered = program (onDom := _) (ev := _)
