-- An app of the page and std.time, whose provider is the page's too
-- (for a test whose page has `<p id="out">`): what it writes
-- after the sleep is written when the time has passed.

module test.apps.slept

import co
import browser.dom
import std.time as Time

page : HFunctor
page = dom <+> Time.time

program : {{onDom : dom <: page}}
        -> {{onTime : Time.time <: page}}
        -> Co page Unit
program = do
  _ <-
    withDocument (\doc -> do
    out <- select doc "#out"
    found out (\o -> do
      text o "sleeping"
      Time.sleep 10
      text o "slept"))
  pure MkUnit

slept : Co page Unit
slept = program (onDom := inl dom Time.time) (onTime := inr dom Time.time)
