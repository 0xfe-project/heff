-- An app of the page and std.time, whose provider is the page's too
-- (for a test whose page has `<p id="out">`): what it writes
-- after the sleep is written when the time has passed.

module test.apps.slept

import co
import browser.dom
import custodian
import std.duration as Duration
import std.time as Time

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{onTime : Time.time <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> do
      text o "sleeping"
      Time.sleep (Duration.milliseconds 10)
      text o "slept")

slept : Co (dom <+> Time.time <+> custodian) Unit
slept = program (onDom := _) (onTime := _)
