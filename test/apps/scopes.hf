-- An app of the page and std.domain (for a test whose page has
-- `<p id="out">`): the program the scopes' tests share, in JavaScript's
-- one domain, its lines written there.

module test.apps.scopes

import co
import browser.dom
import std.domain as Domain
import test.node.scopes-program as Program

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- Program.said
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

scopes : Co (dom <+> Domain.domain) Unit
scopes = program (onDom := _) (dm := _)
