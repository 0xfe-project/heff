-- An app of the page and std.domain (for a test whose page has
-- `<p id="out">`): the program of test/node/domains-program.hf, in
-- JavaScript's one domain, its lines written there.

module test.apps.domains

import co
import browser.dom
import custodian
import std.domain as Domain
import test.node.domains-program as Program

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  ls <- Program.said
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

domains : Co (dom <+> Domain.domain <+> custodian) Unit
domains = program (onDom := _) (dm := _)
