-- An app of the page and cml on std.domain (for a test whose page has
-- `<p id="out">`): the program of test/node/cml-program.hf, in
-- JavaScript's one domain, its lines written there.

module test.apps.cml

import cml as CML
import co
import custodian as Custodian
import browser.dom
import std.domain as Domain
import test.node.cml-program as Program

-- (the lines written, in a thread: its `with` of the document in the
-- custody of the custodian in the threads' world, the only one)
written : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> List String
        -> Co e Unit
written ls = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  r <-
    with _ := CML.threads do
      ls <- Program.said
      written ls
  pure ()

-- | in a world with no custodian of its own
cml : Co (dom <+> Domain.domain) Unit
cml = program (onDom := _) (dm := _)
