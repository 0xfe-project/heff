-- An app whose effect is a definition: the runtime sees through it (for
-- a test whose page has `<p id="out">`).

module test.apps.aliased

import co
import browser.dom
import std.reference

page : HFunctor
page = dom <+> reference Int

program : {{onDom : dom <: page}}
        -> {{onCell : reference Int <: page}}
        -> Co page Unit
program = do
  cell <- newReference 41
  n <- readReference cell
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (debug (n + 1)))

aliased : Co page Unit
aliased =
  program (onDom := _) (onCell := _)
