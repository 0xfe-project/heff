-- An app whose effect is a definition: the runtime sees through it (for
-- test/app-run.mjs, whose page has `<p id="out">`).

import co
import std.dom
import std.ref

page : HFunctor
page = dom <+> (ref Int)

program : {{onDom : dom <: page}}
        -> {{onCell : ref Int <: page}}
        -> Co page Unit
program = do
  cell <- newRef 41
  n <- readRef cell
  out <- select "#out"
  found out (\o -> text o (showInt (n + 1)))

aliased : Co page Unit
aliased = program (onDom := inl dom (ref Int)) (onCell := inr dom (ref Int))
