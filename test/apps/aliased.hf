-- An app whose effect is a definition: the runtime sees through it (for
-- test/app-run.mjs, whose page has `<p id="out">`).

import co
import dom
import prelude
import ref

page : HFunctor
page = dom <+> (ref Int)

onDom : (dom <: page)
onDom = inl dom (ref Int)

onCell : (ref Int <: page)
onCell = inr dom (ref Int)

aliased : Co page Unit
aliased = do
  cell <- newRef onCell 41
  n <- readRef onCell cell
  out <- select onDom "#out"
  found out (\o -> text onDom o (showInt (n + 1)))
