-- An app of the page and std.fuel, built with fuel (for a test whose page has
-- `<p id="out">`): the program of test/node/fuel-program.hf, in
-- JavaScript, its lines written there.

module test.apps.fuel

import co
import browser.dom
import custodian
import std.fuel as Fuel
import test.node.fuel-program as Program

program : {e : HFunctor} -> {{onDom : dom <: e}} -> {{fl : Fuel.fuel <: e}} -> {{cu : custodian <: e}} -> Co e Unit
program = do
  ls0 <- Program.lines
  ns <- Program.nearness
  let ls = List.append ls0 ns
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

fuel : Co (dom <+> Fuel.fuel <+> custodian) Unit
fuel = program (onDom := _) (fl := _)
