-- An app of the page and std.domain (for a test whose page has
-- `<p id="out">`): the program of test/node/fuel-program.hf, in
-- JavaScript, its lines written there.

module test.apps.fuel

import co
import browser.dom
import std.domain as Domain
import test.node.fuel-program as Program

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls0 <- Program.lines
  ns <- Program.nearness
  let ls = List.append ls0 ns
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

fuel : Co (dom <+> Domain.domain) Unit
fuel = program (onDom := _) (dm := _)
