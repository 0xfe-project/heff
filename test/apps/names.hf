-- An app whose definitions have the names of the page's own: `top`,
-- `name`, `status`, `self` and `parent` are the program's, not the
-- page's (for a test whose page has `<p id="out">`).

module test.apps.names

import co
import browser.dom
import custodian

top : String
top = "top"

name : String
name = "name"

status : String
status = "status"

self : String
self = "self"

parent : String
parent = "parent"

program : {e : HFunctor} -> {{page : dom <: e}} -> {{cu : custodian <: e}} -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (joinWith " " [top, name, status, self, parent]))

names : Co (dom <+> custodian) Unit
names = program (page := _) (cu := _)
