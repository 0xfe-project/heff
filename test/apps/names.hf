-- An app whose definitions have the names of the page's own: `top`,
-- `name`, `status`, `self` and `parent` are the program's, not the
-- page's (for test/app-run.mjs, whose page has `<p id="out">`).

import co
import std.dom

top : String
top = "top"

name : String
name = "name"

status : String
status = "status"

self : String
self = "self"

parent : String
parent = "parent"

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  out <- select "#out"
  found out (\o -> text o (joinWith " " [top, name, status, self, parent]))

names : Co dom Unit
names = program (page := here dom)
