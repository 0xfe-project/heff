-- An app of the page and std.time's clocks, read by the page's provider
-- (for a test whose page has `<p id="out">`): what it writes is what the
-- clocks said, over a sleep.

module test.apps.clocked

import co
import browser.dom
import custodian
import std.duration as Duration
import std.instant as Instant
import std.time as Time

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{onTime : Time.time <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> do
      t <- Time.now
      start <- Time.monotonic
      Time.sleep (Duration.milliseconds 10)
      end <- Time.monotonic
      -- (2026-01-01T00:00:00Z, in nanoseconds since the epoch)
      text
          o
          ("after 2026: "
           ^ debug (Instant.unixNanoseconds t > 1767225600000000000)
           ^ ", not fewer: "
           ^ debug (end >= start)))

clocked : Co (dom <+> Time.time <+> custodian) Unit
clocked = program (onDom := _) (onTime := _)
