-- Finding elements of the page: by a CSS selector and by an XPath (for
-- test/app-run.mjs, whose page has `<p id="out">` and `<p id="log">`).

import co
import dom
import prelude

-- | Write in an element, if it is found.
writeIn :: Maybe Int -> String -> Co (dom Int) Unit
writeIn Nothing _ = pure MkUnit
writeIn (Just n) str = text n str

finder :: Co (dom Int) Unit
finder = do
  out <- select "#out"
  writeIn out "found by css"
  log <- xpath "//p[@id='log']"
  writeIn log "found by xpath"
  none <- select "#nowhere"
  writeIn none "never"
