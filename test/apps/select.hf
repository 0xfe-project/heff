-- Finding elements of the page: by a CSS selector and by an XPath (for
-- test/app-run.mjs, whose page has `<p id="out">` and `<p id="log">`).

import co
import dom
import prelude

page : (dom <: dom)
page = here dom

-- | Write in an element, if it is found.
writeIn : Maybe Node -> String -> Co dom Unit
writeIn Nothing _ = pure MkUnit
writeIn (Just n) str = text page n str

finder : Co dom Unit
finder = do
  out <- select page "#out"
  writeIn out "found by css"
  log <- xpath page "//p[@id='log']"
  writeIn log "found by xpath"
  none <- select page "#nowhere"
  writeIn none "never"
