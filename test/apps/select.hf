-- Finding elements of the page: by a CSS selector and by an XPath (for
-- a test whose page has `<p id="out">` and `<p id="log">`).

module test.apps.select

import co
import browser.dom
import custodian

-- | Write in an element, if it is found.
writeIn : {e : HFunctor} -> {{page : dom <: e}} -> Maybe Element -> String -> Co e Unit
writeIn Nothing _ = pure MkUnit
writeIn (Just n) str = text n str

program : {e : HFunctor} -> {{page : dom <: e}} -> {{cu : custodian <: e}} -> Co e Unit
program = do
  with withDocument as doc do
    out <- select doc "#out"
    writeIn out "found by css"
    log <- xpath doc "//p[@id='log']"
    writeIn log "found by xpath"
    none <- select doc "#nowhere"
    writeIn none "never"

finder : Co (dom <+> custodian) Unit
finder = program (page := _) (cu := _)
