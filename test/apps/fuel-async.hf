-- An app of the page, std.time, std.fuel and boc, built with fuel (for a
-- test whose page has `<p id="out">`): the program of
-- test/node/fuel-async-program.hf, in JavaScript, its lines written
-- there.

module test.apps.fuel-async

import boc as BOC
import co
import browser.dom
import custodian
import std.fuel as Fuel
import std.time as Time
import test.node.fuel-async-program as Program

-- (the lines written in the page's `#out`)
written : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{cu : custodian <: e}}
        -> List String
        -> Co e Unit
written ls = do
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

fuelAsync : Co
            (BOC.boc
             <+> dom
             <+> Time.time
             <+> Fuel.fuel
             <+> custodian)
            Unit
fuelAsync = Program.lines written
