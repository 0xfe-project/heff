-- An app of the page, std.time, std.fuel and std.domain, built with fuel
-- (for a test whose page has `<p id="out">`): the program of
-- test/node/fuel-async-program.hf, in JavaScript, its lines written there.

module test.apps.fuel-async

import co
import browser.dom
import custodian
import std.domain as Domain
import std.fuel as Fuel
import std.time as Time
import test.node.fuel-async-program as Program

program : {e : HFunctor} -> {{onDom : dom <: e}} -> {{tm : Time.time <: e}} -> {{fl : Fuel.fuel <: e}} -> {{dm : Domain.domain <: e}} -> {{cu : custodian <: e}} -> Co e Unit
program = do
  ls <- Program.lines
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

fuelAsync : Co (dom <+> Time.time <+> Fuel.fuel <+> Domain.domain <+> custodian) Unit
fuelAsync = program (onDom := _) (tm := _) (fl := _) (dm := _)
