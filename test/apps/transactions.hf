-- An app of the page and stm on std.domain (for a test whose page has
-- `<p id="out">`): the program of test/node/transactions-program.hf, in
-- JavaScript's one domain, its lines written there.

module test.apps.transactions

import co
import browser.dom
import std.domain as Domain
import stm as STM
import test.node.transactions-program as Program

program : {e : HFunctor}
        -> {{onDom : dom <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  r <- STM.scheduled (Program.said (w := e) (sm := _) (dm := _))
  let ls = fromMaybe ["every thread waiting"] r
  with withDocument as doc do
    out <- select doc "#out"
    found out (\o -> text o (unlines ls))

transactions : Co (dom <+> Domain.domain) Unit
transactions = program (onDom := _) (dm := _)
