-- The reading of a `.hf` file, a piece at a time, each on a few texts:
-- the module claim read off, the tokens lexed, the comments attached
-- to them, the declarations read -- reading loses no token.

module test.syntax

import array as Array
import heff.syntax.cst
import heff.syntax.fmt.imports as Imports
import heff.syntax.fmt.lex as Lex
import heff.syntax.fmt.tokens as Tokens
import heff.syntax.import as Import
import std.ordmap as OrdMap

-- The module claim
--------------------------------------------------------------------------------

claimOf : String -> Maybe Import.Claim
claimOf src = (Import.readImports src).claim

-- (what is wrong with the claim, said)
errorSaid : Maybe Import.ClaimError -> String
errorSaid (Just err) = err.msg
errorSaid Nothing = ""

-- (the names the claim lists, if there is one: none listed, where it
-- names the module alone)
claimNames : Maybe Import.Claim -> Maybe (List String)
claimNames (Just h) =
  Just (List.map (\(x : Import.Exposed) -> x.name) h.exposes)
claimNames Nothing = Nothing

-- (the module's name, as its claim says it, if it does)
claimName : Maybe Import.Claim -> Maybe String
claimName (Just h) = h.name
claimName Nothing = Nothing

-- (whether the claim lists what the module exposes, else all it
-- defines is)
claimLists : Maybe Import.Claim -> Bool
claimLists (Just h) = h.listed
claimLists Nothing = False

-- (what is wrong with the claim, if anything)
claimError : Maybe Import.Claim -> String
claimError (Just h) = errorSaid h.error
claimError Nothing = ""

test claims

-- >>> claimNames (claimOf "module (With, withFile, T (..), (<+>))\n\nimport co\n\nx : Int\nx = 1\n")
-- Just ["With", "withFile", "T", "<+>"]

