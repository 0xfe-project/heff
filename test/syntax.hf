-- False

-- >>> claimError (claimOf "module (a, , b)\n")
-- "an empty entry: a module claim lists names: `x`, `T`, `T(..)`, `(<+>)`"

-- >>> claimError (claimOf "import co\nmodule (a)\n")
-- "the module claim comes first, before its imports"

-- >>> claimError (claimOf "module (a.b)\n")
-- "a module claim lists names: `x`, `T`, `T(..)`, `(<+>)`"

-- The tokens
--------------------------------------------------------------------------------

-- (kind:text)
showTok : Lex.Tok -> String
showTok t = t.kind ^ ":" ^ t.text

-- (`(lex src).tokens` in one step panics the elaborator today: an
-- ill-typed projection; through a binder it is fine)
showLexed : Lex.Lexed -> String
showLexed l = joinWith " " (List.map showTok l.tokens)

showToks : String -> String
showToks src = showLexed (Lex.lex src)

lexCmtText : Lex.Cmt -> String
lexCmtText c = c.text

tokCol : Lex.Tok -> Int
tokCol t = t.col

tokFirst : Lex.Tok -> Bool
tokFirst t = t.first

cmtTexts : Lex.Lexed -> List String
cmtTexts l = List.map lexCmtText l.comments

tokText : Lex.Tok -> String
tokText t = t.text

tokTexts : Lex.Lexed -> List String
tokTexts l = List.map tokText l.tokens

tokCols : Lex.Lexed -> List Int
tokCols l = List.map tokCol l.tokens

tokFirsts : Lex.Lexed -> List Bool
tokFirsts l = List.map tokFirst l.tokens

errMsg : Lex.Err -> String
errMsg e = e.msg

errMsgs : Lex.Lexed -> List String
errMsgs l = List.map errMsg l.errors

test lexing

