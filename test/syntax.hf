-- are a name and a list)
-- >>> showToks "b[1, \"x\"] b [2] ab[3] f b[]"
-- "punct:b[ int:1 punct:, str:x punct:] var:b punct:[ int:2 punct:] var:ab punct:[ int:3 punct:] var:f punct:b[ punct:] eof:"

-- The comments, attached to the tokens
--------------------------------------------------------------------------------

cmtText : Tokens.Cmt -> String
cmtText c = c.text

leadTexts : Tokens.Attached -> Int -> List String
leadTexts at ix = List.map cmtText (fromMaybe Nil (OrdMap.lookup at.env.lead ix))

inlineTexts : Tokens.Attached -> Int -> List String
inlineTexts at ix = fromMaybe Nil (OrdMap.lookup at.env.inline ix)

trailText : Tokens.Attached -> Int -> String
trailText at ix = fromMaybe "" (OrdMap.lookup at.env.trail ix)

tokRaw : T -> String
tokRaw t = t.raw

raws : Tokens.Attached -> List String
raws at = List.map tokRaw (Array.toList at.toks)

attachLexed : String -> Lex.Lexed -> Tokens.Attached
attachLexed src l = Tokens.attach src l.tokens l.comments

attached : String -> Tokens.Attached
attached src = attachLexed src (Lex.lex src)

test attaching

