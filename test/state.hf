-- state.hf's handler: the state threaded beside an effect of the rest

import check
import co
import parallel
import state

-- (the state counted up, beside an effect of the rest, `parallel`'s)
counted : Co (state Int <+> parallel Int Int) Int
counted = do
  n <- get (ev := inl (state Int) (parallel Int Int))
  put (ev := inl (state Int) (parallel Int Int)) (n + 1)
  m <- get (ev := inl (state Int) (parallel Int Int))
  pure (m * 10)

threads : Test
threads =
  unit
    "runState"
    (assertEqual
       (handle (turns Int Int) (runState 1 counted))
       (MkPair 20 2 : Pair Int Int))
