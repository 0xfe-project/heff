-- `heff bench`, run on files made for it, each test in a directory of
-- its own: which benchmarks it finds and selects, how it grows a
-- benchmark's count, the lines it says (Go's), that `keep` keeps work
-- the compiler would drop, and a benchmark that fails, abandons or is
-- skipped.

module test.bench

import check
import co
import json as JSON
import std.filesystem
import std.path as Path
import std.process

-- (did it end by itself, with this status)
exitedWith : Int -> Ended -> Bool
exitedWith n (Exited m) = n == m
exitedWith n _ = False

-- (the heff that runs the tests: `heff test` sets HEFF)
heffGiven : {e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> Co e String
heffGiven = do
  v <- getEnv "HEFF"
  case v of
    Just s -> pure s
    Nothing -> failure "HEFF is not set: `heff test` sets it"

-- (`heff bench` run here on these arguments)
heffBench : {e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> List String
          -> Co e Ran
heffBench argv = do
  heff <- heffGiven
  run { command = heff, args = Cons "bench" argv }

-- (what it said, for a failure to show)
said : Ran -> String
said r = r.out ^ "--stderr--\n" ^ r.err

-- (a file of benchmarks: bench imported as `Bench`, check and co, then
-- these definitions)
benchSource : String -> String
benchSource defs =
  "import bench as Bench\nimport check\nimport co\n\nfib : Int -> Int\nfib n = if n < 2 then n else fib (n - 1) + fib (n - 2)\n\n"
  ^ defs

-- (each line of JSON it said)
jsonLines : Ran -> List JSON.Json
jsonLines r =
  List.concatMap
    (\l -> case JSON.parse l of
       Right j -> [j]
       Left why -> Nil)
    (List.keepIf (\l -> not (strEq l "")) (split "\n" r.out))

-- (the names of each benchmark it said, as `--json` says them)
namesSaid : Ran -> List (List String)
namesSaid r =
  List.map
    (\j ->
       List.map
         (\n -> fromMaybe "" (JSON.str Nil n))
         (fromMaybe Nil (JSON.arr ["names"] j)))
    (jsonLines r)

-- (the line of the benchmark of these names, as `--json` says it)
lineOf : Ran -> List String -> Maybe JSON.Json
lineOf r names =
  List.find
    (\j ->
       strEq
         (joinWith
            "/"
            (List.map
               (\n -> fromMaybe "" (JSON.str Nil n))
               (fromMaybe Nil (JSON.arr ["names"] j))))
         (joinWith "/" names))
    (jsonLines r)

-- (a field of a benchmark's line, an integer)
intOf : String -> Maybe JSON.Json -> Int
intOf k (Just j) = fromMaybe (0 - 1) (JSON.int [k] j)
intOf k Nothing = 0 - 1

-- (nanoseconds per op of a benchmark's line)
perOpOf : Maybe JSON.Json -> Float64
perOpOf (Just j) = case JSON.at ["ns_per_op"] j of
  Just (JFloat x) -> x
  Just (JInt i) -> toFloat i
  _ -> 0.0
perOpOf Nothing = 0.0

-- (benchmarks found by their type: a group of two, one alone, and one a
-- group of the file's uses, run under it only)
-- (a module's text, named)
headed : String -> String -> String
headed name text = "module " ^ name ^ "\n\n" ^ text

found : String
found =
  benchSource
    "fibs : Bench.Bench\nfibs = Bench.group \"fib\"\n  [ Bench.bench \"10\" (\\n -> Bench.times n (\\i -> fib (Bench.keep 10)))\n  , Bench.bench \"15\" (\\n -> Bench.times n (\\i -> fib (Bench.keep 15)))\n  ]\n\nalone : Bench.Bench\nalone = Bench.bench \"alone\" (\\n -> Bench.times n (\\i -> i))\n\nshared : Bench.Bench\nshared = Bench.bench \"shared\" (\\n -> Bench.times n (\\i -> i))\n\nouter : Bench.Bench\nouter = Bench.group \"outer\" [shared]\n"

-- (what it said of these names, run with a short time, as JSON)
listedBy : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> List String
         -> Co e (List (List String))
listedBy argv = do
  r <- heffBench (List.append ["--time", "2x", "--json"] argv)
  assert ("it ran:\n" ^ said r) (succeeded r)
  pure (namesSaid r)

-- | which benchmarks `heff bench` finds and runs: a file's own of type
-- | `Bench`, by their names, those a group uses under it only, a
-- | directory's files' (one with none passed over), else bench/'s; and
-- | those `--run` selects, a level each, as `heff test --run`
discovery : Test
discovery = group "found and selected"
  [ integration "a directory's files, their own benchmarks" (do
      a <- writeFile "a.hf" (headed "a" found)
      b <- writeFile "b.hf" "module b\n\nx : Int\nx = 1\n"
      names <- listedBy ["."]
      assertEqual names [["fib", "10"], ["fib", "15"], ["alone"], ["outer", "shared"]])
  , integration "bench/'s, given no file" (do
      made <- makeDirectory "bench"
      a <- writeFile "bench/a.hf" (headed "a" found)
      names <- listedBy Nil
      assertEqual names [["fib", "10"], ["fib", "15"], ["alone"], ["outer", "shared"]])
  , integration "selected by --run, a level each" (do
      a <- writeFile "a.hf" (headed "a" found)
      deep <- listedBy ["--run", "fib/15", "a.hf"]
      assertEqual deep [["fib", "15"]]
      second <- listedBy ["--run", "/10", "a.hf"]
      assertEqual second [["fib", "10"], ["alone"]]
      groups <- listedBy ["--run", "^fib$|^outer$", "a.hf"]
      assertEqual groups [["fib", "10"], ["fib", "15"], ["outer", "shared"]]
      none <- heffBench ["--run", "nothing-is-named-so", "a.hf"]
      assert ("none matched:\n" ^ said none) (exitedWith 1 none.ended)
      assert
          ("it said none matched:\n" ^ said none)
          (contains "no benchmarks match 'nothing-is-named-so'" none.err))
  ]

-- | a benchmark's count grown, as Go's: from 1 until a run takes the
-- | bench time, the last run said; a count given (`100x`), run once of
-- | it; and each run again, as `--count` says
growth : Test
growth = group "the count"
  [ integration "grown until a run takes the time" (do
      a <- writeFile "a.hf" (headed "a" found)
      r <- heffBench ["--time", "30ms", "--json", "--run", "fib/15", "a.hf"]
      assert ("it ran:\n" ^ said r) (succeeded r)
      fib15 <- pure (lineOf r ["fib", "15"])
      assert ("it grew:\n" ^ r.out) (intOf "n" fib15 > 1)
      assert
          ("its last run took the time:\n" ^ r.out)
          (intOf "ns" fib15 >= 30000000))
  , integration "a count given, run once" (do
      a <- writeFile "a.hf" (headed "a" found)
      r <- heffBench ["--time", "7x", "--json", "--run", "fib/15", "a.hf"]
      assert ("it ran:\n" ^ said r) (succeeded r)
      assertEqual (intOf "n" (lineOf r ["fib", "15"])) 7)
  , integration "each run --count times" (do
      a <- writeFile "a.hf" (headed "a" found)
      r <-
        heffBench ["--time", "3x", "--count", "3", "--json", "--run", "fib/", "a.hf"]
      assert ("it ran:\n" ^ said r) (succeeded r)
      assertEqual
          (namesSaid r)
          [ ["fib", "10"]
          , ["fib", "10"]
          , ["fib", "10"]
          , ["fib", "15"]
          , ["fib", "15"]
          , ["fib", "15"]
          ])
  , integration "a time that is none is refused" (do
      a <- writeFile "a.hf" (headed "a" found)
      r <- heffBench ["--time", "soon", "a.hf"]
      assert ("it was refused:\n" ^ said r) (exitedWith 2 r.ended))
  ]

-- (a line of a benchmark, as Go says it, cut at its tabs: its name
-- padded, its count, and per op its nanoseconds, bytes and objects)
goLine : Int -> String -> Bool
goLine width l = case split "\t" l of
  Cons name (Cons n (Cons ns (Cons bytes (Cons allocs Nil)))) ->
    strLength name == width
    && startsWith "Benchmark" name
    && strEq n "       3"
    && endsWith " ns/op" ns
    && strLength ns >= 16
    && endsWith " B/op" bytes
    && strLength bytes >= 13
    && endsWith " allocs/op" allocs
    && strLength allocs >= 18
  _ -> False

-- | the lines `heff bench` says, as Go's: `pkg: FILE`, a line each
-- | benchmark, its name `Benchmark` and its names between `/`s, padded
-- | to the longest, then its count and per op its nanoseconds, bytes
-- | and objects, a tab between each; then `ok` and the file
format : Test
format =
  integration "Go's lines" (do
  a <- writeFile "a.hf" (headed "a" found)
  r <- heffBench ["--time", "3x", "a.hf"]
  assert ("it ran:\n" ^ said r) (succeeded r)
  ls <- pure (List.keepIf (\l -> not (strEq l "")) (split "\n" r.out))
  assertEqual (List.head ls) (Just "pkg: a.hf")
  assertEqual (List.last ls) (Just "ok    a.hf")
  assertEqual
      (List.map
         (\l -> trim (fromMaybe "" (List.head (split "\t" l))))
         (List.take 4 (List.drop 1 ls)))
      [ "BenchmarkFib/10"
      , "BenchmarkFib/15"
      , "BenchmarkAlone"
      , "BenchmarkOuter/shared"
      ]
  assert
      ("each line is Go's:\n" ^ r.out)
      (List.all (goLine 21) (List.take 4 (List.drop 1 ls))))

-- (pure work, kept, and the same work dropped)
pureWork : String
pureWork =
  benchSource
    "dropped : {a : Type} -> Int -> Int -> (Int -> a) -> Unit\ndropped i n f = if i >= n then MkUnit else let r = f i in dropped (i + 1) n f\n\nshows : Bench.Bench\nshows = Bench.group \"show\"\n  [ Bench.bench \"kept\" (\\n -> Bench.times n (\\i -> show (i * 7919)))\n  , Bench.bench \"dropped\" (\\n -> pure (dropped 0 n (\\i -> show (i * 7919))))\n  , Bench.bench \"known\" (\\n -> Bench.times n (\\i -> show (Bench.keep 123456789)))\n  ]\n"

-- | `keep` keeps work the compiler would drop: a string shown each time,
-- | its result kept, makes one object a time and takes nanoseconds,
-- | where the same work, its result not kept, is dropped -- nothing
-- | made, next to no time -- and one made of what is kept is shown each
-- | time, not once
kept : Test
kept =
  integration "keep keeps pure work" (do
  a <- writeFile "a.hf" (headed "a" pureWork)
  r <- heffBench ["--time", "20ms", "--json", "a.hf"]
  assert ("it ran:\n" ^ said r) (succeeded r)
  shown <- pure (lineOf r ["show", "kept"])
  assertEqual (intOf "allocs_per_op" shown) 1
  assert ("it takes time:\n" ^ r.out) (perOpOf shown >= 2.0)
  assertEqual (intOf "allocs_per_op" (lineOf r ["show", "known"])) 1
  -- (else this test shows nothing of keep)
  assertEqual (intOf "allocs_per_op" (lineOf r ["show", "dropped"])) 0)

-- (benchmarks that go through, fail, abandon and are skipped)
going : String
going =
  benchSource
    "fine : Bench.Bench\nfine = Bench.bench \"fine\" (\\n -> Bench.times n (\\i -> i))\n\nfails : Bench.Bench\nfails = Bench.bench \"fails\" (\\n -> assert \"one is two\" (1 == 2))\n\nabandons : Bench.Bench\nabandons = Bench.bench \"abandons\" (\\n -> Bench.times n (\\i -> if i > 1 then abandon else i))\n\nskips : Bench.Bench\nskips = Bench.bench \"skips\" (\\n -> skip \"not here\")\n"

-- | a benchmark that fails, abandons or is skipped said so, as Go says
-- | it, why under it; the others run; the file, and `heff bench`, fail;
-- | a file that does not check fails, and the others go on
failing : Test
failing =
  integration "failing, abandoning, skipped" (do
  a <- writeFile "a.hf" (headed "a" going)
  b <- writeFile "b.hf" (headed "b" (benchSource "oops : Bench.Bench\noops = 1\n"))
  r <- heffBench ["--time", "5x", "b.hf", "a.hf"]
  assert ("it failed:\n" ^ said r) (exitedWith 1 r.ended)
  assert
      ("the file that does not check failed:\n" ^ r.out)
      (contains "FAIL  b.hf\n    b.hf:" r.out)
  assert ("the fine one ran:\n" ^ r.out) (contains "\nBenchmarkFine" r.out)
  assert
      ("the failing one failed:\n" ^ r.out)
      (contains "--- FAIL: BenchmarkFails\n    one is two\n" r.out)
  assert
      ("the abandoning one failed:\n" ^ r.out)
      (contains "--- FAIL: BenchmarkAbandons\n    it abandoned\n" r.out)
  assert
      ("the skipped one was skipped:\n" ^ r.out)
      (contains "--- SKIP: BenchmarkSkips\n    not here\n" r.out)
  assert ("the file failed:\n" ^ r.out) (endsWith "FAIL  a.hf\n" r.out)
  json <- heffBench ["--time", "5x", "--json", "--run", "fails|skips", "a.hf"]
  assertEqual
      (List.map (\j -> JSON.str ["failed"] j) (jsonLines json))
      [Just "one is two", Nothing]
  assertEqual
      (List.map (\j -> JSON.str ["skipped"] j) (jsonLines json))
      [Nothing, Just "not here"])

-- | `heff bench`, held to what it is to do
benches : Test
benches =
  withinTime
    300000
    (group "heff bench" [discovery, growth, format, kept, failing])
