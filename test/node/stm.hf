-- std.stm among green threads in a program of the world: the store the
-- world's state, handled in the language around stdio (std.state's
-- `runState`), the threads printing as they go.  The uses are
-- test.programs.stm's.

module test.node.stm

import co
import green
import state
import std.io
import std.stm
import test.programs.stm

-- (a clerk's transfers, each said when its last is done)
saying : {e : HFunctor}
       -> {{gr : green <: e}}
       -> {{st : stored Accounts <: e}}
       -> {{io : stdio <: e}}
       -> Co e Unit
saying = do
  ch <- newChan
  spawnEach 4 (\i -> do
    clerk (i + 1) 1000
    send ch i)
  joined ch 4
  t <- atomically (total accounts)
  print ("total " ^ show t)

-- | Four clerks making 1000 transfers each, the total printed after.
main : Co stdio Unit
main = do
  r <-
    runState
      (sharing opened)
      (scheduled
         (saying
            (gr := _)
            (st := _)
            (io := _)))
  print (ev := _) (shownOr (\u -> "done") (fst r))
