-- A computation held by an operation of the world, run in a thread of
-- cml's: computed where the operation runs it, not where cml hands the
-- operation on -- so std.fuel's `limited` stops a pure loop at the start
-- of it, and std.domain's `tried` catches a failure there.  And a `tried`
-- in a limit does not catch running out of it.  Built with fuel, on C.

module test.node.fuel-cml

import cml as CML
import co
import custodian as Custodian
import std.domain as Domain
import std.fuel as Fuel
import std.io

-- (a loop of no operation, never ending)
spin : Int -> Int
spin n = spin (n + 1)

-- (the threads' world, and the program's: theirs with the custodian)
base : HFunctor
base = stdio <+> Fuel.fuel <+> Domain.domain

world : HFunctor
world = base <+> Custodian.custodian

failing : Unit -> Int
failing u = if 1 == 1 then abandon else 0

-- (a thread's: a pure loop limited, and a failure tried, each at once)
thread : {e : HFunctor}
       -> {{fu : Fuel.fuel <: e}}
       -> {{dm : Domain.domain <: e}}
       -> Co e (Pair (Maybe Int) (Either String Int))
thread = do
  r <- Fuel.limited 100000 (later (\u -> spin 0))
  t <- Domain.tried (later failing)
  pure (MkPair r t)

-- (what a limit came to)
limitSaid : Maybe Int -> String
limitSaid (Just x) = "Just " ^ debug x
limitSaid Nothing = "Nothing"

triedSaid : Either String Int -> String
triedSaid (Left why) = "Left " ^ why
triedSaid (Right x) = "Right " ^ debug x

said : Maybe (Pair (Maybe Int) (Either String Int)) -> List String
said (Just (MkPair r t)) =
  [ "limited in a cml thread: " ^ limitSaid r
  , "tried in a cml thread: " ^ triedSaid t
  ]
said Nothing = ["all waiting"]

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

main : Co world Unit
main = do
  r <- CML.scheduled (w := base) thread
  printed (said r)
  caught <- Fuel.limited 1000 (Domain.tried (later (\u -> spin 0)))
  print
      ("a tried in a limit: "
       ^ (case caught of
          Just _ -> "caught"
          Nothing -> "Nothing"))
