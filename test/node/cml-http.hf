-- std.http's requests from cml's threads, waiting on the world through
-- each domain's reactor (`CML.scheduledWithReactor`): each pending while
-- the others go on (libcurl's multi interface).  By C alone.
--
--   main BASE N REFUSED   N requests of BASE/item/I at once, from a
--                         thread each, to a server that takes its time
--                         over each (the test's): all of them in about
--                         the time of one; and one to a port nothing
--                         listens on, refused, while they wait
--   self                  this program's own server (CmlServer.serve)
--                         asked by ten threads at once, std.net's and
--                         libcurl's sockets waited on together

module test.node.cml-http

import cml as CML
import co
import custodian as Custodian
import exception
import std.domain as Domain
import std.http as HTTP
import std.http.cmlserver as CmlServer
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import resource

-- (n values received on ch, added up)
recvSum : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> CML.Chan w Int
        -> Int
        -> Int
        -> Co e Int
recvSum ch 0 acc = pure acc
recvSum ch n acc = do
  x <- CML.recv ch
  recvSum ch (n - 1) (acc + x)

-- (what came back, as the test checks it: 1 where it is the item's)
itemIs : Int -> Either HTTP.HttpError String -> Int
itemIs i (Right t) = if strEq t ("item " ^ debug i ^ "\n") then 1 else 0
itemIs i (Left err) = 0

-- (a thread fetching item i, saying on `back` whether it came)
fetcher : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{webw : HTTP.http <: w}}
        -> String
        -> CML.Chan w Int
        -> Int
        -> Co e Unit
fetcher base back i = do
  r <- HTTP.getText (base ^ "/item/" ^ debug i)
  CML.send back (itemIs i r)

-- (fetchers of items `i` down to 1, each a thread of its own)
fetchers : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> {{web : HTTP.http <: e}}
         -> {{webw : HTTP.http <: w}}
         -> String
         -> CML.Chan w Int
         -> Int
         -> Co e Unit
fetchers base back 0 = pure MkUnit
fetchers base back i = do
  CML.spawn (fetcher base back i)
  fetchers base back (i - 1)

-- (where no response came: curl's code)
codeOf : Either HTTP.HttpError HTTP.Response -> String
codeOf (Left err) = "code " ^ debug err.code
codeOf (Right r) = "status " ^ debug r.status

fetches : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{webw : HTTP.http <: w}}
        -> String
        -> Int
        -> Int
        -> Co e Unit
fetches base n refused = do
  back <- CML.newChan
  fetchers base back n
  r <- HTTP.get ("http://127.0.0.1:" ^ debug refused ^ "/")
  print ("refused, while the others wait: " ^ codeOf r)
  got <- recvSum back n 0
  print ("items fetched at once: " ^ debug got)

-- (the arguments: BASE N REFUSED)
argsOf : List String -> Maybe (Pair String (Pair Int Int))
argsOf (b :: n :: r :: _) =
  Just (MkPair b (MkPair (fromMaybe 0 (parseInt n)) (fromMaybe 1 (parseInt r))))
argsOf _ = Nothing

ran : {e : HFunctor} -> {{io : stdio <: e}} -> Maybe Unit -> Co e Unit
ran r = print (maybe "a deadlock" (\u -> "main done") r)

main : Co
       (stdio <+> HTTP.http <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain <+> Custodian.custodian)
       Unit
main = do
  argv <- args (ev := _)
  case argsOf argv of
    Just (MkPair b (MkPair n r)) -> do
      done <-
        CML.scheduledWithReactor
          (dm := _)
          (rx := _)
          (fetches
             (w := stdio <+> HTTP.http <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain <+> Custodian.custodian)
             (cm := _)
             (io := _)
             (web := _)
             b
             n
             r)
      ran (io := _) done
    Nothing -> printErr (ev := _) "main BASE N REFUSED"

-- This program's own server
--------------------------------------------------------------------------------

-- (the value of a `Right`; where there is none, the program abandoned)
must : {a : Type} -> Either Net.NetError a -> a
must (Right x) = x
must (Left err) = abandon

-- (each item answered as the server of the test's answers it)
item : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
item r =
  pure
    (Server.plain
       200
       ("item " ^ strSlice r.target 6 (strLength r.target) ^ "\n"))

-- (the listener served by a thread of its own, and asked of by ten)
askedOn : {e w : HFunctor}
        -> {s : Type}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{webw : HTTP.http <: w}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> With s Net.TcpListener
        -> Co e Unit
askedOn l = do
  at <- Net.local l
  CML.spawn (CmlServer.serve (w := w) Empty l item)
  back <- CML.newChan
  let base = "http://127.0.0.1:" ^ debug (must at).port
  fetchers base back 10
  got <- recvSum back 10 0
  print ("asked of its own server, at once: " ^ debug got)

asked : {e w : HFunctor}
      -> {{cm : CML.cml w <: e}}
      -> {{io : stdio <: e}}
      -> {{web : HTTP.http <: e}}
      -> {{webw : HTTP.http <: w}}
      -> {{nt : Net.net <: e}}
      -> {{ntw : Net.net <: w}}
      -> {{ex : exception Net.NetError <: e}}
      -> Co e Unit
asked =
  bind
    (Net.withListener { host = "127.0.0.1", port = 0 } 64 (\l -> askedOn l))
    (either throw pure)

-- (what main came to: a deadlock, a throw no thread heard, or done)
said : Maybe (Either Net.NetError Unit) -> String
said Nothing = "a deadlock"
said (Just (Left err)) = "not heard: " ^ show err
said (Just (Right u)) = "main done"

self : Co
       (stdio <+> HTTP.http <+> Net.net <+> Reactor.reactor <+> Domain.domain <+> Custodian.custodian)
       Unit
self = do
  done <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (asked
            (w := stdio <+> HTTP.http <+> Net.net <+> Reactor.reactor <+> Domain.domain <+> Custodian.custodian)
            (cm := _)
            (io := _)
            (web := _)
            (nt := _)
            (ex := _)))
  print (ev := _) (said done)
