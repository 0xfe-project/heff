eddsaSignature : Bytes
eddsaSignature =
  hex
    (joinWith
       ""
       [ "11087297c25291eb65d200bf6a9e2f3ddedf11e754c17e9b386d7d9c8a76bd50"
       , "c837789d7c8e0aafe345c8183078971ed42ceeab35a2e3800de6870221499801"
       ])

-- (why, without what OpenSSL said of it, which its versions say each
-- their own way)
reasonless : String -> String
reasonless w = fromMaybe w (List.head (split " (" w))

-- (what could not be made, said)
refused : {a : Type} -> String -> Either String a -> String
refused what (Left why) = what ^ ": refused, " ^ reasonless why
refused what (Right _) = what ^ ": made"

-- (a signature made, verified: of the message, of another, and changed)
signedSaid : {e : HFunctor}
           -> {{c : Crypto.crypto <: e}}
           -> {{io : stdio <: e}}
           -> String
           -> Crypto.Algorithm
           -> Crypto.PublicKey
           -> Either String Bytes
           -> Co e Unit
signedSaid what a p (Right sig) = do
  ok <- Crypto.verify a p message sig
  other <- Crypto.verify a p (Bytes.fromString "heff signs that") sig
  changed <- Crypto.verify a p message (Bytes.map (\x -> xor x 1) sig)
  print
      (what
       ^ ": "
       ^ debug (Bytes.length sig)
       ^ " bytes, verified "
       ^ debug ok
       ^ ", another message "
       ^ debug other
       ^ ", changed "
       ^ debug changed)
signedSaid what a p (Left why) = print (what ^ ": not signed, " ^ why)

-- (the message signed with a key read, verified with the other)
ownRound : {e : HFunctor}
         -> {{c : Crypto.crypto <: e}}
         -> {{io : stdio <: e}}
         -> String
         -> Crypto.Algorithm
         -> Either String Crypto.PrivateKey
         -> Either String Crypto.PublicKey
         -> Co e Unit
ownRound what a (Right k) (Right p) = do
  s <- Crypto.sign a k message
  signedSaid what a p s
ownRound what a (Left why) _ = print (what ^ ": no private key, " ^ why)
ownRound what a _ (Left why) = print (what ^ ": no public key, " ^ why)

-- (a signature openssl made, verified with a key read or made)
theirs : {e : HFunctor}
       -> {{c : Crypto.crypto <: e}}
       -> {{io : stdio <: e}}
       -> String
       -> Crypto.Algorithm
       -> Bytes
       -> Either String Crypto.PublicKey
       -> Co e Unit
theirs what a sig (Right p) = do
  ok <- Crypto.verify a p message sig
  print (what ^ ": " ^ debug ok)
theirs what a sig (Left why) = print (what ^ ": no key, " ^ why)

-- (RS256's signature, which is the same each time: as openssl's)
sameAsTheirs : {e : HFunctor}
             -> {{c : Crypto.crypto <: e}}
             -> {{io : stdio <: e}}
             -> Either String Crypto.PrivateKey
             -> Co e Unit
sameAsTheirs (Right k) = do
  s <- Crypto.sign RS256 k message
  print
      ("RS256 by RSA's own PEM, as openssl's: "
       ^ (case s of
          Right sig -> debug (Bytes.eq sig rs256Signature)
          Left why -> why))
sameAsTheirs (Left why) = print ("no key of RSA's own PEM: " ^ why)

-- (a key of a kind not the algorithm's: not signed, not verified)
otherKind : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> Either String Crypto.PrivateKey
          -> Either String Crypto.PublicKey
          -> Co e Unit
otherKind (Right k) (Right p) = do
  s <- Crypto.sign ES256 k message
  print (refused "ES256 by an RSA key" s)
  ok <- Crypto.verify EdDSA p message eddsaSignature
  print ("EdDSA's signature by an RSA key: " ^ debug ok)
  short <- Crypto.verify RS256 p message Bytes.empty
  print ("RS256, no signature: " ^ debug short)
otherKind _ _ = print "no RSA key"

-- (ES256's signature, not of 64 bytes: not verified)
shortened : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> Either String Crypto.PublicKey
          -> Co e Unit
shortened (Right p) = do
  ok <- Crypto.verify ES256 p message (Bytes.slice es256Signature 0 63)
  print ("ES256, 63 bytes: " ^ debug ok)
shortened (Left why) = print ("no P-256 key: " ^ why)

-- (a private key's public one, verifying what it signs)
itsPublic : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> Either String Crypto.PrivateKey
          -> Co e Unit
itsPublic (Right k) = do
  p <- Crypto.publicOf k
  s <- Crypto.sign EdDSA k message
  signedSaid "EdDSA, the private key's public one" EdDSA p s
itsPublic (Left why) = print ("no Ed25519 key: " ^ why)

program : {e : HFunctor}
        -> {{c : Crypto.crypto <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  rsa <- Crypto.privateKeyFromPem rsaPrivate
  rsaOwn <- Crypto.privateKeyFromPem rsaTraditional
  rsaPub <- Crypto.publicKeyFromPem rsaPublic
  rsaPubOwn <- Crypto.publicKeyFromPem rsaPublicTraditional
  ec <- Crypto.privateKeyFromPem ecPrivate
  ecOwn <- Crypto.privateKeyFromPem ecTraditional
  ecPub <- Crypto.publicKeyFromPem ecPublic
  ed <- Crypto.privateKeyFromPem edPrivate
  edPub <- Crypto.publicKeyFromPem edPublic
  ownRound "RS256" RS256 rsa rsaPub
  ownRound "PS256" PS256 rsa rsaPub
  ownRound "ES256" ES256 ec ecPub
  ownRound "ES256 by EC's own PEM" ES256 ecOwn ecPub
  ownRound "EdDSA" EdDSA ed edPub
  sameAsTheirs rsaOwn
  theirs "openssl's RS256" RS256 rs256Signature rsaPub
  theirs "openssl's RS256, RSA's own public PEM" RS256 rs256Signature rsaPubOwn
  theirs "openssl's PS256" PS256 ps256Signature rsaPub
  theirs "openssl's PS256 as RS256" RS256 ps256Signature rsaPub
  theirs "openssl's ES256" ES256 es256Signature ecPub
  theirs "openssl's EdDSA" EdDSA eddsaSignature edPub
  rsaJwk <- Crypto.rsaPublicKey rsaN (hex "010001")
  theirs "openssl's RS256, a JWK's key" RS256 rs256Signature rsaJwk
  ecJwk <- Crypto.p256PublicKey ecX ecY
  theirs "openssl's ES256, a JWK's key" ES256 es256Signature ecJwk
  edJwk <- Crypto.ed25519PublicKey edX
  theirs "openssl's EdDSA, a JWK's key" EdDSA eddsaSignature edJwk
  itsPublic ed
  otherKind rsa rsaPub
  shortened ecPub
  notPem <- Crypto.privateKeyFromPem "not a key"
  print (refused "a private key of no PEM" notPem)
  publicAsPrivate <- Crypto.privateKeyFromPem rsaPublic
  print (refused "a private key of a public PEM" publicAsPrivate)
  broken <- Crypto.publicKeyFromPem (strSlice rsaPublic 0 200)
  print (refused "a public key of a PEM cut short" broken)
  shortX <- Crypto.p256PublicKey (Bytes.slice ecX 0 31) ecY
  print (refused "a P-256 key, x of 31 bytes" shortX)
  offCurve <- Crypto.p256PublicKey ecY ecX
  print (refused "a P-256 key off the curve" offCurve)
  shortEd <- Crypto.ed25519PublicKey (Bytes.slice edX 0 31)
  print (refused "an Ed25519 key of 31 bytes" shortEd)
  noModulus <- Crypto.rsaPublicKey Bytes.empty (hex "010001")
  print (refused "an RSA key of no modulus" noModulus)

main : Co (Crypto.crypto <+> stdio) Unit
main = program (c := _) (io := _)
