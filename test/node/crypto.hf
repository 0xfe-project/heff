-- (an Ed25519 key, encrypted: its passphrase `x`)
encryptedPrivate : String
encryptedPrivate =
  pem
    [ "-----BEGIN ENCRYPTED PRIVATE KEY-----"
    , "MIGjMF8GCSqGSIb3DQEFDTBSMDEGCSqGSIb3DQEFDDAkBBAnpnSSCwyszmYS0/7g"
    , "kDUPAgIIADAMBggqhkiG9w0CCQUAMB0GCWCGSAFlAwQBKgQQzOh+EADfkC8iH3i7"
    , "J+JMNQRAmQDIcSHmpMmqFVA8rsteKgAwrsonFrV+/zj8pVptTwWfRPEJNokCDZFD"
    , "43ZbNL3EnhzzYYu2O2aZPC6HsagSUQ=="
    , "-----END ENCRYPTED PRIVATE KEY-----"
    ]

-- (bytes, in hex)
hex : String -> Bytes
hex s = fromMaybe Bytes.empty (Hex.decode s)

-- (the RSA key's modulus, its JWK's `n`)
rsaN : Bytes
rsaN =
  hex
    (joinWith
       ""
       [ "c9ed426f591afd3fb45a9d3b6d88c2bd7851a8f90e8cfdd1272a2fafd8acf92b"
       , "40f34d760c7ddd801f30b93a81e7e9df32bd03d5a5710a6fea6645bc32643817"
       , "45281b7f31274c0726f44578bf17bb6fd4b5eec52ae546a1889382b04eacd465"
       , "71127011ec0e57f5e17afb6d77b13496819d8a483095387f7362cab9a7dd681b"
       , "a3998a56bef979af097652513632c6ab0dacbaba991faa76efa574fa36621c90"
       , "f62df2050074aa7a6db8a4c5af936a404850f1aa668b654ccb05b153808ad0ab"
       , "d70840c5a1e5770600c43ca2089cab6b134c22e0849035251b71a16ad24e06f1"
       , "babfc65fc13bdd80c03e5ef493ecd38d2e8a3dd47a5c40f4c87362c0589a384f"
       ])

-- (the 1024-bit RSA key's modulus)
rsaShortN : Bytes
rsaShortN =
  hex
    (joinWith
       ""
       [ "b9096e138ede10e05a9749d50847d9353568fea09ad53a5aa17a3b4c184a5ad6"
       , "dbecb4ace22d0fa48db5c0d0a9f1ce106388f335fd98b7f179fd8febe6987c85"
       , "35cdc6fce163c4d0e697345ef5c32f8995e67a7eb8256e50c051a56adc692238"
       , "ffde42b945c50745db70be25f0d72211ef9f7babf8f306952ae46d54d9278393"
       ])

-- (the P-256 key's point, its JWK's `x` and `y`)
ecX : Bytes
ecX = hex "3a7008df4cf4cfd952c156f9de39ab658e4cc9e9c062ebe5562cc925a5b2f6cf"

ecY : Bytes
ecY = hex "4ca20b16cac6bfc0f2dfeed369d8ccac7b91a2aef3d001bbb1192bd43136c41a"

-- (the Ed25519 key, its JWK's `x`)
edX : Bytes
edX = hex "ad247c766064b53f1fe36085aaf900efc07ae9cbb3c759a91c22b89fe2dd43d8"

-- | What is signed.
message : Bytes
message = Bytes.fromString "heff signs this"

-- (the message signed by openssl: `openssl dgst -sha256 -sign`, with the
-- RSA key)
rs256Signature : Bytes
rs256Signature =
  hex
    (joinWith
       ""
       [ "36b9d4be920b428d65978ff410bb4664003c4e9bdc3273d51bf468082198ad1e"
       , "04a5d9535dd97f6a6f2265ec9ad48688684b060a33a098c45329d12e983601c6"
       , "fc0b9a7bbe882c32522adbd183f1bea642e3089b6f20a68c6eea49e69b7e1552"
       , "f7ea3b792d2f0d5d627661586417c850ec6cb51384c84e5360adb4a92e4b4bbc"
       , "b9735a7c3c21b81eb2275ac63783f930aa271bc1a480b033a8481ffb7636e0ef"
       , "5020a47b27583d26b071fb09efa5e6b8a2702f8d59fc0b1c8ca15f10c30b6e2e"
       , "0d6e49f17a4b52b2e90a16f5f25a915aab88882d79de141ebb0f38825d8aeef5"
       , "374ed608ea82c729e8d9f11cef5e1043bba0a1e38765fc8bedcaa8fb035aef1d"
       ])

-- (... by PSS, a salt of 32 bytes)
ps256Signature : Bytes
ps256Signature =
  hex
    (joinWith
       ""
       [ "261d4311240cced7b63e9278ddf9eaa03ec8dd0c8b59f66c605883a9d0c4551e"
       , "bfc0aa72aa703b41d6ee77eba73ddad523263e2eb448b2baa0aa226ec7e0c283"
       , "3e97f0447c8e5771edaa5382074c92ce98c2a6aa34f10c086af27e9d4f3292fc"
       , "c9dc8b241c453751f546e0bbd5ccae420dc7948c5a8a16b27acfc8504878b7c9"
       , "fd290069214b75d69f72f8fca6a52c82c32c1f88a18cc70a3960580f25180860"
       , "af74362092149af304ab5ac3103a9ad517a903125c2281391d024464c2ccae16"
       , "c3cec23761cee7fb3297a77f4c7c422ee134ae3a69c50ca54ee7c845b577bfd2"
       , "28f51d06038fb6499b2d887bc9b0f54660c5afb0617141feeb896765b335368f"
       ])

-- (... with the P-256 key, its DER made `r` and `s`)
es256Signature : Bytes
es256Signature =
  hex
    (joinWith
       ""
       [ "ca8febfe5e6030d22b32de39b77d2ae6ed80e8b76939fa1a1c0c021938923674"
       , "69947901b16b7aa4fbbd7d7c2c843fc061d4f790afc51cc58a5ac932d1a9d465"
       ])

-- (... with the Ed25519 key: `openssl pkeyutl -sign -rawin`)
eddsaSignature : Bytes
eddsaSignature =
  hex
    (joinWith
       ""
       [ "11087297c25291eb65d200bf6a9e2f3ddedf11e754c17e9b386d7d9c8a76bd50"
       , "c837789d7c8e0aafe345c8183078971ed42ceeab35a2e3800de6870221499801"
       ])

-- (why, without what OpenSSL said of it, which its versions say each
-- their own way)
reasonless : String -> String
reasonless w = fromMaybe w (List.head (split " (" w))

-- (an error, as source writes it: without what OpenSSL said)
errorSaid : Crypto.Error -> String
errorSaid (Unreadable _) = "Unreadable"
errorSaid Encrypted = "Encrypted"
errorSaid (Unsupported kind) = "Unsupported " ^ debug kind
errorSaid (InvalidKey why) = "InvalidKey " ^ debug (reasonless why)
errorSaid (TooShort bits) = "TooShort " ^ debug bits
errorSaid (WrongKey a) = "WrongKey " ^ show a
errorSaid (Failed why) = "Failed " ^ debug (reasonless why)

-- (what could not be made, said)
refused : {a : Type} -> String -> Either Crypto.Error a -> String
refused what (Left why) = what ^ ": refused, " ^ errorSaid why
refused what (Right _) = what ^ ": made"

-- (a signature made, verified: of the message, of another, and changed)
signedSaid : {e : HFunctor}
           -> {{c : Crypto.crypto <: e}}
           -> {{io : stdio <: e}}
           -> String
           -> Crypto.Algorithm
           -> Crypto.PublicKey
           -> Either Crypto.Error Bytes
           -> Co e Unit
signedSaid what a p (Right sig) = do
  ok <- Crypto.verify a p message sig
  other <- Crypto.verify a p (Bytes.fromString "heff signs that") sig
  changed <- Crypto.verify a p message (Bytes.map (\x -> xor x 1) sig)
  print
      (what
       ^ ": "
       ^ debug (Bytes.length sig)
       ^ " bytes, verified "
       ^ debug ok
       ^ ", another message "
       ^ debug other
       ^ ", changed "
       ^ debug changed)
signedSaid what a p (Left why) = print (what ^ ": not signed, " ^ errorSaid why)

-- (the message signed with a key read, verified with the other)
ownRound : {e : HFunctor}
         -> {{c : Crypto.crypto <: e}}
         -> {{io : stdio <: e}}
         -> String
         -> Crypto.Algorithm
         -> Either Crypto.Error Crypto.PrivateKey
         -> Either Crypto.Error Crypto.PublicKey
         -> Co e Unit
ownRound what a (Right k) (Right p) = do
  s <- Crypto.sign a k message
  signedSaid what a p s
ownRound what a (Left why) _ =
  print (what ^ ": no private key, " ^ errorSaid why)
ownRound what a _ (Left why) =
  print (what ^ ": no public key, " ^ errorSaid why)

-- (a signature openssl made, verified with a key read or made)
theirs : {e : HFunctor}
       -> {{c : Crypto.crypto <: e}}
       -> {{io : stdio <: e}}
       -> String
       -> Crypto.Algorithm
       -> Bytes
       -> Either Crypto.Error Crypto.PublicKey
       -> Co e Unit
theirs what a sig (Right p) = do
  ok <- Crypto.verify a p message sig
  print (what ^ ": " ^ debug ok)
theirs what a sig (Left why) = print (what ^ ": no key, " ^ errorSaid why)

-- (RS256's signature, which is the same each time: as openssl's)
sameAsTheirs : {e : HFunctor}
             -> {{c : Crypto.crypto <: e}}
             -> {{io : stdio <: e}}
             -> Either Crypto.Error Crypto.PrivateKey
             -> Co e Unit
sameAsTheirs (Right k) = do
  s <- Crypto.sign RS256 k message
  print
      ("RS256 by RSA's own PEM, as openssl's: "
       ^ (case s of
          Right sig -> debug (Bytes.eq sig rs256Signature)
          Left why -> errorSaid why))
sameAsTheirs (Left why) = print ("no key of RSA's own PEM: " ^ errorSaid why)

-- (a key of a kind not the algorithm's: not signed, not verified)
otherKind : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> Either Crypto.Error Crypto.PrivateKey
          -> Either Crypto.Error Crypto.PublicKey
          -> Co e Unit
otherKind (Right k) (Right p) = do
  s <- Crypto.sign ES256 k message
  print (refused "ES256 by an RSA key" s)
  ok <- Crypto.verify EdDSA p message eddsaSignature
  print ("EdDSA's signature by an RSA key: " ^ debug ok)
  short <- Crypto.verify RS256 p message Bytes.empty
  print ("RS256, no signature: " ^ debug short)
otherKind _ _ = print "no RSA key"

-- (ES256's signature, not of 64 bytes: not verified)
shortened : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> Either Crypto.Error Crypto.PublicKey
          -> Co e Unit
shortened (Right p) = do
  ok <- Crypto.verify ES256 p message (Bytes.slice es256Signature 0 63)
  print ("ES256, 63 bytes: " ^ debug ok)
shortened (Left why) = print ("no P-256 key: " ^ errorSaid why)

-- (a private key's public one: verifying what it signs, and, as PEM,
-- the public key's PEM, nothing private in it)
itsPublic : {e : HFunctor}
          -> {{c : Crypto.crypto <: e}}
          -> {{io : stdio <: e}}
          -> String
          -> Crypto.Algorithm
          -> String
          -> Either Crypto.Error Crypto.PrivateKey
          -> Co e Unit
itsPublic what a want (Right k) = do
  p <- Crypto.publicOf k
  s <- Crypto.sign a k message
  signedSaid (what ^ ", the private key's public one") a p s
  text <- Crypto.publicKeyToPem p
  print
      (what
       ^ ", the public one as PEM, the public PEM: "
       ^ debug (strEq text want))
itsPublic what a want (Left why) = print (what ^ ": no key, " ^ errorSaid why)

-- (a public key read or made, as PEM: the public PEM)
asPem : {e : HFunctor}
      -> {{c : Crypto.crypto <: e}}
      -> {{io : stdio <: e}}
      -> String
      -> String
      -> Either Crypto.Error Crypto.PublicKey
      -> Co e Unit
asPem what want (Right p) = do
  text <- Crypto.publicKeyToPem p
  print (what ^ " as PEM, the public PEM: " ^ debug (strEq text want))
asPem what want (Left why) = print (what ^ ": no key, " ^ errorSaid why)

-- (an operation of crypto's, done by the crypto outside; after a key is
-- read of a PEM, a key of no PEM read too, which fails, before the
-- computation goes on: a handler's own failure, between what it hands
-- on)
meddled : {e : HFunctor}
        -> {a : Type}
        -> {{c : Crypto.crypto <: e}}
        -> Crypto.CryptoF (Co e) a
        -> Co e a
meddled (PrivatePem pem b k) = do
  o <- op (c (PrivatePem pem b (\o -> o))) val
  _ <- Crypto.privateKeyFromPem "not a key"
  pure (k o)
meddled p = op (c p) val

-- (a DSA key read through a handler that fails meanwhile: refused as
-- the DSA key is, not as the handler's was)
meddledWith : {e : HFunctor}
            -> {{c : Crypto.crypto <: e}}
            -> {{io : stdio <: e}}
            -> Co e Unit
meddledWith = do
  dsa <-
    handle
      (through Crypto.crypto e meddled)
      (Crypto.privateKeyFromPem (ev := inl Crypto.crypto e) dsaPrivate)
  print (refused "a DSA key, a handler failing meanwhile" dsa)

program : {e : HFunctor}
        -> {{c : Crypto.crypto <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  rsa <- Crypto.privateKeyFromPem rsaPrivate
  rsaOwn <- Crypto.privateKeyFromPem rsaTraditional
  rsaPub <- Crypto.publicKeyFromPem rsaPublic
  rsaPubOwn <- Crypto.publicKeyFromPem rsaPublicTraditional
  ec <- Crypto.privateKeyFromPem ecPrivate
  ecOwn <- Crypto.privateKeyFromPem ecTraditional
  ecPub <- Crypto.publicKeyFromPem ecPublic
  ed <- Crypto.privateKeyFromPem edPrivate
  edPub <- Crypto.publicKeyFromPem edPublic
  ownRound "RS256" RS256 rsa rsaPub
  ownRound "PS256" PS256 rsa rsaPub
  ownRound "ES256" ES256 ec ecPub
  ownRound "ES256 by EC's own PEM" ES256 ecOwn ecPub
  ownRound "EdDSA" EdDSA ed edPub
  sameAsTheirs rsaOwn
  theirs "openssl's RS256" RS256 rs256Signature rsaPub
  theirs "openssl's RS256, RSA's own public PEM" RS256 rs256Signature rsaPubOwn
  theirs "openssl's PS256" PS256 ps256Signature rsaPub
  theirs "openssl's PS256 as RS256" RS256 ps256Signature rsaPub
  theirs "openssl's ES256" ES256 es256Signature ecPub
  theirs "openssl's EdDSA" EdDSA eddsaSignature edPub
  rsaJwk <- Crypto.rsaPublicKey rsaN (hex "010001")
  theirs "openssl's RS256, a JWK's key" RS256 rs256Signature rsaJwk
  ecJwk <- Crypto.p256PublicKey ecX ecY
  theirs "openssl's ES256, a JWK's key" ES256 es256Signature ecJwk
  edJwk <- Crypto.ed25519PublicKey edX
  theirs "openssl's EdDSA, a JWK's key" EdDSA eddsaSignature edJwk
  itsPublic "RS256" RS256 rsaPublic rsa
  itsPublic "ES256" ES256 ecPublic ec
  itsPublic "EdDSA" EdDSA edPublic ed
  asPem "RSA's own public PEM" rsaPublic rsaPubOwn
  asPem "a JWK's RSA key" rsaPublic rsaJwk
  asPem "a JWK's P-256 key" ecPublic ecJwk
  asPem "a JWK's Ed25519 key" edPublic edJwk
  otherKind rsa rsaPub
  shortened ecPub
  notPem <- Crypto.privateKeyFromPem "not a key"
  print (refused "a private key of no PEM" notPem)
  publicAsPrivate <- Crypto.privateKeyFromPem rsaPublic
  print (refused "a private key of a public PEM" publicAsPrivate)
  broken <- Crypto.publicKeyFromPem (strSlice rsaPublic 0 200)
  print (refused "a public key of a PEM cut short" broken)
  shortX <- Crypto.p256PublicKey (Bytes.slice ecX 0 31) ecY
  print (refused "a P-256 key, x of 31 bytes" shortX)
  offCurve <- Crypto.p256PublicKey ecY ecX
  print (refused "a P-256 key off the curve" offCurve)
  shortEd <- Crypto.ed25519PublicKey (Bytes.slice edX 0 31)
  print (refused "an Ed25519 key of 31 bytes" shortEd)
  noModulus <- Crypto.rsaPublicKey Bytes.empty (hex "010001")
  print (refused "an RSA key of no modulus" noModulus)
  noExponent <- Crypto.rsaPublicKey rsaN Bytes.empty
  print (refused "an RSA key of no exponent" noExponent)
  evenExponent <- Crypto.rsaPublicKey rsaN (hex "010000")
  print (refused "an RSA key of an even exponent" evenExponent)
  oneExponent <- Crypto.rsaPublicKey rsaN (hex "01")
  print (refused "an RSA key of the exponent 1" oneExponent)
  short <- Crypto.privateKeyFromPem rsaShort
  print (refused "a 1024-bit RSA key" short)
  print
      ("a 1024-bit RSA key, shown: "
       ^ (case short of
          Left why -> show why
          Right _ -> "made"))
  shortPub <- Crypto.publicKeyFromPem rsaShortPublic
  print (refused "a 1024-bit RSA public key" shortPub)
  shortPubOwn <- Crypto.publicKeyFromPem rsaShortPublicTraditional
  print (refused "a 1024-bit RSA public key, RSA's own PEM" shortPubOwn)
  shortJwk <- Crypto.rsaPublicKey rsaShortN (hex "010001")
  print (refused "a 1024-bit RSA key of a JWK" shortJwk)
  p384 <- Crypto.privateKeyFromPem p384Private
  print (refused "a P-384 key" p384)
  p384Pub <- Crypto.publicKeyFromPem p384Public
  print (refused "a P-384 public key" p384Pub)
  x25519 <- Crypto.privateKeyFromPem x25519Private
  print (refused "an X25519 key" x25519)
  encrypted <- Crypto.privateKeyFromPem encryptedPrivate
  print (refused "an encrypted key" encrypted)
  dsa <- Crypto.privateKeyFromPem dsaPrivate
  print (refused "a DSA key" dsa)
  dsaPub <- Crypto.publicKeyFromPem dsaPublic
  print (refused "a DSA public key" dsaPub)
  nul <-
    Crypto.privateKeyFromPem
      (strSlice rsaPrivate 0 100 ^ "\x00" ^ strSlice rsaPrivate 100 2000)
  print (refused "a private key of a PEM with a NUL in it" nul)
  nulPub <-
    Crypto.publicKeyFromPem
      (strSlice rsaPublic 0 100 ^ "\x00" ^ strSlice rsaPublic 100 2000)
  print (refused "a public key of a PEM with a NUL in it" nulPub)
  evenModulus <- Crypto.privateKeyFromPem rsaEvenModulus
  case evenModulus of
    Right k -> do
      s <- Crypto.sign RS256 k message
      print (refused "RS256 by a key of an even modulus" s)
      p <- Crypto.sign PS256 k message
      print (refused "PS256 by a key of an even modulus" p)
    Left why -> print ("no key of an even modulus: " ^ errorSaid why)
  meddledWith

main : Co (Crypto.crypto <+> stdio) Unit
main = program (c := _) (io := _)
