-- Signatures by std.crypto, OpenSSL's: keys of RSA (2048 bits), P-256
-- and Ed25519, made by `openssl genpkey` once and kept here, read from
-- PEM and made from a JWK's fields; a message signed and verified by
-- each algorithm, and not verified once it, or the signature, is
-- changed; signatures `openssl` made of the message verified; and what
-- is not a key, or a key of another kind, refused, each by its error:
-- an RSA key of 1024 bits (`openssl genrsa 1024`) as too short, by PEM
-- and by JWK, a P-384 key, an X25519 key and a DSA key as of no
-- algorithm's kind, an encrypted key (`openssl genpkey -aes256`) as
-- encrypted, a PEM with a NUL in it as unreadable, and an RSA key whose
-- modulus is even, read, as invalid once it signs.

module test.node.crypto

import bytes as Bytes
import co
import std.crypto as Crypto
import std.hex as Hex
import std.io
import uint8 as UInt8

-- (a PEM, its lines)
pem : List String -> String
pem ls = joinWith "\n" ls ^ "\n"

