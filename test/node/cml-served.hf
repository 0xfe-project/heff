-- std.http.cmlserver's `serve`, a cml thread for each
-- connection, each had by a `with` in its own, scheduled by cml waiting
-- on the world through each domain's reactor: many clients held open
-- at once, each answered in turn.  By C alone.
--
--   main     n clients, each its connection kept: a first request each,
--            all answered while every connection is held open -- which a
--            server of one connection at a time never does -- then a
--            second request each on the same connection
--   burst    PORT: served there until asked for `/stop`, by Node.js's
--            clients, hundreds of connections opened at once: how many
--            requests it answered

module test.node.cml-served

import bytes as Bytes
import cml as CML
import co
import exception
import std.domain as Domain
import std.http as HTTP
import std.http.cmlserver as CmlServer
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import resource

-- (the value of a `Right`; where there is none, the program abandoned:
-- the test's own sockets, which do not fail)
must : {a : Type} -> Either Net.NetError a -> a
must (Right x) = x
must (Left err) = abandon

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (a thread of its own, its throws heard there and let go of)
apart : {w : HFunctor}
      -> Co (exception Net.NetError <+> (CML.cml w <+> w)) Unit
      -> Co (CML.cml w <+> w) Unit
apart c = bind (attempt Net.NetError c) (\r -> pure ())

repeatG : {e : HFunctor} -> Int -> Co e Unit -> Co e Unit
repeatG 0 c = pure MkUnit
repeatG n c = bind c (\u -> repeatG (n - 1) c)

-- (n values received on ch, added up)
recvSum : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> CML.Chan w Int
        -> Int
        -> Int
        -> Co e Int
recvSum ch 0 acc = pure acc
recvSum ch n acc = do
  x <- CML.recv ch
  recvSum ch (n - 1) (acc + x)

-- (n bytes read, in as many reads as they take)
readN : {e : HFunctor}
      -> {s : Type}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpStream
      -> Int
      -> Bytes
      -> Co e Bytes
readN c n acc =
  if Bytes.length acc >= n then pure acc
  else bind
      (Net.read c (n - Bytes.length acc))
      (\r -> readN c n (Bytes.append acc (must r)))

-- | What a handler throws.
data Thrown = MkThrown

-- (each request answered with its target; `/throw` thrown instead)
answer : {e : HFunctor}
       -> {{ex : exception Thrown <: e}}
       -> Server.Request
       -> Co e HTTP.Response
answer r =
  if r.target == "/throw" then throw MkThrown
  else pure (Server.plain 200 r.target)

-- (a request for `target` sent on the connection, and its response read:
-- 1 where it is the one wanted)
asked : {e : HFunctor}
      -> {s : Type}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpStream
      -> String
      -> Co e Int
asked c target = do
  w <-
    Net.write
      c
      (Bytes.fromString ("GET " ^ target ^ " HTTP/1.1\r\nHost: x\r\n\r\n"))
  let want = Server.responseBytes "" True (Server.plain 200 target)
  got <- readN c (Bytes.length want) Bytes.empty
  pure (if got == want then 1 else 0)

-- (a request whose handler throws, sent on the connection: whether the
-- server closed it at once, unanswered -- the read ending, nothing
-- read, well before the 30 seconds a connection may stay idle)
thrownOn : {e : HFunctor}
         -> {s : Type}
         -> {{nt : Net.net <: e}}
         -> With s Net.TcpStream
         -> Co e String
thrownOn c = do
  _ <- Net.write c (Bytes.fromString "GET /throw HTTP/1.1\r\nHost: x\r\n\r\n")
  r <- Net.read (timeout := 5000) c 100
  pure (case r of
    Right b ->
      if Bytes.length b == 0 then "thrown: closed at once, unanswered"
      else "thrown: answered"
    Left err -> "thrown: left open, " ^ show err)

-- (a client's connection: a first request, its answer said on `back`;
-- then, once main says so on `go`, a second on the same connection:
-- its answer)
clientOn : {e w : HFunctor}
         -> {s : Type}
         -> {{cm : CML.cml w <: e}}
         -> {{nt : Net.net <: e}}
         -> {{ntw : Net.net <: w}}
         -> CML.Chan w Int
         -> CML.Chan w Int
         -> Int
         -> With s Net.TcpStream
         -> Co e Int
clientOn back go i c = do
  first <- asked c ("/" ^ debug i ^ "/first")
  CML.send back first
  x <- CML.recv go
  asked c ("/" ^ debug i ^ "/second")

-- | A client: a first request, its answer said on `back`; then, once
-- | main says so on `go`, a second on the same connection, which is
-- | closed after, its answer said.
client : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ntw : Net.net <: w}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> CML.Chan w Int
       -> CML.Chan w Int
       -> Int
       -> Co e Unit
client port back go i = do
  second <- Net.withConnection (here port) (\c -> clientOn back go i c)
  CML.send back second

-- (clients `i` down to 1, each a thread of its own)
clients : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> CML.Chan w Int
        -> CML.Chan w Int
        -> Int
        -> Co e Unit
clients port back go 0 = pure MkUnit
clients port back go i = do
  CML.spawn (apart (client (w := w) port back go i))
  clients port back go (i - 1)

-- (the server, a thread of its own, and n clients, each one too)
served : {e w : HFunctor}
       -> {s : Type}
       -> {{cm : CML.cml w <: e}}
       -> {{io : stdio <: e}}
       -> {{iow : stdio <: w}}
       -> {{nt : Net.net <: e}}
       -> {{ntw : Net.net <: w}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> With s Net.TcpListener
       -> Co e Unit
served n l = do
  at <- Net.local l
  CML.spawn (CmlServer.serve (w := w) Thrown l answer)
  back <- CML.newChan
  go <- CML.newChan
  clients (must at).port back go n
  first <- recvSum back n 0
  print ("first requests answered, every connection held open: " ^ debug first)
  repeatG n (CML.send go 1)
  second <- recvSum back n 0
  print ("second requests answered, on the same connections: " ^ debug second)
  thrown <- Net.withConnection (here (must at).port) (\c -> thrownOn c)
  print thrown
  after <- Net.withConnection (here (must at).port) (\c -> asked c "/after")
  print ("asked after: " ^ debug after)

program : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{iow : stdio <: w}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> Co e Unit
program n = Net.withListener (here 0) 128 (\l -> served n l)

-- (what main came to: a deadlock, a throw no thread heard, or done)
said : Maybe (Either Net.NetError Unit) -> String
said Nothing = "a deadlock"
said (Just (Left err)) = "not heard: " ^ show err
said (Just (Right u)) = "main done"

main : Co (stdio <+> Net.net <+> Reactor.reactor <+> Domain.domain) Unit
main = do
  r <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (program
            (w := stdio <+> Net.net <+> Reactor.reactor <+> Domain.domain)
            (cm := _)
            (io := _)
            (nt := _)
            (ex := _)
            40))
  print (ev := _) (said r)

-- Many at once
--------------------------------------------------------------------------------

-- (each request answered with its target, and said on `events`: 1, or
-- 0 for `/stop`)
counting : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> CML.Chan w Int
         -> Server.Request
         -> Co e HTTP.Response
counting events r = do
  CML.send events (if r.target == "/stop" then 0 else 1)
  pure (Server.plain 200 r.target)

-- (the requests said on `events`, added up, until a 0)
answeredOn : {e w : HFunctor}
           -> {{cm : CML.cml w <: e}}
           -> CML.Chan w Int
           -> Int
           -> Co e Int
answeredOn events n = do
  x <- CML.recv events
  if x == 0 then pure n else answeredOn events (n + x)

burstAt : {e w : HFunctor}
        -> {s : Type}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{iow : stdio <: w}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> With s Net.TcpListener
        -> Co e Unit
burstAt l = do
  events <- CML.newChan
  CML.spawn (CmlServer.serve (w := w) Empty l (counting events))
  n <- answeredOn events 0
  print ("answered " ^ debug n)

burstProgram : {e w : HFunctor}
             -> {{cm : CML.cml w <: e}}
             -> {{io : stdio <: e}}
             -> {{iow : stdio <: w}}
             -> {{nt : Net.net <: e}}
             -> {{ntw : Net.net <: w}}
             -> {{sys : process <: e}}
             -> {{ex : exception Net.NetError <: e}}
             -> Co e Unit
burstProgram = do
  argv <- args
  let port = fromMaybe 0 (parseInt (fromMaybe "" (List.head argv)))
  Net.withListener (here port) 128 (\l -> burstAt l)

burst : Co
        (stdio <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain)
        Unit
burst = do
  r <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (burstProgram
            (w := stdio <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain)
            (cm := _)
            (io := _)
            (nt := _)
            (sys := _)
            (ex := _)))
  print (ev := _) (said r)
