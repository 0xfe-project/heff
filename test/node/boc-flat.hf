-- Numbers of 64 bits held by cowns, on the C backend's threads: a body
-- on two cowns or more gives back a tuple the compiler may build flat
-- (an `Int64`'s, a `UInt64`'s, a `Float64`'s bits, not a value), and
-- each is written back to its cown as the number it is -- odd and even,
-- one cown and several, alone and beside a value of another type.

module test.node.boc-flat

import boc as BOC
import co
import int64 as Int64
import std.io
import uint64 as UInt64

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  a <- BOC.newCown (25 : Int64)
  b <- BOC.newCown (0 : Int64)
  BOC.when (a, b) (\(x, y) -> pure (x + 1, y + x))
  c <- BOC.newCown (7 : UInt64)
  d <- BOC.newCown (1.5 : Float64)
  n <- BOC.newCown (1 : Int)
  BOC.when ((c, d), n) (\((u, f), i) -> pure ((u * 2, f * 2.0), i + 1))
  e <- BOC.newCown (40 : Int64)
  BOC.when e (\x -> pure (x + 2))
  BOC.when ((a, b), (((c, d), n), e)) (\((x, y), (((u, f), i), z)) -> do
    print ("Int64, two cowns: " ^ show x ^ " " ^ show y)
    print
        ("UInt64, Float64, Int, three cowns: "
         ^ show u
         ^ " "
         ^ show f
         ^ " "
         ^ showInt i)
    print ("Int64, one cown: " ^ show z)
    pure ((x, y), (((u, f), i), z)))

main : Co (BOC.boc <+> stdio) Unit
main = program
