-- What the fuel tests run, on every backend: the same program, by
-- std.domain's `limited` alone, on the C backend (test/node/fuel.hf) and
-- in JavaScript (test/apps/fuel.hf), the same lines said.  A pure loop
-- with no operation in it stopped; a computation finishing within its
-- fuel; limits within limits, the inner running out of its own and of
-- the outer's; a `tried` not catching running out; and the program going
-- on, unlimited, after them.

module test.node.fuel-program

import co
import std.domain as Domain

-- (a loop of no operation, never ending)
spin : Int -> Int
spin n = spin (n + 1)

-- (`1 + ... + n`, by a loop)
sumTo : Int -> Int -> Int
sumTo n acc = if n <= 0 then acc else sumTo (n - 1) (acc + n)

-- (what a limit came to)
said : {a : Type} -> {{sh : Debug a}} -> Maybe a -> String
said (Just x) = "Just " ^ debug x
said Nothing = "Nothing"

-- | the lines said
lines : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (List String)
lines = do
  stopped <- Domain.limited 100000 (later (\u -> spin 0))
  within <- Domain.limited 100000 (later (\u -> sumTo 100 0))
  nested <-
    Domain.limited 1000000 (do
      inner <- Domain.limited 1000 (later (\u -> spin 0))
      s <- later (\u -> sumTo 100 0)
      pure (said inner ^ " then " ^ debug s))
  outer <-
    Domain.limited 1000 (do
      inner <- Domain.limited 1000000 (later (\u -> spin 0))
      pure (said inner))
  caught <- Domain.limited 1000 (Domain.tried (later (\u -> spin 0)))
  after <- later (\u -> sumTo 1000000 0)
  pure
      [ "a pure loop stopped: " ^ said stopped
      , "finished within its fuel: " ^ said within
      , "the inner out of its own: " ^ said nested
      , "the inner out of the outer's: " ^ said outer
      , "a tried does not catch it: "
      ^ (case caught of
         Just _ -> "caught"
         Nothing -> "Nothing")
      , "after them, unlimited: " ^ debug after
      ]
