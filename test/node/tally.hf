-- Another world's provider acting on what boxes.hf's hands out:
-- tally.provider.c adds one to what a box holds, given the box by
-- value -- the foreign value a `with` of boxes holds, which any
-- provider's operation may take -- and keeps nothing of it.  Boxes
-- are freed as the program drops them: each as its `with` ends, where
-- nothing else holds it.

module test.node.tally

import co
import custodian
import std.io
import test.node.boxes
import resource

data TallyF (m : Type -> Type) x = Bump Box x

tally : HFunctor
tally =
  { f = TallyF
  , hfmap = \m g p -> case p of
      Bump b x -> Bump b (g x)
  , hmap = \m n nt p -> case p of
      Bump b x -> Bump b x
  }

-- | one added to what the box holds
bump : {e : HFunctor}
     -> {s : Type}
     -> {{ev : tally <: e}}
     -> With s Box
     -> Co e Unit
bump b = op (ev (Bump (inside b) MkUnit)) val

-- (boxes made and let go of, one after another)
churn : {e : HFunctor}
      -> {{bx : boxes <: e}}
      -> {{cu : custodian <: e}}
      -> Int
      -> Co e Unit
churn 0 = pure MkUnit
churn n = do
  withBox n (\b -> (pure MkUnit : Co e Unit))
  churn (n - 1)

-- (boxes of 1 to n, each held while those below it are: what they hold,
-- added up)
total : {e : HFunctor}
      -> {{bx : boxes <: e}}
      -> {{cu : custodian <: e}}
      -> Int
      -> Int
      -> Co e Int
total 0 acc = pure acc
total n acc = do
  with withBox n as b do
    m <- peek b
    total (n - 1) (acc + m)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{bx : boxes <: e}}
        -> {{tl : tally <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  with withBox 41 as b do
    bump b
    n <- peek b
    print ("bumped: " ^ debug n)
    churn 50
    f <- freed
    print ("churned: " ^ debug f ^ " freed")
    t <- total 100 0
    g <- freed
    print ("kept: " ^ debug t ^ ", then " ^ debug g ^ " freed")
  m <- freed
  print ("freed: " ^ debug m)

main : Co (stdio <+> boxes <+> tally <+> custodian) Unit
main =
  program
    (io := _)
    (bx := _)
    (tl := _)
