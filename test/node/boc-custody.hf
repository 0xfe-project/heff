-- Behaviours take the custodian current where they are spawned, by C
-- alone (boc, and flaky.hf's things, one of which fails to end).
--
--   main     a behaviour spawned in a custodian that contains its
--            failures holds a thing, kept past its `with` by a cown
--            and let go of by the behaviour after it, where it fails
--            to end: the custodian the behaviour took at its spawn is
--            shut down alone, the failure said, and the program goes
--            on; a behaviour spawned after it, outside, has the root's.
--            What they log is printed by a behaviour waiting until all
--            of it is there
--   rooted   a behaviour spawned outside every custodian's `with`, its
--            thing failing to end in the root's custody: the program
--            ended

module test.node.boc-custody

import boc as BOC
import co
import custodian as Custodian
import exception
import std.io
import resource
import test.node.flaky as Flaky

-- (`what` put at the end of the log, by a behaviour on it)
logged : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown (List String)
       -> String
       -> Co e Unit
logged log what = do
  with l := log do
    l := List.append l [what]

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

-- (nothing, where `m` was: what the cown holding a thing is left with)
gone : {a : Type} -> Maybe a -> Maybe a
gone m = Nothing

-- (a thing, one that fails to end where `fails`, held past its `with`
-- by a cown of its own, which the behaviour after this one on `c` --
-- which this one holds -- lets go of, once this one is done)
heldPast : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{fl : Flaky.flaky <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> {{ex : exception String <: e}}
         -> Bool
         -> BOC.Cown Int
         -> Co e Unit
heldPast fails c = do
  with Flaky.withThing fails as t do
    keep <- BOC.newCown (Just t)
    with n := c
         k := keep do
      k := gone k

-- (a behaviour's work: which custodian is current, and a thing held
-- past its `with`, one that fails to end where `fails`)
held : {e : HFunctor}
     -> {{bc : BOC.boc <: e}}
     -> {{fl : Flaky.flaky <: e}}
     -> {{cu : Custodian.custodian <: e}}
     -> BOC.Cown (List String)
     -> BOC.Cown Int
     -> String
     -> Bool
     -> Co e Unit
held log c name fails = do
  cur <- Custodian.current
  case cur of
    Just k -> logged log (name ^ ": a custodian of its own current")
    Nothing -> logged log (name ^ ": the root's current")
  r <- attempt String (heldPast fails c)
  case r of
    Left why -> logged log ("thrown: " ^ why)
    Right u -> logged log (name ^ " went on")

-- (two behaviours on one cown, the first spawned in a custodian that
-- contains its failures, the second after it, outside; what the
-- custodian is given to run at its shutdown put on `stops`, by a
-- behaviour, wherever it runs)
spawned : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> {{fl : Flaky.flaky <: e}}
        -> BOC.Cown (List String)
        -> BOC.Cown (List String)
        -> Co e Unit
spawned log stops = do
  c <- BOC.newCown 0
  with k := Custodian.contained do
    _ <- Custodian.manage k (logged stops "the contained custodian shut down")
    with n := c do
      held log c "the contained" True
      n := n + 1
  with n := c do
    held log c "the root's" False
    n := n + 1

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{fl : Flaky.flaky <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Unit
program = do
  log <- BOC.newCown Nil
  stops <- BOC.newCown Nil
  spawned log stops
  -- (once both behaviours have logged, and the custodian has stopped)
  with l := log
       s := stops
       once List.length l == 4 && List.length s == 1 do
    printed l
    printed s
    print "the program went on"

main : Co (BOC.boc <+> stdio <+> Flaky.flaky <+> Custodian.custodian) Unit
main = program

-- (a behaviour spawned outside every custodian's `with`, its thing
-- failing to end, let go of by the behaviour after it, before the one
-- after that)
alone : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{io : stdio <: e}}
      -> {{fl : Flaky.flaky <: e}}
      -> {{cu : Custodian.custodian <: e}}
      -> Co e Unit
alone = do
  c <- BOC.newCown 0
  with n := c do
    print "held"
    r <- attempt String (heldPast True c)
    with m := c do
      print "not reached"

rootedProgram : {e : HFunctor}
              -> {{bc : BOC.boc <: e}}
              -> {{io : stdio <: e}}
              -> {{fl : Flaky.flaky <: e}}
              -> {{cu : Custodian.custodian <: e}}
              -> Co e Unit
rootedProgram = alone

rooted : Co (BOC.boc <+> stdio <+> Flaky.flaky <+> Custodian.custodian) Unit
rooted = rootedProgram
