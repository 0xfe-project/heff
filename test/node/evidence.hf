module test.node.evidence

-- The evidence of an effect as an instance implicit: nothing global --
-- `main` asks for it, its body's operations find it, and `run` finds it.
import co
import std.io
import std.process

main : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> Co e Unit
main = do
  argv <- args
  print ("args: " ^ joinWith " " argv)
  print "bye"

-- where the world is: each sub-effect's evidence, found
run : Co (stdio <+> process) Unit
run = main (io := _) (sys := _)
