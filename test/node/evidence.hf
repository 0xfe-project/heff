module test.node.evidence

-- The evidence of an effect as an instance implicit: nothing global --
-- `main` asks for it, its body's operations find it, and `run` gives it.
import co
import std.io
import std.process

world : HFunctor
world = stdio <+> process

main : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> Co e Unit
main = do
  argv <- args
  print ("args: " ^ joinWith " " argv)
  print "bye"

-- where the world is: each sub-effect's evidence, given
run : Co world Unit
run = main (io := \p -> InL p) (sys := \p -> InR p)
