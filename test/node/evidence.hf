-- The evidence of an effect as an instance implicit: nothing global --
-- `main` asks for it, its body finds it, and `run` gives it.
import co
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process

-- the operations, their evidence an instance implicit (not written in
-- the equations: `ev` is in scope by its name)
say : {e : HFunctor} -> {{ev : stdio <: e}} -> String -> Co e Unit
say s = print ev s

argv : {e : HFunctor} -> {{ev : process <: e}} -> Co e (List String)
argv = args ev

-- the program: it asks for the evidence, and its body finds it
main : {{io : stdio <: world}} -> {{sys : process <: world}} -> Co world Unit
main = do
  as <- argv
  say ("args: " ++ joinWith " " as)
  say "bye"

-- where the world is: each sub-effect's evidence, given
inStdio : (stdio <: world)
inStdio = \p -> InL p

inProcess : (process <: world)
inProcess = \p -> InR p

run : Co world Unit
run = main [io := inStdio] [sys := inProcess]
