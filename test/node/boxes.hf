-- A world of boxes (with tally.hf): a box is a thing of the host's
-- with an Int in it, held by a `with` (`withBox`), as any host's thing
-- is: a foreign value, given by value to whichever provider's
-- operation takes it.  Its provider, boxes.provider.c, makes boxes
-- and looks in them, empties one as its `with` ends, and counts the
-- boxes freed -- where the program dropped its last reference to them.

module test.node.boxes

import co
import custodian
import resource

-- | A box as the host has it: a foreign value; no value of the program
-- | has it.
data Box

data BoxesF (m : Type -> Type) x
  = NewBox Int (Box -> x)
  | Peek Box (Int -> x)
  | Clear Box x
  | Freed (Int -> x)

boxes : HFunctor
boxes =
  { f = BoxesF
  , hfmap = \m g p -> case p of
      NewBox n k -> NewBox n (\b -> g (k b))
      Peek b k -> Peek b (\n -> g (k n))
      Clear b x -> Clear b (g x)
      Freed k -> Freed (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      NewBox n k -> NewBox n k
      Peek b k -> Peek b k
      Clear b x -> Clear b x
      Freed k -> Freed k
  }

-- (a box made, holding `n`)
made : {e : HFunctor} -> {{ev : boxes <: e}} -> Int -> Co e Box
made n = op (ev (NewBox n (\b -> b))) val

-- (a box emptied, as its `with` ends)
emptied : {e : HFunctor} -> {{ev : boxes <: e}} -> Box -> Co e Unit
emptied b = op (ev (Clear b (MkUnit : Unit))) val

-- | A box holding `n`, had by `body` in a region of its own, and
-- | emptied when `body` ends; freed where the program drops it.
withBox : {e : HFunctor}
        -> {a : Type}
        -> {{ev : boxes <: e}}
        -> {{cu : custodian <: e}}
        -> Int
        -> ({s : Type} -> With s Box -> Co e a)
        -> Co e a
withBox n body = held (made n) emptied body

-- | what the box holds
peek : {e : HFunctor}
     -> {s : Type}
     -> {{ev : boxes <: e}}
     -> With s Box
     -> Co e Int
peek b = op (ev (Peek (inside b) (\n -> n))) val

-- | how many boxes have been freed
freed : {e : HFunctor} -> {{ev : boxes <: e}} -> Co e Int
freed = op (ev (Freed (\n -> n))) val
