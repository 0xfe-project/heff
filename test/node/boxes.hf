-- A world of boxes, for test/backends.mjs (with tally.hf): a box is a
-- thing of the host's with an Int in it, held by the world for every
-- provider (std.handle).  Its providers, boxes.provider.js and
-- boxes.provider.c, make boxes and look in them, and count the boxes let
-- go of -- by whichever provider asked the world to.

import co
import std.handle

-- | What a box is, as the kind of a handle: no value has it.
data Box

data BoxesF (m : Type -> Type) x
  = NewBox Int (Handle Box -> x)
  | Peek (Handle Box) (Int -> x)
  | Freed (Int -> x)

boxes : HFunctor
boxes =
  { f = BoxesF
  , hfmap = \m g p -> case p of
      NewBox n k -> NewBox n (\b -> g (k b))
      Peek b k -> Peek b (\n -> g (k n))
      Freed k -> Freed (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      NewBox n k -> NewBox n k
      Peek b k -> Peek b k
      Freed k -> Freed k
  }

newBox : {e : HFunctor} -> {{ev : boxes <: e}} -> Int -> Co e (Handle Box)
newBox n = op (ev (NewBox n (\b -> b))) val

peek : {e : HFunctor} -> {{ev : boxes <: e}} -> Handle Box -> Co e Int
peek b = op (ev (Peek b (\n -> n))) val

-- | how many boxes the world has let go of
freed : {e : HFunctor} -> {{ev : boxes <: e}} -> Co e Int
freed = op (ev (Freed (\n -> n))) val
