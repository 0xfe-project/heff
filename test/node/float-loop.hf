-- A `do` block's `for` adding up an array's `Float64`s, its total
-- handed on to what the block does after the loop: the total is kept a
-- `double` on each round of the loop, and boxed once, as it leaves it.

module test.node.float-loop

import co
import std.io
import array

sumFloats : {e : HFunctor} -> {{io : stdio <: e}} -> Array Float64 -> Co e Float64
sumFloats xs = do
  let mut total = 0.0
  for x in xs do
    total := total + x
  return total

main : Co stdio Unit
main = do
  t <- sumFloats (io := _) (arrayGenerate 1000 (\i -> floatFromInt i * 0.5))
  print (ev := _) (show t)
