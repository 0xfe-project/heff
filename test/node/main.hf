module test.node.main

-- A program whose module is `main`, as its file is: compiled to C as
-- parts (`heff compile main.hf DIR/`), its part, `main.c`, is its own,
-- not the one with the program's entry.
import co
import std.io

-- (a definition kept as one, in the module's part: it calls itself)
countdown : Int -> List String
countdown 0 = Nil
countdown n = show n :: countdown (n - 1)

program : {{io : stdio <: stdio}} -> Co stdio Unit
program = print ("main, a module of its own: " ^ joinWith " " (countdown 3))

main : Co stdio Unit
main = program (io := _)
