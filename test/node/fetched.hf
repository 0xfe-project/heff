-- Requests of a server of the test's own, a line each: its response --
-- its status, the headers the server said of what it was sent, its body
-- -- or why none came (the C backend's libcurl in
-- the process held to the curl it spawns).  `main AT REFUSED`: the
-- server's address, and an address where nothing listens.

module test.node.fetched

import bytes as Bytes
import co
import std.http as HTTP
import std.io
import std.process
import std.reactor as Reactor
import uint8 as UInt8

-- (every byte, 0 to 255, twice)
everyByte : Bytes
everyByte =
  Bytes.fromList (List.map (\i -> UInt8.fromInt (i % 256)) (List.range 0 511))

-- (`b` doubled `n` times: 512 bytes doubled 12 times, 2 MiB)
doubled : Bytes -> Int -> Bytes
doubled b 0 = b
doubled b n = doubled (Bytes.append b b) (n - 1)

-- (a header shown: the server's own, `X-...`, and where a redirect goes)
shownHeader : Pair String String -> Bool
shownHeader (MkPair n v) = startsWith "X-" n || strEq n "Location"

showHeaders : List (Pair String String) -> String
showHeaders hs =
  joinWith
    ", "
    (List.map (\h -> fst h ^ ": " ^ snd h) (List.keepIf shownHeader hs))

-- (a body shown: as a binary, `b[...]`, where it is short, else its
-- length and its bytes added up)
showBody : Bytes -> String
showBody b =
  if Bytes.length b <= 64 then debug b
  else debug (Bytes.length b)
    ^ " bytes, sum "
    ^ debug (List.foldl (\s c -> s + UInt8.toInt c) 0 (Bytes.toList b))

-- (an error of a request for `url`, said: its URL left out where it is
-- that one)
errorOf : String -> HTTP.HttpError -> String
errorOf url err =
  if strEq err.url url
  then joinWith "" (split (url ^ ": ") (show err))
  else "of another URL, " ^ show err

showGot : String -> Either HTTP.HttpError HTTP.Response -> String
showGot url (Left err) = errorOf url err
showGot url (Right r) =
  debug r.status ^ " [" ^ showHeaders r.headers ^ "] " ^ showBody r.body

each : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{web : HTTP.http <: e}}
     -> List (Pair String HTTP.Request)
     -> Co e Unit
each Nil = pure MkUnit
each (MkPair what rq :: rest) = do
  got <- HTTP.send rq
  print (what ^ ": " ^ showGot rq.url got)
  each rest

requests : String -> String -> List (Pair String HTTP.Request)
requests at refused =
  [ MkPair "get" { url = at ^ "/item" }
  , MkPair
    "post"
    { url = at ^ "/echo"
    , method = "POST"
    , headers =
        [ MkPair "X-Heff" "one two"
        , MkPair "Content-Type" "application/octet-stream"
        ]
    , body = everyByte
    }
  , MkPair
    "post, big"
    { url = at ^ "/echo", method = "POST", body = doubled everyByte 12 }
  , MkPair "post, nothing" { url = at ^ "/echo", method = "POST" }
  , MkPair
    "put"
    { url = at ^ "/echo", method = "PUT", body = Bytes.fromString "put" }
  , MkPair
    "delete"
    { url = at ^ "/echo", method = "DELETE", headers = [MkPair "X-Heff" ""] }
  , MkPair "head" { url = at ^ "/echo", method = "HEAD" }
  , MkPair "404" { url = at ^ "/nope" }
  , MkPair "500" { url = at ^ "/fails" }
  , MkPair "refused" { url = refused }
  , MkPair "followed" { url = at ^ "/moved" }
  , MkPair "not followed" { url = at ^ "/moved", follow = False }
  , MkPair "redirects for ever" { url = at ^ "/loop" }
  , MkPair "in time" { url = at ^ "/slow", timeout = 5000 }
  , MkPair "timed out" { url = at ^ "/slow", timeout = 100 }
  , MkPair "big" { url = at ^ "/big" }
  , MkPair "chunked" { url = at ^ "/chunked" }
  , MkPair "cut short" { url = at ^ "/short" }
  , MkPair "no scheme" { url = "nope://x/" }
  , MkPair "no host" { url = "http://" }
  ]

codeOf : HTTP.HttpError -> String
codeOf err = "code " ^ debug err.code

-- (`getText` and `get` too)
texts : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{web : HTTP.http <: e}}
      -> String
      -> String
      -> Co e Unit
texts at refused = do
  t <- HTTP.getText (at ^ "/item")
  print ("getText: " ^ either (errorOf (at ^ "/item")) (\s -> s) t)
  n <- HTTP.getText refused
  print ("getText, refused: " ^ either codeOf (\s -> s) n)
  m <- HTTP.getText (at ^ "/nope")
  print ("getText, 404: " ^ either (errorOf (at ^ "/nope")) (\s -> s) m)
  r <- HTTP.get (at ^ "/echo")
  print
      ("get: "
       ^ either
         show
         (\x -> fromMaybe "none" (HTTP.header "x-method" x))
         r)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  argv <- args
  case argv of
    (at :: refused :: _) -> do
      each (requests at refused)
      texts at refused
    _ -> printErr "main AT REFUSED"

main : Co (stdio <+> HTTP.http <+> process) Unit
main =
  program
    (io := _)
    (web := _)
    (sys := _)

-- | The same requests, by a green thread scheduled by std.reactor: each
-- | a transfer of libcurl's multi interface, pending until it is done,
-- | its answer as libcurl's easy one is.
multi : Co (stdio <+> HTTP.http <+> process <+> Reactor.reactor) Unit
multi = do
  r <-
    Reactor.scheduled
      (rx := _)
      (program
         (io := _)
         (web := _)
         (sys := _))
  pure MkUnit
