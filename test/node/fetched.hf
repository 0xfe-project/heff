-- What each fetch of the URLs given gives, a line each: its length and
-- its text, a failure's message too (test/backends.mjs, the C backend's
-- libcurl in the process held to the curl it spawns, on a server of the
-- test's own).

import co
import std.io
import std.net
import std.process

world : HFunctor
world = stdio <+> (net <+> process)

each : {e : HFunctor} -> {{io : stdio <: e}} -> {{web : net <: e}} -> List String -> Co e Unit
each Nil = pure MkUnit
each (u :: us) = do
  t <- fetchText u
  print (showInt (strLength t) ^ " " ^ t)
  each us

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{web : net <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  as <- args
  each as

main : Co world Unit
main =
  program
    (io := \p -> InL p)
    (web := \p -> InR (InL p))
    (sys := \p -> InR (InR p))
