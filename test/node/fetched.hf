-- Requests of a server of the test's own, a line each: its response --
-- its status, the headers the server said of what it was sent, its body
-- -- or why none came (the C backend's libcurl in
-- the process held to the curl it spawns).  `main AT REFUSED`: the
-- server's address, and an address where nothing listens.  `multi AT
-- REFUSED`: the same, awaited by boc, in a reactor.  `crossed AT`:
-- streamed responses begun in one behaviour and read, or let go of, in
-- another.

module test.node.fetched

import bytes as Bytes
import boc as BOC
import co
import exception
import std.filesystem
import std.http as HTTP
import std.io
import std.path as Path
import std.process
import stream as Stream
import uint8 as UInt8

-- (every byte, 0 to 255, twice)
everyByte : Bytes
everyByte =
  Bytes.fromList (List.map (\i -> UInt8.fromInt (i % 256)) (List.range 0 511))

-- (`b` doubled `n` times: 512 bytes doubled 12 times, 2 MiB)
doubled : Bytes -> Int -> Bytes
doubled b 0 = b
doubled b n = doubled (Bytes.append b b) (n - 1)

-- (a header shown: the server's own, `X-...`, and where a redirect goes)
shownHeader : Pair String String -> Bool
shownHeader (MkPair n v) = startsWith "X-" n || strEq n "Location"

showHeaders : List (Pair String String) -> String
showHeaders hs =
  joinWith
    ", "
    (List.map (\h -> fst h ^ ": " ^ snd h) (List.keepIf shownHeader hs))

-- (a body shown: as a binary, `b[...]`, where it is short, else its
-- length and its bytes added up)
showBody : Bytes -> String
showBody b =
  if Bytes.length b <= 64 then debug b
  else debug (Bytes.length b)
    ^ " bytes, sum "
    ^ debug (List.foldl (\s c -> s + UInt8.toInt c) 0 (Bytes.toList b))

-- (an error of a request for `url`, said: its URL left out where it is
-- that one)
errorOf : String -> HTTP.HttpError -> String
errorOf url err =
  if strEq err.url url
  then joinWith "" (split (url ^ ": ") (show err))
  else "of another URL, " ^ show err

showGot : String -> Either HTTP.HttpError HTTP.Response -> String
showGot url (Left err) = errorOf url err
showGot url (Right r) =
  debug r.status ^ " [" ^ showHeaders r.headers ^ "] " ^ showBody r.body

each : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{web : HTTP.http <: e}}
     -> List (Pair String HTTP.Request)
     -> Co e Unit
each [] = pure MkUnit
each (MkPair what rq :: rest) = do
  got <- HTTP.send rq
  print (what ^ ": " ^ showGot rq.url got)
  each rest

requests : String -> String -> List (Pair String HTTP.Request)
requests at refused =
  [ MkPair "get" { url = at ^ "/item" }
  , MkPair
    "post"
    { url = at ^ "/echo"
    , method = "POST"
    , headers =
        [ MkPair "X-Heff" "one two"
        , MkPair "Content-Type" "application/octet-stream"
        ]
    , body = everyByte
    }
  , MkPair
    "post, big"
    { url = at ^ "/echo", method = "POST", body = doubled everyByte 12 }
  , MkPair "post, nothing" { url = at ^ "/echo", method = "POST" }
  , MkPair
    "put"
    { url = at ^ "/echo", method = "PUT", body = Bytes.fromString "put" }
  , MkPair
    "delete"
    { url = at ^ "/echo", method = "DELETE", headers = [MkPair "X-Heff" ""] }
  , MkPair "head" { url = at ^ "/echo", method = "HEAD" }
  , MkPair "404" { url = at ^ "/nope" }
  , MkPair "500" { url = at ^ "/fails" }
  , MkPair "refused" { url = refused }
  , MkPair "followed" { url = at ^ "/moved" }
  , MkPair "not followed" { url = at ^ "/moved", follow = False }
  , MkPair "redirects for ever" { url = at ^ "/loop" }
  , MkPair "in time" { url = at ^ "/slow", timeout = 5000 }
  , MkPair "timed out" { url = at ^ "/slow", timeout = 100 }
  , MkPair "big" { url = at ^ "/big" }
  , MkPair "chunked" { url = at ^ "/chunked" }
  , MkPair "cut short" { url = at ^ "/short" }
  , MkPair "no scheme" { url = "nope://x/" }
  , MkPair "no host" { url = "http://" }
  ]

codeOf : HTTP.HttpError -> String
codeOf err = "code " ^ debug err.code

-- (`getText` and `get` too)
texts : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{web : HTTP.http <: e}}
      -> String
      -> String
      -> Co e Unit
texts at refused = do
  t <- HTTP.getText (at ^ "/item")
  print ("getText: " ^ either (errorOf (at ^ "/item")) (\s -> s) t)
  n <- HTTP.getText refused
  print ("getText, refused: " ^ either codeOf (\s -> s) n)
  m <- HTTP.getText (at ^ "/nope")
  print ("getText, 404: " ^ either (errorOf (at ^ "/nope")) (\s -> s) m)
  r <- HTTP.get (at ^ "/echo")
  print
      ("get: "
       ^ either
         show
         (\x -> fromMaybe "none" (HTTP.header "x-method" x))
         r)

-- (a body read a piece at a time: its pieces, the last first, and how
-- it ended)
piecesRead : {e : HFunctor}
           -> Co (Stream.yielding Bytes <+> e) (Either HTTP.HttpError Unit)
           -> Co e (Pair (List Bytes) (Either HTTP.HttpError Unit))
piecesRead body =
  Stream.fold (Stream.source body) Nil (\acc b -> pure (b :: acc))

endOf : Either HTTP.HttpError Unit -> String
endOf (Left err) = codeOf err
endOf (Right u) = "whole"

-- (whether a body longer than a piece came in pieces)
inPieces : Bytes -> List Bytes -> String
inPieces b pieces =
  if Bytes.length b <= 65536 then ""
  else if List.length pieces > 1 then ", in pieces"
  else ", in one piece"

-- (a response streamed: its status, its body's pieces put together, and
-- how it ended)
streamShown : Pair (List Bytes) (Either HTTP.HttpError Unit) -> Int -> String
streamShown (MkPair pieces ended) status =
  let b = Bytes.concat (List.reverse pieces)
  in debug status ^ " " ^ showBody b ^ inPieces b pieces ^ ", " ^ endOf ended

-- (`stream`, each response's body read a piece at a time)
streams : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> List (Pair String HTTP.Request)
        -> Co e Unit
streams [] = pure MkUnit
streams (MkPair what rq :: rest) = do
  r <- HTTP.stream rq
  case r of
    Left err -> print ("stream " ^ what ^ ": " ^ codeOf err)
    Right s -> do
      got <- piecesRead s.body
      print ("stream " ^ what ^ ": " ^ streamShown got s.status)
  streams rest

streamed : String -> String -> List (Pair String HTTP.Request)
streamed at refused =
  [ MkPair "get" { url = at ^ "/item" }
  , MkPair "big" { url = at ^ "/big" }
  , MkPair "chunked" { url = at ^ "/chunked" }
  , MkPair "404" { url = at ^ "/nope" }
  , MkPair "followed" { url = at ^ "/moved" }
  , MkPair "not followed" { url = at ^ "/moved", follow = False }
  , MkPair "redirects for ever" { url = at ^ "/loop" }
  , MkPair "head" { url = at ^ "/echo", method = "HEAD" }
  , MkPair
    "post"
    { url = at ^ "/echo", method = "POST", body = Bytes.fromString "posted" }
  , MkPair "cut short" { url = at ^ "/short" }
  , MkPair "refused" { url = refused }
  , MkPair "silent" { url = at ^ "/silent", idle = 300 }
  ]

-- (`send` given a limit on a silence: its body read a piece at a time,
-- put together)
idleSends : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{web : HTTP.http <: e}}
          -> String
          -> Co e Unit
idleSends at = do
  r <- HTTP.send { url = at ^ "/big", idle = 1000 }
  print ("send, idle: " ^ showGot (at ^ "/big") r)
  s <- HTTP.send { url = at ^ "/silent", idle = 300 }
  print ("send, silent: " ^ either codeOf (\x -> "answered") s)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  argv <- args
  case argv of
    (at :: refused :: _) -> do
      each (requests at refused)
      texts at refused
      streams (streamed at refused)
      idleSends at
    _ -> printErr "main AT REFUSED"

main : Co (stdio <+> HTTP.http <+> process) Unit
main =
  program
    (io := _)
    (web := _)
    (sys := _)

-- | The same requests, an act awaited by boc, in the reactor of the
-- | worker that takes it: each a transfer of libcurl's multi interface,
-- | pending until it is done, its answer as libcurl's easy one is.
multi : Co (BOC.boc <+> stdio <+> HTTP.http <+> process) Unit
multi = do
  with u :=
         BOC.await
           (program : Co (BOC.boc <+> stdio <+> HTTP.http <+> process) Unit) do
    pure ()

-- Responses handed from one behaviour to another
--------------------------------------------------------------------------------

-- (a response's body read whole, a piece at a time: 1 where it is
-- `/big`'s, whole)
readOut : {e : HFunctor} -> Maybe (HTTP.Streamed e) -> Co e Int
readOut Nothing = pure 0
readOut (Just s) = do
  got <- piecesRead s.body
  pure
      (if strEq
            (streamShown got s.status)
            "200 262144 bytes, sum 32767058, in pieces, whole"
       then 1
       else 0)

-- (how many were read, and how many as sent)
type Read = { done : Int, sent : Int }

-- (one more read, `r` whether as sent)
readOne : Read -> Int -> Read
readOne c r = { done = c.done + 1, sent = c.sent + r }

-- (`u` streamed in a behaviour of a cown of its own, and its body read
-- in the next, of that cown and `counts`: there, or by an act it
-- awaits where `inAct`)
handedOver : {e : HFunctor}
           -> {{bc : BOC.boc <: e}}
           -> {{web : HTTP.http <: e}}
           -> String
           -> Bool
           -> BOC.Cown Read
           -> Co e Unit
handedOver u inAct counts = do
  slot <- BOC.newCown (Nothing : Maybe (HTTP.Streamed e))
  with s := slot do
    r <- HTTP.stream { url = u }
    s := either (\err -> Nothing) Just r
  if inAct
  then do
    with s := slot do
      let v = s
      s := Nothing
      with c := counts
           r := BOC.await (readOut v) do
        c := readOne c r
  else do
    with s := slot
         c := counts do
      r <- readOut s
      s := Nothing
      c := readOne c r

-- (`n` responses handed over)
handOvers : {e : HFunctor}
          -> {{bc : BOC.boc <: e}}
          -> {{web : HTTP.http <: e}}
          -> String
          -> Bool
          -> BOC.Cown Read
          -> Int
          -> Co e Unit
handOvers u inAct counts 0 = pure MkUnit
handOvers u inAct counts n = do
  handedOver u inAct counts
  handOvers u inAct counts (n - 1)

-- (how many descriptors the program has open; -1 where that is not to
-- be known)
openFds : {e : HFunctor} -> {{disk : filesystem <: e}} -> Co e Int
openFds = do
  r <-
    attempt
      FileError
      (readDirectory
         (ev := _)
         (ex := _)
         (Path.parse "/dev/fd"))
  pure (either (\err -> 0 - 1) (\l -> List.length l) r)

-- (the first piece of a body read, the rest not: 1 where there was one)
firstPiece : {e : HFunctor} -> Maybe (HTTP.Streamed e) -> Co e Int
firstPiece Nothing = pure 0
firstPiece (Just s) = do
  got <-
    Stream.fold
      (Stream.take 1 (Stream.source s.body))
      0
      (\n b -> pure (n + 1))
  pure (fst got)

-- (the descriptors open after the first round and after the last, and
-- the rounds done, each a first piece read)
type Rounds = { first : Int, last : Int, done : Int, pieces : Int }

-- (one more round, `k` descriptors open after it)
roundOne : Rounds -> Int -> Int -> Rounds
roundOne f k p =
  { first = if f.done == 0 then k else f.first
  , last = k
  , done = f.done + 1
  , pieces = f.pieces + p
  }

-- (`n` rounds: `u` streamed in a behaviour of `slot`'s, its first piece
-- read in the next, of `slot` and `rounds`, and the rest let go of
-- there, the response with it)
dropped : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{disk : filesystem <: e}}
        -> String
        -> BOC.Cown (Maybe (HTTP.Streamed e))
        -> BOC.Cown Rounds
        -> Int
        -> Co e Unit
dropped u slot rounds 0 = pure MkUnit
dropped u slot rounds n = do
  with s := slot do
    r <- HTTP.stream { url = u }
    s := either (\err -> Nothing) Just r
  with s := slot
       f := rounds do
    p <- firstPiece s
    s := Nothing
    k <- openFds
    f := roundOne f k p
  dropped u slot rounds (n - 1)

-- (the descriptors after the last round, held to those after the
-- first: never more)
fdsSaid : Rounds -> String
fdsSaid f =
  if f.first > 0 && f.last <= f.first
  then "descriptors: no more than after the first"
  else "descriptors: "
    ^ debug f.first
    ^ " after the first, "
    ^ debug f.last
    ^ " after the last"

-- | Responses begun in one behaviour and read in another, each of a
-- | cown of its own, which threads run them boc's to choose: `/big`
-- | eight times read in a behaviour, eight times in an act awaited;
-- | then, those done, twenty rounds of its first piece read and the
-- | rest let go of in the behaviour after the one that began it.
-- | `crossed AT`.
crossed : Co
          (BOC.boc <+> stdio <+> HTTP.http <+> process <+> filesystem)
          Unit
crossed = do
  argv <- args
  let at = fromMaybe "" (List.head argv)
  inBehaviours <- BOC.newCown { done = 0, sent = 0 }
  inActs <- BOC.newCown { done = 0, sent = 0 }
  handOvers (at ^ "/big") False inBehaviours 8
  handOvers (at ^ "/big") True inActs 8
  slot <- BOC.newCown Nothing
  rounds <- BOC.newCown { first = 0, last = 0, done = 0, pieces = 0 }
  with b := inBehaviours
       a := inActs
       once b.done >= 8 && a.done >= 8 do
    print ("read in another behaviour, as sent: " ^ debug b.sent ^ " of 8")
    print ("read in an act it awaits, as sent: " ^ debug a.sent ^ " of 8")
    dropped (at ^ "/big") slot rounds 20
  with f := rounds once f.done >= 20 do
    print
        ("let go of in another behaviour, 20 times: "
         ^ debug f.pieces
         ^ " first pieces, "
         ^ fdsSaid f)
