-- C's streams as an effect of the test's own, done by C's own functions
-- alone: no provider written by hand -- the module describes each
-- operation's function (ffi), and the compiler makes the provider of
-- it.  A stream is a foreign value, a `FILE *`, closed when the
-- program drops its last reference: what was written to it and never
-- flushed is in the file once it is.

module test.node.cstdio

import co
import ffi as FFI
import rune as Rune
import std.io

-- | A C stream, open: a foreign value; no value of the program has it.
data Stream

data CStdioF (m : Type -> Type) x
  = Open String String (Either FFI.Errno Stream -> x)
  | Getc Stream (Int -> x)
  | Puts String Stream (Int -> x)
  | Flush Stream (Either FFI.Errno Unit -> x)
  | Remove String (Either FFI.Errno Unit -> x)
  | Clear Stream x

cstdio : HFunctor
cstdio =
  { f = CStdioF
  , hfmap = \m g p -> case p of
      Open path mode k -> Open path mode (\r -> g (k r))
      Getc s k -> Getc s (\c -> g (k c))
      Puts str s k -> Puts str s (\n -> g (k n))
      Flush s k -> Flush s (\r -> g (k r))
      Remove path k -> Remove path (\r -> g (k r))
      Clear s x -> Clear s (g x)
  , hmap = \m n nt p -> case p of
      Open path mode k -> Open path mode k
      Getc s k -> Getc s k
      Puts str s k -> Puts str s k
      Flush s k -> Flush s k
      Remove path k -> Remove path k
      Clear s x -> Clear s x
  }

-- (a stream, as C has it: a `FILE *`, `fclose` letting it go)
stream : FFI.CType
stream = FFI.pointer "FILE" "fclose"

-- | The operations, each C's function of the same name.
cstdioInC : FFI.Described
cstdioInC =
  FFI.describe
    ["<stdio.h>"]
    [ FFI.operation
        "Open"
        (FFI.fun "fopen" [FFI.string, FFI.string] (FFI.givesOrErrno stream))
    , FFI.operation "Getc" (FFI.fun "fgetc" [stream] (FFI.gives FFI.int))
    , FFI.operation "Puts" (FFI.fun "fputs" [FFI.string, stream] (FFI.gives FFI.int))
    , FFI.operation "Flush" (FFI.fun "fflush" [stream] FFI.doneOrErrno)
    , FFI.operation "Remove" (FFI.fun "remove" [FFI.string] FFI.doneOrErrno)
    , FFI.operation "Clear" (FFI.fun "clearerr" [stream] (FFI.gives FFI.void))
    ]

open : {e : HFunctor}
     -> {{ev : cstdio <: e}}
     -> String
     -> String
     -> Co e (Either FFI.Errno Stream)
open path mode = op (ev (Open path mode (\r -> r))) val

getc : {e : HFunctor} -> {{ev : cstdio <: e}} -> Stream -> Co e Int
getc s = op (ev (Getc s (\c -> c))) val

puts : {e : HFunctor} -> {{ev : cstdio <: e}} -> String -> Stream -> Co e Int
puts str s = op (ev (Puts str s (\n -> n))) val

flush : {e : HFunctor}
      -> {{ev : cstdio <: e}}
      -> Stream
      -> Co e (Either FFI.Errno Unit)
flush s = op (ev (Flush s (\r -> r))) val

remove : {e : HFunctor}
       -> {{ev : cstdio <: e}}
       -> String
       -> Co e (Either FFI.Errno Unit)
remove path = op (ev (Remove path (\r -> r))) val

clear : {e : HFunctor} -> {{ev : cstdio <: e}} -> Stream -> Co e Unit
clear s = op (ev (Clear s MkUnit)) val

-- (the stream's characters to its end, after those read so far)
readAll : {e : HFunctor}
        -> {{cs : cstdio <: e}}
        -> Stream
        -> List Rune
        -> Co e String
readAll s acc = do
  c <- getc s
  if c < 0 then pure (strOfRunes (List.reverse acc))
    else readAll s (Cons (Rune.fromInt c) acc)

-- (a write, and the stream dropped: closed by C, what was written in the file)
written : {e : HFunctor}
        -> {{cs : cstdio <: e}}
        -> {{io : stdio <: e}}
        -> String
        -> Either FFI.Errno Stream
        -> Co e Unit
written str (Right s) = do
  n <- puts str s
  clear s
  print ("wrote: " ^ (if n >= 0 then "yes" else "no"))
written str (Left err) = print ("cannot write: " ^ FFI.showErrno err)

-- (what the file holds, read to its end; the stream dropped after)
read : {e : HFunctor}
     -> {{cs : cstdio <: e}}
     -> {{io : stdio <: e}}
     -> Either FFI.Errno Stream
     -> Co e Unit
read (Right s) = do
  text <- readAll s Nil
  r <- flush s
  print ("read: " ^ show text ^ (case r of
    Right _ -> ""
    Left err -> " (flush: " ^ err.name ^ ")"))
read (Left err) = print ("cannot read: " ^ FFI.showErrno err)

-- (why a stream could not be opened)
failed : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> Either FFI.Errno Stream
       -> Co e Unit
failed (Right s) = print "opened what is not there"
failed (Left err) = print ("not opened: " ^ err.name ^ " " ^ show err.code)

-- (whether a file was removed)
removed : {e : HFunctor} -> {{io : stdio <: e}} -> Either FFI.Errno Unit -> Co e Unit
removed (Right _) = print "removed"
removed (Left err) = print ("not removed: " ^ err.name)

program : {e : HFunctor} -> {{cs : cstdio <: e}} -> {{io : stdio <: e}} -> Co e Unit
program = do
  w <- open "cstdio-test.txt" "w"
  written "hello, C\n" w
  r <- open "cstdio-test.txt" "r"
  read r
  missing <- open "cstdio-missing.txt" "r"
  failed missing
  gone <- remove "cstdio-test.txt"
  removed gone
  again <- remove "cstdio-test.txt"
  removed again

main : Co (cstdio <+> stdio) Unit
main = program (cs := _) (io := _)
