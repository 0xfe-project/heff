-- Commands awaited by boc's behaviours: each act a `withProcess` of its
-- own, a sleep of a second, waited for in the reactor of the worker
-- that takes it -- the wait pending while the others go on, so that
-- three sleeps are waited for in about a second, not three.  By C
-- alone.
--
--   main     three sleeps started at once, each an act awaited, the
--            behaviour after it counting it on a cown; the count said
--            once every behaviour is done

module test.node.boc-process

import boc as BOC
import co
import custodian as Custodian
import exception
import std.io
import std.process

-- (a command of a second, held and waited for: 1, or 0 where it was
-- not run)
sleeper : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Int
sleeper = do
  r <-
    attempt
      ProcessError
      (withProcess { command = "sleep", args = ["1"] } (\p -> wait p))
  pure (either (\err -> 0) (\r -> 1) r)

-- (n sleeps, each awaited, counted on `done`)
sleeps : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> {{sys : process <: e}}
       -> {{cu : Custodian.custodian <: e}}
       -> BOC.Cown Int
       -> Int
       -> Co e Unit
sleeps done n =
  if n <= 0 then pure ()
  else do
    with d := done
         x := BOC.await sleeper do
      d := d + x
    sleeps done (n - 1)

-- (what the cown holds, every behaviour before done, said)
said : {e : HFunctor}
     -> {{bc : BOC.boc <: e}}
     -> {{io : stdio <: e}}
     -> BOC.Cown Int
     -> Co e Unit
said done =
  BOC.scheduled
    (\why -> abandon)
    (BOC.when done (\n -> do
     print (debug n ^ " sleeps waited for at once")
     pure n))

main : Co (BOC.boc <+> Custodian.custodian <+> stdio <+> process) Unit
main = do
  done <- BOC.newCown 0
  BOC.scheduled (\why -> print ("failed: " ^ why)) (sleeps done 3)
  said done
