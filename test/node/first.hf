-- The first thread lent to a provider: a job of the provider's own run
-- on the process's first thread, as a toolkit's loop would be, the
-- program going on on its own.  A job returns, or never does, or loops
-- until it is stopped as the program ends; on macOS, one runs the main
-- run loop, which serves what the program sends to the main queue.

module test.node.first

import co
import std.io
import std.process

-- | What a job lent does: say where it ran and return; never return;
-- | say where it ran and loop until stopped; run the main run loop
-- | (macOS) until stopped.
data Job = Returns | Forever | Looping | RunLoop

data FirstF (m : Type -> Type) x
  = Lend Job (Int -> x)
  | HasRun (Bool -> x)
  | Here (Bool -> x)
  | Dispatched (Bool -> x)
  | Failed String x

firstThread : HFunctor
firstThread =
  { f = FirstF
  , hfmap = \m g p -> case p of
      Lend j k -> Lend j (\c -> g (k c))
      HasRun k -> HasRun (\b -> g (k b))
      Here k -> Here (\b -> g (k b))
      Dispatched k -> Dispatched (\b -> g (k b))
      Failed s x -> Failed s (g x)
  , hmap = \m n nt p -> case p of
      Lend j k -> Lend j k
      HasRun k -> HasRun k
      Here k -> Here k
      Dispatched k -> Dispatched k
      Failed s x -> Failed s x
  }

-- | the job lent: what `heff_first_thread` said (0 queued, 1 one lent
-- | already)
lend : {e : HFunctor} -> {{ev : firstThread <: e}} -> Job -> Co e Int
lend j = op (ev (Lend j (\c -> c))) val

-- | whether the job `Returns` or `Looping` ran on the first thread,
-- | once it has begun
ran : {e : HFunctor} -> {{ev : firstThread <: e}} -> Co e Bool
ran = op (ev (HasRun (\b -> b))) val

-- | whether the program is on the first thread
here : {e : HFunctor} -> {{ev : firstThread <: e}} -> Co e Bool
here = op (ev (Here (\b -> b))) val

-- | whether what was sent to the main queue ran on the first thread
dispatched : {e : HFunctor} -> {{ev : firstThread <: e}} -> Co e Bool
dispatched = op (ev (Dispatched (\b -> b))) val

-- | the program failed, as by a failure no one caught
failed : {e : HFunctor} -> {{ev : firstThread <: e}} -> String -> Co e Unit
failed why = op (ev (Failed why MkUnit)) val

main : Co (stdio <+> firstThread) Unit
main = do
  h <- here
  print ("the program on the first thread: " ^ show h)
  c <- lend Returns
  print ("lent: " ^ debug c)
  r <- ran
  print ("the job on the first thread: " ^ show r)

never : Co (stdio <+> firstThread) Unit
never = do
  c <- lend Forever
  again <- lend Returns
  print ("lent: " ^ debug c ^ ", again: " ^ debug again)
  print "bye"

neverExit : Co (stdio <+> process <+> firstThread) Unit
neverExit = do
  c <- lend Forever
  print ("lent: " ^ debug c)
  exit 3

looping : Co (stdio <+> firstThread) Unit
looping = do
  c <- lend Looping
  r <- ran
  print ("lent: " ^ debug c ^ ", begun on the first thread: " ^ show r)

loopingExit : Co (stdio <+> process <+> firstThread) Unit
loopingExit = do
  c <- lend Looping
  r <- ran
  print ("lent: " ^ debug c ^ ", begun on the first thread: " ^ show r)
  exit 4

loopingFailed : Co (stdio <+> firstThread) Unit
loopingFailed = do
  c <- lend Looping
  r <- ran
  print ("lent: " ^ debug c ^ ", begun on the first thread: " ^ show r)
  failed "first: failed"
  print "never"

runLoop : Co (stdio <+> firstThread) Unit
runLoop = do
  c <- lend RunLoop
  print ("lent: " ^ debug c)
  d <- dispatched
  print ("dispatched to the first thread: " ^ show d)
