-- Time and the network in a program (test/node-run.mjs); dom has a `sleep`
-- and a `fetchText` too, in its own effect.

import co
import net
import prelude
import stdio
import time

eff : HFunctor
eff = time <+> net <+> stdio

clock : (time <: eff)
clock = first3 time net stdio

web : (net <: eff)
web = mid3 time net stdio

out : (stdio <: eff)
out = last3 time net stdio

timed : Co eff Unit
timed = do
  sleep clock 10
  t <- fetchText web "data:text/plain,fetched"
  print out t
