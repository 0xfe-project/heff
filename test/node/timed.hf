-- Time and the network in a program (test/node-run.mjs); dom has a `sleep`
-- and a `fetchText` too, in its own effect.

import co
import net
import prelude
import stdio
import time

world : HFunctor
world = time <+> net <+> stdio

program : {e : HFunctor}
        -> {{clock : time <: e}}
        -> {{web : net <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  sleep 10
  t <- fetchText "data:text/plain,fetched"
  print t

-- where the world is: each sub-effect's evidence, given
timed : Co world Unit
timed =
  program
    (clock := \p -> InL (InL p))
    (web := \p -> InL (InR p))
    (io := \p -> InR p)
