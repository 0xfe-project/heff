-- Time in a program; browser.dom has a `sleep` too,
-- in its own effect.

import co
import std.io
import std.time

world : HFunctor
world = time <+> stdio

program : {e : HFunctor}
        -> {{clock : time <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  sleep 10
  print "slept"

-- where the world is: each sub-effect's evidence, given
timed : Co world Unit
timed = program (clock := \p -> InL p) (io := \p -> InR p)
