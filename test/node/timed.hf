-- Time and the network in a program (test/node-run.mjs); dom has a `sleep`
-- and a `fetchText` too, in its own effect.

import co
import net
import prelude
import stdio
import time

eff : HFunctor
eff = time <+> net <+> stdio

timed : Co eff Unit
timed = do
  lift (\p -> inl (time <+> net) stdio (inl time net p)) (sleep 10)
  t <-
    lift
      (\p -> inl (time <+> net) stdio (inr time net p))
      (fetchText "data:text/plain,fetched")
  lift (inr (time <+> net) stdio) (print t)
