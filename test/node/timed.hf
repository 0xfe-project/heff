-- Time in a program; browser.dom has a `sleep` too,
-- in its own effect.

module test.node.timed

import co
import std.io
import std.time

program : {e : HFunctor}
        -> {{clock : time <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  sleep 10
  print "slept"

-- where the world is: each sub-effect's evidence, found
timed : Co (time <+> stdio) Unit
timed = program (clock := _) (io := _)
