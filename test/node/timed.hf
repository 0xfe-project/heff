-- Time and the network in a program (test/node-run.mjs); dom has a `sleep`
-- and a `fetchText` too, in its own effect.

import co
import net
import prelude
import stdio
import time

world : HFunctor
world = time <+> net <+> stdio

clock : (time <: world)
clock = \p -> InL (InL p)

web : (net <: world)
web = \p -> InL (InR p)

out : (stdio <: world)
out = \p -> InR p

timed : Co world Unit
timed = do
  sleep clock 10
  t <- fetchText web "data:text/plain,fetched"
  print out t
