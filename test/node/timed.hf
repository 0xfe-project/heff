-- Time and the network in a program (test/node-run.mjs); dom has a `sleep`
-- and a `fetchText` too, imported as `D` so that they are `D.sleep` and
-- `D.fetchText`.

import co
import dom as D
import io
import prelude

timed :: Co io Unit
timed = do
  sleep 10
  t <- fetchText "data:text/plain,fetched"
  print t
