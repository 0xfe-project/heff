-- What a `with` holds, given to boc's behaviours and acts: the `with`
-- lets go of it when its block ends, and the thing is ended once the
-- behaviour or act is done with it, not before.  By C alone
-- (std.process, std.net).
--
--   main     a command an act is given waited for by it after the
--            `with` that started it has ended: it exits as it would;
--            a connection an act is given written on by it after its
--            `with` has ended, then closed as the act is done: the
--            other side reads what was written, then the end; and a
--            behaviour holding a connection, waiting for a condition
--            that never holds, dropped at the program's end, which it
--            does not keep from ending
--
-- What the acts come to is logged, each in its place, and printed once
-- all of it is in.

module test.node.custody

import boc as BOC
import bytes as Bytes
import co
import custodian as Custodian
import exception
import std.io
import std.net as Net
import std.process
import resource

endedAs : Ended -> String
endedAs (Exited n) = "exited " ^ debug n
endedAs (Signalled n) = "signalled " ^ debug n
endedAs TimedOut = "timed out"
endedAs (NotRun err) = "not run: " ^ err.message

-- (`what` put at the end of the log once it holds `n` lines, by a
-- behaviour waiting until it does: in its place, wherever it runs)
logged : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown (List String)
       -> Int
       -> String
       -> Co e Unit
logged log n what = do
  with l := log
    where List.length l == n
  do
    l := List.append l [what]

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

-- A command ----------------------------------------------------------------------------

-- (a command started by a `with`, waited for by an act awaited in it:
-- the act runs once a worker takes it, the `with` over by then)
commanded : {e : HFunctor}
          -> {{bc : BOC.boc <: e}}
          -> {{sys : process <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> {{cu : Custodian.custodian <: e}}
          -> BOC.Cown (List String)
          -> Co e Unit
commanded log = do
  with withProcess { command = "sleep", args = ["0.3"] } as p do
    with r := BOC.await (wait p) do
      logged log 0 ("an act waited: " ^ endedAs r.ended)

-- A connection -------------------------------------------------------------------------

here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (what comes on the connection, to its end)
drained : {e : HFunctor}
        -> {s : Type}
        -> {{nt : Net.net <: e}}
        -> With s Net.TcpStream
        -> Bytes
        -> Co e String
drained c got = do
  r <- Net.read (timeout := 5000) c 4096
  case r of
    Left err -> pure ("failed: " ^ err.name)
    Right b ->
      if Bytes.length b == 0 then pure (Bytes.asString got)
      else drained c (Bytes.append got b)

-- (the other side's: accepted, read to its end)
reader : {e : HFunctor}
       -> {s : Type}
       -> {{nt : Net.net <: e}}
       -> With s Net.TcpListener
       -> Co e String
reader l = do
  r <- Net.accepted l
  case r of
    Left err -> pure ("not accepted: " ^ err.name)
    Right c -> do
      got <- drained c Bytes.empty
      pure ("the other side read: " ^ got)

-- (a connection made by a `with`, written on by an act awaited in it,
-- once a worker takes it, the `with` over by then; the other side
-- read by an act of its own)
connectedTo : {e : HFunctor}
            -> {s : Type}
            -> {{bc : BOC.boc <: e}}
            -> {{nt : Net.net <: e}}
            -> {{ex : exception Net.NetError <: e}}
            -> {{cu : Custodian.custodian <: e}}
            -> BOC.Cown (List String)
            -> With s Net.TcpListener
            -> Int
            -> Co e Unit
connectedTo log l port = do
  with got := BOC.await (reader l) do
    logged log 1 got
  with Net.withConnection (here port) as c do
    with w :=
           BOC.await
             (Net.write c (Bytes.fromString "written after the with")) do
      pure ()

-- The program's end -------------------------------------------------------------------

-- (a connection held by a behaviour whose condition never holds, as
-- nothing writes the cown it reads: dropped, its body never run, at the
-- program's end)
dropped : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Int
        -> Co e Unit
dropped port = do
  never <- BOC.newCown False
  with Net.withConnection (here port) as c do
    with n := never
      where n
    do
      w <- Net.write c (Bytes.fromString "never")
      pure ()

-- Main ---------------------------------------------------------------------------------

listened : {e : HFunctor}
         -> {s : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> {{nt : Net.net <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> BOC.Cown (List String)
         -> With s Net.TcpListener
         -> Co e Unit
listened log l = do
  a <- Net.local l
  case a of
    Left err -> print ("no port: " ^ err.name)
    Right at -> do
      r <-
        attempt
          Net.NetError (do
            connectedTo log l at.port
            dropped at.port)
      case r of
        Left err -> print ("thrown: " ^ err.name)
        Right u -> pure ()

main : Co
       (BOC.boc <+> Custodian.custodian <+> stdio <+> process <+> Net.net)
       Unit
main = do
  log <- BOC.newCown Nil
  r <- attempt ProcessError (commanded log)
  case r of
    Left err -> print ("thrown: " ^ err.message)
    Right u -> pure ()
  l <- Net.withListener (here 0) 16 (listened log)
  case l of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> pure ()
  with ls := log
    where List.length ls == 2
  do
    printed ls
