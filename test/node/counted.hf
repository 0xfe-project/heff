-- One world handled at home, the rest handed on (test/node-run.mjs): the
-- counter is a state effect peeled off in the language -- the handler's
-- monad is `Int -> Co stdio _`, stdio computations carrying the count --
-- and what is left is a stdio program, which `heff node` runs.  An io
-- operation crosses the state layer by being performed again in
-- `Co stdio`, the count carried past it.

import co
import prelude
import state
import stdio

world : HFunctor
world = state Int <+> stdio

onCt : (state Int <: world)
onCt = inl (state Int) stdio

onIo : (stdio <: world)
onIo = inr (state Int) stdio

-- | The count, counted.
next : Co world Int
next = do
  n <- get onCt
  put onCt (n + 1)
  pure n

greet : String -> Co world Unit
greet s = do
  n <- next
  print onIo (showInt n ++ ": " ++ s)

prog : Co world Unit
prog = do
  greet "one"
  greet "two"
  greet "three"

counted : Handler world
counted =
  { M = \a -> Int -> Co stdio (Pair a Int)
  , ret = \x n -> val (MkPair x n)
  , bind = \m k n ->
        bind (m n) (\xn -> case xn of
        MkPair x n2 -> k x n2)
  , malg = \p n -> case p of
      InL t -> case t of
        Get k -> val (MkPair (k n) n)
        Put n2 x -> val (MkPair x n2)
      InR q -> case q of
        Write s x ->
          bind (op (Write s (MkUnit : Unit)) val) (\u -> val (MkPair x n))
        WriteErr s x ->
          bind (op (WriteErr s (MkUnit : Unit)) val) (\u -> val (MkPair x n))
        ReadStdin k ->
          bind (op (ReadStdin (\s -> s)) val) (\s -> val (MkPair (k s) n))
  }

main : Co stdio Unit
main = do
  xn <- handle counted prog 0
  case xn of
    MkPair u n -> print (here stdio) ("counted " ++ showInt n)
