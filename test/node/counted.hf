-- One world handled at home, the rest handed on: the
-- counter is a state effect peeled off in the language -- the handler's
-- monad is `Int -> Co stdio _`, stdio computations carrying the count --
-- and what is left is a stdio program, which `heff run` runs.  An io
-- operation crosses the state layer by being performed again in
-- `Co stdio`, the count carried past it.

module test.node.counted

import co
import state
import std.io

world : HFunctor
world = state Int <+> stdio

-- | The count, counted.
next : {e : HFunctor} -> {{ct : state Int <: e}} -> Co e Int
next = do
  n <- get
  put (n + 1)
  pure n

greet : {e : HFunctor}
      -> {{ct : state Int <: e}}
      -> {{io : stdio <: e}}
      -> String
      -> Co e Unit
greet s = do
  n <- next
  print (show n ^ ": " ^ s)

prog : {e : HFunctor}
     -> {{ct : state Int <: e}}
     -> {{io : stdio <: e}}
     -> Co e Unit
prog = do
  greet "one"
  greet "two"
  greet "three"

counted : Handler world
counted =
  { M = \a -> Int -> Co stdio (Pair a Int)
  , ret = \x n -> val (MkPair x n)
  , bind = \m k n ->
        bind (m n) (\xn -> case xn of
        MkPair x n2 -> k x n2)
  , malg = \p n -> case p of
      InL t -> case t of
        Get k -> val (MkPair (k n) n)
        Put n2 x -> val (MkPair x n2)
      InR q -> case q of
        Write s x ->
          bind (op (Write s (MkUnit : Unit)) val) (\u -> val (MkPair x n))
        WriteErr s x ->
          bind (op (WriteErr s (MkUnit : Unit)) val) (\u -> val (MkPair x n))
        ReadStdin k ->
          bind (op (ReadStdin (\s -> s)) val) (\s -> val (MkPair (k s) n))
  }

-- (the evidence of each world, given where the program is handled)
main : Co stdio Unit
main = do
  xn <-
    handle
      counted
      (prog (ct := inl (state Int) stdio) (io := inr (state Int) stdio))
      0
  case xn of
    MkPair u n -> print (ev := here stdio) ("counted " ^ show n)
