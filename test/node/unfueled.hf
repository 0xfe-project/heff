-- std.fuel's `limited` in a program built without fuel: nothing ticked
-- but the world's operations, so a pure loop runs past its limit, to its
-- end, and a loop of operations is stopped; heff warns at each use.

module test.node.unfueled

import co
import std.fuel as Fuel
import std.io

-- (`1 + ... + n`, by a loop of no operation)
sumTo : Int -> Int -> Int
sumTo n acc = if n <= 0 then acc else sumTo (n - 1) (acc + n)

-- (`n` operations of the world's, each a limit of its own)
operations : {e : HFunctor} -> {{fl : Fuel.fuel <: e}} -> Int -> Co e Int
operations n =
  if n <= 0 then pure 0
  else do
    _ <- Fuel.limited 5 (pure ())
    operations (n - 1)

-- (what a limit came to)
said : Maybe Int -> String
said (Just x) = "Just " ^ debug x
said Nothing = "Nothing"

main : Co (stdio <+> Fuel.fuel) Unit
main = do
  pure_ <- Fuel.limited 1000 (later (\u -> sumTo 100000 0))
  ops <- Fuel.limited 1000 (operations 100000)
  print ("a pure loop: " ^ said pure_)
  print ("operations: " ^ said ops)
