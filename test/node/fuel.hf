-- Fuel, by std.domain's `limited`, on the C backend: the program of
-- test/node/fuel-program.hf, its lines said.

module test.node.fuel

import co
import std.domain as Domain
import std.io
import test.node.fuel-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- Program.lines
  printed ls

main : Co (stdio <+> Domain.domain) Unit
main = program (io := _) (dm := _)
