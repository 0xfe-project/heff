-- Fuel, by std.fuel's `limited`, on the C backend, built with fuel: the program of
-- test/node/fuel-program.hf, its lines said.

module test.node.fuel

import co
import std.fuel as Fuel
import std.io
import test.node.fuel-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{fl : Fuel.fuel <: e}}
        -> Co e Unit
program = do
  ls <- Program.lines
  printed ls
  ns <- Program.nearness
  printed ns

main : Co (stdio <+> Fuel.fuel) Unit
main = program (io := _) (fl := _)
