-- A failed release cascades up the custodians, by C alone (std.net,
-- boc, and flaky.hf's things, one of which fails to end).  Each `with`
-- of a custodian is written in a world of its own, as a program's
-- `main` is.
--
--   main     a server with a custodian of its own for each connection,
--            one that contains its failures: the second connection's
--            thing, held by a cown past its `with`, fails to end as the
--            behaviour on the cown lets go of it; its custodian is shut
--            down -- what it was given run, the one under it shut down
--            too, its connection closed, so the server's write on it, by
--            the behaviour after, fails and its client reads nothing --
--            and the failure said, the server going on to the third
--   rooted   a thing that fails to end, in the custody of a custodian
--            under another, in the same block, neither containing it:
--            the failure goes up through both to the root, the
--            program's, said, the program ended
--   behaviours
--            two behaviours on one cown, the first spawned in a
--            custodian that contains its failures, the other not: the
--            first's thing that fails to end takes its custodian down
--            alone; the other's, the root's, ends the program
--   connections
--            a server of behaviours, each accept an act awaited in a
--            custodian of its own for its connection, one that contains
--            its failures, the connection put in its custody, its
--            clients acts too: the second's thing, held by a cown past
--            its `with`, fails to end as the behaviour on the cown lets
--            go of it, its custodian alone shut down -- its connection
--            closed, the server's write on it failing -- the others
--            served
--
-- What a server logs is printed once all of it is in, each line in its
-- place, and what its custodians ran after it.

module test.node.cascade

import boc as BOC
import bytes as Bytes
import co
import custodian as Custodian
import exception
import std.io
import std.net as Net
import resource
import test.node.flaky as Flaky

here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (`what` put at the end of the log, by a behaviour on it)
logged : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> BOC.Cown (List String)
       -> String
       -> Co e Unit
logged log what = do
  with l := log do
    l := List.append l [what]

-- (... once it holds `n` lines, by a behaviour waiting until it does: in
-- its place, wherever it runs)
loggedAt : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> BOC.Cown (List String)
         -> Int
         -> String
         -> Co e Unit
loggedAt log n what = do
  with l := log once List.length l == n do
    l := List.append l [what]

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

-- (the lines of the log and then those of the stops printed, once they
-- hold `n` and `m`, by a behaviour waiting until they do)
said : {e : HFunctor}
     -> {{bc : BOC.boc <: e}}
     -> {{io : stdio <: e}}
     -> BOC.Cown (List String)
     -> BOC.Cown (List String)
     -> Int
     -> Int
     -> Co e Unit
said log stops n m = do
  with l := log
       s := stops
       once List.length l == n && List.length s == m do
    printed l
    printed s

-- (what comes on the connection, to its end)
drained : {e : HFunctor}
        -> {s : Type}
        -> {{nt : Net.net <: e}}
        -> With s Net.TcpStream
        -> Bytes
        -> Co e String
drained c got = do
  r <- Net.read (timeout := 5000) c 4096
  case r of
    Left err -> pure ("failed: " ^ err.name)
    Right b ->
      if Bytes.length b == 0 then pure (Bytes.asString got)
      else drained c (Bytes.append got b)

-- (nothing, where `m` was: what the cown holding a thing is left with)
gone : {a : Type} -> Maybe a -> Maybe a
gone m = Nothing

-- (a thing, one that fails to end where `fails`, held past its `with`
-- by a cown of its own, let go of by a behaviour on the cown; then
-- `after`, a behaviour after that one on the cown)
heldPast : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{fl : Flaky.flaky <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> {{sx : exception String <: e}}
         -> Bool
         -> Co e Unit
         -> Co e Unit
heldPast fails after = do
  with Flaky.withThing fails as t do
    keep <- BOC.newCown (Just t)
    with k := keep do
      k := gone k
    with k := keep do
      after

-- (the `i`th connection, by its client and the server: the server's in
-- a custodian of its own, which contains its failures, with one under
-- it; the connection's thing held by a cown past its `with`, let go of
-- by a behaviour, and the write by the behaviour after it; the client's
-- read once the connection is closed, after it.  What each comes to
-- logged in its place, what the custodians run put on `stops`)
served : {e : HFunctor}
       -> {s : Type}
       -> {{bc : BOC.boc <: e}}
       -> {{cu : Custodian.custodian <: e}}
       -> {{nt : Net.net <: e}}
       -> {{fl : Flaky.flaky <: e}}
       -> {{nx : exception Net.NetError <: e}}
       -> {{sx : exception String <: e}}
       -> With s Net.TcpListener
       -> Int
       -> BOC.Cown (List String)
       -> BOC.Cown (List String)
       -> Int
       -> Co e Unit
served l port log stops i = do
  with Net.withConnection (here port) as cl do
    with k := Custodian.contained do
      _ <-
        Custodian.manage
          k
          (logged stops ("custodian " ^ debug i ^ " shut down"))
      sub <- Custodian.make
      _ <-
        Custodian.manage
          sub
          (logged stops ("the one under " ^ debug i ^ " shut down"))
      with Net.accept l as c do
        heldPast
            (i == 2) (do
              w <- Net.write c (Bytes.fromString ("served " ^ debug i))
              case w of
                Left err ->
                  loggedAt
                    log
                    (2 * i - 2)
                    ("connection " ^ debug i ^ ": " ^ err.name)
                Right u ->
                  loggedAt
                    log
                    (2 * i - 2)
                    ("connection " ^ debug i ^ " written"))
    got <- drained cl Bytes.empty
    loggedAt log (2 * i - 1) ("client " ^ debug i ^ " read: " ^ got)

listened : {e : HFunctor}
         -> {s : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> {{io : stdio <: e}}
         -> {{nt : Net.net <: e}}
         -> {{fl : Flaky.flaky <: e}}
         -> BOC.Cown (List String)
         -> BOC.Cown (List String)
         -> With s Net.TcpListener
         -> Co e Unit
listened log stops l = do
  a <- Net.local l
  case a of
    Left err -> print ("no port: " ^ err.name)
    Right at -> do
      r <-
        attempt
          String
          (attempt
             Net.NetError (do
               served l at.port log stops 1
               served l at.port log stops 2
               served l at.port log stops 3))
      case r of
        Left why -> print ("thrown: " ^ why)
        Right (Left err) -> print ("thrown: " ^ err.name)
        Right (Right u) -> pure ()
      said log stops 6 2

main : Co
       (BOC.boc
        <+> Custodian.custodian
        <+> stdio
        <+> Net.net
        <+> Flaky.flaky)
       Unit
main = do
  log <- BOC.newCown Nil
  stops <- BOC.newCown Nil
  r <- Net.withListener (here 0) 16 (listened log stops)
  case r of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> pure ()

rooted : Co (Custodian.custodian <+> stdio <+> Flaky.flaky) Unit
rooted = do
  r <-
    attempt
      String (do
        with outer := Custodian.custody do
          with inner := Custodian.custody do
            with Flaky.withThing True as t do
              print "held"
        print "not reached")
  print "nor this"

-- (a behaviour's work: a thing that fails to end, its failure its
-- custodian's, the one current as the behaviour was spawned)
thingOf : {e : HFunctor}
        -> {{cu : Custodian.custodian <: e}}
        -> {{io : stdio <: e}}
        -> {{fl : Flaky.flaky <: e}}
        -> String
        -> Co e Unit
thingOf name = do
  r <-
    attempt
      String
      (Flaky.withThing True (\t -> print (name ^ " held its thing")))
  print (name ^ " went on")

-- (two behaviours on one cown, the first spawned in a custodian of its
-- own; and a third after them, not reached where the second ends the
-- program)
inTurns : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> {{io : stdio <: e}}
        -> {{fl : Flaky.flaky <: e}}
        -> Co e Unit
inTurns = do
  c <- BOC.newCown 0
  with k := Custodian.contained do
    with n := c do
      thingOf "the contained"
  with n := c do
    thingOf "the root's"
  with n := c do
    print "not reached"

behaviours : Co
             (BOC.boc <+> Custodian.custodian <+> stdio <+> Flaky.flaky)
             Unit
behaviours = inTurns

-- (the server's part of the `i`th connection, behaviours: in a
-- custodian of its own, which contains its failures, the connection
-- accepted by an act into its custody, then its thing held by a cown past its `with`,
-- let go of by a behaviour, and the write after it)
servedAfter : {e : HFunctor}
            -> {s : Type}
            -> {{bc : BOC.boc <: e}}
            -> {{cu : Custodian.custodian <: e}}
            -> {{nt : Net.net <: e}}
            -> {{fl : Flaky.flaky <: e}}
            -> With s Net.TcpListener
            -> BOC.Cown (List String)
            -> BOC.Cown (List String)
            -> Int
            -> Co e Unit
servedAfter l log stops i = do
  with k := Custodian.contained do
    _ <-
      Custodian.manage k (logged stops ("custodian " ^ debug i ^ " shut down"))
    with r := BOC.await (Net.acceptedOwned l) do
      case r of
        Left err -> loggedAt log (2 * i - 2) ("not accepted: " ^ err.name)
        Right c -> do
          t <-
            attempt
              String
              (heldPast
                 (i == 2) (do
                   w <- Net.write c (Bytes.fromString ("served " ^ debug i))
                   case w of
                     Left err ->
                       loggedAt
                         log
                         (2 * i - 2)
                         ("connection " ^ debug i ^ ": " ^ err.name)
                     Right u ->
                       loggedAt
                         log
                         (2 * i - 2)
                         ("connection " ^ debug i ^ " written")))
          case t of
            Left why -> loggedAt log (2 * i - 2) ("thrown: " ^ why)
            Right u -> pure ()

-- (the client's part of the `i`th connection, an act: connected, what
-- comes read to its end)
asked : {e : HFunctor}
      -> {{cu : Custodian.custodian <: e}}
      -> {{nt : Net.net <: e}}
      -> Int
      -> Co e String
asked port = do
  r <-
    attempt
      Net.NetError
      (Net.withConnection (here port) (\cl -> drained cl Bytes.empty))
  pure (either (\(err : Net.NetError) -> "failed: " ^ err.name) (\got -> got) r)

-- (the connections from the `i`th on, one after another: each served
-- and asked, the next once its client has read to its end; after the
-- last, the listener closed)
connectedFrom : {e : HFunctor}
              -> {s : Type}
              -> {{bc : BOC.boc <: e}}
              -> {{cu : Custodian.custodian <: e}}
              -> {{nt : Net.net <: e}}
              -> {{fl : Flaky.flaky <: e}}
              -> With s Net.TcpListener
              -> Int
              -> BOC.Cown (List String)
              -> BOC.Cown (List String)
              -> Int
              -> Co e Unit
connectedFrom l port log stops i =
  if i > 3
  then do
    _ <- Net.closeListener l
    pure ()
  else do
    servedAfter l log stops i
    with got := BOC.await (asked port) do
      loggedAt log (2 * i - 1) ("client " ^ debug i ^ " read: " ^ got)
      connectedFrom l port log stops (i + 1)

connections : Co
              (BOC.boc
               <+> Custodian.custodian
               <+> stdio
               <+> Net.net
               <+> Flaky.flaky)
              Unit
connections = do
  log <- BOC.newCown Nil
  stops <- BOC.newCown Nil
  r <-
    Net.withListener (here 0) 16 (\l -> do
      a <- Net.local l
      case a of
        Left err -> print ("no port: " ^ err.name)
        Right at -> connectedFrom l at.port log stops 1)
  case r of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> said log stops 6 1
