-- A failed release cascades up the custodians, by C alone (std.net,
-- std.domain, cml, and flaky.hf's things, one of which fails to end).
-- Each `with` of a custodian is written in a world of its own, as a
-- program's `main` is.
--
--   main     a server with a custodian of its own for each connection,
--            one that contains its failures: the second connection's
--            thing, held by a domain past its `with`, fails to end as
--            that domain lets go of it; its custodian is shut down --
--            what it was given run, the one under it shut down too, its
--            connection closed, so the server's write on it fails and
--            its client reads nothing -- and the failure said, the
--            server going on to the third
--   rooted   a thing that fails to end, in the custody of a custodian
--            under another, in the same block, neither containing it:
--            the failure goes up through both to the root, the
--            program's, said, the program ended
--   threads  two cml threads, one spawned in a custodian that contains
--            its failures, the other not, taking turns: the first's
--            thing that fails to end takes its custodian down alone; the
--            other's, the root's still, ends the program
--   connections
--            a server in a cml thread, a custodian of its own for each
--            connection, one that contains its failures, the body
--            waiting on a channel for main's word while main runs: the
--            second's thing, held by a domain past its `with`, fails to
--            end, its custodian alone shut down -- its connection
--            closed, the server's write on it failing -- the others
--            served; the program's world names no custodian: the one in
--            the threads' world is the only one, the runtime's
--            custodians reached through the domains'
--   connectionsWith
--            the same, its threads a `with`'s
--   rootedWith
--            a `with`'s thread, its thing failing to end in the root's
--            custody: the program ended

module test.node.cascade

import bytes as Bytes
import cml as CML
import co
import custodian as Custodian
import exception
import std.domain as Domain
import std.io
import std.net as Net
import std.reactor as Reactor
import resource
import test.node.flaky as Flaky

here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (`what` put at the end of the log)
logged : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> Domain.Atomic (List String)
       -> String
       -> Co e Unit
logged log what = do
  ls <- Domain.get log
  Domain.set log (List.append ls [what])

-- (what comes on the connection, to its end)
drained : {e : HFunctor}
        -> {s : Type}
        -> {{nt : Net.net <: e}}
        -> With s Net.TcpStream
        -> Bytes
        -> Co e String
drained c got = do
  r <- Net.read (timeout := 5000) c 4096
  case r of
    Left err -> pure ("failed: " ^ err.name)
    Right b ->
      if Bytes.length b == 0 then pure (Bytes.asString got)
      else drained c (Bytes.append got b)

-- (a domain holding the thing until it is told to let go of it)
keeper : {w : HFunctor}
       -> {s : Type}
       -> {{dm : Domain.domain <: w}}
       -> With s Flaky.Thing
       -> Domain.Atomic Bool
       -> Co w Unit
keeper t go = do
  g <- Domain.get go
  if g then pure () else keeper t go

-- (the `i`th connection, by its client and the server: the server's in
-- a custodian of its own, which contains its failures, with one under
-- it; the connection's thing held by a domain past its `with`)
served : {e : HFunctor}
       -> {s : Type}
       -> {{cu : Custodian.custodian <: e}}
       -> {{dm : Domain.domain <: e}}
       -> {{nt : Net.net <: e}}
       -> {{fl : Flaky.flaky <: e}}
       -> {{nx : exception Net.NetError <: e}}
       -> {{sx : exception String <: e}}
       -> With s Net.TcpListener
       -> Int
       -> Domain.Atomic (List String)
       -> Int
       -> Co e Unit
served l port log i = do
  with Net.withConnection (here port) as cl do
    with k := Custodian.contained do
      _ <-
        Custodian.manage k (logged log ("custodian " ^ debug i ^ " shut down"))
      sub <- Custodian.make
      _ <-
        Custodian.manage
          sub
          (logged log ("the one under " ^ debug i ^ " shut down"))
      with Net.accept l as c do
        go <- Domain.newAtomic False
        with sc := Domain.scope do
          with Flaky.withThing (i == 2) as t do
            _ <- Domain.spawn sc (keeper t go)
            pure ()
          Domain.set go True
        w <- Net.write c (Bytes.fromString ("served " ^ debug i))
        case w of
          Left err -> logged log ("connection " ^ debug i ^ ": " ^ err.name)
          Right u -> logged log ("connection " ^ debug i ^ " written")
    got <- drained cl Bytes.empty
    logged log ("client " ^ debug i ^ " read: " ^ got)

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

listened : {e : HFunctor}
         -> {s : Type}
         -> {{cu : Custodian.custodian <: e}}
         -> {{io : stdio <: e}}
         -> {{dm : Domain.domain <: e}}
         -> {{nt : Net.net <: e}}
         -> {{fl : Flaky.flaky <: e}}
         -> Domain.Atomic (List String)
         -> With s Net.TcpListener
         -> Co e Unit
listened log l = do
  a <- Net.local l
  case a of
    Left err -> print ("no port: " ^ err.name)
    Right at -> do
      r <-
        attempt
          String
          (attempt
             Net.NetError (do
               served l at.port log 1
               served l at.port log 2
               served l at.port log 3))
      case r of
        Left why -> print ("thrown: " ^ why)
        Right (Left err) -> print ("thrown: " ^ err.name)
        Right (Right u) -> pure ()
      ls <- Domain.get log
      printed ls

main : Co
       (stdio
        <+> Net.net
        <+> Domain.domain
        <+> Flaky.flaky
        <+> Custodian.custodian)
       Unit
main = do
  log <- Domain.newAtomic (Nil : List String)
  r <- Net.withListener (here 0) 16 (listened log)
  case r of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> pure ()

rooted : Co
         (stdio
          <+> Net.net
          <+> Domain.domain
          <+> Flaky.flaky
          <+> Custodian.custodian)
         Unit
rooted = do
  r <-
    attempt
      String (do
        with outer := Custodian.custody do
          with inner := Custodian.custody do
            with Flaky.withThing True as t do
              print "held"
        print "not reached")
  print "nor this"

-- (a thread's thing, one that fails to end, after some turns: its
-- failure its custodian's, the one current as it was spawned)
thingAfter : {e w : HFunctor}
           -> {{cm : CML.cml w <: e}}
           -> {{cu : Custodian.custodian <: e}}
           -> {{io : stdio <: e}}
           -> {{fl : Flaky.flaky <: e}}
           -> String
           -> CML.Chan w Unit
           -> CML.Chan w Unit
           -> Co e Unit
thingAfter name go done = do
  CML.yield
  CML.recv go
  CML.yield
  r <-
    attempt
      String
      (Flaky.withThing True (\t -> print (name ^ " held its thing")))
  print (name ^ " went on")
  CML.send done ()

-- (two threads, the first spawned in a custodian of its own, each told
-- in turn to take its thing)
inTurns : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> {{io : stdio <: w}}
        -> {{fl : Flaky.flaky <: w}}
        -> Co e Unit
inTurns = do
  go1 <- CML.newChan
  go2 <- CML.newChan
  done <- CML.newChan
  with k := Custodian.contained do
    CML.spawn (thingAfter "the contained" go1 done)
  CML.spawn (thingAfter "the root's" go2 done)
  CML.send go1 ()
  CML.recv done
  CML.send go2 ()
  CML.recv done

threads : Co (stdio <+> Net.net <+> Domain.domain <+> Flaky.flaky) Unit
threads = do
  r <-
    CML.scheduled
      inTurns
  print "not reached"

-- (the `i`th connection, its server's part, in a cml thread: in a
-- custodian of its own, which contains its failures, the connection
-- accepted, then main's word waited for on `word` -- the body staying
-- in the thread, the other threads running -- and the connection's
-- thing held by a domain past its `with`; then main told, on `done`)
servedAfter : {e w : HFunctor}
            -> {s : Type}
            -> {{cm : CML.cml w <: e}}
            -> {{cu : Custodian.custodian <: e}}
            -> {{dm : Domain.domain <: e}}
            -> {{nt : Net.net <: e}}
            -> {{fl : Flaky.flaky <: e}}
            -> With s Net.TcpListener
            -> Domain.Atomic (List String)
            -> Domain.Atomic (List String)
            -> CML.Chan w Int
            -> CML.Chan w Unit
            -> Int
            -> Co e Unit
servedAfter l log stops word done i = do
  r <-
    attempt
      String
      (attempt
         Net.NetError (do
           with k := Custodian.contained do
             _ <-
               Custodian.manage
                 k
                 (logged stops ("custodian " ^ debug i ^ " shut down"))
             with Net.accept l as c do
               n <- CML.recv word
               go <- Domain.newAtomic False
               with sc := Domain.scope do
                 with Flaky.withThing (n == 2) as t do
                   _ <- Domain.spawn sc (keeper t go)
                   pure ()
                 Domain.set go True
               wr <- Net.write c (Bytes.fromString ("served " ^ debug n))
               case wr of
                 Left err ->
                   logged log ("connection " ^ debug n ^ ": " ^ err.name)
                 Right u -> logged log ("connection " ^ debug n ^ " written")))
  case r of
    Left why -> logged log ("thrown: " ^ why)
    Right (Left err) -> logged log ("thrown: " ^ err.name)
    Right (Right u) -> pure ()
  CML.send done ()

-- (the server: the connections, one after another)
serving : {e w : HFunctor}
        -> {s : Type}
        -> {{cm : CML.cml w <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{nt : Net.net <: e}}
        -> {{fl : Flaky.flaky <: e}}
        -> With s Net.TcpListener
        -> Domain.Atomic (List String)
        -> Domain.Atomic (List String)
        -> CML.Chan w Int
        -> CML.Chan w Unit
        -> Int
        -> Co e Unit
serving l log stops word done i =
  if i > 3 then pure ()
  else do
    servedAfter l log stops word done i
    serving l log stops word done (i + 1)

-- (main's part of the `i`th connection: connected, the word given, what
-- comes read, and the server's part waited for)
asked : {e w : HFunctor}
      -> {{cm : CML.cml w <: e}}
      -> {{cu : Custodian.custodian <: e}}
      -> {{dm : Domain.domain <: e}}
      -> {{nt : Net.net <: e}}
      -> Int
      -> Domain.Atomic (List String)
      -> CML.Chan w Int
      -> CML.Chan w Unit
      -> Int
      -> Co e Unit
asked port log word done i = do
  r <-
    attempt
      Net.NetError (do
        with Net.withConnection (here port) as cl do
          CML.send word i
          got <- drained cl Bytes.empty
          CML.recv done
          logged log ("client " ^ debug i ^ " read: " ^ got))
  case r of
    Left err -> logged log ("client " ^ debug i ^ ": " ^ err.name)
    Right u -> pure ()

-- (the server spawned, and main asking it three times)
connected : {e w : HFunctor}
          -> {s : Type}
          -> {{cm : CML.cml w <: e}}
          -> {{cu : Custodian.custodian <: e}}
          -> {{dm : Domain.domain <: e}}
          -> {{nt : Net.net <: e}}
          -> {{dw : Domain.domain <: w}}
          -> {{nw : Net.net <: w}}
          -> {{fw : Flaky.flaky <: w}}
          -> With s Net.TcpListener
          -> Int
          -> Domain.Atomic (List String)
          -> Domain.Atomic (List String)
          -> Co e Unit
connected l port log stops = do
  word <- CML.newChan
  done <- CML.newChan
  CML.spawn (serving l log stops word done 1)
  asked port log word done 1
  asked port log word done 2
  asked port log word done 3

connections : Co
              (stdio
               <+> Net.net
               <+> Domain.domain
               <+> Flaky.flaky
               <+> Reactor.reactor)
              Unit
connections = do
  log <- Domain.newAtomic (Nil : List String)
  stops <- Domain.newAtomic (Nil : List String)
  r <-
    Net.withListener (here 0) 16 (\l -> do
      a <- Net.local l
      case a of
        Left err -> print ("no port: " ^ err.name)
        Right at -> do
          m <-
            CML.scheduledWithReactor
              (connected
                 l
                 at.port
                 log
                 stops)
          case m of
            Just u -> pure ()
            Nothing -> print "every thread waiting")
  case r of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> pure ()
  ls <- Domain.get log
  printed ls
  ss <- Domain.get stops
  printed ss

-- (the listener, and the server spawned and asked, as `connected`)
listenedFor : {e w : HFunctor}
            -> {{cm : CML.cml w <: e}}
            -> {{cu : Custodian.custodian <: e}}
            -> {{io : stdio <: e}}
            -> {{dm : Domain.domain <: e}}
            -> {{nt : Net.net <: e}}
            -> {{dw : Domain.domain <: w}}
            -> {{nw : Net.net <: w}}
            -> {{fw : Flaky.flaky <: w}}
            -> Domain.Atomic (List String)
            -> Domain.Atomic (List String)
            -> Co e Unit
listenedFor log stops = do
  r <-
    Net.withListener (here 0) 16 (\l -> do
      a <- Net.local l
      case a of
        Left err -> print ("no port: " ^ err.name)
        Right at -> connected l at.port log stops)
  case r of
    Left err -> print ("not listening: " ^ err.name)
    Right u -> pure ()

-- (as `connections`, the threads started by a `with`)
connectionsWith : Co
                  (stdio
                   <+> Net.net
                   <+> Domain.domain
                   <+> Flaky.flaky
                   <+> Reactor.reactor)
                  Unit
connectionsWith = do
  log <- Domain.newAtomic (Nil : List String)
  stops <- Domain.newAtomic (Nil : List String)
  m <-
    with _ := CML.threadsWithReactor do
      listenedFor
          log
          stops
  case m of
    Just u -> pure ()
    Nothing -> print "every thread waiting"
  ls <- Domain.get log
  printed ls
  ss <- Domain.get stops
  printed ss

-- (the threads started by a `with`: a thing that fails to end, in no
-- custodian's custody but the root's, ends the program)
rootedWith : Co (stdio <+> Net.net <+> Domain.domain <+> Flaky.flaky) Unit
rootedWith = do
  r <-
    with _ := CML.threads do
      attempt
        String (Flaky.withThing True (\t -> print "held"))
  print "not reached"
