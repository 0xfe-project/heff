-- What the domains' tests run, on every backend: the same program, by
-- std.domain alone, on the C backend's threads (test/node/domains.hf)
-- and in JavaScript's one domain (test/apps/domains.hf), the same
-- lines said.  A counter several domains add to by `fetchAdd`; one they
-- add to by a `cas` retried, and a list they push onto so, compared by
-- identity; values handed over under a mutex, waited for on a
-- condition; answers joined; many cells, mutexes and conditions made
-- and let go of at once, and domains never joined; lists handed through
-- a queue, taken by domains waiting at it, in the order put.

module test.node.domains-program

import co
import std.domain as Domain

-- (domains `i` to `n - 1`, each running `c` of its number)
spawnedFrom : {e : HFunctor}
            -> {a : Type}
            -> {{dm : Domain.domain <: e}}
            -> Int
            -> Int
            -> (Int -> Co e a)
            -> Co e (List (Domain.Domain a))
spawnedFrom i n c =
  if i >= n then pure Nil
  else do
    d <- Domain.spawn (c i)
    rest <- spawnedFrom (i + 1) n c
    pure (d :: rest)

-- (`n` domains, each running `c i`, `i` its number from 0)
spawned : {e : HFunctor}
        -> {a : Type}
        -> {{dm : Domain.domain <: e}}
        -> Int
        -> (Int -> Co e a)
        -> Co e (List (Domain.Domain a))
spawned n c = spawnedFrom 0 n c

joined : {e : HFunctor}
       -> {a : Type}
       -> {{dm : Domain.domain <: e}}
       -> List (Domain.Domain a)
       -> Co e (List a)
joined Nil = pure Nil
joined (d :: ds) = do
  v <- Domain.join d
  vs <- joined ds
  pure (v :: vs)

-- A counter, by fetchAdd ---------------------------------------------------------------

adding : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> Domain.Atomic Int
       -> Int
       -> Co e Unit
adding counter 0 = pure ()
adding counter k = do
  _ <- Domain.fetchAdd counter 1
  adding counter (k - 1)

-- | 4 domains adding 1 each 100000 times
counted : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
counted = do
  counter <- Domain.newAtomic 0
  ds <- spawned 4 (\i -> adding counter 100000)
  _ <- joined ds
  Domain.get counter

-- By cas, retried ----------------------------------------------------------------------

-- (1 added by a cas, again until no other domain came between; how many
-- tries it took)
bumped : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> Domain.Atomic Int
       -> Co e Int
bumped counter = do
  v <- Domain.get counter
  ok <- Domain.cas counter v (v + 1)
  if ok then pure 1
  else do
    n <- bumped counter
    pure (n + 1)

bumping : {e : HFunctor}
        -> {{dm : Domain.domain <: e}}
        -> Domain.Atomic Int
        -> Int
        -> Co e Unit
bumping counter 0 = pure ()
bumping counter k = do
  _ <- bumped counter
  bumping counter (k - 1)

-- | 4 domains adding 1 each 50000 times, by cas
casCounted : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
casCounted = do
  counter <- Domain.newAtomic 0
  ds <- spawned 4 (\i -> bumping counter 50000)
  _ <- joined ds
  Domain.get counter

-- (`x` pushed onto the list the cell holds, by a cas of the list read:
-- compared by identity, an equal list built again would not do)
pushed : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> Domain.Atomic (List Int)
       -> Int
       -> Co e Unit
pushed stack x = do
  xs <- Domain.get stack
  ok <- Domain.cas stack xs (x :: xs)
  if ok then pure () else pushed stack x

pushing : {e : HFunctor}
        -> {{dm : Domain.domain <: e}}
        -> Domain.Atomic (List Int)
        -> Int
        -> Int
        -> Co e Unit
pushing stack i 0 = pure ()
pushing stack i k = do
  pushed stack (i * 1000 + k)
  pushing stack i (k - 1)

-- | 4 domains pushing 1000 each: how many, and their sum
stacked : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (Int, Int)
stacked = do
  stack <- Domain.newAtomic Nil
  ds <- spawned 4 (\i -> pushing stack i 1000)
  _ <- joined ds
  xs <- Domain.get stack
  pure (List.length xs, List.sum xs)

-- | a cas of a value equal to the one held, but not it, fails
notTheSame : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Bool
notTheSame = do
  cell <- Domain.newAtomic [1, 2, 3]
  Domain.cas cell (List.map (\x -> x + 0) [1, 2, 3]) [4]

-- Handed over under a mutex ------------------------------------------------------------

-- (the values given, waited for until there are `n`, the mutex held)
awaited : {e : HFunctor}
        -> {{dm : Domain.domain <: e}}
        -> Domain.Mutex
        -> Domain.Condition
        -> Domain.Atomic (List Int)
        -> Int
        -> Co e (List Int)
awaited mu cd box n = do
  xs <- Domain.get box
  if List.length xs >= n then pure xs
  else do
    Domain.wait cd mu
    awaited mu cd box n

-- (`x` given: put in the box, the mutex held, and the waiter woken)
given : {e : HFunctor}
      -> {{dm : Domain.domain <: e}}
      -> Domain.Mutex
      -> Domain.Condition
      -> Domain.Atomic (List Int)
      -> Int
      -> Co e Unit
given mu cd box x = do
  Domain.lock mu
  xs <- Domain.get box
  Domain.set box (x :: xs)
  Domain.signal cd
  Domain.unlock mu

-- | 6 domains each giving its square; the sum, once all are given
handed : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
handed = do
  mu <- Domain.newMutex
  cd <- Domain.newCondition
  box <- Domain.newAtomic Nil
  ds <- spawned 6 (\i -> given mu cd box (i * i))
  Domain.lock mu
  xs <- awaited mu cd box 6
  Domain.unlock mu
  _ <- joined ds
  pure (List.sum xs)

-- Waiting on one another ------------------------------------------------------------

-- (read again until the cell holds True: a domain waiting so, by its
-- reads alone, lets another set it)
spun : {e : HFunctor}
     -> {{dm : Domain.domain <: e}}
     -> Domain.Atomic Bool
     -> Co e Unit
spun flag = do
  b <- Domain.get flag
  if b then pure () else spun flag

-- | a domain sets a flag main reads again and again until it is set
spinning : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Bool
spinning = do
  flag <- Domain.newAtomic False
  d <- Domain.spawn (Domain.set flag True)
  spun flag
  Domain.join d
  pure True

-- | a mutex main holds, a domain spawned then locking it: it waits
-- | until main lets go, and adds once
parentFirst : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
parentFirst = do
  mu <- Domain.newMutex
  box <- Domain.newAtomic 0
  Domain.lock mu
  d <-
    Domain.spawn (do
    Domain.lock mu
    _ <- Domain.fetchAdd box 1
    Domain.unlock mu)
  Domain.unlock mu
  Domain.join d
  Domain.get box

-- Through a queue --------------------------------------------------------------------

-- (`k` lists put, each of `i * 1000 + k` down to `i * 1000 + 1`, a fresh
-- list of `k` cells: what the putter holds alone, so moved)
putting : {e : HFunctor}
        -> {{dm : Domain.domain <: e}}
        -> Domain.Queue (List Int)
        -> Int
        -> Int
        -> Co e Unit
putting q i 0 = pure ()
putting q i k = do
  Domain.put q (List.map (\j -> i * 1000 + j) (List.range 1 k))
  putting q i (k - 1)

-- (`k` lists taken, waiting for each: how many cells, and their heads'
-- sum)
taking : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> Domain.Queue (List Int)
       -> Int
       -> (Int, Int)
       -> Co e (Int, Int)
taking q 0 acc = pure acc
taking q k (MkPair cells heads) = do
  xs <- Domain.take q
  case xs of
    x :: rest -> taking q (k - 1) (MkPair (cells + List.length xs) (heads + x))
    Nil -> taking q (k - 1) (MkPair cells heads)

-- | 4 domains putting 1000 lists each, 2 taking 2000 each, waiting
-- | while the queue is empty: the cells taken, and the heads' sum
queued : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (Int, Int)
queued = do
  q <- Domain.newQueue
  takers <- spawned 2 (\i -> taking q 2000 (MkPair 0 0))
  putters <- spawned 4 (\i -> putting q i 1000)
  _ <- joined putters
  taken <- joined takers
  pure
      ( List.sum (List.map fst taken)
      , List.sum (List.map snd taken)
      )

-- (`k` to 1 put, one after another)
counting : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> Domain.Queue Int
         -> Int
         -> Int
         -> Co e Unit
counting q i n = if i > n then pure () else do
  Domain.put q i
  counting q (i + 1) n

-- (`k` taken, as they come)
takenAll : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> Domain.Queue Int
         -> Int
         -> Co e (List Int)
takenAll q 0 = pure Nil
takenAll q k = do
  x <- Domain.take q
  xs <- takenAll q (k - 1)
  pure (x :: xs)

-- | one domain putting 1 to 5, main taking them: in the order put
inOrder : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (List Int)
inOrder = do
  q <- Domain.newQueue
  d <- Domain.spawn (counting q 1 5)
  xs <- takenAll q 5
  Domain.join d
  pure xs

-- Let go of ---------------------------------------------------------------------------

-- (`k` more cells, mutexes, conditions and queues made, a list left in
-- each queue, each let go of at once -- freed with its last reference,
-- or the memory grows with them; `n` counted up by what each cell held)
letGoOf : {e : HFunctor}
        -> {{dm : Domain.domain <: e}}
        -> Int
        -> Int
        -> Co e Int
letGoOf 0 n = pure n
letGoOf k n = do
  cell <- Domain.newAtomic [k]
  _ <- Domain.newMutex
  _ <- Domain.newCondition
  q <- Domain.newQueue
  Domain.put q ([k, k] : List Int)
  held <- Domain.get cell
  letGoOf (k - 1) (n + List.length held)

-- (`k` domains spawned and never joined, their handles let go of while
-- they may still run: each freed by the later of its end and the drop)
unjoined : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Int -> Co e Unit
unjoined 0 = pure ()
unjoined k = do
  _ <- Domain.spawn (pure k)
  unjoined (k - 1)

-- | 100000 cells, mutexes, conditions and queues made and let go of; 20
-- | domains never joined
letGo : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
letGo = do
  unjoined 20
  letGoOf 100000 0

-- The lines ---------------------------------------------------------------------------

-- | what the program says, line by line
said : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (List String)
said = do
  n <- counted
  c <- casCounted
  s <- stacked
  b <- notTheSame
  h <- handed
  answers <- spawned 3 (\i -> pure (debug i ^ "!"))
  ws <- joined answers
  sp <- spinning
  pf <- parentFirst
  qd <- queued
  io <- inOrder
  lg <- letGo
  k <- Domain.cores
  pure
      [ "fetchAdd by 4: " ^ debug n
      , "cas by 4: " ^ debug c
      , "pushed by 4: " ^ debug (fst s) ^ ", their sum " ^ debug (snd s)
      , "an equal list, not the same: " ^ (if b then "swapped" else "kept")
      , "handed over by 6: " ^ debug h
      , "answers: " ^ unwords ws
      , "a flag read until set: " ^ (if sp then "set" else "not set")
      , "locked after main let go: " ^ debug pf
      , "through a queue by 4, taken by 2: " ^ debug (fst qd) ^ " cells, heads " ^ debug (snd qd)
      , "in the order put: " ^ unwords (List.map debug io)
      , "made and let go of: " ^ debug lg
      , "cores: " ^ (if k >= 1 then "at least one" else "none")
      ]
