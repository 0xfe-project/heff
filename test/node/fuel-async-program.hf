-- What the asynchronous fuel tests run, on every backend, built with
-- fuel: a limit across an operation that finishes later -- a sleep --
-- and across a behaviour of boc's spawned, the limit the computation's
-- on both, so a pure loop after them is stopped by its own count, as
-- before them; a behaviour spawned in a limit has none
-- (on C, a thread of the pool's, a thread's fuel its own): the least fuel a loop after a sleep finishes on is its rounds, a
-- batch (`Fuel.batchMost`) and what the sleep and the effects' plumbing
-- take (a few ticks, not the same on each backend, whose worlds differ:
-- the page's and the terminal's) -- on C (test/node/fuel-async.hf) and in
-- JavaScript (test/apps/fuel-async.hf), the same lines said.

module test.node.fuel-async-program

import bench as Bench
import boc as BOC
import co
import std.duration as Duration
import std.fuel as Fuel
import std.time as Time

-- (a loop of no operation, never ending)
spin : Int -> Int
spin n = spin (n + 1)

-- (a loop counting `n` rounds)
count : Int -> Int -> Int
count n acc = if n <= 0 then acc else count (n - 1) (acc + 1)

-- (`1 + ... + n`, by a loop)
sumTo : Int -> Int -> Int
sumTo n acc = if n <= 0 then acc else sumTo (n - 1) (acc + n)

-- (what a limit came to)
said : Maybe Int -> String
said (Just x) = "Just " ^ debug x
said Nothing = "Nothing"

-- (a sleep, then a loop of `n` rounds)
afterSleep : {e : HFunctor} -> {{tm : Time.time <: e}} -> Int -> Co e Int
afterSleep n = do
  Time.sleep (Duration.milliseconds 1)
  later (\u -> count (Bench.keep n) 0)

-- (fuel enough for `c`: `n`, doubled until it is)
enough : {e : HFunctor}
       -> {a : Type}
       -> {{fl : Fuel.fuel <: e}}
       -> Co e a
       -> Int
       -> Co e Int
enough c n = do
  r <- Fuel.limited n c
  case r of
    Just _ -> pure n
    Nothing -> enough c (n * 2)

-- (the least fuel `c` finishes on, above `lo` up to `hi`)
leastIn : {e : HFunctor}
        -> {a : Type}
        -> {{fl : Fuel.fuel <: e}}
        -> Co e a
        -> Int
        -> Int
        -> Co e Int
leastIn c lo hi =
  if hi - lo <= 1 then pure hi
  else do
    r <- Fuel.limited ((lo + hi) / 2) c
    case r of
      Just _ -> leastIn c lo ((lo + hi) / 2)
      Nothing -> leastIn c ((lo + hi) / 2) hi

-- (a behaviour on `c`, spawned)
behaved : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> BOC.Cown Int
        -> (Int -> Int)
        -> Co e Unit
behaved c f = do
  with n := c do
    n := f n

-- | the lines said, given to `k` by a behaviour on the cown summed,
-- | after the one summing
lines : {e : HFunctor}
      -> {{tm : Time.time <: e}}
      -> {{fl : Fuel.fuel <: e}}
      -> {{bc : BOC.boc <: e}}
      -> (List String -> Co e Unit)
      -> Co e Unit
lines k = do
  slept <-
    Fuel.limited 100000 (do
      Time.sleep (Duration.milliseconds 1)
      later (\u -> spin 0))
  sleptWithin <- Fuel.limited 100000 (afterSleep 1000)
  turned <- BOC.newCown 0
  afterTurn <-
    Fuel.limited 100000 (do
      behaved turned (\n -> n + 1)
      later (\u -> spin 0))
  summed <- BOC.newCown 0
  spawned <- Fuel.limited 1000 (behaved summed (\n -> sumTo 1000000 0))
  hi <- enough (afterSleep 5000) 1
  n <- leastIn (afterSleep 5000) 0 hi
  BOC.when summed (\sum -> do
    k
        [ "a pure loop after a sleep: " ^ said slept
        , "a loop after a sleep within its fuel: " ^ said sleptWithin
        , "a pure loop after a behaviour spawned: " ^ said afterTurn
        , "a behaviour spawned in a limit, with none: "
        ^ said (maybe Nothing (\u -> Just sum) spawned)
        , "the least fuel of a loop after a sleep: "
        ^ (if n >= 5000 && n <= 5000 + Fuel.batchMost + 32
           then "near its rounds"
           else debug n ^ " for 5000 rounds")
        ]
    pure sum)
