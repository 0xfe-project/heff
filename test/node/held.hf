-- `held`'s `with`s: the release kept by the program's top level while
-- the block runs.  By C alone.
--
--   main     a port of the standard output written by a `with` and
--            closed as it ends, std.io's printing going on after; a
--            release run once as its block is left; and one whose block
--            a throw left, heard outside it, run by the runtime at the
--            next operation; and one a behaviour's body left by a
--            throw, there being no operation after it in the body, run
--            by its worker before its `scheduled` comes to its value

module test.node.held

import boc as BOC
import co
import custodian
import exception
import resource
import std.file as File
import std.filesystem
import std.io

-- (a `with` whose release says so)
said : {e : HFunctor}
     -> {a : Type}
     -> {{io : stdio <: e}}
     -> {{cu : custodian <: e}}
     -> String
     -> ({s : Type} -> With s Int -> Co e a)
     -> Co e a
said what body = held (pure 1) (\x -> print ("released: " ^ what)) body

left : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{cu : custodian <: e}}
     -> {{ex : exception String <: e}}
     -> Co e Unit
left = said "left by a throw" (\h -> throw "thrown")

-- (a behaviour whose body's `with` a throw left, heard in the body,
-- its release then due on the worker, with no operation after; then
-- its `scheduled` done)
behaved : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
behaved = do
  BOC.scheduled
      (\why -> print ("failed: " ^ why)) (do
        c <- BOC.newCown 0
        with n := c do
          t <-
            attempt
              String
              (said
                 "in a behaviour, left by a throw"
                 (\h -> (throw "thrown" : Co (exception String <+> e) Unit)))
          n := n + 1)
  print "after the behaviour's scheduled"

main : Co (BOC.boc <+> stdio <+> filesystem <+> custodian) Unit
main = do
  r <-
    attempt
      FileError
      (File.withStdout
         (ev := _)
         (cu := _)
         (\o -> File.writeString (ev := _) (ex := _) o "written by a port\n"))
  print (ev := _) "printed after the port closed"
  said (io := _) (cu := _) "once" (\h -> print (ev := _) "in the block")
  t <- attempt String (left (io := _) (cu := _) (ex := _))
  print (ev := _) "after the attempt"
  print (ev := _) (case t of
    Left m -> "heard: " ^ m
    Right u -> "not thrown")
  behaved
