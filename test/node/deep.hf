-- Loops a million rounds deep, compiled: a call of
-- itself last goes round again (`count`, `foldl`), and so does one that is
-- a constructor's last argument (`upto`, `map`, `keepIf`, `concatList`);
-- functions calling one another last, round a cycle, are one loop
-- (`evenOf`, `tick`: in C, workers taking their numbers unboxed, #39;
-- `walk`, `turn`, of other arities, #78); a `do` block's loops (#86), a
-- `while` in `Co` printing as it goes and a `run do` `for` with `break`,
-- each a local function calling itself last; and a `while` whose turns
-- each go through a `try ... catch` (#100), left by its end, by
-- `continue` or by a throw its `catch` arm hears, a scope each turn that
-- is done with before the next.

module test.node.deep

import co
import exception
import int64 as Int64
import std.io
import uint64 as UInt64

upto : Int -> List Int
upto n = if n == 0 then Nil else n :: upto (n - 1)

count : Int -> Int -> Int
count n acc = if n == 0 then acc else count (n - 1) (acc + 1)

-- (what is made in a round keeps that round's `n`)
adders : Int -> List (Int -> Int) -> List (Int -> Int)
adders n acc = if n == 0 then acc else adders (n - 1) ((\x -> x + n) :: acc)

apply0 : (Int -> Int) -> Int
apply0 f = f 0

-- (two workers of one signature, round a cycle)
evenOf : Int64 -> Int64 -> Int64
evenOf n acc =
  if n == 0 then acc
  else if n % 3 == 0 then oddOf (n - 1) (xor acc (n * 3))
  else if n % 3 == 1 then oddOf (n - 1) (acc + n)
  else oddOf (n - 1) (acc - shiftR n 2)
  where
  oddOf : Int64 -> Int64 -> Int64
  oddOf m a =
    if m == 0 then 0 - a
    else if m % 3 == 0 then evenOf (m - 1) (a + shiftR m 1)
    else if m % 3 == 1 then evenOf (m - 1) (xor a m)
    else evenOf (m - 1) (a * 3)

-- (round a cycle, one taking a number unboxed where the other keeps it
-- in a list: one signature for both, the number a `V`)
tick : UInt64 -> Int -> List UInt64 -> String
tick x n seen =
  if n == 0 then debug (List.foldl (\s y -> s + y) 0 seen)
  else if n % 7 == 3 then tock (x * 6364136223846793005 + 1) (n - 1) seen
  else if n % 7 == 4 then tock (x * 3 + 7) (n - 1) seen
  else if n % 7 == 5 then tock (xor x (shiftR x 3)) (n - 1) seen
  else tock (x + 11) (n - 1) seen
  where
  tock : UInt64 -> Int -> List UInt64 -> String
  tock y m ys =
    if m == 0 then "tock " ^ debug y
    else if m % 5 == 1
    then tick y (m - 1) (if m % 100000 == 1 then y :: y + 1 :: ys else ys)
    else if m % 5 == 2
    then tick y (m - 1) (if m % 100000 == 2 then y :: ys else ys)
    else tick y (m - 1) ys

-- (of other arities, each too big to be inlined)
walk : Int64 -> Int64
walk n =
  if n == 0 then 0
  else if n % 3 == 0 then walkOn (n - 1) (n * 3 + 1)
  else if n % 3 == 1 then walkOn (n - 1) (n * 5 + 2)
  else if n % 7 == 2 then walkOn (n - 1) (n * 7 + 3)
  else if n % 11 == 3 then walkOn (n - 1) (n * 11 + 4)
  else if n % 13 == 4 then walkOn (n - 1) (n * 13 + 5)
  else walkOn (n - 1) (n + 6)
  where
  walkOn : Int64 -> Int64 -> Int64
  walkOn m k =
    if m == 0 then k
    else if k % 3 == 0 then walk (m - 1)
    else if k % 5 == 1 then walk (m - 1)
    else if k % 7 == 2 then walk (m - 1)
    else if k % 11 == 3 then walk (m - 1)
    else if k % 13 == 4 then walk (m - 1)
    else walk (m - 1)

-- (three, of arities 1, 2 and 3, a list and a float among what they take)
turn : Int -> Int
turn n =
  if n == 0 then 0
  else if n % 3 == 0 then turnTo (n - 1) [n]
  else if n % 5 == 0 then turnTo (n - 1) [n, n]
  else if n % 7 == 0 then turnTo (n - 1) Nil
  else if n % 11 == 0 then turnTo (n - 1) [11]
  else if n % 13 == 0 then turnTo (n - 1) [13]
  else turnTo (n - 1) [1]
  where
  turnBy : Int -> List Int -> Float64 -> Int
  turnBy p xs x =
    if p == 0 then List.length xs
    else if x > 3.0 then turn (p - 1)
    else if x > 2.0 then turn (p - 1)
    else if x > 1.0 then turn (p - 1)
    else if x > 0.5 then turn (p - 1)
    else turn (p - 1)
  turnTo : Int -> List Int -> Int
  turnTo m xs =
    if m == 0 then List.length xs
    else if m % 3 == 0 then turnBy (m - 1) xs 0.25
    else if m % 5 == 0 then turnBy (m - 1) xs 1.5
    else if m % 7 == 0 then turnBy (m - 1) xs 2.5
    else if m % 11 == 0 then turnBy (m - 1) xs 3.5
    else turnBy (m - 1) xs 0.75

-- (a `while` in `Co`: each turn through `bind`, a print every 250000th)
counted : {{io : stdio <: stdio}} -> Int -> Co stdio Int
counted n = do
  let mut i = 0
  let mut hits = 0
  while i < n do
    i := i + 1
    if i % 250000 == 0 then print ("turn " ^ debug i)
    hits := hits + 1
  return hits

-- (a `for` over a range in pure code, `continue` and `break`)
evensBelow : Int -> Int
evensBelow n = run do
  let mut total = 0
  for i in range 1 n do
    if i % 2 /= 0 then continue
    if i > n - 2 then break
    total := total + i
  return total

-- (a `try ... catch` each turn, `continue` leaving it, or a throw: then
-- the next turn, a tail call)
scopedTurns : {e : HFunctor}
            -> {{ex : exception String <: e}}
            -> {{io : stdio <: e}}
            -> Int
            -> Co e Int
scopedTurns n = do
  let mut i = 0
  let mut hits = 0
  while i < n do
    i := i + 1
    try
      if i % 250000 == 0 then (throw ("left " ^ debug i) : Co e Unit)
      if i % 2 == 0 then continue
      hits := hits + 1
    catch (s : String) ->
      print s
  return hits

showAll : List Int -> String
showAll [] = ""
showAll [x] = debug x
showAll (x :: xs) = debug x ^ "," ^ showAll xs

program : {{io : stdio <: stdio}} -> Co stdio Unit
program = do
  print (debug (count 1000000 0))
  print (debug (List.length (upto 1000000)))
  print (debug (List.length (List.map (\x -> x * 2) (upto 1000000))))
  print (debug (List.length (List.keepIf (\x -> x % 2 == 0) (upto 1000000))))
  print (debug (List.length (List.append (upto 500000) (upto 500000))))
  print (showAll (List.map (\x -> x * 2) (upto 3)))
  print (showAll (List.map apply0 (adders 3 Nil)))
  print (debug (evenOf 1000000 7))
  print (tick 1 1000000 Nil)
  print (debug (walk 1000000))
  print (debug (turn 1000000))
  hits <- counted 1000000
  print (debug hits)
  print (debug (evensBelow 1000000))
  turns <-
    attempt
      String
      (scopedTurns
         (ex := _)
         (io := _)
         1000000)
  print (either (\s -> "thrown " ^ s) (\h -> debug h) turns)

deep : Co stdio Unit
deep = program (io := _)
