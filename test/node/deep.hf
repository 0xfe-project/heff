-- Loops a million rounds deep, compiled (test/node-run.mjs): a call of
-- itself last goes round again (`count`, `foldl`), and so does one that is
-- a constructor's last argument (`upto`, `map`, `filter`, `concatList`).

import co
import stdio
import prelude

upto : Int -> List Int
upto n = if n == 0 then Nil else Cons n (upto (n - 1))

count : Int -> Int -> Int
count n acc = if n == 0 then acc else count (n - 1) (acc + 1)

-- (what is made in a round keeps that round's `n`)
adders : Int -> List (Int -> Int) -> List (Int -> Int)
adders n acc = if n == 0 then acc else adders (n - 1) (Cons (\x -> x + n) acc)

apply0 : (Int -> Int) -> Int
apply0 f = f 0

showAll : List Int -> String
showAll Nil = ""
showAll (Cons x Nil) = showInt x
showAll (Cons x xs) = showInt x ++ "," ++ showAll xs

program : {{io : stdio <: stdio}} -> Co stdio Unit
program = do
  print (showInt (count 1000000 0))
  print (showInt (length (upto 1000000)))
  print (showInt (length (map (\x -> x * 2) (upto 1000000))))
  print (showInt (length (filter (\x -> x % 2 == 0) (upto 1000000))))
  print (showInt (length (concatList (upto 500000) (upto 500000))))
  print (showAll (map (\x -> x * 2) (upto 3)))
  print (showAll (map apply0 (adders 3 Nil)))

deep : Co stdio Unit
deep = program (io := here stdio)
