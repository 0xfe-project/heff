-- Loops a million rounds deep, compiled (test/backends.mjs): a call of
-- itself last goes round again (`count`, `foldl`), and so does one that is
-- a constructor's last argument (`upto`, `map`, `filter`, `concatList`);
-- functions calling one another last, round a cycle, jump (`evenOf`,
-- `tick`: in C, workers taking their numbers unboxed, #39).

import co
import int64 as Int64
import std.io
import uint64 as UInt64

upto : Int -> List Int
upto n = if n == 0 then Nil else Cons n (upto (n - 1))

count : Int -> Int -> Int
count n acc = if n == 0 then acc else count (n - 1) (acc + 1)

-- (what is made in a round keeps that round's `n`)
adders : Int -> List (Int -> Int) -> List (Int -> Int)
adders n acc = if n == 0 then acc else adders (n - 1) (Cons (\x -> x + n) acc)

apply0 : (Int -> Int) -> Int
apply0 f = f 0

-- (two workers of one signature, round a cycle)
evenOf : Int64 -> Int64 -> Int64
evenOf n acc =
  if n == 0 then acc
  else if n % 3 == 0 then oddOf (n - 1) (xor acc (n * 3))
  else if n % 3 == 1 then oddOf (n - 1) (acc + n)
  else oddOf (n - 1) (acc - shiftR n 2)
  where
    oddOf : Int64 -> Int64 -> Int64
    oddOf m a =
      if m == 0 then 0 - a
      else if m % 3 == 0 then evenOf (m - 1) (a + shiftR m 1)
      else if m % 3 == 1 then evenOf (m - 1) (xor a m)
      else evenOf (m - 1) (a * 3)

-- (round a cycle, one taking a number unboxed where the other keeps it
-- in a list: one signature for both, the number a `V`)
tick : UInt64 -> Int -> List UInt64 -> String
tick x n seen =
  if n == 0 then show (List.foldl (\s y -> s + y) 0 seen)
  else if n % 7 == 3 then tock (x * 6364136223846793005 + 1) (n - 1) seen
  else if n % 7 == 4 then tock (x * 3 + 7) (n - 1) seen
  else if n % 7 == 5 then tock (xor x (shiftR x 3)) (n - 1) seen
  else tock (x + 11) (n - 1) seen
  where
    tock : UInt64 -> Int -> List UInt64 -> String
    tock y m ys =
      if m == 0 then "tock " ^ show y
      else if m % 5 == 1
        then tick y (m - 1) (if m % 100000 == 1 then y :: y + 1 :: ys else ys)
      else if m % 5 == 2
        then tick y (m - 1) (if m % 100000 == 2 then y :: ys else ys)
      else tick y (m - 1) ys

showAll : List Int -> String
showAll Nil = ""
showAll (Cons x Nil) = show x
showAll (Cons x xs) = show x ^ "," ^ showAll xs

program : {{io : stdio <: stdio}} -> Co stdio Unit
program = do
  print (show (count 1000000 0))
  print (show (List.length (upto 1000000)))
  print (show (List.length (List.map (\x -> x * 2) (upto 1000000))))
  print (show (List.length (List.filter (\x -> x % 2 == 0) (upto 1000000))))
  print (show (List.length (List.append (upto 500000) (upto 500000))))
  print (showAll (List.map (\x -> x * 2) (upto 3)))
  print (showAll (List.map apply0 (adders 3 Nil)))
  print (show (evenOf 1000000 7))
  print (tick 1 1000000 Nil)

deep : Co stdio Unit
deep = program (io := here stdio)
