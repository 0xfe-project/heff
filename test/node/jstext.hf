-- A world whose operations take and give JavaScript's strings (std.js),
-- for test/backends.mjs, by each backend: jstext.provider.js is given a
-- `JSString` field as the JavaScript string it is, through no helper,
-- and gives one back as it is -- its length the UTF-16 code units of the
-- text, not its bytes; jstext.provider.c is given the string of UTF-8
-- that a `JSString` is there, and says the same.

import co
import std.io
import std.js

data JsTextF (m : Type -> Type) x
  = Units JSString (Int -> x)
  | Echo JSString (JSString -> x)

jstext : HFunctor
jstext =
  { f = JsTextF
  , hfmap = \m g p -> case p of
      Units t k -> Units t (\n -> g (k n))
      Echo t k -> Echo t (\u -> g (k u))
  , hmap = \m n nt p -> case p of
      Units t k -> Units t k
      Echo t k -> Echo t k
  }

-- | how many UTF-16 code units the text is, as JavaScript's `length`
units : {e : HFunctor} -> {{ev : jstext <: e}} -> JSString -> Co e Int
units t = op (ev (Units t (\n -> n))) val

-- | the text, given to the provider and back, as it is
echo : {e : HFunctor} -> {{ev : jstext <: e}} -> JSString -> Co e JSString
echo t = op (ev (Echo t (\u -> u))) val

world : HFunctor
world = stdio <+> jstext

-- (a string, its bytes, the code units of its text, and its text back)
said : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{js : jstext <: e}}
     -> String
     -> Co e Unit
said s = do
  n <- units (toJS s)
  u <- echo (toJS s)
  print
      (showInt (strLength s)
       ^ " bytes, "
       ^ showInt n
       ^ " code units: "
       ^ fromJS u)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{js : jstext <: e}}
        -> Co e Unit
program = do
  said "plain"
  said "é😀a"
  said ("x" ^ fromByte 255 ^ "y")

main : Co world Unit
main = program (io := \p -> InL p) (js := \p -> InR p)
