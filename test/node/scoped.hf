-- A `do` block's `try ... finally`, a scope of the world's (the scope
-- module's, its C provider): released at its end, by a throw of either
-- of two types no `catch` in it hears, by a handler between that drops
-- the continuation (one of the test's own), by a jump; nested, the
-- innermost first; each turn of a loop; in green threads taking turns,
-- each its own; and a thread never resumed, as the scheduler drops it.

import co
import exception
import green
import scope
import std.io

-- (a handler that gives up: `stop` drops the continuation, the answer
-- `Nothing`)
data StopF (m : Type -> Type) x = Stop

stopping : HFunctor
stopping =
  { f = StopF
  , hfmap = \m g p -> case p of
      Stop -> Stop
  , hmap = \m n nt p -> case p of
      Stop -> Stop
  }

stop : {e : HFunctor} -> {{ev : stopping <: e}} -> {a : Type} -> Co e a
stop = op (ev Stop) val

justOr : {e : HFunctor} -> {a : Type} -> Maybe a -> Co e a
justOr (Just x) = val x
justOr Nothing = abandon

maybeFunctor : (e : HFunctor) -> RawFunctor
maybeFunctor e =
  { f = \x -> Co e (Maybe x)
  , fmap = \g m -> bind m (\r -> val (maybe Nothing (\x -> Just (g x)) r))
  }

stopped : (e : HFunctor) -> {a : Type} -> Co (stopping <+> e) a -> Co e (Maybe a)
stopped e c =
  handle
    { M = \x -> Co e (Maybe x)
    , ret = \x -> val (Just x)
    , bind = \m k -> bind m (\r -> maybe (val Nothing) k r)
    , malg = \p -> case p of
        InL t -> val Nothing
        InR q ->
          op
            (e.hmap (maybeFunctor e) (coFunctor e) (\m -> bind m (\r -> justOr r)) q)
            (\x -> val (Just x))
    }
    c

world : HFunctor
world = stdio <+> scope

ended : {e : HFunctor} -> {{io : stdio <: e}} -> {{sc : scope <: e}} -> Co e Int
ended = do
  try
    print "in"
  finally
    print "released at its end"
  pure 1

-- (a throw of a `String`, through two scopes: the inner released first)
thrownString : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sc : scope <: e}}
             -> {{ex : exception String <: e}}
             -> Co e Int
thrownString = do
  try
    try
      print "throwing a String"
      throw (a := Unit) "boom"
    finally
      print "released inner"
  finally
    print "released outer"
  pure 2

thrownInt : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sc : scope <: e}}
          -> {{ex : exception Int <: e}}
          -> Co e Int
thrownInt = do
  try
    print "throwing an Int"
    throw (a := Unit) (7 : Int)
  finally
    print "released by an Int"
  pure 3

gaveUp : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sc : scope <: e}}
       -> {{st : stopping <: e}}
       -> Co e Int
gaveUp = do
  try
    print "stopping"
    stop (a := Unit)
  finally
    print "released by a stop"
  pure 4

-- (a throw heard outside: released before the `catch` arm runs)
caughtOutside : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sc : scope <: e}}
              -> {{ex : exception String <: e}}
              -> Co e Int
caughtOutside = do
  try
    try
      throw (a := Unit) "boom"
    finally
      print "released before the catch"
  catch (why : String) ->
    print ("caught " ^ why)
  pure 5

-- (`return` out of two scopes, `break` and `continue` out of one each
-- turn)
jumps : {e : HFunctor} -> {{io : stdio <: e}} -> {{sc : scope <: e}} -> Co e Int
jumps = do
  let mut n = 0
  for i in range 1 5 do
    try
      if i == 2 then continue
      if i == 4 then break
      n := n + i
    finally
      print ("left turn " ^ show i)
  try
    try
      return n
    finally
      print "released inner by return"
  finally
    print "released outer by return"

-- (a million turns, each through a scope, a throw caught in it every
-- third)
turns : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sc : scope <: e}}
      -> {{ex : exception String <: e}}
      -> Int
      -> Co e Int
turns n = do
  let mut i = 0
  let mut total = 0
  while i < n do
    i := i + 1
    try
      if i % 3 == 0 then throw (a := Unit) "third"
      total := total + 1
    catch (why : String) ->
      total := total + 0
    finally
      if i % 250000 == 0 then print ("left " ^ show i)
  return total

-- (green threads taking turns, each in a scope of its own: each released
-- as it leaves, not as another does)
threadIn : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sc : scope <: e}}
         -> {{gr : green <: e}}
         -> String
         -> Co e Unit
threadIn name = do
  try
    print (name ^ " in")
    yield
    yield
    print (name ^ " still in")
  finally
    print ("released " ^ name)

-- (... and one main does not wait for, never resumed once main ends)
interleaved : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sc : scope <: e}}
            -> {{gr : green <: e}}
            -> Co e Unit
interleaved = do
  spawn (threadIn "B")
  spawn (do
    try
      print "C in"
      yield
      yield
      yield
      yield
      print "C never here"
    finally
      print "released C, never resumed")
  threadIn "A"

shown : Either String Int -> String
shown (Left why) = "thrown " ^ why
shown (Right n) = show n

program : {e : HFunctor} -> {{io : stdio <: e}} -> {{sc : scope <: e}} -> Co e Unit
program = do
  print (show (<- ended))
  r <- attempt String e (thrownString (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (ex := \p -> InL p))
  print (shown r)
  r2 <- attempt Int e (thrownInt (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (ex := \p -> InL p))
  print (either (\n -> "thrown " ^ show n) (\n -> show n) r2)
  r3 <- stopped e (gaveUp (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (st := \p -> InL p))
  print (maybe "stopped" (\(n : Int) -> show n) r3)
  r4 <- attempt String e (caughtOutside (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (ex := \p -> InL p))
  print (shown r4)
  print (show (<- jumps))
  r5 <- attempt String e (turns (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (ex := \p -> InL p) 1000000)
  print (shown r5)
  g <- scheduled e (interleaved (io := \p -> InR (io p)) (sc := \p -> InR (sc p)) (gr := \p -> InL p))
  print "done"

main : Co world Unit
main = program (io := \p -> InL p) (sc := \p -> InR p)
