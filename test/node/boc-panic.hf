-- A behaviour of boc's that panics, on the C backend's threads, while
-- the others are mid-work: one awaits a sleep, to print once it wakes;
-- a chain of behaviours counts on a cown, each spawning the next, to
-- print once the count is done.  The panic ends the program there and
-- then, by 1: neither prints.

module test.node.boc-panic

import boc as BOC
import co
import std.duration as Duration
import std.io
import std.time as Time

-- (a behaviour on `c` adding 1 and spawning the next, until the count
-- is `n`, then saying so)
counted : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> BOC.Cown Int
        -> Int
        -> Co e Unit
counted c n =
  BOC.when
    c
    (\k ->
       if k >= n
       then do
         print "the count finished"
         pure k
       else do
         counted c n
         pure (k + 1))

-- (`k`, but for 1, a panic)
boom : Int -> Int
boom k = if k == 1 then panic "boom" else k

main : Co (BOC.boc <+> stdio <+> Time.time) Unit
main = do
  count <- BOC.newCown (0 : Int)
  with _ := BOC.await (Time.sleep (Duration.milliseconds 1500)) do
    print "the sleeper woke"
  counted count 100000000
  with _ := BOC.await (Time.sleep (Duration.milliseconds 100)) do
    print (show (boom 1))
