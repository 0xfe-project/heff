-- A program for `hg node` (test/node-run.mjs): each of lib/io.hg's
-- operations, once.

import co
import io
import prelude

-- | Each argument, on a line of its own.
printAll :: List String -> Co io Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  print a
  printAll rest

-- | The standard input, written to the file given and read back.
copy :: String -> Co io Unit
copy path = do
  input <- readStdin
  written <- writeFile path input
  back <- readFile path
  if written
      then print ("copied: " ++ fromMaybe "(not read back)" back)
      else printErr "not written"

echo :: Co io Unit
echo = do
  as <- args
  printAll as
  greeting <- getEnv "GREETING"
  print (fromMaybe "no greeting" greeting)
  case as of
    Nil -> printErr "no file given"
    Cons path _ -> copy path
  missing <- readFile "/nonexistent/heff"
  print (maybe "missing: not read" (\_ -> "missing: read") missing)
  printErr "to stderr"
  exit 3
  print "never"
