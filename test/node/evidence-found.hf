module test.node.evidence-found

-- Evidence found where none is written, as `(x := _)` finds it: `main`'s
-- world is said by its type, and `program` is given where each effect
-- is in it; inside `program`, an `attempt` adds an exception on the
-- world's left, and what runs in it is given that place, and the others
-- through `program`'s own evidence.
import co
import exception
import std.filesystem
import std.io
import std.path
import std.process

-- (a file's text, or why it is not read, thrown)
shown : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> {{ex : exception FileError <: e}}
      -> Path
      -> Co e Unit
shown path = do
  text <- readFile path
  print text

-- (a file not there, said by a `String` thrown)
there : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> {{ex : exception FileError <: e}}
      -> {{no : exception String <: e}}
      -> Path
      -> Co e Unit
there path = do
  yes <- exists path
  if yes then shown path else throw "not there"

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  argv <- args
  print ("args: " ^ joinWith " " argv)
  r <- attempt FileError (do
    print "reading"
    shown "no/such/file.txt")
  case r of
    Left err -> print ("not read: " ^ err.name)
    Right _ -> print "read"
  -- (attempts nested: an exception of each)
  r2 <- attempt FileError (attempt String (there "no/such/file.txt"))
  case r2 of
    Right (Left s) -> print s
    _ -> print "read"

-- (a definition that is an operation alone, its evidence its last
-- argument)
flushed : Co (stdio <+> filesystem <+> process) Unit
flushed = flush

main : Co (stdio <+> filesystem <+> process) Unit
main = do
  print "begun"
  program
  flushed
