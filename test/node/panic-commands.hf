-- A panic while a command started runs beside the program: the program
-- ends there and then, by 1, and the command is ended with it, as at
-- any end -- it never wakes to print on the output it shares.

module test.node.panic-commands

import co
import custodian as Custodian
import exception
import std.io
import std.process

-- (`k`, but for 1, a panic)
boom : Int -> Int
boom k = if k == 1 then panic "boom" else k

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Unit
program = do
  with withProcess
         { command = "sh"
         , args = ["-c", "sleep 1; echo the command lived on"]
         , output = Inherited
         } as sleeper do
    print (show (boom 1))

main : Co (stdio <+> process <+> Custodian.custodian) Unit
main = do
  r <- attempt ProcessError (program (io := _) (sys := _) (ex := _))
  pure MkUnit
