-- A world of things that may fail to end (with cascade.hf): a thing is
-- a thing of the host's, held by a `with` (`withThing`), which ends it
-- as it lets go of it where it holds it alone, else its last holder
-- does -- as a socket is.  One made to fail says so as it is ended,
-- whoever ends it: the `with`, its last holder, or its custodian.

module test.node.flaky

import co
import custodian
import exception
import resource

-- | A thing as the host has it: a foreign value.
data Thing

data FlakyF (m : Type -> Type) x
  = NewThing Bool (Either String Thing -> x)
  | LetGoThing Thing (Either String Unit -> x)

flaky : HFunctor
flaky =
  { f = FlakyF
  , hfmap = \m g p -> case p of
      NewThing b k -> NewThing b (\t -> g (k t))
      LetGoThing t k -> LetGoThing t (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      NewThing b k -> NewThing b k
      LetGoThing t k -> LetGoThing t k
  }

-- (a thing made, one that fails to end where `fails`)
made : {e : HFunctor}
     -> {{ev : flaky <: e}}
     -> Bool
     -> Co e (Either String Thing)
made fails = op (ev (NewThing fails (\t -> t))) val

-- (a thing let go of: ended where this was its one holder)
letGo : {e : HFunctor}
      -> {{ev : flaky <: e}}
      -> Thing
      -> Co e (Either String Unit)
letGo t = op (ev (LetGoThing t (\r -> r))) val

-- | A thing, one that fails to end where `fails`, held by `body` in a
-- | region of its own, and let go of when `body` ends.
withThing : {e : HFunctor}
          -> {a : Type}
          -> {{ev : flaky <: e}}
          -> {{ex : exception String <: e}}
          -> {{cu : custodian <: e}}
          -> Bool
          -> ({s : Type} -> With s Thing -> Co e a)
          -> Co e a
withThing fails body = scoped (made fails) letGo body
