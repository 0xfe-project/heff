-- Files open, read and written a piece at a time (std.filesystem), by C
-- alone.
--
--   main DIR     round trips, a large file in chunks, lines (`\r\n`, a
--                last one with no newline, one longer than a buffer),
--                seek and tell, what the system says of a file, links,
--                temporary files, modes, the standard output as a file,
--                and what fails: an operation's, a value, a `with`'s,
--                thrown and heard
--   closed DIR   a file used after its `with` closed it, by a function
--                that kept it: EBADF, a value
--   lines        the standard input a line at a time: `ping` answered
--                at once, then how many lines and bytes there were
--   threaded     boc's behaviours: an act awaited reads the standard
--                input, a pipe, in a worker's reactor, while behaviours
--                count

module test.node.files

import bytes as Bytes
import boc as BOC
import co
import custodian
import exception
import int as Int
import std.file
import std.filesystem
import std.io
import std.path as Path
import std.process
import std.reactor as Reactor
import uint8 as UInt8
import resource

-- (the value of a `Right`; where there is none, the program abandoned:
-- what the test made, which does not fail)
must : {a : Type} -> Either FileError a -> a
must (Right x) = x
must (Left err) = abandon

-- (whether an operation was done)
done : {a : Type} -> Either FileError a -> Bool
done (Right _) = True
done (Left _) = False

-- (where an operation failed: why; else "ok")
failed : {a : Type} -> Either FileError a -> String
failed (Left err) = err.name
failed (Right _) = "ok"

-- (a kind, as it is written)
showKind : Kind -> String
showKind Regular = "regular"
showKind Directory = "directory"
showKind Link = "link"
showKind Other = "other"

-- (a kind, where there is one)
showKindOf : Either FileError Status -> String
showKindOf (Right s) = showKind s.kind
showKindOf (Left err) = err.name

-- (a mode, in octal)
octal : Int -> String
octal n = if n < 8 then debug n else octal (n / 8) ^ debug (n % 8)

-- Round trips
--------------------------------------------------------------------------------

-- (a `with` that may fail, its throw heard, as a value)
tried : {e : HFunctor}
      -> {a : Type}
      -> {{fx : exception FileError <: e}}
      -> Co e a
      -> Co e (Either FileError a)
tried c =
  recover
    (bind c (\x -> pure (Right x)))
    (\(err : FileError) -> pure (Left err))

-- | A string and bytes written, read back whole; then appended to.
roundTrip : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> {{cu : custodian <: e}}
          -> String
          -> Co e Unit
roundTrip path = do
  w <-
    with h := open (access := Write { exists = Truncate }) path do
      a <- tried (writeString h "hello, ")
      b <- tried (writeBytes h b["world", 10])
      pure (failed a ^ " " ^ failed b)
  back <- readFile path
  print ("written: " ^ w)
  print ("read back: " ^ debug back)
  with h := open (access := Write { exists = Append }) path do
    writeString h "again\n"
  again <- readFile path
  print ("appended: " ^ debug again)

-- (the bytes' sum, from `i`)
byteSum : Bytes -> Int -> Int -> Int
byteSum b i acc =
  if i >= Bytes.length b then acc
  else byteSum b (i + 1) (acc + maybe 0 UInt8.toInt (Bytes.index b i))

-- (a block written `n` times)
writeTimes : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> File
           -> Bytes
           -> Int
           -> Co e Unit
writeTimes h block 0 = pure MkUnit
writeTimes h block n =
  bind (writeBytes h block) (\w -> writeTimes h block (n - 1))

-- (chunks of `n` read to the end: how many bytes, their sum, how many
-- chunks)
readAll : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> File
        -> Int
        -> Int
        -> Int
        -> Int
        -> Co e String
readAll h n size total chunks = do
  b <- readChunk h n
  if Bytes.length b == 0
  then pure
      (debug size
       ^ " bytes, sum "
       ^ debug total
       ^ ", "
       ^ debug chunks
       ^ " chunks")
  else readAll h n (size + Bytes.length b) (byteSum b 0 total) (chunks + 1)

-- | A large file, written a block at a time, read back in chunks smaller
-- | and larger than a buffer, and copied, a chunk at a time.
chunks : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> {{cu : custodian <: e}}
       -> String
       -> Co e Unit
chunks path = do
  let block = Bytes.fromString (joinWith "" (List.replicate 100 "0123456789"))
  with h := open (access := Write { exists = Truncate }) path do
    writeTimes h block 3000
    writeString h "tail"
  s <-
    with h := open path do
      readAll h 4096 0 0 0
  print ("in chunks of 4096: " ^ s)
  l <-
    with h := open path do
      readAll h 1000000 0 0 0
  print ("in chunks of 1000000: " ^ l)
  n <-
    with from := open path do
      with to :=
             open (access := Write { exists = Truncate }) (path ^ ".copy") do
        copyOpen from to
  a <- readFile path
  b <- readFile (path ^ ".copy")
  print
      ("copied: "
       ^ debug n
       ^ " bytes, the same "
       ^ debug (a == b))

-- Lines
--------------------------------------------------------------------------------

-- (lines folded into a list, in order)
inOrder : Either FileError (List String) -> Either FileError (List String)
inOrder ls = either (\err -> Left err) (\l -> Right (List.reverse l)) ls

-- (the lines of a file, from its start)
linesOf : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{cu : custodian <: e}}
        -> String
        -> Co e (Either FileError (List String))
linesOf path = do
  ls <-
    with h := open path do
      tried (foldLines h Nil (\acc l -> pure (l :: acc)))
  pure (inOrder ls)

-- (the lines of a file, from its start, read `n` bytes at a time)
linesBy : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{cu : custodian <: e}}
        -> Int
        -> String
        -> Co e (Either FileError (List String))
linesBy n path = do
  ls <-
    with h := open path do
      tried (foldLinesBy n h Nil (\acc l -> pure (l :: acc)))
  pure (inOrder ls)

-- (whether a file's lines, read a few bytes at a time, are `want`)
sameBy : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> {{cu : custodian <: e}}
       -> String
       -> List String
       -> Co e Bool
sameBy path want = do
  got <- for n in ([1, 2, 3, 4, 5, 7, 64] : List Int) do
    linesBy n path
  pure (List.all (\l -> debug (must l) == debug want) got)

-- | Lines ended by `\n` and `\r\n`, an empty one, the last one with no
-- | newline; one longer than a buffer; read a few bytes at a time, a
-- | `\r\n` split between two reads; lines past a chunk, and one longer
-- | than a chunk.
lineReading : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{disk : filesystem <: e}}
            -> {{fx : exception FileError <: e}}
            -> {{cu : custodian <: e}}
            -> String
            -> Co e Unit
lineReading dir = do
  writeFile (dir ^ "/crlf.txt") "one\r\ntwo\n\nthree\r\nfour"
  ls <- linesOf (dir ^ "/crlf.txt")
  print ("lines: " ^ debug (must ls))
  let long = joinWith "" (List.replicate 20000 "abcdefghij")
  writeFile (dir ^ "/long.txt") (long ^ "\nend\n")
  ll <- linesOf (dir ^ "/long.txt")
  print ("long lines: " ^ debug (List.map strLength (must ll)))
  writeFile (dir ^ "/empty.txt") ""
  none <- linesOf (dir ^ "/empty.txt")
  print ("no lines: " ^ debug (must none))
  crlf <- sameBy (dir ^ "/crlf.txt") (must ls)
  writeFile (dir ^ "/split.txt") "a\r\n\r\nbc\r\n\n\nlast\r"
  split <- linesOf (dir ^ "/split.txt")
  splitBy <- sameBy (dir ^ "/split.txt") (must split)
  longBy <- linesBy 4096 (dir ^ "/long.txt")
  emptyBy <- sameBy (dir ^ "/empty.txt") Nil
  print
      ("a few bytes at a time: "
       ^ debug crlf
       ^ " "
       ^ debug (must split)
       ^ " "
       ^ debug splitBy
       ^ ", long "
       ^ debug (List.map strLength (must longBy))
       ^ ", none "
       ^ debug emptyBy)
  let line = "0123456789abcdefghijklmnopqrstuvwxyz"
  writeFile
      (dir ^ "/many.txt")
      (joinWith "" (List.replicate 60000 (line ^ "\n")))
  many <- linesOf (dir ^ "/many.txt")
  writeFile
      (dir ^ "/huge.txt")
      ("first\n" ^ joinWith "" (List.replicate 300000 "abcdefghij") ^ "\r\nend")
  huge <- linesOf (dir ^ "/huge.txt")
  print
      ("past a chunk: "
       ^ debug (List.length (must many))
       ^ " lines, each the same "
       ^ debug (List.all (\l -> l == line) (must many))
       ^ "; "
       ^ debug (List.map strLength (must huge)))

-- Seek, tell, status
--------------------------------------------------------------------------------

-- (a chunk read, as text)
textOf : Either FileError Bytes -> String
textOf (Right b) = show b
textOf (Left err) = err.name

-- | Sought in and told where it is; read, then written where it was read
-- | up to.
seeking : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{cu : custodian <: e}}
        -> String
        -> Co e Unit
seeking dir = do
  let path = dir ^ "/seek.txt"
  writeFile path "hello, world\nsecond line\n"
  with h := open (access := ReadWrite { exists = Update }) path do
    a <- tried (seek h FromStart 7)
    w <- tried (readChunk h 5)
    t <- tried (tell h)
    print
        ("sought to "
         ^ debug (must a)
         ^ ", read "
         ^ textOf w
         ^ ", now at "
         ^ debug (must t))
    e <- tried (seek h FromEnd -5)
    l <- tried (readLine h)
    c <- tried (seek h FromCurrent -12)
    m <- tried (readLine h)
    print
        ("from the end "
         ^ debug (must e)
         ^ ": "
         ^ debug (must l)
         ^ "; back 12: "
         ^ debug (must m))
    s <- seek h FromStart 0
    first <- readChunk h 2
    writeString h "XY"
  after <- readFile path
  print ("written after a read: " ^ debug after)

-- | What the system says of a file, a directory and a link, and when a
-- | file was modified.
status : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> {{cu : custodian <: e}}
       -> String
       -> Co e Unit
status dir = do
  let path = dir ^ "/seek.txt"
  s <- tried (pathStatus path)
  d <- tried (pathStatus dir)
  print
      ("stat: "
       ^ showKindOf s
       ^ " of "
       ^ debug (must s).size
       ^ " bytes; "
       ^ showKindOf d)
  ln <- tried (linkStatus (dir ^ "/link"))
  lf <- tried (pathStatus (dir ^ "/link"))
  real <- tried (realPath (dir ^ "/link"))
  says <- tried (readLink (dir ^ "/link"))
  notLink <- tried (readLink (dir ^ "/seek.txt"))
  print
      ("a link: "
       ^ showKindOf ln
       ^ ", to a "
       ^ showKindOf lf
       ^ ", resolved: "
       ^ (if Path.basename (must real) == "target.txt" then "target.txt"
          else show (must real))
       ^ ", says: "
       ^ either (\(err : FileError) -> err.name) show says
       ^ ", not one: "
       ^ failed notLink)
  hs <-
    with h := open path do
      tried (stat h)
  print
      ("an open file's: "
       ^ showKindOf hs
       ^ " of "
       ^ debug (must hs).size
       ^ " bytes")
  again <- tried (pathStatus path)
  writeFile path "changed"
  later <- tried (pathStatus path)
  print
      ("modified: untouched the same "
       ^ debug ((must again).modified == (must s).modified)
       ^ ", written not earlier "
       ^ debug ((must later).modified >= (must s).modified)
       ^ ", since the epoch "
       ^ debug ((must s).modified > 1000000000000000000))
  isF <- isFile path
  isD <- isDirectory dir
  notD <- isDirectory path
  missing <- exists (dir ^ "/missing")
  k <- kindAt (dir ^ "/missing")
  print
      ("what a path is: "
       ^ debug isF
       ^ " "
       ^ debug isD
       ^ " "
       ^ debug notD
       ^ " "
       ^ debug missing
       ^ " "
       ^ maybe "nothing" showKind k)

-- Modes, temporary files
--------------------------------------------------------------------------------

-- | A mode set, a file made executable, a directory read-only and
-- | writable again.
modes : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> String
      -> Co e Unit
modes dir = do
  let path = dir ^ "/mode.sh"
  writeFile path "#!/bin/sh\n"
  setMode path 0x1a4
  s <- tried (pathStatus path)
  makeExecutable path
  t <- tried (pathStatus path)
  print
      ("modes: " ^ octal (must s).mode ^ ", executable " ^ octal (must t).mode)
  makeDirectory (dir ^ "/locked/in")
  readOnly (dir ^ "/locked")
  r <- tried (pathStatus (dir ^ "/locked"))
  writable (dir ^ "/locked")
  v <- tried (pathStatus (dir ^ "/locked"))
  made <- tried (writeFile (dir ^ "/locked/in/x") "x")
  print
      ("read-only "
       ^ octal (and (must r).mode 0x1ff)
       ^ ", writable again "
       ^ octal (and (must v).mode 0x1c0)
       ^ ", written in "
       ^ debug (done made))

-- | A temporary directory and a temporary file, each new.
temporary : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> {{cu : custodian <: e}}
          -> Co e Unit
temporary = do
  a <- tried (temporaryDirectory "heff-files-")
  b <- tried (temporaryDirectory "heff-files-")
  isD <- isDirectory (must a)
  listed <- tried (readDirectory (must a))
  let names : Maybe (List String) =
    either (\_ -> Nothing) (\ps -> Just (List.map Path.basename ps)) listed
  print
      ("temporary directories: "
       ^ debug isD
       ^ ", empty "
       ^ debug names
       ^ ", each new "
       ^ debug (must a /= must b)
       ^ ", named "
       ^ debug (contains "heff-files-" (Path.basename (must a))))
  t <- tried (temporaryFile "heff-file-")
  r <-
    with file := open (access := ReadWrite { exists = Update }) (must t) do
      w <- writeString file "kept for a while"
      s <- seek file FromStart 5
      tried (readChunk file 100)
  print
      ("a temporary file: "
       ^ textOf r
       ^ ", there "
       ^ debug (contains "heff-file-" (Path.basename (must t))))
  remove (must a)
  remove (must b)
  gone <- tried (remove (must t))
  print ("removed: " ^ debug (done gone))

-- What fails
--------------------------------------------------------------------------------

-- (a failure said, `dir` written `DIR`)
namedIn : String -> FileError -> String
namedIn dir err = joinWith "DIR" (split dir (show err))

-- (what an operation came to said, `dir` written `DIR`: why it failed,
-- or "ok")
cameTo : {a : Type} -> String -> Either FileError a -> String
cameTo dir (Left err) = namedIn dir err
cameTo dir (Right _) = "ok"

-- (a file held by a `with` and let go of at once, opened for `access`)
heldOnce : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> {access : Access := Read}
         -> {{cu : custodian <: e}}
         -> String
         -> Co e Unit
heldOnce path = do
  with h := open (access := access) path do
    pure ()

-- | What fails: an operation's failure a value, a `with`'s thrown, each
-- | its errno's name.
failures : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> {{cu : custodian <: e}}
         -> String
         -> Co e Unit
failures dir = do
  a <- tried (heldOnce (dir ^ "/missing/file"))
  b <- tried (heldOnce (access := Write { exists = Truncate }) dir)
  c <- tried (heldOnce dir)
  let secret = dir ^ "/secret"
  writeFile secret "no"
  setMode secret 0
  d <- tried (heldOnce secret)
  setMode secret 0x1a4
  x <- tried (heldOnce (access := Write {}) secret)
  print
      ("failed: "
       ^ failed a
       ^ " "
       ^ failed b
       ^ " "
       ^ failed c
       ^ " "
       ^ failed d
       ^ " "
       ^ failed x)
  r <-
    with h := open (access := Write { exists = Truncate }) secret do
      tried (readChunk h 10)
  s <- tried (pathStatus (dir ^ "/missing"))
  m <- tried (setMode (dir ^ "/missing") 0x1a4)
  p <- tried (realPath (dir ^ "/missing"))
  onFile <- tried (makeDirectory secret)
  print
      ("failed too: "
       ^ failed r
       ^ " "
       ^ failed s
       ^ " "
       ^ failed m
       ^ " "
       ^ failed p
       ^ ", a directory made where a file is "
       ^ debug (done onFile))
  print ("said so: " ^ either (namedIn dir) (\h -> "opened") a)
  print ("an open file's: " ^ either (namedIn dir) (\b -> "read") r)

-- | Which path a failure names: the one inside a tree an operation of
-- | the tree failed at, the one a call taking two was at fault for, or
-- | both, and a relative one as it was written.
named : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> {{sys : process <: e}}
      -> {{fx : exception FileError <: e}}
      -> String
      -> Co e Unit
named dir = do
  missing <- tried (readFile (dir ^ "/none.txt"))
  print ("read, nothing there: " ^ cameTo dir missing)
  under <- tried (remove (dir ^ "/secret/x"))
  print ("removed, under a file: " ^ cameTo dir under)
  makeDirectory (dir ^ "/tree/sub")
  writeFile (dir ^ "/tree/a.txt") "a"
  writeFile (dir ^ "/tree/sub/locked") "locked"
  setMode (dir ^ "/tree/sub/locked") 0
  copied <- tried (copy (dir ^ "/tree") (dir ^ "/tree-copy"))
  setMode (dir ^ "/tree/sub/locked") 0x1a4
  print ("a tree copied, a file in it unreadable: " ^ cameTo dir copied)
  onto <- tried (move (dir ^ "/round.txt") (dir ^ "/large.bin"))
  print ("moved onto a file: " ^ cameTo dir onto)
  gone <- tried (move (dir ^ "/none.txt") (dir ^ "/elsewhere.txt"))
  print ("moved, nothing there: " ^ cameTo dir gone)
  back <- workingDir
  there <- setWorkingDir dir
  relative <- tried (readFile "none.txt")
  again <- setWorkingDir back
  print ("as it was written: " ^ cameTo dir relative)

-- | The standard output, as an open file, between what std.io writes:
-- | left open when its `with` ends, had again by the next.
standard : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> {{cu : custodian <: e}}
         -> Co e Unit
standard = do
  print "std.io before"
  w <- tried (withStdout (\o -> writeString o "the standard output, a file\n"))
  again <- tried (withStdout (\o -> writeString o "and again\n"))
  print ("std.io after: " ^ failed w ^ " " ^ failed again)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{sys : process <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{cu : custodian <: e}}
        -> String
        -> Co e Unit
program dir = do
  roundTrip (dir ^ "/round.txt")
  chunks (dir ^ "/large.bin")
  lineReading dir
  seeking dir
  status dir
  modes dir
  temporary
  failures dir
  named dir
  standard

-- (the first argument)
firstArg : List String -> String
firstArg (a :: _) = a
firstArg [] = "."

-- (a function that kept the file: what the body came to holds it past
-- the `with`)
keeper : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> File
       -> Co e (Unit -> Co e (Either FileError Unit))
keeper h = pure (\u -> tried (writeString h "never"))

-- | A file used after its `with` closed it, by a function that kept it:
-- | EBADF, a value.
afterClose : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> {{cu : custodian <: e}}
           -> String
           -> Co e Unit
afterClose dir = do
  kept <-
    with h :=
           open (access := Write { exists = Truncate }) (dir ^ "/closed.txt") do
      keeper h
  print "closed"
  let f : Unit -> Co e (Either FileError Unit) = kept
  w <- f MkUnit
  print ("after the with: " ^ failed w)

-- Standard input
--------------------------------------------------------------------------------

-- (lines and bytes so far)
type Counted = { lines : Int, bytes : Int }

-- (a line counted; `ping` answered at once)
countLine : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> File
          -> Counted
          -> String
          -> Co e Counted
countLine out c line =
  let next : Counted = { lines = c.lines + 1, bytes = c.bytes + strLength line }
  in if line == "ping"
  then bind (writeString out "pong\n") (\w -> pure next)
  else pure next

-- | The standard input, a line at a time, in as little memory as a line
-- | takes.
stdinLines : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> {{cu : custodian <: e}}
           -> Co e Unit
stdinLines = do
  r <-
    withStdin
      (\i ->
         withStdout
           (\o ->
              foldLines i ({ lines = 0, bytes = 0 } : Counted) (countLine o)))
  let c : Counted = r
  print ("lines " ^ debug c.lines ^ " bytes " ^ debug c.bytes)

-- (a count to `n`, a step a behaviour on `c`, each spawning the next:
-- the last says what it came to, at once)
counting : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> BOC.Cown Int
         -> Int
         -> Co e Unit
counting c n = do
  with i := c do
    if i + 1 >= n
    then do
      print ("counted while the reader waits: " ^ debug (i + 1))
      flush
    else counting c n
    i := i + 1

-- (the standard input's lines counted, or -1 where it fails)
linesIn : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Int
linesIn = do
  r <- attempt FileError (foldStdinLines 0 (\n l -> pure (n + 1)))
  pure (either (\err -> 0 - 1) (\n -> n) r)

-- | The standard input, a pipe, read by an act awaited, while behaviours
-- | count: the count is written before any of the input comes (the
-- | test writes none until it is).
threadedLines : {e : HFunctor}
              -> {{bc : BOC.boc <: e}}
              -> {{io : stdio <: e}}
              -> {{disk : filesystem <: e}}
              -> {{cu : custodian <: e}}
              -> Co e Unit
threadedLines = do
  count <- BOC.newCown 0
  with n := BOC.await linesIn do
    print ("read: " ^ debug n ^ " lines")
  counting count 1000

-- The programs
--------------------------------------------------------------------------------

-- (a throw no one heard: said)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> Either FileError Unit
        -> Co e Unit
unheard (Left err) = print ("not heard: " ^ show err)
unheard (Right u) = pure MkUnit

main : Co
       (stdio <+> filesystem <+> Reactor.reactor <+> process <+> custodian)
       Unit
main = do
  argv <- args (ev := _)
  r <-
    attempt
      FileError
      (program
         (io := _)
         (disk := _)
         (sys := _)
         (fx := _)
         (firstArg argv))
  unheard (io := _) r

closed : Co
         (stdio <+> filesystem <+> Reactor.reactor <+> process <+> custodian)
         Unit
closed = do
  argv <- args (ev := _)
  r <-
    attempt
      FileError
      (afterClose
         (io := _)
         (disk := _)
         (fx := _)
         (firstArg argv))
  unheard (io := _) r

linesMain : Co
            (stdio <+> filesystem <+> Reactor.reactor <+> process <+> custodian)
            Unit
linesMain = do
  r <- attempt FileError (stdinLines (io := _) (disk := _) (fx := _))
  unheard (io := _) r

threaded : Co (BOC.boc <+> custodian <+> stdio <+> filesystem <+> process) Unit
threaded = do
  BOC.scheduled (\why -> print ("failed: " ^ why)) threadedLines
  print "main done"
