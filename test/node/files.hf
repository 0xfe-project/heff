-- Files open, read and written a piece at a time (std.filesystem), by C
-- alone.
--
--   main DIR     round trips, a large file in chunks, lines (`\r\n`, a
--                last one with no newline, one longer than a buffer),
--                seek and tell, what the system says of a file, links,
--                temporary files, modes, the standard output as a file,
--                and what fails: an operation's, a value, a `with`'s,
--                thrown and heard
--   closed DIR   a file used after its `with` closed it, by a function
--                that kept it: EBADF, a value
--   lines        the standard input a line at a time: `ping` answered
--                at once, then how many lines and bytes there were
--   green        green threads: one reads the standard input, a pipe,
--                while another counts

module test.node.files

import bytes as Bytes
import co
import exception
import green
import int as Int
import std.filesystem
import std.io
import std.process
import std.reactor as Reactor
import uint8 as UInt8
import with

world : HFunctor
world = stdio <+> (filesystem <+> (Reactor.reactor <+> process))

-- (the value of a `Right`; where there is none, the program abandoned:
-- what the test made, which does not fail)
must : {a : Type} -> Either FileError a -> a
must (Right x) = x
must (Left err) = abandon

-- (where an operation failed: why; else "ok")
failed : {a : Type} -> Either FileError a -> String
failed (Left err) = err.name
failed (Right _) = "ok"

-- (a kind, as it is written)
showKind : Kind -> String
showKind Regular = "regular"
showKind Directory = "directory"
showKind Link = "link"
showKind Other = "other"

-- (a kind, where there is one)
showKindOf : Either FileError Status -> String
showKindOf (Right s) = showKind s.kind
showKindOf (Left err) = err.name

-- (a mode, in octal)
octal : Int -> String
octal n = if n < 8 then show n else octal (n / 8) ^ show (n % 8)

-- Round trips
--------------------------------------------------------------------------------

-- (a `with` that may fail, its throw heard, as a value)
tried : {e : HFunctor}
      -> {a : Type}
      -> {{fx : exception FileError <: e}}
      -> Co e a
      -> Co e (Either FileError a)
tried c =
  recover
    (bind c (\x -> pure (Right x)))
    (\(err : FileError) -> pure (Left err))

-- | A string and bytes written, read back whole; then appended to.
roundTrip : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> String
          -> Co e Unit
roundTrip path = do
  w <-
    withFile path { access = Write } (\h -> do
    a <- writeString h "hello, "
    b <- writeBytes h b["world", 10]
    pure (failed a ^ " " ^ failed b))
  back <- readFile path
  print ("written: " ^ w)
  print ("read back: " ^ show back)
  withFile path { access = Append } (\h -> writeString h "again\n")
  again <- readFile path
  print ("appended: " ^ show again)

-- (the bytes' sum, from `i`)
byteSum : Bytes -> Int -> Int -> Int
byteSum b i acc =
  if i >= Bytes.length b then acc
  else byteSum b (i + 1) (acc + maybe 0 UInt8.toInt (Bytes.index b i))

-- (a block written `n` times)
writeTimes : {e : HFunctor}
           -> {s : Type}
           -> {{disk : filesystem <: e}}
           -> With s OpenFile
           -> Bytes
           -> Int
           -> Co e Unit
writeTimes h block 0 = pure MkUnit
writeTimes h block n =
  bind (writeBytes h block) (\w -> writeTimes h block (n - 1))

-- (chunks of `n` read to the end: how many bytes, their sum, how many
-- chunks)
readAll : {e : HFunctor}
        -> {s : Type}
        -> {{disk : filesystem <: e}}
        -> With s OpenFile
        -> Int
        -> Int
        -> Int
        -> Int
        -> Co e String
readAll h n size total chunks = do
  r <- readChunk h n
  let b = must r
  if Bytes.length b == 0
    then pure
        (show size
         ^ " bytes, sum "
         ^ show total
         ^ ", "
         ^ show chunks
         ^ " chunks")
    else readAll h n (size + Bytes.length b) (byteSum b 0 total) (chunks + 1)

-- | A large file, written a block at a time, read back in chunks smaller
-- | and larger than a buffer, and copied, a chunk at a time.
chunks : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> String
       -> Co e Unit
chunks path = do
  let block = Bytes.fromString (joinWith "" (List.replicate 100 "0123456789"))
  withFile path { access = Write } (\h -> do
    writeTimes h block 3000
    writeString h "tail")
  s <- withFile path { access = Read } (\h -> readAll h 4096 0 0 0)
  print ("in chunks of 4096: " ^ s)
  l <- withFile path { access = Read } (\h -> readAll h 1000000 0 0 0)
  print ("in chunks of 1000000: " ^ l)
  n <-
    withFile
      path
      { access = Read }
      (\from ->
         withFile (path ^ ".copy") { access = Write } (\to -> copyOpen from to))
  a <- readFile path
  b <- readFile (path ^ ".copy")
  print
      ("copied: "
       ^ show (must n)
       ^ " bytes, the same "
       ^ show (a == b))

-- Lines
--------------------------------------------------------------------------------

-- (the lines of a file, from its start)
linesOf : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> String
        -> Co e (Either FileError (List String))
linesOf path = do
  ls <-
    withFile
      path
      { access = Read }
      (\h -> foldLines h Nil (\acc l -> pure (l :: acc)))
  pure (either (\err -> Left err) (\l -> Right (List.reverse l)) ls)

-- | Lines ended by `\n` and `\r\n`, an empty one, the last one with no
-- | newline; one longer than a buffer.
lineReading : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{disk : filesystem <: e}}
            -> {{fx : exception FileError <: e}}
            -> String
            -> Co e Unit
lineReading dir = do
  writeFile (dir ^ "/crlf.txt") "one\r\ntwo\n\nthree\r\nfour"
  ls <- linesOf (dir ^ "/crlf.txt")
  print ("lines: " ^ show (must ls))
  let long = joinWith "" (List.replicate 20000 "abcdefghij")
  writeFile (dir ^ "/long.txt") (long ^ "\nend\n")
  ll <- linesOf (dir ^ "/long.txt")
  print ("long lines: " ^ show (List.map strLength (must ll)))
  writeFile (dir ^ "/empty.txt") ""
  none <- linesOf (dir ^ "/empty.txt")
  print ("no lines: " ^ show (must none))

-- Seek, tell, status
--------------------------------------------------------------------------------

-- (a chunk read, as text)
textOf : Either FileError Bytes -> String
textOf (Right b) = toString b
textOf (Left err) = err.name

-- | Sought in and told where it is; read, then written where it was read
-- | up to.
seeking : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> String
        -> Co e Unit
seeking dir = do
  let path = dir ^ "/seek.txt"
  writeFile path "hello, world\nsecond line\n"
  withFile path { access = ReadWrite } (\h -> do
    a <- seek h FromStart 7
    w <- readChunk h 5
    t <- tell h
    print
        ("sought to "
         ^ show (must a)
         ^ ", read "
         ^ textOf w
         ^ ", now at "
         ^ show (must t))
    e <- seek h FromEnd -5
    l <- readLine h
    c <- seek h FromCurrent -12
    m <- readLine h
    print
        ("from the end "
         ^ show (must e)
         ^ ": "
         ^ show (must l)
         ^ "; back 12: "
         ^ show (must m))
    s <- seek h FromStart 0
    first <- readChunk h 2
    writeString h "XY")
  after <- readFile path
  print ("written after a read: " ^ show after)

-- | What the system says of a file, a directory and a link, and when a
-- | file was modified.
status : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> String
       -> Co e Unit
status dir = do
  let path = dir ^ "/seek.txt"
  s <- pathStatus path
  d <- pathStatus dir
  print
      ("stat: "
       ^ showKindOf s
       ^ " of "
       ^ show (must s).size
       ^ " bytes; "
       ^ showKindOf d)
  ln <- linkStatus (dir ^ "/link")
  lf <- pathStatus (dir ^ "/link")
  real <- realPath (dir ^ "/link")
  print
      ("a link: "
       ^ showKindOf ln
       ^ ", to a "
       ^ showKindOf lf
       ^ ", resolved: "
       ^ (if endsWith "/target.txt" (must real) then "target.txt"
          else must real))
  hs <- withFile path { access = Read } (\h -> fileStatus h)
  print
      ("an open file's: "
       ^ showKindOf hs
       ^ " of "
       ^ show (must hs).size
       ^ " bytes")
  again <- pathStatus path
  writeFile path "changed"
  later <- pathStatus path
  print
      ("modified: untouched the same "
       ^ show ((must again).modified == (must s).modified)
       ^ ", written not earlier "
       ^ show ((must later).modified >= (must s).modified)
       ^ ", since the epoch "
       ^ show ((must s).modified > 1000000000000000000))
  isF <- isFile path
  isD <- isDirectory dir
  notD <- isDirectory path
  missing <- exists (dir ^ "/missing")
  k <- kindAt (dir ^ "/missing")
  print
      ("what a path is: "
       ^ show isF
       ^ " "
       ^ show isD
       ^ " "
       ^ show notD
       ^ " "
       ^ show missing
       ^ " "
       ^ maybe "nothing" showKind k)

-- Modes, temporary files
--------------------------------------------------------------------------------

-- | A mode set, a file made executable, a directory read-only and
-- | writable again.
modes : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> String
      -> Co e Unit
modes dir = do
  let path = dir ^ "/mode.sh"
  writeFile path "#!/bin/sh\n"
  a <- setMode path 0x1a4
  s <- pathStatus path
  x <- makeExecutable path
  t <- pathStatus path
  print
      ("modes: " ^ octal (must s).mode ^ ", executable " ^ octal (must t).mode)
  makeDirectory (dir ^ "/locked/in")
  ro <- readOnly (dir ^ "/locked")
  r <- pathStatus (dir ^ "/locked")
  w <- writable (dir ^ "/locked")
  v <- pathStatus (dir ^ "/locked")
  made <- writeFile (dir ^ "/locked/in/x") "x"
  print
      ("read-only "
       ^ octal (and (must r).mode 0x1ff)
       ^ ", writable again "
       ^ octal (and (must v).mode 0x1c0)
       ^ ", written in "
       ^ show made)

-- | A temporary directory and a temporary file, each new.
temporary : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> Co e Unit
temporary = do
  a <- temporaryDirectory "heff-files-"
  b <- temporaryDirectory "heff-files-"
  isD <- isDirectory (must a)
  names <- readDirectory (must a)
  print
      ("temporary directories: "
       ^ show isD
       ^ ", empty "
       ^ show names
       ^ ", each new "
       ^ show (must a /= must b)
       ^ ", named "
       ^ show (contains "heff-files-" (must a)))
  t <- temporaryFile "heff-file-"
  r <-
    withFile (must t) { access = ReadWrite } (\file -> do
    w <- writeString file "kept for a while"
    s <- seek file FromStart 5
    readChunk file 100)
  print
      ("a temporary file: "
       ^ textOf r
       ^ ", there "
       ^ show (contains "heff-file-" (must t)))
  remove (must a)
  remove (must b)
  gone <- remove (must t)
  print ("removed: " ^ show gone)

-- What fails
--------------------------------------------------------------------------------

-- | What fails: an operation's failure a value, a `with`'s thrown, each
-- | its errno's name.
failures : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> String
         -> Co e Unit
failures dir = do
  a <-
    tried
      (withFile
         (dir ^ "/missing/file")
         { access = Read }
         (\h -> (pure MkUnit : Co e Unit)))
  b <- tried (withFile dir { access = Write } (\h -> (pure MkUnit : Co e Unit)))
  c <- tried (withFile dir { access = Read } (\h -> (pure MkUnit : Co e Unit)))
  let secret = dir ^ "/secret"
  writeFile secret "no"
  setMode secret 0
  d <-
    tried (withFile secret { access = Read } (\h -> (pure MkUnit : Co e Unit)))
  setMode secret 0x1a4
  x <-
    tried
      (withFile
         secret
         { access = Write, exclusive = True }
         (\h -> (pure MkUnit : Co e Unit)))
  print
      ("failed: "
       ^ failed a
       ^ " "
       ^ failed b
       ^ " "
       ^ failed c
       ^ " "
       ^ failed d
       ^ " "
       ^ failed x)
  r <- withFile secret { access = Write } (\h -> readChunk h 10)
  s <- pathStatus (dir ^ "/missing")
  m <- setMode (dir ^ "/missing") 0x1a4
  p <- realPath (dir ^ "/missing")
  onFile <- makeDirectory secret
  print
      ("failed too: "
       ^ failed r
       ^ " "
       ^ failed s
       ^ " "
       ^ failed m
       ^ " "
       ^ failed p
       ^ ", a directory made where a file is "
       ^ show onFile)
  print ("said so: " ^ either showFileError (\h -> "opened") a)

-- | The standard output, as an open file, between what std.io writes:
-- | left open when its `with` ends, had again by the next.
standard : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : filesystem <: e}}
         -> Co e Unit
standard = do
  print "std.io before"
  w <- withStdout (\o -> writeString o "the standard output, a file\n")
  again <- withStdout (\o -> writeString o "and again\n")
  print ("std.io after: " ^ failed w ^ " " ^ failed again)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> String
        -> Co e Unit
program dir = do
  roundTrip (dir ^ "/round.txt")
  chunks (dir ^ "/large.bin")
  lineReading dir
  seeking dir
  status dir
  modes dir
  temporary
  failures dir
  standard

-- (the first argument)
firstArg : List String -> String
firstArg (a :: _) = a
firstArg Nil = "."

-- (a function that kept the file: what the body came to may hold it,
-- as a function's type does not name the region)
keeper : {e : HFunctor}
       -> {s : Type}
       -> {{disk : filesystem <: e}}
       -> With s OpenFile
       -> Co e (Unit -> Co e (Either FileError Unit))
keeper h = pure (\u -> writeString h "never")

-- | A file used after its `with` closed it, by a function that kept it:
-- | EBADF, a value.
afterClose : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> String
           -> Co e Unit
afterClose dir = do
  kept <- withFile (dir ^ "/closed.txt") { access = Write } keeper
  print "closed"
  let f : Unit -> Co e (Either FileError Unit) = kept
  w <- f MkUnit
  print ("after the with: " ^ failed w)

-- Standard input
--------------------------------------------------------------------------------

-- (lines and bytes so far)
type Counted = { lines : Int, bytes : Int }

-- (a line counted; `ping` answered at once)
countLine : {e : HFunctor}
          -> {s : Type}
          -> {{disk : filesystem <: e}}
          -> With s OpenFile
          -> Counted
          -> String
          -> Co e Counted
countLine out c line =
  let next : Counted = { lines = c.lines + 1, bytes = c.bytes + strLength line }
  in if line == "ping"
  then bind (writeString out "pong\n") (\w -> pure next)
  else pure next

-- | The standard input, a line at a time, in as little memory as a line
-- | takes.
stdinLines : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e Unit
stdinLines = do
  r <-
    withStdin
      (\i ->
         withStdout
           (\o ->
              foldLines i ({ lines = 0, bytes = 0 } : Counted) (countLine o)))
  let c : Counted = must r
  print ("lines " ^ show c.lines ^ " bytes " ^ show c.bytes)

-- (a thread counting to n, a yield at each)
counting : {e : HFunctor}
         -> {{gr : green <: e}}
         -> Int
         -> Int
         -> Int
         -> Co e Unit
counting ch n i =
  if i >= n then send ch i
  else bind yield (\u -> counting ch n (i + 1))

-- | A thread reading the standard input, a pipe, while another counts:
-- | the count is written before any of the input comes (the test writes
-- | none until it is).
greenLines : {e : HFunctor}
           -> {{gr : green <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e Unit
greenLines = do
  withStdin
      (\i ->
         withStdout (\o -> do
         counted <- newChan
         read <- newChan
         spawn
             (bind
                (foldLines i 0 (\n l -> pure (n + 1)))
                (\r -> send read (must r)))
         spawn (counting counted 1000 0)
         n <- recv counted
         writeString o ("counted while the reader waits: " ^ show n ^ "\n")
         m <- recv read
         writeString o ("read: " ^ show m ^ " lines\n")
         (pure MkUnit : Co e Unit)))
  pure MkUnit

-- The programs
--------------------------------------------------------------------------------

-- (a throw no one heard: said)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> Either FileError Unit
        -> Co e Unit
unheard (Left err) = print ("not heard: " ^ showFileError err)
unheard (Right u) = pure MkUnit

main : Co world Unit
main = do
  as <- args (ev := \p -> InR (InR (InR p)))
  r <-
    attempt
      FileError
      world
      (program
         (io := \p -> InR (InL p))
         (disk := \p -> InR (InR (InL p)))
         (fx := \p -> InL p)
         (firstArg as))
  unheard (io := \p -> InL p) r

closed : Co world Unit
closed = do
  as <- args (ev := \p -> InR (InR (InR p)))
  r <-
    attempt
      FileError
      world
      (afterClose
         (io := \p -> InR (InL p))
         (disk := \p -> InR (InR (InL p)))
         (fx := \p -> InL p)
         (firstArg as))
  unheard (io := \p -> InL p) r

linesMain : Co world Unit
linesMain = stdinLines (io := \p -> InL p) (disk := \p -> InR (InL p))

greenMain : Co world Unit
greenMain = do
  r <-
    Reactor.scheduled
      world
      (rx := \p -> InR (InR (InL p)))
      (greenLines (gr := \p -> InL p) (disk := \p -> InR (InR (InL p))))
  print (ev := \p -> InL p) (maybe "a deadlock" (\u -> "main done") r)
