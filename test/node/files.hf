-- Files open, read and written a piece at a time (std.filesystem), by C
-- alone (test/backends.mjs).
--
--   main DIR     round trips, a large file in chunks, lines (`\r\n`, a
--                last one with no newline, one longer than a buffer),
--                seek and tell, what the system says of a file, links,
--                temporary files, modes, the standard output as a file,
--                and what fails, as values
--   closed DIR   a file used after it is closed: the program fails
--   lines        the standard input a line at a time: `ping` answered
--                at once, then how many lines and bytes there were
--   green        green threads: one reads the standard input, a pipe,
--                while another counts

import bytes as Bytes
import co
import green
import int as Int
import std.filesystem
import std.handle
import std.io
import std.process
import std.reactor as Reactor
import uint8 as UInt8

world : HFunctor
world = stdio <+> (fs <+> (Reactor.reactor <+> process))

-- (the value of a `Right`; where there is none, the program abandoned:
-- what the test made, which does not fail)
must : {a : Type} -> Either FileError a -> a
must (Right x) = x
must (Left err) = abandon

-- (where an operation failed: why; else "ok")
failed : {a : Type} -> Either FileError a -> String
failed (Left err) = err.name
failed (Right _) = "ok"

-- (a kind, as it is written)
showKind : Kind -> String
showKind Regular = "regular"
showKind Directory = "directory"
showKind Link = "link"
showKind Other = "other"

-- (a kind, where there is one)
showKindOf : Either FileError Status -> String
showKindOf (Right s) = showKind s.kind
showKindOf (Left err) = err.name

-- (a mode, in octal)
octal : Int -> String
octal n = if n < 8 then show n else octal (n / 8) ^ show (n % 8)

-- Round trips
--------------------------------------------------------------------------------

-- | A string and bytes written, read back whole; then appended to.
roundTrip : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : fs <: e}}
          -> String
          -> Co e Unit
roundTrip path = do
  h <- openFile path { access = Write }
  a <- writeString (must h) "hello, "
  b <- writeBytes (must h) b["world", 10]
  c <- closeFile (must h)
  back <- readFile path
  print ("written: " ^ failed a ^ " " ^ failed b ^ " " ^ failed c)
  print ("read back: " ^ show back)
  more <- openFile path { access = Append }
  d <- writeString (must more) "again\n"
  closeFile (must more)
  again <- readFile path
  print ("appended: " ^ show again)

-- (the bytes' sum, from `i`)
byteSum : Bytes -> Int -> Int -> Int
byteSum b i acc =
  if i >= Bytes.length b then acc
  else byteSum b (i + 1) (acc + maybe 0 UInt8.toInt (Bytes.index b i))

-- (a block written `n` times)
writeTimes : {e : HFunctor}
           -> {{disk : fs <: e}}
           -> File
           -> Bytes
           -> Int
           -> Co e Unit
writeTimes h block 0 = pure MkUnit
writeTimes h block n = bind (writeBytes h block) (\w -> writeTimes h block (n - 1))

-- (chunks of `n` read to the end: how many bytes, their sum, how many
-- chunks)
readAll : {e : HFunctor}
        -> {{disk : fs <: e}}
        -> File
        -> Int
        -> Int
        -> Int
        -> Int
        -> Co e String
readAll h n size total chunks = do
  r <- readChunk h n
  let b = must r
  if Bytes.length b == 0
    then pure (show size ^ " bytes, sum " ^ show total ^ ", " ^ show chunks ^ " chunks")
    else readAll h n (size + Bytes.length b) (byteSum b 0 total) (chunks + 1)

-- | A large file, written a block at a time, read back in chunks smaller
-- | and larger than a buffer, and copied, a chunk at a time.
chunks : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : fs <: e}}
       -> String
       -> Co e Unit
chunks path = do
  h <- openFile path { access = Write }
  let block = Bytes.fromString (joinWith "" (List.replicate 100 "0123456789"))
  writeTimes (must h) block 3000
  writeString (must h) "tail"
  closeFile (must h)
  small <- openFile path { access = Read }
  s <- readAll (must small) 4096 0 0 0
  print ("in chunks of 4096: " ^ s)
  closeFile (must small)
  large <- openFile path { access = Read }
  l <- readAll (must large) 1000000 0 0 0
  print ("in chunks of 1000000: " ^ l)
  closeFile (must large)
  from <- openFile path { access = Read }
  to <- openFile (path ^ ".copy") { access = Write }
  n <- copyHandle (must from) (must to)
  closeFile (must from)
  closeFile (must to)
  a <- readFile path
  b <- readFile (path ^ ".copy")
  print ("copied: " ^ show (must n) ^ " bytes, the same " ^ show (a == b))

-- Lines
--------------------------------------------------------------------------------

-- (the lines of a file, from its start)
linesOf : {e : HFunctor}
        -> {{disk : fs <: e}}
        -> String
        -> Co e (Either FileError (List String))
linesOf path = do
  h <- openFile path { access = Read }
  ls <- foldLines (must h) Nil (\acc l -> pure (l :: acc))
  closeFile (must h)
  pure (either (\err -> Left err) (\l -> Right (List.reverse l)) ls)

-- | Lines ended by `\n` and `\r\n`, an empty one, the last one with no
-- | newline; one longer than a buffer.
lineReading : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{disk : fs <: e}}
            -> String
            -> Co e Unit
lineReading dir = do
  writeFile (dir ^ "/crlf.txt") "one\r\ntwo\n\nthree\r\nfour"
  ls <- linesOf (dir ^ "/crlf.txt")
  print ("lines: " ^ show (must ls))
  let long = joinWith "" (List.replicate 20000 "abcdefghij")
  writeFile (dir ^ "/long.txt") (long ^ "\nend\n")
  ll <- linesOf (dir ^ "/long.txt")
  print ("long lines: " ^ show (List.map strLength (must ll)))
  writeFile (dir ^ "/empty.txt") ""
  none <- linesOf (dir ^ "/empty.txt")
  print ("no lines: " ^ show (must none))

-- Seek, tell, status
--------------------------------------------------------------------------------

-- (a chunk read, as text)
textOf : Either FileError Bytes -> String
textOf (Right b) = toString b
textOf (Left err) = err.name

-- | Sought in and told where it is; read, then written where it was read
-- | up to.
seeking : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : fs <: e}}
        -> String
        -> Co e Unit
seeking dir = do
  let path = dir ^ "/seek.txt"
  writeFile path "hello, world\nsecond line\n"
  h <- openFile path { access = ReadWrite }
  a <- seek (must h) FromStart 7
  w <- readChunk (must h) 5
  t <- tell (must h)
  print ("sought to " ^ show (must a) ^ ", read " ^ textOf w ^ ", now at " ^ show (must t))
  e <- seek (must h) FromEnd -5
  l <- readLine (must h)
  c <- seek (must h) FromCurrent -12
  m <- readLine (must h)
  print ("from the end " ^ show (must e) ^ ": " ^ show (must l) ^ "; back 12: " ^ show (must m))
  s <- seek (must h) FromStart 0
  first <- readChunk (must h) 2
  x <- writeString (must h) "XY"
  closeFile (must h)
  after <- readFile path
  print ("written after a read: " ^ show after)

-- | What the system says of a file, a directory and a link, and when a
-- | file was modified.
status : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : fs <: e}}
       -> String
       -> Co e Unit
status dir = do
  let path = dir ^ "/seek.txt"
  s <- stat path
  d <- stat dir
  print ("stat: " ^ showKindOf s ^ " of " ^ show (must s).size ^ " bytes; " ^ showKindOf d)
  ln <- linkStat (dir ^ "/link")
  lf <- stat (dir ^ "/link")
  real <- realPath (dir ^ "/link")
  print ("a link: " ^ showKindOf ln ^ ", to a " ^ showKindOf lf ^ ", resolved: " ^ (if endsWith "/target.txt" (must real) then "target.txt" else must real))
  h <- openFile path { access = Read }
  hs <- statHandle (must h)
  closeFile (must h)
  print ("an open file's: " ^ showKindOf hs ^ " of " ^ show (must hs).size ^ " bytes")
  again <- stat path
  writeFile path "changed"
  later <- stat path
  print ("modified: untouched the same " ^ show ((must again).modified == (must s).modified) ^ ", written not earlier " ^ show ((must later).modified >= (must s).modified) ^ ", since the epoch " ^ show ((must s).modified > 1000000000000000000))
  isF <- isFile path
  isD <- isDirectory dir
  notD <- isDirectory path
  missing <- exists (dir ^ "/missing")
  k <- kindAt (dir ^ "/missing")
  print ("what a path is: " ^ show isF ^ " " ^ show isD ^ " " ^ show notD ^ " " ^ show missing ^ " " ^ maybe "nothing" showKind k)

-- Modes, temporary files
--------------------------------------------------------------------------------

-- | A mode set, a file made executable, a directory read-only and
-- | writable again.
modes : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : fs <: e}}
      -> String
      -> Co e Unit
modes dir = do
  let path = dir ^ "/mode.sh"
  writeFile path "#!/bin/sh\n"
  a <- setMode path 0x1a4
  s <- stat path
  x <- makeExecutable path
  t <- stat path
  print ("modes: " ^ octal (must s).mode ^ ", executable " ^ octal (must t).mode)
  mkDir (dir ^ "/locked/in")
  ro <- readOnly (dir ^ "/locked")
  r <- stat (dir ^ "/locked")
  w <- writable (dir ^ "/locked")
  v <- stat (dir ^ "/locked")
  made <- writeFile (dir ^ "/locked/in/x") "x"
  print ("read-only " ^ octal (and (must r).mode 0x1ff) ^ ", writable again " ^ octal (and (must v).mode 0x1c0) ^ ", written in " ^ show made)

-- | A temporary directory and a temporary file, each new.
temporary : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : fs <: e}}
          -> Co e Unit
temporary = do
  a <- tempDirectory "heff-files-"
  b <- tempDirectory "heff-files-"
  isD <- isDirectory (must a)
  names <- readDir (must a)
  print ("temporary directories: " ^ show isD ^ ", empty " ^ show names ^ ", each new " ^ show (must a /= must b) ^ ", named " ^ show (contains "heff-files-" (must a)))
  t <- tempFile "heff-file-"
  let file = snd (must t)
  w <- writeString file "kept for a while"
  s <- seek file FromStart 5
  r <- readChunk file 100
  closeFile file
  print ("a temporary file: " ^ textOf r ^ ", there " ^ show (contains "heff-file-" (fst (must t))))
  remove (must a)
  remove (must b)
  gone <- remove (fst (must t))
  print ("removed: " ^ show gone)

-- What fails
--------------------------------------------------------------------------------

-- | What fails is a value: its errno's name.
failures : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : fs <: e}}
         -> String
         -> Co e Unit
failures dir = do
  a <- openFile (dir ^ "/missing/file") { access = Read }
  b <- openFile dir { access = Write }
  c <- openFile dir { access = Read }
  let secret = dir ^ "/secret"
  writeFile secret "no"
  setMode secret 0
  d <- openFile secret { access = Read }
  setMode secret 0x1a4
  x <- openFile secret { access = Write, exclusive = True }
  print ("failed: " ^ failed a ^ " " ^ failed b ^ " " ^ failed c ^ " " ^ failed d ^ " " ^ failed x)
  w <- openFile secret { access = Write }
  r <- readChunk (must w) 10
  closeFile (must w)
  s <- stat (dir ^ "/missing")
  m <- setMode (dir ^ "/missing") 0x1a4
  p <- realPath (dir ^ "/missing")
  onFile <- mkDir secret
  print ("failed too: " ^ failed r ^ " " ^ failed s ^ " " ^ failed m ^ " " ^ failed p ^ ", a directory made where a file is " ^ show onFile)
  print ("said so: " ^ either showFileError (\h -> "opened") a)

-- | The standard output, as an open file, between what std.io writes.
standard : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{disk : fs <: e}}
         -> Co e Unit
standard = do
  print "std.io before"
  o <- stdout
  w <- writeString o "the standard output, a file\n"
  again <- stdout
  print ("std.io after, the same handle " ^ show (sameHandle o again))

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : fs <: e}}
        -> String
        -> Co e Unit
program dir = do
  roundTrip (dir ^ "/round.txt")
  chunks (dir ^ "/large.bin")
  lineReading dir
  seeking dir
  status dir
  modes dir
  temporary
  failures dir
  standard

-- (the first argument)
firstArg : List String -> String
firstArg (a :: _) = a
firstArg Nil = "."

-- | A file used after it is closed: the program fails, as std.handle
-- | says.
afterClose : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : fs <: e}}
           -> String
           -> Co e Unit
afterClose dir = do
  h <- openFile (dir ^ "/closed.txt") { access = Write }
  closeFile (must h)
  print "closed"
  w <- writeString (must h) "never"
  print "never"

-- Standard input
--------------------------------------------------------------------------------

-- (lines and bytes so far)
type Counted = { lines : Int, bytes : Int }

-- (a line counted; `ping` answered at once)
countLine : {e : HFunctor}
          -> {{disk : fs <: e}}
          -> File
          -> Counted
          -> String
          -> Co e Counted
countLine out c line =
  let next : Counted = { lines = c.lines + 1, bytes = c.bytes + strLength line }
  in if line == "ping"
    then bind (writeString out "pong\n") (\w -> pure next)
    else pure next

-- | The standard input, a line at a time, in as little memory as a line
-- | takes.
stdinLines : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{disk : fs <: e}}
           -> Co e Unit
stdinLines = do
  i <- stdin
  o <- stdout
  r <- foldLines i { lines = 0, bytes = 0 } (countLine o)
  print ("lines " ^ show (must r).lines ^ " bytes " ^ show (must r).bytes)

-- (a thread counting to n, a yield at each)
counting : {e : HFunctor} -> {{gr : green <: e}} -> Int -> Int -> Int -> Co e Unit
counting ch n i =
  if i >= n then send ch i
  else bind yield (\u -> counting ch n (i + 1))

-- | A thread reading the standard input, a pipe, while another counts:
-- | the count is written before any of the input comes (the test writes
-- | none until it is).
greenLines : {e : HFunctor}
           -> {{gr : green <: e}}
           -> {{disk : fs <: e}}
           -> Co e Unit
greenLines = do
  i <- stdin
  o <- stdout
  counted <- newChan
  read <- newChan
  spawn (bind (foldLines i 0 (\n l -> pure (n + 1))) (\r -> send read (must r)))
  spawn (counting counted 1000 0)
  n <- recv counted
  writeString o ("counted while the reader waits: " ^ show n ^ "\n")
  m <- recv read
  writeString o ("read: " ^ show m ^ " lines\n")
  pure MkUnit

-- The programs
--------------------------------------------------------------------------------

main : Co world Unit
main = do
  as <- args (ev := \p -> InR (InR (InR p)))
  program (io := \p -> InL p) (disk := \p -> InR (InL p)) (firstArg as)

closed : Co world Unit
closed = do
  as <- args (ev := \p -> InR (InR (InR p)))
  afterClose (io := \p -> InL p) (disk := \p -> InR (InL p)) (firstArg as)

linesMain : Co world Unit
linesMain = stdinLines (io := \p -> InL p) (disk := \p -> InR (InL p))

greenMain : Co world Unit
greenMain = do
  r <-
    Reactor.scheduled
      world
      (rx := \p -> InR (InR (InL p)))
      (greenLines (gr := \p -> InL p) (disk := \p -> InR (InR (InL p))))
  print (ev := \p -> InL p) (maybe "a deadlock" (\u -> "main done") r)
