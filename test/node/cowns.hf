-- Behaviours, by boc, the runtime's effect, on the C backend's threads:
-- the program of test/node/cowns-program.hf, its lines said by its last
-- behaviour.

module test.node.cowns

import boc as BOC
import co
import custodian as Custodian
import std.io
import std.process as Process
import test.node.cowns-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{pr : Process.process <: e}}
        -> Co e Unit
program = do
  cores <- Process.processors
  Program.said cores printed

-- | on the system's threads, a custodian current in each body
main : Co (BOC.boc <+> Custodian.custodian <+> stdio <+> Process.process) Unit
main = program
