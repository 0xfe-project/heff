-- Behaviours, by boc on std.domain, on the C backend's threads: the
-- program of test/node/cowns-program.hf, its lines said.

module test.node.cowns

import co
import custodian as Custodian
import std.domain as Domain
import std.io
import test.node.cowns-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Unit
program = do
  ls <- Program.said (dm := _) (cu := _)
  printed ls

-- | on the system's threads
main : Co (stdio <+> Domain.domain <+> Custodian.custodian) Unit
main = program (io := _) (dm := _) (cu := _)
