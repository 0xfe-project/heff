-- Behaviours, by boc on std.domain, on the C backend's threads: the
-- program of test/node/cowns-program.hf, its lines said.

module test.node.cowns

import boc as BOC
import co
import std.domain as Domain
import std.io
import test.node.cowns-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- BOC.scheduled (Program.said (w := e) (bc := _) (dm := _))
  printed ls

-- | on the system's threads
main : Co (stdio <+> Domain.domain) Unit
main = program (io := _) (dm := _)
