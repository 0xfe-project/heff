-- A program: a string is bytes, crossing to the
-- system and back the same on every backend.  What is read from stdin
-- -- any bytes, UTF-8 or not -- is written out as it is, to stdout and
-- to a file whose name is not ASCII, and read back as it was; read as
-- runes, what is not UTF-8 in it is U+FFFD.  The arguments and the
-- environment are names, text: what is not UTF-8 in them is U+FFFD.  A
-- directory's names are its bytes; a path with a NUL in it is none.

module test.node.bytes

import co
import exception
import rune as Rune
import std.filesystem
import std.io
import std.path as Path
import std.process

world : HFunctor
world = stdio <+> process <+> filesystem

hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

-- (from `i`, each byte in hexadecimal, after `acc`)
hexFrom : String -> Int -> String -> String
hexFrom s i acc =
  if i >= strLength s then acc
  else hexFrom s (i + 1) (acc ^ hexDigit (byteAt s i / 16) ^ hexDigit (byteAt s i % 16))

-- | its bytes, in hexadecimal
hexOf : String -> String
hexOf s = hexFrom s 0 ""

yes : Bool -> String
yes True = "yes"
yes False = "no"

-- | what the file `dir`/`name` read back is: what was written, or not
sameBack : Bool -> String -> Maybe String -> String
sameBack True input (Just back) = if strEq back input then "same" else "not same"
sameBack True input Nothing = "not read"
sameBack False input back = "not written"

-- | whether an operation of the files was done (what it threw heard)
did : {e : HFunctor}
    -> {{fx : exception FileError <: e}}
    -> Co e Unit
    -> Co e Bool
did c = recover (bind c (\_ -> pure True)) (\(_ : FileError) -> pure False)

-- | what an operation of the files gave, if it gave anything
got : {e : HFunctor}
    -> {a : Type}
    -> {{fx : exception FileError <: e}}
    -> Co e a
    -> Co e (Maybe a)
got c = recover (bind c (\x -> pure (Just x))) (\(_ : FileError) -> pure Nothing)

-- | the input, into a file of `dir` and back; the directory's names; and
-- | a path with a NUL in it
files : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> String
      -> String
      -> Co e Unit
files dir input = do
  written <- did (writeFile (dir ^ "/bytes-\u{e9}\u{1F600}.bin") input)
  back <- got (readFile (dir ^ "/bytes-é😀.bin"))
  print ("file: " ^ sameBack written input back)
  names <- got (readDirectory dir)
  print
    ("names: "
     ^ maybe
         "none"
         (\ps -> joinWith " " (List.map (\p -> hexOf (Path.basename p)) ps))
         names)
  nul <- did (writeFile (dir ^ "/a" ^ fromByte 0 ^ "b") input)
  print ("a NUL in a path, written: " ^ yes nul)
  nulRead <- got (readFile (dir ^ "/bytes-é😀.bin" ^ fromByte 0))
  print ("a NUL in a path, read: " ^ yes (maybe False (\_ -> True) nulRead))

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> Co e Unit
program = do
  input <- readStdin
  write input
  print ""
  print
    (show (strLength input)
     ^ " bytes, "
     ^ show (Rune.count input)
     ^ " runes, UTF-8: "
     ^ yes (Rune.validString input))
  print ("as text: " ^ hexOf (Rune.toValid input))
  argv <- args
  case argv of
    Nil -> printErr "no directory given"
    Cons dir rest -> do
      files dir input
      print ("arguments: " ^ joinWith " " (List.map hexOf rest))
  v <- getEnv "HEFF_BYTES"
  print ("environment: " ^ maybe "none" hexOf v)

-- where the world is: each sub-effect's evidence, given, and a failure of
-- the files no operation heard said
main : Co world Unit
main =
  bind
    (attempt
       FileError
       (program
          (io := _)
          (sys := _)
          (disk := _)
          (fx := \p -> InL p)))
    (either
       (\err -> printErr (ev := _) (showFileError err))
       (\_ -> pure MkUnit))
