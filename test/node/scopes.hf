-- Scopes of domains, by std.domain, on the C backend's threads: the
-- program the scopes' tests share, its lines said.

module test.node.scopes

import co
import std.domain as Domain
import std.io
import test.node.scopes-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- Program.said
  printed ls

-- | on the system's threads
main : Co (stdio <+> Domain.domain) Unit
main = program (io := _) (dm := _)
