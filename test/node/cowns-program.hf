-- What the tests of `boc` run, on every backend: the same program, by
-- boc on std.domain, on the C backend's threads (test/node/cowns.hf)
-- and in JavaScript's one domain (test/apps/cowns.hf), the same lines
-- said.  A counter many behaviours add to; money moved round accounts,
-- two cowns a behaviour; behaviours on one cown in the order they were
-- spawned; a behaviour spawned in a behaviour's body, on its cown and
-- another; a behaviour that fails among others on its cown; one
-- spawned on a free cown in a body that goes on long after; behaviours
-- waiting (`with ... where`) until their condition holds, and one whose
-- condition never does; a `with` whose name holds two cowns.  Each is
-- run by a `scheduled` of its own, and what its cowns
-- hold at the end is read out by a last behaviour on them, into a cell
-- read once `scheduled` is done.

module test.node.cowns-program

import boc as BOC
import co
import custodian as Custodian
import std.domain as Domain

-- (what the cowns hold once every behaviour before is done: written by
-- a behaviour of its own, spawned after them, to a cell for main to
-- read)
readOut : {c : Type}
        -> {e : HFunctor}
        -> c
        -> {{cw : BOC.Cowns c}}
        -> {{bc : BOC.boc cw.World <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: cw.World}}
        -> cw.Contents
        -> Co e (Domain.Atomic cw.Contents)
readOut cs first = do
  out <- Domain.newAtomic first
  BOC.when cs (\v -> do
    Domain.set out v
    pure v)
  pure out

-- (`k` behaviours, each adding 1, a `with` of the cown)
adding : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> BOC.Cown w Int
       -> Int
       -> Co e Unit
adding c 0 = pure ()
adding c k = do
  with n := c do
    n := n + 1
  adding c (k - 1)

-- | 1000 behaviours on one cown, each adding 1
counted : {e w : HFunctor}
        -> {{bc : BOC.boc w <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: w}}
        -> Co e (Domain.Atomic Int)
counted = do
  c <- BOC.newCown 0
  adding c 1000
  readOut c 0

-- (`n` moved from one account to the next: a behaviour on both, a
-- `with` of the two)
moved : {e w : HFunctor}
      -> {{bc : BOC.boc w <: e}}
      -> BOC.Cown w Int
      -> BOC.Cown w Int
      -> Int
      -> Co e Unit
moved from to n = do
  with x := from
       y := to do
    x := x - n
    y := y + n

-- (`k` rounds of moves round the four accounts, `i` from the round
-- number)
rounds : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> BOC.Cown w Int
       -> BOC.Cown w Int
       -> BOC.Cown w Int
       -> BOC.Cown w Int
       -> Int
       -> Co e Unit
rounds a b c d 0 = pure ()
rounds a b c d k = do
  moved a b 1
  moved b c 2
  moved c d 3
  moved d a 4
  moved a c 1
  rounds a b c d (k - 1)

-- | four accounts of 100, 250 rounds of moves among them: what each
-- | has
accounts : {e w : HFunctor}
         -> {{bc : BOC.boc w <: e}}
         -> {{dm : Domain.domain <: e}}
         -> {{dmw : Domain.domain <: w}}
         -> Co e (Domain.Atomic (Int, Int, Int, Int))
accounts = do
  a <- BOC.newCown 100
  b <- BOC.newCown 100
  c <- BOC.newCown 100
  d <- BOC.newCown 100
  rounds a b c d 250
  readOut (a, b, c, d) (0, 0, 0, 0)

-- (behaviours `i` to `n`, each putting its number on the list)
logged : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> BOC.Cown w (List Int)
       -> Int
       -> Int
       -> Co e Unit
logged c i n =
  if i > n then pure ()
  else do
    BOC.when c (\xs -> pure (i :: xs))
    logged c (i + 1) n

-- | 100 behaviours on one cown, each putting its number on a list: in
-- | the order they were spawned
ordered : {e w : HFunctor}
        -> {{bc : BOC.boc w <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: w}}
        -> Co e (Domain.Atomic (List Int))
ordered = do
  c <- BOC.newCown Nil
  logged c 1 100
  readOut c Nil

-- (the body of a behaviour on `a`: one on `a` and `b` spawned, which
-- comes after it on `a`, and after that one on both, reading out what
-- they hold then; 1 added)
spawning : {e w : HFunctor}
         -> {{bc : BOC.boc w <: e}}
         -> {{dm : Domain.domain <: e}}
         -> {{dmw : Domain.domain <: w}}
         -> BOC.Cown w Int
         -> BOC.Cown w Int
         -> Domain.Atomic (Int, Int)
         -> Int
         -> Co e Int
spawning a b out x = do
  BOC.when (a, b) (\(x, y) -> pure (x * 2, y + 1))
  BOC.when (a, b) (\v -> do
    Domain.set out v
    pure v)
  pure (x + 1)

-- | a behaviour on `a` spawning one on `a` and `b`, which comes after
-- | it on `a`: 1 then doubled, and 1 added to `b` of 5.  Read out by
-- | a behaviour spawned in the body after it: one spawned by main
-- | would come before the one spawned in the body
nested : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> {{dm : Domain.domain <: e}}
       -> {{dmw : Domain.domain <: w}}
       -> Co e (Domain.Atomic (Int, Int))
nested = do
  a <- BOC.newCown 0
  b <- BOC.newCown 5
  out <- Domain.newAtomic (0, 0)
  BOC.when a (spawning a b out)
  pure out

-- (behaviour `i` of `n` on the cown of the turn and the numbers come:
-- waiting until the turn is its own, then its number put on the list
-- and the turn the next's; the last says the list)
turned : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> {{dmw : Domain.domain <: w}}
       -> BOC.Cown w (Int, List Int)
       -> Domain.Atomic (List Int)
       -> Int
       -> Int
       -> Co e Unit
turned c out n i = do
  with t := c
    where fst t == i
  do
    t := (i + 1, i :: snd t)
    if i == n then Domain.set out (List.reverse (snd t)) else pure ()

-- (behaviours `i` down to 1, spawned in that order)
turnsFrom : {e w : HFunctor}
          -> {{bc : BOC.boc w <: e}}
          -> {{dmw : Domain.domain <: w}}
          -> BOC.Cown w (Int, List Int)
          -> Domain.Atomic (List Int)
          -> Int
          -> Int
          -> Co e Unit
turnsFrom c out n 0 = pure ()
turnsFrom c out n i = do
  turned c out n i
  turnsFrom c out n (i - 1)

-- | five behaviours on one cown, spawned the last first, each waiting
-- | (`where`) for its turn: their numbers in the order of the turns
inTurn : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> {{dm : Domain.domain <: e}}
       -> {{dmw : Domain.domain <: w}}
       -> Co e (Domain.Atomic (List Int))
inTurn = do
  c <- BOC.newCown (1, Nil)
  out <- Domain.newAtomic Nil
  turnsFrom c out 5 5
  pure out

-- | a behaviour on two cowns waiting until the first holds more than
-- | 0, its condition reading it alone: 1 added to the second meanwhile,
-- | then 2 set in the first; it adds the first to the second, and says
-- | what they hold then
waitingOnOne : {e w : HFunctor}
             -> {{bc : BOC.boc w <: e}}
             -> {{dm : Domain.domain <: e}}
             -> {{dmw : Domain.domain <: w}}
             -> Co e (Domain.Atomic (Int, Int))
waitingOnOne = do
  x <- BOC.newCown 0
  y <- BOC.newCown 0
  out <- Domain.newAtomic (0, 0)
  with a := x
       b := y
    where a > 0
  do
    b := b + a
    Domain.set out (a, b)
  with b := y do
    b := b + 1
  with a := x do
    a := 2
  pure out

-- | a behaviour whose condition never holds: let go of each time the
-- | cown is written, and dropped once every other behaviour is done --
-- | its body never run, and `scheduled` ends
neverHeld : {e w : HFunctor}
          -> {{bc : BOC.boc w <: e}}
          -> {{dm : Domain.domain <: e}}
          -> {{dmw : Domain.domain <: w}}
          -> Co e (Domain.Atomic Bool)
neverHeld = do
  c <- BOC.newCown 0
  ran <- Domain.newAtomic False
  with n := c
    where n < 0
  do
    Domain.set ran True
  adding c 3
  pure ran

-- | a `with` of four cowns by three names, the middle one bound to two
-- | of them, its body setting that name alone: both of its cowns
-- | written, the others not
spread : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> {{dm : Domain.domain <: e}}
       -> {{dmw : Domain.domain <: w}}
       -> Co e (Domain.Atomic (Int, Int, Int, Int))
spread = do
  c0 <- BOC.newCown 0
  c1 <- BOC.newCown 0
  c2 <- BOC.newCown 0
  c3 <- BOC.newCown 0
  with a := c0
       b := (c1, c2)
       c := c3 do
    b := (1, 2)
  readOut (c0, c1, c2, c3) (0, 0, 0, 0)

-- (`why` pushed onto what `whys` holds, by a `cas` retried)
reported : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> Domain.Atomic (List String)
         -> String
         -> Co e Unit
reported whys why = do
  old <- Domain.get whys
  ok <- Domain.cas whys old (why :: old)
  if ok then pure () else reported whys why

-- | three behaviours on one cown of 0: 1 added, the second abandons,
-- | 1 added -- the one that failed leaves the cown as it was, the
-- | others run, and read out to the cell given back: 2, and how many
-- | failures `whys` held then, the one before them reported by then
failing : {e w : HFunctor}
        -> {{bc : BOC.boc w <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: w}}
        -> Domain.Atomic (List String)
        -> Co e (Domain.Atomic (Int, Int))
failing whys = do
  c <- BOC.newCown (0 : Int)
  out <- Domain.newAtomic (0, 0)
  BOC.when c (\n -> pure (n + 1))
  BOC.when c (\n -> if n == 1 then abandon else pure (n + 100))
  BOC.when c (\n -> pure (n + 1))
  BOC.when c (\n -> do
    seen <- Domain.get whys
    Domain.set out (n, List.length seen)
    pure n)
  pure out

-- (how many operations at most the long body does)
longBound : Int
longBound = 100000

-- (the long body's operations from the `i`th: each counted in `done`,
-- until the behaviour it spawned has run, which writes the count it
-- saw to `seenAt`, or `longBound` are done)
counting : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> Domain.Atomic Int
         -> Domain.Atomic Int
         -> Int
         -> Co e Unit
counting done seenAt i =
  if i >= longBound then pure ()
  else do
    seen <- Domain.get seenAt
    if seen >= 0 then pure ()
    else do
      Domain.set done (i + 1)
      counting done seenAt (i + 1)

-- (the body of a behaviour on `a`: one on the free `b` spawned, which
-- its domain keeps to run next, and after it many operations, until
-- that one has run)
longBody : {e w : HFunctor}
         -> {{bc : BOC.boc w <: e}}
         -> {{dm : Domain.domain <: e}}
         -> {{dmw : Domain.domain <: w}}
         -> BOC.Cown w Int
         -> Domain.Atomic Int
         -> Domain.Atomic Int
         -> Int
         -> Co e Int
longBody b done seenAt x = do
  BOC.when b (\y -> do
    n <- Domain.get done
    Domain.set seenAt n
    pure (y + 1))
  counting done seenAt 0
  pure x

-- | a behaviour spawned on a free cown in a body that goes on long
-- | after: kept by the body's domain, and let out to another, where
-- | one is, before the body ends.  What `done` was when it ran is
-- | written to the cell given back, -1 until then
kept : {e w : HFunctor}
     -> {{bc : BOC.boc w <: e}}
     -> {{dm : Domain.domain <: e}}
     -> {{dmw : Domain.domain <: w}}
     -> Co e (Domain.Atomic Int)
kept = do
  a <- BOC.newCown 0
  b <- BOC.newCown 0
  done <- Domain.newAtomic 0
  seenAt <- Domain.newAtomic (0 - 1)
  BOC.when a (longBody b done seenAt)
  pure seenAt

-- | what the program says, line by line: each part run by a
-- | `scheduled` of its own, its cell read once every behaviour is done
said : {e : HFunctor}
     -> {{dm : Domain.domain <: e}}
     -> {{cu : Custodian.custodian <: e}}
     -> Co e (List String)
said = do
  whys <- Domain.newAtomic (Nil : List String)
  failedOut <- BOC.scheduled (reported whys) (failing (bc := _) (dm := _) whys)
  (f, failedBefore) <- Domain.get failedOut
  failures <- Domain.get whys
  unreported <- Domain.newAtomic (Nil : List String)
  outcome <-
    Domain.tried
      (BOC.scheduled
         (\why -> abandon)
         (failing (bc := _) (dm := _) unreported))
  nOut <- BOC.scheduled (\why -> abandon) (counted (bc := _) (dm := _))
  n <- Domain.get nOut
  heldOut <- BOC.scheduled (\why -> abandon) (accounts (bc := _) (dm := _))
  (p, q, r, s) <- Domain.get heldOut
  xsOut <- BOC.scheduled (\why -> abandon) (ordered (bc := _) (dm := _))
  xs <- Domain.get xsOut
  pairOut <- BOC.scheduled (\why -> abandon) (nested (bc := _) (dm := _))
  (x, y) <- Domain.get pairOut
  seenOut <- BOC.scheduled (\why -> abandon) (kept (bc := _) (dm := _))
  seen <- Domain.get seenOut
  turnsOut <- BOC.scheduled (\why -> abandon) (inTurn (bc := _) (dm := _))
  turns <- Domain.get turnsOut
  oneOut <- BOC.scheduled (\why -> abandon) (waitingOnOne (bc := _) (dm := _))
  (oa, ob) <- Domain.get oneOut
  neverOut <- BOC.scheduled (\why -> abandon) (neverHeld (bc := _) (dm := _))
  never <- Domain.get neverOut
  spreadOut <- BOC.scheduled (\why -> abandon) (spread (bc := _) (dm := _))
  (s0, s1, s2, s3) <- Domain.get spreadOut
  cores <- Domain.cores
  pure
      [ "added by 1000: " ^ debug n
      , "accounts: " ^ unwords (List.map debug [p, q, r, s, p + q + r + s])
      , "in the order spawned: "
      ^ (if List.reverse xs == List.range 1 100 then "yes" else "no")
      , "nested: " ^ debug x ^ " " ^ debug y
      , "a failing behaviour: "
      ^ debug f
      ^ " added by the others, failed "
      ^ unwords failures
      ^ (if failedBefore == 1 then ", before the next ran"
         else ", after the next ran")
      , "a failed that fails: scheduled "
      ^ (case outcome of
         Left why -> why
         Right u -> "gave an answer")
      , "kept in a long body's slot: "
      ^ (if seen >= 0 then "run" else "not run")
      ^ (if cores == 1 || seen < longBound
         then ", before its end where another domain is"
         else ", only after its end")
      , "waiting for their turns: " ^ unwords (List.map debug turns)
      , "waiting on one of two: " ^ debug oa ^ " " ^ debug ob
      , "a condition never holding: "
      ^ (if never then "its body ran" else "its body never ran")
      , "a name holding two cowns: " ^ unwords (List.map debug [s0, s1, s2, s3])
      ]
