-- cml's threads waiting on the world through each domain's reactor
-- (`with _ := CML.threadsWithReactor do`), by C alone: many threads
-- sleeping at once, more than there are domains, done in about one
-- sleep's time, not one after another; a `choose` between a channel
-- nobody sends on and a sleep, the sleep committed; one between a
-- channel sent on soon and a long sleep, the channel committed and the
-- sleep let go of -- the program not waiting for it -- the sleep's
-- branch told by its nack; and a thread waiting on the world, the
-- others all waiting, which is no deadlock.

module test.node.cml-reactor

import cml as CML
import co
import std.domain as Domain
import std.duration as Duration
import std.io
import std.reactor as Reactor
import std.time as Time

-- (milliseconds since `t0`, of the clock that only goes forward)
since : {e : HFunctor} -> {{tm : Time.time <: e}} -> Int -> Co e Int
since t0 = do
  t <- Time.monotonic
  pure (Duration.totalNanoseconds t / 1000000 - t0)

-- (now, in milliseconds of the clock that only goes forward)
nowMs : {e : HFunctor} -> {{tm : Time.time <: e}} -> Co e Int
nowMs = since 0

-- (threads `k` down to 1, each sleeping `ms` and then saying so on `ch`)
sleepers : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> {{tm : Time.time <: e}}
         -> CML.Chan w Int
         -> Int
         -> Int
         -> Co e Unit
sleepers ch ms 0 = pure ()
sleepers ch ms k = do
  CML.spawn (do
    Time.sleep (Duration.milliseconds ms)
    CML.send ch k)
  sleepers ch ms (k - 1)

-- (`k` received, summed)
summed : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> CML.Chan w Int
       -> Int
       -> Co e Int
summed ch 0 = pure 0
summed ch k = do
  v <- CML.recv ch
  rest <- summed ch (k - 1)
  pure (v + rest)

-- | 64 threads each sleeping 300 ms: their numbers summed, and whether
-- | it took less than four sleeps' time
slept : {e w : HFunctor}
      -> {{cm : CML.cml w <: e}}
      -> {{tm : Time.time <: e}}
      -> Co e (Int, Bool)
slept = do
  t0 <- nowMs
  ch <- CML.newChan
  sleepers ch 300 64
  s <- summed ch 64
  took <- since t0
  pure (s, took < 1200)

-- | a choice between a channel nobody sends on and a sleep of 100 ms
timedOut : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> {{tm : Time.time <: e}}
         -> Co e String
timedOut = do
  nobody <- (CML.newChan : Co e (CML.Chan w String))
  CML.choose
    [ CML.recv nobody
    , do
      Time.sleep (Duration.milliseconds 100)
      pure "timed out"
    ]

-- | a choice between a channel a thread sends on after 50 ms and a sleep
-- | of 5 s, in a branch with a nack: what came, whether the sleep's
-- | branch was told, and whether it took less than a second
notTimedOut : {e w : HFunctor}
            -> {{cm : CML.cml w <: e}}
            -> {{tm : Time.time <: e}}
            -> Co e (String, Bool, Bool)
notTimedOut = do
  t0 <- nowMs
  ch <- CML.newChan
  told <- CML.newIVar
  CML.spawn (do
    Time.sleep (Duration.milliseconds 50)
    CML.send ch "sent")
  x <-
    CML.choose
      [ CML.recv ch
      , CML.withNack (\nack -> do
          CML.spawn (do
            nack
            CML.putIVar told True)
          Time.sleep (Duration.seconds 5)
          pure "timed out")
      ]
  seen <- CML.readIVar told
  took <- since t0
  pure (x, seen, took < 1000)

-- | main waiting on a sleep, every other thread waiting on a channel:
-- | main's answer, no deadlock
waitingOnTheWorld : {e w : HFunctor}
                  -> {{cm : CML.cml w <: e}}
                  -> {{tm : Time.time <: e}}
                  -> Co e Int
waitingOnTheWorld = do
  a <- (CML.newChan : Co e (CML.Chan w Int))
  CML.spawn (do
    _ <- CML.recv a
    pure ())
  Time.sleep (Duration.milliseconds 50)
  pure 7

-- | what the program says, line by line
said : {e w : HFunctor}
     -> {{cm : CML.cml w <: e}}
     -> {{tm : Time.time <: e}}
     -> Co e (List String)
said = do
  s <- slept
  t <- timedOut
  n <- notTimedOut
  w <- waitingOnTheWorld
  pure
      [ "slept: " ^ debug (fst s) ^ (if snd s then ", at once" else ", one after another")
      , "timed out: " ^ t
      , "not timed out: "
      ^ fst (fst n)
      ^ (if snd (fst n) then ", the sleep told" else ", the sleep not told")
      ^ (if snd n then ", soon" else ", late")
      , "waiting on the world: " ^ debug w
      ]

printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{tm : Time.time <: e}}
        -> Co e Unit
program = do
  r <-
    with _ := CML.threadsWithReactor do
      said (w := e)
  case r of
    Just ls -> printed ls
    Nothing -> print "every thread waiting"

main : Co (stdio <+> Domain.domain <+> Reactor.reactor <+> Time.time) Unit
main = program (io := _) (dm := _) (rx := _) (tm := _)
