-- A `for` over a range whose body sets a variable under an `if` with no
-- `else`: the range's cursor, bound once and passed on by both ways the
-- `if` takes, is kept as its two numbers round the loop, not a cell
-- built (or reused) on each round.

module test.node.range-cursor

import co
import std.io

-- (the bytes' sum and the spaces)
scan : String -> Pair Int Int
scan s = run do
  let mut acc = 0
  let mut spaces = 0
  for i in range 0 (strLength s - 1) do
    let b = byteAt s i
    acc := acc + b
    if b == 32 then spaces := spaces + 1
  MkPair acc spaces

main : Co stdio Unit
main = do
  let r = scan "hello range cursor"
  print (ev := _) (show (fst r) ^ " " ^ show (snd r))
