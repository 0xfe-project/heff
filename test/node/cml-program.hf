-- What the tests of `cml` run, on every backend: the same program, by
-- cml on std.domain, on the C backend's threads (test/node/cml.hf) and
-- in JavaScript's one domain (test/apps/cml.hf), the same lines said.
-- Ping-pong over two channels; many senders and one receiver, their
-- sum; a choice between two channels with a sender on one, the other
-- branch told it was not chosen; the same, a choice in a choice; what
-- a branch does before its base event, run each time; a wrap; an
-- ivar read by several threads; a choice between two events both
-- ready, synced many times, each chosen at least once (no fixed
-- priority); a thread going on step after step, which gives its turn,
-- once its fuel is used, to the one it readied; and a program whose
-- threads all wait, scheduled, coming to `Nothing`; and a scheduler's
-- scope, `with _ := CML.threads do`, its threads done with its body.

module test.node.cml-program

import cml as CML
import co
import std.domain as Domain

-- Ping-pong -----------------------------------------------------------------------------

-- (what comes on `a`, one more, sent on `b`, for ever)
ponger : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> CML.Chan w Int
       -> CML.Chan w Int
       -> Co e Unit
ponger a b = do
  x <- CML.recv a
  CML.send b (x + 1)
  ponger a b

-- | 0 sent to a thread on one channel, and 1 back on another
pinged : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
pinged = do
  a <- CML.newChan
  b <- CML.newChan
  CML.spawn (ponger a b)
  CML.send a 0
  CML.recv b

-- Many senders, one receiver ---------------------------------------------------------

-- (threads `k` down to 1, each sending its number)
senders : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> CML.Chan w Int
        -> Int
        -> Co e Unit
senders ch 0 = pure ()
senders ch k = do
  CML.spawn (CML.send ch k)
  senders ch (k - 1)

-- (`k` values received, in the order they come)
received : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> CML.Chan w Int
         -> Int
         -> Co e (List Int)
received ch 0 = pure Nil
received ch k = do
  v <- CML.recv ch
  vs <- received ch (k - 1)
  pure (v :: vs)

-- | 100 threads each sending its number, 1 to 100, to one receiver:
-- | their sum
summed : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
summed = do
  ch <- CML.newChan
  senders ch 100
  xs <- received ch 100
  pure (List.sum xs)

-- A choice, and the branch not chosen told --------------------------------------------

-- | a choice between two channels, a sender on the first alone: what
-- | came on it, and whether the second branch's nack was seen by the
-- | thread waiting on it
chosen : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e (String, Bool)
chosen = do
  a <- CML.newChan
  b <- (CML.newChan : Co e (CML.Chan w Int))
  nackSeen <- CML.newIVar
  CML.spawn (CML.send a 1)
  x <-
    CML.choose
      [ do
        v <- CML.recv a
        pure ("a " ^ debug v)
      , CML.withNack (\nack -> do
          CML.spawn (do
            nack
            CML.putIVar nackSeen True)
          v <- CML.recv b
          pure ("b " ^ debug v))
      ]
  seen <- CML.readIVar nackSeen
  pure (x, seen)

-- A choice in a choice ---------------------------------------------------------------

-- | a choice of a choice (between `a`, its branch with a nack, and `b`)
-- | and `c`, a sender on `b` alone: what came, and whether the branch of
-- | `a`, inside, was told it was not chosen
nested : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e (String, Bool)
nested = do
  a <- (CML.newChan : Co e (CML.Chan w Int))
  b <- CML.newChan
  c <- (CML.newChan : Co e (CML.Chan w Int))
  nackSeen <- CML.newIVar
  CML.spawn (CML.send b 2)
  x <-
    CML.choose
      [ CML.choose
          [ CML.withNack (\nack -> do
              CML.spawn (do
                nack
                CML.putIVar nackSeen True)
              v <- CML.recv a
              pure ("a " ^ debug v))
          , do
            v <- CML.recv b
            pure ("b " ^ debug v)
          ]
      , do
        v <- CML.recv c
        pure ("c " ^ debug v)
      ]
  seen <- CML.readIVar nackSeen
  pure (x, seen)

-- A guard, run at sync time ------------------------------------------------------------

-- | what a branch does before its base event, run each time the
-- | event is, not where it is made: how often it had run before the
-- | first, after it, and after a second
guarded : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e (List Int)
guarded = do
  runs <- Domain.newAtomic 0
  nobody <- (CML.newChan : Co e (CML.Chan w Unit))
  let ev : Co e Unit =
    CML.choose
      [ do
        _ <- Domain.fetchAdd runs 1
        pure MkUnit
      , CML.recv nobody
      ]
  before <- Domain.get runs
  ev
  once <- Domain.get runs
  ev
  twice <- Domain.get runs
  pure [before, once, twice]

-- A wrap ------------------------------------------------------------------------------------

-- | 20 received, and 1 added by what follows the commit point, a
-- | thread spawned there telling main: 21 and the word
wrapped : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
wrapped = do
  a <- CML.newChan
  b <- CML.newChan
  told <- CML.newChan
  CML.spawn (CML.send a 20)
  x <-
    CML.choose
      [ do
        v <- CML.recv a
        CML.spawn (CML.send told (v + 1))
        CML.recv told
      , CML.recv b
      ]
  pure x

-- An ivar read by several threads -----------------------------------------------------

-- (a reader: what the ivar holds, times `k`, sent on `out`)
reader : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> CML.IVar w Int
       -> CML.Chan w Int
       -> Int
       -> Co e Unit
reader iv out k = do
  v <- CML.readIVar iv
  CML.send out (v * k)

-- (readers `k` down to 1)
readers : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> CML.IVar w Int
        -> CML.Chan w Int
        -> Int
        -> Co e Unit
readers iv out 0 = pure ()
readers iv out k = do
  CML.spawn (reader iv out k)
  readers iv out (k - 1)

-- | an ivar read by three threads, each sending what it read times its
-- | number, written once they wait: what they sent, sorted
shared : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e (List Int)
shared = do
  iv <- CML.newIVar
  out <- CML.newChan
  readers iv out 3
  CML.putIVar iv 7
  xs <- received out 3
  pure (List.sort xs)

-- A choice among several ready: no fixed priority ---------------------------------------

-- (`k` syncs of a choice between two `always`, both ready: how many
-- times the first was chosen)
firstChosen : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Int -> Co e Int
firstChosen 0 = pure 0
firstChosen k = do
  x <- CML.choose [pure 1, pure 0]
  rest <- firstChosen (k - 1)
  pure (x + rest)

-- | 64 syncs of a choice between two events both ready: whether each
-- | was chosen at least once
bothChosen : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Bool
bothChosen = do
  n <- firstChosen 64
  pure (0 < n && n < 64)

-- Fuel: a thread that goes on gives the others their turns ------------------------------

-- (at most `k` syncs of a choice between the ivar `stop` read and an
-- `always`, until the ivar is read: whether it was, before the syncs
-- ran out)
goneOn : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> CML.IVar w Unit
       -> Int
       -> Co e Bool
goneOn stop 0 = pure False
goneOn stop k = do
  stopped <-
    CML.choose
      [ do
        CML.readIVar stop
        pure (True : Bool)
      , pure (False : Bool)
      ]
  if stopped then pure True else goneOn stop (k - 1)

-- | a thread spawning one that tells main, kept in the slot of the
-- | worker running the first, which then goes on for 100000 syncs at
-- | most, until main, told, writes an ivar: whether the one it spawned
-- | had its turn meanwhile -- in JavaScript's one domain, by the fuel
-- | of the first alone
fueled : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Bool
fueled = do
  stop <- CML.newIVar
  told <- (CML.newChan : Co e (CML.Chan w Unit))
  answer <- CML.newChan
  CML.spawn (do
    CML.spawn (CML.send told MkUnit)
    stopped <- goneOn stop 100000
    CML.send answer stopped)
  CML.recv told
  CML.putIVar stop MkUnit
  CML.recv answer

-- Every thread waiting ------------------------------------------------------------------

-- | a thread receiving on a channel nobody sends on, and main on
-- | another: a deadlock
blocked : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
blocked = do
  a <- (CML.newChan : Co e (CML.Chan w Int))
  b <- CML.newChan
  CML.spawn (do
    _ <- CML.recv a
    pure ())
  CML.recv b

-- A scheduler's scope -------------------------------------------------------------------

-- | a thread sending main 3, and another waiting to send on a channel
-- | nobody receives on
sentAndLeft : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
sentAndLeft = do
  a <- CML.newChan
  b <- CML.newChan
  CML.spawn (CML.send a 0)
  CML.spawn (CML.send b 3)
  CML.recv b

-- | threads of their own, a `with` inside a thread: the one left waiting
-- | dropped as main is done, the `with` coming to `Just` main's answer,
-- | and the thread around going on
scope : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e (Maybe Int)
scope = do
  with _ := CML.threads do
    sentAndLeft (w := e)

-- | what the program says, line by line
said : {e w : HFunctor}
     -> {{cm : CML.cml w <: e}}
     -> {{dm : Domain.domain <: e}}
     -> Co e (List String)
said = do
  p <- pinged
  s <- summed
  c <- chosen
  n <- nested
  g <- guarded
  wr <- wrapped
  xs <- shared
  both <- bothChosen
  f <- fueled
  d <-
    with _ := CML.threads do
      blocked (w := e)
  sc <- scope
  pure
      [ "pinged: " ^ debug p
      , "summed from 100 senders: " ^ debug s
      , "chosen: " ^ fst c ^ ", b told: " ^ (if snd c then "yes" else "no")
      , "nested: " ^ fst n ^ ", a told: " ^ (if snd n then "yes" else "no")
      , "guard ran: " ^ unwords (List.map debug g)
      , "wrapped: " ^ debug wr
      , "ivar read by 3: " ^ unwords (List.map debug xs)
      , "two always: " ^ (if both then "both chosen" else "one alone")
      , "going on, the one readied ran meanwhile: "
      ^ (if f then "yes" else "no")
      , "all waiting: "
      ^ (case d of
         Just n -> "Just " ^ debug n
         Nothing -> "Nothing")
      , "a scope of threads: "
      ^ (case sc of
         Just n -> "Just " ^ debug n
         Nothing -> "Nothing")
      ]
