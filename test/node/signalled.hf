-- Signals waited for (std.signal), by C alone: the test sends them, as
-- the program says what it waits for, and holds it to what it says and
-- how it ends.
--
--   plain      waits where it is: for SIGWINCH or SIGTERM, then, SIGWINCH
--              come, for SIGTERM, which it stops on
--   boc        behaviours ticking, each after a sleep awaited, while an
--              act awaits SIGTERM or SIGINT: the ticks stop on it, and
--              the program, its behaviours done
--   unawaited  a command started (a shell sleeping), its pid said, then
--              SIGINT waited for: SIGTERM, not waited for, ends the
--              program, and the command with it

module test.node.signalled

import boc as BOC
import co
import custodian as Custodian
import exception
import std.duration as Duration
import std.io
import std.process
import std.signal as Signal
import std.time as Time

-- (a line written now, for the test to see)
said : {e : HFunctor} -> {{io : stdio <: e}} -> String -> Co e Unit
said l = do
  print l
  flush

plain : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sg : Signal.signals <: e}}
      -> Co e Unit
plain = do
  said "waiting"
  s <- Signal.wait [WindowChanged, Terminate]
  print ("got " ^ show s)
  said "waiting for SIGTERM"
  t <- Signal.wait [Terminate]
  print ("stopping on " ^ show t)

-- (a tick every 20 ms, a sleep awaited, the behaviour after it on
-- `ticks` counting it -- "waiting" said at the first, the signals'
-- wait pending by then -- and awaiting the next, until the count is
-- stopped, -1)
ticking : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{tm : Time.time <: e}}
        -> BOC.Cown Int
        -> Co e Unit
ticking ticks = do
  with n := ticks
       u := BOC.await (Time.sleep (Duration.milliseconds 20)) do
    if n >= 0
    then do
      if n == 0 then said "waiting" else pure ()
      n := n + 1
      ticking ticks
    else pure ()

-- (SIGTERM or SIGINT awaited: once it comes, the count stopped, and
-- the signal said)
stopping : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> {{sg : Signal.signals <: e}}
         -> BOC.Cown Int
         -> Co e Unit
stopping ticks = do
  with n := ticks
       s := BOC.await (Signal.wait [Terminate, Interrupt]) do
    n := 0 - 1
    print ("stopping on " ^ show s)

inBoc : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{io : stdio <: e}}
      -> {{tm : Time.time <: e}}
      -> {{sg : Signal.signals <: e}}
      -> Co e Unit
inBoc = do
  ticks <- BOC.newCown 0
  stopping ticks
  ticking ticks

unawaited : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> {{sg : Signal.signals <: e}}
          -> {{cu : Custodian.custodian <: e}}
          -> Co e Unit
unawaited =
  withProcess
    { command = "sh"
    , args = ["-c", "echo $$; exec sleep 30"]
    , output = Piped
    } (\c -> do
      r <- readOutput c (Through "\n") 10000
      case r of
        Got b -> said ("child " ^ trim (bytesToString b))
        _ -> said "no child"
      _ <- Signal.wait [Interrupt]
      print "not here")

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{bc : BOC.boc <: e}}
        -> {{tm : Time.time <: e}}
        -> {{sg : Signal.signals <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Unit
program = do
  given <- args
  case given of
    ["boc"] -> inBoc
    ["unawaited"] -> do
      r <-
        attempt
          ProcessError
          (unawaited
             (e := exception ProcessError <+> e)
             (io := _)
             (sys := _)
             (ex := _)
             (sg := _))
      case r of
        Left err -> print (show err)
        Right u -> pure ()
    _ -> plain

main : Co
       (BOC.boc
        <+> stdio
        <+> process
        <+> Time.time
        <+> Signal.signals
        <+> Custodian.custodian)
       Unit
main = program
