-- std.http.server's `serveConcurrently`, a green thread for each
-- connection, each had by a `with` in its own, scheduled by
-- std.reactor: many clients held open at once, each answered in turn.
-- By C alone.
--
--   main     n clients, each its connection kept: a first request each,
--            all answered while every connection is held open -- which a
--            server of one connection at a time never does -- then a
--            second request each on the same connection
--   burst    PORT: served there until asked for `/stop`, by Node.js's
--            clients, hundreds of connections opened at once: how many
--            requests it answered
--   flat     n connections, one after another, each closed before the
--            next: the objects made while the first few are served and
--            while the last few are (built with `-DHEFF_COUNT_ALLOCS`),
--            about as many -- each connection's thread under no more
--            handlers than the first's

module test.node.green-served

import bench
import bytes as Bytes
import co
import exception
import green
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import resource

world : HFunctor
world = stdio <+> (Net.net <+> Reactor.reactor)

-- (the value of a `Right`; where there is none, the program abandoned:
-- the test's own sockets, which do not fail)
must : {a : Type} -> Either Net.NetError a -> a
must (Right x) = x
must (Left err) = abandon

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

repeatG : {e : HFunctor} -> Int -> Co e Unit -> Co e Unit
repeatG 0 c = pure MkUnit
repeatG n c = bind c (\u -> repeatG (n - 1) c)

-- (n values received on ch, added up)
recvSum : {e : HFunctor} -> {{gr : green <: e}} -> Int -> Int -> Int -> Co e Int
recvSum ch 0 acc = pure acc
recvSum ch n acc = do
  x <- recv ch
  recvSum ch (n - 1) (acc + x)

-- (n bytes read, in as many reads as they take)
readN : {e : HFunctor}
      -> {s : Type}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpStream
      -> Int
      -> Bytes
      -> Co e Bytes
readN c n acc =
  if Bytes.length acc >= n then pure acc
  else bind
      (Net.read c (n - Bytes.length acc))
      (\r -> readN c n (Bytes.append acc (must r)))

-- (each request answered with its target)
answer : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
answer r = pure (Server.plain 200 r.target)

-- (a request for `target` sent on the connection, and its response read:
-- 1 where it is the one wanted)
asked : {e : HFunctor}
      -> {s : Type}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpStream
      -> String
      -> Co e Int
asked c target = do
  w <-
    Net.write
      c
      (Bytes.fromString ("GET " ^ target ^ " HTTP/1.1\r\nHost: x\r\n\r\n"))
  let want = Server.responseBytes "" True (Server.plain 200 target)
  got <- readN c (Bytes.length want) Bytes.empty
  pure (if got == want then 1 else 0)

-- (a client's connection: a first request, its answer said on `back`;
-- then, once main says so on `go`, a second on the same connection:
-- its answer)
clientOn : {e : HFunctor}
         -> {s : Type}
         -> {{gr : green <: e}}
         -> {{nt : Net.net <: e}}
         -> Int
         -> Int
         -> Int
         -> With s Net.TcpStream
         -> Co e Int
clientOn back go i c = do
  first <- asked c ("/" ^ show i ^ "/first")
  send back first
  x <- recv go
  asked c ("/" ^ show i ^ "/second")

-- | A client: a first request, its answer said on `back`; then, once
-- | main says so on `go`, a second on the same connection, which is
-- | closed after, its answer said.
client : {e : HFunctor}
       -> {{gr : green <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> Int
       -> Int
       -> Int
       -> Co e Unit
client port back go i = do
  second <- Net.withConnection (here port) (\c -> clientOn back go i c)
  send back second

-- (the server, a thread of its own, and n clients, each one too)
served : {e : HFunctor}
       -> {s : Type}
       -> {{gr : green <: e}}
       -> {{io : stdio <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> With s Net.TcpListener
       -> Co e Unit
served n l = do
  at <- Net.local l
  spawn (Server.serveConcurrently l answer)
  back <- newChan
  go <- newChan
  repeatG n (bind newChan (\i -> spawn (client (must at).port back go i)))
  first <- recvSum back n 0
  print ("first requests answered, every connection held open: " ^ show first)
  repeatG n (send go 1)
  second <- recvSum back n 0
  print ("second requests answered, on the same connections: " ^ show second)

program : {e : HFunctor}
        -> {{gr : green <: e}}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> Co e Unit
program n = Net.withListener (here 0) 128 (\l -> served n l)

-- (what main came to: a deadlock, a throw no thread heard, or done)
said : Maybe (Either Net.NetError Unit) -> String
said Nothing = "a deadlock"
said (Just (Left err)) = "not heard: " ^ Net.showError err
said (Just (Right u)) = "main done"

main : Co world Unit
main = do
  r <-
    Reactor.scheduled
      world
      (rx := _)
      (attempt
         Net.NetError
         (program
            (gr := _)
            (io := _)
            (nt := _)
            (ex := _)
            40))
  print (ev := _) (said r)

-- Many at once
--------------------------------------------------------------------------------

-- (each request answered with its target, and said on `events`: 1, or
-- 0 for `/stop`)
counting : {e : HFunctor}
         -> {{gr : green <: e}}
         -> Int
         -> Server.Request
         -> Co e HTTP.Response
counting events r = do
  send events (if r.target == "/stop" then 0 else 1)
  pure (Server.plain 200 r.target)

-- (the requests said on `events`, added up, until a 0)
answeredOn : {e : HFunctor} -> {{gr : green <: e}} -> Int -> Int -> Co e Int
answeredOn events n = do
  x <- recv events
  if x == 0 then pure n else answeredOn events (n + x)

burstAt : {e : HFunctor}
        -> {s : Type}
        -> {{gr : green <: e}}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> With s Net.TcpListener
        -> Co e Unit
burstAt l = do
  events <- newChan
  spawn (Server.serveConcurrently l (counting events))
  n <- answeredOn events 0
  print ("answered " ^ show n)

burstProgram : {e : HFunctor}
             -> {{gr : green <: e}}
             -> {{io : stdio <: e}}
             -> {{nt : Net.net <: e}}
             -> {{sys : process <: e}}
             -> {{ex : exception Net.NetError <: e}}
             -> Co e Unit
burstProgram = do
  argv <- args
  let port = fromMaybe 0 (parseInt (fromMaybe "" (List.head argv)))
  Net.withListener (here port) 128 (\l -> burstAt l)

burstWorld : HFunctor
burstWorld = stdio <+> (Net.net <+> (Reactor.reactor <+> process))

burst : Co burstWorld Unit
burst = do
  r <-
    Reactor.scheduled
      burstWorld
      (rx := _)
      (attempt
         Net.NetError
         (burstProgram
            (gr := _)
            (io := _)
            (nt := _)
            (sys := _)
            (ex := _)))
  print (ev := _) (said r)

-- One after another
--------------------------------------------------------------------------------

-- (connections i to n - 1, one after another, each asked once and
-- closed: how many were answered right)
askedEach : {e : HFunctor}
          -> {{nt : Net.net <: e}}
          -> {{ex : exception Net.NetError <: e}}
          -> Int
          -> Int
          -> Int
          -> Int
          -> Co e Int
askedEach port i n acc =
  if i >= n then pure acc
  else bind
      (Net.withConnection (here port) (\c -> asked c ("/" ^ show i)))
      (\ok -> askedEach port (i + 1) n (acc + ok))

-- (the objects made by connections i to n - 1: how many, and how many
-- answered right)
counted : {e : HFunctor}
        -> {{tm : timer <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> Int
        -> Int
        -> Co e (Pair Int Int)
counted port i n = do
  _ <- startTimer 1
  ok <- askedEach port i n 0
  t <- stopTimer RanThrough
  pure (case t of
    MkSample ns objects bytes -> MkPair objects ok)

flatAt : {e : HFunctor}
       -> {s : Type}
       -> {{gr : green <: e}}
       -> {{io : stdio <: e}}
       -> {{tm : timer <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> Int
       -> With s Net.TcpListener
       -> Co e Unit
flatAt n k l = do
  at <- Net.local l
  let port = (must at).port
  spawn (Server.serveConcurrently l answer)
  first <- counted port 0 k
  middle <- askedEach port k (n - k) 0
  last <- counted port (n - k) n
  print ("answered " ^ show (snd first + middle + snd last) ^ " of " ^ show n)
  print
    ("the last "
     ^ show k
     ^ " no costlier than the first: "
     ^ show (fst first > 0 && 2 * fst last <= 3 * fst first))

flatWorld : HFunctor
flatWorld = stdio <+> (timer <+> (Net.net <+> Reactor.reactor))

flat : Co flatWorld Unit
flat = do
  r <-
    Reactor.scheduled
      flatWorld
      (rx := _)
      (attempt
         Net.NetError
         (Net.withListener
            (ev := _)
            (ex := _)
            (here 0)
            128
            (\l -> flatAt (gr := _) (io := _) (tm := _) (nt := _) (ex := _) 300 50 l)))
  print (ev := _) (said r)
