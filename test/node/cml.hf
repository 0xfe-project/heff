-- Threads and channels, by cml on std.domain, on the C backend's
-- threads: the program of test/node/cml-program.hf, its lines said.

module test.node.cml

import cml as CML
import co
import std.domain as Domain
import std.io
import test.node.cml-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  r <-
    with _ := CML.threads do
      Program.said (w := e)
  case r of
    Just ls -> printed ls
    Nothing -> print "every thread waiting"

-- | on the system's threads, the custodian in their world the only one
main : Co (stdio <+> Domain.domain) Unit
main = program (io := _) (dm := _)
