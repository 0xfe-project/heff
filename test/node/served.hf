-- An HTTP server of std.http.bocserver's, by C alone, on 127.0.0.1 at
-- the port the test picked, until it is asked for `/stop`.  `main
-- PORT`: served to the test's clients (node:http, curl, a socket's
-- bytes), each request said on a line as it is handed to the handler,
-- each answered whole.

module test.node.served

import boc as BOC
import bytes as Bytes
import co
import custodian as Custodian
import exception
import std.http as HTTP
import std.http.bocserver as BocServer
import std.io
import std.net as Net
import std.process
import std.time
import uint8 as UInt8
import resource

-- | What a handler throws.
data Thrown = MkThrown

-- (every byte, 0 to 255, `n` times)
bytesOf : Int -> Bytes
bytesOf n =
  Bytes.fromList
    (List.map (\i -> UInt8.fromInt (i % 256)) (List.range 0 (256 * n - 1)))

-- (`b` doubled `n` times)
doubled : Bytes -> Int -> Bytes
doubled b 0 = b
doubled b n = doubled (Bytes.append b b) (n - 1)

-- (what `/big` answers: 4 MiB)
big : Bytes
big = doubled (bytesOf 4) 12

-- (bytes added up)
sumOf : Bytes -> Int
sumOf b = List.foldl (\s c -> s + UInt8.toInt c) 0 (Bytes.toList b)

-- (a body shown: as a binary, `b[...]`, where it is short, else its
-- length and its bytes added up)
showBody : Bytes -> String
showBody b =
  if Bytes.length b <= 64 then debug b
  else debug (Bytes.length b) ^ " bytes, sum " ^ debug (sumOf b)

routed : HTTP.ServerRequest -> HTTP.Response
routed r =
  if strEq r.target "/hello" then HTTP.plain 200 ("hello, " ^ r.method ^ "\n")
  else if strEq r.target "/echo"
  then { status = 200
       , headers =
           [ MkPair "X-Method" r.method
           , MkPair "X-Version" r.version
           , MkPair "X-Peer" r.peer.host
           , MkPair "X-Heff" (fromMaybe "none" (HTTP.requestHeader "x-heff" r))
           ]
       , body = r.body
       }
  else if strEq r.target "/big" then { status = 200, headers = Nil, body = big }
  else if strEq r.target "/close"
  then { status = 200
       , headers = [MkPair "Connection" "close"]
       , body = b["bye"]
       }
  else if strEq r.target "/stop" then HTTP.plain 200 "stopping\n"
  else HTTP.plain 404 "no such thing\n"

-- (each request said, and answered; `/stop` answered, then the
-- listener closed)
answering : {e : HFunctor}
          -> {rg : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> With rg Net.TcpListener
          -> HTTP.ServerRequest
          -> BocServer.Responder e Thrown
          -> Co (exception Thrown <+> e) Unit
answering l r respond = do
  print (r.method ^ " " ^ r.target ^ " " ^ r.version ^ ", " ^ showBody r.body)
  respond (Whole (routed r))
  if strEq r.target "/stop"
  then do
    _ <- Net.closeListener l
    pure ()
  else pure ()

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> {{nt : Net.net <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  argv <- args
  let port = fromMaybe 0 (parseInt (fromMaybe "" (List.head argv)))
  r <-
    Net.withListener
      { host = "127.0.0.1", port = port }
      16
      (\l -> BocServer.serve Thrown l (answering (e := e) l))
  case r of
    Left err -> printErr ("not heard: " ^ show err)
    Right u -> pure ()

-- | served until asked for `/stop`
main : Co
       (BOC.boc
        <+> Custodian.custodian
        <+> stdio
        <+> time
        <+> Net.net
        <+> process)
       Unit
main = program
