-- An HTTP server of std.http.server's, by C alone,
-- on 127.0.0.1 at the port the test picked, until it is asked for
-- `/stop`.  `main PORT`: served to the test's clients (node:http, curl,
-- a socket's bytes), each request said on a line as it is answered.
-- `self`: served, at a port the system picked, to std.http's client in
-- the same program, a thread of its own (std.thread), what the client
-- got said.  `crowded`, run with few descriptors: connected to until
-- there is none left, each connection's `with` inside the one before,
-- then served -- `serveUntil` and `serve` stop at the connection they
-- cannot accept, why thrown and said.

module test.node.served

import bytes as Bytes
import co
import exception
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.thread
import uint8 as UInt8
import resource

-- (every byte, 0 to 255, `n` times)
bytesOf : Int -> Bytes
bytesOf n =
  Bytes.fromList
    (List.map (\i -> UInt8.fromInt (i % 256)) (List.range 0 (256 * n - 1)))

-- (`b` doubled `n` times)
doubled : Bytes -> Int -> Bytes
doubled b 0 = b
doubled b n = doubled (Bytes.append b b) (n - 1)

-- (what `/big` answers: 4 MiB)
big : Bytes
big = doubled (bytesOf 4) 12

-- (bytes added up)
sumOf : Bytes -> Int
sumOf b = List.foldl (\s c -> s + UInt8.toInt c) 0 (Bytes.toList b)

-- (a body shown: as a binary, `b[...]`, where it is short, else its
-- length and its bytes added up)
showBody : Bytes -> String
showBody b =
  if Bytes.length b <= 64 then debug b
  else debug (Bytes.length b) ^ " bytes, sum " ^ debug (sumOf b)

routed : Server.Request -> HTTP.Response
routed r =
  if strEq r.target "/hello" then Server.plain 200 ("hello, " ^ r.method ^ "\n")
  else if strEq r.target "/echo"
  then { status = 200
       , headers =
           [ MkPair "X-Method" r.method
           , MkPair "X-Version" r.version
           , MkPair "X-Peer" r.peer.host
           , MkPair "X-Heff" (fromMaybe "none" (Server.header "x-heff" r))
           ]
       , body = r.body
       }
  else if strEq r.target "/big" then { status = 200, headers = Nil, body = big }
  else if strEq r.target "/close"
  then { status = 200
       , headers = [MkPair "Connection" "close"]
       , body = b["bye"]
       }
  else if strEq r.target "/stop" then Server.plain 200 "stopping\n"
  else Server.plain 404 "no such thing\n"

-- (each request said, as it is answered)
said : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> Server.Request
     -> Co e HTTP.Response
said r = do
  print (r.method ^ " " ^ r.target ^ " " ^ r.version ^ ", " ^ showBody r.body)
  pure (routed r)

isStop : Server.Request -> Bool
isStop r = strEq r.target "/stop"

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (a throw no one heard -- the port not listened on, a connection not
-- accepted -- said)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> Either Net.NetError Unit
        -> Co e Unit
unheard (Left err) = printErr ("not heard: " ^ show err)
unheard (Right u) = pure MkUnit

serveAt : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> Co e Unit
serveAt port =
  bind
    (Net.withListener (here port) 16 (\l -> Server.serveUntil isStop l said))
    (either throw pure)

-- Out of descriptors --------------------------------------------------------------

errorName : Maybe Net.NetError -> String
errorName Nothing = "none"
errorName (Just err) = err.name

-- (the server, with no descriptor left for a connection it accepts --
-- `failed` why the last connection was not made -- stopped, why said,
-- not trying again for ever)
noneLeft : {e : HFunctor}
         -> {s : Type}
         -> {{io : stdio <: e}}
         -> {{nt : Net.net <: e}}
         -> {{ex : exception Net.NetError <: e}}
         -> With s Net.TcpListener
         -> Maybe Net.NetError
         -> Co e Unit
noneLeft l failed = do
  print ("connect: " ^ errorName failed)
  try
    Server.serveUntil (\r -> True) l (\r -> pure (routed r))
    print "serveUntil: stopped"
  catch (err : Net.NetError) ->
    print ("serveUntil: " ^ err.name)
  try
    Server.serve l (\r -> pure (routed r))
  catch (err : Net.NetError) ->
    print ("serve: " ^ err.name)

-- (connections made to the port, `made` so far, each had while the next
-- is made and waiting to be accepted, until the program has no
-- descriptor left for one more -- the connection not made, thrown, heard
-- inside those made -- or a hundred are made: the server then tried
-- inside them all)
crowd : {e : HFunctor}
      -> {s : Type}
      -> {{io : stdio <: e}}
      -> {{nt : Net.net <: e}}
      -> {{ex : exception Net.NetError <: e}}
      -> Int
      -> With s Net.TcpListener
      -> Int
      -> Co e Unit
crowd port l made =
  if made >= 100 then noneLeft l Nothing
  else do
    try
      Net.withConnection (here port) (\c -> crowd port l (made + 1))
    catch (err : Net.NetError) ->
      noneLeft l (Just err)

crowdedAt : {e : HFunctor}
          -> {s : Type}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> {{ex : exception Net.NetError <: e}}
          -> With s Net.TcpListener
          -> Co e Unit
crowdedAt l = do
  at <- Net.local l
  crowd (either (\e -> 0) (\(a : Net.Address) -> a.port) at) l 0

crowdedProgram : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{nt : Net.net <: e}}
               -> {{ex : exception Net.NetError <: e}}
               -> Co e Unit
crowdedProgram =
  bind (Net.withListener (here 0) 256 (\l -> crowdedAt l)) (either throw pure)

-- std.http's client, a thread of its own --------------------------------------------

showGot : Either HTTP.HttpError HTTP.Response -> String
showGot (Left err) = show err
showGot (Right r) =
  debug r.status
  ^ " ["
  ^ fromMaybe "-" (HTTP.header "x-method" r)
  ^ " "
  ^ fromMaybe "-" (HTTP.header "x-peer" r)
  ^ " "
  ^ fromMaybe "-" (HTTP.header "content-length" r)
  ^ "] "
  ^ showBody r.body

asked : {e : HFunctor}
      -> {{web : HTTP.http <: e}}
      -> String
      -> List String
      -> Pair String HTTP.Request
      -> Co e (List String)
asked at acc (MkPair what rq) = do
  got <- HTTP.send { rq | url = at ^ rq.url }
  pure ((what ^ ": " ^ showGot got) :: acc)

askAll : {e : HFunctor}
       -> {{web : HTTP.http <: e}}
       -> String
       -> List String
       -> List (Pair String HTTP.Request)
       -> Co e (List String)
askAll at acc Nil = pure (List.reverse acc)
askAll at acc (q :: qs) = do
  acc2 <- asked at acc q
  askAll at acc2 qs

requests : List (Pair String HTTP.Request)
requests =
  [ MkPair "get" { url = "/hello" }
  , MkPair
    "post"
    { url = "/echo"
    , method = "POST"
    , headers = [MkPair "X-Heff" "one two"]
    , body = bytesOf 2
    }
  , MkPair
    "post, big"
    { url = "/echo", method = "POST", body = doubled (bytesOf 2) 12 }
  , MkPair "put, nothing" { url = "/echo", method = "PUT" }
  , MkPair "head" { url = "/hello", method = "HEAD" }
  , MkPair "404" { url = "/nope" }
  , MkPair "big" { url = "/big" }
  , MkPair "closed after" { url = "/close" }
  , MkPair "again" { url = "/hello" }
  , MkPair "stop" { url = "/stop" }
  ]

printAll : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printAll Nil = pure MkUnit
printAll (s :: rest) = do
  print s
  printAll rest

-- (thread 0 the server, thread 1 the client: what the client got)
sides : {e : HFunctor}
      -> {s : Type}
      -> {{io : stdio <: e}}
      -> {{nt : Net.net <: e}}
      -> {{web : HTTP.http <: e}}
      -> {{ex : exception Net.NetError <: e}}
      -> With s Net.TcpListener
      -> String
      -> Int
      -> Co e (List String)
sides l at 0 = do
  try
    Server.serveUntil isStop l (\r -> pure (routed r))
    pure Nil
  catch (err : Net.NetError) ->
    pure ["accept: " ^ show err]
sides l at _ = askAll at Nil requests

selfAt : {e : HFunctor}
       -> {s : Type}
       -> {{io : stdio <: e}}
       -> {{nt : Net.net <: e}}
       -> {{web : HTTP.http <: e}}
       -> {{th : threads <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> With s Net.TcpListener
       -> Co e Unit
selfAt l = do
  at <- Net.local l
  let url =
    "http://127.0.0.1:"
    ^ either (\err -> "0") (\(a : Net.Address) -> debug a.port) at
  i <- spread 2
  lines <- sides l url i
  got <- gather lines
  printAll (List.concatMap (\(ls : List String) -> ls) got)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{sys : process <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Co e Unit
program = do
  argv <- args
  case argv of
    (p :: _) -> serveAt (fromMaybe 0 (parseInt p))
    _ -> printErr "main PORT"

selfProgram : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{nt : Net.net <: e}}
            -> {{web : HTTP.http <: e}}
            -> {{th : threads <: e}}
            -> {{ex : exception Net.NetError <: e}}
            -> Co e Unit
selfProgram =
  bind (Net.withListener (here 0) 16 (\l -> selfAt l)) (either throw pure)

main : Co (stdio <+> Net.net <+> HTTP.http <+> threads <+> process) Unit
main =
  bind
    (attempt
       Net.NetError
       (program
          (io := _)
          (nt := _)
          (sys := _)
          (ex := _)))
    (unheard (io := _))

self : Co (stdio <+> Net.net <+> HTTP.http <+> threads <+> process) Unit
self =
  bind
    (attempt
       Net.NetError
       (selfProgram
          (io := _)
          (nt := _)
          (web := _)
          (th := _)
          (ex := _)))
    (unheard (io := _))

crowded : Co (stdio <+> Net.net <+> HTTP.http <+> threads <+> process) Unit
crowded =
  bind
    (attempt
       Net.NetError
       (crowdedProgram
          (io := _)
          (nt := _)
          (ex := _)))
    (unheard (io := _))
