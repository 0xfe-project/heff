-- The asynchronous fuel tests on the C backend, built with fuel: the
-- program of test/node/fuel-async-program.hf, its lines said.

module test.node.fuel-async

import boc as BOC
import co
import std.fuel as Fuel
import std.io
import std.time as Time
import test.node.fuel-async-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed [] = pure ()
printed (l :: ls) = do
  print l
  printed ls

main : Co (BOC.boc <+> stdio <+> Time.time <+> Fuel.fuel) Unit
main = Program.lines printed
