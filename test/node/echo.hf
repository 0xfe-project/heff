-- A program for `heff node` (test/node-run.mjs): operations of three
-- worlds -- the standard streams, the process, files -- summed into one
-- effect.  Each world's evidence is said once; an operation takes it
-- itself (`print out s`, `args sys`), as lib/state.hf's do.

import co
import fs
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process <+> fs

out : (stdio <: world)
out = \p -> InL (InL p)

sys : (process <: world)
sys = \p -> InL (InR p)

disk : (fs <: world)
disk = \p -> InR p

-- the program's own theory of its world: evidence paid once, here
type EchoM =
  { print : String -> Co world Unit
  , printErr : String -> Co world Unit
  , readStdin : Co world String
  , readFile : String -> Co world (Maybe String)
  , writeFile : String -> String -> Co world Bool
  , args : Co world (List String)
  , getEnv : String -> Co world (Maybe String)
  , exit : Int -> Co world Unit
  }

echoM : EchoM
echoM =
  { print = print out
  , printErr = printErr out
  , readStdin = readStdin out
  , readFile = readFile disk
  , writeFile = writeFile disk
  , args = args sys
  , getEnv = getEnv sys
  , exit = exit sys
  }

-- | Each argument, on a line of its own.
printAll : List String -> Co world Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  echoM.print a
  printAll rest

-- | The standard input, written to the file given and read back.
copy : String -> Co world Unit
copy path = do
  input <- echoM.readStdin
  written <- echoM.writeFile path input
  back <- echoM.readFile path
  if written then echoM.print ("copied: " ++ fromMaybe "(not read back)" back)
    else echoM.printErr "not written"

echo : Co world Unit
echo = do
  as <- echoM.args
  printAll as
  greeting <- echoM.getEnv "GREETING"
  echoM.print (fromMaybe "no greeting" greeting)
  case as of
    Nil -> echoM.printErr "no file given"
    Cons path _ -> copy path
  missing <- echoM.readFile "/nonexistent/heff"
  echoM.print (maybe "missing: not read" (\_ -> "missing: read") missing)
  echoM.printErr "to stderr"
  echoM.exit 3
  echoM.print "never"
