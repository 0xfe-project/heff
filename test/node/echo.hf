-- A program for `heff run`: operations of three
-- worlds -- the standard streams, the process, files -- summed into one
-- effect.  A computation asks for the evidence of the worlds it uses,
-- `{{io : stdio <: e}}`, in any world `e` that has them, and its
-- operations find it; the place that runs it gives it, once.

module test.node.echo

import co
import exception
import std.filesystem
import std.io
import std.path as Path
import std.process

-- | Each argument, on a line of its own.
printAll : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  print a
  printAll rest

-- | The standard input, written to the file given and read back.
copy : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> String
     -> Co e Unit
copy path = do
  input <- readStdin
  try (err := FileError)
    writeFile path input
    print ("copied: " ^ (<- readFile path))
  catch err -> printErr ("not copied: " ^ showFileError err)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> Co e Unit
program = do
  argv <- args
  printAll argv
  greeting <- getEnv "GREETING"
  print (fromMaybe "no greeting" greeting)
  case argv of
    Nil -> printErr "no file given"
    Cons path _ -> copy path
  try (err := FileError)
    _ <- readFile "/nonexistent/heff"
    print "missing: read"
  catch _ -> print "missing: not read"
  printErr "to stderr"
  exit 3
  print "never"

-- where the world is: each sub-effect's evidence, found, and a failure of
-- the files no `try` heard said
main : Co (stdio <+> process <+> filesystem) Unit
main =
  bind
    (attempt
       FileError
       (program
          (io := _)
          (sys := _)
          (disk := _)
          (fx := _)))
    (either
       (\err -> printErr (ev := _) (showFileError err))
       (\_ -> pure MkUnit))
