-- A program for `heff node` (test/node-run.mjs): operations of three
-- worlds -- the standard streams, the process, files -- summed into one
-- effect.  Each world's evidence is said once; an operation takes it
-- itself (`print out s`, `args sys`), as lib/state.hf's do.

import co
import fs
import prelude
import process
import stdio

eff : HFunctor
eff = stdio <+> process <+> fs

out : (stdio <: eff)
out = first3 stdio process fs

sys : (process <: eff)
sys = mid3 stdio process fs

disk : (fs <: eff)
disk = last3 stdio process fs

-- the program's own theory of its world: evidence paid once, here
type Io =
  { print : String -> Co eff Unit
  , printErr : String -> Co eff Unit
  , readStdin : Co eff String
  , readFile : String -> Co eff (Maybe String)
  , writeFile : String -> String -> Co eff Bool
  , args : Co eff (List String)
  , getEnv : String -> Co eff (Maybe String)
  , exit : Int -> Co eff Unit
  }

io : Io
io =
  { print = print out
  , printErr = printErr out
  , readStdin = readStdin out
  , readFile = readFile disk
  , writeFile = writeFile disk
  , args = args sys
  , getEnv = getEnv sys
  , exit = exit sys
  }

-- | Each argument, on a line of its own.
printAll : List String -> Co eff Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  io.print a
  printAll rest

-- | The standard input, written to the file given and read back.
copy : String -> Co eff Unit
copy path = do
  input <- io.readStdin
  written <- io.writeFile path input
  back <- io.readFile path
  if written then io.print ("copied: " ++ fromMaybe "(not read back)" back)
    else io.printErr "not written"

echo : Co eff Unit
echo = do
  as <- io.args
  printAll as
  greeting <- io.getEnv "GREETING"
  io.print (fromMaybe "no greeting" greeting)
  case as of
    Nil -> io.printErr "no file given"
    Cons path _ -> copy path
  missing <- io.readFile "/nonexistent/heff"
  io.print (maybe "missing: not read" (\_ -> "missing: read") missing)
  io.printErr "to stderr"
  io.exit 3
  io.print "never"
