-- A program for `heff node` (test/node-run.mjs): operations of three
-- worlds -- the standard streams, the process, files -- summed into one
-- effect, each computation lifted in by its evidence.

import co
import fs
import prelude
import proc
import stdio

eff : HFunctor
eff = stdio <+> proc <+> fs

onStdio : {a : Type} -> Co stdio a -> Co eff a
onStdio = lift (\p -> inl (stdio <+> proc) fs (inl stdio proc p))

onProc : {a : Type} -> Co proc a -> Co eff a
onProc = lift (\p -> inl (stdio <+> proc) fs (inr stdio proc p))

onFs : {a : Type} -> Co fs a -> Co eff a
onFs = lift (inr (stdio <+> proc) fs)

-- | Each argument, on a line of its own.
printAll : List String -> Co eff Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  onStdio (print a)
  printAll rest

-- | The standard input, written to the file given and read back.
copy : String -> Co eff Unit
copy path = do
  input <- onStdio readStdin
  written <- onFs (writeFile path input)
  back <- onFs (readFile path)
  if written
      then onStdio (print ("copied: " ++ fromMaybe "(not read back)" back))
      else onStdio (printErr "not written")

echo : Co eff Unit
echo = do
  as <- onProc args
  printAll as
  greeting <- onProc (getEnv "GREETING")
  onStdio (print (fromMaybe "no greeting" greeting))
  case as of
    Nil -> onStdio (printErr "no file given")
    Cons path _ -> copy path
  missing <- onFs (readFile "/nonexistent/heff")
  onStdio (print (maybe "missing: not read" (\_ -> "missing: read") missing))
  onStdio (printErr "to stderr")
  onProc (exit 3)
  onStdio (print "never")
