-- A program for `heff node` (test/node-run.mjs): operations of three
-- worlds -- the standard streams, the process, files -- summed into one
-- effect.  A computation asks for the evidence of the worlds it uses,
-- `{{io : stdio <: world}}`, and its operations find it; the place that
-- runs it gives it, once.

import co
import fs
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process <+> fs

-- | Each argument, on a line of its own.
printAll : {{io : stdio <: world}} -> List String -> Co world Unit
printAll Nil = pure MkUnit
printAll (Cons a rest) = do
  print a
  printAll rest

-- | The standard input, written to the file given and read back.
copy : {{io : stdio <: world}}
     -> {{disk : fs <: world}}
     -> String
     -> Co world Unit
copy path = do
  input <- readStdin
  written <- writeFile path input
  back <- readFile path
  if written then print ("copied: " ++ fromMaybe "(not read back)" back)
    else printErr "not written"

program : {{io : stdio <: world}}
        -> {{sys : process <: world}}
        -> {{disk : fs <: world}}
        -> Co world Unit
program = do
  as <- args
  printAll as
  greeting <- getEnv "GREETING"
  print (fromMaybe "no greeting" greeting)
  case as of
    Nil -> printErr "no file given"
    Cons path _ -> copy path
  missing <- readFile "/nonexistent/heff"
  print (maybe "missing: not read" (\_ -> "missing: read") missing)
  printErr "to stderr"
  exit 3
  print "never"

-- where the world is: each sub-effect's evidence, given
echo : Co world Unit
echo =
  program
    (io := \p -> InL (InL p))
    (sys := \p -> InL (InR p))
    (disk := \p -> InR p)
