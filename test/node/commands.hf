-- Commands run to their end (test/backends.mjs): each option of
-- std.process's `Invocation` -- a directory, an environment, an input,
-- a time limit, a bound on what is kept -- and each way a command ends.
-- (POSIX: the commands are sh's.)

import co
import std.io
import std.process

world : HFunctor
world = stdio <+> process

-- (how it ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "exited " ^ show n
endedSaid (Signalled n) = "signal " ^ show n
endedSaid TimedOut = "timed out"
endedSaid NotRun = "not run"

-- (what a command did, said on a line: how it ended, what it wrote)
said : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> String
     -> Invocation
     -> Co e Unit
said what c = do
  r <- run c
  print
      (what
       ^ ": "
       ^ endedSaid r.ended
       ^ ", out "
       ^ show r.out
       ^ ", err "
       ^ show r.err)

-- (a command of sh's)
sh : String -> Invocation
sh script = { command = "sh", args = ["-c", script] }

-- (`n` bytes)
bytesOf : Int -> String
bytesOf n = joinWith "" (List.replicate (n / 10) "0123456789")

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
program = do
  said "plain" (sh "echo out; echo err >&2")
  said "status" (sh "exit 3")
  said "directory" { command = "pwd", dir = "/" }
  said "directory not there" { command = "pwd", dir = "/nonexistent/heff" }
  said
      "environment"
      { command = "sh"
      , args = ["-c", "echo \"$GREETING ${PATH:+path}\""]
      , env = [MkPair "GREETING" "new"]
      }
  said "environment as it is" (sh "echo \"$GREETING\"")
  said "input" { command = "cat", input = Just "fed\n" }
  said "no input" { command = "cat" }
  said
      "input, much"
      { (sh "wc -c | tr -d \" \"") | input = Just (bytesOf 200000) }
  said "input, not read" { command = "true", input = Just (bytesOf 200000) }
  said "a signal" (sh "kill -9 $$")
  said "a signal, another" (sh "kill -TERM $$")
  said "a loop" { (sh "while :; do :; done") | timeout = 200 }
  said "a sleep" { (sh "echo before; sleep 5") | timeout = 200 }
  said "within its time" { (sh "echo quick") | timeout = 60000 }
  said "kept" { (sh "echo 0123456789; echo abcdefghij >&2") | keep = 4 }
  said "written forever" { command = "yes", timeout = 300, keep = 6 }
  said "not there" { command = "heff-no-such-command" }

main : Co world Unit
main = program (io := \p -> InL p) (sys := \p -> InR p)
