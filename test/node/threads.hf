-- Threads truly at once, by std.thread (its C
-- provider building the runtime for threads).  `spread n` gives the rest of the program to each
-- of n threads, shared by them, its index its answer; `gather x` joins
-- them, each thread's value, in order, in thread 0, every other thread
-- ending there.  `parFor w n f` is `f 0 .. f (n - 1)`, by `w` threads
-- taking the next as they end one, `parMap` the same over a list: their answers any type, handed back.
-- And `Parallel`, each side a thread (`inThreads`).

module test.node.threads

import array as Array
import co
import int64 as Int64
import parallel
import std.io
import std.process
import std.thread
import uint64 as UInt64

world : HFunctor
world = stdio <+> (process <+> threads)

-- The work: pure, split into parts -------------------------------------------------

noDivisor : Int -> Int -> Bool
noDivisor n d =
  if d * d > n then True else if n % d == 0 then False else noDivisor n (d + 1)

isPrime : Int -> Bool
isPrime n = n >= 2 && noDivisor n 2

countIn : Int -> Int -> Int -> Int
countIn acc i hi =
  if i >= hi then acc
  else countIn (if isPrime i then acc + 1 else acc) (i + 1) hi

-- | the primes below `n` in block `b` of 4096
primesIn : Int -> Int -> Int
primesIn n b = countIn 0 (b * 4096) (min n (b * 4096 + 4096))

fib : Int -> Int
fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)

-- (fib n's calls `d` deep: what is left to compute at each)
leaves : Int -> Int -> List Int
leaves d n =
  if d == 0 || n < 2 then [n]
  else List.append (leaves (d - 1) (n - 1)) (leaves (d - 1) (n - 2))

safe : Int -> Int -> List Int -> Bool
safe c d Nil = True
safe c d (q :: qs) = c /= q && c - q /= d && q - c /= d && safe c (d + 1) qs

place : Int -> Int -> List Int -> Int
place n row qs =
  if row == n then 1
  else List.foldl
      (\acc c -> if safe c 1 qs then acc + place n (row + 1) (c :: qs) else acc)
      0
      (List.range 0 (n - 1))

-- | the `n` queens' solutions whose first two queens are in the columns
-- | `t / n` and `t % n`
queensAt : Int -> Int -> Int
queensAt n t = if safe (t % n) 1 [t / n] then place n 2 [t % n, t / n] else 0

nthOr : Int -> List Int -> Int
nthOr i Nil = 0
nthOr i (x :: xs) = if i == 0 then x else nthOr (i - 1) xs

-- | fib `n`'s leaf `i`, 7 deep
fibAt : Int -> Int -> Int
fibAt n i = fib (nthOr i (leaves 7 n))

-- (a definition every thread asks for, computed once and shared)
squares : List Int
squares = List.map (\x -> x * x) (List.range 1 1000)

-- (records whose numbers the C backend keeps flat (#39): a definition
-- frozen, and one of the caller's each thread holds, shared)
type Mass = { m : Float64, k : Int64, u : UInt64, tag : String }

masses : List Mass
masses =
  List.map
    (\x ->
       ({ m = toFloat x * 0.5
        , k = Int64.fromInt x * 4611686018427387903
        , u = UInt64.fromInt x * 0xF000000000000001
        , tag = "m"
        }
        : Mass))
    (List.range 1 100)

-- (... and tags whose numbers it keeps flat (#64), built where their
-- type is known: list cells, a definition frozen, and one of the
-- caller's each thread holds, shared, of `Float64`s and of `UInt64`s
-- beyond 62 bits; 0 between them)
weightsFrom : Int -> List Float64
weightsFrom n = if n == 0 then Nil else toFloat n * 0.25 :: weightsFrom (n - 1)

weights : List Float64
weights = weightsFrom 100

widesFrom : Int -> List UInt64
widesFrom n =
  if n == 0 then Nil
  else UInt64.fromInt n * 0xF000000000000001 :: widesFrom (n - 1)

massOf : Mass -> List UInt64 -> Int
massOf mine us =
  floor (List.foldl (\s (x : Mass) -> s + x.m) 0.0 masses)
  + Int64.toInt (mine.k / 4611686018427387903)
  + UInt64.toInt (mine.u / 0xF000000000000001)
  + floor (List.foldl (\s w -> s + w) 0.0 weights - 1262.5)
  + UInt64.toInt (List.foldl (\s u -> s + u / 0xF000000000000001) 0 us)
  - 1

-- (functions whose C workers take and give their numbers unboxed (#39),
-- each thread calling them: directly, and through a closure)
spin : UInt64 -> Int -> UInt64
spin x n =
  if n == 0 then x
  else spin
      (xor (x * 6364136223846793005 + 1442695040888963407) (shiftR x 29))
      (n - 1)

low : UInt64 -> Int
low x = UInt64.toInt (and x 0xFFFF)

spun : Int -> Int
spun t =
  low (spin (UInt64.fromInt t) 100000)
  + List.sum (List.map low (List.map (\x -> spin x 10) [UInt64.fromInt t, 0xFFFFFFFFFFFFFFFF]))

-- Parallel, by threads -------------------------------------------------------------

pw : HFunctor
pw = parallel Int Int <+> world

fibPar : Int -> Int -> Co pw Int
fibPar d n =
  if d == 0 || n < 2 then later (\u -> fib n)
  else do
    ab <-
      parallelIn
        (inj := \p -> InL p)
        (fibPar (d - 1) (n - 1))
        (fibPar (d - 1) (n - 2))
    pure (fst ab + snd ab)

-- The programs ---------------------------------------------------------------------

showInts : List Int -> String
showInts xs = unwords (List.map show xs)

program : {{io : stdio <: world}} -> {{th : threads <: world}} -> Co world Unit
program = do
  print "said before the spread, once"
  i <- spread 4
  sq <- gather (i * i)
  print ("squares: " ^ showInts sq)
  j <- spread 2
  k <- spread 3
  inner <- gather (j * 10 + k)
  outer <- gather (List.sum inner)
  print ("nested: " ^ showInts outer)
  m <- spread 3
  own <- gather (List.sum (List.map (\x -> x * m) (List.range 1 5)))
  print ("each its own: " ^ showInts own)
  n <- spread 4
  shared <- gather (List.sum squares + n)
  print ("a definition, shared: " ^ showInts shared)
  mine <-
    pure
      ({ m = 2.5, k = 9223372036854775807, u = 18446744073709551615, tag = "own" }
       : Mass)
  us <- pure (widesFrom 3)
  f <- spread 3
  flat <- gather (massOf mine us + f)
  print ("flat fields, frozen and shared: " ^ showInts flat)
  t <- spread 3
  ws <- gather (spun t)
  print ("workers: " ^ showInts ws)
  ps <- parFor 4 (100000 / 4096 + 1) (primesIn 100000)
  print ("primes below 100000, by 4: " ^ show (List.sum ps))
  fs <- parMap 4 fib (List.replicate 4 20)
  print ("forced at once: " ^ showInts fs)
  r <- handle (inThreads Int Int world) (fibPar 3 20)
  print ("fib 20, each Parallel a thread: " ^ show r)

main : Co world Unit
main = program (io := \p -> InL p) (th := \p -> InR (InR p))

-- (a thread that abandons: the program abandons, as it would one thread
-- doing it all, when the threads are joined)
abandoning : {{io : stdio <: world}}
           -> {{th : threads <: world}}
           -> Co world Unit
abandoning = do
  i <- spread 3
  x <- later (\u -> if i == 2 then abandon else i)
  xs <- gather x
  print ("not said: " ^ showInts xs)

failing : Co world Unit
failing = abandoning (io := \p -> InL p) (th := \p -> InR (InR p))

-- (any value, there and back: strings and lists mapped, gathered, and
-- each side of a `Parallel` of two types; a value of the caller's, not a
-- definition, shared by each task that holds it; a thunk of the
-- caller's, shared, forced by threads at once)
mixed : Co (parallel String (List Int) <+> world) (Pair String (List Int))
mixed =
  parallelIn
    (inj := \p -> InL p)
    (later (\u -> "fib 15 is " ^ show (fib 15)))
    (later (\u -> List.map fib (List.range 1 8)))

showList : List Int -> String
showList xs = "[" ^ joinWith "," (List.map show xs) ^ "]"

generics : {{io : stdio <: world}}
         -> {{th : threads <: world}}
         -> Co world Unit
generics = do
  shouted <- parMap 3 (\s -> s ^ "!") ["a", "bb", "ccc", "dddd", "eeeee"]
  print ("strings, by 3: " ^ unwords shouted)
  ranges <- parFor 4 5 (\i -> List.range 1 i)
  print ("lists, by 4: " ^ unwords (List.map showList ranges))
  mine <- pure (List.map (\x -> x * 3) (List.range 1 100))
  sums <- parMap 4 (\n -> List.sum (List.take n mine)) [0, 1, 10, 100, 1000]
  print ("a list of the caller's, in each: " ^ showInts sums)
  thunk <- pure (\(u : Unit) -> List.range 1 (List.length mine / 20))
  forced <- parMap 4 thunk (List.replicate 8 MkUnit)
  print ("a thunk of the caller's, forced at once: " ^ showInts (List.map List.sum forced))
  pairs <- parMap 2 (\(p : Pair String Int) -> MkPair (fst p) (fib (snd p))) [MkPair "one" 10, MkPair "two" 11]
  print ("pairs: " ^ unwords (List.map (\(p : Pair String Int) -> fst p ^ "=" ^ show (snd p)) pairs))
  none <- parMap 4 (\(x : Int) -> x) Nil
  print ("of none: " ^ showList none)
  text <- pure (joinWith "" (List.replicate 50 (strSlice "0123456789--" 0 (5 + List.length ranges))))
  cut <- parMap 4 (\k -> strSlice (strSlice text k 500) 10 (300 + k)) [0, 1, 2, 3, 4, 5]
  print ("views of the caller's string: " ^ unwords (List.map (\s -> show (strLength s) ^ ":" ^ strSlice s 0 3) cut))
  own <- parMap 3 (\k -> strSlice (joinWith "" (List.replicate 100 (show k))) 2 90) [0, 1, 2]
  print ("views of each's own: " ^ unwords (List.map (\s -> show (strLength s) ^ ":" ^ strSlice s 0 2) own))
  i <- spread 3
  names <- gather (joinWith "" (List.replicate i "ab"))
  print ("gathered: " ^ joinWith "," names)
  both <- handle (inThreads String (List Int) world) mixed
  print ("a Parallel of two types: " ^ fst both ^ "; " ^ showList (snd both))
  c <- cores
  print (if c >= 1 then "cores: at least one" else "cores: none")

generic : Co world Unit
generic = generics (io := \p -> InL p) (th := \p -> InR (InR p))

-- (tasks that abandon: the others take no more, and the caller
-- abandons, as it would have, one thread doing all -- the first that
-- failed in the list's order the one it fails as, though a later one,
-- here, fails sooner)
failAt : Int -> Int
failAt i =
  if i == 2 then (if fib 25 > 0 then abandon else 0)
  else if i == 4 then abandon
  else i

poolFailing : {{io : stdio <: world}}
            -> {{th : threads <: world}}
            -> Co world Unit
poolFailing = do
  print "said before the pool"
  xs <- parFor 4 8 failAt
  print ("not said: " ^ showInts xs)

failingTask : Co world Unit
failingTask = poolFailing (io := \p -> InL p) (th := \p -> InR (InR p))

-- (`cpu WORK N W`: WORK -- primes, queens or fib -- of N, by W threads)
tasks : String -> Int -> Pair Int (Int -> Int)
tasks w n =
  if strEq w "queens" then MkPair (n * n) (queensAt n)
  else if strEq w "fib" then MkPair (List.length (leaves 7 n)) (fibAt n)
  else MkPair (n / 4096 + 1) (primesIn n)

cpuRun : {{io : stdio <: world}}
       -> {{th : threads <: world}}
       -> String
       -> Int
       -> Int
       -> Co world Unit
cpuRun w n ws = do
  xs <- parFor ws (fst (tasks w n)) (snd (tasks w n))
  print (w ^ ": answer " ^ show (List.sum xs))

cpuArgs : {{io : stdio <: world}}
        -> {{th : threads <: world}}
        -> List String
        -> Co world Unit
cpuArgs (w :: n :: ws :: _) =
  cpuRun w (fromMaybe 0 (parseInt n)) (fromMaybe 1 (parseInt ws))
cpuArgs _ = print "cpu primes|queens|fib N W"

cpu : Co world Unit
cpu = do
  argv <- args (ev := \p -> InR (InL p))
  cpuArgs (io := \p -> InL p) (th := \p -> InR (InR p)) argv

-- (`handOver R W`: R rounds, each W lists of 100,000 made by the tasks'
-- threads and given back by the caller, which sums them -- made in one
-- thread, given back in another, round after round, in memory that
-- does not grow)
madeThere : Int -> List Int
madeThere i = List.range i (i + 99999)

handRounds : {{io : stdio <: world}}
           -> {{th : threads <: world}}
           -> Int
           -> Int
           -> Int
           -> Co world Int
handRounds r w acc =
  if r == 0 then pure acc
  else do
    xs <- parFor w w madeThere
    handRounds (r - 1) w (acc + List.sum (List.map List.sum xs))

handArgs : {{io : stdio <: world}}
         -> {{th : threads <: world}}
         -> List String
         -> Co world Unit
handArgs (r :: w :: _) = do
  s <- handRounds (fromMaybe 0 (parseInt r)) (fromMaybe 2 (parseInt w)) 0
  print ("handed over: " ^ show s)
handArgs _ = print "handOver ROUNDS W"

handOver : Co world Unit
handOver = do
  argv <- args (ev := \p -> InR (InL p))
  handArgs (io := \p -> InL p) (th := \p -> InR (InR p)) argv

-- (`unshared`: a tree, a list and two arrays shared with the pool's
-- threads, each reading all of them; held by the caller alone again once
-- the threads let them go, and then taken apart and built in where they
-- are, not copied)
data Tree = Leaf | Node Tree Int Tree

grown : Int -> Int -> Tree
grown d k =
  if d == 0 then Leaf
  else Node (grown (d - 1) (2 * k)) k (grown (d - 1) (2 * k + 1))

treeSum : Tree -> Int
treeSum Leaf = 0
treeSum (Node l x r) = treeSum l + x + treeSum r

bumped : Tree -> Tree
bumped Leaf = Leaf
bumped (Node l x r) = Node (bumped l) (x + 1) (bumped r)

bumpedAll : List Int -> List Int
bumpedAll Nil = Nil
bumpedAll (x :: xs) = x + 1 :: bumpedAll xs

arraySum : Array Int -> Int -> Int -> Int
arraySum a i acc =
  if i >= Array.length a then acc
  else arraySum a (i + 1) (acc + Array.arrayIndex a i)

tripled : Array Int -> Int -> Array Int
tripled a i =
  if i >= Array.length a then a else tripled (Array.set a i (i * 3)) (i + 1)

namesLength : Array String -> Int -> Int -> Int
namesLength a i acc =
  if i >= Array.length a then acc
  else namesLength a (i + 1) (acc + strLength (Array.arrayIndex a i))

renamed : Array String -> Int -> Array String
renamed a i =
  if i >= Array.length a then a
  else renamed (Array.set a i (show (i * 1000))) (i + 1)

unsharedRun : {{io : stdio <: world}}
            -> {{th : threads <: world}}
            -> Co world Unit
unsharedRun = do
  t <- pure (grown 12 1)
  a <- pure (Array.generate 1000 (\i -> i))
  xs <- pure (List.range 1 (Array.length a))
  names <- pure (Array.generate 100 (\i -> show i))
  seen <-
    parMap
      4
      (\i ->
         treeSum t + List.sum xs + arraySum a 0 0 + namesLength names 0 0 + i)
      [0, 1, 2, 3]
  print ("read by 4: " ^ showInts seen)
  print ("tree: " ^ show (treeSum (bumped t)))
  ys <- pure (bumpedAll xs)
  print ("list: " ^ show (List.sum ys) ^ " of " ^ show (List.length ys))
  print ("array: " ^ show (arraySum (tripled a 0) 0 0))
  print ("names: " ^ show (namesLength (renamed names 0) 0 0))

unshared : Co world Unit
unshared = unsharedRun (io := \p -> InL p) (th := \p -> InR (InR p))
