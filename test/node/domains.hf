-- Domains, by std.domain, on the C backend's threads (its provider
-- building the runtime for threads): the program of
-- test/node/domains-program.hf, its lines said; and a domain's failure
-- its joiner's.

module test.node.domains

import co
import std.domain as Domain
import std.io
import test.node.domains-program as Program

-- (each line printed)
printed : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printed Nil = pure ()
printed (l :: ls) = do
  print l
  printed ls

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{dm : Domain.domain <: e}}
        -> Co e Unit
program = do
  ls <- Program.said
  printed ls

-- | on the system's threads
main : Co (stdio <+> Domain.domain) Unit
main = program (io := _) (dm := _)

-- (a domain that abandons: its joiner abandons, as one domain doing it
-- all would)
abandoning : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{dm : Domain.domain <: e}}
           -> Co e Unit
abandoning = do
  with s := Domain.scope do
    d <- Domain.spawn s (later (\u -> if 1 == 1 then abandon else 0))
    print "spawned"
    v <- Domain.join d
    print (debug v)

failing : Co (stdio <+> Domain.domain) Unit
failing = abandoning (io := _) (dm := _)
