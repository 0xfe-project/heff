-- std.http.bocserver's `serve`, every wait of the server an act
-- awaited, under boc's `scheduled`, the listener held by a `with`
-- around the scheduler, which is run on the program's world itself.
-- By C alone.
--
--   main   PORT IDLE [HEAD]: served there, a connection closed after
--          IDLE ms of silence, or HEAD ms (30 s unless given) without
--          a request's head all read; `/slow` answered after 300 ms, slept by an act
--          the handler awaits; served until SIGTERM or SIGINT, which
--          closes the listener; then, once the server is done, how many
--          requests it answered, and `main done`
--   burst  PORT [IDLE [HEAD]]: the same, but served until asked for
--          `/stop`, which is answered, then closes the listener

module test.node.boc-served

import boc as BOC
import co
import custodian as Custodian
import exception
import std.duration as Duration
import std.http as HTTP
import std.http.bocserver as BocServer
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.signal as Signal
import std.time
import resource

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- | What a handler throws.
data Thrown = MkThrown

-- (a request answered, and counted, but `/stop`: `/slow` after 300
-- ms, slept by an act the handler awaits; `/stop` answered, then the
-- listener closed; `/throw` thrown; any other, its target.  An act
-- awaited is of the world of its `with`, the handler's, which says it:
-- its own evidence would put it in the server's)
answering : {e : HFunctor}
          -> {rg : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{clock : time <: e}}
          -> {{nt : Net.net <: e}}
          -> BOC.Cown Int
          -> With rg Net.TcpListener
          -> Server.Request
          -> BocServer.Responder
          -> Co (exception Thrown <+> e) Unit
answering count l r respond = do
  if r.target == "/stop" then pure ()
  else do
    with n := count do
      n := n + 1
  if r.target == "/slow"
  then do
    with _ :=
           BOC.await
             (sleep (Duration.milliseconds 300)
              : Co (exception Thrown <+> e) Unit) do
      respond (Server.plain 200 "slow")
  else if r.target == "/stop"
  then do
    respond (Server.plain 200 "stopping")
    with _ :=
           BOC.await
             (Net.closeListener l
              : Co (exception Thrown <+> e) (Either Net.NetError Unit)) do
      pure ()
  else if r.target == "/throw" then throw (MkThrown : Thrown)
  else respond (Server.plain 200 r.target)

-- (the listener served; where `bySignal`, until SIGTERM or SIGINT,
-- which closes it, said)
served : {e : HFunctor}
       -> {rg : Type}
       -> {{bc : BOC.boc <: e}}
       -> {{io : stdio <: e}}
       -> {{clock : time <: e}}
       -> {{nt : Net.net <: e}}
       -> {{sg : Signal.signals <: e}}
       -> Bool
       -> Int
       -> Int
       -> BOC.Cown Int
       -> With rg Net.TcpListener
       -> Co e Unit
served bySignal idle head count l = do
  BocServer.serve
      (idle := idle)
      (headerWithin := head)
      Thrown
      l
      (answering (e := e) count l)
  if bySignal
  then do
    with s :=
           BOC.await
             (bind
                (Signal.wait [Terminate, Interrupt])
                (\s -> bind (Net.closeListener l) (\u -> pure s))) do
      print ("stopping on " ^ show s)
      flush
  else pure ()

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> {{nt : Net.net <: e}}
        -> {{sg : Signal.signals <: e}}
        -> {{sys : process <: e}}
        -> Bool
        -> Co e Unit
program bySignal = do
  argv <- args
  let port = fromMaybe 0 (parseInt (fromMaybe "" (List.head argv)))
  let idle =
    fromMaybe 30000 (parseInt (fromMaybe "" (List.head (List.drop 1 argv))))
  let head =
    fromMaybe 30000 (parseInt (fromMaybe "" (List.head (List.drop 2 argv))))
  count <- BOC.newCown 0
  r <-
    Net.withListener
      (here port)
      512
      (\l ->
         BOC.scheduled
           (\why -> printErr ("a behaviour failed: " ^ why))
           (served bySignal idle head count l))
  -- (what the server counted, every behaviour done: said by a behaviour
  -- of a `scheduled` after it)
  BOC.scheduled
      (\why -> abandon)
      (BOC.when count (\n -> do
         print ("answered " ^ debug n)
         print (either show (\u -> "main done") r)
         pure n))

-- | served until SIGTERM or SIGINT
main : Co
       (BOC.boc
        <+> Custodian.custodian
        <+> stdio
        <+> time
        <+> Net.net
        <+> Signal.signals
        <+> process)
       Unit
main = program True

-- | served until asked for `/stop`
burst : Co
        (BOC.boc
         <+> Custodian.custodian
         <+> stdio
         <+> time
         <+> Net.net
         <+> Signal.signals
         <+> process)
        Unit
burst = program False
