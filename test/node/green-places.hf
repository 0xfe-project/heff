-- Green threads inside a place: a place runs a scheduler of its own
-- (`Reactor.scheduled`), whose threads' waits -- a sleep, a receive on
-- a place channel, a command waited for, a place joined -- are pending
-- in the place's own reactor, the other threads of the place going on
-- meanwhile.  By C alone.
--
--   main     a place started, running five green threads: four each
--            waiting for something, in the order their waits end --
--            300 ms apart -- and one that goes on at once; main sends
--            what the second waits for 300 ms in.  Then the main place
--            runs a scheduler too, one thread joining a place that
--            sleeps while another goes on.

module test.node.green-places

import co
import exception
import green
import std.io
import std.place
import std.process
import std.reactor as Reactor
import std.time

world : HFunctor
world = stdio <+> (process <+> (Reactor.reactor <+> (places <+> time)))

gw : HFunctor
gw = green <+> world

-- (a place of `ms` and then `n`: for a join)
napping : {e : HFunctor} -> {{tm : time <: e}} -> Int -> Int -> Co e Int
napping ms n = do
  sleep ms
  pure n

-- (the five threads, and main waiting for all five on a channel of green's)
inPlace : {{io : stdio <: gw}}
        -> {{sys : process <: gw}}
        -> {{pl : places <: gw}}
        -> {{tm : time <: gw}}
        -> {{gr : green <: gw}}
        -> PlaceChannel Int
        -> Co gw Unit
inPlace asks = do
  done <- newChan
  spawn (do
    sleep 600
    print "slept"
    send done 1)
  spawn (do
    n <- recvPlace asks
    print ("received " ^ show n)
    send done 2)
  spawn (do
    r <-
      attempt
        ProcessError
        gw
        (withProcess
           (ev := \p -> InR (sys p))
           (ex := \p -> InL p)
           { command = "sleep", args = ["1.2"] }
           (\p -> wait (ev := \p -> InR (sys p)) p))
    print "the command ended"
    send done 3)
  spawn (do
    q <- spawnPlace (napping 900 7)
    n <- joinPlace q
    print ("joined " ^ show n)
    send done 4)
  spawn (do
    print "went on meanwhile"
    send done 5)
  recv done
  recv done
  recv done
  recv done
  recv done
  pure MkUnit

-- (the place's computation: the scheduler, its answer said)
scheduledThere : {{io : stdio <: world}}
               -> {{sys : process <: world}}
               -> {{pl : places <: world}}
               -> {{rx : Reactor.reactor <: world}}
               -> {{tm : time <: world}}
               -> PlaceChannel Int
               -> Co world Unit
scheduledThere asks = do
  r <-
    Reactor.scheduled
      world
      (inPlace
         (io := \q -> InR (io q))
         (sys := \q -> InR (sys q))
         (pl := \q -> InR (pl q))
         (tm := \q -> InR (tm q))
         (gr := \q -> InL q)
         asks)
  print
      (maybe
         "a thread of the place waited for ever"
         (\u -> "the place's threads all ended")
         r)

-- (in the main place: one thread joins a place of 300 ms, another goes
-- on meanwhile)
joining : {{io : stdio <: gw}}
        -> {{pl : places <: gw}}
        -> {{tm : time <: gw}}
        -> {{gr : green <: gw}}
        -> Co gw Unit
joining = do
  done <- newChan
  spawn (do
    q <- spawnPlace (napping 300 3)
    n <- joinPlace q
    print ("joined " ^ show n ^ " here")
    send done 1)
  spawn (do
    print "went on here meanwhile"
    send done 2)
  recv done
  recv done
  pure MkUnit

program : {{io : stdio <: world}}
        -> {{sys : process <: world}}
        -> {{pl : places <: world}}
        -> {{rx : Reactor.reactor <: world}}
        -> {{tm : time <: world}}
        -> Co world Unit
program = do
  asks <- newPlaceChannel
  p <- spawnPlace (scheduledThere asks)
  sleep 300
  sendPlace asks 21
  joinPlace p
  r <-
    Reactor.scheduled
      world
      (joining
         (io := \q -> InR (io q))
         (pl := \q -> InR (pl q))
         (tm := \q -> InR (tm q))
         (gr := \q -> InL q))
  print
      (maybe
         "a thread here waited for ever"
         (\u -> "the main place's threads all ended")
         r)

main : Co world Unit
main =
  program
    (io := \p -> InL p)
    (sys := \p -> InR (InL p))
    (pl := \p -> InR (InR (InR (InL p))))
    (rx := \p -> InR (InR (InL p)))
    (tm := \p -> InR (InR (InR (InR p))))
