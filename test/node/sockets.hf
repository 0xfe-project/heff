-- TCP sockets (std.net), by C alone: a connection to a listener of the
-- program's own, on 127.0.0.1 at the port the test picked, each had by
-- a `with`, each side echoing what the other wrote, one side shut down
-- and then the other's `with` ended; a port the system picks, on IPv4,
-- on IPv6 where the host has it, and by a name; and what fails, thrown
-- by its `with` and heard: a port already in use, a connection refused,
-- a port out of range, a name not resolved.  `main PORT REFUSED`: a
-- port to listen on, and one where nothing listens.

module test.node.sockets

import bytes as Bytes
import co
import exception
import std.io
import std.net as Net
import std.process
import uint8 as UInt8
import resource

world : HFunctor
world = stdio <+> (Net.net <+> process)

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (a `with` that may fail, its throw heard: `ok`, or its error's name)
tried : {e : HFunctor}
      -> {{ex : exception Net.NetError <: e}}
      -> Co e Unit
      -> Co e String
tried c =
  recover (bind c (\u -> pure "ok")) (\(err : Net.NetError) -> pure err.name)

-- (`k` of the value; where there is none, why, said)
onRight : {e : HFunctor}
        -> {a : Type}
        -> {{io : stdio <: e}}
        -> String
        -> (a -> Co e Unit)
        -> Either Net.NetError a
        -> Co e Unit
onRight what k (Left err) = print (what ^ ": " ^ Net.showError err)
onRight what k (Right x) = k x

-- (what an operation that may fail came to: its error's name, or `ok`)
nameOf : {a : Type} -> Either Net.NetError a -> String
nameOf (Left err) = err.name
nameOf (Right _) = "ok"

-- (a read's bytes after those before: `more` of them all; where it read
-- none -- the other side ended -- those before)
afterRead : {e : HFunctor}
          -> (Bytes -> Co e (Either Net.NetError Bytes))
          -> Bytes
          -> Either Net.NetError Bytes
          -> Co e (Either Net.NetError Bytes)
afterRead more acc (Left err) = pure (Left err)
afterRead more acc (Right b) =
  if Bytes.length b == 0 then pure (Right acc) else more (Bytes.append acc b)

-- (`n` bytes read, in as many reads as they take; fewer where the other
-- side ends first)
readAll : {e : HFunctor}
        -> {s : Type}
        -> {{nt : Net.net <: e}}
        -> With s Net.TcpStream
        -> Int
        -> Bytes
        -> Co e (Either Net.NetError Bytes)
readAll c n acc =
  if Bytes.length acc >= n then pure (Right acc)
  else bind (Net.read c (n - Bytes.length acc)) (afterRead (readAll c n) acc)

-- (some text, and a byte of each value, 0 to 255)
sent : Bytes
sent =
  Bytes.append
    b["hello, sockets\r\n"]
    (Bytes.fromList (List.map UInt8.fromInt (List.range 0 255)))

showRead : Either Net.NetError Bytes -> String
showRead (Left err) = Net.showError err
showRead (Right b) =
  if Bytes.length b <= 32 then show b
  else show (Bytes.length b)
    ^ " bytes, those sent: "
    ^ (if b == sent then "yes" else "no")

-- (where the client is, as the server sees it: its address, and whether
-- its port is the client's own)
showPeer : Either Net.NetError Net.Address
         -> Either Net.NetError Net.Address
         -> String
showPeer (Left err) _ = Net.showError err
showPeer _ (Left err) = Net.showError err
showPeer (Right p) (Right mine) =
  p.host
  ^ ", the client's port: "
  ^ (if p.port == mine.port then "yes" else "no")

-- (the client `c` and the server's side `s` of one connection: each
-- echoing the other, the client shut down; then the server's side's
-- `with` ends)
talk : {e : HFunctor}
     -> {s t : Type}
     -> {{io : stdio <: e}}
     -> {{nt : Net.net <: e}}
     -> With s Net.TcpStream
     -> With t Net.TcpStream
     -> Co e Unit
talk c s = do
  p <- Net.peer s
  mine <- Net.thisSide c
  print ("peer: " ^ showPeer p mine)
  w <- Net.write c sent
  print ("written: " ^ nameOf w)
  got <- readAll s (Bytes.length sent) Bytes.empty
  print ("server read: " ^ showRead got)
  back <- Net.write s (either (\_ -> Bytes.empty) (\b -> b) got)
  echoed <- readAll c (Bytes.length sent) Bytes.empty
  print ("client read: " ^ showRead echoed)
  d <- Net.shutdown c
  print ("shut down: " ^ nameOf d)
  end <- Net.read s 100
  print ("server read at the end: " ^ showRead end)
  late <- Net.write s b["still here"]
  still <- readAll c 10 Bytes.empty
  print ("client read after its shutdown: " ^ showRead still)

-- (the connection `c` made to `l`: its server's side accepted and had
-- while they talk; that side's `with` ended, the client reads to the
-- end)
connected : {e : HFunctor}
          -> {s t : Type}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> {{ex : exception Net.NetError <: e}}
          -> With s Net.TcpListener
          -> With t Net.TcpStream
          -> Co e Unit
connected l c = do
  Net.accept l (\s -> talk c s)
  gone <- Net.read c 100
  print ("client read, the server's side closed: " ^ showRead gone)

-- (whom the server's side of a connection to `l` sees)
seen : {e : HFunctor}
     -> {s t : Type}
     -> {{io : stdio <: e}}
     -> {{nt : Net.net <: e}}
     -> {{ex : exception Net.NetError <: e}}
     -> String
     -> With s Net.TcpListener
     -> With t Net.TcpStream
     -> Co e Unit
seen what l c = do
  p <- Net.accept l (\s -> Net.peer s)
  print (what ^ ": " ^ either Net.showError (\(x : Net.Address) -> x.host) p)

-- (a connection to `host`, at the port the system picked for `l`)
connectTo : {e : HFunctor}
          -> {s : Type}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> {{ex : exception Net.NetError <: e}}
          -> String
          -> String
          -> With s Net.TcpListener
          -> Net.Address
          -> Co e Unit
connectTo what host l a = do
  print (what ^ ", a port picked: " ^ (if a.port > 0 then "yes" else "no"))
  Net.withConnection { host = host, port = a.port } (\c -> seen what l c)

-- (a listener of a port the system picks, on `host`, and a connection to
-- it there: what the server sees of the client)
picked : {e : HFunctor}
       -> {s : Type}
       -> {{io : stdio <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> String
       -> String
       -> With s Net.TcpListener
       -> Co e Unit
picked what host l = do
  at <- Net.local l
  onRight what (connectTo what host l) at

-- (a name's start: `EAI_...` for any of getaddrinfo's)
nameStart : String -> String
nameStart n = if startsWith "EAI_" n then "EAI_..." else n

-- (the listener `l`, on `port`: a connection to it, and the port
-- listened on again)
sockets : {e : HFunctor}
        -> {s : Type}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> With s Net.TcpListener
        -> Co e Unit
sockets port l = do
  at <- Net.local l
  print
      ("listening: "
       ^ either
         Net.showError
         (\(a : Net.Address) ->
            if a.port == port then "the port given" else show a.port)
         at)
  Net.withConnection (here port) (\c -> connected l c)
  again <-
    tried (Net.withListener (here port) 8 (\l2 -> (pure MkUnit : Co e Unit)))
  print ("listening again on the port: " ^ again)

-- (what fails, thrown and heard; then ports picked, on IPv4, on IPv6
-- and by a name)
others : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> Co e Unit
others refused = do
  r <-
    tried (Net.withConnection (here refused) (\c -> (pure MkUnit : Co e Unit)))
  print ("refused: " ^ r)
  out <-
    tried (Net.withConnection (here 70000) (\c -> (pure MkUnit : Co e Unit)))
  print ("a port out of range: " ^ out)
  bad <-
    tried
      (Net.withConnection
         { host = "no-such-host.invalid", port = 80 }
         (\c -> (pure MkUnit : Co e Unit)))
  print ("a name not resolved: " ^ nameStart bad)
  Net.withListener (here 0) 1 (\l -> picked "ipv4" "127.0.0.1" l)
  try
    Net.withListener { host = "::1", port = 0 } 1 (\l -> picked "ipv6" "::1" l)
  catch (err : Net.NetError) ->
    print "ipv6: none here"
  Net.withListener
      { host = "localhost", port = 0 }
      1
      (\l -> picked "a name, localhost" "localhost" l)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{sys : process <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Co e Unit
program = do
  argv <- args
  case argv of
    (p :: r :: _) -> do
      let port = fromMaybe 0 (parseInt p)
      Net.withListener (here port) 8 (\l -> sockets port l)
      others (fromMaybe 0 (parseInt r))
    _ -> printErr "main PORT REFUSED"

-- (a throw no one heard: said)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> Either Net.NetError Unit
        -> Co e Unit
unheard (Left err) = print ("not heard: " ^ Net.showError err)
unheard (Right u) = pure MkUnit

main : Co world Unit
main =
  bind
    (attempt
       Net.NetError
       (program
          (io := _)
          (nt := _)
          (sys := _)
          (ex := \p -> InL p)))
    (unheard (io := \p -> InL p))
