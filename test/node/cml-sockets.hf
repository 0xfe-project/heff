-- cml's threads doing std.net's operations, waiting on the world through
-- each domain's reactor (`CML.scheduledWithReactor`): while one waits on
-- a socket, the others go on.  Each connection is had by a `with`, in
-- the thread that uses it.  By C alone.
--
--   main     a thread blocked on a read lets another run, whose write
--            it then reads; many clients echoed at once by a server of
--            cml's threads, a thread a connection, each accepted in its
--            own; a connection refused, a name resolved by a thread of
--            its own and one not resolved -- each thrown by its `with`
--            and heard -- while another thread counts;
--            a read ended by the other side's `with` ending, and one by
--            its own; and main done while a thread still waits to
--            accept, let go of
--
-- Each thread says what it does, in an order its ivars and channels
-- keep, whichever domains run them.

module test.node.cml-sockets

import bytes as Bytes
import cml as CML
import co
import exception
import std.domain as Domain
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import resource

-- (127.0.0.1's `port`)
here : Int -> Net.Address
here port = { host = "127.0.0.1", port = port }

-- (where a connection was not made, or a read failed: why)
showFailed : {a : Type} -> Either Net.NetError a -> String
showFailed (Left err) = err.name
showFailed (Right _) = "ok"

showRead : Either Net.NetError Bytes -> String
showRead (Left err) = err.name
showRead (Right b) = debug b

-- (the value of a `Right`; where there is none, the program abandoned:
-- the test's own sockets, which do not fail)
must : {a : Type} -> Either Net.NetError a -> a
must (Right x) = x
must (Left err) = abandon

-- (a `with` that may fail, its throw heard: `ok`, or its error's name)
tried : {e : HFunctor}
      -> {{ex : exception Net.NetError <: e}}
      -> Co e Unit
      -> Co e String
tried c =
  recover (bind c (\u -> pure "ok")) (\(err : Net.NetError) -> pure err.name)

-- (a thread of its own, its throws heard there and let go of)
apart : {w : HFunctor}
      -> Co (exception Net.NetError <+> (CML.cml w <+> w)) Unit
      -> Co (CML.cml w <+> w) Unit
apart c = bind (attempt Net.NetError c) (\r -> pure ())

repeatG : {e : HFunctor} -> Int -> Co e Unit -> Co e Unit
repeatG 0 c = pure MkUnit
repeatG n c = bind c (\u -> repeatG (n - 1) c)

-- (n values received on ch, added up)
recvSum : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> CML.Chan w Int
        -> Int
        -> Int
        -> Co e Int
recvSum ch 0 acc = pure acc
recvSum ch n acc = do
  x <- CML.recv ch
  recvSum ch (n - 1) (acc + x)

-- A read lets a write run
--------------------------------------------------------------------------------

-- (a thread reads the client's side `c`, nothing written to it yet: it
-- waits, and another runs meanwhile and writes to the server's side
-- `s`, which the first then reads; each says so once the other has
-- said what comes before, by an ivar)
readWrite : {e w : HFunctor}
          -> {s t : Type}
          -> {{cm : CML.cml w <: e}}
          -> {{io : stdio <: e}}
          -> {{iow : stdio <: w}}
          -> {{nt : Net.net <: e}}
          -> {{ntw : Net.net <: w}}
          -> With s Net.TcpStream
          -> With t Net.TcpStream
          -> Co e Unit
readWrite c s = do
  done <- CML.newChan
  reading <- (CML.newIVar : Co e (CML.IVar w Unit))
  wrote <- (CML.newIVar : Co e (CML.IVar w Unit))
  CML.spawn (do
    print "reader: reads"
    CML.putIVar reading MkUnit
    got <- Net.read c 100
    CML.readIVar wrote
    print ("reader: read " ^ showRead got)
    CML.send done 1)
  CML.spawn (do
    CML.readIVar reading
    print "writer: runs while the reader waits"
    w <- Net.write s b["hello"]
    print ("writer: wrote, " ^ showFailed w)
    CML.putIVar wrote MkUnit
    CML.send done 1)
  n <- recvSum done 2 0
  print ("both done: " ^ debug n)

-- | A connection to `l`, both sides had while two threads read one and
-- | write the other.
readThenWrite : {e w : HFunctor}
              -> {s : Type}
              -> {{cm : CML.cml w <: e}}
              -> {{io : stdio <: e}}
              -> {{iow : stdio <: w}}
              -> {{nt : Net.net <: e}}
              -> {{ntw : Net.net <: w}}
              -> {{ex : exception Net.NetError <: e}}
              -> With s Net.TcpListener
              -> Int
              -> Co e Unit
readThenWrite l port =
  Net.withConnection (here port) (\c -> Net.accept l (\s -> readWrite c s))

-- Echo, many at once
--------------------------------------------------------------------------------

-- (a read's bytes written back, then `again`; at the end, done, the
-- connection closed as its `with` ends)
echoed : {e : HFunctor}
       -> {s : Type}
       -> {{nt : Net.net <: e}}
       -> (Unit -> Co e Unit)
       -> With s Net.TcpStream
       -> Either Net.NetError Bytes
       -> Co e Unit
echoed again c (Right b) =
  if Bytes.length b == 0 then pure MkUnit
  else bind (Net.write c b) (\w -> again MkUnit)
echoed again c (Left err) = pure MkUnit

-- (what is read written back, until the other side ends)
echo : {e : HFunctor}
     -> {s : Type}
     -> {{nt : Net.net <: e}}
     -> With s Net.TcpStream
     -> Co e Unit
echo c = bind (Net.read c 4096) (echoed (\u -> echo c) c)

-- (the next connection accepted: a thread spawned to accept the one
-- after, and this one echoed here, had by this thread's `with`; where
-- none is accepted -- the listener's `with` ended -- its throw heard,
-- done)
echoServer : {e w : HFunctor}
           -> {s : Type}
           -> {{cm : CML.cml w <: e}}
           -> {{nt : Net.net <: e}}
           -> {{ntw : Net.net <: w}}
           -> {{ex : exception Net.NetError <: e}}
           -> With s Net.TcpListener
           -> Co e Unit
echoServer l = do
  try
    with Net.accept l as c do
      CML.spawn (apart (echoServer (w := w) l))
      echo c
  catch (err : Net.NetError) ->
    pure MkUnit

-- (n bytes read, in as many reads as they take)
readN : {e : HFunctor}
      -> {s : Type}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpStream
      -> Int
      -> Bytes
      -> Co e Bytes
readN c n acc =
  if Bytes.length acc >= n then pure acc
  else bind
      (Net.read c (n - Bytes.length acc))
      (\r -> readN c n (Bytes.append acc (must r)))

-- (a client's line written on `c` and echoed back, 1 sent on `back`
-- where the echo is the line; then, once main says so on `go`, what it
-- said, the connection closed after)
clientOn : {e w : HFunctor}
         -> {s : Type}
         -> {{cm : CML.cml w <: e}}
         -> {{nt : Net.net <: e}}
         -> {{ntw : Net.net <: w}}
         -> CML.Chan w Int
         -> CML.Chan w Int
         -> Int
         -> With s Net.TcpStream
         -> Co e Int
clientOn back go i c = do
  let line = Bytes.fromString ("client " ^ debug i ^ "\n")
  w <- Net.write c line
  got <- readN c (Bytes.length line) Bytes.empty
  CML.send back (if got == line then 1 else 0)
  CML.recv go

-- | A client: its line written, echoed back; it holds its connection
-- | until every client has had its echo (`all`, each of them sent one
-- | on `back`, and main sends `go` once all have), then says it is done.
client : {e w : HFunctor}
       -> {{cm : CML.cml w <: e}}
       -> {{nt : Net.net <: e}}
       -> {{ntw : Net.net <: w}}
       -> {{ex : exception Net.NetError <: e}}
       -> Int
       -> CML.Chan w Int
       -> CML.Chan w Int
       -> Int
       -> Co e Unit
client port back go i = do
  x <- Net.withConnection (here port) (\c -> clientOn back go i c)
  CML.send back x

-- (clients `i` down to 1, each a thread of its own)
clients : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> CML.Chan w Int
        -> CML.Chan w Int
        -> Int
        -> Co e Unit
clients port back go 0 = pure MkUnit
clients port back go i = do
  CML.spawn (apart (client (w := w) port back go i))
  clients port back go (i - 1)

-- | n clients, each its line echoed, all holding their connections at
-- | once: a server serving one connection at a time would never echo the
-- | second.
echoes : {e w : HFunctor}
       -> {s : Type}
       -> {{cm : CML.cml w <: e}}
       -> {{io : stdio <: e}}
       -> {{iow : stdio <: w}}
       -> {{nt : Net.net <: e}}
       -> {{ntw : Net.net <: w}}
       -> {{ex : exception Net.NetError <: e}}
       -> With s Net.TcpListener
       -> Int
       -> Int
       -> Co e Unit
echoes l port n = do
  CML.spawn (apart (echoServer (w := w) l))
  back <- CML.newChan
  go <- CML.newChan
  clients port back go n
  echoed <- recvSum back n 0
  print ("echoed, all held open at once: " ^ debug echoed)
  repeatG n (CML.send go 1)
  closed <- recvSum back n 0
  print ("closed: " ^ debug closed)

-- What fails, while others run
--------------------------------------------------------------------------------

-- (a thread counting to n, a yield at each)
counting : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> CML.Chan w Int
         -> Int
         -> Int
         -> Co e Unit
counting ch n i =
  if i >= n then CML.send ch i
  else bind CML.yield (\u -> counting ch n (i + 1))

-- (a connection to `localhost` at the port picked for a listener on it:
-- the name resolved, twice)
byName : {e : HFunctor}
       -> {s : Type}
       -> {{nt : Net.net <: e}}
       -> {{ex : exception Net.NetError <: e}}
       -> With s Net.TcpListener
       -> Co e Unit
byName l = do
  at <- Net.local l
  Net.withConnection
      { host = "localhost", port = (must at).port }
      (\c -> (pure MkUnit : Co e Unit))

-- | A connection refused, a name resolved (by a thread of its own) and
-- | one not, each while another thread counts.
failures : {e w : HFunctor}
         -> {{cm : CML.cml w <: e}}
         -> {{io : stdio <: e}}
         -> {{iow : stdio <: w}}
         -> {{nt : Net.net <: e}}
         -> {{ntw : Net.net <: w}}
         -> {{ex : exception Net.NetError <: e}}
         -> Int
         -> Co e Unit
failures refused = do
  counted <- CML.newChan
  CML.spawn (counting counted 1000 0)
  r <-
    tried (Net.withConnection (here refused) (\c -> (pure MkUnit : Co e Unit)))
  print ("refused: " ^ r)
  named <-
    tried (Net.withListener { host = "localhost", port = 0 } 4 (\l -> byName l))
  print ("a name, resolved: " ^ named)
  bad <-
    tried
      (Net.withConnection
         { host = "no-such-host.invalid", port = 80 }
         (\c -> (pure MkUnit : Co e Unit)))
  print
      ("a name not resolved: "
       ^ (if startsWith "EAI_" bad then "EAI_..." else bad))
  n <- CML.recv counted
  print ("counted meanwhile: " ^ debug n)

-- (a read of `c` by a thread of its own: what it came to, said, and
-- `done` told)
reading : {e w : HFunctor}
        -> {s : Type}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{iow : stdio <: w}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> String
        -> CML.Chan w Int
        -> With s Net.TcpStream
        -> Co e Unit
reading what done c = do
  r <- Net.read c 100
  print (what ^ showRead r)
  CML.send done 1

-- (the server's side `s` of the client's `c`: a thread reads `c`, and
-- `s`'s `with` ends while it waits)
otherSideEnds : {e w : HFunctor}
              -> {s t : Type}
              -> {{cm : CML.cml w <: e}}
              -> {{io : stdio <: e}}
              -> {{iow : stdio <: w}}
              -> {{nt : Net.net <: e}}
              -> {{ntw : Net.net <: w}}
              -> CML.Chan w Int
              -> With s Net.TcpStream
              -> With t Net.TcpStream
              -> Co e Unit
otherSideEnds done c s = do
  CML.spawn (reading "read, the other side closed: " done c)
  CML.yield

-- (the server's side `t` of a connection: a thread reads it, and its
-- own `with` ends while it waits)
ownSideEnds : {e w : HFunctor}
            -> {t : Type}
            -> {{cm : CML.cml w <: e}}
            -> {{io : stdio <: e}}
            -> {{iow : stdio <: w}}
            -> {{nt : Net.net <: e}}
            -> {{ntw : Net.net <: w}}
            -> CML.Chan w Int
            -> With t Net.TcpStream
            -> Co e Unit
ownSideEnds done t = do
  CML.spawn (reading "read, its socket closed: " done t)
  CML.yield

-- | A read the other side ends by its `with` ending, and a read whose
-- | own connection's `with` ends.
closings : {e w : HFunctor}
         -> {s : Type}
         -> {{cm : CML.cml w <: e}}
         -> {{io : stdio <: e}}
         -> {{iow : stdio <: w}}
         -> {{nt : Net.net <: e}}
         -> {{ntw : Net.net <: w}}
         -> {{ex : exception Net.NetError <: e}}
         -> With s Net.TcpListener
         -> Int
         -> Co e Unit
closings l port = do
  done <- CML.newChan
  with Net.withConnection (here port) as c do
    Net.accept l (\s -> otherSideEnds done c s)
    CML.recv done
  Net.withConnection (here port) (\d -> Net.accept l (\t -> ownSideEnds done t))
  y <- CML.recv done
  pure MkUnit

-- | Main done while a thread waits to accept, inside its listener's
-- | `with`: the schedule ends, the accept let go of, the listener with
-- | it.
abandoned : {e w : HFunctor}
          -> {{cm : CML.cml w <: e}}
          -> {{nt : Net.net <: e}}
          -> {{ntw : Net.net <: w}}
          -> {{ex : exception Net.NetError <: e}}
          -> Co e Int
abandoned = do
  CML.spawn
      (apart
         (Net.withListener
            (here 0)
            4
            (\l ->
               Net.accept
                 l
                 (\c ->
                    (pure MkUnit :
                       Co (exception Net.NetError <+> (CML.cml w <+> w)) Unit)))))
  CML.yield
  pure 7

-- The program
--------------------------------------------------------------------------------

-- (the listener had: each part of the test on it)
onListener : {e w : HFunctor}
           -> {s : Type}
           -> {{cm : CML.cml w <: e}}
           -> {{io : stdio <: e}}
           -> {{iow : stdio <: w}}
           -> {{nt : Net.net <: e}}
           -> {{ntw : Net.net <: w}}
           -> {{ex : exception Net.NetError <: e}}
           -> Int
           -> With s Net.TcpListener
           -> Co e Unit
onListener refused l = do
  at <- Net.local l
  let port = (must at).port
  readThenWrite l port
  failures refused
  closings l port
  echoes l port 50

program : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{iow : stdio <: w}}
        -> {{nt : Net.net <: e}}
        -> {{ntw : Net.net <: w}}
        -> {{ex : exception Net.NetError <: e}}
        -> Int
        -> Co e Unit
program refused = Net.withListener (here 0) 64 (\l -> onListener refused l)

-- (the first argument, a number)
firstInt : List String -> Int
firstInt (a :: _) = fromMaybe 1 (parseInt a)
firstInt Nil = 1

-- (a port nothing listens on, the first argument)
refusedPort : {e : HFunctor} -> {{sys : process <: e}} -> Co e Int
refusedPort = bind args (\argv -> pure (firstInt argv))

-- (what main came to: a deadlock, a throw no thread heard, or its answer)
said : {a : Type} -> (a -> String) -> Maybe (Either Net.NetError a) -> String
said sh Nothing = "a deadlock"
said sh (Just (Left err)) = "not heard: " ^ show err
said sh (Just (Right x)) = sh x

main : Co (stdio <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain) Unit
main = do
  refused <- refusedPort (sys := _)
  r <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (program
            (w := stdio <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain)
            (cm := _)
            (io := _)
            (nt := _)
            (ex := _)
            refused))
  print (ev := _) (said (\u -> "main done") r)
  a <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (abandoned
            (w := stdio <+> Net.net <+> Reactor.reactor <+> process <+> Domain.domain)
            (cm := _)
            (nt := _)
            (ex := _)))
  print (ev := _) ("abandoned, main's answer: " ^ said debug a)
