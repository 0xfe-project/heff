-- Slices given to the system: a long slice is a view of the string it
-- was cut from, its bytes followed by the rest of that string, not a
-- NUL -- each made a C string of its own where it crosses: a file's
-- path and content, a command's arguments, an environment variable's
-- name, what is printed.

module test.node.sliced

import co
import exception
import std.filesystem
import std.io
import std.path as Path
import std.process

-- (`n` times `s`, built where the program runs)
repeated : String -> Int -> String
repeated s n = if n <= 0 then "" else s ^ repeated s (n - 1)

-- (`s` cut out of a longer string, between `<` and `>tail`: a view)
cutOut : String -> String
cutOut s = strSlice ("<" ^ s ^ ">tail") 1 (strLength s + 1)

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> Co e Unit
program = do
  argv <- args
  let dir = fromMaybe "." (List.head argv)
  let path = cutOut (dir ^ "/" ^ repeated "long-name-" 8 ^ ".txt")
  writeFile path (cutOut (repeated "content " 10))
  print "written"
  print (<- readFile path)
  r <-
    run
      { command = "sh"
      , args =
          [ "-c"
          , "printf '%s|' \"$@\""
          , "sh"
          , cutOut (repeated "arg" 30)
          , cutOut (repeated "b" 64)
          ]
      }
  print r.out
  v <- getEnv (cutOut ("HEFF_SLICED_" ^ repeated "NAME" 15))
  print (fromMaybe "no variable" v)

-- (a failure of the files said)
main : Co (stdio <+> process <+> filesystem) Unit
main =
  bind
    (attempt
       FileError
       (program
          (io := _)
          (sys := _)
          (disk := _)
          (fx := _)))
    (either
       (\err -> printErr (ev := _) (show err))
       (\_ -> pure MkUnit))
