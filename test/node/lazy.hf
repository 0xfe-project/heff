-- A `Lazy` forced again and again is computed once, and kept: `fib 32`,
-- forced ten thousand times each way -- a global forced in each call, a
-- local one handed down a loop, one a closure captures -- would take
-- minutes computed each time, not a moment.

module test.node.lazy

import co
import std.io

fib : Int -> Int
fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)

rounds : Int
rounds = 10000

global : ~Int
global = ~(fib 32)

-- (the global forced in each call)
fromGlobal : Int -> Int
fromGlobal k = force global + k

globalLoop : Int -> Int -> Int
globalLoop 0 acc = acc
globalLoop k acc = globalLoop (k - 1) (acc + fromGlobal 0)

-- (`l` forced `k` times, summed)
forcedIn : Int -> ~Int -> Int -> Int
forcedIn 0 l acc = acc
forcedIn k l acc = forcedIn (k - 1) l (acc + force l)

local : Int -> Int
local n = let l = ~(fib n) in forcedIn rounds l 0

-- (a closure forcing what it captures)
captured : Int -> Int -> Int
captured n = let l = ~(fib n) in \k -> force l + k

closureLoop : (Int -> Int) -> Int -> Int -> Int
closureLoop f 0 acc = acc
closureLoop f k acc = closureLoop f (k - 1) (acc + f 0)

program : {{io : stdio <: stdio}} -> Co stdio Unit
program = do
  print ("a global: " ^ show (globalLoop rounds 0))
  print ("a local: " ^ show (local 32))
  print ("a closure's: " ^ show (closureLoop (captured 32) rounds 0))

main : Co stdio Unit
main = program (io := _)
