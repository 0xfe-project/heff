-- A file opened and closed by hand, and one held by a `with` (`with f
-- := open path do`), by C alone: closed where its body ends, where a throw leaves the body for a `catch` outside it,
-- and where a handler between drops the continuation (one of the test's
-- own) -- each before what follows runs; written in one `with` and read
-- back in another; and ten thousand bodies left by a throw, none of their
-- files left open.  What is open is counted: the process's descriptors,
-- `/dev/fd`.

module test.node.withfile

import co
import exception
import std.file
import std.filesystem
import std.io
import std.path as Path

-- (a handler that gives up: `stop` drops the continuation, the answer
-- `Nothing`)
data StopF (m : Type -> Type) x = Stop

stopping : HFunctor
stopping =
  { f = StopF
  , hfmap = \m g p -> case p of
      Stop -> Stop
  , hmap = \m n nt p -> case p of
      Stop -> Stop
  }

stop : {e : HFunctor} -> {{ev : stopping <: e}} -> {a : Type} -> Co e a
stop = op (ev Stop) val

justOr : {e : HFunctor} -> {a : Type} -> Maybe a -> Co e a
justOr (Just x) = val x
justOr Nothing = abandon

maybeFunctor : (e : HFunctor) -> RawFunctor
maybeFunctor e =
  { f = \x -> Co e (Maybe x)
  , fmap = \g m -> bind m (\r -> val (maybe Nothing (\x -> Just (g x)) r))
  }

stopped : (e : HFunctor)
        -> {a : Type}
        -> Co (stopping <+> e) a
        -> Co e (Maybe a)
stopped e c =
  handle
    { M = \x -> Co e (Maybe x)
    , ret = \x -> val (Just x)
    , bind = \m k -> bind m (\r -> maybe (val Nothing) k r)
    , malg = \p -> case p of
        InL t -> val Nothing
        InR q ->
          op
            (e.hmap
               (maybeFunctor e)
               (coFunctor e)
               (\m -> bind m (\r -> justOr r))
               q)
            (\x -> val (Just x))
    }
    c

-- (the descriptors the process has open; 0 where they cannot be listed)
descriptors : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{fx : exception FileError <: e}}
            -> Co e Int
descriptors =
  recover
    (bind (readDirectory "/dev/fd") (\ns -> pure (List.length ns)))
    (\(_ : FileError) -> pure 0)

-- (... more than `base`)
openMore : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> Int
         -> Co e Int
openMore base = do
  n <- descriptors
  pure (n - base)

-- (a line read, as the test says it)
shownLine : Maybe String -> String
shownLine (Just l) = l
shownLine Nothing = "(the end)"

-- (written to a file opened and closed by hand, read back the same way)
roundTrip : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> Int
          -> Path.Path
          -> Co e Unit
roundTrip base path = do
  w <- open (access := Write { exists = Truncate }) path
  writeString w "one\ntwo\n"
  print ("open in the body: " ^ debug (<- openMore base))
  close w
  print ("open after it: " ^ debug (<- openMore base))
  r <- open path
  a <- readLine r
  b <- readLine r
  c <- readLine r
  close r
  print (shownLine a ^ ", " ^ shownLine b ^ ", " ^ shownLine c)

-- (the same, each held by a `with` (`f := open ...`), the body's value
-- what it comes to)
roundTripBound : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{disk : filesystem <: e}}
               -> {{fx : exception FileError <: e}}
               -> Int
               -> Path.Path
               -> Co e Unit
roundTripBound base path = do
  said <- with f := open (access := Write { exists = Truncate }) path do
    writeString f "one\ntwo\n"
    n <- openMore base
    pure ("open in the body: " ^ debug n)
  print said
  print ("open after it: " ^ debug (<- openMore base))
  with f := open path do
    a <- readLine f
    b <- readLine f
    c <- readLine f
    print (shownLine a ^ ", " ^ shownLine b ^ ", " ^ shownLine c)

-- (a throw out of the body, heard by a `catch` outside it: the file
-- closed before the `catch` arm runs)
caughtOutside : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{disk : filesystem <: e}}
              -> {{ex : exception String <: e}}
              -> {{fx : exception FileError <: e}}
              -> Int
              -> Path.Path
              -> Co e Unit
caughtOutside base path = do
  try
    with f := open path do
      l <- readLine f
      print ("read " ^ shownLine l ^ ", open: " ^ debug (<- openMore base))
      (throw "boom" : Co e Unit)
    print "never here"
  catch (why : String) ->
    print ("caught " ^ why ^ ", open: " ^ debug (<- openMore base))

-- (a handler between that drops the continuation)
gaveUp : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{st : stopping <: e}}
       -> {{fx : exception FileError <: e}}
       -> Int
       -> Path.Path
       -> Co e Unit
gaveUp base path = do
  with f := open path do
    print ("stopping, open: " ^ debug (<- openMore base))
    (stop : Co e Unit)
  print "never here"

-- (`n` bodies, each left by a throw heard outside it)
thrownTimes : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{ex : exception String <: e}}
            -> {{fx : exception FileError <: e}}
            -> Path.Path
            -> Int
            -> Co e Int
thrownTimes path n = do
  let mut i = 0
  let mut caught = 0
  while i < n do
    i := i + 1
    try
      with f := open path do
        (throw "again" : Co e Unit)
    catch (why : String) ->
      caught := caught + 1
  return caught

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> Co e Unit
program = do
  base <- descriptors
  dir <- temporaryDirectory "heff-with-"
  let path = dir / "held.txt"
  roundTrip base path
  roundTripBound base path
  r <-
    attempt
      String
      (caughtOutside
         (io := _)
         (disk := _)
         (ex := _)
         (fx := _)
         base
         path)
  s <-
    stopped
      e
      (gaveUp
         (io := _)
         (disk := _)
         (st := _)
         (fx := _)
         base
         path)
  print ("stopped, open: " ^ debug (<- openMore base))
  n <-
    attempt
      String
      (thrownTimes
         (disk := _)
         (ex := _)
         (fx := _)
         path
         10000)
  print
      ("thrown "
       ^ either (\why -> why) (\c -> debug c) n
       ^ " times, open: "
       ^ debug (<- openMore base))
  remove dir
  print "removed"

-- (a throw no one heard: said)
unheard : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> Either FileError Unit
        -> Co e Unit
unheard (Left err) = print ("not heard: " ^ show err)
unheard (Right u) = pure MkUnit

main : Co (stdio <+> filesystem) Unit
main =
  bind
    (attempt
       FileError
       (program
          (io := _)
          (disk := _)
          (fx := _)))
    (unheard (io := _))
