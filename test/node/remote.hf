-- std.remote's both sides, by C alone: an API's server, over
-- std.http.bocserver, and its client, std.http's POSTs, an act awaited,
-- in one program, on boc's behaviours.
--
--   main REFUSED   calls answered, the server's count kept between
--                  them; a client of another build refused; a server
--                  not there (the port REFUSED); a request that is no
--                  POST

module test.node.remote

import boc as BOC
import co
import custodian as Custodian
import exception
import remote as Remote
import std.http as HTTP
import std.http.bocserver as BocServer
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reference
import std.remote as RemoteHTTP
import std.time
import resource
import wire as Wire

-- The API: a count bumped, and a word shouted
data TallyF (m : Type -> Type) x
  = Bump Int (Int -> x)
  | Shout String (String -> x)

tally : HFunctor
tally =
  { f = TallyF
  , hfmap = \m g p -> case p of
      Bump n k -> Bump n (\t -> g (k t))
      Shout s k -> Shout s (\t -> g (k t))
  , hmap = \m n nt p -> case p of
      Bump i k -> Bump i k
      Shout s k -> Shout s k
  }

bump : {e : HFunctor} -> {{api : tally <: e}} -> Int -> Co e Int
bump n = op (api (Bump n (\t -> t))) val

shout : {e : HFunctor} -> {{api : tally <: e}} -> String -> Co e String
shout s = op (api (Shout s (\t -> t))) val

bumpOp : Remote.Operation Int Int
bumpOp = Remote.operation 0 "bump"

shoutOp : Remote.Operation String String
shoutOp = Remote.operation 1 "shout"

called : {m : Type -> Type} -> {x : Type} -> TallyF m x -> Remote.Call x
called (Bump n k) = Remote.call bumpOp n k
called (Shout s k) = Remote.call shoutOp s k

served : {m : Type -> Type} -> List (Remote.Served (TallyF m Bytes))
served =
  [ Remote.serve bumpOp (\n k -> Bump n k)
  , Remote.serve shoutOp (\s k -> Shout s k)
  ]

tallyApi : Remote.Api tally
tallyApi = Remote.api tally "tally" called served

-- (another build of it, by its name)
otherApi : Remote.Api tally
otherApi = Remote.api tally "tally, again" called served

-- The server's real handler: the count in a cell
kept : {e : HFunctor}
     -> {{cell : reference Int <: e}}
     -> Reference Int
     -> {a : Type}
     -> TallyF (Co e) a
     -> Co e a
kept r (Bump n k) = do
  t <- readReference r
  writeReference r (t + n)
  pure (k (t + n))
kept r (Shout s k) = pure (k (s ^ "!"))

-- (what is not the API's)
elsewhere : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
elsewhere r = pure (Server.plain 404 "no such thing\n")

-- The client's program (a byte that is no UTF-8 in a string, sent and
-- back as it is)
session : {e : HFunctor} -> {{api : tally <: e}} -> Co e String
session = do
  a <- bump 2
  b <- bump 40
  s <- shout "h\xffi"
  pure
      (debug a
       ^ " "
       ^ debug b
       ^ ", shouted, its bytes as they were: "
       ^ debug (s == "h\xffi!"))

-- (the session, its calls posted to `url`: what it said, or why not)
calls : {e : HFunctor}
      -> {{web : HTTP.http <: e}}
      -> Remote.Api tally
      -> String
      -> Co e String
calls which url = do
  r <-
    attempt
      Remote.RemoteError
      (Remote.remotely
         (failed := _)
         which
         (RemoteHTTP.posted (web := _) url)
         (session (api := _)))
  pure (either show (\s -> s) r)

-- (a GET of the API: no call)
got : {e : HFunctor} -> {{web : HTTP.http <: e}} -> String -> Co e String
got url = do
  r <- HTTP.get url
  pure
      (either
         show
         (\(res : HTTP.Response) -> debug res.status ^ " " ^ HTTP.text res)
         r)

-- (the API's server's handler: each request routed, its response
-- answered there)
handler : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{cell : reference Int <: e}}
        -> Reference Int
        -> Server.Request
        -> BocServer.Responder e Empty
        -> Co (exception Empty <+> e) Unit
handler r req respond = do
  res <- RemoteHTTP.routed "/api" tallyApi (kept r) elsewhere req
  respond (Whole res)

-- (the client's calls, one after another, each said; then the listener
-- closed, so the server is done; `main done` said after it, by the
-- behaviour awaiting this)
client : {e : HFunctor}
       -> {s : Type}
       -> {{io : stdio <: e}}
       -> {{nt : Net.net <: e}}
       -> {{web : HTTP.http <: e}}
       -> List String
       -> With s Net.TcpListener
       -> String
       -> Co e Unit
client argv ln url = do
  first <- calls tallyApi url
  print ("answered: " ^ first)
  again <- calls tallyApi url
  print ("again, the count kept: " ^ again)
  other <- calls otherApi url
  print ("another build: " ^ other)
  let nowhere = "http://127.0.0.1:" ^ List.foldl (\x y -> y) "1" argv ^ "/api"
  none <- calls tallyApi nowhere
  print ("no server: " ^ strSlice (joinWith "URL" (split nowhere none)) 0 27)
  asked <- got url
  print ("a GET: " ^ asked)
  closed <- Net.closeListener ln
  pure ()

program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{clock : time <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{sys : process <: e}}
        -> {{cell : reference Int <: e}}
        -> Co e (Either Net.NetError Unit)
program = do
  argv <- args
  r <- newReference 0
  Net.withListener { host = "127.0.0.1", port = 0 } 16 (\ln -> do
    at <- Net.local ln
    let port = either (\err -> 0) (\(a : Net.Address) -> a.port) at
    let url = "http://127.0.0.1:" ^ debug port ^ "/api"
    BocServer.serve Empty ln (handler (e := e) r)
    with u := BOC.await (client argv ln url) do
      print "main done")

main : Co
       (BOC.boc
        <+> Custodian.custodian
        <+> stdio
        <+> Net.net
        <+> time
        <+> HTTP.http
        <+> process
        <+> reference Int)
       Unit
main = do
  r <- program
  case r of
    Left err -> print ("not heard: " ^ show err)
    Right u -> pure ()
