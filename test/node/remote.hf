-- std.remote's both sides, by C alone: an API's
-- server, over std.http.server, and its client, std.http's POSTs, in one
-- program, each a green thread scheduled by std.reactor.
--
--   main REFUSED   calls answered, the server's count kept between
--                  them; a client of another build refused; a server
--                  not there (the port REFUSED); a request that is no
--                  POST

module test.node.remote

import co
import exception
import green
import remote as Remote
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import std.reference
import std.remote as RemoteHTTP
import resource
import wire as Wire

-- The API: a count bumped, and a word shouted
data TallyF (m : Type -> Type) x
  = Bump Int (Int -> x)
  | Shout String (String -> x)

tally : HFunctor
tally =
  { f = TallyF
  , hfmap = \m g p -> case p of
      Bump n k -> Bump n (\t -> g (k t))
      Shout s k -> Shout s (\t -> g (k t))
  , hmap = \m n nt p -> case p of
      Bump i k -> Bump i k
      Shout s k -> Shout s k
  }

bump : {e : HFunctor} -> {{api : tally <: e}} -> Int -> Co e Int
bump n = op (api (Bump n (\t -> t))) val

shout : {e : HFunctor} -> {{api : tally <: e}} -> String -> Co e String
shout s = op (api (Shout s (\t -> t))) val

bumpOp : Remote.Operation Int Int
bumpOp = Remote.operation 0 "bump"

shoutOp : Remote.Operation String String
shoutOp = Remote.operation 1 "shout"

called : {m : Type -> Type} -> {x : Type} -> TallyF m x -> Remote.Call x
called (Bump n k) = Remote.call bumpOp n k
called (Shout s k) = Remote.call shoutOp s k

served : {m : Type -> Type} -> List (Remote.Served (TallyF m Bytes))
served =
  [ Remote.serve bumpOp (\n k -> Bump n k)
  , Remote.serve shoutOp (\s k -> Shout s k)
  ]

tallyApi : Remote.Api tally
tallyApi = Remote.api tally "tally" called served

-- (another build of it, by its name)
otherApi : Remote.Api tally
otherApi = Remote.api tally "tally, again" called served

-- The server's real handler: the count in a cell
kept : {e : HFunctor}
     -> {{cell : reference Int <: e}}
     -> Reference Int
     -> {a : Type}
     -> TallyF (Co e) a
     -> Co e a
kept r (Bump n k) = do
  t <- readReference r
  writeReference r (t + n)
  pure (k (t + n))
kept r (Shout s k) = pure (k (s ^ "!"))

-- (what is not the API's)
elsewhere : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
elsewhere r = pure (Server.plain 404 "no such thing\n")

-- The client's program (a byte that is no UTF-8 in a string, sent and
-- back as it is)
session : {e : HFunctor} -> {{api : tally <: e}} -> Co e String
session = do
  a <- bump 2
  b <- bump 40
  s <- shout "h\xffi"
  pure
      (show a
       ^ " "
       ^ show b
       ^ ", shouted, its bytes as they were: "
       ^ show (s == "h\xffi!"))

-- (the session, its calls posted to `url`: what it said, or why not)
calls : {e : HFunctor}
      -> {{web : HTTP.http <: e}}
      -> Remote.Api tally
      -> String
      -> Co e String
calls which url = do
  r <-
    attempt
      Remote.RemoteError
      (Remote.remotely
         (failed := _)
         which
         (RemoteHTTP.posted (web := _) url)
         (session (api := _)))
  pure (either Remote.showRemoteError (\s -> s) r)

-- (a GET of the API: no call)
got : {e : HFunctor} -> {{web : HTTP.http <: e}} -> String -> Co e String
got url = do
  r <- HTTP.get url
  pure
      (either
         HTTP.showError
         (\(res : HTTP.Response) -> show res.status ^ " " ^ HTTP.text res)
         r)

program : {e : HFunctor}
        -> {{gr : green <: e}}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{sys : process <: e}}
        -> {{cell : reference Int <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Co e Unit
program = do
  argv <- args
  r <- newReference 0
  with Net.withListener { host = "127.0.0.1", port = 0 } 16 as ln do
    at <- Net.local ln
    let port = either (\err -> 0) (\(a : Net.Address) -> a.port) at
    let url = "http://127.0.0.1:" ^ show port ^ "/api"
    spawn
        (Server.serveConcurrently
           ln
           (RemoteHTTP.routed "/api" tallyApi (kept r) elsewhere))
    first <- calls tallyApi url
    print ("answered: " ^ first)
    again <- calls tallyApi url
    print ("again, the count kept: " ^ again)
    other <- calls otherApi url
    print ("another build: " ^ other)
    none <-
      calls
        tallyApi
        ("http://127.0.0.1:" ^ List.foldl (\x y -> y) "1" argv ^ "/api")
    print ("no server: " ^ strSlice none 0 22)
    asked <- got url
    print ("a GET: " ^ asked)

-- (what main came to: a deadlock, a throw no thread heard, or done)
said : Maybe (Either Net.NetError Unit) -> String
said Nothing = "a deadlock"
said (Just (Left err)) = "not heard: " ^ Net.showError err
said (Just (Right u)) = "main done"

main : Co (stdio <+> Net.net <+> HTTP.http <+> Reactor.reactor <+> process <+> reference Int) Unit
main = do
  r <-
    Reactor.scheduled
      (rx := _)
      (attempt
         Net.NetError
         (program
            (gr := _)
            (io := _)
            (nt := _)
            (web := _)
            (sys := _)
            (cell := _)
            (ex := _)))
  print (ev := _) (said r)
