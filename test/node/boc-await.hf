-- Acts of the world awaited by boc's behaviours (`BOC.await`), on the
-- C backend's threads: each run outside every behaviour, in the reactor
-- of the worker whose behaviour awaited it, and the behaviour after it
-- spawned once it has come to its value.  What the runs leave is read
-- out of their cowns by a behaviour of a `scheduled` after each.

module test.node.boc-await

import boc as BOC
import co
import custodian as Custodian
import std.duration as Duration
import std.io
import std.signal as Signal
import std.time

-- (`v`, after `ms` milliseconds' sleep)
after : {e : HFunctor}
      -> {a : Type}
      -> {{clock : time <: e}}
      -> Int
      -> a
      -> Co e a
after ms v = bind (sleep (Duration.milliseconds ms)) (\u -> pure v)

-- (what `c` came to, and how long it took, in milliseconds)
timed : {e : HFunctor}
      -> {a : Type}
      -> {{clock : time <: e}}
      -> Co e a
      -> Co e (Int, a)
timed c = do
  start <- monotonic
  x <- c
  end <- monotonic
  pure (Duration.totalNanoseconds (end - start) / 1000000, x)

-- (what the cowns `cs` hold, every behaviour of the `scheduled` before
-- done, said as `f` says, by a behaviour of a `scheduled` of its own)
said : {c : Type}
     -> {e : HFunctor}
     -> c
     -> {{cw : BOC.Cowns c}}
     -> {{bc : BOC.boc <: e}}
     -> {{io : stdio <: e}}
     -> (cw.Contents -> String)
     -> Co e Unit
said cs f =
  BOC.scheduled
    (\why -> abandon)
    (BOC.when cs (\v -> do
       print (f v)
       pure v))

-- (", in time" where `ms` is about `want`, else how long it took)
inTime : Int -> Int -> String
inTime ms want =
  if ms >= want - 20 && ms < want + 250 then ", in time"
  else ", took " ^ debug ms ^ " ms"

-- (three sleeps -- 300, 100 and 200 ms -- awaited by one behaviour, so
-- in one worker's reactor at once, each followed by a behaviour on
-- `log` adding its name)
three : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{clock : time <: e}}
      -> BOC.Cown (List String)
      -> Co e Unit
three log = do
  with l := log do
    with l := log
         r := BOC.await (after 300 "a") do
      l := l ++ [r]
    with l := log
         r := BOC.await (after 100 "b") do
      l := l ++ [r]
    with l := log
         r := BOC.await (after 200 "c") do
      l := l ++ [r]

-- (an act awaited, `n` times, each by the behaviour after the last,
-- one on no cown, which counts `count` up: the run ends only after
-- the last)
chained : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{clock : time <: e}}
        -> BOC.Cown Int
        -> Int
        -> Co e Unit
chained count n =
  if n <= 0 then pure ()
  else do
    with u := BOC.await (after 20 ()) do
      with c := count do
        c := c + 1
      chained count (n - 1)

-- (two acts that fail, one as it starts and one once it has waited,
-- beside a chain of three: `ran` counts their bodies, which never run)
failing : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{clock : time <: e}}
        -> BOC.Cown Int
        -> BOC.Cown Int
        -> Co e Unit
failing ran count = do
  with n := ran
       r := BOC.await (bind (pure ()) (\u -> (abandon : Co e Int))) do
    n := n + 1
  with n := ran
       r := BOC.await (bind (after 50 ()) (\u -> (abandon : Co e Int))) do
    n := n + 1
  chained count 3

-- (acts awaited in a custody, shut down once a sleep of 50 ms is
-- done: a sleep of 5 s and a wait for SIGHUP, given up, their bodies
-- never run -- `ran` counts them -- and the run ends then)
givenUp : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{clock : time <: e}}
        -> {{sg : Signal.signals <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> BOC.Cown Int
        -> Co e Unit
givenUp ran = do
  with k := Custodian.custody do
    with n := ran
         u := BOC.await (after 5000 ()) do
      n := n + 1
    with n := ran
         s := BOC.await (Signal.wait [Hangup]) do
      n := n + 1
    with u := BOC.await (after 50 ()) do
      _ <- Custodian.shutdown k
      pure ()

-- (two races, a sleep of 50 ms against one of 5 s, each way round: what
-- each came to, on the cown, the run ending once the first are done)
raced : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{clock : time <: e}}
      -> BOC.Cown (List String)
      -> Co e Unit
raced log = do
  with l := log
       r := BOC.awaitFirst (after 50 "quick") (after 5000 "slow") do
    l := l ++ [either (\x -> "Left " ^ x) (\y -> "Right " ^ y) r]
  with l := log
       r := BOC.awaitFirst (after 5000 "slow") (after 100 "quick") do
    l := l ++ [either (\x -> "Left " ^ x) (\y -> "Right " ^ y) r]

-- (the sleeps at once, their behaviours on the cown in the order they
-- woke, the chain done before the run ended; acts that fail, `failed`
-- told, the others going on)
program : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> Co e Unit
program = do
  log <- BOC.newCown Nil
  count <- BOC.newCown 0
  (ms, u) <-
    timed
      (BOC.scheduled
         (\why -> printErr ("failed: " ^ why))
         (do
          three log
          chained count 5))
  said
      (log, count)
      (\p -> case p of
       (l, n) ->
         "reactor: " ^ unwords l ^ ", chained " ^ debug n ^ inTime ms 300)
  ran <- BOC.newCown 0
  count3 <- BOC.newCown 0
  BOC.scheduled
      (\why -> print ("an act failed: " ^ why))
      (failing ran count3)
  said
      (ran, count3)
      (\p -> case p of
       (n, c) ->
         "the run: done, their bodies run "
         ^ debug n
         ^ " times, the chain beside them "
         ^ debug c)

-- (acts given up as their custody is shut down, and acts raced: each
-- run in about the time of its quickest)
givingUp : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> {{clock : time <: e}}
         -> {{sg : Signal.signals <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> Co e Unit
givingUp = do
  ran <- BOC.newCown 0
  (ms, u) <-
    timed
      (BOC.scheduled
         (\why -> printErr ("failed: " ^ why))
         (givenUp ran))
  said
      ran
      (\n ->
         "given up: bodies run "
         ^ debug n
         ^ (if ms < 1000 then ", in time" else ", took " ^ debug ms ^ " ms"))
  log <- BOC.newCown Nil
  (ms2, u2) <-
    timed (BOC.scheduled (\why -> printErr ("failed: " ^ why)) (raced log))
  said
      log
      (\l ->
         "raced: "
         ^ joinWith ", " l
         ^ (if ms2 < 1000 then ", in time" else ", took " ^ debug ms2 ^ " ms"))

-- | the program, on the system's threads
main : Co
       (BOC.boc <+> stdio <+> time <+> Signal.signals <+> Custodian.custodian)
       Unit
main = do
  program
  givingUp
