-- Acts of the world awaited by boc's behaviours (`BOC.await`), on the
-- C backend's threads: each run outside every behaviour, in the reactor
-- of the worker whose behaviour awaited it, and the behaviour after it
-- spawned once it has come to its value.  What each part leaves is read
-- out of its cowns by a behaviour waiting until they hold what its last
-- writes, which then starts the next part.

module test.node.boc-await

import boc as BOC
import co
import custodian as Custodian
import std.duration as Duration
import std.io
import std.signal as Signal
import std.time

-- (`v`, after `ms` milliseconds' sleep)
after : {e : HFunctor}
      -> {a : Type}
      -> {{clock : time <: e}}
      -> Int
      -> a
      -> Co e a
after ms v = bind (sleep (Duration.milliseconds ms)) (\u -> pure v)

-- (how long it has been since `start`, in milliseconds)
since : {e : HFunctor} -> {{clock : time <: e}} -> Duration.Duration -> Co e Int
since start = do
  end <- monotonic
  pure (Duration.totalNanoseconds (end - start) / 1000000)

-- (", in time" where `ms` is about `want`, else how long it took)
inTime : Int -> Int -> String
inTime ms want =
  if ms >= want - 20 && ms < want + 250 then ", in time"
  else ", took " ^ debug ms ^ " ms"

-- (three sleeps -- 300, 100 and 200 ms -- awaited by one behaviour, so
-- in one worker's reactor at once, each followed by a behaviour on
-- `log` adding its name)
three : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{clock : time <: e}}
      -> BOC.Cown (List String)
      -> Co e Unit
three log = do
  with l := log do
    with l := log
         r := BOC.await (after 300 "a") do
      l := l ++ [r]
    with l := log
         r := BOC.await (after 100 "b") do
      l := l ++ [r]
    with l := log
         r := BOC.await (after 200 "c") do
      l := l ++ [r]

-- (an act awaited, `n` times, each by the behaviour after the last,
-- one on no cown, which counts `count` up: the run ends only after
-- the last)
chained : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{clock : time <: e}}
        -> BOC.Cown Int
        -> Int
        -> Co e Unit
chained count n =
  if n <= 0 then pure ()
  else do
    with u := BOC.await (after 20 ()) do
      with c := count do
        c := c + 1
      chained count (n - 1)

-- (two acts that fail, one as it starts and one once it has waited,
-- beside a chain of three: `ran` counts their bodies, which never run)
failing : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{clock : time <: e}}
        -> BOC.Cown Int
        -> BOC.Cown Int
        -> Co e Unit
failing ran count = do
  with n := ran
       r := BOC.await (bind (pure ()) (\u -> (abandon : Co e Int))) do
    n := n + 1
  with n := ran
       r := BOC.await (bind (after 50 ()) (\u -> (abandon : Co e Int))) do
    n := n + 1
  chained count 3

-- (acts awaited in a custody, shut down once a sleep of 50 ms is
-- done: a sleep of two minutes, past the test's time, and a wait for
-- SIGHUP, given up, their bodies never run -- each would say so -- and
-- the program not kept by them; `stopped` set then)
givenUp : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> {{sg : Signal.signals <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> BOC.Cown Bool
        -> Co e Unit
givenUp stopped = do
  with k := Custodian.custody do
    with u := BOC.await (after 120000 ()) do
      print "a sleep given up: its body ran"
    with s := BOC.await (Signal.wait [Hangup]) do
      print "a wait given up: its body ran"
    with u := BOC.await (after 50 ()) do
      _ <- Custodian.shutdown k
      with s := stopped do
        s := True

-- (two races, a sleep of 50 ms against one of two minutes, each way
-- round: what each came to, on the cown, the slow ones given up)
raced : {e : HFunctor}
      -> {{bc : BOC.boc <: e}}
      -> {{clock : time <: e}}
      -> BOC.Cown (List String)
      -> Co e Unit
raced log = do
  with l := log
       r := BOC.awaitFirst (after 50 "quick") (after 120000 "slow") do
    l := l ++ [either (\x -> "Left " ^ x) (\y -> "Right " ^ y) r]
  with l := log
       r := BOC.awaitFirst (after 120000 "slow") (after 100 "quick") do
    l := l ++ [either (\x -> "Left " ^ x) (\y -> "Right " ^ y) r]

-- (the sleeps at once, their behaviours on the cown in the order they
-- woke, and the chain beside them, said once all are done; then
-- `next`)
reactor : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> Co e Unit
        -> Co e Unit
reactor next = do
  log <- BOC.newCown Nil
  count <- BOC.newCown 0
  start <- monotonic
  three log
  chained count 5
  with l := log
       n := count
       once List.length l == 3 && n == 5 do
    ms <- since start
    print ("reactor: " ^ unwords l ^ ", chained " ^ debug n ^ inTime ms 300)
    next

-- (acts that fail, said on stderr, the others going on: said once the
-- chain beside them is done; then `next`)
failingActs : {e : HFunctor}
            -> {{bc : BOC.boc <: e}}
            -> {{io : stdio <: e}}
            -> {{clock : time <: e}}
            -> Co e Unit
            -> Co e Unit
failingActs next = do
  ran <- BOC.newCown 0
  count <- BOC.newCown 0
  failing ran count
  with n := ran
       c := count
       once c == 3 do
    print
        ("the run: done, their bodies run "
         ^ debug n
         ^ " times, the chain beside them "
         ^ debug c)
    next

-- (acts given up as their custody is shut down, said once it is, by a
-- behaviour outside it; then `next`)
givingUp : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> {{clock : time <: e}}
         -> {{sg : Signal.signals <: e}}
         -> {{cu : Custodian.custodian <: e}}
         -> Co e Unit
         -> Co e Unit
givingUp next = do
  stopped <- BOC.newCown False
  start <- monotonic
  with s := stopped once s do
    ms <- since start
    print
        ("given up: "
         ^ (if ms < 1000 then "in time" else "took " ^ debug ms ^ " ms"))
    next
  givenUp stopped

-- (acts raced, said once both races are done: each run in about the
-- time of its quickest)
racing : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> {{io : stdio <: e}}
       -> {{clock : time <: e}}
       -> Co e Unit
racing = do
  log <- BOC.newCown Nil
  start <- monotonic
  raced log
  with l := log once List.length l == 2 do
    ms <- since start
    print
        ("raced: "
         ^ joinWith ", " l
         ^ (if ms < 1000 then ", in time" else ", took " ^ debug ms ^ " ms"))

-- | the program, on the system's threads: each part started once the
-- | one before has said its line
main : Co
       (BOC.boc <+> stdio <+> time <+> Signal.signals <+> Custodian.custodian)
       Unit
main = reactor (failingActs (givingUp racing))
