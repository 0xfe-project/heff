-- Acts of the world awaited by boc's behaviours (`BOC.await`), on the
-- C backend's threads, under `BOC.scheduledWithReactor`: each run
-- outside every behaviour, in the reactor of the domain whose behaviour
-- awaited it, and the behaviour after it spawned once it has come to
-- its value.  Under `BOC.scheduled`, run where it is awaited, in turn.

module test.node.boc-await

import boc as BOC
import co
import custodian as Custodian
import std.domain as Domain
import std.duration as Duration
import std.io
import std.reactor as Reactor
import std.time

-- (`v`, after `ms` milliseconds' sleep)
after : {w : HFunctor} -> {a : Type} -> {{clock : time <: w}} -> Int -> a -> Co w a
after ms v = bind (sleep (Duration.milliseconds ms)) (\u -> pure v)

-- (what `c` came to, and how long it took, in milliseconds)
timed : {e : HFunctor}
      -> {a : Type}
      -> {{clock : time <: e}}
      -> Co e a
      -> Co e (Int, a)
timed c = do
  start <- monotonic
  x <- c
  end <- monotonic
  pure (Duration.totalNanoseconds (end - start) / 1000000, x)

-- (three sleeps -- 300, 100 and 200 ms -- awaited by one behaviour, so
-- in one domain's reactor at once, each followed by a behaviour on
-- `log` adding its name: `seen` what `log` holds after each)
three : {e w : HFunctor}
      -> {{bc : BOC.boc w <: e}}
      -> {{clock : time <: w}}
      -> {{dm : Domain.domain <: e}}
      -> {{dmw : Domain.domain <: w}}
      -> BOC.Cown w (List String)
      -> Domain.Atomic (List String)
      -> Co e Unit
three log seen = do
  with l := log do
    with l := log
         r := BOC.await (after 300 "a") do
      l := l ++ [r]
      Domain.set seen l
    with l := log
         r := BOC.await (after 100 "b") do
      l := l ++ [r]
      Domain.set seen l
    with l := log
         r := BOC.await (after 200 "c") do
      l := l ++ [r]
      Domain.set seen l

-- (an act awaited in the body of a behaviour that came after one, `n`
-- times, the last counting `count` up: run ends only after it)
chained : {e w : HFunctor}
        -> {{bc : BOC.boc w <: e}}
        -> {{clock : time <: w}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: w}}
        -> Domain.Atomic Int
        -> Int
        -> Co e Unit
chained count n =
  if n <= 0 then pure ()
  else do
    with u := BOC.await (after 20 ()) do
      _ <- Domain.fetchAdd count 1
      chained count (n - 1)

-- (three sleeps awaited, and a chain of five)
awaits : {e w : HFunctor}
       -> {{bc : BOC.boc w <: e}}
       -> {{clock : time <: w}}
       -> {{dm : Domain.domain <: e}}
       -> {{dmw : Domain.domain <: w}}
       -> Domain.Atomic (List String)
       -> Domain.Atomic Int
       -> Co e Unit
awaits seen count = do
  log <- BOC.newCown Nil
  three log seen
  chained count 5

-- (what the run left)
said : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{dm : Domain.domain <: e}}
     -> String
     -> Int
     -> Int
     -> Domain.Atomic (List String)
     -> Domain.Atomic Int
     -> Co e Unit
said how ms want seen count = do
  l <- Domain.get seen
  n <- Domain.get count
  print
    (how
     ^ ": "
     ^ unwords l
     ^ ", chained "
     ^ debug n
     ^ (if ms >= want - 20 && ms < want + 250 then ", in time"
        else ", took " ^ debug ms ^ " ms"))

-- (two acts that fail, one as it starts and one once it has waited,
-- beside a chain of three: `ran` counts their bodies, which never run)
failing : {e w : HFunctor}
        -> {{bc : BOC.boc w <: e}}
        -> {{clock : time <: w}}
        -> {{dm : Domain.domain <: e}}
        -> {{dmw : Domain.domain <: w}}
        -> Domain.Atomic Int
        -> Domain.Atomic Int
        -> Co e Unit
failing ran count = do
  with r := BOC.await (bind (pure ()) (\u -> (abandon : Co w Int))) do
    _ <- Domain.fetchAdd ran 1
    pure ()
  with r := BOC.await (bind (after 50 ()) (\u -> (abandon : Co w Int))) do
    _ <- Domain.fetchAdd ran 1
    pure ()
  chained count 3

-- (under `scheduledWithReactor`: the sleeps at once, their behaviours
-- on the cown in the order they woke, the chain done before the run
-- ended; under `scheduled`, each sleep in turn; acts that fail, the
-- others going on)
program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{clock : time <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{dm : Domain.domain <: e}}
        -> {{cu : Custodian.custodian <: e}}
        -> Co e Unit
program = do
  seen <- Domain.newAtomic Nil
  count <- Domain.newAtomic 0
  (ms, u) <-
    timed
      (BOC.scheduledWithReactor
         (\why -> printErr ("failed: " ^ why))
         (awaits (bc := _) (clock := _) (dm := _) seen count))
  said "reactor" ms 300 seen count
  seen2 <- Domain.newAtomic Nil
  count2 <- Domain.newAtomic 0
  (ms2, u2) <-
    timed
      (BOC.scheduled
         (\why -> printErr ("failed: " ^ why))
         (awaits (bc := _) (clock := _) (dm := _) seen2 count2))
  said "scheduled" ms2 600 seen2 count2
  ran <- Domain.newAtomic 0
  count3 <- Domain.newAtomic 0
  r <-
    Domain.tried
      (BOC.scheduledWithReactor
         (\why -> print ("an act failed: " ^ why))
         (failing (bc := _) (clock := _) (dm := _) ran count3))
  n <- Domain.get ran
  c <- Domain.get count3
  print
    (either
       (\why -> "the run: " ^ why)
       (\v ->
          "the run: done, their bodies run "
          ^ debug n
          ^ " times, the chain beside them "
          ^ debug c)
       r)

-- | the program, on the system's threads
main : Co (stdio <+> time <+> Reactor.reactor <+> Domain.domain <+> Custodian.custodian) Unit
main = program (io := _) (clock := _) (rx := _) (dm := _) (cu := _)
