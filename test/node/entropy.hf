-- The system's randomness (std.entropy), and generators seeded by it
-- (std.random's `fromEntropy`), by C: as many bytes as asked for, past
-- `getentropy`'s 256 a call too; two gatherings not the same; two
-- generators seeded so drawing apart.

module test.node.entropy

import bytes as Bytes
import co
import std.entropy as Entropy
import std.io
import std.random as Random
import uint64 as UInt64
import uint8 as UInt8

program : {e : HFunctor}
        -> {{ev : Entropy.entropy <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  none <- Entropy.bytes 0
  less <- Entropy.bytes -3
  many <- Entropy.bytes 1000
  a <- Entropy.bytes 32
  b <- Entropy.bytes 32
  print
      ("lengths: "
       ^ debug
         ([Bytes.length none, Bytes.length less, Bytes.length many] : List Int))
  print ("two gatherings the same: " ^ debug (a == b))
  -- (of 1000 bytes, every one 0: no randomness gathered past the first
  -- 256)
  print
      ("the last 744 all 0: "
       ^ debug
         (Bytes.foldl
            (\z x -> z && UInt8.toInt x == 0)
            True
            (Bytes.slice many 256 1000)))
  r <- Random.fromEntropy
  s <- Random.fromEntropy
  print
      ("two generators' first draws the same: "
       ^ debug
         (UInt64.toInt (fst (Random.next r))
          == UInt64.toInt (fst (Random.next s))))
  print
      ("a die thrown: "
       ^ debug (case Random.between r 1 6 of
       (x, _) -> 1 <= x && x <= 6))

main : Co (Entropy.entropy <+> stdio) Unit
main = program (ev := _) (io := _)
