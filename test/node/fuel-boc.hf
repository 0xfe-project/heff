-- A computation held by an operation of the world, run in a behaviour
-- of boc's: computed where the operation runs it -- so std.fuel's
-- `limited` stops a pure loop at the start of it, and a failure there is
-- the behaviour's, told to `failed`.  And exception's `attempt` in a
-- limit does not catch running out of it.  Built with fuel, on C.

module test.node.fuel-boc

import boc as BOC
import co
import exception
import std.fuel as Fuel
import std.io

-- (a loop of no operation, never ending)
spin : Int -> Int
spin n = spin (n + 1)

failing : Unit -> Int
failing u = if 1 == 1 then abandon else 0

-- (what a limit came to)
limitSaid : Maybe Int -> String
limitSaid (Just x) = "Just " ^ debug x
limitSaid Nothing = "Nothing"

-- (a behaviour's: a pure loop limited, what it came to kept on `c`;
-- and one failing at once, why kept on `why`, by `failed`)
behaviours : {e : HFunctor}
           -> {{bc : BOC.boc <: e}}
           -> {{fu : Fuel.fuel <: e}}
           -> BOC.Cown (Maybe Int)
           -> BOC.Cown Int
           -> Co e Unit
behaviours c n = do
  with r := c do
    l <- Fuel.limited 100000 (later (\u -> spin 0))
    r := l
  with m := n do
    x <- later failing
    m := x

main : Co (BOC.boc <+> stdio <+> Fuel.fuel) Unit
main = do
  c <- BOC.newCown (Just 0)
  n <- BOC.newCown 0
  failed <- BOC.newCown ""
  BOC.scheduled
      (\why -> BOC.when failed (\s -> pure why))
      (behaviours c n)
  BOC.scheduled
      (\why -> abandon)
      (BOC.when (c, failed) (\p -> do
       print ("limited in a behaviour: " ^ limitSaid (fst p))
       print ("a behaviour failing: failed " ^ snd p)
       pure p))
  caught <- Fuel.limited 1000 (attempt String (later (\u -> (spin 0 : Int))))
  print
      ("an attempt in a limit: "
       ^ (case caught of
          Just _ -> "caught"
          Nothing -> "Nothing"))
