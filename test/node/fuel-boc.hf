-- A computation held by an operation of the world, run in a behaviour
-- of boc's: computed where the operation runs it -- so std.fuel's
-- `limited` stops a pure loop at the start of it, and a failure there is
-- the behaviour's, said on stderr, the program ending by 1.  And
-- exception's `attempt` in a limit does not catch running out of it.
-- Built with fuel, on C.

module test.node.fuel-boc

import boc as BOC
import co
import exception
import std.fuel as Fuel
import std.io

-- (a loop of no operation, never ending)
spin : Int -> Int
spin n = spin (n + 1)

failing : Unit -> Int
failing u = if 1 == 1 then abandon else 0

-- (what a limit came to)
limitSaid : Maybe Int -> String
limitSaid (Just x) = "Just " ^ debug x
limitSaid Nothing = "Nothing"

-- (a behaviour's: a pure loop limited, what it came to kept on `c`;
-- and one failing at once)
behaviours : {e : HFunctor}
           -> {{bc : BOC.boc <: e}}
           -> {{fu : Fuel.fuel <: e}}
           -> BOC.Cown (Maybe Int)
           -> BOC.Cown Int
           -> Co e Unit
behaviours c n = do
  with r := c do
    l <- Fuel.limited 100000 (later (\u -> spin 0))
    r := l
  with m := n do
    x <- later failing
    m := x

main : Co (BOC.boc <+> stdio <+> Fuel.fuel) Unit
main = do
  caught <- Fuel.limited 1000 (attempt String (later (\u -> (spin 0 : Int))))
  c <- BOC.newCown (Just 0)
  n <- BOC.newCown 0
  behaviours c n
  BOC.when c (\l -> do
    print ("limited in a behaviour: " ^ limitSaid l)
    print
        ("an attempt in a limit: "
         ^ (case caught of
            Just _ -> "caught"
            Nothing -> "Nothing"))
    pure l)
