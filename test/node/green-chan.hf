-- std.chan's typed channels among green threads scheduled by
-- std.reactor (`Reactor.together`, inside the channels' `with`s): a
-- fan-out, as a proxy's, its fetching threads sending their HTTP
-- responses back on a channel of `(Int, Fetched)`, each fan-out a
-- channel of its own.  And a state handled outside the scheduler,
-- written by threads, some of them after a wait: none of it lost.  By
-- C alone.
--
--   main     this program's own server, each answer slower the lower
--            its item, asked by five threads at once: the answers in
--            the order they came, the last asked first, and each
--            fetched; two fan-outs at once, each of its own channel;
--            then six threads adding one to a state outside the
--            scheduler, three after a sleep

module test.node.green-chan

import co
import exception
import green
import state
import std.chan as Chan
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.process
import std.reactor as Reactor
import std.time
import resource

type Fetched = Either HTTP.HttpError HTTP.Response

repeatG : {e : HFunctor} -> Int -> Co e Unit -> Co e Unit
repeatG 0 c = pure MkUnit
repeatG n c = bind c (\u -> repeatG (n - 1) c)

-- (the value of a `Right`; where there is none, the program abandoned)
must : {a : Type} -> Either Net.NetError a -> a
must (Right x) = x
must (Left err) = abandon

-- The server: item `i` answered after (4 - i) * 60 ms
--------------------------------------------------------------------------------

item : {e : HFunctor} -> {{tm : time <: e}} -> Server.Request -> Co e HTTP.Response
item r = do
  let i = fromMaybe 0 (parseInt (strSlice r.target 6 (strLength r.target)))
  sleep ((4 - i) * 60)
  pure (Server.plain 200 ("item " ^ show i))

-- The fan-out
--------------------------------------------------------------------------------

-- (a thread fetching item `i`, its response sent back with its number)
fetcher : {e : HFunctor}
        -> {c : Type}
        -> {{gr : green <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{cf : Chan.chan c (Int, Fetched) <: e}}
        -> Chan.Chan c (Int, Fetched)
        -> String
        -> Int
        -> Co e Unit
fetcher back base i = do
  r <-
    HTTP.send
      { url = base ^ "/item/" ^ show i
      , headers = [MkPair "Connection" "close"]
      }
  Chan.send back (i, r)

spawnFetchers : {e : HFunctor}
              -> {c : Type}
              -> {{gr : green <: e}}
              -> {{web : HTTP.http <: e}}
              -> {{cf : Chan.chan c (Int, Fetched) <: e}}
              -> Chan.Chan c (Int, Fetched)
              -> String
              -> Int
              -> Int
              -> Co e Unit
spawnFetchers back base i n =
  if i < n then do
    spawn (fetcher back base i)
    spawnFetchers back base (i + 1) n
  else pure ()

received : {e : HFunctor}
         -> {c : Type}
         -> {{gr : green <: e}}
         -> {{cf : Chan.chan c (Int, Fetched) <: e}}
         -> Chan.Chan c (Int, Fetched)
         -> Int
         -> Co e (List (Int, Fetched))
received back 0 = pure Nil
received back n = do
  r <- Chan.recv back
  rest <- received back (n - 1)
  pure (r :: rest)

-- | `n` items fetched at once, a thread each, on a channel of its own:
-- | the answers, in the order they came
fanOut : {e : HFunctor}
       -> {c : Type}
       -> {{gr : green <: e}}
       -> {{web : HTTP.http <: e}}
       -> {{cf : Chan.chan c (Int, Fetched) <: e}}
       -> Chan.Chans c (Int, Fetched)
       -> String
       -> Int
       -> Co e (List (Int, Fetched))
fanOut cs base n = do
  back <- Chan.newChan cs
  spawnFetchers back base 0 n
  received back n

bodyOf : Fetched -> String
bodyOf (Right r) = HTTP.text r
bodyOf (Left err) = "error " ^ show err.code

-- (the answers by their numbers)
byNumber : List (Int, Fetched) -> List String
byNumber rs =
  List.map
    (\i -> maybe "missing" (\(p : (Int, Fetched)) -> bodyOf (snd p)) (List.head (List.keepIf (\(p : (Int, Fetched)) -> fst p == i) rs)))
    (List.range 0 (List.length rs - 1))

-- (a fan-out of a thread's, its count told on `done`)
counted : {e : HFunctor}
        -> {c : Type}
        -> {{gr : green <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{cf : Chan.chan c (Int, Fetched) <: e}}
        -> Chan.Chans c (Int, Fetched)
        -> String
        -> Int
        -> Co e Unit
counted cs base done = do
  rs <- fanOut cs base 5
  send done (List.length (List.keepIf (\(p : (Int, Fetched)) -> strEq (bodyOf (snd p)) ("item " ^ show (fst p))) rs))

askedOn : {e : HFunctor}
        -> {s c : Type}
        -> {{gr : green <: e}}
        -> {{io : stdio <: e}}
        -> {{web : HTTP.http <: e}}
        -> {{nt : Net.net <: e}}
        -> {{tm : time <: e}}
        -> {{cf : Chan.chan c (Int, Fetched) <: e}}
        -> Chan.Chans c (Int, Fetched)
        -> With s Net.TcpListener
        -> Co e Unit
askedOn cs l = do
  at <- Net.local l
  spawn (Server.serveConcurrently l item)
  let base = "http://127.0.0.1:" ^ show (must at).port
  rs <- fanOut cs base 5
  print ("arrived: " ^ joinWith " " (List.map (\(p : (Int, Fetched)) -> show (fst p)) rs))
  print ("fetched: " ^ joinWith ", " (byNumber rs))
  done <- newChan
  spawn (counted cs base done)
  spawn (counted cs base done)
  a <- recv done
  b <- recv done
  print ("two at once, each its own channel: " ^ show a ^ " " ^ show b)

asked : {e : HFunctor}
      -> {c : Type}
      -> {{gr : green <: e}}
      -> {{io : stdio <: e}}
      -> {{web : HTTP.http <: e}}
      -> {{nt : Net.net <: e}}
      -> {{tm : time <: e}}
      -> {{ex : exception Net.NetError <: e}}
      -> {{cf : Chan.chan c (Int, Fetched) <: e}}
      -> Chan.Chans c (Int, Fetched)
      -> Co e Unit
asked cs = Net.withListener { host = "127.0.0.1", port = 0 } 64 (\l -> askedOn cs l)

-- (what main came to: a deadlock, a throw no thread heard, or done)
said : Maybe (Either Net.NetError Unit) -> String
said Nothing = "a deadlock"
said (Just (Left err)) = "not heard: " ^ Net.showError err
said (Just (Right u)) = "main done"

-- A state outside the scheduler
--------------------------------------------------------------------------------

bumper : {e : HFunctor}
       -> {{gr : green <: e}}
       -> {{st : state Int <: e}}
       -> {{tm : time <: e}}
       -> Int
       -> Int
       -> Co e Unit
bumper done ms = do
  if ms > 0 then sleep ms else pure ()
  n <- get (ev := st)
  put (ev := st) (n + 1)
  send done 1

bumped : {e : HFunctor}
       -> {{gr : green <: e}}
       -> {{st : state Int <: e}}
       -> {{tm : time <: e}}
       -> Co e Int
bumped = do
  done <- newChan
  repeatG 3 (spawn (bumper done 0))
  repeatG 3 (spawn (bumper done 20))
  repeatG 6 (bind (recv done) (\u -> pure ()))
  get (ev := st)

main : Co (stdio <+> HTTP.http <+> Net.net <+> Reactor.reactor <+> time <+> process) Unit
main = do
  done <- do
    with Chan.channels as cs do
      Reactor.together
        (rx := _)
        (attempt
           Net.NetError
           (asked
              (gr := _)
              (io := _)
              (web := _)
              (nt := _)
              (tm := _)
              (ex := _)
              (cf := _)
              cs))
  print (ev := _) (said done)
  r <-
    runState
      0
      (Reactor.together
         (rx := _)
         (bumped (gr := _) (st := _) (tm := _)))
  print (ev := _) ("a state outside, written by six threads: " ^ show (fromMaybe 0 (fst r)) ^ ", left " ^ show (snd r))
