-- , "  if (true || false) {"
-- , "    a[v0] = (-5i) - (-2147483647i - 1i);"
-- , "  }"
-- , "  a[v0] = i32(bitcast<f32>(0x7f800000u) / (-0.5f));"
-- , "}"
