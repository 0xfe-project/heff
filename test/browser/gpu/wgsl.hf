-- Kernels of browser.gpu.kernel, printed by browser.gpu.wgsl: each statement and
-- expression as WGSL has it.

module test.browser.gpu.wgsl

import co
import float32 as Float32
import browser.gpu.kernel as Kernel
import browser.gpu.wgsl as Wgsl
import uint32 as UInt32

-- What follows has each statement and expression once, and is of no
-- use but that: a row of `m` (4 wide) summed into `sums` by a loop, the
-- squares of its first two into `norms` by a heff recursion; a negative
-- sum halved and negated, but row 0's, else the row's index modulo 3
-- into `norms`.

-- (a heff function, called as the kernel is built: its code inlined)
squared : Kernel.Exp Float32 -> Kernel.Exp Float32
squared x = x * x

-- (a heff recursion, unrolled as the kernel is built)
unrolled : Int -> (Int -> Co Kernel.stmt Unit) -> Co Kernel.stmt Unit
unrolled 0 body = pure MkUnit
unrolled n body = do
  unrolled (n - 1) body
  body (n - 1)

offset : Int -> Kernel.Exp UInt32
offset k = Kernel.lit (UInt32.fromInt k)

lastly : Kernel.Output Float32
       -> Kernel.Output Float32
       -> Kernel.Exp UInt32
       -> Co Kernel.stmt Unit
lastly sums norms row =
  Kernel.ifElse
    (Kernel.both
       (Kernel.lessThan (Kernel.load sums row) (Kernel.lit 0.0))
       (Kernel.negation (Kernel.equalTo row (Kernel.lit 0))))
    (Kernel.store sums row (-(Kernel.load sums row) /. Kernel.lit 2.0))
    (Kernel.store norms row (Kernel.convert (row % Kernel.lit 3)))

inRow : Kernel.Input Float32
      -> Kernel.Output Float32
      -> Kernel.Output Float32
      -> Kernel.Exp UInt32
      -> Co Kernel.stmt Unit
inRow m sums norms row = do
  start <- Kernel.define (row * Kernel.lit 4)
  Kernel.store sums row (Kernel.lit 0.0)
  Kernel.forRange
      (Kernel.lit 0)
      (Kernel.lit 4)
      (\j ->
         Kernel.store
           sums
           row
           (Kernel.load sums row + Kernel.load m (start + j)))
  unrolled
      2
      (\k ->
         Kernel.store
           norms
           (row + offset k)
           (squared (Kernel.load m (start + offset k))))
  lastly sums norms row

perRow : Kernel.Input Float32
       -> Kernel.Output Float32
       -> Kernel.Output Float32
       -> Co Kernel.stmt Unit
perRow m sums norms = do
  row <- Kernel.globalId
  Kernel.ifElse
      (Kernel.atLeast row (Kernel.length sums))
      (pure MkUnit)
      (inRow m sums norms row)

rows : Kernel.Kernel3
       (Kernel.Input Float32)
       (Kernel.Output Float32)
       (Kernel.Output Float32)
rows = Kernel.kernel3 "rows" 32 perRow

