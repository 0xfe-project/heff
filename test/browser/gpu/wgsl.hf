-- , "    }"
-- , "  }"
-- , "}"
-- ]

-- a kernel of one buffer, and literals of each type: signed ones in
-- parentheses, the least `Int32` as a difference, an infinity by its
-- bits
fill : Kernel.Output Int32 -> Co Kernel.stmt Unit
fill a = do
  i <- Kernel.globalId
  Kernel.when
      (Kernel.either (Kernel.lit True) (Kernel.lit False))
      (Kernel.store a i (Kernel.lit (-5) - Kernel.lit -2147483648))
  Kernel.store
      a
      i
      (Kernel.convert (Kernel.lit (Float32.div 1.0 0.0) /. Kernel.lit (-0.5)))

