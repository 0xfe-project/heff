-- , "    }"
-- , "    c[v0 + 0u] = a[v1 + 0u] * a[v1 + 0u];"
-- , "    c[v0 + 1u] = a[v1 + 1u] * a[v1 + 1u];"
-- , "    if ((b[v0] < 0.0f) && (!(v0 == 0u))) {"
-- , "      b[v0] = (-b[v0]) / 2.0f;"
