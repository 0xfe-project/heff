import check

single : Test
single = unit "three" $ do
  y <- pure 2
  y `assertEqual` 2

each : Test
each = withinTime 5000 $ integration "answers" $ do
  x <- pure 1
  case x of
    1 -> subtest "one" $ do
      x `assertEqual` 1
    _ -> x `assertEqual` 2

cases : List Test
cases =
  [ unit "a case" $ case 1 of
      1 -> 1 `assertEqual` 1
      _ -> 1 `assertEqual` 2
  , unit "a name long enough that what comes before the block does not fit it"
    $ do
      1 `assertEqual` 1
  ]
