theory Eq (a : Type) where
  equal : a -> a -> Bool
instance eqList : {a : Type} -> {{e : Eq a}} -> Eq (List a)
eqList = { equal = same }
  where
  same : List a -> List a -> Bool
  same Nil Nil = True
  same (Cons x xs) (Cons y ys) = e.equal x y && same xs ys
  same _ _ = False
count : List Int -> Int
count xs = go 0 xs
  where
  -- the loop
  go : Int -> List Int -> Int
  go n ys = case ys of
    Nil -> n
    Cons _ rest -> go (step n) rest
    where
    step : Int -> Int
    step k = k + 1

  unused : Int
  unused = 0
