module bound

-- a `with` on the right of `<-` goes on the next line, its body indented
-- from `with`, its bindings under the first name
main = do
  r <-
    with f := open "a.txt" do
      putStrLn "hi"
      pure 1
  s <-
    with a := x
         b := y do
      pure 2
  t <-
    with withFile path { access = Read } as h do
      readLine h
  n <-
    with _ := buffered do
      print "one"
  putStrLn (show r)
