data Bool = True | False
data Maybe (a : Type) = Nothing | Just a
f : Bool -> Maybe Bool -> Bool
f a m =
  if a
  then case m of
    Just b -> b
    Nothing -> a
  else a
g : Bool -> Bool -> Bool
g a b =
  if a
  then if b
    then a
    else b
  else b
h : Maybe Bool -> Bool -> Bool
h m c = case m of
  Just a ->
    if a
    then c
    else a
  Nothing -> if c then c else c
k : Bool -> Bool
k a = if a then False else True
p : Bool -> Bool -> Bool -> Bool
p a b c =
  if a
     && b
  then a
  else if (b
           || c)
          && a
  then b
  else c
q : Bool -> Bool -> Unit
q a b = do
  if a
     || b
  then pure MkUnit
  else pure MkUnit
r : Bool -> Bool -> Unit
r a b = do
  if a
  then if b then pure MkUnit
  else pure MkUnit
  if b
  then pure MkUnit
  else if a
  then pure MkUnit
  else do
    pure MkUnit
