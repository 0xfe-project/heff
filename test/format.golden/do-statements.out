import co
import exception
import std.io
-- `let mut`, `:=`, `while`, `for`, `break`, `continue`, `return`, `(<- c)`
-- and `run do`, as written; an `if` without `else`; a statement's `if`
-- and `case` whose arms are statements
f : {e : HFunctor} -> {{io : stdio <: e}} -> List Int -> Co e Int
f xs = do
  let mut total = 0
  let mut seen : List Int = Nil
  for x in xs do
    if x % 2 /= 0 then continue
    if x > 1000 then break
    seen := Cons x seen
    case x % 3 of
      0 -> total := total + x
      _ -> do
        total := total + 1
        if total > 100 then return total
  while total > 0 && List.length seen > 0 do
    total := total - (<- pure 1)
    if total == 7
    then print "seven"
    else print (debug total)
  return total
g : List Int -> Int
g xs = run do
  let mut n = 0
  for x in xs do
    n := n + x
  return n
-- `let ... else`, and `try ... catch` (#100): `catch` under `try`
h : {e : HFunctor}
  -> {{io : stdio <: e}}
  -> {{ex : exception String <: e}}
  -> Maybe Int
  -> Co e Int
h m = do
  let mut n = 0
  let Just y = m else return n
  n := n + y
  try (err := String)
    n := n + 1
    if n > 3 then return n
  catch (s : String) ->
    print s
  try
    print "again"
  catch e ->
    print e
  return n
-- `if <- c` and `case <- c of`
k : {e : HFunctor} -> {{io : stdio <: e}} -> Co e Unit
k = do
  if <- ready then print "ready" else print "not yet"
  case <- next of
    Just x -> print x
    Nothing -> pure ()
-- `p <- for ...`
m : List Int -> List Int
m xs = run do
  ys <- for x in xs do
    if x < 0 then continue
    x * 2
  ys
