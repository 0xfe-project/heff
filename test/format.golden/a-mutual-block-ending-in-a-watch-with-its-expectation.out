-- A watch at the end of a block: its expectation goes under it, at its
-- column, not at the column of what follows the block.
mutual
  even : Int -> Bool
  even n = if n == 0 then True else odd (n - 1)

  odd : Int -> Bool
  odd n = if n == 0 then False else even (n - 1)

  -- >>> even 2
  -- True

-- of after
after : Int
after = 1

mutual
  f : Int -> Int
  f n = g n

  g : Int -> Int
  g n = f n

  -- >>> [f 1, g 2]
  -- [1,
  -- 2]
