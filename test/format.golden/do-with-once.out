import boc as BOC
import co
-- a `with` of bindings with a condition (#135): `once` after the one
-- binding, on its line, or on a line of its own under more, aligned
-- with them, `do` at the end of it, the body indented under `with`
f : {e : HFunctor}
  -> {{bc : BOC.boc <: e}}
  -> BOC.Cown Int
  -> BOC.Cown Int
  -> Int
  -> Co e Unit
f from to n = do
  with a := from
       b := to
       once a >= n do
    a := a - n
    b := b + n
  with c := from once c > 0 do
    c := c - 1
  with x := from
       -- the other
       y := to
       -- a comment
       once x > y
            && y > 0 do
    x := y
  r <-
    with c := from once c > 1 do
      pure ()
  pure r
-- the equation's own `where`, after the body, is its local declarations
g : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> BOC.Cown Int -> Co e Unit
g from = do
  with c := from once c > least do
    c := c - least
  where
  least : Int
  least = 2
