import boc as BOC
import co
import std.file
import std.filesystem
-- a `with` of bindings (#129): each binding on a line of its own, under
-- the first, `do` at the end of the last, the body indented under `with`
f : {e w : HFunctor}
  -> {{bc : BOC.boc w <: e}}
  -> BOC.Cown w Int
  -> BOC.Cown w Int
  -> Int
  -> Co e Unit
f from to n = do
  with a := from
       b := to do
    a := a - n
    b := b + n
  with c := from do
    c := c + 1
  with x := from
       -- the other
       y := to do
    x := y
g : {e : HFunctor}
  -> {{fs : filesystem <: e}}
  -> {{ex : exception FileError <: e}}
  -> String
  -> Co e Unit
g path = do
  with _ := open path do
    pure ()
