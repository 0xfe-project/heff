import boc as BOC
import co
-- a `with` of bindings with a condition (#135): `where` on a line of
-- its own under the bindings, indented, `do` under `with`, the body
-- indented under `with`
f : {e w : HFunctor}
  -> {{bc : BOC.boc w <: e}}
  -> BOC.Cown w Int
  -> BOC.Cown w Int
  -> Int
  -> Co e Unit
f from to n = do
  with a := from
       b := to
    where a >= n
  do
    a := a - n
    b := b + n
  with c := from
    where c > 0
  do
    c := c - 1
  with x := from
       -- the other
       y := to
    -- a comment
    where x > y
          && y > 0
  do
    x := y
  r <-
    with c := from
      where c > 1
    do
      pure ()
  pure r
-- the equation's own `where`, after the body, is its local declarations
g : {e w : HFunctor} -> {{bc : BOC.boc w <: e}} -> BOC.Cown w Int -> Co e Unit
g from = do
  with c := from
    where c > least
  do
    c := c - least
  where
  least : Int
  least = 2
