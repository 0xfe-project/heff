scaled : Int -> List Int -> List Int
scaled k xs = go xs -- the loop
  where
  -- multiply
  times : Int -> Int
  times x = k * x

  go : List Int -> List Int
  go Nil = Nil
  go (y :: ys) = times y :: go ys -- recursion
classify : Maybe Int -> Int
classify m = case m of
  Just x -> cap x
  Nothing -> 0
  where
  cap : Int -> Int
  cap x = x
nested : Int -> Int
nested n = outer n
  where
  outer : Int -> Int
  outer m = inner m
    where
    inner : Int -> Int
    inner k = k * n
