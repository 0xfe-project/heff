-- The corpus of the NbE goldens: records and projections.

module test.nbe.records

type P2 = { x : Int, y : Int }

mk : Int -> Int -> P2
mk a b = { x = a, y = b }

getX : P2 -> Int
getX p = p.x

-- projection of a construction: normalized to the field
throughMk : Int -> Int
throughMk a = getX (mk a a)

swap : P2 -> P2
swap p = { x = p.y, y = p.x }

-- a record of records
type Seg = { from : P2, to : P2 }

flipSeg : Seg -> Seg
flipSeg s = { from = s.to, to = s.from }
