-- The corpus of the NbE goldens: implicit arguments, inferred and given.

module test.nbe.implicits2

idA : {a : Type} -> a -> a
idA x = x

three : Int
three = idA 3

named : Int
named = idA (a := Int) 7

compose : {a : Type}
        -> {b : Type}
        -> {c : Type}
        -> (b -> c)
        -> (a -> b)
        -> a
        -> c
compose f g x = f (g x)

addOneTwice : (Int -> Int) -> Int -> Int
addOneTwice f = compose f f
