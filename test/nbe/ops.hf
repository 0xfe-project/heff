-- The corpus of the NbE goldens: a primitive, operators and fixity.

foreign import intAdd : Int -> Int -> Int
foreign import intMul : Int -> Int -> Int

infixl .+.
infixl .*. above .+.

(.+.) : Int -> Int -> Int
(.+.) = intAdd

(.*.) : Int -> Int -> Int
(.*.) = intMul

seven : Int
seven = 1 .+. 2 .*. 3

grow : Int -> Int
grow n = n .*. n .+. n
