-- The corpus of the NbE goldens: data, its elimination, literals --
-- statically opaque, and the types still full of structure.

data Color = Red | Green | Blue

data Wrap = MkWrap Int Color

next : Color -> Color
next c = case c of
  Red -> Green
  Green -> Blue
  Blue -> Red

unwrap : Wrap -> Int
unwrap (MkWrap n c) = n

rewrap : Wrap -> Wrap
rewrap w = case w of
  MkWrap n c -> MkWrap n (next c)

lit : Int
lit = 42

greetText : String
greetText = "hello"

pickGreen : Wrap -> Color
pickGreen w =
  next
    (next (case w of
     MkWrap n c -> c))
