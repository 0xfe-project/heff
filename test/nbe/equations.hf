-- The corpus of the NbE goldens: equations with nested patterns and
-- literals, and a nested case.

data Bool = True | False

foreign import intEq : Int -> Int -> Bool

data Nat2 = Z | S Nat2

data Pair2 = MkPair2 Nat2 Nat2

isZero : Nat2 -> Nat2
isZero Z = S Z
isZero (S n) = Z

both : Pair2 -> Nat2
both (MkPair2 Z Z) = S Z
both (MkPair2 (S a) b) = a
both (MkPair2 Z (S b)) = b

pick : Int -> Nat2
pick 0 = Z
pick 1 = S Z
pick n = S (S Z)

deep : Pair2 -> Nat2
deep p = case p of
  MkPair2 (S a) (S b) -> a
  MkPair2 _ _ -> Z
