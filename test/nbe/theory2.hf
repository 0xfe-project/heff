-- The corpus of the NbE goldens: a theory, a struct, projections, and
-- a specialisation.

module test.nbe.theory2

theory Pointed where
  t : Type
  base : t

intPointed : Pointed
intPointed = { t = Int, base = 0 }

baseOf : (p : Pointed) -> p.t
baseOf p = p.base

zeroAgain : Int
zeroAgain = baseOf intPointed

shifted : (p : Pointed @ { t = Int }) -> Int
shifted p = p.base
