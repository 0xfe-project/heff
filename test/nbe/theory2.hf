-- The NbE differential's corpus: a theory, a struct, projections, and
-- a specialisation.

theory Pointed where
  t : Type
  base : t

intPointed : Pointed
intPointed = { t = Int, base = 0 }

baseOf : (p : Pointed) -> p.t
baseOf p = p.base

zeroAgain : Int
zeroAgain = baseOf intPointed

shifted : (p : Pointed ~ { t = Int }) -> Int
shifted p = p.base
