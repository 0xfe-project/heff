-- The corpus of the NbE goldens: functions.  No imports, so the dump
-- stays small, and every global the dump shows is one defined in here.

module test.nbe.functions

idInt : Int -> Int
idInt x = x

constInt : Int -> Int -> Int
constInt x y = x

compose2 : (Int -> Int) -> (Int -> Int) -> Int -> Int
compose2 f g x = f (g x)

twiceApplied : (Int -> Int) -> Int -> Int
twiceApplied f = compose2 f f

-- a redex in a body: normalized away
applied : Int -> Int
applied y = (\(x : Int) -> idInt x) y

shadow : Int -> Int -> Int
shadow x y = constInt y x
