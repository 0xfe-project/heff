-- The example pages, one project (`heff build` builds them), and the
-- tests' own apps, each compiled for the page (`heff compile
-- --backend=page`) and used on a pretend page, as a person would --
-- clicked, typed in, time passed -- each a subtest holding what the page
-- then shows to what it should.  The page is Node.js's (an app is JavaScript), the tests'
-- pretend page; what is done and what is wanted are here.  And a page
-- and its server, one project: `heff build` makes the server, through C,
-- and the page's script; the server runs, and the page asks it for the
-- notes, each call over the wire, until it is gone.  And a first
-- program, through C: its tests, its build, and what it prints.
--
--   heff test test/apps.hf
--   heff test --run apps/notes test/apps.hf

module test.apps

import bytes as Bytes
import check
import co
import exception
import json as JSON
import std.filesystem
import std.path as Path
import std.process
import resource

-- (what the tests run by is given, else the test fails)
given : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> String
      -> Co e String
given name = do
  v <- getEnv name
  case v of
    Just s -> pure s
    Nothing -> failure (name ^ " is not set: `heff test` sets it")

-- (its status, if it exited)
statusOf : Ended -> String
statusOf (Exited n) = "status " ^ show n
statusOf (Signalled n) = "signal " ^ show n
statusOf TimedOut = "timed out"
statusOf (NotRun err) = "not run: " ^ showProcessError err

-- | how a command ended, and what it said
said : Ran -> String
said r = statusOf r.ended ^ "\n" ^ r.out ^ r.err

-- | what the page said, each what was looked at and what it showed
shown : String -> List (Pair String String)
shown out =
  List.map
    (\l -> case JSON.parse l of
     Right j ->
       MkPair
         (fromMaybe "" (JSON.str ["what"] j))
         (fromMaybe "" (JSON.str ["got"] j))
     Left err -> MkPair "said" l)
    (List.keepIf (\l -> not (strEq (trim l) "")) (lines out))

-- | how what the page showed is not what was wanted
-- | >>> unlike [MkPair "a" "1"] [MkPair "a" "2"]
-- | ["a: \"2\", wanted \"1\""]
unlike : List (Pair String String) -> List (Pair String String) -> List String
unlike want got =
  List.append
    (List.concatMap
       (\w -> case List.find (\g -> strEq (fst g) (fst w)) got of
        Just g ->
          if strEq (snd g) (snd w) then Nil
          else [fst w ^ ": " ^ show (snd g) ^ ", wanted " ^ show (snd w)]
        Nothing -> [fst w ^ ": not shown"])
       want)
    (List.concatMap
       (\g ->
          if List.any (\w -> strEq (fst w) (fst g)) want then Nil
          else [fst g ^ ": " ^ show (snd g) ^ ", not wanted"])
       got)

-- (the test fails, saying each of these, unless there are none)
failingWith : {e : HFunctor}
            -> {{chk : check <: e}}
            -> List String
            -> Co e Unit
failingWith Nil = pure MkUnit
failingWith msgs = failure (joinWith "\n" msgs)

-- | an app for the page: its source, the definition it runs, and its
-- | script's name
type App = { source : String, entry : String, name : String }

-- | a test's app, by its source and its name, the definition it runs
testApp : String -> String -> App
testApp source name = { source = source, entry = name, name = name }

-- | an example page, by its name: the program `main` of the pages'
-- | project
example : String -> App
example n =
  { source = "examples/pages/app/" ^ n ^ "/main.hf", entry = "main", name = n }

-- | an app compiled for the page: its script, in the working directory
compiled : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> App
         -> Co e String
compiled app = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  working <- workingDir
  let here = toString working
  out <- pure (here ^ "/" ^ app.name ^ ".js")
  r <-
    run
      { command = heff
      , args =
          ["compile", app.source, out, "--name", app.entry, "--backend=page"]
      , dir = root
      , timeout = 120000
      }
  if succeeded r then pure out else failure ("not compiled: " ^ said r)

-- (each compiled)
allCompiled : {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{sys : process <: e}}
            -> List App
            -> Co e (List String)
allCompiled Nil = pure Nil
allCompiled (Cons a rest) = do
  s <- compiled a
  ss <- allCompiled rest
  pure (Cons s ss)

-- | apps on the pretend page as `scene` says, what it shows held to
-- | what is wanted
onPage : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> String
       -> List App
       -> List (Pair String String)
       -> Co e Unit
onPage scene apps want = do
  root <- given "HEFF_TEST_ROOT"
  scripts <- allCompiled apps
  r <-
    run
      { command = "node"
      , args = Cons (root ^ "/test/page.mjs") (Cons scene scripts)
      , timeout = 60000
      }
  if succeeded r then failingWith (unlike want (shown r.out))
    else failure (said r)

-- | the example pages, one project: `heff build` builds each page's
-- | script
builtPages : {e : HFunctor}
           -> {{chk : check <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{fx : exception FileError <: e}}
           -> Co e Unit
builtPages = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/pages")
  r <- run { command = heff, args = ["build"], dir = dir, timeout = 300000 }
  scripts <- readDirectory (dir ^ "/.heff/bin")
  if not (succeeded r) then failure ("heff build: " ^ said r)
    else assertEqual
        (List.sort (List.map Path.basename scripts))
        ["clock.js", "counter.js", "greet.js", "pixels.js", "vecadd.js"]

-- (the kernel `vecAdd` is, as WGSL)
kernel : String
kernel =
  joinWith
    "\n"
    [ "@group(0) @binding(0) var<storage, read> a : array<f32>;"
    , "@group(0) @binding(1) var<storage, read> b : array<f32>;"
    , "@group(0) @binding(2) var<storage, read_write> c : array<f32>;"
    , "@compute @workgroup_size(64)"
    , "fn add(@builtin(global_invocation_id) id : vec3<u32>) {"
    , "  let v0 = id.x;"
    , "  if (v0 < arrayLength(&c)) {"
    , "    c[v0] = a[v0] + b[v0];"
    , "  }"
    , "}"
    ]

-- (the kernel `gradient` is, as WGSL)
gradient : String
gradient =
  joinWith
    "\n"
    [ "@group(0) @binding(0) var<storage, read_write> a : array<u32>;"
    , "@compute @workgroup_size(64)"
    , "fn shade(@builtin(global_invocation_id) id : vec3<u32>) {"
    , "  let v0 = id.x;"
    , "  if (v0 < arrayLength(&a)) {"
    , "    let v1 = v0 % 64u;"
    , "    let v2 = v0 / 64u;"
    , "    a[v0] = (((v1 * 255u) / 64u) + (((v2 * 255u) / 64u) * 256u)) + 4278190080u;"
    , "  }"
    , "}"
    ]

-- | each app on its page, a subtest each
pages : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> Co e Unit
pages = do
  subtest "built" builtPages
  subtest
      "counter"
      (onPage
         "counter"
         [example "counter"]
         [ MkPair "at first" "count: 0"
         , MkPair "after 3 clicks" "count: 3"
         , MkPair "after -1" "count: 2"
         ])
  subtest
      "clock"
      (onPage
         "clock"
         [example "clock"]
         [MkPair "at first" "0 ticks", MkPair "after 5 ticks" "5 ticks"])
  -- (elements already on the page, found by a CSS selector and an XPath)
  subtest
      "finder"
      (onPage
         "finder"
         [testApp "test/apps/select.hf" "finder"]
         [ MkPair "by css" "found by css"
         , MkPair "by xpath" "found by xpath"
         , MkPair "elements" "2"
         ])
  -- (an app whose effect is a definition, `page = dom <+> state Int`)
  subtest
      "aliased"
      (onPage
         "aliased"
         [testApp "test/apps/aliased.hf" "aliased"]
         [MkPair "out" "42"])
  -- (std.domain in JavaScript's one domain: test/node/domains-program.hf,
  -- the same lines as on the C backend's threads, test/backends.hf's)
  subtest
      "domains"
      (onPage
         "domains"
         [testApp "test/apps/domains.hf" "domains"]
         [ MkPair
           "out"
           ("fetchAdd by 4: 400000\ncas by 4: 200000\npushed by 4: 4000, their sum 8002000\n"
            ^ "an equal list, not the same: kept\nhanded over by 6: 55\nanswers: 0! 1! 2!\n"
            ^ "a flag read until set: set\nlocked after main let go: 1\n"
            ^ "through a queue by 4, taken by 2: 2002000 cells, heads 6004000\nin the order put: 1 2 3 4 5\n"
            ^ "made and let go of: 100000\ncores: at least one")
         ])
  -- (boc on std.domain in JavaScript's one domain:
  -- test/node/cowns-program.hf, the same lines as on the C backend's
  -- threads, test/backends.hf's)
  subtest
      "cowns"
      (onPage
         "cowns"
         [testApp "test/apps/cowns.hf" "cowns"]
         [ MkPair
           "out"
           ("added by 1000: 1000\naccounts: 600 -150 100 -150 400\n"
            ^ "in the order spawned: yes\nnested: 2 6\n"
            ^ "a failing behaviour: 2 added by the others, scheduled heff:abandon")
         ])
  -- (cml on std.domain in JavaScript's one domain:
  -- test/node/cml-program.hf, the same lines as on the C backend's
  -- threads, test/backends.hf's)
  subtest
      "cml"
      (onPage
         "cml"
         [testApp "test/apps/cml.hf" "cml"]
         [ MkPair
           "out"
           ("pinged: 1\nsummed from 100 senders: 5050\nchosen: a 1, b told: yes\n"
            ^ "guard ran: 0 1 2\nwrapped: 21\nivar read by 3: 7 14 21\n"
            ^ "two always: both chosen\nall waiting: Nothing")
         ])
  -- (std.time beside the page's world, its provider the page's too)
  subtest
      "slept"
      (onPage
         "slept"
         [testApp "test/apps/slept.hf" "slept"]
         [ MkPair "before the time has passed" "sleeping"
         , MkPair "after" "slept"
         ])
  -- (std.time's clocks, read by its provider on the page)
  subtest
      "clocked"
      (onPage
         "clocked"
         [testApp "test/apps/clocked.hf" "clocked"]
         [MkPair "out" "after 2026: True, not fewer: True"])
  -- (a world of the test's own beside the page's, each acting on what
  -- the other's provider handed out: the host's own objects, by value)
  subtest
      "painted"
      (onPage
         "painted"
         [testApp "test/apps/paint.hf" "painted"]
         [ MkPair "class" "red"
         , MkPair "its stamp" "mark: stamped"
         , MkPair "found again" "yes"
         ])
  -- (a `JSString` field of an operation: a JavaScript string to the
  -- provider, its length its text's UTF-16 code units, not its bytes)
  subtest
      "texts"
      (onPage
         "texts"
         [testApp "test/apps/jstext.hf" "texts"]
         [ MkPair
           "out"
           "5 bytes, 5 code units: plain\n7 bytes, 4 code units: é😀a\n3 bytes, 3 code units: x\u{FFFD}y"
         ])
  -- (an app whose definitions have the names of the window's own)
  subtest
      "names"
      (onPage
         "names"
         [testApp "test/apps/names.hf" "names"]
         [MkPair "out" "top name status self parent"])
  subtest
      "greet"
      (onPage
         "greet"
         [example "greet"]
         [ MkPair "at first" "Hello, whoever you are."
         , MkPair "after typing" "Hello, Ada!"
         ])
  -- (two apps on one page, each keeping what it defines to itself)
  subtest
      "two apps"
      (onPage
         "two"
         [example "counter", example "clock"]
         [MkPair "the counter" "count: 1", MkPair "the clock" "1 ticks"])
  -- (a GPU, WebGPU's: where there is none, the page says so; on a
  -- pretend one, the provider's wiring, its kernel the example's
  -- `vecAdd` as WGSL; a real GPU is checked by hand)
  subtest
      "vecadd"
      (onPage
         "vecadd"
         [example "vecadd"]
         [ MkPair "no WebGPU" "gpu: WebGPU is not here"
         , MkPair "on a pretend GPU" "ok"
         , MkPair "its dispatch" "add 16 1 1"
         , MkPair "its kernel" kernel
         , MkPair "its buffers let go of" "true,true,true,true"
         ])
  -- (a canvas the DOM made, given to the GPU's canvas effect inside the
  -- same `with`s: on a pretend GPU, the kernel over the pixels, and the
  -- buffer copied onto the canvas, configured for the device)
  subtest
      "pixels"
      (onPage
         "pixels"
         [example "pixels"]
         [ MkPair "no WebGPU" "gpu: WebGPU is not here"
         , MkPair "drawn" "drawn"
         , MkPair "its dispatch" "shade 64 1 1"
         , MkPair "its kernel" gradient
         , MkPair
           "on the canvas"
           "canvas 64x64 rgba8unorm, 16384 bytes, pixel 1: 1,0,0,0"
         , MkPair "its buffers let go of" "true"
         ])

-- (lines read from the page until it says to lose the server)
readUntilLost : {e : HFunctor}
              -> {s : Type}
              -> {{sys : process <: e}}
              -> With s Started
              -> String
              -> Co e String
readUntilLost p sofar = do
  l <- readOutput p (Through "\n") 60000
  case l of
    Got b ->
      if contains "lose the server" (Bytes.asString b)
      then pure (sofar ^ Bytes.asString b)
      else readUntilLost p (sofar ^ Bytes.asString b)
    _ -> pure sofar

-- | the notes, a page and its server: its API's test first, the calls
-- | through the wire with no network; then built, the server run, and
-- | its page asking it, on two pages; a call of another build of the
-- | API refused, and why; the server gone, a call's failure said on the
-- | page
notes : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> {{disk : filesystem <: e}}
      -> Co e Unit
notes = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/notes")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  ports <-
    run
      { command = "node"
      , args = [root ^ "/test/peers.mjs", "ports", "1"]
      , timeout = 30000
      }
  port <- pure (trim ports.out)
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
    else if not (succeeded built) then failure ("heff build: " ^ said built)
    else do
      all <-
        withProcess
          { command = dir ^ "/.heff/bin/server"
          , args = [port]
          , dir = dir
          , timeout = 120000
          }
          (\server ->
             withProcess
               { command = "node"
               , args =
                   [ root ^ "/test/page.mjs"
                   , "notes"
                   , "http://127.0.0.1:" ^ port
                   ]
               , input = Piped
               , output = Piped
               , timeout = 120000
               } (\page -> do
             before <- readUntilLost page ""
             gone <- terminate server
             ok <- writeInput page (Bytes.fromString "\n")
             r <- wait page
             pure (before ^ r.out)))
      failingWith
          (unlike
             [ MkPair "served" "true"
             , MkPair "as the server has them" "[ ] milk|[ ] bread"
             , MkPair "on another page" "[x] milk|[ ] bread"
             , MkPair "another build" "hw 1 2 1"
             , MkPair "why" "true"
             , MkPair "lose the server" ""
             , MkPair "a call to no server" "true"
             , MkPair "as they were" "[x] milk|[ ] bread"
             , MkPair "stray rejections" ""
             ]
             (shown all))

-- | the first program: its tests, then built, through C, and run on
-- | some numbers, what it printed held to what it should
collatz : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> Co e Unit
collatz = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/collatz")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
    else if not (succeeded built) then failure ("heff build: " ^ said built)
    else do
      r <-
        run
          { command = dir ^ "/.heff/bin/collatz"
          , args = ["3", "x", "0", "6"]
          , dir = dir
          , timeout = 60000
          }
      assertEqual
          (said r)
          "status 0\n3: 7 steps\n0: never comes to 1\nmost steps: 7\n"

-- | the todos: tested (the app on keys given) and built
todos : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> Co e Unit
todos = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/todos")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
    else if not (succeeded built) then failure ("heff build: " ^ said built)
    else pure MkUnit

-- | fs_tree: tested, built, and run on a directory made here, what it
-- | drew held to what `tree` draws
fsTree : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> Co e Unit
fsTree = do
  heff <- given "HEFF"
  root <- given "HEFF_TEST_ROOT"
  dir <- pure (root ^ "/examples/fs_tree")
  tested <- run { command = heff, args = ["test"], dir = dir, timeout = 300000 }
  built <- run { command = heff, args = ["build"], dir = dir, timeout = 600000 }
  if not (succeeded tested) then failure ("heff test: " ^ said tested)
    else if not (succeeded built) then failure ("heff build: " ^ said built)
    else do
      makeDirectory "demo/src/lib"
      makeDirectory "demo/docs"
      writeFile "demo/README.md" ""
      writeFile "demo/src/main.hf" ""
      writeFile "demo/src/lib/a.hf" ""
      writeFile "demo/docs/guide.md" ""
      r <-
        run
          { command = dir ^ "/.heff/bin/fs_tree"
          , args = ["demo", "-L", "2"]
          , timeout = 60000
          }
      assertEqual
          (said r)
          "status 0\ndemo\n├── docs\n│\u{a0}\u{a0} └── guide.md\n├── README.md\n└── src\n    ├── lib\n    └── main.hf\n\n4 directories, 3 files\n"

-- | the example apps, on a pretend page, the notes' page and server, the
-- | first program, the todos, and fs_tree
apps : Test
apps =
  group
    "apps"
    [ integration "pages" pages
    , withinTime 600000 (integration "notes" notes)
    , withinTime 600000 (integration "collatz" collatz)
    , withinTime 600000 (integration "todos" todos)
    , withinTime 600000 (integration "fs_tree" fsTree)
    ]
