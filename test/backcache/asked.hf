module test.backcache.asked

import check
import co
import exception
import std.filesystem
import std.process

given : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> String
      -> Co e String
given name = do
  v <- getEnv name
  case v of
    Just s -> pure s
    Nothing -> failure (name ^ " is not set")

compiled : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> String
         -> Co e String
compiled app = do
  heff <- given "HEFF"
  r <- run { command = heff, args = ["version"] }
  if succeeded r then pure app else failure ("not compiled: " ^ r.err)

allCompiled : {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{sys : process <: e}}
            -> List String
            -> Co e (List String)
allCompiled [] = pure Nil
allCompiled (a :: rest) = do
  s <- compiled a
  ss <- allCompiled rest
  pure (s :: ss)

onPage : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> String
       -> List String
       -> String
       -> Co e Unit
onPage scene apps want = do
  root <- given "HEFF_TEST_ROOT"
  scripts <- allCompiled apps
  r <- run { command = "echo", args = scene :: scripts }
  if succeeded r then assertEqual (trim r.out) want else failure (root ^ r.err)

built : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> Co e Unit
built = do
  heff <- given "HEFF"
  r <- run { command = heff, args = ["version"] }
  if not (succeeded r) then failure r.err
  else assertEqual (r.out == "") False

pages : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> Co e Unit
pages = do
  subtest "built" built
  subtest "s0" (onPage "s0" ["a0", "b"] "s0 a0 b")
  subtest "s1" (onPage "s1" ["a1", "b"] "s1 a1 b")
  subtest "s2" (onPage "s2" ["a2", "b"] "s2 a2 b")
  subtest "s3" (onPage "s3" ["a3", "b"] "s3 a3 b")
  subtest "s4" (onPage "s4" ["a4", "b"] "s4 a4 b")
  subtest "s5" (onPage "s5" ["a5", "b"] "s5 a5 b")
  subtest "s6" (onPage "s6" ["a6", "b"] "s6 a6 b")
  subtest "s7" (onPage "s7" ["a7", "b"] "s7 a7 b")

asked : Test
asked = group "asked" [integration "pages" pages]
