module test.backcache.ticking

import co
import browser.dom

tick : {{page : dom <: dom}} -> Element -> Int -> Co dom Unit
tick label n = do
  sleep 100
  text label (show n ^ " ticks")
  tick label (n + 1)

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  with withDocument as doc do
    place <- select doc "#out"
    found place (\r -> do
      label <- textIn doc r "p" "0 ticks"
      tick label 1)

main : Co dom Unit
main = program (page := here dom)
