module test.backcache.ticking

import co
import browser.dom
import custodian

tick : {e : HFunctor} -> {{page : dom <: e}} -> Element -> Int -> Co e Unit
tick label n = do
  sleep 100
  text label (debug n ^ " ticks")
  tick label (n + 1)

program : {e : HFunctor}
        -> {{page : dom <: e}}
        -> {{cu : custodian <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    place <- select doc "#out"
    found place (\r -> do
      label <- textIn doc r "p" "0 ticks"
      tick label 1)

main : Co (dom <+> custodian) Unit
main = program (page := _) (cu := _)
