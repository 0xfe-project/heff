-- Shapes, the fixture of `heff doc`'s golden page: a header comment,
-- then what the module exposes -- data types (one of tags too many
-- for a line), a record type, a theory and its instance, an operator,
-- values with doc comments and doc tests (one of a type too long for a
-- line) -- and what its claim hides, which has no entry.

module test.doc.shapes
  ( Shape(..)
  , Turn(..)
  , Box
  , Sized
  , instanceSizedShape
  , area
  , (<+>)
  , larger
  , unit
  , placed
  )

-- | A shape, by its size.
data Shape = Square Int | Rect Int Int

-- | Which way a shape faces.
data Turn
  = North
  | East
  | South
  | West
  | NorthEast
  | NorthWest
  | SouthEast
  | SouthWest

-- | A box: a shape, and where it is.
type Box = { shape : Shape, x : Int, y : Int }

-- | What has a size.
theory Sized a where
  size : a -> Int

-- (how many cells a shape covers: hidden, as the claim does not list it)
cells : Shape -> Int
cells (Square n) = n * n
cells (Rect w h) = w * h

-- | A shape's size, its area.
instance instanceSizedShape : Sized Shape
instanceSizedShape = { size = cells }

-- | The area of a shape.
-- | >>> area (Rect 2 3)
-- | 6
area : Shape -> Int
area s = cells s

infixl <+>

-- | Two shapes side by side, as one rectangle as tall as the taller.
(<+>) : Shape -> Shape -> Shape
(<+>) a b = Rect (area a + area b) 1

larger : Shape -> Shape -> Shape
larger a b = if area a >= area b then a else b

-- | The unit square.
unit : Shape
unit = Square 1

-- | A shape joined to another, its place scaled.
placed : Shape
       -> Int
       -> Int
       -> Int
       -> (Shape -> Shape -> Shape)
       -> Shape
       -> Maybe Box
placed s k x y join t = Just { shape = join s t, x = x * k, y = y * k }
