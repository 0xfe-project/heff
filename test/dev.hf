-- `heff dev`: a project of a C program that runs until it is ended (a
-- server's shape), built and run -- the program's output heff's; a
-- source changed, built again and the program run anew; a change that
-- does not build said and waited past, the program kept; and heff dev
-- ended by SIGTERM, what it started ended with it (else its output would
-- be held open by them).  `heff test --watch`, which watches as heff dev
-- does: the project's tests run, then run again as a source changes,
-- until ended by SIGTERM.  Each test a project and a heff dev of its own,
-- run by the heff that runs the tests (`HEFF`); not on Windows:
--
--   heff test --run dev/changes test/dev.hf

module test.dev

import bytes as Bytes
import check
import co
import exception
import std.filesystem
import std.path as Path
import std.process
import resource

-- (what the tests run by is given, else the test fails)
given : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> String
      -> Co e String
given name = do
  v <- getEnv name
  case v of
    Just s -> pure s
    Nothing -> failure (name ^ " is not set: `heff test` sets it")

-- (files written, each a path and its text)
writeAll : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{fx : exception FileError <: e}}
         -> List (Pair String String)
         -> Co e Unit
writeAll Nil = pure MkUnit
writeAll (Cons (MkPair path text) rest) = do
  writeFile path text
  writeAll rest

-- (the test fails, saying what was there, unless it holds)
holds : {e : HFunctor}
      -> {{chk : check <: e}}
      -> String
      -> Bool
      -> String
      -> Co e Unit
holds what True there = pure MkUnit
holds what False there = failure (what ^ "\n" ^ there)

-- The project
--------------------------------------------------------------------------------

-- | the program: greets, on its error stream, then sleeps forever
serving : String
serving =
  unlines
    [ "module app.proj.main"
    , ""
    , "import co"
    , "import proj.greeting"
    , "import std.io"
    , "import std.duration as Duration"
    , "import std.time as Time"
    , ""
    , "forever : {e : HFunctor} -> {{clock : Time.time <: e}} -> Co e Unit"
    , "forever = do"
    , "  Time.sleep (Duration.seconds 1)"
    , "  forever"
    , ""
    , "main : Co (stdio <+> Time.time) Unit"
    , "main = do"
    , "  printErr (greeting \"server\")"
    , "  forever"
    , ""
    ]

-- | the project `proj` and its program
project : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
project = do
  heff <- given "HEFF"
  made <- run { command = heff, args = ["init", "proj"] }
  holds "heff init" (succeeded made) made.err
  writeAll [MkPair "proj/app/proj/main.hf" serving]

-- heff dev
--------------------------------------------------------------------------------

-- | heff dev, running (held by `withDev`): its process's number
type Dev = { pid : String }

-- | what is read of its output (and errors), after `said`, until `ok`
-- | holds of it all or `ms` milliseconds have gone by waiting: all read,
-- | and whether the output ended
readUntil : {e : HFunctor}
          -> {s : Type}
          -> {{sys : process <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> With s Started
          -> (String -> Bool)
          -> Int
          -> String
          -> Co e (Pair String Bool)
readUntil p ok ms said =
  if ok said || ms <= 0 then pure (MkPair said False)
  else do
    r <- readOutput p Available 20
    case r of
      Got b -> readUntil p ok ms (said ^ Bytes.asString b)
      Timeout -> readUntil p ok (ms - 20) said
      Closed -> pure (MkPair said True)

-- | what it has said, once it has said something `ok` holds of (a minute
-- | at most)
saidOnce : {e : HFunctor}
         -> {s : Type}
         -> {{sys : process <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> With s Started
         -> (String -> Bool)
         -> String
         -> Co e String
saidOnce p ok said = do
  r <- readUntil p ok 60000 said
  pure (fst r)

-- (the first line of a text)
firstLine : String -> String
firstLine s = fromMaybe "" (List.head (lines s))

-- | heff dev started in the project, its output and its errors one;
-- | held by `body`, given it and its `Dev`, and ended when `body` ends
withDev : {e : HFunctor}
        -> {a : Type}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> ({s : Type} -> With s Started -> Dev -> Co e a)
        -> Co e a
withDev body = do
  heff <- given "HEFF"
  project
  withProcess
      { command = "sh"
      , args =
          [ "-c"
          , "echo $$; exec \"$0\" \"$@\" 2>&1"
          , heff
          , "dev"
          ]
      , dir = "proj"
      , output = Piped
      } (\p -> do
    line <- readOutput p (Through "\n") 10000
    case line of
      Got b -> body p { pid = trim (Bytes.asString b) }
      _ -> failure "heff dev not started")

-- | built, and run: what it said by then
started : {e : HFunctor}
        -> {s : Type}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> With s Started
        -> Co e String
started p = do
  said <-
    saidOnce
      p
      (\s ->
         contains "built (1); running proj\n" s
         && contains "Hello, server!\n" s)
      ""
  holds
      "built, and run"
      (contains "built (1); running proj\n" said
       && contains "Hello, server!\n" said)
      said
  pure said

-- | ended by SIGTERM: what it started ended too (else its output would
-- | be held open by them, and it would not be seen to end)
ended : {e : HFunctor}
      -> {s : Type}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> With s Started
      -> Dev
      -> String
      -> Co e Unit
ended p d said = do
  signalled <- run { command = "kill", args = ["-TERM", d.pid] }
  r <- readUntil p (\s -> False) 10000 said
  case r of
    MkPair all True -> do
      ran <- wait p
      holds
          "ended, with what it started"
          (case ran.ended of
           Signalled n -> n == 15
           _ -> False)
          (all ^ ran.out)
    MkPair all False -> do
      ran <- terminate p
      failure ("not ended, with what it started, in 10 seconds\n" ^ all)

-- The tests
--------------------------------------------------------------------------------

-- | a change: built again, the program run anew; a change that does not
-- | build: said, waited past, the program kept; mended, built again
changes : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
changes =
  withDev (\p d -> do
    said <- started p
    g <- pure "proj/src/proj/greeting.hf"
    original <- readFile g
    text <- pure original
    writeAll [MkPair g (joinWith "\"Howdy, \"" (split "\"Hello, \"" text))]
    again <-
      saidOnce
        p
        (\s ->
           contains "built (2); running proj\n" s
           && contains "Howdy, server!\n" s)
        said
    holds
        "a change, built and run again"
        (contains "built (2); running proj\n" again
         && contains "Howdy, server!\n" again)
        again
    writeAll
        [MkPair g (joinWith "\"Hello, \" ^ 1" (split "\"Hello, \"" text))]
    notBuilt <- pure "heff dev: not built; built again at the next change\n"
    wrong <-
      saidOnce
        p
        (\s ->
           contains
             notBuilt
             (fromMaybe "" (List.last (split "error[E0311]" s)))
           && contains "error[E0311]" s)
        again
    holds
        "a change that does not build"
        (contains "error[E0311]" wrong
         && contains
           notBuilt
           (fromMaybe "" (List.last (split "error[E0311]" wrong))))
        wrong
    holds "the program kept" (not (contains "proj ended" wrong)) wrong
    writeAll [MkPair g text]
    mended <- saidOnce p (\s -> contains "built (3); running proj\n" s) wrong
    holds
        "mended, built again"
        (contains "built (3); running proj\n" mended)
        mended
    ended p d mended)

-- | heff test --watch: the tests run, a source changed and they run
-- | again (and fail), then ended by SIGTERM
watched : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
watched = do
  heff <- given "HEFF"
  made <- run { command = heff, args = ["init", "proj"] }
  holds "heff init" (succeeded made) made.err
  withProcess
      { command = "sh"
      , args =
          [ "-c"
          , "echo $$; exec \"$0\" \"$@\" 2>&1"
          , heff
          , "test"
          , "--watch"
          ]
      , dir = "proj"
      , output = Piped
      } (\p -> do
    line <- readOutput p (Through "\n") 10000
    pid <- case line of
      Got b -> pure (trim (Bytes.asString b))
      _ -> failure "heff test --watch not started"
    d <- pure { pid = pid }
    first <-
      saidOnce
        p
        (\t -> contains "heff test: tested (1), all held" t)
        ""
    holds
        "the tests run"
        (contains "1/1 tests hold" first
         && contains "heff test: tested (1), all held" first)
        first
    g <- pure "proj/src/proj/greeting.hf"
    original <- readFile g
    writeAll
        [ MkPair
          g
          (joinWith
             "\"Howdy there, \""
             (split "\"Hello, \"" original))
        ]
    again <-
      saidOnce
        p
        (\t -> contains "heff test: tested (2), not all held" t)
        first
    holds
        "a change, tested again"
        (contains "heff test: a change; tested again" again
         && contains "0/1 tests hold" again
         && contains "heff test: tested (2), not all held" again)
        again
    ended p d again)

-- (each test skipped on Windows)
posix : ({e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> {{fx : exception FileError <: e}}
         -> Co e Unit)
      -> ({e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> {{fx : exception FileError <: e}}
          -> Co e Unit)
posix body = do
  p <- platform
  if strEq p "win32" then skip "not on Windows" else body

-- | heff dev: its program built again as its sources change; heff test
-- | --watch, which watches as it does
devTests : Test
devTests =
  group
    "dev"
    [ integration "changes" (posix changes)
    , integration "test-watch" (posix watched)
    ]
