data Bool = 'false | 'true

data Option a = 'some a | 'none

theory Eq where
  t :: Type
  eq :: t -> t -> Bool

theory Map where
  key :: Type
  map :: Type -> Type
  empty :: (a :: Type) -> map a
  add :: (a :: Type) -> key -> a -> map a -> map a
  lookup :: (a :: Type) -> key -> map a -> Option a

LambdaMap :: (Key :: Eq) -> Map
LambdaMap Key = { key = Key.t, map = \a -> Key.t -> Option a, empty = \a x -> 'none, add = \a k v m x -> case Key.eq k x of
  'false -> m x
  'true -> 'some v, lookup = \a x m -> m x }

data Color = 'red | 'green | 'blue

ColorEq :: Eq
ColorEq = { t = Color, eq = \c1 c2 -> case c1 of
  'red -> case c2 of
    'red -> 'true
    'green -> 'false
    'blue -> 'false
  'green -> case c2 of
    'red -> 'false
    'green -> 'true
    'blue -> 'false
  'blue -> case c2 of
    'red -> 'false
    'green -> 'false
    'blue -> 'true }

ColorMap :: Map
ColorMap = LambdaMap ColorEq

redMap :: Color -> Option Bool
redMap = ColorMap.add Bool 'red 'true (ColorMap.empty Bool)

red :: Color
red = 'red

likesRed :: Option Bool
likesRed = ColorMap.lookup Bool 'red redMap

