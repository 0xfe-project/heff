data Bool = False | True

data Option a = Some a | None

theory Eq where
  t : Type
  eq : t -> t -> Bool

theory Map where
  key : Type
  map : Type -> Type
  empty : (a : Type) -> map a
  add : (a : Type) -> key -> a -> map a -> map a
  lookup : (a : Type) -> key -> map a -> Option a

LambdaMap : (Key : Eq) -> Map
LambdaMap Key =
  { key = Key.t
  , map = \a -> Key.t -> Option a
  , empty = \a x -> None
  , add = \a k v m x -> case Key.eq k x of
      False -> m x
      True -> Some v
  , lookup = \a x m -> m x
  }

data Color = Red | Green | Blue

ColorEq : Eq
ColorEq =
  { t = Color
  , eq = \c1 c2 -> case c1 of
      Red -> case c2 of
        Red -> True
        Green -> False
        Blue -> False
      Green -> case c2 of
        Red -> False
        Green -> True
        Blue -> False
      Blue -> case c2 of
        Red -> False
        Green -> False
        Blue -> True
  }

ColorMap : Map
ColorMap = LambdaMap ColorEq

redMap : Color -> Option Bool
redMap = ColorMap.add Bool Red True (ColorMap.empty Bool)

red : Color
red = Red

likesRed : Option Bool
likesRed = ColorMap.lookup Bool Red redMap
