-- Integers known to fit a word (src/heff/compile/ranges.hf, #79): loops
-- whose counters are bounded, done on words in C, and loops that look
-- bounded but are not, which cross 2^62 and must go on as big integers;
-- `%` and `/` of negative words, rounded down; a parameter one of whose
-- calls gives a big integer; arrays indexed by words, their elements
-- words or not.

import array as Array

pow2 : Int -> Int
pow2 0 = 1
pow2 n = 2 * pow2 (n - 1)

-- (counted up to a bound: on words)
countTo : Int -> Int -> Int
countTo i acc = if i == 1000 then acc else countTo (i + 1) (acc + i % 7)

counted : Int
counted = countTo 0 0

-- (up to `n`, from just below the edge of a word to past it: `i == n`
-- bounds `i`, but `n` is no word)
climb : Int -> Int -> Int
climb i n = if i == n then i else climb (i + 1) n

climbed : List Int
climbed =
  [ climb 4611686018427387900 4611686018427387910
  , climb (pow2 62 - 3) (pow2 62 + 3)
  , climb (0 - pow2 62 - 2) (0 - pow2 62 + 2)
  ]

-- (bounded below only: `i < 100` holds of every negative, and the square
-- of one is no word)
square : Int -> Int
square i = if i < 100 then square (i * i + 2) else i

squared : List Int
squared = [square 3, square (-5000000000), square (0 - pow2 40)]

-- (the remainders and quotients of words of either sign, by divisors of
-- either sign, rounded down)
signs : Int -> Int -> Int
signs i acc =
  if i == 20 then acc
  else
    signs
      (i + 1)
      (acc
       + (i - 10) % 3
       + (i - 10) / 3
       + (10 - i) % (-3)
       + (10 - i) / (-4)
       + (i - 10) % (i - 21)
       + (i - 10) / (i - 21))

signed : Int
signed = signs 0 0

remainders : List Int
remainders =
  List.map (\i -> i % 7) (List.range (-10) 10)

-- (a remainder made a `Float64`, of words of either sign)
floats : Int -> Float64 -> Float64
floats i acc =
  if i >= 30 then acc
  else floats (i + 1) (acc + toFloat ((i - 15) % 4) + toFloat (i - 15))

floated : Float64
floated = floats 0 0.0

-- (a counter up to a length)
bytesUpTo : String -> Int -> Int -> Int
bytesUpTo s i acc =
  if i >= strLength s then acc
  else bytesUpTo s (i + 1) (acc + byteAt s i)

bytes : Int
bytes = bytesUpTo "heff ranges" 0 0

-- (counted down by a recursion not last: its parameter from 0 to 25)
fib : Int -> Int
fib k = if k < 2 then k else fib (k - 1) + fib (k - 2)

fibs : List Int
fibs = [fib 25, fib 1, fib 0]

-- (one of whose calls is given a big integer: no word, its parameter)
halve : Int -> Int -> Int
halve n steps = if n < 2 then steps else halve (n / 2) (steps + 1)

halved : List Int
halved = [halve 1000 0, halve (pow2 70 + 1) 0]

-- (a square bounded by a word: its operand by the root)
divisor : Int -> Int -> Int
divisor k d =
  if d * d > k then k else if k % d == 0 then d else divisor k (d + 1)

divisors : List Int
divisors = List.map (\k -> divisor k 2) [97, 91, 4611686018427387903, 1000003]

-- (an accumulator, past a word: checked as it grows)
sumTo : Int -> Int -> Int
sumTo i acc = if i == 70 then acc else sumTo (i + 1) (acc + pow2 i)

summed : Int
summed = sumTo 0 0

-- (the same, called with a literal alone: bounded, on words)
divisorOf : Int -> Int -> Int
divisorOf k d =
  if d * d > k then k else if k % d == 0 then d else divisorOf k (d + 1)

firstDivisor : Int
firstDivisor = divisorOf 1000003 2

-- (an array's elements, each a word or not, read in a bounded loop: one
-- known small where it is tested, worked on as a word there)
elements : Array Int
elements = Array.fromList [1, 4611686018427387903, -5, 4611686018427387904, 42]

sumElements : Int -> Int -> Int
sumElements i acc =
  if i >= 5 then acc
  else
    let x = arrayIndex elements i in
    sumElements (i + 1) (if 0 <= x && x < 100 then acc + x % 7 + i else acc + x)

summedElements : Int
summedElements = sumElements 0 0

-- (filled at (7 i + 3) % 101, each the square of its round)
fillAt : Int -> Array Int -> Array Int
fillAt i a = if i >= 101 then a else fillAt (i + 1) (Array.set a ((7 * i + 3) % 101) (i * i))

filled : List Int
filled = arrayToList (fillAt 0 (Array.replicate 101 0))
