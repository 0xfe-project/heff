data Nat = Zero | Succ Nat

data Option (A : Type) = None | Some A

data Empty

data Tm (V : Type) = Var V | App (Tm V) (Tm V) | Lam (Tm (Option V))

liftR : (A : Type) -> (B : Type) -> (f : A -> B) -> (x : Option A) -> Option B
liftR A B f None = None
liftR A B f (Some a) = Some (f a)

rename : (A : Type) -> (B : Type) -> (f : A -> B) -> (t : Tm A) -> Tm B
rename A B f (Var x) = Var (f x)
rename A B f (App u v) = App (rename A B f u) (rename A B f v)
rename A B f (Lam b) = Lam (rename (Option A) (Option B) (liftR A B f) b)

closedId : Tm Empty
closedId = Lam (Var None)

theory Syn where
  repr : Type -> Type
  app : (a : Type) -> (b : Type) -> repr (a -> b) -> repr a -> repr b
  lam : (a : Type) -> (b : Type) -> (repr a -> repr b) -> repr (a -> b)

twice : (S : Syn) -> (a : Type) -> S.repr ((a -> a) -> a -> a)
twice S a =
  S.lam (a -> a) (a -> a) (\f -> S.lam a a (\x -> S.app a a f (S.app a a f x)))
