-- A module's own definition named as a primitive is its own, as any name
-- of its own is: `intAdd`, `strAppend` and `intEq` here are the module's,
-- not the prelude's primitives -- which `+`, `^` and a literal pattern
-- still are -- and `intMul`, which it does not define, is the prelude's.
-- (test/surface.mjs holds the expectations; test/backends.mjs each
-- backend to the interpreter.)

intAdd : Int -> Int -> Int
intAdd a b = a * 10 + b

strAppend : String -> String -> String
strAppend a b = b ^ a

-- | >>> intEq 1 2
-- | True
intEq : Int -> Int -> Bool
intEq _ _ = True

-- | >>> added
-- | 42
added : Int
added = intAdd 4 2

-- | >>> summed
-- | 6
summed : Int
summed = 4 + 2

-- (each a function passed on, not a call the compiler sees through)
-- | >>> digits [1, 2, 3]
-- | 123
digits : List Int -> Int
digits xs = List.foldl intAdd 0 xs

-- | >>> total [1, 2, 3]
-- | 6
total : List Int -> Int
total xs = List.foldl (+) 0 xs

-- | >>> joined
-- | "ba"
joined : String
joined = strAppend "a" "b"

-- | >>> concatenated
-- | "ab"
concatenated : String
concatenated = "a" ^ "b"

-- | >>> backwards ["a", "b", "c"]
-- | "cba"
backwards : List String -> String
backwards xs = List.foldl strAppend "" xs

-- | >>> isZero 1
-- | False
isZero : Int -> Bool
isZero 0 = True
isZero _ = False

-- (and by the primitive where a local is named `intEq`)
-- | >>> shadowed 0
-- | True
shadowed : Int -> Bool
shadowed intEq = case intEq of
  0 -> True
  _ -> False

-- | >>> multiplied
-- | 42
multiplied : Int
multiplied = intMul 6 7

digitsOf : Int
digitsOf = digits [4, 2]

totalOf : Int
totalOf = total [4, 2]

backwardsOf : String
backwardsOf = backwards ["x", "y", "z"]

oneIsZero : Bool
oneIsZero = isZero 1

shadowedZero : Bool
shadowedZero = shadowed 0
