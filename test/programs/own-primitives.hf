-- A module's own definition named as a primitive is its own, as any name
-- of its own is: `intAdd`, `strAppend` and `intEq` here are the module's,
-- not the prelude's primitives -- which `+`, `^` and a literal pattern
-- still are -- and `intMul`, declared again by a `foreign import` of its
-- own, is the primitive itself.  (test/surface.mjs holds the expectations;
-- test/backends.mjs each backend to the interpreter.)

intAdd : Int -> Int -> Int
intAdd a b = a * 10 + b

strAppend : String -> String -> String
strAppend a b = b ^ a

intEq : Int -> Int -> Bool
intEq _ _ = True

foreign import intMul : Int -> Int -> Int

added : Int
added = intAdd 4 2

-- >>> added
-- 42

summed : Int
summed = 4 + 2

-- >>> summed
-- 6

-- (each a function passed on, not a call the compiler sees through)
digits : List Int -> Int
digits xs = List.foldl intAdd 0 xs

total : List Int -> Int
total xs = List.foldl (+) 0 xs

-- >>> digits [1, 2, 3]
-- 123

-- >>> total [1, 2, 3]
-- 6

joined : String
joined = strAppend "a" "b"

-- >>> joined
-- "ba"

concatenated : String
concatenated = "a" ^ "b"

-- >>> concatenated
-- "ab"

backwards : List String -> String
backwards xs = List.foldl strAppend "" xs

-- >>> backwards ["a", "b", "c"]
-- "cba"

isZero : Int -> Bool
isZero 0 = True
isZero _ = False

-- >>> isZero 1
-- False

-- >>> intEq 1 2
-- True

-- (and by the primitive where a local is named `intEq`)
shadowed : Int -> Bool
shadowed intEq = case intEq of
  0 -> True
  _ -> False

-- >>> shadowed 0
-- True

multiplied : Int
multiplied = intMul 6 7

-- >>> multiplied
-- 42

digitsOf : Int
digitsOf = digits [4, 2]

totalOf : Int
totalOf = total [4, 2]

backwardsOf : String
backwardsOf = backwards ["x", "y", "z"]

oneIsZero : Bool
oneIsZero = isZero 1

shadowedZero : Bool
shadowedZero = shadowed 0
