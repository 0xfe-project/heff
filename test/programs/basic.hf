data Bool = 'true | 'false

not : (b : Bool) -> Bool
not 'true = 'false
not 'false = 'true

data Maybe (A : Type) = 'just A | 'nothing

data List (A : Type) = 'cons A (List A) | 'nil

map : (A : Type) -> (B : Type) -> (f : A -> B) -> (xs : List A) -> List B
map A B f ('cons x xs) = 'cons (f x) (map A B f xs)
map A B f 'nil = 'nil

test0 : List Bool
test0 = map Bool Bool not ('cons 'true ('cons 'false 'nil))
