-- Numbers the C backend keeps unboxed (#39) -- a fixed-width integer as
-- its C type, a `Float64` as a `double` -- each backend held to the
-- interpreter: in loops, across 62 bits, wrapping around, divided by 0
-- and by -1, shifted by a negative count, compared (NaN too), and put
-- into a list, a record and a closure and taken out again.  (A value of
-- one is shown as a string: a number does not say its type, where a
-- backend shows it.)

import float32 as Float32
import int64 as Int64
import int8 as Int8
import uint64 as UInt64
import uint8 as UInt8

bool : Bool -> String
bool True = "T"
bool False = "F"

-- Loops
--------------------------------------------------------------------------------

-- (an LCG and a xorshift, all 64 bits used: #39's `mix`)
mix : Int64 -> Int64 -> Int64 -> Int64
mix x acc n =
  if n <= 0 then x + acc
  else let y = x * 6364136223846793005 + 1442695040888963407
       in mix y (xor acc (shiftR y 29)) (n - 1)

mixed : String
mixed = Int64.show (mix 1 0 1000)

-- (beyond 2^63)
spread : UInt64 -> UInt64 -> Int -> UInt64
spread x acc n =
  if n == 0 then acc
  else let y = x * 0x9E3779B97F4A7C15 + 1
       in spread y (xor acc (shiftL y 7) + shiftR y 3) (n - 1)

spreads : String
spreads = UInt64.show (spread UInt64.maxBound 0 500)

-- (an `Int` loop crossing into an `Int64` and back every step)
crossing : Int -> Int -> Int64 -> Int -> String
crossing i n h acc =
  if i >= n then showInt acc ^ " " ^ Int64.show h
  else let h2 = xor h (Int64.fromInt i) * 1099511628211
       in let lo = Int64.toInt (and (shiftR h2 20) 1023)
       in crossing (i + 1) n h2 (acc + lo + i % 7)

crossed : String
crossed = crossing 0 2000 (-3750763034362895579) 0

-- (each step past the greatest or below the least)
bumps : Int8 -> UInt8 -> Int -> String -> String
bumps x u n acc =
  if n == 0 then acc
  else bumps
      (x + 100)
      (u - 77)
      (n - 1)
      (acc ^ " " ^ Int8.show x ^ "/" ^ UInt8.show u)

bumped : String
bumped = bumps 0 0 9 ""

-- (a binding of each arm's value: set in each)
collatz : Int64 -> Int64 -> Int64
collatz x steps =
  if x == 1 then steps
  else let next : Int64 = if x % 2 == 0 then x / 2 else 3 * x + 1
       in collatz next (steps + 1)

collatzSteps : String
collatzSteps =
  joinWith " " (List.map (\k -> Int64.show (collatz k 0)) [27, 97, 871])

-- (used unboxed and given on as a `V` both)
both : Int64 -> List Int64 -> Int -> List Int64
both x acc n = if n == 0 then acc else both (x * 3 + 1) (x :: acc) (n - 1)

bothShown : String
bothShown = joinWith "," (List.map Int64.show (both 1 Nil 45))

-- Edges
--------------------------------------------------------------------------------

edges64 : Int64 -> Int64 -> String
edges64 hi lo =
  joinWith
    " "
    (List.map
       Int64.show
       [ hi + 1
       , lo - 1
       , hi * 2
       , lo * (-1)
       , lo / (-1)
       , lo % (-1)
       , hi / 0
       , hi % 0
       , (-7) / 2
       , (-7) % 2
       , shiftL 1 63
       , shiftR lo 63
       , shiftL 1 (-1)
       , shiftR hi (-2)
       , shiftL hi 64
       ])

int64Edges : String
int64Edges = edges64 Int64.maxBound Int64.minBound

edges8 : Int8 -> Int8 -> String
edges8 hi lo =
  joinWith
    " "
    (List.map
       Int8.show
       [ hi + 1
       , lo - 1
       , hi * hi
       , lo / (-1)
       , lo % (-1)
       , hi / 0
       , hi % 0
       , (-7) / 2
       , (-7) % 2
       , shiftL 1 7
       , shiftR lo 7
       , shiftL 1 (-1)
       , shiftR hi (-2)
       ])

int8Edges : String
int8Edges = edges8 Int8.maxBound Int8.minBound

edgesU64 : UInt64 -> UInt64 -> String
edgesU64 hi lo =
  joinWith
    " "
    (List.map
       UInt64.show
       [ hi + 1
       , lo - 1
       , hi * hi
       , hi / 0
       , hi % 0
       , hi / 3
       , hi % 10
       , shiftR hi 1
       , shiftL hi 63
       ])

uint64Edges : String
uint64Edges = edgesU64 UInt64.maxBound 0

-- (compared where they are tested, and as `Bool`s)
compared64 : Int64 -> Int64 -> String
compared64 a b =
  bool (a == b)
  ^ bool (a < b)
  ^ bool (a <= b)
  ^ (if a < b then "<" else if a == b then "=" else ">")

comparisons64 : String
comparisons64 =
  compared64 Int64.minBound Int64.maxBound
  ^ " "
  ^ compared64 (Int64.maxBound + 1) Int64.minBound
  ^ " "
  ^ compared64 5 5

-- Floats
--------------------------------------------------------------------------------

-- (mandelbrot's escape: z = z^2 + c until |z|^2 > 4)
escape : Float64 -> Float64 -> Float64 -> Float64 -> Int -> Int
escape cr ci zr zi i =
  if i >= 200 || zr * zr + zi * zi > 4.0 then i
  else escape cr ci (zr * zr - zi * zi + cr) (2.0 * zr * zi + ci) (i + 1)

escapes : List Int
escapes =
  List.map
    (\k -> escape (toFloat k /. 10.0 - 1.5) 0.25 0.0 0.0 0)
    (List.range 0 20)

-- (each operation rounded: none fused, `a * b + c` an FMA)
fused : Float64 -> Float64 -> Float64 -> Float64
fused a b c = a * b + c

-- (the operands from a list, not constants the C compiler folds)
unfused : String
unfused =
  joinWith
    " "
    (List.map
       (\p -> showFloat (fused (fst p) 10.0 (snd p)))
       [ MkPair 0.1 (-1.0)
       , MkPair 0.7 (-7.0)
       , MkPair (1.0 /. 3.0) (-3.3333333333333335)
       ])

comparedF : Float64 -> Float64 -> String
comparedF a b =
  bool (a == b)
  ^ bool (a < b)
  ^ bool (a <= b)
  ^ bool (a > b)
  ^ (if a < b then "<" else if a == b then "=" else "?")

nan : Float64
nan = 0.0 /. 0.0

comparisonsF : String
comparisonsF =
  joinWith
    " "
    [ comparedF nan 1.0
    , comparedF nan nan
    , comparedF 1.0 (1.0 /. 0.0)
    , comparedF (0.0 - 0.0) 0.0
    , comparedF 0.1 0.2
    ]

roundedF : Float64 -> String
roundedF x =
  joinWith
    " "
    [ showInt (floor x)
    , showInt (floor (x * 1.0e20))
    , showFloat (sqrt x)
    , showFloat (toFloat (floor x) - x)
    , showFloat (x /. 0.0)
    ]

roundings : String
roundings = roundedF 2.75 ^ " | " ^ roundedF (-2.75)

-- (a recursive function's value tested: bound in the condition)
power : Float64 -> Int -> Float64
power x n = if n == 0 then 1.0 else x * power x (n - 1)

condLets : Float64 -> Int -> Int -> Int
condLets x k acc =
  if k == 0 then acc
  else if power x 2 > 1.0 && power (x * 3.0) 3 < 1000.0
    then condLets (x * 1.3) (k - 1) (acc + 1)
  else condLets (x + 0.9) (k - 1) acc

condLetCount : Int
condLetCount = condLets 0.5 40 0

-- (the same, a `Bool` made of the test: a value bound in it)
inRange : Float64 -> Bool
inRange x = power x 2 > 1.0 && power (x * 3.0) 3 < 1000.0

inRangeCount : Int
inRangeCount =
  List.length (List.filter (\k -> inRange (toFloat k /. 7.0)) (List.range 0 60))

float32Loop : Float32 -> Float32 -> Int -> String
float32Loop x acc n =
  if n == 0 then Float32.show acc ^ " " ^ Float32.show x
  else float32Loop
      (x * Float32.fromFloat 1.0001)
      (acc + x /. Float32.fromFloat 3.0)
      (n - 1)

float32s : String
float32s = float32Loop (Float32.fromFloat 1.0) (Float32.fromFloat 0.0) 1000

-- Into what is uniform, and out
--------------------------------------------------------------------------------

type Point = { x : Float64, y : Float64, n : Int64 }

walkPoints : Float64 -> Int64 -> Int -> List Point -> List Point
walkPoints t n k acc =
  if k == 0 then acc
  else let t2 = t * 1.5 + 0.25
       in let n2 = n * 3037000493 + 7
       in walkPoints t2 n2 (k - 1) ({ x = t2, y = t2 - t, n = n2 } :: acc)

pointsSum : List Point -> Float64 -> Int64 -> String
pointsSum Nil s m = showFloat s ^ " " ^ Int64.show m
pointsSum (p :: ps) s m = pointsSum ps (s + p.x * p.y) (xor m p.n)

points : String
points = pointsSum (walkPoints 1.0 1 40 Nil) 0.0 0

-- (fields a match binds, used unboxed)
pairsSum : List (Pair Int64 Float64) -> Int64 -> Float64 -> String
pairsSum Nil a f = Int64.show a ^ " " ^ showFloat f
pairsSum (MkPair i x :: rest) a f = pairsSum rest (a * 31 + i) (f + x * x)

pairsSummed : String
pairsSummed =
  pairsSum
    (List.map
       (\k -> MkPair (Int64.fromInt k * 1000000007) (toFloat k /. 3.0))
       (List.range 1 30))
    0
    0.0

-- (closures holding them)
makers : Int64
       -> Float64
       -> Int
       -> List (Int64 -> String)
       -> List (Int64 -> String)
makers a f k acc =
  if k == 0 then acc
  else let a2 = a * 6364136223846793005 + 1
       in let f2 = f * 1.25
       in makers
         a2
         f2
         (k - 1)
         ((\b -> Int64.show (a2 + b) ^ "/" ^ showFloat (f2 + 0.5)) :: acc)

closures : String
closures =
  joinWith " " (List.map (\(g : Int64 -> String) -> g 5) (makers 7 0.75 6 Nil))
