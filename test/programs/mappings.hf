-- One definition over any map (std.map's `Mapping`), given each of the
-- three: std.hashmap's, std.hashtable's and std.ordmap's.

module test.programs.mappings

import std.hashmap as HashMap
import std.hashtable as HashTable
import std.map as Map
import std.ordmap as OrdMap

-- (keys bound, some bound again, some removed: how many there are,
-- each one's value summed, and what the removals found; `c` names the
-- kind of map, its empty one)
worked : {c : Type}
       -> {{m : Map.Mapping c @ { Key = Int, Value = Int }}}
       -> c
       -> Int
       -> List Int
worked none n =
  let filled =
    List.foldl (\t i -> m.insert t (i * 7 % 101) i) none (List.range 1 n)
  in let removed =
    List.foldl
      (\acc i -> step acc (m.remove (snd acc) i))
      (MkPair 0 filled)
      (List.range 0 50)
  in [ m.size filled
     , m.size (snd removed)
     , fst removed
     , m.foldl (\s k v -> s + k * v) 0 (snd removed)
     , fromMaybe (-1) (m.lookup (snd removed) 70)
     ]
  where
  step : Pair Int c -> Pair (Maybe Int) c -> Pair Int c
  step (MkPair total t) (MkPair found rest) =
    MkPair (total + fromMaybe 0 found) rest

results : List (List Int)
results =
  [ worked (Map.empty : HashMap.HashMap Int Int) 300
  , worked (Map.empty : HashTable.HashTable Int Int) 300
  , worked (Map.empty : OrdMap.OrdMap Int Int) 300
  ]

-- (the empty ones, as the theory has them)
sizes : List Int
sizes =
  [ Map.size (Map.empty : HashMap.HashMap Int Int)
  , Map.size (Map.empty : HashTable.HashTable Int Int)
  , Map.size (Map.empty : OrdMap.OrdMap Int Int)
  ]
