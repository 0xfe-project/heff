-- Definitions' values of constants, which the C backend lays out as
-- static data (#127): tags, records, floats -- boxed and flat -- strings
-- and `Bytes`, nested; a value held twice; one beside what is computed;
-- and each then taken apart and rebuilt where a value of its own would
-- be built in, its cells left as they were.  Each backend held to the
-- interpreter.

module test.programs.statics

import array as Array
import int64 as Int64
import uint64 as UInt64

data Shape
  = Circle Float64
  | Rect Int Int
  | Tagged String Int64 UInt64 Float64
  | Dot

type Entry = { name : String, code : Int, weight : Float64 }

shapes : List Shape
shapes = [Circle 1.5, Rect 2 3, Tagged "t" 5 7 0.25, Dot, Circle (-2.0)]

entries : List Entry
entries =
  [ { name = "amp", code = 38, weight = 0.5 }
  , { name = "lt", code = 60, weight = 1.25 }
  , { name = "gt", code = 62, weight = 2.0 }
  ]

pairs : List (String, Maybe (List Int))
pairs =
  [ ("none", Nothing)
  , ("one", Just [1])
  , ("some", Just [1, 2, 3])
  , ("\u{e9}", Just [])
  ]

-- (a list in a list, twice the same)
inner : List (List Int)
inner = let xs : List Int = [7, 8, 9] in [xs, xs, [10]]

-- (beyond a word's integers: built at run time, not laid out)
bigs : List Int
bigs = [4611686018427387904, 1, 0 - 4611686018427387905]

bytes : List Bytes
bytes = [b["hi", 255], b[]]

table : Array (String, String)
table = Array.fromList [("a", "x"), ("b", "y"), ("c", "z")]

area : Shape -> Float64
area (Circle r) = 3.0 * r * r
area (Rect w h) = toFloat (w * h)
area (Tagged _ i u f) = toFloat (Int64.toInt i + UInt64.toInt u) + f
area Dot = 0.0

-- (each rebuilt in its cell, were it the last reference)
grow : Shape -> Shape
grow (Circle r) = Circle (r + 1.0)
grow (Rect w h) = Rect h w
grow (Tagged s i u f) = Tagged s (i + i) (u + u) (f * 2.0)
grow Dot = Dot

areas : String
areas = debug (List.foldl (\s sh -> s + area sh) 0.0 shapes)

-- (grown twice, then the shapes as they were)
grown : String
grown =
  debug
    (List.foldl
       (\s sh -> s + area sh)
       0.0
       (List.map grow (List.map grow shapes)))
  ^ " "
  ^ areas

-- (the entries, a field of each changed, then as they were)
renamed : List Entry
renamed =
  List.append
    (List.map
       (\(e : Entry) -> { e | code = e.code + 1 })
       (List.reverse entries))
    entries

codes : Int
codes = List.foldl (\s (e : Entry) -> s + e.code) 0 entries

-- (each pair's list summed, the lists reversed first)
summed : List Int
summed =
  List.map
    (\(p : (String, Maybe (List Int))) -> case snd p of
     Just xs -> List.foldl (\s x -> s + x) 0 (List.reverse xs)
     Nothing -> 0 - 1)
    pairs

-- (the table, set in place, then as it is)
tables : List (String, String)
tables =
  List.append
    (Array.toList (Array.set table 1 ("B", "Y")))
    (Array.toList table)

inners : List Int
inners = List.concat (List.map List.reverse inner)

floats : List Float64
floats = [1.5, -0.0, 2.5]

floatsSum : Float64
floatsSum = List.foldl (\s x -> s + x) 0.0 (List.reverse floats)
