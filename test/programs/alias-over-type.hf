-- A module imported under a built-in type's name: `Rune.toInt` is the
-- module's, an import's alias over the type at `X.y` (a type has no
-- fields), and `Rune`, `Int` anywhere else are the types.  (No
-- definition's value is a rune: a number does not say its type, where a
-- backend shows it.)

import int as Int
import rune as Rune

letter : Unit -> Rune
letter _ = Rune.fromInt 65

code : Int
code = Rune.toInt (letter MkUnit)

next : Rune -> Rune
next r = Rune.fromInt (Rune.toInt r + 1)

letters : Unit -> List Rune
letters _ = [letter MkUnit, next (letter MkUnit), next (next (letter MkUnit))]

codes : List Int
codes = List.map Rune.toInt (letters MkUnit)

upper : Bool
upper = Rune.isUpper (Rune.toUpper (Rune.fromInt 98))

masked : Int
masked = and (Rune.toInt (next (letter MkUnit))) 15

shifted : Int
shifted = shiftL code 2
