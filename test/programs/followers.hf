-- A `do` of a dozen statements, each a choice -- a throw, which goes on
-- no more, or on to what follows -- run by handlers known where they
-- are handled: two of exceptions over one of a state and exceptions.
-- What follows each statement, simplified once, is put where each way
-- out goes on, not simplified again there: when it was, compiling the
-- program took time exponential in its statements, four times as long
-- for each one more (a minute and a half for these).  Run from a state
-- that goes through them all, and from states that throw on the way.

module test.programs.followers

import co
import state
import exception

data Res a = Failed Int | Ok a Int

SE : HFunctor
SE = state Int <+> exception Int

-- | the state and its exceptions, handled at once
both : Handler SE
both =
  { M = \a -> Int -> Res a
  , ret = \x s -> Ok x s
  , bind = \m k s -> case m s of
      Failed e -> Failed e
      Ok x s2 -> k x s2
  , malg = \p s -> case p of
      InL (Get k) -> Ok (k s) s
      InL (Put st x) -> Ok x st
      InR (Throw e) -> Failed e
      InR (Catch c h) -> case c s of
        Failed e -> h e s
        Ok x s2 -> Ok x s2
  }

steps : {e : HFunctor}
      -> {{st : state Int <: e}}
      -> {{ex : exception Int <: e}}
      -> Co e Int
steps = do
  s1 <- get
  if s1 == 501 then throw 1 else pure (MkUnit : Unit)
  put ((s1 * 3 + 1) % 1009)
  s2 <- get
  if s2 == 502 then throw 2 else pure (MkUnit : Unit)
  put ((s2 * 3 + 2) % 1009)
  s3 <- get
  if s3 == 503 then throw 3 else pure (MkUnit : Unit)
  put ((s3 * 3 + 3) % 1009)
  s4 <- get
  if s4 == 504 then throw 4 else pure (MkUnit : Unit)
  put ((s4 * 3 + 4) % 1009)
  s5 <- get
  if s5 == 505 then throw 5 else pure (MkUnit : Unit)
  put ((s5 * 3 + 5) % 1009)
  s6 <- get
  if s6 == 506 then throw 6 else pure (MkUnit : Unit)
  put ((s6 * 3 + 6) % 1009)
  s7 <- get
  if s7 == 507 then throw 7 else pure (MkUnit : Unit)
  put ((s7 * 3 + 7) % 1009)
  s8 <- get
  if s8 == 508 then throw 8 else pure (MkUnit : Unit)
  put ((s8 * 3 + 8) % 1009)
  s9 <- get
  if s9 == 509 then throw 9 else pure (MkUnit : Unit)
  put ((s9 * 3 + 9) % 1009)
  s10 <- get
  if s10 == 510 then throw 10 else pure (MkUnit : Unit)
  put ((s10 * 3 + 10) % 1009)
  s11 <- get
  if s11 == 511 then throw 11 else pure (MkUnit : Unit)
  put ((s11 * 3 + 11) % 1009)
  s12 <- get
  if s12 == 512 then throw 12 else pure (MkUnit : Unit)
  put ((s12 * 3 + 12) % 1009)
  get

-- | the steps from the state `s0`, under two handlers of exceptions
-- | that hear none of them
from : Int -> Res (Either String (Either Bool Int))
from s0 =
  handle
    both
    (attempt
       String
       (attempt
          Bool
          (steps
             (st := \p -> InR (InR (InL p)))
             (ex := \p -> InR (InR (InR p))))))
    s0

-- (through them all)
through : Res (Either String (Either Bool Int))
through = from 0

-- (thrown at the first statement)
first : Res (Either String (Either Bool Int))
first = from 501

-- (thrown at the sixth)
sixth : Res (Either String (Either Bool Int))
sixth = from 101

-- (thrown at the last)
last : Res (Either String (Either Bool Int))
last = from 887
