-- Float literals, each backend held to the interpreter: each the float
-- nearest it (its IEEE bits, as a float's sign is not all shown), at the
-- extremes, ties and long fractions, -0.0 with its sign; at `Float32`
-- too; and a literal in a pattern.

module test.programs.float-literals

import float32 as Float32

doubles : List Float64
doubles =
  [ 5.0e-324
  , 2.4703282292062328e-324
  , 2.4703282292062327e-324
  , 1.0e-400
  , 2.2250738585072014e-308
  , 2.2250738585072011e-308
  , 1.0e-308
  , 1.7976931348623157e308
  , 1.7976931348623158e308
  , 0.1
  , -0.0
  , -5.0e-324
  , 1.0e23
  , 9007199254740993.0
  , 9007199254740995.0
  , 0.30000000000000004
  , 3.141592653589793238462643383279502884197169399375105820974944592307816406286
  , 1_234.567_8e-2
  ]

doubleBits : List Int
doubleBits = List.map (floatBits 64) doubles

-- (a function, as a list of `Float32`s is not shown alike by each
-- backend: its bits are)
singles : Unit -> List Float32
singles u =
  [ 3.4028234663852886e38
  , 3.4028235e38
  , 1.401298464324817e-45
  , 1.0e-45
  , 1.1754943508222875e-38
  , 0.1
  , -0.0
  , 16777217.0
  ]

singleBits : List Int
singleBits = List.map (\x -> floatBits 32 (Float32.toFloat x)) (singles MkUnit)

-- (a literal's pattern: the least subnormal, and -0.0, equal to 0.0)
named : Float64 -> String
named 5.0e-324 = "least"
named -0.0 = "zero"
named _ = "other"

names : List String
names = List.map named [floatOfBits 64 1, 0.0, -0.0, 1.0e-323]

-- (a float's `show` is the literal it was written as, where that is the
-- fewest digits: read back, the very float)
shownAsWritten : Bool
shownAsWritten =
  List.all
    (\p -> strEq (show (fst p)) (snd p))
    [ MkPair 5.0e-324 "5.0e-324"
    , MkPair 2.2250738585072014e-308 "2.2250738585072014e-308"
    , MkPair 1.7976931348623157e308 "1.7976931348623157e308"
    , MkPair 1.0e23 "1.0e23"
    , MkPair 1.0e21 "1.0e21"
    , MkPair 1.5e300 "1.5e300"
    , MkPair 1.0e-7 "1.0e-7"
    , MkPair 0.000001 "0.000001"
    , MkPair 100000000000000000000.0 "100000000000000000000.0"
    , MkPair -0.0 "-0.0"
    , MkPair -2.5e-10 "-2.5e-10"
    ]

shown : List String
shown =
  List.map
    show
    [5.0e-324, 1.7976931348623157e308, 1.0e23, 1.0e-7, -0.0, -2.5e-10]

-- (a `Float32`'s, at its extremes)
shown32 : String
shown32 =
  joinWith
    " "
    [ show (1.0e-45 : Float32)
    , show (3.4028235e38 : Float32)
    , show (1.0e10 : Float32)
    , show (1.1754944e-38 : Float32)
    , show (-0.0 : Float32)
    ]
