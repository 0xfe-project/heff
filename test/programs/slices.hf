-- Slices, compiled as the interpreter computes them: in C a long slice
-- of a string is a view of it, a slice of a view one of its root, a
-- short one a copy.  Each is read by every string primitive, and
-- outlives the string it was cut from; one appended to is not grown in
-- its root's bytes; `Bytes` are sliced so too, and made `Bits`.

module test.programs.slices

import bits as Bits
import bytes as Bytes
import std.hashmap as HashMap
import rune as Rune
import uint8 as UInt8

-- (a string built where the program runs, not a literal: `n` times `s`)
repeated : String -> Int -> String
repeated s n = if n <= 0 then "" else s ^ repeated s (n - 1)

base : String
base = repeated "abcdefghij\u{e9}\u{1F600}" 40

-- (a view, of a view, of a view; and a short copy of the last)
views : List String
views =
  [ strSlice base 15 400
  , strSlice (strSlice base 15 400) 3 300
  , strSlice (strSlice (strSlice base 15 400) 3 300) 7 200
  , strSlice (strSlice (strSlice base 15 400) 3 300) 7 30
  ]

lengths : List Int
lengths = List.map strLength views

-- (each primitive given a view)
read : List String
read =
  List.map
    (\v ->
       joinWith
         ","
         [ debug (strLength v)
         , debug (byteAt v 0)
         , debug (Rune.toInt (runeAt v 0).rune)
         , debug (Rune.count v)
         , debug (indexOf "\u{1F600}a" v 0)
         , debug (compareString v base)
         , debug (v == strSlice base 15 (15 + strLength v))
         , debug (intEq (HashMap.hash v) (HashMap.hash (repeated "x" 0 ^ v)))
         , debug (List.length (runes v))
         , debug (strLength (v ^ v))
         , strSlice (v ^ "!") (strLength v - 4) (strLength v + 1)
         ])
    views

-- (sliced, and only the slices kept: the string they were cut from is
-- let go of, the slices read after)
outlived : List String
outlived =
  List.map
    (\i -> strSlice (repeated "0123456789" 30 ^ debug i) 200 (301 + i / 10))
    (List.range 1 20)

outlivedRead : List Int
outlivedRead =
  List.map (\s -> strLength s + byteAt s (strLength s - 1)) outlived

-- (a tail taken again and again: views, then a copy once short)
tails : String -> Int -> List Int
tails s n =
  if n <= 0 then Nil
  else Cons (byteAt s 0) (tails (strSlice s 1 (strLength s)) (n - 1))

tailBytes : Int
tailBytes = List.foldl (\a b -> a + b) 0 (tails (repeated "xyz" 100) 290)

-- (the whole string, a slice: itself)
whole : Bool
whole = strSlice base 0 (strLength base) == base

-- (keys that are views, in a map, found by copies)
keyed : List (Maybe Int)
keyed =
  List.map
    (\k -> HashMap.lookup table k)
    [repeated "k" 70, repeated "k" 69 ^ "j", strSlice (repeated "k" 200) 0 70]
  where
  table : HashMap.HashMap String Int
  table = HashMap.fromList [MkPair (strSlice (repeated "k" 100) 30 100) 1]

pieces : List Int
pieces = List.map strLength (split ";" (repeated (repeated "w" 80 ^ ";") 5))

-- (a view appended to, its last reference: a new string, its root as
-- it was)
appendedView : List String
appendedView =
  [ strSlice (repeated "ab" 100 ^ "!") 10 150 ^ "xyz"
  , strSlice (strSlice (repeated "ab" 100) 10 150 ^ "xyz") 130 143
  ]

rootAfterAppend : Bool
rootAfterAppend =
  let r = repeated "cd" 100
  in let v = strSlice r 4 190 ^ "!"
  in strSlice r 0 200 == repeated "cd" 100 && strLength v == 187

-- (`Bytes` cut from longer ones, read, appended to, and made `Bits`)
bytesBase : Bytes
bytesBase = Bytes.fromList (List.map UInt8.fromInt (List.range 0 255))

bytesViews : List Int
bytesViews =
  [ Bytes.length (Bytes.slice bytesBase 10 200)
  , UInt8.toInt
    (fromMaybe
       (UInt8.fromInt 0)
       (Bytes.index (Bytes.slice (Bytes.slice bytesBase 10 200) 5 100) 0))
  , Bytes.length (Bytes.append (Bytes.slice bytesBase 0 100) bytesBase)
  , Bits.length (Bits.fromBytes (Bytes.slice bytesBase 50 250))
  , if Bytes.eq
         (Bytes.slice bytesBase 100 200)
         (Bytes.slice (Bytes.slice bytesBase 50 250) 50 150)
  then 1
  else 0
  ]
