-- Elements of an array lent, lent on (#114): a walk down nested arrays of
-- tags, a trie's lookup, calling itself with the element it reads; an
-- element matched where it is read, and given back; and an element of
-- numbers kept flat given the loop, read as it is kept.  Each backend
-- held to the interpreter.

module test.programs.lent-elements

import array as Array

data Tree = Tip Int | Node (Array Tree)

grown : Int -> Int -> Tree
grown d k =
  if d == 0 then Tip k
  else Node (Array.generate 3 (\i -> grown (d - 1) (k * 3 + i)))

tree : Tree
tree = grown 4 0

-- (the loop given the element read, at the parameter it matches on)
look : Int -> Tree -> Int
look k (Tip v) = v
look k (Node cs) = look (k / 3) (arrayIndex cs (k % 3))

looks : List Int
looks = List.map (\k -> look k tree) [0, 1, 5, 40, 80]

-- (the element matched where it is read; given back, or taken apart)
below : Int -> Tree -> Tree
below k (Tip v) = Tip v
below k (Node cs) = case arrayIndex cs (k % 3) of
  Tip v -> Tip (v + 1)
  t -> t

tips : Tree -> Int
tips (Tip _) = 1
tips (Node cs) = Array.foldl (\n t -> n + tips t) 0 cs

belowTips : List Int
belowTips =
  List.map (\k -> tips (below k tree) + tips (below k (grown 1 k))) [0, 2, 7]

-- (the tree still whole after them)
treeTips : Int
treeTips = tips tree

-- (an element of `Float64`s, kept flat, given the loop)
lastOf : Float64 -> Int -> Array Float64 -> Float64
lastOf x i xs =
  if i >= Array.length xs then x else lastOf (arrayIndex xs i) (i + 1) xs

lastFloat : Float64
lastFloat = lastOf 0.0 0 (Array.generate 4 (\i -> toFloat i * 1.5))
