module test.programs.set

data Bool = True | False

theory ORD where
  t : Type
  compare : t -> t -> Bool

theory SET a where
  t : Type
  contains : t -> a -> Bool

TreeType : (M : ORD) -> SET M.t
TreeType M =
  { t = data { Leaf M.t | Node (TreeType M).t M.t (TreeType M).t }
  , contains = \x y -> abandon
  }

Regex : ORD
Regex =
  { t = data { Star | Oneof (TreeType Regex).t }, compare = \x y -> abandon }
