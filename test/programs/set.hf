data Bool = 'true | 'false

theory ORD where
  t :: Type
  compare :: t -> t -> Bool

theory SET a where
  t :: Type
  contains :: t -> a -> Bool

TreeType :: (M :: ORD) -> SET M.t
TreeType M = { t = sum { 'leaf M.t | 'node (TreeType M).t M.t (TreeType M).t }, contains = \x y -> abandon }

Regex :: ORD
Regex = { t = sum { 'star | 'oneof (TreeType Regex).t }, compare = \x y -> abandon }

