-- A match's value bound and taken apart at once, every way out of the
-- match building the tag taken apart, written by hand: no tag of its
-- own, the names it binds set in each arm (heff.compile.ir's `ESet`)
-- where what follows is more than is copied into the arms -- the same
-- values in every backend.

module test.programs.taken-apart

data Three = MkThree Int Int Int

-- (a pair chosen, much after it)
spread : Int -> Int -> Int
spread n acc =
  if n <= 0 then acc
  else let p : Pair Int Int =
         if n % 3 == 0 then MkPair (n * 2) (acc + 1)
         else MkPair (acc % 97) (n + 5)
       in case p of
       MkPair x y ->
         let a1 = (x * 3 + y) % 10007
         in let a2 = (a1 * 5 + x) % 10007
         in let a3 = (a2 * 7 + y) % 10007
         in let a4 = (a3 * 11 + a1) % 10007
         in let a5 = (a4 * 13 + a2) % 10007
         in let a6 = (a5 * 17 + a3) % 10007
         in let a7 = (a6 * 19 + a4) % 10007
         in let a8 = (a7 * 23 + a5) % 10007
         in spread (n - 1) ((acc + a8 + a6) % 100003)

-- (a tag of three fields of the program's own, a `case` of three ways)
threes : Int -> Int -> Int
threes n acc =
  if n <= 0 then acc
  else let t : Three = case n % 3 of
         0 -> MkThree n 1 acc
         1 -> MkThree acc n 2
         _ -> MkThree 3 acc n
       in case t of
       MkThree a b c ->
         let s1 = (a * 7 + b * 3 + c) % 10009
         in let s2 = (s1 * 5 + a) % 10009
         in let s3 = (s2 * 3 + b) % 10009
         in let s4 = (s3 * 7 + c) % 10009
         in let s5 = (s4 * 11 + s1) % 10009
         in let s6 = (s5 * 13 + s2) % 10009
         in let s7 = (s6 * 17 + s3) % 10009
         in threes (n - 1) ((s7 + s4) % 100003)

-- (nested pairs, a field bound to nothing)
nestedPairs : Int -> Int -> Int
nestedPairs n acc =
  if n <= 0 then acc
  else let q : Pair Int (Pair Int Int) =
         if n % 2 == 0 then MkPair n (MkPair (acc + 1) 7)
         else MkPair 0 (MkPair acc (n * 3))
       in case q of
       MkPair _ (MkPair y z) ->
         let b1 = (y * 3 + z) % 10007
         in let b2 = (b1 * 5 + z) % 10007
         in let b3 = (b2 * 7 + y) % 10007
         in let b4 = (b3 * 11 + b1) % 10007
         in let b5 = (b4 * 13 + b2) % 10007
         in let b6 = (b5 * 17 + b3) % 10007
         in let b7 = (b6 * 19 + b4) % 10007
         in nestedPairs (n - 1) ((acc + b7 + b5) % 100003)

-- (a way that abandons, never taken)
abandoning : Int -> Int -> Int
abandoning n acc =
  if n <= 0 then acc
  else let p : Pair Int Int = if n >= 0 then MkPair n acc else abandon
       in case p of
       MkPair x y ->
         let c1 = (x * 3 + y) % 10007
         in let c2 = (c1 * 5 + x) % 10007
         in let c3 = (c2 * 7 + y) % 10007
         in let c4 = (c3 * 11 + c1) % 10007
         in let c5 = (c4 * 13 + c2) % 10007
         in let c6 = (c5 * 17 + c3) % 10007
         in let c7 = (c6 * 19 + c4) % 10007
         in abandoning (n - 1) ((acc + c7 + c5) % 100003)

-- (a way that builds another tag: taken apart as it is)
mixed : List (Maybe Int) -> Int -> Int
mixed ms acc = case ms of
  [] -> acc
  m :: rest ->
    let j : Maybe Int = case m of
      Just v -> Just (v * 2)
      Nothing -> Nothing
    in case j of
    Just w -> mixed rest (acc + w)
    Nothing -> mixed rest (acc + 1)

apart : List Int
apart =
  [ spread 1000 0
  , threes 1000 0
  , nestedPairs 1000 0
  , abandoning 1000 0
  , mixed [Just 3, Nothing, Just 5] 0
  ]
