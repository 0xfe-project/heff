-- A decimal read by the runtime, `floatOfDecimal`, each backend held to
-- the interpreter: its IEEE bits, of 64 and of 32, at the extremes, the
-- ties and just beside them (where a `Float32` rounded from a `Float64`
-- would be wrong), long fractions, the exponents beyond either end; a
-- slice of a longer text; and what is no decimal, NaN.

module test.programs.float-decimals

texts : List String
texts =
  [ "5e-324"
  , "2.4703282292062328e-324"
  , "2.4703282292062327e-324"
  , "2.2250738585072014e-308"
  , "2.2250738585072011e-308"
  , "1.7976931348623157e308"
  , "1.7976931348623159e308"
  , "1e400"
  , "-1e-400"
  , "-0.0"
  , "9007199254740993"
  , "9007199254740993.000000000000000000001"
  , "0.30000000000000004"
  , "3.141592653589793238462643383279502884197169399375105820974944592307816406286"
  , "1.0000000596046448"
  , "1.00000005960464477539"
  , "1.000000059604644775390625"
  , "3.4028235e38"
  , "3.40282356779733661637539395458142568448e38"
  , "3.40282356779733661637539395458142568447e38"
  , "7.0064923216240854e-46"
  , "7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625e-46"
  , "1.17549435e-38"
  , "00012.5000E+0"
  , "1e99999999999999999999"
  , "0e99999999999999999999"
  ]

-- (the bits of the float of `n` bits the text is, whole)
bitsOf : Int -> String -> Int
bitsOf n t = floatBits n (floatOfDecimal n t 0 (strLength t))

read64 : List Int
read64 = List.map (bitsOf 64) texts

read32 : List Int
read32 = List.map (bitsOf 32) texts

slices : List Int
slices =
  [ floatBits 64 (floatOfDecimal 64 "[12.5e1,x]" 1 7)
  , floatBits 32 (floatOfDecimal 32 "x0.1" 1 4)
  ]

-- (none a decimal: each NaN's bits, the quiet one)
others : List Int
others =
  List.map
    (bitsOf 64)
    [ ""
    , "-"
    , "+1"
    , ".5"
    , "1."
    , "1e"
    , "1e+"
    , "Infinity"
    , "NaN"
    , "0x10"
    , "1_000"
    , " 1"
    , "1 "
    , "1e5.5"
    ]

parsed : List (Maybe Float64)
parsed = List.map parseFloat ["0.1", "-0", "1.", "2.5e-3"]
