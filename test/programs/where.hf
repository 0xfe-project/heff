-- `where`, compiled: each local definition a global of its own, given the
-- variables it uses (a loop of it a loop), what is defined after it given
-- those variables, not it.

module test.programs.where

sumTo : Int -> Int
sumTo n = go 0 n
  where
  go : Int -> Int -> Int
  go acc 0 = acc
  go acc i = go (acc + i) (i - 1)

scaled : Int -> List Int -> List Int
scaled k xs = go xs
  where
  times : Int -> Int
  times x = k * x

  go : List Int -> List Int
  go [] = Nil
  go (y :: ys) = times y :: go ys

-- (each equation its own: the variables of its patterns)
firstOr : Int -> List Int -> Int
firstOr d [] = d
firstOr d (x :: xs) = twice
  where
  twice : Int
  twice = x + x

mapAll : {a b : Type} -> (a -> b) -> List a -> List b
mapAll f xs = go xs
  where
  go : List a -> List b
  go [] = Nil
  go (y :: ys) = f y :: go ys

pairUp : {a : Type} -> a -> Pair a a
pairUp x = dup x
  where
  dup : {c : Type} -> c -> Pair c c
  dup y = MkPair y y

nested : Int -> Int
nested n = outer n
  where
  outer : Int -> Int
  outer m = inner m + 1
    where
    inner : Int -> Int
    inner k = k * n

-- (the body a `case`, `where` under it)
classify : Maybe Int -> Int
classify m = case m of
  Just x -> cap x
  Nothing -> 0
  where
  cap : Int -> Int
  cap x = if x > 10 then 10 else x

results : List Int
results =
  [ sumTo 100000
  , firstOr 0 [3, 4]
  , firstOr 7 []
  , nested 4
  , classify (Just 12)
  , classify (Just 3)
  ]

lists : List (List Int)
lists = [scaled 3 [1, 2, 3], mapAll (\x -> x + 1) [1, 2]]

pair : Pair String String
pair = pairUp "a"
