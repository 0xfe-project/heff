-- `Bytes` (lib/bytes.hf), each backend held to the interpreter: made of
-- a list, of a string, of nothing and written, a binary of a string,
-- `b["..."]` (a static object in C); read, sliced, put together,
-- matched by a binary pattern, compared and shown; made text, what is
-- not UTF-8 U+FFFD as `toValid` makes it; and held in a list, a record,
-- a constructor's fields and a closure, taken again, some let go of
-- unread (in C each a buffer of its own, a use after it is freed shown
-- under AddressSanitizer).
-- (Not `bytes.hf`: test/node/bytes.hf's work directory is `bytes-c`.)

import bytes as Bytes
import rune as Rune
import uint8 as UInt8

-- (each made as the program runs, not of a literal; no NUL in them, as a
-- string with one is shown as each backend may -- `made` has one, in
-- bytes)
samples : Unit -> List String
samples _ =
  List.map
    (\s -> "<" ^ s ^ ">")
    [ ""
    , "plain ASCII"
    , "héllo, 中文"
    , "😀 beyond U+FFFF"
    , "\u{FEFF}a byte order mark"
    , "\xC0\xAF overlong"
    , "\xED\xA0\x80 a surrogate's bytes"
    , "cut short \xF0\x9F\x98"
    , "\xFF\x80 bytes of no rune"
    , "\"quotes\", \\, \t\r\n"
    ]

hello : Bytes
hello = Bytes.fromString "héllo"

made : List Bytes
made =
  [ Bytes.empty
  , hello
  , Bytes.fromList [0, 1, 127, 128, 255]
  , Bytes.fromString "\xff\"\\\n"
  ]

shown : List String
shown = List.map show made

lengths : List Int
lengths = List.map Bytes.length made

-- (a byte shown as an `Int`, none as -1: JavaScript has a `UInt8` as a
-- number, which is shown as a float)
bytesOfHello : List Int
bytesOfHello = List.map UInt8.toInt (Bytes.toList hello)

indexed : List Int
indexed =
  List.map (\i -> maybe -1 UInt8.toInt (Bytes.index hello i)) [0, 1, 5, 6, -1]

-- (out of them, by the primitive itself: abandoned)
pastTheEnd : UInt8
pastTheEnd = bytesAt hello 6

sliced : List Bytes
sliced =
  [ Bytes.slice hello 1 3
  , Bytes.slice hello 0 0
  , Bytes.slice hello 4 99
  , Bytes.slice hello -3 6
  , Bytes.slice hello 5 2
  ]

joined : Bytes
joined = Bytes.append (Bytes.fromString "he") (Bytes.fromList [255, 0, 102])

concatenated : Bytes
concatenated = Bytes.concat (List.map Bytes.fromString (samples MkUnit))

-- (40 bytes, what many parts are sliced of)
grownLong : Bytes
grownLong = Bytes.fromList (List.map UInt8.fromInt (List.range 1 40))

-- (none put together; and 3001, of 0 to 40 bytes, a literal among
-- them, made at once, each part's bytes where they were)
concatenatedNone : Bytes
concatenatedNone = Bytes.concat Nil

manyParts : List Bytes
manyParts =
  List.map
    (\n -> if n % 7 == 3 then b["\xff"] else Bytes.slice grownLong 0 n)
    (List.range 0 3000)

concatenatedMany : Int
concatenatedMany = Bytes.length (Bytes.concat manyParts)

concatenatedBack : Bool
concatenatedBack =
  Bytes.toList (Bytes.concat manyParts)
  == List.concatMap Bytes.toList manyParts

-- (an append at its last reference, grown in place in C, a byte at a time)
grown : Bytes
grown =
  List.foldl
    (\b i -> Bytes.append b (Bytes.fromList [UInt8.fromInt i]))
    Bytes.empty
    (List.range 0 299)

grownBack : Bool
grownBack =
  List.map UInt8.toInt (Bytes.toList grown)
  == List.map (\i -> i % 256) (List.range 0 299)

equalities : List Bool
equalities =
  [ hello == Bytes.fromString "héllo"
  , hello == Bytes.fromList [104, 195, 169, 108, 108, 111]
  , hello /= Bytes.slice hello 0 5
  , Bytes.empty == Bytes.fromList []
  , Bytes.eq (Bytes.fromString "a") (Bytes.fromString "b")
  ]

-- (each made text: as `toValid` makes the string, and back where it is
-- UTF-8)
asText : List String
asText = List.map (\s -> toString (Bytes.fromString s)) (samples MkUnit)

asValid : List Bool
asValid =
  List.map
    (\s -> strEq (toString (Bytes.fromString s)) (Rune.toValid s))
    (samples MkUnit)

whereValid : List Bool
whereValid =
  List.map
    (\s ->
       Rune.validString s
       == (Bytes.fromString (toString (Bytes.fromString s))
           == Bytes.fromString s))
    (samples MkUnit)

-- Held, taken again, let go of
--------------------------------------------------------------------------------

data Held = Two Bytes Bytes | One Bytes | NoneHeld

type Kept = { body : Bytes, n : Int, rest : List Bytes }

bodies : Unit -> List Bytes
bodies _ = List.map Bytes.fromString (samples MkUnit)

-- (the first of two, the second let go of unread)
firstOf : Held -> String
firstOf (Two a _) = show a
firstOf (One a) = show a
firstOf NoneHeld = "none"

-- (each in two, the second a copy of the one after it)
pairs : List Bytes -> List Held
pairs (Cons a (Cons b rest)) = Two a b :: pairs (Cons b rest)
pairs (Cons a Nil) = [One a]
pairs Nil = [NoneHeld]

held : List String
held = List.map firstOf (pairs (bodies MkUnit))

heldAsIs : List Held
heldAsIs = pairs (List.take 3 (bodies MkUnit))

keep : Bytes -> Kept
keep b = { body = b, n = List.length (bodies MkUnit), rest = bodies MkUnit }

-- (each kept with the others, all but it let go of unread)
kept : List String
kept =
  List.map
    (\(k : Kept) -> toString k.body ^ show k.n)
    (List.map keep (bodies MkUnit))

keptAsIs : Kept
keptAsIs = keep hello

-- (one held by a closure)
holding : Bytes -> Unit -> Int
holding b _ = Bytes.length b

-- (each held by a closure, called)
closed : List Int
closed =
  List.map (\(f : Unit -> Int) -> f MkUnit) (List.map holding (bodies MkUnit))

-- (each held by a closure, never called)
dropped : Int
dropped = List.length (List.map holding (List.drop 3 (bodies MkUnit)))

-- Written
--------------------------------------------------------------------------------

-- (each escape, a character as it is written its UTF-8 bytes; no NUL
-- nor another control but `\n`, `\t` and `\r`, as made text it is shown
-- as each backend may -- `literalKept` has a NUL)
literals : List Bytes
literals =
  [ b[]
  , b["plain ASCII"]
  , b["h\xc3\xa9llo, h\u{e9}llo, héllo"]
  , b["\u{1F600} \xF0\x9F\x98\x80"]
  , b["\xff\"\\\n\t\r\x80"]
  , b["\xC0\xAF\xED\xA0\x80"]
  ]

literalsShown : List String
literalsShown = List.map show literals

literalsAsText : List String
literalsAsText = List.map toString literals

literalLengths : List Int
literalLengths = List.map Bytes.length literals

-- (each the bytes it is made of otherwise)
literalsEqual : List Bool
literalsEqual =
  [ b["héllo"] == hello
  , b["\x68\x69"] == Bytes.fromList [104, 105]
  , b[] == Bytes.empty
  , b["\u{e9}"] == Bytes.fromString "é"
  , b["a"] == b["b"]
  , Bytes.eq b["\xff"] (Bytes.fromList [255])
  ]

-- (a literal pattern, compared by bytes)
method : Bytes -> String
method b["GET"] = "get"
method b["POST"] = "post"
method b["\xff"] = "byte"
method _ = "other"

methods : List String
methods =
  List.map
    method
    [b["GET"], Bytes.fromString "POST", b["get"], Bytes.fromList [255]]

-- (a literal appended to, sliced, held and let go of: in C a static
-- object, never written to nor freed)
grownFromLiteral : Bytes
grownFromLiteral =
  List.foldl (\b _ -> Bytes.append b b["ab"]) b["x"] (List.range 1 100)

literalSliced : List Bytes
literalSliced = [Bytes.slice b["hello"] 1 3, Bytes.slice b["hello"] -2 99]

literalKept : Kept
literalKept = keep b["kept\x00"]

literalHeld : List String
literalHeld = List.map firstOf (pairs [b["one"], b["two"], b["three"]])

literalClosed : Int
literalClosed = holding b["closed over"] MkUnit
