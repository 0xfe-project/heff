-- A list rebuilt with what is threaded through it (#149): a function
-- giving back a tag one field of which is built round what a call of
-- itself gave there, the others given back as the call gave them, made a
-- loop filling that field.  Each backend held to the interpreter: a
-- step of many kinds, its result taken apart where it is put (a function
-- called once), the list rebuilt in its cells and rebuilt where it is
-- shared, two cells built round the call, the field not the first, and a
-- list too long for a stack of calls not last.

module test.programs.threaded

data Kind
  = Add Int
  | Mul Int
  | Keep Int
  | Fn (Int -> Int)

data Stepped = MkStepped Int Kind Int

data Ran = MkRan (List Kind) Int Int

step : Int -> Kind -> Stepped
step x (Add n) = MkStepped (x + n) (Add (n + 1)) 0
step x (Mul a) = MkStepped ((x * a) % 1009) (Mul a) 1
step x (Keep k) = MkStepped k (Keep x) 0
step x (Fn f) = MkStepped (f x) (Fn f) 1

stepAll : Int -> Int -> List Kind -> Ran
stepAll x n [] = MkRan Nil x n
stepAll x n (k :: ks) = case step x k of
  MkStepped y k2 c -> case (stepAll y (n + c) ks : Ran) of
    MkRan ks2 z n2 -> MkRan (k2 :: ks2) z n2

kinds : List Kind
kinds = [Add 1, Mul 3, Keep 7, Fn (\v -> v * 2 + 1), Add 5, Fn (\v -> v - 3)]

-- (the list given round three times, its cells rebuilt in place)
ticks : Int -> Int -> List Kind -> Pair Int Int
ticks 0 acc ks = MkPair acc (List.length ks)
ticks t acc ks = case stepAll t 0 ks of
  MkRan ks2 z n -> ticks (t - 1) (acc * 31 + z + n) ks2

ticked : String
ticked = case ticks 3 0 kinds of
  MkPair a l -> showInt a ^ "/" ^ showInt l

-- (the list stepped twice: the first time its cells are shared)
twice : String
twice = case stepAll 1 0 kinds of
  MkRan a z n -> case stepAll 2 0 kinds of
    MkRan b w m ->
      showInt z
      ^ ","
      ^ showInt n
      ^ ","
      ^ showInt w
      ^ ","
      ^ showInt m
      ^ ","
      ^ showInt (List.length a + List.length b)

-- (two cells built round the call, the list the second field)
doubled : Int -> List Int -> Pair Int (List Int)
doubled s [] = MkPair s Nil
doubled s (x :: xs) = case (doubled (s + x) xs : Pair Int (List Int)) of
  MkPair t ys -> MkPair t (x :: s :: ys)

doubles : String
doubles = case doubled 0 [1, 2, 3] of
  MkPair t ys -> showInt t ^ ":" ^ joinWith "," (List.map showInt ys)

-- (too long for a stack of calls not last)
long : String
long = case doubled 0 (List.range 1 300000) of
  MkPair t ys -> showInt t ^ ":" ^ showInt (List.length ys)
