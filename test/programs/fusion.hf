-- Lists consumed as they are produced (heff.compile.fuse, #62), compiled
-- as the interpreter computes them: a pipeline of `range`, `map`,
-- `filter` and `foldl` one loop; a list used twice built once, not
-- fused into either use; consumers and producers of the program's own,
-- told by their definitions; a producer ending in something else (the
-- consumer called on it); and what abandons abandoning where it did --
-- a consumer that stops early is not fused, so the producer's work
-- still abandons, and so does work that may fail.

pipeline : Int -> Int
pipeline r =
  let xs = List.range 0 999
  in let ys = List.map (\x -> (x * x + r) % 1009) xs
  in let zs = List.filter (\y -> y % 3 /= 0) ys
  in let ws = List.map (\z -> z * 2 + 1) zs
  in List.foldl (\a b -> a + b) 0 ws + List.length zs

pipelines : List Int
pipelines = [pipeline 0, pipeline 7, pipeline 100]

-- (each stage a loop: test/node/deep.hf's are a million long)
long : Int
long =
  List.foldl
    (\a b -> a + b)
    0
    (List.map
       (\x -> x % 7)
       (List.filter (\x -> x % 2 == 0) (List.range 1 30000)))

-- (used twice: built once, by `map` over `range` fused, and read twice)
shared : Pair Int (List Int)
shared =
  let ys = List.map (\x -> x * 3) (List.range 1 6)
  in MkPair (List.foldl (\a b -> a + b) 0 ys) ys

nested : List Int
nested =
  List.map
    (\x -> x + 1)
    (List.map (\x -> x * 10) (List.filter (\x -> x > 2) (List.range 1 8)))

-- (the program's own: a producer, and a consumer calling itself not
-- last)
countdown : Int -> List Int
countdown n = if n == 0 then Nil else Cons n (countdown (n - 1))

total : List Int -> Int
total Nil = 0
total (Cons x xs) = x * 2 + total xs

owned : Int
owned = total (List.map (\x -> x + 1) (countdown 10))

-- (a producer that ends in another list: the consumer called on that)
appended : Int
appended = List.length (List.append (List.range 1 5) (List.range 10 12))

doubledAppended : List Int
doubledAppended = List.map (\x -> x * 2) (List.append (countdown 3) [7, 8])

-- (a function as the argument, not a lambda written there)
twice : Int -> Int
twice x = x + x

named : List Int
named = List.map twice (List.range 1 4)

-- (the producer's work abandons: it does, fused)
abandonsInProducer : Int
abandonsInProducer =
  List.foldl
    (\a b -> a + b)
    0
    (List.map (\x -> if x == 5 then abandon else x) (List.range 1 10))

-- (a consumer that stops early is not fused: the whole list is
-- produced first, as before, and its fifth abandons)
stopsEarly : List Int
stopsEarly =
  List.take 2 (List.map (\x -> if x == 5 then abandon else x) (List.range 1 10))

anyEarly : Bool
anyEarly =
  List.any
    (\x -> x > 1)
    (List.map (\x -> if x == 5 then abandon else x) (List.range 1 10))

-- (the consumer's work may abandon: not fused, and the producer's
-- abandons first, as it did)
consumerAbandons : Int
consumerAbandons =
  List.foldl
    (\a b -> if b == 2 then abandon else a + b)
    0
    (List.map (\x -> if x == 7 then abandon else x) (List.range 1 10))

-- (what is computed between the list and its use may abandon: not
-- moved past it)
between : Int -> Int
between d =
  let ys = List.map (\x -> x + 1) (List.range 1 10)
  in let q = 100 / d
  in let r : Int = if d == 3 then abandon else q
  in List.foldl (\a b -> a + b) r ys

betweens : List Int
betweens = [between 1, between 4]

betweenAbandons : Int
betweenAbandons = between 3
