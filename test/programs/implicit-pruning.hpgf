def Nat : Type := sum
  'zero
  'succ Nat
end

def id {T : Type} (x : T) : T := x

# checking `id` against `?A -> ?A` inside `y => ...` meets `?A[n]` (outside the
# binder) with `?T[n, y]` (inside it): `y` is pruned from `?T`
def outer {A : Type} (f : Nat -> A -> A) (a : A) : A := f 'zero a

def probe (n : Nat) : Nat := outer (y => id) n

def run : Nat := probe ('succ 'zero)
