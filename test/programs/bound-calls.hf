-- A call of itself bound before what is built round it (#149): what
-- the tag is built of computed first, `let h = (o * b) % 1000`, then the
-- call bound, then the tag -- made a loop all the same, a list cell
-- filled at a time, and a list rebuilt with what is threaded through it.
-- What is computed after the call stays after it.  Each backend held to
-- the interpreter, on lists too long for a stack of calls not last.

module test.programs.bound-calls

data Ran = MkRan (List Int) Int

scaled : Int -> Int -> List Int -> List Int
scaled o b Nil = Nil
scaled o b (x :: rest) =
  let h = (o * b) % 1000
  in let r : List Int = scaled (o + x) b rest
  in h :: r

threaded : Int -> Int -> List Int -> Ran
threaded o b Nil = MkRan Nil o
threaded o b (x :: rest) =
  let h = (o * b) % 1000
  in let r = (threaded (o + x) b rest : Ran)
  in case r of
  MkRan outs st -> MkRan (h :: outs) st

-- (the field computed after the call: the order kept)
after : Int -> Int -> List Int -> Ran
after o b Nil = MkRan Nil o
after o b (x :: rest) = case (after (o + x) b rest : Ran) of
  MkRan outs st -> MkRan ((o * b) % 1000 :: outs) st

sumOf : List Int -> Int
sumOf xs = List.foldl (\a v -> (a + v) % 1000003) 0 xs

ranOf : Ran -> String
ranOf (MkRan xs s) =
  showInt (sumOf xs) ^ "/" ^ showInt (List.length xs) ^ "/" ^ showInt s

short : String
short =
  joinWith "," (List.map showInt (scaled 1 3 [1, 2, 3, 4]))
  ^ ";"
  ^ ranOf (threaded 1 3 [1, 2, 3, 4])
  ^ ";"
  ^ ranOf (after 1 3 [1, 2, 3, 4])

-- (too long for a stack of calls not last)
long : String
long = case scaled 1 3 (List.range 1 300000) of
  xs -> showInt (sumOf xs) ^ "/" ^ showInt (List.length xs)

longThreaded : String
longThreaded = ranOf (threaded 1 3 (List.range 1 300000))
