-- Tags carried round a loop: a loop that takes its parameter apart first
-- and is given that tag built at each call of itself is given a worker
-- carrying the tag's fields instead, called so from where the tag is
-- built too.  Each backend held to the interpreter: an array's cursor, a
-- local loop with more parameters, the parameter passed on as it is, the
-- tag given back whole, a `Float64` field, calls of itself not last, the
-- wrapper called as a closure, and loops that are left as they are (two
-- tags given, the tag used whole on the way, not taken apart first).

module test.programs.unbox

import array

-- (an array's cursor, the index a field)
firstNegative : Pair (Array Int) Int -> Maybe Int
firstNegative (MkPair arr i) =
  if i >= arrayLength arr then Nothing
  else if arrayIndex arr i < 0 then Just (arrayIndex arr i)
  else firstNegative (MkPair arr (i + 1))

numbers : Array Int
numbers = arrayFromList [3, 1, 4, 1, 5, 0 - 9, 2, 6]

firstShow : String
firstShow = case firstNegative (MkPair numbers 0) of
  Just x -> showInt x
  Nothing -> "none"

-- (a local loop, with a number beside the cursor)
total : Array Int -> Int
total a = loop (MkPair a 0) 0
  where
  loop : Pair (Array Int) Int -> Int -> Int
  loop (MkPair arr i) acc =
    if i >= arrayLength arr then acc
    else loop (MkPair arr (i + 1)) (acc + arrayIndex arr i)

totalShow : String
totalShow = showInt (total numbers)

-- (passed on as it is where nothing changes, given back whole)
data Window = MkWindow Int Int

widen : Int -> Window -> Window
widen k (MkWindow lo hi) =
  if k == 0 then MkWindow lo hi
  else if k % 3 == 0 then widen (k - 1) (MkWindow lo hi)
  else widen (k - 1) (MkWindow (lo - 1) (hi + 2))

windowShow : Window -> String
windowShow (MkWindow lo hi) = showInt lo ^ ".." ^ showInt hi

widened : String
widened = windowShow (widen 10 (MkWindow 0 0))

-- (a `Float64` and an `Int`)
data Walker = MkWalker Float64 Int

walk : Int -> Walker -> Float64
walk k (MkWalker x n) =
  if k == 0 then x + toFloat n
  else walk (k - 1) (MkWalker (x * 0.5 + 1.0) (n + k))

walked : String
walked = show (walk 12 (MkWalker 3.0 0))

-- (calls of itself not last, the tag never used whole)
depth : Int -> Pair Int Int -> Int
depth k (MkPair a b) =
  if k == 0 then a * 10 + b else 1 + depth (k - 1) (MkPair b (a + 1))

deep : String
deep = showInt (depth 7 (MkPair 2 3))

-- (the wrapper, called by a closure)
closures : String
closures =
  joinWith
    " "
    (List.map (\w -> windowShow (widen 4 w)) [MkWindow 0 1, MkWindow 5 5])

-- (left as it is: two tags given)
data Phase = Up Int | Down Int

bounce : Int -> Phase -> Int
bounce k p = case p of
  Up n -> if k == 0 then n else bounce (k - 1) (Down (n + 3))
  Down n -> if k == 0 then 0 - n else bounce (k - 1) (Up (n * 2))

bounced : String
bounced = showInt (bounce 5 (Up 1)) ^ " " ^ showInt (bounce 6 (Down 1))

-- (left as it is: the tag used whole on the way round)
trail : Int -> Pair Int Int -> List (Pair Int Int) -> List (Pair Int Int)
trail k p@(MkPair a b) acc =
  if k == 0 then acc else trail (k - 1) (MkPair (a + b) a) (p :: acc)

trailShow : String
trailShow =
  joinWith
    " "
    (List.map
       (\(p : Pair Int Int) -> case p of
        MkPair a b -> showInt a ^ "," ^ showInt b)
       (trail 5 (MkPair 1 0) Nil))

-- (left as it is: not taken apart before the loop may end, and given
-- another tag there)
countdown : Int -> Maybe Int -> Int
countdown k m =
  if k == 0 then 0
  else case m of
    Just x -> countdown (k - 1) (Just (x + k))
    Nothing -> 0 - 1

counted : String
counted =
  showInt (countdown 0 Nothing) ^ " " ^ showInt (countdown 4 (Just 1))
