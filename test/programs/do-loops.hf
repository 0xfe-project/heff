-- A `do` block's loops (#86), compiled: `run do`'s `while` and `for`
-- (over a list, a range, an array), `break`, `continue`, an early
-- `return`, loops in loops and an `if` of statements setting the
-- variables, each a local tail-recursive function of them -- the same
-- values in every backend.

module test.programs.do-loops

import array

oddSum : Int -> Int
oddSum n = run do
  let mut i = 0
  let mut total = 0
  while i < n do
    i := i + 1
    if i % 2 == 0 then continue
    total := total + i
  return total

sumEvens : List Int -> Int
sumEvens xs = run do
  let mut total = 0
  for x in xs do
    if x % 2 /= 0 && x > 0 then continue
    if x > 1000 then break
    if x < 0 then return x
    total := total + x
  return total

firstNegative : Array Int -> Maybe Int
firstNegative a = run do
  for x in a do
    if x < 0 then return (Just x)
  return Nothing

-- (over an array of big integers: each element lent where the array is,
-- counted where it is kept)
bigs : Array Int
bigs =
  arrayFromList
    [1180591620717411303424, 0 - 1180591620717411303424, 5, 7]

sumArray : Array Int -> Int
sumArray a = run do
  let mut total = 0
  for x in a do
    total := total + x
  return total

kept : Array Int -> List Int
kept a = run do
  let mut acc = Nil
  for x in a do
    if x > 5 then acc := Cons x acc
  return acc

keptBigs : List Int
keptBigs = kept bigs

pairs : Int -> Int
pairs n = run do
  let mut count = 0
  for i in range 1 n do
    if i == 3 then continue
    for j in range 1 n do
      if j > i then break
      case j % 3 of
        0 -> count := count + 10
        _ -> count := count + 1
  return count

collatz : Int -> Int
collatz n0 = run do
  let mut n = n0
  let mut steps = 0
  while n /= 1 do
    if n % 2 == 0 then n := n / 2 else n := 3 * n + 1
    steps := steps + 1
  return steps

loops : List Int
loops =
  [ oddSum 100000
  , sumEvens [1, 2, 3, 4, 2000, 6]
  , sumEvens [2, -1, 4]
  , fromMaybe 0 (firstNegative bigs)
  , sumArray bigs
  , pairs 30
  , collatz 27
  , fromMaybe
    0
    (firstNegative
       (arrayGenerate 1000 (\i -> if i == 999 then 0 - 7 else i)))
  ]
