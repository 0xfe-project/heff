-- The prelude's lists and text, compiled as the interpreter computes them.

module test.programs.library

sorted : List Int
sorted = List.sortBy (\a b -> a <= b) [5, 3, 9, 1, 3]

pairs : List (Pair Int String)
pairs = List.zip (List.range 1 3) (words "one two three four")

total : Int
total = List.sum (List.map (\p -> fst p) pairs)

parsed : List (Maybe Int)
parsed = List.map parseInt (split "," "12,-7,x,")

text : String
text = unlines (List.map trim (lines "  a  \n b\n"))

found : Maybe Int
found = indexOf "needle" "haystack with a needle in it" 0

folded : List Int
folded = List.foldr (\x acc -> Cons (x * 2) acc) Nil (List.range 1 5)

deep : Int
deep = List.length (List.foldr (\x acc -> Cons x acc) Nil (List.range 1 100000))
