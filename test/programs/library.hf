-- The prelude's lists and text, compiled as the interpreter computes them.

import prelude

sorted :: List Int
sorted = sortBy (\a b -> a <= b) [5, 3, 9, 1, 3]

pairs :: List (Pair Int String)
pairs = zip (range 1 3) (words "one two three four")

total :: Int
total = sum (map (\p -> fst p) pairs)

parsed :: List (Maybe Int)
parsed = map parseInt (split "," "12,-7,x,")

text :: String
text = unlines (map trim (lines "  a  \n b\n"))

found :: Maybe Int
found = indexOf "needle" "haystack with a needle in it"

folded :: List Int
folded = foldr (\x acc -> Cons (x * 2) acc) Nil (range 1 5)

deep :: Int
deep = length (foldr (\x acc -> Cons x acc) Nil (range 1 100000))
