data Bool = 'true | 'false

data Nat = 'zero | 'succ Nat

data List (A :: Type) = 'nil | 'cons A (List A)

not :: Bool -> Bool
not 'true = 'false
not 'false = 'true

plus :: Nat -> Nat -> Nat
plus 'zero n = n
plus ('succ m) n = 'succ (plus m n)

and :: Bool -> Bool -> Bool
and 'true x2 = x2
and 'false x2 = 'false

eq :: Nat -> Nat -> Bool
eq 'zero 'zero = 'true
eq 'zero ('succ _) = 'false
eq ('succ m) 'zero = 'false
eq ('succ m) ('succ n) = eq m n

map :: (A :: Type) -> (B :: Type) -> (f :: A -> B) -> List A -> List B
map A B f 'nil = 'nil
map A B f ('cons y ys) = 'cons (f y) (map A B f ys)

pred :: Nat -> Nat
pred 'zero = 'zero
pred ('succ 'zero) = 'zero
pred ('succ ('succ n)) = 'succ n

two :: Nat
two = 'succ ('succ 'zero)

four :: Nat
four = plus two two

t1 :: Bool
t1 = eq four (plus 'zero four)

t2 :: Bool
t2 = eq four two

t3 :: Bool
t3 = and (not 'false) t1

ones :: List Nat
ones = map Nat Nat (\n -> plus n ('succ 'zero)) ('cons 'zero ('cons two 'nil))

p3 :: Nat
p3 = pred ('succ ('succ ('succ 'zero)))

