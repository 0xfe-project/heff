-- Equations of several parameters whose variables share names across
-- columns: a variable named in one column where another equation has a
-- constructor, and the same name in another column of another equation.
-- Each argument is still taken apart where it is matched.

data T = U | W Int Int

data N = Z | S N

-- (the second field of a `W`)
snd' : T -> Int
snd' U = 0
snd' (W _ b) = b

toInt : N -> Int
toInt Z = 0
toInt (S n) = 1 + toInt n

fst' : T -> Int
fst' U = 0
fst' (W a _) = a

snd'' : Int -> Int
snd'' n = n

-- | >>> two (W 1 2) (W 3 4)
-- | 1234
-- | >>> two U (W 3 4)
-- | -1
-- | >>> two (W 1 2) U
-- | -2
two : T -> T -> Int
two U r = -1
two r U = -2
two (W a b) (W c d) = a * 1000 + b * 100 + c * 10 + d

-- (three columns, the name in each of them)
-- | >>> three (W 1 2) (W 3 4) (W 5 6)
-- | 123456
-- | >>> three U (W 3 4) (W 5 6)
-- | -1
-- | >>> three (W 1 2) U (W 5 6)
-- | -2
-- | >>> three (W 1 2) (W 3 4) U
-- | -3
three : T -> T -> T -> Int
three U r s = -1
three r U s = -2
three s r U = -3
three (W a b) (W c d) (W e f) =
  a * 100000 + b * 10000 + c * 1000 + d * 100 + e * 10 + f

-- (the same name in all three columns)
-- | >>> threeSame (W 1 2) (W 3 4) (W 5 6)
-- | 123456
-- | >>> threeSame (W 1 2) U U
-- | 12
-- | >>> threeSame U (W 3 4) U
-- | 34
-- | >>> threeSame U U (W 5 6)
-- | 56
-- | >>> threeSame U (W 3 4) (W 5 6)
-- | 3456
-- | >>> threeSame (W 1 2) U (W 5 6)
-- | 1256
-- | >>> threeSame (W 1 2) (W 3 4) U
-- | 1234
threeSame : T -> T -> T -> Int
threeSame U U r = fst' r * 10 + snd' r
threeSame U r U = fst' r * 10 + snd' r
threeSame r U U = fst' r * 10 + snd' r
threeSame (W a b) (W c d) (W e f) =
  a * 100000 + b * 10000 + c * 1000 + d * 100 + e * 10 + f
threeSame U (W c d) (W e f) = c * 1000 + d * 100 + e * 10 + f
threeSame (W a b) U (W e f) = a * 1000 + b * 100 + e * 10 + f
threeSame (W a b) (W c d) U = a * 1000 + b * 100 + c * 10 + d

-- (a variable in the middle column)
-- | >>> middle (W 1 2) 7 (W 3 4)
-- | 12734
-- | >>> middle U 7 (W 3 4)
-- | 7
-- | >>> middle (W 1 2) 7 U
-- | 9
middle : T -> Int -> T -> Int
middle U m r = m
middle r m U = m + 2
middle (W a b) m (W c d) = a * 10000 + b * 1000 + m * 100 + c * 10 + d

-- (a name a column is in one equation, a field in another)
-- | >>> fieldNamed (W 1 2) (W 3 4)
-- | 1234
-- | >>> fieldNamed U (W 3 4)
-- | 3
fieldNamed : T -> T -> Int
fieldNamed U (W a b) = a
fieldNamed U U = 0
fieldNamed (W b a) r = b * 1000 + a * 100 + fieldNamed U r * 10 + snd' r

-- (a field named as another equation's column is)
-- | >>> fieldThenColumn (W 1 2) 5
-- | 15
-- | >>> fieldThenColumn (W 1 2) 0
-- | 1
-- | >>> fieldThenColumn U 5
-- | 5
fieldThenColumn : T -> Int -> Int
fieldThenColumn (W a b) 0 = a
fieldThenColumn (W p q) a = p * 10 + a
fieldThenColumn U a = a

-- (nested constructors)
-- | >>> nested (S (S Z)) (S Z)
-- | 21
-- | >>> nested Z (S (S Z))
-- | -1
-- | >>> nested (S Z) Z
-- | -2
nested : N -> N -> Int
nested Z r = -1
nested r Z = -2
nested (S (S a)) (S b) = 20 + toInt a + toInt b + 1
nested (S a) (S (S b)) = 10 + toInt a + toInt b
nested (S a) (S b) = toInt a * 10 + toInt b

-- | >>> deep (W 1 2) (S (S Z)) (W 3 4)
-- | 1234
-- | >>> deep U (S Z) (W 3 4)
-- | 1
-- | >>> deep (W 1 2) Z U
-- | -2
-- | >>> deep (W 1 2) (S Z) U
-- | -3
-- | >>> deep (W 1 2) (S Z) (W 3 4)
-- | 1239
-- | >>> deep (W 1 2) (S (S (S Z))) (W 3 4)
-- | 1235
deep : T -> N -> T -> Int
deep U r s = toInt r
deep r Z s = -2
deep s r U = -3
deep (W a b) (S (S r)) (W c d) = a * 1000 + b * 100 + c * 10 + d + toInt r
deep (W a b) (S Z) (W c d) = a * 1000 + b * 100 + c * 10 + d + 5

-- (literal patterns)
-- | >>> lits 0 2
-- | 102
-- | >>> lits 5 0
-- | 50
-- | >>> lits 1 2
-- | 12
lits : Int -> Int -> Int
lits 0 r = r + 100
lits r 0 = r * 10
lits a b = a * 10 + b

-- | >>> litTag 0 (W 3 4)
-- | 3
-- | >>> litTag 7 U
-- | 7
-- | >>> litTag 7 (W 3 4)
-- | 734
litTag : Int -> T -> Int
litTag 0 r = fst' r
litTag r U = r
litTag r (W b c) = r * 100 + b * 10 + c

-- (binaries)
-- | >>> binTag b[1, 2] (W 3 4)
-- | 1234
-- | >>> binTag b[] (W 3 4)
-- | 3
-- | >>> binTag b[1, 2] U
-- | -2
-- | >>> binTag b[1] (W 3 4)
-- | -3
binTag : Bytes -> T -> Int
binTag b[] r = fst' r
binTag r U = -2
binTag b[a, e] (W c d) = a * 1000 + e * 100 + c * 10 + d
binTag r (W c d) = -3

-- (records)
type P = { x : Int, y : Int }

-- | >>> recs { x = 1, y = 2 } { x = 3, y = 4 }
-- | 1234
-- | >>> recs { x = 0, y = 2 } { x = 3, y = 4 }
-- | 34
-- | >>> recs { x = 1, y = 2 } { x = 0, y = 4 }
-- | 12
recs : P -> P -> Int
recs { x = 0 } r = r.x * 10 + r.y
recs r { x = 0 } = r.x * 10 + r.y
recs { x = a, y = b } { x = c, y = d } = a * 1000 + b * 100 + c * 10 + d

-- | >>> recThenColumn { x = 1, y = 2 } 5
-- | 15
-- | >>> recThenColumn { x = 1, y = 2 } 0
-- | 1
recThenColumn : P -> Int -> Int
recThenColumn { x = a } 0 = a
recThenColumn { x = p } a = p * 10 + a

-- | >>> recTag { x = 1, y = 2 } (W 3 4)
-- | 1234
-- | >>> recTag { x = 1, y = 2 } U
-- | 12
recTag : P -> T -> Int
recTag r U = r.x * 10 + r.y
recTag { x = a, y = b } (W c d) = a * 1000 + b * 100 + c * 10 + d

-- (a name used free in one equation, a column in another)
-- | >>> freeName (W 1 2)
-- | 7
-- | >>> freeName U
-- | 0
freeName : T -> Int
freeName (W a b) = snd'' 7
freeName snd'' = 0
-- the values, each backend's
t2 : Int
t2 = two (W 1 2) (W 3 4)

t3 : Int
t3 = three (W 1 2) (W 3 4) (W 5 6)

tSame : Int
tSame = threeSame (W 1 2) (W 3 4) (W 5 6) + threeSame U (W 3 4) U

tMiddle : Int
tMiddle = middle (W 1 2) 7 (W 3 4)

tField : Int
tField = fieldNamed (W 1 2) (W 3 4)

tFieldThen : Int
tFieldThen = fieldThenColumn (W 1 2) 5

tNested : Int
tNested = nested (S (S Z)) (S Z) * 100 + nested (S Z) (S (S Z))

tDeep : Int
tDeep = deep (W 1 2) (S (S Z)) (W 3 4)

tLits : Int
tLits = lits 0 2 * 1000 + lits 5 0

tLitTag : Int
tLitTag = litTag 7 (W 3 4) * 10 + litTag 0 (W 3 4)

tBins : Int
tBins = binTag b[1, 2] (W 3 4) * 10 + binTag b[] (W 3 4)

tRecs : Int
tRecs = recs { x = 1, y = 2 } { x = 3, y = 4 }

tRecThen : Int
tRecThen = recThenColumn { x = 1, y = 2 } 5

tRecTag : Int
tRecTag = recTag { x = 1, y = 2 } (W 3 4)

tFree : Int
tFree = freeName (W 1 2)
