-- Reads where the index was tested in range, not checked again by the
-- C backend: `Array.index` of each side of the range, of arrays of
-- `Int`s, of `Int64`s kept flat and kept as `V`s, of `Float64`s; a test
-- the other way round, leaving where it fails; a length bound first; a
-- set so tested; and a loop reading two arrays that change places each
-- round, as a table's rows do.  Each backend held to the interpreter.

module test.programs.tested-reads

import array as Array
import int64 as Int64

at : Array Int64 -> Int -> Int64
at a i = fromMaybe (Int64.fromInt -1) (Array.index a i)

atInt : Array Int -> Int -> Int
atInt a i = fromMaybe -1 (Array.index a i)

atFloat : Array Float64 -> Int -> Float64
atFloat a i = fromMaybe -1.0 (Array.index a i)

-- (each index from -1 to past the end, read; out of range, -1)
sumAt : Array Int64 -> Int -> Int64 -> Int64
sumAt a i acc =
  if i > Array.length a then acc
  else sumAt a (i + 1) (acc * Int64.fromInt 7 + at a i)

sumAtInt : Array Int -> Int -> Int -> Int
sumAtInt a i acc =
  if i > Array.length a then acc else sumAtInt a (i + 1) (acc * 7 + atInt a i)

sumAtFloat : Array Float64 -> Int -> Float64 -> Float64
sumAtFloat a i acc =
  if i > Array.length a then acc
  else sumAtFloat a (i + 1) (acc * 7.0 + atFloat a i)

flatBigs : Array Int64
flatBigs = Array.generate 3 (\i -> Int64.fromInt (i * 1000000007))

flatRead : Int64
flatRead =
  sumAt
    (Array.generate 3 (\i -> Int64.fromInt (i * 1000000007)))
    -1
    (Int64.fromInt 0)

boxedRead : Int64
boxedRead =
  sumAt
    (Array.fromList [Int64.fromInt 5, Int64.fromInt 6, Int64.fromInt 7])
    -1
    (Int64.fromInt 0)

intRead : Int
intRead = sumAtInt (Array.fromList [10, 20]) -2 0

floatRead : Float64
floatRead = sumAtFloat (Array.replicate 2 0.5) -1 0.0

-- (the test the other way round, the branch out of range leaving)
guarded : Array Int64 -> Int -> Int64
guarded a i =
  if i < 0 || Array.length a <= i then Int64.fromInt 0 else arrayIndex a i

guardedRead : Int64
guardedRead = guarded flatBigs -1 + guarded flatBigs 1 + guarded flatBigs 3

-- (the length bound to a variable first)
boundLength : Array Int -> Int -> Int
boundLength a i =
  let n = Array.length a
  in if 0 <= i && i < n then arrayIndex a i else 0

boundRead : Int
boundRead =
  boundLength (Array.fromList [3, 4]) -1 * 1000
  + boundLength (Array.fromList [3, 4]) 0 * 100
  + boundLength (Array.fromList [3, 4]) 1 * 10
  + boundLength (Array.fromList [3, 4]) 2

-- (a set where it is tested, in a loop holding its array alone)
setTested : Int -> Array Int64 -> Array Int64
setTested i a =
  if i > 4 then a
  else setTested
      (i + 1)
      (if 0 <= i && i < Array.length a
       then Array.set a i (Int64.fromInt i * Int64.fromInt 3)
       else a)

setRead : Array Int64
setRead = setTested -1 (Array.replicate 3 (Int64.fromInt 1))

-- (two rows, each round's read from the one before, the rows swapped:
-- the first kept flat, the second as `V`s)
rowFrom : Int -> Int -> Array Int64 -> Array Int64 -> Array Int64
rowFrom j m prev cur =
  if j > m then cur
  else rowFrom
      (j + 1)
      m
      prev
      (Array.set cur j (at prev (j - 1) + at prev j + at cur (j - 1)))

rows : Int -> Int -> Array Int64 -> Array Int64 -> Array Int64
rows k m prev cur =
  if k == 0 then prev else rows (k - 1) m (rowFrom 1 m prev cur) prev

table : List Int64
table =
  Array.toList
    (rows
       3
       4
       (Array.generate 5 (\j -> Int64.fromInt j))
       (Array.fromList
          [ Int64.fromInt 1
          , Int64.fromInt 1
          , Int64.fromInt 1
          , Int64.fromInt 1
          , Int64.fromInt 1
          ]))
