-- Parallel composition, compiled as the interpreter computes it.

import co
import parallel

data LogF (m : Type -> Type) x = Say String x | P ((parallel Int String).f m x)

logging : HFunctor
logging =
  { f = LogF
  , hfmap = \m g p -> case p of
      Say s x -> Say s (g x)
      P q -> P ((parallel Int String).hfmap m g q)
  , hmap = \m n nt p -> case p of
      Say s x -> Say s x
      P q -> P ((parallel Int String).hmap m n nt q)
  }

say : String -> Co logging Unit
say s = op (Say s (MkUnit : Unit)) val

both : Co logging String
both = do
  say "start"
  answers <-
    parallelIn
      (inj := \p -> P p)
      (do
       say "a1"
       say "a2"
       pure 7) (do
    say "b1"
    say "b2"
    pure "seven")
  say "end"
  pure (show (fst answers) ^ " " ^ snd answers)

-- the one after the other --------------------------------------------------

sequential : Handler logging
sequential =
  { M = \a -> Pair a (List String)
  , ret = \x -> MkPair x []
  , bind = \m k -> case m of
      MkPair x out ->
        (case k x of
         MkPair y out' -> MkPair y (List.append out out'))
  , malg = \p -> case p of
      Say s x -> MkPair x [s]
      P q ->
        (case q of
         Parallel l r k ->
           (case l of
            MkPair a outL ->
              (case r of
               MkPair b outR -> MkPair (k a b) (List.append outL outR))))
  }

-- taking turns -------------------------------------------------------------

-- | A thread: done, or it said something and goes on.
data Thread a = Done a | Said String (Thread a)

thenDo : {a b : Type} -> Thread a -> (a -> Thread b) -> Thread b
thenDo (Done x) k = k x
thenDo (Said s t) k = Said s (thenDo t k)

-- | Two threads, each saying one thing in turn, and both their answers.
interleave : {a b : Type} -> Thread a -> Thread b -> Thread (Pair a b)
interleave (Said s t1) (Said s' t2) = Said s (Said s' (interleave t1 t2))
interleave (Done x) t2 = thenDo t2 (\y -> Done (MkPair x y))
interleave t1 (Done y) = thenDo t1 (\x -> Done (MkPair x y))

answer : {a : Type} -> Thread a -> a
answer (Done x) = x
answer (Said _ t) = answer t

lines : {a : Type} -> Thread a -> List String
lines (Done _) = []
lines (Said s t) = Cons s (lines t)

-- | What a thread comes to, and what it said.
said : {a : Type} -> Thread a -> Pair a (List String)
said t = MkPair (answer t) (lines t)

interleaving : Handler logging
interleaving =
  { M = Thread
  , ret = \x -> Done x
  , bind = \m k -> thenDo m k
  , malg = \p -> case p of
      Say s x -> Said s (Done x)
      P q ->
        (case q of
         Parallel l r k ->
           thenDo (interleave l r) (\ab -> case ab of
           MkPair a b -> Done (k a b)))
  }

oneAfterTheOther : Pair String (List String)
oneAfterTheOther = handle sequential both

takingTurns : Pair String (List String)
takingTurns = said (handle interleaving both)
