-- Equality by instances found by finding others: each backend passes
-- what a search found -- eqList of eqInt, eqMaybe of eqList of eqString,
-- eqPair of two, a program's own instance under the prelude's -- as the
-- interpreter does.

data Shape = Circle Int | Square Int

instance eqShape : Eq Shape
eqShape = { equal = sameShape }
  where
    sameShape : Shape -> Shape -> Bool
    sameShape (Circle a) (Circle b) = a == b
    sameShape (Square a) (Square b) = a == b
    sameShape _ _ = False

-- (each of `xs` against each)
everyPair : {a : Type} -> {{eq : Eq a}} -> List a -> List Bool
everyPair xs = List.concatMap (\x -> List.map (\y -> equal x y) xs) xs

lists : List Bool
lists = everyPair ([[], [1], [1, 2], [2, 1]] : List (List Int))

maybes : List Bool
maybes =
  everyPair
    ([Nothing, Just [], Just ["a"], Just ["b"]] : List (Maybe (List String)))

pairs : List Bool
pairs =
  everyPair ([MkPair 1 'a', MkPair 1 'b', MkPair 2 'a'] : List (Pair Int Rune))

eithers : List Bool
eithers = everyPair ([Left 1, Left 2, Right True] : List (Either Int Bool))

shapes : List Bool
shapes =
  everyPair ([[Circle 1], [Square 1], [Circle 1, Circle 2]] : List (List Shape))

orders : List Bool
orders = everyPair [compareInt 1 2, compareInt 2 2, compareInt 3 2]
