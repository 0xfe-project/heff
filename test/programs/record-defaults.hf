-- A record type's defaults, `x : A = d`: a record that leaves the field
-- out is given `d`, wherever the record is made -- a definition's body,
-- an argument, a function's result -- and is the same record as one
-- that writes it.

module test.programs.record-defaults

suffix : String
suffix = ".hf"

type Source =
  { path : String
  , ext : String = suffix
  , lines : List String = []
  , indent : Int -> String = \n -> joinWith "" (List.replicate n " ")
  }

render : Source -> String
render s = s.path ^ s.ext ^ ":" ^ s.indent 2 ^ joinWith "|" s.lines

-- (a record pattern names the fields it matches: a default is matched
-- as one written)
plain : Source -> Bool
plain { ext = ".hf", lines = [] } = True
plain _ = False

made : String -> Source
made p = { path = p, lines = [p] }

rendered : List String
rendered =
  [ render { path = "a" }
  , render { path = "b", ext = ".txt" }
  , render { path = "c", lines = ["x", "y"] }
  , render (made "d")
  , render
      { path = "e", ext = "", lines = ["z"], indent = \n -> debug n }
  ]

plains : List Bool
plains = [plain { path = "a" }, plain (made "b"), plain { path = "c", ext = "" }]

-- (a default that names fields before it is given the record's own,
-- each computed once)
type Window = { start : Int, size : Int = 10, end : Int = start + size }

opened : Int -> Window
opened n = { start = n * n }

ends : List Int
ends =
  List.map
    (\(w : Window) -> w.end)
    [{ start = 1 }, { start = 2, size = 3 }, opened 3, { start = 0, end = 5 }]
