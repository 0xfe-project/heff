-- Constructed results (#80): a function giving back a tag or a record it
-- builds has a worker giving back its fields, which a call taking them
-- apart at once calls; a closure, or a call whose value goes on as it
-- is, calls the wrapper, which builds it.  Each backend held to the
-- interpreter: pairs and records given back round a recursion, a
-- `Maybe` and an `Either` given back by recursive functions, tags of
-- numbers kept flat, tags of different shapes sharing places, a cycle of
-- calls last, a value bound and only matched on, a field read in a
-- lambda, and the wrapper called by closures.

module test.programs.constructed

import int64 as Int64

bool : Bool -> String
bool True = "T"
bool False = "F"

maybeShow : Maybe Int -> String
maybeShow Nothing = "N"
maybeShow (Just n) = "J" ^ showInt n

-- Pairs, round a recursion (nbody's `pull`)
--------------------------------------------------------------------------------

-- (each of the others pushed by `b`, in order: `b` after them all, and
-- each of them)
pull : Int -> List Int -> Pair Int (List Int)
pull b Nil = MkPair b Nil
pull b (o :: os) = case (pull (b + o) os : Pair Int (List Int)) of
  MkPair b2 rest -> MkPair b2 ((o * b) % 1000 :: rest)

pulls : List Int -> List Int
pulls Nil = Nil
pulls (b :: bs) = case pull b bs of
  MkPair b2 rest -> b2 :: pulls rest

pulled : String
pulled =
  joinWith "," (List.map showInt (pulls [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]))

-- (one too long for a stack of calls not last: a list's worth, built
-- and taken apart again at each step)
splitAt : Int -> List Int -> Pair (List Int) (List Int)
splitAt n Nil = MkPair Nil Nil
splitAt n (x :: xs) =
  if n == 0 then MkPair Nil (x :: xs)
  else case (splitAt (n - 1) xs : Pair (List Int) (List Int)) of
    MkPair a b -> MkPair (x :: a) b

halves : String
halves = case splitAt 3 (List.range 1 8) of
  MkPair a b ->
    joinWith "," (List.map showInt a) ^ "|" ^ joinWith "," (List.map showInt b)

-- Records
--------------------------------------------------------------------------------

type Stats = { count : Int, total : Int, mean : Float64 }

stats : List Int -> Stats
stats Nil = { count = 0, total = 0, mean = 0.0 }
stats (x :: xs) =
  let s : Stats = stats xs
  in { count = s.count + 1
     , total = s.total + x
     , mean = toFloat (s.total + x) /. toFloat (s.count + 1)
     }

statsOf : String
statsOf =
  let s = stats [4, 8, 15, 16, 23, 42]
  in showInt s.count ^ " " ^ showInt s.total ^ " " ^ debug s.mean

-- (a field read in a lambda: the field's place captured)
scaledBy : List Int -> List Float64
scaledBy xs =
  let s : Stats = stats xs
  in List.map (\x -> toFloat x * s.mean) xs

scaled : String
scaled = joinWith "," (List.map (\f -> debug f) (scaledBy [1, 2, 3]))

-- Maybe and Either, from recursive functions
--------------------------------------------------------------------------------

-- (a loop giving back a tag: called last of itself, its worker's loop)
findFirst : (Int -> Bool) -> List Int -> Maybe Int
findFirst p Nil = Nothing
findFirst p (x :: xs) = if p x then Just x else findFirst p xs

found : String
found =
  maybeShow (findFirst (\x -> x > 10) [1, 5, 12, 30])
  ^ " "
  ^ maybeShow (findFirst (\x -> x > 100) [1, 5, 12, 30])
  ^ " "
  ^ (case findFirst (\x -> x % 7 == 0) (List.range 1 50) of
     Just n -> showInt (n * 2)
     Nothing -> "none")

-- (a `Maybe Float64`, its number flat in the tuple)
meanOf : Float64 -> Int -> List Float64 -> Maybe Float64
meanOf acc n Nil = if n == 0 then Nothing else Just (acc /. toFloat n)
meanOf acc n (x :: xs) = meanOf (acc + x) (n + 1) xs

orZero : Maybe Float64 -> Float64
orZero Nothing = 0.0
orZero (Just f) = f

means : String
means =
  debug (orZero (meanOf 0.0 0 [1.0, 2.5, 4.0]))
  ^ " "
  ^ debug (orZero (meanOf 0.0 0 Nil))

-- (an `Either Int64 Float64`: its two numbers each a place of its own)
classify : Int64 -> Int -> Either Int64 Float64
classify x n =
  if n == 0
  then (if x % 3 == 0 then Left x
        else Right (toFloat (Int64.toInt x % 1000) * 0.5))
  else classify (x * 6364136223846793005 + 1442695040888963407) (n - 1)

eitherShow : Either Int64 Float64 -> String
eitherShow (Left n) = "L" ^ debug n
eitherShow (Right f) = "R" ^ debug f

classified : String
classified =
  joinWith
    ","
    (List.map (\n -> eitherShow (classify 1 n)) (List.range 0 12))

-- (taken apart twice: a value bound, then only matched on)
twice : Int -> String
twice n =
  let e = classify 7 n
  in (case e of
      Left a -> debug (Int64.toInt a % 10)
      Right f -> debug (floor f % 10))
  ^ (case e of
     Left _ -> "l"
     Right _ -> "r")

twiced : String
twiced = joinWith "," (List.map twice [1, 2, 3, 4, 5])

-- Tags of different shapes
--------------------------------------------------------------------------------

data Shape = Circle Float64 | Rect Float64 Float64 | Named String

-- (three tags, sharing places: a `Float64`, a `V` and another
-- `Float64` -- four words, with the tag's number)
grow : Int -> Shape -> Shape
grow 0 (Circle r) = Circle (r + 0.5)
grow 0 (Rect w h) = Rect h w
grow 0 (Named s) = Named (s ^ ".")
grow n (Circle r) =
  grow (n - 1) (if r > 4.0 then Rect r 1.0 else Circle (r * 2.0))
grow n (Rect w h) =
  grow (n - 1) (if w > 20.0 then Named (showInt n) else Rect w (h + w))
grow n (Named s) = grow (n - 1) (Named (s ^ "!"))

area : Shape -> String
area (Circle r) = "c" ^ debug r
area (Rect w h) = "r" ^ debug (w * h)
area (Named s) = s

shaped : String
shaped =
  joinWith "," (List.map (\n -> area (grow n (Circle 1.0))) (List.range 0 9))

-- (... each tag's arm in a lambda)
widths : String
widths =
  joinWith
    ","
    (List.map
       (\n -> case grow n (Circle 0.5) of
        Circle r -> debug r
        Rect w _ -> debug w
        Named s -> s)
       (List.range 0 6))

-- A cycle of calls last
--------------------------------------------------------------------------------

-- (each gives back what the other does, or a tag: one layout for both,
-- each call last a jump to the other's worker)
hailstone : Int -> Int -> Maybe Int
hailstone n k =
  if n == 1 then Just k
  else if k > 1000 then Nothing
  else if n % 2 == 0 then halve n k
  else hailstone (3 * n + 1) (k + 1)
  where
  halve : Int -> Int -> Maybe Int
  halve m j = if m > 1000000 then Nothing else hailstone (m / 2) (j + 1)

hailstones : String
hailstones =
  joinWith " " (List.map (\n -> maybeShow (hailstone n 0)) [1, 7, 27, 97, 871])

-- The wrapper: closures, and values that go on
--------------------------------------------------------------------------------

-- (the function given as a value: its wrapper builds each pair)
pairs : String
pairs =
  joinWith
    ","
    (List.map
       (\p -> case p of
        MkPair b rest -> showInt b ^ ":" ^ showInt (List.length rest))
       (List.map (pull 1) [Nil, [1], [1, 2], [5, 6, 7]]))

-- (a value that goes on as it is, kept in a list)
kept : String
kept =
  joinWith
    ","
    (List.map
       maybeShow
       (List.map (\n -> findFirst (\x -> x > n) [2, 4, 6]) [0, 3, 9]))

-- (given to another function as it is, and given back)
both : Maybe Int -> Maybe Int -> Maybe Int
both (Just a) (Just b) = Just (a + b)
both a b = Nothing

added : String
added =
  maybeShow
    (both
       (findFirst (\x -> x > 1) [1, 2, 3])
       (findFirst (\x -> x > 2) [1, 2, 3]))
  ^ maybeShow
    (both
       (findFirst (\x -> x > 1) [1, 2, 3])
       (findFirst (\x -> x > 9) [1, 2, 3]))

-- (a value of the program taken apart: computed once, where first used)
counted : Int
counted = case pull 0 (List.range 1 100) of
  MkPair b rest -> b + List.length rest
