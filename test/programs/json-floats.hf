-- JSON's floats, each backend held to the interpreter: a text's float
-- the nearest to it (its IEEE bits, as a float's sign and NaN are not
-- all shown), at the extremes, ties and long fractions; and what
-- `stringify` writes of the infinities, NaN and -0.0.

module test.programs.json-floats

import json as JSON

-- (the IEEE bits of the float read; -1 where it is not one)
floatBitsOf : Either JSON.ParseError JSON.Json -> Int
floatBitsOf (Right (JFloat x)) = floatBits 64 x
floatBitsOf r = -1

texts : List String
texts =
  [ "1e308"
  , "1e-308"
  , "5e-324"
  , "2.4703282292062328e-324"
  , "2.4703282292062327e-324"
  , "9007199254740991.0"
  , "9007199254740993.0"
  , "9007199254740995.0"
  , "0.1"
  , "1e+300"
  , "-0.0"
  , "-1e-400"
  , "1.7976931348623157e308"
  , "1.7976931348623159e308"
  , "2.2250738585072011e-308"
  , "0.30000000000000004"
  , "3.141592653589793238462643383279502884197169399375105820974944592307816406286"
  , "12345678901234567890e-10"
  , "1e400"
  ]

read : List Int
read = List.map (\t -> floatBitsOf (JSON.parse t)) texts

written : String
written =
  JSON.stringify
    (JArray
       [ JFloat (1.0 /. 0.0)
       , JFloat (neg (1.0 /. 0.0))
       , JFloat (0.0 /. 0.0)
       , JFloat (neg 0.0)
       , JFloat 1.0e300
       , JFloat (floatOfBits 64 1)
       ])
