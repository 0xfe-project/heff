-- Effects handled by handlers known where they are handled, which the
-- simplifier makes computations of, specialised for them, and inlines
-- (heff.compile.simplify; #44): what each comes to is the same on every
-- backend as in the interpreter.  A state; exceptions thrown, caught,
-- thrown again from a catch and never caught; four effects stacked,
-- handled by one handler and by four, one over the other; a generator,
-- two of them pulled side by side.  And the shapes the simplifier looks
-- through: a computation that calls itself and ends in an operation
-- (`then get`), a computation bound to a match (`let c = if ...`), a
-- choice of computations followed by more, a handler built by a global.

module test.programs.known-handlers

import co
import state
import exception

-- a state ---------------------------------------------------------------------------

-- | `n` steps of `s <- get; put ...`, from step `i`; then the state.
counting : {e : HFunctor} -> {{st : state Int <: e}} -> Int -> Int -> Co e Int
counting n i =
  if i >= n then get
  else do
    s <- get
    put ((s * 31 + i) % 1000003)
    counting n (i + 1)

data Out a = MkOut a Int

passing : Handler (state Int)
passing =
  { M = \a -> Int -> Out a
  , ret = \x s -> MkOut x s
  , bind = \m k s -> case m s of
      MkOut x s2 -> k x s2
  , malg = \p s -> case p of
      Get k -> MkOut (k s) s
      Put st x -> MkOut x st
  }

counted : Pair Int Int
counted = case handle passing (counting (st := _) 2000 0) 1 of
  MkOut x s -> MkPair x s

-- exceptions -------------------------------------------------------------------------

data Res a = Failed Int | Ok a

failing : Handler (exception Int)
failing =
  { M = \a -> Res a
  , ret = \x -> Ok x
  , bind = \m k -> case m of
      Failed e -> Failed e
      Ok x -> k x
  , malg = \p -> case p of
      Throw e -> Failed e
      Catch c h -> case c of
        Failed e -> h e
        Ok x -> Ok x
  }

validate : {e : HFunctor} -> {{ex : exception Int <: e}} -> Int -> Co e Int
validate i = if i % 3 == 0 then throw (i % 7) else pure (i % 1000)

-- | each `validate i` caught, its answers summed
caughtLoop : {e : HFunctor}
           -> {{ex : exception Int <: e}}
           -> Int
           -> Int
           -> Int
           -> Co e Int
caughtLoop n i acc =
  if i >= n then pure acc
  else do
    v <- recover (validate i) (\err -> pure (0 - err))
    caughtLoop n (i + 1) (acc + v)

-- | ... the computation caught bound to a match first
boundLoop : {e : HFunctor}
          -> {{ex : exception Int <: e}}
          -> Int
          -> Int
          -> Int
          -> Co e Int
boundLoop n i acc =
  if i >= n then pure acc
  else let c =
         ((if i % 3 == 0 then throw (i % 7) else pure (i % 1000)) : Co e Int)
       in do
       v <- recover c (\err -> pure (0 - err))
       boundLoop n (i + 1) (acc + v)

caught : Res Int
caught = handle failing (caughtLoop (ex := _) 3000 0 0)

bound : Res Int
bound = handle failing (boundLoop (ex := _) 3000 0 0)

-- | thrown, after a value, and never caught
uncaught : Res Int
uncaught =
  handle
    failing
    (bind (validate (ex := _) 4) (\x -> validate (ex := _) (x + 5)))

-- | thrown again, from a catch, and caught by the catch around it
rethrown : Res Int
rethrown =
  handle
    failing
    (recover
       (ev := _)
       (recover
          (ev := _)
          (validate (ex := _) 9)
          (\e -> throw (ev := _) (e + 10)))
       (\e -> pure (e * 100)))

-- four effects, stacked ------------------------------------------------------------

data AskF (m : Type -> Type) x = Ask (Int -> x)

reader : HFunctor
reader =
  { f = AskF
  , hfmap = \m g p -> case p of
      Ask k -> Ask (\v -> g (k v))
  , hmap = \m n nt p -> case p of
      Ask k -> Ask k
  }

data TellF (m : Type -> Type) x = Tell Int x

writer : HFunctor
writer =
  { f = TellF
  , hfmap = \m g p -> case p of
      Tell v x -> Tell v (g x)
  , hmap = \m n nt p -> case p of
      Tell v x -> Tell v x
  }

W3 : HFunctor
W3 = state Int <+> exception Int

W2 : HFunctor
W2 = writer <+> W3

W : HFunctor
W = reader <+> W2

ask : Co W Int
ask = op (InL (Ask (\v -> v))) val

tell : Int -> Co W Unit
tell v = op (InR (InL (Tell v MkUnit))) val

step : Int -> Co W Int
step i = do
  k <- ask
  s <- get (ev := _)
  let s2 = (s * k + i) % 1000003
  put (ev := _) s2
  if s2 % 10 == 0 then tell s2 else pure MkUnit
  recover
      (ev := _)
      (if s2 % 13 == 0 then throw (ev := _) s2 else pure 1)
      (\e -> pure (0 - e % 5))

stepping : Int -> Int -> Int -> Co W Int
stepping n i acc =
  if i >= n then pure acc
  else do
    r <- step i
    stepping n (i + 1) (acc + r)

-- | the four handled at once
data St3 a = MkSt3 a Int Int

combined : Handler W
combined =
  { M = \a -> Int -> Int -> Res (St3 a)
  , ret = \x s t -> Ok (MkSt3 x s t)
  , bind = \m k s t -> case m s t of
      Failed e -> Failed e
      Ok (MkSt3 x s2 t2) -> k x s2 t2
  , malg = \p s t -> case p of
      InL (Ask k) -> Ok (MkSt3 (k 7) s t)
      InR (InL (Tell v x)) -> Ok (MkSt3 x s (t + v))
      InR (InR (InL (Get k))) -> Ok (MkSt3 (k s) s t)
      InR (InR (InL (Put st x))) -> Ok (MkSt3 x st t)
      InR (InR (InR (Throw e))) -> Failed e
      InR (InR (InR (Catch c h))) -> case c s t of
        Failed e -> h e s t
        Ok r -> Ok r
  }

stackedOnce : Res (St3 Int)
stackedOnce = handle combined (stepping 400 0 0) 1 0

-- | choices of computations, then more: three ways, each going on; and
-- | two, one of them thrown, which goes on no more
chosen : Int -> Co W Int
chosen i = do
  s <- get (ev := _)
  if s % 3 == 0 then tell s
  else if s % 3 == 1 then put (ev := _) ((s + i) % 1009)
  else pure MkUnit
  t <- get (ev := _)
  put (ev := _) ((t * 7 + i) % 1009)
  if t % 11 == 0 then (throw (ev := _) t : Co W Unit) else pure MkUnit
  pure t

choosing : Int -> Int -> Int -> Co W Int
choosing n i acc =
  if i >= n then pure acc
  else do
    r <- recover (ev := _) (chosen i) (\e -> pure (0 - e))
    choosing n (i + 1) (acc + r)

chosenOnce : Res (St3 Int)
chosenOnce = handle combined (choosing 400 0 0) 1 0

-- | ... by a handler built by a global, given what `ask` answers and a
-- | limit: past it, `ask` fails, a way that goes on no more
combinedBy : Int -> Int -> Handler W
combinedBy base limit =
  { M = \a -> Int -> Int -> Res (St3 a)
  , ret = \x s t -> Ok (MkSt3 x s t)
  , bind = \m k s t -> case m s t of
      Failed e -> Failed e
      Ok (MkSt3 x s2 t2) -> k x s2 t2
  , malg = \p s t -> case p of
      InL (Ask k) ->
        if t > limit then Failed t else Ok (MkSt3 (k (base + s % 5)) s t)
      InR (InL (Tell v x)) -> Ok (MkSt3 x s (t + v))
      InR (InR (InL (Get k))) -> Ok (MkSt3 (k s) s t)
      InR (InR (InL (Put st x))) -> Ok (MkSt3 x st t)
      InR (InR (InR (Throw e))) -> Failed e
      InR (InR (InR (Catch c h))) -> case c s t of
        Failed e -> h e s t
        Ok r -> Ok r
  }

builtOnce : Int -> Int -> Res (St3 Int)
builtOnce base limit = handle (combinedBy base limit) (stepping 400 0 0) 1 0

-- | one run to its end, one failed past its limit
built : Pair (Res (St3 Int)) (Res (St3 Int))
built = MkPair (builtOnce 7 100000000) (builtOnce 3 50000)

-- | ... and one over the other: the reader by `through`, the writer and
-- | the state each by a layer passing an Int, into `Co` of the rest
outValue : {a : Type} -> Out a -> a
outValue (MkOut x _) = x

passingF : (e : HFunctor) -> RawFunctor
passingF e =
  { f = \a -> Int -> Co e (Out a)
  , fmap = \g m s ->
        bind (m s) (\o -> case o of
          MkOut x s2 -> val (MkOut (g x) s2))
  }

layer : (h e : HFunctor)
      -> ({a : Type}
          -> h.f (\x -> Int -> Co e (Out x)) a
          -> Int
          -> Co e (Out a))
      -> Handler (h <+> e)
layer h e alg =
  { M = \a -> Int -> Co e (Out a)
  , ret = \x s -> val (MkOut x s)
  , bind = \m k s ->
        bind (m s) (\o -> case o of
          MkOut x s2 -> k x s2)
  , malg = \p s -> case p of
      InL t -> alg t s
      InR q ->
        op
          (e.hmap
             (passingF e)
             (coFunctor e)
             (\c -> bind (c s) (\o -> val (outValue o)))
             q)
          (\x -> val (MkOut x s))
  }

stackedLayers : Res (Out (Out Int))
stackedLayers =
  let c1 =
    handle
      (through reader W2 (\t -> case t of
       Ask k -> val (k 7)))
      (stepping 400 0 0)
  in let c2 =
    handle
      (layer writer W3 (\t s -> case t of
       Tell v x -> val (MkOut x (s + v))))
      c1
      0
  in let c3 =
    handle
      (layer (state Int) (exception Int) (\t s -> case t of
       Get k -> val (MkOut (k s) s)
       Put st x -> val (MkOut x st)))
      c2
      1
  in handle failing c3

-- a generator -----------------------------------------------------------------------

data YieldF (m : Type -> Type) x = Yield Int x

yielder : HFunctor
yielder =
  { f = YieldF
  , hfmap = \m g p -> case p of
      Yield v x -> Yield v (g x)
  , hmap = \m n nt p -> case p of
      Yield v x -> Yield v x
  }

yield : Int -> Co yielder Unit
yield v = op (Yield v MkUnit) val

squares : Int -> Int -> Co yielder Unit
squares n i =
  if i >= n then pure MkUnit
  else do
    yield ((i * i) % 1000)
    squares n (i + 1)

randoms : Int -> Int -> Int -> Co yielder Unit
randoms n i x =
  if i >= n then pure MkUnit
  else (let y = (x * 48271) % 2147483647
        in do
        yield (y % 1000)
        randoms n (i + 1) y)

data Pull = Next

data Gen a = Done a | More Int (Pull -> Gen a)

genBind : {a b : Type} -> Gen a -> (a -> Gen b) -> Gen b
genBind (Done x) k = k x
genBind (More v rest) k = More v (\u -> genBind (rest u) k)

streaming : Handler yielder
streaming =
  { M = \a -> Gen a
  , ret = \x -> Done x
  , bind = \m k -> genBind m k
  , malg = \p -> case p of
      Yield v x -> More v (\u -> Done x)
  }

zipSum : {a b : Type} -> Gen a -> Gen b -> Int -> Int -> Pair Int Int
zipSum (More x xs) (More y ys) sum above =
  zipSum (xs Next) (ys Next) (sum + x * y) (if x > y then above + 1 else above)
zipSum _ _ sum above = MkPair sum above

generated : Pair Int Int
generated =
  zipSum
    (handle streaming (squares 3000 0))
    (handle streaming (randoms 3000 0 42))
    0
    0

-- a choice resumed twice, a state outside it -----------------------------------------

data FlipF (m : Type -> Type) x = Flip (Bool -> x)

flips : HFunctor
flips =
  { f = FlipF
  , hfmap = \m g p -> case p of
      Flip k -> Flip (\b -> g (k b))
  , hmap = \m n nt p -> case p of
      Flip k -> Flip k
  }

flipC : {e : HFunctor} -> {{ch : flips <: e}} -> Co e Bool
flipC = op (ch (Flip (\b -> b))) val

-- | `d` choices, each path a number; at its end the state got and put
paths : {e : HFunctor}
      -> {{ch : flips <: e}}
      -> {{st : state Int <: e}}
      -> Int
      -> Int
      -> Co e Int
paths d acc =
  if d == 0
  then (do
        s <- get
        put ((s * 31 + acc) % 1009)
        pure acc)
  else (do
        b <- flipC
        paths (d - 1) (if b then acc * 2 + 1 else acc * 2))

getKept : Co (state Int) Int
getKept = get (ev := _)

putKept : Int -> Co (state Int) Unit
putKept s = put (ev := _) s

-- | each choice resumed with True, then False, what the two collect
-- | appended; the state's operations done again, out to `passing`
everyPath : Handler (flips <+> state Int)
everyPath =
  { M = \a -> (a -> Co (state Int) (List Int)) -> Co (state Int) (List Int)
  , ret = \x c -> c x
  , bind = \m k c -> m (\x -> k x c)
  , malg = \p c -> case p of
      InL (Flip k) ->
        bind (c (k True)) (\xs -> bind (c (k False)) (\ys -> val (xs ++ ys)))
      InR (Get k) -> bind getKept (\s -> c (k s))
      InR (Put s x) -> bind (putKept s) (\u -> c x)
  }

sumPaths : Int -> List Int -> Int
sumPaths a Nil = a
sumPaths a (x :: xs) = sumPaths (a + x) xs

-- | the paths' sum, and the state they leave
explored : Pair Int Int
explored = case handle
    passing
    (handle
       everyPath
       (paths (ch := _) (st := _) 9 0)
       (\x -> val [x]))
    1 of
  MkOut xs s -> MkPair (sumPaths 0 xs) s
