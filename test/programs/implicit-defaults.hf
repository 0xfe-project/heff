-- An implicit argument's default, `{x : A := d} -> B`: given where the
-- argument is not, and at run time where it is of a small type.

module test.programs.implicit-defaults

base : Int
base = 10

shift : {by : Int := base} -> Int -> Int
shift n = n + by

label : {loud : Bool := False} -> String -> String
label s = if loud then s ^ "!" else s

shifted : List Int
shifted = [shift 1, shift (by := 2) 1]

-- (a function value: its default given where it is used)
mapped : List Int
mapped = List.map shift [5, 6]

labels : List String
labels = [label "a", label (loud := True) "b"]
