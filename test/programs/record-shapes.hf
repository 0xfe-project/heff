-- Records read at the place their type gives each field (#34): records of
-- many shapes, one label at a different place in each, fields that are
-- types (not there where the program runs), records held after a field
-- is read, lent, and given up by it.

type Named = { name : String, text : String }

type Wide =
  { size : Int
  , kind : Int
  , flag : Bool
  , text : String
  , more : List Int
  , last : Int
  , count : Int
  }

-- (a field that is a type, erased where the program runs: the fields
-- after it one place nearer)
theory Typed where
  elem : Type
  text : String
  items : List Int

theory Family where
  M : Type -> Type
  size : Int
  wrap : Int -> M Int

named : Int -> Named
named i = { name = "n" ^ show i, text = "t" ^ show i }

wide : Int -> Wide
wide i =
  { size = i
  , kind = i % 3
  , flag = i % 2 == 0
  , text = "w" ^ show i
  , more = List.range 1 i
  , last = i * 10
  , count = 7
  }

typed : Int -> Typed
typed i = { elem = Int, text = "y" ^ show i, items = [i, i + 1] }

family : Family
family = { M = List, size = 2, wrap = \n -> List.replicate 2 n }

-- (`text` read from each, by lambdas given to one function: each its own)
texts : List String
texts =
  List.append
    (List.map (\(r : Named) -> r.text) (List.map named (List.range 1 3)))
    (List.append
       (List.map (\(r : Wide) -> r.text) (List.map wide (List.range 1 3)))
       (List.map (\i -> (typed i).text) (List.range 1 3)))

-- (the record held after each field is read but the last)
wideSum : Wide -> Int
wideSum r =
  r.size
  + r.kind
  + (if r.flag then 1 else 0)
  + strLength r.text
  + List.sum r.more
  + r.last
  + r.count

wideSums : List Int
wideSums = List.map (\i -> wideSum (wide i)) (List.range 1 6)

-- (a record built and only one field of it read: given up there)
lasts : List Int
lasts = List.map (\i -> (wide i).last) (List.range 1 6)

-- (a record shared: each holder reads it, it stays whole)
shared : List Int
shared =
  let r = wide 5
  in [wideSum r, r.size, List.length r.more, wideSum r, r.count]

-- (a record in a record, a function in a record)
type Outer = { inner : Wide, label : Named, f : Int -> Int }

outer : Int -> Outer
outer i = { inner = wide i, label = named i, f = \x -> x + i }

outers : List Int
outers =
  List.map
    (\i -> (outer i).f ((outer i).inner.last) + strLength (outer i).label.name)
    (List.range 1 4)

families : List Int
families = List.append (family.wrap 3) [family.size]

typedItems : List Int
typedItems = List.concatMap (\i -> (typed i).items) [1, 5]

-- (records of a type with a parameter, at two types)
type Two (a : Type) = { one : a, other : a, tag : String }

twoInts : Two Int
twoInts = { one = 1, other = 2, tag = "ints" }

twoStrs : Two String
twoStrs = { one = "a", other = "b", tag = "strs" }

swapTwo : {a : Type} -> Two a -> Two a
swapTwo r = { one = r.other, other = r.one, tag = r.tag }

swapped : List String
swapped =
  [ show (swapTwo twoInts).one
  , (swapTwo twoStrs).one
  , (swapTwo (swapTwo twoStrs)).tag
  ]

-- (many records read and given back)
manyReads : Int
manyReads =
  List.foldl (\acc i -> acc + wideSum (wide (i % 20))) 0 (List.range 1 3000)

-- Records updated: built from one of the same shape, some of its fields
-- kept at their places -- in its cell where it was the last reference
-- to it, a copy where it is shared
--------------------------------------------------------------------------------

type Sched = { ready : List Int, chans : List Int, waiting : Int, next : Int }

start : Sched
start = { ready = [], chans = [0], waiting = 0, next = 1 }

-- (one field changed, the others kept)
pushReady : Int -> Sched -> Sched
pushReady x s =
  { ready = x :: s.ready, chans = s.chans, waiting = s.waiting, next = s.next }

-- (two changed, one from another's place)
bump : Sched -> Sched
bump s =
  { ready = s.ready
  , chans = s.next :: s.chans
  , waiting = s.next
  , next = s.next + 1
  }

-- (the record itself, held by a field of the one built from it)
type Chain = { here : Int, prev : Maybe Chain, depth : Int }

extend : Chain -> Chain
extend c = { here = c.here + 1, prev = Just c, depth = c.depth + 1 }

chainSum : Chain -> Int
chainSum c = case c.prev of
  Nothing -> c.here
  Just p -> c.here + chainSum p

-- (each field read before it is given up: unique, built in place)
stepped : Int -> Sched -> Sched
stepped n s = if n <= 0 then s else stepped (n - 1) (bump (pushReady n s))

schedSum : Sched -> Int
schedSum s = List.sum s.ready + List.sum s.chans + s.waiting + s.next

uniqueRun : Int
uniqueRun = schedSum (stepped 2000 start)

-- (shared: the one updated from is kept as it was, and read after)
sharedRun : List Int
sharedRun =
  let s = stepped 3 start
  in let t = bump s
  in let u = pushReady 9 s
  in [schedSum s, schedSum t, schedSum u, schedSum s, List.length s.ready]

-- (fields swapped: neither kept at its place)
swaps : List String
swaps =
  let r = ({ one = "x", other = "y", tag = "t" } : Two String)
  in let s = swapTwo r
  in [s.one, s.other, r.one, (swapTwo s).one]

chains : List Int
chains =
  let c0 = ({ here = 1, prev = Nothing, depth = 0 } : Chain)
  in let c3 = extend (extend (extend c0))
  in [chainSum c3, c3.depth, chainSum (extend c3), chainSum c0]

-- (many updated and given back, each holding a long list)
manyUpdates : Int
manyUpdates =
  List.foldl
    (\acc i -> acc + schedSum (stepped 20 (pushReady i start)))
    0
    (List.range 1 300)

-- Fields taken: a field read of a record that is then only read other
-- fields of and updated is moved out of it where it was the last
-- reference -- its value, held once, then built in its own cell in turn
--------------------------------------------------------------------------------

type Queue = { front : List Int, back : List Int }

emptyQ : Queue
emptyQ = { front = [], back = [] }

putQ : Int -> Queue -> Queue
putQ x q = { front = q.front, back = x :: q.back }

takeQ : Queue -> Maybe (Pair Int Queue)
takeQ q = case q.front of
  Cons x rest -> Just (MkPair x { front = rest, back = q.back })
  Nil -> case List.reverse q.back of
    Cons x rest -> Just (MkPair x { front = rest, back = [] })
    Nil -> Nothing

type State = { queue : Queue, seen : List Int, turns : Int }

turn : Int -> State -> State
turn x s = case takeQ (putQ x (putQ (x * 10) s.queue)) of
  Just p -> { queue = snd p, seen = fst p :: s.seen, turns = s.turns + 1 }
  Nothing -> { queue = emptyQ, seen = s.seen, turns = s.turns }

turned2 : Int -> State -> State
turned2 n s = if n <= 0 then s else turned2 (n - 1) (turn n s)

stateSum : State -> Int
stateSum s =
  List.sum s.queue.front + List.sum s.queue.back + List.sum s.seen + s.turns

state0 : State
state0 = { queue = emptyQ, seen = [], turns = 0 }

-- (unique all along)
uniqueTurns : Int
uniqueTurns = stateSum (turned2 3000 state0)

-- (shared: the state turned from is kept as it was, and read after)
sharedTurns : List Int
sharedTurns =
  let s = turned2 4 state0
  in let t = turned2 3 s
  in [stateSum s, stateSum t, stateSum (turn 7 s), s.turns, List.length s.seen]

-- (a queue shared by two states: each turned apart)
twoStates : List Int
twoStates =
  let q = putQ 1 (putQ 2 emptyQ)
  in let a = turn 5 { queue = q, seen = [], turns = 0 }
  in let b = turn 6 { queue = q, seen = [9], turns = 1 }
  in [stateSum a, stateSum b, List.sum q.back]
