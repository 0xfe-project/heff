-- Records read at the place their type gives each field (#34): records of
-- many shapes, one label at a different place in each, fields that are
-- types (not there where the program runs), records held after a field
-- is read, lent, and given up by it.

type Named = { name : String, text : String }

type Wide =
  { size : Int
  , kind : Int
  , flag : Bool
  , text : String
  , more : List Int
  , last : Int
  , count : Int
  }

-- (a field that is a type, erased where the program runs: the fields
-- after it one place nearer)
theory Typed where
  elem : Type
  text : String
  items : List Int

theory Family where
  M : Type -> Type
  size : Int
  wrap : Int -> M Int

named : Int -> Named
named i = { name = "n" ^ showInt i, text = "t" ^ showInt i }

wide : Int -> Wide
wide i =
  { size = i
  , kind = i % 3
  , flag = i % 2 == 0
  , text = "w" ^ showInt i
  , more = List.range 1 i
  , last = i * 10
  , count = 7
  }

typed : Int -> Typed
typed i = { elem = Int, text = "y" ^ showInt i, items = [i, i + 1] }

family : Family
family = { M = List, size = 2, wrap = \n -> List.replicate 2 n }

-- (`text` read from each, by lambdas given to one function: each its own)
texts : List String
texts =
  List.append
    (List.map (\(r : Named) -> r.text) (List.map named (List.range 1 3)))
    (List.append
       (List.map (\(r : Wide) -> r.text) (List.map wide (List.range 1 3)))
       (List.map (\i -> (typed i).text) (List.range 1 3)))

-- (the record held after each field is read but the last)
wideSum : Wide -> Int
wideSum r =
  r.size
  + r.kind
  + (if r.flag then 1 else 0)
  + strLength r.text
  + List.sum r.more
  + r.last
  + r.count

wideSums : List Int
wideSums = List.map (\i -> wideSum (wide i)) (List.range 1 6)

-- (a record built and only one field of it read: given up there)
lasts : List Int
lasts = List.map (\i -> (wide i).last) (List.range 1 6)

-- (a record shared: each holder reads it, it stays whole)
shared : List Int
shared =
  let r = wide 5
  in [wideSum r, r.size, List.length r.more, wideSum r, r.count]

-- (a record in a record, a function in a record)
type Outer = { inner : Wide, label : Named, f : Int -> Int }

outer : Int -> Outer
outer i = { inner = wide i, label = named i, f = \x -> x + i }

outers : List Int
outers =
  List.map
    (\i -> (outer i).f ((outer i).inner.last) + strLength (outer i).label.name)
    (List.range 1 4)

families : List Int
families = List.append (family.wrap 3) [family.size]

typedItems : List Int
typedItems = List.concatMap (\i -> (typed i).items) [1, 5]

-- (records of a type with a parameter, at two types)
type Two (a : Type) = { one : a, other : a, tag : String }

twoInts : Two Int
twoInts = { one = 1, other = 2, tag = "ints" }

twoStrs : Two String
twoStrs = { one = "a", other = "b", tag = "strs" }

swapTwo : {a : Type} -> Two a -> Two a
swapTwo r = { one = r.other, other = r.one, tag = r.tag }

swapped : List String
swapped =
  [ showInt (swapTwo twoInts).one
  , (swapTwo twoStrs).one
  , (swapTwo (swapTwo twoStrs)).tag
  ]

-- (many records read and given back)
manyReads : Int
manyReads =
  List.foldl (\acc i -> acc + wideSum (wide (i % 20))) 0 (List.range 1 3000)
