-- Green threads (lib/green.hf), with a log beside them, handled in the
-- language too: threads take turns at `yield`, at a `recv` with nothing
-- to take, and where they end, round robin, and each says what it does
-- in the log.  A schedule's order, what it comes to, a deadlock, and
-- many threads and switches: a heap of continuations, each step's rest
-- called last.

import co
import green

-- the world beside: a log --------------------------------------------------------

data LogF (m : Type -> Type) x = Say String x

logging : HFunctor
logging =
  { f = LogF
  , hfmap = \m g p -> case p of
      Say s x -> Say s (g x)
  , hmap = \m n nt p -> case p of
      Say s x -> Say s x
  }

say : {e : HFunctor} -> {{lg : logging <: e}} -> String -> Co e Unit
say s = op (lg (Say s MkUnit)) val

-- (what was said before, then what comes after)
prefixed : {a : Type} -> List String -> Pair a (List String) -> Pair a (List String)
prefixed out (MkPair y out2) = MkPair y (out ++ out2)

thenLog : {a b : Type} -> Pair a (List String) -> (a -> Pair b (List String)) -> Pair b (List String)
thenLog (MkPair x out) k = prefixed out (k x)

logAlg : {m : Type -> Type} -> {a : Type} -> LogF m a -> Pair a (List String)
logAlg (Say s x) = MkPair x [s]

-- | The log, kept: what a computation comes to, and what it said.
logged : Handler logging
logged =
  { M = \a -> Pair a (List String)
  , ret = \x -> MkPair x []
  , bind = \m k -> thenLog m k
  , malg = \p -> logAlg p
  }

-- the programs -------------------------------------------------------------------

gw : HFunctor
gw = green <+> logging

-- | What a schedule came to, and the log.
type Ran a = Pair (Maybe a) (List String)

-- (each scheduled with a log, the log kept)
run : {a : Type} -> Co gw a -> Ran a
run c = handle logged (scheduled logging c)

repeatG : {e : HFunctor} -> Int -> Co e Unit -> Co e Unit
repeatG 0 c = pure MkUnit
repeatG n c = bind c (\u -> repeatG (n - 1) c)

-- (the sum of n values received on ch)
recvSum : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Int -> Co e Int
recvSum ch 0 = pure 0
recvSum ch n = do
  x <- recv ch
  rest <- recvSum ch (n - 1)
  pure (x + rest)

-- | Three threads saying three lines each, yielding between: the order
-- | the scheduler gives them turns in, main first.
talker : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> String -> Int -> Co e Unit
talker name 0 = pure MkUnit
talker name n = do
  say (name ^ showInt n)
  yield
  talker name (n - 1)

turns : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Co e String
turns = do
  spawn (talker "a" 3)
  spawn (talker "b" 3)
  spawn (talker "c" 3)
  say "main"
  yield
  say "main again"
  yield
  yield
  yield
  pure "main done"

worker : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Int -> Int -> Int -> Co e Unit
worker name inbox outbox = do
  x <- recv inbox
  say ("worker " ^ showInt name ^ " squares " ^ showInt x)
  send outbox (x * x)
  yield
  worker name inbox outbox

producer : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Int -> Int -> Int -> Co e Unit
producer jobs i n = if i > n then pure MkUnit else do
  say ("producer sends " ^ showInt i)
  send jobs i
  yield
  producer jobs (i + 1) n

-- | A producer, two workers squaring, and main adding up the squares of
-- | 1 to 6 (91): the workers never end, dropped when main is done.
squares : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Co e Int
squares = do
  jobs <- newChan
  results <- newChan
  spawn (worker 1 jobs results)
  spawn (worker 2 jobs results)
  spawn (producer jobs 1 6)
  recvSum results 6

-- | n threads, each sending 1: main receives them all.
spawnMany : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Co e Int
spawnMany n = do
  ch <- newChan
  repeatG n (spawn (send ch 1))
  recvSum ch n

-- | 10 threads, each yielding n times, then sending 1.
yields : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Co e Int
yields n = do
  ch <- newChan
  repeatG 10 (spawn (bind (repeatG n yield) (\u -> send ch 1)))
  recvSum ch 10

ponger : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Int -> Co e Unit
ponger a b = do
  x <- recv a
  send b (x + 1)
  ponger a b

pinger : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Int -> Int -> Int -> Co e Int
pinger 0 a b x = pure x
pinger n a b x = do
  send a x
  y <- recv b
  pinger (n - 1) a b y

-- | A value sent back and forth n times between two threads, one added
-- | each time.
ping : {e : HFunctor} -> {{ev : green <: e}} -> Int -> Co e Int
ping n = do
  a <- newChan
  b <- newChan
  spawn (ponger a b)
  pinger n a b 0

-- | main and a thread each waiting on a channel nobody sends on.
stuck : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Co e Int
stuck = do
  a <- newChan
  b <- newChan
  spawn (bind (recv a) (\x -> send b x))
  say "waiting"
  recv b

-- (each at gw)
onG : (green <: gw)
onG p = InL p

onL : (logging <: gw)
onL p = InR p

turnsRun : Ran String
turnsRun = run (turns (ev := onG) (lg := onL))

squaresRun : Ran Int
squaresRun = run (squares (ev := onG) (lg := onL))

spawned : Ran Int
spawned = run (spawnMany (ev := onG) 1000)

yielded : Ran Int
yielded = run (yields (ev := onG) 200)

pinged : Ran Int
pinged = run (ping (ev := onG) 1000)

deadlocked : Ran Int
deadlocked = run (stuck (ev := onG) (lg := onL))

-- (one watch for them: a watch computes the file's definitions anew)
-- >>> (MkPair turnsRun [squaresRun, spawned, yielded, pinged, deadlocked] : Pair (Ran String) (List (Ran Int)))
-- MkPair (MkPair (Just "main done") (Cons "main" (Cons "a3" (Cons "b3" (Cons "c3" (Cons "main again" (Cons "a2" (Cons "b2" (Cons "c2" (Cons "a1" (Cons "b1" (Cons "c1" Nil)))))))))))) (Cons (MkPair (Just 91) (Cons "producer sends 1" (Cons "worker 1 squares 1" (Cons "producer sends 2" (Cons "worker 2 squares 2" (Cons "producer sends 3" (Cons "worker 1 squares 3" (Cons "producer sends 4" (Cons "worker 2 squares 4" (Cons "producer sends 5" (Cons "worker 1 squares 5" (Cons "producer sends 6" (Cons "worker 2 squares 6" Nil))))))))))))) (Cons (MkPair (Just 1000) Nil) (Cons (MkPair (Just 10) Nil) (Cons (MkPair (Just 1000) Nil) (Cons (MkPair Nothing (Cons "waiting" Nil)) Nil)))))

-- when the schedule runs ------------------------------------------------------------

-- (a thread whose pure work abandons after a switch, before anything is
-- said)
boom : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Co e Int
boom = do
  ch <- newChan
  spawn (send ch 0)
  x <- recv ch
  y <- pure (if x == 0 then abandon else x)
  say "never"
  pure y

-- | `scheduled` makes a computation and runs none of it ...
madeOnly : String
madeOnly = const "made" (scheduled logging (boom (ev := onG) (lg := onL)))

-- | ... until it runs.
-- | >>> madeAndRun
-- | <abandoned>
madeAndRun : Ran Int
madeAndRun = run (boom (ev := onG) (lg := onL))

-- | `scheduledNow` takes every thread's steps up to the first thing said
-- | where it is made: the work that abandons among them.
-- | >>> madeNow
-- | <abandoned>
madeNow : String
madeNow = const "made" (scheduledNow logging (boom (ev := onG) (lg := onL)))

-- (... and none after it: what comes after the first thing said waits
-- for the `Co` to run)
saidFirst : {e : HFunctor} -> {{ev : green <: e}} -> {{lg : logging <: e}} -> Co e Int
saidFirst = do
  say "first"
  boom

-- | >>> ([madeOnly, madeNowSaidFirst] : List String)
-- | Cons "made" (Cons "made" Nil)
madeNowSaidFirst : String
madeNowSaidFirst = const "made" (scheduledNow logging (saidFirst (ev := onG) (lg := onL)))
