-- Arithmetic as it is written, compiled: a difference times something,
-- a quotient of a product, a sum of products -- the parentheses the
-- operators need in JavaScript are kept.

diffTimes : Int -> Int -> Int -> Int
diffTimes a b c = (a - b) * c

shifted : Int
shifted = diffTimes 1 1 5

sumTimes : Int
sumTimes = (2 + 3) * (4 - 6)

nested : Int
nested = 10 - (3 - 1) * (2 + 2 * 3)

leftMinus : Int
leftMinus = (0 - 3) * 2

quotient : Float64
quotient = 1.0 /. (2.0 * 4.0)

product : Float64
product = 2.0 * (6.0 /. 3.0)

mixed : Float64
mixed = (1.5 - 0.5) * (3.0 + 1.0) /. 2.0
