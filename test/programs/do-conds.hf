-- A `do` block's `if` and `case` statements whose arms each reach their
-- end, in `run do`'s loops: each arm gives the variables back to what
-- follows it, no join point -- the same values in every backend.

module test.programs.do-conds

import array

-- (two variables, an `if` with `else`, little after it)
twoVars : Int -> Int
twoVars n = run do
  let mut a = 0
  let mut b = 1
  let mut i = 0
  while i < n do
    i := i + 1
    if i % 3 == 0 then do
      a := a + i
      b := (b * 7 + a) % 1000
    else b := b + 1
    a := a % 10007
  return a * 1000 + b

-- (four variables, more after the `if` than is copied into its arms)
fourVars : Int -> Int
fourVars n = run do
  let mut a = 0
  let mut b = 0
  let mut c = 0
  let mut d = 0
  let mut i = 0
  while i < n do
    i := i + 1
    if i % 4 == 0 then do
      a := (a + 3) % 1024
      b := (b + 5) % 4096
    else do
      c := (c + 7) % 2048
      d := (d + 1) % 512
    a := (a + i) % 1024
    b := (b + i) % 4096
    c := (c + i) % 2048
    d := (d + i) % 512
    a := (a * 3 + 1) % 1024
    b := (b * 5 + 1) % 4096
    c := (c * 3 + 2) % 2048
    d := (d * 5 + 3) % 512
    a := (a + b + i * 7) % 1024
    b := (b + c + i * 7) % 4096
    c := (c + d + i * 7) % 2048
    d := (d + a + i * 7) % 512
    a := (a * 5 + 2) % 1024
    b := (b * 3 + 2) % 4096
    c := (c * 5 + 1) % 2048
    d := (d * 3 + 1) % 512
  return a + b * 10 + c * 100 + d * 1000

-- (an `if` without `else`, a variable set in one arm alone)
noElse : List Int -> Int
noElse xs = run do
  let mut big = 0
  let mut small = 0
  for x in xs do
    if x > 10 then do
      big := big + x
      small := small - 1
    small := small + 1
  return big * 100 + small

-- (a `case` of statements, its arms binding what they match)
cases : List (Maybe Int) -> Int
cases ms = run do
  let mut found = 0
  let mut missing = 0
  let mut last = 0
  for m in ms do
    case m of
      Just v -> do
        found := found + v
        last := v
      Nothing -> missing := missing + 1
    last := last * 2
  return found * 10000 + missing * 100 + last

-- (an `if` in an arm of an `if`, and a loop in an arm)
nested : Int -> Int
nested n = run do
  let mut s = 0
  let mut t = 0
  for i in range 0 n do
    if i % 2 == 0 then do
      if i % 3 == 0 then do
        s := s + i
        t := t + 1
      else t := t + 2
      s := s + 1
    else do
      let mut k = i
      while k > 0 do
        t := t + k % 3
        k := k / 3
    s := s % 100003
  return s * 1000 + t

-- (an arm leaving by `continue`: what follows stays a join point)
continued : Int -> Int
continued n = run do
  let mut a = 0
  let mut b = 0
  let mut i = 0
  while i < n do
    i := i + 1
    if i % 5 == 0 then do
      a := a + 1
      continue
    else if i % 7 == 0 then b := b + i
    else a := a + 2
    b := b + 1
  return a * 1000 + b

-- (an arm ending in `abandon`, never reached)
abandons : Int -> Int
abandons n = run do
  let mut a = 0
  let mut b = 0
  for i in range 0 n do
    if i >= 0 then do
      a := a + i
      b := b + 1
    else a := abandon
    a := a % 1009
  return a * 100 + b

-- (over an array of big integers: the variables set in the arms are
-- counted where they are kept)
bigs : Array Int
bigs =
  arrayFromList
    [1180591620717411303424, 0 - 1180591620717411303424, 5, 7, 11]

bigSums : Array Int -> Int
bigSums arr = run do
  let mut pos = 0
  let mut neg = 0
  for x in arr do
    if x > 0 then do
      pos := pos + x
      neg := neg + 0
    else neg := neg + x
    pos := pos + 1
  return pos + neg

-- (a string set to a second variable in an arm while it goes on as its
-- own, more after the `if` than is copied into its arms: each counted,
-- the one kept not given back when the other is)
keptOf : Int -> Int
keptOf n = run do
  let mut kept = ""
  let mut a = 0
  let mut b = 0
  for i in range 0 n do
    let mut v = "item " ^ showInt i
    if i % 3 == 1 then kept := v
    a := (a * 3 + b + strLength v) % 1000
    b := (b + a * 2 + strLength v) % 4099
    a := (a * 5 + b + strLength v + 1) % 1001
    b := (b + a * 3 + strLength v + 2) % 4093
    a := (a * 7 + b + strLength v + 3) % 1009
    b := (b + a * 5 + strLength v + 5) % 4091
    a := (a * 3 + b + strLength v + 7) % 1013
    b := (b + a * 7 + strLength v + 11) % 4079
  return (if strEq kept "item 100" then 1 else 2) * 100000000 + b * 1000 + a

conds : List Int
conds =
  [ twoVars 1000
  , fourVars 10000
  , noElse [1, 20, 3, 40, 5]
  , cases [Just 3, Nothing, Just 4, Nothing, Nothing]
  , nested 50
  , continued 100
  , abandons 200
  , bigSums bigs
  , keptOf 101
  ]
