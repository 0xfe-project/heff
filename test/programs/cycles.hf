-- Functions calling one another last round a cycle, made one loop
-- (#78): of other arities, of numbers kept
-- unboxed, of records read at their shapes; one called not last too,
-- and one a value.  Each is too big to be inlined, so the cycle stays.

import int64 as Int64

-- (arities 1 and 2)
walkA : Int -> Int
walkA n =
  if n == 0 then 0
  else if n % 3 == 0 then walkB (n - 1) (n * 3 + 1)
  else if n % 3 == 1 then walkB (n - 1) (n * 5 + 2)
  else if n % 7 == 2 then walkB (n - 1) (n * 7 + 3)
  else if n % 11 == 3 then walkB (n - 1) (n * 11 + 4)
  else if n % 13 == 4 then walkB (n - 1) (n * 13 + 5)
  else walkB (n - 1) (n + 6)
  where
    walkB : Int -> Int -> Int
    walkB m k =
      if m == 0 then k
      else if k % 3 == 0 then walkA (m - 1)
      else if k % 5 == 1 then walkA (m - 1)
      else if k % 7 == 2 then walkA (m - 1)
      else if k % 11 == 3 then walkA (m - 1)
      else if k % 13 == 4 then walkA (m - 1)
      else walkA (m - 1)

walked : List Int
walked = List.map walkA [0, 1, 2, 3, 10, 1000]

-- (arities 1, 2 and 3, round one way)
triA : Int -> Int
triA n =
  if n == 0 then 0
  else if n % 3 == 0 then triB (n - 1) (n * 3)
  else if n % 5 == 0 then triB (n - 1) (n * 5)
  else if n % 7 == 0 then triB (n - 1) (n * 7)
  else if n % 11 == 0 then triB (n - 1) (n * 11)
  else if n % 13 == 0 then triB (n - 1) (n * 13)
  else triB (n - 1) n
  where
    triC : Int -> Int -> Int -> Int
    triC p a b =
      if p == 0 then a + b
      else if a % 3 == b % 3 then triA (p - 1)
      else if a % 5 == b % 5 then triA (p - 1)
      else if a % 7 == b % 7 then triA (p - 1)
      else if a % 11 == b % 11 then triA (p - 1)
      else if a % 13 == b % 13 then triA (p - 1)
      else triA (p - 1)
    triB : Int -> Int -> Int
    triB m a =
      if m == 0 then a
      else if a % 3 == 0 then triC (m - 1) a (m * 3)
      else if a % 5 == 0 then triC (m - 1) a (m * 5)
      else if a % 7 == 0 then triC (m - 1) a (m * 7)
      else if a % 11 == 0 then triC (m - 1) a (m * 11)
      else if a % 13 == 0 then triC (m - 1) a (m * 13)
      else triC (m - 1) a m

tried : List Int
tried = List.map triA [0, 1, 2, 5, 1000]

-- (numbers kept unboxed: a `Float64` given to one, the other's not)
floatA : Float64 -> Int -> Float64
floatA x n =
  if n == 0 then x
  else if n % 3 == 0 then floatB n (x * 0.5) (x + 1.0)
  else if n % 5 == 0 then floatB n (x * 0.25) (x + 2.0)
  else if n % 7 == 0 then floatB n (x * 0.125) (x + 3.0)
  else if n % 11 == 0 then floatB n (x * 0.0625) (x + 4.0)
  else floatB n (x * 0.75) (x - 1.0)
  where
    floatB : Int -> Float64 -> Float64 -> Float64
    floatB m a b =
      if a > b then floatA (a - b) (m - 1)
      else if a * 2.0 > b then floatA (b - a) (m - 1)
      else if a * 4.0 > b then floatA (a + b) (m - 1)
      else if a * 8.0 > b then floatA (b * 0.5) (m - 1)
      else floatA (a + 1.0) (m - 1)

floated : List Float64
floated = List.map (\n -> floatA 1.5 n) [0, 1, 2, 7, 500]

-- (an `Int64` kept unboxed, and a record read at its shape: what one is
-- not given, dropped as a record of it)
type Point = { x : Int64, y : Int64, z : Int64 }

pointA : Int64 -> Point -> Int64
pointA n p =
  if n == 0 then p.x + p.y + p.z
  else if n % 3 == 0 then pointB { x = p.y, y = p.z, z = p.x + n } (n - 1)
  else if n % 5 == 0 then pointB { x = p.z, y = p.x, z = p.y - n } (n - 1)
  else if n % 7 == 0 then pointB { x = p.x * 3, y = p.y, z = p.z } (n - 1)
  else pointB p (n - 1)
  where
    pointB : Point -> Int64 -> Int64
    pointB q m =
      if q.x > 1000000 then pointA m { x = q.x % 1000, y = q.y, z = q.z }
      else if q.y > 1000000 then pointA m { x = q.x, y = q.y % 1000, z = q.z }
      else if q.z < 0 - 1000000 then pointA m { x = q.x, y = q.y, z = 0 }
      else pointA m q

points : List Point
points = [{ x = 1, y = 2, z = 3 }, { x = 4000000, y = 0 - 5, z = 6 }]

pointed : List Int64
pointed =
  List.concatMap
    (\(p : Point) -> List.map (\n -> pointA n p) [0, 1, 2, 9, 1000])
    points

-- (one of them called not last, by the other, and a value)
countA : Int -> List Int -> Int
countA n xs =
  if n == 0 then List.length xs
  else if n % 4 == 0 then countB (n - 1)
  else if n % 4 == 1 then countA (n - 1) (Cons n xs)
  else if n % 9 == 2 then countB (n - 1) + countA (n - 1) xs
  else if n % 11 == 3 then countB (n - 1)
  else countA (n - 1) xs
  where
    countB : Int -> Int
    countB m =
      if m == 0 then 1
      else if m % 3 == 0 then countA (m - 1) [m]
      else if m % 5 == 0 then countA (m - 1) [m, m]
      else if m % 7 == 0 then countA (m - 1) Nil
      else countA (m - 1) [m, m, m]

counted : List Int
counted = List.map (\n -> countA n Nil) [0, 1, 5, 30]

counters : List (List Int -> Int)
counters = List.map countA [3, 4, 20]

countedBy : List Int
countedBy = List.map (\(f : List Int -> Int) -> f [1, 2]) counters
