-- A string's `\u{...}` and `\xff` escapes, each backend held to the
-- interpreter: the bytes each is made of (UTF-8, and a `\xff` a byte
-- of no rune), the runes read back, and the string itself where it
-- shows the same on every backend.

import rune as Rune

texts : Unit -> List String
texts _ =
  [ "\u{41}\u{62}"
  , "\u{e9}t\u{E9}"
  , "\u{4e2d}\u{6587}"
  , "\u{1F600}"
  , "a\u{10FFFF}z"
  , "\u{0}\u{1b}\u{7f}"
  , "\u\u{}\u{41"
  , "\u{5c}\u{22}\\\""
  , "\xc3\xa9\xff\x41\x4"
  ]

bytesIn : String -> List Int
bytesIn s = List.map (\i -> strByteAt s i) (List.range 0 (strLength s - 1))

textBytes : List (List Int)
textBytes = List.map bytesIn (texts MkUnit)

lengths : List Int
lengths = List.map strLength (texts MkUnit)

runeCodes : List (List Int)
runeCodes = List.map (\s -> List.map Rune.toInt (runes s)) (texts MkUnit)

letters : String
letters = "\u{41}\u{62}\u{e9}"

grin : String
grin = "x\u{1F600}y"

same : Bool
same =
  strEq "\u{1F600}" "😀"
  && strEq "\u{e9}" "é"
  && strEq "\xf0\x9f\x98\x80" "😀"

bytes : String
bytes = "a\xffb\xe2\x82\xac\xe2\x82"
