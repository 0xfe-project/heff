-- A string's `\u{...}` escapes, each backend held to the interpreter:
-- the code units each is made of (UTF-16, a surrogate pair beyond
-- U+FFFF), the runes read back, and the string itself where it shows
-- the same on every backend.

import rune as R

texts : Unit -> List String
texts _ =
  [ "\u{41}\u{62}"
  , "\u{e9}t\u{E9}"
  , "\u{4e2d}\u{6587}"
  , "\u{1F600}"
  , "a\u{10FFFF}z"
  , "\u{0}\u{1b}\u{7f}"
  , "\u\u{}\u{41"
  , "\u{5c}\u{22}\\\""
  ]

units : String -> List Int
units s = List.map (\i -> strCharCode s i) (List.range 0 (strLength s - 1))

unitsOf : List (List Int)
unitsOf = List.map units (texts MkUnit)

lengths : List Int
lengths = List.map strLength (texts MkUnit)

runeCodes : List (List Int)
runeCodes = List.map (\s -> List.map R.toInt (runes s)) (texts MkUnit)

letters : String
letters = "\u{41}\u{62}\u{e9}"

grin : String
grin = "x\u{1F600}y"

same : Bool
same = strEq "\u{1F600}" "😀" && strEq "\u{e9}" "é"
