-- Maps and sets, compiled as the interpreter computes them.

module test.programs.ordmaps

import std.ordmap as OrdMap
import std.set as Set

many : OrdMap.OrdMap Int Int
many =
  OrdMap.fromList
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 5000))

fewer : OrdMap.OrdMap Int Int
fewer = List.foldl (\m k -> OrdMap.delete m k) many (List.range 0 5000)

sizes : List Int
sizes = [OrdMap.size many, OrdMap.size fewer]

valid : Bool
valid = OrdMap.valid many && OrdMap.valid fewer

found : Maybe Int
found = OrdMap.lookup many 7919

words : List String
words = Set.toList (Set.fromList (split " " "the cat the hat a cat"))

-- (a word's count, by one walk down the tree each; a key gone and
-- another bound, by `alter`)
counted : OrdMap.OrdMap String Int
counted =
  List.foldl
    (\m w -> OrdMap.update m w 1 (\new old -> new + old))
    OrdMap.empty
    (words' "the cat the hat a cat the end")
  where
  words' : String -> List String
  words' s = split " " s

altered : OrdMap.OrdMap Int Int
altered =
  List.foldl
    (\m k ->
       OrdMap.alter
         m
         k
         (\old ->
            if k % 3 == 0 then Nothing else Just (maybe k (\v -> v + k) old)))
    many
    (List.range 0 3000)

counts : List (Pair String Int)
counts = OrdMap.toList counted

alteredSize : Int
alteredSize = OrdMap.size altered

alteredValid : Bool
alteredValid =
  OrdMap.valid altered
  && OrdMap.valid counted

-- (strings found in strings, and ordered at once)
finds : List (Maybe Int)
finds =
  [ indexOf "at" "the cat the hat" 0
  , indexOf "at" "the cat the hat" 6
  , indexOf "" "ab" 2
  , indexOf "ab" "ab" 1
  , indexOf "\u{e9}t\u{e9}" "\u{e9}t\u{e9}" 0
  ]

pieces : List String
pieces = List.append (lines "one\ntwo\n\nthree") (split "--" "a--b----c")

orders : List Ordering
orders =
  List.map
    (\p -> compareString (fst p) (snd p))
    [ MkPair "abcdefgh1" "abcdefgh2"
    , MkPair "abcdefgh" "abcdefgh"
    , MkPair "abcdefghij" "abcdefgh"
    , MkPair "z" "\u{e9}"
    , MkPair "" "a"
    ]
