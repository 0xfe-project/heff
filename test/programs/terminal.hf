-- std.terminal.widget and std.cli.interactive, pure: what keys typed
-- at a terminal are read as, what the widgets make of them, and what an
-- app shows after them -- the commands of a program picked, filtered and
-- filled in -- the same on every backend.

module test.programs.terminal

import rune as Rune
import std.cli as CLI
import std.cli.interactive as Interactive
import std.terminal.widget as Widget

size : Widget.Size
size = { columns = 48, rows = 12 }

commands : List (CLI.Command String)
commands = CLI.commandsEx

app : Widget.App Interactive.Model Interactive.Result
app = Interactive.app "heff" (Interactive.entries commands)

-- (a key, named: a rune by its code, an escape sequence without its
-- ESC, so that each backend shows it alike)
named : Widget.Key -> String
named (Char c) = "Char " ^ show (Rune.toInt c)
named (Control c) = "Control " ^ show (Rune.toInt c)
named (Sequence s) = "Sequence " ^ strSlice s 1 (strLength s)
named Enter = "Enter"
named Escape = "Escape"
named Tab = "Tab"
named BackTab = "BackTab"
named Backspace = "Backspace"
named Delete = "Delete"
named ArrowUp = "ArrowUp"
named ArrowDown = "ArrowDown"
named ArrowLeft = "ArrowLeft"
named ArrowRight = "ArrowRight"
named Home = "Home"
named End = "End"
named PageUp = "PageUp"
named PageDown = "PageDown"

-- (the keys of a terminal's input, as typed)
keys : List String
keys =
  List.map
    named
    (Widget.decode
       "jk\r\t\u{1b}\u{1b}[A\u{1b}[B\u{1b}[C\u{1b}[D\u{1b}OH\u{1b}[F\u{1b}[5~\u{1b}[6~\u{1b}[3~\u{1b}[Z\u{7f}\u{3}\u{1b}[2J中")

-- (a field typed in: runes at the cursor, moved, deleted, words gone)
typed : List String
typed =
  List.map
    (\s ->
       Widget.fieldText
         (List.foldl
            (\f k -> Widget.fieldKey k f)
            (Widget.field "")
            (Widget.decode s)))
    [ "abc\u{1b}[D\u{1b}[DX"
    , "hello world\u{17}"
    , "hello\u{1}\u{1b}[3~J"
    , "one two\u{1b}[H\u{b}"
    , "x\u{7f}\u{7f}y"
    ]

-- (a choice turned, either way, round)
turned : List String
turned =
  List.map
    (\s ->
       Widget.chosen
         (List.foldl
            (\c k -> Widget.choiceKey k c)
            (Widget.choice ["esm", "page", "c"])
            (Widget.decode s)))
    ["", "\u{1b}[C", " l", "\u{1b}[D", "h"]

-- (a list's selection moved, and the rows it shows, scrolled)
menuShown : List String
menuShown =
  List.map
    Widget.rowText
    (Widget.menuRows
       3
       (List.foldl
          (\m k -> Widget.menuKey 6 k m)
          Widget.menu
          (Widget.decode "\u{1b}[B\u{1b}[B\u{1b}[B\u{1b}[B"))
       (List.map (\s -> [Widget.plain s]) ["a", "b", "c", "d", "e", "f"]))

-- (ESC written `^[`, so that each backend shows it alike)
visible : String -> String
visible s = joinWith "^[" (split "\u{1b}" s)

painted : String
painted =
  visible
    (Widget.paint
       { columns = 6, rows = 3 }
       { rows =
           [ [Widget.bold "wide 中文字", Widget.plain "!"]
           , Widget.status 6 "ok"
           , [Widget.dim "x"]
           , [Widget.plain "cut"]
           ]
       , cursor = Just (MkPair 2 1)
       })

-- (the app: the list, moved, filtered; a form opened, filled in, its
-- command line; what it comes to)
first : List String
first = Widget.shownAfter app size Nil

moved : List String
moved = Widget.shownAfter app size (Widget.decode "j")

filtered : List String
filtered = Widget.shownAfter app size (Widget.decode "co")

none : List String
none = Widget.shownAfter app size (Widget.decode "zz")

slashed : List String
slashed = Widget.shownAfter app size (Widget.decode "/j")

cleared : List String
cleared = Widget.shownAfter app size (Widget.decode "co\u{1b}")

form : List String
form = Widget.shownAfter app size (Widget.decode "\r")

filled : List String
filled =
  Widget.shownAfter app size (Widget.decode "\ra.hf\tout dir\t\t\u{1b}[C")

back : List String
back = Widget.shownAfter app size (Widget.decode "\ra.hf\u{1b}")

chosen : Either Interactive.Model Interactive.Result
chosen = Widget.replay app (Widget.decode "\ra.hf\ta.mjs\tmain\t\u{1b}[C\r")

-- (Enter on a form something is wrong with yet: still the form)
stillLeft : Either Interactive.Model Interactive.Result -> Bool
stillLeft (Left m) = True
stillLeft (Right r) = False

notYet : Bool
notYet = stillLeft (Widget.replay app (Widget.decode "\ra.hf\r"))

dashed : Either Interactive.Model Interactive.Result
dashed = Widget.replay app (Widget.decode "j\r-x.hf\tone -two\r")

quit : Either Interactive.Model Interactive.Result
quit = Widget.replay app (Widget.decode "q")

escaped : Either Interactive.Model Interactive.Result
escaped = Widget.replay app (Widget.decode "\u{1b}")

line : String
line = Interactive.commandLine "heff" "run" ["main.hf", "two words", "it's", ""]
