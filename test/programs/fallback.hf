-- A default case standing for many tags: compiled once, not copied into
-- the case of each tag it stands for (#123).  `step` tests one tag of
-- fifty in a nested pattern, the rest falling through to an equation
-- whose body is big; the tags falling through are tags of no field and
-- of fields, built elsewhere and matched there, and built where the
-- match is (its tag known).

module test.programs.fallback

data K
  = K0
  | K1
  | K2
  | K3
  | K4
  | K5
  | K6
  | K7
  | K8
  | K9
  | K10
  | K11
  | K12
  | K13
  | K14
  | K15
  | K16
  | K17
  | K18
  | K19
  | K20
  | K21
  | K22
  | K23
  | K24
  | K25
  | K26
  | K27
  | K28
  | K29
  | K30
  | K31
  | K32
  | K33
  | K34
  | K35
  | K36
  | K37
  | K38
  | K39
  | K40
  | K41
  | K42
  | K43
  | K44
  | K45
  | K46
  | K47
  | K48
  | K49

data E = Op K (List Int) | Lit Int | Neg E | Two E E

fallback : E -> Int
fallback (Lit n) = n * 3 + 1
fallback (Neg e) = 0 - 1
fallback (Op k xs) = List.length xs
fallback (Two a b) = 7

step : E -> Int
step (Op K7 (Cons a (Cons b Nil))) = a + b
step e =
  fallback e
  + fallback e * 2
  + fallback e * 3
  + fallback e * 4
  + List.length [1, 2, 3, 4]
  + fallback (Two e (Neg e)) * fallback (Neg (Two e e))

stepped : List Int
stepped =
  List.map
    step
    [ Op K7 [1, 2]
    , Op K7 [1]
    , Op K3 Nil
    , Op K49 [4, 5, 6]
    , Lit 4
    , Neg (Lit 1)
    , Two (Lit 1) (Op K0 Nil)
    ]

-- (a tag of fields, built where it is matched, falling through)
known : Int -> Int
known n = case (Two (Lit n) (Op K1 [n]) : E) of
  Op K7 _ -> 0
  e ->
    fallback e
    + fallback e * n
    + fallback e * 3
    + List.length [n, n + 1, n + 2, n + 3]
    + fallback (Two e (Neg e)) * fallback (Neg (Two e e))

knownValue : Int
knownValue = known 5

-- (the default keeps what it matched, whole)
kept : E -> E
kept (Op K7 xs) = Lit (List.length xs)
kept e =
  Two
    (Neg e)
    (Two
       (Two e (Neg (Neg e)))
       (Two (Two (Lit 1) e) (Two (Neg e) (Two e (Two e (Neg (Two e e)))))))

keptValues : List Int
keptValues =
  List.map
    (\e -> fallback (kept e))
    [Op K7 [1, 2], Op K8 [1], Two (Lit 2) (Lit 3)]

-- (two of the fifty named, the rest by a default small enough to be
-- copied)
named : K -> String
named K0 = "first"
named K49 = "last"
named _ = "between"

names : List String
names = List.map named [K0, K1, K25, K48, K49]
