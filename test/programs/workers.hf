-- Workers and wrappers (#39): a function taking or giving a fixed-width
-- integer or a `Float64` is called, where the call is known, by its C
-- worker, the number unboxed; from a closure, through its wrapper.  Each
-- backend held to the interpreter: workers calling workers, round a
-- cycle too, a function given as a value, given some of its arguments,
-- numbers and `V`s mixed, a `Float64` given back, beyond 62 bits across
-- calls.  (A value of one is shown as a string: a number does not say
-- its type, where a backend shows it.)

import int64 as Int64
import int8 as Int8
import uint64 as UInt64

bool : Bool -> String
bool True = "T"
bool False = "F"

-- Workers calling workers
--------------------------------------------------------------------------------

-- (a SWAR popcount and a bit reversal: #39's int64-bits)
popcount : UInt64 -> UInt64
popcount x =
  let a = x - and (shiftR x 1) 0x5555555555555555 in
  let b = and a 0x3333333333333333 + and (shiftR a 2) 0x3333333333333333 in
  let c = and (b + shiftR b 4) 0x0F0F0F0F0F0F0F0F in
  shiftR (c * 0x0101010101010101) 56

reverse : UInt64 -> UInt64
reverse x0 =
  let x1 = or (shiftR (and x0 0xAAAAAAAAAAAAAAAA) 1) (shiftL (and x0 0x5555555555555555) 1) in
  let x2 = or (shiftR (and x1 0xCCCCCCCCCCCCCCCC) 2) (shiftL (and x1 0x3333333333333333) 2) in
  let x3 = or (shiftR (and x2 0xF0F0F0F0F0F0F0F0) 4) (shiftL (and x2 0x0F0F0F0F0F0F0F0F) 4) in
  let x4 = or (shiftR (and x3 0xFF00FF00FF00FF00) 8) (shiftL (and x3 0x00FF00FF00FF00FF) 8) in
  let x5 = or (shiftR (and x4 0xFFFF0000FFFF0000) 16) (shiftL (and x4 0x0000FFFF0000FFFF) 16) in
  or (shiftR x5 32) (shiftL x5 32)

-- (a worker given what another gives, and giving it on)
twiceReversed : UInt64 -> UInt64
twiceReversed x = reverse (reverse x)

bits : UInt64 -> Int -> UInt64 -> UInt64 -> String
bits x n pop h =
  if n == 0 then UInt64.show pop ^ " " ^ UInt64.show h
  else
    let y = xor (xor x (shiftL x 13)) (shiftR (xor x (shiftL x 13)) 7) in
    bits y (n - 1) (pop + popcount y) (xor (h * 31) (reverse y))

counted : String
counted = bits 88172645463325252 2000 0 0

-- (beyond 62 bits, given and given back)
wide : String
wide =
  UInt64.show (reverse 1)
  ^ " "
  ^ UInt64.show (twiceReversed 0xFFFFFFFFFFFFFFFE)
  ^ " "
  ^ UInt64.show (popcount UInt64.maxBound)
  ^ " "
  ^ UInt64.show (reverse 0x8000000000000001)

-- (round a cycle, called last: one signature, a jump; test/node/deep.hf
-- has one a million deep)
isEven : Int64 -> Bool
isEven n = if n == 0 then True else isOdd (n - 1)
  where
    isOdd : Int64 -> Bool
    isOdd m = if m == 0 then False else isEven (m - 1)

evens : String
evens = bool (isEven 100000) ^ bool (isEven 99999)

-- (round a cycle, one taking a number the other keeps in a list: one
-- signature for both, the number a `V`)
ping : UInt64 -> Int -> List UInt64 -> UInt64
ping x n acc =
  if n == 0 then x + List.foldl (\s y -> s + y) 0 acc
  else pong (x * 3 + 1) (n - 1) acc
  where
    pong : UInt64 -> Int -> List UInt64 -> UInt64
    pong y m ys = ping y (m - 1) (if m % 1000 == 0 then y :: ys else ys)

pinged : String
pinged = UInt64.show (ping 7 100000 Nil)

-- (round a cycle, not last)
collatz : Int64 -> Int64
collatz n = if n <= 1 then 0 else 1 + step n
  where
    step : Int64 -> Int64
    step m = if m % 2 == 0 then collatz (m / 2) else collatz (3 * m + 1)

steps : String
steps = Int64.show (collatz 27) ^ " " ^ Int64.show (collatz 837799)

-- (round a cycle, each giving back what the other gives: unboxed only
-- from a hope (#64), last and not)
sumDown : Int64 -> Int64 -> Int64
sumDown n acc =
  if n == 0 then acc
  else if n % 2 == 0 then sumUp (n - 1) (acc + n)
  else sumUp (n - 1) (xor acc n)
  where
    sumUp : Int64 -> Int64 -> Int64
    sumUp m a =
      if m == 0 then a
      else if m % 3 == 0 then sumDown (m - 1) (a * 3)
      else sumDown (m - 1) (a - m)

drift : Float64 -> Int -> Float64
drift x n =
  if n == 0 then x
  else if n % 2 == 0 then 1.0 + sway (x * 0.5) (n - 1)
  else sway (x + 0.25) (n - 1)
  where
    sway : Float64 -> Int -> Float64
    sway y m =
      if m == 0 then y
      else if m % 3 == 0 then drift (y * 1.5) (m - 1)
      else drift (y - 0.125) (m - 1)

hoped : String
hoped =
  Int64.show (sumDown 2001 5)
  ^ " "
  ^ Int64.show (sumDown 1000 0x7FFFFFFFFFFFFF00)
  ^ " "
  ^ showFloat (drift 1000.0 41)

-- A function as a value, and given some of its arguments
--------------------------------------------------------------------------------

counts : String
counts =
  joinWith
    ","
    (List.map (\x -> UInt64.show x) (List.map popcount [0, 1, 0xFF, UInt64.maxBound]))

axpy : Int64 -> Int64 -> Int64 -> Int64
axpy a x y = a * x + y

partial : String
partial =
  joinWith
    ","
    (List.map
       (\x -> Int64.show x)
       (List.zipWith (axpy 9223372036854775807) [1, 2, 3] [0, 1, -1]))

-- (applied by what it is handed to)
applyTo : (UInt64 -> UInt64) -> UInt64 -> UInt64
applyTo f x = f (f x)

handed : String
handed = UInt64.show (applyTo reverse 3) ^ " " ^ UInt64.show (applyTo popcount 0xFFFF)

-- (giving back what a function given it gives: a bounce, a `V`)
bump : (Int64 -> String) -> Int64 -> String
bump k n = k (n * 2 + 1)

bumped : String
bumped = bump (\n -> Int64.show (n * n)) 3037000499

-- Numbers and `V`s mixed, a `Float64` given back
--------------------------------------------------------------------------------

norm : Float64 -> Float64 -> Float64
norm x y = floatSqrt (x * x + y * y)

scaled : Float64 -> List Float64 -> Int8 -> String -> Float64
scaled k xs n tag =
  if strEq tag "neg" then 0.0 - k * List.foldl (\s x -> s + x) 0.0 xs
  else k * toFloat (Int8.toInt n) + norm k (List.foldl (\s x -> s + x) 0.0 xs)

mixedArgs : String
mixedArgs =
  showFloat (scaled 1.5 [1.0, 2.0, 0.25] 120 "pos")
  ^ " "
  ^ showFloat (scaled 2.0 [3.0] (-128) "neg")
  ^ " "
  ^ showFloat (norm 3.0 4.0)

-- (a `Float64` given back, through a loop and a record)
type Body = { x : Float64, v : Float64, name : String }

advance : Body -> Float64 -> Int -> Body
advance b dt n =
  if n == 0 then b
  else advance { x = b.x + b.v * dt, v = b.v - b.x * dt, name = b.name } dt (n - 1)

energy : Body -> Float64
energy b = 0.5 * (b.x * b.x + b.v * b.v)

energies : String
energies = showFloat (energy (advance { x = 1.0, v = 0.0, name = "o" } 0.001 1000))

-- (a `Float64` given back by every arm, one of them a field)
pick : Int -> Body -> Float64
pick 0 b = b.x
pick 1 b = b.v
pick n b = toFloat n

picked : String
picked =
  showFloat (pick 0 { x = 0.5, v = 1.5, name = "p" })
  ^ " "
  ^ showFloat (pick 1 { x = 0.5, v = 1.5, name = "p" })
  ^ " "
  ^ showFloat (pick 7 { x = 0.5, v = 1.5, name = "p" })

-- (a generic function, given numbers of two types: no worker of its own)
both : {a : Type} -> (a -> a -> a) -> a -> a -> a
both f x y = f (f x y) y

generic : String
generic =
  Int64.show (both (\a b -> a * b + 1) 3 4)
  ^ " "
  ^ showFloat (both (\a b -> a * b + 0.5) 1.5 4.0)
  ^ " "
  ^ bool (floatEq (norm (floatDiv 0.0 0.0) 1.0) (norm (floatDiv 0.0 0.0) 1.0))
