-- Records carried round a loop (#81): a loop whose record parameter is
-- given a record built at each call of itself is given a worker carrying
-- the fields instead, the record built where the loop ends.  Each backend
-- held to the interpreter: numbers kept flat, fields of any type, the
-- record passed on as it is, given back whole and in a tag, two records
-- at once, a field read in a lambda, the wrapper called as a closure, and
-- loops that are left as they are (the record used whole on the way, a
-- call of itself not last).

module test.programs.scalars

type Acc = { s : Float64, c : Float64, n : Int }

type Named = { name : String, items : List Int, total : Int }

type Point = { x : Int, y : Int }

-- (numbers kept flat, the record given back whole)
sum : Int -> Acc -> Acc
sum k a =
  if k == 0 then a
  else sum (k - 1) { s = a.s + a.c * 0.5, c = a.c * 0.75 + 1.0, n = a.n + 1 }

summed : String
summed = case sum 20 { s = 0.0, c = 1.0, n = 0 } of
  a -> debug a.s ^ " " ^ debug a.c ^ " " ^ showInt a.n

-- (fields of any type, the record passed on as it is where nothing
-- changes)
collect : List Int -> Named -> Named
collect [] r = r
collect (x :: xs) r =
  if x < 0 then collect xs r
  else collect
      xs
      { name = r.name ^ showInt x, items = x :: r.items, total = r.total + x }

collected : String
collected = case collect
    [3, -1, 4, -1, 5, 9]
    { name = "n", items = Nil, total = 0 } of
  r ->
    r.name
    ^ " "
    ^ joinWith "," (List.map showInt r.items)
    ^ " "
    ^ showInt r.total

-- (given back in a tag, where the loop ends)
walk : Int -> Point -> Maybe Point
walk k p =
  if p.x > 100 then Nothing
  else if k == 0 then Just p
  else walk (k - 1) { x = p.x + p.y, y = p.y + 1 }

pointShow : Maybe Point -> String
pointShow Nothing = "N"
pointShow (Just p) = showInt p.x ^ "," ^ showInt p.y

walked : String
walked =
  pointShow (walk 5 { x = 0, y = 1 })
  ^ " "
  ^ pointShow (walk 50 { x = 0, y = 1 })

-- (two records at once, one of them only read)
steps : Int -> Point -> Point -> Int
steps k a b =
  if k == 0 then a.x * 1000 + a.y * 100 + b.x * 10 + b.y
  else steps (k - 1) { x = a.y, y = a.x + b.x } { x = b.y, y = b.x }

stepped : String
stepped = showInt (steps 7 { x = 1, y = 2 } { x = 3, y = 4 })

-- (a field read in a lambda in the loop)
scaled : List Int -> Point -> Point
scaled [] p = p
scaled (x :: xs) p =
  scaled
    xs
    { x = List.foldl (\a b -> a + b * p.y) p.x [x, x], y = p.y + 1 }

scaledShow : String
scaledShow = case scaled [1, 2, 3] { x = 0, y = 1 } of
  p -> showInt p.x ^ "," ^ showInt p.y

-- (the wrapper, called by a closure)
closures : String
closures =
  joinWith
    " "
    (List.map
       (\k -> showInt (sum k { s = 0.0, c = 2.0, n = 10 }).n)
       [0, 1, 5])

-- (left as it is: the record used whole on the way round)
kept : Int -> Point -> List Point -> List Point
kept k p acc =
  if k == 0 then acc else kept (k - 1) { x = p.x + 1, y = p.y * 2 } (p :: acc)

keptShow : String
keptShow =
  joinWith
    " "
    (List.map
       (\(p : Point) -> showInt p.x ^ "," ^ showInt p.y)
       (kept 4 { x = 0, y = 1 } Nil))

-- (left as it is: a call of itself not last)
depth : Int -> Point -> Int
depth k p =
  if k == 0 then p.x + p.y else 1 + depth (k - 1) { x = p.y, y = p.x + 1 }

deep : String
deep = showInt (depth 6 { x = 2, y = 3 })
