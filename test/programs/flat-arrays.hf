-- Arrays of numbers the C backend keeps flat (#61): built knowing the
-- element's type (a literal, an unboxed variable), built of `Float64`s
-- by code that does not know it, and of other numbers so (their `V`s
-- kept); read and set where the type is known and where it is not; set
-- in place where nothing else holds the array, and copied where it is
-- shared, the shared one as it was; sliced, appended (flat to `V`s),
-- reversed, swapped, filled, modified, folded and sorted.  Each backend
-- held to the interpreter.

module test.programs.flat-arrays

import array as Array
import int8 as Int8
import int64 as Int64
import uint8 as UInt8
import uint64 as UInt64
import float32 as Float32

-- (generic: the element's type not known)
second : {a : Type} -> Array a -> a
second xs = arrayIndex xs 1

putFirst : {a : Type} -> Array a -> a -> Array a
putFirst xs x = Array.set xs 0 x

floats : Array Float64
floats = Array.replicate 4 0.5

-- (a loop threading the array, each round's set in place)
scaleFrom : Int -> Float64 -> Array Float64 -> Array Float64
scaleFrom i k xs =
  if i >= Array.length xs then xs
  else scaleFrom (i + 1) k (Array.set xs i (arrayIndex xs i * k + toFloat i))

sumFrom : Int -> Float64 -> Array Float64 -> Float64
sumFrom i acc xs =
  if i >= Array.length xs then acc
  else sumFrom (i + 1) (acc + arrayIndex xs i) xs

scaled : Array Float64
scaled = scaleFrom 0 3.0 (Array.replicate 6 1.25)

scaledSum : Float64
scaledSum = sumFrom 0 0.0 scaled

-- (built by code that does not know them `Float64`s)
generated : Array Float64
generated = Array.generate 5 (\i -> toFloat i * 0.25)

generatedSum : Float64
generatedSum = sumFrom 0 0.0 generated

listed : Array Float64
listed = Array.fromList [1.5, -0.0, 2.5]

genericRead : Float64
genericRead = second listed + second generated

genericSet : Array Float64
genericSet = putFirst listed 9.75

-- (shared: `floats` is as it was)
shared : Pair (Array Float64) (Array Float64)
shared = MkPair floats (Array.set floats 2 7.0)

bigs : Array Int64
bigs = Array.replicate 3 (Int64.fromInt 4611686018427387903 * 2)

bigsSet : Array Int64
bigsSet = Array.set bigs 1 (Int64.fromInt -9223372036854775807 - 1)

bigsRead : Int64
bigsRead = arrayIndex bigsSet 0 + arrayIndex bigsSet 1

-- (`Int64`s built where their type is not known: `V`s, read and set
-- where it is)
boxedBigs : Array Int64
boxedBigs = Array.generate 3 (\i -> Int64.fromInt (i * 1000000007))

boxedRead : Int64
boxedRead = arrayIndex boxedBigs 2 * 3

boxedSet : Array Int64
boxedSet = Array.set boxedBigs 0 (arrayIndex boxedBigs 1 + Int64.fromInt 1)

mixed : Array Int64
mixed = Array.append boxedBigs bigsSet

mixedOther : Array Int64
mixedOther = Array.append bigs boxedBigs

unsigned : Array UInt64
unsigned = Array.set (Array.replicate 2 (UInt64.fromInt 1)) 1 (UInt64.fromInt -1)

-- (functions, so that no backend shows them: JavaScript shows a `UInt8`
-- as a float, C a `Float32` as its bits)
bytesArray : Int -> Array UInt8
bytesArray n = Array.set (Array.replicate n (UInt8.fromInt 200)) 3 (UInt8.fromInt 300)

-- (each as an `Int`: a `UInt8` is shown as a float by JavaScript's)
bytes : List Int
bytes = List.map UInt8.toInt (Array.toList (bytesArray 5))

bytesSum : Int
bytesSum = Array.foldl (\s b -> s + UInt8.toInt b) 0 (bytesArray 5)

signed : List Int
signed =
  List.map
    Int8.toInt
    (Array.toList (Array.modify (Array.replicate 3 (Int8.fromInt -100)) 1 (\x -> x - Int8.fromInt 100)))

halvesArray : Int -> Array Float32
halvesArray n = Array.set (Array.replicate n (Float32.fromFloat 0.5)) 2 (Float32.fromFloat 1.25)

halvesSum : Float64
halvesSum = Array.foldl (\s x -> s + Float32.toFloat x) 0.0 (halvesArray 3)

halves : List Float64
halves = List.map Float32.toFloat (Array.toList (halvesArray 3))

sliced : List Int
sliced = List.map UInt8.toInt (Array.toList (Array.slice (bytesArray 5) 1 -1))

reversed : Array Float64
reversed = Array.reverse scaled

swapped : Array Int64
swapped = Array.swap bigsSet 0 2

filled : Array Float64
filled = Array.fill (Array.replicate 3 2.0) 0.25

folded : List Float64
folded = Array.foldr (\x acc -> Cons x acc) Nil generated

sorted : Array Float64
sorted = Array.sortBy (\a b -> a <= b) (Array.fromList [3.5, -1.0, 2.25, 0.0])

sortedBytes : List Int
sortedBytes = List.map UInt8.toInt (Array.toList (Array.sortBy (\a b -> a <= b) (bytesArray 5)))

nothingFlat : Int
nothingFlat = Array.length (Array.replicate 0 1.5)

appendedEmpty : Array Float64
appendedEmpty = Array.append (Array.fromList []) floats

-- (a sieve, over bytes, set in place)
crossFrom : Int -> Int -> Int -> Array UInt8 -> Array UInt8
crossFrom n p j xs =
  if j >= n then xs
  else crossFrom n p (j + p) (Array.set xs j (UInt8.fromInt 0))

sieveFrom : Int -> Int -> Array UInt8 -> Array UInt8
sieveFrom n p xs =
  if p * p >= n then xs
  else if arrayIndex xs p == UInt8.fromInt 1 then sieveFrom n (p + 1) (crossFrom n p (p * p) xs)
  else sieveFrom n (p + 1) xs

primes : Int
primes =
  Array.foldl
    (\c b -> c + UInt8.toInt b)
    0
    (sieveFrom 1000 2 (Array.set (Array.set (Array.replicate 1000 (UInt8.fromInt 1)) 0 (UInt8.fromInt 0)) 1 (UInt8.fromInt 0)))

nested : Array (Array Float64)
nested = Array.generate 2 (\i -> Array.replicate i (toFloat i))
