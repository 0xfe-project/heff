data Bool = 'true | 'false

data List (A :: Type) = 'nil | 'cons A (List A)

id :: {A :: Type} -> (x :: A) -> A
id x = x

map :: {A B :: Type} -> (f :: A -> B) -> (xs :: List A) -> List B
map f 'nil = 'nil
map f ('cons y ys) = 'cons (f y) (map (A := A) (B := B) f ys)

not :: (b :: Bool) -> Bool
not 'true = 'false
not 'false = 'true

flipped :: List Bool
flipped = map (A := Bool) (B := Bool) not ('cons 'true ('cons 'false 'nil))

same :: Bool
same = id (A := Bool) 'true

explicit :: List Bool
explicit = map (A := Bool) (B := Bool) not 'nil

compose :: {A B C :: Type} -> (g :: B -> C) -> (f :: A -> B) -> (x :: A) -> C
compose g f x = g (f x)

twice :: Bool
twice = compose (A := Bool) (B := Bool) (C := Bool) not not 'false

data Option (A :: Type) = 'none | 'some A

theory Monoid where
  t :: Type
  unit :: t
  op :: t -> t -> t

mconcat :: {M :: Monoid} -> (xs :: List M.t) -> M.t
mconcat 'nil = M.unit
mconcat ('cons y ys) = M.op y (mconcat (M := M) ys)

Or :: Monoid
Or = { t = Bool, unit = 'false, op = \x y -> case x of
  'true -> 'true
  'false -> y }

anyTrue :: Bool
anyTrue = mconcat (M := Or) ('cons 'false ('cons 'true 'nil))

lamImplicit :: {A :: Type} -> A -> A
lamImplicit x = x

insertedLam :: {A :: Type} -> A -> A
insertedLam x = x

