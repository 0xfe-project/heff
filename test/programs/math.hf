-- std.math, compiled as the interpreter computes it.  Where JavaScript's
-- `Math` and C's libm may differ in a float's last place (`tan 1.0` and
-- `acos 0.5` do), a value is shown to 9 places, where they agree; where
-- they cannot differ, it is the float itself.

import std.math

-- (at least 9 digits: zeros before them)
pad9 : String -> String
pad9 s = if strLength s < 9 then pad9 ("0" ^ s) else s

-- (billionths, not below 0, written as a number of 9 places)
billionths : Int -> String
billionths n = show (n / 1000000000) ^ "." ^ pad9 (show (n % 1000000000))

-- (a float to 9 places)
places : Float64 -> String
places x =
  if x < 0.0 then "-" ^ billionths (round (0.0 - x * 1.0e9))
  else billionths (round (x * 1.0e9))

constants : List Float64
constants = [pi, e]

zeros : List Float64
zeros = [sin 0.0, tan 0.0, acos 1.0, atan 0.0, atan2 0.0 1.0, log 1.0]

ones : List Float64
ones = [cos 0.0, exp 0.0, log e, pow 5.0 0.0, pow 1.0 (0.0 /. 0.0), pow (-1.0) (1.0 /. 0.0)]

powers : List Float64
powers = [pow 2.0 10.0, pow 2.0 (-1.0), pow 4.0 0.5, pow (-2.0) 3.0]

beyond : List Float64
beyond = [log 0.0, log (-1.0), asin 2.0, sin (1.0 /. 0.0), exp 1000.0, exp (-1000.0)]

trig : List String
trig = List.map places [sin 1.0, cos 1.0, tan 1.0, sin 2.0, cos pi, tan (pi /. 4.0), sin (-0.5)]

inverses : List String
inverses = List.map places [asin 0.5, acos 0.5, atan 0.5, atan2 1.0 (-1.0), atan2 (-1.0) (-1.0)]

exponentials : List String
exponentials = List.map places [exp 1.0, exp 10.0, exp (-1.0), log 10.0, log 0.5, pow 1.5 2.5, pow 10.0 0.5]

wholes : List Int
wholes = [ceil 2.1, ceil (-2.9), ceil 3.0, round 2.5, round (-2.5), round 2.4999, round 0.49999999999999994, round (-0.4)]

signs : List Float64
signs = [abs (-2.5), abs 0.0, abs 3.0, minFloat 1.5 (-2.0), maxFloat 1.5 (-2.0)]

-- (what is not finite has no whole number)
infinite : Int
infinite = round (1.0 /. 0.0)
