-- A parameter lent though the function calls itself under a lambda,
-- given there a value the lambda made: no loop of the function's own,
-- the value dropped after the call.  Each backend held to the
-- interpreter.

module test.programs.lent-loops

-- (a list matched alone; called again under a lambda, given a list built
-- there)
nest : List (List Int) -> Int
nest [] = 0
nest (xs :: rest) =
  List.sum
    (List.map
       (\x -> x + nest (List.map (\ys -> List.map (\z -> z + x) ys) rest))
       xs)

nested : Int
nested = nest [[1, 2], [3], [4, 5]]

-- (a string only measured; called again under a lambda, given a string
-- made there)
grow : String -> List Int -> Int
grow s [] = strLength s
grow s (k :: ks) =
  strLength s + k + List.sum (List.map (\j -> grow (showInt (j + k)) ks) ks)

grown : Int
grown = grow "ab" [1, 22, 333, 4444]
