-- Handlers of one effect said within the handler of the rest (`within`):
-- a sieve with a handler per prime, a query a handler cannot answer
-- handed on outward, each answer the same as by `through`; and a state
-- outside it, a get and a put passing through.  Each the same on every
-- backend as in the interpreter.

module test.programs.within

import co
import state

data PrimeF (m : Type -> Type) x = Prime Int (Bool -> x)

primeEffect : HFunctor
primeEffect =
  { f = PrimeF
  , hfmap = \m g p -> case p of
      Prime v k -> Prime v (\b -> g (k b))
  , hmap = \m n nt p -> case p of
      Prime v k -> Prime v k
  }

isPrime : {e : HFunctor} -> {{ev : primeEffect <: e}} -> Int -> Co e Bool
isPrime v = op (ev (Prime v (\b -> b))) val

-- (prime p's handler, within: a multiple of p is not prime, else asked
-- outward)
sieving : (e : HFunctor)
        -> {{ev : primeEffect <: e}}
        -> Int
        -> {a : Type}
        -> (hd : Handler e)
        -> PrimeF hd.M a
        -> hd.M a
sieving e p hd t = case t of
  Prime v k -> if v % p == 0 then hd.ret (k False) else hd.malg (ev t)

-- (the same, through)
passing : (e : HFunctor) -> {{ev : primeEffect <: e}} -> Int -> Handler (primeEffect <+> e)
passing e p =
  through primeEffect e (\t -> case t of
    Prime v k -> if v % p == 0 then val (k False) else bind (isPrime v) (\b -> val (k b)))

-- (the primes from `i` below `count`, summed onto `a`, a handler more for
-- each, said within or through)
primesWithin : {e : HFunctor} -> {{ev : primeEffect <: e}} -> Int -> Int -> Int -> Co e Int
primesWithin i count a =
  if i >= count then pure a
  else do
    b <- isPrime i
    if b then
        within
          primeEffect
          e
          (sieving e i)
          (primesWithin (ev := _) (i + 1) count (a + i))
      else primesWithin (i + 1) count a

primesThrough : {e : HFunctor} -> {{ev : primeEffect <: e}} -> Int -> Int -> Int -> Co e Int
primesThrough i count a =
  if i >= count then pure a
  else do
    b <- isPrime i
    if b then
        handle
          (passing e i)
          (primesThrough (ev := _) (i + 1) count (a + i))
      else primesThrough (i + 1) count a

believing : Handler primeEffect
believing =
  { M = \a -> a
  , ret = \x -> x
  , bind = \m k -> k m
  , malg = \p -> case p of
      Prime v k -> k True
  }

-- | >>> sums
-- | Cons (MkPair 0 0) (Cons (MkPair 2 2) (Cons (MkPair 17 17) (Cons (MkPair 1060 1060) (Cons (MkPair 76127 76127) Nil))))
sums : List (Pair Int Int)
sums =
  List.map
    (\(n : Int) ->
       MkPair
         (handle believing (primesWithin (ev := _) 2 n 0))
         (handle believing (primesThrough (ev := _) 2 n 0)))
    [2, 3, 10, 100, 1000]

-- a state outside: each of `n` queries counted by a put that passes
-- through the prime handlers within

countOdd : {w : HFunctor} -> {{ev : primeEffect <: w}} -> {{st : state Int <: w}} -> Int -> Int -> Co w Int
countOdd i n =
  if i >= n then get
  else do
    b <- isPrime i
    s <- get
    put (if b then s + 1 else s)
    countOdd (i + 1) n

counted : {e : HFunctor} -> {{st : state Int <: e}} -> Int -> Co e Int
counted n =
  within
    primeEffect
    e
    (\hd t -> case t of
       Prime v k -> hd.ret (k (v % 2 == 1)))
    (countOdd (ev := _) (st := _) 0 n)

data Out a = MkOut a Int

stating : Handler (state Int)
stating =
  { M = \a -> Int -> Out a
  , ret = \x s -> MkOut x s
  , bind = \m k s -> case m s of
      MkOut x s2 -> k x s2
  , malg = \p s -> case p of
      Get k -> MkOut (k s) s
      Put st x -> MkOut x st
  }

-- | >>> odds
-- | 10010
odds : Int
odds = case handle stating (counted (st := _) 21) 0 of
  MkOut x s -> x * 1000 + s
