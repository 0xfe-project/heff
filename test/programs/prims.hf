data Bool = True | False

foreign import intAdd :: Int -> Int -> Int

foreign import intLt :: Int -> Int -> Bool

foreign import strAppend :: String -> String -> String

foreign import strLength :: String -> Int

foreign import strCharCode :: String -> Int -> Int

foreign import strSlice :: String -> Int -> Int -> String

foreign import intShow :: Int -> String

count :: (s :: String) -> (i :: Int) -> Int
count s i = case intLt i (strLength s) of
  True -> intAdd 1 (count s (intAdd i 1))
  False -> 0

three :: Int
three = count "abc" 0

small :: Bool
small = intLt 1 2

greeting :: String
greeting = strAppend "len=" (intShow (strLength "hello"))

code :: Int
code = strCharCode "A" 0

mid :: String
mid = strSlice "hippogriff" 2 5

foreign import intMul :: Int -> Int -> Int

foreign import intDiv :: Int -> Int -> Int

foreign import intMod :: Int -> Int -> Int

big :: Int
big = intMul 4294967296 4294967296

foreign import intSub :: Int -> Int -> Int

fdiv :: Int
fdiv = intDiv (intSub 0 7) 2

fmod :: Int
fmod = intMod (intSub 0 7) 2

fmod2 :: Int
fmod2 = intMod 7 (intSub 0 2)

