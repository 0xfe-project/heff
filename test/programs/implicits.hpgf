def Bool : Type := sum
  'true
  'false
end

def List (A : Type) : Type := sum
  'nil
  'cons A (List A)
end

def id {A : Type} (x : A) : A := x

def map {A : Type} {B : Type} (f : A -> B) (xs : List A) : List B := match xs
  'nil => 'nil
  'cons y ys => 'cons (f y) (rec (map f ys))
end

def not (b : Bool) : Bool := match b
  'true => 'false
  'false => 'true
end

def flipped : List Bool := map not ('cons 'true ('cons 'false 'nil))

def same : Bool := id 'true

def explicit : List Bool := map {Bool} {Bool} not 'nil

def compose {A : Type} {B : Type} {C : Type} (g : B -> C) (f : A -> B) (x : A) : C := g (f x)

def twice : Bool := compose not not 'false

def Option (A : Type) : Type := sum
  'none
  'some A
end

theory Monoid := sig
  t : Type
  unit : t
  op : t -> t -> t
end

def mconcat {M : Monoid} (xs : List M.t) : M.t := match xs
  'nil => M.unit
  'cons y ys => M.op y (rec (mconcat {M} ys))
end

def Or : Monoid := struct
  t := Bool
  unit := 'false
  op := x => y => match x
    'true => 'true
    'false => y
  end
end

def anyTrue : Bool := mconcat {Or} ('cons 'false ('cons 'true 'nil))

def lamImplicit : {A : Type} -> A -> A := {A} => x => x

def insertedLam : {A : Type} -> A -> A := x => x
