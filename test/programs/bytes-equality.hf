-- `==` of `Bytes` without `import bytes`: the prelude's `instanceEqualityBytes`,
-- each backend held to the interpreter.

module test.programs.bytes-equality

equal : List Bool
equal =
  [ b["GET"] == b["GET"]
  , b["GET"] == b["PUT"]
  , b[] == b[]
  , b["\xff"] /= b["\xfe"]
  , b["h\u{e9}"] == b["h\xc3\xa9"]
  , List.all (\b -> b == b["a"]) [b["a"], b["\x61"]]
  ]

-- (a pattern of bytes, compared by the prelude's `bytesEq`)
isGet : Bytes -> Bool
isGet b["GET"] = True
isGet _ = False

gets : List Bool
gets = List.map isGet [b["GET"], b["GE"], b["GETS"]]
