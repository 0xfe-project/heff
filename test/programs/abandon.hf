-- What abandons in a primitive abandons compiled too -- and a division
-- by zero, which does not (it is 0, its remainder the dividend), does
-- not compiled either.

byZero : Int
byZero = 7 / 0

modZero : Int
modZero = 7 % 0

floorInfinite : Int
floorInfinite = floor (1.0 /. 0.0)

fine : Int
fine = 7 / 2
