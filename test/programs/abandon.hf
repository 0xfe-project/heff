-- What abandons in a primitive abandons compiled too -- and what does
-- not, does not compiled either: a division by zero (it is 0, its
-- remainder the dividend), and the floor of what is not finite (0).

module test.programs.abandon

import array as Array

byZero : Int
byZero = 7 / 0

modZero : Int
modZero = 7 % 0

floorInfinite : Int
floorInfinite = floor (1.0 /. 0.0)

floorNotANumber : Int
floorNotANumber = floor (0.0 /. 0.0)

-- (the array primitive's index out of range; `Array.index` is `Nothing`)
indexBeyond : Int
indexBeyond = arrayIndex (Array.fromList [1, 2]) 2

fine : Int
fine = 7 / 2

-- (a loop reading two arrays at its index, tested against the first's
-- length: the second shorter, or the index below 0, abandons as an
-- index out of range does)
addFrom : Int -> Array Float64 -> Array Float64 -> Float64 -> Float64
addFrom i xs ys acc =
  if i < Array.length xs
  then addFrom (i + 1) xs ys (acc + arrayIndex xs i + arrayIndex ys i)
  else acc

shorterSecond : Float64
shorterSecond =
  addFrom 0 (Array.replicate 3 1.0) (Array.replicate 2 1.0) 0.0

belowZero : Float64
belowZero = addFrom (0 - 1) (Array.replicate 2 1.0) (Array.replicate 2 1.0) 0.0

asLong : Float64
asLong = addFrom 0 (Array.replicate 2 1.0) (Array.replicate 2 1.0) 0.0

-- (a read of one array, its index tested against another's length:
-- checked still, the one read shorter abandons)
otherRead : Array Int -> Array Int -> Int -> Int
otherRead xs ys i = if 0 <= i && i < Array.length xs then arrayIndex ys i else 0

readShorter : Int
readShorter = otherRead (Array.fromList [1, 2, 3]) (Array.fromList [1]) 2
