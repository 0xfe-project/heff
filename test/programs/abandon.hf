-- What abandons in a primitive abandons compiled too -- and what does
-- not, does not compiled either: a division by zero (it is 0, its
-- remainder the dividend), and the floor of what is not finite (0).

import array as Array

byZero : Int
byZero = 7 / 0

modZero : Int
modZero = 7 % 0

floorInfinite : Int
floorInfinite = floor (1.0 /. 0.0)

floorNotANumber : Int
floorNotANumber = floor (0.0 /. 0.0)

-- (the array primitive's index out of range; `A.index` is `Nothing`)
indexBeyond : Int
indexBeyond = arrayIndex (Array.fromList [1, 2]) 2

fine : Int
fine = 7 / 2
