-- `Int`'s bits, each backend held to the interpreter: and, or and xor of
-- every pair of some integers, words and big ones, of either sign; shifts
-- by counts about a word's and a digit's width.

import int as I

samples : List Int
samples =
  [ 0
  , 1
  , -1
  , 5
  , -5
  , 2147483648
  , 2305843009213693951
  , -2305843009213693952
  , 4611686018427387904
  , 18446744073709551619
  , -1180591620717411291079
  , 123456789012345678901234567890
  , -987654321098765432109876543210
  ]

counts : List Int
counts = [0, 1, 3, 31, 32, 33, 61, 62, 63, 64, 65, 100]

pairShown : Int -> Int -> String
pairShown a b =
  joinWith " " [showInt (I.and a b), showInt (I.or a b), showInt (I.xor a b)]

bits : String
bits =
  joinWith "\n" (List.concatMap (\a -> List.map (\b -> pairShown a b) samples) samples)

shifts : String
shifts =
  joinWith
    "\n"
    (List.concatMap
       (\a ->
          List.map
            (\k -> showInt (I.shiftL a k) ^ " " ^ showInt (I.shiftR a k))
            counts)
       samples)

complements : String
complements = joinWith " " (List.map (\a -> showInt (I.complement a)) samples)

-- (a negative count abandons)
negativeShift : Int
negativeShift = I.shiftL 1 -1
