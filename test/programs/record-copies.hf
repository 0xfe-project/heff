-- Copies made for a literal record: `pointB`'s `{ x =
-- q.x % 1000, ... }`, in a copy made for `{ x = 1, y = 2, z = 3 }`, is
-- closed but computes, and is given no copy of its own -- one would ask
-- for another made for `x % 1000` once more, without end.  Each backend
-- held to the interpreter.

module test.programs.record-copies

import int64 as Int64

type Point = { x : Int64, y : Int64, z : Int64 }

pointA : Int64 -> Point -> Int64
pointA n p =
  if n == 0 then p.x + p.y + p.z
  else if n % 3 == 0 then pointB { x = p.y, y = p.z, z = p.x + n } (n - 1)
  else if n % 5 == 0 then pointB { x = p.z, y = p.x, z = p.y - n } (n - 1)
  else if n % 7 == 0 then pointB { x = p.x * 3, y = p.y, z = p.z } (n - 1)
  else pointB p (n - 1)
  where
  pointB : Point -> Int64 -> Int64
  pointB q m =
    if q.x > 1000000 then pointA m { x = q.x % 1000, y = q.y, z = q.z }
    else pointA m q

pointed : Int64
pointed = pointA 9 { x = 1, y = 2, z = 3 }

-- (past the bound, the field taken down)
pointedFar : Int64
pointedFar = pointA 40 { x = 999999, y = 7, z = 11 }
