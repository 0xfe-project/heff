-- Integers beyond a machine word: each operation, its signs, and the
-- edges where a result comes back to a word.

data Bool = True | False

data List a = Nil | Cons a (List a)

foreign import intAdd : Int -> Int -> Int

foreign import intSub : Int -> Int -> Int

foreign import intMul : Int -> Int -> Int

foreign import intDiv : Int -> Int -> Int

foreign import intMod : Int -> Int -> Int

foreign import intEq : Int -> Int -> Bool

foreign import intLt : Int -> Int -> Bool

foreign import intLe : Int -> Int -> Bool

foreign import intShow : Int -> String

foreign import floatFromInt : Int -> Float

foreign import floatFloor : Float -> Int

foreign import floatMul : Float -> Float -> Float

map : {a b : Type} -> (a -> b) -> List a -> List b
map f Nil = Nil
map f (Cons x xs) = Cons (f x) (map f xs)

pow : Int -> Int -> Int
pow b 0 = 1
pow b n = intMul b (pow b (intSub n 1))

edge : Int
edge = 2305843009213693952

ns : List Int
ns =
  Cons edge
    (Cons (intSub 0 edge)
       (Cons (intSub edge 1)
          (Cons 12345678901234567890123
             (Cons (intSub 0 98765432109876543210) (Cons 7 (Cons (intSub 0 3) Nil))))))

sums : List Int
sums = map (\a -> intAdd a (intSub 0 edge)) ns

products : List Int
products = map (\a -> intMul a a) ns

quotients : List Int
quotients = map (\a -> intDiv (pow 10 40) a) ns

quotientsNeg : List Int
quotientsNeg = map (\a -> intDiv (intSub 0 (pow 7 30)) a) ns

remainders : List Int
remainders = map (\a -> intMod (pow 3 70) a) ns

remaindersNeg : List Int
remaindersNeg = map (\a -> intMod (intSub 0 (pow 3 70)) a) ns

byBig : List Int
byBig = map (\a -> intMod a 18446744073709551557) ns

shown : List String
shown = map intShow ns

lts : List Bool
lts = map (\a -> intLt a 12345678901234567890123) ns

les : List Bool
les = map (\a -> intLe a (intSub edge 1)) ns

eqs : List Bool
eqs = map (\a -> intEq a (intAdd (intSub edge 1) 1)) ns

back : Int
back = intSub (intAdd (pow 2 100) 5) (pow 2 100)

fnv : Int
fnv = intMod (intMul (intAdd 14695981039346656037 98) 1099511628211) 18446744073709551616

floats : List Float
floats = map floatFromInt ns

floors : List Int
floors = map (\a -> floatFloor (floatMul (floatFromInt a) 1.5)) ns

knuth : Int
knuth = intDiv (intSub (pow 2 128) 1) (intAdd (pow 2 64) 3)
