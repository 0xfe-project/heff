-- `deriving` after a `data`'s alternatives: the instances of the
-- prelude's `Equality`, `Order`, `Debug` and `Show`, written as the
-- prelude writes its own -- of an enumeration, of a type with a
-- parameter, and of a recursive one.

module test.programs.deriving

data Color = Red | Green | Blue deriving (Equality, Order, Debug, Show)

data Shape a = Circle Int | Rect a a | Blank
  deriving (Show, Debug, Order, Equality)

data Tree a = Leaf | Node (Tree a) a (Tree a)
  deriving (Equality, Order, Debug)

data Point = MkPoint Int String deriving (Equality, Order, Show)

-- | >>> sameColors
-- | True
sameColors : Bool
sameColors = (Red : Color) == Red && (Red : Color) /= Blue

-- | >>> colorOrder
-- | [LT, EQ, GT]
colorOrder : List Ordering
colorOrder =
  [ compare (Red : Color) Green
  , compare (Blue : Color) Blue
  , compare (Blue : Color) Green
  ]

-- | >>> sameShapes
-- | [True, False, False, True]
sameShapes : List Bool
sameShapes =
  [ (Rect 1 2 : Shape Int) == Rect 1 2
  , (Rect 1 2 : Shape Int) == Rect 1 3
  , (Circle 1 : Shape Int) == Blank
  , (Blank : Shape Int) == Blank
  ]

-- | >>> shapeOrder
-- | [LT, GT, GT, LT]
shapeOrder : List Ordering
shapeOrder =
  [ compare (Circle 9 : Shape Int) (Rect 0 0)
  , compare (Rect 1 3 : Shape Int) (Rect 1 2)
  , compare (Blank : Shape Int) (Circle 0)
  , compare (Rect 0 9 : Shape Int) (Rect 1 0)
  ]

-- | >>> shapeText
-- | "Rect (\"a\") (\"b\") Circle (3) Blank"
shapeText : String
shapeText =
  debug (Rect "a" "b" : Shape String)
  ^ " "
  ^ show (Circle 3 : Shape String)
  ^ " "
  ^ show (Blank : Shape String)

-- | >>> colorText
-- | "Green Blue"
colorText : String
colorText = debug (Green : Color) ^ " " ^ show (Blue : Color)

small : Tree Int
small = Node Leaf 1 (Node Leaf 2 Leaf)

-- | >>> sameTrees
-- | [True, False]
sameTrees : List Bool
sameTrees = [small == Node Leaf 1 (Node Leaf 2 Leaf), small == Node Leaf 1 Leaf]

-- | >>> treeOrder
-- | [GT, LT]
treeOrder : List Ordering
treeOrder = [compare small (Node Leaf 1 Leaf), compare Leaf small]

-- | >>> treeLess
-- | [True, False]
treeLess : List Bool
treeLess = [Node Leaf 0 Leaf < small, small <= Leaf]

-- | >>> treeText
-- | "Node (Leaf) (1) (Node (Leaf) (2) (Leaf))"
treeText : String
treeText = debug small

-- | >>> pointOrder
-- | [GT, EQ]
pointOrder : List Ordering
pointOrder =
  [ compare (MkPoint 1 "b" : Point) (MkPoint 1 "a")
  , compare (MkPoint 2 "x" : Point) (MkPoint 2 "x")
  ]

-- | >>> pointText
-- | "MkPoint (1) (\"a\")"
pointText : String
pointText = show (MkPoint 1 "a" : Point)
