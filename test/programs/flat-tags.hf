-- Tags whose `Float64`, `Int64` and `UInt64` fields the C backend keeps
-- flat (#64): `Just x`, list cells, a tag of the program's own, built,
-- matched, rebuilt in their cells and matched where shared or lent,
-- built by a loop that fills a hole (TRMC), shown, and given to code
-- that does not know the field's type -- and built by it, then matched
-- where the type is known -- and integers beyond 62 bits.  Each backend
-- held to the interpreter.

module test.programs.flat-tags

import int64 as Int64
import uint64 as UInt64

data Shape
  = Circle Float64
  | Rect Float64 Float64
  | Tagged String Int64 UInt64 Float64

area : Shape -> Float64
area (Circle r) = 3.0 * r * r
area (Rect w h) = w * h
area (Tagged _ i u f) =
  toFloat (Int64.toInt (i % 1000)) + toFloat (UInt64.toInt (u % 1000)) + f

shapes : List Shape
shapes =
  List.map
    (\k ->
       if k % 3 == 0 then Circle (toFloat k)
       else if k % 3 == 1 then Rect (toFloat k) 0.5
       else Tagged
           ("t" ^ debug k)
           (Int64.fromInt k * 4611686018427387903)
           (UInt64.fromInt k * 0x9E3779B97F4A7C15)
           0.25)
    (List.range 0 8)

areas : String
areas = debug (List.foldl (\s sh -> s + area sh) 0.0 shapes)

-- (rebuilt in its cell where it is the last reference: the field kept
-- flat or not as the new tag says)
grow : Shape -> Shape
grow (Circle r) = Rect r r
grow (Rect w h) = Circle (w + h)
grow (Tagged s i u f) = Tagged s (i + i) (u * 3) (f * 2.0)

grown : String
grown =
  debug
    (List.foldl
       (\s sh -> s + area sh)
       0.0
       (List.map grow (List.map grow shapes)))

-- (the shapes themselves, as a value: shown by each backend)
some : List Shape
some = List.take 3 (List.drop 1 shapes)

-- (shared: matched while it is wanted after)
twice : Shape -> Float64
twice sh = case sh of
  Circle r -> r + area sh
  Rect w h -> w + h + area sh
  Tagged _ i _ f -> toFloat (Int64.toInt (i % 7)) + f + area sh

shared : String
shared = debug (List.foldl (\s sh -> s + twice sh) 0.0 shapes)

-- (`Just` of a number: built knowing it, matched knowing it, and not)
halve : Float64 -> Maybe Float64
halve x = if x < 1.0 then Nothing else Just (x /. 2.0)

halves : Float64 -> Int -> Float64
halves x n = case halve x of
  Just y -> if n == 0 then y else halves y (n - 1)
  Nothing -> x

orZero : {a : Type} -> a -> Maybe a -> a
orZero d (Just x) = x
orZero d Nothing = d

maybes : String
maybes =
  debug (halves 1000000.0 10)
  ^ " "
  ^ debug (orZero 0.0 (halve 9.0))
  ^ " "
  ^ debug (orZero 0 (Just (Int64.fromInt 7 * 4611686018427387903)))
  ^ " "
  ^ debug (maybe 1 (\u -> u + 1) (Just (UInt64.fromInt 3 * 0xF000000000000001)))

-- (list cells of numbers: built by a loop that fills a hole, mapped and
-- folded where the type is not known, and where it is)
ramp : Int -> List Float64
ramp n = if n == 0 then Nil else toFloat n * 0.5 :: ramp (n - 1)

sumF : List Float64 -> Float64
sumF Nil = 0.0
sumF (x :: xs) = x + sumF xs

wide : List UInt64
wide = List.map (\k -> UInt64.fromInt k * 0x9E3779B97F4A7C15) (List.range 1 5)

sumU : UInt64 -> List UInt64 -> UInt64
sumU acc Nil = acc
sumU acc (u :: us) = sumU (acc + u) us

lists : String
lists =
  debug (sumF (ramp 100))
  ^ " "
  ^ debug (List.foldl (\s x -> s + x) 0.0 (List.map (\x -> x * 2.0) (ramp 10)))
  ^ " "
  ^ debug (sumF (List.reverse (ramp 7)))
  ^ " "
  ^ debug (sumU 0 wide)
  ^ " "
  ^ debug (List.length (List.keepIf (\u -> u > 0x8000000000000000) wide))

-- (lists of numbers, as values)
rampList : List Float64
rampList = ramp 4

wideList : List UInt64
wideList = wide

pairs : List (Pair Int64 Float64)
pairs =
  List.map
    (\k -> MkPair (Int64.fromInt k * 4611686018427387903) (toFloat k + 0.5))
    (List.range 1 3)
