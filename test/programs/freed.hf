-- Deep structures given back (#34): long lists, trees leaning either
-- way, a chain of closures each holding the one before, records holding
-- them -- built, read, and given back, the walk that gives them back
-- going down each without a stack as deep as it is.

module test.programs.freed

data Tree = Leaf | Node Tree Int Tree

leftTree : Int -> Tree -> Tree
leftTree n t = if n <= 0 then t else leftTree (n - 1) (Node t n Leaf)

rightTree : Int -> Tree -> Tree
rightTree n t = if n <= 0 then t else rightTree (n - 1) (Node Leaf n t)

-- (down the left spine, and down the right one)
leftmost : Tree -> Int -> Int
leftmost Leaf acc = acc
leftmost (Node l x _) acc = leftmost l x

rightmost : Tree -> Int -> Int
rightmost Leaf acc = acc
rightmost (Node _ x r) acc = rightmost r x

trees : List Int
trees =
  [ leftmost (leftTree 20000 Leaf) 0
  , rightmost (rightTree 20000 Leaf) 0
  , leftmost (rightTree 100 (leftTree 100 Leaf)) 0
  ]

-- (closures each holding the one before)
chain : Int -> (Int -> Int) -> Int -> Int
chain n f = if n <= 0 then f else chain (n - 1) (\x -> f x + 1)

chained : List Int
chained = [chain 2000 (\x -> x) 0, chain 3 (\x -> x * 2) 5]

-- (a long list of records, each holding a tree, a closure and a list)
type Holder = { tree : Tree, fn : Int -> Int, items : List Int, n : Int }

holder : Int -> Holder
holder i =
  { tree = leftTree (i % 50) Leaf
  , fn = chain (i % 7) (\x -> x + i)
  , items = List.range 0 (i % 30)
  , n = i
  }

holderSum : Holder -> Int
holderSum h = leftmost h.tree 0 + h.fn 1 + List.sum h.items + h.n

holders : Int
holders = List.foldl (\acc h -> acc + holderSum h) 0 (List.map holder (List.range 1 3000))

-- (the list itself long, dropped at once)
longList : Int
longList = List.length (List.map (\i -> ([i, i + 1] : List Int)) (List.range 1 50000))

-- (a list kept in two places, one given back, the other read after)
sharedTail : List Int
sharedTail =
  let xs = List.range 1 10000
  in let ys = 0 :: xs
  in let zs = List.map (\x -> x * 2) ys
  in [List.length zs, List.sum xs, List.length ys]
