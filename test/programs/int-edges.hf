-- Integers about the edge of a word (C keeps one from -2^62 up to 2^62
-- in a word, lib/c/runtime.c): each operation on every pair of some
-- words and big ones of either sign, its result crossing the edge both
-- ways; division and remainder of each sign, by 0 too; comparisons of a
-- word with a big one, as values and as conditions.

import int64 as Int64

pow2 : Int -> Int
pow2 0 = 1
pow2 n = 2 * pow2 (n - 1)

-- (the greatest word, and the least, computed)
top : Int
top = pow2 62 - 1

bottom : Int
bottom = 0 - pow2 62

samples : List Int
samples =
  [ 0
  , 1
  , -1
  , 2
  , -3
  , pow2 31
  , 0 - pow2 31
  , pow2 61
  , top
  , top + 1
  , top - 1
  , bottom
  , bottom + 1
  , bottom - 1
  , pow2 63
  , 0 - pow2 63
  , pow2 64 + 3
  , 0 - pow2 70
  ]

-- (the edges written: each literal a word or a big one, as it is)
literals : List Int
literals =
  [ 4611686018427387903
  , 4611686018427387904
  , -4611686018427387904
  , -4611686018427387905
  , 9223372036854775807
  , -9223372036854775808
  ]

pairs : (Int -> Int -> Int) -> List Int
pairs f = List.concatMap (\a -> List.map (\b -> f a b) samples) samples

sums : List Int
sums = pairs (\a b -> a + b)

differences : List Int
differences = pairs (\a b -> a - b)

products : List Int
products = pairs (\a b -> a * b)

nonZero : List Int
nonZero = List.filter (\b -> b /= 0) samples

byNonZero : (Int -> Int -> Int) -> List Int
byNonZero f = List.concatMap (\a -> List.map (\b -> f a b) nonZero) samples

quotients : List Int
quotients = byNonZero (\a b -> a / b)

remainders : List Int
remainders = byNonZero (\a b -> a % b)

-- (each negated, across the edge both ways)
negations : List Int
negations = List.map neg samples

-- (back to a word, and out of one, by one step)
steps : List Int
steps =
  [ top + 1 - 1
  , bottom - 1 + 1
  , (top + 1) - (top + 1)
  , bottom * -1
  , bottom / -1
  , bottom % -1
  , pow2 31 * pow2 31
  , pow2 31 * (0 - pow2 31)
  , (pow2 70 + 5) - pow2 70
  , (pow2 70 + 5) % pow2 70
  , (0 - pow2 70) / pow2 8
  ]

byZero : Int
byZero = List.length samples / 0

bigByZero : Int
bigByZero = (pow2 70 + List.length samples) % 0

-- (each comparison, as a value)
relations : List (List Bool)
relations =
  List.map
    (\a ->
       List.concatMap
         (\b -> [a == b, a /= b, a < b, a <= b, a > b, a >= b])
         samples)
    samples

-- (each comparison, as a condition)
conditionOf : Int -> Int -> Int
conditionOf a b =
  (if a < b then 1 else 0)
  + (if a <= b then 2 else 0)
  + (if a == b then 4 else 0)
  + (if a > b && a /= b then 8 else 0)
  + (if a >= b || a == 0 then 16 else 0)

conditions : List Int
conditions = pairs conditionOf

orders : List Ordering
orders = List.concatMap (\a -> List.map (compareInt a) samples) samples

-- (equal, the one computed big and back, the other written)
equals : List Bool
equals =
  [ top + 1 - 1 == 4611686018427387903
  , bottom - 1 + 1 == -4611686018427387904
  , pow2 62 == 4611686018427387904
  , pow2 62 - 1 == 4611686018427387904
  ]

-- (Int64 about the edges of a word and of 64 bits)
int64s : List String
int64s =
  List.map
    Int64.show
    [ Int64.add (Int64.fromInt top) 1
    , Int64.sub (Int64.fromInt bottom) 1
    , Int64.add Int64.maxBound 1
    , Int64.mul (Int64.fromInt (pow2 31)) (Int64.fromInt (pow2 31))
    , Int64.div Int64.minBound (-1)
    ]

int64Orders : List Ordering
int64Orders =
  List.map
    (\a -> compare (Int64.fromInt a) (Int64.fromInt top))
    samples
