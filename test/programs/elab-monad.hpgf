def Nat : Type := sum
  'zero
  'succ Nat
end

def Option (A : Type) : Type := sum
  'none
  'some A
end

def Tm (V : Type) : Type := sum
  'var V
  'lam (Tm (Option V))
  'app (Tm V) (Tm V)
  'zero
end

def Res (A : Type) : Type := sum
  'ok A
  'err Nat
end

# the effects the checker needs, and nothing else: failure, and going under
# a binder -- a higher-order operation that changes the scope index
theory Elab := sig
  m : Type -> Type -> Type
  ret : (V : Type) -> (a : Type) -> a -> m V a
  bnd : (V : Type) -> (a : Type) -> (b : Type) -> m V a -> (a -> m V b) -> m V b
  fail : (V : Type) -> (a : Type) -> m V a
  depth : (V : Type) -> m V Nat
  under : (V : Type) -> (a : Type) -> m (Option V) a -> m V a
end

# one implementation: read the depth, fail with it
def ReaderRes : Elab := struct
  m := V => a => Nat -> Res a
  ret := V => a => x => n => 'ok x
  bnd := V => a => b => ma => k => n => match ma n
    'ok x => k x n
    'err d => 'err d
  end
  fail := V => a => n => 'err n
  depth := V => n => 'ok n
  under := V => a => ma => n => ma ('succ n)
end

theory Checker (M : Elab) := sig
  size : (V : Type) -> Tm V -> M.m V Nat
end

# written once, for any implementation of the effects
def MkChecker (M : Elab) : Checker M := struct
  size := V => t => match t
    'var x => M.depth V
    'lam b => rec (M.under V Nat (MkChecker M .size (Option V) b))
    'app f a => rec (M.bnd V Nat Nat (MkChecker M .size V f) (n => MkChecker M .size V a))
    'zero => M.fail V Nat
  end
end

def run1 : Res Nat := MkChecker ReaderRes .size Nat ('lam ('lam ('var 'none))) 'zero

def run2 : Res Nat := MkChecker ReaderRes .size Nat ('lam ('app ('var 'none) 'zero)) 'zero
