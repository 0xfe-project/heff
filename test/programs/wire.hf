-- The wire: each instance's bytes, and each value read
-- back from them, compiled as the interpreter computes them -- so that
-- what a C program writes is what a page's script writes, byte for
-- byte, the contract of remote.

module test.programs.wire

import array as Array
import bits as Bits
import bytes as Bytes
import float32 as Float32
import std.hashmap as HashMap
import int16 as Int16
import int32 as Int32
import int64 as Int64
import int8 as Int8
import std.ordmap as OrdMap
import rune as Rune
import uint16 as UInt16
import uint32 as UInt32
import uint64 as UInt64
import uint8 as UInt8
import wire as Wire

-- (each value written, and whether it reads back as itself, all of the
-- bytes read)
roundTrip : {a : Type}
          -> {{wire : Wire.Wire a}}
          -> {{eq : Equality a}}
          -> a
          -> Bool
roundTrip x = maybe False (\y -> y == x) (Wire.decodeAll (Wire.encode x))

ints : List Int
ints =
  [ 0
  , 1
  , -1
  , 63
  , -64
  , 64
  , 4611686018427387903
  , -4611686018427387904
  , 18446744073709551616
  , -1267650600228229401496703205376
  , 1606938044258990275541962092341162602522202993782792835301376
  ]

intBytes : List Bytes
intBytes = List.map Wire.encode ints

intsBack : Bool
intsBack = List.all roundTrip ints

fixedBytes : List Bytes
fixedBytes =
  [ Wire.encode (Int8.fromInt -128)
  , Wire.encode (Int8.fromInt 127)
  , Wire.encode (Int16.fromInt -2)
  , Wire.encode (Int32.fromInt -2147483648)
  , Wire.encode (Int64.fromInt -9223372036854775808)
  , Wire.encode (Int64.fromInt 9223372036854775807)
  , Wire.encode (UInt8.fromInt 255)
  , Wire.encode (UInt16.fromInt 65535)
  , Wire.encode (UInt32.fromInt 4294967295)
  , Wire.encode (UInt64.fromInt 18446744073709551615)
  ]

fixedBack : List Bool
fixedBack =
  [ roundTrip (Int8.fromInt -128)
  , roundTrip (Int16.fromInt -32768)
  , roundTrip (Int32.fromInt 2147483647)
  , roundTrip (Int64.fromInt -9223372036854775808)
  , roundTrip (UInt8.fromInt 200)
  , roundTrip (UInt16.fromInt 40000)
  , roundTrip (UInt32.fromInt 4000000000)
  , roundTrip (UInt64.fromInt 18446744073709551615)
  ]

floats : List Float64
floats =
  [0.0, -(0.0), 1.5, -2.25, 1.0e300, 1.0 /. 3.0, 0.1, 1.0 /. 0.0, -1.0 /. 0.0]

floatBytes : List Bytes
floatBytes = Wire.encode (0.0 /. 0.0) :: List.map Wire.encode floats

floatsBack : Bool
floatsBack = List.all roundTrip floats

float32Bytes : List Bytes
float32Bytes =
  List.map (\x -> Wire.encode (Float32.fromFloat x)) [1.5, -0.1, 3.0e38]

float32Back : Bool
float32Back = roundTrip (Float32.fromFloat -0.1)

texts : List String
texts = ["", "hi", "h\u{e9}llo", "\u{1F600}", "raw \xff\xfe bytes"]

textBytes : List Bytes
textBytes = List.map Wire.encode texts

textsBack : Bool
textsBack = List.all roundTrip texts

runeBytes : List Bytes
runeBytes =
  List.map Wire.encode ['a', '\u{e9}', '\u{1F600}', Rune.fromInt 55296]

runesBack : Bool
runesBack = List.all roundTrip ['a', '\u{10FFFF}', Rune.fromInt 55296]

bytesBytes : List Bytes
bytesBytes = List.map Wire.encode [b[], b[0, 255, "x"], Bytes.fromString "\xff"]

bytesBack : Bool
bytesBack = roundTrip b[1, 2, 3, 255] && roundTrip b[]

bitsBytes : List Bytes
bitsBytes =
  List.map Wire.encode [Bits.empty, b[1::1], b[5::3, 1::6], b[255, 1::1]]

bitsBack : Bool
bitsBack =
  roundTrip b[5::3, 1::6]
  && roundTrip b[1, 2, b[]::bits]
  && roundTrip Bits.empty

boolsAndUnit : List Bytes
boolsAndUnit =
  [ Wire.encode (True : Bool)
  , Wire.encode (False : Bool)
  , Wire.encode (MkUnit : Unit)
  ]

boolsBack : Bool
boolsBack =
  roundTrip (True : Bool)
  && roundTrip (False : Bool)
  && roundTrip (MkUnit : Unit)

containers : List Bytes
containers =
  [ Wire.encode ([1, 2, 300] : List Int)
  , Wire.encode (Array.fromList ["a", "bc"])
  , Wire.encode (Just (Just False) : Maybe (Maybe Bool))
  , Wire.encode (Nothing : Maybe Int)
  , Wire.encode (MkPair "k" (-7) : Pair String Int)
  , Wire.encode (Left 3 : Either Int String)
  , Wire.encode (Right "r" : Either Int String)
  , Wire.encode (OrdMap.fromList [MkPair 3 "c", MkPair 1 "a", MkPair 2 "b"])
  , Wire.encode
    (HashMap.fromList [MkPair "one" 1, MkPair "two" 2, MkPair "three" 3])
  ]

containersBack : List Bool
containersBack =
  [ roundTrip ([[1], [], [2, 3]] : List (List Int))
  , roundTrip
    ([Just (Left 1), Nothing, Just (Right "x")] :
       List (Maybe (Either Int String)))
  , roundTrip
    (MkPair (MkPair 1.5 'q') ["s"] : Pair (Pair Float64 Rune) (List String))
  , maybe
    False
    (\(xs : Array String) -> Array.toList xs == ["a", "bc"])
    (Wire.decodeAll (Wire.encode (Array.fromList ["a", "bc"])))
  , maybe
    False
    (\m -> OrdMap.toList m == [MkPair 1 "a", MkPair 2 "b"])
    (Wire.decodeAll (Wire.encode (OrdMap.fromList [MkPair 2 "b", MkPair 1 "a"])))
  , maybe
    False
    (\(m : HashMap.HashMap String Int) ->
       HashMap.lookup m "two" == Just 2 && HashMap.size m == 3)
    (Wire.decodeAll
       (Wire.encode
          (HashMap.fromList
             [MkPair "one" 1, MkPair "two" 2, MkPair "three" 3])))
  ]

-- a type of one's own: a record, written as pairs
type Note = { title : String, done : Bool, tags : List String }

instance instanceWireNote : Wire.Wire Note
instanceWireNote =
  Wire.via
    (\(n : Note) -> MkPair n.title (MkPair n.done n.tags))
    (\p -> { title = fst p, done = fst (snd p), tags = snd (snd p) })

-- ... and one of three constructors, as `Either`s
data Shape = Dot | Circle Float64 | Box Float64 Float64

instance instanceWireShape : Wire.Wire Shape
instanceWireShape = Wire.via written read
  where
  written : Shape -> Either Unit (Either Float64 (Pair Float64 Float64))
  written Dot = Left MkUnit
  written (Circle r) = Right (Left r)
  written (Box w h) = Right (Right (MkPair w h))
  read : Either Unit (Either Float64 (Pair Float64 Float64)) -> Shape
  read (Left u) = Dot
  read (Right (Left r)) = Circle r
  read (Right (Right p)) = Box (fst p) (snd p)

instance instanceEqualityShape : Equality Shape
instanceEqualityShape = { equal = same }
  where
  same : Shape -> Shape -> Bool
  same Dot Dot = True
  same (Circle a) (Circle b) = a == b
  same (Box a b) (Box c d) = a == c && b == d
  same _ _ = False

ownBytes : List Bytes
ownBytes =
  [ Wire.encode ({ title = "milk", done = False, tags = ["shop"] } : Note)
  , Wire.encode (Dot : Shape)
  , Wire.encode (Circle 1.0 : Shape)
  , Wire.encode (Box 2.0 0.5 : Shape)
  ]

ownBack : Bool
ownBack =
  List.all roundTrip ([Dot, Circle 1.0, Box 2.0 0.5] : List Shape)
  && maybe
    False
    (\(n : Note) -> n.title == "milk" && n.tags == ["a", "b"])
    (Wire.decodeAll
       (Wire.encode
          ({ title = "milk", done = True, tags = ["a", "b"] } : Note)))

shapes : List String
shapes =
  [ Wire.shapeOf (List (Maybe Int))
  , Wire.shapeOf (Pair String (Either Int64 Bits))
  , Wire.shapeOf Note
  , Wire.shapeOf Shape
  ]

-- what is no value of the type: too short, a tag out of range, a natural
-- that does not end, bytes left over
refused : List Bool
refused =
  [ (Wire.decodeAll b[] : Maybe Bool) == Nothing
  , (Wire.decodeAll b[2] : Maybe Bool) == Nothing
  , (Wire.decodeAll b[3] : Maybe (Maybe Int)) == Nothing
  , (Wire.decodeAll b[128, 128] : Maybe Int) == Nothing
  , (Wire.decodeAll b[5, "abc"] : Maybe String) == Nothing
  , (Wire.decodeAll b[0, 0] : Maybe Int) == Nothing
  , (Wire.decodeAll b[1, 2, 3] : Maybe Int32) == Nothing
  , (Wire.decodeAll b[3, 2, 4] : Maybe (List Int)) == Nothing
  ]
