module test.programs.elab-monad

data Nat = Zero | Succ Nat

data Option (A : Type) = None | Some A

data Tm (V : Type) = Var V | Lam (Tm (Option V)) | App (Tm V) (Tm V) | Zero

data Res (A : Type) = Ok A | Err Nat

theory Elab where
  m : Type -> Type -> Type
  ret : (V : Type) -> (a : Type) -> a -> m V a
  bnd : (V : Type) -> (a : Type) -> (b : Type) -> m V a -> (a -> m V b) -> m V b
  fail : (V : Type) -> (a : Type) -> m V a
  depth : (V : Type) -> m V Nat
  under : (V : Type) -> (a : Type) -> m (Option V) a -> m V a

ReaderRes : Elab
ReaderRes =
  { m = \V a -> Nat -> Res a
  , ret = \V a x n -> Ok x
  , bnd = \V a b ma k n -> case ma n of
      Ok x -> k x n
      Err d -> Err d
  , fail = \V a n -> Err n
  , depth = \V n -> Ok n
  , under = \V a ma n -> ma (Succ n)
  }

theory Checker (M : Elab) where
  size : (V : Type) -> Tm V -> M.m V Nat

MkChecker : (M : Elab) -> Checker M
MkChecker M =
  { size = \V t -> case t of
      Var x -> M.depth V
      Lam b -> M.under V Nat ((MkChecker M).size (Option V) b)
      App f a ->
        M.bnd V Nat Nat ((MkChecker M).size V f) (\n -> (MkChecker M).size V a)
      Zero -> M.fail V Nat
  }

run1 : Res Nat
run1 = (MkChecker ReaderRes).size Nat (Lam (Lam (Var None))) Zero

run2 : Res Nat
run2 = (MkChecker ReaderRes).size Nat (Lam (App (Var None) Zero)) Zero
