-- Arrays, compiled as the interpreter computes them.

import array as Array

squares : Array Int
squares = Array.generate 5 (\i -> i * i)

size : Int
size = Array.length squares

third : Maybe Int
third = Array.index squares 3

beyond : Maybe Int
beyond = Array.index squares 7

below : Maybe Int
below = Array.index squares (-1)

changed : Array Int
changed = Array.set squares 0 100

-- (out of range, the array as it is)
changedBeyond : Array Int
changedBeyond = Array.set squares 5 100

changedBelow : Array Int
changedBelow = Array.set squares (-1) 100

unchanged : Array Int
unchanged = squares

sum : Int
sum = Array.foldl (\acc x -> acc + x) 0 squares

shown : List String
shown = Array.toList (Array.map show (Array.fromList (Cons 1 (Cons 2 Nil))))

nested : Array (Array Bool)
nested = Array.generate 2 (\i -> Array.generate i (\j -> i == j))

nothing : Int
nothing = Array.length (Array.empty : Array Int)
