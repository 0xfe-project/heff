-- Arrays, compiled as the interpreter computes them: grown too, by
-- `push`, `append`, `insertAt` and `reserve`, and shortened by `pop` --
-- in place where nothing else holds the array, and copied where it is
-- shared, the shared one as it was.

module test.programs.arrays

import array as Array
import int64 as Int64
import uint8 as UInt8

squares : Array Int
squares = Array.generate 5 (\i -> i * i)

size : Int
size = Array.length squares

third : Maybe Int
third = Array.index squares 3

beyond : Maybe Int
beyond = Array.index squares 7

below : Maybe Int
below = Array.index squares (-1)

changed : Array Int
changed = Array.set squares 0 100

-- (out of range, the array as it is)
changedBeyond : Array Int
changedBeyond = Array.set squares 5 100

changedBelow : Array Int
changedBelow = Array.set squares (-1) 100

unchanged : Array Int
unchanged = squares

sum : Int
sum = Array.foldl (\acc x -> acc + x) 0 squares

shown : List String
shown = Array.toList (Array.map debug (Array.fromList (Cons 1 (Cons 2 Nil))))

nested : Array (Array Bool)
nested = Array.generate 2 (\i -> Array.generate i (\j -> i == j))

nothing : Int
nothing = Array.length (Array.empty : Array Int)

-- (one put in or taken out: of an array held elsewhere too, its
-- elements counted; of one held only there, moved over; of strings, of
-- numbers kept flat, of none)
words : Array String
words = Array.fromList ["a", "b", "c"]

spliced : List (List String)
spliced =
  [ Array.toList (Array.insertAt words 1 "x")
  , Array.toList (Array.insertAt words 3 "x")
  , Array.toList (Array.insertAt words 7 "x")
  , Array.toList (Array.insertAt words -2 "x")
  , Array.toList (Array.removeAt words 0)
  , Array.toList (Array.removeAt words 2)
  , Array.toList (Array.removeAt words 3)
  , Array.toList words
  , Array.toList
    (Array.removeAt
       (Array.insertAt (Array.fromList ["p", "q", "r"]) 0 "o")
       2)
  , Array.toList (Array.insertAt (Array.fromList []) 0 "only")
  , Array.toList (Array.removeAt (Array.fromList ["only"]) 0)
  ]

splicedFloats : List (List Float64)
splicedFloats =
  [ Array.toList (Array.insertAt (Array.fromList [1.5, 2.5]) 1 9.0)
  , Array.toList (Array.removeAt (Array.fromList [1.5, 2.5]) 0)
  , Array.toList (Array.insertAt (Array.fromList []) 0 0.5)
  ]

-- (pushed one at a time, from none: grown in place)
pushAll : Int -> Int -> Array Int -> Array Int
pushAll i n xs =
  if i >= n then xs else pushAll (i + 1) n (Array.push xs (i * i))

built : List Int
built = Array.toList (pushAll 0 10 Array.empty)

base : Array Int
base = Array.fromList [1, 2, 3]

-- (shared: `base` as it was)
shared : Pair (List Int) (List Int)
shared = MkPair (Array.toList (Array.push base 4)) (Array.toList base)

-- (an array built here, unique, then held twice: each change a copy,
-- the other holder's as it was)
grownTwice : List (List Int)
grownTwice =
  let xs = pushAll 0 4 Array.empty
  in [ Array.toList (Array.push xs 9)
     , Array.toList (Array.append xs (Array.fromList [7]))
     , Array.toList (Array.reserve xs 10)
     , Array.toList (Array.insertAt xs 1 5)
     , Array.toList (Array.removeAt xs 1)
     , Array.toList xs
     ]

poppedTwice : Pair (Maybe (Pair (List Int) Int)) (List Int)
poppedTwice =
  let xs = pushAll 0 4 Array.empty
  in MkPair
    (case Array.pop xs of
     Just (MkPair rest x) -> Just (MkPair (Array.toList rest) x)
     Nothing -> Nothing)
    (Array.toList xs)

popped : Maybe (Pair (List Int) Int)
popped = case Array.pop base of
  Just (MkPair rest x) -> Just (MkPair (Array.toList rest) x)
  Nothing -> Nothing

none : Bool
none = case Array.pop (Array.empty : Array Int) of
  Just _ -> False
  Nothing -> True

-- (a `Float64` pushed onto none: kept flat)
floats : List Float64
floats =
  Array.toList (Array.push (Array.push (Array.empty : Array Float64) 1.5) 2.5)

reserved : List Int
reserved = Array.toList (Array.push (Array.reserve (Array.fromList [7]) 100) 8)

reservedNone : List Int
reservedNone = Array.toList (Array.reserve (Array.fromList [7]) (-3))

appended : List Int
appended =
  Array.toList (Array.append (pushAll 0 5 Array.empty) (Array.fromList [9, 10]))

-- (pushed, then popped, all in place)
popAll : Int -> Array Int -> Int
popAll acc xs = case Array.pop xs of
  Just (MkPair rest x) -> popAll (acc + x) rest
  Nothing -> acc

total : Int
total = popAll 0 (pushAll 0 1000 (Array.reserve Array.empty 3))

removed : List Int
removed =
  Array.toList (Array.removeAt (Array.removeAt (pushAll 0 5 Array.empty) 0) 9)

-- (flat: bytes, `Int64`s and `Float64`s)
bytesUp : Int -> Array UInt8 -> Array UInt8
bytesUp i xs =
  if i >= 300 then xs else bytesUp (i + 1) (Array.push xs (UInt8.fromInt i))

bytesSum : Int
bytesSum =
  Array.foldl
    (\acc b -> acc + UInt8.toInt b)
    0
    (bytesUp 0 (Array.replicate 2 (UInt8.fromInt 7)))

wide : Array Int64
wide = Array.replicate 3 (Int64.fromInt 5)

wideGrown : Pair (List Int64) (List Int64)
wideGrown =
  MkPair
    (Array.toList
       (Array.push (Array.push wide (Int64.fromInt 6)) (Int64.fromInt 7)))
    (Array.toList wide)

floatsDown : Float64 -> Array Float64 -> Float64
floatsDown acc xs = case Array.pop xs of
  Just (MkPair rest x) -> floatsDown (acc + x) rest
  Nothing -> acc

floatsSum : Float64
floatsSum =
  floatsDown
    0.0
    (Array.append (Array.replicate 5 0.5) (Array.fromList [1.0, 2.0]))

inserted : List String
inserted =
  Array.toList
    (Array.insertAt
       (Array.insertAt (Array.reserve (Array.fromList ["a", "c"]) 4) 1 "b")
       0
       "z")

-- (elements counted: an array appended to itself, and a shared one
-- appended to a grown one)
boxes : Array (List Int)
boxes = Array.fromList [[1], [2, 3]]

boxesGrown : Pair (Array (List Int)) (Array (List Int))
boxesGrown = MkPair boxes (Array.append (Array.push boxes [4]) boxes)

selfAppended : List Int
selfAppended =
  let xs = Array.push (Array.fromList [1, 2]) 3
  in Array.toList (Array.append xs xs)

-- (popped where its room is its length, 4, 6 and 9 of them, then grown
-- again past it: its room a power of 2 each time)
popPush : Int -> List (List Int)
popPush n =
  let xs = Array.generate n (\i -> i)
  in case Array.pop xs of
  Just (MkPair rest x) -> [Array.toList (Array.push (Array.push rest x) 99)]
  Nothing -> []

poppedPushed : List (List (List Int))
poppedPushed = [popPush 1, popPush 4, popPush 6, popPush 9]
