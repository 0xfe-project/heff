-- Arrays, compiled as the interpreter computes them.

import array as A
import prelude

squares :: Array Int
squares = A.generate 5 (\i -> i * i)

size :: Int
size = A.length squares

third :: Int
third = A.index squares 3

outside :: Maybe Int
outside = A.at squares 7

beyond :: Int
beyond = A.index squares 7

changed :: Array Int
changed = A.set squares 0 100

unchanged :: Array Int
unchanged = squares

sum :: Int
sum = A.foldl (\acc x -> acc + x) 0 squares

shown :: List String
shown = A.toList (A.map showInt (A.fromList (Cons 1 (Cons 2 Nil))))

nested :: Array (Array Bool)
nested = A.generate 2 (\i -> A.generate i (\j -> i == j))

nothing :: Int
nothing = A.length (A.empty :: Array Int)
