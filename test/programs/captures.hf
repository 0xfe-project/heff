-- Lambdas that capture variables, given to a loop: each loop a copy
-- (heff.compile.spec) given what its lambda captures, no closure built
-- -- a captured variable used more than once given once, two lambdas
-- alike but for what they capture one copy; and a list a copy is both
-- lent and given, which it must not take apart in place while it reads
-- it (heff.compile.rc).

shifted : Int -> List Int
shifted r = List.map (\x -> x * r + r) (List.range 1 5)

shifteds : List (List Int)
shifteds = [shifted 2, shifted 7]

-- (alike but for what they capture)
between : Int -> Int -> List Int
between lo hi = List.filter (\x -> lo < x && x < hi) (List.range 0 20)

betweens : List (List Int)
betweens = [between 3 9, between 10 13]

-- (the list the loop is given is the one its lambda captures)
notFirst : List Int -> List Int
notFirst all =
  List.filter
    (\x -> case all of
     Cons h _ -> x /= h
     Nil -> True)
    all

notFirsts : List (List Int)
notFirsts = [notFirst [4, 1, 4, 2], notFirst (List.range 1 6), notFirst Nil]

sums : Int -> Int
sums r =
  List.foldl (\a b -> a + b * r) 0 (List.map (\x -> x - r) (List.range 1 100))

sumss : List Int
sumss = [sums 1, sums 3]

-- (a list lent and given to one call: what is given is not taken apart
-- in place while what is lent is read)
memberOf : Int -> List Int -> Bool
memberOf x Nil = False
memberOf x (Cons y ys) = x == y || memberOf x ys

notIn : List Int -> List Int -> List Int
notIn ys Nil = Nil
notIn ys (Cons x xs) =
  if memberOf (x + 1) ys then notIn ys xs else Cons (x * 2) (notIn ys xs)

notIns : List Int
notIns =
  let xs = List.map (\x -> x * 3 % 1001) (List.range 1 3000)
  in List.take 5 (notIn xs xs)
