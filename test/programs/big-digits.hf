-- Integers beyond a word, each backend held to the interpreter: every
-- operation of every pair about the edges of a word and of a 64-bit
-- digit (2^62, 2^64, 2^128), of either sign, division rounding down;
-- integers of thousands of digits multiplied, divided and shown; their
-- hashes, and so a map's order.

module test.programs.big-digits

import int as Int
import std.hashmap as HashMap

pow : Int -> Int -> Int
pow b 0 = 1
pow b n = b * pow b (n - 1)

around : Int -> List Int
around e = [e - 1, e, e + 1, 0 - e - 1, 0 - e, 0 - e + 1]

samples : List Int
samples =
  List.append
    [0, 1, -7, 10000000000000000000, -18446744073709551557]
    (List.concatMap around [pow 2 62, pow 2 64, pow 2 128])

pairShown : Int -> Int -> String
pairShown a b =
  joinWith
    " "
    [ debug (a + b)
    , debug (a - b)
    , debug (a * b)
    , debug (a / b)
    , debug (a % b)
    , debug (a < b)
    , debug (a == b)
    , debug (a <= b)
    ]

pairs : String
pairs =
  joinWith "\n" (List.concatMap (\a -> List.map (\b -> pairShown a b) samples) samples)

shifted : String
shifted =
  joinWith
    "\n"
    (List.concatMap
       (\a ->
          List.map
            (\k -> debug (shiftL a k) ^ " " ^ debug (shiftR a k))
            [1, 63, 64, 65, 128, 130])
       samples)

hashes : List Int
hashes = List.map (\(i : Int) -> HashMap.hash i) samples

floats : List Float64
floats = List.map floatFromInt samples

-- (many digits: 3^4000, 1900 of them, and 800!, near 2000)
huge : Int
huge = pow 3 4000

fact : Int
fact = List.product (List.range 1 800)

prod : Int
prod = huge * fact

divisor : Int
divisor = fact + 12345

quot : Int
quot = prod / divisor

rem : Int
rem = prod % divisor

held : Bool
held = quot * divisor + rem == prod && 0 <= rem && rem < divisor

hugeShown : String
hugeShown = debug huge

quotShown : String
quotShown = debug quot

prodLength : Int
prodLength = strLength (debug prod)

negatives : List Int
negatives =
  [ (0 - prod) / huge % 1000000007
  , (0 - prod) % (fact + 1) % 1000000007
  , prod / (0 - huge - 1) % 1000000007
  , prod % (0 - huge - 1) % 1000000007
  , (0 - prod) / (0 - divisor) % 1000000007
  , quot / pow 10 1000
  , huge / pow 2 6000
  , huge % pow 2 64
  ]

bitsOfHuge : List Int
bitsOfHuge =
  [ shiftR prod 5000 % 1000000007
  , shiftL huge 333 % 1000000007
  , and prod (0 - huge) % 1000000007
  , xor prod huge % 1000000007
  , or (0 - prod) fact % 1000000007
  ]

hugeHashes : List Int
hugeHashes = List.map (\(i : Int) -> HashMap.hash i) [huge, 0 - huge, prod, quot, rem]

keyed : HashMap.HashMap Int Int
keyed =
  HashMap.fromList
    (List.map (\i -> MkPair (pow 2 64 * i + i) i) (List.range 1 200))

order : List Int
order = List.map (\p -> case p of MkPair k v -> v) (HashMap.toList keyed)
