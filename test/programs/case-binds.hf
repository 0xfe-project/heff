-- A `case` alternative may name the whole value: `other` is the value
-- matched, as `_` would match it.

module test.programs.case-binds

-- | >>> f [3, 4]
-- | 3
-- | >>> f []
-- | 0
f : List Int -> Int
f xs = case xs of
  x :: rest -> x
  other -> List.length other

-- | >>> g (Just 0)
-- | Nothing
-- | >>> g (Just 2)
-- | Just 2
g : Maybe Int -> Maybe Int
g m = case m of
  Just 0 -> Nothing
  other -> other
