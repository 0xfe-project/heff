-- A `case` alternative may name the whole value: `other` is the value
-- matched, as `_` would match it.

f : List Int -> Int
f xs = case xs of
  Cons x rest -> x
  other -> List.length other

g : Maybe Int -> Maybe Int
g m = case m of
  Just 0 -> Nothing
  other -> other

-- >>> f [3, 4]
-- 3
-- >>> f []
-- 0
-- >>> g (Just 0)
-- Nothing
-- >>> g (Just 2)
-- Just 2
