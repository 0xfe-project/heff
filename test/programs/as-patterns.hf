-- `x@p`: the value `p` matches, also named `x` -- in an equation, in a
-- `case`, under a tag, on a record.

import prelude

type Pt = { x : Int, y : Int }

dupHead : List Int -> List Int
dupHead xs@(Cons x _) = Cons x xs
dupHead Nil = Nil

firstTwo : List Int -> Maybe (List Int)
firstTwo (Cons a rest@(Cons b _)) = Just rest
firstTwo _ = Nothing

sumIfOrigin : Pt -> Int
sumIfOrigin p@{ x = 0 } = p.y
sumIfOrigin p@{ y = 0 } = p.x
sumIfOrigin p = p.x + p.y

caseAs : Maybe Int -> Int
caseAs m = case m of
  j@(Just n) -> fromMaybe 0 j + n
  Nothing -> 0

nestedAs : List (Maybe Int) -> Int
nestedAs (Cons whole@(Just inner@3) _) = fromMaybe 0 whole + inner
nestedAs _ = 0

-- >>> dupHead [1, 2]
-- [1, 1, 2]
-- >>> firstTwo [1, 2, 3]
-- Just [2, 3]
-- >>> sumIfOrigin { x = 0, y = 4 }
-- 4
-- >>> sumIfOrigin { x = 5, y = 0 }
-- 5
-- >>> sumIfOrigin { x = 2, y = 3 }
-- 5
-- >>> caseAs (Just 4)
-- 8
-- >>> nestedAs [Just 3]
-- 6
