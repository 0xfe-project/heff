-- Booleans as conditions, compiled: chains of `&&` and `||`, a test of
-- a test, a binding inside a condition, `not`, and a test in a loop --
-- what is not reached is not computed (a later part that would abandon
-- stays unreached), and what is reached is computed in order.

import prelude

isSpaceAt : String -> Int -> Bool
isSpaceAt s i =
  0 <= i && i < strLength s && (charCode s i == 32 || charCode s i == 9)

spaces : List Bool
spaces =
  [isSpaceAt "a b" 1, isSpaceAt "a\tb" 1, isSpaceAt "ab" 1, isSpaceAt "ab" 5]

-- (the test after `&&`, were it computed, would abandon)
guarded : Int -> Bool
guarded d = d /= 0 && 10 / d > 2

guards : List Bool
guards = [guarded 0, guarded 2, guarded 5]

clamp : Int -> Int
clamp n = if n < 0 then 0 else n + 1

clamps : List Int
clamps = [clamp (0 - 4), clamp 0, clamp 7]

inner : Int -> Int -> Bool
inner a b = if a < b then a == 0 else b == 0

pick : Int -> Int -> Int
pick a b = if inner a b then 1 else 2

picks : List Int
picks = [pick 0 1, pick 2 3, pick 3 0, pick 3 2]

isDigit : Int -> Bool
isDigit c = 48 <= c && c <= 57

digitAt : String -> Int -> Bool
digitAt s i = i < strLength s && isDigit (charCode s i)

digits : List Bool
digits = [digitAt "a1" 1, digitAt "a1" 0, digitAt "a1" 9]

-- (a binding in each arm of a test: one name each)
either : String -> Int -> Bool
either s i =
  if i < 1 then isDigit (charCode s i) else isDigit (charCode s (i - 1))

eithers : List Bool
eithers = [either "7x" 0, either "x7" 0, either "7x" 1, either "x7" 1]

outside : Int -> Int -> Int -> Bool
outside lo hi x = not (lo <= x && x <= hi)

outsides : List Bool
outsides = [outside 1 3 0, outside 1 3 2, outside 1 3 4]

-- (a test in an expression, a boolean kept)
flags : List Bool
flags = map (\n -> n < 3 || n == 7) [1, 5, 7]

-- (a loop on a condition)
allDigits : String -> Int -> Bool
allDigits s i =
  if i >= strLength s then True
  else isDigit (charCode s i) && allDigits s (i + 1)

loops : List Bool
loops = [allDigits "0123" 0, allDigits "01x3" 0, allDigits "" 0]

floatsAndStrings : List Bool
floatsAndStrings = [1.5 <. 2.0 && strEq "a" "a", 2.0 <=. 1.0 || strLt "b" "a"]
