-- Booleans as conditions, compiled: chains of `&&` and `||`, a test of
-- a test, a binding inside a condition, `not`, and a test in a loop --
-- what is not reached is not computed (a later part that would abandon
-- stays unreached), and what is reached is computed in order.  Each
-- type's comparisons as conditions (C tests the runtime's condition of
-- one, not its Bool), a test's value bound and kept.

import float32 as F32
import int8 as I8
import int64 as I64
import uint64 as U64

isSpaceAt : String -> Int -> Bool
isSpaceAt s i =
  0 <= i && i < strLength s && (byteAt s i == 32 || byteAt s i == 9)

spaces : List Bool
spaces =
  [isSpaceAt "a b" 1, isSpaceAt "a\tb" 1, isSpaceAt "ab" 1, isSpaceAt "ab" 5]

-- (the test after `&&`, were it computed, would abandon)
guarded : Int -> Bool
guarded d = d /= 0 && 10 / d > 2

guards : List Bool
guards = [guarded 0, guarded 2, guarded 5]

clamp : Int -> Int
clamp n = if n < 0 then 0 else n + 1

clamps : List Int
clamps = [clamp (0 - 4), clamp 0, clamp 7]

inner : Int -> Int -> Bool
inner a b = if a < b then a == 0 else b == 0

pick : Int -> Int -> Int
pick a b = if inner a b then 1 else 2

picks : List Int
picks = [pick 0 1, pick 2 3, pick 3 0, pick 3 2]

isDigit : Int -> Bool
isDigit c = 48 <= c && c <= 57

digitAt : String -> Int -> Bool
digitAt s i = i < strLength s && isDigit (byteAt s i)

digits : List Bool
digits = [digitAt "a1" 1, digitAt "a1" 0, digitAt "a1" 9]

-- (a binding in each arm of a test: one name each)
either : String -> Int -> Bool
either s i =
  if i < 1 then isDigit (byteAt s i) else isDigit (byteAt s (i - 1))

eithers : List Bool
eithers = [either "7x" 0, either "x7" 0, either "7x" 1, either "x7" 1]

outside : Int -> Int -> Int -> Bool
outside lo hi x = not (lo <= x && x <= hi)

outsides : List Bool
outsides = [outside 1 3 0, outside 1 3 2, outside 1 3 4]

-- (a test in an expression, a boolean kept)
flags : List Bool
flags = List.map (\n -> n < 3 || n == 7) [1, 5, 7]

-- (a loop on a condition)
allDigits : String -> Int -> Bool
allDigits s i =
  if i >= strLength s then True
  else isDigit (byteAt s i) && allDigits s (i + 1)

loops : List Bool
loops = [allDigits "0123" 0, allDigits "01x3" 0, allDigits "" 0]

floatsAndStrings : List Bool
floatsAndStrings = [1.5 <. 2.0 && strEq "a" "a", 2.0 <=. 1.0 || strLt "b" "a"]

-- (a comparison of each type as an `if`'s test, its operands computed)
classify : {a : Type} -> (a -> a -> Bool) -> (a -> a -> Bool) -> a -> a -> Int
classify eq lt x y = if lt x y then 0 else if eq x y then 1 else 2

each : {a : Type} -> (a -> a -> Bool) -> (a -> a -> Bool) -> List a -> List Int
each eq lt xs = List.concatMap (\x -> List.map (classify eq lt x) xs) xs

ints8 : List Int
ints8 =
  List.map
    (\x ->
       if I8.lt x (I8.fromInt 3) then 0
       else if I8.le x (I8.fromInt 3) then 1
       else 2)
    (List.map I8.fromInt [-128, 3, 127, 300])

ints64 : List Int
ints64 =
  each
    I64.eq
    I64.lt
    (List.map
       I64.fromInt
       [-1, 0, 4611686018427387904, 9223372036854775807, -9223372036854775808])

uints64 : List Int
uints64 =
  each
    U64.eq
    U64.lt
    (List.map U64.fromInt [-1, 0, 5, 4611686018427387904, 18446744073709551615])

floats32 : List Int
floats32 =
  each
    F32.eq
    F32.lt
    (List.map F32.fromFloat [0.0 /. 0.0, -1.5, 0.1, 1.0 /. 0.0])

floats : List Int
floats =
  each (\a b -> a ==. b) (\a b -> a <. b) [0.0 /. 0.0, -1.5, 0.1, 1.0 /. 0.0]

strings : List Int
strings = each strEq strLt ["", "a", "ab", "b", strSlice "xab" 1 3]

-- (each comparison inline, its Bool only looked at)
directly : Int -> Int -> String -> String -> List Bool
directly a b s t =
  [ if a == b then True else False
  , if strEq s t then a <= b else b < a
  , if strLt s t || a < b then strEq t s else False
  ]

directs : List (List Bool)
directs = [directly 1 2 "a" "a", directly 2 1 "a" "b", directly 3 3 "b" "a"]

-- (a test's value kept besides being looked at)
kept : Int -> Int -> List Bool
kept a b = let t = a < b in if t then [t, b < a] else [t]

keeps : List (List Bool)
keeps = [kept 1 2, kept 2 1]
