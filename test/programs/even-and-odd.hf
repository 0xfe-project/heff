data Bool = True | False

theory Eq where
  t : Type
  eq : t -> t -> Bool

theory EqPair where
  even : Eq
  odd : Eq

EvenAndOdd : EqPair
EvenAndOdd =
  { even =
      { t = data { Zero | Succ EvenAndOdd.odd.t }
      , eq = \x y -> case x of
          Zero -> case y of
            Zero -> True
            Succ _ -> False
          Succ x0 -> case y of
            Zero -> False
            Succ y0 -> EvenAndOdd.odd.eq x0 y0
      }
  , odd =
      { t = data { Succ EvenAndOdd.even.t }
      , eq = \x y -> case x of
          Succ x0 -> case y of
            Succ y0 -> EvenAndOdd.even.eq x0 y0
      }
  }
