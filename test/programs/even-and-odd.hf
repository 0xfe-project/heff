data Bool = 'true | 'false

theory Eq where
  t :: Type
  eq :: t -> t -> Bool

theory EqPair where
  even :: Eq
  odd :: Eq

EvenAndOdd :: EqPair
EvenAndOdd = { even = { t = sum { 'zero | 'succ EvenAndOdd.odd.t }, eq = \x y -> case x of
  'zero -> case y of
    'zero -> 'true
    'succ _ -> 'false
  'succ x0 -> case y of
    'zero -> 'false
    'succ y0 -> EvenAndOdd.odd.eq x0 y0 }, odd = { t = sum { 'succ EvenAndOdd.even.t }, eq = \x y -> case x of
  'succ x0 -> case y of
    'succ y0 -> EvenAndOdd.even.eq x0 y0 } }

