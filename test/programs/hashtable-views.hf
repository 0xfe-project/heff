-- Keys looked up by a view of them (`KeyView`, a string's `slice`), in a
-- hash table and a hash map, held to the slices made: the k-mers of a
-- string counted both ways, short and long enough to be views.

module test.programs.hashtable-views

import std.hashmap as HashMap
import std.hashtable as HashTable

text : String
text =
  joinWith
    ""
    (List.map
       (\(i : Int) -> if i % 3 == 0 then "ACGT" else if i % 5 == 0 then "GG" else "TA")
       (List.range 0 300))

tableBy : Int -> HashTable.HashTable String Int
tableBy k =
  List.foldl
    (\t i -> HashTable.updateBy t (HashMap.slice text i (i + k)) 1 (\new old -> new + old))
    HashTable.empty
    (List.range 0 (strLength text - k))

mapBy : Int -> HashMap.HashMap String Int
mapBy k =
  List.foldl
    (\m i -> HashMap.updateBy m (HashMap.slice text i (i + k)) 1 (\new old -> new + old))
    HashMap.empty
    (List.range 0 (strLength text - k))

byString : Int -> HashMap.HashMap String Int
byString k =
  List.foldl
    (\m i -> HashMap.update m (strSlice text i (i + k)) 1 (\new old -> new + old))
    HashMap.empty
    (List.range 0 (strLength text - k))

-- (each count the same, all three ways, and found by `lookupBy` too)
agreeOn : Int
        -> HashTable.HashTable String Int
        -> HashMap.HashMap String Int
        -> HashMap.HashMap String Int
        -> Bool
agreeOn k t v m =
  HashTable.size t == HashMap.size m
  && HashMap.size v == HashMap.size m
  && HashMap.foldl
    (\ok key n ->
       ok
       && equal (HashTable.lookup t key) (Just n)
       && equal (HashMap.lookup v key) (Just n))
    True
    m
  && List.all
    (\i ->
       equal
         (HashTable.lookupBy t (HashMap.slice text i (i + k)))
         (HashMap.lookup m (strSlice text i (i + k)))
       && equal
         (HashMap.lookupBy v (HashMap.slice text i (i + k)))
         (HashMap.lookup m (strSlice text i (i + k))))
    (List.range 0 (strLength text - k))

agree : Int -> Bool
agree k = agreeOn k (tableBy k) (mapBy k) (byString k)

agreed : List Bool
agreed = List.map agree [1, 2, 3, 6, 12, 70, 100]

counts : List (Pair String Int)
counts = HashTable.toList (tableBy 2)

mapCounts : List (Pair String Int)
mapCounts = HashMap.toList (mapBy 2)

missing : List (Maybe Int)
missing =
  [ HashTable.lookupBy (tableBy 2) (HashMap.slice "xxCCx" 2 4)
  , HashMap.lookupBy (mapBy 2) (HashMap.slice "xxCCx" 2 4)
  , HashTable.lookupBy (tableBy 2) (HashMap.slice text 0 2)
  , HashMap.lookupBy (mapBy 2) (HashMap.slice text 0 2)
  ]
