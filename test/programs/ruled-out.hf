-- A pattern that binds cannot fail where the matches around it have
-- ruled out the other tags of what it takes apart: the same local, a
-- name bound to it, a field of it, or an argument of the tag matched.
-- A match on such a value needs no case for a tag ruled out.

module test.programs.ruled-out

-- the arm above took Nil
-- | >>> first [5, 6]
-- | 5
-- | >>> first []
-- | 0
first : List Int -> Int
first xs = case xs of
  Nil -> 0
  _ -> do
    let Cons h t = xs
    h

-- an earlier equation took Nil
-- | >>> second [7]
-- | 7
second : List Int -> Int
second Nil = 0
second xs = let Cons h t = xs in h

-- a field
type Box = { items : List Int, n : Int }

-- | >>> boxed { items = [3], n = 1 }
-- | 3
-- | >>> boxed { items = [], n = 1 }
-- | 1
boxed : Box -> Int
boxed b = case b.items of
  Nil -> b.n
  _ -> let Cons h t = b.items in h

-- nested: the tail too
-- | >>> pairUp [1, 2, 3]
-- | 3
-- | >>> pairUp [1]
-- | 0
pairUp : List Int -> Int
pairUp xs = case xs of
  Cons _ (Cons _ _) -> let Cons a (Cons b rest) = xs in a + b
  _ -> 0

-- the tail named by the outer match
-- | >>> tailed [1, 2]
-- | 3
-- | >>> tailed [1]
-- | 1
tailed : List Int -> Int
tailed xs = case xs of
  Cons h t -> case t of
    Nil -> h
    _ -> let Cons a rest = t in h + a
  Nil -> 0

-- two levels of case, the inner on another
-- | >>> twoLevels (Just 1) [4]
-- | 5
twoLevels : Maybe Int -> List Int -> Int
twoLevels m xs = case xs of
  Nil -> 0
  _ -> case m of
    Nothing -> let Cons h t = xs in h
    Just k -> let Cons h t = xs in h + k

-- a name for it
-- | >>> renamed [9]
-- | 9
renamed : List Int -> Int
renamed xs = case xs of
  Nil -> 0
  ys -> let Cons h t = ys in h

-- let-else
-- | >>> elsed (Just [1, 2])
-- | 2
-- | >>> elsed Nothing
-- | 0
elsed : Maybe (List Int) -> Int
elsed m = run do
  let Just xs = m else return 0
  let Just ys = m
  List.length ys

-- a match complete in context
-- | >>> complete [8]
-- | 8
complete : List Int -> Int
complete xs = case xs of
  Nil -> 0
  _ -> case xs of
    Cons h t -> h

-- under a lambda
-- | >>> lam [10]
-- | [11, 12]
lam : List Int -> List Int
lam xs = case xs of
  Nil -> Nil
  _ -> List.map (\y -> let Cons h t = xs in h + y) [1, 2]
