-- Floats, compiled as the interpreter computes them.

import prelude

half :: Float
half = 1.0 /. 2.0

area :: Float -> Float
area r = 3.14159 *. r *. r

circle :: Float
circle = area 2.0

whole :: Float
whole = 2.0 *. 3.0

big :: Float
big = 6.02e23 *. 10.0

tiny :: Float
tiny = 0.1 +. 0.2

negative :: Float
negative = -0.5 -. 1.25

rounded :: Int
rounded = floor circle

shown :: String
shown = showFloat whole ++ " " ++ showFloat tiny

compared :: Bool
compared = sqrt 2.0 <. 1.5 && toFloat 3 ==. 3.0

infinite :: Int
infinite = floor (1.0 /. 0.0)
