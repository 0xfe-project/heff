-- Floats, compiled as the interpreter computes them.

module test.programs.floats

half : Float64
half = 1.0 /. 2.0

area : Float64 -> Float64
area r = 3.14159 * r * r

circle : Float64
circle = area 2.0

whole : Float64
whole = 2.0 * 3.0

big : Float64
big = 6.02e23 * 10.0

tiny : Float64
tiny = 0.1 + 0.2

negative : Float64
negative = -0.5 - 1.25

-- (0.0's sign too: 1 over it, -Infinity)
negated : String
negated =
  show (neg 2.5)
  ^ " "
  ^ show (-negative)
  ^ " "
  ^ show (1.0 /. neg 0.0)

rounded : Int
rounded = floor circle

shown : String
shown = show whole ^ " " ^ show tiny

compared : Bool
compared = sqrt 2.0 < 1.5 && toFloat 3 == 3.0

infinite : Int
infinite = floor (1.0 /. 0.0)

-- (-0.0 shown with its sign, as an argument in parentheses, and read
-- back as it: 1 over it, -Infinity)
negativeZero : String
negativeZero =
  show (neg 0.0) ^ " " ^ show -0.0 ^ " " ^ show (0.0 * -1.0) ^ " " ^ show 0.0

negativeZeros : List Float64
negativeZeros = [-0.0, 0.0, neg 0.0]

negativeZeroInside : Maybe Float64
negativeZeroInside = Just -0.0

negativeZeroBack : Float64
negativeZeroBack = 1.0 /. -0.0
