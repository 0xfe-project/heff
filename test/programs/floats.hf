-- Floats, compiled as the interpreter computes them.

half : Float64
half = 1.0 /. 2.0

area : Float64 -> Float64
area r = 3.14159 *. r *. r

circle : Float64
circle = area 2.0

whole : Float64
whole = 2.0 *. 3.0

big : Float64
big = 6.02e23 *. 10.0

tiny : Float64
tiny = 0.1 +. 0.2

negative : Float64
negative = -0.5 -. 1.25

-- (0.0's sign too: 1 over it, -Infinity)
negated : String
negated =
  showFloat (negFloat 2.5)
  ^ " "
  ^ showFloat (negFloat negative)
  ^ " "
  ^ showFloat (1.0 /. negFloat 0.0)

rounded : Int
rounded = floor circle

shown : String
shown = showFloat whole ^ " " ^ showFloat tiny

compared : Bool
compared = sqrt 2.0 <. 1.5 && toFloat 3 ==. 3.0

infinite : Int
infinite = floor (1.0 /. 0.0)
