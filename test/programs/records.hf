-- Record patterns, `{ x = p, ... }`: the fields named are matched (those
-- not named match anything), nested in tags and lists and holding them,
-- in equations, a `case` and a `let`.

import prelude

type Path = { absolute : Bool, segments : List String }

render : Path -> String
render { absolute = True, segments = [] } = "/"
render { absolute = True, segments = segments } = "/" ++ joinWith "/" segments
render { absolute = False, segments = [] } = "."
render { segments = segments } = joinWith "/" segments

depth : Path -> Int
depth p = case p of
  { segments = _ :: rest } -> 1 + length rest
  _ -> 0

firstSegment : Maybe Path -> String
firstSegment (Just { segments = [s] }) = s
firstSegment (Just { absolute = a, segments = s :: _ }) =
  if a then "/" ++ s else s
firstSegment _ = ""

flip : Path -> Path
flip path =
  let { absolute = a, segments = s } = path
  in { absolute = not a, segments = s }

rendered : List String
rendered =
  [ render { absolute = True, segments = [] }
  , render { absolute = True, segments = ["usr", "lib"] }
  , render { absolute = False, segments = [] }
  , render { absolute = False, segments = ["src", "main.hf"] }
  , render (flip { absolute = False, segments = ["etc"] })
  ]

depths : List Int
depths =
  [ depth { absolute = True, segments = [] }
  , depth { absolute = False, segments = ["a", "b"] }
  ]

firsts : List String
firsts =
  [ firstSegment (Just { absolute = True, segments = ["a"] })
  , firstSegment (Just { absolute = True, segments = ["b", "c"] })
  , firstSegment (Just { absolute = False, segments = ["d", "e"] })
  , firstSegment Nothing
  ]
