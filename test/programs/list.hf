data List a = Nil | Cons a (List a)

map : (a : Type) -> (b : Type) -> (f : a -> b) -> (xs : List a) -> List b
map a b f Nil = Nil
map a b f (Cons x ys) = Cons (f x) (map a b f ys)

data Bool = True | False

not : (b : Bool) -> Bool
not True = False
not False = True

l0 : List Bool
l0 = map Bool Bool not (Cons True (Cons False Nil))
