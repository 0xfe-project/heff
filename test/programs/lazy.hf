-- `Lazy`, compiled: `~e` computed where it is forced, and kept -- what
-- is never forced, never computed (an `abandon` delayed stays
-- unreached); forced by `force` or where its value is wanted; a field
-- of a data type, a record's; bound and forced more than once; handed
-- down a loop; captured by a closure.

module test.programs.lazy

inc : Int -> Int
inc x = x + 1

seven : ~Int
seven = ~(inc 6)

pick : Bool -> ~Int -> ~Int -> Int
pick True a b = a
pick False a b = b

-- (`l` forced `k` times, summed)
forcedIn : Int -> ~Int -> Int -> Int
forcedIn 0 l acc = acc
forcedIn k l acc = forcedIn (k - 1) l (acc + force l)

data Cell = MkCell ~Int String

cellSum : Cell -> Int
cellSum (MkCell n s) = force n + strLength s

type Holder = { lazy : ~String, plain : Int }

holder : Holder
holder = { lazy = ~("a" ^ "b"), plain = 1 }

local : Int -> Int
local n =
  let l = ~(inc n)
  in force l + force l + force l

captured : Int -> Int -> Int
captured n = let l = ~(n * 2) in \k -> force l + k

results : List Int
results =
  [ force seven
  , seven
  , pick False ~abandon ~7
  , pick True ~(List.length [1, 2]) ~(abandon)
  , forcedIn 100 seven 0
  , cellSum (MkCell ~(3 + 4) "xyz")
  , local 4
  , captured 5 1 + captured 5 2
  , force (force ~~9)
  ]

strings : List String
strings = [force holder.lazy, holder.lazy]
