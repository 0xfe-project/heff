def Bool : Type := sum
  'True
  'False
end
primitive intAdd : Int -> Int -> Int
primitive intLt : Int -> Int -> Bool
primitive strAppend : String -> String -> String
primitive strLength : String -> Int
primitive strCharCode : String -> Int -> Int
primitive strSlice : String -> Int -> Int -> String
primitive intShow : Int -> String
def count (s : String) (i : Int) : Int := match intLt i (strLength s)
  'True => intAdd 1 (rec (count s (intAdd i 1)))
  'False => 0
end
def three : Int := count ("abc") 0
def small : Bool := intLt 1 2
def greeting : String := strAppend ("len=") (intShow (strLength ("hello")))
def code : Int := strCharCode ("A") 0
def mid : String := strSlice ("hippogriff") 2 5
primitive intMul : Int -> Int -> Int
primitive intDiv : Int -> Int -> Int
primitive intMod : Int -> Int -> Int
def big : Int := intMul 4294967296 4294967296
primitive intSub : Int -> Int -> Int
def fdiv : Int := intDiv (intSub 0 7) 2
def fmod : Int := intMod (intSub 0 7) 2
def fmod2 : Int := intMod 7 (intSub 0 2)
