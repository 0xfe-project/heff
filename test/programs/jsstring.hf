-- JavaScript's strings (browser.js), JavaScript held to the interpreter
-- (a C program refuses the browser's modules): a string made one and
-- back, `Rune.toValid` of it on each -- non-ASCII, beyond U+FFFF, a byte
-- order mark, a NUL, what is not UTF-8 (an overlong, a surrogate's
-- bytes, beyond U+10FFFF, cut short, a byte of no rune) -- and ones held
-- in a list, a record, a constructor's fields and a closure, taken
-- again, some let go of unread.  None a definition's value: what one is
-- is the backend's, a JavaScript string in JavaScript and a string in
-- the interpreter.

module test.programs.jsstring

import rune as Rune
import browser.js

-- (each made as the program runs, not a literal)
samples : Unit -> List String
samples _ =
  List.map
    (\s -> "<" ^ s ^ ">")
    [ ""
    , "plain ASCII"
    , "héllo, 中文"
    , "😀 beyond U+FFFF"
    , "\u{FEFF}a byte order mark"
    , "\xC0\xAF overlong"
    , "\xED\xA0\x80 a surrogate's bytes"
    , "\xF4\x90\x80\x80 beyond U+10FFFF"
    , "cut short \xF0\x9F\x98"
    , "\xFF\x80 bytes of no rune"
    , "\xE2\x82"
    ]

-- (a string's bytes, each a number: what is not UTF-8 shown alike)
bytesOf : String -> List Int
bytesOf s = List.map (\i -> byteAt s i) (List.range 0 (strLength s - 1))

-- (and a NUL, shown by no definition: a backend shows one as it may)
roundTrips : List (List Int)
roundTrips =
  List.map (\s -> bytesOf (fromJS (toJS s))) ("a\u{0}NUL" :: samples MkUnit)

asValid : List Bool
asValid =
  List.map (\s -> strEq (fromJS (toJS s)) (Rune.toValid s)) (samples MkUnit)

-- (whether it is back as it was, and whether it was UTF-8: the same)
whereValid : List Bool
whereValid =
  List.map
    (\s ->
       if Rune.validString s then strEq (fromJS (toJS s)) s
       else not (strEq (fromJS (toJS s)) s))
    (samples MkUnit)

-- Held, taken again, let go of
--------------------------------------------------------------------------------

data Held = Two JSString JSString | One JSString | NoneHeld

type Kept = { text : JSString, n : Int, rest : List JSString }

texts : Unit -> List JSString
texts _ = List.map toJS (samples MkUnit)

-- (the first of two, the second let go of unread)
firstOf : Held -> String
firstOf (Two a _) = fromJS a
firstOf (One a) = fromJS a
firstOf NoneHeld = "none"

-- (each in two, the second a copy of the one after it)
pairs : List JSString -> List Held
pairs (Cons a (Cons b rest)) = Two a b :: pairs (Cons b rest)
pairs (Cons a Nil) = [One a]
pairs Nil = [NoneHeld]

held : List String
held = List.map firstOf (pairs (texts MkUnit))

keep : JSString -> Kept
keep t = { text = t, n = List.length (texts MkUnit), rest = texts MkUnit }

-- (each kept with the others, all but it let go of unread)
kept : List String
kept =
  List.map
    (\(k : Kept) -> fromJS k.text ^ debug k.n)
    (List.map keep (texts MkUnit))

-- (the list twice over, one of them reversed, and its last alone)
copied : List String
copied =
  List.map fromJS (List.append (texts MkUnit) (List.reverse (texts MkUnit)))

lastOne : String
lastOne = case List.last (texts MkUnit) of
  Just t -> fromJS t
  Nothing -> ""

-- (one held by a closure)
holding : JSString -> Unit -> String
holding t _ = fromJS t ^ "!"

-- (each held by a closure, called)
closed : List String
closed =
  List.map (\(f : Unit -> String) -> f MkUnit) (List.map holding (texts MkUnit))

-- (each held by a closure, never called)
dropped : Int
dropped = List.length (List.map holding (List.drop 3 (texts MkUnit)))
