-- A record built of the shape of one it reads, none of its fields kept
-- from it (#149): built in that one's cell where it was its last
-- reference, and anew where it is shared, in a loop, in a lambda, in
-- branches, with flat fields.  Each backend held to the interpreter.

module test.programs.record-rebuilt

type Stats = { fired : Int, sum : Int }

type Point = { x : Float64, y : Float64 }

bump : Int -> Stats -> Stats
bump v s = { fired = s.fired + 1, sum = (s.sum + v) % 1000003 }

stepped : Int -> Stats -> Stats
stepped 0 s = s
stepped n s =
  stepped
    (n - 1)
    (if n % 3 == 0 then bump n s else { fired = s.sum % 7, sum = s.fired })

shown : Stats -> String
shown s = showInt s.fired ^ "/" ^ showInt s.sum

alone : String
alone = shown (stepped 1000 { fired = 0, sum = 0 })

-- (the record read again after it is rebuilt: shared, built anew)
shared : String
shared =
  let s : Stats = { fired = 2, sum = 5 }
  in let t = bump 3 s
  in shown s ^ "," ^ shown t

viaLambda : String
viaLambda =
  let f =
    (\v (s : Stats) -> { fired = s.fired + v, sum = s.sum * 2 }) :
      Int -> Stats -> Stats
  in shown (List.foldl (\s v -> f v s) { fired = 0, sum = 1 } (List.range 1 20))

turned : Point -> Point
turned p = { x = p.y * 0.5, y = p.x + 1.0 }

flat : String
flat =
  let p = List.foldl (\q i -> turned q) { x = 1.0, y = 2.0 } (List.range 1 9)
  in debug p.x ^ "," ^ debug p.y
