def Nat : Type := sum
  'zero
  'succ Nat
end


def Option (A : Type) : Type := sum
  'none
  'some A
end

def Empty : Type := sum
end

def Tm (V : Type) : Type := sum
  'var V
  'app (Tm V) (Tm V)
  'lam (Tm (Option V))
end

def liftR (A : Type) (B : Type) (f : A -> B) (x : Option A) : Option B := match x
  'none => 'none
  'some a => 'some (f a)
end

def rename (A : Type) (B : Type) (f : A -> B) (t : Tm A) : Tm B := match t
  'var x => 'var (f x)
  'app u v => 'app (rec (rename A B f u)) (rec (rename A B f v))
  'lam b => 'lam (rec (rename (Option A) (Option B) (liftR A B f) b))
end

def closedId : Tm Empty := 'lam ('var 'none)


theory Syn := sig
  repr : Type -> Type
  app : (a : Type) -> (b : Type) -> repr (a -> b) -> repr a -> repr b
  lam : (a : Type) -> (b : Type) -> (repr a -> repr b) -> repr (a -> b)
end

def twice (S : Syn) (a : Type) : S.repr ((a -> a) -> a -> a) := S.lam (a -> a) (a -> a) (f => S.lam a a (x => S.app a a f (S.app a a f x)))
