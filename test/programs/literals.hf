-- Literal patterns, compiled as the interpreter computes them.

import prelude

name :: Int -> String
name 0 = "zero"
name 1 = "one"
name n = "many"

fib :: Int -> Int
fib 0 = 0
fib 1 = 1
fib n = fib (n - 1) + fib (n - 2)

answer :: String -> Int -> Int
answer "yes" 0 = 1
answer "yes" n = n
answer _ n = 0 - n

names :: String
names = name 0 ++ name 1 ++ name 2

fibs :: Int
fibs = fib 15

answers :: Int
answers = answer "yes" 0 + answer "yes" 5 + answer "no" 5
