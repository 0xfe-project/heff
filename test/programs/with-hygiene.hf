-- A `with`'s region: the binder the elaborator puts around its body,
-- `{s : Type}`, is one no name in the text refers to, so a variable of
-- the block named `s` is still that variable in the body (#139).

module test.programs.with-hygiene

import co
import resource

data NoneF (m : Type -> Type) x = NoneOf (NoneF m x)

nothingElse : HFunctor
nothingElse =
  { f = NoneF
  , hfmap = \m g p -> case p of
      NoneOf q -> abandon
  , hmap = \m n nt p -> case p of
      NoneOf q -> abandon
  }

noneAlg : {x : Type} -> NoneF (\y -> y) x -> x
noneAlg (NoneOf q) = noneAlg q

ranAlone : Handler nothingElse
ranAlone =
  { M = \x -> x
  , ret = \x -> x
  , bind = \m k -> k m
  , malg = \p -> noneAlg p
  }

ran : {a : Type} -> Co nothingElse a -> a
ran c = handle ranAlone c

-- (a `with` of a number, held in a region)
number : {e : HFunctor}
       -> {a : Type}
       -> Int
       -> ({s : Type} -> With s Int -> Co e a)
       -> Co e a
number n = had n

-- | an `s` of the block, used in a `with`'s body
-- | >>> ran outerS
-- | 6
outerS : {e : HFunctor} -> Co e Int
outerS = do
  s <- pure 5
  with number 1 as t do
    pure (s + inside t)

-- | and a parameter named `s`
-- | >>> ran (paramS 10)
-- | 12
paramS : {e : HFunctor} -> Int -> Co e Int
paramS s = do
  with number 2 as t do
    pure (s + inside t)

-- | the body given as a lambda, no `do`
-- | >>> ran (lambdaS 3)
-- | 7
lambdaS : {e : HFunctor} -> Int -> Co e Int
lambdaS s = number 4 (\t -> pure (s + inside t))
