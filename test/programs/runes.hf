-- Runes, each backend held to the interpreter: literals and their code
-- points, comparisons, literal patterns, the ASCII classes and cases, and
-- a string's runes taken out and put back -- non-ASCII, beyond U+FFFF,
-- bytes of no rune, runes that are no scalar value (a rune shown
-- as a string, and none a definition's value: a number does not say its
-- type, where a backend shows it).

module test.programs.runes

import rune as Rune

samples : Unit -> List Rune
samples _ =
  [ 'a'
  , 'Z'
  , '0'
  , ' '
  , '\n'
  , '\''
  , '\\'
  , '\u{0}'
  , '\u{7F}'
  , 'é'
  , '中'
  , '\u{FFFF}'
  , '😀'
  , '\u{10FFFF}'
  , Rune.fromInt 55296
  , Rune.fromInt 1114112
  , Rune.fromInt -1
  , Rune.fromInt 4294967393
  ]

bool : Bool -> String
bool True = "T"
bool False = "F"

codes : List Int
codes = List.map Rune.toInt (samples MkUnit)

shown : String
shown = joinWith " " (List.map show (samples MkUnit))

classes : String
classes =
  joinWith
    " "
    (List.map
       (\c ->
          bool (Rune.isDigit c)
          ^ bool (Rune.isAlpha c)
          ^ bool (Rune.isSpace c)
          ^ bool (Rune.isUpper c)
          ^ bool (Rune.isLower c)
          ^ bool (Rune.isControl c)
          ^ bool (Rune.isValid c))
       (samples MkUnit))

cases : String
cases =
  joinWith
    " "
    (List.map
       (\c -> show (Rune.toUpper c) ^ show (Rune.toLower c))
       (samples MkUnit))

pairShown : Rune -> Rune -> String
pairShown a b = bool (Rune.eq a b) ^ bool (Rune.lt a b) ^ bool (Rune.le a b)

pairs : String
pairs =
  joinWith
    " "
    (List.concatMap (\a -> List.map (\b -> pairShown a b) (samples MkUnit)) (samples MkUnit))

-- (literal patterns, in equations and in `case`)
kind : Rune -> String
kind 'a' = "a"
kind '\n' = "newline"
kind 'é' = "e acute"
kind '😀' = "grin"
kind '\u{10FFFF}' = "last"
kind c = case c of
  '0' -> "zero"
  '\'' -> "quote"
  _ -> "other"

kinds : List String
kinds = List.map kind (samples MkUnit)

texts : Unit -> List String
texts _ =
  [ ""
  , "plain"
  , "héllo, wörld"
  , "😀 and 中文"
  , "a\xedb"
  , "\xed\xa0\x80\xf0\x9f\x98"
  , "\xe0\xa0A\xc0\xaf\xf4\x90\x80\x80\xff"
  , "ab\xc3"
  , "\xe4\xb8"
  ]

-- (what is not UTF-8 shown a byte at a time, as written)
shownTexts : List String
shownTexts = texts MkUnit

widths : List (List Int)
widths =
  List.map
    (\s -> List.map (\i -> (runeAt s i).width) (List.range 0 (strLength s)))
    (texts MkUnit)

valid : List Bool
valid = List.map Rune.validString (texts MkUnit)

madeValid : List String
madeValid = List.map Rune.toValid (texts MkUnit)

runeCounts : List Int
runeCounts = List.map Rune.count (texts MkUnit)

-- (bytes' order: of UTF-8, code points')
ordered : List Bool
ordered =
  [ strLt "\u{FFFF}" "😀"
  , strLt "z" "é"
  , strLt "é" "\xff"
  , strLt "" "\x00"
  , strLt "\u{E000}" "\u{10FFFF}"
  ]

runeCodes : List (List Int)
runeCodes = List.map (\s -> List.map Rune.toInt (runes s)) (texts MkUnit)

counts : List Int
counts = List.map (\s -> List.length (runes s)) (texts MkUnit)

roundTrips : List Bool
roundTrips = List.map (\s -> strEq (ofRunes (runes s)) s) (texts MkUnit)

made : List Int
made =
  List.map
    (\i -> strByteAt (ofRunes (samples MkUnit)) i)
    (List.range 0 (strLength (ofRunes (samples MkUnit)) - 1))

-- (a rune and its width read at the same byte, as C reads them once:
-- each byte's, and those out of the string)
decoded : List (List Int)
decoded =
  List.map
    (\s ->
       List.concatMap
         (\i -> (let r = runeAt s i in [Rune.toInt r.rune, r.width]))
         (List.range (0 - 1) (strLength s + 1)))
    (texts MkUnit)

-- (... a byte past `i`'s)
nextOf : String -> Int -> List Int
nextOf s i = (let r = runeAt s (i + 1) in [Rune.toInt r.rune, r.width])

nexts : List (List Int)
nexts =
  List.map
    (\s -> List.concatMap (nextOf s) (List.range 0 (strLength s)))
    (texts MkUnit)

-- (a string walked rune by rune: each rune's code point)
walkFrom : String -> Int -> List Int -> List Int
walkFrom s i acc =
  if i >= strLength s then List.reverse acc
  else (let r = runeAt s i
        in walkFrom s (i + r.width) (Cons (Rune.toInt r.rune) acc))

walked : List (List Int)
walked = List.map (\s -> walkFrom s 0 Nil) (texts MkUnit)

-- (... its runes that are not U+FFFD, the width read only of those)
goodFrom : String -> Int -> Int -> Int
goodFrom s i n =
  if i >= strLength s then n
  else if Rune.toInt (runeAt s i).rune == 65533 then goodFrom s (i + 1) n
  else goodFrom s (i + (runeAt s i).width) (n + 1)

goods : List Int
goods = List.map (\s -> goodFrom s 0 0) (texts MkUnit)
