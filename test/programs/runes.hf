-- Runes, each backend held to the interpreter: literals and their code
-- points, comparisons, literal patterns, the ASCII classes and cases, and
-- a string's runes taken out and put back -- non-ASCII, beyond U+FFFF,
-- bytes of no rune, runes that are no scalar value (a rune shown
-- as a string, and none a definition's value: a number does not say its
-- type, where a backend shows it).

import rune as R

samples : Unit -> List Rune
samples _ =
  [ 'a'
  , 'Z'
  , '0'
  , ' '
  , '\n'
  , '\''
  , '\\'
  , '\u{0}'
  , '\u{7F}'
  , 'é'
  , '中'
  , '\u{FFFF}'
  , '😀'
  , '\u{10FFFF}'
  , R.fromInt 55296
  , R.fromInt 1114112
  , R.fromInt -1
  , R.fromInt 4294967393
  ]

bool : Bool -> String
bool True = "T"
bool False = "F"

codes : List Int
codes = List.map R.toInt (samples MkUnit)

shown : String
shown = joinWith " " (List.map R.show (samples MkUnit))

classes : String
classes =
  joinWith
    " "
    (List.map
       (\c ->
          bool (R.isDigit c)
          ^ bool (R.isAlpha c)
          ^ bool (R.isSpace c)
          ^ bool (R.isUpper c)
          ^ bool (R.isLower c)
          ^ bool (R.isControl c)
          ^ bool (R.isValid c))
       (samples MkUnit))

cases : String
cases =
  joinWith
    " "
    (List.map
       (\c -> R.show (R.toUpper c) ^ R.show (R.toLower c))
       (samples MkUnit))

pairShown : Rune -> Rune -> String
pairShown a b = bool (R.eq a b) ^ bool (R.lt a b) ^ bool (R.le a b)

pairs : String
pairs =
  joinWith
    " "
    (List.concatMap (\a -> List.map (\b -> pairShown a b) (samples MkUnit)) (samples MkUnit))

-- (literal patterns, in equations and in `case`)
kind : Rune -> String
kind 'a' = "a"
kind '\n' = "newline"
kind 'é' = "e acute"
kind '😀' = "grin"
kind '\u{10FFFF}' = "last"
kind c = case c of
  '0' -> "zero"
  '\'' -> "quote"
  _ -> "other"

kinds : List String
kinds = List.map kind (samples MkUnit)

texts : Unit -> List String
texts _ =
  [ ""
  , "plain"
  , "héllo, wörld"
  , "😀 and 中文"
  , "a\xedb"
  , "\xed\xa0\x80\xf0\x9f\x98"
  , "\xe0\xa0A\xc0\xaf\xf4\x90\x80\x80\xff"
  ]

-- (what is not UTF-8 shown a byte at a time, as written)
shownTexts : List String
shownTexts = texts MkUnit

widths : List (List Int)
widths =
  List.map
    (\s -> List.map (\i -> (runeAt s i).width) (List.range 0 (strLength s)))
    (texts MkUnit)

valid : List Bool
valid = List.map R.validString (texts MkUnit)

madeValid : List String
madeValid = List.map R.toValid (texts MkUnit)

runeCounts : List Int
runeCounts = List.map R.count (texts MkUnit)

-- (bytes' order: of UTF-8, code points')
ordered : List Bool
ordered =
  [ strLt "\u{FFFF}" "😀"
  , strLt "z" "é"
  , strLt "é" "\xff"
  , strLt "" "\x00"
  , strLt "\u{E000}" "\u{10FFFF}"
  ]

runeCodes : List (List Int)
runeCodes = List.map (\s -> List.map R.toInt (runes s)) (texts MkUnit)

counts : List Int
counts = List.map (\s -> List.length (runes s)) (texts MkUnit)

roundTrips : List Bool
roundTrips = List.map (\s -> strEq (ofRunes (runes s)) s) (texts MkUnit)

made : List Int
made =
  List.map
    (\i -> strByteAt (ofRunes (samples MkUnit)) i)
    (List.range 0 (strLength (ofRunes (samples MkUnit)) - 1))
