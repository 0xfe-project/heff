-- Literal patterns at the fixed-width types, each backend held to the
-- interpreter: every type's literals matched by its equality, in
-- equations and in `case` (a value of one shown as a string).

import float32 as F32
import int16 as I16
import int32 as I32
import int64 as I64
import int8 as I8
import uint16 as U16
import uint32 as U32
import uint64 as U64
import uint8 as U8

i8 : Int8 -> String
i8 -128 = "least"
i8 127 = "most"
i8 0 = "zero"
i8 x = I8.show x

i16 : Int16 -> String
i16 x = case x of
  -32768 -> "least"
  1000 -> "thousand"
  _ -> I16.show x

i32 : Int32 -> String
i32 -2147483648 = "least"
i32 2147483647 = "most"
i32 x = I32.show x

i64 : Int64 -> String
i64 -9223372036854775808 = "least"
i64 9223372036854775807 = "most"
i64 x = I64.show x

u8 : UInt8 -> String
u8 255 = "most"
u8 x = U8.show x

u16 : UInt16 -> String
u16 65535 = "most"
u16 x = U16.show x

u32 : UInt32 -> String
u32 x = case x of
  4294967295 -> "most"
  3735928559 -> "deadbeef"
  _ -> U32.show x

u64 : UInt64 -> String
u64 18446744073709551615 = "most"
u64 9223372036854775808 = "half"
u64 x = U64.show x

f32 : Float32 -> String
f32 0.1 = "a tenth"
f32 2 = "two"
f32 x = F32.show x

int8s : String
int8s = joinWith " " (List.map i8 (List.map I8.fromInt [-128, 127, 0, 5, 128]))

int16s : String
int16s = joinWith " " (List.map i16 (List.map I16.fromInt [-32768, 1000, 7, 32768]))

int32s : String
int32s =
  joinWith
    " "
    (List.map i32 (List.map I32.fromInt [-2147483648, 2147483647, 9, 2147483648]))

int64s : String
int64s =
  joinWith
    " "
    (List.map
       i64
       (List.map
          I64.fromInt
          [-9223372036854775808, 9223372036854775807, 11, 9223372036854775808]))

uint8s : String
uint8s = joinWith " " (List.map u8 (List.map U8.fromInt [255, -1, 3]))

uint16s : String
uint16s = joinWith " " (List.map u16 (List.map U16.fromInt [65535, -1, 3]))

uint32s : String
uint32s =
  joinWith " " (List.map u32 (List.map U32.fromInt [4294967295, 3735928559, -1, 3]))

uint64s : String
uint64s =
  joinWith
    " "
    (List.map
       u64
       (List.map U64.fromInt [18446744073709551615, 9223372036854775808, -1, 3]))

float32s : String
float32s =
  joinWith
    " "
    (List.map f32 (List.map F32.fromFloat [0.1, 2.0, 0.10000000000000002, 3.0]))
