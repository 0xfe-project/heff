-- Handlers stacked one over the other, the operations polymorphic in the
-- effect they are performed in, their evidence an instance argument
-- given once where the stack is handled (#63): a reader peeled off by
-- `through`, a writer and a state each by a state-passing layer into
-- `Co` of the rest, exceptions last by a pure handler.  The simplifier
-- makes each layer a copy of the loop for its handler, and the layers
-- one loop (heff.compile.simplify, Continuations back into a loop):
-- what each comes to is the same on every backend as in the interpreter.

module test.programs.stacked-handlers

import co
import state
import exception

data AskF (m : Type -> Type) x = Ask (Int -> x)

reader : HFunctor
reader =
  { f = AskF
  , hfmap = \m g p -> case p of
      Ask k -> Ask (\v -> g (k v))
  , hmap = \m n nt p -> case p of
      Ask k -> Ask k
  }

data TellF (m : Type -> Type) x = Tell Int x

writer : HFunctor
writer =
  { f = TellF
  , hfmap = \m g p -> case p of
      Tell v x -> Tell v (g x)
  , hmap = \m n nt p -> case p of
      Tell v x -> Tell v x
  }

-- the world the stack handles, nested to the right: globals built by
-- `<+>`, known to the simplifier as the records they come to
W3 : HFunctor
W3 = state Int <+> exception Int

W2 : HFunctor
W2 = writer <+> W3

ask : {e : HFunctor} -> {{rd : reader <: e}} -> Co e Int
ask = op (rd (Ask (\v -> v))) val

tell : {e : HFunctor} -> {{wr : writer <: e}} -> Int -> Co e Unit
tell v = op (wr (Tell v MkUnit)) val

-- | a round: each operation once, a throw caught some rounds
step : {e : HFunctor}
     -> {{rd : reader <: e}}
     -> {{wr : writer <: e}}
     -> {{st : state Int <: e}}
     -> {{ex : exception Int <: e}}
     -> Int
     -> Co e Int
step i = do
  k <- ask
  s <- get
  let s2 = (s * k + i) % 1000003
  put s2
  if s2 % 10 == 0 then tell s2 else pure MkUnit
  recover
      (if s2 % 13 == 0 then throw s2 else pure 1)
      (\err -> pure (0 - err % 5))

-- | `n` rounds, what they give summed
loop : {e : HFunctor}
     -> {{rd : reader <: e}}
     -> {{wr : writer <: e}}
     -> {{st : state Int <: e}}
     -> {{ex : exception Int <: e}}
     -> Int
     -> Int
     -> Int
     -> Co e Int
loop n i acc =
  if i >= n then pure acc
  else do
    r <- step i
    loop n (i + 1) (acc + r)

-- | ... and a throw not caught, the round it is thrown in: `n` rounds
-- | at most
escaping : {e : HFunctor}
         -> {{st : state Int <: e}}
         -> {{ex : exception Int <: e}}
         -> Int
         -> Int
         -> Co e Int
escaping n i =
  if i >= n then get
  else do
    s <- get
    if s % 97 == 0 then throw i else put ((s * 7 + i) % 1000003)
    escaping n (i + 1)

data Out a = MkOut a Int

outValue : {a : Type} -> Out a -> a
outValue (MkOut x _) = x

passingF : (e : HFunctor) -> RawFunctor
passingF e =
  { f = \a -> Int -> Co e (Out a)
  , fmap = \g m s ->
        bind (m s) (\o -> case o of
        MkOut x s2 -> val (MkOut (g x) s2))
  }

-- | a layer that keeps an Int as it handles `h`, into `Co e` of the
-- | rest: an operation of the rest is an operation again
passing : (h e : HFunctor)
        -> ({a : Type}
            -> h.f (\x -> Int -> Co e (Out x)) a
            -> Int
            -> Co e (Out a))
        -> Handler (h <+> e)
passing h e alg =
  { M = \a -> Int -> Co e (Out a)
  , ret = \x s -> val (MkOut x s)
  , bind = \m k s ->
        bind (m s) (\o -> case o of
        MkOut x s2 -> k x s2)
  , malg = \p s -> case p of
      InL t -> alg t s
      InR q ->
        op
          (e.hmap
             (passingF e)
             (coFunctor e)
             (\c -> bind (c s) (\o -> val (outValue o)))
             q)
          (\x -> val (MkOut x s))
  }

data Res a = Failed Int | Ok a

failing : Handler (exception Int)
failing =
  { M = \a -> Res a
  , ret = \x -> Ok x
  , bind = \m k -> case m of
      Failed e -> Failed e
      Ok x -> k x
  , malg = \p -> case p of
      Throw e -> Failed e
      Catch c h -> case c of
        Failed e -> h e
        Ok x -> Ok x
  }

-- | `n` rounds of the four, stacked
stacked : Int -> Res (Out (Out Int))
stacked n =
  let c1 =
    handle
      (through reader W2 (\t -> case t of
       Ask k -> val (k 7)))
      (loop
         (rd := _)
         (wr := _)
         (st := _)
         (ex := _)
         n
         0
         0)
  in let c2 =
    handle
      (passing writer W3 (\t s -> case t of
       Tell v x -> val (MkOut x (s + v))))
      c1
      0
  in let c3 =
    handle
      (passing (state Int) (exception Int) (\t s -> case t of
       Get k -> val (MkOut (k s) s)
       Put st x -> val (MkOut x st)))
      c2
      1
  in handle failing c3

stackedSome : Res (Out (Out Int))
stackedSome = stacked 3000

stackedNone : Res (Out (Out Int))
stackedNone = stacked 0

-- | the state and the exceptions alone, a throw escaping
escaped : Res (Out Int)
escaped =
  handle
    failing
    (handle
       (passing (state Int) (exception Int) (\t s -> case t of
        Get k -> val (MkOut (k s) s)
        Put st x -> val (MkOut x st)))
       (escaping (st := _) (ex := _) 5000 0)
       1)
