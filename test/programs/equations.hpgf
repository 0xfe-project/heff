def Bool : Type := sum
  'true
  'false
end

def Nat : Type := sum
  'zero
  'succ Nat
end

def List (A : Type) : Type := sum
  'nil
  'cons A (List A)
end

def not : Bool -> Bool where
  not 'true := 'false
  not 'false := 'true
end

def plus : Nat -> Nat -> Nat where
  plus 'zero n := n
  plus ('succ m) n := 'succ (plus m n)
end

def and : Bool -> Bool -> Bool where
  and 'true b := b
  and _ _ := 'false
end

def eq : Nat -> Nat -> Bool where
  eq 'zero 'zero := 'true
  eq ('succ m) ('succ n) := eq m n
  eq _ _ := 'false
end

def map (A : Type) (B : Type) (f : A -> B) : List A -> List B where
  map A B f 'nil := 'nil
  map A B f ('cons y ys) := 'cons (f y) (map A B f ys)
end

def pred : Nat -> Nat where
  pred ('succ ('succ n)) := 'succ n
  pred _ := 'zero
end

def two : Nat := 'succ ('succ 'zero)
def four : Nat := plus two two
def t1 : Bool := eq four (plus 'zero four)
def t2 : Bool := eq four two
def t3 : Bool := and (not 'false) t1
def ones : List Nat := map Nat Nat (n => plus n ('succ 'zero)) ('cons 'zero ('cons two 'nil))
def p3 : Nat := pred ('succ ('succ ('succ 'zero)))
