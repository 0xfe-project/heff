-- Maps and sets, compiled as the interpreter computes them.

import std.map as Map
import std.set as Set

many : Map.Map Int Int
many =
  Map.fromList
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 5000))

fewer : Map.Map Int Int
fewer = List.foldl (\m k -> Map.delete m k) many (List.range 0 5000)

sizes : List Int
sizes = [Map.size many, Map.size fewer]

valid : Bool
valid = Map.valid many && Map.valid fewer

found : Maybe Int
found = Map.lookup many 7919

words : List String
words = Set.toList (Set.fromList (split " " "the cat the hat a cat"))

-- (a word's count, by one walk down the tree each; a key gone and
-- another bound, by `alter`)
counted : Map.Map String Int
counted =
  List.foldl
    (\m w -> Map.update m w 1 (\new old -> new + old))
    Map.empty
    (words' "the cat the hat a cat the end")
  where
  words' : String -> List String
  words' s = split " " s

altered : Map.Map Int Int
altered =
  List.foldl
    (\m k ->
       Map.alter
         m
         k
         (\old ->
            if k % 3 == 0 then Nothing else Just (maybe k (\v -> v + k) old)))
    many
    (List.range 0 3000)

counts : List (Pair String Int)
counts = Map.toList counted

alteredSize : Int
alteredSize = Map.size altered

alteredValid : Bool
alteredValid =
  Map.valid altered
  && Map.valid counted

-- (strings found in strings, and ordered at once)
finds : List (Maybe Int)
finds =
  [ indexOf "at" "the cat the hat"
  , indexFrom "at" "the cat the hat" 6
  , indexFrom "" "ab" 2
  , indexFrom "ab" "ab" 1
  , indexOf "\u{e9}t\u{e9}" "\u{e9}t\u{e9}"
  ]

pieces : List String
pieces = List.append (lines "one\ntwo\n\nthree") (split "--" "a--b----c")

orders : List Ordering
orders =
  List.map
    (\p -> compareString (fst p) (snd p))
    [ MkPair "abcdefgh1" "abcdefgh2"
    , MkPair "abcdefgh" "abcdefgh"
    , MkPair "abcdefghij" "abcdefgh"
    , MkPair "z" "\u{e9}"
    , MkPair "" "a"
    ]
