-- Maps and sets, compiled as the interpreter computes them.

import map as Map
import set as Set

many : Map.Map Int Int
many =
  Map.fromList
    compareInt
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 5000))

fewer : Map.Map Int Int
fewer = List.foldl (\m k -> Map.delete compareInt k m) many (List.range 0 5000)

sizes : List Int
sizes = [Map.size many, Map.size fewer]

valid : Bool
valid = Map.valid compareInt many && Map.valid compareInt fewer

found : Maybe Int
found = Map.lookup compareInt 7919 many

words : List String
words = Set.toList (Set.fromList compareString (split " " "the cat the hat a cat"))
