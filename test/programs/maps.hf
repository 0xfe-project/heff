-- Maps and sets, compiled as the interpreter computes them.

import map as M
import set as S

many : M.Map Int Int
many =
  M.fromList
    compareInt
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 5000))

fewer : M.Map Int Int
fewer = List.foldl (\m k -> M.delete compareInt k m) many (List.range 0 5000)

sizes : List Int
sizes = [M.size many, M.size fewer]

valid : Bool
valid = M.valid compareInt many && M.valid compareInt fewer

found : Maybe Int
found = M.lookup compareInt 7919 many

words : List String
words = S.toList (S.fromList compareString (split " " "the cat the hat a cat"))
