-- Hash maps, compiled as the interpreter computes them:
-- the hashes, and so the order of `toList`, the same on every backend.

module test.programs.hashmaps

import std.hashmap as HashMap

hashes : List Int
hashes =
  List.append
    (List.map
       (\(s : String) -> HashMap.hash s)
       ["", "a", "hello, world", "\u{e9}t\u{e9}", "eight by", "nine bytes"])
    (List.map
       (\(i : Int) -> HashMap.hash i)
       [ 0
       , 1
       , -1
       , 4611686018427387903
       , -4611686018427387904
       , 18446744073709551619
       , -1180591620717411291079
       ])

-- (a range's hash and its comparison, held to its slice's: in range,
-- clamped, negative from the end, empty, long enough to be a view)
ranges : List (Pair Int Int)
ranges =
  [ MkPair 0 0
  , MkPair 0 1
  , MkPair 3 11
  , MkPair 7 12
  , MkPair 0 200
  , MkPair 5 3
  , MkPair (-5) (-1)
  , MkPair (-200) 4
  , MkPair 1 99
  , MkPair 20 100
  ]

ranged : String
ranged =
  "hello, world: "
  ^ joinWith "" (List.map (\(i : Int) -> showInt i) (List.range 0 40))

rangeHashes : List Bool
rangeHashes =
  List.map
    (\(p : Pair Int Int) ->
       HashMap.strHashRange ranged (fst p) (snd p)
       == HashMap.strHash (strSlice ranged (fst p) (snd p)))
    ranges

rangeHashValues : List Int
rangeHashValues =
  List.map
    (\(p : Pair Int Int) -> HashMap.strHashRange ranged (fst p) (snd p))
    ranges

rangeEqs : List Bool
rangeEqs =
  List.map
    (\(p : Pair Int Int) ->
       HashMap.strEqRange
         (strSlice ranged (fst p) (snd p))
         ranged
         (fst p)
         (snd p))
    ranges

rangeDiffers : List Bool
rangeDiffers =
  [ HashMap.strEqRange "hello" ranged 0 4
  , HashMap.strEqRange "hellp" ranged 0 5
  , HashMap.strEqRange "" ranged 9 9
  , HashMap.strEqRange "ello" ranged 1 5
  ]

slots : List Int
slots =
  List.map
    (\(h : Int) -> HashMap.trieSlot 2863311530 h 0)
    [0, 1, 2, 31, 63, -1, 1180591620717411303424]

-- (keys whose hashes share their first levels, and some that collide:
-- a hash of our own, a key's last digit only)
data Digit = MkDigit Int

instance instanceEqualityDigit : Equality Digit
instanceEqualityDigit = { equal = \a b -> same a b }
  where
  same : Digit -> Digit -> Bool
  same (MkDigit x) (MkDigit y) = x == y

instance instanceHashDigit : HashMap.Hash Digit
instanceHashDigit = { hash = \d -> lastDigit d }
  where
  lastDigit : Digit -> Int
  lastDigit (MkDigit x) = x % 10

many : HashMap.HashMap Int Int
many =
  HashMap.fromList
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 3000))

fewer : HashMap.HashMap Int Int
fewer = List.foldl (\m k -> HashMap.delete m k) many (List.range 0 6000)

sizes : List Int
sizes =
  [ HashMap.size many
  , HashMap.size fewer
  , HashMap.size
    (List.foldl (\m k -> HashMap.delete m k) many (List.range 0 10007))
  ]

found : List (Maybe Int)
found = List.map (\k -> HashMap.lookup many k) [7919, 0, 8000, 10006]

pairs : List (Pair Int Int)
pairs = List.take 20 (HashMap.toList fewer)

counted : HashMap.HashMap String Int
counted =
  List.foldl
    (\m w -> HashMap.update m w 1 (\new old -> new + old))
    HashMap.empty
    (split " " "the cat the hat a cat the end")

counts : List (Pair String Int)
counts = HashMap.toList counted

altered : HashMap.HashMap Int Int
altered =
  List.foldl
    (\m k ->
       HashMap.alter
         m
         k
         (\old ->
            if k % 3 == 0 then Nothing else Just (maybe k (\v -> v + k) old)))
    many
    (List.range 0 3000)

alteredSum : Pair Int Int
alteredSum =
  MkPair (HashMap.size altered) (HashMap.foldl (\n k v -> n + k * v) 0 altered)

collided : HashMap.HashMap Digit String
collided =
  List.foldl
    (\m i -> HashMap.insert m (MkDigit i) (debug i))
    HashMap.empty
    (List.range 0 40)

collidedOut : List (Maybe String)
collidedOut =
  List.map
    (\i -> HashMap.lookup (HashMap.delete collided (MkDigit 13)) (MkDigit i))
    [3, 13, 23, 40, 41]

collidedSize : List Int
collidedSize =
  [ HashMap.size collided
  , HashMap.size
    (List.foldl
       (\m i -> HashMap.delete m (MkDigit i))
       collided
       (List.range 0 35))
  ]

-- (the count a map keeps, held to one counted: after binding keys new
-- and bound, deleting keys there and not, altering keys to none and to
-- one; and a delete counted by the size it leaves)
kept : List (Pair Int Int)
kept =
  List.map
    (\m -> MkPair (HashMap.size m) (HashMap.foldl (\n k v -> n + 1) 0 m))
    [ many
    , fewer
    , altered
    , HashMap.update many 7919 5 (\new old -> new + old)
    , HashMap.update many 1 5 (\new old -> new + old)
    , HashMap.delete many 7919
    , HashMap.delete many 0
    , HashMap.alter many 7919 (\old -> Nothing)
    , HashMap.alter many 0 (\old -> Nothing)
    , HashMap.alter many 0 (\old -> Just 1)
    , HashMap.empty
    ]

collidedKept : List Int
collidedKept =
  [ HashMap.size (HashMap.delete collided (MkDigit 13))
  , HashMap.size (HashMap.delete collided (MkDigit 99))
  , HashMap.size (HashMap.insert collided (MkDigit 13) "again")
  , HashMap.size (HashMap.insert collided (MkDigit 41) "new")
  , HashMap.size (HashMap.alter collided (MkDigit 41) (\old -> Just "new"))
  ]

-- (keys removed, each counted as `remove` says it was there, and the
-- values they were bound to summed)
tallied : Pair Int Int -> Maybe Int -> Pair Int Int
tallied (MkPair n total) Nothing = MkPair n total
tallied (MkPair n total) (Just v) = MkPair (n + 1) (total + v)

removing : Pair (Pair Int Int) (HashMap.HashMap Int Int)
         -> Pair (Maybe Int) (HashMap.HashMap Int Int)
         -> Pair (Pair Int Int) (HashMap.HashMap Int Int)
removing (MkPair c m0) (MkPair old m) = MkPair (tallied c old) m

removedCount : Pair Int Int
removedCount =
  fst
    (List.foldl
       (\acc k -> removing acc (HashMap.remove (snd acc) k))
       (MkPair (MkPair 0 0) many)
       (List.range 0 10007))

collidedRemoved : List (Maybe String)
collidedRemoved =
  List.map
    (\i -> fst (HashMap.remove collided (MkDigit i)))
    [3, 13, 41]

composite : List (Maybe Int)
composite =
  List.map
    (\k -> HashMap.lookup table k)
    [MkPair "a" [1, 2], MkPair "b" [], MkPair "a" [2, 1]]
  where
  table : HashMap.HashMap (Pair String (List Int)) Int
  table =
    HashMap.fromList [MkPair (MkPair "a" [1, 2]) 12, MkPair (MkPair "b" []) 0]
