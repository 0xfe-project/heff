-- Hash maps, compiled as the interpreter computes them:
-- the hashes, and so the order of `toList`, the same on every backend.

import std.hashmap as HashMap

hashes : List Int
hashes =
  List.append
    (List.map
       (\(s : String) -> HashMap.hash s)
       ["", "a", "hello, world", "\u{e9}t\u{e9}", "eight by", "nine bytes"])
    (List.map
       (\(i : Int) -> HashMap.hash i)
       [ 0
       , 1
       , -1
       , 4611686018427387903
       , -4611686018427387904
       , 18446744073709551619
       , -1180591620717411291079
       ])

slots : List Int
slots =
  List.map
    (\(h : Int) -> HashMap.trieSlot 2863311530 h 0)
    [0, 1, 2, 31, 63, -1, 1180591620717411303424]

-- (keys whose hashes share their first levels, and some that collide:
-- a hash of our own, a key's last digit only)
data Digit = MkDigit Int

instance instanceEqualityDigit : Equality Digit
instanceEqualityDigit = { equal = \a b -> same a b }
  where
  same : Digit -> Digit -> Bool
  same (MkDigit x) (MkDigit y) = x == y

instance instanceHashDigit : HashMap.Hash Digit
instanceHashDigit = { hash = \d -> lastDigit d }
  where
  lastDigit : Digit -> Int
  lastDigit (MkDigit x) = x % 10

many : HashMap.HashMap Int Int
many =
  HashMap.fromList
    (List.map (\i -> MkPair ((i * 7919) % 10007) i) (List.range 1 3000))

fewer : HashMap.HashMap Int Int
fewer = List.foldl (\m k -> HashMap.delete m k) many (List.range 0 6000)

sizes : List Int
sizes =
  [ HashMap.size many
  , HashMap.size fewer
  , HashMap.size
    (List.foldl (\m k -> HashMap.delete m k) many (List.range 0 10007))
  ]

found : List (Maybe Int)
found = List.map (\k -> HashMap.lookup many k) [7919, 0, 8000, 10006]

pairs : List (Pair Int Int)
pairs = List.take 20 (HashMap.toList fewer)

counted : HashMap.HashMap String Int
counted =
  List.foldl
    (\m w -> HashMap.update m w 1 (\new old -> new + old))
    HashMap.empty
    (split " " "the cat the hat a cat the end")

counts : List (Pair String Int)
counts = HashMap.toList counted

altered : HashMap.HashMap Int Int
altered =
  List.foldl
    (\m k ->
       HashMap.alter
         m
         k
         (\old ->
            if k % 3 == 0 then Nothing else Just (maybe k (\v -> v + k) old)))
    many
    (List.range 0 3000)

alteredSum : Pair Int Int
alteredSum =
  MkPair (HashMap.size altered) (HashMap.foldl (\n k v -> n + k * v) 0 altered)

collided : HashMap.HashMap Digit String
collided =
  List.foldl
    (\m i -> HashMap.insert m (MkDigit i) (show i))
    HashMap.empty
    (List.range 0 40)

collidedOut : List (Maybe String)
collidedOut =
  List.map
    (\i -> HashMap.lookup (HashMap.delete collided (MkDigit 13)) (MkDigit i))
    [3, 13, 23, 40, 41]

collidedSize : List Int
collidedSize =
  [ HashMap.size collided
  , HashMap.size
    (List.foldl
       (\m i -> HashMap.delete m (MkDigit i))
       collided
       (List.range 0 35))
  ]

composite : List (Maybe Int)
composite =
  List.map
    (\k -> HashMap.lookup table k)
    [MkPair "a" [1, 2], MkPair "b" [], MkPair "a" [2, 1]]
  where
  table : HashMap.HashMap (Pair String (List Int)) Int
  table =
    HashMap.fromList [MkPair (MkPair "a" [1, 2]) 12, MkPair (MkPair "b" []) 0]
