-- A tag checked at a function type is eta-expanded (#89): `MkBox` at
-- `Int -> Box` is `\x -> MkBox x`, and `MkP 1` at `Int -> P` is
-- `\y -> MkP 1 y`; given to `List.map`, it waits for the function type
-- it is checked at.  Each backend held to the interpreter.

data Box = MkBox Int

data P = MkP Int Int

unbox : Box -> Int
unbox (MkBox n) = n

sumP : P -> Int
sumP (MkP a b) = a * 10 + b

mk : Int -> Box
mk = MkBox

part : Int -> P
part = MkP 1

xs : List Box
xs = List.map MkBox [1, 2]

boxed : Int
boxed = unbox (mk 7)

parted : Int
parted = sumP (part 4)

total : Int
total = List.foldl (\n b -> n + unbox b) 0 xs

pairs : List Int
pairs = List.map sumP (List.map (MkP 3) [5, 6])
