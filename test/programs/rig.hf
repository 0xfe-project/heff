theory Monoid where
  t :: Type
  m :: t -> t -> t

theory Rig where
  t :: Type
  plus :: Monoid ~ { t = t }
  times :: Monoid ~ { t = t }

blah :: (R :: Rig) -> (x :: R.t) -> R.t
blah R x = R.plus.m x (R.times.m x x)

data Bool = 'true | 'false

Or :: Monoid ~ { t = Bool }
Or = { t = Bool, m = \x y -> case x of
  'true -> 'true
  'false -> y }

And :: Monoid ~ { t = Bool }
And = { t = Bool, m = \x y -> case x of
  'true -> y
  'false -> 'false }

BoolRig :: Rig
BoolRig = { t = Bool, plus = Or, times = And }

test0 :: Bool
test0 = blah BoolRig 'true

