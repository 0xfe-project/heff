theory Monoid where
  t : Type
  m : t -> t -> t

theory Rig where
  t : Type
  plus : Monoid ~ { t = t }
  times : Monoid ~ { t = t }

blah : (R : Rig) -> (x : R.t) -> R.t
blah R x = R.plus.m x (R.times.m x x)

data Bool = True | False

Or : Monoid ~ { t = Bool }
Or =
  { t = Bool
  , m = \x y -> case x of
      True -> True
      False -> y
  }

And : Monoid ~ { t = Bool }
And =
  { t = Bool
  , m = \x y -> case x of
      True -> y
      False -> False
  }

BoolRig : Rig
BoolRig = { t = Bool, plus = Or, times = And }

test0 : Bool
test0 = blah BoolRig True
