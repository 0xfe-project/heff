-- The CPU-bound work heff_parallel and heff_vs_native timed against C
-- and Rust -- primes by trial division, n queens on lists, fib -- at
-- sizes every backend computes at once, their answers known: a loop of
-- arithmetic with its comparisons as conditions, a fold of closures
-- building lists, two calls a node.  Each also split into parts as those
-- experiments split it, part i of p, the parts adding up to the whole
-- whatever p is.  (The watch at the end holds the answers.)

module test.programs.cpu-kernels

-- primes ----------------------------------------------------------------------

noDivisor : Int -> Int -> Bool
noDivisor n d = if d * d > n then True else if n % d == 0 then False else noDivisor n (d + 1)

isPrime : Int -> Bool
isPrime n = n >= 2 && noDivisor n 2

countIn : Int -> Int -> Int -> Int
countIn acc i hi = if i >= hi then acc else countIn (if isPrime i then acc + 1 else acc) (i + 1) hi

-- (the greatest prime below n, 0 if there is none)
lastBelow : Int -> Int
lastBelow n = if n <= 2 then 0 else if isPrime (n - 1) then n - 1 else lastBelow (n - 1)

blockCount : Int -> Int -> Int -> Int -> Int -> Int
blockCount acc b p n part =
  if b * 512 >= n then acc
  else blockCount (if b % p == part then countIn acc (b * 512) (min n (b * 512 + 512)) else acc) (b + 1) p n part

-- | Part `i` of `p` of the primes below `n`: blocks of 512, block b to
-- | part b mod p.
primesTask : Int -> Int -> Int -> Int
primesTask n p i = blockCount 0 0 p n i

primesBelow10000 : Int
primesBelow10000 = countIn 0 0 10000

lastPrimeBelow10000 : Int
lastPrimeBelow10000 = lastBelow 10000

primesSmall : List Int
primesSmall = List.filter isPrime (List.range 0 50)

-- (the same count, in 3 parts and in 7)
primesByParts : List Int
primesByParts = List.map (\p -> List.sum (List.map (primesTask 10000 p) (List.range 0 (p - 1)))) [3, 7]

-- queens ----------------------------------------------------------------------

safe : Int -> Int -> List Int -> Bool
safe c d Nil = True
safe c d (q :: qs) = c /= q && c - q /= d && q - c /= d && safe c (d + 1) qs

place : Int -> Int -> List Int -> Int
place n row qs =
  if row == n then 1
  else List.foldl (\acc c -> if safe c 1 qs then acc + place n (row + 1) (c :: qs) else acc) 0 (List.range 0 (n - 1))

queens : Int -> Int
queens n = place n 0 Nil

-- (the first two rows, safe)
openings : Int -> List (List Int)
openings n =
  List.foldr (\a acc -> List.foldr (\b acc2 -> if safe b 1 [a] then [b, a] :: acc2 else acc2) acc (List.range 0 (n - 1))) [] (List.range 0 (n - 1))

-- | Part `i` of `p` of the `n` queens' solutions: opening j to part j
-- | mod p.
queensTask : Int -> Int -> Int -> Int
queensTask n p i =
  fst (List.foldl (\st qs -> MkPair (if snd st % p == i then fst st + place n 2 qs else fst st) (snd st + 1)) (MkPair 0 0) (openings n))

queens6to8 : List Int
queens6to8 = List.map queens [6, 7, 8]

openings8 : Int
openings8 = List.length (openings 8)

-- (7 queens' 40, in 1, 2 and 5 parts)
queensByParts : List Int
queensByParts = List.map (\p -> List.sum (List.map (queensTask 7 p) (List.range 0 (p - 1)))) [1, 2, 5]

-- fib -------------------------------------------------------------------------

fib : Int -> Int
fib n = if n < 2 then n else fib (n - 1) + fib (n - 2)

-- (fib n's calls `d` deep: what is left to compute at each)
leaves : Int -> Int -> List Int
leaves d n = if d == 0 || n < 2 then [n] else leaves (d - 1) (n - 1) ++ leaves (d - 1) (n - 2)

sumEvery : Int -> Int -> Int -> List Int -> Int
sumEvery acc j p Nil = acc
sumEvery acc j p (x :: xs) = sumEvery (if j == 0 then acc + fib x else acc) (if j == 0 then p - 1 else j - 1) p xs

-- | Part `i` of `p` of fib `n`: its leaves 7 deep, leaf j to part j mod
-- | p.
fibTask : Int -> Int -> Int -> Int
fibTask n p i = sumEvery 0 i p (leaves 7 n)

fib20 : Int
fib20 = fib 20

fibSmall : List Int
fibSmall = List.map fib (List.range 0 12)

leavesOf20 : Int
leavesOf20 = List.length (leaves 7 20)

fibByParts : List Int
fibByParts = List.map (\p -> List.sum (List.map (fibTask 20 p) (List.range 0 (p - 1)))) [1, 2, 6]

-- (by a loop, far past a word: from fib 91 on, a sum is no word)
fibIter : Int -> Int -> Int -> Int
fibIter 0 a b = a
fibIter n a b = fibIter (n - 1) b (a + b)

fib100 : Int
fib100 = fibIter 100 0 1

-- the answers -------------------------------------------------------------------

-- (one watch for them all: a watch computes the file's definitions anew)
