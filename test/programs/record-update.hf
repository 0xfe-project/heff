-- A record with some fields replaced, `{ r | x = v }`: the rest are
-- `r`'s, `r` computed once; `x.y = v` sets a field of a field.

module test.programs.record-update

type Body =
  { x : Float64, y : Float64, vx : Float64, vy : Float64, mass : Float64 }

move : Float64 -> Body -> Body
move dt b = { b | x = b.x + dt * b.vx, y = b.y + dt * b.vy }

moved : Body
moved = move 0.5 { x = 1.0, y = 2.0, vx = 2.0, vy = 4.0, mass = 3.0 }

type Opts = { name : String, verbose : Bool = False, label : String = name }

-- (a field not set keeps the record's value, its default not given again)
opts : Opts
opts = { name = "a", label = "x" }

renamed : Opts
renamed = { opts | name = "b" }

type Pos = { px : Int, py : Int }

type Sprite = { pos : Pos, id : Int }

-- (the settings under `pos` are put together, in any order)
sprite : Sprite
sprite = { pos = { px = 1, py = 2 }, id = 7 }

nudged : Sprite
nudged = { sprite | pos.py = 20, id = 8, pos.px = 10 }

-- (`f { r | ... }`: the braces hold the update)
ids : List Int
ids = List.map (\(s : Sprite) -> s.id) [nudged, { nudged | id = 9 }]

-- (`r` is any expression, computed once)
fresh : Int -> Sprite
fresh n = { pos = { px = n, py = n }, id = n }

again : Sprite
again = { fresh 3 | id = 4 }

-- (`r` in the settings is the binder's, not the update's)
r : Int
r = 5

shadowed : Sprite
shadowed = { again | id = r }
