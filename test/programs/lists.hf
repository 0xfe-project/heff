-- List literals, compiled as the interpreter computes them.

import prelude

small :: List Int
small = [1, 2, 3]

describe :: List Int -> String
describe [] = "empty"
describe [x] = "one"
describe [x, y] = "two"
describe (Cons x rest) = "many"

described :: List String
described = map describe [[], [7], [1, 2], small]

nested :: List (List Bool)
nested = [[True], [], [False, True]]
