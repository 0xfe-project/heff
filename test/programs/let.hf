-- `let`, compiled: a value computed once, where it is written -- under a
-- condition, not before it (a later part that would abandon stays
-- unreached) -- a pattern taking a value apart, a chain of them, and a
-- `let` in a loop and in a `do` block.

module test.programs.let

digitAt : String -> Int -> Bool
digitAt s i = i < strLength s && (let c = byteAt s i in 48 <= c && c <= 57)

digits : List Bool
digits = [digitAt "a1" 1, digitAt "a1" 0, digitAt "a1" 5]

guarded : Int -> Int
guarded n = if n > 0 then (let x = 100 / n in x + 1) else 0

swap : Pair Int String -> Pair String Int
swap p = let MkPair a b = p in MkPair b a

chain : Int -> Int
chain n =
  let a = n + 1
  in let b = a * 2
  in let MkPair c d : Pair Int Int = MkPair b a
  in c * 100 + d

sumTo : Int -> Int -> Int
sumTo acc n = if n == 0 then acc else (let m = n - 1 in sumTo (acc + n) m)

bind : {a b : Type} -> Maybe a -> (a -> Maybe b) -> Maybe b
bind Nothing k = Nothing
bind (Just x) k = k x

stmts : Int -> Maybe Int
stmts n = do
  x <- Just n
  let y = x + 1
  let MkPair a b : Pair Int Int = MkPair y x
  Just (a * 10 + b)

results : List Int
results = [guarded 0, guarded 4, chain 3, sumTo 0 100000]

swapped : Pair String Int
swapped = swap (MkPair 1 "a")

done : Maybe Int
done = stmts 4
