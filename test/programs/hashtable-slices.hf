-- A hash table's keys looked for as parts of a string (`updateBy`,
-- `lookupBy` of a `HashMap.slice`), held to the slices made: the k-mers of a string
-- counted both ways, short and long enough to be views.

module test.programs.hashtable-slices

import std.hashmap as HashMap
import std.hashtable as HashTable

text : String
text =
  joinWith
    ""
    (List.map
       (\(i : Int) ->
          if i % 3 == 0 then "ACGT" else if i % 5 == 0 then "GG" else "TA")
       (List.range 0 300))

bySlice : Int -> HashTable.HashTable String Int
bySlice k =
  List.foldl
    (\t i ->
       HashTable.updateBy
         t
         (HashMap.slice text i (i + k))
         1
         (\new old -> new + old))
    HashTable.empty
    (List.range 0 (strLength text - k))

byString : Int -> HashMap.HashMap String Int
byString k =
  List.foldl
    (\m i ->
       HashMap.update m (strSlice text i (i + k)) 1 (\new old -> new + old))
    HashMap.empty
    (List.range 0 (strLength text - k))

-- (each count the same, both ways, and found by `lookupBy` too)
agreeOn : Int
        -> HashTable.HashTable String Int
        -> HashMap.HashMap String Int
        -> Bool
agreeOn k t m =
  HashTable.size t == HashMap.size m
  && HashMap.foldl
    (\ok key n -> ok && equal (HashTable.lookup t key) (Just n))
    True
    m
  && List.all
    (\i ->
       equal
         (HashTable.lookupBy t (HashMap.slice text i (i + k)))
         (HashMap.lookup m (strSlice text i (i + k))))
    (List.range 0 (strLength text - k))

agree : Int -> Bool
agree k = agreeOn k (bySlice k) (byString k)

agreed : List Bool
agreed = List.map agree [1, 2, 3, 6, 12, 70, 100]

counts : List (Pair String Int)
counts = HashTable.toList (bySlice 2)

missing : List (Maybe Int)
missing =
  [ HashTable.lookupBy (bySlice 2) (HashMap.slice "xxCCx" 2 4)
  , HashTable.lookupBy
    (HashTable.empty : HashTable.HashTable String Int)
    (HashMap.slice text 0 2)
  , HashTable.lookupBy (bySlice 2) (HashMap.slice text 0 2)
  ]
