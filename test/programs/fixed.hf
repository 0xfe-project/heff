int8s : String
int8s = suite i8

int16s : String
int16s = suite i16

int32s : String
int32s = suite i32

int64s : String
int64s = suite i64

uint8s : String
uint8s = suite u8

uint16s : String
uint16s = suite u16

uint32s : String
uint32s = suite u32

uint64s : String
uint64s = suite u64

wraps : String
wraps =
  joinWith
    "\n"
    [ wrapped i8
    , wrapped i16
    , wrapped i32
    , wrapped i64
    , wrapped u8
    , wrapped u16
    , wrapped u32
    , wrapped u64
    ]

-- (literals, each of its type, and the operators)
literals : String
literals =
  joinWith
    " "
    [ I8.show (I8.add 127 1)
    , U8.show (U8.sub 0 1)
    , I32.show (I32.mul 65536 65536)
    , U32.show (U32.add 4294967295 2)
    , I64.show (I64.add 9223372036854775807 1)
    , U64.show (U64.mul 18446744073709551615 18446744073709551615)
    , I16.show (complement 0)
    , U16.show (complement 0)
    , bool (I32.lt (-1) 0)
    , bool (U32.lt 4294967295 0)
    ]

-- (a division by zero is 0, its remainder the dividend, as an `Int`'s
-- are)
int32ByZero : String
int32ByZero = I32.show (I32.div 1 0) ^ " " ^ I32.show (I32.rem 1 0)

uint64ByZero : String
uint64ByZero = U64.show (U64.div 1 0) ^ " " ^ U64.show (U64.rem 1 0)

-- (the prelude's operators at each, by its module's instances)
operators : String
operators =
  joinWith
    " "
    [ I8.show (127 + 1 - 3 * 2)
    , U8.show (0 - 1)
    , I16.show (-(-32768))
    , U16.show (65535 * 65535 / 3 % 1000)
    , I32.show (65536 * 65536 / 3 + 7 % 0)
    , U32.show (and 4294967295 (shiftL 1 31) + xor 1 3)
    , I64.show (-(9223372036854775807 + 1) / -1)
    , U64.show (18446744073709551615 * 3 + complement 0)
    , bool (-1 < (0 : Int32) && max (200 : UInt8) 100 >= 200)
    , bool (compare (1 : UInt64) 18446744073709551615 == LT)
    ]

int8Least : String
int8Least = I8.show (I8.div (-128) (-1)) ^ " " ^ I8.show (I8.rem (-128) (-1))

int64Least : String
int64Least =
  I64.show (I64.div (-9223372036854775808) (-1))
  ^ " "
  ^ I64.show (I64.rem (-9223372036854775808) (-1))
