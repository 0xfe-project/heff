-- The fixed-width integers, each backend held to the interpreter: every
-- operation of each type on every pair of some values (each an integer
-- wrapped around to the type), shown.  (A value of one is shown as a
-- string: a number does not say its type, where a backend shows it.)

import int16 as I16
import int32 as I32
import int64 as I64
import int8 as I8
import uint16 as U16
import uint32 as U32
import uint64 as U64
import uint8 as U8

-- | an integer type's operations
type Ops t =
  { add : t -> t -> t
  , sub : t -> t -> t
  , mul : t -> t -> t
  , div : t -> t -> t
  , rem : t -> t -> t
  , eq : t -> t -> Bool
  , lt : t -> t -> Bool
  , le : t -> t -> Bool
  , and : t -> t -> t
  , or : t -> t -> t
  , xor : t -> t -> t
  , shl : t -> t -> t
  , shr : t -> t -> t
  , show : t -> String
  , fromInt : Int -> t
  , toInt : t -> Int
  }

samples : List Int
samples =
  [ 0
  , 1
  , -1
  , 2
  , 7
  , -7
  , 31
  , 33
  , 127
  , -128
  , 255
  , 256
  , 32767
  , -32768
  , 65535
  , 2147483647
  , -2147483648
  , 4294967295
  , 9223372036854775807
  , -9223372036854775808
  , 18446744073709551615
  , 12345678901234567890
  , -98765432109876543
  ]

bool : Bool -> String
bool True = "T"
bool False = "F"

-- (the operations of two values, shown; division by 0 too: 0, its
-- remainder the dividend)
pairShown : {t : Type} -> Ops t -> t -> t -> String
pairShown o x y =
  joinWith
    " "
    [ o.show (o.add x y)
    , o.show (o.sub x y)
    , o.show (o.mul x y)
    , o.show (o.div x y)
    , o.show (o.rem x y)
    , bool (o.eq x y)
    , bool (o.lt x y)
    , bool (o.le x y)
    , o.show (o.and x y)
    , o.show (o.or x y)
    , o.show (o.xor x y)
    , o.show (o.shl x y)
    , o.show (o.shr x y)
    ]

suite : {t : Type} -> Ops t -> String
suite o =
  joinWith
    "\n"
    (List.concatMap
       (\x -> List.map (\y -> pairShown o x y) (List.map o.fromInt samples))
       (List.map o.fromInt samples))

-- (each value, wrapped around, and back as an integer)
wrapped : {t : Type} -> Ops t -> String
wrapped o =
  joinWith " " (List.map (\n -> showInt (o.toInt (o.fromInt n))) samples)

i8 : Ops Int8
i8 =
  { add = I8.add
  , sub = I8.sub
  , mul = I8.mul
  , div = I8.div
  , rem = I8.rem
  , eq = I8.eq
  , lt = I8.lt
  , le = I8.le
  , and = and
  , or = or
  , xor = xor
  , shl = shiftL
  , shr = shiftR
  , show = I8.show
  , fromInt = I8.fromInt
  , toInt = I8.toInt
  }

