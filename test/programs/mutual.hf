-- Definitions of a `mutual` block, compiled: each a field of a record
-- the block knots, called through it.

mutual
  even : Int -> Bool
  even 0 = True
  even n = odd (n - 1)

  odd : Int -> Bool
  odd 0 = False
  odd n = even (n - 1)

data Expr = Num Int | Add Expr Expr | Neg Expr | Sum (List Expr)

mutual
  eval : Expr -> Int
  eval (Num n) = n
  eval (Add a b) = eval a + eval b
  eval (Neg e) = 0 - eval e
  eval (Sum es) = evalAll es 0

  evalAll : List Expr -> Int -> Int
  evalAll Nil acc = acc
  evalAll (Cons e es) acc = evalAll es (acc + eval e)

evens : List Bool
evens = List.map even [0, 1, 2, 3, 10]

odds : List Bool
odds = List.map odd [0, 1, 2, 3, 7]

total : Int
total = eval (Sum [Num 1, Add (Num 2) (Neg (Num 3)), Sum [Num 4, Num 5]])

empty : Int
empty = eval (Sum Nil)

type Step = Int -> Int

mutual
  down : Step
  down 0 = 0
  down n = up (n - 1)

  up : Step
  up n = down n + 1

stepped : Int
stepped = down 4
