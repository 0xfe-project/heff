-- `f $ x` is `f x`, looser than any other operator and to the right:
-- the prelude's, and any module's (`.+.` here, declared beside nothing).
-- Inlined, it is a call of `f` itself.

twice : Int -> Int
twice x = x * 2

inc : Int -> Int
inc x = x + 1

-- (a module's own operator, declared above none)
infixl .+.

(.+.) : Int -> Int -> Int
(.+.) a b = a * 10 + b

-- to the right: `twice (inc (twice 3))`
nested : Int
nested = twice $ inc $ twice 3

-- >>> nested
-- 14

-- looser than arithmetic: `twice (1 + 2 * 3)`
summed : Int
summed = twice $ 1 + 2 * 3

-- >>> summed
-- 14

shown : String
shown = showInt $ 4 + 5 * 6

-- >>> shown
-- "34"

-- than `::` and `++`
consed : List Int
consed = List.map inc $ 1 :: [2] ++ [3]

-- >>> consed
-- Cons 2 (Cons 3 (Cons 4 Nil))

-- than `^`
joined : String
joined = (\s -> s ^ "!") $ "a" ^ "b"

-- >>> joined
-- "ab!"

-- than the comparisons, `&&` and `||`
tested : Bool
tested = not $ 1 < 2 && 2 < 1 || 3 == 4

-- >>> tested
-- True

-- than a float's
halved : Float
halved = sqrt $ 2.0 *. 8.0

-- >>> halved
-- 4.0

-- than an operator declared above nothing
digits : Int
digits = twice $ 1 .+. 2 .+. 3

-- >>> digits
-- 246

-- a lambda, an `if`, after it
lambda : Int
lambda = List.foldl (\a b -> a + b) 0 $ List.map (\x -> x * x) $ [1, 2, 3]

-- >>> lambda
-- 14

chosen : Int
chosen = twice $ if nested > 10 then 1 else 2

-- >>> chosen
-- 2

-- `($)` named: applied, and given to another
applied : List Int
applied = List.map (flip ($) 5) [twice, inc]

-- >>> applied
-- Cons 10 (Cons 6 Nil)

-- (inlined: a direct call of `f`)
call : (Int -> Int) -> Int -> Int
call f n = f $ n + 1

-- >>> call twice 4
-- 10
