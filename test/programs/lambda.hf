data Nat = Zero | Succ Nat

data Bwd (A : Type) = Nil | Snoc (Bwd A) A

Bwd/elemAt : (A : Type) -> (xs : Bwd A) -> (n : Nat) -> A
Bwd/elemAt A Nil n = abandon
Bwd/elemAt A (Snoc xs x) Zero = x
Bwd/elemAt A (Snoc xs x) (Succ n) = Bwd/elemAt A xs n

data Stx = Var Nat | App Stx Stx | Lam Stx

data Val = Neu Nat (Bwd Val) | Lam (Val -> Val)

Env : Type
Env = Bwd Val

app : (v0 : Val) -> (v1 : Val) -> Val
app (Neu i vs) v1 = Neu i (Snoc vs v1)
app (Lam f) v1 = f v1

eval : (e : Bwd Val) -> (t : Stx) -> Val
eval e (Var i) = Bwd/elemAt Val e i
eval e (App t0 t1) = app (eval e t0) (eval e t1)
eval e (Lam t) = Lam (\v -> eval (Snoc e v) t)

theory Quote/typeof where
  spine : Bwd Val -> Stx -> Stx
  val : Val -> Stx

Quote : (n : Nat) -> Quote/typeof
Quote n =
  { spine = \sp t -> case sp of
      Nil -> t
      Snoc sp v -> App ((Quote n).spine sp t) ((Quote n).val v)
  , val = \v -> case v of
      Neu i vs -> (Quote n).spine vs (Var i)
      Lam f -> Lam ((Quote (Succ n)).val (f (Neu n Nil)))
  }

norm : (t : Stx) -> Stx
norm t = (Quote Zero).val (eval Nil t)

t0 : Stx
t0 = norm (Lam (App (Lam (Var Zero)) (Var Zero)))
