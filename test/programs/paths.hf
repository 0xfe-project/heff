-- Paths compiled as interpreted: the host's style (`onWindows`, which
-- each backend answers for the system the program runs on), a string
-- taken as a path in it, and each style asked for by name.

module test.programs.paths

import std.path as Path

host : Bool
host = onWindows MkUnit

-- (a string where a path is expected, read in the host's style)
taken : Path.Path
taken = "src/heff/../main.hf"

joined : String
joined = toString (Path.normal taken / "x.hf")

posix : List String
posix = Path.segments (Path.parse (os := Posix) "/a\\b/c")

windows : String
windows =
  Path.render
    (os := Windows)
    (Path.parse (os := Windows) "C:/a" / "b\\c.hf")

sameEither : Bool
sameEither = Path.parse (os := Posix) "a/b" == Path.parse (os := Windows) "a\\b"
