-- Tests that need the world outside the program: integration tests,
-- each run by `heff test` in a program of its own, in a directory of its
-- own, within its time limit; and golden texts, kept beside this file.

import check
import co
import std.filesystem
import std.process

-- (did it end by itself, with this status)
exitedWith : Int -> Ended -> Bool
exitedWith n (Exited m) = n == m
exitedWith n _ = False

commands : Test
commands = group "outside"
  [ integration "a command runs in the test's own directory, new and empty" (do
      here <- workingDir
      names <- readDirectory here
      assertEqual names (Just Nil)
      written <- writeFile "note.txt" "hello\n"
      assert "the note is written" written
      r <- run { command = "cat", args = ["note.txt"] }
      assertEqual r.out "hello\n")
  , integration "a command's status is seen" (do
      r <- run { command = "sh", args = ["-c", "exit 3"] }
      assert "it exited with 3" (exitedWith 3 r.ended))
  , unit "a golden text" (golden "greeting.txt" ("hello, " ^ "golden\n"))
  , integration "a golden text, of a command's output" (do
      r <- run { command = "echo", args = ["from outside"] }
      golden "echoed.txt" r.out)
  ]
