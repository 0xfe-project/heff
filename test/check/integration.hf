-- Tests that need the world outside the program: integration tests,
-- each run by `heff test` in a program of its own, in a directory of its
-- own, within its time limit; and golden texts, kept beside this file.

module test.check.integration

import check
import co
import std.filesystem
import std.path as Path
import std.process

-- (did it end by itself, with this status)
exitedWith : Int -> Ended -> Bool
exitedWith n (Exited m) = n == m
exitedWith n _ = False

-- (the heff that runs the tests: `heff test` sets HEFF)
heffGiven : {e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> Co e String
heffGiven = do
  v <- getEnv "HEFF"
  case v of
    Just s -> pure s
    Nothing -> failure "HEFF is not set: `heff test` sets it"

-- (a test file of one integration test, `name`, given `limit` ms, that
-- runs `script` by sh and holds if it exits with 0)
scriptTest : String -> Int -> String -> String
scriptTest name limit script =
  "module "
  ^ name
  ^ "\n\nimport check\nimport co\nimport std.process\n\nt : Test\nt = withinTime "
  ^ show limit
  ^ " (integration "
  ^ show name
  ^ " (do\n  r <- run { command = \"sh\", args = [\"-c\", "
  ^ show script
  ^ "] }\n  assert \"it exited with 0\" (succeeded r)))\n"

-- (a script that leaves `me`'s flag in `dir` and waits, some seconds at
-- most, for `other`'s: it exits with 0 if it came)
meets : String -> String -> String -> String
meets dir me other =
  "touch "
  ^ dir
  ^ "/"
  ^ me
  ^ ".flag; i=0; while [ ! -e "
  ^ dir
  ^ "/"
  ^ other
  ^ ".flag ] && [ $i -lt 150 ]; do sleep 0.1; i=$((i+1)); done; test -e "
  ^ dir
  ^ "/"
  ^ other
  ^ ".flag"

-- (`heff test` run here on these arguments)
heffTest : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> List String
         -> Co e Ran
heffTest argv = do
  heff <- heffGiven
  run { command = heff, args = Cons "test" argv }

-- | what `heff test` does of the integration tests of other files, run by
-- | it here
runner : Test
runner = group "heff test"
  [ integration "the files' integration tests run in one pool" (do
      -- (each waits for the other: they hold only if they run at once)
      working <- workingDir
      let here = toString working
      a <- writeFile "a.hf" (scriptTest "a" 20000 (meets here "a" "b"))
      b <- writeFile "b.hf" (scriptTest "b" 20000 (meets here "b" "a"))
      r <- heffTest ["--jobs", "2", "a.hf", "b.hf"]
      assert ("they met:\n" ^ r.out ^ r.err) (succeeded r))
  , integration "a test killed at its time limit takes what it started" (do
      -- (it starts a sleep, says its pid, and is killed long before the
      -- sleep ends: the sleep is to be gone soon after)
      working <- workingDir
      let here = toString working
      w <-
        writeFile
          "slow.hf"
          (scriptTest
             "slow"
             1000
             ("sleep 30 & echo $! > " ^ here ^ "/pid; wait"))
      r <- heffTest ["slow.hf"]
      assert ("it failed:\n" ^ r.out) (exitedWith 1 r.ended)
      gone <-
        run
          { command = "sh"
          , args =
              [ "-c"
              , "p=$(cat pid); i=0; while kill -0 $p 2>/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done; if kill -0 $p 2>/dev/null; then kill $p; exit 1; fi"
              ]
          }
      assert "the sleep it started is gone" (succeeded gone))
  , integration "a file whose tests do not compile fails, the others go on" (do
      -- (the name of the program heff test adds to it, taken)
      p <-
        writeFile
          "p.hf"
          "module p\n\nimport check\nimport co\n\nheffTestIntegrations : Int\nheffTestIntegrations = 1\n\nt : Test\nt = integration \"t\" (assertEqual 1 1)\n"
      -- (the other's a unit test: built into no program, it is run all
      -- the same)
      q <-
        writeFile
          "q.hf"
          "module q\n\nimport check\nimport co\n\nt : Test\nt = unit \"q\" (assertEqual 1 1)\n"
      r <- heffTest ["p.hf", "q.hf"]
      assert "it failed" (exitedWith 1 r.ended)
      golden "unbuilt.txt" r.out)
  , integration "a heff test run in a test runs a test at a time" (do
      jobs <- getEnv "HEFF_TEST_JOBS"
      assertEqual jobs (Just "1"))
  ]

commands : Test
commands = group "outside"
  [ integration "a command runs in the test's own directory, new and empty" (do
      working <- workingDir
      let here = toString working
      names <- readDirectory here
      assertEqual (List.map Path.basename names) Nil
      writeFile "note.txt" "hello\n"
      r <- run { command = "cat", args = ["note.txt"] }
      assertEqual r.out "hello\n")
  , integration "a command's status is seen" (do
      r <- run { command = "sh", args = ["-c", "exit 3"] }
      assert "it exited with 3" (exitedWith 3 r.ended))
  , unit "a golden text" (golden "greeting.txt" ("hello, " ^ "golden\n"))
  , integration "a golden text, of a command's output" (do
      r <- run { command = "echo", args = ["from outside"] }
      golden "echoed.txt" r.out)
  , integration "what a test's commands write does not say how it went" (do
      -- (what the test started writes to its output after it ends)
      r <-
        run
          { command = "sh"
          , args = ["-c", "(sleep 1; echo '-- heff test: the outcome --'; echo '{') &"]
          , output = Inherited
          }
      assert "it started" (exitedWith 0 r.ended))
  , integration "subtests, each a test of its own" (do
      subtest "first" (golden "subtests/first.txt" "one\n")
      subtest "nested" (subtest "inner" (assertEqual (1 + 1) 2))
      r <- run { command = "echo", args = ["after them"] }
      assertEqual r.out "after them\n")
  ]
