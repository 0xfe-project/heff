-- The runner of check, tested by itself: properties that fail on
-- purpose, run by `runTest` as `heff test` runs them, and what came of
-- them looked at -- the counterexample shrunk to the smallest, the same
-- seed running the same runs, the labels counted, the runs given up on.
-- (Those that fail on purpose are made by functions, not definitions of
-- type `Test`, which `heff test` would run itself.)

module test.check.runner

import check
import co
import generator as Generator

-- | Fails on purpose: some list of numbers below 100 has one of 50 or
-- | more.  The smallest counterexample is `[50]`.
allSmall : Unit -> Test
allSmall u = property "all below 50" $ do
  xs <- forAll (Generator.list 0 20 (Generator.int 0 99))
  assert "all below 50" (List.all (\x -> x < 50) xs)

-- | Fails on purpose, by two draws: shrunk, the two sum to 10 (each draw
-- | shrinks with the other as it is, so it is a smallest pair, not the
-- | smallest).
sumSmall : Unit -> Test
sumSmall u = property "sums below 10" $ do
  a <- forAll (Generator.int 0 20)
  b <- forAll (Generator.int 0 20)
  a + b < 10 `assertEqual` True

-- | Holds, but only of the runs it does not give up on.
evens : Unit -> Test
evens u = property "an even number halved and doubled" $ do
  n <- forAll (Generator.int 0 1000)
  assume (n % 2 == 0)
  label (if n == 0 then "zero" else "not zero")
  n / 2 * 2 `assertEqual` n

-- | Gives up on every run.
nothingFits : Unit -> Test
nothingFits u = property "nothing fits" $ assume False

outcome : Int -> Test -> Outcome
outcome seed t = case runTest seed t of
  o :: _ -> o
  [] -> abandon

-- | A broken map: its size is wrong once it has three keys or more.
data Command = Put Int | Count

-- (a command, shown as it is written: a type of the test's own, given
-- its `Debug`)
instance instanceDebugCommand : Debug Command
instanceDebugCommand = { debug = written }
  where
  written : Command -> String
  written (Put k) = "Put " ^ debug k
  written Count = "Count"

putIn : Int -> List Int -> List Int
putIn k ks = if List.any (\x -> x == k) ks then ks else k :: ks

stepBroken : Command -> List Int -> Pair (List Int) Int
stepBroken (Put k) ks = MkPair (putIn k ks) 0
stepBroken Count ks =
  MkPair ks (if List.length ks >= 3 then 0 else List.length ks)

stepRight : Command -> List Int -> Pair (List Int) Int
stepRight (Put k) ks = MkPair (putIn k ks) 0
stepRight Count ks = MkPair ks (List.length ks)

broken : Machine Command (List Int) (List Int) Int
broken =
  { system = Nil
  , model = Nil
  , step = stepBroken
  , stepModel = stepRight
  , valid = \ks -> True
  }

brokenModel : Unit -> Test
brokenModel u = property "the broken map agrees with its model" $ do
  cmds <-
    forAll
      (Generator.list
         0
         30
         (Generator.oneOf
            (MkNonEmptyList
               (Generator.map (\k -> Put k) (Generator.int 0 9))
               [Generator.constant Count])))
  agree broken cmds

runner : Test
runner =
  group
    "runner"
    [ unit "a failing property shrinks to the smallest counterexample" $ do
        assert "fails" (not (outcome 1 (allSmall MkUnit)).ok)
        (outcome 1 (allSmall MkUnit)).notes `assertEqual` ["[50]"]
        (outcome 1 (allSmall MkUnit)).failure
          `assertEqual` Just (Because "all below 50")
    , unit "two draws shrink together, to a sum of 10"
      $ List.sum
          (List.map
             (\s -> fromMaybe 0 (parseInt s))
             (outcome 3 (sumSmall MkUnit)).notes)
        `assertEqual` 10
    , unit "what differs is said: expected, then got"
      $ (outcome 3 (sumSmall MkUnit)).failure
        `assertEqual` Just (Differ "True" "False")
    , unit "the same seed runs the same runs"
      $ runTest 7 (allSmall MkUnit) `assertEqual` runTest 7 (allSmall MkUnit)
    , unit "another seed runs others, to the same counterexample" $ do
        assert
            "the runs differ"
            (not
               ((outcome 7 (allSmall MkUnit)).runs
                == (outcome 8 (allSmall MkUnit)).runs))
        (outcome 8 (allSmall MkUnit)).notes `assertEqual` ["[50]"]
    , unit "runs given up on are counted apart, and labels counted" $ do
        assert "holds" (outcome 1 (evens MkUnit)).ok
        (outcome 1 (evens MkUnit)).runs `assertEqual` 100
        assert "gives some up" ((outcome 1 (evens MkUnit)).discarded > 0)
        List.map
            (\(p : Pair String Int) -> fst p)
            (outcome 1 (evens MkUnit)).labels
          `assertEqual` ["not zero", "zero"]
    , unit "a property that gives up on every run fails" $ do
        assert "fails" (not (outcome 1 (nothingFits MkUnit)).ok)
        (outcome 1 (nothingFits MkUnit)).runs `assertEqual` 0
    , unit "a model-based test shrinks to a short program" $ do
        List.length
            (split
               ", "
               (fromMaybe
                  ""
                  (List.head (outcome 1 (brokenModel MkUnit)).notes)))
          `assertEqual` 4
        List.drop 1 (outcome 1 (brokenModel MkUnit)).notes
          `assertEqual` ["at command 3, Count"]
    , runs 10 $ property "from any seed, the same smallest counterexample" $ do
        s <- forAll (Generator.uniform 0 1000000)
        (outcome s (allSmall MkUnit)).notes `assertEqual` ["[50]"]
    , unit "a type of the test's own is shown by its instance"
      $ (outcome
           1
           (unit "differs" $ (Put 1 : Command) `assertEqual` Count)).failure
        `assertEqual` Just (Differ "Count" "Put 1")
    , unit "a group names its tests"
      $ List.map
          (\(o : Outcome) -> o.name)
          (runTest
             1
             (group
                "g"
                [unit "a" $ pure MkUnit, group "h" [unit "b" $ pure MkUnit]]))
        `assertEqual` ["g / a", "g / h / b"]
    ]
