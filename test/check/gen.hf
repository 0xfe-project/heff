-- lib/gen.hf, by properties of its generators: what each makes is in
-- its range, and so is every shrink of it, a level deep -- over seeds
-- and sizes drawn by other generators.

import check
import co
import gen as G
import prelude

-- (what a generator makes from a seed at a size)
value : {a : Type} -> G.Gen a -> Int -> Int -> a
value g s n = G.root (G.run g (G.seed s) n)

-- (... and the shrinks of it, a level deep)
shrinks : {a : Type} -> G.Gen a -> Int -> Int -> List a
shrinks g s n = G.shrinks (G.run g (G.seed s) n)

-- (both)
madeAll : {a : Type} -> G.Gen a -> Int -> Int -> List a
madeAll g s n = Cons (value g s n) (shrinks g s n)

within : Int -> Int -> Int -> Bool
within lo hi x = lo <= x && x <= hi

-- (the number of `lo` to `hi` nearest 0)
nearest0 : Int -> Int -> Int
nearest0 lo hi = if lo > 0 then lo else if hi < 0 then hi else 0

ints : Test
ints =
  group
    "int"
    [ property "it is in its range, and so are its shrinks" (do
    lo <- forAll showInt (G.int (0 - 50) 50)
    width <- forAll showInt (G.int 0 50)
    s <- forAll showInt (G.uniform 0 100000)
    n <- forAll showInt (G.uniform 0 100)
    label
        (if within lo (lo + width) 0 then "the range has 0"
         else "the range has no 0")
    assert
        "in range"
        (all (within lo (lo + width)) (madeAll (G.int lo (lo + width)) s n)))
    , property "it shrinks first to the number of its range nearest 0" (do
    lo <- forAll showInt (G.int (0 - 150) 50)
    s <- forAll showInt (G.uniform 0 100000)
    assume (not (value (G.int lo (lo + 100)) s 100 == nearest0 lo (lo + 100)))
    equal
        (showMaybe showInt)
        (head (shrinks (G.int lo (lo + 100)) s 100))
        (Just (nearest0 lo (lo + 100))))
    , unit
      "at size 0 it is the number nearest 0"
      (equal showInt (value (G.int 3 90) 17 0) 3)
    ]

lists : Test
lists =
  group
    "list"
    [ property "its length is in its range, and so are its shrinks'" (do
    lo <- forAll showInt (G.int 0 5)
    width <- forAll showInt (G.int 0 10)
    s <- forAll showInt (G.uniform 0 100000)
    n <- forAll showInt (G.uniform 0 100)
    assert
        "in range"
        (all
           (\(xs : List Int) -> within lo (lo + width) (length xs))
           (madeAll (G.list lo (lo + width) (G.int 0 9)) s n)))
    , property "a shrink is shorter, or as long with an element smaller" (do
    s <- forAll showInt (G.uniform 0 100000)
    assert
        "smaller"
        (all
           (\(xs : List Int) ->
              length xs < length (value (G.list 0 10 (G.int 0 9)) s 100)
              || sum xs < sum (value (G.list 0 10 (G.int 0 9)) s 100))
           (shrinks (G.list 0 10 (G.int 0 9)) s 100)))
    ]

others : Test
others =
  group
    "others"
    [ property "an element is one of the list's" (do
    s <- forAll showInt (G.uniform 0 100000)
    assert
        "one of them"
        (elemBy strEq (value (G.element ["a", "b", "c"]) s 50) ["a", "b", "c"]))
    , property "frequency keeps to its weights, about" (do
    x <-
      forAll
        showInt
        (G.frequency [MkPair 1 (G.constant 0), MkPair 3 (G.constant 1)])
    label (if x == 0 then "weighed 1" else "weighed 3"))
    , unit
      "a bool shrinks to False"
      (equal
         (showList showBool)
         (shrinks G.bool 1 100)
         (if value G.bool 1 100 then [False] else Nil))
    , unit
      "a string is of its alphabet"
      (equal
         (showList showString)
         (filter
            (\c -> not (strEq c "a" || strEq c "b"))
            (map
               (\i -> strSlice (value (G.string 5 5 "ab") 3 100) i (i + 1))
               (range 0 4)))
         Nil)
    ]
