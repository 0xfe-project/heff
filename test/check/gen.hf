-- lib/gen.hf, by properties of its generators: what each makes is in
-- its range, and so is every shrink of it, a level deep -- over seeds
-- and sizes drawn by other generators.

import check
import co
import gen as Gen

-- (what a generator makes from a seed at a size)
value : {a : Type} -> Gen.Gen a -> Int -> Int -> a
value g s n = Gen.root (Gen.run g (Gen.seed s) n)

-- (... and the shrinks of it, a level deep)
shrinks : {a : Type} -> Gen.Gen a -> Int -> Int -> List a
shrinks g s n = Gen.shrinks (Gen.run g (Gen.seed s) n)

-- (both)
madeAll : {a : Type} -> Gen.Gen a -> Int -> Int -> List a
madeAll g s n = Cons (value g s n) (shrinks g s n)

within : Int -> Int -> Int -> Bool
within lo hi x = lo <= x && x <= hi

-- (the number of `lo` to `hi` nearest 0)
nearest0 : Int -> Int -> Int
nearest0 lo hi = if lo > 0 then lo else if hi < 0 then hi else 0

ints : Test
ints =
  group
    "int"
    [ property "it is in its range, and so are its shrinks" (do
    lo <- forAll showInt (Gen.int (0 - 50) 50)
    width <- forAll showInt (Gen.int 0 50)
    s <- forAll showInt (Gen.uniform 0 100000)
    n <- forAll showInt (Gen.uniform 0 100)
    label
        (if within lo (lo + width) 0 then "the range has 0"
         else "the range has no 0")
    assert
        "in range"
        (List.all (within lo (lo + width)) (madeAll (Gen.int lo (lo + width)) s n)))
    , property "it shrinks first to the number of its range nearest 0" (do
    lo <- forAll showInt (Gen.int (0 - 150) 50)
    s <- forAll showInt (Gen.uniform 0 100000)
    assume (not (value (Gen.int lo (lo + 100)) s 100 == nearest0 lo (lo + 100)))
    assertEqual
        (showMaybe showInt)
        (List.head (shrinks (Gen.int lo (lo + 100)) s 100))
        (Just (nearest0 lo (lo + 100))))
    , unit
      "at size 0 it is the number nearest 0"
      (assertEqual showInt (value (Gen.int 3 90) 17 0) 3)
    ]

lists : Test
lists =
  group
    "list"
    [ property "its length is in its range, and so are its shrinks'" (do
    lo <- forAll showInt (Gen.int 0 5)
    width <- forAll showInt (Gen.int 0 10)
    s <- forAll showInt (Gen.uniform 0 100000)
    n <- forAll showInt (Gen.uniform 0 100)
    assert
        "in range"
        (List.all
           (\(xs : List Int) -> within lo (lo + width) (List.length xs))
           (madeAll (Gen.list lo (lo + width) (Gen.int 0 9)) s n)))
    , property "a shrink is shorter, or as long with an element smaller" (do
    s <- forAll showInt (Gen.uniform 0 100000)
    assert
        "smaller"
        (List.all
           (\(xs : List Int) ->
              List.length xs < List.length (value (Gen.list 0 10 (Gen.int 0 9)) s 100)
              || List.sum xs < List.sum (value (Gen.list 0 10 (Gen.int 0 9)) s 100))
           (shrinks (Gen.list 0 10 (Gen.int 0 9)) s 100)))
    ]

others : Test
others =
  group
    "others"
    [ property "an element is one of the list's" (do
    s <- forAll showInt (Gen.uniform 0 100000)
    assert
        "one of them"
        (List.elemBy strEq (value (Gen.element (MkNonEmptyList "a" ["b", "c"])) s 50) ["a", "b", "c"]))
    , property "frequency keeps to its weights, about" (do
    x <-
      forAll
        showInt
        (Gen.frequency (MkNonEmptyList (MkPair 1 (Gen.constant 0)) [MkPair 3 (Gen.constant 1)]))
    label (if x == 0 then "weighed 1" else "weighed 3"))
    , unit
      "a bool shrinks to False"
      (assertEqual
         (showList showBool)
         (shrinks Gen.bool 1 100)
         (if value Gen.bool 1 100 then [False] else Nil))
    , unit
      "a string is of its alphabet"
      (assertEqual
         (showList showString)
         (List.filter
            (\c -> not (strEq c "a" || strEq c "b"))
            (List.map
               (\i -> strSlice (value (Gen.string 5 5 (MkNonEmptyList 'a' ['b'])) 3 100) i (i + 1))
               (List.range 0 4)))
         Nil)
    , property "a string of an alphabet beyond ASCII is of its runes, whole, and so are its shrinks" (do
    s <- forAll showInt (Gen.uniform 0 100000)
    n <- forAll showInt (Gen.uniform 0 100)
    assert
        "of its runes"
        (List.all
           (\(t : String) ->
              strEq (ofRunes (runes t)) t
              && List.all (\(r : Rune) -> contains (ofRunes [r]) "a😀é") (runes t))
           (madeAll (Gen.string 0 8 (MkNonEmptyList 'a' ['😀', 'é'])) s n)))
    ]
