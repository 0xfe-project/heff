-- lib/map.hf against a model of it: a list of pairs, the newest first,
-- which is too slow to use and too simple to be wrong.  A property draws
-- a program of commands, runs it on both, and after each command holds
-- the map to say what the list says, and to be balanced and in order
-- (`Map.valid`).  If they ever differ, the program shrinks to a short one
-- that shows how.

import check
import co
import gen as Gen
import map as Map

data Command = Insert Int Int | Delete Int | Lookup Int | Size | Keys

instance instanceShowCommand : Show Command
instanceShowCommand = { show = written }
  where
    written : Command -> String
    written (Insert k v) = "Insert " ^ show k ^ " " ^ show v
    written (Delete k) = "Delete " ^ show k
    written (Lookup k) = "Lookup " ^ show k
    written Size = "Size"
    written Keys = "Keys"

-- | A command: its keys from a small range, so that a program inserts a
-- | key it has, and deletes and looks up keys it has.
command : Gen.Gen Command
command =
  Gen.frequency
    (MkNonEmptyList
       (MkPair 4 (Gen.map2 (\k v -> Insert k v) (Gen.int 0 15) (Gen.int 0 9)))
       [ MkPair 2 (Gen.map (\k -> Delete k) (Gen.int 0 15))
       , MkPair 2 (Gen.map (\k -> Lookup k) (Gen.int 0 15))
       , MkPair 1 (Gen.constant Size)
       , MkPair 1 (Gen.constant Keys)
       ])

-- | What a command is seen to do: nothing, a value, or a number of keys,
-- | or the keys.
data Seen = Nothing' | Found (Maybe Int) | Count Int | KeysAre (List Int)

instance instanceShowSeen : Show Seen
instanceShowSeen = { show = written }
  where
    written : Seen -> String
    written Nothing' = "nothing"
    written (Found m) = show m
    written (Count n) = show n
    written (KeysAre ks) = show ks

stepMap : Command -> Map.Map Int Int -> Pair (Map.Map Int Int) Seen
stepMap (Insert k v) m = MkPair (Map.insert compareInt k v m) Nothing'
stepMap (Delete k) m = MkPair (Map.delete compareInt k m) Nothing'
stepMap (Lookup k) m = MkPair m (Found (Map.lookup compareInt k m))
stepMap Size m = MkPair m (Count (Map.size m))
stepMap Keys m = MkPair m (KeysAre (Map.keys m))

without : Int -> List (Pair Int Int) -> List (Pair Int Int)
without k ps = List.filter (\(p : Pair Int Int) -> not (fst p == k)) ps

stepList : Command -> List (Pair Int Int) -> Pair (List (Pair Int Int)) Seen
stepList (Insert k v) ps = MkPair (Cons (MkPair k v) (without k ps)) Nothing'
stepList (Delete k) ps = MkPair (without k ps) Nothing'
stepList (Lookup k) ps = MkPair ps (Found (List.lookupBy (\a b -> a == b) k ps))
stepList Size ps = MkPair ps (Count (List.length ps))
stepList Keys ps =
  MkPair
    ps
    (KeysAre (List.sortBy (\a b -> a <= b) (List.map (\(p : Pair Int Int) -> fst p) ps)))

machine : Machine Command (Map.Map Int Int) (List (Pair Int Int)) Seen
machine =
  { system = Map.empty
  , model = Nil
  , step = stepMap
  , stepModel = stepList
  , valid = \m -> Map.valid compareInt m
  }

-- (how many keys a program leaves: to see the programs are not trivial)
sizeLabel : List Command -> String
sizeLabel cmds = sized (Map.size (List.foldl (\m c -> fst (stepMap c m)) Map.empty cmds))
  where
    sized : Int -> String
    sized n =
      if n == 0 then "ends empty"
      else if n < 5 then "ends with 1 to 4 keys"
      else "ends with 5 keys or more"

mapModel : Test
mapModel =
  group
    "map"
    [ property "agrees with a list of pairs" (do
    cmds <- forAll (Gen.list 0 50 command)
    label (sizeLabel cmds)
    agree machine cmds)
    , property
      "fromList, then toList, is the pairs sorted, the last of each key kept" (do
    ps <-
      forAll
        (Gen.list 0 30 (Gen.pair (Gen.int 0 20) (Gen.int 0 9)))
    assertEqual
        (Map.toList (Map.fromList compareInt ps))
        (List.sortBy
           (\(a : Pair Int Int) (b : Pair Int Int) -> fst a <= fst b)
           (List.foldl
              (\acc (p : Pair Int Int) -> Cons p (without (fst p) acc))
              Nil
              ps)))
    , unit
      "a key inserted is found"
      (assertEqual
         (Map.lookup compareInt 1 (Map.insert compareInt 1 "one" Map.empty))
         (Just "one"))
    , unit
      "a key deleted is not"
      (assertEqual
         (Map.lookup
            compareInt
            1
            (Map.delete compareInt 1 (Map.insert compareInt 1 "one" Map.empty)))
         Nothing)
    ]
