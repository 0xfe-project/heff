-- The elaborator's pieces, each on a few terms: the core syntax, what a
-- unification tried and failed leaves behind.

module test.elab

import co
import heff.elab.conversion as Conversion
import heff.elab.environment
import heff.elab.meta as Meta
import heff.elab.params as Params
import heff.elab.syntax
import heff.elab.unify as Unify
import heff.syntax.diagnostic
import std.ordmap as OrdMap

-- The core syntax
--------------------------------------------------------------------------------

-- (1 of an application, else 0)
isApp : Tm -> Int
isApp (SApp _ _) = 1
isApp _ = 0

test syntax

-- >>> isApp (SApp (SLocal 0) (SLitInt 7))
-- 1

-- The metavariables
--------------------------------------------------------------------------------

-- (a unification that makes a metavariable, then fails)
madeThenFailed : Elab (Either Conversion.EqErr Int)
madeThenFailed =
  bind
    (Meta.liftU
       (Unify.newMetaFrom
          (ms := Unify.msEv)
          (uf := Unify.ufEv)
          { ty = VPrimInt
          , sol = Nothing
          , solStx = Nothing
          , arity = 0
          , name = "m"
          , span = Params.noSpan
          }
          0
          VPrimInt))
    (\r -> pure (Left MentionsError))

-- (how many metavariables the state ends with)
metaCount : {a : Type} -> Pair (Either Diag a) ElabSt -> Int
metaCount (MkPair _ st) = OrdMap.size (core st).metas

test metas

-- tried, what the failed unification made is gone; not tried, it stays

-- >>> metaCount (Meta.runE (Meta.attempt madeThenFailed) emptySt)
-- 0

-- >>> metaCount (Meta.runE madeThenFailed emptySt)
-- 1
