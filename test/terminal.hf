-- heff with no words, on a terminal: its commands' app, driven by keys
-- typed at the tests' pseudo-terminal (`pty.c`, built here by zig, else
-- `cc`) of 100 columns by 30 rows, each key once what was drawn before
-- it has been: the list drawn on the alternate screen, filtered, a
-- command's form filled in and its command line run once the app has
-- put the terminal back as it was; Esc and `q` leaving it, with nothing
-- run; Ctrl-C ending heff with the terminal put back; a command line
-- that lacks what its command wants opening on the command's form, a
-- path typed in it completed; the
-- line chosen written to the file a shell's function names, not run.  On
-- a terminal that is `dumb` heff says its usage, as before.  Run by the heff that
-- runs the tests (`HEFF`); not on Windows, which has no such terminal:
--
--   heff test --run terminal/form test/terminal.hf

module test.terminal

import bytes as Bytes
import check
import co
import exception
import regex as Regex
import std.filesystem
import std.path as Path
import std.process
import resource

-- (what the tests run by is given, else the test fails)
given : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> String
      -> Co e String
given name = do
  v <- getEnv name
  case v of
    Just s -> pure s
    Nothing -> failure (name ^ " is not set: `heff test` sets it")

-- (did it exit with this status)
exitedWith : Int -> Ended -> Bool
exitedWith n (Exited k) = k == n
exitedWith n _ = False

-- The terminal
--------------------------------------------------------------------------------

-- | the pseudo-terminal built, `pty` in the test's directory: its path
ptyBuilt : {e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> Co e String
ptyBuilt = do
  root <- given "HEFF_TEST_ROOT"
  working <- workingDir
  let here = show working
  zig <- run { command = "zig", args = ["version"] }
  flags <- pure ["-O1", "-w", root ^ "/test/pty.c", "-o", here ^ "/pty"]
  built <-
    if succeeded zig then run { command = "zig", args = Cons "cc" flags }
    else run { command = "cc", args = flags }
  if succeeded built then pure (here ^ "/pty")
    else failure ("the pseudo-terminal not built: " ^ built.err)

-- | how many frames were drawn: each ends its synchronized update
frames : String -> Int
frames raw = List.length (split "\u{1b}[?2026l" raw) - 1

-- | what is read of the command's output, after `raw`, until `ok` holds
-- | of it all or `ms` milliseconds have gone by waiting: all read, and
-- | whether the output ended
readUntil : {e : HFunctor}
          -> {s : Type}
          -> {{sys : process <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> With s Started
          -> (String -> Bool)
          -> Int
          -> String
          -> Co e (Pair String Bool)
readUntil p ok ms raw =
  if ok raw || ms <= 0 then pure (MkPair raw False)
  else do
    r <- readOutput p Available 20
    case r of
      Got b -> readUntil p ok ms (raw ^ Bytes.asString b)
      Timeout -> readUntil p ok (ms - 20) raw
      Closed -> pure (MkPair raw True)

-- (the key typed once something has been drawn, then what it draws
-- waited for a while)
typedNow : {e : HFunctor}
         -> {s : Type}
         -> {{sys : process <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> With s Started
         -> Int
         -> String
         -> Pair String Bool
         -> Co e (Pair String Bool)
typedNow p before k (MkPair raw True) = pure (MkPair raw True)
typedNow p before k (MkPair raw False) =
  if frames raw == 0 then pure (MkPair raw True)
  else do
    written <- writeInput p (Bytes.fromString k)
    readUntil
        p
        (\s -> frames s > before + 1 || (before == 0 && frames s > 1))
        300
        raw

-- | each key typed once what was drawn before it has been: all drawn,
-- | and whether it ended
typed : {e : HFunctor}
      -> {s : Type}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> With s Started
      -> List String
      -> Pair String Bool
      -> Co e (Pair String Bool)
typed p keys (MkPair raw True) = pure (MkPair raw True)
typed p Nil (MkPair raw False) = pure (MkPair raw False)
typed p (Cons k rest) (MkPair raw False) = do
  drawn <- readUntil p (\s -> frames s > 0) 20000 raw
  next <- typedNow p (frames raw) k drawn
  typed p rest next

-- (waited for to its end, killed if it has not in 20 seconds)
ended : {e : HFunctor}
      -> {s : Type}
      -> {{sys : process <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> With s Started
      -> Pair String Bool
      -> Co e Ran
ended p (MkPair raw True) = do
  r <- wait p
  pure { r | out = raw ^ r.out }
ended p (MkPair raw False) = do
  last <- readUntil p (\s -> False) 20000 raw
  case last of
    MkPair all True -> ended p last
    MkPair all False -> do
      kill p
      r <- wait p
      pure { r | out = all ^ r.out }

-- | heff given the words on the terminal, `TERM` as given, the file for
-- | the command line chosen (`HEFF_CHOSEN`, a shell's function's: none,
-- | where it is empty), each of `keys` typed once what it drew before
-- | has been drawn: all it drew, as its output, and how it ended
onTerminalWith : {e : HFunctor}
               -> {{chk : check <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> {{ex : exception ProcessError <: e}}
               -> {{fx : exception FileError <: e}}
               -> String
               -> String
               -> List String
               -> List String
               -> Co e Ran
onTerminalWith term chosenTo words keys = do
  pty <- ptyBuilt
  heff <- given "HEFF"
  writeFile "a.hf" "module a\n\nx : Int\nx = 1\n"
  withProcess
      { command = pty
      , args = List.append ["100", "30", heff] words
      , env = [MkPair "TERM" term, MkPair "HEFF_CHOSEN" chosenTo]
      , input = Piped
      , output = Piped
      , group = True
      } (\p -> do
    drawn <- typed p keys (MkPair "" False)
    ended p drawn)

-- | heff with no words on the terminal, `TERM` as given, each of `keys`
-- | typed as above
onTerminal : {e : HFunctor}
           -> {{chk : check <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{ex : exception ProcessError <: e}}
           -> {{fx : exception FileError <: e}}
           -> String
           -> List String
           -> Co e Ran
onTerminal term keys = onTerminalWith term "" Nil keys

-- The screen
--------------------------------------------------------------------------------

-- (a byte of a control sequence's parameters, `?`, a digit or `;`)
parameter : Int -> Bool
parameter b = b == 63 || b == 59 || (b >= 48 && b <= 57)

-- (a letter, a control sequence's last byte)
letter : Int -> Bool
letter b = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)

-- (past a control sequence's parameters, from `i`)
pastParameters : String -> Int -> Int
pastParameters s i =
  if i < strLength s && parameter (byteAt s i) then pastParameters s (i + 1)
  else i

-- | the text, its control sequences (`ESC [`, parameters, a letter) and
-- | `\r`s left out
plainText : String -> String
plainText s = case indexOf "\u{1b}[" s 0 of
  Nothing -> joinWith "" (split "\r" s)
  Just i ->
    if pastParameters s (i + 2) < strLength s
       && letter (byteAt s (pastParameters s (i + 2)))
    then plainText
        (strSlice s 0 i
         ^ strSlice s (pastParameters s (i + 2) + 1) (strLength s))
    else joinWith "" (split "\r" (strSlice s 0 (i + 2)))
      ^ plainText (strSlice s (i + 2) (strLength s))

-- (the string, the spaces at its end left out)
trimEnd : String -> String
trimEnd s =
  if strLength s > 0 && byteAt s (strLength s - 1) == 32
  then trimEnd (strSlice s 0 (strLength s - 1))
  else s

-- (what follows the last of `mark`, if there is one)
afterLast : String -> String -> Maybe String
afterLast mark s = case split mark s of
  Cons only Nil -> Nothing
  pieces -> List.last pieces

-- | the screen the last frame drawn drew: its rows, as text
lastFrame : String -> List String
lastFrame raw = case afterLast "\u{1b}[?2026h" raw of
  Nothing -> Nil
  Just frame -> case indexOf "\u{1b}[?2026l" frame 0 of
    Nothing -> Nil
    Just end -> List.map trimEnd (lines (plainText (strSlice frame 0 end)))

-- | each frame drawn, its rows
eachFrame : String -> List (List String)
eachFrame raw =
  List.map
    (\f -> lastFrame (f ^ "\u{1b}[?2026l"))
    (List.take (frames raw) (split "\u{1b}[?2026l" raw))

-- | what was written after the app put the terminal back
afterwards : String -> String
afterwards raw =
  joinWith "" (split "\r" (fromMaybe raw (afterLast "\u{1b}[?1049l" raw)))

-- | the terminal put back: the app began on the alternate screen and left
-- | it after its last frame
restored : String -> Bool
restored raw =
  startsWith "\u{1b}[?1049h" raw
  && maybe
    False
    (\a -> not (contains "\u{1b}[?2026l" a))
    (afterLast "\u{1b}[?1049l" raw)

-- (row `i` of a screen, `""` if it has none)
row : Int -> List String -> String
row i rows = fromMaybe "" (List.head (List.drop i rows))

-- (frame `i` of these, none if there is none)
frameAt : Int -> List (List String) -> List String
frameAt i fs = fromMaybe Nil (List.head (List.drop i fs))

-- (some line of the screen matches the pattern)
someLine : String -> List String -> Bool
someLine pattern rows = case Regex.compile pattern of
  Left why -> False
  Right r -> List.any (\l -> Regex.matches r l) rows

-- (the test fails, saying what was there, unless it holds)
holds : {e : HFunctor}
      -> {{chk : check <: e}}
      -> String
      -> Bool
      -> String
      -> Co e Unit
holds what True there = pure MkUnit
holds what False there = failure (what ^ "\n" ^ there)

-- (how it ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "exited " ^ debug n
endedSaid (Signalled n) = "signal " ^ debug n
endedSaid TimedOut = "timed out"
endedSaid (NotRun err) = "not run: " ^ show err

-- The tests
--------------------------------------------------------------------------------

-- | the list of the commands, the first frame; `q` leaves it, nothing run
theList : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
theList = do
  r <- onTerminal "xterm-256color" ["q"]
  shown <- pure (fromMaybe Nil (List.head (eachFrame r.out)))
  holds
      "the list of the commands"
      (exitedWith 0 r.ended
       && restored r.out
       && strEq (row 0 shown) "heff: its commands"
       && someLine "^> check +elaborate FILE" shown
       && someLine "^  dev +the project built" shown
       && not (List.any (\l -> contains "dump-core" l) shown)
       && startsWith "heff check FILE" (row 29 shown))
      (endedSaid r.ended ^ "\n" ^ unlines shown)
  holds "q: nothing run" (strEq (afterwards r.out) "") (afterwards r.out)

-- | filtered, opened, filled in -- a field typed in, a switch turned on --
-- | and run: the command line said, then run as if it had been given
form : {e : HFunctor}
     -> {{chk : check <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> {{ex : exception ProcessError <: e}}
     -> Co e Unit
form = do
  r <- onTerminal "xterm-256color" ["fm", "\r", "a.hf", "\t", " ", "\r"]
  shown <- pure (lastFrame r.out)
  holds
      "a form filled in"
      (strEq (row 0 shown) "heff fmt"
       && someLine "^  FILE\\.\\.\\. +a\\.hf$" shown
       && someLine "^> -c, --check +off  on$" shown
       && List.any (\l -> strEq l "$ heff fmt a.hf --check") shown
       && startsWith "Enter: run it" (row 29 shown))
      (unlines shown)
  holds
      "its command line run"
      (exitedWith 0 r.ended
       && restored r.out
       && strEq (afterwards r.out) "$ heff fmt a.hf --check\n")
      (endedSaid r.ended ^ "\n" ^ afterwards r.out)

-- | a form something is wrong with: said, and Enter runs nothing; Esc
-- | back to the list, the filter kept; Esc again clears it, and once
-- | more leaves
wrong : {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{fx : exception FileError <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> Co e Unit
wrong = do
  r <-
    onTerminal
      "xterm-256color"
      ["comp", "\r", "\r", "\u{1b}", "\u{1b}", "\u{1b}"]
  each <- pure (eachFrame r.out)
  holds
      "what is wrong yet, said"
      (List.any
         (\f ->
            strEq (row 0 f) "heff compile"
            && startsWith "not yet: expected FILE" (row 29 f))
         each)
      (unlines (List.map (\f -> row 29 f) each))
  backwards <- pure (List.reverse each)
  holds
      "Esc: back, then the filter cleared, then out"
      (exitedWith 0 r.ended
       && restored r.out
       && strEq (afterwards r.out) ""
       && startsWith "type to filter" (row 1 (frameAt 0 backwards))
       && strEq (row 1 (frameAt 1 backwards)) "filter: comp")
      (endedSaid r.ended
       ^ "\n"
       ^ unlines (List.concatMap (\f -> List.take 4 f) (List.take 3 backwards)))

-- | a command of no words: Enter twice runs it
version : {e : HFunctor}
        -> {{chk : check <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Co e Unit
version = do
  r <- onTerminal "xterm-256color" ["version", "\r", "\r"]
  holds
      "a command of no words, run"
      (exitedWith 0 r.ended
       && someLine
         "^\\$ heff version\nheff [0-9]+\\.[0-9]+\\.[0-9]+\n$"
         [afterwards r.out])
      (afterwards r.out)

-- | Ctrl-C: SIGINT, the terminal put back, heff ended by it
interrupted : {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{fx : exception FileError <: e}}
            -> {{ex : exception ProcessError <: e}}
            -> Co e Unit
interrupted = do
  r <- onTerminal "xterm-256color" ["j", "\u{3}"]
  holds
      "Ctrl-C"
      (exitedWith 130 r.ended && restored r.out)
      (endedSaid r.ended
       ^ "\n"
       ^ strSlice r.out (max 0 (strLength r.out - 60)) (strLength r.out))

-- | `TERM=dumb`: no app, the usage
dumb : {e : HFunctor}
     -> {{chk : check <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> {{ex : exception ProcessError <: e}}
     -> Co e Unit
dumb = do
  r <- onTerminal "dumb" Nil
  holds
      "a dumb terminal: the usage"
      (exitedWith 0 r.ended
       && not (contains "\u{1b}[?1049h" r.out)
       && startsWith "usage: heff COMMAND ..." r.out)
      (strSlice r.out 0 200)

-- | a command line that lacks what its command wants: the command's form
-- | alone, filled in with what it has, the first field wanted being
-- | filled in; once filled in, the command line said, then run
lacked : {e : HFunctor}
       -> {{chk : check <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> Co e Unit
lacked = do
  r <-
    onTerminalWith
      "xterm-256color"
      ""
      ["compile", "a.hf", "--backend=c"]
      ["a.c", "\r"]
  first <- pure (frameAt 0 (eachFrame r.out))
  holds
      "the form, filled in with what was given"
      (strEq (row 0 first) "heff compile"
       && someLine "^  FILE +a\\.hf$" first
       && someLine "^> OUT$" first
       && List.any
         (\l -> strEq l "$ heff compile a.hf --backend=c")
         first
       && startsWith "not yet: expected OUT  (Esc: leave)" (row 29 first))
      (unlines first)
  holds
      "its command line run (a.hf has no main to compile)"
      (exitedWith 1 r.ended
       && restored r.out
       && strEq
         (afterwards r.out)
         "$ heff compile a.hf a.c --backend=c\nheff: a.hf: no definition main\n")
      (endedSaid r.ended ^ "\n" ^ afterwards r.out)

-- | a path typed in a field of paths: the names it completes to shown
-- | under it as it is typed -- directories, and files with the suffix --
-- | and completed by Tab as far as they all go
pathCompleted : {e : HFunctor}
              -> {{chk : check <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> {{fx : exception FileError <: e}}
              -> {{ex : exception ProcessError <: e}}
              -> Co e Unit
pathCompleted = do
  makeDirectory "abc"
  makeDirectory "abd"
  writeFile "abc/x.hf" "module x\n\ny : Int\ny = 2\n"
  writeFile "notes.txt" "not heff\n"
  r <-
    onTerminalWith
      "xterm-256color"
      ""
      ["check"]
      ["ab", "c", "\t", "\t", "\r"]
  each <- pure (eachFrame r.out)
  holds
      "the paths offered, as typed"
      (List.any (\f -> List.elem "a.hf abc/ abd/ (Tab: 3 paths)" f) each
       && List.any (\f -> List.elem "abc/ abd/ (Tab: 2 paths)" f) each
       && List.any (\f -> List.elem "x.hf (Tab: 1 path)" f) each
       && List.any (\f -> someLine "^> FILE +abc/$" f) each)
      (unlines (List.concatMap (\f -> List.take 12 f) each))
  holds
      "the path completed, run"
      (exitedWith 0 r.ended
       && startsWith "$ heff check abc/x.hf\n" (afterwards r.out))
      (endedSaid r.ended ^ "\n" ^ afterwards r.out)

-- | Esc on the form of what a command line lacks: what it lacks said, as
-- | where there is no terminal
leftLacking : {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{fx : exception FileError <: e}}
            -> {{ex : exception ProcessError <: e}}
            -> Co e Unit
leftLacking = do
  r <- onTerminalWith "xterm-256color" "" ["check"] ["\u{1b}"]
  holds
      "Esc: what is lacking said"
      (exitedWith 1 r.ended
       && restored r.out
       && startsWith "heff check: expected FILE\n" (afterwards r.out))
      (endedSaid r.ended ^ "\n" ^ afterwards r.out)

-- | the file for the command line chosen named (a shell's function's):
-- | the line written there, nothing run nor said
chosenWritten : {e : HFunctor}
              -> {{chk : check <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> {{fx : exception FileError <: e}}
              -> {{ex : exception ProcessError <: e}}
              -> Co e Unit
chosenWritten = do
  working <- workingDir
  let file = show working ^ "/chosen"
  r <- onTerminalWith "xterm-256color" file Nil ["che", "\r", "a b.hf", "\r"]
  line <- readFile file
  holds
      "the line chosen written, not run"
      (exitedWith 0 r.ended
       && restored r.out
       && strEq (afterwards r.out) ""
       && strEq line "heff check 'a b.hf'")
      (endedSaid r.ended ^ "\n" ^ afterwards r.out ^ "\n" ^ line)

-- | a shell on the terminal, its words given it, heff on its PATH (by
-- | the shell's function its completions put there), its home the
-- | test's directory and its history kept nowhere; in heff's app, `heff
-- | version` chosen, its keys typed as above
shellOnTerminal : {e : HFunctor}
                -> {{chk : check <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> {{ex : exception ProcessError <: e}}
                -> {{fx : exception FileError <: e}}
                -> String
                -> List String
                -> Co e Ran
shellOnTerminal shell words = do
  pty <- ptyBuilt
  heff <- given "HEFF"
  working <- workingDir
  let here = show working
  path <- getEnv "PATH"
  makeDirectory "bin"
  writeFile "bin/heff" ("#!/bin/sh\nexec \"" ^ heff ^ "\" \"$@\"\n")
  makeExecutable "bin/heff"
  withProcess
      { command = pty
      , args = List.append ["100", "30", shell] words
      , env =
          [ MkPair "TERM" "xterm-256color"
          , MkPair "HOME" here
          , MkPair "HISTFILE" "/dev/null"
          , MkPair "PATH" (here ^ "/bin:" ^ fromMaybe "" path)
          , MkPair "HEFF_CHOSEN" ""
          ]
      , input = Piped
      , output = Piped
      , group = True
      } (\p -> do
    drawn <- typed p ["version", "\r", "\r"] (MkPair "" False)
    ended p drawn)

-- (was it there to run)
wasRun : Ran -> Bool
wasRun r = case r.ended of
  NotRun _ -> False
  _ -> True

-- (the shell's history, after heff's app was left with `heff version`:
-- that line in it, and run)
historyHolds : {e : HFunctor}
             -> {{chk : check <: e}}
             -> String
             -> Ran
             -> (List String -> Bool)
             -> Co e Unit
historyHolds shell r kept =
  holds
      (shell ^ ": the line chosen kept in its history, and run")
      (exitedWith 0 r.ended
       && kept (lines (afterwards r.out))
       && someLine "^heff [0-9]+\\.[0-9]+\\.[0-9]+$" (lines (afterwards r.out)))
      (endedSaid r.ended ^ "\n" ^ afterwards r.out)

-- (a shell's subtest, where the shell is)
whereThere : {e : HFunctor}
           -> {{chk : check <: e}}
           -> {{sys : process <: e}}
           -> String
           -> Co e Unit
           -> Co e Unit
whereThere shell body = do
  there <- run { command = shell, args = ["-c", "exit 0"] }
  subtest shell (if wasRun there then body else skip ("no " ^ shell ^ " to run"))

-- | heff in a shell that sourced its completions: the line chosen in its
-- | app kept in the shell's history in the place of `heff`, then run
-- | (zsh, which takes no line out, keeps no `heff` typed alone); fish
-- | and zsh where they are
histories : {e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> Co e Unit
histories = do
  subtest "bash" (do
    r <-
      shellOnTerminal
        "bash"
        [ "--norc"
        , "--noprofile"
        , "-c"
        , "set -o history\neval \"$(heff completions bash)\"\nheff\nhistory"
        ]
    historyHolds
        "bash"
        r
        (\ls ->
           List.any (\l -> endsWith "  heff version" l) ls
           && not (List.any (\l -> endsWith "  heff" l) ls)))
  whereThere "zsh" (do
    r <-
      shellOnTerminal
        "zsh"
        [ "-f"
        , "-c"
        , "HISTSIZE=100\nautoload -Uz compinit\ncompinit -u -d $HOME/zcompdump\neval \"$(heff completions zsh)\"\nheff\nfc -ln 1\n__heff_history $'heff\\n' || echo dropped"
        ]
    historyHolds
        "zsh"
        r
        (\ls -> List.elem "heff version" ls && List.elem "dropped" ls))
  whereThere "fish" (do
    r <-
      shellOnTerminal
        "fish"
        [ "--no-config"
        , "-c"
        , "heff completions fish | source\nheff\necho kept: $history[1]"
        ]
    historyHolds "fish" r (\ls -> List.elem "kept: heff version" ls))

-- (each test passed over where there is no such terminal, on Windows)
posix : ({e : HFunctor}
         -> {{chk : check <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> {{fx : exception FileError <: e}}
         -> Co e Unit)
      -> ({e : HFunctor}
          -> {{chk : check <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{ex : exception ProcessError <: e}}
          -> {{fx : exception FileError <: e}}
          -> Co e Unit)
posix body = do
  p <- platform
  if strEq p "win32" then skip "not on Windows" else body

-- | heff's commands' app, on a terminal
terminal : Test
terminal =
  group
    "terminal"
    [ integration "list" (posix theList)
    , integration "form" (posix form)
    , integration "wrong" (posix wrong)
    , integration "version" (posix version)
    , integration "interrupt" (posix interrupted)
    , integration "dumb" (posix dumb)
    , integration "lacking" (posix lacked)
    , integration "lacking-left" (posix leftLacking)
    , integration "paths" (posix pathCompleted)
    , integration "chosen" (posix chosenWritten)
    , integration "history" (posix histories)
    ]
