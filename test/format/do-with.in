import co
import std.filesystem
import std.io
-- a `with` statement (#106): `with e as x do`, its statements the
-- `with`'s body, indented under it
f : {e : HFunctor} -> {{io : stdio <: e}} -> {{fs : filesystem <: e}} -> {{ex : exception IOError <: e}} -> String -> Co e Int
f path = do
  let mut n = 0
  with   withFile   path { access = Read }   as   h do
    l <- readLine h
    n := n + 1
  with withFile path { access = Read } as h do return n
  pure n
