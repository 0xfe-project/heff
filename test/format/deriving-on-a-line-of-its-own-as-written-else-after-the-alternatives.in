data Shape a = Circle Int | Rect a a | Blank
  deriving (Equality, Order, Debug, Show)

data Color = Red | Green | Blue deriving Equality

data Tree a
  = Leaf
  | Node (Tree a) a (Tree a)
  deriving (Equality,Order)

data Long = Aaaaaaaaaaaaaaaa | Bbbbbbbbbbbbbbbbbbbbbbbbb | Cccccccccccccccccccccc | Dddd deriving (Equality, Debug)
