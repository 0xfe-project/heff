short : Int
short = let  a = 1   in a
long : Int -> Int
long n = let aaaaaaaaaaaaaaaa = n + 1111111111111 + 22222222222222 in let bbbbbbbbbbbb = aaaaaaaaaaaaaaaa * 3333333333 in aaaaaaaaaaaaaaaa + bbbbbbbbbbbb
blocky : Maybe Int -> Int
blocky m =
  let k : Int = case m of
        Just x -> x
        Nothing -> 0
  in k + 1
