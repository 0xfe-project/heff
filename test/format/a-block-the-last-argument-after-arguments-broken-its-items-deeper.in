module a

-- the arguments broken, a block last goes on the line of the last of
-- them, its items indented from that line: deeper than the head
lamCase : Int
lamCase =
  f
    x
    y (\t -> case t of
    A -> 1
    B -> 2)

-- (written on a line of its own, too)
ownLine : Int
ownLine =
  f
    x
    y
    (\t -> case t of
       A -> 1
       B -> 2)

-- (broken for not fitting on the line)
long : Int
long = fold someArgument anotherArgument yetAnotherArgument oneMoreArgument (\t -> case t of
  A -> 1
  B -> 2)

-- (in parentheses, the head after them)
inParens : Int
inParens = g (f
  x
  y (\t -> case t of
    A -> 1
    B -> 2))

bareCase : Int
bareCase =
  f
    x
    y (case t of
    A -> 1
    B -> 2)

lamDo : Int
lamDo =
  f
    x
    y (\t -> do
    pure t)

statements : Int
statements = do
  r <- f
    x
    y (do
    z <- x
    pure z)
  run
    x
    y do
    pure 1

-- the arguments on the line of the head, the items indented from it
flat : Int
flat = f x y (\t -> case t of
  A -> 1
  B -> 2)

flatStatement : Int
flatStatement = do
  r <- f x (do
    pure x)
  run x do
    pure 1
