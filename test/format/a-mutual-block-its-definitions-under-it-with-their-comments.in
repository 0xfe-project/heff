-- before
mutual   -- the block
    -- of even
    even : Int -> Bool
    even n   =  if n == 0 then True else odd (n - 1)   -- trail


    -- >>> even 2
    -- True

    -- | >>> odd 3
    -- | True
    odd : Int -> Bool
    odd n = if n == 0 then False
      else even (n - 1)
      where
         one : Int
         one = 1

after : Int
after = 1
