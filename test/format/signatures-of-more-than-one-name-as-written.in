import co

-- | Two numbers.
one,two : Int
one = 1
two = 2

-- (written apart, they stay apart)
three : Int
three = 3

four : Int
four = 4

mutual
  isEven ,  isOdd : Int -> Bool
  isEven n = if n == 0 then True else isOdd (n - 1)
  isOdd n = if n == 0 then False else isEven (n - 1)

handle2, handle3 : {h : HFunctor} -> {a b : Type} -> h.f (Co h) a -> (a -> Co h b) -> Co h b
handle2 p k = op p k
handle3 p k = op p k

type Point = { x,y : Int, label : String }

theory Twice a where
  first,second : a -> a
  third : a -> a
