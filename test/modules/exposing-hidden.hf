-- test: expect errors
-- what a module's claim does not expose is not had: a name it keeps,
-- the tags of a data type it lists bare (neither matched nor made), an
-- instance it keeps (no search finds it), by name or by an alias

module exposing-hidden

import sealed
import sealed as Sealed

sizeOf : {a : Type} -> {{sz : Sized a}} -> a -> Int
sizeOf x = sz.size x

kept : Int
kept = start

keptQualified : Int
keptQualified = Sealed.start

opened : Counter -> Int
opened (MkCounter n) = n

made : Counter
made = MkCounter 5

searched : Int
searched = sizeOf counter
