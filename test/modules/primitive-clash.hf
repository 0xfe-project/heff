-- Two imports written that have `intAdd` -- tens its own, adds the
-- primitive -- are an error where it is used unqualified, the prelude's
-- giving way to both; qualified, each is itself.

import tens
import adds
import tens as T
import adds as A

ok : Int
ok = T.intAdd 4 (A.intAdd 1 1)

clashed : Int
clashed = intAdd 4 2
