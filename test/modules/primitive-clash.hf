-- test: expect errors
-- Two imports written that have `intAnd` -- int the primitive, ands its
-- own -- are an error where it is used unqualified; qualified, each is
-- itself.

module primitive-clash

import int
import ands
import int as Int
import ands as Ands

ok : Int
ok = Ands.intAnd 4 (Int.intAnd 3 1)

clashed : Int
clashed = intAnd 4 2
