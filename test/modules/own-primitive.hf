-- A name an import written has comes before a primitive the module has
-- only by the prelude, without writing it: `intAdd` is tens's, and the
-- primitive is the prelude's `P.intAdd`, adds's `A.intAdd` and `+`.

import tens
import adds as A
import prelude as P

-- >>> intAdd 4 2
-- 42

-- >>> A.intAdd 4 2
-- 6

-- >>> P.intAdd 4 2
-- 6

-- >>> 4 + 2
-- 6
