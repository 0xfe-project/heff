-- `join`'s fixity comes with its module, imported unqualified:
-- `` a `join` b ++ c `` groups as `joins` declares. Through an alias the
-- name has none, and `` a `Joins.join` b ++ c `` wants parentheses.

module backticks

import joins
import joins as Joins

-- | >>> joined
-- | [2, 1, 3]
joined : List Int
joined = [1] `join` [2] ++ [3]

-- | >>> aliased
-- | [2, 1, 3]
aliased : List Int
aliased = ([1] `Joins.join` [2]) ++ [3]
