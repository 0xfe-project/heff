-- what a module's header exposes is in scope: a data type without its
-- tags, made and taken apart by what the module exposes; one with its
-- tags; an alias, a theory, an operator, an instance

module exposing

import sealed

sizeOf : {a : Type} -> {{sz : Sized a}} -> a -> Int
sizeOf x = sz.size x

-- | >>> twice
-- | 2
twice : Int
twice = count (bump (bump counter))

-- | >>> lined
-- | 3
lined : Int
lined = case (Line 3 : Shape) of
  Dot -> 0
  Line n -> n

-- | >>> paired
-- | 12
paired : Int
paired = fst ((MkPair 1 2 : Pairing)) <#> 2

-- | >>> sized
-- | 4
sized : Int
sized = sizeOf (Line 4 : Shape)
