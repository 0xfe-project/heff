-- test: expect errors
-- Two imports define `assert`, each its own way: a use of it unqualified
-- is an error, even as the head of an application in a `do` block deep
-- in a definition's body, the library's module imported first.

module head-clash

import check
import co
import limits
import std.process

t : Test
t =
  integration "a" (do
  r <- run { command = "sh", args = ["-c", "true"] }
  assert "it exited with 0" (succeeded r))
