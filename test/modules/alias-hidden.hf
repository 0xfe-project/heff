-- A local name hides an import's alias: in `fresh`, `Map.empty` is the
-- argument's; anywhere else, the module's.

module alias-hidden

import std.map as Map

theory Store where
  t : Type
  empty : t

ints : Store
ints = { t = Int, empty = 0 }

fresh : (Map : Store) -> Map.t
fresh Map = Map.empty

-- | >>> fresh ints
-- | 0
zero : Int
zero = fresh ints

-- | >>> Map.size none
-- | 0
none : Map.Map Int Int
none = Map.empty
