-- A local name hides an import's alias: in `fresh`, `OrdMap.empty` is the
-- argument's; anywhere else, the module's.

module alias-hidden

import std.ordmap as OrdMap

theory Store where
  t : Type
  empty : t

ints : Store
ints = { t = Int, empty = 0 }

fresh : (OrdMap : Store) -> OrdMap.t
fresh OrdMap = OrdMap.empty

-- | >>> fresh ints
-- | 0
zero : Int
zero = fresh ints

-- | >>> OrdMap.size none
-- | 0
none : OrdMap.OrdMap Int Int
none = OrdMap.empty
