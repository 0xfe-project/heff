-- a `mutual` block, of which the header exposes one definition and
-- hides the names its lowering made

module knot (even, evenly)

mutual
  even : Int -> Bool
  even n = if n == 0 then True else odd (n - 1)

  odd : Int -> Bool
  odd n = if n == 0 then False else even (n - 1)

evenly : Int -> Bool
evenly n = even n
