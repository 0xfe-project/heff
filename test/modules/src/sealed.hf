-- a module that says what it exposes: a data type bare (its tags its
-- own), one with its tags, an alias, a theory, an operator and an
-- instance; the rest -- a helper, an instance -- its own

module
  ( Counter
  , Shape(..)
  , Pairing
  , Sized
  , counter
  , bump
  , count
  , (<#>)
  , instanceSizedShape
  )

data Counter = MkCounter Int

data Shape = Dot | Line Int

type Pairing = Pair Int Int

theory Sized (a : Type) where
  size : a -> Int

-- (what the module keeps to itself)
start : Int
start = 0

counter : Counter
counter = MkCounter start

bump : Counter -> Counter
bump (MkCounter n) = MkCounter (n + 1)

count : Counter -> Int
count (MkCounter n) = n

(<#>) : Int -> Int -> Int
(<#>) x y = x * 10 + y

infixl <#>

instance instanceSizedShape : Sized Shape
instanceSizedShape =
  { size = \s -> case s of
      Dot -> 0
      Line n -> n
  }

instance instanceSizedCounter : Sized Counter
instanceSizedCounter = { size = count }
