-- the instances of a module imported qualified, `import m as M`, are in
-- scope too: an instance is found by its type, not by its name

import equality
import eqint as I

-- | >>> found
-- | True
found : Bool
found = member 2 [1, 2]

-- | >>> given
-- | False
given : Bool
given = member (eq := I.eqInt) 3 [1, 2]
