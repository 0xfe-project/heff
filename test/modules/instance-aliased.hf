-- the instances of a module imported qualified, `import m as M`, are in
-- scope too: an instance is found by its type, not by its name

module instance-aliased

import equality
import eqint as EqInt

-- | >>> found
-- | True
found : Bool
found = member 2 [1, 2]

-- | >>> given
-- | False
given : Bool
given = member (eq := EqInt.instanceEqInt) 3 [1, 2]
