-- another file projects the module's record type, and the shape is in
-- hand: the type and the values come through the struct, by `reflect`
import prelude
import structmod as M

get :: M.m.tok -> Int
get t = t.k

-- >>> get (M.m.mk 7)
-- 7

-- >>> (M.m.mk 3).k
-- 3

-- >>> map (\(t :: M.m.tok) -> t.k) [M.m.mk 1, M.m.mk 2]
-- Cons 1 (Cons 2 Nil)
