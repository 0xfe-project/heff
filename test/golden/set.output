-- elaborated
name: Bool
type: Type
syntax: sum
  'true
  'false
end
name: ORD
type: Theory
syntax: sig
  t : Type
  compare : t -> t -> Bool
end
name: SET
type: (a : Type) -> Theory
syntax: a => sig
  t : Type
  contains : t -> a -> Bool
end
name: TreeType
type: (M : ORD) -> SET M.t
syntax: M => [
  t : sum
    'leaf M.t
    'node (TreeType M .t) M.t (TreeType M .t)
  end,
  contains : x => y => abandon
]
name: Regex
type: ORD
syntax: [
  t : sum
    'star
    'oneof (TreeType Regex .t)
  end,
  compare : x => y => abandon
]
-- evaluated
Bool = #erased
ORD = #erased
SET = #fun
TreeType = #fun
Regex = [t := #erased, compare := #fun]
-- messages
