def Bool : Type := sum
  'true
  'false
end

theory ORD := sig
  t : Type
  compare : t -> t -> Bool
end

theory SET (a : Type) := sig
  t : Type
  contains : t -> a -> Bool
end

def TreeType (M : ORD) : SET (M.t) := struct
  t := sum
    'leaf (M.t)
    'node (TreeType M .t) (M.t) (TreeType M .t)
  end

  contains := x => y => abandon
end

def Regex : ORD := struct
  t := sum
    'star
    'oneof (TreeType Regex .t)
  end

  compare := x => y => abandon
end
