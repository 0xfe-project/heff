-- elaborated
name: Monoid
type: Theory
syntax: sig
  t : Type
  m : t -> t -> t
end
name: Rig
type: Theory
syntax: sig
  t : Type
  plus : Monoid & [.t := t]
  times : Monoid & [.t := t]
end
name: blah
type: (R : Rig) -> (x : R.t) -> R.t
syntax: R => x => R.plus.m x (R.times.m x x)
name: Bool
type: Type
syntax: sum
  'true
  'false
end
name: Or
type: Monoid & [.t := Bool]
syntax: [t : Bool, m : x => y => match x   'true => 'true   'false => y end]
name: And
type: Monoid & [.t := Bool]
syntax: [t : Bool, m : x => y => match x   'true => y   'false => 'false end]
name: BoolRig
type: Rig
syntax: [t : Bool, plus : Or, times : And]
name: test0
type: Bool
syntax: blah BoolRig 'true
-- evaluated
Monoid = #erased
Rig = #erased
blah = #fun
Bool = #erased
Or = [t := #erased, m := #fun]
And = [t := #erased, m := #fun]
BoolRig = [ t := #erased
, plus := [t := #erased, m := #fun]
, times := [t := #erased, m := #fun] ]
test0 = 'true
-- messages
