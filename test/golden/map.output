-- elaborated
name: Bool
type: Type
syntax: sum
  'false
  'true
end
name: Option
type: (a : Type) -> Type
syntax: a => sum
  'some a
  'none
end
name: Eq
type: Theory
syntax: sig
  t : Type
  eq : t -> t -> Bool
end
name: Map
type: Theory
syntax: sig
  key : Type
  map : Type -> Type
  empty : (a : Type) -> map a
  add : (a : Type) -> key -> a -> map a -> map a
  lookup : (a : Type) -> key -> map a -> Option a
end
name: LambdaMap
type: (Key : Eq) -> Map
syntax: Key => [
  key : Key.t,
  map : a => Key.t -> Option a,
  empty : a => x => 'none,
  add : a => k => v => m => x => match Key.eq k x
    'false => m x
    'true => 'some v
  end,
  lookup : a => x => m => m x
]
name: Color
type: Type
syntax: sum
  'red
  'green
  'blue
end
name: ColorEq
type: Eq
syntax: [
  t : Color,
  eq : c1 => c2 => match c1
    'red => match c2
      'red => 'true
      'green => 'false
      'blue => 'false
    end
    'green => match c2
      'red => 'false
      'green => 'true
      'blue => 'false
    end
    'blue => match c2
      'red => 'false
      'green => 'false
      'blue => 'true
    end
  end
]
name: ColorMap
type: Map
syntax: LambdaMap ColorEq
name: redMap
type: Color -> Option Bool
syntax: ColorMap.add Bool 'red 'true (ColorMap.empty Bool)
name: red
type: Color
syntax: 'red
name: likesRed
type: Option Bool
syntax: ColorMap.lookup Bool 'red redMap
-- evaluated
Bool = #erased
Option = #fun
Eq = #erased
Map = #erased
LambdaMap = #fun
Color = #erased
ColorEq = [t := #erased, eq := #fun]
ColorMap = [ key := #erased
, map := #fun
, empty := #fun
, add := #fun
, lookup := #fun ]
redMap = #fun
red = 'red
likesRed = 'some 'true
-- messages
