def Bool : Type := sum
  'true
  'false
end

theory Eq := sig
  t : Type
  eq : t -> t -> Bool
end

theory EqPair := sig
  even : Eq
  odd : Eq
end

def EvenAndOdd : EqPair := struct
  even := struct
    t := sum
      'zero
      'succ EvenAndOdd.odd.t
    end
    eq := x => y => match x
      'zero => match y
         'zero => 'true
         'succ _ => 'false
      end
      'succ x0 => match y
         'zero => 'false
         'succ y0 => rec (EvenAndOdd.odd.eq x0 y0)
      end
    end
  end
  odd := struct
    t := sum
      'succ EvenAndOdd.even.t
    end
    eq := x => y => match x
      'succ x0 => match y
         'succ y0 => rec (EvenAndOdd.even.eq x0 y0)
      end
    end
  end
end
