-- elaborated
name: Bool
type: Type
syntax: sum
  'true
  'false
end
name: Eq
type: Theory
syntax: sig
  t : Type
  eq : t -> t -> Bool
end
name: EqPair
type: Theory
syntax: sig
  even : Eq
  odd : Eq
end
name: EvenAndOdd
type: EqPair
syntax: [
  even : [
    t : sum
      'zero
      'succ EvenAndOdd.odd.t
    end,
    eq : x => y => match x
      'zero => match y
        'zero => 'true
        'succ _ => 'false
      end
      'succ x0 => match y
        'zero => 'false
        'succ y0 => EvenAndOdd.odd.eq x0 y0
      end
    end
  ],
  odd : [
    t : sum
      'succ EvenAndOdd.even.t
    end,
    eq : x => y => match x
      'succ x0 => match y
        'succ y0 => EvenAndOdd.even.eq x0 y0
      end
    end
  ]
]
-- evaluated
Bool = #erased
Eq = #erased
EqPair = #erased
EvenAndOdd = [ even := [t := #erased, eq := #fun]
, odd := [t := #erased, eq := #fun] ]
-- messages
