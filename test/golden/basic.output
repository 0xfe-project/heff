-- elaborated
name: Bool
type: Type
syntax: sum
  'true
  'false
end
name: not
type: (b : Bool) -> Bool
syntax: b => match b
  'true => 'false
  'false => 'true
end
name: Maybe
type: (A : Type) -> Type
syntax: A => sum
  'just A
  'nothing
end
name: List
type: (A : Type) -> Type
syntax: A => sum
  'cons A (List A)
  'nil
end
name: map
type: (A : Type) -> (B : Type) -> (f : A -> B) -> (xs : List A) -> List B
syntax: A => B => f => xs => match xs
  'cons x xs => 'cons (f x) (map A B f xs)
  'nil => 'nil
end
name: test0
type: List Bool
syntax: map Bool Bool not ('cons 'true ('cons 'false 'nil))
-- evaluated
Bool = #erased
not = #fun
Maybe = #fun
List = #fun
map = #fun
test0 = 'cons 'false 'cons 'true 'nil
