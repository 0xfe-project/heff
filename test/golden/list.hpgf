def List (a : Type) : Type := sum
  'nil
  'cons a (List a)
end

def map (a : Type) (b : Type) (f : a -> b) (xs : List a) : List b := match xs
  'nil => 'nil
  'cons x ys => 'cons (f x) (rec (map a b f ys))
end

def Bool : Type := sum
  'true
  'false
end

def not (b : Bool) : Bool := match b
  'true => 'false
  'false => 'true
end

def l0 : List Bool := map Bool Bool not ('cons 'true ('cons 'false 'nil))
