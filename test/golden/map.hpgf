def Bool : Type := sum
  'false
  'true
end

def Option (a : Type) : Type := sum
  'some a
  'none
end

theory Eq := sig
  t : Type
  eq : t -> t -> Bool
end

theory Map := sig
  key : Type
  map : Type -> Type
  empty : (a : Type) -> map a
  add : (a : Type) -> key -> a -> map a -> map a
  lookup : (a : Type) -> key -> map a -> Option a
end

def LambdaMap (Key : Eq) : Map := struct
  key := Key.t
  map := a => Key.t -> Option a
  empty := a => x => 'none
  add := a => k => v => m => x => match (Key.eq k x)
    'true => 'some v
    'false => m x
  end
  lookup := a => x => m => m x
end

def Color : Type := sum
  'red
  'green
  'blue
end

def ColorEq : Eq := struct
  t := Color
  eq := c1 => c2 => match c1
    'red => match c2
      'red => 'true
      'green => 'false
      'blue => 'false
    end
    'green => match c2
      'red => 'false
      'green => 'true
      'blue => 'false
    end
    'blue => match c2
      'red => 'false
      'green => 'false
      'blue => 'true
    end
  end
end

def ColorMap : Map := LambdaMap ColorEq

def redMap : ColorMap.map Bool := ColorMap.add Bool 'red 'true (ColorMap.empty Bool)

def red : Color := 'red

def likesRed : Option Bool := ColorMap.lookup Bool ('red) redMap
