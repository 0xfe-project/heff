def Bool : Type := sum
  'true
  'false
end

def not (b : Bool) : Bool := match b
  'true => 'false
  'false => 'true
end

def Maybe (A : Type) : Type := sum
  'just A
  'nothing
end

def List (A : Type) : Type := sum
  'cons A (List A)
  'nil
end

def map (A : Type) (B : Type) (f : A -> B) (xs : List A) : List B := match xs
  'cons x xs => 'cons (f x) (rec (map A B f xs))
  'nil => 'nil
end

def test0 : List Bool := map Bool Bool not ('cons 'true ('cons 'false 'nil))

