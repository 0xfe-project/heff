def Nat : Type := sum
  'zero
  'succ Nat
end
 
def Bwd (A : Type) : Type := sum
  'nil
  'snoc (Bwd A) A
end

def Bwd/elemAt (A : Type) (xs : Bwd A) (n : Nat) : A := match xs
  'nil => abandon
  'snoc xs x => match n
    'zero => x
    'succ n => rec (Bwd/elemAt A xs n)
  end
end

def Stx : Type := sum
  'var Nat
  'app Stx Stx
  'lam Stx
end

def Val : Type := sum
  'neu Nat (Bwd Val)
  'lam (Val -> Val)
end

def Env : Type := Bwd Val

def app (v0 : Val) (v1 : Val) : Val := match v0
  'neu i vs => 'neu i ('snoc vs v1)
  'lam f => f v1
end

def eval (e : Env) (t : Stx) : Val := match t
  'var i => Bwd/elemAt Val e i
  'app t0 t1 => app (rec (eval e t0)) (rec (eval e t1))
  'lam t => 'lam (v => rec (eval ('snoc e v) t))
end

theory Quote/typeof := sig
  spine : Bwd Val -> Stx -> Stx
  val : Val -> Stx
end

def Quote (n : Nat) : Quote/typeof := struct
  spine := sp => t => match sp
    'nil => t
    'snoc sp v => 'app (rec (Quote n .spine sp t)) (rec (Quote n .val v))
  end

  val := v => match v
    'neu i vs => rec (Quote n .spine vs ('var i))
    'lam f => 'lam (rec (Quote ('succ n) .val (f ('neu n 'nil))))
  end
end

def norm (t : Stx) : Stx := Quote 'zero .val (eval 'nil t)

def t0 : Stx := norm ('lam ('app ('lam ('var 'zero)) ('var 'zero)))
