theory ThOddAndEven := sig
  odd : Type
  even : Type
end

def OddAndEven : ThOddAndEven := struct
  odd := sum
    'succ OddAndEven.even
  end

  even := sum
    'zero
    'succ OddAndEven.odd
  end
end

def three : OddAndEven.odd := 'succ ('succ ('succ 'zero))

def bad-three : OddAndEven.even := 'succ ('succ ('succ 'zero))
