-- elaborated
name: Nat
type: Type
syntax: sum
  'zero
  'succ Nat
end
name: Bwd
type: (A : Type) -> Type
syntax: A => sum
  'nil
  'snoc (Bwd A) A
end
name: Bwd/elemAt
type: (A : Type) -> (xs : Bwd A) -> (n : Nat) -> A
syntax: A => xs => n => match xs
  'nil => abandon
  'snoc xs x => match n
    'zero => x
    'succ n => Bwd/elemAt A xs n
  end
end
name: Stx
type: Type
syntax: sum
  'var Nat
  'app Stx Stx
  'lam Stx
end
name: Val
type: Type
syntax: sum
  'neu Nat (Bwd Val)
  'lam (Val -> Val)
end
name: Env
type: Type
syntax: Bwd Val
name: app
type: (v0 : Val) -> (v1 : Val) -> Val
syntax: v0 => v1 => match v0
  'neu i vs => 'neu i ('snoc vs v1)
  'lam f => f v1
end
name: eval
type: (e : Bwd Val) -> (t : Stx) -> Val
syntax: e => t => match t
  'var i => Bwd/elemAt Val e i
  'app t0 t1 => app (eval e t0) (eval e t1)
  'lam t => 'lam (v => eval ('snoc e v) t)
end
name: Quote/typeof
type: Theory
syntax: sig
  spine : Bwd Val -> Stx -> Stx
  val : Val -> Stx
end
name: Quote
type: (n : Nat) -> Quote/typeof
syntax: n => [
  spine : sp => t => match sp
    'nil => t
    'snoc sp v => 'app (Quote n .spine sp t) (Quote n .val v)
  end,
  val : v => match v
    'neu i vs => Quote n .spine vs ('var i)
    'lam f => 'lam (Quote ('succ n) .val (f ('neu n 'nil)))
  end
]
name: norm
type: (t : Stx) -> Stx
syntax: t => Quote 'zero .val (eval 'nil t)
name: t0
type: Stx
syntax: norm ('lam ('app ('lam ('var 'zero)) ('var 'zero)))
-- evaluated
Nat = #erased
Bwd = #fun
Bwd/elemAt = #fun
Stx = #erased
Val = #erased
Env = #erased
app = #fun
eval = #fun
Quote/typeof = #erased
Quote = #fun
norm = #fun
t0 = 'lam 'var 'zero
-- messages
