theory Monoid := sig
  t : Type
  m : t -> t -> t
end

theory Rig := sig
  t : Type
  plus : Monoid ~ [ .t := t ]
  times : Monoid ~ [ .t := t ]
end

def blah (R : Rig) (x : R.t) : R.t := R.plus.m x (R.times.m x x)

def Bool : Type := sum
  'true
  'false
end

def Or : Monoid ~ [ .t := Bool ] := struct
  t := Bool
  m := x => y => match x
    'true => 'true
    'false => y
  end
end

def And : Monoid ~ [ .t := Bool ] := struct
  t := Bool
  m := x => y => match x
    'true => y
    'false => 'false
  end
end

def BoolRig : Rig := struct
  t := Bool
  plus := Or
  times := And
end

def test0 : Bool := blah BoolRig 'true
