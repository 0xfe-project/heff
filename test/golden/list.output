-- elaborated
name: List
type: (a : Type) -> Type
syntax: a => sum
  'nil
  'cons a (List a)
end
name: map
type: (a : Type) -> (b : Type) -> (f : a -> b) -> (xs : List a) -> List b
syntax: a => b => f => xs => match xs
  'nil => 'nil
  'cons x ys => 'cons (f x) (map a b f ys)
end
name: Bool
type: Type
syntax: sum
  'true
  'false
end
name: not
type: (b : Bool) -> Bool
syntax: b => match b
  'true => 'false
  'false => 'true
end
name: l0
type: List Bool
syntax: map Bool Bool not ('cons 'true ('cons 'false 'nil))
-- evaluated
List = #fun
map = #fun
Bool = #erased
not = #fun
l0 = 'cons 'false 'cons 'true 'nil
-- messages
