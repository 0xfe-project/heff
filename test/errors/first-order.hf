-- test: expect errors
-- first-order approximation (#88) solves `?m a =?= C b` for
-- `C` a sum or a record only: not `?m Int =?= Int`, where `Int` has no
-- argument for `?m`'s, nor against a local's application

module test.errors.first-order

theory Monad (m : Type -> Type) where
  pure : {a : Type} -> a -> m a
  bind : {a b : Type} -> m a -> (a -> m b) -> m b

twice : {m : Type -> Type} -> {{mo : Monad m}} -> m Int -> m Int
twice c = mo.bind c (\x -> mo.bind c (\y -> mo.pure (x + y)))

-- `?m Int =?= Int`: fewer arguments than `?m` is applied to (E0340)
bad1 : Int
bad1 = twice (3 : Int)

-- `?m Int =?= f Int`, `f` a local: postponed, not approximated (E0340)
bad2 : {f : Type -> Type} -> {{fo : Monad f}} -> f Int -> f Int
bad2 c = twice c
