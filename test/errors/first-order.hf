-- test: expect errors
-- first-order approximation (#88) solves `?m a =?= C b` for a type
-- declared `C` only: not `?m Int =?= Int`, where `Int` has no argument
-- for `Int`, nor against a local's application or a type function

theory Monad (m : Type -> Type) where
  pure : {a : Type} -> a -> m a
  bind : {a b : Type} -> m a -> (a -> m b) -> m b

twice : {m : Type -> Type} -> {{mo : Monad m}} -> m Int -> m Int
twice c = mo.bind c (\x -> mo.bind c (\y -> mo.pure (x + y)))

-- `?m Int =?= Int`: fewer arguments than `?m` is applied to (E0340)
bad1 : Int
bad1 = twice (3 : Int)

-- `?m Int =?= f Int`, `f` a local: postponed, not approximated (E0340)
bad2 : {f : Type -> Type} -> {{fo : Monad f}} -> f Int -> f Int
bad2 c = twice c

-- a type function by equations may compute: not approximated (E0340)
Box : (a : Type) -> Type
Box a = { item : a }

instance instanceMonadBox : Monad Box
instanceMonadBox = { pure = \x -> { item = x }, bind = \c k -> k c.item }

bad3 : Box Int
bad3 = twice ({ item = 2 } : Box Int)
