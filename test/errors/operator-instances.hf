-- an operator at a type with no instance of its theory: a string has no
-- `Addition`, a float no `Division` (its division is `/.`), a pair no
-- `Order`, an integer no `FloatDivision` (its division is `/`), and an
-- `Int64`'s are its module's, not imported here

joined : String
joined = "he" + "ff"

halved : Float64
halved = 1.0 / 2.0

ordered : Bool
ordered = (MkPair 1 2 : Pair Int Int) < MkPair 1 3

floatHalved : Int
floatHalved = 1 /. 2

wide : Int64
wide = 7 + 1
