-- test: expect errors
-- One error, reported once, and no abandoning: a record type that did
-- not parse (`test` is a keyword, no field's name) makes one made of it
-- an error hole, and a lambda whose binder is annotated with that, its
-- body a field taken of it, is an error hole too -- not a function type
-- unequal to the one wanted, whose message would say the error's type.

type Job = { owner : Int, test : String }

type Finished = { owner : Int, jobs : List Job }

owner : Finished -> Int
owner f = (\(x : Finished) -> x.owner) f

owners : List Finished -> List Int
owners fs = List.map (\(f : Finished) -> f.owner) fs
