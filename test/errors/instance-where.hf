-- test: expect errors
-- an instance is the module's, declared at the top level: none is
-- declared in a `where` (the file does not parse there)

theory Eq (a : Type) where
  equal : a -> a -> Bool

local : Bool
local = eqBool.equal True True
  where
    instance eqBool : Eq Bool
    eqBool = { equal = \a b -> True }
