-- instance search looks in the scope only, and refuses none and many

theory Eqv a where
  eqv : a -> a -> Bool

whoEq : {a : Type} -> {{e : Eqv a}} -> a -> a -> Bool
whoEq x y = e.eqv x y

-- none in scope
bad1 : Bool
bad1 = whoEq 1 2

-- two of the same type in scope
bad2 : {{e1 : Eqv Int}} -> {{e2 : Eqv Int}} -> Bool
bad2 = whoEq 1 2
