-- instance search refuses none and refuses many
import prelude

theory Eqv a where
  eqv : a -> a -> Bool

whoEq : {a : Type} -> [e : Eqv a] -> a -> a -> Bool
whoEq e x y = e.eqv x y

-- no instance in scope
bad1 : Bool
bad1 = whoEq 1 2

instance eqInt1 : Eqv Int
eqInt1 = { eqv = \a b -> a == b }

instance eqInt2 : Eqv Int
eqInt2 = { eqv = \a b -> False }

-- more than one
bad2 : Bool
bad2 = whoEq 1 2
