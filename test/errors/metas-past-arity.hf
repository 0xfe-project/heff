-- test: expect errors
-- A metavariable applied past its arity, to a local in scope of what it
-- is unified with, stands in it as it is: of the type it has applied to
-- all of them (`?m t : Type`, not `Type -> Type`).  Nothing says what
-- `made`'s `m` is here, and that is said.

module test.errors.metas-past-arity

made : {m : Type -> Type} -> (t : Type) -> m t
made t = abandon

Of : {m : Type -> Type} -> ((t : Type) -> m t) -> Type
Of f = m Int

x1 : Of made -> Int
x1 z = 0
