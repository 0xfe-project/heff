-- test: expect errors
-- An instance whose field is not what the specialization says, and one
-- whose field is not known, are not instances of it.

module test.errors.specialize

data Bool = True | False

data Unit = Tt

theory Th where
  t : Type
  pick : t -> Bool

inst : Th
inst = { t = Bool, pick = \x -> x }

wrong : Th (t := Unit)
wrong = inst

unknown : (m : Th) -> Th (t := Bool)
unknown m = m

-- A name neither an argument nor a field.
neither : Th (u := Bool)
neither = inst
