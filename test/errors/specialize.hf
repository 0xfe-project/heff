-- test: expect errors
-- An instance whose field is not what the specialization says, and one
-- whose field is not known, are not instances of it; a field the theory
-- does not have, or a head that is not a theory, is not specialised; a
-- field is not a named argument.

module test.errors.specialize

data Bool = True | False

data Unit = Tt

theory Th where
  t : Type
  pick : t -> Bool

inst : Th
inst = { t = Bool, pick = \x -> x }

wrong : Th @ { t = Unit }
wrong = inst

unknown : (m : Th) -> Th @ { t = Bool }
unknown m = m

noField : Th @ { u = Bool }
noField = inst

notTheory : Bool @ { t = Bool }
notTheory = True

named : Th (t := Bool)
named = inst
