-- test: expect errors
-- What an implicit argument's default is not: inferred (it is given as
-- it is), naming the parameters before it, of another type; and without
-- one, a small implicit argument could never be inferred.

same : {a : Type := Int} -> a -> a
same x = x

-- (`a` is `Int`, not what `"s"` would have it be)
notInferred : String
notInferred = same "s"

-- (a default names definitions only)
named : (n : Int) -> {m : Int := n} -> Int
named n = m

small : {b : Bool} -> Int
small = 1

wrong : {b : Bool := 3} -> Int
wrong = 1

-- (`:=` gives an implicit argument's default; a record type's field has
-- `=`)
type R = { x : Int := 3 }
