-- test: expect errors
-- `deriving` refused (E0150), at what it cannot make: a theory that is
-- not the prelude's `Equality`, `Order`, `Debug` or `Show`; `Order`
-- without `Equality`; a theory named twice; what is not a theory's
-- name; a type with no alternatives, with a parameter `(x : T)`, or
-- given its universe; a field that holds the type inside another type,
-- which a derived instance cannot reach; a `type` that is no record
-- type, or one with a parameter `(x : T)`, or a field holding it; and
-- `Hash` where std.hashmap is not imported (E0308).  A field whose type has
-- no instance is the instance search's error, at the theory's name.

module test.errors.deriving

data A = A1 | A2 deriving Monad

data B = B1 deriving (Order, Debug)

data C = C1 deriving (Equality, Equality)

data D = D1 deriving (Equality Int)

data E = E1 | E2
  deriving [Debug]

data F a deriving Equality

data G (n : Int) = G1 deriving Equality

data H : Type = H1 deriving Equality

data Rose a = MkRose a (List (Rose a)) deriving (Equality, Debug)

data Fn = MkFn (Int -> Int) deriving Equality

type Size = Int deriving Equality

type Step = Int -> Int deriving Debug

type Sized (n : Int) = { x : Int } deriving Equality

type Chain = { next : Maybe Chain } deriving Equality

type Pos = { x : Int } deriving (Order, Debug)

data Coin = Heads | Tails deriving (Equality, Hash)
