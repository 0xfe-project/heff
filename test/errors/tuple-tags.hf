-- test: expect errors
-- A tag in a tuple inferring waits for its type, but a `case` on the pair
-- does not say it (its patterns' tags say no type, as a tag alone does
-- not), nor does a type's argument at a kind to be found: once nothing is
-- left to say it, the tag is E0314.

module test.errors.tuple-tags

later : Int
later = case (1, Nothing) of
  (n, Just m) -> n + m
  (n, Nothing) -> n

first : Int
first = case (Nothing, 1, Just 2) of
  (Just m, n, _) -> n + m
  (Nothing, n, _) -> n

Wrap : {k : Type} -> k -> Type
Wrap x = Int

wrapped : Wrap (1, Nothing)
wrapped = 3
