-- test: expect errors
-- A tag checked at a function type is eta-expanded (#89), and the tag
-- applied checked at the last codomain: what is wrong is said there, as
-- of the tag applied by hand.

data Box = MkBox Int

data P = MkP Int Int

-- not one of `Int`'s
mk : Int -> Int
mk = MkBox

-- not one of `Box`'s: the same as `MkP 1 x`
part : Int -> Box
part = MkP 1

partByHand : Int -> Box
partByHand x = MkP 1 x

-- one argument too many
many : Int -> Int -> P
many = MkP 1

-- at the type it waits for
ys : List Int
ys = List.map MkBox [1, 2]

-- at a type never known
q : Int
q = const 0 MkBox
