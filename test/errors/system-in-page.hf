-- The system's effects, imported by a page's script (--backend=page,
-- test/golden.mjs's compile): each import of one with no provider in
-- the page an error (E0352) -- std.io's is Node.js's, std.http and
-- std.net have none but C's -- and std.ref, std.time and the pure
-- std.path none, nor the browser's.  It checks, as any backend's module does.

import co
import browser.dom
import std.io
import std.http as Http
import std.net as Net
import std.path
import std.ref
import std.time as Time

page : HFunctor
page = dom <+> Time.time

program : {{onDom : dom <: page}} -> {{onTime : Time.time <: page}} -> Co page Unit
program = do
  Time.sleep 10
  out <- select "#out"
  found out (\o -> text o "slept")

app : Co page Unit
app = program (onDom := inl dom Time.time) (onTime := inr dom Time.time)
