-- The system's effects, imported by a page's script (--backend=page):
-- each import of one with no provider in
-- the page an error (E0352) -- std.io, std.http and std.net have none
-- but C's -- and of a module of lib/std/ that imports
-- one, however far down: std.http.server (std.http and std.net, its
-- note says which).  Not std.reference, std.time, the pure std.path, nor
-- std.handle (imported by std.net, importing none), nor the browser's.  It checks, as any backend's module does.

import co
import browser.dom
import std.io
import std.handle
import std.http as Http
import std.http.server as Server
import std.net as Net
import std.path
import std.reference
import std.time as Time

page : HFunctor
page = dom <+> Time.time

program : {{onDom : dom <: page}} -> {{onTime : Time.time <: page}} -> Co page Unit
program = do
  Time.sleep 10
  out <- select "#out"
  found out (\o -> text o "slept")

app : Co page Unit
app = program (onDom := inl dom Time.time) (onTime := inr dom Time.time)
