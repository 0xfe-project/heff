-- test: expect errors
-- A record type with a field that is a type is no type of run-time data:
-- it is a theory, and said so, the field named -- and what is made of it
-- is not an error again.

module test.errors.large-record

type Pack = { t : Type, size : Int }

pack : Pack
pack = { t = Int, size = 8 }

sizeOf : Pack -> Int
sizeOf p = p.size

type Wrap (a : Type) = { f : Type -> Type, x : a }

-- (as a theory, it is one)
theory Packed where
  t : Type
  size : Int

packed : Packed
packed = { t = Int, size = 8 }
