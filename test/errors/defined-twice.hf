-- test: expect errors
-- A name is defined once in a module (E0153), at the second definition,
-- which says where the first is: by a signature, by a `data`, `type`,
-- `theory` or `primitive`, or by equations that are not right under
-- their signature.  A tag is no definition: two types may have the same.

module test.errors.defined-twice

one : Int
one = 1

one : Int
one = 2

data Shape = Circle | Square

data Shape = Triangle

type Size = Int

data Size = Small | Large

theory Sized a where
  size : a -> Int

Sized : Type
Sized = Int

-- (equations apart, another definition between them)
double : Int -> Int
double n = n + n

two : Int
two = 2

double n = 2 * n

-- (a primitive, which the library alone declares, is a definition too)
primitive seven : Int

seven : Int
seven = 7

-- (an equation above its signature)
half n = n

half : Int -> Int

-- (an instance is a definition too)
showOne : Int
showOne = 1

instance showOne : Int
showOne = 1

-- (in a `where` too)
three : Int
three = x
  where
    x : Int
    x = 1
    x : Int
    x = 3

-- (a watch between equations keeps them together)
sign : Int -> Int
sign 0 = 0
-- >>> sign 0
-- 0
sign n = 1

data Light = Square | Amber
