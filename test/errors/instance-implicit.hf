-- An instance's implicit argument is solved by unifying what it is an
-- instance of with the type wanted, so it must be in it: `weird`'s `a`
-- and `half`'s `b` are not, and are said so where they are declared,
-- not where a search would fail to solve them -- nor again where one
-- of them may have been the instance wanted.

theory Same (a : Type) where
  same : a -> a -> Bool

instance weird : {a : Type} -> Same Bool
weird = { same = \x y -> True }

instance half : {a b : Type} -> {{s : Same b}} -> Same (Maybe a)
half = { same = \x y -> True }

-- (one of an instance argument, and in what it is an instance of)
instance fine : {a : Type} -> {{s : Same a}} -> Same (List a)
fine = { same = \x y -> True }

isSame : {a : Type} -> {{s : Same a}} -> a -> a -> Bool
isSame x y = s.same x y

-- (`half` may have been the one: no error of its own)
used : Maybe Int -> Bool
used m = isSame m m
