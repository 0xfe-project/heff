-- test: expect errors
-- An instance's implicit argument is solved by unifying what it is an
-- instance of with the type wanted, so it must be in it:
-- `instanceSameBool`'s `a` and `instanceSameMaybe`'s `b` are not, and
-- are said so where they are declared, not where a search would fail to
-- solve them -- nor again where one of them may have been the instance
-- wanted.

theory Same (a : Type) where
  same : a -> a -> Bool

instance instanceSameBool : {a : Type} -> Same Bool
instanceSameBool = { same = \x y -> True }

instance instanceSameMaybe : {a b : Type} -> {{s : Same b}} -> Same (Maybe a)
instanceSameMaybe = { same = \x y -> True }

-- (one of an instance argument, and in what it is an instance of)
instance instanceSameList : {a : Type} -> {{s : Same a}} -> Same (List a)
instanceSameList = { same = \x y -> True }

isSame : {a : Type} -> {{s : Same a}} -> a -> a -> Bool
isSame x y = s.same x y

-- (`instanceSameMaybe` may have been the one: no error of its own)
used : Maybe Int -> Bool
used m = isSame m m
