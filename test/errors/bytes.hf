-- test: expect errors
-- `Bytes` are a type of their own: no `String`, nor a string a `Bytes`
-- -- a string is made one by `fromString`, a list of bytes by
-- `fromList`, each a `UInt8`, in its range -- and a bytes literal,
-- `b"..."`, is one, no `String`, nor a string's pattern.

import bytes as Bytes

asText : String
asText = Bytes.fromString "hi"

fromText : Bytes
fromText = "hi"

appended : String
appended = "a" ^ Bytes.empty

tooLarge : Bytes
tooLarge = Bytes.fromList [104, 256]

textInList : Bytes
textInList = Bytes.fromList [showInt 1]

literalAsText : String
literalAsText = b"hi"

literalPattern : String -> Bool
literalPattern b"GET" = True
literalPattern _ = False

-- (fine: what each is made into)
made : String
made = Bytes.toString (Bytes.fromString "hi")

fromLiteral : String
fromLiteral = Bytes.toString b"hi\xff"
