-- test: expect errors
-- An instance is found by its theory and parameters alone: two
-- instances of a theory without parameters, each specialised, are both
-- candidates; and the one found whose field is not what the goal's
-- specialisation says is refused.

module test.errors.instance-specialised

theory Zero where
  t : Type
  zero : t

instance zeroInt : Zero @ { t = Int }
zeroInt = { t = Int, zero = 0 }

instance zeroString : Zero @ { t = String }
zeroString = { t = String, zero = "" }

zeroOf : {{z : Zero}} -> z.t
zeroOf = z.zero

both : Int
both = zeroOf

firstString : {c : Type} -> {{it : Iterate c @ { Elem = String }}} -> c -> Int
firstString xs = 0

nums : List Int
nums = [1, 2]

mismatch : Int
mismatch = firstString nums
