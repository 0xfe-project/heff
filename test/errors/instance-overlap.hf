-- the prelude's eqList is of every `Eq (List a)`, and this module's own
-- of `Eq (List Int)` overlaps it: a search for `Eq (List Int)` finds
-- both, and is refused -- an instance declared, or imported, makes an
-- error of a search, never another answer -- wherever it is wanted, by
-- the program or by an instance; one for `Eq (List String)` finds the
-- prelude's alone

instance eqInts : Eq (List Int)
eqInts = { equal = \xs ys -> True }

overlapping : List Int -> Bool
overlapping xs = equal xs xs

-- wanted by eqMaybe
nested : Maybe (List Int) -> Bool
nested m = equal m m

-- eqList's, alone
strings : List String -> Bool
strings xs = equal xs xs

-- (given, no search: no error)
given : List Int -> Bool
given xs = equal (eq := eqInts) xs xs
