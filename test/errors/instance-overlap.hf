-- test: expect errors
-- the prelude's instanceEqualityList is of every `Equality (List a)`, and this module's own
-- of `Equality (List Int)` overlaps it: a search for `Equality (List Int)` finds
-- both, and is refused -- an instance declared, or imported, makes an
-- error of a search, never another answer -- wherever it is wanted, by
-- the program or by an instance; one for `Equality (List String)` finds the
-- prelude's alone

module test.errors.instance-overlap

instance instanceEqualityListInt : Equality (List Int)
instanceEqualityListInt = { equal = \xs ys -> True }

overlapping : List Int -> Bool
overlapping xs = equal xs xs

-- wanted by instanceEqualityMaybe
nested : Maybe (List Int) -> Bool
nested m = equal m m

-- equalityList's, alone
strings : List String -> Bool
strings xs = equal xs xs

-- (given, no search: no error)
given : List Int -> Bool
given xs = equal (eq := instanceEqualityListInt) xs xs
