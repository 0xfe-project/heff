-- test: expect errors
-- What a record type's defaults do not do: a field without one is not
-- left out, the fields are in the type's order, a default names the
-- fields before it and definitions only, and a record whose type is not
-- known is given none.

type Opts = { name : String, verbose : Bool = False, tags : List String = [] }

-- (`name` has no default)
nameless : Opts
nameless = { verbose = True }

empty : Opts
empty = {}

-- (`verbose` comes before `tags`)
order : Opts
order = { name = "a", tags = [], verbose = True }

twice : Opts
twice = { name = "a", name = "b" }

-- (no field `tag`: `tags` is left out)
unknown : Opts
unknown = { name = "a", tag = [] }

-- (a default names earlier fields and definitions: no later, no parameter)
type Later = { early : Int = late, late : Int }

type Sized (n : Int) = { size : Int = n }

-- (a default is of its field's type)
type Wrong = { flag : Bool = 3 }

-- (an implicit argument a default leaves unsolved is an error, as
-- anywhere)
type Unsolved = { count : Int = List.length [] }

-- (inferred, a record is no record of any type: no defaults)
inferred : Bool
inferred = let r = { name = "a" } in True

-- (the fields a default given names are bound by `let`s: a type written
-- in place there, nominal, is not one of them)
theory Pick where
  T : Type
  pick : T -> T = \t -> t

picks : Pick
picks = { T = data { C | D } }
