-- test: expect errors
-- A pattern that binds must match every value: `let p = e`, `p <- e`,
-- `with e as p` and `\p -> e` refuse one that can fail (a tag of a type
-- of several, a literal), each where it is written.  A tag that is its
-- type's only one cannot fail, nor a tuple of patterns that cannot.

module test.errors.let-refutable

import co

f : Maybe Int -> Int
f m = let Just x = m in x

pairs : {e : HFunctor} -> Co e (Maybe Int, Int)
pairs = pure (Just 1, 2)

bound : {e : HFunctor} -> Co e Int
bound = do
  (Just x, y) <- pairs
  pure (x + y)

three : {e : HFunctor} -> {a : Type} -> ((Int, Bool) -> Co e a) -> Co e a
three k = k (1, True)

held : {e : HFunctor} -> Co e Int
held = do
  with three as (x, True) do
    pure x

literal : (Int, Int) -> Int
literal = \(0, b) -> b

listed : List Int -> Int
listed xs = let [a, b] = xs in a + b

only : Pair Int String -> Int
only p = let MkPair a b = p in a

fine : (Int, (Bool, String)) -> Int
fine t = let (n, (_, s)) = t in n + strLength s
