-- test: expect errors
-- a value shown, by `debug` or by `assertEqual`, of a type with no
-- instance of `Debug`: a type of the file's own, alone and in a list
-- (whose search says the instance that wanted one) -- but a rune, whose
-- instance is the prelude's, found with no import, as a string's is;
-- and a value as text, `show`, of a type with no `Show`: a type
-- of the file's own, and a list, which has none in the prelude

module test.errors.instance-debug

import check

data Color = Red | Green

named : String
named = debug (Red : Color)

listed : String
listed = debug ([Red, Green] : List Color)

quoted : String
quoted = debug 'a' ^ show 'a'

same : Test
same = unit "the same color" (assertEqual (Red : Color) Green)

text : String
text = show (Red : Color)

listedText : String
listedText = show ([1, 2] : List Int)
