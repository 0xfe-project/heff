-- test: expect errors
-- a value shown, by `show` or by `assertEqual`, of a type with no
-- instance of `Show`: a type of the file's own, alone and in a list
-- (whose search says the instance that wanted one) -- but a rune, whose
-- instance is the prelude's, found with no import, as a string's is;
-- and a value as text, `toString`, of a type with no `ToString`: a type
-- of the file's own, and a list, which has none in the prelude

import check

data Color = Red | Green

named : String
named = show (Red : Color)

listed : String
listed = show ([Red, Green] : List Color)

quoted : String
quoted = show 'a' ^ toString 'a'

same : Test
same = unit "the same color" (assertEqual (Red : Color) Green)

text : String
text = toString (Red : Color)

listedText : String
listedText = toString ([1, 2] : List Int)
