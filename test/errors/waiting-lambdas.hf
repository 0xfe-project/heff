-- test: expect errors
-- A lambda, or an application, that waits for its type and does not fit
-- it once it is known (or never knows it) is said wrong where it is, as
-- it would be had its type been known at once.

module test.errors.waiting-lambdas

ignore : {a b : Type} -> (a -> b) -> Int
ignore f = 0

-- the inner lambda waits, and its type is `Int`: no function type
notFunction : List Int
notFunction = List.map (\j -> \v -> v + j) (List.range 0 3)

-- the inner lambda's body does not fit, once its type is known
wrongBody : List (Int -> Int)
wrongBody = List.map (\j -> \v -> v ^ "!") (List.range 0 3)

-- `f` waits, and is an `Int`, applied
appliedInt : Int
appliedInt = List.foldl (\acc f -> f acc) 0 (List.range 0 3)

-- the inner lambda's type is never known
neverKnown : Int
neverKnown = ignore (\x -> \y -> y)

-- nor is `f`'s
neverApplied : Int
neverApplied = ignore (\f -> f 1)

pass : {g : Type} -> g -> (g -> Int) -> Int
pass x k = k x

both : String -> String -> Int
both a b = 0

-- where nothing says a lambda's type, it is guessed `?A -> ?B`; where
-- that does not fit either, the error is the one without the guess

-- meant for `{a : Type} -> a -> a`: as `?A -> ?B`, it is used at two types
implicitMeant : Int
implicitMeant = pass (\v -> v) (\f -> both (f "a") (f 1))

-- meant for `{a : Type} -> {{s : Show a}} -> a -> String`
instanceMeant : Int
instanceMeant = pass (\v -> show v) (\f -> both (f 1) (f "a"))

data Tagged (n : Int) = MkTagged Int

tagged : (n : Int) -> Tagged n
tagged n = MkTagged n

untag : (n : Int) -> Tagged n -> Int
untag n (MkTagged k) = k

-- of the dependent type `(n : Int) -> Tagged n` only, no `?A -> ?B`
dependent : Int
dependent = pass (\n -> tagged n) (\f -> untag 1 (f 1))

-- the guess fits, and the body does not
wrongGuessedBody : Int
wrongGuessedBody = pass (\v -> v ^ "!") (\f -> f 2)
