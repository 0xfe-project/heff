-- test: expect errors
-- A `do` block's statements, misused: each said where it is.

import co
import exception

-- `break` and `continue` are a loop's
breakOutside : Int
breakOutside = run do
  let x = 1
  break

continueOutside : Int -> Int
continueOutside n = run do
  if n > 0 then continue
  return n

-- `:=` sets a `let mut` variable only
assignNotMut : Int
assignNotMut = run do
  let x = 1
  x := 2
  return x

-- a variable is not bound again
mutBoundAgain : Int
mutBoundAgain = run do
  let mut n = 0
  n <- idPure 2
  return n

mutForPattern : List Int -> Int
mutForPattern xs = run do
  let mut x = 0
  for x in xs do
    x := x + 1
  return x

-- nothing after a jump
afterBreak : Int
afterBreak = run do
  let mut i = 0
  while i < 3 do
    break
    i := i + 1
  return i

afterReturn : Int
afterReturn = run do
  return 1
  return 2

-- a lambda's body runs later: no `return`, `(<- c)`, `break` or setting
-- the block's variable in it
returnInLambda : List Int -> List Int
returnInLambda xs = run do
  return (List.map (\x -> return x) xs)

nestInLambda : List Int -> List Int
nestInLambda xs = run do
  return (List.map (\x -> (<- idPure x)) xs)

breakInLambda : List Int -> List Int
breakInLambda xs = run do
  for x in xs do
    let f = List.map (\y -> break) xs
    return f
  return Nil

assignInClosure : List Int -> Int
assignInClosure xs = run do
  let mut n = 0
  let ys = List.map (\y -> run do
    n := y
    return y) xs
  return n

-- each of them a statement of a `do` block
nestOutside : Int
nestOutside = (<- idPure 1)

returnOutside : Int
returnOutside = return 1

ifThenAsValue : Int -> Int
ifThenAsValue n = (if n > 0 then n : Int)

-- a `do` block ends with an expression
mutLast : Int
mutLast = run do
  let mut n = 0

-- `if let` without `else` is a statement
ifLetAsValue : Maybe Int -> Int
ifLetAsValue m = (if let Just x = m then x : Int)

-- a `catch` binder is no variable of the block
catchBindsMut : {e : HFunctor} -> {{ex : exception String <: e}} -> Co e Int
catchBindsMut = do
  let mut e = 0
  try
    pure 1
  catch (e : String) -> pure 2
  return e

-- nothing after a `try` that never reaches its end
afterTry : {e : HFunctor} -> {{ex : exception String <: e}} -> Co e Int
afterTry = do
  try
    return 1
  catch (e : String) -> return 2
  return 3
