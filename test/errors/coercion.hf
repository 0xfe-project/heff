-- test: expect errors
-- coercions that are not put in: no instance of `Coe` for the two
-- types (the mismatch, as it is); two in a row (one only: `A` to `C`
-- by way of `B` is none); a type not known whole yet (a list of what
-- is not known); a number literal, which takes the type expected as
-- its own; and two instances of one `Coe` (ambiguous)

module test.errors.coercion

data A = MkA
data B = MkB A
data C = MkC B

instance instanceCoeAB : Coe A B
instanceCoeAB = { coe = MkB }

instance instanceCoeBC : Coe B C
instanceCoeBC = { coe = MkC }

instance instanceCoeListIntC : Coe (List Int) C
instanceCoeListIntC = { coe = \xs -> MkC (MkB MkA) }

takesB : B -> Int
takesB b = 1

takesC : C -> Int
takesC c = 2

a : A
a = MkA

b : B
b = MkB a

-- (one step: A to B, and B to C, each a coercion; a tag is checked at
-- the type expected, so `MkA` itself would be no `B`)
oneStep : Int
oneStep = takesB a + takesC b

-- no `Coe Bool B`
noInstance : Int
noInstance = takesB (not True)

-- A to C would be two
twoSteps : Int
twoSteps = takesC a

-- the list's element type is not known: no coercion is looked for (a
-- `Coe (List Int) C` would fit, were it `Int`)
notKnown : Int
notKnown = takesC (List.reverse Nil)

-- the literal is checked at `C`
literal : Int
literal = takesC 3

data D = MkD

instance instanceCoeAD : Coe A D
instanceCoeAD = { coe = \a -> MkD }

instance instanceCoeAD2 : Coe A D
instanceCoeAD2 = { coe = \a -> MkD }

takesD : D -> Int
takesD d = 3

-- two instances of `Coe A D`
ambiguous : Int
ambiguous = takesD a
