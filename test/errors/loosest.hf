-- The loosest operators, each declared `below` alone, are the bottom:
-- nothing is declared below one, and two of them, unparenthesised, are
-- related by nothing.

infixr <$$> below

infixl <|> below <$$>

infixl <||> below <|> $

(<$$>) : (Int -> Int) -> Int -> Int
(<$$>) f x = f x

twice : Int -> Int
twice x = x + x

both : Int
both = twice <$$> twice $ 1

parenthesised : Int
parenthesised = twice <$$> (twice $ 1)
