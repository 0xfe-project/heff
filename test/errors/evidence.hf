-- test: expect errors
-- `(x := _)` where the evidence is not found: an effect in two places of
-- the world, in none, an argument that is no evidence, and a world not
-- known where the call is.

module test.errors.evidence

import co
import std.io

hello : {e : HFunctor} -> {{io : stdio <: e}} -> Co e Unit
hello = print "hi"

-- (two places)
twice : Co (stdio <+> stdio) Unit
twice = hello (io := _)

-- (three)
thrice : Co (stdio <+> stdio <+> stdio) Unit
thrice = hello (io := _)

-- (none)
data NoneF (m : Type -> Type) x = None x

nothing : HFunctor
nothing =
  { f = NoneF
  , hfmap = \m g p -> case p of
      None x -> None (g x)
  , hmap = \m n nt p -> case p of
      None x -> None x
  }

nowhere : Co nothing Unit
nowhere = hello (io := _)

-- (no evidence)
given : {a : Type} -> {{x : a}} -> a
given = x

number : Int
number = given (x := _)

-- (no world known)
unknown : Int
unknown = let c = hello (io := _) in 0
