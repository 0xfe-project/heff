-- test: expect errors
-- top-level instances: one declared after a use is not in scope there
-- (definitions are sequential), and one of another type is no candidate;
-- an instance and an instance binder of the same type are two; an
-- instance that takes an explicit argument, which no search gives, is
-- refused

module test.errors.instance-declared

theory Eq (a : Type) where
  equal : a -> a -> Bool

member : {a : Type} -> {{eq : Eq a}} -> a -> List a -> Bool
member x [] = False
member x (y :: ys) = eq.equal x y || member x ys

instance instanceEqFloat64 : Eq Float64
instanceEqFloat64 = { equal = floatEq }

-- none of `Eq Int` in scope: `instanceEqInt` is declared after it
before : Bool
before = member 1 [1]

instance instanceEqInt : Eq Int
instanceEqInt = { equal = intEq }

-- the instance binder and `instanceEqInt`, both of `Eq Int`
twice : {{mine : Eq Int}} -> Bool
twice = member 1 [1]

-- an explicit argument: no search gives it
instance instanceEqIntBy : (Int -> Int -> Bool) -> Eq Int
instanceEqIntBy same = { equal = same }

-- (refused, it is no instance: a search for one finds `instanceEqInt` alone, and
-- a use of it is no error of its own)
once : Bool
once = member 1 [1] || (instanceEqIntBy intEq).equal 1 1
