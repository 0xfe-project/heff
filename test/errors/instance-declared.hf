-- top-level instances: one declared after a use is not in scope there
-- (definitions are sequential), and one of another type is no candidate;
-- an instance and an instance binder of the same type are two; an
-- instance of every type, found by finding others, is refused

theory Eq (a : Type) where
  equal : a -> a -> Bool

member : {a : Type} -> {{eq : Eq a}} -> a -> List a -> Bool
member x Nil = False
member x (Cons y ys) = eq.equal x y || member x ys

instance eqFloat : Eq Float64
eqFloat = { equal = floatEq }

-- none of `Eq Int` in scope: `eqInt` is declared after it
before : Bool
before = member 1 [1]

instance eqInt : Eq Int
eqInt = { equal = intEq }

-- the instance binder and `eqInt`, both of `Eq Int`
twice : {{mine : Eq Int}} -> Bool
twice = member 1 [1]

-- of every `List a`, given an `Eq a`: not had yet
instance eqList : {a : Type} -> {{eq : Eq a}} -> Eq (List a)
eqList = { equal = \xs ys -> False }

-- (refused, it is no instance: a search for one finds none, and a use
-- of it is no error of its own)
lists : List Int -> Bool
lists xs = member xs [xs] || eqList.equal xs xs
