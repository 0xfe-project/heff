-- test: expect errors
-- `as`, `with` and `data` are keywords, and no name is either: not a
-- variable's, nor a field's.

module test.errors.keyword-names

-- (a parameter named `as`)
size : List Int -> Int
size as = 0

-- (a variable named `with`)
held : Int
held = let with = 1 in with

-- (a field named `data`)
type Box = { data : Int }

-- (a record with a field named `data`)
boxed : Int
boxed = { data = 1 }.data
