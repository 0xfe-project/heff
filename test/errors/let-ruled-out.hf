-- test: expect errors
-- A pattern that binds can fail unless the matches around it have ruled
-- out the other tags of the very value it takes apart: not of one bound
-- to the same name again (a `let`, a `let mut` variable set, a lambda's
-- parameter), not outside the arm (a lambda made before the match, the
-- statements after it), not of the arm that took the tag, not of a part
-- no match took apart, not of another field.  A match needs a case for
-- each tag not ruled out.

module test.errors.let-ruled-out

shadowed : List Int -> List Int -> Int
shadowed xs zs = case xs of
  [] -> 0
  _ -> let xs = zs in let h :: t = xs in h

mutated : List Int -> Int
mutated xs = run do
  let mut ys = xs
  case ys of
    [] -> return 0
    _ -> do
      ys := Nil
      let h :: t = ys
      return h
  0

after : List Int -> Int
after xs = run do
  let mut n = 0
  case xs of
    [] -> n := 1
    _ -> n := 2
  let h :: t = xs
  h + n

before : List Int -> Int
before xs =
  let f : Int -> Int = \u -> let h :: t = xs in h
  in case xs of
  [] -> 0
  _ -> f 0

param : List Int -> List Int
param xs = case xs of
  [] -> Nil
  _ -> List.map (\(ys : List Int) -> let h :: t = ys in h) [xs]

wrong : List Int -> Int
wrong xs = case xs of
  [] -> let h :: t = xs in h
  _ -> 0

inner : List Int -> Int
inner xs = case xs of
  [] -> 0
  _ -> let a :: b :: c = xs in a + b

type Two = { l : List Int, r : List Int }

otherField : Two -> Int
otherField p = case p.l of
  [] -> 0
  _ -> let h :: t = p.r in h

data Three = A | B | C Int

twoLeft : Three -> Int
twoLeft x = case x of
  A -> 0
  _ -> let C n = x in n

incomplete : Three -> Int
incomplete x = case x of
  A -> 0
  _ -> case x of
    C n -> n

completeThree : Three -> Int
completeThree x = case x of
  A -> 0
  B -> 1
  _ -> case x of
    C n -> n
