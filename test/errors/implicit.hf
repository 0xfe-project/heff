-- An implicit argument that what is known of it does not say: `plus ?h ?k`
-- (`<+>`) is a function, not a constructor.  Said where it was to be
-- inferred, the call.

import co
import io
import prelude
import state

leftOf :: {h k :: HFunctor} -> Handler (h <+> k) -> Handler h
leftOf hd =
  { M = hd.M, ret = hd.ret, bind = hd.bind, malg = \p -> hd.malg (InL p) }

rightOf :: {h k :: HFunctor} -> Handler (h <+> k) -> Handler k
rightOf hd =
  { M = hd.M, ret = hd.ret, bind = hd.bind, malg = \p -> hd.malg (InR p) }

liftL :: {h k :: HFunctor} -> {a :: Type} -> Co h a -> Co (h <+> k) a
liftL c = \hd r kont -> c (leftOf (h := h) (k := k) hd) r kont

liftR :: {h k :: HFunctor} -> {a :: Type} -> Co k a -> Co (h <+> k) a
liftR c = \hd r kont -> c (rightOf (h := h) (k := k) hd) r kont

getS :: {s :: Type} -> Co (state s) s
getS = op (Get (\x -> x)) val

putS :: {s :: Type} -> s -> Co (state s) Unit
putS x = op (Put x MkUnit) val

counted :: Co (io <+> (state Int)) Unit
counted = do
  liftR (putS 1)
  n <- liftR getS
  liftL (print (showInt (n + 1)))
