-- A literal checked at a fixed-width type must be one of its values: an
-- integer in its range, at an integer type; a float not too large for
-- one, at `Float32`.  A float is no integer, nor an integer a float.

import prelude

over : Int8
over = 128

under : UInt32
under = -1

wide : UInt64
wide = 18446744073709551616

huge : Float32
huge = 1.0e39

fraction : Int32
fraction = 1.5

whole : Float32
whole = 1
