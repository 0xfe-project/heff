-- test: expect errors
-- A number literal must be one of its type's values: an integer in an
-- integer type's range, a float not too large for `Float32` -- found so
-- once the type is known, which may be late, after it waited for it.  A
-- fractional literal is of no integer type, and no literal is of a type
-- that is not a number's.

module test.errors.fixed-literals

over : Int8
over = 128

under : UInt32
under = -1

wide : UInt64
wide = 18446744073709551616

huge : Float32
huge = 1.0e39

fraction : Int32
fraction = 1.5

text : String
text = 5

-- (the type `id` is wanted at, known after its argument waited)
late : UInt8
late = id 300

-- (a pattern's literal too, of the type it matches)
byteName : UInt8 -> String
byteName 256 = "too large"
byteName _ = "a byte"

-- (in hexadecimal, the same)
hexOver : UInt8
hexOver = 0x1_00
