-- test: expect errors
-- A `try` is the exception module's `recover`: where it is not imported,
-- that is said at the `try`, and nothing after it is blamed for it.

module test.errors.try-unimported

import co

caught : {e : HFunctor} -> Co e Int
caught = do
  try
    pure MkUnit
  catch (err : String) ->
    pure MkUnit
  pure 1
