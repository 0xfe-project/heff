-- test: expect errors
-- The equations of a definition have the same patterns in number, in a
-- `mutual` block as anywhere: said of the definition as written, which
-- the block's record is called through, not of its body, which takes
-- the record first.

module test.errors.mutual-uneven-equations

mutual
  f : Int -> Int
  f = g
  f n = g n

  g : Int -> Int
  g n = f n
