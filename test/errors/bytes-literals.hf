-- test: expect errors
-- A bytes literal, `b"..."`, is read as a string is: what its `\u{...}`
-- stands for is a Unicode scalar value (its UTF-8 bytes), and one that
-- is never closed is said.  (A file that does not lex the formatter
-- leaves.)

surrogate : Bytes
surrogate = b"a\u{D800}b"

beyond : Bytes
beyond = b"\u{110000}"

fine : Bytes
fine = b"\u{10FFFF}\xff"

open : Bytes
open = b"never closed
