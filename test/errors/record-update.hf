-- test: expect errors
-- What an update is not: of a field the type does not have, of one
-- field twice, of a value that is no record, of a field at another type,
-- or keeping a field whose type a field set changes.

type Pos = { x : Int, y : Int }

type Sprite = { pos : Pos, id : Int }

origin : Pos
origin = { x = 0, y = 0 }

sprite : Sprite
sprite = { pos = origin, id = 1 }

unknown : Pos
unknown = { origin | z = 1 }

twice : Pos
twice = { origin | x = 1, x = 2 }

-- (`pos` set, and a field of it too)
both : Sprite
both = { sprite | pos = origin, pos.x = 1 }

nested : Sprite
nested = { sprite | pos.z = 1 }

number : Int
number = { 3 | x = 1 }

retyped : Pos
retyped = { origin | x = "one" }

theory Monoid where
  t : Type
  unit : t
  m : t -> t -> t

sum : Monoid
sum = { t = Int, unit = 0, m = \a b -> a + b }

-- (`unit` and `m` are of `t`: set with it)
bools : Monoid
bools = { sum | t = Bool }
