-- test: expect errors
-- What gpu.kernel's types refuse, as WGSL would: a buffer read only
-- stored into, numbers of two types added, `Bool`s added, a buffer of
-- `Bool`s, an integer divided by `/.`, a `UInt32` negated, a float
-- divided by `/`.

import co
import gpu.kernel as Kernel

intoInput : Kernel.Input Float32 -> Co Kernel.stmt Unit
intoInput a = Kernel.store a (Kernel.lit 0) (Kernel.load a (Kernel.lit 1))

mixed : Kernel.Exp Float32 -> Kernel.Exp Int32 -> Kernel.Exp Float32
mixed x n = x + n

bools : Kernel.Exp Bool -> Kernel.Exp Bool
bools b = b + b

flags : Kernel.Kernel1 (Kernel.Output Bool)
flags = Kernel.kernel1 "flags" 64 (\a -> pure MkUnit)

intDivided : Kernel.Exp Int32 -> Kernel.Exp Int32
intDivided n = n /. n

unsignedNegated : Kernel.Exp UInt32 -> Kernel.Exp UInt32
unsignedNegated n = -n

floatDivided : Kernel.Exp Float32 -> Kernel.Exp Float32
floatDivided x = x / x
