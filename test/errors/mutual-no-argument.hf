-- test: expect errors
-- A definition of a `mutual` block takes an argument: the block is a
-- record of its definitions, built before any of them runs, so each is
-- a function, called later.  A value that needs another would need the
-- record while it is being built.

module test.errors.mutual-no-argument

mutual
  ones : List Int
  ones = 1 :: more 0

  more : Int -> List Int
  more n = ones
