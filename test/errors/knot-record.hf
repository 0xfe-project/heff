-- test: expect errors
-- A record whose field needs the record while it is being built: the
-- fields of a record are computed before it is one.  Under a lambda the
-- use waits, and it works fine.

module test.errors.knot-record

theory G where
  f : Int -> Int
  g : Int -> Int

r : G
r = { f = \n -> n + 1, g = r.f }
