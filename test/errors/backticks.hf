-- test: expect errors
-- A name in backticks with no fixity goes with no operator but the
-- loosest, nor with itself: parentheses say how; a fixity is declared of
-- a name unqualified, and above or below only what has one.

module test.errors.backticks

infixl `List.append`

infixl <+> below `undeclared`

nextToPlus : Int
nextToPlus = 1 `max` 2 + 3

twice : Int
twice = 1 `max` 2 `max` 3

twoNames : Int
twoNames = 1 `max` 2 `min` 3
