-- a postponed problem that is a contradiction is reported as one (the
-- flip answers Bool; the do asks Int of it), not swallowed into a
-- "cannot infer"

import co
import std.io

data PickF (m : Type -> Type) x = Flip (Bool -> x)

pick : HFunctor
pick =
  { f = PickF
  , hfmap = \m g p -> case p of
      Flip k -> Flip (\b -> g (k b))
  , hmap = \m n nt p -> case p of
      Flip k -> Flip k
  }

eff2 : HFunctor
eff2 = pick <+> stdio

bad : Co eff2 Int
bad = do
  c <- op (inl pick stdio (Flip (\(b : Bool) -> b))) val
  pure c
