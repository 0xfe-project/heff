-- test: expect errors
-- A signature of more than one name, `f, g : T`: a name of it with no
-- equations after it has a type but no definition, said at that name; a
-- name written twice in it is said at the second, as in a theory's
-- fields and a record type's; what is wrong in its type is said once.

module test.errors.multi-name-signatures

one, two, three : Int
one = 1
three = 3

four, four : Int
four = 4

bad, worse : Int -> Strin
bad n = "b"
worse n = "w"

type Pair2 = { a, a : Int }

theory Twice a where
  m, m : a -> a

-- (the others are as they are)
fine, good : Int
fine = 1
good = 2
