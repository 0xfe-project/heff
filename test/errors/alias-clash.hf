-- test: expect errors
-- `M.x` where `M` is both an import's alias that has `x` and a local
-- name, which could take `.x` too, is an error where it is written: a
-- local name is not let to shadow the alias, nor the alias the local.
-- Where the alias has no `x` (`Map.t`), the local's field is meant.

module test.errors.alias-clash

import std.map as Map

theory Store where
  t : Type
  empty : t

fresh : (Map : Store) -> Map.t
fresh Map = Map.empty

-- (the alias is the module's anywhere else)
none : Map.Map Int Int
none = Map.empty
