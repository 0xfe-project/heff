-- test: expect errors
-- A `with` of bindings with a condition, misused: each said where it is.

module test.errors.with-where

import co
import std.domain as Domain

-- a holder that cannot let go and take again has no `Waiter`: a scope
-- of domains
scopeWhere : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Unit
scopeWhere = do
  with s := Domain.scope
    where True
  do
    pure ()

-- the condition is checked again and again, not where the statement
-- runs: no action's value in it
nestedIn : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> Domain.Atomic Bool
         -> Co e Unit
nestedIn a = do
  with s := Domain.scope
    where (<- Domain.get a)
  do
    pure ()
