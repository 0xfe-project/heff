-- test: expect errors
-- A `with` of bindings with a condition, misused: each said where it is.

module test.errors.with-where

import boc as BOC
import co
import custodian as Custodian

-- a holder that cannot let go and take again has no `Waiter`: a
-- custodian's custody
custodyWhere : {e : HFunctor} -> {{cu : Custodian.custodian <: e}} -> Co e Unit
custodyWhere = do
  with k := Custodian.custody once True do
    pure ()

-- the condition is checked again and again, not where the statement
-- runs: no action's value in it
nestedIn : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> BOC.Cown Int
         -> Co e Bool
         -> Co e Unit
nestedIn c ready = do
  with n := c once (<- ready) do
    pure ()
