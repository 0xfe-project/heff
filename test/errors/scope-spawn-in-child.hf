-- test: expect errors
-- A domain spawning in its own scope: a domain's computation is of the
-- world around the scope's `with`, where there is no `scoped`, so it
-- cannot, said where it is.

module test.errors.scope-spawn-in-child

import co
import std.domain as Domain

-- a domain's computation spawning in the scope it is spawned in
spawningAgain : {e : HFunctor}
              -> {s : Type}
              -> {{dm : Domain.domain <: e}}
              -> Domain.Scope s e
              -> Co e Unit
spawningAgain sc = do
  _ <- Domain.spawn sc (pure 1)
  pure ()

-- the same, the domain's computation written in the body
spawnedInChild : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Unit
spawnedInChild = do
  with s := Domain.scope do
    _ <- Domain.spawn s (bind (Domain.spawn s (pure 1)) (\d -> pure ()))
    pure ()

-- the body spawns: no error
spawnedInBody : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Unit
spawnedInBody = do
  with s := Domain.scope do
    _ <- Domain.spawn s (pure 1)
    pure ()
