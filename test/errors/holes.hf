-- test: expect errors
-- An error inside a definition is an error hole of the type it was checked
-- at, and what is around it is checked still: each error is reported, once.
-- A hole is equal to anything, and no implicit argument is inferred from it
-- (nor reported as not inferred); the definition keeps its type for what
-- uses it.

module test.errors.holes

-- three errors in one definition: two arguments, and a tag not of the
-- type, inside a `case` of literals
f : Int -> List Int
f n =
  Cons
    (n + "one")
    (Cons (undefinedThing n) (case n of
     0 -> Nil
     _ -> True))

-- `a` of `Cons`, known only from what does not elaborate
g : Int
g = List.length (Cons nope Nil)

h : Int
h = List.length (f 3)
