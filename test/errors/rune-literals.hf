-- test: expect errors
-- A rune literal is a Unicode scalar value: from U+0000 to U+10FFFF,
-- but the surrogates.  A `'` that no rune literal starts -- one
-- character or an escape, and a `'` -- is an unexpected character, as
-- it was.  (A file that does not lex the formatter leaves.)

module test.errors.rune-literals

surrogate : Rune
surrogate = '\u{D800}'

lowSurrogate : Rune
lowSurrogate = '\u{dfff}'

beyond : Rune
beyond = '\u{110000}'

-- (two characters are no rune)
two : Rune
two = 'ab'

-- (nor is nothing)
none : Rune
none = ''
