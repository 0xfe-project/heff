-- test: expect errors
-- One error, reported once: what depends on it is not an error again --
-- a type that did not elaborate used as one (a record made of it, a field
-- taken of it), a name bound to a computation of it (its type an implicit
-- argument the error kept from being inferred), and a definition that
-- failed, unfolded where a type is computed from it.

import co

data FreshF (m : Type -> Type) x = Fresh (String -> x)

fresh : HFunctor
fresh =
  { f = FreshF
  , hfmap = \m g p -> case p of
      Fresh k -> Fresh (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Fresh k -> Fresh k
  }

-- (`Boolean` is no type: `Bool` is)
type Named = { name : String, atomic : Boolean }

atom : String -> Named
atom s = { name = s, atomic = True }

nameOf : Named -> String
nameOf n = n.name

theory Pick where
  T : Type
  pick : T

named : Pick
named =
  { T = Co fresh Named
  , pick = do
      n <- pure (atom "x")
      pure (atom (nameOf n))
  }

-- (what `named.T` is, computed from a definition that failed)
picked : Co fresh Named
picked = named.pick
