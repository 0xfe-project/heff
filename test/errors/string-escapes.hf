-- test: expect errors
-- What a string's `\u{...}` stands for is a Unicode scalar value, as a
-- rune literal is: from U+0000 to U+10FFFF, but the surrogates; the
-- first of a string's that is none is said.  (A file that does not lex
-- the formatter leaves.)

surrogate : String
surrogate = "a\u{D800}b"

low : String
low = "\u{dc00}"

beyond : String
beyond = "x\u{110000}\u{D800}"

fine : String
fine = "\u{10FFFF}\u{FFFD}"
