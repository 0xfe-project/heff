-- test: expect errors
-- A specialised field given by an instance argument not found yet,
-- `Elem = it.Elem`, is checked once that argument is found: a mismatch
-- is still the check's, at the search.

module test.errors.instance-specialised-deferred

theory Pick (c : Type) where
  Elem : Type
  Src : Type
  pick : c -> Maybe Elem

data Loose (c : Type) = MkLoose c

-- (`d` is known only by the goal's `Src`: `it` waits for the check)
instance instancePickLoose : {c d : Type}
                           -> {{it : Iterate d}}
                           -> Pick (Loose c) @ { Src = d }
instancePickLoose = { Elem = it.Elem, Src = d, pick = go }
  where
  go : Loose c -> Maybe it.Elem
  go x = Nothing

pickStr : {c : Type}
        -> {{p : Pick c @ { Elem = String, Src = List Int }}}
        -> c
        -> Int
pickStr x = 0

loose : Loose Int
loose = MkLoose 7

mismatch : Int
mismatch = pickStr loose
