-- test: expect errors
-- An import the file has already is an error: builtin, the prelude and
-- `list as List` are every module's without being written (but the
-- prelude by a name is another import), and so is the same import
-- written twice; a module opened and by a name is two.

module test.errors.import-again

import builtin
import std.ordmap
import std.ordmap as M
import std.ordmap as M
import prelude
import prelude as P
import list as List

x : Int
x = P.id 1
