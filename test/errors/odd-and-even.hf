-- test: expect errors
-- Mutually defined types in a struct: three is odd, not even.

theory ThOddAndEven where
  odd : Type
  even : Type

OddAndEven : ThOddAndEven
OddAndEven =
  { odd = data { Succ OddAndEven.even }
  , even = data { Zero | Succ OddAndEven.odd }
  }

three : OddAndEven.odd
three = Succ (Succ (Succ Zero))

badThree : OddAndEven.even
badThree = Succ (Succ (Succ Zero))
