-- test: expect errors
-- a value applied that is not of a function type: the message says its
-- type, and the note what is applied

module test.errors.apply-non-function

import co
import std.io

-- one argument more than `inc` takes: `inc 1` is applied to `2`
inc : Int -> Int
inc x = x + 1

two : Int
two = inc 1 2

-- a handler's algebra: what comes after `Write` is an `a`, not an `M a`
-- (`StdioF M a` holds an `a`), so it is no continuation to apply
collect : Handler stdio
collect =
  { M = \a -> String -> Pair String a
  , ret = \x -> \out -> MkPair out x
  , bind = \m k -> \out -> case m out of
      MkPair o x -> k x o
  , malg = \p -> case p of
      Write s x -> \out -> x (out ^ s)
      WriteErr s x -> \out -> MkPair out x
      ReadStdin k -> \out -> MkPair out (k "")
      Flush x -> \out -> MkPair out x
  }

-- a literal, its type not known yet where it is applied: no type said
three : Int
three = 1 2
