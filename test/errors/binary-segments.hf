-- test: expect errors
-- A segment of a binary, `b[v::spec]`, is checked as it is read: its
-- spec's words, a size of 8 to 64 bits for an integer, a number that
-- fits it, a string all its bytes, bytes of no endianness; in a pattern,
-- a name, `_`, a number or a string, and only the last taking what is
-- left.  (Each is said where it is; the rest of the file is read.)

unknownWord : Int -> Bytes
unknownWord x = b[x::16-bigg]

oddSize : Int -> Bytes
oddSize x = b[x::12]

twice : Int -> Bytes
twice x = b[x::16-big-little]

tooLarge : Bytes
tooLarge = b[256]

sizedString : Bytes
sizedString = b["GET"::binary-size(2)]

littleBytes : Bytes -> Bytes
littleBytes x = b[x::binary-little]

notLast : Bytes -> Int
notLast b[rest::binary, 1] = 1
notLast _ = 0

notAName : Bytes -> Int
notAName b[(Just x)::8] = 1
notAName _ = 0

unsigned : Bytes -> Int
unsigned b[-1::8] = 1
unsigned _ = 0

fine : Int -> Bytes
fine x = b[x::16-little-signed, -1, "ok", 255::8]
