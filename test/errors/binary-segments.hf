-- test: expect errors
-- A segment of a binary, `b[v::spec]`, is checked as it is read: its
-- spec's words, a size of 1 to 64 bits for an integer, 32 or 64 for a
-- float, none for a code point, a unit of a size said, bytes' a multiple
-- of 8; a number that fits it, a string all its bytes, a value of the
-- kind of its type; bytes and bits of no endianness, a float and a code
-- point of no sign, UTF-8 of no endianness; in a pattern, a name, `_`,
-- a number, a string or a rune, and only the last taking what is left.
-- (Each is said where it is; the rest of the file is read.)

module test.errors.binary-segments

unknownWord : Int -> Bytes
unknownWord x = b[x::16-bigg]

tooWide : Int -> Bits
tooWide x = b[x::72]

twice : Int -> Bytes
twice x = b[x::16-big-little]

tooLarge : Bytes
tooLarge = b[256]

sizedString : Bytes
sizedString = b["GET"::binary-size(2)]

littleBytes : Bytes -> Bytes
littleBytes x = b[x::binary-little]

notLast : Bytes -> Int
notLast b[rest::binary, 1] = 1
notLast _ = 0

notAName : Bytes -> Int
notAName b[(Just x)::8] = 1
notAName _ = 0

unsigned : Bytes -> Int
unsigned b[-1::8] = 1
unsigned _ = 0

utfSized : Int -> Bytes
utfSized c = b[c::utf8-size(8)]

floatOdd : Float64 -> Bytes
floatOdd x = b[x::float-12]

floatNamed : Int -> Float64 -> Bytes
floatNamed n x = b[x::float-size(n)]

floatSigned : Float64 -> Bytes
floatSigned x = b[x::float-signed]

utf8Little : Rune -> Bytes
utf8Little c = b[c::utf8-little]

utfSigned : Rune -> Bytes
utfSigned c = b[c::utf16-signed]

bitsLittle : Bits -> Bits
bitsLittle x = b[x::bits-little]

bytesUnit : Int -> Bytes -> Bytes
bytesUnit n x = b[x::binary-size(n)-unit(4)]

unitAlone : Int -> Bits
unitAlone x = b[x::unit(8)]

unitZero : Int -> Bits
unitZero x = b[x::size(2)-unit(0)]

unitTwice : Int -> Bytes
unitTwice x = b[x::size(2)-unit(8)-unit(8)]

stringCode : Bytes
stringCode = b["é"::utf8]

floatInteger : Bytes
floatInteger = b[1.5::8]

runeInteger : Bytes
runeInteger = b['a'::16]

numberFloat : Bytes
numberFloat = b[1::float]

noScalar : Bytes
noScalar = b[0x110000::utf8, 0xd800::utf16]

bitsNotLast : Bits -> Int
bitsNotLast b[rest::bits, 1::1] = 1
bitsNotLast _ = 0

fine : Int -> Rune -> Float64 -> Bits
fine x c f =
  b[ x::16-little-signed
  , -1
  , "ok"
  , 255::8
  , x::3
  , c::utf8
  , c::utf16-little
  , f::float-32
  , x::size(x)-unit(2)
  ]
