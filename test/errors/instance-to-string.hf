-- test: expect errors
-- a value shown, by `toString` or by `assertEqual`, of a type with no
-- instance of `ToString`: a type of the file's own, alone and in a list
-- (whose search says the instance that wanted one) -- but a rune, whose
-- instance is the prelude's, found with no import, as a string's is

import check

data Color = Red | Green

named : String
named = toString (Red : Color)

listed : String
listed = toString ([Red, Green] : List Color)

quoted : String
quoted = toString 'a'

same : Test
same = unit "the same color" (assertEqual (Red : Color) Green)
