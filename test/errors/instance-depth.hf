-- test: expect errors
-- instances that want instances without end: one that wants an instance
-- of a larger type than its own, and two that want each other -- their
-- searches, one deeper each, are refused at a depth, not followed for
-- ever

module test.errors.instance-depth

theory Debug (a : Type) where
  debug : a -> String

-- of every `Debug a`, wanting a `Debug (List a)`: of which it is one too
instance instanceDebug : {a : Type} -> {{s : Debug (List a)}} -> Debug a
instanceDebug = { debug = \x -> "" }

showIt : {a : Type} -> {{s : Debug a}} -> a -> String
showIt x = s.debug x

growing : String
growing = showIt 3

theory Ping where
  ping : Int

theory Pong where
  pong : Int

instance instancePing : {{p : Pong}} -> Ping
instancePing = { ping = p.pong }

instance instancePong : {{p : Ping}} -> Pong
instancePong = { pong = p.ping }

pinged : {{p : Ping}} -> Int
pinged = p.ping

circling : Int
circling = pinged
