-- test: expect errors
-- instances that want instances without end: one that wants an instance
-- of a larger type than its own, and two that want each other -- their
-- searches, one deeper each, are refused at a depth, not followed for
-- ever

theory Show (a : Type) where
  show : a -> String

-- of every `Show a`, wanting a `Show (List a)`: of which it is one too
instance byLists : {a : Type} -> {{s : Show (List a)}} -> Show a
byLists = { show = \x -> "" }

showIt : {a : Type} -> {{s : Show a}} -> a -> String
showIt x = s.show x

growing : String
growing = showIt 3

theory Ping where
  ping : Int

theory Pong where
  pong : Int

instance pingOfPong : {{p : Pong}} -> Ping
pingOfPong = { ping = p.pong }

instance pongOfPing : {{p : Ping}} -> Pong
pongOfPing = { pong = p.ping }

pinged : {{p : Ping}} -> Int
pinged = p.ping

circling : Int
circling = pinged
