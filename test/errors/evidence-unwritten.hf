-- test: expect errors
-- Evidence no witness in scope is, wanted where nothing is written: found
-- as `(x := _)` finds it, and refused as it is -- an effect in two places
-- of the world, in none, a world not known where the call is.

module test.errors.evidence-unwritten

import co
import std.io

hello : {e : HFunctor} -> {{io : stdio <: e}} -> Co e Unit
hello = print "hi"

-- (two places)
twice : Co (stdio <+> stdio) Unit
twice = hello

-- (none)
data NoneF (m : Type -> Type) x = None x

nothing : HFunctor
nothing =
  { f = NoneF
  , hfmap = \m g p -> case p of
      None x -> None (g x)
  , hmap = \m n nt p -> case p of
      None x -> None x
  }

nowhere : Co nothing Unit
nowhere = hello

-- (none, in a world of its own: no evidence of it bound)
unbound : {e : HFunctor} -> Co e Unit
unbound = print "hi"

-- (no world known)
unknown : Int
unknown = let c = print "hi" in 0
