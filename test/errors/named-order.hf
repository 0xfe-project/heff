-- test: expect errors
-- Named arguments go in the order of the function's type: one written
-- after an argument that comes later says which it comes before.

module test.errors.named-order

difference : {{a : Int}} -> {{b : Int}} -> Int
difference = a - b

-- (`a` after `b`)
swapped : Int
swapped = difference (b := 1) (a := 2)

between : {{a : Int}} -> {{c : Int}} -> {{b : Int}} -> Int
between = a - b

-- (`a` after `c`, `b` still to come)
skipped : Int
skipped = between (c := 1) (a := 2)

around : {{a : Int}} -> Int -> {{b : Int}} -> Int
around x = a - b

-- (`a` after the explicit argument it comes before)
late : Int
late = around 1 (a := 2)

-- (no argument named `z`)
missing : Int
missing = difference (z := 2)
