-- The browser's modules, imported by a program compiled to C
-- (--backend=c, test/golden.mjs's compile): each import an error
-- (E0351), naming the module and the backend; the system's are C's.
-- It checks, as any backend's module does.

import co
import std.io
import browser.dom
import browser.js as Js

main : Co stdio Unit
main = print (ev := here stdio) (Js.fromJS (Js.toJS "hi"))
