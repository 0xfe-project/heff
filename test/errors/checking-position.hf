-- test: expect errors
-- a notation that does not infer its type -- a record, a lambda, a tag,
-- a `case` -- where a type is not known (what `let` binds, a function
-- applied, a scrutinee): E0200, said what it is, and the ways to put it
-- where its type is known

module test.errors.checking-position

type Pos = { x : Int, y : Int }

-- what `let` binds
bound : Int
bound = let p = { x = 1, y = 2 } in p.x

-- a function applied
applied : Int
applied = (\n -> n + 1) 2

-- a scrutinee
scrutinee : Int
scrutinee = case Nothing of
  Nothing -> 0
  Just n -> n

-- each way out, which checks: the type given where it is bound, in
-- place, or the notation put where its type is known
given : Int
given = let p : Pos = { x = 1, y = 2 } in p.x

inPlace : Int
inPlace = let p = ({ x = 1, y = 2 } : Pos) in p.x

xOf : Pos -> Int
xOf p = p.x

asArgument : Int
asArgument = xOf { x = 1, y = 2 }

origin : Pos
origin = { x = 0, y = 0 }

-- a type, as an element
typeBound : Int
typeBound = let t = Int in 0
