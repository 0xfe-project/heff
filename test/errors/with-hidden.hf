-- test: expect errors
-- A file held by a `with` is had only by std.filesystem.held's
-- operations: the shared `With` is exposed without its tag, so a program
-- neither takes the file out of one by it nor makes one, nor names what
-- the module keeps to itself.

import co
import std.filesystem
import std.filesystem.held
import with

-- (the file taken out of the `With` by its tag)
unwrapped : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> Co e (Either FileError OpenFile)
unwrapped =
  withFile "held.txt" { access = Read } (\f -> case f of
  MkWith h -> pure h)

-- (a `With` made of a file opened otherwise)
forged : {s : Type} -> OpenFile -> With s OpenFile
forged h = MkWith h

-- (what the module does not expose)
helper : Either FileError Unit -> Either FileError Int
helper r = closedWith 1 r
