-- test: expect errors
-- A file held by a `with` is had only by std.filesystem's operations:
-- the shared `With` is exposed without its tag, so a program neither
-- takes the file out of one by it nor makes one, nor names what the
-- module keeps to itself.

import co
import exception
import std.filesystem
import with

-- (the file taken out of the `With` by its tag)
unwrapped : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> Co e OpenFile
unwrapped =
  withFile "held.txt" { access = Read } (\f -> case f of
  MkWith h -> pure h)

-- (a `With` made of a file opened otherwise)
forged : {s : Type} -> OpenFile -> With s OpenFile
forged h = MkWith h

-- (what the module does not expose)
helper : {e : HFunctor}
       -> {{fx : exception FileError <: e}}
       -> Either FileError Unit
       -> Co e Int
helper r = releasedTo 1 r
