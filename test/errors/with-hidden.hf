-- test: expect errors
-- A command held by a `with` is had only by std.process's operations:
-- the shared `With` is exposed without its tag, so a program neither
-- takes the command out of one by it nor makes one, nor names what the
-- module keeps to itself.

module test.errors.with-hidden

import co
import custodian
import exception
import std.process
import resource

-- (the command taken out of the `With` by its tag)
unwrapped : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{fx : exception ProcessError <: e}}
          -> {{cu : custodian <: e}}
          -> Co e Started
unwrapped =
  withProcess { command = "true" } (\p -> case p of
  MkWith h -> pure h)

-- (a `With` made of a command started otherwise)
forged : {s : Type} -> Started -> With s Started
forged h = MkWith h

-- (what the module does not expose)
helper : {e : HFunctor}
       -> {{fx : exception ProcessError <: e}}
       -> Either ProcessError Unit
       -> Co e Int
helper r = releasedTo 1 r
