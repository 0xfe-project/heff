-- Each error is reported once, where it is, and the rest of the file is
-- still checked: a definition whose body does not elaborate has its type
-- for what uses it; one whose type does not, or that does not parse, is not
-- an error again where it is used; a declaration that does not parse ends
-- where the next begins, in brackets too; a definition with an equation
-- that does not parse is not checked with the others alone.

data Bool = True | False

f : Bool -> Bool
f b = "oops"

g : Bool
g = f True

h : Nope -> Bool
h x = True

k : Bool
k = h True

bad : Bool
bad = (

m : Bool
m = g

not : Bool -> Bool
not True = (
not False = True

n : Bool
n = not m
