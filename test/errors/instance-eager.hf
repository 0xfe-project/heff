-- test: expect errors
-- an instance argument whose goal is known where it is inserted is
-- searched for there; a search that finds more than one, or none, is
-- refused as it was when every search waited for the whole application

module test.errors.instance-eager

theory Cell (c : Type) where
  Contents : Type
  get : c -> Contents

data Box (a : Type) = MkBox a

instance instanceCellBox : {a : Type} -> Cell (Box a)
instanceCellBox = { Contents = a, get = open }
  where
  open : Box a -> a
  open (MkBox x) = x

instance instanceCellBoxInt : Cell (Box Int)
instanceCellBoxInt = { Contents = Int, get = open }
  where
  open : Box Int -> Int
  open (MkBox x) = x

update : {c : Type} -> c -> {{cw : Cell c}} -> (cw.Contents -> Int) -> Int
update b f = f (cw.get b)

oneBox : Box Int
oneBox = MkBox 1

-- (two instances of `Cell (Box Int)`)
ambiguous : Int
ambiguous = update oneBox (\y -> y)

-- (none of `Cell Int`)
missing : Int
missing = update 1 (\y -> 0)

-- (given, no search: no error)
given : Int
given = update oneBox (cw := instanceCellBoxInt) (\y -> y + 1)
