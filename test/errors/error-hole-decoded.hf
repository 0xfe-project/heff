-- test: expect errors
-- What did not elaborate, computed where a type is wanted: an error
-- hole applied in a type, a value of an error type used as a function
-- of types or as a record.  Each is the error type, or opaque: the
-- error is said where it was made, and elaboration goes on.

module test.errors.error-hole-decoded

import co
import state

-- `\a -> 3` is no function of types: `M Int` computes an error hole
applied : (M : Type -> Type) -> M Int -> Int
applied M v = 1

x : Int
x = applied (\a -> 3) 2

-- `t.tick`, of a type that did not elaborate, used as `M`: `M a` is of
-- that error type
theory Monadic where
  M : Type -> Type
  ret : {a : Type} -> a -> M a

theory Ticking where
  tick : noSuchType

monadic : (t : Ticking) -> Monadic
monadic t = { M = t.tick, ret = \y -> y }

-- `put` given what is not in scope: the instance it asks for is of a
-- type that did not elaborate, projected
noted : {e : HFunctor} -> Co e Unit
noted = do
  l <- get
  put s l

-- an annotation naming what is not in scope, on what is of another
-- type: its value is not asked for
annotated : Int
annotated = ((\s -> 0) : Int -> List e)

-- elaboration went on
after : Int
after = "after"
