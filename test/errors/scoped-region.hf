-- test: expect errors
-- A thing held by the shared `with`, `scoped`, kept past its body, from
-- a module of no effect of the system's: what the body comes to is of a
-- type bound outside it, which the region of the thing is not.

module test.errors.scoped-region

import co
import custodian
import exception
import state
import resource

-- (a number acquired from the state, released by putting it back)
acquired : {e : HFunctor} -> {{st : state Int <: e}} -> Co e (Either String Int)
acquired = do
  n <- get
  pure (Right n)

released : {e : HFunctor}
         -> {{st : state Int <: e}}
         -> Int
         -> Co e (Either String Unit)
released n = do
  put n
  pure (Right MkUnit)

escaped : {e : HFunctor}
        -> {{st : state Int <: e}}
        -> {{ex : exception String <: e}}
        -> {{cu : custodian <: e}}
        -> Co e (With Int Int)
escaped = scoped acquired released (\w -> pure w)

-- (a value held)
kept : {a : Type} -> a -> Maybe a
kept x = Just x

-- (in a `do`, the last statement)
hidden : {e : HFunctor}
       -> {{st : state Int <: e}}
       -> {{ex : exception String <: e}}
       -> {{cu : custodian <: e}}
       -> Co e Unit
hidden = do
  r <-
    scoped acquired released (\w -> do
      put (inside w)
      pure (kept w))
  pure MkUnit
