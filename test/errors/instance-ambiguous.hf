-- test: expect errors
-- two modules imported each declare an instance of `Eq Int`: a search
-- for one finds both, and is refused, each said where it is from --
-- whether its module is imported by name or by alias

module test.errors.instance-ambiguous

import test.errors.instances.equality
import test.errors.instances.exact
import test.errors.instances.parity as Parity

found : Bool
found = member 3 [1]

-- given, no search: no error
given : Bool
given = member (eq := Parity.instanceEqInt) 3 [1]
