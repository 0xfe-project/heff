-- test: expect errors
-- `~e` and what it is not: only `~e` delays, so an `Int` where a `~Int`
-- is wanted is a mismatch; `~ e`, with a space, is the operator `~`;
-- what is delayed is checked at the type delayed; `Lazy` takes a
-- `Type`, so no type is delayed; `Lazy`'s tag is builtin's own; what
-- `~e` delays is computed later, as a lambda's body is, so `(<- c)` in
-- it is refused; and a lambda delayed infers no type.

module test.errors.lazy

import co

inc : Int -> Int
inc x = x + 1

-- no delay put in: a literal, a call
literal : ~Int
literal = 3

call : ~Int
call = inc 3

-- a space after `~`
spaced : ~Int
spaced = ~ 3

-- a `String` delayed, where a `~Int` is wanted
delayedString : ~Int
delayedString = ~"a"

-- a type delayed: `Lazy` takes a `Type`
delayedType : Lazy Type
delayedType = ~Int

-- the tag, made and matched
made : ~Int
made = MkLazy (\u -> 1)

matched : ~Int -> Int
matched (MkLazy f) = f MkUnit

-- the value of an action, in what is delayed
nested : {e : HFunctor} -> Co e Int -> Co e ~Int
nested c = do
  pure ~(<- c)

-- a lambda delayed, with no type to check it at
lambda : Int
lambda = let f = ~(\x -> x) in 1
