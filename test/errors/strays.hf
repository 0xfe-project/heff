-- test: expect errors
-- Notation that has no reading, each where it is written: a tuple, a
-- named argument or an instance binder standing alone, a specialization
-- by something other than fields, an implicit argument that is no name,
-- a field declaration that is not `x : A`, a record setting whose field
-- is no name.

module test.errors.strays

tuple : Int
tuple = (1, 2)

id : Int -> Int
id x = x

tupleArgument : Int
tupleArgument = id (1, 2)

named : Int
named = (x := 1)

instanceBinder : Int
instanceBinder = {{x : Int}}

specialized : Type
specialized = Int @ 1

type Twice = { x y : Int }

type One = { x : Int }

one : One
one = { 1 = 1 }

unnamedImplicit : {Maybe Int : Type} -> Int
unnamedImplicit = 1
