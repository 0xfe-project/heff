-- test: expect errors
-- A file held by a `with` kept past its body: what the body comes to is
-- of a type bound outside it, which the region of the file is not.

import co
import std.filesystem

escaped : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> Co e (Either FileError (With OpenFile OpenFile))
escaped = withFile "held.txt" { access = Read } (\f -> pure f)
