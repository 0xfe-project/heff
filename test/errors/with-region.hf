-- test: expect errors
-- A command held by a `with` kept past its body: what the body comes to
-- is of a type bound outside it, which the region of the command is not.

module test.errors.with-region

import co
import exception
import std.process
import resource

escaped : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{fx : exception ProcessError <: e}}
        -> Co e (With Started Started)
escaped = withProcess { command = "true" } (\p -> pure p)

-- (kept in what the body comes to: a pair holding it)
stored : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{fx : exception ProcessError <: e}}
       -> Co e (Pair Int (With Started Started))
stored = withProcess { command = "true" } (\p -> pure (MkPair 1 p))

-- (a value held)
held : {a : Type} -> a -> Maybe a
held x = Just x

-- (in a `do`, the last statement)
kept : {e : HFunctor}
     -> {{sys : process <: e}}
     -> {{fx : exception ProcessError <: e}}
     -> Co e Unit
kept = do
  r <-
    withProcess { command = "true" } (\p -> do
    _ <- wait p
    pure (held p))
  pure MkUnit
