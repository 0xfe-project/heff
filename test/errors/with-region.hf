-- test: expect errors
-- A file held by a `with` kept past its body: what the body comes to is
-- of a type bound outside it, which the region of the file is not.

import co
import std.filesystem
import std.filesystem.held
import with

escaped : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> Co e (Either FileError (With OpenFile OpenFile))
escaped = withFile "held.txt" { access = Read } (\f -> pure f)

-- (kept in what the body comes to: a pair holding it)
stored : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> Co e (Either FileError (Pair Int (With OpenFile OpenFile)))
stored = withFile "held.txt" { access = Read } (\f -> pure (MkPair 1 f))

-- (a value held)
held : {a : Type} -> a -> Maybe a
held x = Just x

-- (in a `do`, the last statement)
kept : {e : HFunctor} -> {{disk : filesystem <: e}} -> Co e Unit
kept = do
  r <-
    withFile "held.txt" { access = Read } (\f -> do
    _ <- readLineOf f
    pure (held f))
  pure MkUnit
