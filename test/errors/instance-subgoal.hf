-- test: expect errors
-- an instance's instance arguments are searched for as any are: one of
-- which there is none in scope is refused, said with the instances that
-- wanted it, outwards (one whose type the instance's conclusion would
-- leave undetermined is refused where it is declared)

data Color = Red | Green

-- none of `Equality Color`, which instanceEqualityList wants for `Equality (List Color)`, which
-- instanceEqualityMaybe wants for `Equality (Maybe (List Color))`
missing : Maybe (List Color) -> Bool
missing m = equal m m
