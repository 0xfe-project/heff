-- an instance's instance arguments are searched for as any are: one of
-- which there is none in scope is refused, said with the instances that
-- wanted it, outwards; one whose type the instance's conclusion leaves
-- undetermined is refused too

data Color = Red | Green

-- none of `Eq Color`, which eqList wants for `Eq (List Color)`, which
-- eqMaybe wants for `Eq (Maybe (List Color))`
missing : Maybe (List Color) -> Bool
missing m = equal m m

theory Same (a : Type) where
  same : a -> a -> Bool

instance sameInt : Same Int
sameInt = { same = intEq }

isSame : {a : Type} -> {{s : Same a}} -> a -> a -> Bool
isSame x y = s.same x y

-- `b` is not in `Same (Maybe a)`: what `Same b` is, is never known
instance sameMaybe : {a b : Type} -> {{s : Same b}} -> Same (Maybe a)
sameMaybe = { same = \x y -> True }

undetermined : Maybe Int -> Bool
undetermined m = isSame m m
