-- test: expect errors
-- A `do` block's `with` statement, misused: each said where it is.

module test.errors.do-with

import co
import resource

-- (a `with` of a number)
number : {e : HFunctor}
       -> {a : Type}
       -> Int
       -> ({s : Type} -> With s Int -> Co e a)
       -> Co e a
number n = held (pure n) (\x -> pure MkUnit)

-- what a `with` holds is in its statements alone
heldAfter : {e : HFunctor} -> Co e Int
heldAfter = do
  with number 1 as c do
    pure (inside c)
  pure (inside c)

-- what it holds is no variable of the block
withBindsMut : {e : HFunctor} -> Co e Int
withBindsMut = do
  let mut c = 0
  with number 1 as c do
    pure (inside c)
  return c

-- nothing after a `with` whose statements never reach their end
afterWith : {e : HFunctor} -> Co e Int
afterWith = do
  with number 1 as c do
    return (inside c)
  return 3

-- what it holds does not leave it, as the value of the block
escapes : {e : HFunctor} -> {a : Type} -> Co e a
escapes = do
  with number 1 as c do
    pure c
