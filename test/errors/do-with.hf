-- test: expect errors
-- A `do` block's `with` statement, misused: each said where it is.

module test.errors.do-with

import co
import resource

-- (a `with` of a number)
number : {e : HFunctor}
       -> {a : Type}
       -> Int
       -> ({s : Type} -> With s Int -> Co e a)
       -> Co e a
number n = held (pure n) (\x -> pure MkUnit)

-- what a `with` holds is in its statements alone
heldAfter : {e : HFunctor} -> Co e Int
heldAfter = do
  with number 1 as c do
    pure (inside c)
  pure (inside c)

-- what it holds is no variable of the block
withBindsMut : {e : HFunctor} -> Co e Int
withBindsMut = do
  let mut c = 0
  with number 1 as c do
    pure (inside c)
  return c

-- nothing after a `with` whose statements never reach their end
afterWith : {e : HFunctor} -> Co e Int
afterWith = do
  with number 1 as c do
    return (inside c)
  return 3

-- what it holds does not leave it, as the value of the block
escapes : {e : HFunctor} -> {a : Type} -> Co e a
escapes = do
  with number 1 as c do
    pure c

-- (a `with` of bindings of a number: its name the number, set or not;
-- the `with` comes to what its body came to)
data Numbered = MkNumbered Int

numbered : Int -> Numbered
numbered n = MkNumbered n

instance instanceBinderNumbered : Binder Numbered
instanceBinderNumbered = { Contents = \s -> Int, Result = \r -> r }

instance instanceHolderNumbered : {e : HFunctor}
                                -> Holder e Numbered (\s -> Int) (\r -> r)
instanceHolderNumbered =
  { held = \c written body -> case c of
      MkNumbered n -> bind (body (s := Unit) n) (\p -> pure (fst p))
  }

-- a `with`'s body is a block of its own: it sets no variable of the
-- block around
setsOuter : {e : HFunctor} -> Co e Int
setsOuter = do
  let mut k = 0
  with n := numbered 1 do
    k := n
  pure k

-- nor leaves its loop
breaksOuter : {e : HFunctor} -> Co e Int
breaksOuter = do
  while True do
    with n := numbered 1 do
      break
  pure 0

-- its names are its variables: bound again, refused
boundAgain : {e : HFunctor} -> Co e Int
boundAgain = do
  with n := numbered 1 do
    n <- pure 2
    pure n

-- (a `with` of bindings of a number held in a region, as a resource)
data HeldNumber = MkHeldNumber Int

heldNumber : Int -> HeldNumber
heldNumber n = MkHeldNumber n

instance instanceBinderHeldNumber : Binder HeldNumber
instanceBinderHeldNumber = { Contents = \s -> With s Int, Result = \r -> r }

instance instanceHolderHeldNumber : {e : HFunctor}
                                  -> Holder
                                    e
                                    HeldNumber
                                    (\s -> With s Int)
                                    (\r -> r)
instanceHolderHeldNumber =
  { held = \c written body -> case c of
      MkHeldNumber n ->
        held
          (pure n)
          (\x -> pure MkUnit)
          (\w -> bind (body w) (\p -> pure (fst p)))
  }

-- what a name of a region holds does not leave the body, as its value
escapesBound : {e : HFunctor} -> Co e Unit
escapesBound = do
  v <-
    with c := heldNumber 1 do
    pure c
  pure ()
