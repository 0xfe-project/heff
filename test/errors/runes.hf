-- test: expect errors
-- A rune literal is a `Rune`, whatever it is checked at: an integer
-- literal is no rune, nor is a rune literal an integer or a string.

module test.errors.runes

code : Rune
code = 97

number : Int
number = 'a'

text : String
text = 'a'

-- (a pattern's literal is a rune, matched against a rune only)
digit : Int -> String
digit '0' = "zero"
digit _ = "other"

-- (literals never match every rune)
onlyA : Rune -> Bool
onlyA 'a' = True
