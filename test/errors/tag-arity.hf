-- A tag matched with another number of arguments than where it is first
-- is said there, when the match comes to its arm: the arm of `L`, before
-- that of `K`, says it of the `K` in it first.

data Two = K Int | L

data P = MkP Two Two

g : P -> Int
g (MkP L (K x)) = x
g (MkP L K) = 0
g (MkP (K n) L) = n
g (MkP K L) = 1
