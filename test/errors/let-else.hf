-- test: expect errors
-- A `let ... else`'s `else` must leave the block: a last statement that
-- is no jump, `return` or `abandon` (nor an `if` whose arms all are) is
-- refused, an action too (`pure 0`, a throw): a value is `case`'s.  A
-- `let ... else` is no last statement: the block ends with an
-- expression.

module test.errors.let-else

import co
import exception

f : {e : HFunctor} -> Maybe Int -> Co e Int
f m = do
  let Just x = m else
    let y = 1
  pure x

g : {e : HFunctor} -> Maybe Int -> Co e Int
g m = do
  let mut n = 0
  let Just x = m else n := 1
  pure x

k : {e : HFunctor} -> Maybe Int -> Co e Int
k m = do
  let Just x = m else return 0

valued : {e : HFunctor} -> Maybe Int -> Co e Int
valued m = do
  let Just x = m else pure 0
  pure x

thrown : {e : HFunctor}
       -> {{ex : exception String <: e}}
       -> Maybe Int
       -> Co e Int
thrown m = do
  let Just x = m else throw "none"
  pure x

halfway : {e : HFunctor} -> Bool -> Maybe Int -> Co e Int
halfway b m = do
  let Just x = m else
    if b then return 0
  pure x
