-- test: expect errors
-- A block where it cannot be: a `do` after `try`, whose own block would
-- have to be indented past it, in the middle of the line, said where
-- the `do` is.

module test.errors.block-indented

import co
import exception

caught : {e : HFunctor} -> {{ex : exception String <: e}} -> Co e Int
caught = do
  try do
    pure ()
  catch (why : String) ->
    pure ()
  pure 1
