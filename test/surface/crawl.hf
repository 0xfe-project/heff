-- A crawler: five worlds in one sum -- failure, a visited set, the
-- network, a log, parallel fetching -- and one handler built world by
-- world.  `extend` is the point to see: it never composes two monads; it
-- stacks one more algebra on the ONE monad the whole sum shares
-- (St -> R a, below).  What does not compose by itself -- failure over
-- state, parallel over failure -- is composed by hand, in R and in the
-- order the algebras read St.

import bytes as Bytes
import co
import exception
import parallel
import state
import std.http as Http
import std.io

-- the sum, right-nested so the handler stacks the same way
par2 : HFunctor
par2 = parallel String String

r3 : HFunctor
r3 = stdio <+> par2

r2 : HFunctor
r2 = Http.http <+> r3

r1 : HFunctor
r1 = state (List String) <+> r2

world : HFunctor
world = exception String <+> r1

-- the world's structure: each sub-effect's evidence, given to `crawl`
onException : (exception String <: world)
onException = inl (exception String) r1

onSt : (state (List String) <: world)
onSt p = inr (exception String) r1 (inl (state (List String)) r2 p)

onNet : (Http.http <: world)
onNet p =
  inr (exception String) r1 (inr (state (List String)) r2 (inl Http.http r3 p))

onOut : (stdio <: world)
onOut p =
  inr
    (exception String)
    r1
    (inr (state (List String)) r2 (inr Http.http r3 (inl stdio par2 p)))

onPar : (par2 <: world)
onPar p =
  inr
    (exception String)
    r1
    (inr (state (List String)) r2 (inr Http.http r3 (inr stdio par2 p)))

-- the operations, each asking for the evidence of the world it uses
visited : {e : HFunctor}
        -> {{st : state (List String) <: e}}
        -> Co e (List String)
visited = get

record : {e : HFunctor}
       -> {{st : state (List String) <: e}}
       -> List String
       -> Co e Unit
record v = put v

say : {e : HFunctor} -> {{io : stdio <: e}} -> String -> Co e Unit
say s = write s

-- (a page's text: none where it is missing, or nothing answered)
found : Either Http.HttpError Http.Response -> Maybe String
found (Left _) = Nothing
found (Right r) = if r.status == 200 then Just (Http.text r) else Nothing

fetch : {e : HFunctor}
      -> {{nt : Http.http <: e}}
      -> String
      -> Co e (Maybe String)
fetch u = do
  r <- Http.get u
  pure (found r)

-- a fetch that fails loudly on a missing page
fetchBody : {e : HFunctor}
          -> {{nt : Http.http <: e}}
          -> {{ex : exception String <: e}}
          -> String
          -> Co e String
fetchBody u = do
  c <- fetch u
  maybe (throw u) pure c

-- fetch one page, catching: a missing page is said, and is no page
grab : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{nt : Http.http <: e}}
     -> {{ex : exception String <: e}}
     -> String
     -> Co e String
grab u = do
  say ("fetch " ^ u)
  catch (fetchBody u) (\bad -> do
    say ("missing " ^ bad)
    pure "")

-- the links not yet seen, in order
fresh : {e : HFunctor}
      -> {{st : state (List String) <: e}}
      -> List String
      -> Co e (List String)
fresh Nil = pure Nil
fresh (u :: us) = do
  rest <- fresh us
  v <- visited
  if strEq u "" || List.elemBy strEq u v then pure rest else pure (u :: rest)

-- breadth first, two pages at a time in parallel, while the fuel lasts
crawlW : {e : HFunctor}
       -> {{ex : exception String <: e}}
       -> {{st : state (List String) <: e}}
       -> {{nt : Http.http <: e}}
       -> {{io : stdio <: e}}
       -> {{pr : par2 <: e}}
       -> Int
       -> List String
       -> Co e Unit
crawlW 0 _ = say "fuel spent"
crawlW fuel Nil = say "done"
crawlW fuel (a :: b :: rest) = do
  v <- visited
  record (a :: b :: v)
  bodies <- parallelIn (grab a) (grab b)
  more <- fresh (words (fst bodies ^ " " ^ snd bodies))
  crawlW (fuel - 1) (List.append rest more)
crawlW fuel (a :: Nil) = do
  v <- visited
  record (a :: v)
  body <- grab a
  more <- fresh (words body)
  crawlW (fuel - 1) more

-- the crawler, its world's evidence given
crawl : Int -> List String -> Co world Unit
crawl fuel us =
  crawlW
    (ex := onException)
    (st := onSt)
    (nt := onNet)
    (io := onOut)
    (pr := onPar)
    fuel
    us

-- the handler ------------------------------------------------------------

-- the one monad of the whole sum: a visited set and a log, threaded, and
-- failure cutting the thread
data St = MkSt (List String) (List String)

data R a = ROk a St | RFail String St

logged : String -> St -> St
logged s (MkSt v lg) = MkSt v (List.append lg [s])

-- the little web
page : Int -> String -> Http.Response
page status t = { status = status, headers = Nil, body = Bytes.fromString t }

pageOf : String -> Http.Response
pageOf "root" = page 200 "a b"
pageOf "a" = page 200 "c d"
pageOf "b" = page 200 "e"
pageOf "c" = page 200 ""
pageOf "e" = page 200 ""
pageOf _ = page 404 "not here"

-- the base world: parallel fetching, here one after the other
-- (`extend` stacks the other four onto it)
base : Handler par2
base =
  { M = \a -> St -> R a
  , ret = \x st -> ROk x st
  , bind = \m k st -> case m st of
      RFail s st2 -> RFail s st2
      ROk x st2 -> k x st2
  , malg = \p st -> case p of
      Parallel l r k -> case l st of
        RFail s st2 -> RFail s st2
        ROk x st2 -> case r st2 of
          RFail s st3 -> RFail s st3
          ROk y st3 -> ROk (k x y) st3
  }

h3 : Handler r3
h3 =
  extend stdio par2 base (\p st -> case p of
  Write s x -> ROk x (logged s st)
  WriteErr s x -> ROk x (logged s st)
  ReadStdin k -> ROk (k "") st)

h2 : Handler r2
h2 =
  extend Http.http r3 h3 (\p st -> case p of
  Send rq k -> ROk (k (Right (pageOf rq.url))) st)

h1 : Handler r1
h1 =
  extend (state (List String)) r2 h2 (\p st -> case p of
  Get k -> case st of
    MkSt v lg -> ROk (k v) st
  Put v x -> case st of
    MkSt old lg -> ROk x (MkSt v lg))

-- failure keeps the world: what was fetched stays fetched
hAll : Handler world
hAll =
  extend (exception String) r1 h1 (\p st -> case p of
  Throw s -> RFail s st
  Catch c h -> case c st of
    RFail s st2 -> h s st2
    ROk x st2 -> ROk x st2)

render : R Unit -> String
render (ROk u (MkSt v lg)) = joinWith ";" lg
render (RFail s (MkSt v lg)) = "FAIL " ^ s ^ ": " ^ joinWith ";" lg

test crawl

-- >>> render (handle hAll (crawl 6 ["root"]) (MkSt [] []))
-- "fetch root;fetch a;fetch b;fetch c;fetch d;missing d;fetch e;done"

-- out of fuel before the queue is out
-- >>> render (handle hAll (crawl 2 ["root"]) (MkSt [] []))
-- "fetch root;fetch a;fetch b;fuel spent"
