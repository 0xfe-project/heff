-- A metavariable applied past its arity, to a local out of the scope of
-- what it is unified with, is pruned: its solution a fresh one, of the
-- type it has applied to all of them (`?m t : Type`, not `Type -> Type`).

module test.surface.metas-past-arity

-- (a function of a type, its result of the type the argument makes)
made : {m : Type -> Type} -> (t : Type) -> m t
made t = abandon

-- (a function of a type, its result of one type whatever it is)
fixed : {p : Type} -> (t : Type) -> p
fixed t = abandon

-- (the first of two of a type)
first : {a : Type} -> a -> a -> a
first x y = x

-- `?m t =?= ?p`, under `t`: `?m := \t -> ?n`, `?n : Type`
madeFirst : Type -> Int
madeFirst t = first made fixed t

-- `?p =?= ?m t`, under `t`
fixedFirst : Type -> Int
fixedFirst t = first fixed made t
