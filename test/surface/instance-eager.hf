-- An instance argument is searched for as soon as its goal is known:
-- here once the argument before it is, so that its type members type
-- the arguments after it.  One whose goal is not known yet waits, as
-- before.

module test.surface.instance-eager

theory Cell (c : Type) where
  Contents : Type
  get : c -> Contents
  put : c -> Contents -> c

data Box (a : Type) = MkBox a

instance instanceCellBox : {a : Type} -> Cell (Box a)
instanceCellBox = { Contents = a, get = open, put = \b x -> MkBox x }
  where
  open : Box a -> a
  open (MkBox x) = x

-- (`cw`'s goal is known once `b` is: `f`'s binder is `cw.Contents`)
update : {c : Type} -> c -> {{cw : Cell c}} -> (cw.Contents -> cw.Contents) -> c
update b f = cw.put b (f (cw.get b))

contents : {c : Type} -> {{cw : Cell c}} -> c -> cw.Contents
contents b = cw.get b

oneBox : Box Int
oneBox = MkBox 1

pairBox : Box (Int, Int)
pairBox = MkBox (1, 2)

-- | >>> bumped
-- | 2
bumped : Int
bumped = contents (update oneBox (\y -> y + 1))

-- | >>> flipped
-- | (2, 1)
flipped : (Int, Int)
flipped = contents (update pairBox (\(x, y) -> (y, x)))

-- (`cw`'s goal is not known until `b` is, after `f`: it waits, and `f`'s
-- binder, annotated, is checked against `cw.Contents` once it is found)
updateLate : {c : Type}
           -> {{cw : Cell c}}
           -> (cw.Contents -> cw.Contents)
           -> c
           -> c
updateLate f b = cw.put b (f (cw.get b))

-- | >>> bumpedLate
-- | 2
bumpedLate : Int
bumpedLate = contents (updateLate (\(y : Int) -> y + 1) oneBox)
