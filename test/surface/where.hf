-- `where` after an equation: local definitions, each given its type and
-- defined by equations, as at the top level.  They are in scope in the
-- equation's body and in those after them, and see the equation's
-- variables; one may call itself, under a lambda.  The parent's implicit
-- arguments are in scope in their types; a local one has its own.

-- | >>> sumTo 100000
-- | 5000050000
sumTo : Int -> Int
sumTo n = go 0 n
  where
    go : Int -> Int -> Int
    go acc 0 = acc
    go acc i = go (acc + i) (i - 1)

-- | >>> scaled 3 [1, 2, 3]
-- | Cons 3 (Cons 6 (Cons 9 Nil))
scaled : Int -> List Int -> List Int
scaled k xs = go xs
  where
    times : Int -> Int
    times x = k * x

    go : List Int -> List Int
    go Nil = Nil
    go (y :: ys) = times y :: go ys

-- (each equation its own: the variables of its patterns)
-- | >>> firstOr 0 [3, 4]
-- | 6
-- | >>> firstOr 7 []
-- | 7
firstOr : Int -> List Int -> Int
firstOr d Nil = d
firstOr d (x :: xs) = twice
  where
    twice : Int
    twice = x + x

-- | >>> mapAll (\x -> x + 1) [1, 2]
-- | Cons 2 (Cons 3 Nil)
mapAll : {a b : Type} -> (a -> b) -> List a -> List b
mapAll f xs = go xs
  where
    go : List a -> List b
    go Nil = Nil
    go (y :: ys) = f y :: go ys

-- | >>> pairUp 5
-- | MkPair 5 5
pairUp : {a : Type} -> a -> Pair a a
pairUp x = dup x
  where
    dup : {c : Type} -> c -> Pair c c
    dup y = MkPair y y

-- | >>> nested 4
-- | 17
nested : Int -> Int
nested n = outer n
  where
    outer : Int -> Int
    outer m = inner m + 1
      where
        inner : Int -> Int
        inner k = k * n

-- (the body a `case`, `where` under it)
-- | >>> classify (Just 12)
-- | 10
classify : Maybe Int -> Int
classify m = case m of
  Just x -> cap x
  Nothing -> 0
  where
    cap : Int -> Int
    cap x = if x > 10 then 10 else x

-- (#73: the declarations at the column of `where`, as `heff fmt` lays
-- them out; a local equation's own `where` past them, its declarations
-- at its column too)
-- | >>> flatNested 4
-- | 17
flatNested : Int -> Int
flatNested n = outer n
  where
  outer : Int -> Int
  outer m = inner m + 1
    where
    inner : Int -> Int
    inner k = k * n

-- | >>> flatClassify (Just 3)
-- | 6
-- | >>> flatClassify Nothing
-- | 0
flatClassify : Maybe Int -> Int
flatClassify m = case m of
  Just x -> twice x
  Nothing -> 0
  where
  twice : Int -> Int
  twice x = case x of
    0 -> 0
    _ -> x + x
