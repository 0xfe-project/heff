-- `a ++ f xs` last: the compiled call is a loop, the left sides gathered
-- as it goes (as a constructor's last argument is, modulo cons) -- a
-- hundred thousand appends are no stack.

import prelude

joinAll : List String -> String
joinAll Nil = ""
joinAll (Cons x xs) = x ++ joinAll xs

-- (two appends before the call, and a tail of its own text)
sep : List String -> String
sep Nil = "."
sep (Cons x xs) = x ++ "," ++ sep xs

-- >>> joinAll ["a", "b", "c"]
-- "abc"

-- >>> sep ["a", "b"]
-- "a,b,."

nats : Int -> List String
nats n = if n <= 0 then Nil else Cons (showInt n) (nats (n - 1))

-- >>> strLength (joinAll (nats 100000))
-- 488895
