-- `x :: xs` is `Cons x xs` -- the prelude's operator in an expression,
-- and the `Cons` in scope in a pattern (as a literal is the equality in
-- scope); it binds right, below the arithmetic and `++`.

import prelude

len2 : {a : Type} -> List a -> Int
len2 Nil = 0
len2 (x :: xs) = 1 + len2 xs

second : List Int -> Int
second (x :: y :: rest) = y
second xs = 0

-- >>> 1 :: 2 :: [3]
-- Cons 1 (Cons 2 (Cons 3 Nil))

-- >>> 1 + 1 :: [3]
-- Cons 2 (Cons 3 Nil)

-- >>> "a" ++ "b" :: ["c"]
-- Cons "ab" (Cons "c" Nil)

-- >>> len2 [1, 2, 3]
-- 3

-- >>> second [4, 5, 6]
-- 5

heads : List Int -> Int
heads xs = case xs of
  x :: rest -> x
  Nil -> 0

-- >>> heads [7, 8]
-- 7
