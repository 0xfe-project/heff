-- `x :: xs` is `Cons x xs` -- the prelude's operator, in an expression
-- and in a pattern too, as it is defined as another name for the tag;
-- it binds right, below the arithmetic and `^`.  An operator of one's
-- own, so defined, is a pattern as well, by its own fixity.

module test.surface.cons

-- | >>> len2 [1, 2, 3]
-- | 3
len2 : {a : Type} -> List a -> Int
len2 [] = 0
len2 (x :: xs) = 1 + len2 xs

-- | >>> second [4, 5, 6]
-- | 5
second : List Int -> Int
second (x :: y :: rest) = y
second xs = 0

-- >>> 1 :: 2 :: [3]
-- Cons 1 (Cons 2 (Cons 3 Nil))

-- >>> 1 + 1 :: [3]
-- Cons 2 (Cons 3 Nil)

-- >>> "a" ^ "b" :: ["c"]
-- Cons "ab" (Cons "c" Nil)

-- | >>> heads [7, 8]
-- | 7
heads : List Int -> Int
heads xs = case xs of
  x :: rest -> x
  [] -> 0

data Snoc a = Lin | MkSnoc (Snoc a) a

infixl :>

(:>) : {a : Type} -> Snoc a -> a -> Snoc a
(:>) xs x = MkSnoc xs x

-- | >>> lastS (Lin :> 1 :> 2)
-- | 2
lastS : Snoc Int -> Int
lastS (_ :> x) = x
lastS Lin = 0

-- | >>> firstS (Lin :> 7 :> 8)
-- | 7
firstS : Snoc Int -> Int
firstS s = case s of
  Lin :> a :> _ -> a
  _ -> 0
