-- An act a `with` awaits, `BOC.await act`, is of the `with`'s world: the
-- `with`'s `Holder` says so, deciding the act's world, and the act's
-- evidence is found there -- in a definition of a concrete world, as in
-- one polymorphic in it, and in a world a handler adds to (`attempt`'s),
-- with no annotation.  (Evidence waiting for the act's world is not
-- refused at the end before that `Holder` is taken.)

module test.surface.awaited-worlds

import boc as BOC
import co
import exception
import std.duration as Duration
import std.io
import std.time

-- (a nap, of whatever world has time)
nap : {e : HFunctor} -> {{clock : time <: e}} -> Int -> Co e Unit
nap ms = sleep (Duration.milliseconds ms)

-- an act awaited, in a concrete world
slept : Co (BOC.boc <+> time <+> stdio) Unit
slept = do
  with u := BOC.await (sleep (Duration.milliseconds 10)) do
    print "slept"

-- two raced, and an act that is a call of a polymorphic function
raced : Co (BOC.boc <+> time <+> stdio) Unit
raced = do
  with r := BOC.awaitFirst (nap 10) (nap 20) do
    print "raced"
  with u := BOC.await (nap 5) do
    print "napped"

-- a cown and an act, in one `with`
counted : Co (BOC.boc <+> time <+> stdio) Unit
counted = do
  c <- BOC.newCown 0
  with n := c
       u := BOC.await (sleep (Duration.milliseconds 10)) do
    n := n + 1

-- an act awaited in `attempt`'s world, of a concrete world around
attempted : Co (BOC.boc <+> time <+> stdio) Unit
attempted = do
  r <-
    attempt String (do
      with u := BOC.await (sleep (Duration.milliseconds 10)) do
        print "slept")
  print "done"

-- ... and of a world polymorphic around: the act's world is `attempt`'s,
-- not the `e` the evidence in scope is of
attemptedIn : {e : HFunctor}
            -> {{bc : BOC.boc <: e}}
            -> {{clock : time <: e}}
            -> {{io : stdio <: e}}
            -> Co e Unit
attemptedIn = do
  r <-
    attempt String (do
      with u := BOC.await (sleep (Duration.milliseconds 10)) do
        print "slept")
  print "done"
