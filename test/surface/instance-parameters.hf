-- Instances that take instance arguments: `instance x : {a : Type} ->
-- {{e : C a}} -> C (T a)` is an instance of each `C (T a)` there is a
-- `C a` of -- its conclusion unified with the type wanted, which solves
-- its implicit arguments, and its instance arguments found by searches
-- of their own, as deep as they go.  The prelude's `Equality` has them of
-- lists, `Maybe`, pairs and `Either`.

-- lists, and lists of lists: equalityList of equalityInt, equalityList of equalityList
-- >>> equal ([1, 2, 3] : List Int) [1, 2, 3]
-- True
-- >>> equal (["a"] : List String) ["a", "b"]
-- False
-- >>> equal ([[1], [2, 3]] : List (List Int)) [[1], [2, 3]]
-- True
-- >>> equal ([[1], []] : List (List Int)) [[1], [2]]
-- False

-- a `Maybe` of lists, pairs, and an `Either` in one
-- >>> equal (Just [1, 2] : Maybe (List Int)) (Just [1, 2])
-- True
-- >>> equal (Just [] : Maybe (List Int)) Nothing
-- False
-- >>> equal (MkPair 1 [True] : Pair Int (List Bool)) (MkPair 1 [True])
-- True
-- >>> equal (MkPair "x" (Left 2) : Pair String (Either Int Rune)) (MkPair "x" (Right 'c'))
-- False

-- (in a definition, the type known from its parameters)
-- | >>> sameRows [[0.5], []] [[0.5], []]
-- | True
sameRows : List (List Float64) -> List (List Float64) -> Bool
sameRows a b = equal a b

-- a type of the program's own, given an instance: lists of it, and
-- `Maybe`s, by the prelude's instances of those
data Color = Red | Green | Blue

instance eqColor : Equality Color
eqColor = { equal = sameColor }
  where
    sameColor : Color -> Color -> Bool
    sameColor Red Red = True
    sameColor Green Green = True
    sameColor Blue Blue = True
    sameColor _ _ = False

-- >>> equal ([Red, Blue] : List Color) [Red, Blue]
-- True
-- >>> equal (Just Green : Maybe Color) (Just Blue)
-- False

-- a parameterized type of the program's own, and its instance, which
-- takes its elements' type's
data Tree a = Leaf | Node a (Tree a) (Tree a)

instance eqTree : {a : Type} -> {{eq : Equality a}} -> Equality (Tree a)
eqTree = { equal = sameTrees }
  where
    sameTrees : Tree a -> Tree a -> Bool
    sameTrees Leaf Leaf = True
    sameTrees (Node x l1 r1) (Node y l2 r2) =
      equal x y && sameTrees l1 l2 && sameTrees r1 r2
    sameTrees _ _ = False

singleton : {a : Type} -> a -> Tree a
singleton x = Node x Leaf Leaf

-- >>> equal (singleton [Red] : Tree (List Color)) (singleton [Red])
-- True
-- >>> equal (Node (Just 1) Leaf (singleton Nothing) : Tree (Maybe Int)) (Node (Just 1) Leaf Leaf)
-- False
-- >>> equal ([singleton (MkPair 1 'a')] : List (Tree (Pair Int Rune))) [singleton (MkPair 1 'a')]
-- True

-- a function given an `Equality a` finds an `Equality (List a)` by it: equalityList of
-- the instance binder
-- | >>> firstRows ([[1], [2]] : List (List Int)) [[1]]
-- | True
firstRows : {a : Type}
          -> {{eq : Equality a}}
          -> List (List a)
          -> List (List a)
          -> Bool
firstRows (Cons x xs) (Cons y ys) = equal x y
firstRows _ _ = False

-- an instance found is given by name, as any instance argument may be,
-- and its own instance arguments too
-- >>> equal (eq := equalityList (eq := equalityInt)) [1] [2]
-- False
-- >>> equal (eq := eqTree) (singleton 'r') (singleton 'r')
-- True

-- an instance with arguments projected from is given them first, as an
-- application gives them
-- >>> equalityList.equal ([1, 2] : List Int) [1, 2]
-- True
-- >>> equalityPair.equal (MkPair 'a' "b" : Pair Rune String) (MkPair 'a' "c")
-- False
