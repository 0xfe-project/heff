-- A column of tags taken apart: an equation that matches any value
-- there between those that match a tag (in every arm, those of the tags
-- after it too), a tag again after another, and the names the equations
-- give the column and the tags' fields.

module test.surface.tag-columns

data Nat2 = Z | S Nat2

data Three = A | B Nat2 | C Nat2 Nat2

-- (`t` and `u`, matching any value, are in the arms of `B` and `C`,
-- which come after them, and the column takes a name of its own)
-- | >>> order A (S Z)
-- | S Z
-- | >>> order (B (S Z)) Z
-- | Z
-- | >>> order (C Z Z) (S Z)
-- | S Z
-- | >>> order (B (S Z)) (S (S Z))
-- | S Z
-- | >>> order (C Z (S (S Z))) (S (S Z))
-- | S (S Z)
order : Three -> Nat2 -> Nat2
order A n = n
order t Z = Z
order u (S Z) = S Z
order (B m) (S n) = m
order (C a b) n = b
order (B m) n = n

-- (the tag column is the second: the first equation's first pattern
-- matches any value)
-- | >>> mix (S Z) Z
-- | S Z
-- | >>> mix Z (S (S Z))
-- | S Z
-- | >>> mix (S (S Z)) (S Z)
-- | S (S Z)
mix : Nat2 -> Nat2 -> Nat2
mix x Z = x
mix Z (S n) = n
mix y w = y
mix z (S (S k)) = k

-- (a tag's fields named by its first equation, `_` a fresh name)
-- | >>> fields (C Z (S Z))
-- | S Z
-- | >>> fields (B (S Z))
-- | S Z
-- | >>> fields A
-- | Z
fields : Three -> Nat2
fields (C _ b) = b
fields (B m) = m
fields (C a _) = a
fields A = Z
