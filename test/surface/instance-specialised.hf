-- An instance argument of a theory specialised, `{{it : Iterate c @ {
-- Elem = Int }}}`, is searched for as `Iterate c`: the instance found
-- by its parameters, then its fields checked against the
-- specialisation.  An instance declared specialised is found as one of
-- the theory itself.

module test.surface.instance-specialised

-- (the prelude's `instanceIterateList`, its `Elem` the list's)
firstInt : {c : Type} -> {{it : Iterate c @ { Elem = Int }}} -> c -> Int
firstInt xs = case it.next (it.start xs) of
  Just (MkPair x _) -> x
  Nothing -> 0

nums : List Int
nums = [7, 8]

-- | >>> first
-- | 7
first : Int
first = firstInt nums

-- (the field's value inferred: `Elem` checked, `e` solved)
firstOf : {c e : Type} -> {{it : Iterate c @ { Elem = e }}} -> e -> c -> e
firstOf d xs = case it.next (it.start xs) of
  Just (MkPair x _) -> x
  Nothing -> d

words : List String
words = ["a", "b"]

-- | >>> word
-- | "a"
word : String
word = firstOf "" words

-- (`e` determined by the check alone, and then its `Show e` found)
firstShown : {c e : Type}
           -> {{it : Iterate c @ { Elem = e }}}
           -> {{sh : Show e}}
           -> c
           -> String
firstShown xs = case it.next (it.start xs) of
  Just (MkPair x _) -> sh.show x
  Nothing -> ""

-- | >>> shown
-- | "7"
shown : String
shown = firstShown nums

theory Zero where
  t : Type
  zero : t

-- | >>> zeroInt.zero
-- | 0
instance zeroInt : Zero @ { t = Int }
zeroInt = { t = Int, zero = 0 }

-- (a goal not specialised finds the instance declared so)
zeroOf : {{z : Zero}} -> z.t
zeroOf = z.zero

-- | >>> plain
-- | 0
plain : Int
plain = zeroOf
