-- An arm no value takes is warned of: one whose tag the matches around
-- have ruled out for the very value it matches (W0358, with the arm or
-- the match that ruled it out), a default with no tag left, and one the
-- arms or the equations above leave no value for (W0359).  Not an arm of
-- a match the reader or the clause compiler made (an `if`, `&&`, a
-- `let p = e else s`, the rows of names a nested `case` has), nor where
-- the value is another (a name bound again, a variable set, a lambda's
-- parameter) or the arm is outside the match (a lambda made before it,
-- the statements after it), nor a body the equations put in more than
-- one place and taken in one of them, nor one inside an arm warned of.

module test.surface.dead-arms

data Three = A | B | C Int

type Box = { items : List Int, n : Int }

-- Ruled out by the matches around

inner : List Int -> Int
inner xs = case xs of
  [] -> 0
  h :: t -> case xs of
    [] -> 1
    a :: b -> a

defaultLeft : List Int -> Int
defaultLeft xs = case xs of
  h :: t -> 0
  _ -> case xs of
    a :: b -> 1
    _ -> 2

noTagLeft : Three -> Int
noTagLeft x = case x of
  A -> 0
  B -> 1
  C n -> case x of
    C m -> m
    _ -> 2

field : Box -> Int
field b = case b.items of
  [] -> 0
  _ -> case b.items of
    [] -> 1
    [x] -> x
    _ -> 2

argument : List (List Int) -> Int
argument xss = case xss of
  [] :: rest -> 0
  (a :: b) :: rest -> case xss of
    [] :: r -> 1
    _ -> a
  [] -> 3

renamed : List Int -> Int
renamed xs = case xs of
  [] -> 0
  ys -> case xs of
    [] -> 1
    h :: t -> h

inDo : List Int -> Int
inDo xs = run do
  let mut n = 0
  case xs of
    [] -> n := 1
    h :: t -> case xs of
      [] -> n := 5
      a :: b -> n := a
  n

deadInDead : List Int -> Int
deadInDead xs = case xs of
  [] -> 0
  h :: t -> case xs of
    [] -> case xs of
      [] -> 5
      a :: b -> 6
    a :: b -> a

-- Left no value by the arms or equations above

twice : List Int -> Int
twice xs = case xs of
  [] -> 1
  [] -> 2
  h :: t -> h

everyTag : Bool -> Int
everyTag b = case b of
  True -> 1
  False -> 2
  _ -> 3

above : List Int -> Int
above xs = case xs of
  [a] -> a
  _ -> 0
  a :: b :: c -> b

equations : List Int -> Int
equations [] = 0
equations xs = 1
equations (h :: t) = h

literals : Int -> Int
literals 0 = 0
literals n = n
literals 1 = 1

-- Not warned of

condition : Bool -> Int
condition b = case b of
  True -> if b then 1 else 2
  False -> if b && b then 3 else 4

letElse : List Int -> Int
letElse xs = case xs of
  [] -> run do
    let h :: t = xs else return 0
    h
  _ -> 1

shadowed : List Int -> List Int -> Int
shadowed xs ys = case xs of
  [] -> 0
  _ ->
    let xs = ys
    in case xs of
    [] -> 1
    a :: b -> a

mutated : List Int -> Int
mutated xs = run do
  let mut ys = xs
  case ys of
    [] -> return 0
    _ -> do
      ys := Nil
      case ys of
        [] -> return 1
        h :: t -> return h
  0

after : List Int -> Int
after xs = run do
  let mut n = 0
  case xs of
    [] -> n := 1
    _ -> n := 2
  case xs of
    [] -> n
    h :: t -> h + n

lambdaBefore : List Int -> Int
lambdaBefore xs =
  let f : Int -> Int = \u -> case xs of
    [] -> 0
    h :: t -> h
  in case xs of
  [] -> f 0
  _ -> f 1

parameter : List Int -> Int
parameter xs = case xs of
  [] -> 0
  _ ->
    let f : List Int -> Int = \ys -> case ys of
      [] -> 1
      h :: t -> h
    in f xs

copied : List Int -> Bool -> Int
copied [] True = 1
copied xs b = case xs of
  [] -> 2
  h :: t -> h

-- (the equations above name every tag, but the clause compiler is not
-- told the type: an equation of names after them is taken as reached)
namesLast : List Int -> Int
namesLast [] = 0
namesLast (h :: t) = h
namesLast xs = 1
