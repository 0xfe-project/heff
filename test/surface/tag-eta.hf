-- A tag checked at a function type is eta-expanded (#89): it is the
-- lambda that applies it to the arguments the type takes, and the tag
-- applied is checked at the type's last codomain as a tag is.  At a type
-- not known yet (`List.map`'s argument), it waits for it.

module test.surface.tag-eta

data Box = MkBox Int

data P = MkP Int Int

mk : Int -> Box
mk = MkBox

part : Int -> P
part = MkP 1

xs : List Box
xs = List.map MkBox [1, 2]

-- (implicit and instance binders: the implicit lambdas around any term
-- checked there)
data Wrap a = MkWrap a

wrap : {a : Type} -> a -> Wrap a
wrap = MkWrap

wrapShown : {a : Type} -> {{s : Show a}} -> a -> Wrap a
wrapShown = MkWrap

-- >>> mk 3
-- MkBox 3
-- >>> part 2
-- MkP 1 2
-- >>> xs
-- [MkBox 1, MkBox 2]
-- >>> wrap 1
-- MkWrap 1
-- >>> wrapShown 2
-- MkWrap 2
