-- A negative literal: `-` right before a digit is the literal's sign,
-- unless it is right after an operand (a name, a literal, a closing
-- bracket, with no space between).  So `a - 1` and `a-1` subtract, and
-- `f -1` and `a -1` apply to -1.  A literal it is, of the type it is used
-- at: `-128` is an `Int8`'s least, its range checked as -128.

import int8 as I8

-- | >>> a - 1
-- | 9
-- | >>> a-1
-- | 9
-- | >>> 0 - a
-- | -10
a : Int
a = 10

-- | >>> f -1
-- | -100
-- | >>> f (a - 1)
-- | 900
f : Int -> Int
f x = x * 100

-- (a pattern too)
-- | >>> List.map sign [-1, 0, 1]
-- | Cons "minus one" (Cons "zero" (Cons "other" Nil))
sign : Int -> String
sign -1 = "minus one"
sign 0 = "zero"
sign _ = "other"

-- | >>> least -128
-- | True
least : Int8 -> Bool
least x = case x of
  -128 -> True
  _ -> False

-- >>> 2 * -3
-- -6

-- >>> List.map (\x -> x * 2) [-1, -0x10]
-- Cons (-2) (Cons (-32) Nil)

-- >>> I8.show -128
-- "-128"
