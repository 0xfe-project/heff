-- The fixed-width numeric types' literals: a literal checked at one of
-- them is of it (an integer one in its range, a float one at `Float32`);
-- one whose type nothing decides is an `Int` or a `Float64`.

module test.surface.fixed-literals

-- | another name for one of them is the type itself
type Byte = UInt8

-- | >>> least
-- | -128
least : Int8
least = -128

-- | >>> most
-- | 18446744073709551615
most : UInt64
most = 18446744073709551615

-- | >>> byte
-- | 255
byte : Byte
byte = 255

-- | >>> pair
-- | MkPair (-300) 4000000000
pair : Pair Int16 UInt32
pair = MkPair (-300) 4000000000

-- | >>> halves
-- | Cons 0.5 (Cons (-0.25) (Cons 6.02e23 Nil))
halves : List Float32
halves = [0.5, -0.25, 6.02e23]

twice : Int64 -> List Int64
twice x = [x, x]

-- (an argument checked at the parameter's type)
-- | >>> twos
-- | Cons 2 (Cons 2 Nil)
twos : List Int64
twos = twice 2

-- (at no type known yet, and none found: an `Int`)
-- | >>> seven
-- | 7
seven : Int
seven = List.length [1, 2, 3] + 4

-- >>> (0.1 : Float32)
-- 0.1

-- >>> (-2147483648 : Int32)
-- -2147483648
