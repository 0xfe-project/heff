-- In-module type naming: a type field of the struct names a type for the
-- fields after it.  The self's checked fields are in hand -- `mod1.at`
-- below is the record type it was just defined to be -- so `mk` builds an
-- `at` in place, and `pos` projects through it.

module test.surface.struct-naming

theory MOD where
  at : Type
  tok : Type
  mk : Int -> tok
  pos : tok -> Int

-- | >>> mod1.pos (mod1.mk 3)
-- | 7
mod1 : MOD
mod1 =
  { at = { line : Int, col : Int }
  , tok = { k : Int, at : mod1.at }
  , mk = \i -> { k = i, at = { line = i, col = i + 1 } }
  , pos = \t -> t.at.line + t.at.col
  }
