-- Functions that call one another are fields of one record: a call of one
-- goes through the record's name, under a lambda (so it is not computed
-- while the record is being built -- `test/errors/knot-record.hf`).

import prelude

theory Evens where
  isEven : Int -> Bool
  isOdd : Int -> Bool

evens : Evens
evens =
  { isEven = \n -> if n == 0 then True else evens.isOdd (n - 1)
  , isOdd = \n -> if n == 0 then False else evens.isEven (n - 1)
  }

-- >>> evens.isEven 10
-- True

-- >>> evens.isOdd 7
-- True
