-- Evaluation is by value: an argument, or a field, is computed before it is
-- passed or put, used or not (as the compiled code runs).

module test.surface.by-value

-- | >>> one 2
-- | 1
-- | >>> one abandon
-- | <abandoned>
one : Int -> Int
one _ = 1

-- >>> fst (MkPair 1 (abandon : Int))
-- <abandoned>
-- >>> const 1 (abandon : Int)
-- <abandoned>
