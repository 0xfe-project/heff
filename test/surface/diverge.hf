-- A definition that recurses without end diverges: evaluation deeper than
-- a program that ends needs is said to, `<diverged>`, by the
-- interpreter -- it is not run until the memory is gone.

module test.surface.diverge

-- | >>> spin 0
-- | <diverged>
spin : Int -> Int
spin x = spin (x + 1)

-- | A loop that ends ends, however many turns it takes: a call in a tail
-- | position nests no deeper, and two million turns take fewer steps than
-- | the interpreter's bound.
-- | >>> countDown 2000000
-- | 0
countDown : Int -> Int
countDown n = if n == 0 then 0 else countDown (n - 1)

-- | A recursion that waits for itself, nested past a million, diverges:
-- | the interpreter's own stack is bounded.
-- | >>> depthOf 2000000
-- | <diverged>
depthOf : Int -> Int
depthOf n = if n == 0 then 0 else 1 + depthOf (n - 1)
