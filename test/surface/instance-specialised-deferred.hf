-- A goal specialised, `T args @ { x = v }`, whose instance gives its
-- field through one of its own instance arguments, `Elem = it.Elem`:
-- found at once, or found only later (its type known once another
-- argument or another field's check solves it), the field's check
-- waits for it, and solves what the goal leaves open.

module test.surface.instance-specialised-deferred

data Wrap (c : Type) = MkWrap c

instance instanceIterateWrap : {c : Type}
                             -> {{it : Iterate c}}
                             -> Iterate (Wrap c)
instanceIterateWrap =
  { Elem = it.Elem, Cursor = it.Cursor, start = begin, next = it.next }
  where
  begin : Wrap c -> it.Cursor
  begin (MkWrap xs) = it.start xs

firstInt : {c : Type} -> {{it : Iterate c @ { Elem = Int }}} -> c -> Int
firstInt xs = case it.next (it.start xs) of
  Just (MkPair x _) -> x
  Nothing -> 0

firstOf : {c e : Type} -> {{it : Iterate c @ { Elem = e }}} -> e -> c -> e
firstOf d xs = case it.next (it.start xs) of
  Just (MkPair x _) -> x
  Nothing -> d

nums : Wrap (List Int)
nums = MkWrap [7, 8]

numsTwice : Wrap (Wrap (List Int))
numsTwice = MkWrap nums

words : Wrap (List String)
words = MkWrap ["a"]

-- | >>> wrapped
-- | 7
wrapped : Int
wrapped = firstInt nums

-- | >>> wrappedTwice
-- | 7
wrappedTwice : Int
wrappedTwice = firstInt numsTwice

-- | >>> wrappedWord
-- | "a"
wrappedWord : String
wrappedWord = firstOf "" words

theory Into (c : Type) where
  Out : Type
  into : c -> Out

data Box = MkBox (List Int)

instance instanceIntoBox : Into Box @ { Out = List Int }
instanceIntoBox = { Out = List Int, into = open }
  where
  open : Box -> List Int
  open (MkBox xs) = xs

data Via (c : Type) = MkVia c

-- | What a value is walked through: its first element, out of what it
-- | is made of, `Src`.
theory Walk (c : Type) where
  Src : Type
  Elem : Type
  first : c -> Maybe Elem

-- (`d` is in the type only as a field: `it`'s goal, `Iterate d`, is not
-- determined until `to` is found, and waits)
instance instanceWalkVia : {c d : Type}
                         -> {{it : Iterate d}}
                         -> {{to : Into c @ { Out = d }}}
                         -> Walk (Via c) @ { Src = d }
instanceWalkVia = { Src = d, Elem = it.Elem, first = go }
  where
  go : Via c -> Maybe it.Elem
  go (MkVia x) = case it.next (it.start (to.into x)) of
    Just (MkPair y _) -> Just y
    Nothing -> Nothing

walkInt : {c : Type} -> {{w : Walk c @ { Elem = Int }}} -> c -> Int
walkInt x = case w.first x of
  Just y -> y
  Nothing -> 0

walkOf : {c e : Type} -> {{w : Walk c @ { Elem = e }}} -> e -> c -> e
walkOf d x = case w.first x of
  Just y -> y
  Nothing -> d

walkShown : {c e : Type}
          -> {{w : Walk c @ { Elem = e }}}
          -> {{sh : Debug e}}
          -> c
          -> String
walkShown x = case w.first x of
  Just y -> sh.debug y
  Nothing -> ""

boxed : Via Box
boxed = MkVia (MkBox [7, 8])

-- | >>> viaInt
-- | 7
viaInt : Int
viaInt = walkInt boxed

-- | >>> viaOf
-- | 7
viaOf : Int
viaOf = walkOf 0 boxed

-- | >>> viaShown
-- | "7"
viaShown : String
viaShown = walkShown boxed

data Loose (c : Type) = MkLoose c

-- (`d` is known only by the goal's `Src`: `it` waits for the check)
instance instanceWalkLoose : {c d : Type}
                           -> {{it : Iterate d}}
                           -> Walk (Loose c) @ { Src = d }
instanceWalkLoose = { Src = d, Elem = it.Elem, first = go }
  where
  go : Loose c -> Maybe it.Elem
  go x = Nothing

walkIntFrom : {c : Type}
            -> {{w : Walk c @ { Elem = Int, Src = List Int }}}
            -> c
            -> Int
walkIntFrom x = case w.first x of
  Just y -> y
  Nothing -> 0

walkFromInt : {c : Type}
            -> {{w : Walk c @ { Src = List Int, Elem = Int }}}
            -> c
            -> Int
walkFromInt x = case w.first x of
  Just y -> y
  Nothing -> 0

loose : Loose Int
loose = MkLoose 7

-- | >>> looseElemFirst
-- | 0
looseElemFirst : Int
looseElemFirst = walkIntFrom loose

-- | >>> looseSrcFirst
-- | 0
looseSrcFirst : Int
looseSrcFirst = walkFromInt loose

-- (`Walk`, its fields the other way round: the field through `it`
-- before the one that determines it)
theory Pick (c : Type) where
  Elem : Type
  Src : Type
  pick : c -> Maybe Elem

instance instancePickLoose : {c d : Type}
                           -> {{it : Iterate d}}
                           -> Pick (Loose c) @ { Src = d }
instancePickLoose = { Elem = it.Elem, Src = d, pick = go }
  where
  go : Loose c -> Maybe it.Elem
  go x = Nothing

pickInt : {c : Type}
        -> {{p : Pick c @ { Elem = Int, Src = List Int }}}
        -> c
        -> Int
pickInt x = case p.pick x of
  Just y -> y
  Nothing -> 0

pickOf : {c e : Type}
       -> {{p : Pick c @ { Elem = e, Src = List Int }}}
       -> e
       -> c
       -> e
pickOf d x = case p.pick x of
  Just y -> y
  Nothing -> d

-- | >>> picked
-- | 0
picked : Int
picked = pickInt loose

-- | >>> pickedOf
-- | 0
pickedOf : Int
pickedOf = pickOf 0 loose
