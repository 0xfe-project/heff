-- Count as part of the algebra: a fun-shaped (value-returning) operation
-- is Plotkin-Power's generic effect, `A -> M B` in place of a clause that
-- receives `B -> x`.  The operation adds no control of its own: its one
-- continuation is bound in the adapter, so how often the rest runs is
-- M's say alone -- once under a first-order monad, replayed by List's
-- bind, and taken back whole by a CPS-shaped M.  Nothing here forbids
-- control; it makes control show on M's type.

import co

data TickF (m : Type -> Type) x = Tick (Int -> x)

ticker : HFunctor
ticker =
  { f = TickF
  , hfmap = \m g p -> case p of
      Tick k -> Tick (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Tick k -> Tick k
  }

idEv : (h : HFunctor) -> (h <: h)
idEv h p = p

tick : {e : HFunctor} -> (ticker <: e) -> Co e Int
tick ev = op (ev (Tick (\n -> n))) val

prog : Co ticker Int
prog = do
  a <- tick (idEv ticker)
  b <- tick (idEv ticker)
  pure (a + b)

-- a raw monad alone (Handler without its algebra)
theory Monadish where
  M : Type -> Type
  ret : {a : Type} -> a -> M a
  bind : {a b : Type} -> M a -> (a -> M b) -> M b

-- | A fun-shaped handler of ticker: `tick` is a VALUE of `M Int`.  This
-- | theory cannot name the rest of the computation; how often it runs is
-- | said by `m`, and only there (a control-shaped `m` says it loudly:
-- | cpsFun below).
theory TickFun where
  m : Monadish
  tick : m.M Int

-- | The adapter: the one place the continuation appears, bound once.
funTicker : (t : TickFun) -> Handler ticker
funTicker t =
  { M = t.m.M
  , ret = \x -> t.m.ret x
  , bind = \c k -> t.m.bind c k
  , malg = \p -> case p of
      Tick k -> t.m.bind t.tick (\n -> t.m.ret (k n))
  }

test funShaped

counterFun : TickFun
counterFun =
  { m =
      { M = \a -> Int -> Pair a Int
      , ret = \x n -> MkPair x n
      , bind = \c k n -> case c n of
          MkPair x n2 -> k x n2
      }
  , tick = \n -> MkPair n (n + 1)
  }

-- >>> handle (funTicker counterFun) prog 0
-- MkPair 1 2

-- the leftover freedom is M's, not the operation's: List bind replays
listFun : TickFun
listFun =
  { m = { M = List, ret = \x -> x :: Nil, bind = \c k -> List.concatMap k c }
  , tick = 0 :: 1 :: Nil
  }

-- >>> handle (funTicker listFun) prog
-- Cons 0 (Cons 1 (Cons 1 (Cons 2 Nil)))

-- and the precise claim, witnessed: "exactly once" is relative to M.  A
-- CPS-shaped M hands `tick` a continuation again, legitimately -- the
-- very lambda the identity monad rejects -- and the rest runs twice per
-- tick, all four world-lines summed.  The rest can be taken back, but
-- only where M's type says so.
cpsFun : TickFun
cpsFun =
  { m =
      { M = \a -> (a -> Int) -> Int
      , ret = \x k -> k x
      , bind = \c f k -> c (\x -> f x k)
      }
  , tick = \k -> k 0 + k 1
  }

-- >>> handle (funTicker cpsFun) prog id
-- 4
