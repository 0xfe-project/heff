-- Count as part of the algebra: a fun-shaped (value-returning) operation
-- is Plotkin-Power's generic effect, `A -> M B` in place of a clause that
-- receives `B -> x`.  The handler never sees the continuation at all --
-- Koka's `fun` discipline, by shape, no judgment added.  What freedom is
-- left (a List monad replays the rest) is pinned to M's bind alone.

import co
import prelude

data TickF (m : Type -> Type) x = Tick (Int -> x)

ticker : HFunctor
ticker =
  { f = TickF
  , hfmap = \fm g p -> case p of
      Tick k -> Tick (\n -> g (k n))
  , hmap = \nt p -> case p of
      Tick k -> Tick k
  }

idEv : (h : HFunctor) -> (h <: h)
idEv h p = p

tick : {e : HFunctor} -> (ticker <: e) -> Co e Int
tick ev = op (ev (Tick (\n -> n))) val

prog : Co ticker Int
prog = do
  a <- tick (idEv ticker)
  b <- tick (idEv ticker)
  pure (a + b)

-- a raw monad alone (Handler without its algebra)
theory Monadish where
  M : Type -> Type
  ret : {a : Type} -> a -> M a
  bind : {a b : Type} -> M a -> (a -> M b) -> M b

-- | A fun-shaped handler of ticker: `tick` is a VALUE of `M Int`.  No
-- | continuation in sight -- this theory cannot express zero or two
-- | resumes of the rest; only `m.bind` says how answers meet the rest.
theory TickFun where
  m : Monadish
  tick : m.M Int

-- | The adapter: the one place the continuation appears, bound once.
funTicker : (t : TickFun) -> Handler ticker
funTicker t =
  { M = t.m.M
  , ret = \x -> t.m.ret x
  , bind = \c k -> t.m.bind c k
  , malg = \p -> case p of
      Tick k -> t.m.bind t.tick (\n -> t.m.ret (k n))
  }

test funShaped

counterFun : TickFun
counterFun =
  { m =
      { M = \a -> Int -> Pair a Int
      , ret = \x n -> MkPair x n
      , bind = \c k n -> case c n of
          MkPair x n2 -> k x n2
      }
  , tick = \n -> MkPair n (n + 1)
  }

-- >>> handle (funTicker counterFun) prog 0
-- MkPair 1 2

-- the leftover freedom is M's, not the operation's: List bind replays
listFun : TickFun
listFun =
  { m = { M = List, ret = \x -> x :: Nil, bind = \c k -> concatMap k c }
  , tick = 0 :: 1 :: Nil
  }

-- >>> handle (funTicker listFun) prog
-- Cons 0 (Cons 1 (Cons 1 (Cons 2 Nil)))
