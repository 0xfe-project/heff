-- A `do` block's statements (#86): `let mut` and `:=`, `while`, `for`
-- (through `Iterate`: a list, a range, a string, an array), `break`,
-- `continue`, `return`, an `if` without `else` and an `if`'s or a
-- `case`'s arms that are statements, `(<- c)` (hoisted to the start of
-- the arm it is in), `if <- c` and `case <- c of`, `p <- for ...`, a
-- closure holding a variable's value, and `run do` for pure code.  A
-- `case` on a pattern, and `let ... else`.  And (#100) `try ... catch`
-- over the `exception` effect.

module test.surface.do-statements

import array
import co
import exception
import state

-- | `while`, its variables set in the body; the loop's `if` an `else`
-- | of `continue`
-- | >>> oddSum 10
-- | 25
oddSum : Int -> Int
oddSum n = run do
  let mut i = 0
  let mut total = 0
  while i < n do
    i := i + 1
    if i % 2 == 0 then continue
    total := total + i
  return total

-- | `for` over a list: `continue`, `break` and an early `return`
-- | >>> sumEvens [1, 2, 3, 4, 2000, 6]
-- | 6
-- | >>> sumEvens [2, -1, 4]
-- | -1
sumEvens : List Int -> Int
sumEvens xs = run do
  let mut total = 0
  for x in xs do
    if x % 2 /= 0 && x > 0 then continue
    if x > 1000 then break
    if x < 0 then return x
    total := total + x
  return total

-- | `for` over a range, both ends in
-- | >>> rangeSum 1 4
-- | 10
rangeSum : Int -> Int -> Int
rangeSum a b = run do
  let mut s = 0
  for i in range a b do
    s := s + i
  return s

-- | ... over a string, rune by rune
-- | >>> vowels "heff loops"
-- | 3
vowels : String -> Int
vowels s = run do
  let mut n = 0
  for c in s do
    if c == 'e' || c == 'o' then n := n + 1
  return n

-- | ... and over an array
-- | >>> arraySum (arrayFromList [10, 20])
-- | 30
arraySum : Array Int -> Int
arraySum xs = run do
  let mut s = 0
  for x in xs do
    s := s + x
  return s

-- | loops in loops, a `case` of statements, a `do` block as an arm
-- | >>> pairs 6
-- | 54
pairs : Int -> Int
pairs n = run do
  let mut count = 0
  for i in range 1 n do
    if i == 3 then continue
    for j in range 1 n do
      if j > i then break
      case j % 3 of
        0 -> count := count + 10
        _ -> do
          count := count + 1
          if count > 1000 then return count
  return count

-- | a pattern in `for`, a variable given its type
-- | >>> unzipped [MkPair 1 "a", MkPair 2 "b"]
-- | MkPair [2, 1] "ab"
unzipped : List (Pair Int String) -> Pair (List Int) String
unzipped ps = run do
  let mut ns : List Int = Nil
  let mut s = ""
  for (MkPair n t) in ps do
    ns := Cons n ns
    s := s ^ t
  return (MkPair ns s)

-- | an `if` with an `else` of statements, each arm setting the variable,
-- | and a join point after it
-- | >>> collatz 6
-- | 8
collatz : Int -> Int
collatz n0 = run do
  let mut n = n0
  let mut steps = 0
  while n /= 1 do
    if n % 2 == 0 then n := n / 2 else n := 3 * n + 1
    steps := steps + 1
  return steps

-- | a condition that is a tag alone, `while True`, left by `break`
-- | >>> untilAbove 10
-- | 11
untilAbove : Int -> Int
untilAbove n = run do
  let mut i = 0
  while True do
    if i > n then break
    i := i + 1
  if True then i := i + 0
  return i

-- | a closure holds the variable's value where it is made
-- | >>> captured
-- | [0, 1, 2]
captured : List Int
captured = run do
  let mut i = 0
  let mut fs : List (Unit -> Int) = Nil
  while i < 3 do
    let j = i
    fs := Cons (\u -> j) fs
    i := i + 1
  return (List.reverse (List.map (\(f : Unit -> Int) -> f MkUnit) fs))

-- (a state of an `Int`)
intState : Handler (state Int)
intState =
  { M = \x -> Int -> Pair x Int
  , ret = \x st -> MkPair x st
  , bind = \m k st -> case m st of
      MkPair x st2 -> k x st2
  , malg = \p st -> case p of
      Get k -> MkPair (k st) st
      Put st2 x -> MkPair x st2
  }

-- | `(<- c)`: in the condition, each turn; in an arm, at its start (the
-- | other arm `pure`, and `&&`'s right side run only if needed)
counter : {e : HFunctor} -> {{st : state Int <: e}} -> Co e Int
counter = do
  let mut turns = 0
  while (<- get) < 5 do
    put ((<- get) + 1)
    turns := turns + 1
  let x = if turns > 3 then (<- get) * 100 else 0
  b <- pure (turns > 100 && (<- get) > 0)
  return (x + (if b then 1 else 0))

-- | >>> counted
-- | MkPair 500 5
counted : Pair Int Int
counted = handle intState (counter (st := _)) 0

-- | a `while` last: the block's value is `MkUnit`
countdown : {e : HFunctor} -> {{st : state Int <: e}} -> Co e Unit
countdown = do
  put 10
  while (<- get) > 0 do
    n <- get
    put (n - 1)

-- | >>> counteddown
-- | MkPair MkUnit 0
counteddown : Pair Unit Int
counteddown = handle intState (countdown (st := _)) 7

-- | `p <- for ...`: each turn's value gathered, in order; a turn left by
-- | `continue` gives none, and `break` ends the gathering
-- | >>> gatheredOdds 20
-- | [10, 30, 50, 70]
gatheredOdds : Int -> List Int
gatheredOdds n = run do
  odds <- for x in range 1 n do
    if x % 2 == 0 then continue
    if x > 7 then break
    x * 10
  odds

-- | ... and the turns' actions run in order, the block's variables set
-- | as they go
-- | >>> handle intState (numbered (st := _)) 5
-- | MkPair [6, 7, 8] 8
numbered : {e : HFunctor} -> {{st : state Int <: e}} -> Co e (List Int)
numbered = do
  let mut turns = 0
  xs <- for _ in range 1 3 do
    turns := turns + 1
    put ((<- get) + 1)
    get
  pure xs

-- | `if <- c` and `case <- c of`: what `if` tests and `case` matches, the
-- | value of an action, as `(<- c)`; an `else` under its `if`
-- | >>> handle intState (sorted (st := _)) 3
-- | MkPair 30 4
sorted : {e : HFunctor} -> {{st : state Int <: e}} -> Co e Int
sorted = do
  let mut n = 0
  if <- isSmall
  then n := 10
  else n := 20
  put 4
  case <- smallOr of
    Just k -> return (n + k)
    Nothing -> return n
  where
  isSmall : Co e Bool
  isSmall = do
    v <- get
    pure (v < 4)
  smallOr : Co e (Maybe Int)
  smallOr = do
    v <- get
    pure (if v > 3 then Just 20 else Nothing)

-- A pattern: `case`, `let ... else`
--------------------------------------------------------------------------------

-- | `let ... else`, its variables bound in the statements after it, its
-- | `else` the loop's next turn
-- | >>> firstPositive [Nothing, Just (-1), Just 3, Just 4]
-- | 3
firstPositive : List (Maybe Int) -> Int
firstPositive ms = run do
  for m in ms do
    let Just x = m else continue
    if x > 0 then return x
  return 0

-- | a `case` of statements, each arm setting the block's variable
-- | >>> justs [Just 1, Nothing, Just 5, Nothing]
-- | MkPair 6 2
justs : List (Maybe Int) -> Pair Int Int
justs ms = run do
  let mut total = 0
  let mut missing = 0
  for m in ms do
    case m of
      Just x -> total := total + x
      Nothing -> missing := missing + 1
  return (MkPair total missing)

-- `try`, `catch`
--------------------------------------------------------------------------------

-- (a world that throws a `String` and keeps a log; a throw keeps what was
-- logged before it)
world : HFunctor
world = exception String <+> state (List String)

-- (the log, its latest first, and the answer or what no `catch` heard)
data Logged = Thrown String (List String) | Done Int (List String)

logged : Handler world
logged =
  { M = \a -> List String -> Pair (Either String a) (List String)
  , ret = \x l -> MkPair (Right x) l
  , bind = \m k l -> case m l of
      MkPair (Left s) l2 -> MkPair (Left s) l2
      MkPair (Right x) l2 -> k x l2
  , malg = \p l -> case p of
      InL t -> case t of
        Throw s -> MkPair (Left s) l
        Catch c h -> case c l of
          MkPair (Left s) l2 -> h s l2
          MkPair (Right x) l2 -> MkPair (Right x) l2
      InR t -> case t of
        Get k -> MkPair (Right (k l)) l
        Put l2 x -> MkPair (Right x) l2
  }

runLogged : Co world Int -> Logged
runLogged c = case handle logged c Nil of
  MkPair (Left s) l -> Thrown s l
  MkPair (Right x) l -> Done x l

note : {e : HFunctor}
     -> {{st : state (List String) <: e}}
     -> String
     -> Co e Unit
note s = do
  l <- get
  put (Cons s l : List String)

onEx : exception String <: world
onEx = inl (exception String) (state (List String))

onLog : state (List String) <: world
onLog = inr (exception String) (state (List String))

-- | a throw caught, the `catch` arm setting the block's variable (which
-- | it sees as it was where the `try` began: what the throw abandoned is
-- | gone)
-- | >>> runLogged (caught (ex := onEx) (st := onLog))
-- | Done 11 ["caught boom", "tried"]
caught : {e : HFunctor}
       -> {{ex : exception String <: e}}
       -> {{st : state (List String) <: e}}
       -> Co e Int
caught = do
  let mut n = 1
  try
    n := 2
    note "tried"
    (throw "boom" : Co e Unit)
  catch (msg : String) ->
    note ("caught " ^ msg)
    n := n + 10
  return n

-- | the `try` the block's last statement (its value the block's), and a
-- | throw its `catch` arm throws on
-- | >>> runLogged (fine (ex := onEx) (st := onLog) False)
-- | Done 7 []
-- | >>> runLogged (fine (ex := onEx) (st := onLog) True)
-- | Thrown "out" ["passing out"]
fine : {e : HFunctor}
     -> {{ex : exception String <: e}}
     -> {{st : state (List String) <: e}}
     -> Bool
     -> Co e Int
fine b = do
  try
    if b then (throw "out" : Co e Unit)
    pure 7
  catch (s : String) ->
    note ("passing " ^ s)
    throw s

-- | a `catch` arm's binder, its type found from its use
-- | >>> runLogged (heard (ex := onEx) (st := onLog))
-- | Done 3 ["heard no"]
heard : {e : HFunctor}
      -> {{ex : exception String <: e}}
      -> {{st : state (List String) <: e}}
      -> Co e Int
heard = do
  let mut n = 0
  try
    n := 1
    (throw "no" : Co e Unit)
  catch e ->
    note ("heard " ^ e)
    n := 3
  return n

-- | `continue` and `break` crossing a `try`, a throw heard on a turn
-- | between
-- | >>> runLogged (loops (ex := onEx) (st := onLog))
-- | Done 8 ["four"]
loops : {e : HFunctor}
      -> {{ex : exception String <: e}}
      -> {{st : state (List String) <: e}}
      -> Co e Int
loops = do
  let mut i = 0
  let mut total = 0
  while i < 10 do
    i := i + 1
    try
      if i == 3 then continue
      if i == 6 then break
      if i == 4 then (throw "four" : Co e Unit)
      total := total + i
    catch (s : String) ->
      note s
  return total

-- | `return` crossing two
-- | >>> runLogged (nested (ex := onEx) (st := onLog))
-- | Done 5 []
nested : {e : HFunctor}
       -> {{ex : exception String <: e}}
       -> {{st : state (List String) <: e}}
       -> Co e Int
nested = do
  try
    try
      return 5
    catch (s : String) ->
      note "inner"
  catch (s : String) ->
    note "outer"
  return 0

-- | the `catch` in a loop, `continue` from it
-- | >>> runLogged (retried (ex := onEx) (st := onLog))
-- | Done 2 ["retry 1"]
retried : {e : HFunctor}
        -> {{ex : exception String <: e}}
        -> {{st : state (List String) <: e}}
        -> Co e Int
retried = do
  let mut i = 0
  let mut ok = 0
  while i < 3 do
    i := i + 1
    try
      if i == 1 then (throw "again" : Co e Unit)
      ok := ok + 1
    catch (s : String) ->
      note ("retry " ^ show i)
      continue
  return ok
