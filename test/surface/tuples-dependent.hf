-- Tuples by what is expected of them: where a universe is, the types
-- `Unit` and `Pair A B`; anywhere else, the values -- so a type may hold
-- a pair as an index, and a term a tuple type, as an explicit type
-- argument or what a function gives.  Inferring, a tuple is a value,
-- unless its first part is a type.

module test.surface.tuples-dependent

-- | a type indexed by a pair: the index a value in a type
Indexed : (Int, Int) -> Type
Indexed p = Int

-- | >>> atOrigin
-- | 0
atOrigin : Indexed (0, 0)
atOrigin = 0

-- | >>> at 1 2 5
-- | 8
at : (x : Int) -> (y : Int) -> Indexed (x, y) -> Int
at x y n = x + y + n

-- | a function giving a type: a tuple where a type is expected
PairOf : Type -> Type
PairOf a = (a, a)

-- | >>> twice
-- | MkPair 1 1
twice : PairOf Int
twice = (1, 1)

-- | an explicit type argument a tuple type
firstOf : {a : Type} -> List a -> Maybe a
firstOf Nil = Nothing
firstOf (Cons x _) = Just x

-- | >>> first
-- | Just (MkPair 1 "x")
first : Maybe (Int, String)
first = firstOf (a := (Int, String)) [(1, "x")]

-- | inferring (an argument at a type not known): a value, or the type
-- | where its first part is a type
-- | >>> inferredValue
-- | 2
inferredValue : Int
inferredValue = case id (1, "x") of
  (n, s) -> n + strLength s

-- | three parts inferring: `((1, "x"), 2)`, the pair before the last a
-- | value too
-- | >>> inferredThree
-- | 4
inferredThree : Int
inferredThree = case id (1, "x", 2) of
  (n, s, m) -> n + m + strLength s

Named : Type
Named = id (String, Int)

-- | the type `((String, Int), Bool)`, its first part a type
NamedThree : Type
NamedThree = id (String, Int, Bool)

-- | >>> namedThree
-- | MkPair (MkPair "x" 1) True
namedThree : NamedThree
namedThree = ("x", 1, True)

-- | >>> named
-- | MkPair "x" 1
named : Named
named = ("x", 1)

-- | a tuple type as an argument where a type is not said: at a kind
-- | to be found, or through `id` at a type to be found
Tagged : {k : Type} -> k -> Type
Tagged x = Int

-- | >>> tagged
-- | 3
tagged : Tagged ((String, Int), Bool)
tagged = 3

-- | >>> List.length nestedNamed
-- | 1
nestedNamed : List (id ((String, Int), Bool))
nestedNamed = [(("x", 1), True)]

-- | a type found by inferring, in a signature: `id`'s implicit argument
-- | solved to `Type` before the type is read
-- | >>> secondOf ("x", 3)
-- | 3
secondOf : id (String, Int) -> Int
secondOf (_, n) = n

Text : Type
Text = String

-- | >>> lengthOf "abc"
-- | 3
lengthOf : id Text -> Int
lengthOf s = strLength s

units : List ()
units = [(), ()]

lazyPair : ~(Int, Int)
lazyPair = ~(1, 2)
