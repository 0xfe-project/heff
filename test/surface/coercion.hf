-- Coercions: where an expression of one type is given and another is
-- expected, and the two do not unify, heff puts in `coe`, by the one
-- instance of the prelude's `Coe from to` in scope -- a binder's or a
-- declared one -- once, never two in a row.

module test.surface.coercion

import co

data Name = MkName String

instance instanceCoeStringName : Coe String Name
instanceCoeStringName = { coe = MkName }

nameText : Name -> String
nameText (MkName s) = s

instance instanceShowName : Show Name
instanceShowName = { show = \n -> "MkName " ^ show (nameText n) }

greet : Name -> String
greet n = "hi " ^ nameText n

-- | a string literal where a `Name` is expected
-- | >>> literal
-- | "hi ann"
literal : String
literal = greet "ann"

-- | a variable, and the result of a call
-- | >>> variable
-- | "hi bo hi cy"
variable : String
variable = greet who ^ " " ^ greet (strSlice "xcy" 1 3)
  where
  who : String
  who = "bo"

-- | where a definition's type says `Name`
-- | >>> show given
-- | "MkName \"dee\""
given : Name
given = "dee"

-- | inside a lambda, and a list's elements, each its own
-- | >>> inside
-- | ["hi a", "hi b"]
inside : List String
inside = List.map (\s -> greet s) ["a", "b"]

-- | >>> elements
-- | ["a", "b"]
elements : List String
elements = List.map nameText (["a", "b"] : List Name)

-- | in a `do`, the statement's value
-- | >>> inDo
-- | "hi eve"
inDo : String
inDo = run do
  let s = "eve"
  return (greet s)

-- | an instance argument in scope is one too
-- | >>> byBinder (c := { coe = \n -> MkName (show n) })
-- | "hi 42"
byBinder : {{c : Coe Int Name}} -> String
byBinder = greet answer
  where
  answer : Int
  answer = 42

-- | `coe` itself, named
-- | >>> show (coe "fay" : Name)
-- | "MkName \"fay\""
named : Name
named = coe "fay"
