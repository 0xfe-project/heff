-- An API sent over the wire with no network: a client
-- of it, `Remote.locally`, its server's real handler answering each
-- frame in the same program -- and what a client hears where the
-- server is of another build, or where no answer comes.

module test.surface.remote

import bytes as Bytes
import co
import exception
import remote as Remote
import state
import wire as Wire

-- The API: notes, added and counted
data NotesF (m : Type -> Type) x
  = Add String (Int -> x)
  | Count (Int -> x)
  | Titles (List String -> x)

notes : HFunctor
notes =
  { f = NotesF
  , hfmap = \m g p -> case p of
      Add t k -> Add t (\n -> g (k n))
      Count k -> Count (\n -> g (k n))
      Titles k -> Titles (\ts -> g (k ts))
  , hmap = \m n nt p -> case p of
      Add t k -> Add t k
      Count k -> Count k
      Titles k -> Titles k
  }

add : {e : HFunctor} -> {{ev : notes <: e}} -> String -> Co e Int
add t = op (ev (Add t (\n -> n))) val

count : {e : HFunctor} -> {{ev : notes <: e}} -> Co e Int
count = op (ev (Count (\n -> n))) val

titles : {e : HFunctor} -> {{ev : notes <: e}} -> Co e (List String)
titles = op (ev (Titles (\ts -> ts))) val

addOp : Remote.Operation String Int
addOp = Remote.operation 0 "add"

countOp : Remote.Operation Unit Int
countOp = Remote.operation 1 "count"

titlesOp : Remote.Operation Unit (List String)
titlesOp = Remote.operation 2 "titles"

called : {m : Type -> Type} -> {x : Type} -> NotesF m x -> Remote.Call x
called (Add t k) = Remote.call addOp t k
called (Count k) = Remote.call countOp MkUnit k
called (Titles k) = Remote.call titlesOp MkUnit k

served : {m : Type -> Type} -> List (Remote.Served (NotesF m Bytes))
served =
  [ Remote.serve addOp (\t k -> Add t k)
  , Remote.serve countOp (\u k -> Count k)
  , Remote.serve titlesOp (\u k -> Titles k)
  ]

notesApi : Remote.Api notes
notesApi = Remote.api notes "notes" called served

-- (another build of it: `count` answering a list)
otherApi : Remote.Api notes
otherApi =
  Remote.api
    notes
    "notes"
    called
    [ Remote.serve addOp (\t k -> Add t k)
    , Remote.serve
      (Remote.operation 1 "count" : Remote.Operation Unit (List Int))
      (\u k -> Titles (\ts -> k (List.map strLength ts)))
    , Remote.serve titlesOp (\u k -> Titles k)
    ]

-- The server's real handler: the notes in a state
notesKept : {e : HFunctor}
          -> {{st : state (List String) <: e}}
          -> Co e (List String)
notesKept = get

kept : {e : HFunctor}
     -> {{st : state (List String) <: e}}
     -> {a : Type}
     -> NotesF (Co e) a
     -> Co e a
kept (Add t k) = do
  ns <- notesKept
  put (List.append ns [t])
  pure (k (List.length ns + 1))
kept (Count k) = bind notesKept (\ns -> pure (k (List.length ns)))
kept (Titles k) = bind notesKept (\ns -> pure (k ns))

-- The client's program
program : {e : HFunctor} -> {{ev : notes <: e}} -> Co e String
program = do
  a <- add "milk"
  b <- add "bread"
  n <- count
  ts <- titles
  pure (show a ^ " " ^ show b ^ " " ^ show n ^ " " ^ joinWith "," ts)

-- The worlds: the client's, and what is under it
under : HFunctor
under = exception Remote.RemoteError <+> state (List String)

-- (the notes kept, as a function of them)
stateHandler : Handler (state (List String))
stateHandler =
  { M = \x -> List String -> Pair x (List String)
  , ret = \x st -> MkPair x st
  , bind = \m k st -> case m st of
      MkPair x st2 -> k x st2
  , malg = \p st -> case p of
      Get k -> MkPair (k st) st
      Put st2 x -> MkPair x st2
  }

-- (a state handled, from the empty one)
stated : {a : Type} -> Co (state (List String)) a -> Pair a (List String)
stated c = handle stateHandler c Nil

said : Either Remote.RemoteError String -> String
said (Left err) = Remote.showRemoteError err
said (Right s) = s

-- (the program, its calls through `transport`, its failures heard)
outcome : Remote.Transport under -> Pair String (List String)
outcome transport =
  let ran =
    Remote.remotely
      notes
      under
      (failed := _)
      notesApi
      transport
      (program (ev := \p -> InL p))
  in stated
    (bind
       (attempt Remote.RemoteError ran)
       (\r -> pure (said r)))

-- (a server of this build, or of another)
serverOf : Remote.Api notes -> Remote.Transport under
serverOf server = Remote.loopback server (kept (st := \p -> InR p))

-- (a transport no answer comes by)
cut : Remote.Transport under
cut = { exchange = \frame -> pure (Left (Unreachable "no connection")) }

-- | each call written, answered by the server's handler, and read back
-- >>> fst (outcome (serverOf notesApi))
-- "1 2 2 milk,bread"
-- >>> snd (outcome (serverOf notesApi))
-- ["milk", "bread"]

-- | `locally`, the same
-- >>> fst (stated (bind (attempt Remote.RemoteError (Remote.locally notes under (failed := _) notesApi (kept (st := \p -> InR p)) (program (ev := \p -> InL p)))) (\r -> pure (said r))))
-- "1 2 2 milk,bread"

-- | a server of another build: the first call refused, nothing done
-- >>> outcome (serverOf otherApi)
-- MkPair "mismatched: the server's API is notes #2c98640b, the call's #b8270bad" []

-- | no answer: thrown, and heard
-- >>> fst (outcome cut)
-- "unreachable: no connection"

-- | the fingerprints differ, by the type of one operation
-- >>> notesApi.fingerprint == otherApi.fingerprint
-- False
-- >>> Remote.signatures notesApi
-- ["0 add : String -> Int", "1 count : Unit -> Int", "2 titles : Unit -> List String"]

-- | a call's frame, answered
-- >>> fst (stated (Remote.respond notesApi (kept (e := state (List String)) (st := \p -> p)) (Remote.frame Asked notesApi.fingerprint 0 (Wire.encode "x"))))
-- b["hw", 1, 1, 184, "'", 11, 173, 0, 0, 0, 0, 0, 1, 2]

-- | ... and what is no call of it
-- >>> List.map (\(b : Bytes) -> Remote.saidIn (Bytes.slice (fst (stated (Remote.respond notesApi (kept (e := state (List String)) (st := \p -> p)) b))) 14 200)) [b["nonsense"], Remote.frame Asked notesApi.fingerprint 9 b[], Remote.frame Asked notesApi.fingerprint 0 b[200]]
-- ["no frame of the wire", "no operation 9 in notes #b8270bad", "the argument of operation 0 not read"]
