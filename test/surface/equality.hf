-- The prelude's `Eq`: a function asks for a type's equality, and where
-- it is used the instance of that type in scope is given -- `Int`'s and
-- `Float64`'s side by side, and a fixed-width type's from its module,
-- imported by a name.

import int8 as I8

data Tree a = Leaf | Node a (Tree a) (Tree a)

singleton : {a : Type} -> a -> Tree a
singleton x = Node x Leaf Leaf

-- | >>> member 2 $ Node 1 (singleton 2) Leaf
-- | True
-- | >>> member 3 $ Node 1 (singleton 2) Leaf
-- | False
-- | >>> member 2.5 $ Node 0.5 Leaf (singleton 2.5)
-- | True
-- | >>> member "b" $ singleton "a"
-- | False
member : {a : Type} -> {{eq : Eq a}} -> a -> Tree a -> Bool
member x Leaf = False
member x (Node y left right) = equal x y || member x left || member x right

-- | >>> small
-- | True
small : Bool
small = member (I8.fromInt 5) (singleton (I8.fromInt 5))

-- (given by name, as any instance argument may be)
-- | >>> member (eq := eqInt) 1 Leaf
-- | False
