import prelude

theory Show a where
  show : a -> String

instance showInt' : Show Int
showInt' = { show = \n -> showInt n }

shown : {a : Type} -> [s : Show a] -> a -> String
shown s x = s.show x

-- >>> shown 42
-- "42"

-- the binder form: a witness entered into scope by `[s : Show a]`
shownTwice : {a : Type} -> [s : Show a] -> a -> String
shownTwice s x = shown x ++ shown x

-- >>> shownTwice 7
-- "77"
