-- Instance arguments, as Agda has them: `{{x : T}}` is an implicit
-- argument found among the instance binders in scope -- never among
-- global declarations.  Where it is used, it is given: `(x := e)`.
import prelude

theory Show a where
  show : a -> String

-- (`s` is not written in the equation: it is in scope, by its name)
shown : {a : Type} -> {{s : Show a}} -> a -> String
shown x = s.show x

-- the inner `shown` finds `s`: it is an instance binder in scope here
shownTwice : {a : Type} -> {{s : Show a}} -> a -> String
shownTwice x = shown x ++ shown x

showInt' : Show Int
showInt' = { show = \n -> showInt n }

-- >>> shown (s := showInt') 42
-- "42"

-- >>> shownTwice (s := showInt') 7
-- "77"
