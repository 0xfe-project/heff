-- Instance arguments, as Agda has them: `{{x : T}}` is an implicit
-- argument found among the instances in scope -- here the instance
-- binders, none declared (top-instances.hf declares some).  Where it is
-- used, it is given: `(x := e)`.

module test.surface.instance

theory Debug a where
  debug : a -> String

-- (`s` is not written in the equation: it is in scope, by its name)
shown : {a : Type} -> {{s : Debug a}} -> a -> String
shown x = s.debug x

-- the inner `shown` finds `s`: it is an instance binder in scope here
shownTwice : {a : Type} -> {{s : Debug a}} -> a -> String
shownTwice x = shown x ^ shown x

-- | >>> shown (s := showInt') 42
-- | "42"
-- | >>> shownTwice (s := showInt') 7
-- | "77"
showInt' : Debug Int
showInt' = { debug = \n -> show n }
