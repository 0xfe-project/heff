-- `\(x :: T) -> e`: the binder annotated, so the body synthesises and
-- the lambda says an argument type nothing else has said yet -- the
-- record's shape is in hand where `\r -> r.a` would be too late.

import co
import test.surface.fresh

type R = { a : Int, b : Int }

-- | >>> List.map (\(r : R) -> r.a) [mk 1, mk 2]
-- | Cons 1 (Cons 2 Nil)
-- | >>> List.map (\(r : R) -> r.a + r.b) [mk 3]
-- | Cons 9 Nil
mk : Int -> R
mk n = { a = n, b = n * 2 }

-- >>> (\(n : Int) -> n + 1) 41
-- 42

-- a definition that is such a lambda: the implicit arguments of its body
-- inferred where the definition itself is in scope, as the global it will
-- be (and not yet is)
-- | >>> firstOf (mk 5)
-- | Just 5
firstOf : R -> Maybe Int
firstOf = \(r : R) -> Just r.a

-- | >>> countdown 3
-- | Cons 3 (Cons 2 (Cons 1 Nil))
countdown : Int -> List Int
countdown = \(n : Int) -> if n == 0 then Nil else Cons n (countdown (n - 1))

-- such a lambda whose body synthesises a computation: its type has an
-- implicit argument in it, read back applied to the definition itself
-- | >>> (named (pureR (mk 4))).b
-- | 8
pureR : R -> Co fresh R
pureR = \(r : R) -> pure r

-- checked where the argument type expected is not known yet: the binder
-- is what its annotation says
-- | >>> firsts [mk 6] (\(r : R) -> Cons r.b Nil)
-- | Cons 12 Nil
firsts : {a b : Type} -> List a -> (a -> List b) -> List b
firsts xs g = case xs of
  Nil -> Nil
  Cons y ys -> g y
