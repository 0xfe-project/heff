-- lists
data Bool = True | False
data List a = Nil | Cons a (List a)

not : Bool -> Bool
not True = False
not False = True

map : {a b : Type} -> (a -> b) -> List a -> List b
map f Nil = Nil
map f (Cons y ys) = Cons (f y) (map f ys)

twice : (b : Bool) -> Bool
twice b = not (not b)

theory Monoid where
  t : Type
  m : t -> t -> t

orM : Monoid ~ { t = Bool }
orM =
  { t = Bool
  , m = \x y -> case x of
      True -> True
      False -> y
  }

blah : (r : Monoid) -> (x : r.t) -> r.t
blah r x = r.m x x

foreign import intAdd : Int -> Int -> Int

len : {a : Type} -> List a -> Int
len xs = case xs of
  Nil -> 0
  Cons _ ys -> intAdd 1 (len ys)

neg : Int
neg = intAdd -3 (len (Cons "x" Nil))

pick : Bool -> Int
pick b = if b then 1 else 2

idInt : Int -> Int
idInt = \x -> x

test not/spec
-- >>> not True
-- False

-- capitalised type parameters: binders in the signature, variables in the
-- equations' patterns
mapT : (A : Type) -> (B : Type) -> (f : A -> B) -> (xs : List A) -> List B
mapT A B f Nil = Nil
mapT A B f (Cons y ys) = Cons (f y) (mapT A B f ys)

idT : {A : Type} -> A -> A
idT x = x
