-- A theory specialized, `Th @ { t = Bool }`: its instances whose `t` is
-- `Bool`.  An instance of `Th` is one if its `t` is.

module test.surface.specialize

data Bool = True | False

theory Th where
  t : Type
  pick : t -> Bool

inst : Th
inst = { t = Bool, pick = \x -> x }

spec : Th @ { t = Bool }
spec = inst

-- (so `spec.t` is `Bool`)
-- | >>> spec.pick yes
-- | True
yes : spec.t
yes = True

-- Two fields fixed, in one specialisation or one after the other.
theory Both where
  a : Type
  b : Type
  first : a
  second : b

both : Both @ { a = Bool, b = Bool }
both = { a = Bool, b = Bool, first = True, second = False }

both2 : Both @ { a = Bool } @ { b = Bool }
both2 = both

-- | >>> both.second
-- | False
second : both.b
second = both.second

-- A theory's parameter named, an argument, and its field specialised.
theory Tagged (k : Type) where
  t : Type
  tag : k -> t

tagged : Tagged (k := Bool) @ { t = Bool }
tagged = { t = Bool, tag = \x -> x }

-- (the parameter given as it is)
tagged2 : Tagged Bool @ { t = Bool }
tagged2 = tagged

-- | >>> tagged.tag True
-- | True
tagT : tagged.t
tagT = tagged.tag True
