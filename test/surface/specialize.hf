-- A theory specialized, `Th (t := Bool)`: its instances whose `t` is
-- `Bool`.  An instance of `Th` is one if its `t` is.

module test.surface.specialize

data Bool = True | False

theory Th where
  t : Type
  pick : t -> Bool

inst : Th
inst = { t = Bool, pick = \x -> x }

spec : Th (t := Bool)
spec = inst

-- (so `spec.t` is `Bool`)
-- | >>> spec.pick yes
-- | True
yes : spec.t
yes = True

-- Two fields fixed, one after the other.
theory Both where
  a : Type
  b : Type
  first : a
  second : b

both : Both (a := Bool) (b := Bool)
both = { a = Bool, b = Bool, first = True, second = False }

-- | >>> both.second
-- | False
second : both.b
second = both.second

-- A theory's parameter and its field, each named: the parameter is an
-- argument, the field a specialisation.
theory Tagged (k : Type) where
  t : Type
  tag : k -> t

tagged : Tagged (k := Bool) (t := Bool)
tagged = { t = Bool, tag = \x -> x }

-- (the parameter given as it is, the field by its name)
tagged2 : Tagged Bool (t := Bool)
tagged2 = tagged

-- | >>> tagged.tag True
-- | True
tagT : tagged.t
tagT = tagged.tag True
