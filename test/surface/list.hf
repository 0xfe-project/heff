-- The operations of lists, by the name `List` without an import: `List`
-- is the type still, and an import of `list` by another name is that
-- name's.

import list as L

-- | >>> squares
-- | Cons 1 (Cons 4 (Cons 9 (Cons 16 Nil)))
-- | >>> List.foldl (\a b -> a + b) 0 squares
-- | 30
-- | >>> L.length squares
-- | 4
squares : List Int
squares = List.map (\x -> x * x) (List.range 1 4)
