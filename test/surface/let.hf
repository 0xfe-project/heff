-- `let p = e in e'`: `e` computed once, where it is written, and bound in
-- `e'` -- under a condition too, which a value computed before it would
-- not be.  `p` is a name, or a pattern every value matches; `e` says its
-- type, or is given one (`let p : T = e`).  In a `do` block, `let p = e`
-- binds in the statements after it.

-- | >>> digitAt "a1" 1
-- | True
-- | >>> digitAt "a1" 0
-- | False
-- | >>> digitAt "a1" 5
-- | False
digitAt : String -> Int -> Bool
digitAt s i = i < strLength s && (let c = charCode s i in 48 <= c && c <= 57)

-- | >>> swap (MkPair 1 2)
-- | MkPair 2 1
swap : Pair Int Int -> Pair Int Int
swap p = let MkPair a b = p in MkPair b a

-- | >>> annotated
-- | Cons 0 (Cons 1 (Cons 2 Nil))
annotated : List Int
annotated = let xs : List Int = [1, 2] in 0 :: xs

-- | >>> nested
-- | 12
nested : Int
nested = let a = 1 in let b = a + 1 in a * 10 + b

-- | >>> shadowed 3
-- | 8
shadowed : Int -> Int
shadowed x = let x = x + 1 in x * 2

bind : {a b : Type} -> Maybe a -> (a -> Maybe b) -> Maybe b
bind Nothing k = Nothing
bind (Just x) k = k x

-- | >>> stmts 4
-- | Just 54
stmts : Int -> Maybe Int
stmts n = do
  x <- Just n
  let y = x + 1
  let MkPair a b : Pair Int Int = MkPair y x
  Just (a * 10 + b)
