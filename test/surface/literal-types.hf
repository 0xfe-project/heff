-- A number literal's type is found from how it is used: it waits for
-- the type, which unification solves, and is of it.  An integer literal
-- may be of any number type, a fractional one of a float type.  What
-- nothing decides is an `Int` or a `Float` when the definition settles: a
-- `Float` where an integer literal shares its type with a fractional one.

import int32 as I32
import uint8 as U8

-- (`5` is `id`'s argument, of the type `id` is wanted at)
-- | >>> I32.show five
-- | "5"
five : Int32
five = id 5

-- (through a polymorphic function, then used as a `UInt8`: 200 + 100
-- wraps around to 44)
-- | >>> U8.show wrapped
-- | "44"
wrapped : UInt8
wrapped = U8.add (fst (MkPair 200 "two hundred")) 100

-- (bound by a `let`, and used as an `Int32`: a `let` does not generalise,
-- the literal has the one type)
-- | >>> I32.show bound
-- | "42"
bound : Int32
bound = let n = 40 in I32.add n 2

-- (an integer literal of a float type)
-- | >>> float
-- | 5.0
float : Float
float = 5

-- | >>> floats
-- | Cons 1.0 (Cons 2.5 (Cons (-3.0) Nil))
floats : List Float32
floats = [1, 2.5, -3]

-- (an instance argument waits for the literal's type, and is found at
-- `Int` once it settles there)
theory Shown a where
  shown : a -> String

shownBy : {a : Type} -> {{s : Shown a}} -> a -> String
shownBy x = s.shown x

shownInt : Shown Int
shownInt = { shown = \n -> "int " ^ showInt n }

-- | >>> viaInstance (s := shownInt)
-- | "int 42"
viaInstance : {{s : Shown Int}} -> String
viaInstance = shownBy 42

-- nothing decides these: an `Int`, a `Float`, and a `Float` for both
-- >>> id 5
-- 5

-- >>> id 2.5
-- 2.5

-- >>> List.head [1, 2.5]
-- Just 1.0

-- >>> List.head [1, 2]
-- Just 1
