-- A string's escapes are a rune literal's: `\n` `\t` `\r`, `\u{...}` a
-- code point in hexadecimal -- its UTF-8 bytes, as the string is bytes
-- -- and `\` before any other character that character (`\u` not before
-- `{`, digits and `}` among them); and its own, `\xff`, a byte of two
-- hexadecimal digits, any byte (`\x` not before two an `x`).

module test.surface.string-escapes

import rune as Rune

-- | >>> letters
-- | "Abé"
letters : String
letters = "\u{41}\u{62}\u{e9}"

-- | >>> List.map Rune.toInt (runes grin)
-- | [128512]
-- | >>> strLength grin
-- | 4
-- | >>> List.map (byteAt grin) [0, 1, 2, 3, 4]
-- | [240, 159, 152, 128, -1]
grin : String
grin = "\u{1F600}"

-- (as a rune literal says it)
-- | >>> sameAsRunes
-- | True
sameAsRunes : Bool
sameAsRunes = strEq (ofRunes ['\u{41}', 'b', 'é', '\u{1F600}']) (letters ^ grin)

-- (no digits, or no `}`: `\u` is a `u`)
-- | >>> plainU
-- | "uu{}u{41"
plainU : String
plainU = "\u\u{}\u{41"

-- >>> strEq "\u{10FFFF}\u{0}" (ofRunes [Rune.maxRune, Rune.fromInt 0])
-- True

-- >>> "tab\tquote\"back\\slash\u{5c}"
-- "tab\tquote\"back\\slash\\"

-- (a byte: of a rune's, the rune's bytes; of none, shown as written)
-- | >>> List.map strLength bytes
-- | [2, 1, 2, 2]
-- | >>> List.map (\s -> byteAt s 0) bytes
-- | [195, 255, 65, 120]
-- | >>> bytes
-- | ["é", "\xff", "Ag", "x4"]
bytes : List String
bytes = ["\xc3\xA9", "\xff", "\x41g", "\x4"]

-- >>> strEq "\xe2\x80\xa6" "\u{2026}"
-- True

-- >>> List.map Rune.toInt (runes "a\xe2\x80b\xf5")
-- [97, 65533, 98, 65533]

-- >>> "\xe2\x80" ^ "\xa6" ^ "\xa6"
-- "…\xa6"
