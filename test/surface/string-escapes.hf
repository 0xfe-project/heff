-- A string's escapes are a rune literal's: `\n` `\t` `\r`, `\u{...}` a
-- code point in hexadecimal -- beyond U+FFFF a surrogate pair, as the
-- string is UTF-16 -- and `\` before any other character that character
-- (`\u` not before `{`, digits and `}` among them).

import rune as R

-- | >>> letters
-- | "Abé"
letters : String
letters = "\u{41}\u{62}\u{e9}"

-- | >>> List.map R.toInt (runes grin)
-- | [128512]
-- | >>> strLength grin
-- | 2
-- | >>> List.map (charCode grin) [0, 1, 2]
-- | [55357, 56832, -1]
grin : String
grin = "\u{1F600}"

-- (as a rune literal says it)
-- | >>> sameAsRunes
-- | True
sameAsRunes : Bool
sameAsRunes = strEq (ofRunes ['\u{41}', 'b', 'é', '\u{1F600}']) (letters ^ grin)

-- (no digits, or no `}`: `\u` is a `u`)
-- | >>> plainU
-- | "uu{}u{41"
plainU : String
plainU = "\u\u{}\u{41"

-- >>> strEq "\u{10FFFF}\u{0}" (ofRunes [R.maxRune, R.fromInt 0])
-- True

-- >>> "tab\tquote\"back\\slash\u{5c}"
-- "tab\tquote\"back\\slash\\"
