-- A name in backticks is applied as an operator: `` a `f` b `` is
-- `f a b`, whatever the name is -- a variable, a local, a tag, a
-- definition of a module imported under an alias.  Its fixity is
-- declared as an operator's; with none, it goes with no operator but the
-- loosest, `$`.

module test.surface.backticks

infixl `plus` above + below *

infixr `lifted` below ++

plus : Int -> Int -> Int
plus a b = a + b

lifted : List Int -> List Int -> List Int
lifted xs ys = List.append (List.map (\x -> x + 1) xs) ys

-- | >>> seven
-- | 7
seven : Int
seven = 1 `plus` 2 * 3

-- | >>> nine
-- | 9
nine : Int
nine = 1 + 2 `plus` 3 * 4 - 6

-- | >>> appended
-- | [1, 2, 3]
appended : List Int
appended = [1] `List.append` [2, 3]

-- | >>> consed
-- | [1, 2, 3]
consed : List Int
consed = 1 `Cons` (2 `Cons` [3])

-- | >>> loose
-- | [2, 3, 4, 4]
loose : List Int
loose = [1] `lifted` [2] ++ [3] `lifted` [4]

-- | >>> dollar
-- | 2
dollar : Int
dollar = id $ 1 `max` 2

-- | >>> applied
-- | 21
applied : Int
applied = max 1 2 `max` id 21

-- | >>> firstOf [4, 5]
-- | 4
firstOf : List Int -> Int
firstOf (x `Cons` _) = x
firstOf [] = 0

-- | >>> local (\a b -> a * 10 + b)
-- | 12
local : (Int -> Int -> Int) -> Int
local f = 1 `f` 2

-- | >>> parenthesised
-- | 9
parenthesised : Int
parenthesised = (1 `max` 2) + (3 `min` 7) * (4 `max` 0) - 5
