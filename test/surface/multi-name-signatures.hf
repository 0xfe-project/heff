-- A signature may name more than one definition, `f, g : T`: each has
-- the type, as if each had its own signature, and its own equations
-- after it, the names in any order.  So may a `where`'s and a `mutual`
-- block's signatures, a record type's fields and a theory's.  The doc
-- comment above it is each name's.

module test.surface.multi-name-signatures

-- | One and two, each a number.
-- | >>> one + two
-- | 3
one, two : Int
two = 2
one = 1

double, triple : Int -> Int
double n = n * 2
triple n = n * 3

-- >>> double (triple 2)
-- 12

-- (local signatures)
total : Int
total = x + y
  where
    x, y : Int
    x = 1
    y = 2

-- >>> total
-- 3

mutual
  isEven, isOdd : Int -> Bool
  isEven n = if n == 0 then True else isOdd (n - 1)
  isOdd n = if n == 0 then False else isEven (n - 1)

-- >>> (isEven 10, isOdd 7)
-- (True, True)

-- (operators, and a name implicit arguments are given to)
(+++), (***) : Int -> Int -> Int
(+++) a b = a + b
(***) a b = a * b

pick, drop : {a : Type} -> a -> a -> a
pick x y = x
drop x y = y

-- >>> ((+++) 3 4, (***) 3 4, pick 1 2, drop 1 2)
-- (7, 12, 1, 2)

type Point = { x, y : Int, label : String }

origin : Point
origin = { x = 0, y = 5, label = "o" }

-- >>> (origin.x, origin.y)
-- (0, 5)

theory Step a where
  up, down : a -> a

instance stepInt : Step Int
stepInt = { up = \n -> n + 1, down = \n -> n - 1 }

stepUp, stepDown : {a : Type} -> {{s : Step a}} -> a -> a
stepUp = s.up
stepDown = s.down

-- >>> (stepUp 1, stepDown 1)
-- (2, 0)
