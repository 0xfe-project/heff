-- `(C :: T)` annotates a constructor; `(A :: T) -> B` binds `A`, by the
-- `->` after it.

module test.surface.annotations

unit : Unit
unit = (MkUnit : Unit)

nothing : Maybe Int
nothing = (Nothing : Maybe Int)

-- | >>> idType Int 3
-- | 3
idType : (A : Type) -> A -> A
idType A x = x

-- >>> (Nothing : Maybe Bool)
-- Nothing
-- >>> (True : Bool)
-- True
