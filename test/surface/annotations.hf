-- `(C :: T)` annotates a constructor; `(A :: T) -> B` binds `A`, by the
-- `->` after it.

import prelude

unit : Unit
unit = (MkUnit : Unit)

nothing : Maybe Int
nothing = (Nothing : Maybe Int)

idType : (A : Type) -> A -> A
idType A x = x

-- >>> (Nothing :: Maybe Bool)
-- Nothing
-- >>> idType Int 3
-- 3
-- >>> (True :: Bool)
-- True
