-- A record type's fields may have defaults, `x : A = d`: a record
-- checked against the type may leave them out, and is given them.

greeting : String
greeting = "hello"

-- | a default names definitions (`greeting`), tags, literals, lambdas
type Opts =
  { name : String
  , verbose : Bool = False
  , tags : List String = []
  , says : String = greeting
  , step : Int -> Int = \n -> n + 1
  }

-- (only the field without a default)
-- | >>> bare.verbose
-- | False
-- | >>> bare.tags
-- | Nil
-- | >>> bare.says
-- | "hello"
-- | >>> bare.step 41
-- | 42
bare : Opts
bare = { name = "bare" }

-- (some given, in order, the others left out)
-- | >>> some.tags
-- | Cons "a" (Cons "b" Nil)
-- | >>> some.verbose
-- | False
some : Opts
some = { name = "some", tags = ["a", "b"] }

-- (every field given, the defaulted ones too)
-- | >>> full.verbose
-- | True
-- | >>> full.says
-- | "hi"
-- | >>> full.step 21
-- | 42
full : Opts
full =
  { name = "full", verbose = True, tags = [], says = "hi", step = \n -> n * 2 }

-- (made in an expression, not a definition's body)
-- | >>> (named "n").verbose
-- | True
-- | >>> (named "n").says
-- | "hello"
named : String -> Opts
named n = { name = n, verbose = True }

-- | a parameterised type's default
type Stack a = { top : a, below : List a = [] }

-- | >>> single.below
-- | Nil
single : Stack Int
single = { top = 1 }

-- | a theory's fields have defaults too: a type among them
theory Counter where
  T : Type = Int
  start : T
  name : String = "counter"

-- | >>> ints.name
-- | "counter"
ints : Counter
ints = { start = 0 }

-- (`ints.T` is the default, `Int`, where it is checked)
-- | >>> next
-- | 1
next : ints.T
next = ints.start + 1

-- | >>> strings.start
-- | ""
strings : Counter
strings = { T = String, start = "", name = "strings" }

-- | a default names the fields before it: a record that leaves it out is
-- | given it of the record's own, each of them computed once
type Range =
  { lo : Int
  , hi : Int = lo
  , width : Int = hi - lo
  , shift : Int -> Int = \n -> n + lo
  }

-- | >>> point.hi
-- | 3
-- | >>> point.width
-- | 0
-- | >>> point.shift 10
-- | 13
point : Range
point = { lo = 3 }

-- | >>> (span 4).width
-- | 4
-- | >>> (span 4).shift 1
-- | 5
span : Int -> Range
span n = { lo = n, hi = n * 2 }

-- | a theory's: the fields before it, its type among them
theory Seed where
  T : Type
  first : T
  again : T = first
  both : T -> List T = \t -> [first, t]

-- | >>> seeds.both 1
-- | Cons 7 (Cons 1 Nil)
seeds : Seed
seeds = { T = Int, first = 7 }

-- (`seeds.T` is `Int`, where it is checked)
-- | >>> later
-- | 8
later : seeds.T
later = seeds.again + 1

-- (a type written in place, not named by a default given)
-- | >>> tags.again
-- | One
tags : Seed
tags = { T = data { One | Two }, first = One, both = \t -> [t] }
