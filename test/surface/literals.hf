-- Literal patterns: an equation for a number, a string or a float, matched
-- by the equality in scope; one of the equations must match every other
-- value.

import prelude

name : Int -> String
name 0 = "zero"
name 1 = "one"
name n = "many"

answer : String -> Int -> Int
answer "yes" 0 = 1
answer "yes" n = n
answer _ n = 0 - n

fib : Int -> Int
fib 0 = 0
fib 1 = 1
fib n = fib (n - 1) + fib (n - 2)

half : Float -> String
half 0.5 = "half"
half x = "not"

digits : List Int -> String
digits Nil = ""
digits (Cons 0 rest) = "o" ++ digits rest
digits (Cons n rest) = "x" ++ digits rest

-- >>> name 0
-- "zero"
-- >>> name 1
-- "one"
-- >>> name 7
-- "many"
-- >>> answer "yes" 0
-- 1
-- >>> answer "yes" 5
-- 5
-- >>> answer "no" 5
-- -5
-- >>> fib 10
-- 55
-- >>> half 0.5
-- "half"
-- >>> half 0.25
-- "not"
-- >>> digits (Cons 0 (Cons 3 (Cons 0 Nil)))
-- "oxo"
