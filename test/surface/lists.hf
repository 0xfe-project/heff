-- List literals: `[a, b]` is `Cons a (Cons b Nil)` and `[]` is `Nil`, as
-- expressions and as patterns.

import prelude

small :: List Int
small = [1, 2, 3]

describe :: List Int -> String
describe [] = "empty"
describe [x] = "one: " ++ showInt x
describe [x, y] = "two"
describe (Cons x rest) = "many"

nested :: List (List Bool)
nested = [[True], [], [False, True]]

-- >>> small
-- Cons 1 (Cons 2 (Cons 3 Nil))
-- >>> map describe [[], [7], [1, 2], small]
-- Cons "empty" (Cons "one: 7" (Cons "two" (Cons "many" Nil)))
-- >>> length nested
-- 3
-- >>> ([] :: List Int)
-- Nil
