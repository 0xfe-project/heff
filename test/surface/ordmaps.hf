-- Maps and sets, by the keys' order.

module test.surface.ordmaps

import std.ordmap as OrdMap
import std.set as Set

-- | >>> OrdMap.toList ages
-- | Cons (MkPair "al" 27) (Cons (MkPair "bo" 31) (Cons (MkPair "cy" 40) Nil))
-- | >>> OrdMap.lookup ages "bo"
-- | Just 31
-- | >>> OrdMap.lookup ages "di"
-- | Nothing
-- | >>> OrdMap.keys (OrdMap.insert ages "al" 28)
-- | Cons "al" (Cons "bo" (Cons "cy" Nil))
-- | >>> OrdMap.values (OrdMap.insert ages "al" 28)
-- | Cons 28 (Cons 31 (Cons 40 Nil))
-- | >>> OrdMap.size (OrdMap.delete ages "bo")
-- | 2
ages : OrdMap.OrdMap String Int
ages = OrdMap.fromList [MkPair "bo" 31, MkPair "al" 27, MkPair "cy" 40]

-- | >>> OrdMap.size many
-- | 100
-- | >>> OrdMap.valid many
-- | True
many : OrdMap.OrdMap Int Int
many =
  OrdMap.fromList
    (List.map (\i -> MkPair ((i * 37) % 101) i) (List.range 1 100))

-- | >>> OrdMap.size fewer
-- | 40
-- | >>> OrdMap.valid fewer
-- | True
-- | >>> List.take 3 (OrdMap.keys fewer)
-- | Cons 61 (Cons 62 (Cons 63 Nil))
fewer : OrdMap.OrdMap Int Int
fewer = List.foldl (\m k -> OrdMap.delete m k) many (List.range 0 60)

-- >>> Set.toList (Set.fromList [3, 1, 2, 3, 1])
-- Cons 1 (Cons 2 (Cons 3 Nil))
-- >>> Set.member (Set.fromList [1, 2]) 2
-- True
-- >>> Set.size (Set.union (Set.fromList [1, 2]) (Set.fromList [2, 3]))
-- 3
