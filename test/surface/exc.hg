-- Exceptions, with a higher-order operation (catch), handled by a raw monad
-- (Maybe)

import co

data Bool = True | False
data Maybe a = Nothing | Just a

foreign import intEq :: Int -> Int -> Bool
foreign import intDiv :: Int -> Int -> Int

data ExcF (m :: Type -> Type) a = Throw | Catch (m a) (m a)

exc :: HFunctor
exc = { f = ExcF, hmap = \nt p -> case p of
    Throw -> Throw
    Catch x y -> Catch (nt x) (nt y) }

throw :: {a :: Type} -> Co exc a
throw = op Throw val

catch :: {a :: Type} -> Co exc a -> Co exc a -> Co exc a
catch p q = op (Catch p q) val

safeDiv :: Int -> Int -> Co exc Int
safeDiv x y = if intEq y 0 then throw else pure (intDiv x y)

twoDivs :: Int -> Co exc Int
twoDivs n = do
  a <- safeDiv 100 n
  b <- safeDiv a 2
  pure b

maybeH :: Handler exc
maybeH = { M = Maybe, ret = \x -> Just x, bind = \m k -> case m of
    Nothing -> Nothing
    Just x -> k x, malg = \p -> case p of
    Throw -> Nothing
    Catch x y -> case x of
      Nothing -> y
      Just v -> Just v }

test exc/spec
-- >>> handle maybeH (safeDiv 7 2)
-- Just 3
-- >>> handle maybeH (safeDiv 7 0)
-- Nothing
-- >>> handle maybeH (catch (safeDiv 7 0) (pure 42))
-- Just 42
-- >>> handle maybeH (twoDivs 5)
-- Just 10
-- >>> handle maybeH (twoDivs 0)
-- Nothing
