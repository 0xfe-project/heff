-- The same implicit, met under two different patterns, depends only on
-- what the two agree on (pattern intersection) -- never "would have to
-- contain itself".  So the `fmap` of hfmap's functor may be a lambda in
-- place; it need not be given as a named definition.

module test.surface.meet

import co

data TellF (m : Type -> Type) x = Tell String x

teller : HFunctor
teller =
  { f = TellF
  , hfmap = \m g p -> case p of
      Tell s x -> Tell s (g x)
  , hmap = \m n nt p -> case p of
      Tell s x -> Tell s x
  }

bump : (h : HFunctor)
     -> {a b : Type}
     -> (a -> b)
     -> h.f (Co h) a
     -> h.f (Co h) b
bump h g p =
  h.hfmap
    { f = \a -> Co h a, fmap = \g2 c -> bind c (\x -> val (g2 x)) }
    g
    p

render : TellF (Co teller) String -> String
render (Tell s x) = s ^ x

test intersection

-- >>> render (bump teller show (Tell "m" 3))
-- "m3"
