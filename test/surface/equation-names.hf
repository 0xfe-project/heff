-- The equations of a definition may name an argument differently: each
-- name means the argument wherever its equation's body sees it, in a
-- local definition (`where`) too, and nowhere it is bound again.  A
-- field's name and a named argument's are not the argument's.

-- | >>> local (Just 1) 5
-- | 10
-- | >>> local Nothing 5
-- | 5
local : Maybe Int -> Int -> Int
local (Just x) n = twice
  where
    twice : Int
    twice = n + n
local Nothing m = m

-- | >>> shadowed (Just 1) 5
-- | 11
shadowed : Maybe Int -> Int -> Int
shadowed (Just x) n = let n = 10 in n + 1
shadowed Nothing m = m

type Box = { n : Int }

-- | >>> (boxed (Just 1) 5).n
-- | 5
boxed : Maybe Int -> Int -> Box
boxed (Just x) n = { n = n }
boxed Nothing m = { n = m }

scale : (n : Int) -> Int -> Int
scale n x = n * x

-- | >>> named (Just 1) 5
-- | 10
named : Maybe Int -> Int -> Int
named (Just x) n = scale (n := n) 2
named Nothing m = m
