-- Arrays (lib/array.hf), imported as `A`: made, read, and made again.

import array as A
import prelude

squares :: Array Int
squares = A.generate 5 (\i -> i * i)

-- >>> squares
-- [0, 1, 4, 9, 16]
-- >>> A.length squares
-- 5
-- >>> A.index squares 3
-- 9
-- >>> A.at squares 7
-- Nothing
-- >>> A.index squares 7
-- <abandoned>
-- >>> A.set squares 0 100
-- [100, 1, 4, 9, 16]
-- >>> squares
-- [0, 1, 4, 9, 16]
-- >>> A.foldl (\acc x -> acc + x) 0 squares
-- 30
-- >>> A.toList (A.map showInt (A.fromList (Cons 1 (Cons 2 Nil))))
-- Cons "1" (Cons "2" Nil)
-- >>> A.length (A.empty :: Array Int)
-- 0
