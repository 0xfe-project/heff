-- Tuples checked at a known `Pair A B`: each part checked at its own
-- type, so a part that needs its type to elaborate (a record, a lambda
-- without annotations, a tag) needs no annotation of its own.

module test.surface.tuples-checked

type R = { a : Int, b : Int }

-- | a record as a part
-- | >>> (fst withRecord).b
-- | 2
withRecord : (R, List Int)
withRecord = ({ a = 1, b = 2 }, [3])

-- | a lambda, its argument's type the pair's
-- | >>> fst withLambda 4
-- | 5
withLambda : (Int -> Int, Bool)
withLambda = (\x -> x + 1, True)

-- | a bare tag
-- | >>> withTag
-- | MkPair Nothing 1
withTag : (Maybe Int, Int)
withTag = (Nothing, 1)

-- | `(a, b, c)` is `((a, b), c)`: its front checked as a pair too
-- | >>> (fst (fst nested)).a + snd (fst nested) 10
-- | 11
nested : (R, Int -> Int, Maybe Int)
nested = ({ a = 1, b = 2 }, \x -> x, Nothing)

-- | a pair inside the second part
-- | >>> (fst (snd inner)).b
-- | 2
inner : (Int, (R, Int -> Int))
inner = (1, ({ a = 1, b = 2 }, \x -> x))

-- | a type naming a pair
type Named = (R, Int -> Int)

-- | >>> snd named 3
-- | 6
named : Named
named = ({ a = 0, b = 0 }, \x -> x * 2)

-- | the parts at a function's result
-- | >>> fst (made 7)
-- | { a = 7, b = 7 }
made : Int -> (R, List Int)
made n = ({ a = n, b = n }, [n])
