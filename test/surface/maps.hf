-- Maps and sets (lib/map.hf, lib/set.hf), by the keys' order.

import map as M
import set as S

-- | >>> M.toList ages
-- | Cons (MkPair "al" 27) (Cons (MkPair "bo" 31) (Cons (MkPair "cy" 40) Nil))
-- | >>> M.lookup compareString "bo" ages
-- | Just 31
-- | >>> M.lookup compareString "di" ages
-- | Nothing
-- | >>> M.keys (M.insert compareString "al" 28 ages)
-- | Cons "al" (Cons "bo" (Cons "cy" Nil))
-- | >>> M.values (M.insert compareString "al" 28 ages)
-- | Cons 28 (Cons 31 (Cons 40 Nil))
-- | >>> M.size (M.delete compareString "bo" ages)
-- | 2
ages : M.Map String Int
ages = M.fromList compareString [MkPair "bo" 31, MkPair "al" 27, MkPair "cy" 40]

-- | >>> M.size many
-- | 100
-- | >>> M.valid compareInt many
-- | True
many : M.Map Int Int
many =
  M.fromList compareInt (List.map (\i -> MkPair ((i * 37) % 101) i) (List.range 1 100))

-- | >>> M.size fewer
-- | 40
-- | >>> M.valid compareInt fewer
-- | True
-- | >>> List.take 3 (M.keys fewer)
-- | Cons 61 (Cons 62 (Cons 63 Nil))
fewer : M.Map Int Int
fewer = List.foldl (\m k -> M.delete compareInt k m) many (List.range 0 60)

-- >>> S.toList (S.fromList compareInt [3, 1, 2, 3, 1])
-- Cons 1 (Cons 2 (Cons 3 Nil))
-- >>> S.member compareInt 2 (S.fromList compareInt [1, 2])
-- True
-- >>> S.size (S.union compareInt (S.fromList compareInt [1, 2]) (S.fromList compareInt [2, 3]))
-- 3
