-- Maps and sets, by the keys' order.

import std.map as Map
import std.set as Set

-- | >>> Map.toList ages
-- | Cons (MkPair "al" 27) (Cons (MkPair "bo" 31) (Cons (MkPair "cy" 40) Nil))
-- | >>> Map.lookup ages "bo"
-- | Just 31
-- | >>> Map.lookup ages "di"
-- | Nothing
-- | >>> Map.keys (Map.insert ages "al" 28)
-- | Cons "al" (Cons "bo" (Cons "cy" Nil))
-- | >>> Map.values (Map.insert ages "al" 28)
-- | Cons 28 (Cons 31 (Cons 40 Nil))
-- | >>> Map.size (Map.delete ages "bo")
-- | 2
ages : Map.Map String Int
ages = Map.fromList [MkPair "bo" 31, MkPair "al" 27, MkPair "cy" 40]

-- | >>> Map.size many
-- | 100
-- | >>> Map.valid many
-- | True
many : Map.Map Int Int
many =
  Map.fromList (List.map (\i -> MkPair ((i * 37) % 101) i) (List.range 1 100))

-- | >>> Map.size fewer
-- | 40
-- | >>> Map.valid fewer
-- | True
-- | >>> List.take 3 (Map.keys fewer)
-- | Cons 61 (Cons 62 (Cons 63 Nil))
fewer : Map.Map Int Int
fewer = List.foldl (\m k -> Map.delete m k) many (List.range 0 60)

-- >>> Set.toList (Set.fromList [3, 1, 2, 3, 1])
-- Cons 1 (Cons 2 (Cons 3 Nil))
-- >>> Set.member (Set.fromList [1, 2]) 2
-- True
-- >>> Set.size (Set.union (Set.fromList [1, 2]) (Set.fromList [2, 3]))
-- 3
