-- A `with` of bindings is co's `holding` (`holdingWhere` with `once`),
-- whatever the module names so: its own `holding` and `holdingWhere`,
-- and a local named so, are not the `with`'s.

module test.surface.with-own-holding

import boc as BOC
import co

holding : Int
holding = 3

holdingWhere : Int -> Int
holdingWhere n = n + 1

counted : Co BOC.boc Unit
counted = do
  c <- BOC.newCown 0
  with n := c do
    n := n + holding
  with n := c once n > 0 do
    n := holdingWhere n

-- (a local of that name too)
local : Int -> Co BOC.boc Unit
local holding = do
  c <- BOC.newCown holding
  with n := c do
    n := n + holding
