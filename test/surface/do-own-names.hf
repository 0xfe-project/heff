-- A `do` block's `for` and `try` are the library's names, by their
-- keys, whatever the module names so: the prelude's `iterateOf` and
-- `leaveScope`, the exception module's `recover`, builtin's `Unit`.
-- The module's own of those names, and locals named so, are not the
-- block's.

module test.surface.do-own-names

import builtin as Builtin
import co
import exception

leaveScope : Int
leaveScope = 1

iterateOf : Int -> Int
iterateOf n = n + 1

recover : String
recover = "own"

data Unit = Tt

-- (a world that throws a `String`)
failing : Handler (exception String)
failing =
  { M = \a -> Either String a
  , ret = \x -> Right x
  , bind = \m k -> case m of
      Left s -> Left s
      Right x -> k x
  , malg = \p -> case p of
      Throw s -> Left s
      Catch c h -> case c of
        Left s -> h s
        Right x -> Right x
  }

-- | `for` and `try` beside the module's own names
-- | >>> handle failing (tried [1, 2, 3])
-- | Right 10
-- | >>> handle failing (tried [1, -2, 3])
-- | Right 100
tried : List Int -> Co (exception String) Int
tried xs = do
  let mut total = leaveScope
  try
    for x in xs do
      if x < 0 then (throw recover : Co (exception String) Builtin.Unit)
      total := total + iterateOf x
  catch (why : String) ->
    total := 100
  return total

-- | no variable set: what follows a scope takes builtin's `Unit`
-- | >>> handle failing (plain [1, 2])
-- | Left "two"
-- | >>> handle failing (plain [1])
-- | Right 0
plain : List Int -> Co (exception String) Int
plain xs = do
  try
    for x in xs do
      if x == 2 then (throw "two" : Co (exception String) Builtin.Unit)
  catch (s : String) ->
    (throw s : Co (exception String) Builtin.Unit)
  pure 0

-- | locals of those names
-- | >>> handle failing (local 5 2 "no" [1, 2])
-- | Right 11
-- | >>> handle failing (local 5 2 "no" [1, -2])
-- | Right 6
local : Int -> Int -> String -> List Int -> Co (exception String) Int
local leaveScope iterateOf recover xs = do
  let mut total = leaveScope
  try
    for x in xs do
      if x < 0 then (throw recover : Co (exception String) Builtin.Unit)
      total := total + x * iterateOf
  catch (why : String) ->
    total := total + 1
  return total
