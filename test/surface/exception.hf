-- The classic question asked of catch: when the caught
-- computation changed the world before it threw, does the world keep the
-- change?  The framework does not say.  Two handlers of
-- `exception String <+> state Int`, one line apart, say it each way.

import co
import exception
import state

world : HFunctor
world = exception String <+> state Int

-- the programs ask for the evidence of the worlds they use ...
bumpAndFailW : {e : HFunctor}
             -> {{ex : exception String <: e}}
             -> {{st : state Int <: e}}
             -> Co e Int
bumpAndFailW =
  -- bump the counter, then fail; the catch hears it and reads the counter
  catch
    (do
     put 1
     throw "boom")
    ((\s -> get) : String -> Co e Int)

quietW : {e : HFunctor}
       -> {{ex : exception String <: e}}
       -> {{st : state Int <: e}}
       -> Co e Int
quietW =
  -- no throw: catch is invisible
  catch
    (do
     put 7
     get)
    ((\s -> pure 0) : String -> Co e Int)

loudW : {e : HFunctor}
      -> {{ex : exception String <: e}}
      -> {{st : state Int <: e}}
      -> Co e Int
loudW = do
  -- a throw nobody catches
  put 5
  throw "unheard"

-- ... and here the world gives it
onException : (exception String <: world)
onException = inl (exception String) (state Int)

onSt : (state Int <: world)
onSt = inr (exception String) (state Int)

bumpAndFail : Co world Int
bumpAndFail = bumpAndFailW (ex := onException) (st := onSt)

quiet : Co world Int
quiet = quietW (ex := onException) (st := onSt)

loud : Co world Int
loud = loudW (ex := onException) (st := onSt)

data Res a = Failed String Int | Done a Int

render : Res Int -> String
render (Failed s n) = "failed " ^ s ^ " @" ^ show n
render (Done x n) = show x ^ " @" ^ show n

-- the two handlers: one monad, Int -> Res a, and the same algebra but for
-- the one line of Catch -- which world the recovery starts from

rolledBack : Handler world
rolledBack =
  { M = \a -> Int -> Res a
  , ret = \x n -> Done x n
  , bind = \m k n -> case m n of
      Failed s n2 -> Failed s n2
      Done x n2 -> k x n2
  , malg = \p n -> case p of
      InL t -> case t of
        Throw s -> Failed s n
        Catch c h -> case c n of
          Failed s n2 -> h s n
          Done x n2 -> Done x n2
      InR t -> case t of
        Get k -> Done (k n) n
        Put st x -> Done x st
  }

kept : Handler world
kept =
  { M = \a -> Int -> Res a
  , ret = \x n -> Done x n
  , bind = \m k n -> case m n of
      Failed s n2 -> Failed s n2
      Done x n2 -> k x n2
  , malg = \p n -> case p of
      InL t -> case t of
        Throw s -> Failed s n
        Catch c h -> case c n of
          Failed s n2 -> h s n2
          Done x n2 -> Done x n2
      InR t -> case t of
        Get k -> Done (k n) n
        Put st x -> Done x st
  }

test catch/state

-- the put inside the failed try is undone ...
-- >>> render (handle rolledBack bumpAndFail 0)
-- "0 @0"

-- ... or it happened and stays: the handler's word, not the framework's
-- >>> render (handle kept bumpAndFail 0)
-- "1 @1"

-- >>> render (handle rolledBack quiet 0)
-- "7 @7"

-- >>> render (handle kept loud 0)
-- "failed unheard @5"
