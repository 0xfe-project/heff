-- A file as a value: a theory names what it has, a struct is the module,
-- and later fields use earlier ones through the module's own name -- the
-- self is let-bound to the global it will be, so `mod1.size` inside
-- `twice` and the capture's `mod1.tok` are one thing.

import prelude

theory MOD where
  tok :: Type
  mk :: Int -> tok
  size :: tok -> Int
  twice :: tok -> Int
  lexed :: Type
  lex :: String -> lexed
  toks :: lexed -> List tok

mod1 :: MOD
mod1 =
  { tok = { k :: Int, n :: Int }
  , mk = \i -> { k = i, n = i + i }
  , size = \t -> t.k + t.n
  , twice = \t -> mod1.size t + mod1.size t
  , lexed = data { 'lexed (List mod1.tok) }
  , lex = \s -> 'lexed [mod1.mk (strLength s)]
  , toks = \l -> case l of
      'lexed ts -> ts
  }

-- >>> mod1.size (mod1.mk 3)
-- 9

-- >>> mod1.twice (mod1.mk 2)
-- 12

-- >>> map (\(t :: mod1.tok) -> t.k) (mod1.toks (mod1.lex "abcd"))
-- Cons 4 Nil

-- >>> (mod1.mk 5).n
-- 10
