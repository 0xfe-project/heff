-- A program's own tags of the short names the prelude's theories are not
-- named by (`Addition`, `Subtraction`, `Multiplication`, `Division`):
-- made in expressions, matched by patterns, beside the operators they
-- stand for.

data Op = Add | Sub | Mul | Div

data Expr = Lit Int | Apply Op Expr Expr

-- | >>> List.map symbol [Add, Sub, Mul, Div]
-- | Cons "+" (Cons "-" (Cons "*" (Cons "/" Nil)))
symbol : Op -> String
symbol op = case op of
  Add -> "+"
  Sub -> "-"
  Mul -> "*"
  Div -> "/"

-- | >>> evaluate (Apply Add (Lit 1) (Apply Mul (Lit 2) (Apply Div (Lit 7) (Apply Sub (Lit 5) (Lit 3)))))
-- | 7
evaluate : Expr -> Int
evaluate (Lit n) = n
evaluate (Apply Add a b) = evaluate a + evaluate b
evaluate (Apply Sub a b) = evaluate a - evaluate b
evaluate (Apply Mul a b) = evaluate a * evaluate b
evaluate (Apply Div a b) = evaluate a / evaluate b

-- | >>> shown (Apply Sub (Lit 9) (Apply Div (Lit 8) (Lit 0)))
-- | "(9 - (8 / 0)) = 9"
shown : Expr -> String
shown e = written e ^ " = " ^ show (evaluate e)
  where
    written : Expr -> String
    written (Lit n) = show n
    written (Apply op a b) =
      "(" ^ written a ^ " " ^ symbol op ^ " " ^ written b ^ ")"
