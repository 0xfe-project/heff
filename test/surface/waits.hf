-- What once failed too early now waits its turn: a match whose
-- scrutinee's type is an implicit still unsolved waits for the type
-- (the cases are delayed on it), and an annotated binder whose body can
-- only be checked is checked -- an annotation never breaks what worked
-- without it.

import co
import prelude

data FlipF (m : Type -> Type) x = Flip (Bool -> x)

flipE : HFunctor
flipE =
  { f = FlipF
  , hfmap = \fm g p -> case p of
      Flip k -> Flip (\b -> g (k b))
  , hmap = \nt p -> case p of
      Flip k -> Flip k
  }

here : (flipE <: flipE)
here p = p

-- the op inline in the do, under an abstract effect: the answer's type
-- arrives only once the whole bind meets the signature, and the `if`
-- waits for it
draw : {e : HFunctor} -> (flipE <: e) -> Co e Int
draw ev = do
  c <- op (ev (Flip (\b -> b))) val
  if c then pure 1 else pure 0

alwaysTrue : Handler flipE
alwaysTrue =
  { M = \a -> a
  , ret = \x -> x
  , bind = \m k -> k m
  , malg = \p -> case p of
      Flip k -> k True
  }

-- a plain lambda taking a pair apart, its type an unsolved implicit when
-- the case is met
logsOf : {a : Type} -> List (Pair a (List String)) -> List String
logsOf m =
  concatMap
    (\pr -> case pr of
     MkPair x lg -> lg)
    m

-- the same, the binder annotated: the annotation need only agree
logsOfAnn : {a : Type} -> List (Pair a (List String)) -> List String
logsOfAnn m =
  concatMap
    (\(pr : Pair a (List String)) -> case pr of
     MkPair x lg -> lg)
    m

test waits

-- >>> handle alwaysTrue (draw here)
-- 1

-- >>> logsOf [MkPair 1 ["a"], MkPair 2 ["b"]]
-- Cons "a" (Cons "b" Nil)

-- >>> logsOfAnn [MkPair 1 ["a"], MkPair 2 ["b"]]
-- Cons "a" (Cons "b" Nil)

-- a tag's payload at an answer type still unsolved also waits (E0314,
-- once): no annotation on MkUnit
data PingF (m : Type -> Type) x = Ping x

pingE : HFunctor
pingE =
  { f = PingF
  , hfmap = \fm g p -> case p of
      Ping x -> Ping (g x)
  , hmap = \nt p -> case p of
      Ping x -> Ping x
  }

ping : {e : HFunctor} -> (pingE <: e) -> Co e Unit
ping ev = op (ev (Ping MkUnit)) val
