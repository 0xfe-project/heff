-- An implicit argument may have a default, `{x : A := d} -> B`: where it
-- is not given, `(x := e)`, it is `d` -- given as it is, not inferred.

-- | of a small type, too: it is never inferred
-- | >>> greet "a"
-- | "a"
-- | >>> greet (loud := True) "a"
-- | "a!"
greet : {loud : Bool := False} -> String -> String
greet name = if loud then name ^ "!" else name

-- | a type
-- | >>> same 3
-- | 3
-- | >>> same (a := String) "s"
-- | "s"
same : {a : Type := Int} -> a -> a
same x = x

-- | a record, a definition named
type Opts = { verbose : Bool }

quietly : Opts
quietly = { verbose = False }

-- | >>> run 1
-- | False
-- | >>> run (opts := { verbose = True }) 1
-- | True
run : {opts : Opts := quietly} -> Int -> Bool
run n = opts.verbose

-- | grouped, each its default
-- | >>> first 1 2
-- | 1
first : {a b : Type := Int} -> a -> b -> a
first x y = x

-- | the default given first, then an instance argument found for it
theory Show a where
  show : a -> String

shown : {a : Type := Int} -> {{s : Show a}} -> a -> String
shown x = s.show x

shownHere : {{s : Show Int}} -> String
shownHere = shown 3

-- | >>> shownHere (s := showInt')
-- | "3"
showInt' : Show Int
showInt' = { show = \n -> showInt n }

-- | in a theory's field: the lambda checked at it binds it
theory Step where
  step : {by : Int := 1} -> Int -> Int

-- | >>> steps.step 1
-- | 2
-- | >>> steps.step (by := 5) 1
-- | 6
steps : Step
steps = { step = \n -> n + by }
