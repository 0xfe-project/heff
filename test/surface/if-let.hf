-- `if let p = e then a else b`: `a` where `e` matches `p`, `p`'s names
-- bound in `a` alone; `b` where it does not.  The pattern may fail; one
-- that cannot is let be, its `else` never taken.  `else if let` goes on
-- the chain; in a `do` block an `if let` may have no `else`.

module test.surface.if-let

import co

-- | >>> lastOr [1, 2, 3]
-- | 3
-- | >>> lastOr []
-- | 0
lastOr : List Int -> Int
lastOr xs =
  if let Just m = List.last xs
  then m
  else 0

-- | >>> pick Nothing (Just 2)
-- | 2
-- | >>> pick (Just 1) (Just 2)
-- | 1
-- | >>> pick Nothing Nothing
-- | 0
pick : Maybe Int -> Maybe Int -> Int
pick a b =
  if let Just x = a then x
  else if let Just y = b then y
  else 0

-- | the names of `p`, the `then` branch's alone: `x` in `else` is the
-- | argument
-- | >>> shadowed 5 (Just 1)
-- | 1
-- | >>> shadowed 5 Nothing
-- | 5
shadowed : Int -> Maybe Int -> Int
shadowed x m = if let Just x = m then x else x

-- | a pattern with an annotation, and nested
-- | >>> firstTwo [1, 2, 3]
-- | 3
-- | >>> firstTwo [1]
-- | 0
firstTwo : List Int -> Int
firstTwo xs = if let Cons a (Cons b _) : List Int = xs then a + b else 0

-- | a pattern that cannot fail, its `else` never taken
-- | >>> whole (1, 2)
-- | 3
whole : (Int, Int) -> Int
whole p = if let (a, b) = p then a + b else 0

-- | a statement, with no `else`, and with one
-- | >>> summed [Just 1, Nothing, Just 3]
-- | 4
summed : List (Maybe Int) -> Int
summed ms = run do
  let mut total = 0
  for m in ms do
    if let Just x = m then total := total + x
  return total

-- | >>> found [Nothing, Just 7, Just 8]
-- | 7
-- | >>> found []
-- | 0
found : List (Maybe Int) -> Int
found ms = run do
  for m in ms do
    if let Just x = m then return x
    else continue
  return 0
