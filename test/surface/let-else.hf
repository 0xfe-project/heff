-- `let p = e else s` in a `do` block: where `e` matches `p`, the
-- statements after it, `p`'s variables bound; where it does not, `s`,
-- which leaves: `return`, `break`, `continue`, `abandon`, or an `if` or
-- `case` whose every arm does (a throw, `return (<- throw e)`).  The
-- pattern may fail, as nowhere else a pattern binds; one that cannot is
-- let be.

module test.surface.let-else

import co
import exception

ran : Handler (exception String)
ran =
  { M = \a -> Either String a
  , ret = \x -> Right x
  , bind = \m k -> case m of
      Left s -> Left s
      Right x -> k x
  , malg = \p -> case p of
      Throw s -> Left s
      Catch c h -> case c of
        Left s -> h s
        Right x -> Right x
  }

runIt : {a : Type} -> Co (exception String) a -> Either String a
runIt c = handle ran c

-- | >>> runIt (early (Just 4))
-- | Right 5
-- | >>> runIt (early Nothing)
-- | Right 0
early : Maybe Int -> Co (exception String) Int
early m = do
  let Just x = m else return 0
  pure (x + 1)

-- | >>> runIt (thrown (Just 4))
-- | Right 4
-- | >>> runIt (thrown Nothing)
-- | Left "none"
thrown : Maybe Int -> Co (exception String) Int
thrown m = do
  let Just x = m else return (<- throw (ev := _) "none")
  pure x

-- | >>> runIt (summed [Just 1, Nothing, Just 3, Nothing, Just 100])
-- | Right 4
summed : List (Maybe Int) -> Co (exception String) Int
summed ms = do
  let mut total = 0
  for m in ms do
    let Just x = m else
      if total > 3 then break
      continue
    total := total + x
  return total

-- | >>> runIt (pairs (Just 1, 2))
-- | Right 3
-- | >>> runIt (pairs (Nothing, 2))
-- | Right 2
pairs : (Maybe Int, Int) -> Co (exception String) Int
pairs p = do
  let (Just a, b) = p else
    let (_, c) = p
    return c
  pure (a + b)

-- | >>> pureBlock [1, 2]
-- | 1
pureBlock : List Int -> Int
pureBlock xs = run do
  let [a, _] = xs else return 0
  return a

-- | a pattern that cannot fail, its `else` never run
-- | >>> runIt (whole (1, 2))
-- | Right 3
whole : (Int, Int) -> Co (exception String) Int
whole p = do
  let (a, b) = p else return 0
  pure (a + b)

-- | an `else` of an `if` whose arms both leave, one by `abandon`
-- | >>> runIt (checked (Just 7))
-- | Right 7
-- | >>> runIt (checked Nothing)
-- | Right 0
checked : Maybe Int -> Co (exception String) Int
checked m = do
  let Just x = m else
    if True then return 0 else abandon
  pure x
