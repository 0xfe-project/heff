-- A record with some fields replaced, `{ r | x = v }`: the rest are
-- `r`'s, `r` computed once; `x.y = v` sets a field of a field; a
-- theory's record is updated the same way.

type Body =
  { x : Float64, y : Float64, vx : Float64, vy : Float64, mass : Float64 }

move : Float64 -> Body -> Body
move dt b = { b | x = b.x + dt * b.vx, y = b.y + dt * b.vy }

-- >>> move 0.5 { x = 1.0, y = 2.0, vx = 2.0, vy = 4.0, mass = 3.0 }
-- { x = 2.0, y = 4.0, vx = 2.0, vy = 4.0, mass = 3.0 }

type Opts = { name : String, verbose : Bool = False, label : String = name }

opts : Opts
opts = { name = "a", label = "x" }

-- (a field not set keeps the record's value: `label` is not given its
-- default again)
-- >>> { opts | name = "b" }
-- { name = "b", verbose = False, label = "x" }

type Pos = { px : Int, py : Int }

type Sprite = { pos : Pos, id : Int }

sprite : Sprite
sprite = { pos = { px = 1, py = 2 }, id = 7 }

-- (the settings under `pos` are put together, in any order)
-- >>> { sprite | pos.py = 20, id = 8, pos.px = 10 }
-- { pos = { px = 10, py = 20 }, id = 8 }

theory Monoid where
  t : Type
  unit : t
  m : t -> t -> t

sum : Monoid ~ { t = Int }
sum = { t = Int, unit = 0, m = \a b -> a + b }

product : Monoid ~ { t = Int }
product = { sum | unit = 1, m = \a b -> a * b }

-- >>> product.m 3 (product.m 4 product.unit)
-- 12
