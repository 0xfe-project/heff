-- Unit and pairs written as tuples: `()` is the unit and `(a, b)` a
-- pair, `(a, b, c)` the pair `((a, b), c)`; as values, each says its
-- type (`Unit`, `Pair`), where a tag alone says none; where a type is
-- expected, `()` is `Unit` and `(A, B)` is `Pair A B`; as patterns,
-- they take values apart, wherever a pattern binds: `case`, equations,
-- `let p = e`, `p <- e`, `with e as p`, `\p -> e`.

module test.surface.tuples

import co
import exception

-- Values and types

-- | >>> origin
-- | MkPair 0 0
origin : (Int, Int)
origin = (0, 0)

-- | >>> triple
-- | MkPair (MkPair 1 "two") True
triple : (Int, String, Bool)
triple = (1, "two", True)

nothing : ()
nothing = ()

-- | a list of pairs, its type's argument a tuple type too
-- | >>> List.length table
-- | 2
table : List (String, Int)
table = [("one", 1), ("two", 2)]

type Point = (Int, Int)

-- | >>> norm1 (3, 4)
-- | 7
norm1 : Point -> Int
norm1 (x, y) = x + y

-- | a pair inferring its type: its parts' types found
-- | >>> multiplied 2
-- | 6
multiplied : Int -> Int
multiplied n = case (n, n + 1) of
  (a, b) -> a * b

-- Patterns

-- | >>> swap (1, "a")
-- | MkPair "a" 1
swap : {a b : Type} -> (a, b) -> (b, a)
swap (x, y) = (y, x)

-- | >>> sum3 (1, 2, 3)
-- | 6
-- | >>> sum3 ((1, 2), 3)
-- | 6
sum3 : (Int, Int, Int) -> Int
sum3 (a, b, c) = a + b + c

-- | nested, and refutable parts where a `case` tries them in turn
-- | >>> List.map firstOr [(2, (Just 5, 1)), (2, (Nothing, 1))]
-- | [5, 3]
firstOr : (Int, (Maybe Int, Int)) -> Int
firstOr (_, (Just a, _)) = a
firstOr (c, (Nothing, b)) = b + c

-- | `(a, b, c)` is `((a, b), c)`, as a pattern too
-- | >>> List.map leading [(Just 5, 1, 2), (Nothing, 1, 2)]
-- | [5, 3]
leading : ((Maybe Int, Int), Int) -> Int
leading (Just a, _, _) = a
leading ((Nothing, b), c) = b + c

-- | >>> unitArg ()
-- | 7
unitArg : () -> Int
unitArg () = 7

-- | `let` taking a pair apart
-- | >>> area 3
-- | 12
area : Int -> Int
area n =
  let (w, h) = (n, n + 1)
  in w * h

-- | a lambda's argument taken apart
-- | >>> List.map (\(a, b) -> a * b) [(1, 2), (3, 4)]
-- | [2, 12]
-- | >>> ((\() -> 3) : Unit -> Int) ()
-- | 3
-- | >>> dot (1, 2) (3, 4)
-- | 11
dot : (Int, Int) -> (Int, Int) -> Int
dot = \(a, b) (c, d) -> a * c + b * d

-- `do` blocks

-- (a world that throws a `String`)
world : HFunctor
world = exception String

-- (what a computation of it comes to, or what it threw)
ran : Handler world
ran =
  { M = \a -> Either String a
  , ret = \x -> Right x
  , bind = \m k -> case m of
      Left s -> Left s
      Right x -> k x
  , malg = \p -> case p of
      Throw s -> Left s
      Catch c h -> case c of
        Left s -> h s
        Right x -> Right x
  }

runIt : {a : Type} -> Co world a -> Either String a
runIt c = handle ran c

-- (an action of any type, as STM's `retry` is)
stop : {a : Type} -> Co world a
stop = throw (ev := here world) "stop"

-- | a `with` head handing its body three things, as a resource's hands
-- | it what it holds
three : {e : HFunctor}
      -> {a : Type}
      -> ((Int, String, Bool) -> Co e a)
      -> Co e a
three k = k (1, "two", True)

pairUp : {e : HFunctor} -> Int -> Co e (Int, Int)
pairUp n = pure (n, n * 2)

-- | `p <- e`, `let p = e` and `with e as p`
-- | >>> runIt (statements 5)
-- | Right 136
statements : Int -> Co world Int
statements n = do
  (a, b) <- pairUp n
  let (c, d) = (a + 1, b + 1)
  with three as (x, s, t) do
    pure (a + b + c + d + x + strLength s + (if t then 100 else 0))

-- | `()` bound and given
-- | >>> runIt (units 1)
-- | Right 1
units : Int -> Co world Int
units n = do
  () <- pure ()
  let () = ()
  pure n

-- | `pure ()` in an `if` whose other arm says no type, its value
-- | dropped: `()` says it is a `Unit` (`MkUnit` alone does not, E0314)
-- | >>> runIt (checked False)
-- | Right 1
-- | >>> runIt (checked True)
-- | Left "stop"
checked : Bool -> Co world Int
checked b = do
  if b then stop else pure ()
  pure 1

-- | `pure ()` as a `for` loop's body
-- | >>> runIt (looped [1, 2, 3])
-- | Right 2
-- | >>> runIt (looped [1, 5])
-- | Left "stop"
looped : List Int -> Co world Int
looped xs = do
  for x in xs do
    if x > 3 then stop else pure ()
  pure 2
