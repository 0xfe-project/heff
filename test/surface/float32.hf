-- `Float32`: each operation rounded to IEEE 754's single precision,
-- shown as the fewest digits that read back as the same one.

import float32 as F32
import prelude

third : Float32
third = F32.div 1.0 3.0

-- (in a `Float32`, 16777217 is 16777216: 24 bits)
big : Float32
big = 16777217.0

-- | the dot product of two vectors
dot : List Float32 -> List Float32 -> Float32
dot xs ys = foldl F32.add 0.0 (zipWith F32.mul xs ys)

-- >>> third
-- 0.33333334

-- >>> F32.toFloat third
-- 0.3333333432674408

-- >>> big
-- 16777216.0

-- >>> F32.add big 1.0
-- 16777216.0

-- >>> F32.show (0.1 : Float32)
-- "0.1"

-- >>> F32.toFloat 0.1 ==. 0.1
-- False

-- >>> dot [1.5, 2.0, -0.25] [2.0, 0.5, 4.0]
-- 3.0

-- >>> map F32.show [F32.div 1.0 0.0, F32.div (-1.0) 0.0, F32.div 0.0 0.0]
-- Cons "Infinity" (Cons "-Infinity" (Cons "NaN" Nil))

-- >>> F32.isNaN (F32.div 0.0 0.0) && not (F32.eq (F32.div 0.0 0.0) (F32.div 0.0 0.0))
-- True

-- >>> F32.mul 3.0e38 10.0
-- Infinity

-- >>> F32.sqrt 2.0
-- 1.4142135

-- >>> map F32.floor [2.5, -2.5]
-- Cons 2 (Cons (-3) Nil)

-- >>> F32.floor (F32.div 1.0 0.0)
-- <abandoned>

-- >>> F32.fromInt 16777219
-- 16777220.0

-- >>> F32.compare 1.0 2.0
-- LT

-- >>> F32.show 3355443.25
-- "3355443.2"
