-- `Float32`: each operation rounded to IEEE 754's single precision,
-- shown as the fewest digits that read back as the same one.

import float32 as Float32

-- | >>> third
-- | 0.33333334
-- | >>> Float32.toFloat third
-- | 0.3333333432674408
third : Float32
third = Float32.div 1.0 3.0

-- (in a `Float32`, 16777217 is 16777216: 24 bits)
-- | >>> big
-- | 16777216.0
-- | >>> Float32.add big 1.0
-- | 16777216.0
big : Float32
big = 16777217.0

-- | the dot product of two vectors
-- | >>> dot [1.5, 2.0, -0.25] [2.0, 0.5, 4.0]
-- | 3.0
dot : List Float32 -> List Float32 -> Float32
dot xs ys = List.foldl Float32.add 0.0 (List.zipWith Float32.mul xs ys)

-- >>> Float32.show (0.1 : Float32)
-- "0.1"

-- >>> Float32.toFloat 0.1 == 0.1
-- False

-- >>> List.map Float32.show [Float32.div 1.0 0.0, Float32.div (-1.0) 0.0, Float32.div 0.0 0.0]
-- Cons "Infinity" (Cons "-Infinity" (Cons "NaN" Nil))

-- >>> Float32.isNaN (Float32.div 0.0 0.0) && not (Float32.eq (Float32.div 0.0 0.0) (Float32.div 0.0 0.0))
-- True

-- >>> Float32.mul 3.0e38 10.0
-- Infinity

-- >>> Float32.sqrt 2.0
-- 1.4142135

-- >>> List.map Float32.floor [2.5, -2.5]
-- Cons 2 (Cons (-3) Nil)

-- >>> Float32.floor (Float32.div 1.0 0.0)
-- 0

-- >>> Float32.fromInt 16777219
-- 16777220.0

-- >>> compare (1.0 : Float32) 2.0
-- LT

-- >>> Float32.show 3355443.25
-- "3355443.2"
