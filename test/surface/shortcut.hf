-- `&&` and `||` are `if`: the right side is computed only if it is
-- needed, and a call of itself there is a tail call -- `deepAnd` is a
-- loop, not a stack.  `(&&)` alone is still the prelude's function.

-- >>> False && abandon
-- False

-- >>> True || abandon
-- True

-- >>> True && False
-- False

-- >>> False || True
-- True

-- >>> List.foldl (&&) True [True, True]
-- True

deepAnd : Int -> Bool
deepAnd n = n >= 0 && (n == 0 || deepAnd (n - 1))

-- >>> deepAnd 100000
-- True
