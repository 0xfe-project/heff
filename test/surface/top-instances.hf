-- Instances declared at the top level, as Agda has them: `instance x : T`
-- is a definition like any other, and a candidate for the instance
-- arguments elaborated after it -- with the instance binders in scope,
-- and the instances of the modules imported, one pool, from which
-- exactly one must be of the type wanted.

module test.surface.top-instances

theory Eq (a : Type) where
  equal : a -> a -> Bool

-- | >>> instanceEqInt.equal 3 3
-- | True
instance instanceEqInt : Eq Int
instanceEqInt = { equal = intEq }

instance instanceEqFloat64 : Eq Float64
instanceEqFloat64 = { equal = floatEq }

-- (the inner `member` finds `eq`: neither instance is of `Eq a`)
-- | >>> member 2 [1, 2, 3]
-- | True
-- | >>> member 2.5 [1.0, 2.0]
-- | False
member : {a : Type} -> {{eq : Eq a}} -> a -> List a -> Bool
member x [] = False
member x (y :: ys) = eq.equal x y || member x ys

-- | >>> both
-- | True
both : Bool
both = member 1 [1, 2] && member 1.5 [0.5, 1.5]

-- an instance is given as any instance argument is, by its name
-- | >>> given
-- | False
given : Bool
given = member (eq := instanceEqInt) 3 [1, 2]

-- an instance binder of the signature, and the instances: each search
-- finds the one of the type it wants
-- | >>> inner (eq := { equal = strEq }) "b"
-- | True
inner : {{eq : Eq String}} -> String -> Bool
inner x = member x ["a", "b"] && member 1 [1] && not (member 0.5 [])
