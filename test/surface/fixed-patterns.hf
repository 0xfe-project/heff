-- Literal patterns at the fixed-width types, in equations and in `case`:
-- each literal of the type it matches (in its range), compared by that
-- type's equality; an integer literal matches a float too.

import float32 as F32
import int8 as I8
import uint32 as U32
import uint8 as U8

-- | >>> List.map opcode [0, 255, 7]
-- | Cons "nop" (Cons "halt" (Cons "op 7" Nil))
opcode : UInt8 -> String
opcode 0 = "nop"
opcode 255 = "halt"
opcode n = "op " ^ U8.show n

-- | >>> List.map sign [-128, 0, -3, 3]
-- | Cons "least" (Cons "zero" (Cons "negative" (Cons "positive" Nil)))
sign : Int8 -> String
sign x = case x of
  -128 -> "least"
  0 -> "zero"
  _ -> if I8.lt x 0 then "negative" else "positive"

-- | >>> List.map magic [3735928559, 1]
-- | Cons True (Cons False Nil)
magic : UInt32 -> Bool
magic 3735928559 = True
magic _ = False

-- (an integer literal and a fractional one, both matching a `Float32`)
-- | >>> List.map half [0.0, 0.5, 0.25]
-- | Cons "zero" (Cons "half" (Cons "0.25" Nil))
half : Float32 -> String
half 0 = "zero"
half 0.5 = "half"
half x = F32.show x

-- (and a `Float`)
-- | >>> List.map unit [1.0, 2.0]
-- | Cons "one" (Cons "other" Nil)
unit : Float -> String
unit 1 = "one"
unit _ = "other"
