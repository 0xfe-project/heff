-- Floats: JavaScript's numbers, their literals, arithmetic and comparisons.

import prelude

half : Float
half = 1.0 /. 2.0

area : Float -> Float
area r = 3.14159 *. r *. r

-- >>> half
-- 0.5
-- >>> area 2.0
-- 12.56636
-- >>> floor (area 2.0)
-- 12
-- >>> showFloat 2.0 ++ " " ++ showFloat 0.1 ++ " " ++ showFloat 6.02e23
-- "2.0 0.1 6.02e+23"
-- >>> sqrt 2.0 <. 1.5 && 1.0 +. 2.0 ==. 3.0
-- True
-- >>> toFloat 7 /. 2.0
-- 3.5
-- >>> -0.5 +. 1.0
-- 0.5
-- >>> floor (1.0 /. 0.0)
-- <abandoned>
