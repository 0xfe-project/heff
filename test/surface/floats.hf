-- Floats: JavaScript's numbers, their literals, arithmetic and comparisons.

-- | >>> half
-- | 0.5
half : Float64
half = 1.0 /. 2.0

-- | >>> area 2.0
-- | 12.56636
-- | >>> floor (area 2.0)
-- | 12
area : Float64 -> Float64
area r = 3.14159 * r * r

