-- A `case` of nested patterns names what it takes apart, and no name
-- it makes is one its alternatives have: here the inner `case`'s second
-- field, taken apart unnamed, is not the outer `sp`.

data Inner = MkInner Int Int

data Outer = Plain Int | Nested Inner

pick : Outer -> Int -> Int
pick n c = case (MkPair n c : Pair Outer Int) of
  MkPair (Plain x) _ -> x
  MkPair (Nested inner) sp -> case inner of
    MkInner 0 _ -> 0
    _ -> sp

-- >>> pick (Nested (MkInner 1 2)) 7
-- 7

-- >>> pick (Nested (MkInner 0 2)) 7
-- 0

-- >>> pick (Plain 3) 7
-- 3
