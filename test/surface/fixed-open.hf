-- A fixed-width type's module, opened: its instances are found as an
-- aliased import's are, so `+` is the prelude's still, at `Int32` and at
-- `Int` side by side; its own names, `add` to `show`, are in scope as
-- they are, the prelude's (every module has the prelude without writing
-- it) giving way to them -- its `neg` is what `-x` is.

import int32

-- | >>> sum2
-- | 14
-- | >>> not $ sum2 == 14 && sum2 < 0
-- | True
sum2 : Int32
sum2 = 2 + 3 * 4

-- (`$` below them, as below the prelude's)
-- | >>> doubled
-- | 30
doubled : Int32
doubled = (\x -> x * 2) $ sum2 + 1

-- | >>> List.map flip [5, -2147483648]
-- | Cons (-5) (Cons (-2147483648) Nil)
flip : Int32 -> Int32
flip x = -x

-- (an `Int` beside it: the same operators)
-- | >>> both 2147483647
-- | "-2147483648 2147483648"
both : Int -> String
both n = show (fromInt n + 1) ^ " " ^ showInt (n + 1)
