-- A fixed-width type's module, opened: its instances are found as an
-- aliased import's are, so `+` is the prelude's still, at `Int64` and at
-- `Int` side by side; its own names, `add` to `debug`, are in scope as
-- they are, and none of them is the prelude's -- so `-n`, `min` and
-- `and` are the prelude's at `Int` as at `Int64`, in the same file.

module test.surface.fixed-open

import int as Int
import int64

-- | >>> sum2
-- | 14
-- | >>> not $ sum2 == 14 && sum2 < 0
-- | True
sum2 : Int64
sum2 = 2 + 3 * 4

-- (`$` below them, as below the prelude's)
-- | >>> doubled
-- | 30
doubled : Int64
doubled = (\x -> x * 2) $ sum2 + 1

-- | >>> List.map flip [5, -9223372036854775808]
-- | Cons (-5) (Cons (-9223372036854775808) Nil)
flip : Int64 -> Int64
flip x = -x

-- (an `Int` beside it: the same operators)
-- | >>> both 9223372036854775807
-- | "-9223372036854775808 9223372036854775808"
both : Int -> String
both n = debug (fromInt n + 1) ^ " " ^ debug (n + 1)

-- (and the prelude's functions, at `Int` and at `Int64` in one file: the
-- module has no `neg`, `min` or `and` of its own in their way)
-- | >>> ints 5
-- | Cons (-5) (Cons 3 (Cons 4 Nil))
ints : Int -> List Int
ints n = [-n, min n 3, and n 12]

-- | >>> List.map debug (wides 5)
-- | Cons "-5" (Cons "3" (Cons "4" Nil))
wides : Int64 -> List Int64
wides n = [-n, min n 3, and n 12]
