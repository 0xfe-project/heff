-- A fixed-width type's operators are its module's: opened, its `+` is
-- the one in scope, the prelude's (every module has the prelude without
-- writing it) giving way to it -- and its `neg` is what `-x` is.

import int32

-- | >>> sum2
-- | 14
-- | >>> not $ sum2 == 14 && sum2 < 0
-- | True
sum2 : Int32
sum2 = 2 + 3 * 4

-- (`$` below them, as below the prelude's)
-- | >>> doubled
-- | 30
doubled : Int32
doubled = (\x -> x * 2) $ sum2 + 1

-- | >>> List.map flip [5, -2147483648]
-- | Cons (-5) (Cons (-2147483648) Nil)
flip : Int32 -> Int32
flip x = -x
