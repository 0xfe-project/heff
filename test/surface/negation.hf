-- `-x`: `-` where it would be a number's sign (after a space, or at the
-- start, not right after an operand), right before a name or a `(`,
-- negates what it is before -- an argument's worth: a name with its
-- fields, or what is in parentheses.  It is the `neg` in scope applied to
-- it, as `a - b` is the `(-)` in scope: the prelude's an `Int`'s, a
-- fixed-width module's, imported unaliased, one of its own.
-- So `f -x` is `f (-x)`, as `f -1` is
-- `f (-1)`, while `a - x` and `a-x` subtract.

module test.surface.negation

type P = { x : Int, y : Int }

-- | >>> -a
-- | -10
-- | >>> -(-a)
-- | 10
-- | >>> a - 3
-- | 7
-- | >>> a-3
-- | 7
-- | >>> 1 + -a
-- | -9
a : Int
a = 10

-- | >>> f -a
-- | -20
-- | >>> -(f 3)
-- | -6
-- | >>> List.map (\n -> -n) [1, -2]
-- | Cons (-1) (Cons 2 Nil)
f : Int -> Int
f n = n * 2

-- | >>> -p.x
-- | -3
p : P
p = { x = 3, y = 4 }
