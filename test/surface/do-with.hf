-- A `do` block's `with` statement (#106): `with e as x do` and the
-- block under it, the `with`'s body, `x` what it holds.  Its value is the
-- block's where it is the last statement, dropped otherwise; its
-- statements are the block's (they set its `let mut` variables, and
-- `return`, `break` and `continue` out of it); a throw in it is heard by
-- a `try` around it.

module test.surface.do-with

import co
import custodian
import exception
import state
import resource

-- (the log, its latest first, and the answer or what no `catch` heard)
data Logged = Thrown String (List String) | Done Int (List String)

-- (a world that throws a `String` and keeps a log; a throw keeps what was
-- logged before it)
logged : Handler (exception String <+> state (List String))
logged =
  { M = \a -> List String -> Pair (Either String a) (List String)
  , ret = \x l -> MkPair (Right x) l
  , bind = \m k l -> case m l of
      MkPair (Left s) l2 -> MkPair (Left s) l2
      MkPair (Right x) l2 -> k x l2
  , malg = \p l -> case p of
      InL t -> case t of
        Throw s -> MkPair (Left s) l
        Catch c h -> case c l of
          MkPair (Left s) l2 -> h s l2
          MkPair (Right x) l2 -> MkPair (Right x) l2
      InR t -> case t of
        Get k -> MkPair (Right (k l)) l
        Put l2 x -> MkPair (Right x) l2
  }

runLogged : Co (custodian <+> (exception String <+> state (List String))) Int -> Logged
runLogged c = case handle logged (untended c) Nil of
  MkPair (Left s) l -> Thrown s l
  MkPair (Right x) l -> Done x l

note : {e : HFunctor} -> {{st : state (List String) <: e}} -> String -> Co e Unit
note s = do
  l <- get
  put (Cons s l : List String)

-- | a `with` of a number, which notes it let go of it
counter : {e : HFunctor} -> {{st : state (List String) <: e}} -> {a : Type} -> {{cu : custodian <: e}} -> Int -> ({s : Type} -> With s Int -> Co e a) -> Co e a
counter n = held (pure n) (\x -> note ("released " ^ debug x))

-- | the `with` the block's last statement: its value the block's
-- | >>> runLogged (lastOne (st := _))
-- | Done 5 ["released 4", "in"]
lastOne : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Co e Int
lastOne = do
  with counter 4 as c do
    note "in"
    pure (inside c + 1)

-- | the `with` not the last: its value dropped, the block's variable set
-- | in it
-- | >>> runLogged (setInside (st := _))
-- | Done 4 ["after", "released 4"]
setInside : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Co e Int
setInside = do
  let mut n = 0
  with counter 4 as c do
    n := inside c
    pure "dropped"
  note "after"
  return n

-- | `return` out of a `with`, the thing let go of on the way
-- | >>> runLogged (returned (st := _) True)
-- | Done 2 ["released 2"]
-- | >>> runLogged (returned (st := _) False)
-- | Done 0 ["released 2", "kept on"]
returned : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Bool -> Co e Int
returned b = do
  with counter 2 as c do
    if b then return (inside c)
    note "kept on"
  return 0

-- | `continue` and `break` out of a `with` in a loop's body, each turn's
-- | thing let go of
-- | >>> runLogged (looped (st := _))
-- | Done 4 ["released 4", "released 3", "released 2", "released 1"]
looped : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Co e Int
looped = do
  let mut i = 0
  let mut total = 0
  while i < 10 do
    i := i + 1
    with counter i as c do
      if inside c == 2 then continue
      if inside c == 4 then break
      total := total + inside c
  return total

-- | two `with`s, one in the other, `return` out of both
-- | >>> runLogged (both (st := _) True)
-- | Done 3 ["released 1", "released 2"]
-- | >>> runLogged (both (st := _) False)
-- | Done 0 ["released 1", "between", "released 2"]
both : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Bool -> Co e Int
both b = do
  with counter 1 as x do
    with counter 2 as y do
      if b then return (inside x + inside y)
    note "between"
  return 0

-- | a throw in a `with`, heard by a `try` around it: the variable as it
-- | was where the `try` began
-- | >>> runLogged (heardAround (ex := _) (st := _))
-- | Done 0 ["caught inside"]
heardAround : {e : HFunctor} -> {{ex : exception String <: e}} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Co e Int
heardAround = do
  let mut n = 0
  try
    with counter 3 as c do
      n := inside c
      (throw "inside" : Co e Unit)
  catch (s : String) ->
    note ("caught " ^ s)
  return n

-- | `(<- c)` in the `with`, bound before it
-- | >>> runLogged (nestedHead (st := _))
-- | Done 6 ["released 6"]
nestedHead : {e : HFunctor} -> {{st : state (List String) <: e}} -> {{cu : custodian <: e}} -> Co e Int
nestedHead = do
  with counter (<- pure 6) as c do
    pure (inside c)
