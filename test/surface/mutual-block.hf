-- A `mutual` block: definitions that name one another, each with its
-- signature, every signature in scope in every body, the bodies checked
-- in order.  After the block, the names are the module's as any other.
-- A doc test in the block is of the definition under it; a watch is
-- checked after the definitions above it.

module test.surface.mutual-block

mutual
  -- | >>> even 10
  -- | True
  even : Int -> Bool
  even 0 = True
  even n = odd (n - 1)

  -- | >>> odd 7
  -- | True
  odd : Int -> Bool
  odd 0 = False
  odd n = even (n - 1)

-- >>> List.map even [0, 1, 2, 3]
-- [True, False, True, False]

-- Equations with patterns, as any definition's; a definition that
-- takes implicit and instance arguments; a local binding that shadows
-- a name of the block is the local.
data Expr = Num Int | Add Expr Expr | Neg Expr | Sum (List Expr)

mutual
  eval : Expr -> Int
  eval (Num n) = n
  eval (Add a b) = eval a + eval b
  eval (Neg e) = 0 - eval e
  eval (Sum es) = evalAll es 0

  evalAll : List Expr -> Int -> Int
  evalAll Nil acc = acc
  evalAll (Cons e es) acc = evalAll es (acc + eval e)

  same : {a : Type} -> {{e : Equality a}} -> a -> a -> Bool
  same x y =
    if equal x y then even (len [x]) else let eval = (False : Bool) in eval

  len : {a : Type} -> List a -> Int
  len Nil = 0
  len (Cons _ xs) = 1 + len xs

  -- >>> same 1 1
-- False

-- >>> eval (Sum [Num 1, Add (Num 2) (Neg (Num 3)), Num 4])
-- 4
-- >>> same "a" "b"
-- False
-- >>> len [1, 2, 3]
-- 3
-- >>> evalAll [Num 1] 2
-- 3

-- A signature through an alias of a function type: the block's record
-- is typed by it, the alias unfolded where the field is checked.
type Step = Int -> Int

mutual
  down : Step
  down 0 = 0
  down n = up (n - 1)

  up : Step
  up n = down n + 1

-- >>> down 4
-- 4
