-- A record of a type with a parameter, bound where its type is known
-- only once an instance is found (a cown's `with`, whose name is of the
-- binder's `Contents`): updated, and a field projected, the fields'
-- types of the parameter, with no annotation.

module test.surface.with-record-update

import boc as BOC
import co

type Box (r : Type) = { item : Maybe r, count : Int }

bumped : {r : Type} -> BOC.Cown (Box r) -> Co BOC.boc Unit
bumped c = do
  with b := c do
    b := { b | count = b.count + 1 }

-- (a field of the parameter's type projected, and set)
kept : {r : Type} -> BOC.Cown (Box r) -> Co BOC.boc Unit
kept c = do
  with b := c do
    b := { b | count = b.count + 1, item = b.item }

-- (with two bindings, as a server's state beside an act awaited)
both : {r : Type} -> BOC.Cown (Box r) -> BOC.Cown Int -> Co BOC.boc Unit
both c d = do
  with b := c
       n := d do
    b := { b | count = n }

-- the same of an instance of the program's own, no `with`
theory Holds (c : Type) where
  Inside : Type

instance instanceHoldsMaybe : {a : Type} -> Holds (Maybe a)
instanceHoldsMaybe = { Inside = a }

held : {c : Type} -> c -> {{h : Holds c}} -> (h.Inside -> h.Inside) -> Unit
held c f = MkUnit

counted : {r : Type} -> Maybe (Box r) -> Unit
counted m = held m (\b -> { b | count = b.count + 1 })
