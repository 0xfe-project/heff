-- The fixed-width integers' operations: each wraps around to its type,
-- divides rounding toward zero, shifts by the amount modulo its bits, and
-- goes to and from an `Int`.

import int32 as I32
import int64 as I64
import int8 as I8
import uint32 as U32
import uint64 as U64
import uint8 as U8

-- | FNV-1a, 32 bits: the bytes of a string, mixed by `xor` and a product
-- | wrapping around
-- | >>> U32.show (fnv "heff")
-- | "844628642"
fnv : String -> UInt32
fnv s =
  List.foldl
    (\h c -> U32.mul (U32.xor h (U32.fromInt c)) 16777619)
    2166136261
    (List.map (\i -> byteAt s i) (List.range 0 (strLength s - 1)))

-- >>> I8.show (I8.add 127 1)
-- "-128"

-- >>> U8.show (U8.sub 0 1)
-- "255"

-- >>> I32.show (I32.mul 65536 65536)
-- "0"

-- >>> I64.show (I64.add I64.maxBound 1)
-- "-9223372036854775808"

-- >>> U64.show (U64.mul U64.maxBound U64.maxBound)
-- "1"

-- >>> List.map I32.show [I32.div (-7) 2, I32.rem (-7) 2, I32.div 7 (-2), I32.rem 7 (-2)]
-- Cons "-3" (Cons "-1" (Cons "-3" (Cons "1" Nil)))

-- >>> I8.show (I8.div (-128) (-1))
-- "-128"

-- >>> List.map I32.show [I32.div 1 0, I32.rem 1 0, I32.div I32.minBound (-1), I32.rem I32.minBound (-1)]
-- Cons "0" (Cons "1" (Cons "-2147483648" (Cons "0" Nil)))

-- >>> List.map I8.show [I8.shiftL 1 7, I8.shiftL 1 8, I8.shiftR (-128) 7, I8.shiftL 1 (-1)]
-- Cons "-128" (Cons "1" (Cons "-1" (Cons "-128" Nil)))

-- >>> List.map U8.show [U8.shiftR 128 7, U8.and 12 10, U8.or 12 10, U8.xor 12 10, U8.complement 0]
-- Cons "1" (Cons "8" (Cons "14" (Cons "6" (Cons "255" Nil))))

-- >>> U32.lt 1 4294967295 && I32.lt (-1) 0
-- True

-- >>> List.map I32.toInt [I32.fromInt 2147483648, I32.fromInt (-2147483649), I32.minBound]
-- Cons (-2147483648) (Cons 2147483647 (Cons (-2147483648) Nil))

-- >>> U64.toInt (U64.fromInt (-1))
-- 18446744073709551615
