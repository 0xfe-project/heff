-- The fixed-width integers' operations: each wraps around to its type,
-- divides rounding toward zero, shifts by the amount modulo its bits, and
-- goes to and from an `Int`.

import int32 as Int32
import int64 as Int64
import int8 as Int8
import uint32 as UInt32
import uint64 as UInt64
import uint8 as UInt8

-- | FNV-1a, 32 bits: the bytes of a string, mixed by `xor` and a product
-- | wrapping around
-- | >>> UInt32.show (fnv "heff")
-- | "844628642"
fnv : String -> UInt32
fnv s =
  List.foldl
    (\h c -> UInt32.mul (xor h (UInt32.fromInt c)) 16777619)
    2166136261
    (List.map (\i -> byteAt s i) (List.range 0 (strLength s - 1)))

-- >>> Int8.show (Int8.add 127 1)
-- "-128"

-- >>> UInt8.show (UInt8.sub 0 1)
-- "255"

-- >>> Int32.show (Int32.mul 65536 65536)
-- "0"

-- >>> Int64.show (Int64.add Int64.maxBound 1)
-- "-9223372036854775808"

-- >>> UInt64.show (UInt64.mul UInt64.maxBound UInt64.maxBound)
-- "1"

-- >>> List.map Int32.show [Int32.div (-7) 2, Int32.rem (-7) 2, Int32.div 7 (-2), Int32.rem 7 (-2)]
-- Cons "-3" (Cons "-1" (Cons "-3" (Cons "1" Nil)))

-- >>> Int8.show (Int8.div (-128) (-1))
-- "-128"

-- >>> List.map Int32.show [Int32.div 1 0, Int32.rem 1 0, Int32.div Int32.minBound (-1), Int32.rem Int32.minBound (-1)]
-- Cons "0" (Cons "1" (Cons "-2147483648" (Cons "0" Nil)))

-- >>> List.map Int8.show [shiftL 1 7, shiftL 1 8, shiftR (-128) 7, shiftL 1 (-1)]
-- Cons "-128" (Cons "1" (Cons "-1" (Cons "0" Nil)))

-- >>> List.map UInt8.show [shiftR 128 7, and 12 10, or 12 10, xor 12 10, complement 0]
-- Cons "1" (Cons "8" (Cons "14" (Cons "6" (Cons "255" Nil))))

-- >>> UInt32.lt 1 4294967295 && Int32.lt (-1) 0
-- True

-- >>> List.map Int32.toInt [Int32.fromInt 2147483648, Int32.fromInt (-2147483649), Int32.minBound]
-- Cons (-2147483648) (Cons 2147483647 (Cons (-2147483648) Nil))

-- >>> UInt64.toInt (UInt64.fromInt (-1))
-- 18446744073709551615
