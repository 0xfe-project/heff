-- The prelude's lists and text.

import prelude

-- >>> take 2 [1, 2, 3]
-- Cons 1 (Cons 2 Nil)
-- >>> drop 2 [1, 2, 3]
-- Cons 3 Nil
-- >>> take 5 [1, 2]
-- Cons 1 (Cons 2 Nil)
-- >>> zip [1, 2, 3] ["a", "b"]
-- Cons (MkPair 1 "a") (Cons (MkPair 2 "b") Nil)
-- >>> sum (range 1 10)
-- 55
-- >>> product [1, 2, 3, 4]
-- 24
-- >>> any (\x -> x > 2) [1, 2, 3]
-- True
-- >>> all (\x -> x > 2) [1, 2, 3]
-- False
-- >>> find (\x -> x > 1) [1, 2, 3]
-- Just 2
-- >>> elemBy (\a b -> a == b) 3 [1, 2, 3]
-- True
-- >>> lookupBy strEq "b" [MkPair "a" 1, MkPair "b" 2]
-- Just 2
-- >>> sortBy (\a b -> a <= b) [3, 1, 2, 1]
-- Cons 1 (Cons 1 (Cons 2 (Cons 3 Nil)))
-- >>> (foldr (\x acc -> Cons x acc) Nil [1, 2, 3] :: List Int)
-- Cons 1 (Cons 2 (Cons 3 Nil))
-- >>> concatMap (\x -> [x, x]) [1, 2]
-- Cons 1 (Cons 1 (Cons 2 (Cons 2 Nil)))
-- >>> head [7, 8]
-- Just 7
-- >>> last [7, 8]
-- Just 8
-- >>> tail ([] :: List Int)
-- Nothing
-- >>> replicate 3 "x"
-- Cons "x" (Cons "x" (Cons "x" Nil))
-- >>> split "," "a,,b"
-- Cons "a" (Cons "" (Cons "b" Nil))
-- >>> lines "one\ntwo"
-- Cons "one" (Cons "two" Nil)
-- >>> words "  hello   big\tworld "
-- Cons "hello" (Cons "big" (Cons "world" Nil))
-- >>> unwords ["a", "b"]
-- "a b"
-- >>> joinWith ", " ["x", "y", "z"]
-- "x, y, z"
-- >>> trim "  padded  "
-- "padded"
-- >>> trim "   "
-- ""
-- >>> indexOf "lo" "hello"
-- Just 3
-- >>> contains "ell" "hello"
-- True
-- >>> startsWith "he" "hello"
-- True
-- >>> endsWith "lo" "hello"
-- True
-- >>> parseInt "42"
-- Just 42
-- >>> parseInt "-7"
-- Just (-7)
-- >>> parseInt "4x"
-- Nothing
-- >>> parseInt "-"
-- Nothing
-- >>> charCode "A" 0
-- 65
-- >>> fromCharCode 66
-- "B"
