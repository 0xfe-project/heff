-- A lambda checked where its type is not known yet waits for it, as a
-- literal does, and so does an application of a value whose type is not
-- known yet: what the rest of the call says of them is known by then.
-- Where nothing says it, a lambda that waits is guessed a function,
-- `?A -> ?B`.

module test.surface.waiting-lambdas

-- the inner lambda's type is the list's element type, known only once the
-- call meets the type wanted of it
adders : List (Int -> Int)
adders = List.map (\j -> \v -> v + j) (List.range 0 3)

-- `f`'s type is known only from the third argument
-- | >>> applied
-- | 6
applied : Int
applied = List.foldl (\acc f -> f acc) 0 adders

-- >>> List.map (\f -> f 10) adders
-- [10, 11, 12, 13]

-- `f`'s type is the inner lambda's, and the inner lambda's is `f`'s: each
-- waits on the other, and nothing else says either, so the inner lambda
-- is guessed a function
-- | >>> eachOther
-- | 7
eachOther : Int
eachOther =
  List.foldl (\acc f -> f acc) 1 (List.map (\j -> \v -> v + j) (List.range 0 3))

pass : {g : Type} -> g -> (g -> Int) -> Int
pass x k = k x

-- a lambda given where an implicit argument's type is wanted, and `f`
-- applied: guessed a function, then `Int -> Int`
-- | >>> passed
-- | 3
passed : Int
passed = pass (\v -> v + 1) (\f -> f 2)

-- the inner lambda is guessed too, once its outer one is
-- | >>> curried
-- | 5
curried : Int
curried = pass (\a -> \b -> a + b) (\f -> f 2 3)
