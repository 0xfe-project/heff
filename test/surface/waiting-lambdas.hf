-- A lambda checked where its type is not known yet waits for it, as a
-- literal does, and so does an application of a value whose type is not
-- known yet: what the rest of the call says of them is known by then.

module test.surface.waiting-lambdas

-- the inner lambda's type is the list's element type, known only once the
-- call meets the type wanted of it
adders : List (Int -> Int)
adders = List.map (\j -> \v -> v + j) (List.range 0 3)

-- `f`'s type is known only from the third argument
-- | >>> applied
-- | 6
applied : Int
applied = List.foldl (\acc f -> f acc) 0 adders

-- >>> List.map (\f -> f 10) adders
-- [10, 11, 12, 13]
