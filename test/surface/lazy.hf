-- `~A` is the type `Lazy A`, and `~e` delays `e`: it is computed where
-- it is forced, by `force`, or where an `A` is wanted (the prelude's
-- `Coe (Lazy A) A`), and kept, so not computed again.  `~`, as `-`,
-- is so right before a name, a number, a string, a rune, a `(` or a
-- `[`, and not right after an operand: `f ~x` is `f (~x)`, while
-- `a ~ b` and `a~b` are the operator `~`.  Which of the two `~e` is,
-- the elaborator says: where `e` is a type, `Lazy e`; else `e` delayed.
-- Only `~e` delays: an `e` where a `Lazy` is wanted is not one.

module test.surface.lazy

inc : Int -> Int
inc x = x + 1

-- | a delayed value, in a signature `~Int`
seven : ~Int
seven = ~(inc 6)

-- | forced by `force`, or where an `Int` is wanted
-- | >>> force seven
-- | 7
-- | >>> inc seven
-- | 8
-- | >>> forcedTwice
-- | 14
forcedTwice : Int
forcedTwice = force seven + force seven

-- | where a definition's type says `Int`
asInt : Int
asInt = seven

-- | >>> asInt
-- | 7
-- | >>> double ~21
-- | 42
-- | >>> double ~(List.length [1, 2, 3])
-- | 6
double : ~Int -> Int
double l = force l * 2

-- | what is never forced is never computed: `abandon` delayed, not
-- | chosen
-- | >>> pick False ~abandon ~7
-- | 7
-- | >>> pick True ~(List.length [0]) ~(abandon)
-- | 1
pick : Bool -> ~Int -> ~Int -> Int
pick True a b = a
pick False a b = b

-- | the first of a list, or what a delayed default comes to: the
-- | default, abandoned, is computed only for an empty list
-- | >>> headOr [3, 4] ~abandon
-- | 3
headOr : List Int -> ~Int -> Int
headOr (x :: _) d = x
headOr Nil d = d

-- | a field of a data type, and a record's
data Cell = MkCell ~Int

type Holder = { lazy : ~String }

cellValue : Cell -> Int
cellValue (MkCell n) = n

-- | >>> cellValue (MkCell ~(3 + 4))
-- | 7
-- | >>> fieldValue { lazy = ~"x" }
-- | "x"
fieldValue : Holder -> String
fieldValue r = r.lazy

-- | `~` of a `~`, and of what is in brackets
-- | >>> force (force deep)
-- | 3
deep : ~~Int
deep = ~~3

-- | >>> force listed
-- | [1, 2]
listed : ~(List Int)
listed = ~[1, 2]

-- inferring: `~e` of an `e` that infers, without a type wanted
-- >>> ((let d = ~(inc 1) in force d + force d) : Int)
-- 4
-- >>> force ~'a'
-- 'a'
-- >>> (force ~(Just 1) : Maybe Int)
-- Just 1

-- | a type: `~Int` where a type is wanted is `Lazy Int`
-- | >>> force (lazyOf Int 5)
-- | 5
lazyOf : (a : Type) -> a -> ~a
lazyOf a x = ~x

-- as an argument right after the function, `f ~x` is `f (~x)`
-- >>> double ~seven
-- 14
-- >>> double ~(inc 0)
-- 2

-- an operator `~`, after an operand or with a space after it: no delay
infixl ~ above + -

-- | >>> 1 ~ 2
-- | 12
-- | >>> 1~2
-- | 12
(~) : Int -> Int -> Int
(~) a b = a * 10 + b

a : Int
a = 3

b : Int
b = 4

-- >>> a~b
-- 34
-- >>> a ~ b
-- 34

-- `-` the same: `a - b`, `a-b` subtract, `-a` negates
-- >>> a - b
-- -1
-- >>> a-b
-- -1
-- >>> inc -a
-- -2
