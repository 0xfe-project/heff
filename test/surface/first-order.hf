-- A metavariable applied to what is no variable, `?m Int =?= Maybe Int`,
-- is solved to the first order when nothing else solves it: `?m :=
-- Maybe`, then `Int =?= Int` (#88).  So a theory over a type constructor
-- is used without the constructor spelt out.

theory Monad (m : Type -> Type) where
  pure : {a : Type} -> a -> m a
  bind : {a b : Type} -> m a -> (a -> m b) -> m b

instance instanceMonadMaybe : Monad Maybe
instanceMonadMaybe = { pure = \x -> Just x, bind = bindMaybe }
  where
  bindMaybe : {a b : Type} -> Maybe a -> (a -> Maybe b) -> Maybe b
  bindMaybe Nothing k = Nothing
  bindMaybe (Just x) k = k x

instance instanceMonadList : Monad List
instanceMonadList = { pure = \x -> [x], bind = bindList }
  where
  bindList : {a b : Type} -> List a -> (a -> List b) -> List b
  bindList Nil k = Nil
  bindList (Cons x xs) k = List.append (k x) (bindList xs k)

twice : {m : Type -> Type} -> {{mo : Monad m}} -> m Int -> m Int
twice c = mo.bind c (\x -> mo.bind c (\y -> mo.pure (x + y)))

-- `?m Int =?= Maybe Int`: `?m := Maybe`, and the instance is found
-- | >>> r
-- | Just (4)
r : Maybe Int
r = twice (Just 2 : Maybe Int)

-- | >>> sums
-- | [2, 3, 3, 4]
sums : List Int
sums = twice ([1, 2] : List Int)

-- | >>> none
-- | Nothing
none : Maybe Int
none = twice (Nothing : Maybe Int)

-- a record written with an equation is as one declared by `type`
Box : (a : Type) -> Type
Box a = { item : a }

instance instanceMonadBox : Monad Box
instanceMonadBox = { pure = \x -> { item = x }, bind = \c k -> k c.item }

-- | >>> boxed.item
-- | 4
boxed : Box Int
boxed = twice ({ item = 2 } : Box Int)
