-- The operators are the prelude's, each a theory's operation, found at
-- the type it is used at: `Int`'s and `Int64`'s side by side in one
-- file, a float's `+`, `-x` and `/.`, a function of any type that has an
-- `Addition`, an order's `min` and `max` at several types, the bits of
-- an `Int` and of a fixed-width type -- and a division, total, by zero
-- 0, beside the one of `exn` that throws.

import co
import exn
import int as I
import int64 as I64
import uint8 as U8

-- (an LCG step, `Int64` wrapping around, counted by an `Int`)
-- | >>> I64.show (steps 3 7)
-- | "-1723371901998948404"
steps : Int -> Int64 -> Int64
steps n x =
  if n <= 0 then x
  else steps (n - 1) (x * 6364136223846793005 + 1442695040888963407)

-- (the first, and the rest added to it)
-- | >>> showInt (sumOf 1 [2, 3]) ^ " " ^ showFloat (sumOf 0.5 [0.25])
-- | "6 0.75"
-- | >>> I64.show (sumOf I64.maxBound [1])
-- | "-9223372036854775808"
sumOf : {a : Type} -> {{add : Addition a}} -> a -> List a -> a
sumOf first rest = List.foldl (+) first rest

-- (a literal that nothing decides is an `Int`, or a `Float64`, before
-- the instances it wants are looked for)
-- >>> equal (1 + 1) 2 && 7 / 2 == 3
-- True
-- >>> 1 + 2.5
-- 3.5

-- | >>> twice 21
-- | 42
-- | >>> twice 1.25
-- | 2.5
twice : {a : Type} -> {{add : Addition a}} -> a -> a
twice x = x + x

-- (a float's arithmetic and comparisons are the same operators; its
-- negation `-x`, 0.0's too)
-- | >>> showFloat (-x) ^ " " ^ showFloat (2.5 * x - 1.0) ^ " " ^ showFloat (1.0 /. neg 0.0)
-- | "-1.5 2.75 -Infinity"
x : Float64
x = 1.5

-- >>> 1.5 < 2.0 && 2.0 >= 2.0 && 0.1 + 0.2 /= 0.3 && compare 1.0 0.5 == GT
-- True

-- >>> showInt (min 3 (-4)) ^ " " ^ showFloat (max 0.5 (-0.5)) ^ " " ^ U8.show (max 7 200) ^ " " ^ I64.show (min (-1) 1)
-- "-4 0.5 200 -1"

-- >>> showInt (and 12 10) ^ " " ^ showInt (shiftL 1 70) ^ " " ^ showInt (complement 5)
-- "8 1180591620717411303424 -6"

-- >>> U8.show (xor 240 255) ^ " " ^ U8.show (shiftR 128 7 + complement 0)
-- "15 0"

-- (a division is total: by zero 0, its remainder the dividend, so
-- `(x / y) * y + x % y` is `x` whatever `y` is)
-- | >>> List.map (\y -> (17 / y) * y + 17 % y) [5, -5, 0]
-- | Cons 17 (Cons 17 (Cons 17 Nil))
-- | >>> I64.show (I64.minBound / -1) ^ " " ^ I64.show (7 / 0) ^ " " ^ I64.show (7 % 0)
-- | "-9223372036854775808 0 7"
quotients : List Int
quotients = [17 / 5, -17 / 5, 17 / 0, 17 % 5, -17 % 5, 17 % 0]

-- >>> quotients
-- Cons 3 (Cons (-4) (Cons 0 (Cons 2 (Cons 3 (Cons 17 Nil)))))

-- (`exnDiv` throws where `/` is 0: what is thrown is heard by the handler
-- of `exn`, an `Either` here)
fallible : Handler (exn DivByZero)
fallible =
  { M = \a -> Either DivByZero a
  , ret = \v -> Right v
  , bind = \m k -> case m of
      Left d -> Left d
      Right v -> k v
  , malg = \p -> case p of
      Throw d -> Left d
      Catch c h -> case c of
        Left d -> h d
        Right v -> Right v
  }

divided : Int -> Int -> Either DivByZero Int
divided a b = handle fallible (exnDiv (ev := here (exn DivByZero)) a b)

shownDiv : Either DivByZero Int -> String
shownDiv (Left MkDivByZero) = "by zero"
shownDiv (Right v) = showInt v

-- >>> shownDiv (divided 7 2) ^ ", " ^ shownDiv (divided 7 0)
-- "3, by zero"

-- >>> shownDiv (handle fallible (exnMod (ev := here (exn DivByZero)) 7 (0 : Int)))
-- "by zero"

-- (at a fixed-width type too, whose zero its module's `IsZero` knows)
-- >>> handle fallible (exnDiv (ev := here (exn DivByZero)) (7 : Int64) 0)
-- Left MkDivByZero

-- (and a catch of it, in the program)
-- | >>> shownDiv (handle fallible (orZero (ev := here (exn DivByZero)) 1 0))
-- | "0"
orZero : {e : HFunctor} -> {{ev : exn DivByZero <: e}} -> Int -> Int -> Co e Int
orZero a b = catch (exnDiv a b) (\(d : DivByZero) -> pure 0)
