-- A handler of the dom effect written in Hippogriff: its monad is a state
-- monad over a page that only writes down what is done to it -- enough to
-- test an app without a browser

import co
import dom
import examples.counter.counter
import prelude
import state

-- the next node, the app's state, and what was done (last first)
data Page s = MkPage Int s String

note :: {s :: Type} -> String -> Page s -> Page s
note line (MkPage n st done) = MkPage n st (done ++ line ++ "; ")

-- the DOM's operations, and the state's, on the page written down
domStep :: {s x :: Type} -> DomF (\a -> Page s -> Pair a (Page s)) x -> Page s -> Pair x (Page s)
domStep p pg = case p of
  Create t k -> case pg of
    MkPage n st done -> MkPair (k (n + 1)) (note ("create " ++ t) (MkPage (n + 1) st done))
  Text n str x -> MkPair x (note ("text " ++ showInt n ++ " " ++ str) pg)
  Attr n a v x -> MkPair x (note "attr" pg)
  Append p c x -> MkPair x (note ("append " ++ showInt p ++ " " ++ showInt c) pg)
  Clear n x -> MkPair x (note "clear" pg)
  Value n k -> MkPair (k "") pg
  On n e h x -> MkPair x (note ("on " ++ e) pg)
  Root k -> MkPair (k 0) pg
  -- (a page that only writes down: nothing on it is found)
  Select q k -> MkPair (k Nothing) (note ("select " ++ q) pg)
  XPath q k -> MkPair (k Nothing) (note ("xpath " ++ q) pg)
  Sleep ms x -> MkPair x (note ("sleep " ++ showInt ms) pg)
  Fetch url k -> MkPair (k "") (note ("fetch " ++ url) pg)

stateStep :: {s x :: Type} -> StateF s (\a -> Page s -> Pair a (Page s)) x -> Page s -> Pair x (Page s)
stateStep p pg = case p of
  Get k -> case pg of
    MkPage n st done -> MkPair (k st) pg
  Put st x -> case pg of
    MkPage n old done -> MkPair x (MkPage n st done)

traceH :: {s :: Type} -> s -> Handler (plus dom (state s))
traceH s0 =
  { M = \a -> Page s -> Pair a (Page s)
  , ret = \x pg -> MkPair x pg
  , bind = \m k pg -> case m pg of
      MkPair x pg2 -> k x pg2
  , malg = \p pg -> case p of
      InL d -> domStep d pg
      InR st -> stateStep st pg
  }

-- what an app does to the page, when it starts
rendering :: Co (plus dom (state Int)) Unit -> String
rendering app = case handle (traceH 0) app (MkPage 0 0 "") of
  MkPair u pg -> case pg of
    MkPage n st done -> done

test counter/renders
-- >>> rendering counter
-- "create p; text 1 count: 0; append 0 1; create button; text 2 +1; append 0 2; on click; "
