-- `-x` is the prelude's `neg`, by its key, whatever the module names
-- so: its own `neg`, and a local named so, are not the `-`'s.

module test.surface.negation-own-neg

neg : String
neg = "own"

-- | >>> flipped 3
-- | -3
flipped : Int -> Int
flipped x = -x

-- | >>> local 4 "no"
-- | MkPair (-4) "no"
local : Int -> String -> Pair Int String
local x neg = MkPair (-x) neg
