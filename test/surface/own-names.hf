-- A module's own definition comes first: before an import's it writes,
-- and before builtin's, the prelude's and `List`'s, which it has without
-- writing them.  Here a `do` is the module's own `bind`'s, not co's;
-- `id` is the module's, the prelude's `P.id`; `map` the module's, the
-- lists' `List.map`.

import co
import prelude as Prelude

-- | a value, and how many steps made it
type Counted a = Pair Int a

bind : {a b : Type} -> Counted a -> (a -> Counted b) -> Counted b
bind (MkPair n x) k = case k x of
  MkPair m y -> MkPair (n + m + 1) y

-- | >>> steps
-- | MkPair 2 3
steps : Counted Int
steps = do
  x <- MkPair 0 1
  y <- MkPair 0 (x + 1)
  MkPair 0 (x + y)

-- | >>> id (Prelude.id 1)
-- | 2
-- | >>> List.map id [1, 2]
-- | Cons 2 (Cons 3 Nil)
id : Int -> Int
id n = n + 1

-- | >>> map id 0
-- | 2
map : (Int -> Int) -> Int -> Int
map f n = f (f n)
