-- A record type among a struct's fields may name the definition being
-- elaborated, as a sum's variants may: the record type is nominative, so
-- the recursion is guarded by its name.  Inside the struct the earlier
-- types are abstract: values go through the module's own makers (`m.mk`).

theory MOD where
  tok : Type
  mk : Int -> tok
  lexed : Type
  lex : String -> lexed
  toks : lexed -> List tok

-- | >>> List.map (\(t : m.tok) -> t.k) (m.toks (m.lex "abcde"))
-- | Cons 5 Nil
m : MOD
m =
  { tok = { k : Int }
  , mk = \i -> { k = i }
  , lexed = { ts : List m.tok }
  , lex = \s -> { ts = [m.mk (strLength s)] }
  , toks = \l -> l.ts
  }
