import prelude

-- a nested pattern in a case alternative
second : List Int -> Int
second xs = case xs of
  Cons _ (Cons y _) -> y
  _ -> 0

-- >>> second [1, 2, 3]
-- 2
-- >>> second [1]
-- 0

-- a literal alternative, with a default
sayOf : Int -> String
sayOf n = case n of
  0 -> "zero"
  1 -> "one"
  _ -> "many"

-- >>> sayOf 0
-- "zero"
-- >>> sayOf 7
-- "many"

-- nesting two constructors deep, and the scrutinee an expression
data Shape = Dot | Box Int Int

area : Maybe Shape -> Int
area m = case m of
  Just (Box w h) -> w * h
  Just Dot -> 1
  Nothing -> 0

-- >>> area (Just (Box 3 4))
-- 12
-- >>> area (Just Dot)
-- 1
-- >>> area Nothing
-- 0

-- the scrutinee is computed once: effects would double otherwise
pairUp : List Int -> Int
pairUp xs = case reverse xs of
  Cons a (Cons b _) -> a + b
  Cons a Nil -> a
  Nil -> 0

-- >>> pairUp [1, 2, 3]
-- 5

-- a field named as a later equation names the whole: the later equation
-- still means the whole
data Tagged = MkTagged String Int

data Boxed = MkBoxed Tagged Int

weight : Boxed -> Int
weight (MkBoxed (MkTagged "light" n) _) = n
weight n = case n of
  MkBoxed (MkTagged _ k) j -> k * 10 + j

-- >>> weight (MkBoxed (MkTagged "light" 7) 3)
-- 7
-- >>> weight (MkBoxed (MkTagged "heavy" 7) 3)
-- 73
