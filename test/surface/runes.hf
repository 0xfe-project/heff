-- Runes: a literal is a `Rune`, whatever its type is checked at, of one
-- character or an escape -- a string's, and `\u{...}`, a code point in
-- hexadecimal -- non-ASCII and beyond U+FFFF too; a name's prime is no
-- quote.  Rune literals are patterns, in equations and in `case`,
-- compared by code point; `runes` and `ofRunes` take a string apart into
-- its code points and put it together again.

import rune as R

letter : Rune
letter = 'a'

escapes : List Rune
escapes = ['\n', '\t', '\r', '\'', '\\', '\"', '\u{41}', '\u{1F600}']

wide : List Rune
wide = ['é', '中', '😀', '\u{10FFFF}']

-- (a literal whose type is not given is a `Rune` still)
inferred : String
inferred = let c = '😀' in R.show c

-- (primes in names, beside literals)
x' : Int
x' = 1

x'' : Rune -> Int
x'' c = R.toInt c + x'

f : Int -> Int
f n = n + x'

applied : Int
applied = f x' + x'' 'b'

-- (literal patterns, in equations)
kind : Rune -> String
kind ' ' = "space"
kind '\n' = "newline"
kind 'é' = "e acute"
kind '😀' = "grin"
kind c = if R.isDigit c then "digit" else "other"

-- (and in `case`)
bracket : Rune -> Maybe Rune
bracket c = case c of
  '(' -> Just ')'
  '[' -> Just ']'
  '{' -> Just '}'
  _ -> Nothing

-- (a string's runes, counted: a code point each, a surrogate pair one)
count : String -> Int
count s = List.length (runes s)

roundTrip : String -> Bool
roundTrip s = strEq (ofRunes (runes s)) s

-- >>> letter
-- 'a'

-- >>> List.map R.show escapes
-- ["'\\n'", "'\\t'", "'\\r'", "'\\''", "'\\\\'", "'\"'", "'A'", "'😀'"]

-- >>> List.map R.toInt wide
-- [233, 20013, 128512, 1114111]

-- >>> inferred
-- "'😀'"

-- >>> applied
-- 101

-- >>> List.map kind [' ', '\n', 'é', '😀', '7', 'x']
-- ["space", "newline", "e acute", "grin", "digit", "other"]

-- >>> List.map bracket ['(', '{', 'x']
-- [Just ')', Just '}', Nothing]

-- >>> List.map count ["", "abc", "héllo", "a😀b", "中文"]
-- [0, 3, 5, 3, 2]

-- >>> List.map strLength ["a😀b"]
-- [4]

-- >>> runes "a😀é"
-- ['a', '😀', 'é']

-- >>> List.map roundTrip ["", "plain", "héllo wörld", "😀 and 中文", "\n\t"]
-- [True, True, True, True, True]

-- (a surrogate not in a pair is read as U+FFFD; a rune that is no scalar
-- value is U+FFFD in a string)
-- >>> runes ("a" ^ fromCharCode 55357 ^ "b")
-- ['a', '\u{FFFD}', 'b']

-- >>> ofRunes [R.fromInt 55296, R.fromInt 1114112, R.fromInt -1]
-- "���"
