-- Runes: a literal is a `Rune`, whatever its type is checked at, of one
-- character or an escape -- a string's, and `\u{...}`, a code point in
-- hexadecimal -- non-ASCII and beyond U+FFFF too; a name's prime is no
-- quote.  Rune literals are patterns, in equations and in `case`,
-- compared by code point; `runes` and `ofRunes` take a string apart into
-- its code points and put it together again.

import rune as Rune

-- | >>> letter
-- | 'a'
letter : Rune
letter = 'a'

-- | >>> List.map Rune.show escapes
-- | ["'\\n'", "'\\t'", "'\\r'", "'\\''", "'\\\\'", "'\"'", "'A'", "'😀'"]
escapes : List Rune
escapes = ['\n', '\t', '\r', '\'', '\\', '\"', '\u{41}', '\u{1F600}']

-- | >>> List.map Rune.toInt wide
-- | [233, 20013, 128512, 1114111]
wide : List Rune
wide = ['é', '中', '😀', '\u{10FFFF}']

-- (a literal whose type is not given is a `Rune` still)
-- | >>> inferred
-- | "'😀'"
inferred : String
inferred = let c = '😀' in Rune.show c

-- (primes in names, beside literals)
x' : Int
x' = 1

x'' : Rune -> Int
x'' c = Rune.toInt c + x'

f : Int -> Int
f n = n + x'

-- | >>> applied
-- | 101
applied : Int
applied = f x' + x'' 'b'

-- (literal patterns, in equations)
-- | >>> List.map kind [' ', '\n', 'é', '😀', '7', 'x']
-- | ["space", "newline", "e acute", "grin", "digit", "other"]
kind : Rune -> String
kind ' ' = "space"
kind '\n' = "newline"
kind 'é' = "e acute"
kind '😀' = "grin"
kind c = if Rune.isDigit c then "digit" else "other"

-- (and in `case`)
-- | >>> List.map bracket ['(', '{', 'x']
-- | [Just ')', Just '}', Nothing]
bracket : Rune -> Maybe Rune
bracket c = case c of
  '(' -> Just ')'
  '[' -> Just ']'
  '{' -> Just '}'
  _ -> Nothing

-- (a string's runes, counted: a code point each, of one to four bytes)
-- | >>> List.map count ["", "abc", "héllo", "a😀b", "中文"]
-- | [0, 3, 5, 3, 2]
count : String -> Int
count s = List.length (runes s)

-- | >>> List.map roundTrip ["", "plain", "héllo wörld", "😀 and 中文", "\n\t"]
-- | [True, True, True, True, True]
roundTrip : String -> Bool
roundTrip s = strEq (ofRunes (runes s)) s

-- >>> List.map strLength ["a😀b", "é", "中"]
-- [6, 2, 3]

-- >>> runes "a😀é"
-- ['a', '😀', 'é']

-- (what is not UTF-8 is read as U+FFFD, one for each longest start of a
-- rune's bytes; a rune that is no scalar value is U+FFFD in a string)
-- >>> runes ("a" ^ fromByte 237 ^ fromByte 160 ^ fromByte 128 ^ "b" ^ fromByte 240 ^ fromByte 159 ^ fromByte 152)
-- ['a', '\u{FFFD}', '\u{FFFD}', '\u{FFFD}', 'b', '\u{FFFD}']

-- >>> ofRunes [Rune.fromInt 55296, Rune.fromInt 1114112, Rune.fromInt -1]
-- "���"
