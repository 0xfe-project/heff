-- The shared `with`s, `scoped` and `held`, from a module of no effect
-- of the system's: a number acquired from a state, held in a region of
-- its own, and released after the body -- the release's `put` seen
-- after the body's; an acquire that fails, thrown, the body not run; a
-- release that fails, thrown, the body's answer lost to it; and `held`,
-- of a thing always had, asking for no exception.

module test.surface.scoped

import co
import exception
import state
import resource

-- (a state of an `Int`)
intState : Handler (state Int)
intState =
  { M = \x -> Int -> Pair x Int
  , ret = \x st -> MkPair x st
  , bind = \m k st -> case m st of
      MkPair x st2 -> k x st2
  , malg = \p st -> case p of
      Get k -> MkPair (k st) st
      Put st2 x -> MkPair x st2
  }

-- (the state and one, acquired)
acquired : {e : HFunctor} -> {{st : state Int <: e}} -> Co e (Either String Int)
acquired = do
  n <- get
  pure (Right (n + 1))

-- (the thing released: ten times it, put)
released : {e : HFunctor}
         -> {{st : state Int <: e}}
         -> Int
         -> Co e (Either String Unit)
released n = do
  put (n * 10)
  pure (Right MkUnit)

-- (the thing, held: the body puts nought and gives one more than it)
holding : {e : HFunctor}
        -> {{st : state Int <: e}}
        -> {{ex : exception String <: e}}
        -> Co e Int
holding =
  scoped acquired released (\w -> do
  put 0
  pure (inside w + 1))

-- (no thing to be had)
refused : {e : HFunctor} -> Co e (Either String Int)
refused = pure (Left "no")

-- (a release that fails)
stuck : {e : HFunctor} -> Int -> Co e (Either String Unit)
stuck n = pure (Left "stuck")

-- (a body that puts nought)
nought : {e : HFunctor}
       -> {{st : state Int <: e}}
       -> {s : Type}
       -> With s Int
       -> Co e Int
nought w = do
  put 0
  pure (inside w)

-- (the thing always had: the state and one; let go of: ten times it)
had : {e : HFunctor} -> {{st : state Int <: e}} -> Co e Int
had = do
  n <- get
  pure (n + 1)

letGo : {e : HFunctor} -> {{st : state Int <: e}} -> Int -> Co e Unit
letGo n = put (n * 10)

-- (`c`, its throws heard, over the state)
tried : {a : Type}
      -> Co (exception String <+> state Int) a
      -> Int
      -> Pair (Either String a) Int
tried c = handle intState (attempt String c)

-- | >>> tried (holding (st := _) (ex := _)) 4
-- | MkPair (Right 6) 50
-- | >>> tried (scoped (ex := _) refused (released (st := _)) (nought (st := _))) 4
-- | MkPair (Left "no") 4
-- | >>> tried (scoped (ex := _) (acquired (st := _)) stuck (nought (st := _))) 4
-- | MkPair (Left "stuck") 0
-- | >>> handle intState (held (had (st := _)) (letGo (st := _)) (nought (st := _))) 4
-- | MkPair 5 50
run : Int -> Pair (Either String Int) Int
run = tried (holding (st := _) (ex := _))
