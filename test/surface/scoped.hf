-- The shared `with`, `scoped`, from a module of no effect of the
-- system's: a number acquired from a state, held in a region of its
-- own, and released after the body -- the release's `put` seen after
-- the body's; an acquire that fails, the body not run; a release that
-- fails, the body's answer lost to it.

import co
import state
import with

-- (a state of an `Int`)
intState : Handler (state Int)
intState =
  { M = \x -> Int -> Pair x Int
  , ret = \x st -> MkPair x st
  , bind = \m k st -> case m st of
      MkPair x st2 -> k x st2
  , malg = \p st -> case p of
      Get k -> MkPair (k st) st
      Put st2 x -> MkPair x st2
  }

-- (the state and one, acquired)
acquired : {e : HFunctor} -> {{st : state Int <: e}} -> Co e (Either String Int)
acquired = do
  n <- get
  pure (Right (n + 1))

-- (the thing released: ten times it, put)
released : {e : HFunctor}
         -> {{st : state Int <: e}}
         -> Int
         -> Co e (Either String Unit)
released n = do
  put (n * 10)
  pure (Right MkUnit)

-- (the thing, held: the body puts nought and gives one more than it)
held : {e : HFunctor} -> {{st : state Int <: e}} -> Co e (Either String Int)
held =
  scoped acquired released (\w -> do
  put 0
  pure (inside w + 1))

-- (no thing to be had)
refused : {e : HFunctor} -> Co e (Either String Int)
refused = pure (Left "no")

-- (a release that fails)
stuck : {e : HFunctor} -> Int -> Co e (Either String Unit)
stuck n = pure (Left "stuck")

-- (a body that puts nought)
nought : {e : HFunctor}
       -> {{st : state Int <: e}}
       -> {s : Type}
       -> With s Int
       -> Co e Int
nought w = do
  put 0
  pure (inside w)

-- | >>> handle intState (held (st := here (state Int))) 4
-- | MkPair (Right 6) 50
-- | >>> handle intState (scoped refused (released (st := here (state Int))) (nought (st := here (state Int)))) 4
-- | MkPair (Left "no") 4
-- | >>> handle intState (scoped (acquired (st := here (state Int))) stuck (nought (st := here (state Int)))) 4
-- | MkPair (Left "stuck") 0
run : Int -> Pair (Either String Int) Int
run = handle intState (held (st := here (state Int)))
