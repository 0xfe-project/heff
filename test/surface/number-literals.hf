-- Integer literals in hexadecimal (`0x`) and binary (`0b`), and digits
-- apart by `_`: of any integer type, as a decimal literal is, its range
-- checked the same way.

import int as I
import prelude
import uint16 as U16
import uint8 as U8

rtmNewlink : Int
rtmNewlink = 0x10

nlmFCreate : Int
nlmFCreate = 0x400

mask : UInt8
mask = 0xFF

flags : UInt8
flags = 0b1010_0101

million : Int
million = 1_000_000

wide : UInt16
wide = 0xBEEF

-- (in a pattern too)
kind : UInt8 -> String
kind 0x0A = "newline"
kind 0b0 = "zero"
kind _ = "other"

-- >>> 0x605
-- 1541

-- >>> 0XFF + 0b11 + 0B1
-- 259

-- >>> -0x10
-- -16

-- >>> million
-- 1000000

-- >>> I.or nlmFCreate 0x200
-- 1536

-- >>> map U8.show [mask, flags]
-- Cons "255" (Cons "165" Nil)

-- >>> U16.show wide
-- "48879"

-- >>> map kind [10, 0, 7]
-- Cons "newline" (Cons "zero" (Cons "other" Nil))

-- >>> 1_000.25
-- 1000.25
