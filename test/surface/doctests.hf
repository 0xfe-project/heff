-- Doc tests: a line `-- | >>> e` of the doc comment right above a
-- definition, checked after it -- it, and what is above it, in scope --
-- its expectation the `-- | ...` lines under it, up to the next doc
-- test or a blank line of the comment.

module test.surface.doctests

-- | a number, twice
-- | >>> twice 2
-- | 4
-- | >>> twice (twice 1)
-- | 4
-- |
-- | (the comment goes on after a blank line of it)
twice : Int -> Int
twice x = x + x

-- | a `data`'s doc tests have its tags
-- | >>> (Red : Color)
-- | Red
data Color = Red | Green

-- | a `type`'s, its fields
-- | >>> ({ x = 1, y = 2 } : Point).y
-- | 2
type Point = { x : Int, y : Int }

-- | an expectation over more than one line, compared by value
-- | >>> List.map twice [1, 2, 3]
-- | [ 2
-- | , 4
-- | , 6 ]
-- (a comment between the doc comment and the definition)
twiceAll : List Int -> List Int
twiceAll xs = List.map twice xs

-- a watch, of no one definition: what is above it
-- >>> twiceAll [1] ++ [twice 3]
-- [2, 6]
