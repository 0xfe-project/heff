-- A field of a record computed through a `case` (here, in `named` and
-- `fst`): what the value's fields are is not known while elaborating, but
-- the field's type is, depending on none of them.

import co
import test.surface.fresh

type R = { a : Int, b : Int }

pureR : R -> Co fresh R
pureR r = pure r

-- >>> (named (pureR { a = 1, b = 2 })).b
-- 2

pick : Bool -> R
pick c = if c then { a = 3, b = 4 } else { a = 5, b = 6 }

-- >>> (pick False).a + (pick True).b
-- 9
