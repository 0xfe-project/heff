-- Fresh names, an effect, and a handler that counts them: what some of
-- the tests here compute in.

module test.surface.fresh

import co

-- | The operation: a name, from a stem, not given before.
data FreshF (m : Type -> Type) x = Fresh String (String -> x)

fresh : HFunctor
fresh =
  { f = FreshF
  , hfmap = \m g p -> case p of
      Fresh s k -> Fresh s (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Fresh s k -> Fresh s k
  }

-- | Names, counted: `stem` and how many were given before it.
counting : Handler fresh
counting =
  { M = \a -> Int -> Pair a Int
  , ret = \x n -> MkPair x n
  , bind = \m k n -> case m n of
      MkPair x n2 -> k x n2
  , malg = \p n -> case p of
      Fresh stem k -> MkPair (k (stem ^ "%" ^ debug n)) (n + 1)
  }

-- | A computation of fresh names, its value.
named : {a : Type} -> Co fresh a -> a
named c = fst (handle counting c 0)
