%YAML 1.2
---
# Made from the VS Code extension's grammar: change that, and make
# this again (make bat).
name: heff
scope: source.heff
file_extensions:
  - hf
contexts:
  main:
    - include: doctest
    - include: watch
    - include: comments
    - include: strings
    - include: import
    - include: runes
    - include: signature
    - include: tokens
  doctest:
    # a doc test, a line of a doc comment: `-- | >>> e`, the rest of the line an expression
    - match: '(-- \|) (>>>)'
      captures:
        1: comment.line.documentation.heff
        2: keyword.other.watch.heff
      push: doctest-body
  doctest-body:
    - meta_content_scope: meta.watch.heff
    - match: '$'
      pop: true
    - include: comments
    - include: strings
    - include: runes
    - include: tokens
  watch:
    # a watch: `-- >>> e`, the rest of the line an expression
    - match: '(-- >>>)'
      captures:
        1: keyword.other.watch.heff
      push: watch-body
  watch-body:
    - meta_content_scope: meta.watch.heff
    - match: '$'
      pop: true
    - include: comments
    - include: strings
    - include: runes
    - include: tokens
  comments:
    - match: '--+ \|.*$'
      scope: comment.line.documentation.heff
    # two dashes or more, not followed by a symbol (`---` is a comment, `-->` and `--->` are operators)
    - match: '--+(?![!#$%&*+./<=>?@\\^|\-~:]).*$'
      scope: comment.line.double-dash.heff
    - include: blockComment
  blockComment:
    - match: '\{-'
      push: blockComment-body
  blockComment-body:
    - meta_scope: comment.block.heff
    - match: '-\}'
      pop: true
    - include: blockComment
  strings:
    - match: '"'
      push: strings-body
  strings-body:
    - meta_scope: string.quoted.double.heff
    - match: '"|$'
      pop: true
    - match: '\\u\{[0-9A-Fa-f]+\}|\\x[0-9A-Fa-f]{2}|\\.'
      scope: constant.character.escape.heff
  import:
    # an import, its line: `as` is a keyword there, `import a.b as M`
    - match: '^(import)(?![A-Za-z0-9_''])'
      captures:
        1: keyword.control.heff
      push: import-body
  import-body:
    - match: '$'
      pop: true
    - include: comments
    - match: '(?<![A-Za-z0-9_''./])as(?![A-Za-z0-9_''])'
      scope: keyword.control.heff
    - include: tokens
  runes:
    # a rune literal: a `'` where a token starts (in a name it is a prime), one character or an escape, and a `'`
    - match: '(?<![A-Za-z0-9_''])''(?:[^''\\\n]|(\\u\{[0-9A-Fa-f]+\}|\\.))'''
      scope: constant.character.heff
      captures:
        1: constant.character.escape.heff
  signature:
    # the name a signature declares, at the start of a line: `x : A`, not `x :: xs`
    - match: '^\s*([a-z_][A-Za-z0-9_'']*(?:/[A-Za-z][A-Za-z0-9_'']*)*)\s*(?=:(?![!#$%&*+./<=>?@\\^|\-~:]))'
      captures:
        1: entity.name.function.heff
    # an operator a signature declares: `(::) : A`
    - match: '^\s*\(([!#$%&*+./<=>?@\\^|\-~:]+)\)\s*(?=:(?![!#$%&*+./<=>?@\\^|\-~:]))'
      captures:
        1: entity.name.function.heff
  tokens:
    # a binary opens with `b[`: a `b` where a token starts, right before the `[` (`ab[x]` is a name and a list)
    - match: '(?<![A-Za-z0-9_''])b\['
      scope: punctuation.section.binary.begin.heff
    - match: '(?<![A-Za-z0-9_''])(data|type|theory|primitive|instance|import|case|of|if|then|else|do|where|let|mut|in|while|for|break|continue|return|try|catch|finally|test|abandon|infixl|infixr|infix)(?![A-Za-z0-9_''])'
      scope: keyword.control.heff
    # a built-in type, but not before a field: `Rune.toInt` is of a module imported as `Rune`
    - match: '(?<![A-Za-z0-9_''])(Type|Int|Float64|String|Rune|Array|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32)(?![A-Za-z0-9_''])(?!\.[A-Za-z])'
      scope: support.type.builtin.heff
    # a constructor, or a type: a name with a capital, going on over a `/` before a letter as any name does (`Bwd/elemAt`)
    - match: '(?<![A-Za-z0-9_''])[A-Z][A-Za-z0-9_'']*(?:/[A-Za-z][A-Za-z0-9_'']*)*'
      scope: entity.name.type.heff
    # a field: right after what it projects
    - match: '(?<=[A-Za-z0-9_''\)\]\}])\.[A-Za-z][A-Za-z0-9_'']*'
      scope: variable.other.member.heff
    - match: '(?<![A-Za-z0-9_''])[a-z_][A-Za-z0-9_'']*(?:/[A-Za-z][A-Za-z0-9_'']*)*'
      scope: variable.other.heff
    - match: '(?<![A-Za-z0-9_''])-?[0-9](?:_?[0-9])*\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?'
      scope: constant.numeric.float.heff
    - match: '(?<![A-Za-z0-9_''])-?(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)'
      scope: constant.numeric.integer.heff
    # an operator: symbols, stopped before `--` (`+--x` is `+` and a comment, `--->` is `-` and `-->`)
    - match: '[!#$%&*+./<=>?@\\^|\-~:](?:[!#$%&*+./<=>?@\\^|~:]|-(?!-))*'
      scope: keyword.operator.heff
    - match: ','
      scope: punctuation.separator.heff
    - match: '[\(\)\[\]\{\}]'
      scope: punctuation.section.brackets.heff
