{
  "comments": { "lineComment": "--", "blockComment": ["{-", "-}"] },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_']*(/[A-Za-z][A-Za-z0-9_']*)*",
  "indentationRules": {
    "increaseIndentPattern": "(\\S.*\\bwhere|\\b(of|do|let)|=|->)\\s*$",
    "decreaseIndentPattern": "^\\s*(in|then|else)\\b"
  }
}
