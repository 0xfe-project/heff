{
  "name": "heff",
  "displayName": "heff",
  "description": "heff .hf files: highlighting, and the heff language server (diagnostics, hover, go to definition, formatting)",
  "version": "0.3.0",
  "publisher": "heff",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "heff",
        "aliases": ["heff"],
        "extensions": [".hf"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "heff", "scopeName": "source.heff", "path": "./syntaxes/heff.tmLanguage.json" }
    ],
    "configuration": {
      "title": "heff",
      "properties": {
        "heff.serverPath": {
          "type": "string",
          "default": "",
          "description": "The heff executable, run as `<path> lsp --stdio`; a relative path is from the workspace's folder. Empty: `heff` on the PATH, else HEFF_HOME/bin/heff, else ~/.heff/bin/heff."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "bundle": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle",
    "package": "vsce package --allow-missing-repository"
  }
}
