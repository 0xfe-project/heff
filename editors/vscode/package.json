{
  "name": "heff",
  "displayName": "heff (Hippogriff)",
  "description": "Hippogriff .hg files: highlighting, and the hg language server (diagnostics, hover, go to definition, formatting)",
  "version": "0.1.0",
  "publisher": "heff",
  "license": "ISC",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Formatters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "heff",
        "aliases": ["Hippogriff", "heff"],
        "extensions": [".hg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "heff", "scopeName": "source.heff", "path": "./syntaxes/heff.tmLanguage.json" }
    ],
    "configuration": {
      "title": "heff",
      "properties": {
        "heff.serverPath": {
          "type": "string",
          "default": "",
          "description": "The path of heff's bin/hg.mjs, run as `node <path> lsp`. Empty: the repository's, relative to this extension (../../bin/hg.mjs), else the `hg` on the PATH (e.g. from `npm link`)."
        },
        "heff.nodePath": {
          "type": "string",
          "default": "node",
          "description": "The Node.js executable that runs the server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository"
  }
}
