{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "heff",
  "scopeName": "source.heff",
  "fileTypes": ["hf"],
  "patterns": [
    { "include": "#watch" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#import" },
    { "include": "#runes" },
    { "include": "#signature" },
    { "include": "#tokens" }
  ],
  "repository": {
    "watch": {
      "comment": "a doctest line: `-- >>> e`, the rest of the line an expression",
      "begin": "(-- >>>)",
      "beginCaptures": { "1": { "name": "keyword.other.watch.heff" } },
      "end": "$",
      "contentName": "meta.watch.heff",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#runes" },
        { "include": "#tokens" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.heff",
          "match": "--+ \\|.*$"
        },
        {
          "comment": "two dashes or more, not followed by a symbol (`---` is a comment, `-->` and `--->` are operators)",
          "name": "comment.line.double-dash.heff",
          "match": "--+(?![!#$%&*+./<=>?@\\\\^|\\-~:]).*$"
        },
        { "include": "#blockComment" }
      ]
    },
    "blockComment": {
      "name": "comment.block.heff",
      "begin": "\\{-",
      "end": "-\\}",
      "patterns": [{ "include": "#blockComment" }]
    },
    "strings": {
      "name": "string.quoted.double.heff",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [{ "name": "constant.character.escape.heff", "match": "\\\\u\\{[0-9A-Fa-f]+\\}|\\\\." }]
    },
    "import": {
      "comment": "an import, its line: `as` is a keyword there, `import a.b as M`",
      "begin": "^(import)(?![A-Za-z0-9_'])",
      "beginCaptures": { "1": { "name": "keyword.control.heff" } },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "name": "keyword.control.heff", "match": "(?<![A-Za-z0-9_'./])as(?![A-Za-z0-9_'])" },
        { "include": "#tokens" }
      ]
    },
    "runes": {
      "comment": "a rune literal: a `'` where a token starts (in a name it is a prime), one character or an escape, and a `'`",
      "name": "constant.character.heff",
      "match": "(?<![A-Za-z0-9_'])'(?:[^'\\\\\\n]|(\\\\u\\{[0-9A-Fa-f]+\\}|\\\\.))'",
      "captures": { "1": { "name": "constant.character.escape.heff" } }
    },
    "signature": {
      "patterns": [
        {
          "comment": "the name a signature declares, at the start of a line: `x : A`, not `x :: xs`",
          "match": "^\\s*([a-z_][A-Za-z0-9_']*(?:/[A-Za-z][A-Za-z0-9_']*)*)\\s*(?=:(?![!#$%&*+./<=>?@\\\\^|\\-~:]))",
          "captures": { "1": { "name": "entity.name.function.heff" } }
        },
        {
          "comment": "an operator a signature declares: `(::) : A`",
          "match": "^\\s*\\(([!#$%&*+./<=>?@\\\\^|\\-~:]+)\\)\\s*(?=:(?![!#$%&*+./<=>?@\\\\^|\\-~:]))",
          "captures": { "1": { "name": "entity.name.function.heff" } }
        }
      ]
    },
    "tokens": {
      "patterns": [
        {
          "name": "keyword.control.heff",
          "match": "(?<![A-Za-z0-9_'])(data|type|theory|primitive|import|case|of|if|then|else|do|where|let|in|test|abandon|infixl|infixr|infix)(?![A-Za-z0-9_'])"
        },
        {
          "name": "support.type.builtin.heff",
          "match": "(?<![A-Za-z0-9_'])(Type|Int|Float|String|Rune|Array|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32)(?![A-Za-z0-9_'])"
        },
        {
          "comment": "a constructor, or a type: a name with a capital, going on over a `/` before a letter as any name does (`Bwd/elemAt`)",
          "name": "entity.name.type.heff",
          "match": "(?<![A-Za-z0-9_'])[A-Z][A-Za-z0-9_']*(?:/[A-Za-z][A-Za-z0-9_']*)*"
        },
        {
          "comment": "a field: right after what it projects",
          "name": "variable.other.member.heff",
          "match": "(?<=[A-Za-z0-9_'\\)\\]\\}])\\.[A-Za-z][A-Za-z0-9_']*"
        },
        {
          "name": "variable.other.heff",
          "match": "(?<![A-Za-z0-9_'])[a-z_][A-Za-z0-9_']*(?:/[A-Za-z][A-Za-z0-9_']*)*"
        },
        {
          "name": "constant.numeric.float.heff",
          "match": "(?<![A-Za-z0-9_'])-?[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?"
        },
        {
          "name": "constant.numeric.integer.heff",
          "match": "(?<![A-Za-z0-9_'])-?(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)"
        },
        {
          "comment": "an operator: symbols, stopped before `--` (`+--x` is `+` and a comment, `--->` is `-` and `-->`)",
          "name": "keyword.operator.heff",
          "match": "[!#$%&*+./<=>?@\\\\^|\\-~:](?:[!#$%&*+./<=>?@\\\\^|~:]|-(?!-))*"
        },
        {
          "name": "punctuation.separator.heff",
          "match": ","
        },
        {
          "name": "punctuation.section.brackets.heff",
          "match": "[\\(\\)\\[\\]\\{\\}]"
        }
      ]
    }
  }
}
