-- What heff says of a text that is wrong, or worth a word: a
-- diagnostic, where it is (`heff.render` lays it out).

import heff.params as P
import prelude

data Severity = SError | SWarning | SDebug

-- | a diagnostic: `code` is already offset into its family (lexer 0,
-- | reader 100, parser 200, elaborator 300); its message is plain text
type Diag =
  { code : Int
  , severity : Severity
  , msg : String
  , span : P.Span
  , note : Maybe String
  }
