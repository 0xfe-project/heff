-- Definitions by equations, and a `case` of nested patterns.  Each
-- equation is one case of an induction; they are compiled, as
-- presyntax, into the lambdas and matches Hippogriff has.  This module's `do`
-- sequences `Either Err`; the match compiler and its arms are the fields
-- of one record, `ck`.

import heff.elab.params as Pm
import heff.syntax.presyntax as Notation

type Err = { span : Pm.Span, msg : String }

mkErr : Pm.Span -> String -> Err
mkErr span msg = { span = span, msg = msg }

bind : {a b : Type} -> Either Err a -> (a -> Either Err b) -> Either Err b
bind (Left e) f = Left e
bind (Right x) f = f x

-- (a unit step in a chain, its type pinned)
bindU : Either Err Unit -> Either Err Unit
bindU e = e

badPat : {a : Type} -> Notation.Pat -> Either Err a
badPat p =
  Left
    (mkErr
       (Pm.spanOf p)
       "a pattern is a variable, a literal, a tag applied to patterns, or a record of patterns")

-- | a literal pattern is matched by the equality in scope for its kind
-- | a record pattern names the fields it matches
data MatchPat
  = PVar String
  | PTag String (List MatchPat) Pm.Span
  | PLit Notation.Pat
  | PRec (List (Pair String MatchPat)) Pm.Span
  -- | `x@p`
  | PAs String MatchPat

type Clause = { pats : List MatchPat, rhs : Notation.Checkable }

mkClause : List MatchPat -> Notation.Checkable -> Clause
mkClause pats rhs = { pats = pats, rhs = rhs }

appendC : {a : Type} -> List a -> List a -> List a
appendC Nil ys = ys
appendC (Cons x xs) ys = Cons x (appendC xs ys)

concatMapC : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapC f Nil = Nil
concatMapC f (Cons x xs) = appendC (f x) (concatMapC f xs)

catMaybesC : {a : Type} -> List (Maybe a) -> List a
catMaybesC Nil = Nil
catMaybesC (Cons (Just x) xs) = Cons x (catMaybesC xs)
catMaybesC (Cons Nothing xs) = catMaybesC xs

pure : {a : Type} -> a -> Either Err a
pure x = Right x

traverseC : {a b : Type} -> (a -> Either Err b) -> List a -> Either Err (List b)
traverseC f Nil = Right Nil
traverseC f (Cons x xs) = do
  y <- f x
  ys <- traverseC f xs
  pure (Cons y ys)

forC : {a : Type} -> List a -> (a -> Either Err Unit) -> Either Err Unit
forC Nil f = Right MkUnit
forC (Cons x xs) f = do
  u <- f x
  forC xs f

nthC : {a : Type} -> List a -> Int -> Maybe a
nthC Nil i = Nothing
nthC (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nthC xs (i - 1)

mapWithIndexC : {a b : Type} -> Int -> (Int -> a -> b) -> List a -> List b
mapWithIndexC i f Nil = Nil
mapWithIndexC i f (Cons x xs) = Cons (f i x) (mapWithIndexC (i + 1) f xs)

zipC : {a b : Type} -> List a -> List b -> List (Pair a b)
zipC (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipC xs ys)
zipC _ _ = Nil

anyC : {a : Type} -> (a -> Bool) -> List a -> Bool
anyC p Nil = False
anyC p (Cons x xs) = p x || anyC p xs

allC : {a : Type} -> (a -> Bool) -> List a -> Bool
allC p Nil = True
allC p (Cons x xs) = p x && allC p xs

nubStr : List String -> List String
nubStr Nil = Nil
nubStr (Cons x xs) = Cons x (nubStr (List.filter (\y -> not (strEq y x)) xs))

upToGo : Int -> Int -> List Int
upToGo i n = if i >= n then Nil else Cons i (upToGo (i + 1) n)

-- | 0, 1, ..., n - 1
upTo : Int -> List Int
upTo n = upToGo 0 n

dropAt : {a : Type} -> Int -> List a -> List a
dropAt i Nil = Nil
dropAt i (Cons x xs) = if i == 0 then xs else Cons x (dropAt (i - 1) xs)

takeC : {a : Type} -> Int -> List a -> List a
takeC n Nil = Nil
takeC n (Cons x xs) = if n <= 0 then Nil else Cons x (takeC (n - 1) xs)

dropC : {a : Type} -> Int -> List a -> List a
dropC n Nil = Nil
dropC n (Cons x xs) = if n <= 0 then Cons x xs else dropC (n - 1) xs

-- | replace the element at `i` by `ys`
spliceAt : {a : Type} -> Int -> List a -> List a -> List a
spliceAt i ys xs = appendC (takeC i xs) (appendC ys (dropC (i + 1) xs))

-- | (`pat`, the knot: a record's fields are patterns)
fieldPat : (Notation.Pat -> Either Err MatchPat)
         -> Notation.FieldPat Notation.Pat
         -> Either Err (Pair String MatchPat)
fieldPat pt (MkFieldPat x p) = do
  q <- pt p
  pure (MkPair x q)

-- | >>> (\(e : Either Err MatchPat) -> 1) (pat (At (PatVar "x") Pm.noSpan))
-- | 1
pat : Notation.Pat -> Either Err MatchPat
pat p = case Pm.nodeOf p of
  PatVar x -> Right (PVar x)
  PatTag t tsp ps -> do
    qs <- traverseC (\m -> pat m) ps
    pure (PTag t qs tsp)
  PatInt _ -> Right (PLit p)
  PatString _ -> Right (PLit p)
  PatRune _ -> Right (PLit p)
  PatFloat _ -> Right (PLit p)
  PatRecord fs -> do
    fps <- traverseC (\f -> fieldPat (\m -> pat m) f) fs
    pure (PRec fps (Pm.spanOf p))
  PatAs x _ q -> do
    q' <- pat q
    pure (PAs x q')
  _ -> badPat p

-- | the equality a literal is matched by where the type of what it
-- | matches is not known
equalityOf : Notation.Pat -> String
equalityOf (At (PatString _) _) = "strEq"
equalityOf (At (PatRune _) _) = "runeEq"
equalityOf (At (PatFloat _) _) = "floatEq"
equalityOf _ = "intEq"

sameLit : Notation.Pat -> Notation.Pat -> Bool
sameLit (At (PatInt x) _) (At (PatInt y) _) = x == y
sameLit (At (PatString x) _) (At (PatString y) _) = strEq x y
sameLit (At (PatRune x) _) (At (PatRune y) _) = x == y
sameLit (At (PatFloat x) _) (At (PatFloat y) _) = floatEq x y
sameLit _ _ = False

-- | a literal pattern, as the expression it is compared to
litExpr : Notation.Pat -> Notation.Checkable
litExpr (At (PatInt x) sp) = Notation.chkOf (At (IInt x) sp)
litExpr (At (PatString x) sp) = Notation.chkOf (At (IString x) sp)
litExpr (At (PatRune x) sp) = Notation.chkOf (At (IRune x) sp)
litExpr (At (PatFloat x) sp) = Notation.chkOf (At (IFloat x) sp)
litExpr (At _ sp) = At CAbandon sp

-- | `f p ... = e`
equation : Pm.Spanned (Notation.Equation Notation.Checkable)
         -> Either Err Clause
equation (At (MkEquation _ _ ps rhs) _) = do
  pats <- traverseC (\m -> pat m) ps
  pure (mkClause pats rhs)

varOf : MatchPat -> Maybe String
varOf (PVar x) = Just x
varOf (PAs x _) = Just x
varOf _ = Nothing

patVars : MatchPat -> List String
patVars (PVar x) = Cons x Nil
patVars (PTag _ ps _) = concatMapC (\p -> patVars p) ps
patVars (PLit _) = Nil
patVars (PRec fps _) = concatMapC (\fp -> patVars (snd fp)) fps
patVars (PAs x p) = Cons x (patVars p)

-- Names written
--------------------------------------------------------------------------------

-- | the names a pattern has, as written (an operator's, a record's
-- | fields' too)
patIdents : Notation.Pat -> List String
patIdents p = case Pm.nodeOf p of
  PatVar x -> Cons x Nil
  PatTag _ _ ps -> concatMapC (\m -> patIdents m) ps
  PatOp x _ ps -> Cons x (concatMapC (\m -> patIdents m) ps)
  PatAs x _ q -> Cons x (patIdents q)
  PatRecord fs ->
    concatMapC
      (\f -> case f of
       MkFieldPat x q -> Cons x (patIdents q))
      fs
  _ -> Nil

-- | the names a term has: every name it uses or binds (a field's, set
-- | or declared, and a named argument's too)
type Idents =
  { inf : Notation.Inferable -> List String
  , chk : Notation.Checkable -> List String
  , typ : Notation.TypeForm -> List String
  , decl : Notation.Declaration -> List String
  }

argIdents : Idents
          -> Pm.Spanned (Notation.Arg Notation.Checkable)
          -> List String
argIdents r (At (ArgExplicit c) _) = r.chk c
argIdents r (At (ArgProject _) _) = Nil
argIdents r (At (ArgNamed x c) _) = Cons x (r.chk c)

piIdents : Idents
         -> Notation.PiBinder Notation.TypeForm Notation.Checkable
         -> List String
piIdents r (PiNamed x _ t) = Cons x (r.typ t)
piIdents r (PiImplicit x _ _ t d) =
  Cons x (appendC (r.typ t) (maybe Nil (\c -> r.chk c) d))
piIdents r (PiInstance x _ _ t) = Cons x (r.typ t)
piIdents r (PiAnon d) = r.typ d

altIdents : Idents
          -> Pm.Spanned (Notation.Alt Notation.Checkable)
          -> List String
altIdents r (At (MkAlt p b) _) = appendC (patIdents p) (r.chk b)

paramIdents : Idents
            -> Pm.Spanned (Notation.Param Notation.TypeForm)
            -> List String
paramIdents r (At (ExplicitParam x _ t) _) = Cons x (r.typ t)
paramIdents r (At (ImplicitParam x _ t) _) = Cons x (r.typ t)

equationIdents : Idents
               -> Pm.Spanned (Notation.Equation Notation.Checkable)
               -> List String
equationIdents r (At (MkEquation f _ ps rhs) _) =
  Cons f (appendC (concatMapC (\m -> patIdents m) ps) (r.chk rhs))

identsInfF : Idents -> Notation.Inferable -> List String
identsInfF r n = case Pm.nodeOf n of
  IVar x -> Cons x Nil
  IApp h args -> appendC (r.inf h) (concatMapC (argIdents r) args)
  IAnn c t -> appendC (r.chk c) (r.typ t)
  ISpec a _ _ v -> appendC (r.inf a) (r.chk v)
  IAnnLam x _ t b -> Cons x (appendC (r.typ t) (r.inf b))
  INominal i -> r.inf i
  ILitEq x _ eq lit -> Cons x (Cons eq (r.chk lit))
  _ -> Nil

identsChkF : Idents -> Notation.Checkable -> List String
identsChkF r n = case Pm.nodeOf n of
  CInf i -> r.inf i
  CType t -> r.typ t
  CLam x _ b -> Cons x (r.chk b)
  CImplicitLam x _ b -> Cons x (r.chk b)
  CAnnLam x _ t b -> Cons x (appendC (r.typ t) (r.chk b))
  CTag _ _ args -> concatMapC r.chk args
  CStruct fs ->
    concatMapC
      (\f -> case Pm.nodeOf f of
       SetField x _ e -> Cons x (r.chk e)
       BadFieldSet e -> r.chk e)
      fs
  CMatch s alts -> appendC (r.inf s) (concatMapC (\a -> altIdents r a) alts)
  CLetIn rhs a -> appendC (r.inf rhs) (altIdents r a)
  CLocal body ds -> appendC (r.chk body) (concatMapC r.decl ds)
  CAbandon -> Nil
  CNominal c -> r.chk c

identsTypF : Idents -> Notation.TypeForm -> List String
identsTypF r n = case Pm.nodeOf n of
  TPi b cod -> appendC (piIdents r b) (r.typ cod)
  TSig fs ->
    concatMapC
      (\f -> case Pm.nodeOf f of
       DeclareField x _ t d ->
         Cons x (appendC (r.typ t) (maybe Nil (\c -> r.chk c) d))
       BadFieldDecl e -> r.typ e)
      fs
  TSum vs ->
    concatMapC
      (\v -> case Pm.nodeOf v of
       TagVariant _ _ args -> concatMapC r.typ args
       BadVariant e -> r.typ e)
      vs
  TArray a -> r.typ a
  TInf i -> r.inf i
  TChk c -> r.chk c
  TNominal t -> r.typ t
  _ -> Nil

identsDeclF : Idents -> Notation.Declaration -> List String
identsDeclF r d = case Pm.nodeOf d of
  DeclEquations f _ ty eqs ->
    Cons f (appendC (r.typ ty) (concatMapC (\m -> equationIdents r m) eqs))
  DeclDefine x _ ps u body ->
    Cons
      x
      (appendC
         (concatMapC (\m -> paramIdents r m) ps)
         (appendC (r.typ u) (r.chk body)))
  DeclTheory x _ ps body ->
    Cons x (appendC (concatMapC (\m -> paramIdents r m) ps) (r.chk body))
  DeclPrimitive x _ t -> Cons x (r.typ t)
  DeclTest x _ -> Cons x Nil
  DeclWatch e -> r.chk e

idents : Idents
idents =
  { inf = \n -> identsInfF idents n
  , chk = \n -> identsChkF idents n
  , typ = \n -> identsTypF idents n
  , decl = \d -> identsDeclF idents d
  }

identsOf : Notation.Checkable -> List String
identsOf n = idents.chk n

fresh : List String -> String -> String
fresh used x = if List.elemBy strEq x used then fresh used (x ^ "'") else x

-- Renaming
--------------------------------------------------------------------------------

-- | the variables a pattern binds (an operator is a tag, a field's name
-- | a label: neither is bound)
patBinds : Notation.Pat -> List String
patBinds p = case Pm.nodeOf p of
  PatVar x -> Cons x Nil
  PatTag _ _ ps -> concatMapC (\m -> patBinds m) ps
  PatOp _ _ ps -> concatMapC (\m -> patBinds m) ps
  PatAs x _ q -> Cons x (patBinds q)
  PatRecord fs ->
    concatMapC
      (\f -> case f of
       MkFieldPat _ q -> patBinds q)
      fs
  _ -> Nil

binds : String -> Notation.Pat -> Bool
binds x p = List.elemBy strEq x (patBinds p)

-- | `x` becomes `v` in each item, until one binds `x` again: `f` renames
-- | an item, `b` says whether it binds `x` for those after it
renameSeq : {a : Type} -> (a -> a) -> (a -> Bool) -> List a -> List a
renameSeq f b Nil = Nil
renameSeq f b (Cons m rest) =
  Cons (f m) (if b m then rest else renameSeq f b rest)

-- | the variable `x` as `v`, in each kind of term (the knot)
type Renamer =
  { x : String
  , v : String
  , inf : Notation.Inferable -> Notation.Inferable
  , chk : Notation.Checkable -> Notation.Checkable
  , typ : Notation.TypeForm -> Notation.TypeForm
  }

-- | `p -> e`: `x` is `v` in `e`, unless `p` binds `x`
renameAlt : Renamer
          -> Pm.Spanned (Notation.Alt Notation.Checkable)
          -> Pm.Spanned (Notation.Alt Notation.Checkable)
renameAlt r (At (MkAlt p b) sp) =
  if binds r.x p then At (MkAlt p b) sp else At (MkAlt p (r.chk b)) sp

renameArg : Renamer
          -> Pm.Spanned (Notation.Arg Notation.Checkable)
          -> Pm.Spanned (Notation.Arg Notation.Checkable)
renameArg r (At (ArgExplicit c) sp) = At (ArgExplicit (r.chk c)) sp
renameArg r (At (ArgNamed y c) sp) = At (ArgNamed y (r.chk c)) sp
renameArg r a = a

renameDefault : Renamer -> Maybe Notation.Checkable -> Maybe Notation.Checkable
renameDefault r Nothing = Nothing
renameDefault r (Just c) = Just (r.chk c)

renameField : Renamer
            -> Pm.Spanned
              (Notation.FieldDecl Notation.TypeForm Notation.Checkable)
            -> Pm.Spanned
              (Notation.FieldDecl Notation.TypeForm Notation.Checkable)
renameField r (At (DeclareField y ysp t d) sp) =
  At (DeclareField y ysp (r.typ t) (renameDefault r d)) sp
renameField r (At (BadFieldDecl e) sp) = At (BadFieldDecl (r.typ e)) sp

fieldBinds : String
           -> Pm.Spanned
             (Notation.FieldDecl Notation.TypeForm Notation.Checkable)
           -> Bool
fieldBinds x (At (DeclareField y _ _ _) _) = strEq x y
fieldBinds x (At (BadFieldDecl _) _) = False

renameEquation : Renamer
               -> Pm.Spanned (Notation.Equation Notation.Checkable)
               -> Pm.Spanned (Notation.Equation Notation.Checkable)
renameEquation r (At (MkEquation f fsp ps rhs) sp) =
  if anyC (binds r.x) ps then At (MkEquation f fsp ps rhs) sp
  else At (MkEquation f fsp ps (r.chk rhs)) sp

renameParam : Renamer
            -> Pm.Spanned (Notation.Param Notation.TypeForm)
            -> Pm.Spanned (Notation.Param Notation.TypeForm)
renameParam r (At (ExplicitParam y ysp t) sp) =
  At (ExplicitParam y ysp (r.typ t)) sp
renameParam r (At (ImplicitParam y ysp t) sp) =
  At (ImplicitParam y ysp (r.typ t)) sp

paramBinds : String -> Pm.Spanned (Notation.Param Notation.TypeForm) -> Bool
paramBinds x (At (ExplicitParam y _ _) _) = strEq x y
paramBinds x (At (ImplicitParam y _ _) _) = strEq x y

-- | a local definition: its type is outside it, its name binds in its
-- | equations (and in what follows, which the caller sees to)
renameDecl : Renamer -> Notation.Declaration -> Notation.Declaration
renameDecl r d = case d of
  At (DeclEquations f fsp ty eqs) sp ->
    At
      (DeclEquations
         f
         fsp
         (r.typ ty)
         (if strEq r.x f then eqs else List.map (renameEquation r) eqs))
      sp
  At (DeclDefine y ysp ps u body) sp ->
    if strEq r.x y then d
    else At
        (DeclDefine
           y
           ysp
           (renameSeq (renameParam r) (paramBinds r.x) ps)
           (if anyC (paramBinds r.x) ps then u else r.typ u)
           (if anyC (paramBinds r.x) ps then body else r.chk body))
        sp
  At (DeclTheory y ysp ps body) sp ->
    if strEq r.x y then d
    else At
        (DeclTheory
           y
           ysp
           (renameSeq (renameParam r) (paramBinds r.x) ps)
           (if anyC (paramBinds r.x) ps then body else r.chk body))
        sp
  At (DeclPrimitive y ysp t) sp -> At (DeclPrimitive y ysp (r.typ t)) sp
  At (DeclWatch e) sp -> At (DeclWatch (r.chk e)) sp
  _ -> d

declBinds : String -> Notation.Declaration -> Bool
declBinds x d = case Notation.declName d of
  Just y -> strEq x y
  Nothing -> False

renamePi : Renamer
         -> Notation.PiBinder Notation.TypeForm Notation.Checkable
         -> Notation.PiBinder Notation.TypeForm Notation.Checkable
renamePi r (PiNamed y ysp t) = PiNamed y ysp (r.typ t)
renamePi r (PiImplicit y ysp bsp t d) =
  PiImplicit y ysp bsp (r.typ t) (renameDefault r d)
renamePi r (PiInstance y ysp bsp t) = PiInstance y ysp bsp (r.typ t)
renamePi r (PiAnon d) = PiAnon (r.typ d)

piBinds : String
        -> Notation.PiBinder Notation.TypeForm Notation.Checkable
        -> Bool
piBinds x (PiNamed y _ _) = strEq x y
piBinds x (PiImplicit y _ _ _ _) = strEq x y
piBinds x (PiInstance y _ _ _) = strEq x y
piBinds x (PiAnon _) = False

renameInfF : Renamer -> Notation.Inferable -> Notation.Inferable
renameInfF r n = case n of
  At (IVar y) sp -> if strEq y r.x then At (IVar r.v) sp else n
  At (IApp h args) sp -> At (IApp (r.inf h) (List.map (renameArg r) args)) sp
  At (IAnn c t) sp -> At (IAnn (r.chk c) (r.typ t)) sp
  At (ISpec a f fsp val) sp -> At (ISpec (r.inf a) f fsp (r.chk val)) sp
  -- (the type of an annotated lambda's binder is outside it)
  At (IAnnLam y ysp t b) sp ->
    At (IAnnLam y ysp (r.typ t) (if strEq y r.x then b else r.inf b)) sp
  At (INominal i) sp -> At (INominal (r.inf i)) sp
  At (ILitEq y ysp eq lit) sp ->
    At (ILitEq (if strEq y r.x then r.v else y) ysp eq (r.chk lit)) sp
  _ -> n

renameChkF : Renamer -> Notation.Checkable -> Notation.Checkable
renameChkF r n = case n of
  At (CInf i) sp -> At (CInf (r.inf i)) sp
  At (CType t) sp -> At (CType (r.typ t)) sp
  At (CLam y ysp b) sp ->
    if strEq y r.x then n else At (CLam y ysp (r.chk b)) sp
  At (CImplicitLam y ysp b) sp ->
    if strEq y r.x then n else At (CImplicitLam y ysp (r.chk b)) sp
  At (CAnnLam y ysp t b) sp ->
    At (CAnnLam y ysp (r.typ t) (if strEq y r.x then b else r.chk b)) sp
  At (CTag t tsp args) sp -> At (CTag t tsp (List.map r.chk args)) sp
  At (CStruct fs) sp ->
    At
      (CStruct
         (List.map
            (\f -> case f of
             At (SetField y ysp e) fsp -> At (SetField y ysp (r.chk e)) fsp
             At (BadFieldSet e) fsp -> At (BadFieldSet (r.chk e)) fsp)
            fs))
      sp
  At (CMatch s alts) sp ->
    At (CMatch (r.inf s) (List.map (renameAlt r) alts)) sp
  At (CLetIn rhs a) sp -> At (CLetIn (r.inf rhs) (renameAlt r a)) sp
  At (CLocal body ds) sp ->
    At
      (CLocal
         (if anyC (declBinds r.x) ds then body else r.chk body)
         (renameSeq (renameDecl r) (declBinds r.x) ds))
      sp
  At (CNominal c) sp -> At (CNominal (r.chk c)) sp
  _ -> n

renameTypF : Renamer -> Notation.TypeForm -> Notation.TypeForm
renameTypF r n = case n of
  At (TPi b cod) sp ->
    At (TPi (renamePi r b) (if piBinds r.x b then cod else r.typ cod)) sp
  At (TSig fs) sp ->
    At (TSig (renameSeq (renameField r) (fieldBinds r.x) fs)) sp
  At (TSum vs) sp ->
    At
      (TSum
         (List.map
            (\m -> case m of
             At (TagVariant t tsp args) vsp ->
               At (TagVariant t tsp (List.map r.typ args)) vsp
             At (BadVariant e) vsp -> At (BadVariant (r.typ e)) vsp)
            vs))
      sp
  At (TArray a) sp -> At (TArray (r.typ a)) sp
  At (TInf i) sp -> At (TInf (r.inf i)) sp
  At (TChk c) sp -> At (TChk (r.chk c)) sp
  At (TNominal t) sp -> At (TNominal (r.typ t)) sp
  _ -> n

renamer : String -> String -> Renamer
renamer x v =
  { x = x
  , v = v
  , inf = \n -> renameInfF (renamer x v) n
  , chk = \n -> renameChkF (renamer x v) n
  , typ = \n -> renameTypF (renamer x v) n
  }

-- | the variable `x` becomes `v` wherever it is not bound again (`v` is
-- | fresh: nothing binds it); a field's name, set or declared, and a
-- | named argument's are labels, not variables
rename : String -> String -> Notation.Checkable -> Notation.Checkable
rename x v n = (renamer x v).chk n

-- | a variable pattern `p` matched against the variable `v`: `p` means `v`
bindVar : String -> MatchPat -> Notation.Checkable -> Notation.Checkable
bindVar v (PVar x) e =
  if not (strEq x "_") && not (strEq x v) then rename x v e else e
bindVar v _ e = e

isTagP : MatchPat -> Bool
isTagP (PTag _ _ _) = True
isTagP _ = False

isLitP : MatchPat -> Bool
isLitP (PLit _) = True
isLitP _ = False

isRecP : MatchPat -> Bool
isRecP (PRec _ _) = True
isRecP _ = False

type TagRow =
  { tag : String, arity : Int, pats : List MatchPat, span : Pm.Span }

tagOf : MatchPat -> Maybe TagRow
tagOf (PTag t ps s) =
  Just { tag = t, arity = List.length ps, pats = ps, span = s }
tagOf _ = Nothing

patAt : Int -> Clause -> MatchPat
patAt c r = case nthC r.pats c of
  Just p -> p
  Nothing -> PVar "_"

-- | the match compiler, knotted with its arms
type CK =
  { compile :
        List String
        -> List String
        -> Pm.Span
        -> List String
        -> List Clause
        -> Either Err Notation.Checkable
  }

findTagLit : List MatchPat -> Int -> Maybe Int
findTagLit Nil i = Nothing
findTagLit (Cons p rest) i =
  if isTagP p || isLitP p || isRecP p then Just i else findTagLit rest (i + 1)

nubTagRows : List TagRow -> List TagRow
nubTagRows Nil = Nil
nubTagRows (Cons t rest) =
  Cons
    t
    (nubTagRows (List.filter (\(u : TagRow) -> not (strEq t.tag u.tag)) rest))

-- | (`bound`: every variable the match has bound so far, those taken
-- | apart too -- an equation further down may still mean one of them,
-- | so no field takes its name)
armSubName : List String
           -> List String
           -> String
           -> Int
           -> Maybe String
           -> String
armSubName used bound v i (Just x) =
  if not (strEq x "_") && not (List.elemBy strEq x bound) then x
  else fresh (appendC used bound) (v ^ showInt (i + 1))
armSubName used bound v i Nothing =
  fresh (appendC used bound) (v ^ showInt (i + 1))

-- | the fields' names: those the first equation of the tag uses
armSub : List String -> List String -> TagRow -> String -> Int -> String
armSub used bound t v i = case nthC t.pats i of
  Just p -> armSubName used bound v i (varOf p)
  Nothing -> fresh (appendC used bound) (v ^ showInt (i + 1))

armFields : List String -> List String -> TagRow -> String -> List String
armFields used bound t v =
  List.map (\i -> armSub used bound t v i) (upTo t.arity)

badArity : Int -> TagRow -> Clause -> Bool
badArity c t row = case patAt c row of
  PTag t' ps _ -> strEq t' t.tag && not (List.length ps == t.arity)
  _ -> False

arityCheck : Pm.Span -> List Clause -> Int -> TagRow -> Either Err Unit
arityCheck sp rows c t =
  if anyC (\row -> badArity c t row) rows
    then Left
        (mkErr t.span (t.tag ^ " is used with different numbers of arguments"))
  else Right MkUnit

armSpecializeV : Int
               -> TagRow
               -> List String
               -> String
               -> Clause
               -> Maybe Clause
armSpecializeV c t ys v r = case patAt c r of
  PTag t' ps _ ->
    if strEq t' t.tag then Just (mkClause (spliceAt c ps r.pats) r.rhs)
    else Nothing
  PVar x ->
    Just
      (mkClause
         (spliceAt c (List.map (\(y : String) -> PVar "_") ys) r.pats)
         (bindVar v (PVar x) r.rhs))
  PLit l ->
    Just
      (mkClause
         (spliceAt c (List.map (\(y : String) -> PVar "_") ys) r.pats)
         r.rhs)
  PRec _ _ -> Nothing
  -- (none: `compile` takes each `x@p` apart first)
  PAs _ _ -> Nothing

armOf : CK
      -> List String
      -> List String
      -> Pm.Span
      -> List String
      -> List Clause
      -> Int
      -> String
      -> TagRow
      -> Either Err (Pm.Spanned (Notation.Alt Notation.Checkable))
armOf r used bound sp vars rows c v t = do
  arityCheck sp rows c t
  body <-
    r.compile
      used
      (appendC (armFields used bound t v) bound)
      sp
      (spliceAt c (armFields used bound t v) vars)
      (catMaybesC
         (List.map
            (\row -> armSpecializeV c t (armFields used bound t v) v row)
            rows))
  pure
      (Notation.alt
         (Notation.patTag
            t.tag
            t.span
            (List.map (\y -> At (PatVar y) sp) (armFields used bound t v)))
         body)

litYesOne : Int
          -> Notation.Pat
          -> String
          -> Clause
          -> List Clause
          -> List Clause
litYesOne c l v r acc = case patAt c r of
  PLit l' ->
    if sameLit l l' then Cons (mkClause (dropAt c r.pats) r.rhs) acc else acc
  PVar x -> Cons (mkClause (dropAt c r.pats) (bindVar v (PVar x) r.rhs)) acc
  PTag _ _ _ -> acc
  PRec _ _ -> acc
  PAs _ _ -> acc

litYes : Int -> Notation.Pat -> String -> List Clause -> List Clause
litYes c l v Nil = Nil
litYes c l v (Cons r rest) = litYesOne c l v r (litYes c l v rest)

litNoOne : Int -> Notation.Pat -> Clause -> List Clause -> List Clause
litNoOne c l r acc = case patAt c r of
  PLit l' -> if sameLit l l' then acc else Cons r acc
  _ -> Cons r acc

litNo : Int -> Notation.Pat -> List Clause -> List Clause
litNo c l Nil = Nil
litNo c l (Cons r rest) = litNoOne c l r (litNo c l rest)

litChecks : Pm.Span
          -> List String
          -> List Clause
          -> Int
          -> Notation.Pat
          -> Either Err Unit
litChecks sp vars rows c l =
  bind
    (a := Unit)
    (if anyC (\row -> isTagP (patAt c row)) rows
       then Left
           (mkErr (Pm.spanOf l) "a literal and a tag match the same argument")
     else Right MkUnit)
    (\u1 ->
       if allC (\row -> isLitP (patAt c row)) rows
         then Left
             (mkErr
                (Pm.spanOf l)
                "literals are matched here: one of them must match every other value (a variable, or `_`)")
       else Right MkUnit)

varAt : List String -> Int -> String
varAt vars c = case nthC vars c of
  Just v -> v
  Nothing -> "_"

-- | a column of literals: equal to the first equation's, or not
literalOf : CK
          -> List String
          -> List String
          -> Pm.Span
          -> List String
          -> List Clause
          -> Int
          -> Notation.Pat
          -> Either Err Notation.Checkable
literalOf r used bound sp vars rows c l = do
  litChecks sp vars rows c l
  yesB <-
    r.compile used bound sp (dropAt c vars) (litYes c l (varAt vars c) rows)
  noB <- r.compile used bound sp vars (litNo c l rows)
  pure
      (At
         (CMatch
            (At
               (ILitEq (varAt vars c) sp (equalityOf l) (litExpr l))
               (Pm.spanOf l))
            [ Notation.alt (Notation.patTag "True" (Pm.spanOf l) Nil) yesB
            , Notation.alt (Notation.patTag "False" (Pm.spanOf l) Nil) noB
            ])
         (Pm.spanOf l))

noLitHere : Pm.Span -> Int -> List Clause -> Either Err Unit
noLitHere sp c rows =
  forC rows (\row -> case patAt c row of
  PLit l ->
    Left (mkErr (Pm.spanOf l) "a literal and a tag match the same argument")
  _ -> Right MkUnit)

clausePats : Clause -> List MatchPat
clausePats r = r.pats

clauseRhs : Clause -> Notation.Checkable
clauseRhs r = r.rhs

bindPair : Notation.Checkable -> Pair String MatchPat -> Notation.Checkable
bindPair e (MkPair v p) = bindVar v p e

defaultOf : CK
          -> List String
          -> List String
          -> Pm.Span
          -> List String
          -> List Clause
          -> Int
          -> List Clause
          -> Either Err (List (Pm.Spanned (Notation.Alt Notation.Checkable)))
defaultOf r used bound sp vars rows c Nil = Right Nil
defaultOf r used bound sp vars rows c rest = do
  b <-
    r.compile
      used
      bound
      sp
      (dropAt c vars)
      (List.map
         (\(row : Clause) ->
            mkClause
              (dropAt c row.pats)
              (bindVar (varAt vars c) (patAt c row) row.rhs))
         rest)
  pure (Cons (Notation.alt (At (PatVar "_") sp) b) Nil)

-- | rows whose column `c` is a variable go on in every other case
defaultArm : CK
           -> List String
           -> List String
           -> Pm.Span
           -> List String
           -> List Clause
           -> Int
           -> Either Err (List (Pm.Spanned (Notation.Alt Notation.Checkable)))
defaultArm r used bound sp vars rows c =
  defaultOf
    r
    used
    bound
    sp
    vars
    rows
    c
    (List.filter (\row -> not (isTagP (patAt c row))) rows)

-- Records
--------------------------------------------------------------------------------

recFieldsOf : MatchPat -> List (Pair String MatchPat)
recFieldsOf (PRec fps _) = fps
recFieldsOf _ = Nil

lookupField : String -> List (Pair String MatchPat) -> Maybe MatchPat
lookupField f Nil = Nothing
lookupField f (Cons (MkPair g p) rest) =
  if strEq f g then Just p else lookupField f rest

-- | a column of records matches no tag and no literal
noRecMix : List Clause -> Int -> Either Err Unit
noRecMix rows c =
  if anyC (\row -> isRecP (patAt c row)) rows
    then forC rows (\row -> case patAt c row of
      PTag _ _ sp ->
        Left (mkErr sp "a record and a tag match the same argument")
      PLit l ->
        Left
          (mkErr (Pm.spanOf l) "a record and a literal match the same argument")
      _ -> Right MkUnit)
  else Right MkUnit

-- | every field some equation names in column `c`, in order
recFieldNames : Int -> List Clause -> List String
recFieldNames c rows =
  nubStr
    (concatMapC
       (\row -> List.map (\fp -> fst fp) (recFieldsOf (patAt c row)))
       rows)

-- | the variable the first equation naming field `f` binds it to
recFieldVar : Int -> List Clause -> String -> Maybe String
recFieldVar c rows f = case catMaybesC
    (List.map (\row -> lookupField f (recFieldsOf (patAt c row))) rows) of
  Cons p _ -> varOf p
  Nil -> Nothing

-- | the name of field `f`'s column: that variable, unless it is `_` or
-- | bound already, else (a fresh) `f`
recSubName : List String -> List String -> Maybe String -> String -> String
recSubName used bound (Just x) f =
  if not (strEq x "_") && not (List.elemBy strEq x bound) then x
  else fresh (appendC used bound) f
recSubName used bound Nothing f = fresh (appendC used bound) f

recSubs : List String -> List String -> Int -> List Clause -> List String
recSubs used bound c rows =
  List.map
    (\f -> recSubName used bound (recFieldVar c rows f) f)
    (recFieldNames c rows)

orWildcard : Maybe MatchPat -> MatchPat
orWildcard (Just p) = p
orWildcard Nothing = PVar "_"

-- | a row, its column `c` the fields `fs` (`_` those it does not name)
recSpecialize : Int -> List String -> String -> Clause -> Clause
recSpecialize c fs v r = case patAt c r of
  PRec fps _ ->
    mkClause
      (spliceAt c (List.map (\f -> orWildcard (lookupField f fps)) fs) r.pats)
      r.rhs
  _ ->
    mkClause
      (spliceAt c (List.map (\(f : String) -> PVar "_") fs) r.pats)
      (bindVar v (patAt c r) r.rhs)

-- | `let y = v.f in e`, each field's column bound to its projection
letFields : Pm.Span
          -> String
          -> List (Pair String String)
          -> Notation.Checkable
          -> Notation.Checkable
letFields sp v Nil body = body
letFields sp v (Cons (MkPair f y) rest) body =
  At
    (CLetIn
       (Notation.infApp (At (IVar v) sp) [At (ArgProject f) sp])
       (Notation.alt (At (PatVar y) sp) (letFields sp v rest body)))
    sp

-- | a column of records: a column for each field named, bound to its
-- | projection
recordOf : CK
         -> List String
         -> List String
         -> Pm.Span
         -> List String
         -> List Clause
         -> Int
         -> Either Err Notation.Checkable
recordOf r used bound sp vars rows c = do
  noRecMix rows c
  body <-
    r.compile
      used
      (appendC (recSubs used bound c rows) bound)
      sp
      (spliceAt c (recSubs used bound c rows) vars)
      (List.map
         (\row -> recSpecialize c (recFieldNames c rows) (varAt vars c) row)
         rows)
  pure
      (letFields
         sp
         (varAt vars c)
         (zipC (recFieldNames c rows) (recSubs used bound c rows))
         body)

compileAt : CK
          -> List String
          -> List String
          -> Pm.Span
          -> List String
          -> List Clause
          -> Int
          -> MatchPat
          -> Either Err Notation.Checkable
compileAt r used bound sp vars rows c (PLit l) = do
  noRecMix rows c
  literalOf r used bound sp vars rows c l
compileAt r used bound sp vars rows c (PRec _ _) =
  recordOf r used bound sp vars rows c
compileAt r used bound sp vars rows c p = do
  noRecMix rows c
  noLitHere sp c rows
  arms <-
    traverseC
      (\t -> armOf r used bound sp vars rows c (varAt vars c) t)
      (nubTagRows (catMaybesC (List.map (\row -> tagOf (patAt c row)) rows)))
  dflt <- defaultArm r used bound sp vars rows c
  pure (At (CMatch (At (IVar (varAt vars c)) sp) (appendC arms dflt)) sp)

-- | `x@p` matched against the variable `v`: `p`, and `x` means `v`
peelAs : String
       -> MatchPat
       -> Notation.Checkable
       -> Pair MatchPat Notation.Checkable
peelAs v (PAs x p) e = peelAs v p (bindVar v (PVar x) e)
peelAs v p e = MkPair p e

consPat : MatchPat -> Clause -> Clause
consPat p r = mkClause (Cons p r.pats) r.rhs

-- | a row, no column of it `x@p`
peelCols : List String -> List MatchPat -> Notation.Checkable -> Clause
peelCols (Cons v vs) (Cons p ps) e = case peelAs v p e of
  MkPair p' e' -> consPat p' (peelCols vs ps e')
peelCols _ ps e = mkClause ps e

peelRow : List String -> Clause -> Clause
peelRow vars r = peelCols vars r.pats r.rhs

compilePeeled : CK
              -> List String
              -> List String
              -> Pm.Span
              -> List String
              -> List Clause
              -> Either Err Notation.Checkable
compilePeeled r used bound sp vars rows = case rows of
  -- unreachable: a missing tag is the match's error
  Nil -> Right (At CAbandon sp)
  Cons row rest -> case findTagLit (clausePats row) 0 of
    -- the first equation matches whatever is left: it is the answer
    Nothing ->
      Right
        (List.foldl
           (\e vp -> bindPair e vp)
           (clauseRhs row)
           (zipC vars (clausePats row)))
    Just c -> compileAt r used bound sp vars rows c (patAt c row)

-- | the match tree for `rows` over the variables `vars`, column by column
compileF : CK
         -> List String
         -> List String
         -> Pm.Span
         -> List String
         -> List Clause
         -> Either Err Notation.Checkable
compileF r used bound sp vars rows =
  compilePeeled r used bound sp vars (List.map (\row -> peelRow vars row) rows)

ck : CK
ck =
  { compile = \used bound sp vars rows -> compileF ck used bound sp vars rows }

rowVar : Clause -> Int -> Maybe String
rowVar r i = case nthC r.pats i of
  Just p -> varOf p
  Nothing -> Nothing

colPick : List String -> Int -> List String -> String
colPick used i (Cons x Nil) =
  if strEq x "_" then fresh used ("x" ^ showInt (i + 1)) else x
colPick used i xs = fresh used ("x" ^ showInt (i + 1))

colFrom : List String -> List Clause -> Int -> String
colFrom used rows i =
  colPick used i (nubStr (catMaybesC (List.map (\r -> rowVar r i) rows)))

-- | the name of a column: the parameter's, else the one its equations
-- | use, else a fresh one
colName : List String -> List String -> List Clause -> Int -> String
colName used params rows i = case nthC params i of
  Just p -> p
  Nothing -> colFrom used rows i

foldr2 : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr2 f z Nil = z
foldr2 f z (Cons x xs) = f x (foldr2 f z xs)

desugarBody : String
            -> List String
            -> Pm.Span
            -> List Clause
            -> Int
            -> List String
            -> Either Err Notation.Checkable
desugarBody f params sp rows arity used = do
  body <-
    ck.compile
      used
      (List.map (\i -> colName used params rows i) (upTo arity))
      sp
      (List.map (\i -> colName used params rows i) (upTo arity))
      rows
  pure
      (foldr2
         (\x b -> Notation.chkLam x sp b)
         body
         (dropC
            (List.length params)
            (List.map (\i -> colName used params rows i) (upTo arity))))

-- | the body of `f` from its equations: `params` are the parameters
-- | named in the head of the definition
desugar : String
        -> List String
        -> List (Pm.Spanned (Notation.Equation Notation.Checkable))
        -> Pm.Span
        -> Either Err Notation.Checkable
desugar f params eqNs sp = do
  rows <- traverseC (\n -> equation n) eqNs
  arity <- case rows of
    Nil -> Left (mkErr sp "a definition by equations needs an equation")
    Cons r rest -> Right (List.length r.pats)
  forC
      rows
      (\(r : Clause) ->
         if not (List.length r.pats == arity)
           then Left
               (mkErr
                  (Pm.spanOf r.rhs)
                  ("every equation of `"
                   ^ f
                   ^ "` has "
                   ^ showInt arity
                   ^ " pattern(s)"))
         else Right MkUnit)
  u2 <-
    bindU
      (if arity < List.length params
         then Left
             (mkErr
                sp
                ("the equations of `"
                 ^ f
                 ^ "` match fewer arguments than it names"))
       else Right MkUnit)
  desugarBody
      f
      params
      sp
      rows
      arity
      (appendC
         (concatMapC
            (\(r : Clause) ->
               appendC (concatMapC (\p -> patVars p) r.pats) (identsOf r.rhs))
            rows)
         (appendC params (Cons f Nil)))

-- | a `case` whose alternatives match nested patterns: compiled like the
-- | equations, over one column -- a fresh name for the scrutinee
type CaseTree = { scrutinee : String, tree : Notation.Checkable }

caseAlt : Pm.Spanned (Notation.Alt Notation.Checkable) -> Either Err Clause
caseAlt (At (MkAlt p rhs) _) = do
  p' <- pat p
  pure (mkClause (Cons p' Nil) rhs)

-- | (`used`: the names the alternatives have, which no name the match
-- | makes may be)
caseTreeOf : Pm.Span
           -> List Clause
           -> List String
           -> String
           -> Either Err CaseTree
caseTreeOf sp rows used x = do
  tree <- ck.compile (Cons x used) [x] sp [x] rows
  pure { scrutinee = x, tree = tree }

caseNames : List Clause -> List String
caseNames rows =
  concatMapC
    (\(r : Clause) ->
       appendC (concatMapC (\p -> patVars p) r.pats) (identsOf r.rhs))
    rows

caseTree : Pm.Span
         -> List (Pm.Spanned (Notation.Alt Notation.Checkable))
         -> Either Err CaseTree
caseTree sp altNs = do
  rows <- traverseC (\n -> caseAlt n) altNs
  caseTreeOf sp rows (caseNames rows) (fresh (caseNames rows) "it")
