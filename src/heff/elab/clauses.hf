-- Definitions by equations, and a `case` of nested patterns.  Each
-- equation is one case of an induction; they are compiled, as
-- presyntax, into the lambdas and matches Hippogriff has.  This module's `do`
-- sequences `Either Err`; the match compiler and its arms are the fields
-- of one record, `ck`.

module heff.elab.clauses

import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import std.ordmap as OrdMap

type Err = { span : Params.Span, msg : String }

mkErr : Params.Span -> String -> Err
mkErr span msg = { span = span, msg = msg }

bind : {a b : Type} -> Either Err a -> (a -> Either Err b) -> Either Err b
bind (Left e) f = Left e
bind (Right x) f = f x

-- (a unit step in a chain, its type pinned)
bindU : Either Err Unit -> Either Err Unit
bindU e = e

badPat : {a : Type} -> Presyntax.Pat -> Either Err a
badPat p =
  Left
    (mkErr
       (Params.spanOf p)
       "a pattern is a variable, a literal, a tag applied to patterns, or a record of patterns")

-- | a segment of a binary pattern: what it holds (a name, `_`, a number
-- | or a string), what it is, its size, its flags (the prelude's
-- | `bytesIntAt`'s)
type BinSeg =
  { value : Presyntax.Pat
  , ty : Presyntax.SegmentType
  , size : Presyntax.SegmentSize
  , flags : Int
  , span : Params.Span
  }

binSeg : Params.Spanned (Presyntax.Segment Presyntax.Pat) -> BinSeg
binSeg (At (MkSegment v ty size little signed) sp) =
  { value = v
  , ty = ty
  , size = size
  , flags = Presyntax.segmentFlags little signed
  , span = sp
  }

-- | the name a segment binds, if it binds one
valueName : Presyntax.Pat -> Maybe String
valueName (At (PatVar x) _) = if strEq x "_" then Nothing else Just x
valueName _ = Nothing

segName : BinSeg -> Maybe String
segName s = valueName s.value

-- | the name a segment's size is, if it is one
sizeNameOf : Presyntax.SegmentSize -> Maybe String
sizeNameOf (SizeName x _ _) = Just x
sizeNameOf _ = Nothing

sizeName : BinSeg -> Maybe String
sizeName s = sizeNameOf s.size

-- | a literal pattern is matched by the equality in scope for its kind
-- | a record pattern names the fields it matches
data MatchPat
  = PVar String
  | PTag String (List MatchPat) Params.Span
  | PLit Presyntax.Pat
  | PRec (List (Pair String MatchPat)) Params.Span
  -- | `x@p`
  | PAs String MatchPat
  -- | `b[...]`, a binary taken apart by its segments
  | PBin (List BinSeg) Params.Span

-- (a binary pattern of one segment: `b[x::binary]`, a name for them
-- all, is that name)
soleBin : BinSeg
        -> Presyntax.Pat
        -> Presyntax.SegmentType
        -> Presyntax.SegmentSize
        -> Params.Span
        -> MatchPat
soleBin s (At (PatVar x) _) SegmentBinary SizeDefault sp = PVar x
soleBin s v ty size sp = PBin (Cons s Nil) sp

binPat : List BinSeg -> Params.Span -> MatchPat
binPat (Cons s Nil) sp = soleBin s s.value s.ty s.size sp
binPat segs sp = PBin segs sp

type Clause = { pats : List MatchPat, rhs : Presyntax.Checkable }

mkClause : List MatchPat -> Presyntax.Checkable -> Clause
mkClause pats rhs = { pats = pats, rhs = rhs }

appendC : {a : Type} -> List a -> List a -> List a
appendC Nil ys = ys
appendC (Cons x xs) ys = Cons x (appendC xs ys)

concatMapC : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapC f Nil = Nil
concatMapC f (Cons x xs) = appendC (f x) (concatMapC f xs)

catMaybesC : {a : Type} -> List (Maybe a) -> List a
catMaybesC Nil = Nil
catMaybesC (Cons (Just x) xs) = Cons x (catMaybesC xs)
catMaybesC (Cons Nothing xs) = catMaybesC xs

pure : {a : Type} -> a -> Either Err a
pure x = Right x

traverseC : {a b : Type} -> (a -> Either Err b) -> List a -> Either Err (List b)
traverseC = traverse (mo := instanceMonadEither)

forC : {a : Type} -> List a -> (a -> Either Err Unit) -> Either Err Unit
forC Nil f = Right MkUnit
forC (Cons x xs) f = do
  u <- f x
  forC xs f

nthC : {a : Type} -> List a -> Int -> Maybe a
nthC Nil i = Nothing
nthC (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nthC xs (i - 1)

mapWithIndexC : {a b : Type} -> Int -> (Int -> a -> b) -> List a -> List b
mapWithIndexC i f Nil = Nil
mapWithIndexC i f (Cons x xs) = Cons (f i x) (mapWithIndexC (i + 1) f xs)

zipC : {a b : Type} -> List a -> List b -> List (Pair a b)
zipC (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipC xs ys)
zipC _ _ = Nil

anyC : {a : Type} -> (a -> Bool) -> List a -> Bool
anyC p Nil = False
anyC p (Cons x xs) = p x || anyC p xs

allC : {a : Type} -> (a -> Bool) -> List a -> Bool
allC p Nil = True
allC p (Cons x xs) = p x && allC p xs

nubStr : List String -> List String
nubStr Nil = Nil
nubStr (Cons x xs) = Cons x (nubStr (List.keepIf (\y -> not (strEq y x)) xs))

upToGo : Int -> Int -> List Int
upToGo i n = if i >= n then Nil else Cons i (upToGo (i + 1) n)

-- | 0, 1, ..., n - 1
upTo : Int -> List Int
upTo n = upToGo 0 n

dropAt : {a : Type} -> Int -> List a -> List a
dropAt i Nil = Nil
dropAt i (Cons x xs) = if i == 0 then xs else Cons x (dropAt (i - 1) xs)

takeC : {a : Type} -> Int -> List a -> List a
takeC n Nil = Nil
takeC n (Cons x xs) = if n <= 0 then Nil else Cons x (takeC (n - 1) xs)

dropC : {a : Type} -> Int -> List a -> List a
dropC n Nil = Nil
dropC n (Cons x xs) = if n <= 0 then Cons x xs else dropC (n - 1) xs

-- | replace the element at `i` by `ys`
spliceAt : {a : Type} -> Int -> List a -> List a -> List a
spliceAt i ys xs = appendC (takeC i xs) (appendC ys (dropC (i + 1) xs))

-- | (`pat`, the knot: a record's fields are patterns)
fieldPat : (Presyntax.Pat -> Either Err MatchPat)
         -> Presyntax.FieldPat Presyntax.Pat
         -> Either Err (Pair String MatchPat)
fieldPat pt (MkFieldPat x p) = do
  q <- pt p
  pure (MkPair x q)

-- | >>> (\(e : Either Err MatchPat) -> 1) (pat (At (PatVar "x") Params.noSpan))
-- | 1
pat : Presyntax.Pat -> Either Err MatchPat
pat (At (PatVar x) _) = Right (PVar x)
pat (At (PatTag t tsp ps) _) = do
  qs <- traverseC (\m -> pat m) ps
  pure (PTag t qs tsp)
pat p@(At (PatInt _) _) = Right (PLit p)
pat p@(At (PatString _) _) = Right (PLit p)
pat (At (PatBinary segs) sp) = Right (binPat (List.map binSeg segs) sp)
pat p@(At (PatRune _) _) = Right (PLit p)
pat p@(At (PatFloat _) _) = Right (PLit p)
pat p@(At (PatRecord fs) _) = do
  fps <- traverseC (\f -> fieldPat (\m -> pat m) f) fs
  pure (PRec fps (Params.spanOf p))
pat (At (PatAs x _ q) _) = do
  q' <- pat q
  pure (PAs x q')
pat p = badPat p

-- | the equality a literal is matched by where the type of what it
-- | matches is not known
equalityOf : Presyntax.Pat -> String
equalityOf (At (PatString _) _) = "strEq"
equalityOf (At (PatRune _) _) = "runeEq"
equalityOf (At (PatFloat _) _) = "floatEq"
equalityOf _ = "intEq"

sameLit : Presyntax.Pat -> Presyntax.Pat -> Bool
sameLit (At (PatInt x) _) (At (PatInt y) _) = x == y
sameLit (At (PatString x) _) (At (PatString y) _) = strEq x y
sameLit (At (PatRune x) _) (At (PatRune y) _) = x == y
sameLit (At (PatFloat x) _) (At (PatFloat y) _) = floatEq x y
sameLit _ _ = False

-- | a literal pattern, as the expression it is compared to
litExpr : Presyntax.Pat -> Presyntax.Checkable
litExpr (At (PatInt x) sp) = Presyntax.chkOf (At (IInt x) sp)
litExpr (At (PatString x) sp) = Presyntax.chkOf (At (IString x) sp)
litExpr (At (PatRune x) sp) = Presyntax.chkOf (At (IRune x) sp)
litExpr (At (PatFloat x) sp) = Presyntax.chkOf (At (IFloat x) sp)
litExpr (At _ sp) = At CAbandon sp

-- | `f p ... = e`
equation : Params.Spanned (Presyntax.Equation Presyntax.Checkable)
         -> Either Err Clause
equation (At (MkEquation _ _ ps rhs) _) = do
  pats <- traverseC (\m -> pat m) ps
  pure (mkClause pats rhs)

varOf : MatchPat -> Maybe String
varOf (PVar x) = Just x
varOf (PAs x _) = Just x
varOf _ = Nothing

patVars : MatchPat -> List String
patVars (PVar x) = Cons x Nil
patVars (PTag _ ps _) = concatMapC (\p -> patVars p) ps
patVars (PLit _) = Nil
patVars (PRec fps _) = concatMapC (\fp -> patVars (snd fp)) fps
patVars (PAs x p) = Cons x (patVars p)
-- (and the names its sizes are: no name the match makes is one of them)
patVars (PBin segs _) =
  appendC
    (catMaybesC (List.map segName segs))
    (catMaybesC (List.map sizeName segs))

-- Names written
--------------------------------------------------------------------------------

-- (Each of these puts the names it finds before `acc`, in no order and
-- some more than once: they are only asked whether they have a name.)

-- | `f` of each of `xs`, before `acc`
namesOfAll : {a : Type}
           -> (a -> List String -> List String)
           -> List a
           -> List String
           -> List String
namesOfAll f Nil acc = acc
namesOfAll f (Cons x xs) acc = namesOfAll f xs (f x acc)

-- | the names a pattern has, as written (an operator's, a record's
-- | fields' too)
patIdents : Presyntax.Pat -> List String -> List String
patIdents (At (PatVar x) _) acc = Cons x acc
patIdents (At (PatTag _ _ ps) _) acc = namesOfAll (\m a -> patIdents m a) ps acc
patIdents (At (PatOp x _ ps) _) acc =
  Cons x (namesOfAll (\m a -> patIdents m a) ps acc)
patIdents (At (PatAs x _ q) _) acc = Cons x (patIdents q acc)
patIdents (At (PatRecord fs) _) acc =
  namesOfAll
    (\f a -> case f of
     MkFieldPat x q -> Cons x (patIdents q a))
    fs
    acc
patIdents (At (PatBinary segs) _) acc =
  namesOfAll
    (\m a -> case m of
     At (MkSegment v _ size _ _) _ ->
       patIdents v (appendC (catMaybesC [sizeNameOf size]) a))
    segs
    acc
patIdents p acc = acc

-- | the names a term has: every name it uses or binds (a field's, set
-- | or declared, and a named argument's too)
type Idents =
  { inf : Presyntax.Inferable -> List String -> List String
  , chk : Presyntax.Checkable -> List String -> List String
  , typ : Presyntax.TypeForm -> List String -> List String
  , decl : Presyntax.Declaration -> List String -> List String
  }

argIdents : Idents
          -> Params.Spanned (Presyntax.Arg Presyntax.Checkable)
          -> List String
          -> List String
argIdents r (At (ArgExplicit c) _) acc = r.chk c acc
argIdents r (At (ArgProject _) _) acc = acc
argIdents r (At (ArgNamed x c) _) acc = Cons x (r.chk c acc)
argIdents r (At (ArgEvidence x) _) acc = Cons x acc

defaultIdents : Idents
              -> Maybe Presyntax.Checkable
              -> List String
              -> List String
defaultIdents r Nothing acc = acc
defaultIdents r (Just c) acc = r.chk c acc

piIdents : Idents
         -> Presyntax.PiBinder Presyntax.TypeForm Presyntax.Checkable
         -> List String
         -> List String
piIdents r (PiNamed x _ t) acc = Cons x (r.typ t acc)
piIdents r (PiImplicit x _ _ t d) acc = Cons x (r.typ t (defaultIdents r d acc))
piIdents r (PiInstance x _ _ t) acc = Cons x (r.typ t acc)
piIdents r (PiAnon d) acc = r.typ d acc

altIdents : Idents
          -> Params.Spanned (Presyntax.Alt Presyntax.Checkable)
          -> List String
          -> List String
altIdents r (At (MkAlt p b) _) acc = patIdents p (r.chk b acc)

paramIdents : Idents
            -> Params.Spanned (Presyntax.Param Presyntax.TypeForm)
            -> List String
            -> List String
paramIdents r (At (ExplicitParam x _ t) _) acc = Cons x (r.typ t acc)
paramIdents r (At (ImplicitParam x _ t) _) acc = Cons x (r.typ t acc)

equationIdents : Idents
               -> Params.Spanned (Presyntax.Equation Presyntax.Checkable)
               -> List String
               -> List String
equationIdents r (At (MkEquation f _ ps rhs) _) acc =
  Cons f (namesOfAll (\m a -> patIdents m a) ps (r.chk rhs acc))

setIdents : Idents
          -> Params.Spanned (Presyntax.FieldSet Presyntax.Checkable)
          -> List String
          -> List String
setIdents r (At (SetField x _ e) _) acc = Cons x (r.chk e acc)
setIdents r (At (BadFieldSet e) _) acc = r.chk e acc

updateIdents : Idents
             -> Params.Spanned (Presyntax.UpdateSet Presyntax.Checkable)
             -> List String
             -> List String
updateIdents r (At (SetPath path e) _) acc =
  List.append
    (List.map (\(f : Pair String Params.Span) -> fst f) path)
    (r.chk e acc)

fieldIdents : Idents
            -> Params.Spanned
              (Presyntax.FieldDecl Presyntax.TypeForm Presyntax.Checkable)
            -> List String
            -> List String
fieldIdents r (At (DeclareField x _ t d) _) acc =
  Cons x (r.typ t (defaultIdents r d acc))
fieldIdents r (At (BadFieldDecl e) _) acc = r.typ e acc

variantIdents : Idents
              -> Params.Spanned (Presyntax.Variant Presyntax.TypeForm)
              -> List String
              -> List String
variantIdents r (At (TagVariant _ _ args) _) acc = namesOfAll r.typ args acc
variantIdents r (At (BadVariant e) _) acc = r.typ e acc

identsInfF : Idents -> Presyntax.Inferable -> List String -> List String
identsInfF r (At (IVar x) _) acc = Cons x acc
identsInfF r (At (IApp h args) _) acc =
  r.inf h (namesOfAll (argIdents r) args acc)
identsInfF r (At (IAnn c t) _) acc = r.chk c (r.typ t acc)
identsInfF r (At (ISpec a _ _ v) _) acc = r.inf a (r.chk v acc)
identsInfF r (At (IUpdate a fs) _) acc =
  r.inf a (namesOfAll (updateIdents r) fs acc)
identsInfF r (At (IAnnLam x _ t b) _) acc = Cons x (r.typ t (r.inf b acc))
identsInfF r (At (INominal i) _) acc = r.inf i acc
identsInfF r (At (ILitEq x _ eq lit) _) acc = Cons x (Cons eq (r.chk lit acc))
identsInfF r (At (ILazy c) _) acc = r.chk c acc
identsInfF r (At (ITuple cs) _) acc = List.foldr r.chk acc cs
identsInfF r n acc = acc

identsChkF : Idents -> Presyntax.Checkable -> List String -> List String
identsChkF r (At (CInf i) _) acc = r.inf i acc
identsChkF r (At (CType t) _) acc = r.typ t acc
identsChkF r (At (CLam x _ b) _) acc = Cons x (r.chk b acc)
identsChkF r (At (CImplicitLam x _ b) _) acc = Cons x (r.chk b acc)
identsChkF r (At (CAnnLam x _ t b) _) acc = Cons x (r.typ t (r.chk b acc))
identsChkF r (At (CTag _ _ args) _) acc = namesOfAll r.chk args acc
identsChkF r (At (CStruct fs) _) acc = namesOfAll (setIdents r) fs acc
identsChkF r (At (CMatch s alts) _) acc =
  r.inf s (namesOfAll (\a b -> altIdents r a b) alts acc)
identsChkF r (At (CLetIn rhs a) _) acc = r.inf rhs (altIdents r a acc)
identsChkF r (At (CLocal body ds) _) acc = r.chk body (namesOfAll r.decl ds acc)
identsChkF r (At CAbandon _) acc = acc
identsChkF r (At (CNominal c) _) acc = r.chk c acc

identsTypF : Idents -> Presyntax.TypeForm -> List String -> List String
identsTypF r (At (TPi b cod) _) acc = piIdents r b (r.typ cod acc)
identsTypF r (At (TSig fs) _) acc = namesOfAll (fieldIdents r) fs acc
identsTypF r (At (TSum vs) _) acc = namesOfAll (variantIdents r) vs acc
identsTypF r (At (TArray a) _) acc = r.typ a acc
identsTypF r (At (TInf i) _) acc = r.inf i acc
identsTypF r (At (TChk c) _) acc = r.chk c acc
identsTypF r (At (TNominal t) _) acc = r.typ t acc
identsTypF r n acc = acc

identsDeclF : Idents -> Presyntax.Declaration -> List String -> List String
identsDeclF r (At (DeclEquations f _ _ ty eqs) _) acc =
  Cons f (r.typ ty (namesOfAll (\m a -> equationIdents r m a) eqs acc))
identsDeclF r (At (DeclDefine x _ ps u body) _) acc =
  Cons x (namesOfAll (\m a -> paramIdents r m a) ps (r.typ u (r.chk body acc)))
identsDeclF r (At (DeclTheory x _ ps body) _) acc =
  Cons x (namesOfAll (\m a -> paramIdents r m a) ps (r.chk body acc))
identsDeclF r (At (DeclPrimitive x _ t) _) acc = Cons x (r.typ t acc)
identsDeclF r (At (DeclTest x _) _) acc = Cons x acc
identsDeclF r (At (DeclWatch e) _) acc = r.chk e acc

idents : Idents
idents =
  { inf = \n acc -> identsInfF idents n acc
  , chk = \n acc -> identsChkF idents n acc
  , typ = \n acc -> identsTypF idents n acc
  , decl = \d acc -> identsDeclF idents d acc
  }

-- | the names `n` has, before `acc`
identsOf : Presyntax.Checkable -> List String -> List String
identsOf n acc = idents.chk n acc

-- | the names a row has: its patterns' variables, its body's names,
-- | before `acc`
rowNames : Clause -> List String -> List String
rowNames r acc =
  namesOfAll (\p a -> appendC (patVars p) a) r.pats (identsOf r.rhs acc)

fresh : List String -> String -> String
fresh used x = if List.elemBy strEq x used then fresh used (x ^ "'") else x

-- | `fresh` of the names `used` and `bound` both, not put together
freshIn : List String -> List String -> String -> String
freshIn used bound x =
  if List.elemBy strEq x used || List.elemBy strEq x bound
  then freshIn used bound (x ^ "'")
  else x

-- Renaming
--------------------------------------------------------------------------------

-- | the variables a pattern binds (an operator is a tag, a field's name
-- | a label: neither is bound)
patBinds : Presyntax.Pat -> List String
patBinds (At (PatVar x) _) = Cons x Nil
patBinds (At (PatTag _ _ ps) _) = concatMapC (\m -> patBinds m) ps
patBinds (At (PatOp _ _ ps) _) = concatMapC (\m -> patBinds m) ps
patBinds (At (PatAs x _ q) _) = Cons x (patBinds q)
patBinds (At (PatRecord fs) _) =
  concatMapC
    (\f -> case f of
     MkFieldPat _ q -> patBinds q)
    fs
patBinds (At (PatBinary segs) _) =
  concatMapC
    (\m -> case m of
     At (MkSegment v _ _ _ _) _ -> patBinds v)
    segs
patBinds p = Nil

binds : String -> Presyntax.Pat -> Bool
binds x p = List.elemBy strEq x (patBinds p)

-- | `x` becomes `v` in each item, until one binds `x` again: `f` renames
-- | an item, `b` says whether it binds `x` for those after it
renameSeq : {a : Type} -> (a -> a) -> (a -> Bool) -> List a -> List a
renameSeq f b Nil = Nil
renameSeq f b (Cons m rest) =
  Cons (f m) (if b m then rest else renameSeq f b rest)

-- | the variable `x` as `v`, in each kind of term (the knot)
type Renamer =
  { x : String
  , v : String
  , inf : Presyntax.Inferable -> Presyntax.Inferable
  , chk : Presyntax.Checkable -> Presyntax.Checkable
  , typ : Presyntax.TypeForm -> Presyntax.TypeForm
  }

-- | `p -> e`: `x` is `v` in `e`, unless `p` binds `x`
renameAlt : Renamer
          -> Params.Spanned (Presyntax.Alt Presyntax.Checkable)
          -> Params.Spanned (Presyntax.Alt Presyntax.Checkable)
renameAlt r (At (MkAlt p b) sp) =
  if binds r.x p then At (MkAlt p b) sp else At (MkAlt p (r.chk b)) sp

renameArg : Renamer
          -> Params.Spanned (Presyntax.Arg Presyntax.Checkable)
          -> Params.Spanned (Presyntax.Arg Presyntax.Checkable)
renameArg r (At (ArgExplicit c) sp) = At (ArgExplicit (r.chk c)) sp
renameArg r (At (ArgNamed y c) sp) = At (ArgNamed y (r.chk c)) sp
renameArg r a = a

renameDefault : Renamer
              -> Maybe Presyntax.Checkable
              -> Maybe Presyntax.Checkable
renameDefault r Nothing = Nothing
renameDefault r (Just c) = Just (r.chk c)

renameField : Renamer
            -> Params.Spanned
              (Presyntax.FieldDecl Presyntax.TypeForm Presyntax.Checkable)
            -> Params.Spanned
              (Presyntax.FieldDecl Presyntax.TypeForm Presyntax.Checkable)
renameField r (At (DeclareField y ysp t d) sp) =
  At (DeclareField y ysp (r.typ t) (renameDefault r d)) sp
renameField r (At (BadFieldDecl e) sp) = At (BadFieldDecl (r.typ e)) sp

fieldBinds : String
           -> Params.Spanned
             (Presyntax.FieldDecl Presyntax.TypeForm Presyntax.Checkable)
           -> Bool
fieldBinds x (At (DeclareField y _ _ _) _) = strEq x y
fieldBinds x (At (BadFieldDecl _) _) = False

renameEquation : Renamer
               -> Params.Spanned (Presyntax.Equation Presyntax.Checkable)
               -> Params.Spanned (Presyntax.Equation Presyntax.Checkable)
renameEquation r (At (MkEquation f fsp ps rhs) sp) =
  if anyC (binds r.x) ps then At (MkEquation f fsp ps rhs) sp
  else At (MkEquation f fsp ps (r.chk rhs)) sp

renameParam : Renamer
            -> Params.Spanned (Presyntax.Param Presyntax.TypeForm)
            -> Params.Spanned (Presyntax.Param Presyntax.TypeForm)
renameParam r (At (ExplicitParam y ysp t) sp) =
  At (ExplicitParam y ysp (r.typ t)) sp
renameParam r (At (ImplicitParam y ysp t) sp) =
  At (ImplicitParam y ysp (r.typ t)) sp

paramBinds : String
           -> Params.Spanned (Presyntax.Param Presyntax.TypeForm)
           -> Bool
paramBinds x (At (ExplicitParam y _ _) _) = strEq x y
paramBinds x (At (ImplicitParam y _ _) _) = strEq x y

-- | a local definition: its type is outside it, its name binds in its
-- | equations (and in what follows, which the caller sees to)
renameDecl : Renamer -> Presyntax.Declaration -> Presyntax.Declaration
renameDecl r (At (DeclEquations f fsp declared ty eqs) sp) =
  At
    (DeclEquations
       f
       fsp
       declared
       (r.typ ty)
       (if strEq r.x f then eqs else List.map (renameEquation r) eqs))
    sp
renameDecl r d@(At (DeclDefine y ysp ps u body) sp) =
  if strEq r.x y then d
  else At
      (DeclDefine
         y
         ysp
         (renameSeq (renameParam r) (paramBinds r.x) ps)
         (if anyC (paramBinds r.x) ps then u else r.typ u)
         (if anyC (paramBinds r.x) ps then body else r.chk body))
      sp
renameDecl r d@(At (DeclTheory y ysp ps body) sp) =
  if strEq r.x y then d
  else At
      (DeclTheory
         y
         ysp
         (renameSeq (renameParam r) (paramBinds r.x) ps)
         (if anyC (paramBinds r.x) ps then body else r.chk body))
      sp
renameDecl r (At (DeclPrimitive y ysp t) sp) =
  At (DeclPrimitive y ysp (r.typ t)) sp
renameDecl r (At (DeclWatch e) sp) = At (DeclWatch (r.chk e)) sp
renameDecl r d = d

declBinds : String -> Presyntax.Declaration -> Bool
declBinds x d = case Presyntax.declName d of
  Just y -> strEq x y
  Nothing -> False

renamePi : Renamer
         -> Presyntax.PiBinder Presyntax.TypeForm Presyntax.Checkable
         -> Presyntax.PiBinder Presyntax.TypeForm Presyntax.Checkable
renamePi r (PiNamed y ysp t) = PiNamed y ysp (r.typ t)
renamePi r (PiImplicit y ysp bsp t d) =
  PiImplicit y ysp bsp (r.typ t) (renameDefault r d)
renamePi r (PiInstance y ysp bsp t) = PiInstance y ysp bsp (r.typ t)
renamePi r (PiAnon d) = PiAnon (r.typ d)

piBinds : String
        -> Presyntax.PiBinder Presyntax.TypeForm Presyntax.Checkable
        -> Bool
piBinds x (PiNamed y _ _) = strEq x y
piBinds x (PiImplicit y _ _ _ _) = strEq x y
piBinds x (PiInstance y _ _ _) = strEq x y
piBinds x (PiAnon _) = False

renameSet : Renamer
          -> Params.Spanned (Presyntax.FieldSet Presyntax.Checkable)
          -> Params.Spanned (Presyntax.FieldSet Presyntax.Checkable)
renameSet r (At (SetField y ysp e) sp) = At (SetField y ysp (r.chk e)) sp
renameSet r (At (BadFieldSet e) sp) = At (BadFieldSet (r.chk e)) sp

renameVariant : Renamer
              -> Params.Spanned (Presyntax.Variant Presyntax.TypeForm)
              -> Params.Spanned (Presyntax.Variant Presyntax.TypeForm)
renameVariant r (At (TagVariant t tsp args) sp) =
  At (TagVariant t tsp (List.map r.typ args)) sp
renameVariant r (At (BadVariant e) sp) = At (BadVariant (r.typ e)) sp

renameInfF : Renamer -> Presyntax.Inferable -> Presyntax.Inferable
renameInfF r n@(At (IVar y) sp) = if strEq y r.x then At (IVar r.v) sp else n
renameInfF r (At (IApp h args) sp) =
  At (IApp (r.inf h) (List.map (renameArg r) args)) sp
renameInfF r (At (IAnn c t) sp) = At (IAnn (r.chk c) (r.typ t)) sp
renameInfF r (At (ISpec a f fsp val) sp) =
  At (ISpec (r.inf a) f fsp (r.chk val)) sp
renameInfF r (At (IUpdate a fs) sp) =
  At
    (IUpdate
       (r.inf a)
       (List.map
          (\f -> case f of
           At (SetPath path e) fsp -> At (SetPath path (r.chk e)) fsp)
          fs))
    sp
-- (the type of an annotated lambda's binder is outside it)
renameInfF r (At (IAnnLam y ysp t b) sp) =
  At (IAnnLam y ysp (r.typ t) (if strEq y r.x then b else r.inf b)) sp
renameInfF r (At (INominal i) sp) = At (INominal (r.inf i)) sp
renameInfF r (At (ILitEq y ysp eq lit) sp) =
  At (ILitEq (if strEq y r.x then r.v else y) ysp eq (r.chk lit)) sp
renameInfF r (At (ILazy c) sp) = At (ILazy (r.chk c)) sp
renameInfF r (At (ITuple cs) sp) = At (ITuple (List.map r.chk cs)) sp
renameInfF r n = n

renameChkF : Renamer -> Presyntax.Checkable -> Presyntax.Checkable
renameChkF r (At (CInf i) sp) = At (CInf (r.inf i)) sp
renameChkF r (At (CType t) sp) = At (CType (r.typ t)) sp
renameChkF r n@(At (CLam y ysp b) sp) =
  if strEq y r.x then n else At (CLam y ysp (r.chk b)) sp
renameChkF r n@(At (CImplicitLam y ysp b) sp) =
  if strEq y r.x then n else At (CImplicitLam y ysp (r.chk b)) sp
renameChkF r (At (CAnnLam y ysp t b) sp) =
  At (CAnnLam y ysp (r.typ t) (if strEq y r.x then b else r.chk b)) sp
renameChkF r (At (CTag t tsp args) sp) =
  At (CTag t tsp (List.map r.chk args)) sp
renameChkF r (At (CStruct fs) sp) = At (CStruct (List.map (renameSet r) fs)) sp
renameChkF r (At (CMatch s alts) sp) =
  At (CMatch (r.inf s) (List.map (renameAlt r) alts)) sp
renameChkF r (At (CLetIn rhs a) sp) = At (CLetIn (r.inf rhs) (renameAlt r a)) sp
renameChkF r (At (CLocal body ds) sp) =
  At
    (CLocal
       (if anyC (declBinds r.x) ds then body else r.chk body)
       (renameSeq (renameDecl r) (declBinds r.x) ds))
    sp
renameChkF r (At (CNominal c) sp) = At (CNominal (r.chk c)) sp
renameChkF r n = n

renameTypF : Renamer -> Presyntax.TypeForm -> Presyntax.TypeForm
renameTypF r (At (TPi b cod) sp) =
  At (TPi (renamePi r b) (if piBinds r.x b then cod else r.typ cod)) sp
renameTypF r (At (TSig fs) sp) =
  At (TSig (renameSeq (renameField r) (fieldBinds r.x) fs)) sp
renameTypF r (At (TSum vs) sp) = At (TSum (List.map (renameVariant r) vs)) sp
renameTypF r (At (TArray a) sp) = At (TArray (r.typ a)) sp
renameTypF r (At (TInf i) sp) = At (TInf (r.inf i)) sp
renameTypF r (At (TChk c) sp) = At (TChk (r.chk c)) sp
renameTypF r (At (TNominal t) sp) = At (TNominal (r.typ t)) sp
renameTypF r n = n

renamer : String -> String -> Renamer
renamer x v =
  { x = x
  , v = v
  , inf = \n -> renameInfF (renamer x v) n
  , chk = \n -> renameChkF (renamer x v) n
  , typ = \n -> renameTypF (renamer x v) n
  }

-- | the variable `x` becomes `v` wherever it is not bound again (`v` is
-- | fresh: nothing binds it); a field's name, set or declared, and a
-- | named argument's are labels, not variables
rename : String -> String -> Presyntax.Checkable -> Presyntax.Checkable
rename x v n = (renamer x v).chk n

-- | a variable pattern `p` matched against the variable `v`: `p` means `v`
bindVar : String -> MatchPat -> Presyntax.Checkable -> Presyntax.Checkable
bindVar v (PVar x) e =
  if not (strEq x "_") && not (strEq x v) then rename x v e else e
bindVar v _ e = e

isTagP : MatchPat -> Bool
isTagP (PTag _ _ _) = True
isTagP _ = False

isLitP : MatchPat -> Bool
isLitP (PLit _) = True
isLitP _ = False

isBinP : MatchPat -> Bool
isBinP (PBin _ _) = True
isBinP _ = False

isRecP : MatchPat -> Bool
isRecP (PRec _ _) = True
isRecP _ = False

type TagRow =
  { tag : String, arity : Int, pats : List MatchPat, span : Params.Span }

patAt : Int -> Clause -> MatchPat
patAt c r = case nthC r.pats c of
  Just p -> p
  Nothing -> PVar "_"

isName : String -> Maybe String -> Bool
isName x (Just y) = strEq x y
isName x Nothing = False

-- | whether `x` may name the column `c` of `rows`: each row binds it
-- | there, or has no name `x` at all -- so that, a row's variable there
-- | renamed `x`, no other `x` of the row, another column's variable or
-- | a name from outside, is taken for the column
nameFits : String -> Int -> List Clause -> Bool
nameFits x c rows =
  allC
    (\row ->
       isName x (varOf (patAt c row))
       || not (List.elemBy strEq x (rowNames row Nil)))
    rows

-- | the match compiler, knotted with its arms
type CK =
  { compile :
        List String
        -> List String
        -> Params.Span
        -> List String
        -> List Clause
        -> Either Err Presyntax.Checkable
  }

findTagLit : List MatchPat -> Int -> Maybe Int
findTagLit Nil i = Nothing
findTagLit (Cons p rest) i =
  if isTagP p || isLitP p || isRecP p || isBinP p then Just i
  else findTagLit rest (i + 1)

-- | (`bound`: every variable the match has bound so far, those taken
-- | apart too -- an equation further down may still mean one of them,
-- | so no field takes its name)
-- | (`rows`: the arm's, its `i`th field the column `c + i`)
armSubName : List String
           -> List String
           -> List Clause
           -> Int
           -> String
           -> Int
           -> Maybe String
           -> String
armSubName used bound rows c v i (Just x) =
  if not (strEq x "_")
     && not (List.elemBy strEq x bound)
     && nameFits x (c + i) rows
  then x
  else freshIn used bound (v ^ show (i + 1))
armSubName used bound rows c v i Nothing = freshIn used bound (v ^ show (i + 1))

-- | the fields' names: those the first equation of the tag uses, where
-- | they fit
armSub : List String
       -> List String
       -> List Clause
       -> Int
       -> TagRow
       -> String
       -> Int
       -> String
armSub used bound rows c t v i = case nthC t.pats i of
  Just p -> armSubName used bound rows c v i (varOf p)
  Nothing -> freshIn used bound (v ^ show (i + 1))

armFields : List String
          -> List String
          -> List Clause
          -> Int
          -> TagRow
          -> String
          -> List String
armFields used bound rows c t v =
  List.map (\i -> armSub used bound rows c t v i) (upTo t.arity)

-- | a tag of a column, as its first row has it; whether a row has it
-- | with another number of arguments; the rows of its arm, the last first
type TagArm = { row : TagRow, bad : Bool, rows : List Clause }

-- | a column of tags, taken apart in one pass over its rows: each tag's
-- | arm, the tags in the order they first come (the last first), and the
-- | rows so far that match any value (the last first; the variable each
-- | binds there bound in its body)
type TagCol =
  { arms : OrdMap.OrdMap String TagArm
  , order : List TagRow
  , anys : List Clause
  }

-- | (in the arm of a tag of `n` arguments, as many `_`)
anyIn : Int -> Int -> Clause -> Clause
anyIn c n a =
  mkClause
    (spliceAt c (List.map (\(i : Int) -> PVar "_") (upTo n)) a.pats)
    a.rhs

anyArm : Int -> Clause -> TagArm -> TagArm
anyArm c a arm =
  { row = arm.row
  , bad = arm.bad
  , rows = Cons (anyIn c arm.row.arity a) arm.rows
  }

-- | a row matching any value: in every arm so far, and in those to come
anyStep : Int -> TagCol -> Clause -> TagCol
anyStep c col a =
  { arms = OrdMap.mapValues (\arm -> anyArm c a arm) col.arms
  , order = col.order
  , anys = Cons a col.anys
  }

-- (a tag's arm, the rows matching any value before its first row in it)
firstArm : Int -> TagRow -> List Clause -> Clause -> TagArm
firstArm c t anys r =
  { row = t
  , bad = False
  , rows = Cons r (List.map (\a -> anyIn c t.arity a) anys)
  }

nextArm : Int -> TagArm -> Clause -> TagArm
nextArm n arm r =
  { row = arm.row
  , bad = arm.bad || not (n == arm.row.arity)
  , rows = Cons r arm.rows
  }

tagArmStep : Int -> TagCol -> TagRow -> Clause -> Maybe TagArm -> TagCol
tagArmStep c col t r Nothing =
  { arms = OrdMap.insert col.arms t.tag (firstArm c t col.anys r)
  , order = Cons t col.order
  , anys = col.anys
  }
tagArmStep c col t r (Just arm) =
  { arms = OrdMap.insert col.arms t.tag (nextArm t.arity arm r)
  , order = col.order
  , anys = col.anys
  }

-- | a row of the column, `p` its pattern there: one with a tag in its
-- | tag's arm (its arguments the columns there), one matching any value
-- | in every arm
tagColAt : Int -> String -> TagCol -> Clause -> MatchPat -> TagCol
tagColAt c v col r (PTag t ps sp) =
  tagArmStep
    c
    col
    { tag = t, arity = List.length ps, pats = ps, span = sp }
    (mkClause (spliceAt c ps r.pats) r.rhs)
    (OrdMap.lookup col.arms t)
tagColAt c v col r (PVar x) =
  anyStep c col (mkClause r.pats (bindVar v (PVar x) r.rhs))
tagColAt c v col r (PLit l) = anyStep c col r
tagColAt c v col r (PRec _ _) = col
tagColAt c v col r (PBin _ _) = col
-- (none: `compile` takes each `x@p` apart first)
tagColAt c v col r (PAs _ _) = col

tagColStep : Int -> String -> TagCol -> Clause -> TagCol
tagColStep c v col r = tagColAt c v col r (patAt c r)

tagColGo : Int -> String -> TagCol -> List Clause -> TagCol
tagColGo c v col Nil = col
tagColGo c v col (Cons r rest) = tagColGo c v (tagColStep c v col r) rest

tagCol : Int -> String -> List Clause -> TagCol
tagCol c v rows =
  tagColGo c v { arms = OrdMap.empty, order = Nil, anys = Nil } rows

-- (always `Just`: each tag of `order` has its arm)
armOr : TagRow -> Maybe TagArm -> TagArm
armOr t (Just arm) = arm
armOr t Nothing = { row = t, bad = False, rows = Nil }

armAt : TagCol -> TagRow -> TagArm
armAt col t = armOr t (OrdMap.lookup col.arms t.tag)

-- | (`fs`: the fields' names)
armWith : CK
        -> List String
        -> List String
        -> Params.Span
        -> List String
        -> Int
        -> TagArm
        -> List String
        -> Either Err (Params.Spanned (Presyntax.Alt Presyntax.Checkable))
armWith r used bound sp vars c arm fs = do
  u <-
    bindU
      (if arm.bad
       then Left
           (mkErr
              arm.row.span
              (arm.row.tag ^ " is used with different numbers of arguments"))
       else Right MkUnit)
  body <-
    r.compile
      used
      (appendC fs bound)
      sp
      (spliceAt c fs vars)
      (List.reverse arm.rows)
  pure
      (Presyntax.alt
         (Presyntax.patTag
            arm.row.tag
            arm.row.span
            (List.map (\y -> At (PatVar y) sp) fs))
         body)

armOf : CK
      -> List String
      -> List String
      -> Params.Span
      -> List String
      -> Int
      -> String
      -> TagArm
      -> Either Err (Params.Spanned (Presyntax.Alt Presyntax.Checkable))
armOf r used bound sp vars c v arm =
  armWith r used bound sp vars c arm (armFields used bound arm.rows c arm.row v)

litYesOne : Int
          -> Presyntax.Pat
          -> String
          -> Clause
          -> List Clause
          -> List Clause
litYesOne c l v r acc = case patAt c r of
  PLit l' ->
    if sameLit l l' then Cons (mkClause (dropAt c r.pats) r.rhs) acc else acc
  PVar x -> Cons (mkClause (dropAt c r.pats) (bindVar v (PVar x) r.rhs)) acc
  PTag _ _ _ -> acc
  PRec _ _ -> acc
  PAs _ _ -> acc
  PBin _ _ -> acc

litYes : Int -> Presyntax.Pat -> String -> List Clause -> List Clause
litYes c l v Nil = Nil
litYes c l v (Cons r rest) = litYesOne c l v r (litYes c l v rest)

litNoOne : Int -> Presyntax.Pat -> Clause -> List Clause -> List Clause
litNoOne c l r acc = case patAt c r of
  PLit l' -> if sameLit l l' then acc else Cons r acc
  _ -> Cons r acc

litNo : Int -> Presyntax.Pat -> List Clause -> List Clause
litNo c l Nil = Nil
litNo c l (Cons r rest) = litNoOne c l r (litNo c l rest)

litChecks : Params.Span
          -> List String
          -> List Clause
          -> Int
          -> Presyntax.Pat
          -> Either Err Unit
litChecks sp vars rows c l =
  bind
    (a := Unit)
    (if anyC (\row -> isTagP (patAt c row)) rows
     then Left
         (mkErr
            (Params.spanOf l)
            "a literal and a tag match the same argument")
     else if anyC (\row -> isBinP (patAt c row)) rows
     then Left
         (mkErr
            (Params.spanOf l)
            "a literal and a binary match the same argument")
     else Right MkUnit)
    (\u1 ->
       if allC (\row -> isLitP (patAt c row)) rows
       then Left
           (mkErr
              (Params.spanOf l)
              "literals are matched here: one of them must match every other value (a variable, or `_`)")
       else Right MkUnit)

varAt : List String -> Int -> String
varAt vars c = case nthC vars c of
  Just v -> v
  Nothing -> "_"

-- | a column of literals: equal to the first equation's, or not
literalOf : CK
          -> List String
          -> List String
          -> Params.Span
          -> List String
          -> List Clause
          -> Int
          -> Presyntax.Pat
          -> Either Err Presyntax.Checkable
literalOf r used bound sp vars rows c l = do
  litChecks sp vars rows c l
  yesB <-
    r.compile used bound sp (dropAt c vars) (litYes c l (varAt vars c) rows)
  noB <- r.compile used bound sp vars (litNo c l rows)
  pure
      (At
         (CMatch
            (At
               (ILitEq (varAt vars c) sp (equalityOf l) (litExpr l))
               (Params.spanOf l))
            [ Presyntax.alt (Presyntax.patTag "True" (Params.spanOf l) Nil) yesB
            , Presyntax.alt (Presyntax.patTag "False" (Params.spanOf l) Nil) noB
            ])
         (Params.spanOf l))

noLitHere : Params.Span -> Int -> List Clause -> Either Err Unit
noLitHere sp c rows =
  forC rows (\row -> case patAt c row of
  PLit l ->
    Left (mkErr (Params.spanOf l) "a literal and a tag match the same argument")
  PBin _ bsp -> Left (mkErr bsp "a binary and a tag match the same argument")
  _ -> Right MkUnit)

clausePats : Clause -> List MatchPat
clausePats r = r.pats

clauseRhs : Clause -> Presyntax.Checkable
clauseRhs r = r.rhs

bindPair : Presyntax.Checkable -> Pair String MatchPat -> Presyntax.Checkable
bindPair e (MkPair v p) = bindVar v p e

defaultOf : CK
          -> List String
          -> List String
          -> Params.Span
          -> List String
          -> List Clause
          -> Int
          -> List Clause
          -> Either
            Err
            (List (Params.Spanned (Presyntax.Alt Presyntax.Checkable)))
defaultOf r used bound sp vars rows c Nil = Right Nil
defaultOf r used bound sp vars rows c rest = do
  b <-
    r.compile
      used
      bound
      sp
      (dropAt c vars)
      (List.map
         (\(row : Clause) ->
            mkClause
              (dropAt c row.pats)
              (bindVar (varAt vars c) (patAt c row) row.rhs))
         rest)
  pure (Cons (Presyntax.alt (At (PatVar "_") sp) b) Nil)

-- | rows whose column `c` is a variable go on in every other case
defaultArm : CK
           -> List String
           -> List String
           -> Params.Span
           -> List String
           -> List Clause
           -> Int
           -> Either
             Err
             (List (Params.Spanned (Presyntax.Alt Presyntax.Checkable)))
defaultArm r used bound sp vars rows c =
  defaultOf
    r
    used
    bound
    sp
    vars
    rows
    c
    (List.keepIf (\row -> not (isTagP (patAt c row))) rows)

-- Records
--------------------------------------------------------------------------------

recFieldsOf : MatchPat -> List (Pair String MatchPat)
recFieldsOf (PRec fps _) = fps
recFieldsOf _ = Nil

lookupField : String -> List (Pair String MatchPat) -> Maybe MatchPat
lookupField f Nil = Nothing
lookupField f (Cons (MkPair g p) rest) =
  if strEq f g then Just p else lookupField f rest

-- | a column of records matches no tag and no literal
noRecMix : List Clause -> Int -> Either Err Unit
noRecMix rows c =
  if anyC (\row -> isRecP (patAt c row)) rows
  then forC rows (\row -> case patAt c row of
    PTag _ _ sp -> Left (mkErr sp "a record and a tag match the same argument")
    PLit l ->
      Left
        (mkErr
           (Params.spanOf l)
           "a record and a literal match the same argument")
    PBin _ bsp ->
      Left (mkErr bsp "a record and a binary match the same argument")
    _ -> Right MkUnit)
  else Right MkUnit

-- | every field some equation names in column `c`, in order
recFieldNames : Int -> List Clause -> List String
recFieldNames c rows =
  nubStr
    (concatMapC
       (\row -> List.map (\fp -> fst fp) (recFieldsOf (patAt c row)))
       rows)

-- | the variable the first equation naming field `f` binds it to
recFieldVar : Int -> List Clause -> String -> Maybe String
recFieldVar c rows f = case catMaybesC
    (List.map (\row -> lookupField f (recFieldsOf (patAt c row))) rows) of
  Cons p _ -> varOf p
  Nil -> Nothing

-- | the name of field `f`'s column, `c` of the rows taken apart
-- | (`rows`): that variable, unless it is `_`, bound already or does
-- | not fit, else (a fresh) `f`
recSubName : List String
           -> List String
           -> List Clause
           -> Int
           -> Maybe String
           -> String
           -> String
recSubName used bound rows c (Just x) f =
  if not (strEq x "_")
     && not (List.elemBy strEq x bound)
     && nameFits x c rows
  then x
  else freshIn used bound f
recSubName used bound rows c Nothing f = freshIn used bound f

orWildcard : Maybe MatchPat -> MatchPat
orWildcard (Just p) = p
orWildcard Nothing = PVar "_"

-- | a row, its column `c` the fields `fs` (`_` those it does not name)
recSpecialize : Int -> List String -> String -> Clause -> Clause
recSpecialize c fs v r = case patAt c r of
  PRec fps _ ->
    mkClause
      (spliceAt c (List.map (\f -> orWildcard (lookupField f fps)) fs) r.pats)
      r.rhs
  _ ->
    mkClause
      (spliceAt c (List.map (\(f : String) -> PVar "_") fs) r.pats)
      (bindVar v (patAt c r) r.rhs)

-- | (`fs`: the fields named, `rows`: the rows taken apart by them)
recSubs : List String
        -> List String
        -> Int
        -> List Clause
        -> List String
        -> List Clause
        -> List String
recSubs used bound c rows fs specialized =
  mapWithIndexC
    0
    (\i f -> recSubName used bound specialized (c + i) (recFieldVar c rows f) f)
    fs

-- | `let y = v.f in e`, each field's column bound to its projection
letFields : Params.Span
          -> String
          -> List (Pair String String)
          -> Presyntax.Checkable
          -> Presyntax.Checkable
letFields sp v Nil body = body
letFields sp v (Cons (MkPair f y) rest) body =
  At
    (CLetIn
       (Presyntax.infApp (At (IVar v) sp) [At (ArgProject f) sp])
       (Presyntax.alt (At (PatVar y) sp) (letFields sp v rest body)))
    sp

-- | a column of records: a column for each field named, bound to its
-- | projection
-- | (`fs`: the fields named, `ys`: their columns' names, `specialized`:
-- | the rows, the column `c` of each its fields)
recordWith : CK
           -> List String
           -> List String
           -> Params.Span
           -> List String
           -> List Clause
           -> Int
           -> List String
           -> List String
           -> List Clause
           -> Either Err Presyntax.Checkable
recordWith r used bound sp vars rows c fs ys specialized = do
  noRecMix rows c
  body <- r.compile used (appendC ys bound) sp (spliceAt c ys vars) specialized
  pure (letFields sp (varAt vars c) (zipC fs ys) body)

recordFields : CK
             -> List String
             -> List String
             -> Params.Span
             -> List String
             -> List Clause
             -> Int
             -> List String
             -> List Clause
             -> Either Err Presyntax.Checkable
recordFields r used bound sp vars rows c fs specialized =
  recordWith
    r
    used
    bound
    sp
    vars
    rows
    c
    fs
    (recSubs used bound c rows fs specialized)
    specialized

recordNamed : CK
            -> List String
            -> List String
            -> Params.Span
            -> List String
            -> List Clause
            -> Int
            -> List String
            -> Either Err Presyntax.Checkable
recordNamed r used bound sp vars rows c fs =
  recordFields
    r
    used
    bound
    sp
    vars
    rows
    c
    fs
    (List.map (\row -> recSpecialize c fs (varAt vars c) row) rows)

recordOf : CK
         -> List String
         -> List String
         -> Params.Span
         -> List String
         -> List Clause
         -> Int
         -> Either Err Presyntax.Checkable
recordOf r used bound sp vars rows c =
  recordNamed r used bound sp vars rows c (recFieldNames c rows)

-- | a column of tags: an arm for each, in the order they first come,
-- | and one for the rest if a row matches any value
tagsAt : CK
       -> List String
       -> List String
       -> Params.Span
       -> List String
       -> List Clause
       -> Int
       -> TagCol
       -> Either Err Presyntax.Checkable
tagsAt r used bound sp vars rows c col = do
  noRecMix rows c
  noLitHere sp c rows
  arms <-
    traverseC
      (\t -> armOf r used bound sp vars c (varAt vars c) (armAt col t))
      (List.reverse col.order)
  dflt <- defaultArm r used bound sp vars rows c
  pure (At (CMatch (At (IVar (varAt vars c)) sp) (appendC arms dflt)) sp)

-- Binaries
--------------------------------------------------------------------------------

-- A column whose first row's pattern is a binary, `b[...]`: whether the
-- value is one it matches (a test, of `Bool`), and if it is, the names
-- its segments bind bound, each a column more (the first row's names in
-- them), over the rows as they are -- another binary may match the value
-- too, where the first row fails further on; if it is not, the rows
-- after the first.  The test reads the value left to right, by the
-- prelude's primitives and definitions: each segment there, a number, a
-- string, a float or a code point equal to its own, a code point's
-- UTF-8 or UTF-16 well formed (its width read), and the value all read
-- but where the last takes what is left; a size a name, one an earlier
-- segment binds (read in the test too) or one in scope.  Offsets and
-- sizes are in bits.  A binary that is `Bits` (`Presyntax.isBitsBinary`)
-- is read as bits (`bitsLength`, `bitsIntAt`, `bitsSlice`), and so is
-- one that is `Bytes` whose segments are not each whole bytes, made bits
-- first (`bitsOfBytes`); one that is, as bytes (`bytesLength`,
-- `bytesIntAt`, `bytesSlice`).

-- (the primitive or definition `p` applied)
callOf : String
       -> List Presyntax.Checkable
       -> Params.Span
       -> Presyntax.Inferable
callOf p args sp =
  At
    (IApp (At (IPrim p) sp) (List.map (\c -> At (ArgExplicit c) sp) args))
    sp

callC : String -> List Presyntax.Checkable -> Params.Span -> Presyntax.Checkable
callC p args sp = Presyntax.chkOf (callOf p args sp)

intC : Int -> Params.Span -> Presyntax.Checkable
intC n sp = Presyntax.chkOf (At (IInt n) sp)

varC : String -> Params.Span -> Presyntax.Checkable
varC x sp = Presyntax.chkOf (At (IVar x) sp)

boolC : Bool -> Params.Span -> Presyntax.Checkable
boolC b sp = At (CTag (if b then "True" else "False") sp Nil) sp

-- (`c`, and then `rest`)
andC : Presyntax.Inferable
     -> Presyntax.Checkable
     -> Params.Span
     -> Presyntax.Checkable
andC c rest sp =
  At
    (CMatch
       c
       [ Presyntax.alt (Presyntax.patTag "True" sp Nil) rest
       , Presyntax.alt (Presyntax.patTag "False" sp Nil) (boolC False sp)
       ])
    sp

letC : String
     -> Presyntax.Inferable
     -> Presyntax.Checkable
     -> Params.Span
     -> Presyntax.Checkable
letC x rhs body sp = At (CLetIn rhs (Presyntax.alt (At (PatVar x) sp) body)) sp

-- | an offset, or a width: bits known, and terms added to them
type Off = { bits : Int, terms : List Presyntax.Checkable }

offOf : Int -> Off
offOf n = { bits = n, terms = Nil }

offAdd : Off -> Off -> Off
offAdd a b = { bits = a.bits + b.bits, terms = appendC a.terms b.terms }

offC : Off -> Params.Span -> Presyntax.Checkable
offC o sp =
  List.foldl (\acc t -> callC "intAdd" [acc, t] sp) (intC o.bits sp) o.terms

-- (a width a name holds)
offVar : String -> Params.Span -> Off
offVar x sp = { bits = 0, terms = [varC x sp] }

-- (in bytes: every offset is of whole bytes)
offBytesC : Off -> Params.Span -> Presyntax.Checkable
offBytesC o sp =
  if List.null o.terms then intC (o.bits / 8) sp
  else callC "intDiv" [offC o sp, intC 8 sp] sp

-- | (the name an earlier segment binds `x` to, else `x`)
resolve : List (Pair String String) -> String -> String
resolve Nil x = x
resolve (Cons (MkPair y t) rest) x = if strEq x y then t else resolve rest x

-- | a segment's width (all that is left: none, it is last; a code
-- | point's of UTF-8 or UTF-16: none here, it is read)
widthBy : List (Pair String String)
        -> Params.Span
        -> Presyntax.SegmentType
        -> Presyntax.SegmentSize
        -> Presyntax.Pat
        -> Off
widthBy env sp SegmentInteger SizeDefault v = offOf 8
widthBy env sp SegmentFloat SizeDefault v = offOf 64
widthBy env sp (SegmentUtf 32) SizeDefault v = offOf 32
widthBy env sp ty (SizeNumber n) v = offOf n
widthBy env sp ty (SizeName x xsp 1) v = offVar (resolve env x) xsp
widthBy env sp ty (SizeName x xsp unit) v =
  { bits = 0
  , terms = [callC "intMul" [varC (resolve env x) xsp, intC unit sp] sp]
  }
widthBy env sp SegmentBinary SizeDefault (At (PatString str) _) =
  offOf (8 * strLength str)
widthBy env sp ty SizeDefault v = offOf 0

widthOf : List (Pair String String) -> BinSeg -> Off
widthOf env s = widthBy env s.span s.ty s.size s.value

-- | whether a segment is a code point whose width is read: UTF-8's,
-- | UTF-16's
readsWidth : Presyntax.SegmentType -> Bool
readsWidth (SegmentUtf 8) = True
readsWidth (SegmentUtf 16) = True
readsWidth _ = False

-- | whether a binary pattern is `Bits`, as `Presyntax.isBitsBinary` says
binIsBits : List BinSeg -> Bool
binIsBits segs =
  List.any (\(s : BinSeg) -> Presyntax.isBitsSegment s.ty) segs
  || not
    (Presyntax.oddIsZero
       (Presyntax.oddSum
          (List.map (\(s : BinSeg) -> Presyntax.segmentOdd s.ty s.size) segs)
          0))

-- | whether each segment is whole bytes, as
-- | `Presyntax.wholeByteSegments` says
binWholeBytes : List BinSeg -> Bool
binWholeBytes segs =
  not (List.any (\(s : BinSeg) -> Presyntax.isBitsSegment s.ty) segs)
  && List.all
    (\(s : BinSeg) -> Presyntax.oddIsZero (Presyntax.segmentOdd s.ty s.size))
    segs

-- | what the test of a column's binary knows: the name of the value read
-- | (the column's, or it made bits), whether it is read as bits, the
-- | name of its length in bits, the names some segment's size is, and
-- | the names in use (none it makes is one of them)
type BinCtx =
  { v : String
  , bits : Bool
  , len : String
  , sizes : List String
  , used : List String
  , bound : List String
  , span : Params.Span
  }

-- (the primitive of bytes, `bytes`, or of bits, `bits`, as the value is
-- read)
byMode : BinCtx -> String -> String -> String
byMode k bytes bits = if k.bits then bits else bytes

-- (`n`, a size a name is, of a segment of the type: of 0 to 64 bits, an
-- integer's; of 0 bits or more, bytes' and bits')
sizeOk : BinCtx
       -> Presyntax.SegmentType
       -> Presyntax.SegmentSize
       -> Off
       -> Presyntax.Checkable
       -> Presyntax.Checkable
sizeOk k SegmentInteger (SizeName _ _ _) w rest =
  andC
    (callOf "intLe" [intC 0 k.span, offC w k.span] k.span)
    (andC (callOf "intLe" [offC w k.span, intC 64 k.span] k.span) rest k.span)
    k.span
sizeOk k ty (SizeName _ _ _) w rest =
  andC (callOf "intLe" [intC 0 k.span, offC w k.span] k.span) rest k.span
sizeOk k ty size w rest = rest

-- (the segment there: its end within the value)
fits : BinCtx -> Off -> Off -> Presyntax.Checkable -> Presyntax.Checkable
fits k off w rest =
  andC
    (callOf "intLe" [offC (offAdd off w) k.span, varC k.len k.span] k.span)
    rest
    k.span

-- | an integer's segment read
intRead : BinCtx -> Off -> Off -> Int -> Presyntax.Inferable
intRead k off w flags =
  callOf
    (byMode k "bytesIntAt" "bitsIntAt")
    [varC k.v k.span, offC off k.span, offC w k.span, intC flags k.span]
    k.span

-- | a float's segment read, of `n` bits
floatRead : BinCtx -> Off -> Int -> Int -> Presyntax.Inferable
floatRead k off n flags =
  callOf
    "floatOfBits"
    [intC n k.span, Presyntax.chkOf (intRead k off (offOf n) flags)]
    k.span

-- (a float's size, in bits)
floatSize : Presyntax.SegmentSize -> Int
floatSize (SizeNumber n) = n
floatSize _ = 64

-- | how many bits the code point of UTF-8 or UTF-16 at `off` is: of
-- | none there, 0
utfWidth : BinCtx
         -> Off
         -> BinSeg
         -> Presyntax.SegmentType
         -> Presyntax.Inferable
utfWidth k off s (SegmentUtf 8) =
  callOf
    (byMode k "prelude.bytesUtf8Width" "prelude.bitsUtf8Width")
    [varC k.v k.span, offC off k.span]
    k.span
utfWidth k off s ty =
  callOf
    (byMode k "prelude.bytesUtf16Width" "prelude.bitsUtf16Width")
    [varC k.v k.span, offC off k.span, intC s.flags k.span]
    k.span

-- | a code point's segment read, a `Rune`
utfRead : BinCtx
        -> Off
        -> BinSeg
        -> Presyntax.SegmentType
        -> Presyntax.Inferable
utfRead k off s (SegmentUtf 8) =
  callOf
    (byMode k "prelude.bytesUtf8At" "prelude.bitsUtf8At")
    [varC k.v k.span, offC off k.span]
    k.span
utfRead k off s (SegmentUtf 16) =
  callOf
    (byMode k "prelude.bytesUtf16At" "prelude.bitsUtf16At")
    [varC k.v k.span, offC off k.span, intC s.flags k.span]
    k.span
utfRead k off s ty =
  callOf
    "runeFromInt"
    [Presyntax.chkOf (intRead k off (offOf 32) s.flags)]
    k.span

-- | the name the test reads the `i`th segment's size into, where a
-- | later one's size is its name, or the width of its code point into
sizeTemp : BinCtx -> Int -> String
sizeTemp k i = freshIn k.used k.bound (k.v ^ "Size" ^ show (i + 1))

widthTemp : BinCtx -> Int -> String
widthTemp k i = freshIn k.used k.bound (k.v ^ "Width" ^ show (i + 1))

-- | the test of the segments from the `i`th, at `off` (`env`: the names
-- | those before bind, as the test reads them)
type BinTest =
  { go :
        List (Pair String String)
        -> Int
        -> Off
        -> List BinSeg
        -> Presyntax.Checkable
  }

-- (an integer's value: a number its own, a name a size is read)
intTest : BinTest
        -> BinCtx
        -> List (Pair String String)
        -> Int
        -> Off
        -> BinSeg
        -> List BinSeg
        -> Off
        -> Presyntax.Pat
        -> Presyntax.Checkable
intTest t k env i off s rest w (At (PatInt n) _) =
  andC
    (callOf
       "intEq"
       [Presyntax.chkOf (intRead k off w s.flags), intC n k.span]
       k.span)
    (t.go env (i + 1) (offAdd off w) rest)
    k.span
intTest t k env i off s rest w (At (PatVar x) _) =
  if List.elemBy strEq x k.sizes
  then letC
      (sizeTemp k i)
      (intRead k off w s.flags)
      (t.go (Cons (MkPair x (sizeTemp k i)) env) (i + 1) (offAdd off w) rest)
      k.span
  else t.go env (i + 1) (offAdd off w) rest
intTest t k env i off s rest w v = t.go env (i + 1) (offAdd off w) rest

-- (a float's value: a float its own)
floatTest : BinCtx
          -> Off
          -> BinSeg
          -> Presyntax.Pat
          -> Presyntax.Checkable
          -> Presyntax.Checkable
floatTest k off s (At (PatFloat x) xsp) rest =
  andC
    (callOf
       "floatEq"
       [ Presyntax.chkOf (floatRead k off (floatSize s.size) s.flags)
       , Presyntax.chkOf (At (IFloat x) xsp)
       ]
       k.span)
    rest
    k.span
floatTest k off s v rest = rest

-- (a code point's value, `c` it read: a number or a rune its own)
codeTest : BinCtx
         -> Presyntax.Inferable
         -> Presyntax.Pat
         -> Presyntax.Checkable
         -> Presyntax.Checkable
codeTest k c (At (PatInt n) _) rest =
  andC (callOf "intEq" [Presyntax.chkOf c, intC n k.span] k.span) rest k.span
codeTest k c (At (PatRune n) _) rest =
  andC (callOf "intEq" [Presyntax.chkOf c, intC n k.span] k.span) rest k.span
codeTest k c v rest = rest

-- (a string's value, a pattern's)
stringOf : Presyntax.Pat -> Maybe String
stringOf (At (PatString str) _) = Just str
stringOf _ = Nothing

-- (bytes' or bits': a string's, those left, or so many)
partTest : BinTest
         -> BinCtx
         -> List (Pair String String)
         -> Int
         -> Off
         -> BinSeg
         -> List BinSeg
         -> Off
         -> Presyntax.SegmentType
         -> Presyntax.SegmentSize
         -> Maybe String
         -> Presyntax.Checkable
partTest t k env i off s rest w SegmentBinary SizeDefault (Just str) =
  andC
    (if k.bits
     then callOf
         "prelude.bitsHasBytesAt"
         [ varC k.v k.span
         , offC off k.span
         , Presyntax.chkOf (At (IBytes str) k.span)
         ]
         k.span
     else callOf
         "bytesHasAt"
         [ varC k.v k.span
         , offBytesC off k.span
         , Presyntax.chkOf (At (IBytes str) k.span)
         ]
         k.span)
    (t.go env (i + 1) (offAdd off w) rest)
    k.span
-- (the bytes that are left: the last, all of them, whole bytes)
partTest t k env i off s rest w SegmentBinary SizeDefault Nothing =
  if k.bits
  then callC
      "intEq"
      [ callC
        "intMod"
        [ callC "intSub" [varC k.len k.span, offC off k.span] k.span
        , intC 8 k.span
        ]
        k.span
      , intC 0 k.span
      ]
      k.span
  else boolC True k.span
-- (the bits that are left: the last, all of them)
partTest t k env i off s rest w SegmentBits SizeDefault str = boolC True k.span
partTest t k env i off s rest w ty size str =
  sizeOk k ty size w (fits k off w (t.go env (i + 1) (offAdd off w) rest))

segTest : BinTest
        -> BinCtx
        -> List (Pair String String)
        -> Int
        -> Off
        -> BinSeg
        -> List BinSeg
        -> Off
        -> Presyntax.SegmentType
        -> Presyntax.Checkable
segTest t k env i off s rest w SegmentInteger =
  sizeOk
    k
    SegmentInteger
    s.size
    w
    (fits k off w (intTest t k env i off s rest w s.value))
segTest t k env i off s rest w SegmentFloat =
  fits
    k
    off
    w
    (floatTest k off s s.value (t.go env (i + 1) (offAdd off w) rest))
segTest t k env i off s rest w (SegmentUtf 32) =
  fits
    k
    off
    w
    (letC
       (widthTemp k i)
       (intRead k off w s.flags)
       (andC
          (callOf "prelude.isScalarValue" [varC (widthTemp k i) k.span] k.span)
          (codeTest
             k
             (At (IVar (widthTemp k i)) k.span)
             s.value
             (t.go env (i + 1) (offAdd off w) rest))
          k.span)
       k.span)
segTest t k env i off s rest w (SegmentUtf n) =
  letC
    (widthTemp k i)
    (utfWidth k off s s.ty)
    (andC
       (callOf "intLt" [intC 0 k.span, varC (widthTemp k i) k.span] k.span)
       (codeTest
          k
          (callOf "runeToInt" [Presyntax.chkOf (utfRead k off s s.ty)] k.span)
          s.value
          (t.go env (i + 1) (offAdd off (offVar (widthTemp k i) k.span)) rest))
       k.span)
    k.span
segTest t k env i off s rest w ty =
  partTest t k env i off s rest w ty s.size (stringOf s.value)

binTestGo : BinTest
          -> BinCtx
          -> List (Pair String String)
          -> Int
          -> Off
          -> List BinSeg
          -> Presyntax.Checkable
binTestGo t k env i off Nil =
  Presyntax.chkOf (callOf "intEq" [offC off k.span, varC k.len k.span] k.span)
binTestGo t k env i off (Cons s rest) =
  segTest t k env i off s rest (widthOf env s) s.ty

binTest : BinCtx -> BinTest
binTest k = { go = \env i off segs -> binTestGo (binTest k) k env i off segs }

-- (a segment's bytes, where it is written whole: a number of a size
-- written, a string)
wholeSeg : BinSeg
         -> Presyntax.SegmentType
         -> Presyntax.SegmentSize
         -> Presyntax.Pat
         -> Maybe String
wholeSeg s SegmentInteger SizeDefault (At (PatInt n) _) =
  Just (Presyntax.integerBytes 8 (s.flags % 2 == 1) n)
wholeSeg s SegmentInteger (SizeNumber m) (At (PatInt n) _) =
  Just (Presyntax.integerBytes m (s.flags % 2 == 1) n)
wholeSeg s SegmentBinary SizeDefault (At (PatString str) _) = Just str
wholeSeg s ty size v = Nothing

-- | a binary's bytes, if each segment is written whole, after `acc`
wholeBin : List BinSeg -> String -> Maybe String
wholeBin Nil acc = Just acc
wholeBin (Cons s rest) acc = case wholeSeg s s.ty s.size s.value of
  Just b -> wholeBin rest (acc ^ b)
  Nothing -> Nothing

-- | the test, of `Bool`: the bytes, if the binary is written whole
binTestOf : BinCtx -> List BinSeg -> Maybe String -> Presyntax.Checkable
binTestOf k segs (Just b) =
  callC
    "bytesEq"
    [varC k.v k.span, Presyntax.chkOf (At (IBytes b) k.span)]
    k.span
binTestOf k segs Nothing =
  letC
    k.len
    (if k.bits then callOf "bitsLength" [varC k.v k.span] k.span
     else callOf
         "intMul"
         [callC "bytesLength" [varC k.v k.span] k.span, intC 8 k.span]
         k.span)
    ((binTest k).go Nil 0 (offOf 0) segs)
    k.span

-- (what is left from `off`, in bits)
restC : BinCtx -> Off -> Presyntax.Checkable
restC k off =
  callC
    "intSub"
    [callC "bitsLength" [varC k.v k.span] k.span, offC off k.span]
    k.span

-- | a segment's name bound to what it holds
segRead : BinCtx
        -> Off
        -> Off
        -> BinSeg
        -> Presyntax.SegmentType
        -> Presyntax.SegmentSize
        -> Presyntax.Inferable
segRead k off w s SegmentInteger size = intRead k off w s.flags
segRead k off w s SegmentFloat size = floatRead k off (floatSize size) s.flags
segRead k off w s (SegmentUtf n) size = utfRead k off s (SegmentUtf n)
segRead k off w s SegmentBits SizeDefault =
  callOf "bitsSlice" [varC k.v k.span, offC off k.span, restC k off] k.span
segRead k off w s SegmentBits size =
  callOf "bitsSlice" [varC k.v k.span, offC off k.span, offC w k.span] k.span
segRead k off w s SegmentBinary SizeDefault =
  if k.bits
  then callOf
      "bitsBytes"
      [ callC
        "bitsSlice"
        [varC k.v k.span, offC off k.span, restC k off]
        k.span
      ]
      k.span
  else callOf
      "bytesSlice"
      [ varC k.v k.span
      , offBytesC off k.span
      , callC "bytesLength" [varC k.v k.span] k.span
      ]
      k.span
segRead k off w s SegmentBinary size =
  if k.bits
  then callOf
      "bitsBytes"
      [ callC
        "bitsSlice"
        [varC k.v k.span, offC off k.span, offC w k.span]
        k.span
      ]
      k.span
  else callOf
      "bytesSlice"
      [varC k.v k.span, offBytesC off k.span, offBytesC (offAdd off w) k.span]
      k.span

-- | the names the segments bind, `ys` theirs, bound around `body`, from
-- | the `i`th
type BinBind =
  { go :
        List (Pair String String)
        -> Int
        -> List String
        -> Off
        -> List BinSeg
        -> Presyntax.Checkable
        -> Presyntax.Checkable
  }

segBind : BinBind
        -> BinCtx
        -> List (Pair String String)
        -> Int
        -> List String
        -> Off
        -> BinSeg
        -> List BinSeg
        -> Presyntax.Checkable
        -> Off
        -> Maybe String
        -> Presyntax.Checkable
segBind b k env i ys off s rest body w Nothing =
  b.go env (i + 1) ys (offAdd off w) rest body
segBind b k env i (Cons y ys) off s rest body w (Just x) =
  letC
    y
    (segRead k off w s s.ty s.size)
    (b.go (Cons (MkPair x y) env) (i + 1) ys (offAdd off w) rest body)
    k.span
segBind b k env i Nil off s rest body w (Just x) = body

binBindGo : BinBind
          -> BinCtx
          -> List (Pair String String)
          -> Int
          -> List String
          -> Off
          -> List BinSeg
          -> Presyntax.Checkable
          -> Presyntax.Checkable
binBindGo b k env i ys off Nil body = body
binBindGo b k env i ys off (Cons s rest) body =
  if readsWidth s.ty
  then letC
      (widthTemp k i)
      (utfWidth k off s s.ty)
      (segBind
         b
         k
         env
         i
         ys
         off
         s
         rest
         body
         (offVar (widthTemp k i) k.span)
         (segName s))
      k.span
  else segBind b k env i ys off s rest body (widthOf env s) (segName s)

binBind : BinCtx -> BinBind
binBind k =
  { go = \env i ys off segs body ->
        binBindGo (binBind k) k env i ys off segs body
  }

-- | a column of binaries matches no tag, literal or record, and a row
-- | matches any value
binChecks : List Clause -> Int -> Params.Span -> Either Err Unit
binChecks rows c bsp =
  if anyC (\row -> isTagP (patAt c row)) rows
  then Left (mkErr bsp "a binary and a tag match the same argument")
  else if anyC (\row -> isLitP (patAt c row)) rows
  then Left (mkErr bsp "a literal and a binary match the same argument")
  else if anyC (\row -> isRecP (patAt c row)) rows
  then Left (mkErr bsp "a record and a binary match the same argument")
  else if allC (\row -> isBinP (patAt c row)) rows
  then Left
      (mkErr
         bsp
         "binaries are matched here: one of them must match every other value (a variable, or `_`)")
  else Right MkUnit

-- (the match, of the value made bits first where it is so read)
asBitsC : Bool
        -> String
        -> String
        -> Params.Span
        -> Presyntax.Checkable
        -> Presyntax.Checkable
asBitsC True v x sp body = letC x (callOf "bitsOfBytes" [varC v sp] sp) body sp
asBitsC False v x sp body = body

-- | (`xs`: the names the first row's segments bind; `ys`: their columns;
-- | `k`: what the test knows; `made`: whether the value is made bits
-- | first, a `Bytes` read as bits)
binaryWith : CK
           -> List String
           -> List String
           -> Params.Span
           -> List String
           -> List Clause
           -> Int
           -> List BinSeg
           -> Params.Span
           -> List String
           -> List String
           -> BinCtx
           -> Bool
           -> Either Err Presyntax.Checkable
binaryWith r used bound sp vars rows c segs bsp xs ys k made = do
  binChecks rows c bsp
  yesB <-
    r.compile
      used
      (appendC ys bound)
      sp
      (appendC vars ys)
      (mapWithIndexC
         0
         (\i (row : Clause) ->
            if i == 0
            then mkClause
                (appendC
                   (spliceAt c [PVar "_"] row.pats)
                   (List.map (\x -> PVar x) xs))
                row.rhs
            else mkClause
                (appendC row.pats (List.map (\(y : String) -> PVar "_") ys))
                row.rhs)
         rows)
  noB <- r.compile used bound sp vars (dropC 1 rows)
  pure
      (asBitsC
         made
         (varAt vars c)
         k.v
         bsp
         (At
            (CMatch
               (At
                  (IAnn
                     (binTestOf
                        k
                        segs
                        (if k.bits then Nothing else wholeBin segs ""))
                     (At (TInf (At (IPrim "builtin.Bool") bsp)) bsp))
                  bsp)
               [ Presyntax.alt
                 (Presyntax.patTag "True" bsp Nil)
                 ((binBind k).go Nil 0 ys (offOf 0) segs yesB)
               , Presyntax.alt (Presyntax.patTag "False" bsp Nil) noB
               ])
            bsp))

-- (`bits`: read as bits; `made`: made bits first)
binaryRead : CK
           -> List String
           -> List String
           -> Params.Span
           -> List String
           -> List Clause
           -> Int
           -> List BinSeg
           -> Params.Span
           -> Bool
           -> Bool
           -> Either Err Presyntax.Checkable
binaryRead r used bound sp vars rows c segs bsp bits made =
  binaryWith
    r
    used
    bound
    sp
    vars
    rows
    c
    segs
    bsp
    (catMaybesC (List.map segName segs))
    (mapWithIndexC
       0
       (\i (x : String) ->
          freshIn used bound (varAt vars c ^ "Segment" ^ show (i + 1)))
       (catMaybesC (List.map segName segs)))
    { v =
        if made then freshIn used bound (varAt vars c ^ "AsBits")
        else varAt vars c
    , bits = bits
    , len = freshIn used bound (varAt vars c ^ "Bits")
    , sizes = catMaybesC (List.map sizeName segs)
    , used = used
    , bound = bound
    , span = bsp
    }
    made

binaryOf : CK
         -> List String
         -> List String
         -> Params.Span
         -> List String
         -> List Clause
         -> Int
         -> List BinSeg
         -> Params.Span
         -> Either Err Presyntax.Checkable
binaryOf r used bound sp vars rows c segs bsp =
  binaryRead
    r
    used
    bound
    sp
    vars
    rows
    c
    segs
    bsp
    (binIsBits segs || not (binWholeBytes segs))
    (not (binIsBits segs) && not (binWholeBytes segs))

compileAt : CK
          -> List String
          -> List String
          -> Params.Span
          -> List String
          -> List Clause
          -> Int
          -> MatchPat
          -> Either Err Presyntax.Checkable
compileAt r used bound sp vars rows c (PLit l) = do
  noRecMix rows c
  literalOf r used bound sp vars rows c l
compileAt r used bound sp vars rows c (PRec _ _) =
  recordOf r used bound sp vars rows c
compileAt r used bound sp vars rows c (PBin segs bsp) =
  binaryOf r used bound sp vars rows c segs bsp
compileAt r used bound sp vars rows c p =
  tagsAt r used bound sp vars rows c (tagCol c (varAt vars c) rows)

-- | `x@p` matched against the variable `v`: `p`, and `x` means `v`
peelAs : String
       -> MatchPat
       -> Presyntax.Checkable
       -> Pair MatchPat Presyntax.Checkable
peelAs v (PAs x p) e = peelAs v p (bindVar v (PVar x) e)
peelAs v p e = MkPair p e

consPat : MatchPat -> Clause -> Clause
consPat p r = mkClause (Cons p r.pats) r.rhs

-- | a row, no column of it `x@p`
peelCols : List String -> List MatchPat -> Presyntax.Checkable -> Clause
peelCols (Cons v vs) (Cons p ps) e = case peelAs v p e of
  MkPair p' e' -> consPat p' (peelCols vs ps e')
peelCols _ ps e = mkClause ps e

peelRow : List String -> Clause -> Clause
peelRow vars r = peelCols vars r.pats r.rhs

compilePeeled : CK
              -> List String
              -> List String
              -> Params.Span
              -> List String
              -> List Clause
              -> Either Err Presyntax.Checkable
-- unreachable: a missing tag is the match's error
compilePeeled r used bound sp vars Nil = Right (At CAbandon sp)
compilePeeled r used bound sp vars rows@(Cons row rest) = case findTagLit
    (clausePats row)
    0 of
  -- the first equation matches whatever is left: it is the answer
  Nothing ->
    Right
      (List.foldl
         (\e vp -> bindPair e vp)
         (clauseRhs row)
         (zipC vars (clausePats row)))
  Just c -> compileAt r used bound sp vars rows c (patAt c row)

-- | the match tree for `rows` over the variables `vars`, column by column
compileF : CK
         -> List String
         -> List String
         -> Params.Span
         -> List String
         -> List Clause
         -> Either Err Presyntax.Checkable
compileF r used bound sp vars rows =
  compilePeeled r used bound sp vars (List.map (\row -> peelRow vars row) rows)

ck : CK
ck =
  { compile = \used bound sp vars rows -> compileF ck used bound sp vars rows }

rowVar : Clause -> Int -> Maybe String
rowVar r i = case nthC r.pats i of
  Just p -> varOf p
  Nothing -> Nothing

-- | (`taken`: the earlier columns' names)
colPick : List String
        -> List String
        -> List Clause
        -> Int
        -> List String
        -> String
colPick used taken rows i (Cons x Nil) =
  if not (strEq x "_")
     && not (List.elemBy strEq x taken)
     && nameFits x i rows
  then x
  else freshIn used taken ("x" ^ show (i + 1))
colPick used taken rows i xs = freshIn used taken ("x" ^ show (i + 1))

colFrom : List String -> List String -> List Clause -> Int -> String
colFrom used taken rows i =
  colPick
    used
    taken
    rows
    i
    (nubStr (catMaybesC (List.map (\r -> rowVar r i) rows)))

-- | the name of a column: the parameter's, else the one its equations
-- | use where it fits, else a fresh one
colName : List String
        -> List String
        -> List String
        -> List Clause
        -> Int
        -> String
colName used params taken rows i = case nthC params i of
  Just p -> p
  Nothing -> colFrom used taken rows i

-- | the columns' names, from the `i`th of `n`
colNames : List String
         -> List String
         -> List Clause
         -> Int
         -> Int
         -> List String
         -> List String
colNames used params rows i n taken =
  if i >= n then Nil
  else let x = colName used params taken rows i
       in Cons x (colNames used params rows (i + 1) n (Cons x taken))

foldr2 : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr2 f z Nil = z
foldr2 f z (Cons x xs) = f x (foldr2 f z xs)

-- | (`cols`: the columns' names)
desugarCols : List String
            -> Params.Span
            -> List Clause
            -> List String
            -> List String
            -> Either Err Presyntax.Checkable
desugarCols params sp rows used cols = do
  body <- ck.compile used cols sp cols rows
  pure
      (foldr2
         (\x b -> Presyntax.chkLam x sp b)
         body
         (dropC (List.length params) cols))

desugarBody : String
            -> List String
            -> Params.Span
            -> List Clause
            -> Int
            -> List String
            -> Either Err Presyntax.Checkable
desugarBody f params sp rows arity used =
  desugarCols
    params
    sp
    rows
    used
    (colNames used params rows 0 arity Nil)

-- | the body of `f` from its equations: `params` are the parameters
-- | named in the head of the definition
desugar : String
        -> List String
        -> List (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
        -> Params.Span
        -> Either Err Presyntax.Checkable
desugar f params eqNs sp = do
  rows <- traverseC (\n -> equation n) eqNs
  arity <- case rows of
    Nil -> Left (mkErr sp "a definition by equations needs an equation")
    Cons r rest -> Right (List.length r.pats)
  forC
      rows
      (\(r : Clause) ->
         if not (List.length r.pats == arity)
         then Left
             (mkErr
                (Params.spanOf r.rhs)
                ("every equation of `"
                 ^ f
                 ^ "` has "
                 ^ show arity
                 ^ " pattern(s)"))
         else Right MkUnit)
  u2 <-
    bindU
      (if arity < List.length params
       then Left
           (mkErr
              sp
              ("the equations of `"
               ^ f
               ^ "` match fewer arguments than it names"))
       else Right MkUnit)
  desugarBody
      f
      params
      sp
      rows
      arity
      (namesOfAll rowNames rows (appendC params (Cons f Nil)))

-- | a `case` whose alternatives match nested patterns: compiled like the
-- | equations, over one column -- a fresh name for the scrutinee
type CaseTree = { scrutinee : String, tree : Presyntax.Checkable }

caseAlt : Params.Spanned (Presyntax.Alt Presyntax.Checkable)
        -> Either Err Clause
caseAlt (At (MkAlt p rhs) _) = do
  p' <- pat p
  pure (mkClause (Cons p' Nil) rhs)

-- | (`used`: the names the alternatives have, which no name the match
-- | makes may be)
caseTreeOf : Params.Span
           -> List Clause
           -> List String
           -> String
           -> Either Err CaseTree
caseTreeOf sp rows used x = do
  tree <- ck.compile (Cons x used) [x] sp [x] rows
  pure { scrutinee = x, tree = tree }

caseNames : List Clause -> List String
caseNames rows = namesOfAll rowNames rows Nil

-- | (`used`: the names the alternatives have)
caseTreeUsing : Params.Span -> List Clause -> List String -> Either Err CaseTree
caseTreeUsing sp rows used = caseTreeOf sp rows used (fresh used "it")

caseTree : Params.Span
         -> List (Params.Spanned (Presyntax.Alt Presyntax.Checkable))
         -> Either Err CaseTree
caseTree sp altNs = do
  rows <- traverseC (\n -> caseAlt n) altNs
  caseTreeUsing sp rows (caseNames rows)
