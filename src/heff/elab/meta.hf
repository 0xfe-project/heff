-- The metavariable layer in the elaboration monad: forcing, fresh
-- metavariables, unification entered from `Elab`, postponed problems and delayed checks
-- settled together, unsolved metavariables reported.  `do` here is
-- environment's `bind`.

module heff.elab.meta

import array as Array
import co
import exception as Exception
import heff.elab.conversion as Conversion
import heff.syntax.diagnostic
import heff.elab.environment
import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.elab.readback as Readback
import heff.elab.syntax as Syntax
import heff.elab.unify as Unify
import heff.elab.value as Value
import std.ordmap as OrdMap
import state as State

force : Value.V -> Elab Value.V
force v = gets (\c -> Value.forceEl c.metas v)

forceT : Value.Ty -> Elab Value.Ty
forceT t = gets (\c -> Value.forceTy c.metas t)

liftTake : {a : Type}
         -> Pair (Either Conversion.EqErr a) StCore
         -> Elab (Either Conversion.EqErr a)
liftTake (MkPair r c2) = bind (putSt c2) (\u -> val r)

-- | a unification, in elaboration: run on the core state, by itself
-- | (it has no other effect), its failure a value
liftU : {a : Type} -> Co Unify.uW a -> Elab (Either Conversion.EqErr a)
liftU u = bind (gets (\c -> Unify.runU u c)) liftTake

unifyTy : Globals.Globals
        -> Params.CtxShape
        -> Value.Ty
        -> Value.Ty
        -> Elab (Either Conversion.EqErr Unit)
unifyTy g cs a b =
  liftU (Unify.uTy (ms := Unify.msEv) (uf := Unify.ufEv) g cs a b)

unifyEl : Globals.Globals
        -> Params.CtxShape
        -> Value.V
        -> Value.V
        -> Elab (Either Conversion.EqErr Unit)
unifyEl g cs a b =
  liftU (Unify.uEl (ms := Unify.msEv) (uf := Unify.ufEv) g cs a b)

blockedFlex : OrdMap.OrdMap Int Unit -> Value.Ty -> Bool
blockedFlex ps a = case Unify.flexTy a of
  Just (MkPair m _) -> OrdMap.member ps m
  Nothing -> False

-- | is a type one nothing can be asked of, for an error elsewhere: an
-- | error hole's, or a metavariable an error hole kept from being solved?
blockedTy : Value.Ty -> Elab Bool
blockedTy a0 = do
  a <- forceT a0
  gets (\c -> Value.isErrorTy a || blockedFlex c.poisoned a)

type Unsolved = { name : String, span : Params.Span }

keepUnsolved : List Unsolved -> Value.MetaEntry -> List Unsolved
keepUnsolved acc e@{ sol = Nothing } = Cons { name = e.name, span = e.span } acc
keepUnsolved acc { sol = Just _ } = acc

-- | the metavariables that were created and never solved
unsolvedMetas : Elab (List Unsolved)
unsolvedMetas =
  gets
    (\c -> List.reverse (List.foldl keepUnsolved Nil (OrdMap.values c.metas)))

-- Postponed problems and delayed checks
--------------------------------------------------------------------------------

keepFailed : Postponed -> Either Conversion.EqErr Unit -> Elab Unit
keepFailed p (Left _) =
  modify
    (\c ->
       setPostponed
         (Cons
            { shape = p.shape, left = p.left, right = p.right, failed = True }
            c.postponed)
         c)
keepFailed p (Right _) = pure MkUnit

-- | the state as it was, but for what a failed unification keeps: the
-- | metavariables and the problems postponed go back; the trace (and
-- | what else is written down) stays, so `heff explain` shows the try
undoTo : StCore -> StCore -> StCore
undoTo before c =
  setPostponed before.postponed (setMetas before.metas before.nextMeta c)

undoIfFailed : {a : Type}
             -> StCore
             -> Saved
             -> Either Conversion.EqErr a
             -> Elab (Either Conversion.EqErr a)
undoIfFailed before waiting (Right x) = pure (Right x)
undoIfFailed before waiting (Left err) = do
  modify (undoTo before)
  restoreWaiting waiting
  pure (Left err)

-- | a unification tried: if it fails, what it did is undone -- the
-- | metavariables it solved or made, the problems it postponed, the
-- | checks it left waiting -- for what is tried next to start from what
-- | was there before (#19)
attempt : {a : Type}
        -> Elab (Either Conversion.EqErr a)
        -> Elab (Either Conversion.EqErr a)
attempt m = do
  before <- gets (\c -> c)
  waiting <- saveDelayed
  r <- m
  undoIfFailed before waiting r

retryEach : Globals.Globals -> List Postponed -> Elab Unit
retryEach g Nil = pure MkUnit
retryEach g (Cons p rest) = do
  r <-
    attempt
      (liftU
         (Unify.uEl
            (ms := Unify.msEv)
            (uf := Unify.ufEv)
            g
            p.shape
            p.left
            p.right))
  keepFailed p r
  retryEach g rest

retryGo : Globals.Globals -> Int -> Elab (List Postponed)
retryGo g fuel = do
  ps <- gets (\c -> List.reverse c.postponed)
  modify (setPostponed Nil)
  retryEach g ps
  left <- gets (\c -> c.postponed)
  if List.length left == 0 || List.length left == List.length ps || fuel > 50
  then pure (List.reverse left)
  else retryGo g (fuel + 1)

-- | Retry the postponed problems until no more are solved; a problem
-- | that fails outright is kept, to be reported as stuck: it holds the
-- | contradiction.
retryPostponed : Globals.Globals -> Elab (List Postponed)
retryPostponed g = retryGo g 0

delayedReady : Value.MetaCtx -> Bool -> Delayed ElabSt -> Bool
delayedReady mc all (MkDelayed ty chk) =
  all || not (Unify.isFlexTy (Value.forceTy mc ty))

anyDelayed : Value.MetaCtx -> List (Delayed ElabSt) -> Bool
anyDelayed mc Nil = False
anyDelayed mc (Cons d rest) = delayedReady mc False d || anyDelayed mc rest

resolveKept : List (Pair Bool (Wanted ElabSt)) -> List (Wanted ElabSt)
resolveKept Nil = Nil
resolveKept (Cons (MkPair True _) rest) = resolveKept rest
resolveKept (Cons (MkPair False w) rest) = Cons w (resolveKept rest)

resolveAny : List (Pair Bool (Wanted ElabSt)) -> Bool
resolveAny rs = List.any (\(p : Pair Bool (Wanted ElabSt)) -> fst p) rs

-- The handler
--------------------------------------------------------------------------------

-- Elaboration's handler (`elabE`'s, heff.elab.environment): its monad is a
-- step over the whole state (`Step`), a diagnostic ending the
-- computation where it is, the state kept.  The checks waiting are
-- steps in that state, run here: specialised for this handler, an
-- elaboration is the state passing it would be by hand.

type Step a = ElabSt -> Pair (Either Diag a) ElabSt

bindStep : {a b : Type}
         -> Pair (Either Diag a) ElabSt
         -> (a -> Step b)
         -> Pair (Either Diag b) ElabSt
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

catchStep : {a : Type}
          -> (Diag -> Step a)
          -> Pair (Either Diag a) ElabSt
          -> Pair (Either Diag a) ElabSt
catchStep h (MkPair (Left e) st) = h e st
catchStep h (MkPair (Right x) st) = MkPair (Right x) st

-- (the delayed checks, oldest first)
runEachS : List (Delayed ElabSt) -> Step Unit
runEachS Nil = \st -> MkPair (Right MkUnit) st
runEachS (Cons (MkDelayed ty chk) rest) = \st ->
    bindStep (chk st) (\u -> runEachS rest)

readyIn : Bool -> ElabSt -> List (Delayed ElabSt)
readyIn all st = List.keepIf (delayedReady (core st).metas all) (delayedOf st)

-- | the delayed checks whose types are known (every one, with `all`),
-- | run, until none is
wakeS : Bool -> Step Unit
wakeS all = \st ->
    if List.null (readyIn all st) then MkPair (Right MkUnit) st
    else bindStep
        (runEachS
           -- (the state holds them newest first; they run oldest first, in
           -- the order they were delayed)
           (List.reverse (readyIn all st))
           (withDelayed
              (\ds ->
                 List.keepIf
                   (\d -> not (delayedReady (core st).metas all d))
                   ds)
              st))
        (\u -> wakeS all)

-- (a search as it is: its failure is the elaboration's)
asItIs : Step Bool -> Step Bool
asItIs s = s

-- (a search tried before the definition settles: where it fails, what
-- it did is undone and it waits on, so that it fails where it would
-- have, when the definition settles)
untilSettled : Step Bool -> Step Bool
untilSettled s = \st -> case s st of
  MkPair (Left d) st2 -> MkPair (Right False) st
  r -> r

resolveListS : (Step Bool -> Step Bool)
             -> Bool
             -> List (Wanted ElabSt)
             -> Step (List (Pair Bool (Wanted ElabSt)))
resolveListS tried final Nil = \st -> MkPair (Right Nil) st
resolveListS tried final (Cons (MkWanted sp f) rest) = \st ->
    bindStep
      (tried (f final) st)
      (\done st2 ->
         bindStep
           (resolveListS tried final rest st2)
           (\rs st3 ->
              MkPair (Right (Cons (MkPair done (MkWanted sp f)) rs)) st3))

-- | each wanted instance tried (as `tried` says); those found dropped
resolveByS : (Step Bool -> Step Bool) -> Bool -> Step Bool
resolveByS tried final = \st ->
    if List.null (wantedOf st) then MkPair (Right False) st
    else bindStep
        (resolveListS tried final (wantedOf st) (withWanted (\w -> Nil) st))
        (\rs st2 ->
           MkPair
             (Right (resolveAny rs))
             (withWanted (\w -> List.append w (resolveKept rs)) st2))

resolveS : Bool -> Step Bool
resolveS final = resolveByS asItIs final

-- | the delayed checks whose types are known run, and the instance
-- | arguments whose goals are found -- as soon as they are, not once the
-- | definition settles, so that what a found instance says (its type
-- | members) is known to what follows; one not found yet waits on --
-- | until neither moves.  With `all`, every delayed check, and no search.
wakeResolveS : Bool -> Step Unit
wakeResolveS all = \st ->
    bindStep
      (wakeS all st)
      (\u st2 ->
         if all then MkPair (Right MkUnit) st2
         else bindStep
             (resolveByS untilSettled False st2)
             (\found st3 ->
                if found then wakeResolveS all st3
                else MkPair (Right MkUnit) st3))

stateAlg : {a : Type} -> State.StateF StCore Step a -> Step a
stateAlg (Get k) = \st -> MkPair (Right (k (core st))) st
stateAlg (Put c x) = \st -> MkPair (Right x) (withCore (\old -> c) st)

exceptionAlg : {a : Type} -> Exception.ExceptionF Diag Step a -> Step a
exceptionAlg (Throw d) = \st -> MkPair (Left d) st
exceptionAlg (Catch c h) = \st -> catchStep h (c st)

deferAlg : {a : Type} -> DeferF Step a -> Step a
deferAlg (Delay ty c x) = \st ->
    MkPair (Right x) (withDelayed (\ds -> Cons (MkDelayed ty c) ds) st)
deferAlg (Want sp f x) = \st ->
    MkPair
      (Right x)
      (withWanted (\ws -> List.append ws (Cons (MkWanted sp f) Nil)) st)
deferAlg (Wake all x) = \st ->
    bindStep (wakeResolveS all st) (\u st2 -> MkPair (Right x) st2)
deferAlg (Resolve final k) = \st ->
    bindStep (resolveS final st) (\b st2 -> MkPair (Right (k b)) st2)
deferAlg (Pending k) = \st ->
    MkPair (Right (k (anyDelayed (core st).metas (delayedOf st)))) st
deferAlg (SaveDelayed k) = \st ->
    MkPair (Right (k (MkSaved (delayedOf st) (wantedOf st)))) st
deferAlg (RestoreDelayed sv x) = \st -> MkPair (Right x) (restoreTo sv st)
deferAlg (RestoreWaiting sv x) = \st -> MkPair (Right x) (restoreAllTo sv st)

notesAlg : {a : Type} -> NotesF Step a -> Step a
notesAlg (Trace ev x) = \st -> MkPair (Right x) (withCore (pushTrace ev) st)
notesAlg (Record i x) = \st -> MkPair (Right x) (withCore (pushInfo i) st)

-- (the sum, one level at a time: `((state <+> exception) <+> defer) <+> notes`)
alg2 : {a : Type}
     -> SumF (State.StateF StCore) (Exception.ExceptionF Diag) Step a
     -> Step a
alg2 (InL t) = stateAlg t
alg2 (InR q) = exceptionAlg q

alg3 : {a : Type}
     -> SumF
       (SumF (State.StateF StCore) (Exception.ExceptionF Diag))
       DeferF
       Step
       a
     -> Step a
alg3 (InL p) = alg2 p
alg3 (InR q) = deferAlg q

elabAlg : {a : Type} -> elabE.f Step a -> Step a
elabAlg (InL p) = alg3 p
elabAlg (InR q) = notesAlg q

elabH : Handler elabE
elabH =
  { M = Step
  , ret = \x st -> MkPair (Right x) st
  , bind = \m k st -> bindStep (m st) k
  , malg = \p -> elabAlg p
  }

-- | an elaboration, as a step from a state: its value, or the error it
-- | failed with
-- | >>> either (\(d : Diag) -> d.msg) (\n -> show n) (fst (runE (bind (val 20) (\x -> val (x + 22))) emptySt))
-- | "42"
-- | >>> either (\(d : Diag) -> d.msg) (\n -> show n) (fst (runE (bind (failWith (a := Int) Params.noSpan 8 "no") (\x -> val 1)) emptySt))
-- | "no"
runE : {a : Type} -> Elab a -> Step a
runE m = handle elabH m

-- | Run the delayed checks whose types are now known (and those they
-- | delay in turn), and find the instance arguments whose goals are;
-- | with `all`, every delayed check, known or not.
runDelayed : Bool -> Elab Unit
runDelayed all = wake all

-- | try each waiting instance argument; `final` refuses the
-- | ones whose goals never became determined.  Answers whether any was
-- | found (the loop then goes again).
resolveWanteds : Bool -> Elab Bool
resolveWanteds final = resolve final

approximated : Either Conversion.EqErr Bool -> Bool
approximated (Right b) = b
approximated (Left _) = False

-- | the first of the problems still stuck (oldest first) that a
-- | first-order approximation solves (`Unify.approximate`, #88), solved;
-- | one that failed holds a contradiction, and is left as it is
approximateFirst : Globals.Globals -> List Postponed -> Elab Bool
approximateFirst g Nil = pure False
approximateFirst g (Cons p rest) =
  if p.failed then approximateFirst g rest
  else do
    r <-
      attempt
        (liftU
           (Unify.approximate
              (ms := Unify.msEv)
              (uf := Unify.ufEv)
              g
              p.shape
              p.left
              p.right))
    if approximated r then pure True else approximateFirst g rest

settleGo : Globals.Globals -> Int -> Elab (List Postponed)
settleGo g fuel = do
  runDelayed False
  retryPostponed g
  -- find the instance arguments whose goals are determined now
  moved <- resolveWanteds False
  ready <- pending
  if (ready || moved) && fuel <= 50 then settleGo g (fuel + 1)
  else do
    -- nothing moves: a problem still stuck approximated, then again
    stuck <- gets (\c -> List.reverse c.postponed)
    guessed <- approximateFirst g stuck
    if guessed && fuel <= 50 then settleGo g (fuel + 1)
    else do
      runDelayed True
      moved2 <- resolveWanteds True
      retryPostponed g

-- | Let the postponed problems and the delayed checks feed one another
-- | until neither moves; then force what is left, and retry once more.
settle : Globals.Globals -> Elab (List Postponed)
settle g = settleGo g 0

-- >>> List.length (OrdMap.values (OrdMap.insert OrdMap.empty 1 "a"))
-- 1
