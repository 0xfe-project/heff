-- The effect of a computation (`Co h a`, lib/co.hf) as a runtime sees
-- it.  Effects summed (`<+>`), and leaves -- each a global's key,
-- `browser.dom.dom`, whose module may hold the world's side of it, an
-- effect provider (`dom.provider.js` beside `dom.hf`, see
-- lib/browser/dom.provider.js).

import heff.elab.globals as Globals
import heff.elab.syntax as Syntax

data Effect = Leaf String | Plus Effect Effect

appendE : {a : Type} -> List a -> List a -> List a
appendE Nil ys = ys
appendE (Cons x xs) ys = Cons x (appendE xs ys)

-- | >>> leaves (Plus (Plus (Leaf "stdio") (Leaf "process")) (Leaf "filesystem"))
-- | ["stdio", "process", "filesystem"]
leaves : Effect -> List String
leaves (Leaf x) = Cons x Nil
leaves (Plus a b) = appendE (leaves a) (leaves b)

plusM : Maybe Effect -> Maybe Effect -> Maybe Effect
plusM (Just a) (Just b) = Just (Plus a b)
plusM _ _ = Nothing

dropLastD : List String -> List String
dropLastD Nil = Nil
dropLastD (Cons x Nil) = Nil
dropLastD (Cons x rest) = Cons x (dropLastD rest)

lastOr : String -> List String -> String
lastOr d Nil = d
lastOr d (Cons x Nil) = x
lastOr d (Cons x rest) = lastOr d rest

-- | the module of a leaf's key: `dom.dom` is `dom`'s, `a.b.c` is `a.b`'s
moduleOfKey : String -> String
moduleOfKey k = joinWith "." (dropLastD (split "." k))

-- | ... and the definition's name in it
nameOfKey : String -> String
nameOfKey k = lastOr k (split "." k)

orLeaf : String -> Maybe Effect -> Maybe Effect
orLeaf k Nothing = Just (Leaf k)
orLeaf k (Just e) = Just e

-- | `h`, an effect: a sum, or a leaf -- a global, by its key, not its
-- | name (a definition that is a sum is seen through; one that is not a
-- | sum is a leaf: whether its module provides it is the caller's to
-- | ask, by the key)
effectOf : Globals.Globals -> Syntax.Tm -> Maybe Effect
effectOf g (SIs e') = effectOf g e'
effectOf g (SApp (SApp (SGlobal p) a) b) =
  if strEq p "co.plus" || strEq p "co.<+>"
    then plusM (effectOf g a) (effectOf g b)
  else Nothing
effectOf g (SApp (SGlobal k) _) = Just (Leaf k)
effectOf g (SGlobal k) = case Globals.lookupEntry g k of
  Just entry -> orLeaf k (effectOf g entry.syntax)
  Nothing -> Just (Leaf k)
effectOf g e = Nothing

-- | a computation's effect, from its type: `Co h a`, which is a
-- | function taking a `Handler h`
computationEffect : Globals.Globals -> Syntax.Ty -> Maybe Effect
computationEffect g (SFunction _ (SDecode (SApp (SGlobal p) h)) _ _ _) =
  if strEq p "co.Handler" then effectOf g h else Nothing
computationEffect g (SDecode (SApp (SApp (SGlobal p) h) _)) =
  if strEq p "co.Co" then effectOf g h else Nothing
computationEffect g t = Nothing
