-- Globals: an insertion-ordered map of names to elaborated
-- definitions.  `syntax` is the definition at case D with itself as
-- local 0, `tySyntax` its type, closed; `value` and `type_` their
-- evaluations (`src/heff/elab/top.hf` ties the knot).

import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.map as Map

type Entry =
  { syntax : Syntax.Tm
  , tySyntax : Syntax.Ty
  , value : Value.V
  , type_ : Value.Ty
  }

-- | a top-level instance in scope, a candidate for the instance arguments
-- | elaborated under it: its key, and the module that declares it
type Instance = { key : String, module : String }

-- | `aliases` maps a name to the key it stands for; `broken` the keys of
-- | definitions that did not elaborate (a use of one is not an error of
-- | its own); `ambiguous` a name that stands for more than one key, the
-- | keys (a use of it unqualified is an error), and `places` where a key
-- | is defined, said (`prelude, at lib/prelude.hf:23`); `instances`, the
-- | top-level instances in scope -- the module's own declared so far, and
-- | those of the modules it imports, not of what those import -- newest
-- | first
type Globals =
  { order : List String
  , entries : Map.Map String Entry
  , aliases : Map.Map String String
  , broken : Map.Map String Unit
  , ambiguous : Map.Map String (List String)
  , places : Map.Map String String
  , instances : List Instance
  }

emptyGlobals : Globals
emptyGlobals =
  { order = Nil
  , entries = Map.empty
  , aliases = Map.empty
  , broken = Map.empty
  , ambiguous = Map.empty
  , places = Map.empty
  , instances = Nil
  }

addBroken : String -> Globals -> Globals
addBroken k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = Map.insert g.broken k MkUnit
  , ambiguous = g.ambiguous
  , places = g.places
  , instances = g.instances
  }

-- (`x` is `M.y`, from the dot at `i` on, where the qualifier `M.` is
-- broken)
underBrokenFrom : Globals -> String -> Int -> Bool
underBrokenFrom g x i = case indexFrom "." x i of
  Just j ->
    Map.member g.broken (strSlice x 0 (j + 1))
    || underBrokenFrom g x (j + 1)
  Nothing -> False

-- | whether the name `x` is `M.y`, where `M` is the alias of a module
-- | that did not load (`addBroken "M."`: no key ends with a dot): it
-- | may be any of that module's definitions
underBroken : Globals -> String -> Bool
underBroken g x = underBrokenFrom g x 0

-- | whether the name `x` stands for a definition that did not elaborate:
-- | what it is an alias for, else (a key being itself) `x` -- or one of
-- | a module that did not load (`underBroken`)
isBroken : Globals -> String -> Bool
isBroken g x = case Map.lookup g.aliases x of
  Just k -> Map.member g.broken k
  Nothing -> Map.member g.broken x || underBroken g x

-- | (a redefinition moves the name to the end; `order` is kept backwards
-- | here, newest first, and reversed where it is read.  Only then is it
-- | copied: an old `Globals` is kept by what was elaborated under it,
-- | and a copy each time held them all, quadratic in the definitions)
addEntry : String -> Entry -> Globals -> Globals
addEntry x e g =
  { order =
      if Map.member g.entries x
        then Cons x (List.filter (\y -> not (strEq y x)) g.order)
      else Cons x g.order
  , entries = Map.insert g.entries x e
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , instances = g.instances
  }

addAlias : String -> String -> Globals -> Globals
addAlias name key g =
  { order = g.order
  , entries = g.entries
  , aliases = Map.insert g.aliases name key
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , instances = g.instances
  }

-- | where the key `k` is defined, said
addPlace : String -> String -> Globals -> Globals
addPlace k place g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = Map.insert g.places k place
  , instances = g.instances
  }

placeOf : Globals -> String -> String
placeOf g k = case Map.lookup g.places k of
  Just place -> place
  Nothing -> k

-- | the keys the name `x` stands for, if more than one
ambiguousIn : Globals -> String -> Maybe (List String)
ambiguousIn g x = Map.lookup g.ambiguous x

-- | the name `x` stands for the keys `ks` too: no longer for one alone
addAmbiguous : String -> List String -> Globals -> Globals
addAmbiguous x ks g =
  { order = g.order
  , entries = g.entries
  , aliases = Map.delete g.aliases x
  , broken = g.broken
  , ambiguous =
      Map.insert
        g.ambiguous
        x
        (List.append
           (case ambiguousIn g x of
            Just old -> List.filter (\k -> not (List.elemBy strEq k ks)) old
            Nothing -> Nil)
           ks)
  , places = g.places
  , instances = g.instances
  }

-- | the definition under the key `k`, and the key
keyedEntry : Globals -> String -> Maybe (Pair String Entry)
keyedEntry g k = case Map.lookup g.entries k of
  Just e -> Just (MkPair k e)
  Nothing -> Nothing

-- | resolve a name to its key and entry: what the name is an alias for
-- | -- the module's own definition, else an import's -- else, a key
-- | being itself, the definition under it.  A primitive's key is its
-- | bare name: the module's own definition of that name, or an import's,
-- | comes before it, as before any other.  (A name that stands for more
-- | than one key is ambiguous, `ambiguousIn`, not resolved)
lookupKey : Globals -> String -> Maybe (Pair String Entry)
lookupKey g x = case Map.lookup g.aliases x of
  Just k -> keyedEntry g k
  Nothing -> keyedEntry g x

-- | the definition a name stands for (`lookupKey`)
lookupName : Globals -> String -> Maybe Entry
lookupName g x = case lookupKey g x of
  Just (MkPair _ e) -> Just e
  Nothing -> Nothing

-- | the definition under the key `k` -- else under what `k` is an alias
-- | for.  The key comes first: `intAdd` is the primitive here, where the
-- | name `intAdd` may be the module's own (`lookupName` for a name)
lookupEntry : Globals -> String -> Maybe Entry
lookupEntry g k = case Map.lookup g.entries k of
  Just e -> Just e
  Nothing -> case Map.lookup g.aliases k of
    Just k2 -> Map.lookup g.entries k2
    Nothing -> Nothing

-- (the name `x` stands for one key again)
notAmbiguous : String -> Globals -> Globals
notAmbiguous x g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = Map.delete g.ambiguous x
  , places = g.places
  , instances = g.instances
  }

-- | the module's own definition of `x`, by the key `k`: the name stands
-- | for it, whatever it stood for before -- an import's, or two imports'
-- | -- as a module's own definition comes first
addOwn : String -> String -> Globals -> Globals
addOwn x k g = addAlias x k (notAmbiguous x g)

-- | the definition under the key `k`, declared by the module `module`,
-- | is an instance in scope (once: declared again, it comes in anew)
addInstance : String -> String -> Globals -> Globals
addInstance k module g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , instances =
      Cons
        { key = k, module = module }
        (List.filter (\(i : Instance) -> not (strEq i.key k)) g.instances)
  }

-- | the definition under the key `k` is no instance: defined again, as
-- | a definition
dropInstance : String -> Globals -> Globals
dropInstance k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , instances = List.filter (\(i : Instance) -> not (strEq i.key k)) g.instances
  }

-- | the top-level instances in scope, in the order they came into it
instancesOf : Globals -> List Instance
instancesOf g = List.reverse g.instances

-- | whether the definition under the key `k` is an instance in scope
isInstance : Globals -> String -> Bool
isInstance g k = List.any (\(i : Instance) -> strEq i.key k) g.instances

-- | every definition, in the order declared (`order` is kept newest
-- | first)
globalsList : Globals -> List (Pair String Entry)
globalsList g =
  List.foldl
    (\acc k -> case Map.lookup g.entries k of
     Just e -> Cons (MkPair k e) acc
     Nothing -> acc)
    Nil
    g.order

-- | (evaluation only reaches globals that are there)
-- | >>> (elemAt (addEntry "k" { syntax = SOpaque, tySyntax = SPrimInt, value = VOpaque, type_ = VPrimInt } emptyGlobals) "k").tySyntax
-- | SPrimInt
elemAt : Globals -> String -> Entry
elemAt g x = case Map.lookup g.entries x of
  Just e -> e
  Nothing -> abandon
