-- Globals: an insertion-ordered map of names to elaborated
-- definitions.  `syntax` is the definition at case D with itself as
-- local 0, `tySyntax` its type, closed; `value` and `type_` their
-- evaluations.

module heff.elab.globals

import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.ordmap as OrdMap

type Entry =
  { syntax : Syntax.Tm
  , tySyntax : Syntax.Ty
  , value : Value.V
  , type_ : Value.Ty
  }

-- | a top-level instance in scope, a candidate for the instance arguments
-- | elaborated under it: its key, and the module that declares it
type Instance = { key : String, module : String }

-- | `aliases` maps a name to the key it stands for; `broken` the keys of
-- | definitions that did not elaborate (a use of one is not an error of
-- | its own); `ambiguous` a name that stands for more than one key, the
-- | keys (a use of it unqualified is an error), and `places` where a key
-- | is defined, said (`prelude, at lib/prelude.hf:23`); `instances`, the
-- | top-level instances in scope -- the module's own declared so far, and
-- | those of the modules it imports, not of what those import -- newest
-- | first; `hidden`, the keys a module's claim does not expose (a key
-- | is no name for them here), and `T(..)` for a data type `T` whose
-- | tags it does not, each with that module
type Globals =
  { order : List String
  , entries : OrdMap.OrdMap String Entry
  , aliases : OrdMap.OrdMap String String
  , broken : OrdMap.OrdMap String Unit
  , ambiguous : OrdMap.OrdMap String (List String)
  , places : OrdMap.OrdMap String String
  , hidden : OrdMap.OrdMap String String
  , instances : List Instance
  }

emptyGlobals : Globals
emptyGlobals =
  { order = Nil
  , entries = OrdMap.empty
  , aliases = OrdMap.empty
  , broken = OrdMap.empty
  , ambiguous = OrdMap.empty
  , places = OrdMap.empty
  , hidden = OrdMap.empty
  , instances = Nil
  }

addBroken : String -> Globals -> Globals
addBroken k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = OrdMap.insert g.broken k MkUnit
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = g.hidden
  , instances = g.instances
  }

-- (`x` is `M.y`, from the dot at `i` on, where the qualifier `M.` is
-- broken)
underBrokenFrom : Globals -> String -> Int -> Bool
underBrokenFrom g x i = case indexOf "." x i of
  Just j ->
    OrdMap.member g.broken (strSlice x 0 (j + 1))
    || underBrokenFrom g x (j + 1)
  Nothing -> False

-- | whether the name `x` is `M.y`, where `M` is the alias of a module
-- | that did not load (`addBroken "M."`: no key ends with a dot): it
-- | may be any of that module's definitions
underBroken : Globals -> String -> Bool
underBroken g x = underBrokenFrom g x 0

-- | whether the name `x` stands for a definition that did not elaborate:
-- | what it is an alias for, else (a key being itself) `x` -- or one of
-- | a module that did not load (`underBroken`)
isBroken : Globals -> String -> Bool
isBroken g x = case OrdMap.lookup g.aliases x of
  Just k -> OrdMap.member g.broken k
  Nothing -> OrdMap.member g.broken x || underBroken g x

-- | (a redefinition moves the name to the end; `order` is kept backwards
-- | here, newest first, and reversed where it is read.  Only then is it
-- | copied: an old `Globals` is kept by what was elaborated under it,
-- | and a copy each time held them all, quadratic in the definitions)
addEntry : String -> Entry -> Globals -> Globals
addEntry x e g =
  { order =
      if OrdMap.member g.entries x
      then x :: List.keepIf (\y -> not (strEq y x)) g.order
      else x :: g.order
  , entries = OrdMap.insert g.entries x e
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = g.hidden
  , instances = g.instances
  }

addAlias : String -> String -> Globals -> Globals
addAlias name key g =
  { order = g.order
  , entries = g.entries
  , aliases = OrdMap.insert g.aliases name key
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = g.hidden
  , instances = g.instances
  }

-- | where the key `k` is defined, said
addPlace : String -> String -> Globals -> Globals
addPlace k place g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = OrdMap.insert g.places k place
  , hidden = g.hidden
  , instances = g.instances
  }

placeOf : Globals -> String -> String
placeOf g k = case OrdMap.lookup g.places k of
  Just place -> place
  Nothing -> k

-- | the key `k` hidden by the module `m`'s claim (`T(..)`: the tags of
-- | the data type `T`)
addHidden : String -> String -> Globals -> Globals
addHidden k m g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = OrdMap.insert g.hidden k m
  , instances = g.instances
  }

-- | the module whose claim hides the tags of the data type `k`, if one
-- | does
sealedBy : Globals -> String -> Maybe String
sealedBy g k = OrdMap.lookup g.hidden (k ^ "(..)")

-- | the module whose claim hides what the name `x` would stand for --
-- | `M.y`, where `M` is the alias of a module that defines `y` and does
-- | not expose it -- if one does
hiddenBy : Globals -> String -> Maybe String
hiddenBy g x = OrdMap.lookup g.hidden x

-- | the name `x` stands for the keys `ks` too: no longer for one alone
addAmbiguous : String -> List String -> Globals -> Globals
addAmbiguous x ks g =
  { order = g.order
  , entries = g.entries
  , aliases = OrdMap.delete g.aliases x
  , broken = g.broken
  , ambiguous =
      OrdMap.insert
        g.ambiguous
        x
        (List.append
           (case OrdMap.lookup g.ambiguous x of
            Just old -> List.keepIf (\k -> not (List.elem k ks)) old
            Nothing -> Nil)
           ks)
  , places = g.places
  , hidden = g.hidden
  , instances = g.instances
  }

-- | the definition under the key `k`, and the key
keyedEntry : Globals -> String -> Maybe (Pair String Entry)
keyedEntry g k = case OrdMap.lookup g.entries k of
  Just e -> Just (MkPair k e)
  Nothing -> Nothing

-- | what a name stands for: a definition, by its key; more than one,
-- | the keys (used unqualified, an error); one that did not elaborate (a
-- | use of it is not an error of its own); nothing
data Resolved
  = Defined String Entry
  | Ambiguous (List String)
  | Broken
  | Unbound

-- (`x` names no definition there is: one that did not elaborate, or none)
unresolved : Globals -> String -> Resolved
unresolved g x = if isBroken g x then Broken else Unbound

-- (the definition under the key `k`, the name `x` standing for it)
resolvedTo : Globals -> String -> String -> Resolved
resolvedTo g x k = case OrdMap.lookup g.entries k of
  Just e -> Defined k e
  Nothing -> unresolved g x

-- | what the name `x` stands for, the one way a name is looked up: more
-- | than one key, ambiguous; else what it is an alias for -- the
-- | module's own definition, else an import's -- else, a key being
-- | itself, the definition under it.  A primitive's key is its bare
-- | name: the module's own definition of that name, or an import's,
-- | comes before it, as before any other.  A key a claim hides is no
-- | name
resolve : Globals -> String -> Resolved
resolve g x = case OrdMap.lookup g.ambiguous x of
  Just ks -> Ambiguous ks
  Nothing -> case OrdMap.lookup g.aliases x of
    Just k -> resolvedTo g x k
    Nothing ->
      if OrdMap.member g.hidden x then unresolved g x else resolvedTo g x x

-- (the places, said: `A, and B`, `A, B, and C`)
placesSaid : List String -> String
placesSaid [] = ""
placesSaid [x] = x
placesSaid [x, y] = x ^ ", and " ^ y
placesSaid (x :: rest) = x ^ ", " ^ placesSaid rest

-- | a name that stands for more than one definition, used unqualified:
-- | which, and where each is
ambiguousMsg : Globals -> String -> List String -> String
ambiguousMsg g x ks =
  "`" ^ x ^ "` is defined " ^ placesSaid (List.map (placeOf g) ks)

-- | the definition under the key `k` -- else under what `k` is an alias
-- | for.  The key comes first: `intAdd` is the primitive here, where the
-- | name `intAdd` may be the module's own (`resolve` for a name)
lookupEntry : Globals -> String -> Maybe Entry
lookupEntry g k = case OrdMap.lookup g.entries k of
  Just e -> Just e
  Nothing -> case OrdMap.lookup g.aliases k of
    Just k2 -> OrdMap.lookup g.entries k2
    Nothing -> Nothing

-- (the name `x` stands for one key again)
notAmbiguous : String -> Globals -> Globals
notAmbiguous x g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = OrdMap.delete g.ambiguous x
  , places = g.places
  , hidden = g.hidden
  , instances = g.instances
  }

-- | the module's own definition of `x`, by the key `k`: the name stands
-- | for it, whatever it stood for before -- an import's, or two imports'
-- | -- as a module's own definition comes first
addOwn : String -> String -> Globals -> Globals
addOwn x k g = addAlias x k (notAmbiguous x g)

-- | the definition under the key `k`, declared by the module `module`,
-- | is an instance in scope (once: declared again, it comes in anew)
addInstance : String -> String -> Globals -> Globals
addInstance k module g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = g.hidden
  , instances =
      { key = k, module = module }
      :: List.keepIf (\(i : Instance) -> not (strEq i.key k)) g.instances
  }

-- | the definition under the key `k` is no instance: defined again, as
-- | a definition
dropInstance : String -> Globals -> Globals
dropInstance k g =
  { order = g.order
  , entries = g.entries
  , aliases = g.aliases
  , broken = g.broken
  , ambiguous = g.ambiguous
  , places = g.places
  , hidden = g.hidden
  , instances = List.keepIf (\(i : Instance) -> not (strEq i.key k)) g.instances
  }

-- | the top-level instances in scope, in the order they came into it
instancesOf : Globals -> List Instance
instancesOf g = List.reverse g.instances

-- | whether the definition under the key `k` is an instance in scope
isInstance : Globals -> String -> Bool
isInstance g k = List.any (\(i : Instance) -> strEq i.key k) g.instances

-- | every definition, in the order declared (`order` is kept newest
-- | first)
globalsList : Globals -> List (Pair String Entry)
globalsList g =
  List.foldl
    (\acc k -> case OrdMap.lookup g.entries k of
     Just e -> MkPair k e :: acc
     Nothing -> acc)
    Nil
    g.order

-- | (evaluation only reaches globals that are there)
-- | >>> (elemAt (addEntry "k" { syntax = SOpaque, tySyntax = SPrimInt, value = VOpaque, type_ = VPrimInt } emptyGlobals) "k").tySyntax
-- | SPrimInt
elemAt : Globals -> String -> Entry
elemAt g x = case OrdMap.lookup g.entries x of
  Just e -> e
  Nothing -> abandon
