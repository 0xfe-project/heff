-- The locals of a file, as written: each binder, and the names that
-- refer to it.  Read from the presyntax --
-- before the equations are compiled to matches, which merges the
-- variables of different equations into one -- by the scoping the
-- elaborator follows: a name refers to the nearest binder of it around
-- it, else to a global.
--
-- What binds: a lambda's parameters and a `case` alternative's, an
-- equation's patterns, `let p = e in e'`, `x <- e` and `let p = e` in a
-- `do` block (for the statements after it), a local definition of a
-- `where` (for itself, those after it and the equation's body), a named
-- argument of a function type (for what follows it), a definition's or a
-- theory's parameters (for what follows them); and
-- a signature's implicit arguments, which its equations are under.  A
-- record type's field is in scope for the fields after it: a use of one
-- is the field's (`fields`), not a local's.

import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax

-- | a local: its name, where its binder is, where it is used
type Local = { name : String, binder : Params.Span, uses : List Params.Span }

-- | a use of a record type's field among the fields after it (`t` of
-- | `m : t -> t`), and where the field is declared
type FieldUse = { name : String, field : Params.Span, use : Params.Span }

type Binder = { name : String, span : Params.Span, field : Bool }

type Use = { binder : Binder, use : Params.Span }

type Found = { binders : List Binder, uses : List Use }

type Locals = { locals : List Local, fields : List FieldUse }

none : Found
none = { binders = Nil, uses = Nil }

both : Found -> Found -> Found
both a b =
  { binders = List.append a.binders b.binders
  , uses = List.append a.uses b.uses
  }

bound : List Binder -> Found
bound bs = { binders = bs, uses = Nil }

binder : String -> Params.Span -> Binder
binder name span = { name = name, span = span, field = False }

sameSpan : Params.Span -> Params.Span -> Bool
sameSpan a b = a.start == b.start && a.end == b.end

-- | binders in scope, the innermost first
scope : List Binder -> List Binder -> List Binder
scope bs env = List.foldl (\e b -> Cons b e) env bs

findBinder : String -> List Binder -> Maybe Binder
findBinder x Nil = Nothing
findBinder x (Cons b rest) =
  if strEq b.name x then Just b else findBinder x rest

-- | the variables a pattern binds (`_` binds nothing; a tag is no
-- | variable, nor is an operator, another name for one)
patternBinders : Presyntax.Pat -> List Binder
patternBinders (At (PatVar x) sp) = if strEq x "_" then Nil else [binder x sp]
patternBinders (At (PatTag _ _ ps) _) = List.concatMap patternBinders ps
patternBinders (At (PatOp _ _ ps) _) = List.concatMap patternBinders ps
patternBinders (At (PatAs x sp q) _) = Cons (binder x sp) (patternBinders q)
patternBinders (At (PatRecord fs) _) =
  List.concatMap
    (\f -> case f of
     MkFieldPat _ q -> patternBinders q)
    fs
patternBinders p = Nil

-- | a signature's implicit and instance arguments, which its equations
-- | are under
implicitsOf : Presyntax.Expr -> List Binder
implicitsOf (At (EPi (PiImplicit x sp _ _ _) r) _) =
  Cons (binder x sp) (implicitsOf r)
implicitsOf (At (EPi (PiInstance x sp _ _) r) _) =
  Cons (binder x sp) (implicitsOf r)
implicitsOf _ = Nil

-- | the walk: a name's use, or what binds around what
type Walk =
  { walk : List Binder -> Presyntax.Expr -> Found
  , decl : List Binder -> Presyntax.Decl -> Found
  , doBlock :
        List Binder
        -> List (Params.Spanned (Presyntax.Stmt Presyntax.Expr))
        -> Found
  , sigBlock :
        List Binder
        -> List
          (Params.Spanned (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr))
        -> Found
  }

walkAll : Walk -> List Binder -> List Presyntax.Expr -> Found
walkAll w env ns = List.foldl (\acc x -> both acc (w.walk env x)) none ns

under : Walk -> List Binder -> List Binder -> Presyntax.Expr -> Found
under w env bs r = both (bound bs) (w.walk (scope bs env) r)

-- (a field's name, set or declared, is no use of anything)
fieldSetting : Walk
             -> List Binder
             -> Params.Spanned (Presyntax.FieldSet Presyntax.Expr)
             -> Found
fieldSetting w env (At (SetField _ _ e) _) = w.walk env e
fieldSetting w env (At (BadFieldSet e) _) = w.walk env e

-- | the name a local definition (`where`) binds
localBinders : Presyntax.Decl -> List Binder
localBinders (At (DeclEquations f fsp _ _ _) _) = [binder f fsp]
localBinders d = Nil

-- | an equation: its patterns bind in its body
equationF : Walk
          -> List Binder
          -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
          -> Found
equationF w env (At (MkEquation _ _ ps rhs) _) =
  under w env (List.concatMap patternBinders ps) rhs

-- (an equation's head, the definition's name: a use of it)
headUse : List Binder
        -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
        -> Found
headUse env (At (MkEquation f fsp _ _) _) = case findBinder f env of
  Just b -> { binders = Nil, uses = [{ binder = b, use = fsp }] }
  Nothing -> none

-- | a local definition: its signature, then its equations under the
-- | signature's implicit arguments
localDefF : Walk -> List Binder -> Presyntax.Decl -> Found
localDefF w env (At (DeclEquations _ _ _ ty eqs) _) =
  both
    (w.walk env ty)
    (List.foldl
       (\acc eq ->
          both
            acc
            (both
               (headUse env eq)
               (equationF w (scope (implicitsOf ty) env) eq)))
       none
       eqs)
localDefF w env d = w.decl env d

-- | an equation's `where`: each local definition in scope in itself,
-- | those after it and the equation's body
localsF : Walk -> List Binder -> List Presyntax.Decl -> Presyntax.Expr -> Found
localsF w env Nil body = w.walk env body
localsF w env (d :: ds) body =
  both
    (bound (localBinders d))
    (both
       (localDefF w (scope (localBinders d) env) d)
       (localsF w (scope (localBinders d) env) ds body))

-- | a name, a use where something binds it
useOf : List Binder -> String -> Params.Span -> Found
useOf env x sp = case findBinder x env of
  Just b -> { binders = Nil, uses = [{ binder = b, use = sp }] }
  Nothing -> none

paramWalk : Walk
          -> List Binder
          -> Params.Spanned (Presyntax.Param Presyntax.Expr)
          -> Found
paramWalk w env (At (ExplicitParam x xsp t) _) =
  both (useOf env x xsp) (w.walk env t)
paramWalk w env (At (ImplicitParam x xsp t) _) =
  both (useOf env x xsp) (w.walk env t)

-- | a declaration where a local one is, walked as what it is written as
declF : Walk -> List Binder -> Presyntax.Decl -> Found
declF w env (At (DeclEquations f fsp _ ty eqs) _) =
  both
    (useOf env f fsp)
    (both
       (w.walk env ty)
       (List.foldl (\acc eq -> both acc (equationF w env eq)) none eqs))
declF w env (At (DeclDefine x xsp ps u body) _) =
  both
    (useOf env x xsp)
    (both
       (List.foldl (\acc m -> both acc (paramWalk w env m)) none ps)
       (both (w.walk env u) (w.walk env body)))
declF w env (At (DeclTheory _ _ _ body) _) = w.walk env body
declF w env (At (DeclPrimitive x xsp t) _) =
  both (useOf env x xsp) (w.walk env t)
declF w env (At (DeclTest x xsp) _) = useOf env x xsp
declF w env (At (DeclWatch e) _) = w.walk env e

lamBinders : Presyntax.LamBinder Presyntax.Expr -> List Binder
lamBinders (LamName x sp) = if strEq x "_" then Nil else [binder x sp]
lamBinders (LamImplicit x sp) = if strEq x "_" then Nil else [binder x sp]
lamBinders (LamAnn x sp _) = [binder x sp]

altF : Walk
     -> List Binder
     -> Params.Spanned (Presyntax.Alt Presyntax.Expr)
     -> Found
altF w env (At (MkAlt p r) _) = under w env (patternBinders p) r

walkF : Walk -> List Binder -> Presyntax.Expr -> Found
walkF w env n@(At (EVar x) _) = useOf env x (Params.spanOf n)
-- a lambda with its binder annotated, `\(x : T) -> e`: `T` is outside
walkF w env (At (ELam (LamAnn x sp a) r) _) =
  both (w.walk env a) (under w env [binder x sp] r)
walkF w env (At (ELam b r) _) = under w env (lamBinders b) r
walkF w env (At (ENamed _ e) _) = w.walk env e
walkF w env (At (EPi (PiNamed x sp a) r) _) =
  both (w.walk env a) (under w env [binder x sp] r)
walkF w env (At (EPi (PiImplicit x sp _ a d) r) _) =
  both
    (both (w.walk env a) (maybe none (w.walk env) d))
    (under w env [binder x sp] r)
walkF w env (At (EPi (PiInstance x sp _ a) r) _) =
  both (w.walk env a) (under w env [binder x sp] r)
walkF w env (At (EPi (PiAnon a) r) _) = both (w.walk env a) (w.walk env r)
walkF w env (At (EDo stmts) _) = w.doBlock env stmts
walkF w env (At (ELocal body defs) _) = localsF w env defs body
walkF w env (At (EStruct fs) _) =
  List.foldl (\acc f -> both acc (fieldSetting w env f)) none fs
walkF w env (At (EUpdate a fs) _) =
  List.foldl
    (\acc f -> case f of
     At (SetPath _ e) _ -> both acc (w.walk env e))
    (w.walk env a)
    fs
walkF w env (At (ESig fs) _) = w.sigBlock env fs
walkF w env (At (EAnn e t) _) = both (w.walk env e) (w.walk env t)
walkF w env (At (ESpec acc _ _ v) _) = both (w.walk env acc) (w.walk env v)
walkF w env (At (EApp h args) _) = both (w.walk env h) (walkAll w env args)
walkF w env (At (EMatch s alts) _) =
  both (w.walk env s) (List.foldl (\acc a -> both acc (altF w env a)) none alts)
walkF w env (At (ELetIn rhs a) _) = both (w.walk env rhs) (altF w env a)
walkF w env (At (ESum vs) _) =
  List.foldl
    (\acc v ->
       both acc (case v of
       At (TagVariant _ _ args) _ -> walkAll w env args
       At (BadVariant e) _ -> w.walk env e))
    none
    vs
walkF w env n = none

-- | `x <- e`: `x` is bound for the statements after it
doBlockF : Walk
         -> List Binder
         -> List (Params.Spanned (Presyntax.Stmt Presyntax.Expr))
         -> Found
doBlockF w env Nil = none
doBlockF w env (Cons (At (StmtBind x sp e) _) rest) =
  both
    (w.walk env e)
    (both (bound [binder x sp]) (w.doBlock (Cons (binder x sp) env) rest))
-- (`let p = e`: `p`'s variables, for the statements after it)
doBlockF w env (Cons (At (StmtLet p e) _) rest) =
  both
    (w.walk env e)
    (both
       (bound (patternBinders p))
       (w.doBlock (scope (patternBinders p) env) rest))
doBlockF w env (Cons (At (StmtExpr e) _) rest) =
  both (w.walk env e) (w.doBlock env rest)

-- | a record type's fields: each in scope for those after it
sigBlockF : Walk
          -> List Binder
          -> List
            (Params.Spanned (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr))
          -> Found
sigBlockF w env Nil = none
sigBlockF w env (Cons (At (DeclareField x sp a d) _) rest) =
  both
    (both (w.walk env a) (maybe none (w.walk env) d))
    (both
       (bound [{ name = x, span = sp, field = True }])
       (w.sigBlock (Cons { name = x, span = sp, field = True } env) rest))
sigBlockF w env (Cons (At (BadFieldDecl f) _) rest) =
  both (w.walk env f) (w.sigBlock env rest)

walker : Walk
walker =
  { walk = \env n -> walkF walker env n
  , decl = \env d -> declF walker env d
  , doBlock = \env ns -> doBlockF walker env ns
  , sigBlock = \env ns -> sigBlockF walker env ns
  }

-- | each parameter in scope for those after it, then what follows them
arguments : List Binder
          -> List (Params.Spanned (Presyntax.Param Presyntax.Expr))
          -> List Presyntax.Expr
          -> Found
arguments env Nil rest = walkAll walker env rest
-- (a parameter's type is in the scope of those before it)
arguments env (Cons (At (ExplicitParam x sp t) _) tl) rest =
  both
    (walker.walk env t)
    (both (bound [binder x sp]) (arguments (Cons (binder x sp) env) tl rest))
arguments env (Cons (At (ImplicitParam x sp t) _) tl) rest =
  both
    (walker.walk env t)
    (both (bound [binder x sp]) (arguments (Cons (binder x sp) env) tl rest))

-- | a declaration: its signature, then its equations under the
-- | signature's implicit arguments
declaration : Presyntax.Decl -> Found
declaration (At (DeclEquations _ _ _ ty eqs) _) =
  -- (the implicit arguments are bound in the signature, which walks
  -- them)
  both
    (walker.walk Nil ty)
    (List.foldl
       (\acc eq -> both acc (equationF walker (scope (implicitsOf ty) Nil) eq))
       none
       eqs)
-- a definition with named arguments (`data Pair a b = ...`): each in
-- scope for those after it, the type, and the body
declaration (At (DeclDefine _ _ ps ty body) _) = arguments Nil ps [ty, body]
-- a theory's parameters (`theory SET a`)
declaration (At (DeclTheory _ _ ps body) _) = arguments Nil ps [body]
declaration (At (DeclPrimitive _ _ t) _) = walker.walk Nil t
declaration (At (DeclTest _ _) _) = none
declaration (At (DeclWatch e) _) = walker.walk Nil e

usesOf : List Use -> Binder -> List Params.Span
usesOf us b =
  List.map
    (\(u : Use) -> u.use)
    (List.filter (\(u : Use) -> sameSpan u.binder.span b.span) us)

mkLocal : List Use -> Binder -> Local
mkLocal us b = { name = b.name, binder = b.span, uses = usesOf us b }

mkFieldUse : Use -> FieldUse
mkFieldUse u = { name = u.binder.name, field = u.binder.span, use = u.use }

localsOf : Found -> Locals
localsOf found =
  { locals =
      List.map
        (\b -> mkLocal found.uses b)
        (List.filter (\(b : Binder) -> not b.field) found.binders)
  , fields =
      List.map
        (\u -> mkFieldUse u)
        (List.filter (\(u : Use) -> u.binder.field) found.uses)
  }

-- | the locals of a file, and the uses of record fields among the
-- | fields after them
locals : List Presyntax.Decl -> Locals
locals decls =
  localsOf (List.foldl (\acc d -> both acc (declaration d)) none decls)
