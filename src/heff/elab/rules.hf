-- The typing rules.  The four judgments are functions in `Elab`
-- (src/heff/elab/environment.hf's `bind` is this module's `do`); checking
-- recovers from errors with holes.

import array as A
import co
import heff.elab.conversion as C
import heff.syntax.diagnostic
import heff.util.dict as D
import heff.elab.environment
import heff.elab.eval as EV
import heff.elab.fixed as Fx
import heff.elab.globals as G
import heff.elab.memoed as M
import heff.elab.meta as Mt
import heff.elab.params as P
import heff.elab.print as Pr
import heff.syntax.psurface as Ps
import heff.elab.readback as R
import heff.elab.rename as Rn
import heff.elab.syntax as Sx
import heff.elab.unify as U
import heff.elab.value as V
import map as Mp

-- Judgments
--------------------------------------------------------------------------------

data Typ = MkTyp (ElabEnv -> Elab M.Ty)

data SmallTyp = MkSmallTyp (ElabEnv -> Elab M.Ty)

data Syn = MkSyn (ElabEnv -> Elab (Pair M.El V.Ty))

data Chk = MkChk (ElabEnv -> V.Ty -> Elab M.El)

runTyp : Typ -> ElabEnv -> Elab M.Ty
runTyp (MkTyp f) e = f e

runSmall : SmallTyp -> ElabEnv -> Elab M.Ty
runSmall (MkSmallTyp f) e = f e

runSyn : Syn -> ElabEnv -> Elab (Pair M.El V.Ty)
runSyn (MkSyn f) e = f e

runChk : Chk -> ElabEnv -> V.Ty -> Elab M.El
runChk (MkChk f) e a = f e a

-- Mentions
--------------------------------------------------------------------------------

anyP : {a : Type} -> (a -> Bool) -> List a -> Bool
anyP p Nil = False
anyP p (Cons x xs) = p x || anyP p xs

anyIdxGo : {a : Type} -> Int -> (Int -> a -> Bool) -> List a -> Bool
anyIdxGo i f Nil = False
anyIdxGo i f (Cons x xs) = f i x || anyIdxGo (i + 1) f xs

anyWithIndex : {a : Type} -> (Int -> a -> Bool) -> List a -> Bool
anyWithIndex f xs = anyIdxGo 0 f xs

-- | whether syntax mentions a local, of those `var d i` says (`i` under
-- | `d` binders of the term)
type Mentions =
  { el : Int -> Sx.Tm -> Bool
  , ty : Int -> Sx.Ty -> Bool
  , var : Int -> Int -> Bool
  }

armMentions : Mentions -> Int -> Pair String (Pair (Array String) Sx.Tm) -> Bool
armMentions r d (MkPair tag (MkPair xs b)) = r.el (d + A.length xs) b

fieldMentions : Mentions -> Int -> Pair String Sx.Tm -> Bool
fieldMentions r d (MkPair k v) = r.el d v

variantMentions : Mentions -> Int -> Pair String (Array Sx.Ty) -> Bool
variantMentions r d (MkPair k args) = anyP (r.ty d) (A.toList args)

mentionsTermF : Mentions -> Int -> Sx.Tm -> Bool
mentionsTermF r d (SLocal i) = r.var d i
mentionsTermF r d (SCode a) = r.ty d a
mentionsTermF r d (SApp f a) = r.el d f || r.el d a
mentionsTermF r d (SLam dd (MkAbs x b)) = r.ty d dd || r.el (d + 1) b
mentionsTermF r d (SLam dd (AbsConst b)) = r.ty d dd || r.el d b
mentionsTermF r d (SCons dct) = anyP (fieldMentions r d) (D.toList dct)
mentionsTermF r d (SProj e l) = r.el d e
mentionsTermF r d (STag x as) = anyP (r.el d) (A.toList as)
mentionsTermF r d (SMatch e cs) =
  r.el d e || anyP (armMentions r d) (D.toList cs)
mentionsTermF r d (SSpecialize e l v) = r.el d e || r.el d v
mentionsTermF r d (SIs e) = r.el d e
mentionsTermF r d (SRec e) = r.el d e
mentionsTermF r d (SFix dd (MkAbs x b)) = r.ty d dd || r.el (d + 1) b
mentionsTermF r d (SFix dd (AbsConst b)) = r.ty d dd || r.el d b
mentionsTermF r d (SImplicit x e) = r.el d e
mentionsTermF r d (SMetaApp m ix ty) = r.ty d ty
mentionsTermF r d t = False

mentionsTypeF : Mentions -> Int -> Sx.Ty -> Bool
mentionsTypeF r d (SDecode e) = r.el d e
-- (an implicit argument's default is closed)
mentionsTypeF r d (SFunction level dom (MkAbs x b) implicit dflt) =
  r.ty d dom || r.ty (d + 1) b
mentionsTypeF r d (SFunction level dom (AbsConst b) implicit dflt) =
  r.ty d dom || r.ty d b
-- (a default names the fields before it only)
mentionsTypeF r d (SRecord level ft ds) =
  anyWithIndex (\i ty -> r.ty (d + i) ty) (A.toList ft.values)
mentionsTypeF r d (SSum vs) = anyP (variantMentions r d) (D.toList vs)
mentionsTypeF r d (SIsTy a) = r.ty d a
mentionsTypeF r d (SPrimArray a) = r.ty d a
mentionsTypeF r d t = False

-- | any local, from `d` binders out
mentions : Mentions
mentions =
  { el = \d t -> mentionsTermF mentions d t
  , ty = \d t -> mentionsTypeF mentions d t
  , var = \d i -> i >= d
  }

-- | the local `k`, of those around the term
mentionsLocal : Int -> Mentions
mentionsLocal k =
  { el = \d t -> mentionsTermF (mentionsLocal k) d t
  , ty = \d t -> mentionsTypeF (mentionsLocal k) d t
  , var = \d i -> i == d + k
  }

-- | does a type's syntax mention local 0 (the innermost binder)?
mentionsInner : Sx.Ty -> Bool
mentionsInner t = mentions.ty 0 t

-- | a default -- of a record type's field, of an implicit argument --
-- | the term, and where it is written
type Default = { chk : Chk, span : P.Span }

-- environment updates, spelled once
withScope : ElabEnv -> Scope -> ElabEnv
withScope e sc =
  { scope = sc
  , globals = e.globals
  , elabFor = e.elabFor
  , lams = e.lams
  , self = e.self
  , insts = e.insts
  }

withFor : ElabEnv -> ElabFor -> ElabEnv
withFor e ef =
  { scope = e.scope
  , globals = e.globals
  , elabFor = ef
  , lams = e.lams
  , self = e.self
  , insts = e.insts
  }

intoLam : ElabEnv -> Scope -> V.V -> ElabEnv
intoLam e sc v =
  { scope = sc
  , globals = e.globals
  , elabFor = appElabFor e.elabFor v
  , lams = e.lams + 1
  , self = e.self
  , insts = e.insts
  }

intoLamQuiet : ElabEnv -> Scope -> V.V -> ElabEnv
intoLamQuiet e sc v =
  { scope = sc
  , globals = e.globals
  , elabFor = appElabFor e.elabFor v
  , lams = e.lams
  , self = e.self
  , insts = e.insts
  }

-- | under an implicit or instance binder, bound silently: an instance
-- | one becomes a candidate for the searches under it
intoSilent : ElabEnv
           -> P.Plicity
           -> String
           -> V.Ty
           -> Scope
           -> V.V
           -> Bool
           -> ElabEnv
intoSilent e implicit y dom sc v counted =
  { scope = sc
  , globals = e.globals
  , elabFor = appElabFor e.elabFor v
  , lams = if counted then e.lams + 1 else e.lams
  , self = e.self
  , insts =
      if P.eqPlicity implicit Inst
        then Cons { name = y, ty = dom, v = v } e.insts
      else e.insts
  }

-- | an error hole of a type: what did not elaborate, in its place
errorHole : V.Ty -> M.El
errorHole a = { stx = SAbandon, val = \u -> Nom (V.errorHole a) }

-- | a memoed element from syntax and a value (the literal, under a
-- | top-level annotation: built inline it trips the compiler)
mEl : Sx.Tm -> V.V -> M.El
mEl stx v = { stx = stx, val = \u -> Nom v }

-- | what is made of something whose type did not elaborate: an error
-- | hole too, of a type nothing is known of
errorOf : Elab (Pair M.El V.Ty)
errorOf = pure (MkPair (errorHole (V.errorTy LargeU)) (V.errorTy LargeU))

-- A hole: a fresh metavariable, with its syntax and value (local to this
-- module -- a record alias crossing two modules trips the compiler)
type Hole = { stx : Sx.Tm, val : V.V }

downFrom : Int -> List Int
downFrom n = if n < 0 then Nil else Cons n (downFrom (n - 1))

-- (a context of `n` locals, named for a trace: `x0` the outermost)
namesFor : Int -> List String
namesFor n =
  if n <= 0 then Nil else Cons ("x" ^ showInt (n - 1)) (namesFor (n - 1))

-- | a metavariable's type, for the trace, as the metacontext has it
metaTyShown : V.MetaCtx -> Int -> V.Ty -> String
metaTyShown mc len ty =
  Ps.printTy Ps.plainImplicits 0 (namesFor len) (U.zonkTy mc (R.readbTy len ty))

-- | A metavariable of type `ty`, applied to every local in scope (so its
-- | solution may mention them).
freshMeta : Int -> V.Locals V.V -> V.Ty -> String -> P.Span -> Elab Hole
freshMeta len locals ty name sp = do
  m <- gets (\c -> c.nextMeta)
  modify
      (\c ->
         setMetas
           (Mp.insert
              compareInt
              m
              { ty = ty
              , sol = Nothing
              , solStx = Nothing
              , arity = len
              , name = name
              , span = sp
              }
              c.metas)
           (m + 1)
           c)
  mc <- gets (\c -> c.metas)
  traceE
      sp
      "meta"
      (\u -> "?" ^ showInt m ^ " (" ^ name ^ ") : " ^ metaTyShown mc len ty)
  pure
      { stx = SMetaApp m (A.fromList (downFrom (len - 1))) (R.readbTy len ty)
      , val =
          V.metaEl
            m
            (List.foldl
               (\sp' i -> SpApp sp' (V.localsAt locals i))
               SpId
               (downFrom (len - 1)))
            ty
      }

fillHole : G.Globals -> Int -> V.MetaEntry -> Sx.Tm -> Elab Unit
fillHole g m e argStx =
  modify
    (\c ->
       setMetas
         (Mp.insert
            compareInt
            m
            { ty = e.ty
            , sol = Just (V.nom (EV.eval g N (U.lamsU e.arity argStx) LNil))
            , solStx = Just (U.lamsU e.arity argStx)
            , arity = e.arity
            , name = e.name
            , span = e.span
            }
            c.metas)
         c.nextMeta
         c)

-- | The hole standing for a delayed argument, filled with the argument
-- | once it is checked.  If unification got there first, the two must
-- | agree.
solveHole : G.Globals
          -> P.CtxShape
          -> Int
          -> V.V
          -> Sx.Tm
          -> V.V
          -> Elab (Either C.EqErr Unit)
solveHole g cs m holeVal argStx argVal = do
  mc <- gets (\c -> c.metas)
  case Mp.lookup compareInt m mc of
    Just e -> case e.sol of
      Nothing -> do
        fillHole g m e argStx
        mc2 <- gets (\c -> c.metas)
        traceE
            e.span
            "solve"
            (\u ->
               "?"
               ^ showInt m
               ^ " ("
               ^ e.name
               ^ ") := "
               ^ Ps.printEl
                 Ps.plainImplicits
                 0
                 Nil
                 (U.zonkEl mc2 (U.lamsU e.arity argStx)))
        pure (Right MkUnit)
      Just _ -> Mt.unifyEl g cs holeVal argVal
    Nothing -> Mt.unifyEl g cs holeVal argVal

-- | a type in a message: its readback, printed in the surface syntax
-- (messages leave implicit arguments out, and say globals by the names
-- the file knows them by)
tyStr : ElabEnv -> V.Ty -> String
tyStr e t =
  Ps.printTy
    Ps.plainImplicits
    0
    e.scope.names
    (Rn.renameTy (Rn.displayName e.globals) (R.readbTy e.scope.len t))

tyStrM : ElabEnv -> M.Ty -> String
tyStrM e m =
  Ps.printTy
    Ps.plainImplicits
    0
    e.scope.names
    (Rn.renameTy (Rn.displayName e.globals) m.stx)

eqTyStr : G.Globals -> P.CtxShape -> V.Ty -> String
eqTyStr g cs t =
  Ps.printTy
    Ps.plainImplicits
    0
    cs.names
    (Rn.renameTy (Rn.displayName g) (R.readbTy cs.len t))

eqElStr : G.Globals -> P.CtxShape -> V.V -> String
eqElStr g cs v =
  Ps.printEl
    Ps.plainImplicits
    0
    cs.names
    (Rn.renameEl (Rn.displayName g) (R.readbEl cs.len v))

eqBareStr : G.Globals -> P.CtxShape -> V.Head -> V.Spine V.V -> String
eqBareStr g cs h sp =
  Ps.printEl
    Ps.plainImplicits
    0
    cs.names
    (Rn.renameEl (Rn.displayName g) (R.readbBareN cs.len h sp))

-- | a conversion failure, said with what was being compared (the
-- | trailing space is where a reason would go)
prettyEqErr : G.Globals -> C.EqErr -> String
prettyEqErr g (UnequalTys cs a a2) =
  "types " ^ eqTyStr g cs a ^ " and " ^ eqTyStr g cs a2 ^ " are not equal "
prettyEqErr g (UnequalEls cs a a2) =
  "elements " ^ eqElStr g cs a ^ " and " ^ eqElStr g cs a2 ^ " are not equal "
prettyEqErr g (UnequalNeus cs h sp h2 sp2) =
  "neutrals "
  ^ eqBareStr g cs h sp
  ^ " and "
  ^ eqBareStr g cs h2 sp2
  ^ " are not equal "
prettyEqErr g MentionsError = "a solution would mention what did not elaborate"

tyStrZ : ElabEnv -> V.Ty -> Elab String
tyStrZ e t = do
  mc <- gets (\c -> c.metas)
  pure
      (Ps.printTy
         Ps.plainImplicits
         0
         e.scope.names
         (Rn.renameTy
            (Rn.displayName e.globals)
            (U.zonkTy mc (R.readbTy e.scope.len t))))

-- | a term in a message, as `tyStrZ` says a type: the solved
-- | metavariables put in
elStrZ : ElabEnv -> M.El -> Elab String
elStrZ e m = do
  mc <- gets (\c -> c.metas)
  pure
      (Ps.printEl
         Ps.plainImplicits
         0
         e.scope.names
         (Rn.renameEl (Rn.displayName e.globals) (U.zonkEl mc m.stx)))

-- | (checked at a type that did not elaborate, nothing is an error of
-- | its own: kept, for the definition to fail, but reported elsewhere)
keepRecovered : Diag -> StCore -> Saved -> Elab Unit
keepRecovered kept saved waiting = do
  modify (\c -> setRecovered (Cons kept c.recovered) c)
  modify (setPostponed saved.postponed)
  restoreDelayed waiting

-- Function
--------------------------------------------------------------------------------

data Binder
  = Anonymous Typ
  | Named String Typ
  -- | `{x : A} -> B`, and `{x : A := d} -> B`, its default
  | NamedImplicit P.Span String Typ (Maybe Default)
  | NamedInstance P.Span String Typ

-- | Where a check fails, the error is kept and an error hole of the type
-- | checked at takes its place, so that what is around it is checked
-- | still.  What the failed check left waiting is dropped with it.
recoverWith : ElabEnv -> V.Ty -> Diag -> StCore -> Saved -> Elab M.El
recoverWith e a d saved waiting = do
  blocked <- Mt.blockedTy a
  keepRecovered
      (if blocked
         then { code = 0 - 1
              , severity = d.severity
              , msg = d.msg
              , span = d.span
              , note = d.note
              }
       else d)
      saved
      waiting
  pure (errorHole a)

-- (the state and the checks waiting before the check, for what fails to
-- go back to)
recovering : Chk -> Chk
recovering c =
  MkChk (\e a -> do
  saved <- gets (\c0 -> c0)
  waiting <- saveDelayed
  catchE (runChk c e a) (\d -> recoverWith e a d saved waiting))

isImplicitPi : V.Ty -> Bool
isImplicitPi t = case V.behavior t of
  LikeFunction level dom cod implicit -> not (P.eqPlicity implicit Expl)
  _ -> False

cloNameOr : {v a : Type} -> V.Clo v a -> String
cloNameOr c = case V.cloName c of
  Just x -> x
  Nothing -> "_"

metasLeft : ElabEnv -> V.MetaCtx -> V.Ty -> List Int
metasLeft e mc goal = U.metasTy mc 20 e.scope.len goal

instShown : ElabEnv -> V.MetaCtx -> V.Ty -> String
instShown e mc goal =
  Ps.printTy
    Ps.plainImplicits
    0
    e.scope.names
    (Rn.renameTy
       (Rn.displayName e.globals)
       (U.zonkTy mc (R.readbTy e.scope.len goal)))

-- | an instance argument's goal, as a search's messages say it: the
-- | solved metavariables put in (`Equality Int`, not
-- | `Equality ((\x -> Int) f)`)
goalShown : ElabEnv -> V.MetaCtx -> V.Ty -> String
goalShown e mc goal =
  Ps.printTy
    Ps.plainImplicits
    0
    e.scope.names
    (Rn.renameTy
       (Rn.displayName e.globals)
       (R.readbTyForced mc e.scope.len goal))

-- | an implicit argument not given, `x : dom`, of the function type `ty`
-- | that takes it first: its default, where the type has one -- given as
-- | it is, not inferred -- else a fresh metavariable, inferred
implicitArg : ElabEnv -> P.Span -> V.Ty -> V.Ty -> String -> Elab M.El
implicitArg e sp ty dom x = case V.implicitDefault ty of
  Just d -> pure { stx = d, val = \u -> EV.eval e.globals N d LNil }
  Nothing -> do
    meta <- freshMeta e.scope.len e.scope.locals dom x sp
    pure (mEl meta.stx meta.val)

-- | a candidate for an instance argument: its name (said when it is
-- | asked for: a global's, as the file knows it, is looked for among all
-- | the names in scope), where it is from (said where more than one
-- | fits), whether its type is a scheme, its type, and it.  A top-level
-- | instance's type is a scheme: its implicit and instance binders are
-- | given anew in each search, so that `{a : Type} -> {{eq : Equality a}}
-- | -> Equality (List a)` is an instance of each `Equality (List a)` there
-- | is an `Equality a` of;
-- | an instance binder's is a type as it is.
type Witness =
  { name : Unit -> String
  , from : String
  , scheme : Bool
  , ty : V.Ty
  , stx : Sx.Tm
  , val : V.V
  }

mkWitness : (Unit -> String)
          -> String
          -> Bool
          -> V.Ty
          -> Sx.Tm
          -> V.V
          -> Witness
mkWitness name from scheme ty stx val =
  { name = name, from = from, scheme = scheme, ty = ty, stx = stx, val = val }

nameOf : Witness -> String
nameOf w = w.name MkUnit

catMaybesR : {a : Type} -> List (Maybe a) -> List a
catMaybesR Nil = Nil
catMaybesR (Cons (Just x) xs) = Cons x (catMaybesR xs)
catMaybesR (Cons Nothing xs) = catMaybesR xs

-- | the instance binders in scope
instLocals : ElabEnv -> List Witness
instLocals e =
  List.map
    (\(c : InstLocal) ->
       mkWitness
         (\u -> c.name)
         "an instance argument"
         False
         c.ty
         (R.readbEl e.scope.len c.v)
         c.v)
    e.insts

-- (a top-level instance, by its key: named as the file knows it)
instGlobal : ElabEnv -> G.Instance -> Maybe Witness
instGlobal e i = case G.lookupEntry e.globals i.key of
  Just ge ->
    Just
      (mkWitness
         (\u -> Rn.displayName e.globals i.key)
         ("declared by " ^ i.module)
         True
         ge.type_
         (SGlobal i.key)
         ge.value)
  Nothing -> Nothing

-- | whether an instance in scope did not elaborate (it is of no type, no
-- | candidate)
brokenInstanceIn : ElabEnv -> Bool
brokenInstanceIn e =
  List.any
    (\(i : G.Instance) -> case G.lookupEntry e.globals i.key of
     Just _ -> False
     Nothing -> True)
    (G.instancesOf e.globals)

-- | the top-level instances in scope: the module's own declared before,
-- | and those of the modules it imports
instGlobals : ElabEnv -> List Witness
instGlobals e =
  catMaybesR (List.map (\i -> instGlobal e i) (G.instancesOf e.globals))

-- | an instance argument of a candidate, given a hole: a search finds
-- | what fills it, an instance of `goal`
type Subgoal = { hole : Hole, goal : V.Ty }

-- | a candidate, its binders given: it applied to them, its conclusion
-- | (the type it is then of), and the instance arguments it takes, in
-- | the order it takes them
type Instantiated =
  { applied : M.El, conclusion : V.Ty, subgoals : List Subgoal }

-- (each implicit binder a fresh metavariable, which the conclusion's
-- unification with the goal solves, and each instance binder a hole:
-- the binders of the type as declared, as the declaration checks them,
-- no type unfolded for more)
instantiateGo : ElabEnv
              -> P.Span
              -> M.El
              -> V.Ty
              -> List Subgoal
              -> Elab Instantiated
instantiateGo e sp m ty subgoals = case ty of
  VFunction level dom cod Impl dflt -> do
    arg <- implicitArg e sp ty dom (cloNameOr cod)
    instantiateGo
        e
        sp
        (M.iapp (cloNameOr cod) m arg)
        (V.nom (V.appClo cod (\u -> M.valN arg)))
        subgoals
  VFunction level dom cod Inst dflt -> do
    hole <- freshMeta e.scope.len e.scope.locals dom (cloNameOr cod) sp
    instantiateGo
        e
        sp
        (M.iapp (cloNameOr cod) m (mEl hole.stx hole.val))
        (V.nom (V.appClo cod (\u -> hole.val)))
        (Cons { hole = hole, goal = dom } subgoals)
  _ -> pure { applied = m, conclusion = ty, subgoals = List.reverse subgoals }

-- | a candidate, its binders given where its type is a scheme
instantiate : ElabEnv -> P.Span -> Witness -> Elab Instantiated
instantiate e sp w =
  if w.scheme then instantiateGo e sp (mEl w.stx w.val) w.ty Nil
  else pure { applied = mEl w.stx w.val, conclusion = w.ty, subgoals = Nil }

-- | a candidate whose conclusion is the goal, as its trial left it: its
-- | binders given, and the state of elaboration the trial came to, which
-- | committing to it goes on from
type Fit = { witness : Witness, instantiated : Instantiated, state : StCore }

fitOf : Witness -> Instantiated -> StCore -> Either C.EqErr Unit -> Maybe Fit
fitOf w inst after (Right _) =
  Just { witness = w, instantiated = inst, state = after }
fitOf w inst after (Left _) = Nothing

-- | a scheme's conclusion, its binders given placeholders (rigid locals,
-- | looked at for what is rigid in the conclusion alone: a placeholder
-- | is none of it)
conclusionOf : Int -> V.Ty -> V.Ty
conclusionOf n ty = case ty of
  VFunction level dom cod Impl dflt ->
    conclusionOf (n + 1) (V.nom (V.appClo cod (\u -> V.local n dom)))
  VFunction level dom cod Inst dflt ->
    conclusionOf (n + 1) (V.nom (V.appClo cod (\u -> V.local n dom)))
  _ -> ty

-- | a type, as an argument, by its former, where no unification could
-- | make it another: a built-in or fixed-width type, a decoded type's
-- | global head, or a global no record of fields stands for (a data
-- | type, `List a`) -- unification compares heads, it unfolds none
rigidFormer : V.MetaCtx -> V.V -> Maybe String
rigidFormer mc v = case V.forceEl mc v of
  VNeu (HGlobal k) sp ty expansion desc -> case expansion MkUnit of
    NotApplicable -> Just k
    IntoCons _ -> Nothing
  VCode t -> case V.forceTy mc t of
    VPrimInt -> Just "Int"
    VPrimFloat -> Just "Float64"
    VPrimString -> Just "String"
    VPrimRune -> Just "Rune"
    VPrimArray _ -> Just "Array"
    VFixed w -> Just (Fx.fixedName w)
    VDecode (HGlobal k) sp u described el -> Just k
    _ -> Nothing
  _ -> Nothing

-- | whether two arguments are of rigid formers that differ
apartArgs : V.MetaCtx -> V.V -> V.V -> Bool
apartArgs mc a b = case rigidFormer mc a of
  Just k -> case rigidFormer mc b of
    Just k2 -> not (strEq k k2)
    Nothing -> False
  Nothing -> False

-- | whether two spines, argument by argument, have a pair that is apart
apartSpines : V.MetaCtx -> V.Spine V.V -> V.Spine V.V -> Bool
apartSpines mc (SpApp sp a) (SpApp sp2 b) =
  apartArgs mc a b || apartSpines mc sp sp2
apartSpines mc _ _ = False

-- (`apartFrom`, the goal forced)
apartForced : V.MetaCtx -> V.Ty -> V.Ty -> Bool
apartForced mc (VDecode (HGlobal k2) sp _ _ _) (VDecode (HGlobal k) csp _ _ _) =
  not (strEq k k2) || apartSpines mc sp csp
apartForced mc (VDecode _ _ _ _ _) conclusion = False
apartForced mc t (VDecode (HGlobal k) _ _ _ _) = not (V.isErrorTy t)
apartForced mc t conclusion = False

-- | whether a scheme's conclusion is apart from the goal, so that no
-- | unification could make them one: a decoded type's head is rigid --
-- | unification compares heads, it unfolds neither -- so a goal of
-- | another head is apart, and so is one that is no decoded type (but an
-- | error, equal to anything); and of the same head, one an argument of
-- | which is of another rigid former (`Equality Int` and `equalityList`'s
-- | `Equality (List a)`), so that a search for `x == y` at `Int` tries `equalityInt` alone
apartFrom : V.MetaCtx -> V.Ty -> V.Ty -> Bool
apartFrom mc goal conclusion = apartForced mc (V.forceTy mc goal) conclusion

-- | a candidate tried: its binders given, its conclusion unified with the
-- | goal, and the state put back whatever the answer -- the
-- | metavariables its binders were given, what the unification solved,
-- | what was written down of it -- so that each candidate is tried from
-- | the same state (neither does more than the state of elaboration: no
-- | check waits on them).  A scheme whose conclusion is apart from the
-- | goal is not tried: it would be given its binders, in each search,
-- | for nothing.
fits : ElabEnv -> P.Span -> V.Ty -> Witness -> Elab (Maybe Fit)
fits e sp goal w = do
  mc <- gets (\c -> c.metas)
  if w.scheme && apartFrom mc goal (conclusionOf 0 w.ty) then pure Nothing
    else do
      before <- gets (\c -> c)
      inst <- instantiate e sp w
      r <- Mt.unifyTy e.globals (shape e.scope) goal inst.conclusion
      after <- gets (\c -> c)
      putSt before
      pure (fitOf w inst after r)

-- (a candidate that fits, if it does, before the others that do)
withFit : Maybe Fit -> List Fit -> List Fit
withFit (Just f) fs = Cons f fs
withFit Nothing fs = fs

witnessMatches : ElabEnv -> P.Span -> V.Ty -> List Witness -> Elab (List Fit)
witnessMatches e sp goal Nil = pure Nil
witnessMatches e sp goal (Cons w rest) = do
  fit <- fits e sp goal w
  more <- witnessMatches e sp goal rest
  pure (withFit fit more)

-- | an instance found that wants an instance argument: its name, and
-- | the goal it was found for
type WantedBy = { name : String, goal : V.Ty }

-- | how far a search is into those that wanted it: an instance found
-- | wants its instance arguments, each found by a search of its own, one
-- | deeper -- `depth` deep, wanted by the instances `wantedBy` says, the
-- | nearest first
type InstanceSearch = { depth : Int, wantedBy : List WantedBy }

-- | a search for an instance argument the program takes: wanted by no
-- | instance
topSearch : InstanceSearch
topSearch = { depth = 0, wantedBy = Nil }

-- | how deep the searches for instances' instance arguments may go: one
-- | deeper is refused (E0349), as an instance that wants one of a type
-- | no smaller than its own may want them without end
instanceDepthLimit : Int
instanceDepthLimit = 32

-- | a search for an instance argument of `w`, found for `goal`
deeperSearch : InstanceSearch -> Witness -> V.Ty -> InstanceSearch
deeperSearch s w goal =
  { depth = s.depth + 1
  , wantedBy = Cons { name = nameOf w, goal = goal } s.wantedBy
  }

-- (an instance found, and the goal it was found for)
wantedByShown : ElabEnv -> V.MetaCtx -> WantedBy -> String
wantedByShown e mc w = w.name ^ " for " ^ goalShown e mc w.goal

-- | which instances want what a search is for, said after it: `, wanted
-- | by equalityList for Equality (List Foo)`, and on, outwards
wantedByWhom : ElabEnv -> V.MetaCtx -> InstanceSearch -> String
wantedByWhom e mc s =
  joinWith
    ""
    (List.map
       (\(w : WantedBy) -> ", wanted by " ^ wantedByShown e mc w)
       s.wantedBy)

-- | a search refused for its depth: the goal it began with, and the
-- | first instances it went through, outwards in
tooDeep : ElabEnv -> V.MetaCtx -> InstanceSearch -> V.Ty -> String
tooDeep e mc s goal = case List.reverse s.wantedBy of
  Cons outermost _ ->
    "the search for an instance of "
    ^ goalShown e mc outermost.goal
    ^ " goes more than "
    ^ showInt instanceDepthLimit
    ^ " instances deep: "
    ^ joinWith
      ", then "
      (List.map
         (\(w : WantedBy) -> wantedByShown e mc w)
         (List.take 3 (List.reverse s.wantedBy)))
    ^ ", and on"
  Nil ->
    "the search for an instance of " ^ goalShown e mc goal ^ " goes too deep"

-- (the one candidate found does not fit where the hole is)
misfit : ElabEnv -> P.Span -> Witness -> C.EqErr -> Elab Instantiated
misfit e sp w err =
  failWithNote
    sp
    11
    ("the instance found, " ^ nameOf w ^ ", does not fit here")
    (prettyEqErr e.globals err)

-- | the one candidate found, committed to: elaboration goes on from the
-- | state its trial came to -- its binders given, its conclusion unified
-- | with the goal -- and the hole is filled with it applied to them, its
-- | instance arguments' holes left to the searches that fill them
committed : ElabEnv -> P.Span -> Int -> V.V -> V.Ty -> Fit -> Elab Instantiated
committed e sp hm holeVal goal fit = do
  mc <- gets (\c -> c.metas)
  putSt fit.state
  r <-
    solveHole
      e.globals
      (shape e.scope)
      hm
      holeVal
      fit.instantiated.applied.stx
      (M.valN fit.instantiated.applied)
  case r of
    Right _ -> do
      traceE
          sp
          "instance"
          (\u -> "found " ^ nameOf fit.witness ^ " : " ^ goalShown e mc goal)
      pure fit.instantiated
    Left err -> misfit e sp fit.witness err

metaOf : Sx.Tm -> Int
metaOf (SMetaApp k _ _) = k
metaOf _ = 0 - 1

-- | each of the instance arguments of an instance found, searched for by
-- | `find`
eachSubgoal : (Subgoal -> Elab Unit) -> List Subgoal -> Elab Unit
eachSubgoal find Nil = pure MkUnit
eachSubgoal find (Cons sg rest) = do
  find sg
  eachSubgoal find rest

-- | find the one witness in scope whose type is the goal, as Agda's
-- | instance arguments are found: among the instance binders in scope
-- | (`e.insts`) and the top-level instances in scope (`e.globals`'s), one
-- | pool.  A top-level instance whose type takes implicit and instance
-- | arguments is a witness of the goal if its conclusion is, its
-- | implicit arguments solved by unifying the two; it is decided on the
-- | conclusion alone, and then its instance arguments are searched for
-- | as this one is, one deeper (`search`), to a depth (E0349).  More than
-- | one is refused (same-typed witnesses are definitionally equal here --
-- | small values are opaque -- so no tie-break can tell them apart), so
-- | an import that brings in another makes an error of a search, never
-- | another answer; none is refused too.
resolveWanted : ElabEnv
              -> P.Span
              -> InstanceSearch
              -> Int
              -> V.V
              -> V.Ty
              -> Bool
              -> Elab Bool
resolveWanted e sp search hm holeVal goal final = do
  mc <- gets (\c -> c.metas)
  if not (List.null (metasLeft e mc goal))
      then if final
          then failWithNote
              (a := Bool)
              sp
              40
              ("an instance argument's type is not determined here: "
               ^ goalShown e mc goal
               ^ wantedByWhom e mc search)
              "give the argument explicitly, or annotate so the implicits around it are solved"
        else pure False
    else if search.depth > instanceDepthLimit
      then failWithNote
          (a := Bool)
          sp
          49
          (tooDeep e mc search goal)
          "an instance's instance arguments are found by searches of their own, and one that wants an instance of a type no smaller than its own may want them without end: give the argument explicitly, `(x := e)`"
    else do
      matches <-
        witnessMatches e sp goal (List.append (instLocals e) (instGlobals e))
      case matches of
        Cons one Nil -> do
          inst <- committed e sp hm holeVal goal one
          eachSubgoal
              (\sg -> do
               mcNow <- gets (\c -> c.metas)
               traceE
                   sp
                   "instance"
                   (\u ->
                      "wanted "
                      ^ goalShown e mcNow sg.goal
                      ^ "  [by "
                      ^ nameOf one.witness
                      ^ " for "
                      ^ goalShown e mc goal
                      ^ "]")
               done <-
                 resolveWanted
                   e
                   sp
                   (deeperSearch search one.witness goal)
                   (metaOf sg.hole.stx)
                   sg.hole.val
                   sg.goal
                   final
               -- (one whose type is not determined yet waits, as any)
               if done then pure MkUnit
                 else want
                     sp
                     (\later ->
                        resolveWanted
                          e
                          sp
                          (deeperSearch search one.witness goal)
                          (metaOf sg.hole.stx)
                          sg.hole.val
                          sg.goal
                          later))
              inst.subgoals
          pure True
        Nil ->
          -- (not an error of its own where an instance that may have
          -- been the one wanted did not elaborate: that is reported)
          if brokenInstanceIn e
            then failElsewhere
                (a := Bool)
                sp
                ("no instance for "
                 ^ goalShown e mc goal
                 ^ ", where one in scope does not elaborate")
          else failWithNote
              (a := Bool)
              sp
              41
              ("no instance for "
               ^ goalShown e mc goal
               ^ " in scope"
               ^ wantedByWhom e mc search)
              "declare one, `instance x : T`, bind one, `{{x : T}} -> ...`, where this is used, or give it: `(x := e)`"
        _ ->
          failWithNote
            (a := Bool)
            sp
            42
            ("more than one instance for "
             ^ goalShown e mc goal
             ^ " in scope"
             ^ wantedByWhom e mc search
             ^ ": "
             ^ joinWith
               ", "
               (List.map
                  (\(f : Fit) -> nameOf f.witness ^ " (" ^ f.witness.from ^ ")")
                  matches))
            "they cannot be told apart by type (small values are statically opaque): give the argument explicitly"

-- | an instance argument: a hole, and a `Wanted` that will find
-- | it
insertInstance : ElabEnv -> P.Span -> V.Ty -> String -> Elab M.El
insertInstance e sp goal name = do
  hole <- freshMeta e.scope.len e.scope.locals goal name sp
  mc0 <- gets (\c -> c.metas)
  -- (the trace says whether the goal is determined already: then it
  -- would need no deferral)
  traceE
      sp
      "instance"
      (\u ->
         "wanted "
         ^ goalShown e mc0 goal
         ^ (if List.null (metasLeft e mc0 goal) then "  [ready at the call]"
            else "  [waits for implicits]"))
  want
      sp
      (\final ->
         resolveWanted e sp topSearch (metaOf hole.stx) hole.val goal final)
  pure (mEl hole.stx hole.val)

-- | Apply `m : ty` to each implicit argument it takes first: its default,
-- | or a fresh metavariable.
insertImplicits : ElabEnv -> P.Span -> M.El -> V.Ty -> Elab (Pair M.El V.Ty)
insertImplicits e sp m ty0 = do
  ty <- Mt.forceT ty0
  case V.behavior ty of
    LikeFunction level dom cod Impl -> do
      arg <- implicitArg e sp ty dom (cloNameOr cod)
      insertImplicits
          e
          sp
          (M.iapp (cloNameOr cod) m arg)
          (V.nom (V.appClo cod (\u -> M.valN arg)))
    -- an instance argument gets a hole, to be found (`settle`)
    -- among the witnesses in scope once its goal type has no metas left
    -- (marked implicit, as it is not written: printed, it is left out,
    -- and `n + 1` is printed so)
    LikeFunction level dom cod Inst -> do
      arg <- insertInstance e sp dom (cloNameOr cod)
      insertImplicits
          e
          sp
          (M.iapp (cloNameOr cod) m arg)
          (V.nom (V.appClo cod (\u -> M.valN arg)))
    _ -> pure (MkPair m ty)

isJustD : Maybe Default -> Bool
isJustD (Just _) = True
isJustD Nothing = False

-- (an implicit argument's default, zonked: it names no local)
closedImplicit : P.Span -> M.El -> Sx.Tm -> Elab M.El
closedImplicit sp m stx =
  if mentions.el 0 stx
    then failWith
        sp
        45
        "an implicit argument's default names definitions only, not the parameters before it"
  else pure { stx = stx, val = m.val }

-- | an implicit argument's default: closed, naming definitions only -- an
-- | application that leaves the argument out is given it, wherever that
-- | is.  (An implicit argument it leaves unsolved is the definition's
-- | error, as anywhere.)
implicitDefaultChk : P.Span -> Chk -> Chk
implicitDefaultChk sp c =
  MkChk (\e a -> do
  m <- runChk c e a
  mc <- gets (\c0 -> c0.metas)
  closedImplicit sp m (U.zonkEl mc m.stx))

-- (an implicit argument's default, checked at its type where the type
-- is; where it does not do, an error hole)
implicitDefaultAt : ElabEnv -> M.Ty -> Maybe Default -> Elab (Maybe Sx.Tm)
implicitDefaultAt e ty Nothing = pure Nothing
implicitDefaultAt e ty (Just d) = do
  m <-
    runChk
      (recovering (implicitDefaultChk d.span d.chk))
      (withFor e ForNominative)
      (M.tyN ty)
  pure (Just m.stx)

functionFormation : Binder -> Typ -> Typ
functionFormation (Anonymous dom) cod =
  MkTyp (\e -> do
  edom <- runTyp dom e
  ecod <- runTyp cod e
  pure (M.function e.globals e.scope.locals edom (AbsConst ecod)))
functionFormation (Named x dom) cod =
  MkTyp (\e -> do
  edom <- runTyp dom e
  ecod <- runTyp cod (withScope e (bindName x (M.tyN edom) e.scope))
  pure (M.function e.globals e.scope.locals edom (MkAbs x ecod)))
-- extension: an implicit argument, inferred at each use.  Its type must
-- be large: a value of a small type is statically irrelevant, so nothing
-- could ever determine it.  One with a default, `{x : A := d}`, is not
-- inferred: where it is not given, it is `d` -- of any type.
functionFormation (NamedImplicit sp x dom dflt) cod =
  MkTyp (\e -> do
  edom <- runTyp dom e
  if P.leq (M.levelOf edom) Small && not (isJustD dflt)
      then failWith
          (a := M.Ty)
          sp
          24
          "an implicit argument without a default must have a large type (a small one could never be inferred: its values are statically irrelevant)"
    else do
      d <- implicitDefaultAt e edom dflt
      ecod <- runTyp cod (withScope e (bindName x (M.tyN edom) e.scope))
      pure (M.functionD Impl d e.globals e.scope.locals edom (MkAbs x ecod)))
-- `{{x : A}} -> B`, an instance argument, found among the
-- witnesses in scope at each use.  Its type may be small (the finding
-- is by the goal TYPE, which is static; the small value found is the
-- named witness's) -- the E0324 ban is about unification, which this
-- never uses.
functionFormation (NamedInstance sp x dom) cod =
  MkTyp (\e -> do
  edom <- runTyp dom e
  ecod <- runTyp cod (withScope e (bindName x (M.tyN edom) e.scope))
  pure (M.functionI Inst e.globals e.scope.locals edom (MkAbs x ecod)))

-- | extension: checked at an implicit function type, anything is under
-- | the implicit lambdas it needs (not only a lambda)
implicitLams : Chk -> Chk
implicitLams c =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeFunction level dom cod implicit ->
      if P.eqPlicity implicit Expl then runChk c e a
      else withBound (cloNameOr cod) dom e.scope (\v scope' -> do
        ebody <-
          runChk
            (implicitLams c)
            (intoSilent e implicit (cloNameOr cod) dom scope' v False)
            (V.nom (V.appClo cod (\u -> v)))
        pure
            (M.lam
               (caseOf e.elabFor)
               e.globals
               e.scope.locals
               (M.fromVTy N e.scope.len a)
               (MkAbs (cloNameOr cod) ebody)))
    _ -> runChk c e a)

functionIntro : P.Span -> String -> Chk -> Chk
functionIntro sp x body =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeFunction level dom cod implicit ->
      if P.eqPlicity implicit Expl
        then withBound x dom e.scope (\v scope' -> do
          ebody <-
            runChk body (intoLam e scope' v) (V.nom (V.appClo cod (\u -> v)))
          pure
              (M.lam
                 (caseOf e.elabFor)
                 e.globals
                 e.scope.locals
                 (M.fromVTy N e.scope.len a)
                 (MkAbs x ebody)))
      -- a lambda checked at an implicit (or instance) function type:
      -- that argument is bound silently, and the lambda is for the
      -- next one
      else withBound (cloNameOr cod) dom e.scope (\v scope' -> do
        ebody <-
          runChk
            (functionIntro sp x body)
            (intoSilent e implicit (cloNameOr cod) dom scope' v True)
            (V.nom (V.appClo cod (\u -> v)))
        pure
            (M.lam
               (caseOf e.elabFor)
               e.globals
               e.scope.locals
               (M.fromVTy N e.scope.len a)
               (MkAbs (cloNameOr cod) ebody)))
    _ ->
      failWith
        (a := M.El)
        sp
        1
        "tried to check a lambda expression at a non-function type")

-- | extension: `\(x : T) -> e`, the binder annotated.  The body
-- | synthesises under it, and the function's type is `(x : T) -> B`
functionIntroSyn : String -> Typ -> Syn -> Syn
functionIntroSyn x dom body =
  MkSyn (\e -> do
  edom <- runTyp dom e
  pb <-
    withBound
      x
      (M.tyN edom)
      e.scope
      (\v scope' -> runSyn body (intoLamQuiet e scope' v))
  case pb of
    MkPair ebody bty -> do
      pure
          (MkPair
             (M.lam
                (caseOf e.elabFor)
                e.globals
                e.scope.locals
                (M.function
                   e.globals
                   e.scope.locals
                   edom
                   (MkAbs x (M.fromVTy N (e.scope.len + 1) bty)))
                (MkAbs x ebody))
             (M.tyN
                (M.function
                   e.globals
                   e.scope.locals
                   edom
                   (MkAbs x (M.fromVTy N (e.scope.len + 1) bty))))))

-- | `\(x : T) -> e` where the argument type is already expected of it:
-- | the annotation need only agree, and the body is checked
requireAgree : ElabEnv -> P.Span -> Either C.EqErr Unit -> Elab Unit
requireAgree e sp (Right _) = pure MkUnit
requireAgree e sp (Left err) =
  failWithNote
    sp
    11
    "the binder's annotation is not the argument type expected here"
    (prettyEqErr e.globals err)

functionIntroAnn : P.Span -> String -> Typ -> Chk -> Chk
functionIntroAnn sp x dom body =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeFunction level fdom cod implicit ->
      if P.eqPlicity implicit Expl
        then do
          edom <- runTyp dom e
          agree <- Mt.unifyTy e.globals (shape e.scope) fdom (M.tyN edom)
          requireAgree e sp agree
          -- (bound at the annotation: the two are equal, and what is
          -- expected may be known only later)
          withBound x (M.tyN edom) e.scope (\v scope' -> do
            ebody <-
              runChk body (intoLam e scope' v) (V.nom (V.appClo cod (\u -> v)))
            pure
                (M.lam
                   (caseOf e.elabFor)
                   e.globals
                   e.scope.locals
                   (M.fromVTy N e.scope.len a)
                   (MkAbs x ebody)))
      else withBound (cloNameOr cod) fdom e.scope (\v scope' -> do
        ebody <-
          runChk
            (functionIntroAnn sp x dom body)
            (intoSilent e implicit (cloNameOr cod) fdom scope' v True)
            (V.nom (V.appClo cod (\u -> v)))
        pure
            (M.lam
               (caseOf e.elabFor)
               e.globals
               e.scope.locals
               (M.fromVTy N e.scope.len a)
               (MkAbs (cloNameOr cod) ebody)))
    _ ->
      failWith
        (a := M.El)
        sp
        1
        "tried to check a lambda expression at a non-function type")

-- | `{x} => e`: naming an implicit argument
functionIntroImplicit : P.Span -> String -> Chk -> Chk
functionIntroImplicit sp x body =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeFunction level dom cod implicit ->
      if P.eqPlicity implicit Expl
        then failWith
            sp
            25
            "an implicit lambda `\\{x} -> ...` checked at a type that takes no implicit argument"
      else withBound x dom e.scope (\v scope' -> do
        ebody <-
          runChk
            body
            (intoSilent e implicit x dom scope' v True)
            (V.nom (V.appClo cod (\u -> v)))
        pure
            (M.lam
               (caseOf e.elabFor)
               e.globals
               e.scope.locals
               (M.fromVTy N e.scope.len a)
               (MkAbs x ebody)))
    _ ->
      failWith
        (a := M.El)
        sp
        25
        "an implicit lambda `\\{x} -> ...` checked at a type that takes no implicit argument")

-- | `f {a}`: giving an implicit argument explicitly
functionElimImplicit : P.Span -> Syn -> Chk -> Syn
functionElimImplicit sp callee arg =
  MkSyn (\e -> do
  pc <- runSyn callee e
  case pc of
    MkPair ecallee a0 -> do
      a <- Mt.forceT a0
      case V.behavior a of
        LikeFunction level dom cod Impl -> do
          earg <- runChk arg e dom
          pure
              (MkPair
                 (M.iapp (cloNameOr cod) ecallee earg)
                 (V.nom (V.appClo cod (\u -> M.valN earg))))
        -- `f {a}` also gives an instance argument explicitly
        LikeFunction level dom cod Inst -> do
          earg <- runChk arg e dom
          pure
              (MkPair
                 (M.iapp (cloNameOr cod) ecallee earg)
                 (V.nom (V.appClo cod (\u -> M.valN earg))))
        LikeFunction level dom cod implicit ->
          failWith
            sp
            26
            "`{...}` gives an implicit argument, but this takes none here"
        _ ->
          failWith
            (a := Pair M.El V.Ty)
            sp
            26
            "`{...}` gives an implicit argument, but this takes none here")

nameIs : Maybe String -> String -> Bool
nameIs (Just y) x = strEq y x
nameIs Nothing x = False

-- | extension: `f (x := a)` gives the argument named `x`; the implicit ones before it are inferred, an explicit one cannot be skipped
namedGo : P.Span
        -> String
        -> Chk
        -> ElabEnv
        -> M.El
        -> V.Ty
        -> Elab (Pair M.El V.Ty)
namedGo sp x arg e m ty0 = do
  ty <- Mt.forceT ty0
  case V.behavior ty of
    LikeFunction level dom cod implicit ->
      if nameIs (V.cloName cod) x
        then do
          earg <- runChk arg e dom
          pure
              (MkPair
                 (if P.eqPlicity implicit Expl then M.app m earg
                  else M.iapp x m earg)
                 (V.nom (V.appClo cod (\u -> M.valN earg))))
      else if P.eqPlicity implicit Impl
        then do
          iarg <- implicitArg e sp ty dom (cloNameOr cod)
          namedGo
              sp
              x
              arg
              e
              (M.iapp (cloNameOr cod) m iarg)
              (V.nom (V.appClo cod (\u -> M.valN iarg)))
      else if P.eqPlicity implicit Inst
        -- an instance argument before the named one is searched for
        then do
          earg <- insertInstance e sp dom (cloNameOr cod)
          namedGo
              sp
              x
              arg
              e
              (M.iapp (cloNameOr cod) m earg)
              (V.nom (V.appClo cod (\u -> M.valN earg)))
      else noArgNamed sp x
    _ -> noArgNamed sp x
  where
    noArgNamed : P.Span -> String -> Elab (Pair M.El V.Ty)
    noArgNamed sp x =
      failWith
        sp
        29
        ("`("
         ^ x
         ^ " := ...)` names an argument, but there is none named "
         ^ x
         ^ " here")

functionElimNamed : P.Span -> String -> Syn -> Chk -> Syn
functionElimNamed sp x callee arg =
  MkSyn (\e -> do
  pc <- runSyn callee e
  case pc of
    MkPair ecallee a0 -> namedGo sp x arg e ecallee a0)

delayedCheck : ElabEnv
             -> P.Span
             -> String
             -> Chk
             -> V.Ty
             -> Int
             -> Hole
             -> Elab Unit
delayedCheck e sp what c ty m hole = do
  el <- runChk c e ty
  r <- solveHole e.globals (shape e.scope) m hole.val el.stx (M.valN el)
  case r of
    Right _ -> pure MkUnit
    Left err ->
      failWithNote
        sp
        11
        ("this " ^ what ^ " does not fit how it is used")
        (prettyEqErr e.globals err)

metaOfStx : Sx.Tm -> Int
metaOfStx (SMetaApp k _ _) = k
metaOfStx _ = 0 - 1

-- | check `c` at `ty` later, once `ty` (flexible now) is known: a hole
-- | stands for the result until then; `keyTy` is the unsolved type whose
-- | solution unblocks the check
delayChkOn : ElabEnv -> P.Span -> String -> Chk -> V.Ty -> V.Ty -> Elab M.El
delayChkOn e sp what c keyTy ty = do
  hole <- freshMeta e.scope.len e.scope.locals ty what sp
  delay keyTy (delayedCheck e sp what c ty (metaOfStx (hole.stx)) hole)
  traceE
      sp
      "delay"
      (\u -> what ^ " waits for its type ?" ^ showInt (metaOfStx hole.stx))
  pure (mEl hole.stx hole.val)

delayChk : ElabEnv -> P.Span -> String -> Chk -> V.Ty -> Elab M.El
delayChk e sp what c ty = delayChkOn e sp what c ty ty

elimPlain : ElabEnv
          -> M.El
          -> V.Ty
          -> V.Clo V.V V.Ty
          -> Chk
          -> Elab (Pair M.El V.Ty)
elimPlain e ecallee dom cod arg = do
  earg <- runChk arg e dom
  pure (MkPair (M.app ecallee earg) (V.nom (V.appClo cod (\u -> M.valN earg))))

-- | E0302: what is applied is of a type that is no function's -- said,
-- | and what it is, where it is no hole (a literal whose type waits)
notAFunction : ElabEnv -> P.Span -> M.El -> V.Ty -> Elab (Pair M.El V.Ty)
notAFunction e sp ecallee a =
  if U.isFlexTy a
    then failWith
        sp
        2
        "tried to apply a value as a function, where its type is not known"
  else do
    ty <- tyStrZ e a
    applied <- elStrZ e ecallee
    if metaOfStx ecallee.stx >= 0
        then failWith
            sp
            2
            ("tried to apply a value of type "
             ^ ty
             ^ ", which is not a function type")
      else failWithNote
          sp
          2
          ("tried to apply a value of type "
           ^ ty
           ^ ", which is not a function type")
          ("the value applied here is `" ^ applied ^ "`")

-- | Application.  An argument that can only be checked, at a type that
-- | is still an unsolved implicit, waits: a hole stands for it.
elimGo : Bool
       -> P.Span
       -> Chk
       -> ElabEnv
       -> Pair M.El V.Ty
       -> Elab (Pair M.El V.Ty)
elimGo checksOnly sp arg e (MkPair ecallee a) = case V.behavior a of
  LikeFunction level dom cod implicit ->
    if checksOnly
      then do
        fdom <- Mt.forceT dom
        if not (U.isFlexTy fdom) then elimPlain e ecallee dom cod arg
          else do
            hole <- delayChk e sp "argument" arg fdom
            pure
                (MkPair
                   (M.app ecallee hole)
                   (V.nom (V.appClo cod (\u -> M.valN hole))))
    else elimPlain e ecallee dom cod arg
  _ -> do
    blocked <- Mt.blockedTy a
    if blocked then errorOf
      else do
        fa <- Mt.forceT a
        notAFunction e sp ecallee fa

functionElimC : Bool -> P.Span -> Syn -> Chk -> Syn
functionElimC checksOnly sp callee arg =
  MkSyn (\e -> do
  pc <- runSyn callee e
  case pc of
    MkPair ecallee0 a0 -> do
      pi <- insertImplicits e sp ecallee0 a0
      elimGo checksOnly sp arg e pi)

functionElim : P.Span -> Syn -> Chk -> Syn
functionElim sp callee arg = functionElimC False sp callee arg

-- ModeShift
--------------------------------------------------------------------------------

checkFields : ElabEnv
            -> V.V
            -> List (Pair String V.V)
            -> Elab (Either C.EqErr Unit)
checkFields e v Nil = pure (Right MkUnit)
checkFields e v (Cons (MkPair y g) rest) = do
  r <- Mt.unifyEl e.globals (shape e.scope) (V.nom (V.proj v y)) g
  case r of
    Right _ -> checkFields e v rest
    Left err -> pure (Left err)

-- | `v : B ~ { x = f, … }`: the type expected, specialized, is peeled of
-- | its specializations one by one until what is left is the type `v`
-- | has; then `v`'s fields are what is left over asks.
specializedGo : ElabEnv
              -> V.V
              -> V.Ty
              -> V.Head
              -> V.Spine V.V
              -> P.Universe
              -> P.Th (Maybe V.Ty)
              -> P.Th V.V
              -> List (Pair String V.V)
              -> Either C.EqErr Unit
              -> Elab (Either C.EqErr Unit)
specializedGo e v a' h (SpSpec sq x f) u described el fields err = do
  r <-
    Mt.attempt
      (Mt.unifyTy e.globals (shape e.scope) (VDecode h sq u described el) a')
  case r of
    Right _ -> checkFields e v (Cons (MkPair x f) fields)
    Left _ ->
      specializedGo e v a' h sq u described el (Cons (MkPair x f) fields) err
specializedGo e v a' h sp u described el fields err = pure err

specialized : ElabEnv
            -> V.V
            -> V.Ty
            -> V.Ty
            -> Either C.EqErr Unit
            -> Elab (Either C.EqErr Unit)
specialized e v (VDecode h sp u described el) a' err =
  specializedGo e v a' h sp u described el Nil err
specialized e v a a' err = pure err

applyGo : P.Span -> ElabEnv -> V.Ty -> Pair M.El V.Ty -> Elab M.El
applyGo sp e a (MkPair m a') = do
  r0 <- Mt.attempt (Mt.unifyTy e.globals (shape e.scope) a a')
  r <- case r0 of
    Left err -> specialized e (M.valN m) a a' (Left err)
    Right x -> pure (Right x)
  mc <- gets (\c -> c.metas)
  traceE
      sp
      "unify"
      (\u ->
         instShown e mc a
         ^ "  =?=  "
         ^ instShown e mc a'
         ^ (case r of
            Right _ -> "   ok"
            Left _ -> "   FAILS"))
  case r of
    Right _ -> do
      Mt.runDelayed False
      pure m
    Left err -> do
      want <- tyStrZ e a
      got <- tyStrZ e a'
      failWithNote
          sp
          11
          ("expected type " ^ want ^ ", but got type " ^ got)
          (prettyEqErr e.globals err)

apply : P.Span -> Syn -> Chk
apply sp syn =
  MkChk (\e a0 -> do
  pm <- runSyn syn e
  case pm of
    MkPair m0 a1 -> do
      a <- Mt.forceT a0
      -- implicit arguments are inserted, unless an implicit function is
      -- wanted
      pi <-
        if isImplicitPi a then pure (MkPair m0 a1)
        else insertImplicits e sp m0 a1
      applyGo sp e a pi)

annot : Typ -> Chk -> Syn
annot typ chk =
  MkSyn (\e -> do
  a <- runTyp typ (withFor e ForNominative)
  g <- runChk chk e (M.tyN a)
  pure (MkPair g (M.tyN a)))

-- NonTerm
--------------------------------------------------------------------------------

recChk : P.Span -> Chk -> Chk
recChk sp c =
  MkChk
    (\e a ->
       if not (P.leq (V.levelOf a) Small)
         then failWith sp 20 "can only use rec when checking at a small type"
       -- evaluation is by value: a recursive use under no lambda would be
       -- computed while the definition itself is, and never end
       else if e.lams == 0
         then failWith
             sp
             31
             "the definition would need itself while it is being computed: put the recursive use under a lambda"
       else do
         m <- runChk c (withScope e (undelayScope e.scope)) a
         pure (M.recM m))

-- Variable
--------------------------------------------------------------------------------

data VarError = NotInScope | Delayed2

varGo : String
      -> List String
      -> Ctx
      -> V.Locals V.V
      -> Int
      -> Int
      -> Either VarError (Pair M.El V.Ty)
varGo x names (CUndelay c') locals n i = varGo x names c' locals (n + 1) i
varGo x names (CBind c' (BDelayedBy k) a) locals n i = case names of
  Cons x' xs -> case locals of
    LSnoc vs v ->
      if strEq x x'
        then if n >= k then Right (MkPair (M.local i v) a) else Left Delayed2
      else varGo x xs c' vs n (i + 1)
    _ -> Left NotInScope
  _ -> Left NotInScope
varGo x names CEmpty locals n i = Left NotInScope

findLocal : ElabEnv -> String -> Either VarError (Pair M.El V.Ty)
findLocal e x = varGo x e.scope.names e.scope.ctx e.scope.locals 0 0

-- | a call `f a ...` of a delayed variable `f` (a recursive call) is
-- | checked as `rec (f a ...)`
autoRec : P.Span -> String -> Chk -> Chk
autoRec sp x c =
  MkChk (\e a -> case findLocal e x of
  Left Delayed2 ->
    if P.leq (V.levelOf a) Small then runChk (recChk sp c) e a else runChk c e a
  _ -> runChk c e a)

abandonChk : P.Span -> Chk
abandonChk sp =
  MkChk
    (\e a ->
       if P.leq (V.levelOf a) Small then pure M.abandonM
       else failWith sp 21 "can only use abandon when checking at a small type")

-- Prim
--------------------------------------------------------------------------------

primInt : Typ
primInt = MkTyp (\e -> pure M.primInt)

litInt : Int -> Syn
litInt i = MkSyn (\e -> pure (MkPair (M.litInt i) VPrimInt))

primFloat : Typ
primFloat = MkTyp (\e -> pure M.primFloat)

litFloat : Float64 -> Syn
litFloat x = MkSyn (\e -> pure (MkPair (M.litFloat x) VPrimFloat))

-- | `Array a`
primArray : Typ -> Typ
primArray a =
  MkTyp (\e -> do
  t <- runTyp a e
  pure (M.primArray t))

primString : Typ
primString = MkTyp (\e -> pure M.primString)

litString : String -> Syn
litString s = MkSyn (\e -> pure (MkPair (M.litString s) VPrimString))

-- | `Rune`
primRune : Typ
primRune = MkTyp (\e -> pure M.primRune)

-- | a rune literal: a `Rune`, whatever it is checked at
litRune : Int -> Syn
litRune c = MkSyn (\e -> pure (MkPair (M.litRune c) VPrimRune))

-- | `Int8` ... `UInt64`, `Float32`
primFixed : Fx.Fixed -> Typ
primFixed w = MkTyp (\e -> pure (M.primFixed w))

-- Number literals
--------------------------------------------------------------------------------

-- A number literal is of the type it is checked at: an integer literal
-- of any number type, `Int`, `Float64` or a fixed-width one, a fractional
-- one of a float type, `Float64` or `Float32` -- each one of the type's
-- values (E0346).  Where that type is not known yet, the literal waits
-- for it, as a tag does, a hole standing for it; one that infers its type
-- has a type of its own to wait for, which how it is used solves.  If
-- nothing ever does, when the definition settles (every wait run), it is
-- an `Int`, or a `Float64`: a fractional literal is one at once, an integer
-- one waits once more, so that it is a `Float64` where it shares its type
-- with a fractional one.

-- | a number literal, as written
data NumLit = IntNum Int | FracNum Float64

numLitText : NumLit -> String
numLitText (IntNum i) = showInt i
numLitText (FracNum x) = showFloat x

-- (what a literal may be, for a message)
numLitMay : NumLit -> String
numLitMay (IntNum _) = "a number"
numLitMay (FracNum _) = "a float"

-- (a literal at a type that is no number's: at an error hole, silent)
notANumber : P.Span -> ElabEnv -> V.Ty -> NumLit -> Elab M.El
notANumber sp e a lit =
  if V.isErrorTy a then pure (errorHole a)
  else do
    want <- tyStrZ e a
    failWith
        sp
        11
        ("expected type "
         ^ want
         ^ ", but got the literal "
         ^ numLitText lit
         ^ ", which is "
         ^ numLitMay lit)

outOfRange : P.Span -> String -> String -> Elab M.El
outOfRange sp lit why = failWith sp 46 (lit ^ " is out of range for " ^ why)

-- (a float at `Float32`: one that is not too large for it)
atFloat32 : P.Span -> String -> Float64 -> Elab M.El
atFloat32 sp text x =
  if Fx.float32Overflows x
    then outOfRange sp text "Float32, whose greatest is 3.4028234663852886e+38"
  else pure (M.litFloat32 x)

-- (an integer literal at a fixed-width type: one of its values)
intAtFixed : P.Span -> Fx.Fixed -> Int -> Elab M.El
intAtFixed sp w i =
  if Fx.isFloat32 w then atFloat32 sp (showInt i) (toFloat i)
  else if Fx.fitsFixed w i then pure (M.litFixed w i)
  else outOfRange
      sp
      (showInt i)
      (Fx.fixedName w
       ^ ", whose values are "
       ^ showInt (Fx.fixedMin w)
       ^ " to "
       ^ showInt (Fx.fixedMax w))

-- (a fractional literal at a fixed-width type: at `Float32` only)
fracAtFixed : P.Span -> ElabEnv -> V.Ty -> Fx.Fixed -> Float64 -> Elab M.El
fracAtFixed sp e a w x =
  if Fx.isFloat32 w then atFloat32 sp (showFloat x) x
  else notANumber sp e a (FracNum x)

-- | a number literal at a type known
numLitAt : P.Span -> ElabEnv -> V.Ty -> NumLit -> Elab M.El
numLitAt sp e a (IntNum i) = case V.behavior a of
  LikeInt -> pure (M.litInt i)
  LikeFloat -> pure (M.litFloat (toFloat i))
  LikeFixed w -> intAtFixed sp w i
  _ -> notANumber sp e a (IntNum i)
numLitAt sp e a (FracNum x) = case V.behavior a of
  LikeFloat -> pure (M.litFloat x)
  LikeFixed w -> fracAtFixed sp e a w x
  _ -> notANumber sp e a (FracNum x)

-- (never known: the type an integer literal or a fractional one is)
numLitDefault : P.Span -> ElabEnv -> V.Ty -> NumLit -> Elab M.El
numLitDefault sp e a (IntNum i) = runChk (apply sp (litInt i)) e a
numLitDefault sp e a (FracNum x) = runChk (apply sp (litFloat x)) e a

isIntNum : NumLit -> Bool
isIntNum (IntNum _) = True
isIntNum (FracNum _) = False

-- (waiting for its type: run once it is known, or when every wait is run;
-- an integer literal then waits `n` more times)
numLitWait : Int -> P.Span -> NumLit -> Chk
numLitWait n sp lit =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  if not (U.isFlexTy a) then numLitAt sp e a lit
    else if n > 0 && isIntNum lit
      then delayChk e sp "literal" (numLitWait (n - 1) sp lit) a
    else numLitDefault sp e a lit)

-- | a number literal checked
numLitChk : P.Span -> NumLit -> Chk
numLitChk sp lit =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  if U.isFlexTy a then delayChk e sp "literal" (numLitWait 1 sp lit) a
    else numLitAt sp e a lit)

-- | a number literal inferring its type: a type of its own, unknown, to
-- | wait for
numLitSyn : P.Span -> NumLit -> Syn
numLitSyn sp lit =
  MkSyn (\e -> do
  t <- freshMeta e.scope.len e.scope.locals (VU SmallU) "literal" sp
  el <- runChk (numLitChk sp lit) e (V.decodeN t.val)
  pure (MkPair el (V.decodeN t.val)))

-- Record
--------------------------------------------------------------------------------

-- | a field of a record type: its name, its type, and its default (a
-- | term of that type), if it has one
type FieldDeclaration = { name : String, typ : Typ, dflt : Maybe Default }

-- | a record type's fields formed: its level, the fields' types, the
-- | defaults of those that have one, and the first field too large for
-- | run-time data, written as it is declared (`t : Type`)
type Formed =
  { level : P.Level
  , fields : List (Pair String Sx.Ty)
  , defaults : List (Pair String Sx.Tm)
  , large : Maybe String
  }

-- (a default, zonked: it names no local but the `i` fields before it)
namesBefore : P.Span -> Int -> M.El -> Sx.Tm -> Elab M.El
namesBefore sp i m stx =
  if mentions.el i stx
    then failWith
        sp
        43
        "a field's default names the fields before it and definitions, not the type's parameters"
  else pure { stx = stx, val = m.val }

-- | the default of a type's field, the one after `i` others: it names
-- | those fields and definitions, nothing else of where the type is (its
-- | parameters), so that it means the same wherever a record leaves the
-- | field out.  (An implicit argument it leaves unsolved is the
-- | definition's error, as anywhere.)
defaultChk : P.Span -> Int -> Chk -> Chk
defaultChk sp i c =
  MkChk (\e a -> do
  m <- runChk c e a
  mc <- gets (\c0 -> c0.metas)
  namesBefore sp i m (U.zonkEl mc m.stx))

-- (a field's default, checked at the field's type where the type is, the
-- `i` fields before it in scope; where it does not do, an error hole)
defaultAt : ElabEnv -> Int -> M.Ty -> Maybe Default -> Elab (Maybe Sx.Tm)
defaultAt e i ty Nothing = pure Nothing
defaultAt e i ty (Just d) = do
  m <- runChk (recovering (defaultChk d.span i d.chk)) e (M.tyN ty)
  pure (Just m.stx)

consDefault : String
            -> Maybe Sx.Tm
            -> List (Pair String Sx.Tm)
            -> List (Pair String Sx.Tm)
consDefault x (Just d) ds = Cons (MkPair x d) ds
consDefault x Nothing ds = ds

-- (the field `x : ty`, if it is too large for run-time data, else the
-- first such of those after it)
largeField : ElabEnv -> String -> M.Ty -> Maybe String -> Maybe String
largeField e x ty after =
  if P.leq (M.levelOf ty) Small then after else Just (x ^ " : " ^ tyStrM e ty)

-- (the fields from the `i`th on)
formGo : ElabEnv -> Int -> List FieldDeclaration -> Elab Formed
formGo e' i Nil =
  pure { level = Small, fields = Nil, defaults = Nil, large = Nothing }
formGo e' i (Cons fd rest) = do
  ty <- runTyp fd.typ e'
  d <- defaultAt e' i ty fd.dflt
  f <- formGo (withScope e' (bindName fd.name (M.tyN ty) e'.scope)) (i + 1) rest
  pure
      { level = P.maxLevel f.level (M.levelOf ty)
      , fields = Cons (MkPair fd.name ty.stx) f.fields
      , defaults = consDefault fd.name d f.defaults
      , large = largeField e' fd.name ty f.large
      }

-- | a record type's fields formed where `e` is
formRecord : ElabEnv -> List FieldDeclaration -> Elab Formed
formRecord e fieldTyps =
  -- (the fields may name the definition being elaborated: the record
  -- type is nominative, so the recursion is guarded by its name)
  formGo
    (withScope (withFor e ForNominative) (undelayScope e.scope))
    0
    fieldTyps

recordOf : ElabEnv -> Formed -> M.Ty
recordOf e f =
  M.recordM
    e.globals
    e.scope.locals
    f.level
    (D.fromList f.fields)
    (D.fromList f.defaults)

recordFormation : List FieldDeclaration -> Typ
recordFormation fieldTyps =
  MkTyp (\e -> do
  f <- formRecord e fieldTyps
  pure (recordOf e f))

-- | (`nameSpan`: the field's name, where it is written)
type FieldSetting =
  { name : String, chk : Chk, span : P.Span, nameSpan : P.Span }

-- | a tag or a field, where it is written, as a name of the type it is
-- | of, defined where that type is
recordName : ElabEnv -> V.Ty -> String -> P.Span -> V.Ty -> Elab Unit
recordName e (VDecode (HGlobal k) sp2 u described el) x sp ty =
  if sp.end - sp.start == strLength x || sp.end - sp.start == strLength x + 1
    then record
        { span = sp
        , name = x
        , key = Just k
        , member = True
        , ty = \u -> tyStr e ty
        }
  else pure MkUnit
recordName e a x sp ty = pure MkUnit

appendP : {a : Type} -> List a -> List a -> List a
appendP Nil ys = ys
appendP (Cons x xs) ys = Cons x (appendP xs ys)

lookupP : {a : Type} -> List (Pair String a) -> String -> Maybe a
lookupP Nil x = Nothing
lookupP (Cons (MkPair y v) rest) x =
  if strEq y x then Just v else lookupP rest x

-- | the deepest local replaced: the self is the definition's first binding
rebottom : V.V -> V.Locals V.V -> V.Locals V.V
rebottom v LNil = LNil
rebottom v (LSnoc LNil x) = LSnoc LNil (\u -> v)
rebottom v (LSnoc rest x) = LSnoc (rebottom v rest) x
rebottom v (LChunkSnoc LNil xs) =
  if A.length xs == 1 then LSnoc LNil (\u -> v) else LChunkSnoc LNil xs
rebottom v (LChunkSnoc rest xs) = LChunkSnoc (rebottom v rest) xs

rescope : Scope -> V.V -> Scope
rescope sc v =
  { len = sc.len
  , names = sc.names
  , locals = rebottom v sc.locals
  , ctx = sc.ctx
  }

fieldEvOf : String -> V.Ty -> List (Pair String V.V) -> String -> V.Ev V.V
fieldEvOf gk a done f = case lookupP done f of
  Just v -> Nom v
  Nothing -> V.proj (V.reflect (HGlobal gk) (\u -> SpId) (\u -> a) Nothing) f

advanceSelf : String
            -> V.Ty
            -> D.Dict (V.Locals V.V -> V.Field)
            -> List (Pair String V.V)
            -> V.V
advanceSelf gk a fieldTypes done =
  V.reflect
    (HGlobal gk)
    (\u -> SpId)
    (\u -> a)
    (Just
       (Describe
          (VCons
             { keys = fieldTypes.keys
             , byName = fieldTypes.byName
             , values = A.map (fieldEvOf gk a done) fieldTypes.keys
             })))

-- | While the record being checked is the definition's own body, the
-- | self in scope is rebound after each field: a projection of a field
-- | already checked is that field's value; one still to come stays the
-- | bare neutral it always was.
selfAdvance : ElabEnv -> V.Ty -> List (Pair String V.V) -> Elab ElabEnv
selfAdvance e@{ elabFor = ForDescriptive (HGlobal gk) SpId } a done = do
  sk <- gets (\c -> c.selfKey)
  case V.behavior a of
    LikeRecord level capture fieldTypes ->
      if nameIs sk gk
        then pure
            (withScope e (rescope e.scope (advanceSelf gk a fieldTypes done)))
      else pure e
    _ -> pure e
selfAdvance e a done = pure e

checkFixed : ElabEnv -> P.Span -> V.V -> Maybe V.V -> Elab Unit
checkFixed e sp v Nothing = pure MkUnit
checkFixed e sp v (Just expected) = do
  r <- Mt.unifyEl e.globals (shape e.scope) v expected
  case r of
    Right _ -> pure MkUnit
    Left err ->
      failWithNote
        sp
        11
        ("expected value "
         ^ eqElStr e.globals (shape e.scope) expected
         ^ ", but got value "
         ^ eqElStr e.globals (shape e.scope) v)
        (prettyEqErr e.globals err)

-- | what checking a record's fields has in hand: the record's span, the
-- | type, its fields' names in order, their defaults, and the names of
-- | the fields written
type Intro =
  { span : P.Span
  , ty : V.Ty
  , keys : List String
  , defaults : D.Dict Sx.Tm
  , written : List String
  }

-- (`a`, `a and b`, `a, b and c`)
andList : List String -> String
andList Nil = ""
andList (Cons x Nil) = x
andList (Cons x (Cons y Nil)) = x ^ " and " ^ y
andList (Cons x rest) = x ^ ", " ^ andList rest

-- | the fields a record of the type is given, in order, and which of
-- | them it may leave out
fieldsNote : Intro -> String
fieldsNote it =
  "the fields are "
  ^ joinWith ", " it.keys
  ^ ", in this order"
  ^ (if D.size it.defaults == 0 then ""
     else " (" ^ andList (A.toList it.defaults.keys) ^ " may be left out)")

-- | the default `d` of a field, `vs` the fields before it: a nominal
-- | term, marked so in descriptive position (as one written there is,
-- | `CNominal`); its syntax names those fields, as the type has it
defaultFor : ElabFor -> G.Globals -> V.Locals V.V -> Sx.Tm -> M.El
defaultFor ForNominative g vs d = { stx = d, val = \u -> EV.eval g N d vs }
defaultFor (ForDescriptive _ _) g vs d =
  M.isM { stx = d, val = \u -> EV.eval g N d vs }

-- | a field given: its term, where it is (the setting, or the record for
-- | a default), whether it is a default, the settings after it
type Given = { el : M.El, span : P.Span, dflt : Bool, rest : List FieldSetting }

-- (field `x` not written, nor defaulted: the setting there instead, or
-- the record's end)
notGiven : Intro -> String -> List FieldSetting -> Elab Given
notGiven it x (Cons fs _) =
  failWithNote
    fs.span
    3
    ("expected record field " ^ x ^ " got: " ^ fs.name)
    (fieldsNote it)
notGiven it x Nil =
  failWithNote it.span 4 ("missing record field " ^ x) (fieldsNote it)

-- (field `x` not written: its default, if it has one; `vs` the fields
-- before it)
defaulted : ElabEnv
          -> Intro
          -> String
          -> V.Locals V.V
          -> List FieldSetting
          -> Elab Given
defaulted e it x vs settings = case D.lookup it.defaults x of
  Just d ->
    pure
      { el = defaultFor (projElabFor e.elabFor x) e.globals vs d
      , span = it.span
      , dflt = True
      , rest = settings
      }
  Nothing -> notGiven it x settings

written : ElabEnv
        -> Intro
        -> String
        -> V.Ty
        -> FieldSetting
        -> List FieldSetting
        -> Elab Given
written e it x fty fs rest = do
  recordName e it.ty fs.name fs.nameSpan fty
  m <- runChk fs.chk (withFor e (projElabFor e.elabFor x)) fty
  pure { el = m, span = fs.span, dflt = False, rest = rest }

-- | field `x`, of type `fty`: the next setting, if it is `x`'s, else
-- | `x`'s default
givenField : ElabEnv
           -> Intro
           -> String
           -> V.Ty
           -> V.Locals V.V
           -> List FieldSetting
           -> Elab Given
givenField e it x fty vs (Cons fs rest) =
  if strEq fs.name x then written e it x fty fs rest
  else defaulted e it x vs (Cons fs rest)
givenField e it x fty vs Nil = defaulted e it x vs Nil

-- | a field of the record, made: its name, its type, its term (a
-- | default's names the fields before it, as the type has it), whether it
-- | is a default, and where it is
type Made = { name : String, ty : V.Ty, el : M.El, dflt : Bool, span : P.Span }

-- | a setting after the type's fields: of none of them, or of one met
-- | before (written twice, or out of order)
leftOver : ElabEnv -> Intro -> List FieldSetting -> Elab (List Made)
leftOver e it Nil = pure Nil
leftOver e it (Cons fs _) =
  if List.length (List.filter (\x -> strEq x fs.name) it.written) > 1
    then failWithNote
        fs.span
        4
        ("record field " ^ fs.name ^ " is given twice")
        (fieldsNote it)
  else if List.elemBy strEq fs.name it.keys
    then failWithNote
        fs.span
        4
        ("record field " ^ fs.name ^ " is out of order")
        (fieldsNote it)
  else failWithNote
      fs.span
      7
      ("no such field " ^ fs.name ^ " in type " ^ tyStr e it.ty)
      (fieldsNote it)

-- | the record's fields, one by one as the type has them: each the next
-- | setting written, or its default
introGo : ElabEnv
        -> Intro
        -> List (Pair String V.V)
        -> V.Locals V.V
        -> List FieldSetting
        -> List (Pair String (V.Locals V.V -> V.Field))
        -> Elab (List Made)
introGo e it done vs settings Nil = leftOver e it settings
introGo e it done vs settings (Cons (MkPair x fieldC) rest) = case fieldC vs of
  MkField fty fvalue -> do
    g <- givenField e it x fty vs settings
    let v = createNominative (projElabFor e.elabFor x) (P.forceTh g.el.val) fty
    checkFixed e g.span v fvalue
    e' <- selfAdvance e it.ty (appendP done (Cons (MkPair x v) Nil))
    fields <-
      introGo
        e'
        it
        (appendP done (Cons (MkPair x v) Nil))
        (V.snocL vs v)
        g.rest
        rest
    pure
        (Cons
           { name = x, ty = fty, el = g.el, dflt = g.dflt, span = g.span }
           fields)

-- Sharing the fields a default names
--------------------------------------------------------------------------------

-- A default that names fields before it is given, where a record leaves
-- its field out, the record's own: those fields are bound once, by
-- `let`s around the record (beta-redexes, as `let x = e in e'` is), the
-- record and the defaults naming them by the `let`s' locals --
--
--   { lo = e }  at  { lo : Int, hi : Int = lo }  is  let lo = e in { lo = lo, hi = lo }

-- (does a default given, of the `i`th field on, name field `j`?)
namedFrom : List Made -> Int -> Int -> Bool
namedFrom Nil i j = False
namedFrom (Cons m rest) i j =
  (m.dflt && (mentionsLocal (i - 1 - j)).el 0 m.el.stx)
  || namedFrom rest (i + 1) j

-- | for each field, whether a default given names it: then it is bound
boundGo : List Made -> List Made -> Int -> List Bool
boundGo all Nil j = Nil
boundGo all (Cons m rest) j =
  Cons (namedFrom (List.drop (j + 1) all) (j + 1) j) (boundGo all rest (j + 1))

-- | each field's `let`, by its place among those bound, if it is bound
placesGo : List Bool -> Int -> List (Maybe Int)
placesGo Nil k = Nil
placesGo (Cons b rest) k =
  if b then Cons (Just k) (placesGo rest (k + 1))
  else Cons Nothing (placesGo rest k)

-- (under `at` of the `let`s: field `f`'s local, for each field before
-- the one a default is of; a field it does not name, any)
fieldIdxs : Int -> List (Maybe Int) -> List Int
fieldIdxs at Nil = Nil
fieldIdxs at (Cons (Just p) rest) = Cons (at - 1 - p) (fieldIdxs at rest)
fieldIdxs at (Cons Nothing rest) = Cons 0 (fieldIdxs at rest)

-- | a term of a context of `n` locals, under `k` binders more
weaken : Int -> Int -> Sx.Tm -> Sx.Tm
weaken n k t =
  if k == 0 then t
  else (U.substOf (List.map (\m -> n - 1 - m + k) (List.range 0 (n - 1)))).el
      0
      t

-- | the `i`th field's term, of the record's context (`n` locals) under
-- | `at` of the `let`s
codeAt : Int -> Int -> List (Maybe Int) -> Made -> Int -> Sx.Tm
codeAt n at places m i =
  if m.dflt then (U.substOf (fieldIdxs at (List.take i places))).el 0 m.el.stx
  else weaken n at m.el.stx

-- (the `i`th field in the record, under all `k` of the `let`s)
entryAt : Int -> Int -> List (Maybe Int) -> Made -> Int -> Maybe Int -> Sx.Tm
entryAt n k places m i (Just p) = SLocal (k - 1 - p)
entryAt n k places m i Nothing = codeAt n k places m i

entriesGo : Int
          -> Int
          -> List (Maybe Int)
          -> List Made
          -> List (Maybe Int)
          -> Int
          -> List (Pair String Sx.Tm)
entriesGo n k places (Cons m rest) (Cons pl pls) i =
  Cons
    (MkPair m.name (entryAt n k places m i pl))
    (entriesGo n k places rest pls (i + 1))
entriesGo n k places _ _ i = Nil

-- (the bound fields' values, each under the `let`s before it)
valuesGo : Int
         -> List (Maybe Int)
         -> List Made
         -> List (Maybe Int)
         -> Int
         -> List (Pair Made Sx.Tm)
valuesGo n places (Cons m rest) (Cons (Just p) pls) i =
  Cons (MkPair m (codeAt n p places m i)) (valuesGo n places rest pls (i + 1))
valuesGo n places (Cons m rest) (Cons Nothing pls) i =
  valuesGo n places rest pls (i + 1)
valuesGo n places _ _ i = Nil

-- | the `let`s around the record, the `p`th on (`a` the record's type)
letsAround : Int -> V.Ty -> List (Pair Made Sx.Tm) -> Int -> Sx.Tm -> Sx.Tm
letsAround n a Nil p body = body
letsAround n a (Cons (MkPair m v) rest) p body =
  SApp
    (SLam
       (SFunction
          (V.levelOf a)
          (R.readbTy (n + p) m.ty)
          (AbsConst (R.readbTy (n + p) a))
          Expl
          Nothing)
       (MkAbs m.name (letsAround n a rest (p + 1) body)))
    v

-- (a type written in place, `data { ... }`: no `let` binds it, the
-- `let`'s value being nominal)
describes : Sx.Tm -> Bool
describes (SCode (SSum _)) = True
describes (SCode (SRecord _ _ _)) = True
describes _ = False

-- | a bound field that is a type written in place: none may be
describedBound : List Made -> List Bool -> Elab Unit
describedBound (Cons m rest) (Cons b bs) =
  if b && describes m.el.stx
    then failWith
        m.span
        44
        ("`"
         ^ m.name
         ^ "` is a type written in place, and a default this record is given names it: define the type apart, and set `"
         ^ m.name
         ^ "` to its name")
  else describedBound rest bs
describedBound _ _ = pure MkUnit

-- (the `let`s, each field bound at its place, around the record)
lettedAt : ElabEnv
         -> V.Ty
         -> List Made
         -> M.El
         -> List Bool
         -> List (Maybe Int)
         -> Elab M.El
lettedAt e a made record bound places = do
  describedBound made bound
  pure
      { stx =
          letsAround
            e.scope.len
            a
            (valuesGo e.scope.len places made places 0)
            0
            (SCons
               (D.fromList
                  (entriesGo
                     e.scope.len
                     (List.length (List.filter (\b -> b) bound))
                     places
                     made
                     places
                     0)))
      , val = record.val
      }

-- (the record, and which fields a default given names)
lettedWith : ElabEnv -> V.Ty -> List Made -> M.El -> List Bool -> Elab M.El
lettedWith e a made record bound =
  if List.any (\b -> b) bound
    then lettedAt e a made record bound (placesGo bound 0)
  else pure record

-- | the record of the fields made, the fields a default given names bound
-- | once around it
letted : ElabEnv -> V.Ty -> List Made -> Elab M.El
letted e a made =
  lettedWith
    e
    a
    made
    (M.cons
       (caseOf e.elabFor)
       (D.fromList (List.map (\(m : Made) -> MkPair m.name m.el) made)))
    (boundGo made made 0)

recordIntro : P.Span -> List FieldSetting -> Chk
recordIntro sp fieldSettings =
  MkChk (\e0 a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeRecord level capture fieldTypes -> do
      made <-
        introGo
          e0
          { span = sp
          , ty = a
          , keys = A.toList fieldTypes.keys
          , defaults = V.defaultsOf a
          , written = List.map (\(fs : FieldSetting) -> fs.name) fieldSettings
          }
          Nil
          capture
          fieldSettings
          (D.toList fieldTypes)
      letted e0 a made
    _ ->
      failWith
        (a := M.El)
        sp
        5
        "tried to check a record expression at a non-record type")

fieldOrLocal : Int -> V.Ty -> Maybe V.V -> V.V
fieldOrLocal l fty (Just v) = v
fieldOrLocal l fty Nothing = V.local l fty

fieldTyAt : Int
          -> V.Locals V.V
          -> D.Dict (V.Locals V.V -> V.Field)
          -> Int
          -> Array V.V
          -> Int
          -> Maybe V.Ty
fieldTyAt len capture fieldTypes i before j =
  if j < i
    then case (D.at fieldTypes j) (LChunkSnoc capture before) of
      MkField fty fvalue ->
        fieldTyAt
          len
          capture
          fieldTypes
          i
          (A.fromList
             (appendP
                (A.toList before)
                (Cons (fieldOrLocal (len + j) fty fvalue) Nil)))
          (j + 1)
  else case (D.at fieldTypes i) (LChunkSnoc capture before) of
    MkField fty fvalue ->
      if mentionsInner (R.readbTy (len + i) fty) then Nothing else Just fty

-- | The type of field `x` of a record whose fields are not known: each
-- | field before it a local of its own (or the value the type fixes it
-- | to), and the type, if it mentions none of them
fieldTyApart : Int
             -> P.Level
             -> V.Locals V.V
             -> D.Dict (V.Locals V.V -> V.Field)
             -> String
             -> Maybe V.Ty
fieldTyApart len level capture fieldTypes x =
  fieldTyAt len capture fieldTypes (D.keyIndex fieldTypes x) A.empty 0

recordElim : P.Span -> Syn -> String -> Syn
recordElim sp projectee x =
  MkSyn (\e -> do
  pp <- runSyn projectee e
  -- (a value that takes implicit and instance arguments first is given
  -- them, as an application gives them: `equalityList.equal`)
  given <- insertImplicits e sp (fst pp) (snd pp)
  case given of
    MkPair eprojectee a0 -> do
      a <- Mt.forceT a0
      case V.behavior a of
        LikeRecord level capture fieldTypes ->
          if not (D.contains fieldTypes x)
            then failWith sp 7 ("no such field " ^ x ^ " in type " ^ tyStr e a)
          else case V.projTyMaybe a (M.valN eprojectee) x of
            Just fieldTy -> do
              recordName e a x sp fieldTy
              pure (MkPair (M.proj eprojectee x) fieldTy)
            -- (the value's fields are not in hand: the field's type is
            -- what it is without them, or it depends on them)
            Nothing -> case fieldTyApart
                e.scope.len
                level
                capture
                fieldTypes
                x of
              Just fieldTy -> do
                recordName e a x sp fieldTy
                pure (MkPair (M.projAt eprojectee x fieldTy) fieldTy)
              Nothing ->
                failWith
                  sp
                  32
                  ("the type of `."
                   ^ x
                   ^ "` depends on the fields before it, and what this record's are is not known here")
        NoRules -> do
          blocked <- Mt.blockedTy a
          if blocked then errorOf
            else failWith
                sp
                32
                ("the record's shape is not in hand here for `."
                 ^ x
                 ^ "`: annotate the binder, `\\(x : T) -> ...`, or give the implicit argument, `(a := T)`")
        _ -> do
          blocked <- Mt.blockedTy a
          if blocked then errorOf
            else failWith
                sp
                6
                "tried to project from a value that was not of a record type")

recordSpec : P.Span -> Syn -> String -> Chk -> Syn
recordSpec sp s x c =
  MkSyn (\e -> do
  pg <- runSyn s e
  case pg of
    MkPair g a -> case M.valN g of
      VNeu h sp2 nty expansion desc -> case desc MkUnit of
        Just (VCode (VRecord level capture fieldTypes defaults)) ->
          if D.contains fieldTypes x
            then case V.typeForProjection
                capture
                fieldTypes
                x
                (V.expandRecordWith
                   (\h2 s2 t2 d2 -> V.reflect h2 s2 t2 d2)
                   level
                   capture
                   fieldTypes
                   (HLocal e.scope.len)
                   SpId
                   Nothing) of
              MkField fty fvalue -> do
                g' <- runChk c e fty
                pure (MkPair (M.specializeM g x g') a)
          else failWith sp 22 ("no such field " ^ x)
        _ -> failWith sp 22 "can only specialize type with record behavior"
      _ -> failWith (a := Pair M.El V.Ty) sp 22 "can only specialize neutral")

-- Sum
--------------------------------------------------------------------------------

traverseE : {a b : Type} -> (a -> Elab b) -> List a -> Elab (List b)
traverseE f Nil = pure Nil
traverseE f (Cons x xs) = do
  y <- f x
  ys <- traverseE f xs
  pure (Cons y ys)

sumFormation : P.Variants SmallTyp -> Typ
sumFormation vs =
  MkTyp (\e -> do
  vs' <-
    traverseE
      (\p -> case p of
       MkPair k ts -> do
         ts' <-
           traverseE
             (\t ->
                runSmall
                  t
                  (withScope (withFor e ForNominative) (undelayScope e.scope)))
             (A.toList ts)
         pure (MkPair k (A.fromList ts')))
      (D.toList vs)
  pure (M.sumM (D.fromList vs')))

tagArgsGo : ElabEnv -> List Chk -> List (P.Th V.Ty) -> Elab (List M.El)
tagArgsGo e Nil Nil = pure Nil
tagArgsGo e (Cons c cs) (Cons t ts) = do
  m <- runChk c e (P.forceTh t)
  ms <- tagArgsGo e cs ts
  pure (Cons m ms)
tagArgsGo e _ _ = pure Nil

sumIntroNow : P.Span -> P.Span -> String -> List Chk -> Chk
sumIntroNow sp tsp x cs =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeSum vs -> case D.lookup vs x of
      Just ts ->
        if A.length ts == List.length cs
          then do
            recordName e a x tsp a
            args <- tagArgsGo e cs (A.toList ts)
            pure (M.tag x (A.fromList args))
        else failWith
            sp
            16
            ("wrong number of arguments for tag " ^ x ^ " in type " ^ tyStr e a)
      Nothing -> failWith sp 15 ("no such tag " ^ x ^ " in type " ^ tyStr e a)
    _ ->
      if U.isFlexTy a
        then failWith
            sp
            14
            ("cannot check tag syntax at a type that is not known: annotate it, as in `("
             ^ x
             ^ " ... : T)`")
      -- (as any mismatch: what was expected, and what was given; a
      -- capitalised name is read as a tag when it names no definition
      -- or binder)
      else failWithNote
          tsp
          14
          ("expected type " ^ tyStr e a ^ ", but got the tag " ^ x)
          (x
           ^ " names no definition or binder in scope, so it is read as a tag"))

-- | `sp`: the tag applied, `tsp`: the tag
sumIntro : P.Span -> P.Span -> String -> List Chk -> Chk
sumIntro sp tsp x cs =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  -- extension: at a type not known yet, the tag waits for it (once)
  if U.isFlexTy a then delayChk e sp "tag" (sumIntroNow sp tsp x cs) a
    else runChk (sumIntroNow sp tsp x cs) e a)

recordTagIn : ElabEnv
            -> V.Ty
            -> P.Variants (P.Th V.Ty)
            -> String
            -> P.Span
            -> Elab Unit
recordTagIn e a vs x tsp = case D.lookup vs x of
  Just _ -> recordName e a x tsp a
  Nothing -> pure MkUnit

recordTags : ElabEnv
           -> V.Ty
           -> P.Variants (P.Th V.Ty)
           -> List (Pair String P.Span)
           -> Elab Unit
recordTags e a vs Nil = pure MkUnit
recordTags e a vs (Cons (MkPair x tsp) rest) = do
  recordTagIn e a vs x tsp
  recordTags e a vs rest

caseArm : P.Span
        -> ElabEnv
        -> V.Ty
        -> V.Ty
        -> String
        -> List (P.Th V.Ty)
        -> D.Dict (Pair (Array String) Chk)
        -> Elab (Pair String (Pair (Array String) Sx.Tm))
caseArm sp e b a x ts casesChk = case D.lookup casesChk x of
  Just (MkPair xs bodyChk) ->
    if A.length xs == List.length ts
      then do
        body <-
          runChk
            bodyChk
            (withScope
               e
               (multiBind
                  (A.toList xs)
                  (List.map (\t -> P.forceTh t) ts)
                  e.scope))
            b
        pure (MkPair x (MkPair xs body.stx))
    else failWith sp 16 ("wrong number of arguments provided for tag " ^ x)
  -- extension: a default case `_ => e` covers the tags not listed
  Nothing -> case D.lookup casesChk "_" of
    Just (MkPair us bodyChk) -> do
      body <-
        runChk
          bodyChk
          (withScope
             e
             (multiBind
                (List.map (\t -> "_") ts)
                (List.map (\t -> P.forceTh t) ts)
                e.scope))
          b
      pure (MkPair x (MkPair (A.fromList (List.map (\t -> "_") ts)) body.stx))
    Nothing -> failWith sp 17 ("no case provided for tag " ^ x)

casesAt : P.Span
        -> ElabEnv
        -> V.Ty
        -> M.El
        -> V.Ty
        -> P.Variants (P.Th V.Ty)
        -> List (Pair String P.Span)
        -> D.Dict (Pair (Array String) Chk)
        -> Elab M.El
casesAt sp e b scrut a vs tags casesChk = do
  recordTags e a vs tags
  cases <-
    traverseE
      (\p -> case p of
       MkPair x ts -> caseArm sp e b a x (A.toList ts) casesChk)
      (D.toList vs)
  pure (M.matchM scrut (D.fromList cases))

matchLater : P.Span
           -> M.El
           -> V.Ty
           -> List (Pair String P.Span)
           -> D.Dict (Pair (Array String) Chk)
           -> Chk
matchLater sp scrut a tags casesChk =
  MkChk (\e2 b2 -> do
  a2 <- Mt.forceT a
  case V.behavior a2 of
    LikeSum vs -> casesAt sp e2 b2 scrut a2 vs tags casesChk
    _ -> do
      blocked <- Mt.blockedTy a2
      if blocked then pure (errorHole b2)
        else failWith
            sp
            18
            ("cannot match against non-sum type " ^ tyStr e2 a2))

-- | `tags`: where the cases' tags are written
sumElim : P.Span
        -> Syn
        -> List (Pair String P.Span)
        -> D.Dict (Pair (Array String) Chk)
        -> Chk
sumElim sp scrutSyn tags casesChk =
  MkChk
    (\e b ->
       if not (P.leq (V.levelOf b) Small)
         then failWith sp 23 "cannot eliminate from sum type into large type"
       else do
         ps <- runSyn scrutSyn e
         case ps of
           MkPair scrut a0 -> do
             a <- Mt.forceT a0
             case V.behavior a of
               LikeSum vs -> casesAt sp e b scrut a vs tags casesChk
               _ -> do
                 blocked <- Mt.blockedTy a
                 if blocked then pure (errorHole b)
                   else if U.isFlexTy a
                     -- the scrutinee's type is an unsolved implicit: the
                     -- cases wait for it, a hole standing for the match
                     then delayChkOn
                         e
                         sp
                         "match"
                         (matchLater sp scrut a tags casesChk)
                         a
                         b
                   else failWith
                       sp
                       18
                       ("cannot match against non-sum type " ^ tyStr e a))

-- | extension: a `case` of nested patterns is compiled
-- | (`Clauses.caseTree`) into the matches above, on a name for the
-- | scrutinee, bound once by a beta-redex; `lams` does not grow
caseLet : String -> Syn -> Chk -> Chk
caseLet x scrutSyn body =
  MkChk (\e b -> do
  ps <- runSyn scrutSyn e
  case ps of
    MkPair scrut a0 -> do
      a <- Mt.forceT a0
      ebody <-
        withBound x a e.scope (\v scope' -> runChk body (withScope e scope') b)
      pure
          (M.app
             (M.lam
                (caseOf e.elabFor)
                e.globals
                e.scope.locals
                (M.function
                   e.globals
                   e.scope.locals
                   (M.fromVTy N e.scope.len a)
                   (MkAbs x (M.fromVTy N (e.scope.len + 1) b)))
                (MkAbs x ebody))
             scrut))

-- | the scope of a local definition's body: the definition itself, by
-- | its name, in hand only under a lambda of the body (`rec`), as a
-- | top-level definition is in its own
fixEnv : ElabEnv -> String -> V.Ty -> ElabEnv
fixEnv e x a =
  { scope = letAt (BDelayedBy 1) x (V.local e.scope.len a) a e.scope
  , globals = e.globals
  , elabFor = ForNominative
  , lams = 0
  , self = e.self
  , insts = e.insts
  }

-- | extension: a local definition (`where`), `x : T` by `body`, which may
-- | call `x` under a lambda; bound in `rest` by a beta-redex
localDef : String -> Typ -> Chk -> Chk -> Chk
localDef x typ body rest =
  MkChk (\e b -> do
  ty <- runTyp typ (withFor e ForNominative)
  ebody <- runChk body (fixEnv e x (M.tyN ty)) (M.tyN ty)
  erest <-
    withBound
      x
      (M.tyN ty)
      e.scope
      (\v scope' -> runChk rest (withScope e scope') b)
  pure
      (M.app
         (M.lam
            (caseOf e.elabFor)
            e.globals
            e.scope.locals
            (M.function
               e.globals
               e.scope.locals
               ty
               (MkAbs x (M.fromVTy N (e.scope.len + 1) b)))
            (MkAbs x erest))
         (M.fixM ty x ebody)))

-- Update
--------------------------------------------------------------------------------

-- `{ r | x = v }` is `r` bound once, and the record of its type with
-- `x` set to `v`, every other field `r`'s own:
--
--   { r | x = v }  at  { x : Int, y : Int }  is  (\r' -> { x = v, y = r'.y }) r
--
-- A field not set keeps `r`'s value, a default too: defaults are given
-- where a record is built, not where one is updated.  `x.y = v` sets
-- field `y` of `r.x` the same way, the settings under one field put
-- together.

-- | a setting of an update: the field (where its name is, where the
-- | setting is) set to a value, or its own fields set (`x.y = v`)
data UpdateField
  = UpdateTo String P.Span P.Span Chk
  | UpdateIn String P.Span P.Span (List UpdateField)

updateName : UpdateField -> String
updateName (UpdateTo x _ _ _) = x
updateName (UpdateIn x _ _ _) = x

updateSpan : UpdateField -> P.Span
updateSpan (UpdateTo _ _ sp _) = sp
updateSpan (UpdateIn _ _ sp _) = sp

appendInner : List UpdateField
            -> Maybe (List UpdateField)
            -> Maybe (List UpdateField)
appendInner fs (Just more) = Just (appendP fs more)
appendInner fs Nothing = Nothing

-- | the settings of `x.y = v`, `x.z = w`: `y = v`, `z = w`
updateInner : List UpdateField -> Maybe (List UpdateField)
updateInner Nil = Just Nil
updateInner (Cons (UpdateIn _ _ _ fs) rest) = appendInner fs (updateInner rest)
updateInner (Cons (UpdateTo _ _ _ _) rest) = Nothing

-- | a field kept or set, whose type in the record updated `t` must be
-- | its type in the record made, `fty` (one a field set depends on is
-- | not: it is set too)
sameField : P.Span -> ElabEnv -> String -> V.Ty -> M.El -> V.Ty -> Elab M.El
sameField sp e x fty m t = do
  r <- Mt.attempt (Mt.unifyTy e.globals (shape e.scope) fty t)
  case r of
    Right _ -> do
      Mt.runDelayed False
      pure m
    Left err -> do
      want <- tyStrZ e fty
      got <- tyStrZ e t
      failWithNote
          sp
          11
          ("field "
           ^ x
           ^ " is of type "
           ^ got
           ^ " in the record updated, but of type "
           ^ want
           ^ " in the record made: set it too")
          (prettyEqErr e.globals err)

-- | field `x` of the record `g` (of type `a`), bound to `r`, and its
-- | type: named by the binder, so that `g` is computed once, but `g`'s
-- | own as a value -- the redex the binder is of is, reduced -- so that
-- | a field a type depends on is what it is (`r.t` is `Int`)
updatedField : P.Span
             -> ElabEnv
             -> String
             -> M.El
             -> V.Ty
             -> String
             -> Elab (Pair M.El V.Ty)
updatedField sp e r g a x = case findLocal e r of
  Right (MkPair v _) ->
    let bound = M.boundTo v g
    in case V.behavior a of
    LikeRecord level capture fieldTypes -> case V.projTyMaybe a (M.valN g) x of
      Just t -> pure (MkPair (M.proj bound x) t)
      Nothing -> case fieldTyApart e.scope.len level capture fieldTypes x of
        Just t -> pure (MkPair (M.projAt bound x t) t)
        Nothing ->
          failWith
            sp
            32
            ("the type of field "
             ^ x
             ^ " depends on the fields before it, and what the record's are is not known here")
    _ -> failWith sp 6 "tried to update a value that was not of a record type"
  Left _ -> failWith sp 3 "the record updated is out of scope"

-- | a field the update does not set: the record's own
keptField : P.Span -> String -> M.El -> V.Ty -> String -> Chk
keptField sp r g a x =
  MkChk (\e fty -> do
  pt <- updatedField sp e r g a x
  case pt of
    MkPair m t -> sameField sp e x fty m t)

-- (the field's name, where it is written, as `recordName` has it)
recordNameOf : ElabEnv -> V.Ty -> String -> P.Span -> Elab Unit
recordNameOf e a x xsp = case V.behavior a of
  LikeRecord level capture fieldTypes -> case fieldTyApart
      e.scope.len
      level
      capture
      fieldTypes
      x of
    Just t -> recordName e a x xsp t
    Nothing -> pure MkUnit
  _ -> pure MkUnit

-- | field `x` set twice, or set and a field of it set too
givenTwice : {b : Type} -> List UpdateField -> String -> Elab b
givenTwice fs x = case List.drop
    1
    (List.filter (\f -> strEq (updateName f) x) fs) of
  Cons f _ -> failWith (updateSpan f) 4 ("record field " ^ x ^ " is set twice")
  Nil -> failWith P.noSpan 4 ("record field " ^ x ^ " is set twice")

-- | how a record is updated (`updateOf`, below)
type Updater =
  P.Span -> String -> ElabEnv -> M.El -> V.Ty -> List UpdateField -> Elab M.El

-- | a field whose own fields the update sets: the record's, updated
nestedField : Updater
            -> P.Span
            -> String
            -> M.El
            -> V.Ty
            -> String
            -> List UpdateField
            -> Chk
nestedField upd sp r g a x fs =
  MkChk (\e fty -> do
  pt <- updatedField sp e r g a x
  case pt of
    MkPair m t -> do
      m' <- upd sp r e m t fs
      sameField sp e x fty m' t)

-- | field `x` of the record made: kept, or as the settings of it say
updateSetting : Updater
              -> ElabEnv
              -> P.Span
              -> String
              -> M.El
              -> V.Ty
              -> List UpdateField
              -> String
              -> Elab FieldSetting
updateSetting upd e sp r g a fs x = case List.filter
    (\f -> strEq (updateName f) x)
    fs of
  Nil ->
    pure
      { name = x, chk = keptField sp r g a x, span = sp, nameSpan = P.noSpan }
  Cons (UpdateTo _ xsp fsp c) Nil ->
    pure { name = x, chk = c, span = fsp, nameSpan = xsp }
  Cons (UpdateIn _ xsp fsp inner) more -> case updateInner more of
    Just rest -> do
      recordNameOf e a x xsp
      pure
          { name = x
          , chk = nestedField upd fsp r g a x (appendP inner rest)
          , span = fsp
          , nameSpan = P.noSpan
          }
    Nothing -> givenTwice fs x
  _ -> givenTwice fs x

-- | a setting of a field the type does not have
noSuchSetting : ElabEnv -> V.Ty -> List String -> List UpdateField -> Elab Unit
noSuchSetting e a keys Nil = pure MkUnit
noSuchSetting e a keys (Cons f rest) =
  if List.elemBy strEq (updateName f) keys then noSuchSetting e a keys rest
  else failWithNote
      (updateSpan f)
      7
      ("no such field " ^ updateName f ^ " in type " ^ tyStr e a)
      ("the fields are " ^ joinWith ", " keys)

-- | the record `g`, of type `a0`, its fields set as `fs` say: bound to
-- | `r`, and made anew of it
updateOf : P.Span
         -> String
         -> ElabEnv
         -> M.El
         -> V.Ty
         -> List UpdateField
         -> Elab M.El
updateOf sp r e g a0 fs = do
  a <- Mt.forceT a0
  case V.behavior a of
    LikeRecord level capture fieldTypes -> do
      let keys = A.toList fieldTypes.keys
      noSuchSetting e a keys fs
      settings <- traverseE (\x -> updateSetting updateOf e sp r g a fs x) keys
      -- (bound by a beta-redex, as `let` binds)
      body <-
        withBound
          r
          a
          e.scope
          (\v scope' -> runChk (recordIntro sp settings) (withScope e scope') a)
      pure
          (M.app
             (M.lam
                (caseOf e.elabFor)
                e.globals
                e.scope.locals
                (M.function
                   e.globals
                   e.scope.locals
                   (M.fromVTy N e.scope.len a)
                   (MkAbs r (M.fromVTy N (e.scope.len + 1) a)))
                (MkAbs r body))
             g)
    NoRules -> do
      blocked <- Mt.blockedTy a
      if blocked then pure (errorHole a)
        else failWith
            sp
            32
            "the record's shape is not in hand here for the update: annotate the binder, `\\(x : T) -> ...`, or give the implicit argument, `(a := T)`"
    _ -> do
      blocked <- Mt.blockedTy a
      if blocked then pure (errorHole a)
        else failWith
            sp
            6
            "tried to update a value that was not of a record type"

-- | `{ s | fs }`, bound to `r` (a name none of the settings has)
recordUpdate : P.Span -> Syn -> String -> List UpdateField -> Syn
recordUpdate sp s r fs =
  MkSyn (\e -> do
  ps <- runSyn s e
  given <- insertImplicits e sp (fst ps) (snd ps)
  case given of
    MkPair g a -> do
      m <- updateOf sp r e g a fs
      pure (MkPair m a))

-- Universe
--------------------------------------------------------------------------------

universeFormation : P.Universe -> Typ
universeFormation u = MkTyp (\e -> pure (M.univ u))

-- (a type too large for its universe: `note`, what to write instead)
tooLarge : P.Span -> String -> Maybe String -> Elab M.El
tooLarge sp msg Nothing = failWith sp 9 msg
tooLarge sp msg (Just note) = failWithNote sp 9 msg note

-- (the type `ty` as a term of the type `a`, a universe it must be small
-- enough for)
universeAt : P.Span -> Maybe String -> ElabEnv -> V.Ty -> M.Ty -> Elab M.El
universeAt sp note e a ty = case V.behavior a of
  LikeU u ->
    if P.leq (M.levelOf ty) (P.decodesInto u) then pure (M.code ty)
    else tooLarge
        sp
        ("type " ^ tyStrM e ty ^ " too large for its universe")
        note
  _ ->
    failWith
      sp
      10
      ("cannot check type "
       ^ tyStrM e ty
       ^ " at non-universe type "
       ^ tyStr e a)

universeIntro : P.Span -> Typ -> Chk
universeIntro sp typ =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  ty <- runTyp typ e
  universeAt sp Nothing e a ty)

-- (what a record type too large for run-time data is: a theory)
theoryNote : Maybe String -> Maybe String
theoryNote Nothing = Nothing
theoryNote (Just field) =
  Just
    ("its field `"
     ^ field
     ^ "` is no run-time data: a record with such a field is a theory -- declare it with `theory X where`, a field a line")

-- | a record type as a term (`type X = { ... }`): one with a field too
-- | large for run-time data is said to be a theory
recordTypeIntro : P.Span -> List FieldDeclaration -> Chk
recordTypeIntro sp fieldTyps =
  MkChk (\e a0 -> do
  a <- Mt.forceT a0
  f <- formRecord e fieldTyps
  universeAt sp (theoryNote f.large) e a (recordOf e f))

universeElim : P.Universe -> Chk -> Typ
universeElim u chk =
  MkTyp (\e -> do
  m <- runChk chk e (VU u)
  pure (M.decode m))

universeElimSyn : P.Span -> Syn -> Typ
universeElimSyn sp syn =
  MkTyp (\e -> do
  pm <- runSyn syn e
  case pm of
    MkPair m a -> case a of
      VU u -> pure (M.decode m)
      _ -> failWith sp 10 "cannot decode an element of non-universe type")

asSmall : P.Span -> Typ -> SmallTyp
asSmall sp typ =
  MkSmallTyp (\e -> do
  ty <- runTyp typ e
  if P.leq (M.levelOf ty) Small then pure ty
    else failWith sp 9 "expected small type")

indexOfName : List String -> String -> Int -> Maybe Int
indexOfName Nil x i = Nothing
indexOfName (Cons y ys) x i =
  if strEq y x then Just i else indexOfName ys x (i + 1)

selfKeyOf : ElabEnv -> String -> Maybe String
selfKeyOf e x = case indexOfName e.scope.names x 0 of
  Just i -> if i == e.scope.len - 1 then e.self else Nothing
  Nothing -> Nothing

-- (the places, said: `A, and B`, `A, B, and C`)
placesSaid : List String -> String
placesSaid Nil = ""
placesSaid [x] = x
placesSaid [x, y] = x ^ ", and " ^ y
placesSaid (x :: rest) = x ^ ", " ^ placesSaid rest

-- | a name that stands for more than one definition, used unqualified:
-- | which, and where each is
ambiguousMsg : G.Globals -> String -> List String -> String
ambiguousMsg g x ks =
  "`" ^ x ^ "` is defined " ^ placesSaid (List.map (G.placeOf g) ks)

find : P.Span -> String -> Syn
find sp x =
  MkSyn (\e -> case findLocal e x of
  Right (MkPair m ty) -> do
    -- (the definition's own name, local 0: the global it is)
    record
        { span = sp
        , name = x
        , key = selfKeyOf e x
        , member = False
        , ty = \u -> tyStr e ty
        }
    pure (MkPair m ty)
  Left Delayed2 ->
    failWith
      sp
      19
      ("variable "
       ^ x
       ^ " is the definition being elaborated: it is in hand only under a lambda, where a type is expected of it (an argument, a branch, the result -- not a case scrutinee)")
  Left NotInScope -> case G.ambiguousIn e.globals x of
    Just ks -> failWith sp 30 (ambiguousMsg e.globals x ks)
    Nothing -> case G.lookupKey e.globals x of
      Just (MkPair key ge) -> do
        record
            { span = sp
            , name = x
            , key = Just key
            , member = False
            , ty = \u -> tyStr e ge.type_
            }
        pure (MkPair (M.global key ge.value) ge.type_)
      Nothing ->
        -- (not an error of its own: that of the definition is reported)
        if G.isBroken e.globals x
          then failElsewhere sp ("uses " ^ x ^ ", which does not elaborate")
        else failWith sp 8 ("no such variable " ^ x ^ " in scope"))

-- Literal patterns
--------------------------------------------------------------------------------

-- | the equality a literal pattern matches a value of the type by (its
-- | primitive's name, in scope: builtin has `Rune`'s and the fixed-width
-- | types'); `eq` where the type is not known
equalityAt : V.Ty -> String -> String
equalityAt t eq = case V.behavior t of
  LikeInt -> "intEq"
  LikeFloat -> "floatEq"
  LikeString -> "strEq"
  LikeRune -> "runeEq"
  LikeFixed w -> Fx.primPrefix w ^ "Eq"
  _ -> eq

-- | the primitive `p` by its key, its bare name, whatever the name `p`
-- | stands for here (the module's own `intEq`, a local): there if a
-- | module the file is made of declares it, as the prelude does `intEq`
-- | and builtin `int32Eq`
findPrim : P.Span -> String -> Syn
findPrim sp p =
  MkSyn (\e -> case G.keyedEntry e.globals p of
  Just (MkPair key ge) -> do
    record
        { span = sp
        , name = p
        , key = Just key
        , member = False
        , ty = \u -> tyStr e ge.type_
        }
    pure (MkPair (M.global key ge.value) ge.type_)
  Nothing -> failWith sp 8 ("no such variable " ^ p ^ " in scope"))

-- | `x` matched by a literal pattern: whether it is equal to the literal,
-- | checked at `x`'s type, by that type's equality, the primitive
litEq : P.Span -> String -> P.Span -> String -> Chk -> Syn
litEq sp x xsp eq lit =
  MkSyn (\e -> do
  px <- runSyn (find xsp x) e
  a <- Mt.forceT (snd px)
  runSyn
      (functionElim
         sp
         (functionElim
            sp
            (findPrim sp (equalityAt a eq))
            (apply xsp (MkSyn (\e2 -> pure px))))
         lit)
      e)

-- >>> (\(p : Pair M.El V.Ty) -> 1) (MkPair M.abandonM VPrimInt)
-- 1
