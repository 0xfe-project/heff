-- Definitions, as globals: `define` evaluates a definition's stored
-- syntax (the body has the definition itself as local 0) into its value
-- -- the self is a neutral of the definition's name, described by the
-- body's own evaluation.

module heff.elab.top

import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.elab.syntax as Syntax
import heff.elab.value as Value

emptyGlobals : Eval.Globals
emptyGlobals = Globals.emptyGlobals

typeOf : Eval.Globals -> Syntax.Ty -> Value.Ty
typeOf g tyStx = Value.nom (Eval.evalTy g N tyStx LNil)

-- | the definition's value: a neutral of its name whose description is
-- | the body, evaluated with the value itself as local 0 (the knot; the
-- | thunk recomputes it, it is not shared)
valueOf : Eval.Globals -> String -> Syntax.Ty -> Syntax.Tm -> Value.V
valueOf g k tyStx bodyStx =
  Value.reflect
    (HGlobal k)
    (\u -> SpId)
    (\u -> typeOf g tyStx)
    (Just
       (Eval.eval g De bodyStx (LSnoc LNil (\u -> valueOf g k tyStx bodyStx))))

-- | a primitive has no definition to unfold: it is a neutral
primValueOf : Eval.Globals -> String -> Syntax.Ty -> Value.V
primValueOf g k tyStx =
  Value.reflect (HGlobal k) (\u -> SpId) (\u -> typeOf g tyStx) Nothing

define : Eval.Globals -> String -> Syntax.Ty -> Syntax.Tm -> Eval.Globals
define g k tyStx bodyStx =
  Globals.addEntry
    k
    { syntax = bodyStx
    , tySyntax = tyStx
    , value = valueOf g k tyStx bodyStx
    , type_ = typeOf g tyStx
    }
    g
