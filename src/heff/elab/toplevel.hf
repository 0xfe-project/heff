-- Top-level elaboration: presyntax becomes
-- judgments (the dispatcher's functions are one knot record, `tk`),
-- declarations become globals, each elaborated in a fresh state; a
-- definition whose body fails is an error hole of its type.  A watch
-- (`-- >>> e`, or a doc test `-- | >>> e`, which the reader puts after
-- the definition it is of) elaborates to an entry of its own, kept
-- aside.

import array as Array
import co
import heff.elab.clauses as Clauses
import heff.elab.conversion as Conversion
import heff.syntax.diagnostic
import heff.util.dict as Dict
import heff.elab.environment
import heff.elab.globals as Globals
import heff.elab.memoed as Memoed
import heff.elab.meta as Meta
import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import heff.compile.prims as Prims
import heff.elab.print as Print
import heff.syntax.surfaceprint as SurfacePrint
import heff.elab.readback as Readback
import heff.elab.rename as Rename
import heff.elab.rules as Rules
import heff.syntax.surface as Surface
import heff.elab.syntax as Syntax
import heff.elab.top as Top
import heff.elab.unify as Unify
import heff.elab.value as Value
import map as Map

-- Diagnostics (parser codes are numbered from 200)
--------------------------------------------------------------------------------

failP : {a : Type} -> Params.Span -> Int -> String -> Elab a
failP sp code msg =
  throwE
    { code = 200 + code
    , severity = SError
    , msg = msg
    , span = sp
    , note = Nothing
    }

failNoteP : {a : Type} -> Params.Span -> Int -> String -> String -> Elab a
failNoteP sp code msg note =
  throwE
    { code = 200 + code
    , severity = SError
    , msg = msg
    , span = sp
    , note = Just note
    }

unexpectedNotation : {a : Type} -> Params.Span -> String -> Elab a
unexpectedNotation sp c = failP sp 3 ("unexpected notation for " ^ c)

-- The self, as local 0
--------------------------------------------------------------------------------

type SL =
  { el : Int -> Syntax.Tm -> Syntax.Tm, ty : Int -> Syntax.Ty -> Syntax.Ty }

selfTermF : SL -> String -> Int -> Syntax.Tm -> Syntax.Tm
selfTermF r k d (SGlobal x) = if strEq x k then SLocal d else SGlobal x
selfTermF r k d (SCode a) = SCode (r.ty d a)
selfTermF r k d (SApp f a) = SApp (r.el d f) (r.el d a)
selfTermF r k d (SLam dom (MkAbs x b)) =
  SLam (r.ty d dom) (MkAbs x (r.el (d + 1) b))
selfTermF r k d (SLam dom (AbsConst b)) =
  SLam (r.ty d dom) (AbsConst (r.el d b))
selfTermF r k d (SCons c) = SCons (Dict.mapD (r.el d) c)
selfTermF r k d (SProj e l) = SProj (r.el d e) l
selfTermF r k d (STag tg as) = STag tg (Array.map (r.el d) as)
selfTermF r k d (SMatch e cs) =
  SMatch
    (r.el d e)
    (Dict.mapD
       (\p -> case p of
        MkPair xs b -> MkPair xs (r.el (d + Array.length xs) b))
       cs)
selfTermF r k d (SSpecialize e l v) = SSpecialize (r.el d e) l (r.el d v)
selfTermF r k d (SIs e) = SIs (r.el d e)
selfTermF r k d (SRec e) = SRec (r.el d e)
selfTermF r k d (SFix dom (MkAbs x b)) =
  SFix (r.ty d dom) (MkAbs x (r.el (d + 1) b))
selfTermF r k d (SFix dom (AbsConst b)) =
  SFix (r.ty d dom) (AbsConst (r.el d b))
selfTermF r k d (SImplicit x e) = SImplicit x (r.el d e)
selfTermF r k d (SMetaApp m ix ty2) = SMetaApp m ix (r.ty d ty2)
selfTermF r k d t = t

selfTypeF : SL -> String -> Int -> Syntax.Ty -> Syntax.Ty
selfTypeF r k d (SDecode e) = SDecode (r.el d e)
-- (an implicit argument's default is closed: it does not mention the
-- definition)
selfTypeF r k d (SFunction level dom (MkAbs x b) implicit dflt) =
  SFunction level (r.ty d dom) (MkAbs x (r.ty (d + 1) b)) implicit dflt
selfTypeF r k d (SFunction level dom (AbsConst b) implicit dflt) =
  SFunction level (r.ty d dom) (AbsConst (r.ty d b)) implicit dflt
-- (a default names no local but the fields before it: not the
-- definition, local 0)
selfTypeF r k d (SRecord level ft ds) = SRecord level (Dict.mapD (r.ty d) ft) ds
selfTypeF r k d (SSum vs) = SSum (Dict.mapD (Array.map (r.ty d)) vs)
selfTypeF r k d (SIsTy a) = SIsTy (r.ty d a)
selfTypeF r k d (SPrimArray a) = SPrimArray (r.ty d a)
selfTypeF r k d t = t

selfWalk : String -> SL
selfWalk k =
  { el = \d t -> selfTermF (selfWalk k) k d t
  , ty = \d t -> selfTypeF (selfWalk k) k d t
  }

-- | the global it was mentioned as, while it was not yet one: the
-- | definition itself, local 0
selfAsLocal : String -> Syntax.Tm -> Syntax.Tm
selfAsLocal k t = (selfWalk k).el 0 t

-- Judgments from presyntax
--------------------------------------------------------------------------------

-- (in descriptive position, a term not passing it on is elaborated as in
-- nominative, its result marked so: `Notation.INominal` and the others,
-- where the presyntax says it is)
nominalSyn : Rules.Syn -> Rules.Syn
nominalSyn j =
  MkSyn (\e -> do
  pr <- Rules.runSyn j (Rules.withFor e ForNominative)
  case pr of
    MkPair res a -> pure (MkPair (Memoed.isM res) a))

nominalChk : Rules.Chk -> Rules.Chk
nominalChk j =
  MkChk (\e a -> do
  res <- Rules.runChk j (Rules.withFor e ForNominative) a
  pure (Memoed.isM res))

nominalTyp : Rules.Typ -> Rules.Typ
nominalTyp j =
  MkTyp (\e -> do
  res <- Rules.runTyp j (Rules.withFor e ForNominative)
  pure (Memoed.isTy res))

-- | a term that can only be checked, never inferred (whose argument
-- | waits, where its type is not known yet)
checksOnly : Presyntax.Checkable -> Bool
checksOnly (At (CInf i) _) = case Params.nodeOf (Presyntax.infSpineOf i).head of
  IAnnLam _ _ _ _ -> True
  _ -> False
checksOnly (At (CType _) _) = False
checksOnly c = True

implicitLambda : Presyntax.Checkable -> Bool
implicitLambda (At (CImplicitLam _ _ _) _) = True
implicitLambda _ = False

-- | the elaborator's functions, knotted: a term inferring, checked (the
-- | implicit lambdas around it inserted), checked as written, a type
type TK =
  { infJ : Presyntax.Inferable -> Elab Rules.Syn
  , chkJ : Presyntax.Checkable -> Elab Rules.Chk
  , rawJ : Presyntax.Checkable -> Elab Rules.Chk
  , typJ : Presyntax.TypeForm -> Elab Rules.Typ
  }

-- | a check, recovered from where it fails -- where its presyntax is not
-- | read, too
recoveringChk : Elab Rules.Chk -> Elab Rules.Chk
recoveringChk m = do
  r <- tryE m
  case r of
    Right c -> pure (Rules.recovering c)
    Left d -> pure (Rules.recovering (MkChk (\e a -> throwE d)))

-- | an argument: where it does not check, an error hole
argumentF : TK -> Presyntax.Checkable -> Elab Rules.Chk
argumentF tk c = recoveringChk (tk.chkJ c)

-- | an application to `a`, from `start` (where the function is) to it
elimF : TK
      -> Int
      -> Rules.Syn
      -> Params.Spanned (Presyntax.Arg Presyntax.Checkable)
      -> Elab Rules.Syn
elimF tk start s (At (ArgProject x) sp) = pure (Rules.recordElim sp s x)
elimF tk start s (At (ArgNamed x c) sp) = do
  a <- argumentF tk c
  pure (Rules.functionElimNamed { start = start, end = sp.end } x s a)
elimF tk start s (At (ArgExplicit c) sp) = do
  a <- argumentF tk c
  pure (Rules.functionElimC (checksOnly c) { start = start, end = sp.end } s a)

elimAll : TK
        -> Int
        -> Rules.Syn
        -> List (Params.Spanned (Presyntax.Arg Presyntax.Checkable))
        -> Elab Rules.Syn
elimAll tk start s Nil = pure s
elimAll tk start s (Cons a rest) = do
  s' <- elimF tk start s a
  elimAll tk start s' rest

-- | a field's default, and where it is: where it does not check, an
-- | error hole
defaultF : TK -> Maybe Presyntax.Checkable -> Elab (Maybe Rules.Default)
defaultF tk Nothing = pure Nothing
defaultF tk (Just c) = do
  j <- recoveringChk (tk.chkJ c)
  pure (Just { chk = j, span = Params.spanOf c })

binderF : TK
        -> Presyntax.PiBinder Presyntax.TypeForm Presyntax.Checkable
        -> Elab Rules.Binder
binderF tk (PiNamed x _ t) = do
  a <- tk.typJ t
  pure (Named x a)
binderF tk (PiInstance x _ sp t) = do
  a <- tk.typJ t
  pure (NamedInstance sp x a)
binderF tk (PiImplicit x _ sp t d) = do
  a <- tk.typJ t
  dflt <- defaultF tk d
  pure (NamedImplicit sp x a dflt)
binderF tk (PiAnon d) = do
  a <- tk.typJ d
  pure (Anonymous a)

fieldDeclF : TK
           -> Params.Spanned
             (Presyntax.FieldDecl Presyntax.TypeForm Presyntax.Checkable)
           -> Elab Rules.FieldDeclaration
fieldDeclF tk (At (DeclareField x _ t d) _) = do
  a <- tk.typJ t
  dflt <- defaultF tk d
  pure { name = x, typ = a, dflt = dflt }
fieldDeclF tk (At (BadFieldDecl _) sp) =
  failP sp 1 "expected a field declaration of the form `x : A`"

fieldSetF : TK
          -> Params.Spanned (Presyntax.FieldSet Presyntax.Checkable)
          -> Elab Rules.FieldSetting
fieldSetF tk (At (SetField x xsp e) _) = do
  v <- recoveringChk (tk.chkJ e)
  pure { name = x, chk = v, span = Params.spanOf e, nameSpan = xsp }
fieldSetF tk (At (BadFieldSet _) sp) =
  failP sp 2 "expected a field setting of the form `x = v`"

traverseEL : {a b : Type} -> (a -> Elab b) -> List a -> Elab (List b)
traverseEL f Nil = pure Nil
traverseEL f (Cons x xs) = do
  y <- f x
  ys <- traverseEL f xs
  pure (Cons y ys)

smallF : TK -> Presyntax.TypeForm -> Elab Rules.SmallTyp
smallF tk t = do
  a <- tk.typJ t
  pure (Rules.asSmall (Params.spanOf t) a)

variantF : TK
         -> Params.Spanned (Presyntax.Variant Presyntax.TypeForm)
         -> Elab (Pair String (Array Rules.SmallTyp))
variantF tk (At (TagVariant x _ args) _) = do
  typs <- traverseEL (\m -> smallF tk m) args
  pure (MkPair x (Array.fromList typs))
variantF tk (At (BadVariant _) sp) =
  unexpectedNotation sp "variant in a sum type"

patName : Presyntax.Pat -> Elab String
patName (At (PatVar x) _) = pure x
patName p =
  failP
    (Params.spanOf p)
    3
    "an argument of a `case` pattern is a pattern or a name"

doPat : Presyntax.Pat -> Elab (Pair String (List String))
doPat p = case (Presyntax.patSpineOf p).head of
  At (PatTag x _ _) _ -> do
    xs <- traverseEL (\q -> patName q) (Presyntax.patSpineOf p).args
    pure (MkPair x xs)
  -- extension: `_ => e` handles every tag not listed (a name for the
  -- whole value is not flat: it is the match tree's)
  At (PatVar "_") sp -> pure (MkPair "_" Nil)
  _ ->
    failP
      (Params.spanOf p)
      3
      "a `case` pattern is a pattern: a tag applied to patterns, a literal, or `_`"

doCase : TK
       -> Params.Spanned (Presyntax.Alt Presyntax.Checkable)
       -> Elab (Pair String (Pair (Array String) Rules.Chk))
doCase tk (At (MkAlt p body) _) = do
  px <- doPat p
  case px of
    MkPair x xs -> do
      b <- recoveringChk (tk.chkJ body)
      pure (MkPair x (MkPair (Array.fromList xs) b))

allL : {a : Type} -> (a -> Bool) -> List a -> Bool
allL p Nil = True
allL p (Cons x xs) = p x && allL p xs

isData : Presyntax.Checkable -> Bool
isData (At (CTag _ _ _) _) = True
isData (At (CStruct _) _) = True
isData c = False

-- | `(e : T)`, `e` a tag or a record: in the core it is `e`, which does
-- | not say its type
annotatesData : Presyntax.Inferable -> Bool
annotatesData (At (IAnn c _) _) = isData c
annotatesData _ = False

isVarP : Presyntax.Pat -> Bool
isVarP (At (PatVar _) _) = True
isVarP _ = False

flatPat : Presyntax.PatSpine -> Bool
flatPat gr = case Params.nodeOf gr.head of
  PatTag _ _ _ -> allL isVarP gr.args
  PatVar x -> strEq x "_" && List.length gr.args == 0
  _ -> False

-- | flat: a tag applied to names, or `_`; anything else goes through the
-- | match-tree compiler
flatCaseAlt : Params.Spanned (Presyntax.Alt Presyntax.Checkable) -> Bool
flatCaseAlt (At (MkAlt p _) _) = flatPat (Presyntax.patSpineOf p)

tagSpanOf : Presyntax.Pat
          -> List (Pair String Params.Span)
          -> List (Pair String Params.Span)
tagSpanOf p acc = case (Presyntax.patSpineOf p).head of
  At (PatTag x _ _) tsp -> Cons (MkPair x tsp) acc
  _ -> acc

tagSpans : List (Params.Spanned (Presyntax.Alt Presyntax.Checkable))
         -> List (Pair String Params.Span)
tagSpans Nil = Nil
tagSpans (Cons (At (MkAlt p _) _) rest) = tagSpanOf p (tagSpans rest)

-- Operators in patterns
--------------------------------------------------------------------------------

-- | the lambdas a body opens with, and what is under them (and under
-- | its mark of case D)
lamsOf : Int -> Syntax.Tm -> Pair Int Syntax.Tm
lamsOf n (SLam _ (MkAbs _ b)) = lamsOf (n + 1) b
lamsOf n (SLam _ (AbsConst b)) = lamsOf (n + 1) b
lamsOf n (SIs b) = lamsOf n b
lamsOf n b = MkPair n b

absBody : Syntax.Abs Syntax.Ty -> Syntax.Ty
absBody (MkAbs _ t) = t
absBody (AbsConst t) = t

-- | a function type's implicit parameters, then its explicit ones: how
-- | many of each (`Nothing` if they are mixed otherwise)
paramsOf : Int -> Int -> Syntax.Ty -> Maybe (Pair Int Int)
paramsOf i e (SFunction _ _ cod Impl _) =
  if e > 0 then Nothing else paramsOf (i + 1) e (absBody cod)
paramsOf i e (SFunction _ _ cod Expl _) = paramsOf i (e + 1) (absBody cod)
paramsOf i e (SFunction _ _ _ Inst _) = Nothing
paramsOf i e _ = Just (MkPair i e)

-- | the arguments are the variables of the last `k` lambdas, in order
paramsInOrder : Int -> Int -> List Syntax.Tm -> Bool
paramsInOrder k i Nil = i == k
paramsInOrder k i (Cons (SLocal j) rest) =
  j == k - 1 - i && paramsInOrder k (i + 1) rest
paramsInOrder k i _ = False

-- | `(op) x y = C x y`: the tag an operator is another name for, and how
-- | many arguments it takes
tagSynonym : Globals.Entry -> Maybe (Pair String Int)
tagSynonym ge = case paramsOf 0 0 ge.tySyntax of
  Just (MkPair i k) -> case lamsOf 0 ge.syntax of
    MkPair n (STag t args) ->
      if n == i + k && paramsInOrder k 0 (Array.toList args)
        then Just (MkPair t k)
      else Nothing
    _ -> Nothing
  Nothing -> Nothing

notTagSynonym : {a : Type} -> String -> Params.Span -> Elab a
notTagSynonym x sp =
  failP
    sp
    3
    ("`"
     ^ x
     ^ "` is not another name for a tag, so no pattern can use it: an operator in a pattern is defined as one, `("
     ^ x
     ^ ") x y = C x y`")

-- | an operator applied, `x :: xs`, in a pattern
hasOpPat : Presyntax.Pat -> Bool
hasOpPat (At (PatOp _ _ _) _) = True
hasOpPat (At (PatRecord fs) _) =
  not
    (allL
       (\f -> case f of
        MkFieldPat _ q -> not (hasOpPat q))
       fs)
hasOpPat (At (PatTag _ _ ps) _) = not (allL (\m -> not (hasOpPat m)) ps)
hasOpPat (At (PatAs _ _ q) _) = hasOpPat q
hasOpPat p = False

-- | (`opPat`, the knot) `x = p`, a field of a record pattern
opField : (Presyntax.Pat -> Elab Presyntax.Pat)
        -> Presyntax.FieldPat Presyntax.Pat
        -> Elab (Presyntax.FieldPat Presyntax.Pat)
opField op (MkFieldPat x p) = do
  p' <- op p
  pure (MkFieldPat x p')

-- | a pattern, its operators as the tags they are other names for
opPat : Globals.Globals -> Presyntax.Pat -> Elab Presyntax.Pat
opPat g (At (PatOp x xsp args) _) = case Globals.lookupKey g x of
  Just (MkPair _ ge) -> case tagSynonym ge of
    Just (MkPair t k) ->
      if k == List.length args
        then do
          args' <- traverseEL (\m -> opPat g m) args
          pure (Presyntax.patTag t xsp args')
      else notTagSynonym x xsp
    Nothing -> notTagSynonym x xsp
  Nothing -> failP xsp 3 ("no such operator " ^ x ^ " in scope")
opPat g (At (PatRecord fs) sp) = do
  fs' <- traverseEL (\m -> opField (\q -> opPat g q) m) fs
  pure (At (PatRecord fs') sp)
opPat g (At (PatTag t tsp args) _) = do
  args' <- traverseEL (\m -> opPat g m) args
  pure (Presyntax.patTag t tsp args')
opPat g (At (PatAs x xsp q) sp) = do
  q' <- opPat g q
  pure (At (PatAs x xsp q') sp)
opPat g p = pure p

altHasOp : Params.Spanned (Presyntax.Alt Presyntax.Checkable) -> Bool
altHasOp (At (MkAlt p _) _) = hasOpPat p

opAlt : Globals.Globals
      -> Params.Spanned (Presyntax.Alt Presyntax.Checkable)
      -> Elab (Params.Spanned (Presyntax.Alt Presyntax.Checkable))
opAlt g (At (MkAlt p body) sp) = do
  p' <- opPat g p
  pure (At (MkAlt p' body) sp)

eqnHasOp : Params.Spanned (Presyntax.Equation Presyntax.Checkable) -> Bool
eqnHasOp (At (MkEquation _ _ ps _) _) = not (allL (\m -> not (hasOpPat m)) ps)

opEquation : Globals.Globals
           -> Params.Spanned (Presyntax.Equation Presyntax.Checkable)
           -> Elab (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
opEquation g (At (MkEquation f fsp ps rhs) sp) = do
  ps' <- traverseEL (\m -> opPat g m) ps
  pure (At (MkEquation f fsp ps' rhs) sp)

-- | a local definition's body: its equations, as a match
localEqs : TK
         -> String
         -> List (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
         -> Params.Span
         -> Elab Rules.Chk
localEqs tk f eqs sp = case Clauses.desugar f Nil eqs sp of
  Left err -> failP err.span 10 err.msg
  Right b -> tk.chkJ b

-- (an operator in a pattern is found where the globals are in hand)
localBody : TK
          -> String
          -> List (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
          -> Params.Span
          -> Elab Rules.Chk
localBody tk f eqs sp =
  if not (allL (\m -> not (eqnHasOp m)) eqs)
    then pure
        (MkChk (\e a -> do
         eqs' <- traverseEL (\m -> opEquation e.globals m) eqs
         j <- localEqs tk f eqs' sp
         Rules.runChk j e a))
  else localEqs tk f eqs sp

-- | extension: an equation's `where`: each local definition, `f : T` by
-- | its equations, in scope in those after it and in the equation's body
localsJ : TK
        -> List Presyntax.Declaration
        -> Presyntax.Checkable
        -> Elab Rules.Chk
localsJ tk Nil body = tk.chkJ body
localsJ tk (d :: ds) body = case Params.nodeOf d of
  DeclEquations name _ _ tyN eqs -> do
    ty <- tk.typJ tyN
    b <- localBody tk name eqs (Params.spanOf d)
    rest <- localsJ tk ds body
    pure (Rules.localDef name ty b rest)
  _ -> unexpectedNotation (Params.spanOf d) "local definition"

-- | `x.y = v` in an update: `x`'s setting
updatePath : Params.Span
           -> List (Pair String Params.Span)
           -> Rules.Chk
           -> Elab Rules.UpdateField
updatePath sp (Cons (MkPair x xsp) Nil) c = pure (UpdateTo x xsp sp c)
updatePath sp (Cons (MkPair x xsp) rest) c = do
  f <- updatePath sp rest c
  pure (UpdateIn x xsp sp (Cons f Nil))
updatePath sp Nil c =
  failP sp 3 "an update sets a field by its name: `{ r | x = v }`"

updateFieldF : TK
             -> Params.Spanned (Presyntax.UpdateSet Presyntax.Checkable)
             -> Elab Rules.UpdateField
updateFieldF tk (At (SetPath path v) sp) = do
  c <- tk.chkJ v
  updatePath sp path c

-- (the names a setting has, which the name the record is bound to is
-- none of)
updateNames : Params.Spanned (Presyntax.UpdateSet Presyntax.Checkable)
            -> List String
updateNames (At (SetPath path v) _) = Clauses.identsOf v Nil

-- | a term that infers its type
infF : TK -> Presyntax.Inferable -> Elab Rules.Syn
-- Variable rule
infF tk (At (IVar x) sp) = pure (Rules.find sp x)
infF tk (At (IInt i) sp) = pure (Rules.numLitSyn sp (IntNum i))
infF tk (At (IFloat x) sp) = pure (Rules.numLitSyn sp (FracNum x))
infF tk (At (IString s) _) = pure (Rules.litString s)
infF tk (At (IBytes s) sp) = pure (Rules.litBytes sp s)
infF tk (At (IPrim p) sp) = pure (Rules.findPrim sp p)
infF tk (At (IRune c) _) = pure (Rules.litRune c)
infF tk (At (IApp h args) _) = do
  s0 <- tk.infJ h
  s <- elimAll tk (Params.spanOf h).start s0 args
  pure (s)
infF tk (At (IAnn n0 n1) _) = do
  cc <- tk.chkJ n0
  t <- tk.typJ n1
  pure (Rules.annot t cc)
infF tk n@(At (ISpec n0 x _ v) _) = do
  cc <- tk.chkJ v
  s <- tk.infJ n0
  pure (Rules.recordSpec (Params.spanOf n) s x cc)
infF tk (At (IUpdate n0 fs) sp) = do
  s <- tk.infJ n0
  fs' <- traverseEL (\m -> updateFieldF tk m) fs
  pure
      (Rules.recordUpdate
         sp
         s
         (Clauses.fresh (List.concatMap updateNames fs) "r")
         fs')
-- extension: `\(x : T) -> e` annotates the binder
infF tk (At (IAnnLam x _ tyN body) _) = do
  dom <- tk.typJ tyN
  b <- tk.infJ body
  pure (Rules.functionIntroSyn x dom b)
infF tk (At (IInvalid code why Nothing) sp) = failP sp code why
infF tk (At (IInvalid code why (Just note)) sp) = failNoteP sp code why note
infF tk (At (INominal i) _) = do
  s <- tk.infJ i
  pure (nominalSyn s)
infF tk (At (ILitEq x xsp eq lit) sp) = do
  j <- tk.chkJ lit
  pure (Rules.litEq sp x xsp eq j)

-- | a term checked against a type, as written (no implicit lambdas
-- | around it)
rawF : TK -> Presyntax.Checkable -> Elab Rules.Chk
-- Introduction rules
rawF tk n@(At (CLam x _ body) _) = do
  b <- recoveringChk (tk.chkJ body)
  pure (Rules.functionIntro (Params.spanOf n) x b)
-- extension: `\(x : T) -> e` annotates the binder
rawF tk n@(At (CAnnLam x _ tyN body) _) = do
  dom <- tk.typJ tyN
  b <- tk.chkJ body
  pure (Rules.functionIntroAnn (Params.spanOf n) x dom b)
-- extension: `{x} => e` names an implicit argument
rawF tk n@(At (CImplicitLam x _ body) _) = do
  b <- recoveringChk (tk.chkJ body)
  pure (Rules.functionIntroImplicit (Params.spanOf n) x b)
rawF tk n@(At (CTag x tsp args) _) = do
  as <- traverseEL (\m -> argumentF tk m) args
  pure (Rules.sumIntro (Params.spanOf n) tsp x as)
rawF tk (At (CStruct fields) sp) = do
  fieldSettings <- traverseEL (\m -> fieldSetF tk m) fields
  pure (Rules.recordIntro sp fieldSettings)
rawF tk (At (CMatch scrutN casesN) sp) =
  -- (an operator in a pattern is found where the globals are in hand)
  if not (allL (\m -> not (altHasOp m)) casesN)
    then pure
        (MkChk (\e a -> do
         casesN' <- traverseEL (\m -> opAlt e.globals m) casesN
         j <- tk.chkJ (At (CMatch scrutN casesN') sp)
         Rules.runChk j e a))
  -- (a scrutinee `(e : T)`, `e` a tag or a record, is `e` in the core,
  -- which does not say its type there: it is bound to a name, below)
  else if allL flatCaseAlt casesN && not (annotatesData scrutN)
    then do
      scrut <- tk.infJ scrutN
      cases <- traverseEL (\m -> doCase tk m) casesN
      pure (Rules.sumElim sp scrut (tagSpans casesN) (Dict.fromList cases))
  -- extension: nested patterns, literals, a name for the whole value,
  -- compiled into the flat matches above, on a name for the scrutinee,
  -- bound once
  else do
    case Clauses.caseTree sp casesN of
      Left err -> failP err.span 3 err.msg
      Right r -> do
        scrut <- tk.infJ scrutN
        body <- tk.chkJ r.tree
        pure (Rules.caseLet r.scrutinee scrut body)
-- extension: `let x = e in e'`, `e` inferring (`let x : T = e` if it
-- does not), bound once by a beta-redex; `let p = e in e'`, a `case` of
-- one alternative, which must match every value
rawF tk (At (CLetIn rhsN alt0) sp) = case alt0 of
  At (MkAlt (At (PatVar x) _) bodyN) _ -> do
    rhs <- tk.infJ rhsN
    body <- recoveringChk (tk.chkJ bodyN)
    pure (Rules.caseLet x rhs body)
  _ -> tk.rawJ (At (CMatch rhsN (Cons alt0 Nil)) sp)
-- extension: an equation's body and its local definitions (`where`)
rawF tk (At (CLocal bodyN defs) sp) = do
  localsJ tk defs bodyN
rawF tk (At CAbandon sp) = pure (Rules.abandonChk sp)
rawF tk (At (CNominal c) _) = do
  j <- tk.rawJ c
  pure (nominalChk j)
rawF tk n = tk.chkJ n

chkHeadOf : Presyntax.Inferable -> Rules.Syn -> Rules.Chk
chkHeadOf n j = case (Presyntax.infSpineOf (Presyntax.unNominal n)).head of
  At (IVar x) _ ->
    Rules.autoRec (Params.spanOf n) x (Rules.apply (Params.spanOf n) j)
  _ -> Rules.apply (Params.spanOf n) j

-- | a number literal, which the type it is checked at decides
literalOf : Presyntax.Inferable -> Maybe Rules.NumLit
literalOf (At (IInt k) _) = Just (IntNum k)
literalOf (At (IFloat x) _) = Just (FracNum x)
literalOf _ = Nothing

nominalInf : Presyntax.Inferable -> Bool
nominalInf (At (INominal _) _) = True
nominalInf _ = False

-- | a term that infers its type, checked against one: a literal by that
-- | type (`5` at `Int32` is an `Int32`), any other by its own
chkInf : TK -> Presyntax.Inferable -> Elab Rules.Chk
chkInf tk i = case literalOf (Presyntax.unNominal i) of
  Just lit ->
    pure
      (Rules.implicitLams
         (if nominalInf i
            then nominalChk (Rules.numLitChk (Params.spanOf i) lit)
          else Rules.numLitChk (Params.spanOf i) lit))
  Nothing -> do
    s <- tk.infJ i
    pure (Rules.implicitLams (chkHeadOf i s))

-- | a type as a term, of a universe: a record type too large for it says
-- | which field is
typeChk : TK -> Params.Span -> Presyntax.TypeForm -> Elab Rules.Chk
typeChk tk sp (At (TSig fields) _) = do
  fieldDecls <- traverseEL (\m -> fieldDeclF tk m) fields
  pure (Rules.recordTypeIntro sp fieldDecls)
typeChk tk sp t = do
  a <- tk.typJ t
  pure (Rules.universeIntro sp a)

-- | a term checked against a type, the implicit lambdas around it
-- | inserted (`{x} => e` binds the implicit argument itself)
chkF : TK -> Presyntax.Checkable -> Elab Rules.Chk
chkF tk (At (CInf i) _) = chkInf tk i
chkF tk (At (CType t) sp) = typeChk tk sp t
chkF tk n = do
  j <- tk.rawJ n
  pure (if implicitLambda n then j else Rules.implicitLams j)

typF : TK -> Presyntax.TypeForm -> Elab Rules.Typ
typF tk (At (TPi b codN) _) = do
  dom <- binderF tk b
  cod <- tk.typJ codN
  pure (Rules.functionFormation dom cod)
typF tk (At (TSig fields) sp) = do
  fieldDecls <- traverseEL (\m -> fieldDeclF tk m) fields
  pure (Rules.recordFormation fieldDecls)
typF tk (At (TSum variantNs) sp) = do
  variants <- traverseEL (\m -> variantF tk m) variantNs
  pure (Rules.sumFormation (Dict.fromList variants))
typF tk (At TType _) = pure (Rules.universeFormation SmallU)
typF tk (At TInt _) = pure (Rules.primInt)
typF tk (At TFloat _) = pure (Rules.primFloat)
typF tk (At TString _) = pure (Rules.primString)
typF tk (At TRune _) = pure (Rules.primRune)
typF tk (At (TFixed w) _) = pure (Rules.primFixed w)
typF tk (At (TArray a0) _) = do
  a <- tk.typJ a0
  pure (Rules.primArray a)
typF tk (At (TInf i) sp) = do
  s <- tk.infJ i
  pure (Rules.universeElimSyn sp s)
typF tk (At (TChk ch) _) = do
  j <- tk.rawJ ch
  pure (Rules.universeElim LargeU j)
typF tk (At (TNominal t) _) = do
  a <- tk.typJ t
  pure (nominalTyp a)

tk : TK
tk =
  { infJ = \n -> infF tk n
  , chkJ = \n -> chkF tk n
  , rawJ = \n -> rawF tk n
  , typJ = \n -> typF tk n
  }

-- Declarations
--------------------------------------------------------------------------------

type ArgBinding =
  { span : Params.Span
  , name : String
  , typ : Rules.Typ
  , implicit : Params.Plicity
  }

mkArgBinding : Params.Span
             -> String
             -> Rules.Typ
             -> Params.Plicity
             -> ArgBinding
mkArgBinding span name typ implicit =
  { span = span, name = name, typ = typ, implicit = implicit }

argBinding : Params.Spanned (Presyntax.Param Presyntax.TypeForm)
           -> Elab ArgBinding
argBinding (At (ExplicitParam x _ t) sp) = do
  a <- tk.typJ (Presyntax.markType N t)
  pure (mkArgBinding sp x a Expl)
argBinding (At (ImplicitParam x _ t) sp) = do
  a <- tk.typJ (Presyntax.markType N t)
  pure (mkArgBinding sp x a Impl)

withOne : ArgBinding -> Pair Rules.Typ Rules.Chk -> Pair Rules.Typ Rules.Chk
withOne ab@{ implicit = Impl } (MkPair t c) =
  MkPair
    (Rules.functionFormation (NamedImplicit ab.span ab.name ab.typ Nothing) t)
    (Rules.functionIntroImplicit ab.span ab.name c)
withOne ab@{ implicit = Inst } (MkPair t c) =
  MkPair
    (Rules.functionFormation (NamedInstance ab.span ab.name ab.typ) t)
    (Rules.functionIntroImplicit ab.span ab.name c)
withOne ab@{ implicit = Expl } (MkPair t c) =
  MkPair
    (Rules.functionFormation (Named ab.name ab.typ) t)
    (Rules.functionIntro ab.span ab.name c)

withArgs : List ArgBinding
         -> Pair Rules.Typ Rules.Chk
         -> Pair Rules.Typ Rules.Chk
withArgs Nil base = base
withArgs (Cons ab rest) base = withOne ab (withArgs rest base)

type DeclJ = { name : String, ty : Rules.Typ, tm : Rules.Chk, prim : Bool }

mkDeclJ : String -> Rules.Typ -> Rules.Chk -> Bool -> DeclJ
mkDeclJ name ty tm prim = { name = name, ty = ty, tm = tm, prim = prim }

declOfParts : String -> Pair Rules.Typ Rules.Chk -> Bool -> Elab DeclJ
declOfParts name (MkPair ty tm) prim = pure (mkDeclJ name ty tm prim)

-- | `theory T a where` and its fields
theoryD : String
        -> List (Params.Spanned (Presyntax.Param Presyntax.TypeForm))
        -> Presyntax.Checkable
        -> Elab DeclJ
theoryD name params bodyN = do
  args <- traverseEL (\m -> argBinding m) params
  body <- tk.chkJ (Presyntax.markTerm De bodyN)
  declOfParts
      name
      (withArgs args (MkPair (MkTyp (\e -> pure (Memoed.univ LargeU))) body))
      False

explicitNames : List ArgBinding -> List String
explicitNames Nil = Nil
explicitNames (Cons ab rest) =
  if not (Params.eqPlicity ab.implicit Expl) then explicitNames rest
  else Cons ab.name (explicitNames rest)

-- | `data T a = ...`, `type T a = ...`: a definition with named
-- | arguments, its type and its body
defineD : String
        -> List (Params.Spanned (Presyntax.Param Presyntax.TypeForm))
        -> Presyntax.TypeForm
        -> Presyntax.Checkable
        -> Elab DeclJ
defineD name params tyN bodyN = do
  args <- traverseEL (\m -> argBinding m) params
  returnTyp <- tk.typJ (Presyntax.markType N tyN)
  body <- tk.chkJ (Presyntax.markTerm De bodyN)
  declOfParts name (withArgs args (MkPair returnTyp body)) False

equationsBody : String
              -> List ArgBinding
              -> List (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
              -> Params.Span
              -> Elab Rules.Chk
equationsBody name args eqs sp = do
  bodyN <- case Clauses.desugar name (explicitNames args) eqs sp of
    Left err -> failP err.span 10 err.msg
    Right b -> pure b
  -- (in descriptive position as the clause compiler made it)
  tk.chkJ (Presyntax.markTerm De bodyN)

-- | a definition by equations, `f : T` and `f p ... = e`; `sp`, from the
-- | type to the last equation
equationsD : String
           -> Presyntax.TypeForm
           -> List (Params.Spanned (Presyntax.Equation Presyntax.Checkable))
           -> Params.Span
           -> Elab DeclJ
equationsD name tyN eqs sp = do
  body <-
    if not (allL (\m -> not (eqnHasOp m)) eqs)
      then pure
          (MkChk (\e a -> do
           eqs' <- traverseEL (\m -> opEquation e.globals m) eqs
           j <- equationsBody name Nil eqs' sp
           Rules.runChk j e a))
    else equationsBody name Nil eqs sp
  returnTyp <- tk.typJ (Presyntax.markType N tyN)
  declOfParts name (withArgs Nil (MkPair returnTyp body)) False

declJ : Presyntax.Declaration -> Elab DeclJ
declJ (At (DeclTheory name _ params bodyN) _) = theoryD name params bodyN
declJ (At (DeclDefine name _ params tyN bodyN) _) =
  defineD name params tyN bodyN
declJ d@(At (DeclEquations name _ _ tyN eqs) _) =
  equationsD
    name
    tyN
    eqs
    { start = (Params.spanOf tyN).start, end = (Params.spanOf d).end }
-- extension: `primitive name : T`, implemented by the runtime
declJ (At (DeclPrimitive x _ tyN) _) = do
  ty <- tk.typJ (Presyntax.markType N tyN)
  pure
      (mkDeclJ
         x
         ty
         (MkChk (\e a -> pure { stx = SPrim x, val = \u -> Nom VOpaque }))
         True)
declJ d = unexpectedNotation (Params.spanOf d) "top-level declaration"

-- Elaborating one declaration
--------------------------------------------------------------------------------

-- | fail, if errors were recovered from (they are reported, this is not)
recoveredCheck : Elab Unit
recoveredCheck = do
  ds <- gets (\c -> c.recovered)
  if List.length ds == 0 then pure MkUnit
    else failElsewhere Params.noSpan "errors recovered from"

anyL : {a : Type} -> (a -> Bool) -> List a -> Bool
anyL p Nil = False
anyL p (Cons x xs) = p x || anyL p xs

unsolvedPoisoned : Value.MetaCtx -> Int -> Bool
unsolvedPoisoned mc m = case Map.lookup compareInt m mc of
  Just me -> case me.sol of
    Just _ -> False
    Nothing -> True
  Nothing -> False

-- | fail, unreported, if an implicit argument is left that an error hole
-- | kept from being inferred
poisonedLeft : Elab Unit
poisonedLeft = do
  ps <- gets (\c -> c.poisoned)
  mc <- gets (\c -> c.metas)
  if anyL (\m -> unsolvedPoisoned mc m) (Map.keys ps)
      then failElsewhere
          Params.noSpan
          "an implicit argument an error kept from being inferred"
    else pure MkUnit

appendM : {a : Type} -> List a -> List a -> List a
appendM Nil ys = ys
appendM (Cons x xs) ys = Cons x (appendM xs ys)

concatMapM : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapM f Nil = Nil
concatMapM f (Cons x xs) = appendM (f x) (concatMapM f xs)

spineVals : Value.Spine Value.V -> List Value.V
spineVals SpId = Nil
spineVals (SpApp sp e) = appendM (spineVals sp) (Cons e Nil)
spineVals (SpProj sp _) = spineVals sp
spineVals (SpSpec sp _ e) = appendM (spineVals sp) (Cons e Nil)

headMeta : Value.Head -> List Int
headMeta (HMeta m) = Cons m Nil
headMeta _ = Nil

-- | the metavariables not yet solved in a value: at its head, or in
-- | its spine's arguments
metasInV : Value.MetaCtx -> Value.V -> List Int
metasInV mc v = case Value.forceEl mc v of
  VNeu h sp ty expansion desc ->
    appendM (headMeta h) (concatMapM (\v2 -> metasInV mc v2) (spineVals sp))
  _ -> Nil

nubInt : List Int -> List Int
nubInt Nil = Nil
nubInt (Cons x xs) = Cons x (nubInt (List.filter (\y -> not (y == x)) xs))

shownV : Globals.Globals
       -> Value.MetaCtx
       -> Params.CtxShape
       -> Value.V
       -> String
shownV g mc cs v =
  SurfacePrint.printEl
    SurfacePrint.plainImplicits
    0
    cs.names
    (Rename.renameEl
       (Rename.displayName g)
       (Readback.readbEl cs.len (Value.forceEl mc v)))

aboutMeta : Value.MetaCtx -> Postponed -> Maybe Value.MetaEntry
aboutMeta mc p = case List.head
    (nubInt (appendM (metasInV mc p.left) (metasInV mc p.right))) of
  Just m -> Map.lookup compareInt m mc
  Nothing -> Nothing

-- a problem that was retried and found contradictory: not missing
-- information, a mismatch -- say so, where the implicit was asked for
stuckWith : Params.Span
          -> Postponed
          -> Maybe Value.MetaEntry
          -> String
          -> String
          -> Diag
stuckWith fallback p about left right =
  if p.failed
    then { code = 311
         , severity = SError
         , msg =
             "the implicit arguments found do not fit together: "
             ^ left
             ^ " and "
             ^ right
             ^ " are not equal"
         , span =
             (case about of
              Just me -> me.span
              Nothing -> fallback)
         , note =
             (case about of
              Just me ->
                Just
                  ("found for `"
                   ^ me.name
                   ^ "`, it would need "
                   ^ left
                   ^ " = "
                   ^ right)
              Nothing -> Nothing)
         }
  else case about of
    Just me ->
      { code = 327
      , severity = SError
      , msg =
          "cannot infer the implicit argument `"
          ^ me.name
          ^ "`: give it, `("
          ^ me.name
          ^ " := ...)`"
      , span = me.span
      , note =
          Just
            ("what is known of it, "
             ^ left
             ^ " = "
             ^ right
             ^ ", does not say what it is")
      }
    Nothing ->
      { code = 327
      , severity = SError
      , msg =
          "cannot infer an implicit argument: "
          ^ left
          ^ " = "
          ^ right
          ^ " does not say what it is"
      , span = fallback
      , note = Nothing
      }

stuckAt : Globals.Globals -> Params.Span -> Postponed -> Value.MetaCtx -> Diag
stuckAt g fallback p mc =
  stuckWith
    fallback
    p
    (aboutMeta mc p)
    (shownV g mc p.shape p.left)
    (shownV g mc p.shape p.right)

stuckDiag : Globals.Globals -> Params.Span -> Postponed -> Elab Diag
stuckDiag g fallback p = do
  mc <- gets (\c -> c.metas)
  pure (stuckAt g fallback p mc)

-- | a declaration elaborated: what it defines, under which key, whether
-- | it is a primitive or an instance, its entry, and why its body did not
-- | elaborate, if it did not
type Elaborated =
  { name : String
  , key : String
  , prim : Bool
  , isInstance : Bool
  , entry : Globals.Entry
  , failed : Maybe Diag
  }

mkElaborated : String
             -> String
             -> Bool
             -> Bool
             -> Globals.Entry
             -> Maybe Diag
             -> Elaborated
mkElaborated name key prim isInstance entry failed =
  { name = name
  , key = key
  , prim = prim
  , isInstance = isInstance
  , entry = entry
  , failed = failed
  }

-- | the entry a definition is stored as, from its core syntax alone
entryFor : Globals.Globals
         -> String
         -> Bool
         -> Syntax.Ty
         -> Syntax.Tm
         -> Globals.Entry
entryFor g k prim tyStx bodyStx =
  { syntax = bodyStx
  , tySyntax = tyStx
  , value =
      if prim then Top.primValueOf g k tyStx else Top.valueOf g k tyStx bodyStx
  , type_ = Top.typeOf g tyStx
  }

errEntry : Globals.Globals -> String -> Syntax.Ty -> Globals.Entry
errEntry g k tyStx =
  { syntax = SAbandon
  , tySyntax = tyStx
  , value = Value.errorHole (Top.typeOf g tyStx)
  , type_ = Top.typeOf g tyStx
  }

checkStuck : Globals.Globals -> Params.Span -> List Postponed -> Elab Unit
checkStuck g sp Nil = pure MkUnit
checkStuck g sp (Cons p rest) = do
  d <- stuckDiag g sp p
  throwE (a := Unit) d

checkUnsolved : List Meta.Unsolved -> Elab Unit
checkUnsolved Nil = pure MkUnit
checkUnsolved (Cons u rest) =
  throwE
    { code = 328
    , severity = SError
    , msg =
        "cannot infer the implicit argument `"
        ^ u.name
        ^ "`; give it as `{...}`"
    , span = u.span
    , note = Nothing
    }

withSelf : ElabEnv -> String -> Scope -> ElabEnv
withSelf e k sc =
  { scope = sc
  , globals = e.globals
  , elabFor = e.elabFor
  , lams = e.lams
  , self = Just k
  , insts = e.insts
  }

-- | the definition mentions itself as the global it will be; pattern
-- | unification knows it by its key
bodyEnv : Globals.Globals -> String -> String -> Value.Ty -> ElabEnv
bodyEnv gSelf k name aval =
  withSelf
    (emptyElabEnvFor gSelf k)
    k
    (letAt
       (BDelayedBy 1)
       name
       (Value.reflect (HGlobal k) (\u -> SpId) (\u -> aval) Nothing)
       aval
       (emptyElabEnvFor gSelf k).scope)

-- (a failure, reported where it comes from: no diagnostic's code)
elsewhereD : Diag -> Diag
elsewhereD d =
  { code = 0 - 1
  , severity = d.severity
  , msg = d.msg
  , span = d.span
  , note = d.note
  }

-- (a body checked at a type that did not elaborate fails of that, not of
-- its own: its error is reported where the type is)
failedAt : Value.Ty -> Diag -> Elab Memoed.El
failedAt aval d = do
  blocked <- Meta.blockedTy aval
  throwE (if blocked then elsewhereD d else d)

-- | the whole body phase: checked, settled, zonk-ready
bodyPhase : Params.Span
          -> DeclJ
          -> Globals.Globals
          -> String
          -> Value.Ty
          -> Elab Memoed.El
bodyPhase dsp d gSelf k aval = do
  t <-
    catchE
      (Rules.runChk d.tm (bodyEnv gSelf k d.name aval) aval)
      (failedAt aval)
  -- the implicit arguments: every one inferred, and substituted in
  stuck <- Meta.settle gSelf
  recoveredCheck
  poisonedLeft
  checkStuck gSelf dsp stuck
  unsolved <- Meta.unsolvedMetas
  checkUnsolved unsolved
  pure t

keyOf : (String -> String) -> DeclJ -> String
keyOf key d = if d.prim then d.name else key d.name

elabOut : (String -> String)
        -> Globals.Globals
        -> DeclJ
        -> Bool
        -> Syntax.Ty
        -> Value.MetaCtx
        -> Either Diag Memoed.El
        -> Elab Elaborated
elabOut key g d isInstance tyStx mc (Left failed) =
  pure
    (mkElaborated
       d.name
       (keyOf key d)
       d.prim
       isInstance
       (errEntry g (keyOf key d) tyStx)
       (Just failed))
elabOut key g d isInstance tyStx mc (Right t) =
  pure
    (mkElaborated
       d.name
       (keyOf key d)
       d.prim
       isInstance
       (entryFor
          g
          (keyOf key d)
          d.prim
          tyStx
          (selfAsLocal (keyOf key d) (Unify.zonkEl mc t.stx)))
       Nothing)

primNames : List String
primNames = List.map (\(p : Pair String Prims.PrimImpl) -> fst p) Prims.prims

-- (those said when one is not there: the fixed-width types' go without
-- saying, by the rule that names them)
basicPrimNames : List String
basicPrimNames =
  List.map (\(p : Pair String Prims.PrimImpl) -> fst p) Prims.basicPrims

-- | a primitive is one the runtime has
primKnown : Params.Span -> DeclJ -> Elab Unit
primKnown sp d =
  if d.prim && not (List.elemBy strEq d.name primNames)
    then failWith
        (a := Unit)
        sp
        29
        ("there is no primitive called `"
         ^ d.name
         ^ "` (the runtime has: "
         ^ joinWith ", " basicPrimNames
         ^ ", and each fixed-width type's, `int32Add` and the like)")
  else pure MkUnit

-- | where an instance's type is written, of a declaration that declares
-- | one (`instance f : T`)
instanceTypeAt : Presyntax.Declaration -> Maybe Params.Span
instanceTypeAt (At (DeclEquations _ _ AsInstance tyN _) _) =
  Just (Params.spanOf tyN)
instanceTypeAt _ = Nothing

-- | whether a declaration declares an instance
declaresInstance : Presyntax.Declaration -> Bool
declaresInstance n = case instanceTypeAt n of
  Just _ -> True
  Nothing -> False

-- | an implicit argument of an instance, by its name, and how many
-- | binders are outside it
type ImplicitBound = { name : String, level : Int }

-- (an implicit argument the instance is of no type by: a search, which
-- solves it by unifying what the instance is an instance of with the
-- type wanted, could not)
unsolvedImplicit : Params.Span -> String -> Elab Unit
unsolvedImplicit sp x =
  failWithNote
    sp
    50
    ("the instance's implicit argument `"
     ^ x
     ^ "` is not in what it is an instance of: a search, unifying that with the type wanted, cannot solve it")
    "use it in what the instance is an instance of (`{a : Type} -> {{e : Equality a}} -> Equality (List a)`), or leave it out"

-- | what the instance is an instance of mentions each of its implicit
-- | arguments, `depth` binders inside the outermost
everyImplicitIn : Params.Span
                -> Int
                -> Syntax.Ty
                -> List ImplicitBound
                -> Elab Unit
everyImplicitIn sp depth conclusion Nil = pure MkUnit
everyImplicitIn sp depth conclusion (Cons b rest) =
  if (Rules.mentionsLocal (depth - 1 - b.level)).ty 0 conclusion
    then everyImplicitIn sp depth conclusion rest
  else unsolvedImplicit sp b.name

-- | an instance's type takes implicit and instance arguments, if any,
-- | before what it is an instance of (`{a : Type} -> {{e : Equality a}} ->
-- | Equality (List a)`): a search solves the one by unification, finds the
-- | other, and gives no explicit one -- so each implicit argument is in
-- | what it is an instance of, for the unification to solve
searchedInstance : Params.Span
                 -> List ImplicitBound
                 -> Int
                 -> Syntax.Ty
                 -> Elab Unit
searchedInstance sp implicits depth (SFunction _ _ _ Expl _) =
  failWithNote
    sp
    48
    "an instance takes only implicit and instance arguments, `{x : A}` and `{{x : A}}`: a search gives it no explicit one"
    "make it implicit, solved where the instance is found (`{a : Type} -> {{e : Equality a}} -> Equality (List a)`), or declare a definition, no instance, and give it its arguments where it is used"
searchedInstance sp implicits depth (SFunction _ _ (MkAbs x cod) Impl _) =
  searchedInstance
    sp
    (Cons { name = x, level = depth } implicits)
    (depth + 1)
    (SurfacePrint.unIsTy cod)
searchedInstance sp implicits depth (SFunction _ _ (AbsConst cod) Impl _) =
  unsolvedImplicit sp "_"
searchedInstance sp implicits depth (SFunction _ _ (MkAbs x cod) _ _) =
  searchedInstance sp implicits (depth + 1) (SurfacePrint.unIsTy cod)
searchedInstance sp implicits depth (SFunction _ _ (AbsConst cod) _ _) =
  searchedInstance sp implicits depth (SurfacePrint.unIsTy cod)
searchedInstance sp implicits depth conclusion =
  everyImplicitIn sp depth conclusion (List.reverse implicits)

-- | an instance is of a type a search can find it by
instanceType : Maybe Params.Span -> Memoed.Ty -> Elab Unit
instanceType (Just sp) ty =
  searchedInstance sp Nil 0 (SurfacePrint.unIsTy ty.stx)
instanceType Nothing ty = pure MkUnit

elabBody : (String -> String)
         -> Globals.Globals
         -> Presyntax.Declaration
         -> DeclJ
         -> Memoed.Ty
         -> Elab Elaborated
elabBody key g n d a = do
  modify (setSelfKey (Just (keyOf key d)))
  body <-
    tryE
      (bodyPhase
         (Params.spanOf n)
         d
         (Globals.addEntry
            (keyOf key d)
            { syntax = SOpaque
            , tySyntax = a.stx
            , value =
                Value.reflect
                  (HGlobal (keyOf key d))
                  (\u -> SpId)
                  (\u -> Memoed.tyN a)
                  Nothing
            , type_ = Memoed.tyN a
            }
            g)
         (keyOf key d)
         (Memoed.tyN a))
  modify (setSelfKey Nothing)
  primKnown (Params.spanOf n) d
  mc <- gets (\c -> c.metas)
  elabOut key g d (declaresInstance n) (Unify.zonkTy mc a.stx) mc body

-- | Elaborate one declaration.  A definition whose type elaborates and
-- | whose body does not is a definition still, `failed`: an error hole
-- | of its type.
elabDecl : (String -> String)
         -> Globals.Globals
         -> Presyntax.Declaration
         -> Elab Elaborated
elabDecl key g n = do
  modify (setSelfKey Nothing)
  d <- declJ n
  a <- Rules.runTyp d.ty (emptyElabEnv g)
  -- (a type with an error hole is no type to give the definition)
  recoveredCheck
  instanceType (instanceTypeAt n) a
  elabBody key g n d a

watchSyn : Presyntax.Checkable -> Elab Rules.Syn
watchSyn (At (CInf i) _) = tk.infJ i
watchSyn w =
  failP
    (Params.spanOf w)
    0
    "a watch must say what type it has: write `>>> (e : T)`"

watchEntry : Globals.Globals
           -> Value.MetaCtx
           -> Memoed.El
           -> Value.Ty
           -> Globals.Entry
watchEntry g mc t ty =
  entryFor
    g
    "> watch"
    False
    (Unify.zonkTy mc (Readback.readbTy 0 (Value.forceTy mc ty)))
    (Unify.zonkEl mc t.stx)

watchPhase : Globals.Globals
           -> Params.Span
           -> Pair Memoed.El Value.Ty
           -> Elab Globals.Entry
watchPhase g sp (MkPair t ty) = do
  stuck <- Meta.settle g
  -- (what settling met that was recovered from, too)
  recoveredCheck
  poisonedLeft
  checkStuck g sp stuck
  unsolved <- Meta.unsolvedMetas
  checkUnsolved unsolved
  mc <- gets (\c -> c.metas)
  pure (watchEntry g mc t ty)

-- | a watch `-- >>> e`: elaborated as an anonymous definition, its
-- | entry kept aside (never among the globals)
elabWatch : Globals.Globals -> Presyntax.Checkable -> Elab Globals.Entry
elabWatch g n = do
  s <- watchSyn (Presyntax.markTerm N n)
  pr <- Rules.runSyn s (emptyElabEnv g)
  watchPhase g (Params.spanOf n) pr

-- The module
--------------------------------------------------------------------------------

type Watch = { span : Params.Span, entry : Globals.Entry }

mkWatch : Params.Span -> Globals.Entry -> Watch
mkWatch span entry = { span = span, entry = entry }

type TestDecl = { name : String, span : Params.Span }

-- | a module elaborated: its globals, what went wrong, what each
-- | definition is stored under and where it is; `broken`: the
-- | declarations that did not elaborate, not even their types (where
-- | each is); `infos` and `trace`: what elaboration found for the IDE,
-- | and its steps (for `heff explain`)
type TopResult =
  { globals : Globals.Globals
  , diags : List Diag
  , keys : List String
  , broken : List (Pair String Params.Span)
  , watches : List Watch
  , tests : List TestDecl
  , spans : List (Pair String Params.Span)
  , infos : List Info
  , trace : List TraceEvent
  }

mkTop : Globals.Globals
      -> List Diag
      -> List String
      -> List (Pair String Params.Span)
      -> List Watch
      -> List TestDecl
      -> List (Pair String Params.Span)
      -> List Info
      -> List TraceEvent
      -> TopResult
mkTop globals diags keys broken watches tests spans infos trace =
  { globals = globals
  , diags = diags
  , keys = keys
  , broken = broken
  , watches = watches
  , tests = tests
  , spans = spans
  , infos = infos
  , trace = trace
  }

appendT : {a : Type} -> List a -> List a -> List a
appendT Nil ys = ys
appendT (Cons x xs) ys = Cons x (appendT xs ys)

-- (a `failElsewhere` marker is reported where it comes from, not here)
reportedD : Diag -> List Diag
reportedD d = if reportedElsewhere d then Nil else Cons d Nil

concatMapT : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapT f Nil = Nil
concatMapT f (Cons x xs) = appendT (f x) (concatMapT f xs)

-- what a declaration's elaboration recovered from, kept: chronological
-- (the state holds them newest first)
recChron : ElabSt -> List Diag
recChron st = concatMapT reportedD (List.reverse (core st).recovered)

-- (the accumulator holds diagnostics newest first)
consAll : List Diag -> List Diag -> List Diag
consAll ds xs = List.foldl (\a x -> Cons x a) ds xs

failedList : Elaborated -> List Diag
failedList { failed = Just d } = reportedD d
failedList { failed = Nothing } = Nil

-- | the module a key is of, by the name it has there (`m.x`, `x`: `m`;
-- | a key that is its name, as an expectation's, of none)
keyModule : String -> String -> String
keyModule key name =
  if strEq key name then ""
  else strSlice key 0 (strLength key - strLength name - 1)

-- | a definition, an instance or not: one is a candidate for the
-- | instance arguments after it; a definition of the name again, as no
-- | instance, is none
withInstance : Bool -> String -> String -> Globals.Globals -> Globals.Globals
withInstance isInstance key name g =
  if isInstance then Globals.addInstance key (keyModule key name) g
  else if Globals.isInstance g key then Globals.dropInstance key g
  else g

-- | an instance declared that does not elaborate is in scope still, of
-- | no type: a search that finds no instance may have wanted it, and is
-- | no error of its own
withBrokenInstance : (String -> String)
                   -> Presyntax.Declaration
                   -> Globals.Globals
                   -> Globals.Globals
withBrokenInstance kf n g = case Presyntax.declName n of
  Just x ->
    if declaresInstance n then Globals.addInstance (kf x) (keyModule (kf x) x) g
    else g
  Nothing -> g

-- (not even its type: what uses it is not checked, and not refused)
topBroken : (String -> String)
          -> TopResult
          -> Presyntax.Declaration
          -> List Diag
          -> TopResult
topBroken kf acc n diags = case Presyntax.declName n of
  Just x ->
    mkTop
      (withBrokenInstance
         kf
         n
         (Globals.addBroken
            (kf x)
            (if strEq (kf x) x then acc.globals
             else Globals.addOwn x (kf x) acc.globals)))
      diags
      acc.keys
      (Cons (MkPair x (Params.spanOf n)) acc.broken)
      acc.watches
      acc.tests
      acc.spans
      acc.infos
      acc.trace
  Nothing ->
    mkTop
      acc.globals
      diags
      acc.keys
      acc.broken
      acc.watches
      acc.tests
      acc.spans
      acc.infos
      acc.trace

-- (what a declaration's elaboration found for the IDE, and its steps,
-- kept: the state and the accumulator both hold them newest first)
keepSt : ElabSt -> TopResult -> TopResult
keepSt st acc =
  mkTop
    acc.globals
    acc.diags
    acc.keys
    acc.broken
    acc.watches
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

-- (a definition under the key `k` itself, not one `k` is a name of)
knownEntry : Globals.Globals -> String -> Bool
knownEntry g k = case Globals.keyedEntry g k of
  Just _ -> True
  Nothing -> False

-- (a primitive declared again -- an error, heff.build.driver's `withTwice` says
-- where -- leaves the first where it was)
addElaborated : Elaborated -> Globals.Globals -> Globals.Globals
addElaborated r g =
  if r.prim && knownEntry g r.key then g else Globals.addEntry r.key r.entry g

topTake : (String -> String)
        -> TopResult
        -> Presyntax.Declaration
        -> Pair (Either Diag Elaborated) ElabSt
        -> TopResult
topTake kf acc n (MkPair (Left d) st) =
  topBroken
    kf
    (keepSt st acc)
    n
    (consAll acc.diags (appendT (recChron st) (reportedD d)))
topTake kf acc n (MkPair (Right r) st) =
  mkTop
    (withInstance
       r.isInstance
       r.key
       r.name
       (Globals.addOwn r.name r.key (addElaborated r acc.globals)))
    (consAll acc.diags (appendT (recChron st) (failedList r)))
    (Cons r.key acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (Cons (MkPair r.name (Params.spanOf n)) acc.spans)
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

watchTake : TopResult
          -> Params.Span
          -> Pair (Either Diag Globals.Entry) ElabSt
          -> TopResult
watchTake acc sp (MkPair (Left d) st) =
  mkTop
    acc.globals
    (consAll acc.diags (appendT (recChron st) (reportedD d)))
    acc.keys
    acc.broken
    acc.watches
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)
watchTake acc sp (MkPair (Right entry) st) =
  mkTop
    acc.globals
    (consAll acc.diags (recChron st))
    acc.keys
    acc.broken
    (Cons (mkWatch sp entry) acc.watches)
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

topOne : (String -> String) -> TopResult -> Presyntax.Declaration -> TopResult
topOne kf acc (At (DeclWatch e) sp) =
  watchTake acc sp (Meta.runE (elabWatch acc.globals e) emptySt)
-- extension: `test name`, the watches after it (with expectations) are
-- a test, named
topOne kf acc (At (DeclTest x _) sp) =
  mkTop
    acc.globals
    acc.diags
    acc.keys
    acc.broken
    acc.watches
    (Cons { name = x, span = sp } acc.tests)
    acc.spans
    acc.infos
    acc.trace
topOne kf acc n =
  topTake kf acc n (Meta.runE (elabDecl kf acc.globals n) emptySt)

topGo : (String -> String)
      -> TopResult
      -> List Presyntax.Declaration
      -> TopResult
topGo kf acc Nil =
  mkTop
    acc.globals
    (List.reverse acc.diags)
    (List.reverse acc.keys)
    (List.reverse acc.broken)
    (List.reverse acc.watches)
    (List.reverse acc.tests)
    (List.reverse acc.spans)
    (List.reverse acc.infos)
    (List.reverse acc.trace)
topGo kf acc (Cons n rest) = topGo kf (topOne kf acc n) rest

emptyTop : Globals.Globals -> TopResult
emptyTop g0 = mkTop g0 Nil Nil Nil Nil Nil Nil Nil Nil

-- | every declaration of a module, each elaborated in a fresh state
-- | >>> List.length (topModule "m" Globals.emptyGlobals Nil).keys
-- | 0
topModule : String -> Globals.Globals -> List Presyntax.Decl -> TopResult
topModule modName g0 decls =
  topGo
    (\x -> modName ^ "." ^ x)
    (emptyTop g0)
    (List.map Presyntax.classify decls)

-- | the same, on top of some existing globals, each definition under
-- | its own name (what an expectation is read with)
topWith : Globals.Globals -> List Presyntax.Decl -> TopResult
topWith g0 decls =
  topGo (\x -> x) (emptyTop g0) (List.map Presyntax.classify decls)

-- | a definition as a cache keeps it: its key, whether it is an
-- | instance, where it is, and its core syntax (type and body)
type ThawedDef =
  { name : String
  , key : String
  , isInstance : Bool
  , span : Params.Span
  , ty : Syntax.Ty
  , body : Syntax.Tm
  }

mkThawedDef : String
            -> String
            -> Bool
            -> Params.Span
            -> Syntax.Ty
            -> Syntax.Tm
            -> ThawedDef
mkThawedDef name key isInstance span ty body =
  { name = name
  , key = key
  , isInstance = isInstance
  , span = span
  , ty = ty
  , body = body
  }

isPrimB : Syntax.Tm -> Bool
isPrimB (SPrim _) = True
isPrimB (SIs e) = isPrimB e
isPrimB _ = False

thawKeep : TopResult -> ThawedDef -> Globals.Globals -> TopResult
thawKeep acc d g =
  mkTop
    g
    acc.diags
    (Cons d.key acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (Cons (MkPair d.name d.span) acc.spans)
    acc.infos
    acc.trace

-- (the name is the module's own definition's, a primitive's too, as
-- `topTake` has it)
thawGlobals : TopResult -> ThawedDef -> Globals.Globals
thawGlobals acc d =
  withInstance
    d.isInstance
    d.key
    d.name
    (Globals.addOwn
       d.name
       d.key
       (Globals.addEntry
          d.key
          (entryFor acc.globals d.key (isPrimB d.body) d.ty d.body)
          acc.globals))

thawOne : TopResult -> ThawedDef -> TopResult
thawOne acc d =
  -- (a primitive declared again: the first stays, as `addElaborated` has it)
  if isPrimB d.body && knownEntry acc.globals d.key
    then thawKeep acc d (Globals.addOwn d.name d.key acc.globals)
  else thawKeep acc d (thawGlobals acc d)

thawDone : TopResult -> TopResult
thawDone acc =
  mkTop
    acc.globals
    acc.diags
    (List.reverse acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (List.reverse acc.spans)
    acc.infos
    acc.trace

-- | a module thawed from a cache: its definitions' syntax evaluated
-- | back into globals -- `topModule` with the elaboration already done
topThawed : Globals.Globals -> List ThawedDef -> TopResult
topThawed g0 defs =
  thawDone (List.foldl (\acc d -> thawOne acc d) (emptyTop g0) defs)

-- Checking source text, whole
--------------------------------------------------------------------------------

withParse : TopResult -> List Diag -> TopResult
withParse t ds =
  mkTop
    t.globals
    (appendT ds t.diags)
    t.keys
    t.broken
    t.watches
    t.tests
    t.spans
    t.infos
    t.trace

noImports : String -> Bool
noImports x = False

checkRead : String -> Surface.Read -> TopResult
checkRead modName r =
  withParse (topModule modName Globals.emptyGlobals r.decls) r.diags

-- | a module's source, read and elaborated (no imports)
-- | >>> (checkSource "m" "two : Int\ntwo = 2\n").keys
-- | ["m.two"]
-- | >>> List.length (checkSource "m" "bad : Int\nbad = \"no\"\n").diags
-- | 1
checkSource : String -> String -> TopResult
checkSource modName src = checkRead modName (Surface.readProgram noImports src)

-- | a definition's stored core, printed
-- | >>> bodyDump (checkSource "m" "two : Int\ntwo = 2\n") "m.two"
-- | "(SIs (SLitInt 2))"
-- | >>> bodyDump (checkSource "m" "idInt : Int -> Int\nidInt x = x\n") "m.idInt"
-- | "(SLam (SFunction Small SPrimInt (AbsConst SPrimInt) Expl Nothing) (MkAbs \"x\" (SIs (SLocal 0))))"
bodyDump : TopResult -> String -> String
bodyDump t k = case Globals.lookupEntry t.globals k of
  Just e -> Print.showEl e.syntax
  Nothing -> "<no such definition>"

-- | >>> tyDump (checkSource "m" "two : Int\ntwo = 2\n") "m.two"
-- | "SPrimInt"
tyDump : TopResult -> String -> String
tyDump t k = case Globals.lookupEntry t.globals k of
  Just e -> Print.showTy e.tySyntax
  Nothing -> "<no such definition>"
