-- Evaluation.  Syntax is evaluated against the local environment; the
-- globals hold each definition's value.  Elements and types evaluate
-- through one another, so the two functions are the fields of one
-- record, `evaluator`, as the concrete syntax's grammar ties its own knot.
-- (Syntax is not staged into a function of the environment: staging
-- does not survive the knot's etas.)

module heff.elab.eval

import array as Array
import heff.util.dict as Dict
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.map as Map

type Globals = Globals.Globals

type Env = Value.Locals Value.V

type Evaluator =
  { el : Globals -> Params.Case -> Syntax.Tm -> Env -> Value.Ev Value.V
  , ty : Globals -> Params.Case -> Syntax.Ty -> Env -> Value.Ev Value.Ty
  }

globalValue : Globals -> String -> Value.V
globalValue g x = (Globals.elemAt g x).value

spineOfIdxs : Env -> Array Int -> Value.Spine Value.V
spineOfIdxs vs idxs =
  Array.foldl (\sp i -> SpApp sp (Value.localsAt vs i)) SpId idxs

evalTermF : Evaluator
          -> Globals
          -> Params.Case
          -> Syntax.Tm
          -> Env
          -> Value.Ev Value.V
evalTermF r g c (SLocal i) vs = Nom (Value.localsAt vs i)
evalTermF r g c (SGlobal x) vs = Nom (globalValue g x)
evalTermF r g c (SCode a) vs = Value.emap (\t -> Value.code t) (r.ty g c a vs)
-- (a redex, `let x = t1 in t`: its body where the redex is, at its case,
-- as the body with `t1` for `x` is)
evalTermF r g c (SApp (SLam dom (MkAbs x t)) t1) vs =
  r.el g c t (LSnoc vs (\u -> Value.nom (r.el g N t1 vs)))
evalTermF r g c (SApp t0 t1) vs =
  Value.ebind
    (\f -> Value.app f (\u -> Value.nom (r.el g N t1 vs)))
    (r.el g N t0 vs)
evalTermF r g c (SLam dom (MkAbs x t)) vs =
  Value.epure
    c
    (VLam
       (\u -> Value.nom (r.ty g N dom vs))
       (MkClo x vs (\vs2 -> r.el g c t vs2)))
evalTermF r g c (SLam dom (AbsConst t)) vs =
  Value.epure
    c
    (VLam (\u -> Value.nom (r.ty g N dom vs)) (CloConst (r.el g c t vs)))
evalTermF r g c (SCons fields) vs =
  Value.epure c (VCons (Dict.mapD (\t -> r.el g c t vs) fields))
evalTermF r g c (SProj t x) vs =
  Value.ebind (\v -> Value.proj v x) (r.el g N t vs)
evalTermF r g c (SSpecialize t x t') vs =
  Nom
    (Value.specialize
       (Value.nom (r.el g N t vs))
       x
       (Value.nom (r.el g N t' vs)))
evalTermF r g c (SIs t) vs = Become (Value.nom (r.el g N t vs))
evalTermF r g c (SImplicit x e) vs = r.el g c e vs
evalTermF r g c (SMetaApp m idxs ty) vs =
  Nom (Value.metaEl m (spineOfIdxs vs idxs) (Value.nom (r.ty g N ty vs)))
-- statically opaque: data, its elimination, literals, primitives, and
-- guarded recursion (which is also what keeps a self-call from unfolding
-- forever)
evalTermF r g c (STag x ts) vs = Nom VOpaque
evalTermF r g c (SMatch t arms) vs = Nom VOpaque
evalTermF r g c SOpaque vs = Nom VOpaque
evalTermF r g c SAbandon vs = Nom VOpaque
evalTermF r g c (SRec t) vs = Nom VOpaque
evalTermF r g c (SFix a b) vs = Nom VOpaque
evalTermF r g c (SPrim x) vs = Nom VOpaque
evalTermF r g c (SLitInt n) vs = Nom VOpaque
evalTermF r g c (SLitFloat n) vs = Nom VOpaque
evalTermF r g c (SLitString s) vs = Nom VOpaque
evalTermF r g c (SLitBytes s) vs = Nom VOpaque
evalTermF r g c (SLitRune n) vs = Nom VOpaque
evalTermF r g c (SLitFixed w n) vs = Nom VOpaque
evalTermF r g c (SLitFloat32 x) vs = Nom VOpaque

evalAbsTy : Evaluator
          -> Globals
          -> Syntax.Abs Syntax.Ty
          -> Env
          -> Value.Clo Value.V Value.Ty
evalAbsTy r g (MkAbs x t) vs = MkClo x vs (\vs2 -> r.ty g N t vs2)
evalAbsTy r g (AbsConst t) vs = CloConst (r.ty g N t vs)

fieldOfTy : Evaluator -> Globals -> Syntax.Ty -> Env -> Value.Field
fieldOfTy r g t vs2 = MkField (Value.nom (r.ty g N t vs2)) Nothing

sumArg : Evaluator -> Globals -> Env -> Syntax.Ty -> Params.Th Value.Ty
sumArg r g vs t u = Value.nom (r.ty g N t vs)

-- | is it an error hole read back (applied, projected, specialized): an
-- | error type's syntax, as a type that mentions what did not elaborate
-- | reads back
errorHeaded : Syntax.Tm -> Bool
errorHeaded SAbandon = True
errorHeaded (SApp t _) = errorHeaded t
errorHeaded (SProj t _) = errorHeaded t
errorHeaded (SSpecialize t _ _) = errorHeaded t
errorHeaded _ = False

evalTypeF : Evaluator
          -> Globals
          -> Params.Case
          -> Syntax.Ty
          -> Env
          -> Value.Ev Value.Ty
evalTypeF r g c (SU u) vs = Nom (VU u)
-- (an error type read back is one again, of a type nothing is known of,
-- at once)
evalTypeF r g c (SDecode t) vs =
  if errorHeaded t then Nom (Value.errorTy LargeU)
  else Value.decodeEv (r.el g c t vs)
evalTypeF r g c (SFunction level dom cod implicit dflt) vs =
  Nom
    (VFunction
       level
       (Value.nom (r.ty g N dom vs))
       (evalAbsTy r g cod vs)
       implicit
       dflt
       Nothing)
evalTypeF r g c (SRecord level fieldTypes defaults) vs =
  Describe (VRecord level vs (Dict.mapD (fieldOfTy r g) fieldTypes) defaults)
evalTypeF r g c (SSum st) vs =
  Describe (VSum (Params.variantsMap (sumArg r g vs) st))
evalTypeF r g c (SIsTy t) vs = Become (Value.nom (r.ty g N t vs))
evalTypeF r g c SPrimInt vs = Nom VPrimInt
evalTypeF r g c SPrimFloat vs = Nom VPrimFloat
evalTypeF r g c SPrimString vs = Nom VPrimString
evalTypeF r g c SPrimRune vs = Nom VPrimRune
evalTypeF r g c (SPrimArray a) vs = Nom (VPrimArray (Value.nom (r.ty g N a vs)))
evalTypeF r g c (SFixed w) vs = Nom (VFixed w)

evaluator : Evaluator
evaluator =
  { el = \g c s vs -> evalTermF evaluator g c s vs
  , ty = \g c s vs -> evalTypeF evaluator g c s vs
  }

eval : Globals -> Params.Case -> Syntax.Tm -> Env -> Value.Ev Value.V
eval g c s vs = evaluator.el g c s vs

-- | >>> Value.levelOf (Value.nom (evalTy Globals.emptyGlobals N SPrimInt LNil))
-- | Small
evalTy : Globals -> Params.Case -> Syntax.Ty -> Env -> Value.Ev Value.Ty
evalTy g c s vs = evaluator.ty g c s vs
