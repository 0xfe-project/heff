-- Syntax paired with its (thunked) value, so that elaboration never has
-- to evaluate a term it just built.

import array as Array
import heff.util.dict as Dict
import heff.elab.eval as Eval
import heff.elab.fixed
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.elab.readback as Readback
import heff.elab.syntax as Syntax
import heff.elab.value as Value

type El = { stx : Syntax.Tm, val : Params.Th (Value.Ev Value.V) }

type Ty = { stx : Syntax.Ty, val : Params.Th (Value.Ev Value.Ty) }

valN : El -> Value.V
valN m = Value.nom (Params.forceTh m.val)

tyN : Ty -> Value.Ty
tyN m = Value.nom (Params.forceTh m.val)

levelOf : Ty -> Params.Level
levelOf m = Value.levelOfEv (Params.forceTh m.val)

local : Int -> Params.Th Value.V -> El
local i v = { stx = SLocal i, val = \u -> Nom (v u) }

-- | a name of `g`, `v`, bound to it by a redex: `v`'s syntax, and the
-- | value it has once the redex is reduced, `g`'s
boundTo : El -> El -> El
boundTo v g = { stx = v.stx, val = g.val }

global : String -> Value.V -> El
global x v = { stx = SGlobal x, val = \u -> Nom v }

code : Ty -> El
code g =
  { stx = SCode g.stx
  , val = \u -> Value.emap (\t -> Value.code t) (Params.forceTh g.val)
  }

app : El -> El -> El
app g0 g1 =
  { stx = SApp g0.stx g1.stx
  , val = \u ->
        Value.ebind (\f -> Value.app f (\u2 -> valN g1)) (Params.forceTh g0.val)
  }

-- | an application to an implicit argument (the binder's name kept, for
-- | printing)
iapp : String -> El -> El -> El
iapp x g0 g1 =
  { stx = SApp g0.stx (SImplicit x g1.stx)
  , val = \u ->
        Value.ebind (\f -> Value.app f (\u2 -> valN g1)) (Params.forceTh g0.val)
  }

lam : Params.Case
    -> Globals.Globals
    -> Value.Locals Value.V
    -> Ty
    -> Syntax.Abs El
    -> El
lam c g vs gdom (MkAbs x gbody) =
  { stx = SLam gdom.stx (MkAbs x gbody.stx)
  , val = \u ->
        Value.epure
          c
          (VLam
             (\u2 -> tyN gdom)
             (MkClo x vs (\vs2 -> Eval.eval g c gbody.stx vs2)))
  }
lam c g vs gdom (AbsConst gbody) =
  { stx = SLam gdom.stx (AbsConst gbody.stx)
  , val = \u ->
        Value.epure
          c
          (VLam (\u2 -> tyN gdom) (CloConst (Params.forceTh gbody.val)))
  }

cons : Params.Case -> Dict.Dict El -> El
cons c d =
  { stx = SCons (Dict.mapD (\(m : El) -> m.stx) d)
  , val = \u ->
        Value.epure c (VCons (Dict.mapD (\(m : El) -> Params.forceTh m.val) d))
  }

proj : El -> String -> El
proj g x =
  { stx = SProj g.stx x
  , val = \u -> Value.ebind (\v -> Value.proj v x) (Params.forceTh g.val)
  }

-- | (`proj`, the field's type in hand: see `V.projAt`)
projAt : El -> String -> Value.Ty -> El
projAt g x a =
  { stx = SProj g.stx x
  , val = \u -> Value.ebind (\v -> Value.projAt v x a) (Params.forceTh g.val)
  }

tag : String -> Array El -> El
tag x gs =
  { stx = STag x (Array.map (\(m : El) -> m.stx) gs), val = \u -> Nom VOpaque }

matchM : El -> Dict.Dict (Pair (Array String) Syntax.Tm) -> El
matchM g cases = { stx = SMatch g.stx cases, val = \u -> Nom VOpaque }

specializeM : El -> String -> El -> El
specializeM g x g' =
  { stx = SSpecialize g.stx x g'.stx
  , val = \u -> Nom (Value.specialize (valN g) x (valN g'))
  }

recM : El -> El
recM m = { stx = SRec m.stx, val = \u -> Nom VOpaque }

-- | a local definition, recursive: opaque to evaluation (not unfolded)
fixM : Ty -> String -> El -> El
fixM ty x body =
  { stx = SFix ty.stx (MkAbs x body.stx), val = \u -> Nom VOpaque }

abandonM : El
abandonM = { stx = SAbandon, val = \u -> Nom VOpaque }

litInt : Int -> El
litInt i = { stx = SLitInt i, val = \u -> Nom VOpaque }

litFloat : Float64 -> El
litFloat x = { stx = SLitFloat x, val = \u -> Nom VOpaque }

litString : String -> El
litString s = { stx = SLitString s, val = \u -> Nom VOpaque }

litBytes : String -> El
litBytes s = { stx = SLitBytes s, val = \u -> Nom VOpaque }

litRune : Int -> El
litRune c = { stx = SLitRune c, val = \u -> Nom VOpaque }

litFixed : Fixed -> Int -> El
litFixed w i = { stx = SLitFixed w i, val = \u -> Nom VOpaque }

litFloat32 : Float64 -> El
litFloat32 x = { stx = SLitFloat32 x, val = \u -> Nom VOpaque }

isM : El -> El
isM g = { stx = SIs g.stx, val = \u -> Become (valN g) }

univ : Params.Universe -> Ty
univ u = { stx = SU u, val = \u2 -> Nom (VU u) }

decode : El -> Ty
decode g =
  { stx = SDecode g.stx, val = \u -> Value.decodeEv (Params.forceTh g.val) }

-- | a function type whose argument may be implicit (with a default, a
-- | closed term) or an instance
functionD : Params.Plicity
          -> Maybe Syntax.Tm
          -> Globals.Globals
          -> Value.Locals Value.V
          -> Ty
          -> Syntax.Abs Ty
          -> Ty
functionD implicit dflt g vs dom (MkAbs x body) =
  { stx = SFunction (levelOf body) dom.stx (MkAbs x body.stx) implicit dflt
  , val = \u ->
        Nom
          (VFunction
             (levelOf body)
             (tyN dom)
             (MkClo x vs (\vs2 -> Eval.evalTy g N body.stx vs2))
             implicit
             dflt)
  }
functionD implicit dflt g vs dom (AbsConst body) =
  { stx = SFunction (levelOf body) dom.stx (AbsConst body.stx) implicit dflt
  , val = \u ->
        Nom
          (VFunction
             (levelOf body)
             (tyN dom)
             (CloConst (Params.forceTh body.val))
             implicit
             dflt)
  }

-- | a function type whose argument may be implicit or an instance
functionI : Params.Plicity
          -> Globals.Globals
          -> Value.Locals Value.V
          -> Ty
          -> Syntax.Abs Ty
          -> Ty
functionI implicit g vs dom cod = functionD implicit Nothing g vs dom cod

function : Globals.Globals -> Value.Locals Value.V -> Ty -> Syntax.Abs Ty -> Ty
function g vs dom cod = functionI Expl g vs dom cod

fieldEval : Globals.Globals -> Syntax.Ty -> Value.Locals Value.V -> Value.Field
fieldEval g t vs2 = MkField (Value.nom (Eval.evalTy g N t vs2)) Nothing

-- | a record type: its fields' types, and their defaults (naming the
-- | fields before them, nothing else local)
recordM : Globals.Globals
        -> Value.Locals Value.V
        -> Params.Level
        -> Dict.Dict Syntax.Ty
        -> Dict.Dict Syntax.Tm
        -> Ty
recordM g vs level fieldTypes defaults =
  { stx = SRecord level fieldTypes defaults
  , val = \u ->
        Describe
          (VRecord level vs (Dict.mapD (fieldEval g) fieldTypes) defaults)
  }

sumThunk : Ty -> Params.Th Value.Ty
sumThunk m u2 = tyN m

sumM : Params.Variants Ty -> Ty
sumM st =
  { stx = SSum (Params.variantsMap (\(m : Ty) -> m.stx) st)
  , val = \u -> Describe (VSum (Params.variantsMap sumThunk st))
  }

isTy : Ty -> Ty
isTy m = { stx = SIsTy m.stx, val = \u -> Become (tyN m) }

-- | >>> (app (lam N Globals.emptyGlobals LNil (function Globals.emptyGlobals LNil primInt (AbsConst primInt)) (MkAbs "x" (local 0 (\u -> Value.local 0 VPrimInt)))) (global "k" (Value.local 1 VPrimInt))).stx
-- | SApp (SLam (SFunction Small SPrimInt (AbsConst SPrimInt) Expl Nothing) (MkAbs "x" (SLocal 0))) (SGlobal "k")
primInt : Ty
primInt = { stx = SPrimInt, val = \u -> Nom VPrimInt }

primFloat : Ty
primFloat = { stx = SPrimFloat, val = \u -> Nom VPrimFloat }

primString : Ty
primString = { stx = SPrimString, val = \u -> Nom VPrimString }

primRune : Ty
primRune = { stx = SPrimRune, val = \u -> Nom VPrimRune }

primArray : Ty -> Ty
primArray a = { stx = SPrimArray a.stx, val = \u -> Nom (VPrimArray (tyN a)) }

primFixed : Fixed -> Ty
primFixed w = { stx = SFixed w, val = \u -> Nom (VFixed w) }

fromVEl : Params.Case -> Int -> Value.V -> El
fromVEl c n v = { stx = Readback.readbEl n v, val = \u -> Value.epure c v }

fromVTy : Params.Case -> Int -> Value.Ty -> Ty
fromVTy c n v = { stx = Readback.readbTy n v, val = \u -> Value.epure c v }
