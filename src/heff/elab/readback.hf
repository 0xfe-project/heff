-- Readback: values go back to core
-- syntax; elements and types read back through one another, so the two
-- are the fields of one record, `rb`.

module heff.elab.readback

import array as Array
import heff.util.dict as Dict
import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.map as Map

type Rb =
  { el : Int -> Value.V -> Syntax.Tm, ty : Int -> Value.Ty -> Syntax.Ty }

arrayEmpty : Array Int
arrayEmpty = Array.empty

readbHead : Int -> Value.Head -> Syntax.Tm
readbHead n (HLocal i) = SLocal (n - i - 1)
readbHead n (HGlobal x) = SGlobal x
readbHead n (HMeta m) = SMetaApp m arrayEmpty (SU SmallU)
-- (computed, an error hole abandons: it is never, as the definitions
-- that have one are not)
readbHead n HError = SAbandon

consMaybe : Int -> Maybe (List Int) -> Maybe (List Int)
consMaybe l (Just xs) = Just (Cons l xs)
consMaybe l Nothing = Nothing

-- | the spine's arguments, if they are exactly locals (then a
-- | metavariable reads back as `SMetaApp`); innermost first here,
-- | reversed by the caller
localArgs : Value.Spine Value.V -> Maybe (List Int)
localArgs SpId = Just Nil
localArgs (SpApp sp (VNeu (HLocal l) SpId _ _ _)) = consMaybe l (localArgs sp)
localArgs _ = Nothing

readbSpine : Rb -> Int -> Value.Spine Value.V -> Syntax.Tm -> Syntax.Tm
readbSpine r n SpId t = t
readbSpine r n (SpApp sp v) t = SApp (readbSpine r n sp t) (r.el n v)
readbSpine r n (SpProj sp x) t = SProj (readbSpine r n sp t) x
readbSpine r n (SpSpec sp x v) t =
  SSpecialize (readbSpine r n sp t) x (r.el n v)

readbBare : Rb -> Int -> Value.Head -> Value.Spine Value.V -> Syntax.Tm
readbBare r n (HMeta m) sp = case localArgs sp of
  Just idxs ->
    SMetaApp
      m
      (Array.fromList (List.map (\l -> n - l - 1) (List.reverse idxs)))
      (SU SmallU)
  Nothing -> readbSpine r n sp (readbHead n (HMeta m))
readbBare r n h sp = readbSpine r n sp (readbHead n h)

-- | an evaluation read back as syntax of the same case
readbEvF : Rb -> Int -> Value.Ev Value.V -> Syntax.Tm
readbEvF r n (Nom v) = r.el n v
readbEvF r n (Describe v) = r.el n v
readbEvF r n (Become v) = SIs (r.el n v)

readbEvTypeF : Rb -> Int -> Value.Ev Value.Ty -> Syntax.Ty
readbEvTypeF r n (Nom a) = r.ty n a
readbEvTypeF r n (Describe a) = r.ty n a
readbEvTypeF r n (Become a) = SIsTy (r.ty n a)

readbCloEl : Rb
           -> Int
           -> Value.Ty
           -> Value.Clo Value.V Value.V
           -> Syntax.Abs Syntax.Tm
readbCloEl r n dom (MkClo x l f) =
  MkAbs x (readbEvF r (n + 1) (f (Value.snocL l (Value.local n dom))))
readbCloEl r n dom (CloConst t) = AbsConst (readbEvF r n t)

readbCloTy : Rb
           -> Int
           -> Value.Ty
           -> Value.Clo Value.V Value.Ty
           -> Syntax.Abs Syntax.Ty
readbCloTy r n dom (MkClo x l f) =
  MkAbs x (readbEvTypeF r (n + 1) (f (Value.snocL l (Value.local n dom))))
readbCloTy r n dom (CloConst t) = AbsConst (readbEvTypeF r n t)

readbTermF : Rb -> Int -> Value.V -> Syntax.Tm
readbTermF r n (VNeu h sp ty expansion desc) = readbBare r n h sp
readbTermF r n (VCode a) = SCode (r.ty n a)
readbTermF r n (VLam fty body) =
  SLam
    (r.ty n (Params.forceTh fty))
    (readbCloEl r n (Value.lamDom (Params.forceTh fty)) body)
readbTermF r n (VCons d) = SCons (Dict.mapD (readbEvF r n) d)
readbTermF r n VOpaque = SOpaque

-- | a record type's fields, each under the ones before it
goRT : Rb
     -> Int
     -> Value.Locals Value.V
     -> List (Value.Locals Value.V -> Value.Field)
     -> List Syntax.Ty
goRT r i ls Nil = Nil
goRT r i ls (Cons f rest) = case f ls of
  MkField ty value ->
    Cons (r.ty i ty) (goRT r (i + 1) (Value.snocL ls (Value.local i ty)) rest)

sumVariant : Rb -> Int -> Params.Th Value.Ty -> Syntax.Ty
sumVariant r n t = r.ty n (Params.forceTh t)

readbTypeF : Rb -> Int -> Value.Ty -> Syntax.Ty
readbTypeF r n (VU u) = SU u
readbTypeF r n (VDecode h sp u described el) =
  SDecode (readbSpine r n sp (readbHead n h))
readbTypeF r n (VFunction level dom cod implicit dflt) =
  SFunction level (r.ty n dom) (readbCloTy r n dom cod) implicit dflt
readbTypeF r n (VRecord level capture fieldTypes defaults) =
  SRecord
    level
    { keys = fieldTypes.keys
    , byName = fieldTypes.byName
    , values =
        Array.fromList (goRT r n capture (Array.toList fieldTypes.values))
    }
    defaults
readbTypeF r n (VSum st) = SSum (Params.variantsMap (sumVariant r n) st)
readbTypeF r n VPrimInt = SPrimInt
readbTypeF r n VPrimFloat = SPrimFloat
readbTypeF r n VPrimString = SPrimString
readbTypeF r n VPrimRune = SPrimRune
readbTypeF r n (VPrimArray a) = SPrimArray (r.ty n a)
readbTypeF r n (VFixed w) = SFixed w

rb : Rb
rb = { el = \n v -> readbTermF rb n v, ty = \n t -> readbTypeF rb n t }

readbEl : Int -> Value.V -> Syntax.Tm
readbEl n v = rb.el n v

readbBareN : Int -> Value.Head -> Value.Spine Value.V -> Syntax.Tm
readbBareN n h sp = readbBare rb n h sp

readbTy : Int -> Value.Ty -> Syntax.Ty
readbTy n t = rb.ty n t

readbEv : Int -> Value.Ev Value.V -> Syntax.Tm
readbEv n e = readbEvF rb n e

-- | readback that puts the solved metavariables in as it goes, each value
-- | forced first (`Int`, where a solution applied to the locals would
-- | read back as `(\x -> Int) f`)
forcedRb : Value.MetaCtx -> Rb
forcedRb mc =
  { el = \n v -> readbTermF (forcedRb mc) n (Value.forceEl mc v)
  , ty = \n t -> readbTypeF (forcedRb mc) n (Value.forceTy mc t)
  }

readbTyForced : Value.MetaCtx -> Int -> Value.Ty -> Syntax.Ty
readbTyForced mc n t = (forcedRb mc).ty n t

-- the identity on Int, as core syntax, and the NbE round trip
-- | >>> readbEl 0 (Value.nom (Eval.eval Globals.emptyGlobals N idTm LNil))
-- | SLam (SFunction Small SPrimInt (AbsConst SPrimInt) Expl Nothing) (MkAbs "x" (SLocal 0))
-- |
-- | a beta step against a free local
-- | >>> readbEl 1 (Value.nom (Eval.eval Globals.emptyGlobals N (SApp idTm (SLocal 0)) (Value.snocL LNil (Value.local 0 VPrimInt))))
-- | SLocal 0
idTm : Syntax.Tm
idTm =
  SLam
    (SFunction Small SPrimInt (AbsConst SPrimInt) Expl Nothing)
    (MkAbs "x" (SLocal 0))
