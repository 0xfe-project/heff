-- The elaboration environment and state.  `Elab` is a computation
-- whose effects are the elaboration state and failing with
-- a diagnostic; `do` is `co`'s.  `ElabSt` holds delayed
-- checks and wanted instances as its handler's steps (`Step`), so it is
-- a `data` (`MkSt core delayed wanted`), the knot tied.

module heff.elab.environment

import co
import exception as Exception
import heff.syntax.diagnostic
import heff.util.dict as Dict
import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.ordmap as OrdMap
import state as State

-- Scope
--------------------------------------------------------------------------------

data BindingMode = BDelayedBy Int

data Ctx = CEmpty | CBind Ctx BindingMode Value.Ty | CUndelay Ctx

-- | a step into a value: a record's field, or the `i`th argument of its
-- | tag `x`
data PartStep = PartField String | PartArg String Int

samePartStep : PartStep -> PartStep -> Bool
samePartStep (PartField f) (PartField g) = strEq f g
samePartStep (PartArg x i) (PartArg y j) = i == j && strEq x y
samePartStep _ _ = False

samePartSteps : List PartStep -> List PartStep -> Bool
samePartSteps Nil Nil = True
samePartSteps (Cons s ss) (Cons t ts) = samePartStep s t && samePartSteps ss ts
samePartSteps _ _ = False

-- | a part of a local's value: the local, by its level, and the steps
-- | into it, the last first
type ValuePart = { root : Int, steps : List PartStep }

samePart : ValuePart -> ValuePart -> Bool
samePart p q = p.root == q.root && samePartSteps p.steps q.steps

-- | the tags a part can still have, and where: the arm, taken, that
-- | says so
type TagsLeft = { part : ValuePart, tags : List String, at : Params.Span }

-- | what the matches around a term have established of the values in
-- | scope (#108): the locals that name a part of another's value (bound
-- | to it, or to an argument of the tag matched), and the tags a part can
-- | still have, an arm of a match on it being taken (the last first).
-- | The locals do not change (a `let mut` variable is bound again where
-- | it is set), so it holds for whatever is under the arm, lambdas too
type Matched = { aliases : List (Pair Int ValuePart), tags : List TagsLeft }

nothingMatched : Matched
nothingMatched = { aliases = Nil, tags = Nil }

type Scope =
  { len : Int
  , names : List String
  , locals : Value.Locals Value.V
  , ctx : Ctx
  , matched : Matched
  }

emptyScope : Scope
emptyScope =
  { len = 0
  , names = Nil
  , locals = LNil
  , ctx = CEmpty
  , matched = nothingMatched
  }

undelayScope : Scope -> Scope
undelayScope sd =
  { len = sd.len
  , names = sd.names
  , locals = sd.locals
  , ctx = CUndelay sd.ctx
  , matched = sd.matched
  }

letAt : BindingMode -> String -> Value.V -> Value.Ty -> Scope -> Scope
letAt bm x v a c =
  { len = c.len + 1
  , names = Cons x c.names
  , locals = Value.snocL c.locals v
  , ctx = CBind c.ctx bm a
  , matched = c.matched
  }

withMatched : Matched -> Scope -> Scope
withMatched k sc =
  { len = sc.len
  , names = sc.names
  , locals = sc.locals
  , ctx = sc.ctx
  , matched = k
  }

-- (the part of a value the local `l` names: its own, unless it was bound
-- to a part of another's)
partNamed : List (Pair Int ValuePart) -> Int -> ValuePart
partNamed Nil l = { root = l, steps = Nil }
partNamed (Cons (MkPair m p) rest) l = if m == l then p else partNamed rest l

partInto : PartStep -> ValuePart -> ValuePart
partInto s p = { root = p.root, steps = Cons s p.steps }

partIntoM : PartStep -> Maybe ValuePart -> Maybe ValuePart
partIntoM s (Just p) = Just (partInto s p)
partIntoM s Nothing = Nothing

-- | the part of a local's value a term is, if it is one: a local, or a
-- | field of one
partOf : Scope -> Syntax.Tm -> Maybe ValuePart
partOf sc (SLocal i) = Just (partNamed sc.matched.aliases (sc.len - 1 - i))
partOf sc (SProj t f) = partIntoM (PartField f) (partOf sc t)
partOf sc _ = Nothing

matchedTagsAt : List TagsLeft -> ValuePart -> Maybe (List String)
matchedTagsAt Nil p = Nothing
matchedTagsAt (Cons t rest) p =
  if samePart p t.part then Just t.tags else matchedTagsAt rest p

-- | the tags `p` can still have, where a match around says
matchedTags : Scope -> ValuePart -> Maybe (List String)
matchedTags sc p = matchedTagsAt sc.matched.tags p

-- | of the tags `xs`, those the part `p` can still have
tagsLeft : Scope -> Maybe ValuePart -> List String -> List String
tagsLeft sc (Just p) xs = case matchedTags sc p of
  Just ys -> List.keepIf (\x -> List.elemBy strEq x ys) xs
  Nothing -> xs
tagsLeft sc Nothing xs = xs

-- | the scope of an arm, at `at`, where the tag of `p` is one of `xs`
matchedTo : Maybe ValuePart -> List String -> Params.Span -> Scope -> Scope
matchedTo (Just p) xs at sc =
  withMatched
    { aliases = sc.matched.aliases
    , tags =
        Cons
          { part = p, tags = tagsLeft sc (Just p) xs, at = at }
          sc.matched.tags
    }
    sc
matchedTo Nothing xs at sc = sc

-- (of the arms that left `p` tags, the first that left it none of `x`:
-- each leaves fewer than the one around it)
ruledOutAt : List TagsLeft
           -> ValuePart
           -> String
           -> Maybe Params.Span
           -> Maybe Params.Span
ruledOutAt Nil p x found = found
ruledOutAt (Cons t rest) p x found =
  if samePart p t.part && not (List.elemBy strEq x t.tags)
  then ruledOutAt rest p x (Just t.at)
  else ruledOutAt rest p x found

-- | where the matches around ruled out the tag `x` of the part `p`: the
-- | arm that did it first, if they did
ruledOutBy : Scope -> Maybe ValuePart -> String -> Maybe Params.Span
ruledOutBy sc (Just p) x = ruledOutAt sc.matched.tags p x Nothing
ruledOutBy sc Nothing x = Nothing

-- | whether no value gets here: the matches around have left a part no
-- | tag
unreachable : Scope -> Bool
unreachable sc = List.any (\(t : TagsLeft) -> List.null t.tags) sc.matched.tags

-- | the local `l` is bound to the part `p`
namesPart : Int -> Maybe ValuePart -> Scope -> Scope
namesPart l (Just p) sc =
  withMatched
    { aliases = Cons (MkPair l p) sc.matched.aliases, tags = sc.matched.tags }
    sc
namesPart l Nothing sc = sc

-- (the `n` locals from the level `l` on, bound to the arguments of the
-- tag `x` of `p`, from the `i`th)
argPartsFrom : ValuePart -> String -> Int -> Int -> Int -> Scope -> Scope
argPartsFrom p x l i n sc =
  if i >= n then sc
  else argPartsFrom
      p
      x
      l
      (i + 1)
      n
      (namesPart (l + i) (Just (partInto (PartArg x i) p)) sc)

-- | an arm of the tag `x` of `p` binds its `n` arguments next
argParts : Maybe ValuePart -> String -> Int -> Scope -> Scope
argParts (Just p) x n sc = argPartsFrom p x sc.len 0 n sc
argParts Nothing x n sc = sc

let_ : String -> Value.V -> Value.Ty -> Scope -> Scope
let_ x v a c = letAt (BDelayedBy 0) x v a c

bindAt : BindingMode -> String -> Value.Ty -> Scope -> Scope
bindAt bm x a c = letAt bm x (Value.local c.len a) a c

bindName : String -> Value.Ty -> Scope -> Scope
bindName x a c = bindAt (BDelayedBy 0) x a c

multiBind : List String -> List Value.Ty -> Scope -> Scope
multiBind (Cons x xs) (Cons a args) s = multiBind xs args (bindName x a s)
multiBind _ _ s = s

withBound : {a : Type}
          -> String
          -> Value.Ty
          -> Scope
          -> (Value.V -> Scope -> a)
          -> a
withBound x a c action =
  action (Value.local c.len a) (let_ x (Value.local c.len a) a c)

shape : Scope -> Params.CtxShape
shape c = { len = c.len, names = c.names }

-- Elaboration environment
--------------------------------------------------------------------------------

data ElabFor = ForNominative | ForDescriptive Value.Head (Value.Spine Value.V)

caseOf : ElabFor -> Params.Case
caseOf ForNominative = N
caseOf (ForDescriptive _ _) = De

projElabFor : ElabFor -> String -> ElabFor
projElabFor ForNominative _ = ForNominative
projElabFor (ForDescriptive h sp) x = ForDescriptive h (SpProj sp x)

appElabFor : ElabFor -> Value.V -> ElabFor
appElabFor ForNominative _ = ForNominative
appElabFor (ForDescriptive h sp) v = ForDescriptive h (SpApp sp v)

createNominative : ElabFor -> Value.Ev Value.V -> Value.Ty -> Value.V
createNominative ForNominative v _ = Value.nom v
createNominative (ForDescriptive h sp) ev a =
  Value.reflect h (\u -> sp) (\u -> a) (Just ev)

-- | an instance binder in scope -- a candidate for instance
-- | search.  `v` is the bound local's value, `ty` its type.
type InstLocal = { name : String, ty : Value.Ty, v : Value.V }

-- | `lams`: how many lambdas the elaboration has entered; `self`: the
-- | key of the definition being elaborated, bound as local 0; `insts`:
-- | the instance binders in scope
type ElabEnv =
  { scope : Scope
  , globals : Globals.Globals
  , elabFor : ElabFor
  , lams : Int
  , self : Maybe String
  , insts : List InstLocal
  }

emptyElabEnv : Globals.Globals -> ElabEnv
emptyElabEnv globals =
  { scope = emptyScope
  , globals = globals
  , elabFor = ForNominative
  , lams = 0
  , self = Nothing
  , insts = Nil
  }

emptyElabEnvFor : Globals.Globals -> String -> ElabEnv
emptyElabEnvFor globals x =
  { scope = emptyScope
  , globals = globals
  , elabFor = ForDescriptive (HGlobal x) SpId
  , lams = 0
  , self = Nothing
  , insts = Nil
  }

-- State
--------------------------------------------------------------------------------

-- | what elaboration learns for the IDE: what a name at a span resolved
-- | to, and its type (rendered when it is asked for)
type Info =
  { span : Params.Span
  , name : String
  , key : Maybe String
  , member : Bool
  , ty : Unit -> String
  }

-- | an `Info` as elaboration notes it, its type rendered with the
-- | metavariables' solutions it is given: once the definition is done,
-- | its own (`settled`), so that a type found later (a `do` block's
-- | variable's, a `let`'s literal's) is said
type Noted =
  { span : Params.Span
  , name : String
  , key : Maybe String
  , member : Bool
  , ty : Value.MetaCtx -> String
  }

-- | a note, its type rendered with the solutions `mc`
settled : Value.MetaCtx -> Noted -> Info
settled mc n =
  { span = n.span
  , name = n.name
  , key = n.key
  , member = n.member
  , ty = \u -> n.ty mc
  }

-- | ... without its type: what a query over a whole project keeps (the
-- | rendering holds on to the environment it was found in)
leanInfo : Info -> Info
leanInfo i =
  { span = i.span
  , name = i.name
  , key = i.key
  , member = i.member
  , ty = \u -> ""
  }

-- | a step of elaboration, for `heff explain`: where, what kind, and
-- | what (rendered when it is asked for)
type TraceEvent = { span : Params.Span, kind : String, text : Unit -> String }

type Postponed =
  { shape : Params.CtxShape, left : Value.V, right : Value.V, failed : Bool }

-- | what elaboration saw of an arm (#108), by where the source has it:
-- | taken; never taken, where the matches around ruled out what it
-- | matches (`ArmRuledOut at by what`: the arm `by` did, of the tag or
-- | tags `what`); never reached, as others match every value it would
-- | (an arm's, an equation's: what it says)
data ArmSeen
  = ArmTaken Params.Span
  | ArmRuledOut Params.Span Params.Span String
  | ArmCovered Params.Span String
  | EquationCovered Params.Span

-- | where the arm is
armPlace : ArmSeen -> Params.Span
armPlace (ArmTaken sp) = sp
armPlace (ArmRuledOut sp _ _) = sp
armPlace (ArmCovered sp _) = sp
armPlace (EquationCovered sp) = sp

type StCore =
  { infos : List Noted
  , recovered : List Diag
  , poisoned : OrdMap.OrdMap Int Unit
  , metas : Value.MetaCtx
  , nextMeta : Int
  , postponed : List Postponed
  , trace : List TraceEvent
  , selfKey : Maybe String
  , arms : List ArmSeen
  }

-- (a step of the handler, over a state `st`)
type StepIn st a = st -> Pair (Either Diag a) st

-- | an argument whose check waits until the type it is checked at is
-- | known, and what may be guessed of that type when nothing else says
-- | it (of a lambda's: that it is a function type; whether it was).
-- | Each is a step of the handler (`Step`), over the whole state, so
-- | the state is a `data`, and the fields parametric, to tie the knot.
data Delayed st = MkDelayed Value.Ty (StepIn st Unit) (Maybe (StepIn st Bool))

-- | an instance argument to find.  `resolve final` searches
-- | once the goal has no unsolved metavariables; it answers whether it
-- | is done (solved), and on `final` it fails rather than wait longer.
data Wanted st = MkWanted Params.Span (Bool -> st -> Pair (Either Diag Bool) st)

-- | The handler's state: the elaboration state, and the checks waiting
-- | in it.  No rule sees it: they see `StCore`, and say what is to wait
-- | by the operations of `defer`.
data ElabSt = MkSt StCore (List (Delayed ElabSt)) (List (Wanted ElabSt))

emptyCore : StCore
emptyCore =
  { infos = Nil
  , recovered = Nil
  , poisoned = OrdMap.empty
  , metas = OrdMap.empty
  , nextMeta = 0
  , postponed = Nil
  , trace = Nil
  , selfKey = Nothing
  , arms = Nil
  }

emptySt : ElabSt
emptySt = MkSt emptyCore Nil Nil

core : ElabSt -> StCore
core (MkSt c _ _) = c

delayedOf : ElabSt -> List (Delayed ElabSt)
delayedOf (MkSt _ d _) = d

wantedOf : ElabSt -> List (Wanted ElabSt)
wantedOf (MkSt _ _ w) = w

withCore : (StCore -> StCore) -> ElabSt -> ElabSt
withCore f (MkSt c d w) = MkSt (f c) d w

withDelayed : (List (Delayed ElabSt) -> List (Delayed ElabSt))
            -> ElabSt
            -> ElabSt
withDelayed f (MkSt c d w) = MkSt c (f d) w

withWanted : (List (Wanted ElabSt) -> List (Wanted ElabSt)) -> ElabSt -> ElabSt
withWanted f (MkSt c d w) = MkSt c d (f w)

-- | the checks waiting, as they were at a moment: what a check that
-- | failed is put back to (recovery drops what it left delayed; a
-- | unification tried, `attempt`, what it left delayed and wanted)
data Saved = MkSaved (List (Delayed ElabSt)) (List (Wanted ElabSt))

restoreTo : Saved -> ElabSt -> ElabSt
restoreTo (MkSaved ds ws) st = withDelayed (\old -> ds) st

restoreAllTo : Saved -> ElabSt -> ElabSt
restoreAllTo (MkSaved ds ws) st =
  withWanted (\old -> ws) (withDelayed (\old -> ds) st)

-- Effects
--------------------------------------------------------------------------------

-- | Checks that wait: one delayed until a type is known (with a guess
-- | of that type, or not), an instance argument wanted; a guess made,
-- | of the oldest delayed check that has one and still waits, and
-- | whether there is one to make; waking the delayed ones whose types are known (all
-- | of them, with `True`; else finding the wanted ones whose goals are
-- | known, too), trying the wanted ones (and refusing those
-- | still undetermined, on `True`: whether any was found); whether one
-- | is ready; the waiting checks saved, and put back (the delayed ones,
-- | or all).
data DeferF (m : Type -> Type) x
  = Delay Value.Ty (m Unit) x
  | DelayGuessing Value.Ty (m Unit) (m Bool) x
  | Guess (Bool -> x)
  | CanGuess (Bool -> x)
  | Want Params.Span (Bool -> m Bool) x
  | Wake Bool x
  | Resolve Bool (Bool -> x)
  | Pending (Bool -> x)
  | SaveDelayed (Saved -> x)
  | RestoreDelayed Saved x
  | RestoreWaiting Saved x

defer : HFunctor
defer =
  { f = DeferF
  , hfmap = \m g p -> case p of
      Delay ty c x -> Delay ty c (g x)
      DelayGuessing ty c gs x -> DelayGuessing ty c gs (g x)
      Guess k -> Guess (\b -> g (k b))
      CanGuess k -> CanGuess (\b -> g (k b))
      Want sp f x -> Want sp f (g x)
      Wake all x -> Wake all (g x)
      Resolve final k -> Resolve final (\b -> g (k b))
      Pending k -> Pending (\b -> g (k b))
      SaveDelayed k -> SaveDelayed (\sv -> g (k sv))
      RestoreDelayed sv x -> RestoreDelayed sv (g x)
      RestoreWaiting sv x -> RestoreWaiting sv (g x)
  , hmap = \m n nt p -> case p of
      Delay ty c x -> Delay ty (nt c) x
      DelayGuessing ty c gs x -> DelayGuessing ty (nt c) (nt gs) x
      Guess k -> Guess k
      CanGuess k -> CanGuess k
      Want sp f x -> Want sp (\b -> nt (f b)) x
      Wake all x -> Wake all x
      Resolve final k -> Resolve final k
      Pending k -> Pending k
      SaveDelayed k -> SaveDelayed k
      RestoreDelayed sv x -> RestoreDelayed sv x
      RestoreWaiting sv x -> RestoreWaiting sv x
  }

-- | What elaboration writes down for others: a step of the trace (for
-- | `heff explain`), and what a name resolved to (for the IDE).
data NotesF (m : Type -> Type) x = Trace TraceEvent x | Record Noted x

notes : HFunctor
notes =
  { f = NotesF
  , hfmap = \m g p -> case p of
      Trace ev x -> Trace ev (g x)
      Record i x -> Record i (g x)
  , hmap = \m n nt p -> case p of
      Trace ev x -> Trace ev x
      Record i x -> Record i x
  }

-- | What elaboration does to the world: it has a state, it may give up
-- | with the one diagnostic that made it stop, checks wait in it, and it
-- | writes notes.  (Its handler is `heff.elab.meta`'s `elabH`: whether a
-- | delayed check is ready is the unifier's to say.)
elabE : HFunctor
elabE = State.state StCore <+> Exception.exception Diag <+> defer <+> notes

type Elab a = Co elabE a

-- the evidence of each, given once
stEv : State.state StCore <: elabE
stEv p = InL (InL (InL p))

exEv : Exception.exception Diag <: elabE
exEv p = InL (InL (InR p))

dfEv : defer <: elabE
dfEv p = InL (InR p)

ntEv : notes <: elabE
ntEv p = InR p

gets : {a : Type} -> (StCore -> a) -> Elab a
gets f = op (stEv (Get f)) val

putSt : StCore -> Elab Unit
putSt c = op (stEv (Put c (MkUnit : Unit))) val

modify : (StCore -> StCore) -> Elab Unit
modify f = bind (gets f) putSt

throwE : {a : Type} -> Diag -> Elab a
throwE d = op (exEv (Throw d)) val

-- | `m`; if it gives up, `h` of why, from the state it gave up in
catchE : {a : Type} -> Elab a -> (Diag -> Elab a) -> Elab a
catchE m h = op (exEv (Catch m h)) val

-- | `chk`, once `ty` is known
delay : Value.Ty -> Elab Unit -> Elab Unit
delay ty chk = op (dfEv (Delay ty chk (MkUnit : Unit))) val

-- | `chk`, once `ty` is known; and `gs`, a guess of `ty`, if nothing else
-- | says it (whether it was made)
delayGuessing : Value.Ty -> Elab Unit -> Elab Bool -> Elab Unit
delayGuessing ty chk gs =
  op (dfEv (DelayGuessing ty chk gs (MkUnit : Unit))) val

-- | a guess made: of the oldest delayed check that has one and still
-- | waits (whether one was made)
guess : Elab Bool
guess = op (dfEv (Guess (\b -> b))) val

-- | whether a delayed check that still waits has a guess to make
canGuess : Elab Bool
canGuess = op (dfEv (CanGuess (\b -> b))) val

-- | an instance argument to find later (see `Wanted`)
want : Params.Span -> (Bool -> Elab Bool) -> Elab Unit
want sp f = op (dfEv (Want sp f (MkUnit : Unit))) val

-- | run the delayed checks whose types are now known (and those they
-- | delay in turn), and find the instance arguments whose goals are
-- | (one not found yet waits on); with `all`, every delayed check, known
-- | or not, and no search
wake : Bool -> Elab Unit
wake all = op (dfEv (Wake all (MkUnit : Unit))) val

-- | try each waiting instance argument; `final` refuses the ones whose
-- | goals never became determined.  Whether any was found.
resolve : Bool -> Elab Bool
resolve final = op (dfEv (Resolve final (\b -> b))) val

-- | whether a delayed check is ready to run
pending : Elab Bool
pending = op (dfEv (Pending (\b -> b))) val

saveDelayed : Elab Saved
saveDelayed = op (dfEv (SaveDelayed (\sv -> sv))) val

restoreDelayed : Saved -> Elab Unit
restoreDelayed sv = op (dfEv (RestoreDelayed sv (MkUnit : Unit))) val

restoreWaiting : Saved -> Elab Unit
restoreWaiting sv = op (dfEv (RestoreWaiting sv (MkUnit : Unit))) val

traceE : Params.Span -> String -> (Unit -> String) -> Elab Unit
traceE span kind text =
  op
    (ntEv (Trace { span = span, kind = kind, text = text } (MkUnit : Unit)))
    val

record : Noted -> Elab Unit
record i = op (ntEv (Record i (MkUnit : Unit))) val

-- | a computation, its failure as a value (the state kept either way)
tryE : {a : Type} -> Elab a -> Elab (Either Diag a)
tryE m = catchE (bind m (\x -> val (Right x))) (\d -> val (Left d))

-- | a trace event, kept in the state
pushTrace : TraceEvent -> StCore -> StCore
pushTrace ev c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = Cons ev c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

-- | ... made here (a record alias built in another module trips the host)
pushTraceAt : Params.Span -> String -> (Unit -> String) -> StCore -> StCore
pushTraceAt span kind text c =
  pushTrace { span = span, kind = kind, text = text } c

-- | an info, kept in the state
pushInfo : Noted -> StCore -> StCore
pushInfo i c =
  { infos = Cons i c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

-- | elaborator codes are numbered from 300
failWith : {a : Type} -> Params.Span -> Int -> String -> Elab a
failWith sp code msg =
  throwE
    { code = 300 + code
    , severity = SError
    , msg = msg
    , span = sp
    , note = Nothing
    }

failWithNote : {a : Type} -> Params.Span -> Int -> String -> String -> Elab a
failWithNote sp code msg note =
  throwE
    { code = 300 + code
    , severity = SError
    , msg = msg
    , span = sp
    , note = Just note
    }

-- | a failure that is not an error of its own: what it comes of is
-- | reported where it is.  Its code is no diagnostic's
failElsewhere : {a : Type} -> Params.Span -> String -> Elab a
failElsewhere sp msg =
  throwE
    { code = 0 - 1, severity = SError, msg = msg, span = sp, note = Nothing }

reportedElsewhere : Diag -> Bool
reportedElsewhere d = d.code == (0 - 1)

-- state field updates, spelled once
setMetas : Value.MetaCtx -> Int -> StCore -> StCore
setMetas mc next c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = mc
  , nextMeta = next
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

setPostponed : List Postponed -> StCore -> StCore
setPostponed ps c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = ps
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

setPoisoned : OrdMap.OrdMap Int Unit -> StCore -> StCore
setPoisoned ps c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = ps
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

setRecovered : List Diag -> StCore -> StCore
setRecovered ds c =
  { infos = c.infos
  , recovered = ds
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = c.arms
  }

-- | what was seen of an arm, kept
pushArm : ArmSeen -> StCore -> StCore
pushArm a c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = c.selfKey
  , arms = Cons a c.arms
  }

-- | what was seen of the arms, kept
seeArms : List ArmSeen -> Elab Unit
seeArms Nil = val MkUnit
seeArms (Cons a rest) = bind (modify (pushArm a)) (\u -> seeArms rest)

setSelfKey : Maybe String -> StCore -> StCore
setSelfKey k c =
  { infos = c.infos
  , recovered = c.recovered
  , poisoned = c.poisoned
  , metas = c.metas
  , nextMeta = c.nextMeta
  , postponed = c.postponed
  , trace = c.trace
  , selfKey = k
  , arms = c.arms
  }
