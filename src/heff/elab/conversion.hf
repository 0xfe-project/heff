-- Definitional equality.  There is no type-directed conversion: every
-- element of a small type is `VOpaque` already, and `VOpaque` is equal
-- to anything.  The four judgments call one another, so they are the
-- fields of one record, `eq`.  An error carries the context's shape and
-- the two sides, for the message.

import array as A
import heff.util.dict as D
import heff.elab.params as P
import heff.elab.value as V

data EqErr
  = UnequalTys P.CtxShape V.Ty V.Ty
  | UnequalEls P.CtxShape V.V V.V
  | UnequalNeus P.CtxShape V.Head (V.Spine V.V) V.Head (V.Spine V.V)
  -- | a solution would mention an error hole (it is not given)
  | MentionsError

type EqM = Either EqErr Unit

-- (`do` in this module sequences these checks)
bind : {a b : Type} -> Either EqErr a -> (a -> Either EqErr b) -> Either EqErr b
bind (Left e) f = Left e
bind (Right x) f = f x

ok : EqM
ok = Right MkUnit

holds : EqM -> Bool
holds (Right _) = True
holds (Left _) = False

eqHead : V.Head -> V.Head -> Bool
eqHead (HLocal i) (HLocal j) = i == j
eqHead (HGlobal x) (HGlobal y) = strEq x y
eqHead (HMeta m) (HMeta m') = m == m'
eqHead HError HError = True
eqHead _ _ = False

type Conv =
  { ty : P.CtxShape -> V.Ty -> V.Ty -> EqM
  , el : P.CtxShape -> V.V -> V.V -> EqM
  , bare : P.CtxShape -> V.Head -> V.Spine V.V -> V.Head -> V.Spine V.V -> EqM
  }

cloBinder : {v a : Type} -> V.Clo v a -> V.Clo v a -> String
cloBinder c0 c1 = case V.cloName c0 of
  Just x -> x
  Nothing -> case V.cloName c1 of
    Just x -> x
    Nothing -> "x"

defEqCloTypeF : Conv
              -> P.CtxShape
              -> V.Ty
              -> V.Clo V.V V.Ty
              -> V.Clo V.V V.Ty
              -> EqM
defEqCloTypeF r cs a c0 c1 =
  V.withV
    (V.local cs.len a)
    (\v ->
       r.ty
         (P.bindShape (cloBinder c0 c1) cs)
         (V.nom (V.appClo c0 (\u -> v)))
         (V.nom (V.appClo c1 (\u -> v))))

defEqCloTermF : Conv
              -> P.CtxShape
              -> V.Ty
              -> V.Clo V.V V.V
              -> V.Clo V.V V.V
              -> EqM
defEqCloTermF r cs a c0 c1 =
  V.withV
    (V.local cs.len a)
    (\v ->
       r.el
         (P.bindShape (cloBinder c0 c1) cs)
         (V.nom (V.appClo c0 (\u -> v)))
         (V.nom (V.appClo c1 (\u -> v))))

defEqTypeF : Conv -> P.CtxShape -> V.Ty -> V.Ty -> EqM
defEqTypeF r cs a a' = case a of
  VU u -> case a' of
    VU u' -> if P.eqUniverse u u' then ok else Left (UnequalTys cs a a')
    _ -> Left (UnequalTys cs a a')
  VDecode h sp u described el -> case a' of
    VDecode h' sp' u' described' el' -> r.bare cs h sp h' sp'
    _ -> Left (UnequalTys cs a a')
  -- (an implicit argument's default is not the type's: two that differ
  -- in it alone are equal)
  VFunction level dom cod implicit dflt -> case a' of
    VFunction level' dom' cod' implicit' dflt' ->
      if P.eqLevel level level'
        then do
          r.ty cs dom dom'
          defEqCloTypeF r cs dom cod cod'
      else Left (UnequalTys cs a a')
    _ -> Left (UnequalTys cs a a')
  VPrimInt -> case a' of
    VPrimInt -> ok
    _ -> Left (UnequalTys cs a a')
  VPrimFloat -> case a' of
    VPrimFloat -> ok
    _ -> Left (UnequalTys cs a a')
  VPrimString -> case a' of
    VPrimString -> ok
    _ -> Left (UnequalTys cs a a')
  VPrimRune -> if V.isRune a' then ok else Left (UnequalTys cs a a')
  VPrimArray b -> case a' of
    VPrimArray b' -> r.ty cs b b'
    _ -> Left (UnequalTys cs a a')
  VFixed w -> if V.isFixed w a' then ok else Left (UnequalTys cs a a')
  _ -> Left (UnequalTys cs a a')

defEqHeadF : P.CtxShape -> V.Head -> V.Head -> EqM
defEqHeadF cs h h' =
  if eqHead h h' || V.headIsError h || V.headIsError h' then ok
  else Left (UnequalNeus cs h SpId h' SpId)

defEqBareF : Conv
           -> P.CtxShape
           -> V.Head
           -> V.Spine V.V
           -> V.Head
           -> V.Spine V.V
           -> EqM
defEqBareF r cs h sp h' sp' = case sp of
  SpId -> case sp' of
    SpId -> defEqHeadF cs h h'
    _ -> Left (UnequalNeus cs h sp h' sp')
  SpApp sq v -> case sp' of
    SpApp sq' v' -> do
      r.bare cs h sq h' sq'
      r.el cs v v'
    _ -> Left (UnequalNeus cs h sp h' sp')
  SpProj sq x -> case sp' of
    SpProj sq' x' -> do
      r.bare cs h sq h' sq'
      if strEq x x' then ok else Left (UnequalNeus cs h sp h' sp')
    _ -> Left (UnequalNeus cs h sp h' sp')
  SpSpec sq x v -> case sp' of
    SpSpec sq' x' v' -> do
      r.bare cs h sq h' sq'
      if strEq x x' then ok else Left (UnequalNeus cs h sp h' sp')
      r.el cs v v'
    _ -> Left (UnequalNeus cs h sp h' sp')

-- | eta: a neutral of record type is its fields, of function type a lambda
canon : V.V -> V.V
canon v = case v of
  VNeu h sp ty expansion desc -> case V.behavior (P.forceTh ty) of
    LikeRecord level capture fieldTypes -> case expansion MkUnit of
      IntoCons fields -> VCons (D.mapD (\f -> Nom f) fields)
      NotApplicable -> abandon
    LikeFunction level dom cod implicit ->
      VLam ty (MkClo "x" LNil (\w -> V.app v (\u -> V.localsAt w 0)))
    _ -> v
  _ -> v

eqFields : Conv -> P.CtxShape -> List (V.Ev V.V) -> List (V.Ev V.V) -> EqM
eqFields r cs Nil ys = ok
eqFields r cs (Cons x xs) Nil = ok
eqFields r cs (Cons x xs) (Cons y ys) = do
  r.el cs (V.nom x) (V.nom y)
  eqFields r cs xs ys

defEqCanon : Conv -> P.CtxShape -> V.V -> V.V -> V.V -> V.V -> EqM
defEqCanon r cs v v' cv cv' = case cv of
  VNeu h sp ty expansion desc -> case cv' of
    VNeu h' sp' ty' expansion' desc' -> r.bare cs h sp h' sp'
    _ -> Left (UnequalEls cs v v')
  VCode a -> case cv' of
    VCode a' -> r.ty cs a a'
    _ -> Left (UnequalEls cs v v')
  VLam a c -> case cv' of
    VLam a' c' -> defEqCloTermF r cs (V.lamDom (P.forceTh a)) c c'
    _ -> Left (UnequalEls cs v v')
  VCons d -> case cv' of
    VCons d' ->
      eqFields
        r
        cs
        (List.map (\x -> x) (A.toList d.values))
        (List.map (\x -> x) (A.toList d'.values))
    _ -> Left (UnequalEls cs v v')
  VOpaque -> ok

defEqTermF : Conv -> P.CtxShape -> V.V -> V.V -> EqM
defEqTermF r cs VOpaque v' = ok
defEqTermF r cs v VOpaque = ok
defEqTermF r cs v v' = defEqCanon r cs v v' (canon v) (canon v')

eq : Conv
eq =
  { ty = \cs a a' -> defEqTypeF eq cs a a'
  , el = \cs v v' -> defEqTermF eq cs v v'
  , bare = \cs h sp h' sp' -> defEqBareF eq cs h sp h' sp'
  }

-- | >>> holds (defEqTy P.emptyShape (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing) (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing))
-- | True
-- | >>> holds (defEqTy P.emptyShape VPrimInt VPrimString)
-- | False
defEqTy : P.CtxShape -> V.Ty -> V.Ty -> EqM
defEqTy cs a a' = eq.ty cs a a'

-- | eta: the identity lambda against a free local of function type
-- | >>> holds (defEqEl P.emptyShape (V.local 0 (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing)) (VLam (\u -> VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing) (MkClo "x" LNil (\w -> V.app (V.local 0 (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing)) (\u -> V.localsAt w 0)))))
-- | True
-- |
-- | opaque is equal to anything
-- | >>> holds (defEqEl P.emptyShape VOpaque (V.local 3 VPrimInt))
-- | True
defEqEl : P.CtxShape -> V.V -> V.V -> EqM
defEqEl cs v v' = eq.el cs v v'
