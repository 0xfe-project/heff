-- Definitional equality.  There is no type-directed conversion: every
-- element of a small type is `VOpaque` already, and `VOpaque` is equal
-- to anything.  The four judgments call one another, so they are the
-- fields of one record, `eq`.  An error carries the context's shape and
-- the two sides, for the message.

module heff.elab.conversion

import array as Array
import heff.util.dict as Dict
import heff.elab.params as Params
import heff.elab.value as Value

data EqErr
  = UnequalTys Params.CtxShape Value.Ty Value.Ty
  | UnequalEls Params.CtxShape Value.V Value.V
  | UnequalNeus Params.CtxShape Value.Head (Value.Spine
                                              Value.V) Value.Head (Value.Spine
                                                                     Value.V)
  -- | a solution would mention an error hole (it is not given)
  | MentionsError
  -- | a solution would mention the local of this level where it is not
  -- | bound (a metavariable made outside it)
  | Escapes Int

type EqM = Either EqErr Unit

-- (`do` in this module sequences these checks)
bind : {a b : Type} -> Either EqErr a -> (a -> Either EqErr b) -> Either EqErr b
bind (Left e) f = Left e
bind (Right x) f = f x

ok : EqM
ok = Right MkUnit

holds : EqM -> Bool
holds (Right _) = True
holds (Left _) = False

eqHead : Value.Head -> Value.Head -> Bool
eqHead (HLocal i) (HLocal j) = i == j
eqHead (HGlobal x) (HGlobal y) = strEq x y
eqHead (HMeta m) (HMeta m') = m == m'
eqHead HError HError = True
eqHead _ _ = False

type Conv =
  { ty : Params.CtxShape -> Value.Ty -> Value.Ty -> EqM
  , el : Params.CtxShape -> Value.V -> Value.V -> EqM
  , bare :
        Params.CtxShape
        -> Value.Head
        -> Value.Spine Value.V
        -> Value.Head
        -> Value.Spine Value.V
        -> EqM
  }

cloBinder : {v a : Type} -> Value.Clo v a -> Value.Clo v a -> String
cloBinder c0 c1 = case Value.cloName c0 of
  Just x -> x
  Nothing -> case Value.cloName c1 of
    Just x -> x
    Nothing -> "x"

defEqCloTypeF : Conv
              -> Params.CtxShape
              -> Value.Ty
              -> Value.Clo Value.V Value.Ty
              -> Value.Clo Value.V Value.Ty
              -> EqM
defEqCloTypeF r cs a c0 c1 =
  Value.withV
    (Value.local cs.len a)
    (\v ->
       r.ty
         (Params.bindShape (cloBinder c0 c1) cs)
         (Value.nom (Value.appClo c0 (\u -> v)))
         (Value.nom (Value.appClo c1 (\u -> v))))

defEqCloTermF : Conv
              -> Params.CtxShape
              -> Value.Ty
              -> Value.Clo Value.V Value.V
              -> Value.Clo Value.V Value.V
              -> EqM
defEqCloTermF r cs a c0 c1 =
  Value.withV
    (Value.local cs.len a)
    (\v ->
       r.el
         (Params.bindShape (cloBinder c0 c1) cs)
         (Value.nom (Value.appClo c0 (\u -> v)))
         (Value.nom (Value.appClo c1 (\u -> v))))

defEqTypeF : Conv -> Params.CtxShape -> Value.Ty -> Value.Ty -> EqM
defEqTypeF r cs a@(VU u) a' = case a' of
  VU u' -> if Params.eqUniverse u u' then ok else Left (UnequalTys cs a a')
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@(VDecode h sp u described el) a' = case a' of
  VDecode h' sp' u' described' el' -> r.bare cs h sp h' sp'
  _ -> Left (UnequalTys cs a a')
-- (an implicit argument's default is not the type's: two that differ
-- in it alone are equal)
defEqTypeF r cs a@(VFunction level dom cod implicit dflt _) a' = case a' of
  VFunction level' dom' cod' implicit' dflt' _ ->
    if Params.eqLevel level level'
    then do
      r.ty cs dom dom'
      defEqCloTypeF r cs dom cod cod'
    else Left (UnequalTys cs a a')
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@VPrimInt a' = case a' of
  VPrimInt -> ok
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@VPrimFloat a' = case a' of
  VPrimFloat -> ok
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@VPrimString a' = case a' of
  VPrimString -> ok
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@VPrimRune a' =
  if Value.isRune a' then ok else Left (UnequalTys cs a a')
defEqTypeF r cs a@(VPrimArray b) a' = case a' of
  VPrimArray b' -> r.ty cs b b'
  _ -> Left (UnequalTys cs a a')
defEqTypeF r cs a@(VFixed w) a' =
  if Value.isFixed w a' then ok else Left (UnequalTys cs a a')
defEqTypeF r cs a a' = Left (UnequalTys cs a a')

defEqHeadF : Params.CtxShape -> Value.Head -> Value.Head -> EqM
defEqHeadF cs h h' =
  if eqHead h h' || Value.headIsError h || Value.headIsError h' then ok
  else Left (UnequalNeus cs h SpId h' SpId)

defEqBareF : Conv
           -> Params.CtxShape
           -> Value.Head
           -> Value.Spine Value.V
           -> Value.Head
           -> Value.Spine Value.V
           -> EqM
defEqBareF r cs h sp@SpId h' sp' = case sp' of
  SpId -> defEqHeadF cs h h'
  _ -> Left (UnequalNeus cs h sp h' sp')
defEqBareF r cs h sp@(SpApp sq v) h' sp' = case sp' of
  SpApp sq' v' -> do
    r.bare cs h sq h' sq'
    r.el cs v v'
  _ -> Left (UnequalNeus cs h sp h' sp')
defEqBareF r cs h sp@(SpProj sq x) h' sp' = case sp' of
  SpProj sq' x' -> do
    r.bare cs h sq h' sq'
    if strEq x x' then ok else Left (UnequalNeus cs h sp h' sp')
  _ -> Left (UnequalNeus cs h sp h' sp')
defEqBareF r cs h sp@(SpSpec sq x v) h' sp' = case sp' of
  SpSpec sq' x' v' -> do
    r.bare cs h sq h' sq'
    if strEq x x' then ok else Left (UnequalNeus cs h sp h' sp')
    r.el cs v v'
  _ -> Left (UnequalNeus cs h sp h' sp')

-- | eta: a neutral of record type is its fields, of function type a lambda
canon : Value.V -> Value.V
canon v@(VNeu h sp ty expansion desc) = case Value.behavior
    (Params.forceTh ty) of
  LikeRecord level capture fieldTypes -> case expansion MkUnit of
    IntoCons fields -> VCons (Dict.mapD (\f -> Nom f) fields)
    NotApplicable -> abandon
  LikeFunction level dom cod implicit ->
    VLam ty (MkClo "x" LNil (\w -> Value.app v (\u -> Value.localsAt w 0)))
  _ -> v
canon v = v

eqFields : Conv
         -> Params.CtxShape
         -> List (Value.Ev Value.V)
         -> List (Value.Ev Value.V)
         -> EqM
eqFields r cs [] ys = ok
eqFields r cs (x :: xs) [] = ok
eqFields r cs (x :: xs) (y :: ys) = do
  r.el cs (Value.nom x) (Value.nom y)
  eqFields r cs xs ys

defEqCanon : Conv
           -> Params.CtxShape
           -> Value.V
           -> Value.V
           -> Value.V
           -> Value.V
           -> EqM
defEqCanon r cs v v' (VNeu h sp ty expansion desc) cv' = case cv' of
  VNeu h' sp' ty' expansion' desc' -> r.bare cs h sp h' sp'
  _ -> Left (UnequalEls cs v v')
defEqCanon r cs v v' (VCode a) cv' = case cv' of
  VCode a' -> r.ty cs a a'
  _ -> Left (UnequalEls cs v v')
defEqCanon r cs v v' (VLam a c) cv' = case cv' of
  VLam a' c' -> defEqCloTermF r cs (Value.lamDom (Params.forceTh a)) c c'
  _ -> Left (UnequalEls cs v v')
defEqCanon r cs v v' (VCons d) cv' = case cv' of
  VCons d' ->
    eqFields
      r
      cs
      (List.map (\x -> x) (Array.toList d.values))
      (List.map (\x -> x) (Array.toList d'.values))
  _ -> Left (UnequalEls cs v v')
defEqCanon r cs v v' VOpaque cv' = ok

defEqTermF : Conv -> Params.CtxShape -> Value.V -> Value.V -> EqM
defEqTermF r cs VOpaque v' = ok
defEqTermF r cs v VOpaque = ok
defEqTermF r cs v v' = defEqCanon r cs v v' (canon v) (canon v')

-- | types and terms, equal or not
-- | >>> holds (eq.ty Params.emptyShape (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing Nothing) (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing Nothing))
-- | True
-- | >>> holds (eq.ty Params.emptyShape VPrimInt VPrimString)
-- | False
-- |
-- | eta: the identity lambda against a free local of function type
-- | >>> holds (eq.el Params.emptyShape (Value.local 0 (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing Nothing)) (VLam (\u -> VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing Nothing) (MkClo "x" LNil (\w -> Value.app (Value.local 0 (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing Nothing)) (\u -> Value.localsAt w 0)))))
-- | True
-- |
-- | opaque is equal to anything
-- | >>> holds (eq.el Params.emptyShape VOpaque (Value.local 3 VPrimInt))
-- | True
eq : Conv
eq =
  { ty = \cs a a' -> defEqTypeF eq cs a a'
  , el = \cs v v' -> defEqTermF eq cs v v'
  , bare = \cs h sp h' sp' -> defEqBareF eq cs h sp h' sp'
  }
