-- The fixed-width numeric types: the integers of 8, 16, 32 and 64 bits,
-- signed (`Int8` ... `Int64`) and not (`UInt8` ... `UInt64`), and the
-- 32-bit float, `Float32`.  Their names are keywords, as `Int`'s and
-- `Float64`'s are.  An integer of one wraps around, as the machine's does:
-- its value is the one of the type equal to it modulo 2^bits.  Each is
-- given its operations by primitives named after it (`int32Add`), which
-- lib/int32.hf and the others name.

data Fixed = I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 | F32

-- | its name, the keyword
fixedName : Fixed -> String
fixedName I8 = "Int8"
fixedName I16 = "Int16"
fixedName I32 = "Int32"
fixedName I64 = "Int64"
fixedName U8 = "UInt8"
fixedName U16 = "UInt16"
fixedName U32 = "UInt32"
fixedName U64 = "UInt64"
fixedName F32 = "Float32"

-- | its tag, as a value is shown
showFixed : Fixed -> String
showFixed I8 = "I8"
showFixed I16 = "I16"
showFixed I32 = "I32"
showFixed I64 = "I64"
showFixed U8 = "U8"
showFixed U16 = "U16"
showFixed U32 = "U32"
showFixed U64 = "U64"
showFixed F32 = "F32"

-- | every one
-- | >>> List.map fixedName allFixed
-- | Cons "Int8" (Cons "Int16" (Cons "Int32" (Cons "Int64" (Cons "UInt8" (Cons "UInt16" (Cons "UInt32" (Cons "UInt64" (Cons "Float32" Nil))))))))
allFixed : List Fixed
allFixed = [I8, I16, I32, I64, U8, U16, U32, U64, F32]

-- | the one a keyword names
fixedOfName : String -> Maybe Fixed
fixedOfName x = List.find (\w -> strEq (fixedName w) x) allFixed

-- | whether it is one's name (a keyword: src/heff/syntax/fmt/lex.hf has them)
isFixedName : String -> Bool
isFixedName x = maybe False (\_ -> True) (fixedOfName x)

eqFixed : Fixed -> Fixed -> Bool
eqFixed a b = strEq (fixedName a) (fixedName b)

isFloat32 : Fixed -> Bool
isFloat32 F32 = True
isFloat32 _ = False

fixedBits : Fixed -> Int
fixedBits I8 = 8
fixedBits I16 = 16
fixedBits I32 = 32
fixedBits I64 = 64
fixedBits U8 = 8
fixedBits U16 = 16
fixedBits U32 = 32
fixedBits U64 = 64
fixedBits F32 = 32

fixedSigned : Fixed -> Bool
fixedSigned U8 = False
fixedSigned U16 = False
fixedSigned U32 = False
fixedSigned U64 = False
fixedSigned _ = True

twoTo : Int -> Int
twoTo n = if n <= 0 then 1 else 2 * twoTo (n - 1)

-- | the least value of an integer type
-- | >>> fixedMin I8
-- | -128
fixedMin : Fixed -> Int
fixedMin w = if fixedSigned w then 0 - twoTo (fixedBits w - 1) else 0

-- | the greatest
-- | >>> fixedMax U64
-- | 18446744073709551615
fixedMax : Fixed -> Int
fixedMax w =
  if fixedSigned w then twoTo (fixedBits w - 1) - 1 else twoTo (fixedBits w) - 1

-- | whether an integer is a value of the type
fitsFixed : Fixed -> Int -> Bool
fitsFixed w n = fixedMin w <= n && n <= fixedMax w

-- | the value of the type an integer wraps around to
-- | >>> List.map (wrapFixed I8) [127, 128, 0 - 129, 256]
-- | Cons 127 (Cons (-128) (Cons 127 (Cons 0 Nil)))
-- | >>> List.map (wrapFixed U32) [0 - 1, twoTo 32]
-- | Cons 4294967295 (Cons 0 Nil)
wrapFixed : Fixed -> Int -> Int
wrapFixed w n = fixedMin w + (n - fixedMin w) % twoTo (fixedBits w)

-- | whether a float is too large for a `Float32`: what rounds to an
-- | infinity (from 2^128 - 2^103, halfway between the greatest `Float32`
-- | and 2^128, on)
-- | >>> List.map float32Overflows [3.4028234663852886e38, 3.4028235677973366e38]
-- | Cons False (Cons True Nil)
float32Overflows : Float64 -> Bool
float32Overflows x =
  x >=. toFloat (twoTo 128 - twoTo 103) || x <=. toFloat (twoTo 103 - twoTo 128)

-- Primitives
--------------------------------------------------------------------------------

-- | what each one's primitives are named by: `int32` of `int32Add`
primPrefix : Fixed -> String
primPrefix I8 = "int8"
primPrefix I16 = "int16"
primPrefix I32 = "int32"
primPrefix I64 = "int64"
primPrefix U8 = "uint8"
primPrefix U16 = "uint16"
primPrefix U32 = "uint32"
primPrefix U64 = "uint64"
primPrefix F32 = "float32"

-- | what a primitive of theirs does: of two values of the type (`OpAdd`
-- | to `OpShr`; `OpShl` and `OpShr` shift by the second modulo the bits),
-- | or of one
data FixedOp
  = OpAdd
  | OpSub
  | OpMul
  | OpDiv
  | OpRem
  | OpEq
  | OpLt
  | OpLe
  | OpAnd
  | OpOr
  | OpXor
  | OpShl
  | OpShr
  | OpShow
  | OpFromInt
  | OpToInt
  | OpSqrt
  | OpFromFloat
  | OpToFloat
  | OpFloor

-- | its name, after the type's prefix
opName : FixedOp -> String
opName OpAdd = "Add"
opName OpSub = "Sub"
opName OpMul = "Mul"
opName OpDiv = "Div"
opName OpRem = "Rem"
opName OpEq = "Eq"
opName OpLt = "Lt"
opName OpLe = "Le"
opName OpAnd = "And"
opName OpOr = "Or"
opName OpXor = "Xor"
opName OpShl = "Shl"
opName OpShr = "Shr"
opName OpShow = "Show"
opName OpFromInt = "FromInt"
opName OpToInt = "ToInt"
opName OpSqrt = "Sqrt"
opName OpFromFloat = "FromFloat"
opName OpToFloat = "ToFloat"
opName OpFloor = "Floor"

-- | how many arguments it takes
opArity : FixedOp -> Int
opArity OpShow = 1
opArity OpFromInt = 1
opArity OpToInt = 1
opArity OpSqrt = 1
opArity OpFromFloat = 1
opArity OpToFloat = 1
opArity OpFloor = 1
opArity _ = 2

-- | whether it may fail (`abandon`): a division by zero, the floor of
-- | what is not finite
opFails : FixedOp -> Bool
opFails OpDiv = True
opFails OpRem = True
opFails OpFloor = True
opFails _ = False

-- | an integer type's operations
intOps : List FixedOp
intOps =
  [ OpAdd
  , OpSub
  , OpMul
  , OpDiv
  , OpRem
  , OpEq
  , OpLt
  , OpLe
  , OpAnd
  , OpOr
  , OpXor
  , OpShl
  , OpShr
  , OpShow
  , OpFromInt
  , OpToInt
  ]

-- | `Float32`'s
float32Ops : List FixedOp
float32Ops =
  [ OpAdd
  , OpSub
  , OpMul
  , OpDiv
  , OpEq
  , OpLt
  , OpLe
  , OpSqrt
  , OpShow
  , OpFromFloat
  , OpToFloat
  , OpFromInt
  , OpFloor
  ]

opsOf : Fixed -> List FixedOp
opsOf w = if isFloat32 w then float32Ops else intOps

-- | a primitive of one of them: the type, and what it does
type FixedPrim = { fixed : Fixed, op : FixedOp }

mkFixedPrim : Fixed -> FixedOp -> FixedPrim
mkFixedPrim w o = { fixed = w, op = o }

-- | every primitive of every one
-- | >>> List.length fixedPrims
-- | 141
fixedPrims : List FixedPrim
fixedPrims = List.concatMap (\w -> List.map (mkFixedPrim w) (opsOf w)) allFixed

fixedPrimName : FixedPrim -> String
fixedPrimName p = primPrefix p.fixed ^ opName p.op

fixedPrimFails : FixedPrim -> Bool
fixedPrimFails p = opFails p.op

-- | the primitive of that name, if it is one of theirs
-- | >>> maybe "" fixedPrimName (fixedPrimOf "uint16Shr")
-- | "uint16Shr"
fixedPrimOf : String -> Maybe FixedPrim
fixedPrimOf x = case List.find (\w -> startsWith (primPrefix w) x) allFixed of
  Just w ->
    maybe
      Nothing
      (\o -> Just (mkFixedPrim w o))
      (List.find (\o -> strEq (primPrefix w ^ opName o) x) (opsOf w))
  Nothing -> Nothing
