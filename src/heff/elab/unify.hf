-- Unification: conversion-with-solving -- the rules of conversion, plus pattern unification with
-- pruning.  A unification is a computation in any world `w`
-- with two effects in it: the elaboration's core state (the
-- metavariables, `ms`) and failing with a conversion error (`uf`) --
-- nothing else of elaboration's.  heff.elab.meta runs it in `Elab`.
-- The solver's judgments are one knot record, `uk`, for a world.

import array as Array
import co
import exception as Exception
import heff.elab.conversion as Conversion
import heff.util.dict as Dict
import heff.elab.environment as Environment
import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.elab.params as Params
import heff.syntax.surfaceprint as SurfacePrint
import heff.elab.syntax as Syntax
import heff.elab.value as Value
import std.map as Map
import state as State

uGets : {w : HFunctor}
      -> {{ms : State.state Environment.StCore <: w}}
      -> {{uf : Exception.exception Conversion.EqErr <: w}}
      -> {a : Type}
      -> (Environment.StCore -> a)
      -> Co w a
uGets f = op (ms (Get f)) val

uModify : {w : HFunctor}
        -> {{ms : State.state Environment.StCore <: w}}
        -> {{uf : Exception.exception Conversion.EqErr <: w}}
        -> (Environment.StCore -> Environment.StCore)
        -> Co w Unit
uModify f = bind (uGets f) (\c -> op (ms (Put c (MkUnit : Unit))) val)

throwU : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> {a : Type}
       -> Conversion.EqErr
       -> Co w a
throwU err = op (uf (Throw err)) val

catchU : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> {a : Type}
       -> Co w a
       -> (Conversion.EqErr -> Co w a)
       -> Co w a
catchU m h = op (uf (Catch m h)) val

forceU : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> Value.V
       -> Co w Value.V
forceU v = uGets (\c -> Value.forceEl c.metas v)

forceTU : {w : HFunctor}
        -> {{ms : State.state Environment.StCore <: w}}
        -> {{uf : Exception.exception Conversion.EqErr <: w}}
        -> Value.Ty
        -> Co w Value.Ty
forceTU t = uGets (\c -> Value.forceTy c.metas t)

-- Flexible heads
--------------------------------------------------------------------------------

flexOf : Value.V -> Maybe (Pair Int (Value.Spine Value.V))
flexOf (VNeu (HMeta m) sp ty expansion desc) = Just (MkPair m sp)
flexOf v = Nothing

-- | a type that is a metavariable, as an element (so it can be solved)
flexTy : Value.Ty -> Maybe (Pair Int (Value.Spine Value.V))
flexTy (VDecode (HMeta m) sp u described el) = Just (MkPair m sp)
flexTy t = Nothing

isFlexTy : Value.Ty -> Bool
isFlexTy t = case flexTy t of
  Just _ -> True
  Nothing -> False

-- Miller patterns
--------------------------------------------------------------------------------

-- | an argument of a flexible neutral, in a Miller pattern: a variable
-- | (its level), or the definition being elaborated itself
data PatArg = PVar Int | PSelf

eqPatArg : PatArg -> PatArg -> Bool
eqPatArg (PVar l) (PVar l') = l == l'
eqPatArg PSelf PSelf = True
eqPatArg _ _ = False

eqPatArgs : List PatArg -> List PatArg -> Bool
eqPatArgs Nil Nil = True
eqPatArgs (Cons a as) (Cons b bs) = eqPatArg a b && eqPatArgs as bs
eqPatArgs _ _ = False

patVarsOf : List PatArg -> List Int
patVarsOf Nil = Nil
patVarsOf (Cons (PVar l) rest) = Cons l (patVarsOf rest)
patVarsOf (Cons PSelf rest) = patVarsOf rest

distinct : List Int -> Bool
distinct Nil = True
distinct (Cons x xs) = not (List.elemBy (\a b -> a == b) x xs) && distinct xs

isSelfGlobal : Maybe String -> String -> Bool
isSelfGlobal (Just sk) k = strEq sk k
isSelfGlobal Nothing k = False

patStep : Maybe String -> Value.V -> Maybe (List PatArg) -> Maybe (List PatArg)
patStep selfKey v Nothing = Nothing
patStep selfKey (VNeu (HLocal l) SpId _ _ _) (Just rest) =
  Just (Cons (PVar l) rest)
patStep selfKey (VNeu (HGlobal k) SpId _ _ _) (Just rest) =
  if isSelfGlobal selfKey k then Just (Cons PSelf rest) else Nothing
patStep selfKey v (Just rest) = Nothing

patSpine : Maybe String
         -> Value.MetaCtx
         -> Value.Spine Value.V
         -> Maybe (List PatArg)
patSpine selfKey mc SpId = Just Nil
patSpine selfKey mc (SpApp s v) =
  patStep selfKey (Value.forceEl mc v) (patSpine selfKey mc s)
patSpine selfKey mc _ = Nothing

-- | the arguments of a flexible neutral, if they are distinct variables
-- | (or the self) -- a Miller pattern; outermost last
patternArgs : Maybe String
            -> Value.MetaCtx
            -> Value.Spine Value.V
            -> Maybe (List PatArg)
patternArgs selfKey mc sp = case patSpine selfKey mc sp of
  Nothing -> Nothing
  Just items ->
    if distinct (patVarsOf items) then Just (List.reverse items) else Nothing

-- List helpers
--------------------------------------------------------------------------------

nth : {a : Type} -> List a -> Int -> Maybe a
nth Nil i = Nothing
nth (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nth xs (i - 1)

mapWithIndexL : {a b : Type} -> Int -> (Int -> a -> b) -> List a -> List b
mapWithIndexL i f Nil = Nil
mapWithIndexL i f (Cons x xs) = Cons (f i x) (mapWithIndexL (i + 1) f xs)

zipL : {a b : Type} -> List a -> List b -> List (Pair a b)
zipL (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipL xs ys)
zipL _ _ = Nil

catMaybes : {a : Type} -> List (Maybe a) -> List a
catMaybes Nil = Nil
catMaybes (Cons (Just x) xs) = Cons x (catMaybes xs)
catMaybes (Cons Nothing xs) = catMaybes xs

anyL : {a : Type} -> (a -> Bool) -> List a -> Bool
anyL p Nil = False
anyL p (Cons x xs) = p x || anyL p xs

appendL : {a : Type} -> List a -> List a -> List a
appendL Nil ys = ys
appendL (Cons x xs) ys = Cons x (appendL xs ys)

concatMapL : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapL f Nil = Nil
concatMapL f (Cons x xs) = appendL (f x) (concatMapL f xs)

traverseU : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> {a b : Type}
          -> (a -> Co w b)
          -> List a
          -> Co w (List b)
traverseU = traverse (mo := instanceMonadCo)

forU : {w : HFunctor}
     -> {{ms : State.state Environment.StCore <: w}}
     -> {{uf : Exception.exception Conversion.EqErr <: w}}
     -> {a : Type}
     -> List a
     -> (a -> Co w Unit)
     -> Co w Unit
forU Nil f = val MkUnit
forU (Cons x xs) f = bind (f x) (\u -> forU xs f)

-- Postponing, poisoning
--------------------------------------------------------------------------------

postponeU : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> Params.CtxShape
          -> Value.V
          -> Value.V
          -> Co w Unit
postponeU cs l r =
  uModify
    (\c ->
       Environment.setPostponed
         (Cons { shape = cs, left = l, right = r, failed = False } c.postponed)
         c)

-- | the unsolved metavariables in a value, `depth` deep (a record type's
-- | fields are not looked into)
type MetasK =
  { mel : Int -> Int -> Value.V -> List Int
  , mty : Int -> Int -> Value.Ty -> List Int
  , msp : Int -> Int -> Value.Spine Value.V -> List Int
  }

metasTermF : MetasK -> Value.MetaCtx -> Int -> Int -> Value.V -> List Int
metasTermF r mc depth len v0 =
  if depth <= 0 then Nil
  else case Value.forceEl mc v0 of
    VNeu (HMeta m) sp ty expansion desc -> Cons m (r.msp depth len sp)
    VNeu h sp ty expansion desc -> r.msp depth len sp
    VCode t -> r.mty (depth - 1) len t
    VLam d c ->
      r.mel
        (depth - 1)
        (len + 1)
        (Value.nom
           (Value.appClo
              c
              (\u -> Value.local len (Value.lamDom (Params.forceTh d)))))
    VCons d ->
      concatMapL
        (\x -> r.mel (depth - 1) len (Value.nom x))
        (Array.toList d.values)
    VOpaque -> Nil

metasTypeF : MetasK -> Value.MetaCtx -> Int -> Int -> Value.Ty -> List Int
metasTypeF r mc depth len t0 =
  if depth <= 0 then Nil
  else case Value.forceTy mc t0 of
    VDecode h sp u described el -> r.mel depth len (Params.forceTh el)
    VFunction level dom cod implicit dflt ->
      appendL
        (r.mty (depth - 1) len dom)
        (r.mty
           (depth - 1)
           (len + 1)
           (Value.nom (Value.appClo cod (\u -> Value.local len dom))))
    VPrimArray a -> r.mty (depth - 1) len a
    _ -> Nil

metasSpF : MetasK
         -> Value.MetaCtx
         -> Int
         -> Int
         -> Value.Spine Value.V
         -> List Int
metasSpF r mc depth len SpId = Nil
metasSpF r mc depth len (SpApp sp a) =
  appendL (r.msp depth len sp) (r.mel (depth - 1) len a)
metasSpF r mc depth len (SpProj sp _) = r.msp depth len sp
metasSpF r mc depth len (SpSpec sp _ a) =
  appendL (r.msp depth len sp) (r.mel (depth - 1) len a)

metasK : Value.MetaCtx -> MetasK
metasK mc =
  { mel = \depth len v -> metasTermF (metasK mc) mc depth len v
  , mty = \depth len t -> metasTypeF (metasK mc) mc depth len t
  , msp = \depth len sp -> metasSpF (metasK mc) mc depth len sp
  }

-- | the metavariables a type still waits on, to `depth`
metasTy : Value.MetaCtx -> Int -> Int -> Value.Ty -> List Int
metasTy mc depth len t = (metasK mc).mty depth len t

poisonMany : {w : HFunctor}
           -> {{ms : State.state Environment.StCore <: w}}
           -> {{uf : Exception.exception Conversion.EqErr <: w}}
           -> List Int
           -> Co w Unit
poisonMany ms =
  uModify
    (\c ->
       Environment.setPoisoned
         (List.foldl (\ps m -> Map.insert ps m MkUnit) c.poisoned ms)
         c)

poisonTy : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> Int
         -> Value.Ty
         -> Co w Unit
poisonTy len t =
  bind (uGets (\c -> c.metas)) (\mc -> poisonMany ((metasK mc).mty 20 len t))

poisonEl : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> Int
         -> Value.V
         -> Co w Unit
poisonEl len v =
  bind (uGets (\c -> c.metas)) (\mc -> poisonMany ((metasK mc).mel 20 len v))

-- Zonking (solutions substituted into syntax), and instantiation
--------------------------------------------------------------------------------

absMap : {a : Type} -> (a -> a) -> Syntax.Abs a -> Syntax.Abs a
absMap f (MkAbs x b) = MkAbs x (f b)
absMap f (AbsConst b) = AbsConst (f b)

-- | under `d` binders of the body, index `d + j` is the binder x_{k-j}
substVar : List Int -> Int -> Int -> Syntax.Tm
substVar idxs d i =
  if i < d then SLocal i
  else case nth idxs (List.length idxs - 1 - (i - d)) of
    Just j -> SLocal (j + d)
    Nothing -> SLocal i

substIdx : List Int -> Int -> Int -> Int
substIdx idxs d i = case substVar idxs d i of
  SLocal j -> j
  _ -> i

type Subst =
  { el : Int -> Syntax.Tm -> Syntax.Tm, ty : Int -> Syntax.Ty -> Syntax.Ty }

substTermF : Subst -> List Int -> Int -> Syntax.Tm -> Syntax.Tm
substTermF r idxs d (SLocal i) = substVar idxs d i
substTermF r idxs d (SMetaApp m ix ty) =
  SMetaApp m (Array.map (\i -> substIdx idxs d i) ix) (r.ty d ty)
substTermF r idxs d (SCode ty) = SCode (r.ty d ty)
substTermF r idxs d (SApp f a) = SApp (r.el d f) (r.el d a)
substTermF r idxs d (SLam dd (MkAbs x b)) =
  SLam (r.ty d dd) (MkAbs x (r.el (d + 1) b))
substTermF r idxs d (SLam dd (AbsConst b)) =
  SLam (r.ty d dd) (AbsConst (r.el d b))
substTermF r idxs d (SCons dct) = SCons (Dict.mapD (r.el d) dct)
substTermF r idxs d (SProj e l) = SProj (r.el d e) l
substTermF r idxs d (STag x as) = STag x (Array.map (r.el d) as)
substTermF r idxs d (SMatch e cs) =
  SMatch
    (r.el d e)
    (Dict.mapD
       (\p -> case p of
        MkPair xs b -> MkPair xs (r.el (d + Array.length xs) b))
       cs)
substTermF r idxs d (SSpecialize e l v) = SSpecialize (r.el d e) l (r.el d v)
substTermF r idxs d (SIs e) = SIs (r.el d e)
substTermF r idxs d (SRec e) = SRec (r.el d e)
substTermF r idxs d (SFix dd (MkAbs x b)) =
  SFix (r.ty d dd) (MkAbs x (r.el (d + 1) b))
substTermF r idxs d (SFix dd (AbsConst b)) =
  SFix (r.ty d dd) (AbsConst (r.el d b))
substTermF r idxs d (SImplicit x e) = SImplicit x (r.el d e)
substTermF r idxs d t = t

substTyFields : Subst -> Int -> Int -> List Syntax.Ty -> List Syntax.Ty
substTyFields r d i Nil = Nil
substTyFields r d i (Cons ty rest) =
  Cons (r.ty (d + i) ty) (substTyFields r d (i + 1) rest)

substTypeF : Subst -> List Int -> Int -> Syntax.Ty -> Syntax.Ty
substTypeF r idxs d (SDecode e) = SDecode (r.el d e)
-- (an implicit argument's default is closed)
substTypeF r idxs d (SFunction level dom (MkAbs x b) implicit dflt) =
  SFunction level (r.ty d dom) (MkAbs x (r.ty (d + 1) b)) implicit dflt
substTypeF r idxs d (SFunction level dom (AbsConst b) implicit dflt) =
  SFunction level (r.ty d dom) (AbsConst (r.ty d b)) implicit dflt
-- (the defaults name no local but the fields before them: nothing to
-- substitute)
substTypeF r idxs d (SRecord level ft ds) =
  SRecord
    level
    { keys = ft.keys
    , byName = ft.byName
    , values = Array.fromList (substTyFields r d 0 (Array.toList ft.values))
    }
    ds
substTypeF r idxs d (SSum vs) = SSum (Dict.mapD (Array.map (r.ty d)) vs)
substTypeF r idxs d (SIsTy a) = SIsTy (r.ty d a)
substTypeF r idxs d t = t

substOf : List Int -> Subst
substOf idxs =
  { el = \d t -> substTermF (substOf idxs) idxs d t
  , ty = \d t -> substTypeF (substOf idxs) idxs d t
  }

stripLams : Int -> Syntax.Tm -> Syntax.Tm
stripLams n t =
  if n <= 0 then t
  else case t of
    SLam _ (MkAbs _ b) -> stripLams (n - 1) b
    SLam _ (AbsConst b) -> stripLams (n - 1) b
    _ -> t

-- | `sol` is closed lambdas over the body; the result is the body with
-- | each binder replaced by the local `idxs[i]`
instantiate : List Int -> Syntax.Tm -> Syntax.Tm
instantiate idxs sol = (substOf idxs).el 0 (stripLams (List.length idxs) sol)

solStxOf : Value.MetaCtx -> Int -> Maybe Syntax.Tm
solStxOf mc m = case Map.lookup mc m of
  Just e -> e.solStx
  Nothing -> Nothing

type Zonk = { el : Syntax.Tm -> Syntax.Tm, ty : Syntax.Ty -> Syntax.Ty }

zonkTermF : Zonk -> Value.MetaCtx -> Syntax.Tm -> Syntax.Tm
zonkTermF r mc (SMetaApp m idxs ty) = case solStxOf mc m of
  Just sol -> r.el (instantiate (Array.toList idxs) sol)
  Nothing -> SMetaApp m idxs (r.ty ty)
zonkTermF r mc (SCode ty) = SCode (r.ty ty)
zonkTermF r mc (SApp f a) = SApp (r.el f) (r.el a)
zonkTermF r mc (SLam d b) = SLam (r.ty d) (absMap r.el b)
zonkTermF r mc (SCons d) = SCons (Dict.mapD r.el d)
zonkTermF r mc (SProj e l) = SProj (r.el e) l
zonkTermF r mc (STag x as) = STag x (Array.map r.el as)
zonkTermF r mc (SMatch e cs) =
  SMatch
    (r.el e)
    (Dict.mapD
       (\p -> case p of
        MkPair xs b -> MkPair xs (r.el b))
       cs)
zonkTermF r mc (SSpecialize e l v) = SSpecialize (r.el e) l (r.el v)
zonkTermF r mc (SIs e) = SIs (r.el e)
zonkTermF r mc (SRec e) = SRec (r.el e)
zonkTermF r mc (SFix d b) = SFix (r.ty d) (absMap r.el b)
zonkTermF r mc (SImplicit x e) = SImplicit x (r.el e)
zonkTermF r mc t = t

zonkDefault : Zonk -> Maybe Syntax.Tm -> Maybe Syntax.Tm
zonkDefault r (Just d) = Just (r.el d)
zonkDefault r Nothing = Nothing

zonkTypeF : Zonk -> Value.MetaCtx -> Syntax.Ty -> Syntax.Ty
zonkTypeF r mc (SDecode e) = SDecode (r.el e)
zonkTypeF r mc (SFunction level dom cod implicit dflt) =
  SFunction level (r.ty dom) (absMap r.ty cod) implicit (zonkDefault r dflt)
zonkTypeF r mc (SRecord level ft ds) =
  SRecord level (Dict.mapD r.ty ft) (Dict.mapD r.el ds)
zonkTypeF r mc (SSum vs) = SSum (Dict.mapD (Array.map r.ty) vs)
zonkTypeF r mc (SIsTy a) = SIsTy (r.ty a)
zonkTypeF r mc t = t

zonker : Value.MetaCtx -> Zonk
zonker mc =
  { el = \t -> zonkTermF (zonker mc) mc t
  , ty = \t -> zonkTypeF (zonker mc) mc t
  }

zonkEl : Value.MetaCtx -> Syntax.Tm -> Syntax.Tm
zonkEl mc t = (zonker mc).el t

zonkTy : Value.MetaCtx -> Syntax.Ty -> Syntax.Ty
zonkTy mc t = (zonker mc).ty t

-- Solving: shared pieces
--------------------------------------------------------------------------------

-- | eta, but a metavariable's neutral stays itself
canonU : Value.V -> Value.V
canonU v@(VNeu (HMeta m) sp ty expansion desc) = v
canonU v = Conversion.canon v

scopeError : {w : HFunctor}
           -> {{ms : State.state Environment.StCore <: w}}
           -> {{uf : Exception.exception Conversion.EqErr <: w}}
           -> {a : Type}
           -> Co w a
scopeError = throwU (UnequalEls Params.emptyShape VOpaque VOpaque)

occursError : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> {a : Type}
            -> Co w a
occursError = throwU (UnequalEls Params.emptyShape VOpaque VOpaque)

-- | a partial renaming: the levels of `dom` that may appear, and what
-- | they become in a context of `cod` levels
type PRen = { dom : Int, cod : Int, ren : Map.Map Int Int }

lift1 : PRen -> PRen
lift1 r =
  { dom = r.dom + 1
  , cod = r.cod + 1
  , ren = Map.insert r.ren r.dom r.cod
  }

iterateLift : Int -> PRen -> PRen
iterateLift i rr = if i <= 0 then rr else iterateLift (i - 1) (lift1 rr)

renameHead : {w : HFunctor}
           -> {{ms : State.state Environment.StCore <: w}}
           -> {{uf : Exception.exception Conversion.EqErr <: w}}
           -> PRen
           -> Value.Head
           -> Co w Syntax.Tm
renameHead r (HLocal l) = case Map.lookup r.ren l of
  Just l' -> val (SLocal (r.cod - l' - 1))
  Nothing -> throwU (Escapes l)
renameHead r (HGlobal x) = val (SGlobal x)
renameHead r (HMeta m) = scopeError
renameHead r HError = throwU MentionsError

lamsU : Int -> Syntax.Tm -> Syntax.Tm
lamsU k body =
  if k <= 0 then body else lamsU (k - 1) (SLam (SU SmallU) (MkAbs "x" body))

eqBool : Bool -> Bool -> Bool
eqBool True True = True
eqBool False False = True
eqBool _ _ = False

cloBinderName : {v a : Type} -> Value.Clo v a -> String
cloBinderName c = case Value.cloName c of
  Just x -> x
  Nothing -> "x"

withTm : {a : Type} -> Syntax.Tm -> (Syntax.Tm -> a) -> a
withTm t k = k t

withVal : {a : Type} -> Value.V -> (Value.V -> a) -> a
withVal v k = k v

metaEntry : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> Int
          -> Co w Value.MetaEntry
metaEntry m =
  bind (uGets (\c -> c.metas)) (\mc -> case Map.lookup mc m of
  Just e -> val e
  Nothing -> scopeError)

solvedEntry : Value.V -> Syntax.Tm -> Value.MetaEntry -> Value.MetaEntry
solvedEntry sol stx e =
  { ty = e.ty
  , sol = Just sol
  , solStx = Just stx
  , arity = e.arity
  , name = e.name
  , span = e.span
  }

-- | store a solution for `m`
storeSol : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> Int
         -> Value.V
         -> Syntax.Tm
         -> Co w Unit
storeSol m sol stx =
  uModify (\c -> case Map.lookup c.metas m of
  Just e ->
    Environment.setMetas
      (Map.insert c.metas m (solvedEntry sol stx e))
      c.nextMeta
      c
  Nothing -> c)

-- | a solution in the trace, at the metavariable's span: its body, over
-- | one binder per local
traceSolve : {w : HFunctor}
           -> {{ms : State.state Environment.StCore <: w}}
           -> {{uf : Exception.exception Conversion.EqErr <: w}}
           -> Int
           -> Syntax.Tm
           -> Co w Unit
traceSolve m stx =
  uModify (\c -> case Map.lookup c.metas m of
  Just e ->
    Environment.pushTraceAt
      e.span
      "solve"
      (\u ->
         "?"
         ^ show m
         ^ " ("
         ^ e.name
         ^ ") := "
         ^ SurfacePrint.printEl
           SurfacePrint.plainImplicits
           0
           Nil
           (zonkEl c.metas stx))
      c
  Nothing -> c)

-- | the state with a new metavariable, numbered next
newMetaIn : Value.MetaEntry
          -> Int
          -> Value.Ty
          -> Environment.StCore
          -> Environment.StCore
newMetaIn entry arity ty c =
  Environment.setMetas
    (Map.insert
       c.metas
       c.nextMeta
       { ty = ty
       , sol = Nothing
       , solStx = Nothing
       , arity = arity
       , name = entry.name
       , span = entry.span
       })
    (c.nextMeta + 1)
    c

-- | a fresh metavariable from an old entry's name and span
newMetaFrom : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> Value.MetaEntry
            -> Int
            -> Value.Ty
            -> Co w Int
newMetaFrom entry arity ty = do
  n <- uGets (\c -> c.nextMeta)
  uModify (newMetaIn entry arity ty)
  val n

-- | the positions where two equal-length patterns agree
agreeing : List PatArg -> List PatArg -> List Int
agreeing args args' =
  catMaybes
    (mapWithIndexL
       0
       (\i p -> case p of
        MkPair a1 a2 -> if eqPatArg a1 a2 then Just i else Nothing)
       (zipL args args'))

inRen : PRen -> PatArg -> Bool
inRen pr (PVar l) = Map.member pr.ren l
inRen pr PSelf = False

renInsert : Map.Map Int Int -> Pair Int PatArg -> Map.Map Int Int
renInsert mp (MkPair i (PVar l)) = Map.insert mp l i
renInsert mp (MkPair i PSelf) = mp

renOf : Params.CtxShape -> List PatArg -> PRen
renOf cs args =
  { dom = cs.len
  , cod = List.length args
  , ren =
      List.foldl renInsert Map.empty (mapWithIndexL 0 (\i a -> MkPair i a) args)
  }

-- The judgments and renamings, knotted
--------------------------------------------------------------------------------

type UK (w : HFunctor) =
  { uty :
        Globals.Globals -> Params.CtxShape -> Value.Ty -> Value.Ty -> Co w Unit
  , uel : Globals.Globals -> Params.CtxShape -> Value.V -> Value.V -> Co w Unit
  , ubare :
        Globals.Globals
        -> Params.CtxShape
        -> Value.Head
        -> Value.Spine Value.V
        -> Value.Head
        -> Value.Spine Value.V
        -> Co w Unit
  , solve :
        Globals.Globals
        -> Params.CtxShape
        -> Int
        -> Value.Spine Value.V
        -> Value.V
        -> Value.V
        -> Co w Unit
  , ren : Globals.Globals -> Int -> PRen -> Value.V -> Co w Syntax.Tm
  , renEv : Globals.Globals -> Int -> PRen -> Value.Ev Value.V -> Co w Syntax.Tm
  , renTy : Globals.Globals -> Int -> PRen -> Value.Ty -> Co w Syntax.Ty
  , renEvTy :
        Globals.Globals -> Int -> PRen -> Value.Ev Value.Ty -> Co w Syntax.Ty
  , renFlex :
        Globals.Globals
        -> Int
        -> PRen
        -> Int
        -> Value.Spine Value.V
        -> Co w Syntax.Tm
  }

-- | `?storeM := λx₁…xₙ. ?new x_kept`, from an old entry's name and
-- | span; the type must be closed (renamed into the empty context, with
-- | the occurs check against `occursM`)
solveWithPruned : {w : HFunctor}
                -> {{ms : State.state Environment.StCore <: w}}
                -> {{uf : Exception.exception Conversion.EqErr <: w}}
                -> (UK w)
                -> Globals.Globals
                -> Int
                -> Int
                -> Value.MetaEntry
                -> Int
                -> List Int
                -> Co w Value.V
solveWithPruned r g occursM storeM entry n kept =
  bind
    (r.renTy g occursM { dom = entry.arity, cod = 0, ren = Map.empty } entry.ty)
    (\tyStx ->
       bind
         (newMetaFrom
            entry
            (List.length kept)
            (Value.nom (Eval.evalTy g N tyStx LNil)))
         (\new ->
            withTm
              (lamsU
                 n
                 (SMetaApp
                    new
                    (Array.fromList (List.map (\i -> n - i - 1) kept))
                    tyStx))
              (\stx ->
                 withVal
                   (Value.nom (Eval.eval g N stx LNil))
                   (\sol ->
                      bind
                        (storeSol storeM sol stx)
                        (\u ->
                           bind (traceSolve storeM stx) (\u2 -> val sol))))))

-- | rename the right-hand side; one mentioning an error hole is no
-- | solution (the metavariable is left as it is)
solveRhs : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> (UK w)
         -> Globals.Globals
         -> Params.CtxShape
         -> Int
         -> List PatArg
         -> Value.V
         -> Co w Unit
solveRhs r g cs m args rhs =
  bind
    (catchU
       (bind
          (r.ren g m (renOf cs args) rhs)
          (\b -> val (Just b))) (\e -> case e of
     MentionsError -> val Nothing
     _ -> throwU e)) (\(renamed : Maybe Syntax.Tm) -> case renamed of
  Nothing -> val MkUnit
  Just body ->
    withTm
      (lamsU (List.length args) body)
      (\stx ->
         withVal
           (Value.nom (Eval.eval g N stx LNil))
           (\sol ->
              bind
                (storeSol m sol stx)
                (\u1 ->
                   bind
                     (uGets (\c -> Map.member c.poisoned m))
                     (\p ->
                        bind
                          (if p then poisonEl 0 sol else val MkUnit)
                          (\u2 -> traceSolve m stx))))))

-- | `?m sp := rhs`; `self` is the flexible side, kept for postponing
solveF : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> (UK w)
       -> Globals.Globals
       -> Params.CtxShape
       -> Int
       -> Value.Spine Value.V
       -> Value.V
       -> Value.V
       -> Co w Unit
solveF r g cs m sp rhs self =
  bind
    (uGets (\c -> c.metas))
    (\mc ->
       bind (uGets (\c -> c.selfKey)) (\sk -> case patternArgs sk mc sp of
       Nothing -> postponeU cs self rhs
       Just args -> case flexOf rhs of
         -- `?m` met on both sides: with the same pattern it is nothing; with
         -- two different patterns it depends only on the positions where
         -- the two agree (pattern intersection) -- never an occurs error
         Just (MkPair m' sp') ->
           if m' == m
           then case patternArgs sk mc sp' of
             Just args' ->
               if eqPatArgs args' args then val MkUnit
               else if List.length args' == List.length args
               then bind
                   (metaEntry m)
                   (\entry ->
                      bind
                        (solveWithPruned
                           r
                           g
                           m
                           m
                           entry
                           (List.length args)
                           (agreeing args args'))
                        (\u -> val MkUnit))
               else postponeU cs self rhs
             Nothing -> postponeU cs self rhs
           else solveRhs r g cs m args rhs
         Nothing -> solveRhs r g cs m args rhs))

uTyRigid : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> (UK w)
         -> Globals.Globals
         -> Params.CtxShape
         -> Value.Ty
         -> Value.Ty
         -> Co w Unit
uTyRigid r g cs a@(VU u) b = case b of
  VU u' ->
    if Params.eqUniverse u u' then val MkUnit else throwU (UnequalTys cs a b)
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VDecode h sp u described el) b = case b of
  VDecode h' sp' u' described' el' -> r.ubare g cs h sp h' sp'
  _ -> throwU (UnequalTys cs a b)
-- (an implicit argument's default is not the type's: it is not unified)
uTyRigid r g cs a@(VFunction level dom cod implicit dflt) b = case b of
  VFunction level' dom' cod' implicit' dflt' ->
    if Params.eqLevel level level' && Params.eqPlicity implicit implicit'
    then bind
        (r.uty g cs dom dom')
        (\u ->
           Value.withV
             (Value.local cs.len dom)
             (\x ->
                r.uty
                  g
                  (Params.bindShape (cloBinderName cod) cs)
                  (Value.nom (Value.appClo cod (\w -> x)))
                  (Value.nom (Value.appClo cod' (\w -> x)))))
    else throwU (UnequalTys cs a b)
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimInt b = case b of
  VPrimInt -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimFloat b = case b of
  VPrimFloat -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimString b = case b of
  VPrimString -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimRune b =
  if Value.isRune b then val MkUnit else throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VPrimArray x) b = case b of
  VPrimArray y -> r.uty g cs x y
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VFixed w) b =
  if Value.isFixed w b then val MkUnit else throwU (UnequalTys cs a b)
uTyRigid r g cs a b = throwU (UnequalTys cs a b)

uTypeF : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> (UK w)
       -> Globals.Globals
       -> Params.CtxShape
       -> Value.Ty
       -> Value.Ty
       -> Co w Unit
uTypeF r g cs a0 b0 =
  bind
    (forceTU a0)
    (\a ->
       bind
         (forceTU b0)
         (\b ->
            -- (an error hole is equal to anything: before a metavariable is
            -- solved with it)
            if Value.isErrorTy a || Value.isErrorTy b
            then bind (poisonTy cs.len a) (\u -> poisonTy cs.len b)
            else case flexTy a of
              Just (MkPair m sp) ->
                r.solve g cs m sp (Value.code b) (Value.code a)
              Nothing -> case flexTy b of
                Just (MkPair m sp) ->
                  r.solve g cs m sp (Value.code a) (Value.code b)
                Nothing -> uTyRigid r g cs a b))

uBareF : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> (UK w)
       -> Globals.Globals
       -> Params.CtxShape
       -> Value.Head
       -> Value.Spine Value.V
       -> Value.Head
       -> Value.Spine Value.V
       -> Co w Unit
uBareF r g cs h sp h' sp' =
  if Value.headIsError h || Value.headIsError h' then val MkUnit
  else case sp of
    SpId -> case sp' of
      SpId ->
        if Conversion.eqHead h h' then val MkUnit
        else throwU (UnequalNeus cs h sp h' sp')
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpApp sq v -> case sp' of
      SpApp sq' v' -> bind (r.ubare g cs h sq h' sq') (\u -> r.uel g cs v v')
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpProj sq x -> case sp' of
      SpProj sq' x' ->
        bind
          (r.ubare g cs h sq h' sq')
          (\u ->
             if strEq x x' then val MkUnit
             else throwU (UnequalNeus cs h sp h' sp'))
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpSpec sq x v -> case sp' of
      SpSpec sq' x' v' ->
        bind
          (r.ubare g cs h sq h' sq')
          (\u ->
             bind
               (a := Unit)
               (if strEq x x' then val MkUnit
                else throwU (UnequalNeus cs h sp h' sp'))
               (\u2 -> r.uel g cs v v'))
      _ -> throwU (UnequalNeus cs h sp h' sp')

uElRigid : {w : HFunctor}
         -> {{ms : State.state Environment.StCore <: w}}
         -> {{uf : Exception.exception Conversion.EqErr <: w}}
         -> (UK w)
         -> Globals.Globals
         -> Params.CtxShape
         -> Value.V
         -> Value.V
         -> Value.V
         -> Value.V
         -> Co w Unit
uElRigid r g cs (VNeu h sp ty expansion desc) cb a b = case cb of
  VNeu h' sp' ty' expansion' desc' -> r.ubare g cs h sp h' sp'
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VCode t) cb a b = case cb of
  VCode t' -> r.uty g cs t t'
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VLam d c) cb a b = case cb of
  VLam d' c' ->
    Value.withV
      (Value.local cs.len (Value.lamDom (Params.forceTh d)))
      (\x ->
         r.uel
           g
           (Params.bindShape (cloBinderName c) cs)
           (Value.nom (Value.appClo c (\w -> x)))
           (Value.nom (Value.appClo c' (\w -> x))))
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VCons d) cb a b = case cb of
  VCons d' ->
    forU
      (zipL (Array.toList d.values) (Array.toList d'.values)) (\p -> case p of
    MkPair x y -> r.uel g cs (Value.nom x) (Value.nom y))
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs VOpaque cb a b = val MkUnit

uTermF : {w : HFunctor}
       -> {{ms : State.state Environment.StCore <: w}}
       -> {{uf : Exception.exception Conversion.EqErr <: w}}
       -> (UK w)
       -> Globals.Globals
       -> Params.CtxShape
       -> Value.V
       -> Value.V
       -> Co w Unit
uTermF r g cs a0 b0 =
  bind
    (forceU a0)
    (\a ->
       bind
         (forceU b0)
         (\b ->
            if Value.isError a || Value.isError b
            then bind (poisonEl cs.len a) (\u -> poisonEl cs.len b)
            else case a of
              VOpaque -> val MkUnit
              _ -> case b of
                VOpaque -> val MkUnit
                _ -> case flexOf a of
                  Just (MkPair m sp) -> r.solve g cs m sp b a
                  Nothing -> case flexOf b of
                    Just (MkPair m sp) -> r.solve g cs m sp a b
                    Nothing -> uElRigid r g cs (canonU a) (canonU b) a b))

renameSpine : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> (UK w)
            -> Globals.Globals
            -> Int
            -> PRen
            -> Value.Spine Value.V
            -> Syntax.Tm
            -> Co w Syntax.Tm
renameSpine r g m pr SpId h = val h
renameSpine r g m pr (SpApp s a) h =
  bind
    (renameSpine r g m pr s h)
    (\f -> bind (r.ren g m pr a) (\x -> val (SApp f x)))
renameSpine r g m pr (SpProj s l) h =
  bind (renameSpine r g m pr s h) (\f -> val (SProj f l))
renameSpine r g m pr (SpSpec s l a) h =
  bind
    (renameSpine r g m pr s h)
    (\f -> bind (r.ren g m pr a) (\x -> val (SSpecialize f l x)))

renameClo : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> (UK w)
          -> Globals.Globals
          -> Int
          -> PRen
          -> Value.Ty
          -> Value.Clo Value.V Value.V
          -> Co w (Syntax.Abs Syntax.Tm)
renameClo r g m pr dom (MkClo x l f) =
  bind
    (r.renEv g m (lift1 pr) (f (Value.snocL l (Value.local pr.dom dom))))
    (\b -> val (MkAbs x b))
renameClo r g m pr dom (CloConst t) =
  bind (r.renEv g m pr t) (\b -> val (AbsConst b))

renameCloTy : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> (UK w)
            -> Globals.Globals
            -> Int
            -> PRen
            -> Value.Ty
            -> Value.Clo Value.V Value.Ty
            -> Co w (Syntax.Abs Syntax.Ty)
renameCloTy r g m pr dom (MkClo x l f) =
  bind
    (r.renEvTy g m (lift1 pr) (f (Value.snocL l (Value.local pr.dom dom))))
    (\b -> val (MkAbs x b))
renameCloTy r g m pr dom (CloConst t) =
  bind (r.renEvTy g m pr t) (\b -> val (AbsConst b))

renameEvF : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> (UK w)
          -> Globals.Globals
          -> Int
          -> PRen
          -> Value.Ev Value.V
          -> Co w Syntax.Tm
renameEvF r g m pr (Nom v) = r.ren g m pr v
renameEvF r g m pr (Describe v) = r.ren g m pr v
renameEvF r g m pr (Become v) = bind (r.ren g m pr v) (\t -> val (SIs t))

renameEvTypeF : {w : HFunctor}
              -> {{ms : State.state Environment.StCore <: w}}
              -> {{uf : Exception.exception Conversion.EqErr <: w}}
              -> (UK w)
              -> Globals.Globals
              -> Int
              -> PRen
              -> Value.Ev Value.Ty
              -> Co w Syntax.Ty
renameEvTypeF r g m pr (Nom a) = r.renTy g m pr a
renameEvTypeF r g m pr (Describe a) = r.renTy g m pr a
renameEvTypeF r g m pr (Become a) =
  bind (r.renTy g m pr a) (\t -> val (SIsTy t))

renameF : {w : HFunctor}
        -> {{ms : State.state Environment.StCore <: w}}
        -> {{uf : Exception.exception Conversion.EqErr <: w}}
        -> (UK w)
        -> Globals.Globals
        -> Int
        -> PRen
        -> Value.V
        -> Co w Syntax.Tm
renameF r g m pr v0 =
  bind (forceU v0) (\v -> case v of
  VNeu (HMeta m') sp ty expansion desc ->
    if m' == m then occursError else r.renFlex g m pr m' sp
  VNeu h sp ty expansion desc ->
    bind (renameHead pr h) (\hd -> renameSpine r g m pr sp hd)
  VCode t -> bind (r.renTy g m pr t) (\t' -> val (SCode t'))
  VLam fty body ->
    bind
      (r.renTy g m pr (Params.forceTh fty))
      (\d ->
         bind
           (renameClo r g m pr (Value.lamDom (Params.forceTh fty)) body)
           (\b -> val (SLam d b)))
  VCons d ->
    bind
      (traverseU
         (\p -> case p of
          MkPair k x -> bind (r.renEv g m pr x) (\y -> val (MkPair k y)))
         (Dict.toList d))
      (\ps -> val (SCons (Dict.fromList ps)))
  VOpaque -> val SOpaque)

renameRecordFields : {w : HFunctor}
                   -> {{ms : State.state Environment.StCore <: w}}
                   -> {{uf : Exception.exception Conversion.EqErr <: w}}
                   -> (UK w)
                   -> Globals.Globals
                   -> Int
                   -> PRen
                   -> Int
                   -> Value.Locals Value.V
                   -> List (Value.Locals Value.V -> Value.Field)
                   -> Co w (List Syntax.Ty)
renameRecordFields r g m pr i ls Nil = val Nil
renameRecordFields r g m pr i ls (Cons fc rest) = case fc ls of
  MkField ty value ->
    bind
      (r.renTy g m (iterateLift i pr) ty)
      (\x ->
         bind
           (renameRecordFields
              r
              g
              m
              pr
              (i + 1)
              (Value.snocL ls (Value.local (pr.dom + i) ty))
              rest)
           (\xs -> val (Cons x xs)))

renameTypeF : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> (UK w)
            -> Globals.Globals
            -> Int
            -> PRen
            -> Value.Ty
            -> Co w Syntax.Ty
renameTypeF r g m pr t0 =
  bind (forceTU t0) (\t -> case t of
  VU u -> val (SU u)
  VDecode (HMeta m') sp u described el ->
    if m' == m then occursError
    else bind (r.renFlex g m pr m' sp) (\e -> val (SDecode e))
  VDecode h sp u described el ->
    bind
      (renameHead pr h)
      (\hd -> bind (renameSpine r g m pr sp hd) (\e -> val (SDecode e)))
  -- (an implicit argument's default is closed: nothing to rename)
  VFunction level dom cod implicit dflt ->
    bind
      (r.renTy g m pr dom)
      (\d ->
         bind
           (renameCloTy r g m pr dom cod)
           (\c -> val (SFunction level d c implicit dflt)))
  VRecord level capture fieldTypes defaults ->
    bind
      (renameRecordFields r g m pr 0 capture (Array.toList fieldTypes.values))
      (\tys ->
         val
           (SRecord
              level
              { keys = fieldTypes.keys
              , byName = fieldTypes.byName
              , values = Array.fromList tys
              }
              defaults))
  VSum vs ->
    bind
      (traverseU
         (\p -> case p of
          MkPair k args ->
            bind
              (traverseU
                 (\a -> r.renTy g m pr (Params.forceTh a))
                 (Array.toList args))
              (\xs -> val (MkPair k (Array.fromList xs))))
         (Dict.toList vs))
      (\ps -> val (SSum (Dict.fromList ps)))
  VPrimInt -> val SPrimInt
  VPrimFloat -> val SPrimFloat
  VPrimString -> val SPrimString
  VPrimRune -> val SPrimRune
  VPrimArray a -> bind (r.renTy g m pr a) (\x -> val (SPrimArray x))
  VFixed w -> val (SFixed w))

-- | Another metavariable in the solution.  If some of its arguments are
-- | out of scope, it is pruned: replaced by a fresh one without them.
renameFlexF : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> (UK w)
            -> Globals.Globals
            -> Int
            -> PRen
            -> Int
            -> Value.Spine Value.V
            -> Co w Syntax.Tm
renameFlexF r g m pr m' sp =
  bind
    (uGets (\c -> c.metas))
    (\mc ->
       bind (uGets (\c -> c.selfKey)) (\sk -> case patternArgs sk mc sp of
       Nothing -> scopeError
       Just args ->
         if anyL (\a -> not (inRen pr a)) args
         then bind
             (metaEntry m')
             (\entry ->
                bind
                  (solveWithPruned
                     r
                     g
                     m
                     m'
                     entry
                     (List.length args)
                     (catMaybes
                        (mapWithIndexL
                           0
                           (\i a -> if inRen pr a then Just i else Nothing)
                           args)))
                  (\sol -> r.ren g m pr (Value.replay sol sp)))
         else bind
             (metaEntry m')
             (\entry ->
                bind
                  (r.renTy g m pr entry.ty)
                  (\ty ->
                     bind
                       (traverseU
                          (\a -> case a of
                           PVar l -> case Map.lookup pr.ren l of
                             Just l' -> val (pr.cod - l' - 1)
                             Nothing -> scopeError
                           PSelf -> scopeError)
                          args)
                       (\idxs -> val (SMetaApp m' (Array.fromList idxs) ty))))))

uk : {w : HFunctor}
   -> {{ms : State.state Environment.StCore <: w}}
   -> {{uf : Exception.exception Conversion.EqErr <: w}}
   -> (UK w)
uk =
  { uty = \g cs a b -> uTypeF uk g cs a b
  , uel = \g cs a b -> uTermF uk g cs a b
  , ubare = \g cs h sp h' sp' -> uBareF uk g cs h sp h' sp'
  , solve = \g cs m sp rhs self -> solveF uk g cs m sp rhs self
  , ren = \g m pr v -> renameF uk g m pr v
  , renEv = \g m pr v -> renameEvF uk g m pr v
  , renTy = \g m pr t -> renameTypeF uk g m pr t
  , renEvTy = \g m pr t -> renameEvTypeF uk g m pr t
  , renFlex = \g m pr m' sp -> renameFlexF uk g m pr m' sp
  }

uTy : {w : HFunctor}
    -> {{ms : State.state Environment.StCore <: w}}
    -> {{uf : Exception.exception Conversion.EqErr <: w}}
    -> Globals.Globals
    -> Params.CtxShape
    -> Value.Ty
    -> Value.Ty
    -> Co w Unit
uTy g cs a b = (uk : UK w).uty g cs a b

uEl : {w : HFunctor}
    -> {{ms : State.state Environment.StCore <: w}}
    -> {{uf : Exception.exception Conversion.EqErr <: w}}
    -> Globals.Globals
    -> Params.CtxShape
    -> Value.V
    -> Value.V
    -> Co w Unit
uEl g cs a b = (uk : UK w).uel g cs a b

-- First-order approximation
--------------------------------------------------------------------------------

-- `?m a₁…aₖ =?= C b₁…bₙ` is outside the pattern fragment when an `aᵢ` is
-- no variable, and it has no one solution (`?m := C`, `?m := \_ -> C
-- b₁`, ...).  When a definition settles and the problem is still stuck,
-- it is approximated as Lean does, to the first: `?m := C b₁…bₙ₋ₖ`, and
-- `aᵢ =?= bₙ₋ₖ₊ᵢ` -- only where `C` is, under its arguments, a sum or
-- a record: a name that computes no further (#88).

absBody : {a : Type} -> Syntax.Abs a -> a
absBody (MkAbs x b) = b
absBody (AbsConst b) = b

nominalCode : Syntax.Ty -> Bool
nominalCode (SSum _) = True
nominalCode (SRecord _ _ _) = True
nominalCode _ = False

-- | a body that is, under its arguments, a sum or a record: one that
-- | computes no further (no alias, `T a = Maybe a`)
nominalBody : Syntax.Tm -> Bool
nominalBody (SLam _ b) = nominalBody (absBody b)
nominalBody (SCode t) = nominalCode t
nominalBody _ = False

nominalEntry : Maybe Globals.Entry -> Bool
nominalEntry (Just e) = nominalBody e.syntax
nominalEntry Nothing = False

nominalOf : Globals.Globals
          -> Value.Head
          -> Value.Spine Value.V
          -> Maybe (Pair String (Value.Spine Value.V))
nominalOf g (HGlobal k) sp =
  if nominalEntry (Globals.lookupEntry g k) then Just (MkPair k sp)
  else Nothing
nominalOf g h sp = Nothing

-- | a neutral headed by the name of a sum or a record: the name, the spine
-- | (a local, a function, a metavariable are none)
nominalHead : Globals.Globals
            -> Value.V
            -> Maybe (Pair String (Value.Spine Value.V))
nominalHead g (VNeu h sp ty expansion desc) = nominalOf g h sp
nominalHead g v = Nothing

consArg : Value.V -> Maybe (List Value.V) -> Maybe (List Value.V)
consArg a (Just as) = Just (Cons a as)
consArg a Nothing = Nothing

-- | the arguments of a spine of applications only, the last applied first
appsRev : Value.Spine Value.V -> Maybe (List Value.V)
appsRev SpId = Just Nil
appsRev (SpApp s a) = consArg a (appsRev s)
appsRev _ = Nothing

-- | the spine of arguments listed the last applied first
spineRev : List Value.V -> Value.Spine Value.V
spineRev Nil = SpId
spineRev (Cons a rest) = SpApp (spineRev rest) a

-- | what an approximation does: `?meta prefix := rhs`, then each pair
type Approx =
  { meta : Int
  , prefix : Value.Spine Value.V
  , rhs : Value.V
  , pairs : List (Pair Value.V Value.V)
  }

-- (`k` arguments past the meta's arity, matched with the last `k` of
-- `C`'s; fewer than `k` of `C`'s, or none past the arity: no approximation)
approxWith : Globals.Globals
           -> Int
           -> Int
           -> List Value.V
           -> String
           -> List Value.V
           -> Maybe Approx
approxWith g m k metaArgs key rigidArgs =
  if k < 1 || List.length rigidArgs < k then Nothing
  else Just
      { meta = m
      , prefix = spineRev (List.drop k metaArgs)
      , rhs =
          Value.replay
            (Globals.elemAt g key).value
            (spineRev (List.drop k rigidArgs))
      , pairs = zipL (List.take k metaArgs) (List.take k rigidArgs)
      }

approxRigid : Globals.Globals
            -> Int
            -> Int
            -> List Value.V
            -> Maybe (Pair String (Value.Spine Value.V))
            -> Maybe Approx
approxRigid g m arity metaArgs (Just (MkPair key sp)) = case appsRev sp of
  Just rigidArgs ->
    approxWith g m (List.length metaArgs - arity) metaArgs key rigidArgs
  Nothing -> Nothing
approxRigid g m arity metaArgs Nothing = Nothing

approxEntry : Globals.Globals
            -> Int
            -> Maybe Value.MetaEntry
            -> Maybe (List Value.V)
            -> Value.V
            -> Maybe Approx
approxEntry g m (Just e) (Just metaArgs) rigid =
  approxRigid g m e.arity metaArgs (nominalHead g rigid)
approxEntry g m _ _ rigid = Nothing

-- | the approximation of `flex =?= rigid`, if it is one: `flex` an
-- | unsolved metavariable applied past its arity, `rigid` a sum or a
-- | record's name applied to as many arguments at least
approxOf : Globals.Globals
         -> Value.MetaCtx
         -> Value.V
         -> Maybe (Pair Int (Value.Spine Value.V))
         -> Maybe Approx
approxOf g mc rigid (Just (MkPair m sp)) =
  approxEntry g m (Map.lookup mc m) (appsRev sp) rigid
approxOf g mc rigid Nothing = Nothing

neuTy : Value.V -> Maybe Value.Ty
neuTy (VNeu h sp ty expansion desc) = Just (Params.forceTh ty)
neuTy v = Nothing

isSolved : Value.MetaCtx -> Int -> Bool
isSolved mc m = case Value.solutionOf mc m of
  Just _ -> True
  Nothing -> False

-- | the approximation done: the metavariable's type (closed) must be
-- | `C b₁…bₙ₋ₖ`'s, and it solved; whatever does not hold is a failure
approxRun : {w : HFunctor}
          -> {{ms : State.state Environment.StCore <: w}}
          -> {{uf : Exception.exception Conversion.EqErr <: w}}
          -> Globals.Globals
          -> Params.CtxShape
          -> Value.V
          -> Approx
          -> Co w Unit
approxRun g cs self a = do
  entry <- metaEntry a.meta
  tyStx <-
    (uk : UK w).renTy
      g
      a.meta
      { dom = entry.arity, cod = 0, ren = Map.empty }
      entry.ty
  rhsTy <- case neuTy a.rhs of
    Just t -> val t
    Nothing -> scopeError
  (uk : UK w).uty g cs (Value.nom (Eval.evalTy g N tyStx LNil)) rhsTy
  (uk : UK w).solve g cs a.meta a.prefix a.rhs self
  solved <- uGets (\c -> isSolved c.metas a.meta)
  if solved
    then forU
        a.pairs
        (\p -> (uk : UK w).uel g cs (fst p) (snd p))
    else scopeError

approxMaybe : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> Globals.Globals
            -> Params.CtxShape
            -> Value.V
            -> Maybe Approx
            -> Co w Bool
approxMaybe g cs self (Just a) = bind (approxRun g cs self a) (\u -> val True)
approxMaybe g cs self Nothing = val False

-- | A problem still stuck, `left =?= right` (the flexible side left, as
-- | postponed), approximated to the first order: whether it was one to
-- | approximate.  It fails as a unification does; run it in an attempt.
approximate : {w : HFunctor}
            -> {{ms : State.state Environment.StCore <: w}}
            -> {{uf : Exception.exception Conversion.EqErr <: w}}
            -> Globals.Globals
            -> Params.CtxShape
            -> Value.V
            -> Value.V
            -> Co w Bool
approximate g cs left right = do
  l <- forceU left
  r <- forceU right
  mc <- uGets (\c -> c.metas)
  approxMaybe g cs l (approxOf g mc r (flexOf l))

-- A unification by itself
--------------------------------------------------------------------------------

-- | the world a unification is run in by itself: the core state, and
-- | failing with a conversion error
uW : HFunctor
uW = State.state Environment.StCore <+> Exception.exception Conversion.EqErr

msEv : State.state Environment.StCore <: uW
msEv p = InL p

ufEv : Exception.exception Conversion.EqErr <: uW
ufEv p = InR p

-- | its handler's monad: from a state, an answer or a conversion error,
-- | and the state after
type UStep a =
  Environment.StCore -> Pair (Either Conversion.EqErr a) Environment.StCore

bindStep : {a b : Type}
         -> Pair (Either Conversion.EqErr a) Environment.StCore
         -> (a -> UStep b)
         -> Pair (Either Conversion.EqErr b) Environment.StCore
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

catchStep : {a : Type}
          -> (Conversion.EqErr -> UStep a)
          -> Pair (Either Conversion.EqErr a) Environment.StCore
          -> Pair (Either Conversion.EqErr a) Environment.StCore
catchStep h (MkPair (Left e) st) = h e st
catchStep h (MkPair (Right x) st) = MkPair (Right x) st

uStateAlg : {a : Type} -> State.StateF Environment.StCore UStep a -> UStep a
uStateAlg (Get k) = \c -> MkPair (Right (k c)) c
uStateAlg (Put c2 x) = \c -> MkPair (Right x) c2

uExceptionAlg : {a : Type}
              -> Exception.ExceptionF Conversion.EqErr UStep a
              -> UStep a
uExceptionAlg (Throw err) = \c -> MkPair (Left err) c
uExceptionAlg (Catch m h) = \c -> catchStep h (m c)

uAlg : {a : Type}
     -> SumF
       (State.StateF Environment.StCore)
       (Exception.ExceptionF Conversion.EqErr)
       UStep
       a
     -> UStep a
uAlg (InL t) = uStateAlg t
uAlg (InR q) = uExceptionAlg q

uH : Handler uW
uH =
  { M = UStep
  , ret = \x c -> MkPair (Right x) c
  , bind = \m k c -> bindStep (m c) k
  , malg = \p -> uAlg p
  }

-- | a unification, from a state
runU : {a : Type} -> Co uW a -> UStep a
runU u = handle uH u

-- | >>> Conversion.holds (resOf (runU (uTy (ms := msEv) (uf := ufEv) Globals.emptyGlobals Params.emptyShape VPrimInt VPrimInt) Environment.emptyCore))
-- | True
-- | >>> Conversion.holds (resOf (runU (uTy (ms := msEv) (uf := ufEv) Globals.emptyGlobals Params.emptyShape VPrimInt VPrimString) Environment.emptyCore))
-- | False
resOf : Pair (Either Conversion.EqErr Unit) Environment.StCore
      -> Either Conversion.EqErr Unit
resOf (MkPair e st) = e
