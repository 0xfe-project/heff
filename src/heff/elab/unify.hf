-- Unification: conversion-with-solving -- the rules of src/heff/elab/conversion.hf, plus pattern unification with
-- pruning.  A unification is a computation (lib/co.hf) in any world `w`
-- with two effects in it: the elaboration's core state (the
-- metavariables, `ms`) and failing with a conversion error (`uf`) --
-- nothing else of elaboration's.  src/heff/elab/meta.hf runs it in `Elab`.
-- The solver's judgments are one knot record, `uk`, for a world.

import array as A
import co
import exn as X
import heff.elab.conversion as C
import heff.util.dict as D
import heff.elab.environment as Env
import heff.elab.eval as E
import heff.elab.globals as G
import heff.elab.params as P
import heff.syntax.surfaceprint as Ps
import heff.elab.syntax as Sx
import heff.elab.value as V
import map as M
import state as S

uGets : {w : HFunctor}
      -> {{ms : S.state Env.StCore <: w}}
      -> {{uf : X.exn C.EqErr <: w}}
      -> {a : Type}
      -> (Env.StCore -> a)
      -> Co w a
uGets f = op (ms (Get f)) val

uModify : {w : HFunctor}
        -> {{ms : S.state Env.StCore <: w}}
        -> {{uf : X.exn C.EqErr <: w}}
        -> (Env.StCore -> Env.StCore)
        -> Co w Unit
uModify f = bind (uGets f) (\c -> op (ms (Put c (MkUnit : Unit))) val)

throwU : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> {a : Type}
       -> C.EqErr
       -> Co w a
throwU err = op (uf (Throw err)) val

catchU : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> {a : Type}
       -> Co w a
       -> (C.EqErr -> Co w a)
       -> Co w a
catchU m h = op (uf (Catch m h)) val

forceU : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> V.V
       -> Co w V.V
forceU v = uGets (\c -> V.forceEl c.metas v)

forceTU : {w : HFunctor}
        -> {{ms : S.state Env.StCore <: w}}
        -> {{uf : X.exn C.EqErr <: w}}
        -> V.Ty
        -> Co w V.Ty
forceTU t = uGets (\c -> V.forceTy c.metas t)

-- Flexible heads
--------------------------------------------------------------------------------

flexOf : V.V -> Maybe (Pair Int (V.Spine V.V))
flexOf (VNeu (HMeta m) sp ty expansion desc) = Just (MkPair m sp)
flexOf v = Nothing

-- | a type that is a metavariable, as an element (so it can be solved)
flexTy : V.Ty -> Maybe (Pair Int (V.Spine V.V))
flexTy (VDecode (HMeta m) sp u described el) = Just (MkPair m sp)
flexTy t = Nothing

isFlexTy : V.Ty -> Bool
isFlexTy t = case flexTy t of
  Just _ -> True
  Nothing -> False

-- Miller patterns
--------------------------------------------------------------------------------

-- | an argument of a flexible neutral, in a Miller pattern: a variable
-- | (its level), or the definition being elaborated itself
data PatArg = PVar Int | PSelf

eqPatArg : PatArg -> PatArg -> Bool
eqPatArg (PVar l) (PVar l') = l == l'
eqPatArg PSelf PSelf = True
eqPatArg _ _ = False

eqPatArgs : List PatArg -> List PatArg -> Bool
eqPatArgs Nil Nil = True
eqPatArgs (Cons a as) (Cons b bs) = eqPatArg a b && eqPatArgs as bs
eqPatArgs _ _ = False

patVarsOf : List PatArg -> List Int
patVarsOf Nil = Nil
patVarsOf (Cons (PVar l) rest) = Cons l (patVarsOf rest)
patVarsOf (Cons PSelf rest) = patVarsOf rest

distinct : List Int -> Bool
distinct Nil = True
distinct (Cons x xs) = not (List.elemBy (\a b -> a == b) x xs) && distinct xs

isSelfGlobal : Maybe String -> String -> Bool
isSelfGlobal (Just sk) k = strEq sk k
isSelfGlobal Nothing k = False

patStep : Maybe String -> V.V -> Maybe (List PatArg) -> Maybe (List PatArg)
patStep selfKey v Nothing = Nothing
patStep selfKey (VNeu (HLocal l) SpId _ _ _) (Just rest) =
  Just (Cons (PVar l) rest)
patStep selfKey (VNeu (HGlobal k) SpId _ _ _) (Just rest) =
  if isSelfGlobal selfKey k then Just (Cons PSelf rest) else Nothing
patStep selfKey v (Just rest) = Nothing

patSpine : Maybe String -> V.MetaCtx -> V.Spine V.V -> Maybe (List PatArg)
patSpine selfKey mc SpId = Just Nil
patSpine selfKey mc (SpApp s v) =
  patStep selfKey (V.forceEl mc v) (patSpine selfKey mc s)
patSpine selfKey mc _ = Nothing

-- | the arguments of a flexible neutral, if they are distinct variables
-- | (or the self) -- a Miller pattern; outermost last
patternArgs : Maybe String -> V.MetaCtx -> V.Spine V.V -> Maybe (List PatArg)
patternArgs selfKey mc sp = case patSpine selfKey mc sp of
  Nothing -> Nothing
  Just items ->
    if distinct (patVarsOf items) then Just (List.reverse items) else Nothing

-- List helpers
--------------------------------------------------------------------------------

nth : {a : Type} -> List a -> Int -> Maybe a
nth Nil i = Nothing
nth (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nth xs (i - 1)

mapWithIndexL : {a b : Type} -> Int -> (Int -> a -> b) -> List a -> List b
mapWithIndexL i f Nil = Nil
mapWithIndexL i f (Cons x xs) = Cons (f i x) (mapWithIndexL (i + 1) f xs)

zipL : {a b : Type} -> List a -> List b -> List (Pair a b)
zipL (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipL xs ys)
zipL _ _ = Nil

catMaybes : {a : Type} -> List (Maybe a) -> List a
catMaybes Nil = Nil
catMaybes (Cons (Just x) xs) = Cons x (catMaybes xs)
catMaybes (Cons Nothing xs) = catMaybes xs

anyL : {a : Type} -> (a -> Bool) -> List a -> Bool
anyL p Nil = False
anyL p (Cons x xs) = p x || anyL p xs

appendL : {a : Type} -> List a -> List a -> List a
appendL Nil ys = ys
appendL (Cons x xs) ys = Cons x (appendL xs ys)

concatMapL : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapL f Nil = Nil
concatMapL f (Cons x xs) = appendL (f x) (concatMapL f xs)

traverseU : {w : HFunctor}
          -> {{ms : S.state Env.StCore <: w}}
          -> {{uf : X.exn C.EqErr <: w}}
          -> {a b : Type}
          -> (a -> Co w b)
          -> List a
          -> Co w (List b)
traverseU f Nil = val Nil
traverseU f (Cons x xs) =
  bind (f x) (\y -> bind (traverseU f xs) (\ys -> val (Cons y ys)))

forU : {w : HFunctor}
     -> {{ms : S.state Env.StCore <: w}}
     -> {{uf : X.exn C.EqErr <: w}}
     -> {a : Type}
     -> List a
     -> (a -> Co w Unit)
     -> Co w Unit
forU Nil f = val MkUnit
forU (Cons x xs) f = bind (f x) (\u -> forU xs f)

-- Postponing, poisoning
--------------------------------------------------------------------------------

postponeU : {w : HFunctor}
          -> {{ms : S.state Env.StCore <: w}}
          -> {{uf : X.exn C.EqErr <: w}}
          -> P.CtxShape
          -> V.V
          -> V.V
          -> Co w Unit
postponeU cs l r =
  uModify
    (\c ->
       Env.setPostponed
         (Cons { shape = cs, left = l, right = r, failed = False } c.postponed)
         c)

-- | the unsolved metavariables in a value, `depth` deep (a record type's
-- | fields are not looked into)
type MetasK =
  { mel : Int -> Int -> V.V -> List Int
  , mty : Int -> Int -> V.Ty -> List Int
  , msp : Int -> Int -> V.Spine V.V -> List Int
  }

metasTermF : MetasK -> V.MetaCtx -> Int -> Int -> V.V -> List Int
metasTermF r mc depth len v0 =
  if depth <= 0 then Nil
  else case V.forceEl mc v0 of
    VNeu (HMeta m) sp ty expansion desc -> Cons m (r.msp depth len sp)
    VNeu h sp ty expansion desc -> r.msp depth len sp
    VCode t -> r.mty (depth - 1) len t
    VLam d c ->
      r.mel
        (depth - 1)
        (len + 1)
        (V.nom (V.appClo c (\u -> V.local len (V.lamDom (P.forceTh d)))))
    VCons d ->
      concatMapL (\x -> r.mel (depth - 1) len (V.nom x)) (A.toList d.values)
    VOpaque -> Nil

metasTypeF : MetasK -> V.MetaCtx -> Int -> Int -> V.Ty -> List Int
metasTypeF r mc depth len t0 =
  if depth <= 0 then Nil
  else case V.forceTy mc t0 of
    VDecode h sp u described el -> r.mel depth len (P.forceTh el)
    VFunction level dom cod implicit dflt ->
      appendL
        (r.mty (depth - 1) len dom)
        (r.mty
           (depth - 1)
           (len + 1)
           (V.nom (V.appClo cod (\u -> V.local len dom))))
    VPrimArray a -> r.mty (depth - 1) len a
    _ -> Nil

metasSpF : MetasK -> V.MetaCtx -> Int -> Int -> V.Spine V.V -> List Int
metasSpF r mc depth len SpId = Nil
metasSpF r mc depth len (SpApp sp a) =
  appendL (r.msp depth len sp) (r.mel (depth - 1) len a)
metasSpF r mc depth len (SpProj sp _) = r.msp depth len sp
metasSpF r mc depth len (SpSpec sp _ a) =
  appendL (r.msp depth len sp) (r.mel (depth - 1) len a)

metasK : V.MetaCtx -> MetasK
metasK mc =
  { mel = \depth len v -> metasTermF (metasK mc) mc depth len v
  , mty = \depth len t -> metasTypeF (metasK mc) mc depth len t
  , msp = \depth len sp -> metasSpF (metasK mc) mc depth len sp
  }

-- | the metavariables a type still waits on, to `depth`
metasTy : V.MetaCtx -> Int -> Int -> V.Ty -> List Int
metasTy mc depth len t = (metasK mc).mty depth len t

poisonMany : {w : HFunctor}
           -> {{ms : S.state Env.StCore <: w}}
           -> {{uf : X.exn C.EqErr <: w}}
           -> List Int
           -> Co w Unit
poisonMany ms =
  uModify
    (\c ->
       Env.setPoisoned
         (List.foldl (\ps m -> M.insert compareInt m MkUnit ps) c.poisoned ms)
         c)

poisonTy : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> Int
         -> V.Ty
         -> Co w Unit
poisonTy len t =
  bind (uGets (\c -> c.metas)) (\mc -> poisonMany ((metasK mc).mty 20 len t))

poisonEl : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> Int
         -> V.V
         -> Co w Unit
poisonEl len v =
  bind (uGets (\c -> c.metas)) (\mc -> poisonMany ((metasK mc).mel 20 len v))

-- Zonking (solutions substituted into syntax), and instantiation
--------------------------------------------------------------------------------

absMap : {a : Type} -> (a -> a) -> Sx.Abs a -> Sx.Abs a
absMap f (MkAbs x b) = MkAbs x (f b)
absMap f (AbsConst b) = AbsConst (f b)

-- | under `d` binders of the body, index `d + j` is the binder x_{k-j}
substVar : List Int -> Int -> Int -> Sx.Tm
substVar idxs d i =
  if i < d then SLocal i
  else case nth idxs (List.length idxs - 1 - (i - d)) of
    Just j -> SLocal (j + d)
    Nothing -> SLocal i

substIdx : List Int -> Int -> Int -> Int
substIdx idxs d i = case substVar idxs d i of
  SLocal j -> j
  _ -> i

type Subst = { el : Int -> Sx.Tm -> Sx.Tm, ty : Int -> Sx.Ty -> Sx.Ty }

substTermF : Subst -> List Int -> Int -> Sx.Tm -> Sx.Tm
substTermF r idxs d (SLocal i) = substVar idxs d i
substTermF r idxs d (SMetaApp m ix ty) =
  SMetaApp m (A.map (\i -> substIdx idxs d i) ix) (r.ty d ty)
substTermF r idxs d (SCode ty) = SCode (r.ty d ty)
substTermF r idxs d (SApp f a) = SApp (r.el d f) (r.el d a)
substTermF r idxs d (SLam dd (MkAbs x b)) =
  SLam (r.ty d dd) (MkAbs x (r.el (d + 1) b))
substTermF r idxs d (SLam dd (AbsConst b)) =
  SLam (r.ty d dd) (AbsConst (r.el d b))
substTermF r idxs d (SCons dct) = SCons (D.mapD (r.el d) dct)
substTermF r idxs d (SProj e l) = SProj (r.el d e) l
substTermF r idxs d (STag x as) = STag x (A.map (r.el d) as)
substTermF r idxs d (SMatch e cs) =
  SMatch
    (r.el d e)
    (D.mapD
       (\p -> case p of
        MkPair xs b -> MkPair xs (r.el (d + A.length xs) b))
       cs)
substTermF r idxs d (SSpecialize e l v) = SSpecialize (r.el d e) l (r.el d v)
substTermF r idxs d (SIs e) = SIs (r.el d e)
substTermF r idxs d (SRec e) = SRec (r.el d e)
substTermF r idxs d (SFix dd (MkAbs x b)) =
  SFix (r.ty d dd) (MkAbs x (r.el (d + 1) b))
substTermF r idxs d (SFix dd (AbsConst b)) =
  SFix (r.ty d dd) (AbsConst (r.el d b))
substTermF r idxs d (SImplicit x e) = SImplicit x (r.el d e)
substTermF r idxs d t = t

substTyFields : Subst -> Int -> Int -> List Sx.Ty -> List Sx.Ty
substTyFields r d i Nil = Nil
substTyFields r d i (Cons ty rest) =
  Cons (r.ty (d + i) ty) (substTyFields r d (i + 1) rest)

substTypeF : Subst -> List Int -> Int -> Sx.Ty -> Sx.Ty
substTypeF r idxs d (SDecode e) = SDecode (r.el d e)
-- (an implicit argument's default is closed)
substTypeF r idxs d (SFunction level dom (MkAbs x b) implicit dflt) =
  SFunction level (r.ty d dom) (MkAbs x (r.ty (d + 1) b)) implicit dflt
substTypeF r idxs d (SFunction level dom (AbsConst b) implicit dflt) =
  SFunction level (r.ty d dom) (AbsConst (r.ty d b)) implicit dflt
-- (the defaults name no local but the fields before them: nothing to
-- substitute)
substTypeF r idxs d (SRecord level ft ds) =
  SRecord
    level
    { keys = ft.keys
    , byName = ft.byName
    , values = A.fromList (substTyFields r d 0 (A.toList ft.values))
    }
    ds
substTypeF r idxs d (SSum vs) = SSum (D.mapD (A.map (r.ty d)) vs)
substTypeF r idxs d (SIsTy a) = SIsTy (r.ty d a)
substTypeF r idxs d t = t

substOf : List Int -> Subst
substOf idxs =
  { el = \d t -> substTermF (substOf idxs) idxs d t
  , ty = \d t -> substTypeF (substOf idxs) idxs d t
  }

stripLams : Int -> Sx.Tm -> Sx.Tm
stripLams n t =
  if n <= 0 then t
  else case t of
    SLam _ (MkAbs _ b) -> stripLams (n - 1) b
    SLam _ (AbsConst b) -> stripLams (n - 1) b
    _ -> t

-- | `sol` is closed lambdas over the body; the result is the body with
-- | each binder replaced by the local `idxs[i]`
instantiate : List Int -> Sx.Tm -> Sx.Tm
instantiate idxs sol = (substOf idxs).el 0 (stripLams (List.length idxs) sol)

solStxOf : V.MetaCtx -> Int -> Maybe Sx.Tm
solStxOf mc m = case M.lookup compareInt m mc of
  Just e -> e.solStx
  Nothing -> Nothing

type Zonk = { el : Sx.Tm -> Sx.Tm, ty : Sx.Ty -> Sx.Ty }

zonkTermF : Zonk -> V.MetaCtx -> Sx.Tm -> Sx.Tm
zonkTermF r mc (SMetaApp m idxs ty) = case solStxOf mc m of
  Just sol -> r.el (instantiate (A.toList idxs) sol)
  Nothing -> SMetaApp m idxs (r.ty ty)
zonkTermF r mc (SCode ty) = SCode (r.ty ty)
zonkTermF r mc (SApp f a) = SApp (r.el f) (r.el a)
zonkTermF r mc (SLam d b) = SLam (r.ty d) (absMap r.el b)
zonkTermF r mc (SCons d) = SCons (D.mapD r.el d)
zonkTermF r mc (SProj e l) = SProj (r.el e) l
zonkTermF r mc (STag x as) = STag x (A.map r.el as)
zonkTermF r mc (SMatch e cs) =
  SMatch
    (r.el e)
    (D.mapD
       (\p -> case p of
        MkPair xs b -> MkPair xs (r.el b))
       cs)
zonkTermF r mc (SSpecialize e l v) = SSpecialize (r.el e) l (r.el v)
zonkTermF r mc (SIs e) = SIs (r.el e)
zonkTermF r mc (SRec e) = SRec (r.el e)
zonkTermF r mc (SFix d b) = SFix (r.ty d) (absMap r.el b)
zonkTermF r mc (SImplicit x e) = SImplicit x (r.el e)
zonkTermF r mc t = t

zonkDefault : Zonk -> Maybe Sx.Tm -> Maybe Sx.Tm
zonkDefault r (Just d) = Just (r.el d)
zonkDefault r Nothing = Nothing

zonkTypeF : Zonk -> V.MetaCtx -> Sx.Ty -> Sx.Ty
zonkTypeF r mc (SDecode e) = SDecode (r.el e)
zonkTypeF r mc (SFunction level dom cod implicit dflt) =
  SFunction level (r.ty dom) (absMap r.ty cod) implicit (zonkDefault r dflt)
zonkTypeF r mc (SRecord level ft ds) =
  SRecord level (D.mapD r.ty ft) (D.mapD r.el ds)
zonkTypeF r mc (SSum vs) = SSum (D.mapD (A.map r.ty) vs)
zonkTypeF r mc (SIsTy a) = SIsTy (r.ty a)
zonkTypeF r mc t = t

zonker : V.MetaCtx -> Zonk
zonker mc =
  { el = \t -> zonkTermF (zonker mc) mc t
  , ty = \t -> zonkTypeF (zonker mc) mc t
  }

zonkEl : V.MetaCtx -> Sx.Tm -> Sx.Tm
zonkEl mc t = (zonker mc).el t

zonkTy : V.MetaCtx -> Sx.Ty -> Sx.Ty
zonkTy mc t = (zonker mc).ty t

-- Solving: shared pieces
--------------------------------------------------------------------------------

-- | eta, but a metavariable's neutral stays itself
canonU : V.V -> V.V
canonU v@(VNeu (HMeta m) sp ty expansion desc) = v
canonU v = C.canon v

scopeError : {w : HFunctor}
           -> {{ms : S.state Env.StCore <: w}}
           -> {{uf : X.exn C.EqErr <: w}}
           -> {a : Type}
           -> Co w a
scopeError = throwU (UnequalEls P.emptyShape VOpaque VOpaque)

occursError : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> {a : Type}
            -> Co w a
occursError = throwU (UnequalEls P.emptyShape VOpaque VOpaque)

-- | a partial renaming: the levels of `dom` that may appear, and what
-- | they become in a context of `cod` levels
type PRen = { dom : Int, cod : Int, ren : M.Map Int Int }

lift1 : PRen -> PRen
lift1 r =
  { dom = r.dom + 1
  , cod = r.cod + 1
  , ren = M.insert compareInt r.dom r.cod r.ren
  }

iterateLift : Int -> PRen -> PRen
iterateLift i rr = if i <= 0 then rr else iterateLift (i - 1) (lift1 rr)

renameHead : {w : HFunctor}
           -> {{ms : S.state Env.StCore <: w}}
           -> {{uf : X.exn C.EqErr <: w}}
           -> PRen
           -> V.Head
           -> Co w Sx.Tm
renameHead r (HLocal l) = case M.lookup compareInt l r.ren of
  Just l' -> val (SLocal (r.cod - l' - 1))
  Nothing -> scopeError
renameHead r (HGlobal x) = val (SGlobal x)
renameHead r (HMeta m) = scopeError
renameHead r HError = throwU MentionsError

lamsU : Int -> Sx.Tm -> Sx.Tm
lamsU k body =
  if k <= 0 then body else lamsU (k - 1) (SLam (SU SmallU) (MkAbs "x" body))

eqBool : Bool -> Bool -> Bool
eqBool True True = True
eqBool False False = True
eqBool _ _ = False

cloBinderName : {v a : Type} -> V.Clo v a -> String
cloBinderName c = case V.cloName c of
  Just x -> x
  Nothing -> "x"

withTm : {a : Type} -> Sx.Tm -> (Sx.Tm -> a) -> a
withTm t k = k t

withVal : {a : Type} -> V.V -> (V.V -> a) -> a
withVal v k = k v

metaEntry : {w : HFunctor}
          -> {{ms : S.state Env.StCore <: w}}
          -> {{uf : X.exn C.EqErr <: w}}
          -> Int
          -> Co w V.MetaEntry
metaEntry m =
  bind (uGets (\c -> c.metas)) (\mc -> case M.lookup compareInt m mc of
  Just e -> val e
  Nothing -> scopeError)

solvedEntry : V.V -> Sx.Tm -> V.MetaEntry -> V.MetaEntry
solvedEntry sol stx e =
  { ty = e.ty
  , sol = Just sol
  , solStx = Just stx
  , arity = e.arity
  , name = e.name
  , span = e.span
  }

-- | store a solution for `m`
storeSol : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> Int
         -> V.V
         -> Sx.Tm
         -> Co w Unit
storeSol m sol stx =
  uModify (\c -> case M.lookup compareInt m c.metas of
  Just e ->
    Env.setMetas
      (M.insert compareInt m (solvedEntry sol stx e) c.metas)
      c.nextMeta
      c
  Nothing -> c)

-- | a solution in the trace, at the metavariable's span: its body, over
-- | one binder per local
traceSolve : {w : HFunctor}
           -> {{ms : S.state Env.StCore <: w}}
           -> {{uf : X.exn C.EqErr <: w}}
           -> Int
           -> Sx.Tm
           -> Co w Unit
traceSolve m stx =
  uModify (\c -> case M.lookup compareInt m c.metas of
  Just e ->
    Env.pushTraceAt
      e.span
      "solve"
      (\u ->
         "?"
         ^ showInt m
         ^ " ("
         ^ e.name
         ^ ") := "
         ^ Ps.printEl Ps.plainImplicits 0 Nil (zonkEl c.metas stx))
      c
  Nothing -> c)

-- | the state with a new metavariable, numbered next
newMetaIn : V.MetaEntry -> Int -> V.Ty -> Env.StCore -> Env.StCore
newMetaIn entry arity ty c =
  Env.setMetas
    (M.insert
       compareInt
       c.nextMeta
       { ty = ty
       , sol = Nothing
       , solStx = Nothing
       , arity = arity
       , name = entry.name
       , span = entry.span
       }
       c.metas)
    (c.nextMeta + 1)
    c

-- | a fresh metavariable from an old entry's name and span
newMetaFrom : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> V.MetaEntry
            -> Int
            -> V.Ty
            -> Co w Int
newMetaFrom entry arity ty = do
  n <- uGets (\c -> c.nextMeta)
  uModify (newMetaIn entry arity ty)
  val n

-- | the positions where two equal-length patterns agree
agreeing : List PatArg -> List PatArg -> List Int
agreeing args args' =
  catMaybes
    (mapWithIndexL
       0
       (\i p -> case p of
        MkPair a1 a2 -> if eqPatArg a1 a2 then Just i else Nothing)
       (zipL args args'))

inRen : PRen -> PatArg -> Bool
inRen pr (PVar l) = M.member compareInt l pr.ren
inRen pr PSelf = False

renInsert : M.Map Int Int -> Pair Int PatArg -> M.Map Int Int
renInsert mp (MkPair i (PVar l)) = M.insert compareInt l i mp
renInsert mp (MkPair i PSelf) = mp

renOf : P.CtxShape -> List PatArg -> PRen
renOf cs args =
  { dom = cs.len
  , cod = List.length args
  , ren =
      List.foldl renInsert M.empty (mapWithIndexL 0 (\i a -> MkPair i a) args)
  }

-- The judgments and renamings, knotted
--------------------------------------------------------------------------------

type UK (w : HFunctor) =
  { uty : G.Globals -> P.CtxShape -> V.Ty -> V.Ty -> Co w Unit
  , uel : G.Globals -> P.CtxShape -> V.V -> V.V -> Co w Unit
  , ubare :
        G.Globals
        -> P.CtxShape
        -> V.Head
        -> V.Spine V.V
        -> V.Head
        -> V.Spine V.V
        -> Co w Unit
  , solve :
        G.Globals -> P.CtxShape -> Int -> V.Spine V.V -> V.V -> V.V -> Co w Unit
  , ren : G.Globals -> Int -> PRen -> V.V -> Co w Sx.Tm
  , renEv : G.Globals -> Int -> PRen -> V.Ev V.V -> Co w Sx.Tm
  , renTy : G.Globals -> Int -> PRen -> V.Ty -> Co w Sx.Ty
  , renEvTy : G.Globals -> Int -> PRen -> V.Ev V.Ty -> Co w Sx.Ty
  , renFlex : G.Globals -> Int -> PRen -> Int -> V.Spine V.V -> Co w Sx.Tm
  }

-- | `?storeM := λx₁…xₙ. ?new x_kept`, from an old entry's name and
-- | span; the type must be closed (renamed into the empty context, with
-- | the occurs check against `occursM`)
solveWithPruned : {w : HFunctor}
                -> {{ms : S.state Env.StCore <: w}}
                -> {{uf : X.exn C.EqErr <: w}}
                -> (UK w)
                -> G.Globals
                -> Int
                -> Int
                -> V.MetaEntry
                -> Int
                -> List Int
                -> Co w V.V
solveWithPruned r g occursM storeM entry n kept =
  bind
    (r.renTy g occursM { dom = entry.arity, cod = 0, ren = M.empty } entry.ty)
    (\tyStx ->
       bind
         (newMetaFrom
            entry
            (List.length kept)
            (V.nom (E.evalTy g N tyStx LNil)))
         (\new ->
            withTm
              (lamsU
                 n
                 (SMetaApp
                    new
                    (A.fromList (List.map (\i -> n - i - 1) kept))
                    tyStx))
              (\stx ->
                 withVal
                   (V.nom (E.eval g N stx LNil))
                   (\sol ->
                      bind
                        (storeSol storeM sol stx)
                        (\u ->
                           bind (traceSolve storeM stx) (\u2 -> val sol))))))

-- | rename the right-hand side; one mentioning an error hole is no
-- | solution (the metavariable is left as it is)
solveRhs : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> (UK w)
         -> G.Globals
         -> P.CtxShape
         -> Int
         -> List PatArg
         -> V.V
         -> Co w Unit
solveRhs r g cs m args rhs =
  bind
    (catchU
       (bind
          (r.ren g m (renOf cs args) rhs)
          (\b -> val (Just b))) (\e -> case e of
     MentionsError -> val Nothing
     _ -> throwU e)) (\(renamed : Maybe Sx.Tm) -> case renamed of
  Nothing -> val MkUnit
  Just body ->
    withTm
      (lamsU (List.length args) body)
      (\stx ->
         withVal
           (V.nom (E.eval g N stx LNil))
           (\sol ->
              bind
                (storeSol m sol stx)
                (\u1 ->
                   bind
                     (uGets (\c -> M.member compareInt m c.poisoned))
                     (\p ->
                        bind
                          (if p then poisonEl 0 sol else val MkUnit)
                          (\u2 -> traceSolve m stx))))))

-- | `?m sp := rhs`; `self` is the flexible side, kept for postponing
solveF : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> (UK w)
       -> G.Globals
       -> P.CtxShape
       -> Int
       -> V.Spine V.V
       -> V.V
       -> V.V
       -> Co w Unit
solveF r g cs m sp rhs self =
  bind
    (uGets (\c -> c.metas))
    (\mc ->
       bind (uGets (\c -> c.selfKey)) (\sk -> case patternArgs sk mc sp of
       Nothing -> postponeU cs self rhs
       Just args -> case flexOf rhs of
         -- `?m` met on both sides: with the same pattern it is nothing; with
         -- two different patterns it depends only on the positions where
         -- the two agree (pattern intersection) -- never an occurs error
         Just (MkPair m' sp') ->
           if m' == m
             then case patternArgs sk mc sp' of
               Just args' ->
                 if eqPatArgs args' args then val MkUnit
                 else if List.length args' == List.length args
                   then bind
                       (metaEntry m)
                       (\entry ->
                          bind
                            (solveWithPruned
                               r
                               g
                               m
                               m
                               entry
                               (List.length args)
                               (agreeing args args'))
                            (\u -> val MkUnit))
                 else postponeU cs self rhs
               Nothing -> postponeU cs self rhs
           else solveRhs r g cs m args rhs
         Nothing -> solveRhs r g cs m args rhs))

uTyRigid : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> (UK w)
         -> G.Globals
         -> P.CtxShape
         -> V.Ty
         -> V.Ty
         -> Co w Unit
uTyRigid r g cs a@(VU u) b = case b of
  VU u' -> if P.eqUniverse u u' then val MkUnit else throwU (UnequalTys cs a b)
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VDecode h sp u described el) b = case b of
  VDecode h' sp' u' described' el' -> r.ubare g cs h sp h' sp'
  _ -> throwU (UnequalTys cs a b)
-- (an implicit argument's default is not the type's: it is not unified)
uTyRigid r g cs a@(VFunction level dom cod implicit dflt) b = case b of
  VFunction level' dom' cod' implicit' dflt' ->
    if P.eqLevel level level' && P.eqPlicity implicit implicit'
      then bind
          (r.uty g cs dom dom')
          (\u ->
             V.withV
               (V.local cs.len dom)
               (\x ->
                  r.uty
                    g
                    (P.bindShape (cloBinderName cod) cs)
                    (V.nom (V.appClo cod (\w -> x)))
                    (V.nom (V.appClo cod' (\w -> x)))))
    else throwU (UnequalTys cs a b)
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimInt b = case b of
  VPrimInt -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimFloat b = case b of
  VPrimFloat -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimString b = case b of
  VPrimString -> val MkUnit
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@VPrimRune b =
  if V.isRune b then val MkUnit else throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VPrimArray x) b = case b of
  VPrimArray y -> r.uty g cs x y
  _ -> throwU (UnequalTys cs a b)
uTyRigid r g cs a@(VFixed w) b =
  if V.isFixed w b then val MkUnit else throwU (UnequalTys cs a b)
uTyRigid r g cs a b = throwU (UnequalTys cs a b)

uTypeF : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> (UK w)
       -> G.Globals
       -> P.CtxShape
       -> V.Ty
       -> V.Ty
       -> Co w Unit
uTypeF r g cs a0 b0 =
  bind
    (forceTU a0)
    (\a ->
       bind
         (forceTU b0)
         (\b ->
            -- (an error hole is equal to anything: before a metavariable is
            -- solved with it)
            if V.isErrorTy a || V.isErrorTy b
              then bind (poisonTy cs.len a) (\u -> poisonTy cs.len b)
            else case flexTy a of
              Just (MkPair m sp) -> r.solve g cs m sp (V.code b) (V.code a)
              Nothing -> case flexTy b of
                Just (MkPair m sp) -> r.solve g cs m sp (V.code a) (V.code b)
                Nothing -> uTyRigid r g cs a b))

uBareF : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> (UK w)
       -> G.Globals
       -> P.CtxShape
       -> V.Head
       -> V.Spine V.V
       -> V.Head
       -> V.Spine V.V
       -> Co w Unit
uBareF r g cs h sp h' sp' =
  if V.headIsError h || V.headIsError h' then val MkUnit
  else case sp of
    SpId -> case sp' of
      SpId ->
        if C.eqHead h h' then val MkUnit
        else throwU (UnequalNeus cs h sp h' sp')
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpApp sq v -> case sp' of
      SpApp sq' v' -> bind (r.ubare g cs h sq h' sq') (\u -> r.uel g cs v v')
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpProj sq x -> case sp' of
      SpProj sq' x' ->
        bind
          (r.ubare g cs h sq h' sq')
          (\u ->
             if strEq x x' then val MkUnit
             else throwU (UnequalNeus cs h sp h' sp'))
      _ -> throwU (UnequalNeus cs h sp h' sp')
    SpSpec sq x v -> case sp' of
      SpSpec sq' x' v' ->
        bind
          (r.ubare g cs h sq h' sq')
          (\u ->
             bind
               (a := Unit)
               (if strEq x x' then val MkUnit
                else throwU (UnequalNeus cs h sp h' sp'))
               (\u2 -> r.uel g cs v v'))
      _ -> throwU (UnequalNeus cs h sp h' sp')

uElRigid : {w : HFunctor}
         -> {{ms : S.state Env.StCore <: w}}
         -> {{uf : X.exn C.EqErr <: w}}
         -> (UK w)
         -> G.Globals
         -> P.CtxShape
         -> V.V
         -> V.V
         -> V.V
         -> V.V
         -> Co w Unit
uElRigid r g cs (VNeu h sp ty expansion desc) cb a b = case cb of
  VNeu h' sp' ty' expansion' desc' -> r.ubare g cs h sp h' sp'
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VCode t) cb a b = case cb of
  VCode t' -> r.uty g cs t t'
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VLam d c) cb a b = case cb of
  VLam d' c' ->
    V.withV
      (V.local cs.len (V.lamDom (P.forceTh d)))
      (\x ->
         r.uel
           g
           (P.bindShape (cloBinderName c) cs)
           (V.nom (V.appClo c (\w -> x)))
           (V.nom (V.appClo c' (\w -> x))))
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs (VCons d) cb a b = case cb of
  VCons d' ->
    forU (zipL (A.toList d.values) (A.toList d'.values)) (\p -> case p of
    MkPair x y -> r.uel g cs (V.nom x) (V.nom y))
  _ -> throwU (UnequalEls cs a b)
uElRigid r g cs VOpaque cb a b = val MkUnit

uTermF : {w : HFunctor}
       -> {{ms : S.state Env.StCore <: w}}
       -> {{uf : X.exn C.EqErr <: w}}
       -> (UK w)
       -> G.Globals
       -> P.CtxShape
       -> V.V
       -> V.V
       -> Co w Unit
uTermF r g cs a0 b0 =
  bind
    (forceU a0)
    (\a ->
       bind
         (forceU b0)
         (\b ->
            if V.isError a || V.isError b
              then bind (poisonEl cs.len a) (\u -> poisonEl cs.len b)
            else case a of
              VOpaque -> val MkUnit
              _ -> case b of
                VOpaque -> val MkUnit
                _ -> case flexOf a of
                  Just (MkPair m sp) -> r.solve g cs m sp b a
                  Nothing -> case flexOf b of
                    Just (MkPair m sp) -> r.solve g cs m sp a b
                    Nothing -> uElRigid r g cs (canonU a) (canonU b) a b))

renameSpine : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> (UK w)
            -> G.Globals
            -> Int
            -> PRen
            -> V.Spine V.V
            -> Sx.Tm
            -> Co w Sx.Tm
renameSpine r g m pr SpId h = val h
renameSpine r g m pr (SpApp s a) h =
  bind
    (renameSpine r g m pr s h)
    (\f -> bind (r.ren g m pr a) (\x -> val (SApp f x)))
renameSpine r g m pr (SpProj s l) h =
  bind (renameSpine r g m pr s h) (\f -> val (SProj f l))
renameSpine r g m pr (SpSpec s l a) h =
  bind
    (renameSpine r g m pr s h)
    (\f -> bind (r.ren g m pr a) (\x -> val (SSpecialize f l x)))

renameClo : {w : HFunctor}
          -> {{ms : S.state Env.StCore <: w}}
          -> {{uf : X.exn C.EqErr <: w}}
          -> (UK w)
          -> G.Globals
          -> Int
          -> PRen
          -> V.Ty
          -> V.Clo V.V V.V
          -> Co w (Sx.Abs Sx.Tm)
renameClo r g m pr dom (MkClo x l f) =
  bind
    (r.renEv g m (lift1 pr) (f (V.snocL l (V.local pr.dom dom))))
    (\b -> val (MkAbs x b))
renameClo r g m pr dom (CloConst t) =
  bind (r.renEv g m pr t) (\b -> val (AbsConst b))

renameCloTy : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> (UK w)
            -> G.Globals
            -> Int
            -> PRen
            -> V.Ty
            -> V.Clo V.V V.Ty
            -> Co w (Sx.Abs Sx.Ty)
renameCloTy r g m pr dom (MkClo x l f) =
  bind
    (r.renEvTy g m (lift1 pr) (f (V.snocL l (V.local pr.dom dom))))
    (\b -> val (MkAbs x b))
renameCloTy r g m pr dom (CloConst t) =
  bind (r.renEvTy g m pr t) (\b -> val (AbsConst b))

renameEvF : {w : HFunctor}
          -> {{ms : S.state Env.StCore <: w}}
          -> {{uf : X.exn C.EqErr <: w}}
          -> (UK w)
          -> G.Globals
          -> Int
          -> PRen
          -> V.Ev V.V
          -> Co w Sx.Tm
renameEvF r g m pr (Nom v) = r.ren g m pr v
renameEvF r g m pr (Describe v) = r.ren g m pr v
renameEvF r g m pr (Become v) = bind (r.ren g m pr v) (\t -> val (SIs t))

renameEvTypeF : {w : HFunctor}
              -> {{ms : S.state Env.StCore <: w}}
              -> {{uf : X.exn C.EqErr <: w}}
              -> (UK w)
              -> G.Globals
              -> Int
              -> PRen
              -> V.Ev V.Ty
              -> Co w Sx.Ty
renameEvTypeF r g m pr (Nom a) = r.renTy g m pr a
renameEvTypeF r g m pr (Describe a) = r.renTy g m pr a
renameEvTypeF r g m pr (Become a) =
  bind (r.renTy g m pr a) (\t -> val (SIsTy t))

renameF : {w : HFunctor}
        -> {{ms : S.state Env.StCore <: w}}
        -> {{uf : X.exn C.EqErr <: w}}
        -> (UK w)
        -> G.Globals
        -> Int
        -> PRen
        -> V.V
        -> Co w Sx.Tm
renameF r g m pr v0 =
  bind (forceU v0) (\v -> case v of
  VNeu (HMeta m') sp ty expansion desc ->
    if m' == m then occursError else r.renFlex g m pr m' sp
  VNeu h sp ty expansion desc ->
    bind (renameHead pr h) (\hd -> renameSpine r g m pr sp hd)
  VCode t -> bind (r.renTy g m pr t) (\t' -> val (SCode t'))
  VLam fty body ->
    bind
      (r.renTy g m pr (P.forceTh fty))
      (\d ->
         bind
           (renameClo r g m pr (V.lamDom (P.forceTh fty)) body)
           (\b -> val (SLam d b)))
  VCons d ->
    bind
      (traverseU
         (\p -> case p of
          MkPair k x -> bind (r.renEv g m pr x) (\y -> val (MkPair k y)))
         (D.toList d))
      (\ps -> val (SCons (D.fromList ps)))
  VOpaque -> val SOpaque)

renameRecordFields : {w : HFunctor}
                   -> {{ms : S.state Env.StCore <: w}}
                   -> {{uf : X.exn C.EqErr <: w}}
                   -> (UK w)
                   -> G.Globals
                   -> Int
                   -> PRen
                   -> Int
                   -> V.Locals V.V
                   -> List (V.Locals V.V -> V.Field)
                   -> Co w (List Sx.Ty)
renameRecordFields r g m pr i ls Nil = val Nil
renameRecordFields r g m pr i ls (Cons fc rest) = case fc ls of
  MkField ty value ->
    bind
      (r.renTy g m (iterateLift i pr) ty)
      (\x ->
         bind
           (renameRecordFields
              r
              g
              m
              pr
              (i + 1)
              (V.snocL ls (V.local (pr.dom + i) ty))
              rest)
           (\xs -> val (Cons x xs)))

renameTypeF : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> (UK w)
            -> G.Globals
            -> Int
            -> PRen
            -> V.Ty
            -> Co w Sx.Ty
renameTypeF r g m pr t0 =
  bind (forceTU t0) (\t -> case t of
  VU u -> val (SU u)
  VDecode (HMeta m') sp u described el ->
    if m' == m then occursError
    else bind (r.renFlex g m pr m' sp) (\e -> val (SDecode e))
  VDecode h sp u described el ->
    bind
      (renameHead pr h)
      (\hd -> bind (renameSpine r g m pr sp hd) (\e -> val (SDecode e)))
  -- (an implicit argument's default is closed: nothing to rename)
  VFunction level dom cod implicit dflt ->
    bind
      (r.renTy g m pr dom)
      (\d ->
         bind
           (renameCloTy r g m pr dom cod)
           (\c -> val (SFunction level d c implicit dflt)))
  VRecord level capture fieldTypes defaults ->
    bind
      (renameRecordFields r g m pr 0 capture (A.toList fieldTypes.values))
      (\tys ->
         val
           (SRecord
              level
              { keys = fieldTypes.keys
              , byName = fieldTypes.byName
              , values = A.fromList tys
              }
              defaults))
  VSum vs ->
    bind
      (traverseU
         (\p -> case p of
          MkPair k args ->
            bind
              (traverseU (\a -> r.renTy g m pr (P.forceTh a)) (A.toList args))
              (\xs -> val (MkPair k (A.fromList xs))))
         (D.toList vs))
      (\ps -> val (SSum (D.fromList ps)))
  VPrimInt -> val SPrimInt
  VPrimFloat -> val SPrimFloat
  VPrimString -> val SPrimString
  VPrimRune -> val SPrimRune
  VPrimArray a -> bind (r.renTy g m pr a) (\x -> val (SPrimArray x))
  VFixed w -> val (SFixed w))

-- | Another metavariable in the solution.  If some of its arguments are
-- | out of scope, it is pruned: replaced by a fresh one without them.
renameFlexF : {w : HFunctor}
            -> {{ms : S.state Env.StCore <: w}}
            -> {{uf : X.exn C.EqErr <: w}}
            -> (UK w)
            -> G.Globals
            -> Int
            -> PRen
            -> Int
            -> V.Spine V.V
            -> Co w Sx.Tm
renameFlexF r g m pr m' sp =
  bind
    (uGets (\c -> c.metas))
    (\mc ->
       bind (uGets (\c -> c.selfKey)) (\sk -> case patternArgs sk mc sp of
       Nothing -> scopeError
       Just args ->
         if anyL (\a -> not (inRen pr a)) args
           then bind
               (metaEntry m')
               (\entry ->
                  bind
                    (solveWithPruned
                       r
                       g
                       m
                       m'
                       entry
                       (List.length args)
                       (catMaybes
                          (mapWithIndexL
                             0
                             (\i a -> if inRen pr a then Just i else Nothing)
                             args)))
                    (\sol -> r.ren g m pr (V.replay sol sp)))
         else bind
             (metaEntry m')
             (\entry ->
                bind
                  (r.renTy g m pr entry.ty)
                  (\ty ->
                     bind
                       (traverseU
                          (\a -> case a of
                           PVar l -> case M.lookup compareInt l pr.ren of
                             Just l' -> val (pr.cod - l' - 1)
                             Nothing -> scopeError
                           PSelf -> scopeError)
                          args)
                       (\idxs -> val (SMetaApp m' (A.fromList idxs) ty))))))

uk : {w : HFunctor}
   -> {{ms : S.state Env.StCore <: w}}
   -> {{uf : X.exn C.EqErr <: w}}
   -> (UK w)
uk =
  { uty = \g cs a b -> uTypeF uk g cs a b
  , uel = \g cs a b -> uTermF uk g cs a b
  , ubare = \g cs h sp h' sp' -> uBareF uk g cs h sp h' sp'
  , solve = \g cs m sp rhs self -> solveF uk g cs m sp rhs self
  , ren = \g m pr v -> renameF uk g m pr v
  , renEv = \g m pr v -> renameEvF uk g m pr v
  , renTy = \g m pr t -> renameTypeF uk g m pr t
  , renEvTy = \g m pr t -> renameEvTypeF uk g m pr t
  , renFlex = \g m pr m' sp -> renameFlexF uk g m pr m' sp
  }

uTy : {w : HFunctor}
    -> {{ms : S.state Env.StCore <: w}}
    -> {{uf : X.exn C.EqErr <: w}}
    -> G.Globals
    -> P.CtxShape
    -> V.Ty
    -> V.Ty
    -> Co w Unit
uTy g cs a b = (uk : UK w).uty g cs a b

uEl : {w : HFunctor}
    -> {{ms : S.state Env.StCore <: w}}
    -> {{uf : X.exn C.EqErr <: w}}
    -> G.Globals
    -> P.CtxShape
    -> V.V
    -> V.V
    -> Co w Unit
uEl g cs a b = (uk : UK w).uel g cs a b

-- A unification by itself
--------------------------------------------------------------------------------

-- | the world a unification is run in by itself: the core state, and
-- | failing with a conversion error
uW : HFunctor
uW = S.state Env.StCore <+> X.exn C.EqErr

msEv : S.state Env.StCore <: uW
msEv p = InL p

ufEv : X.exn C.EqErr <: uW
ufEv p = InR p

-- | its handler's monad: from a state, an answer or a conversion error,
-- | and the state after
type UStep a = Env.StCore -> Pair (Either C.EqErr a) Env.StCore

bindStep : {a b : Type}
         -> Pair (Either C.EqErr a) Env.StCore
         -> (a -> UStep b)
         -> Pair (Either C.EqErr b) Env.StCore
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

catchStep : {a : Type}
          -> (C.EqErr -> UStep a)
          -> Pair (Either C.EqErr a) Env.StCore
          -> Pair (Either C.EqErr a) Env.StCore
catchStep h (MkPair (Left e) st) = h e st
catchStep h (MkPair (Right x) st) = MkPair (Right x) st

uStateAlg : {a : Type} -> S.StateF Env.StCore UStep a -> UStep a
uStateAlg (Get k) = \c -> MkPair (Right (k c)) c
uStateAlg (Put c2 x) = \c -> MkPair (Right x) c2

uExnAlg : {a : Type} -> X.ExnF C.EqErr UStep a -> UStep a
uExnAlg (Throw err) = \c -> MkPair (Left err) c
uExnAlg (Catch m h) = \c -> catchStep h (m c)

uAlg : {a : Type}
     -> SumF (S.StateF Env.StCore) (X.ExnF C.EqErr) UStep a
     -> UStep a
uAlg (InL t) = uStateAlg t
uAlg (InR q) = uExnAlg q

uH : Handler uW
uH =
  { M = UStep
  , ret = \x c -> MkPair (Right x) c
  , bind = \m k c -> bindStep (m c) k
  , malg = \p -> uAlg p
  }

-- | a unification, from a state
runU : {a : Type} -> Co uW a -> UStep a
runU u = handle uH u

-- | >>> C.holds (resOf (runU (uTy (ms := msEv) (uf := ufEv) G.emptyGlobals P.emptyShape VPrimInt VPrimInt) Env.emptyCore))
-- | True
-- | >>> C.holds (resOf (runU (uTy (ms := msEv) (uf := ufEv) G.emptyGlobals P.emptyShape VPrimInt VPrimString) Env.emptyCore))
-- | False
resOf : Pair (Either C.EqErr Unit) Env.StCore -> Either C.EqErr Unit
resOf (MkPair e st) = e
