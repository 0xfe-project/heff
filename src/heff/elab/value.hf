-- Values.  The mutual recursion of elements and types is broken as in
-- src/heff/elab/syntax.hf: every auxiliary former is parametric, `El` is
-- parametric in the type it mentions, and `Ty` closes the knot
-- (`V = El Ty`).  Fields are positional constructor arguments; lazy
-- ones are thunks (`Params.Th`, no memoization); `abandon` fires on
-- ill-typed input only, which the elaborator never hands over.

import array as Array
import heff.util.dict as Dict
import heff.elab.fixed
import heff.elab.params as Params
import heff.elab.syntax as Syntax
import std.map as Map

-- | a local is a de Bruijn level; a meta is an implicit argument being
-- | inferred; an error is what did not elaborate
data Head = HLocal Int | HGlobal String | HMeta Int | HError

headIsError : Head -> Bool
headIsError HError = True
headIsError _ = False

data Spine v
  = SpId
  | SpApp (Spine v) v
  | SpProj (Spine v) String
  | SpSpec (Spine v) String v

data Locals v
  = LNil
  | LSnoc (Locals v) (Params.Th v)
  | LChunkSnoc (Locals v) (Array v)

-- | >>> localsAt (LSnoc (LSnoc LNil (\u -> 10)) (\u -> 20)) 0
-- | 20
-- | >>> localsAt (LChunkSnoc (LSnoc LNil (\u -> 10)) (arrayFromList [1, 2, 3])) 0
-- | 3
localsAt : {v : Type} -> Locals v -> Int -> v
localsAt LNil i = abandon
localsAt (LSnoc e v) i = if i == 0 then Params.forceTh v else localsAt e (i - 1)
localsAt (LChunkSnoc e vs) i = case Array.index vs (Array.length vs - i - 1) of
  Just v -> v
  Nothing -> localsAt e (i - Array.length vs)

snocL : {v : Type} -> Locals v -> v -> Locals v
snocL vs v = LSnoc vs (\u -> v)

-- | `Ev a`: at case N just `Nom`; at case D a description, or a
-- | definition that turned out to be an ordinary element (`Become`)
data Ev a = Nom a | Describe a | Become a

nom : {a : Type} -> Ev a -> a
nom (Nom x) = x
nom (Become x) = x
nom (Describe _) = abandon

epure : {a : Type} -> Params.Case -> a -> Ev a
epure N x = Nom x
epure De x = Describe x

emap : {a b : Type} -> (a -> b) -> Ev a -> Ev b
emap f (Nom x) = Nom (f x)
emap f (Describe x) = Describe (f x)
emap f (Become x) = Become (f x)

-- | `f` is used at case N for `Become` (whose payload is nominative)
ebind : {a b : Type} -> (a -> Ev b) -> Ev a -> Ev b
ebind f (Nom x) = f x
ebind f (Describe x) = f x
ebind f (Become x) = Become (nom (f x))

data Clo v a = MkClo String (Locals v) (Locals v -> Ev a) | CloConst (Ev a)

-- | the argument is a thunk: a closure that ignores it never evaluates it
appClo : {v a : Type} -> Clo v a -> Params.Th v -> Ev a
appClo (MkClo x vs body) v = body (LSnoc vs v)
appClo (CloConst body) v = body

cloName : {v a : Type} -> Clo v a -> Maybe String
cloName (MkClo n _ _) = Just n
cloName (CloConst _) = Nothing

data Expansion v = IntoCons (Dict.Dict v) | NotApplicable

-- | a record field: its type, and its value where specialized
data FieldOf t v = MkField t (Maybe v)

fieldTy : {t v : Type} -> FieldOf t v -> t
fieldTy (MkField ty _) = ty

fieldValue : {t v : Type} -> FieldOf t v -> Maybe v
fieldValue (MkField _ v) = v

-- | an element: `VNeu head spine ty expansion description`
data El t
  = VNeu Head (Spine (El t)) (Params.Th t) (Params.Th
                                              (Expansion (El t))) (Params.Th
                                                                     (Maybe
                                                                        (El t)))
  | VCode t
  | VLam (Params.Th t) (Clo (El t) (El t))
  | VCons (Dict.Dict (Ev (El t)))
  | VOpaque

-- | a type: `VDecode head spine universe described el` (`described`:
-- | the type the description decodes to, if any), `VFunction level dom cod implicit`,
-- | `VRecord level capture fieldTypes defaults` (the defaults as the
-- | syntax has them: they name the fields before them, not the capture)
data Ty
  = VU Params.Universe
  | VDecode Head (Spine (El Ty)) Params.Universe (Params.Th
                                                    (Maybe Ty)) (Params.Th
                                                                   (El Ty))
  | VFunction Params.Level Ty (Clo (El Ty) Ty) Params.Plicity (Maybe Syntax.Tm)
  | VRecord Params.Level (Locals (El Ty)) (Dict.Dict
                                             (Locals (El Ty)
                                              -> FieldOf Ty (El Ty))) (Dict.Dict
                                                                         Syntax.Tm)
  | VSum (Params.Variants (Params.Th Ty))
  | VPrimInt
  | VPrimFloat
  | VPrimString
  | VPrimRune
  | VPrimArray Ty
  | VFixed Fixed

type V = El Ty

type Field = FieldOf Ty V

-- | how a type behaves under the rules
data TB
  = LikeU Params.Universe
  | LikeFunction Params.Level Ty (Clo V Ty) Params.Plicity
  | LikeRecord Params.Level (Locals V) (Dict.Dict (Locals V -> Field))
  | LikeSum (Params.Variants (Params.Th Ty))
  | LikeInt
  | LikeFloat
  | LikeString
  | LikeRune
  | LikeArray Ty
  | LikeFixed Fixed
  | NoRules

behavior : Ty -> TB
behavior (VU u) = LikeU u
behavior (VDecode h sp u described el) = case described MkUnit of
  Just t -> behavior t
  Nothing -> NoRules
behavior (VFunction level dom cod implicit dflt) =
  LikeFunction level dom cod implicit
behavior (VRecord level capture fieldTypes defaults) =
  LikeRecord level capture fieldTypes
behavior (VSum st) = LikeSum st
behavior VPrimInt = LikeInt
behavior VPrimFloat = LikeFloat
behavior VPrimString = LikeString
behavior VPrimRune = LikeRune
behavior (VPrimArray a) = LikeArray a
behavior (VFixed w) = LikeFixed w

-- | >>> levelOf (VFunction Small VPrimInt (CloConst (Nom VPrimInt)) Expl Nothing)
-- | Small
levelOf : Ty -> Params.Level
levelOf (VU u) = Params.codesInto u
levelOf (VDecode h sp u described el) = Params.decodesInto u
levelOf (VFunction level dom cod implicit dflt) = level
levelOf (VRecord level capture fieldTypes defaults) = level
levelOf (VSum st) = Small
levelOf VPrimInt = Small
levelOf VPrimFloat = Small
levelOf VPrimString = Small
levelOf VPrimRune = Small
levelOf (VPrimArray a) = levelOf a
levelOf (VFixed w) = Small

-- | whether a type is `Rune`
isRune : Ty -> Bool
isRune VPrimRune = True
isRune _ = False

-- | whether a type is that fixed-width one
isFixed : Fixed -> Ty -> Bool
isFixed w (VFixed w') = eqFixed w w'
isFixed w _ = False

levelOfEv : Ev Ty -> Params.Level
levelOfEv (Nom t) = levelOf t
levelOfEv (Describe t) = levelOf t
levelOfEv (Become t) = levelOf t

-- | the domain of a lambda's function type annotation; a metavariable
-- | solution's lambdas are annotated with a placeholder universe instead,
-- | which is taken as the domain itself
lamDom : Ty -> Ty
lamDom t = case behavior t of
  LikeFunction level dom cod implicit -> dom
  _ -> t

coerceToFieldsMaybe : V -> Maybe (Dict.Dict (Ev V))
coerceToFieldsMaybe (VCons fields) = Just fields
coerceToFieldsMaybe (VNeu h sp ty expansion desc) = case expansion MkUnit of
  IntoCons fields -> Just (Dict.mapD (\f -> Nom f) fields)
  NotApplicable -> Nothing
coerceToFieldsMaybe v = Nothing

coerceToFields : V -> Dict.Dict (Ev V)
coerceToFields v = case coerceToFieldsMaybe v of
  Just fields -> fields
  Nothing -> abandon

proj : V -> String -> Ev V
proj VOpaque x = Nom VOpaque
proj v x = Dict.elemAt (coerceToFields v) x

-- | `expandRecord` makes a neutral for each field not specialized, so it
-- | takes `reflect` (they are mutually recursive, and definitions are
-- | sequential)
type Reflect = Head -> Params.Th (Spine V) -> Params.Th Ty -> Maybe (Ev V) -> V

mapMaybe : {a b : Type} -> (a -> b) -> Maybe a -> Maybe b
mapMaybe f Nothing = Nothing
mapMaybe f (Just x) = Just (f x)

fieldVal : Reflect -> Head -> Spine V -> Maybe V -> String -> Field -> V
fieldVal refl h sp desc x (MkField fty (Just v)) = v
fieldVal refl h sp desc x (MkField fty Nothing) =
  refl h (\u -> SpProj sp x) (\u -> fty) (mapMaybe (\d -> proj d x) desc)

withV : {a : Type} -> V -> (V -> a) -> a
withV v k = k v

goER : Reflect
     -> Locals V
     -> Head
     -> Spine V
     -> Maybe V
     -> List (Pair String (Locals V -> Field))
     -> List V
     -> List V
goER refl vs h sp desc Nil acc = acc
goER refl vs h sp desc (Cons (MkPair x f) rest) acc =
  withV
    (fieldVal refl h sp desc x (f vs))
    (\v -> goER refl (snocL vs v) h sp desc rest (Cons v acc))

expandRecordWith : Reflect
                 -> Params.Level
                 -> Locals V
                 -> Dict.Dict (Locals V -> Field)
                 -> Head
                 -> Spine V
                 -> Maybe V
                 -> Dict.Dict V
expandRecordWith refl level capture fieldTypes h sp desc =
  { keys = fieldTypes.keys
  , byName = fieldTypes.byName
  , values =
      Array.fromList
        (List.reverse
           (goER refl capture h sp desc (Dict.toList fieldTypes) Nil))
  }

mkNeu : Reflect -> Head -> Spine V -> Params.Th Ty -> Maybe V -> V
mkNeu refl h spine ty desc =
  VNeu
    h
    spine
    ty
    (\u -> case behavior (Params.forceTh ty) of
     LikeRecord level capture fieldTypes ->
       IntoCons (expandRecordWith refl level capture fieldTypes h spine desc)
     _ -> NotApplicable)
    (\u -> desc)

-- | Make a neutral, or, when the description says the name is really just
-- | an element (`Become`), that element.  The spine is only built in the
-- | first case, so a `Become` never forces the arguments that led to it.
reflect : Head -> Params.Th (Spine V) -> Params.Th Ty -> Maybe (Ev V) -> V
reflect h spineTh ty (Just (Describe desc)) =
  mkNeu
    (\h2 sp2 ty2 d2 -> reflect h2 sp2 ty2 d2)
    h
    (Params.forceTh spineTh)
    ty
    (Just desc)
reflect h spineTh ty (Just (Become v)) = v
reflect h spineTh ty (Just (Nom v)) = v
reflect h spineTh ty Nothing =
  mkNeu
    (\h2 sp2 ty2 d2 -> reflect h2 sp2 ty2 d2)
    h
    (Params.forceTh spineTh)
    ty
    Nothing

-- | field `x` of `v`, of type `a`: a neutral whose fields are not in hand
-- | (its type was not known to be a record's when it was made) is
-- | projected as it is
projAt : V -> String -> Ty -> Ev V
projAt v x a = case coerceToFieldsMaybe v of
  Just fields -> Dict.elemAt fields x
  Nothing -> case v of
    VNeu h sp ty expansion desc ->
      Nom (reflect h (\u -> SpProj sp x) (\u -> a) Nothing)
    _ -> proj v x

local : Int -> Ty -> V
local i a = reflect (HLocal i) (\u -> SpId) (\u -> a) Nothing

localTh : Int -> Params.Th Ty -> V
localTh i a = reflect (HLocal i) (\u -> SpId) a Nothing

-- | an error hole, of a type
errorHole : Ty -> V
errorHole a = reflect HError (\u -> SpId) (\u -> a) Nothing

-- | is it an error hole (applied, projected), or the type it decodes?
isError : V -> Bool
isError (VNeu h sp ty expansion desc) = headIsError h
isError (VCode (VDecode h sp u described el)) = headIsError h
isError _ = False

isErrorTy : Ty -> Bool
isErrorTy (VDecode h sp u described el) = headIsError h
isErrorTy _ = False

-- | decoding a description
decodeD : V -> Ev Ty
decodeD (VCode a) = Describe a
decodeD _ = abandon

-- | Encoding a type as an element of its universe.  A decoded neutral
-- | encodes back to the neutral itself, so values stay normal.
code : Ty -> V
code (VDecode h sp u described el) = Params.forceTh el
code t = VCode t

universeOfTy : Ty -> Params.Universe
universeOfTy (VU u) = u
universeOfTy _ = abandon

decodeNeu : Head
          -> Spine V
          -> Params.Th Ty
          -> Params.Th (Expansion V)
          -> Params.Th (Maybe V)
          -> Params.Universe
          -> Maybe (Ev Ty)
          -> Ty
decodeNeu h sp ty expansion desc u (Just (Describe dty)) =
  VDecode h sp u (\x -> Just dty) (\x -> VNeu h sp ty expansion desc)
decodeNeu h sp ty expansion desc u (Just (Become dty)) = dty
decodeNeu h sp ty expansion desc u (Just (Nom dty)) = dty
decodeNeu h sp ty expansion desc u Nothing =
  VDecode h sp u (\x -> Nothing) (\x -> VNeu h sp ty expansion desc)

-- | decoding an element of case N
decodeN : V -> Ty
decodeN (VCode a) = a
decodeN (VNeu h sp ty expansion desc) =
  decodeNeu
    h
    sp
    ty
    expansion
    desc
    (universeOfTy (Params.forceTh ty))
    (mapMaybe decodeD (desc MkUnit))
decodeN _ = abandon

-- | the type an error hole of a universe decodes to
errorTy : Params.Universe -> Ty
errorTy u = decodeN (errorHole (VU u))

decodeEv : Ev V -> Ev Ty
decodeEv (Nom x) = Nom (decodeN x)
decodeEv (Describe x) = decodeD x
decodeEv (Become x) = Become (decodeN x)

appTy : Ty -> Params.Th V -> Ty
appTy t arg = case behavior t of
  LikeFunction level dom cod implicit -> nom (appClo cod arg)
  _ -> abandon

-- | the type of a neutral applied; a metavariable's stays what it is
-- | past its arity
neuAppTy : Head -> Ty -> Params.Th V -> Ty
neuAppTy (HMeta m) t arg = case behavior t of
  LikeFunction level dom cod implicit -> appTy t arg
  _ -> t
neuAppTy h t arg = appTy t arg

app : V -> Params.Th V -> Ev V
app (VLam fty clo) arg = appClo clo arg
app (VNeu h sp ty expansion desc) arg =
  Nom
    (reflect
       h
       (\u -> SpApp sp (Params.forceTh arg))
       (\u -> neuAppTy h (Params.forceTh ty) arg)
       (mapMaybe (\d -> app d arg) (desc MkUnit)))
app VOpaque arg = Nom VOpaque
app f arg = abandon

setFieldValue : V -> (Locals V -> Field) -> Locals V -> Field
setFieldValue v field vs = case field vs of
  MkField ty _ -> MkField ty (Just v)

addSpecialization : Params.Level
                  -> Locals V
                  -> Dict.Dict (Locals V -> Field)
                  -> Dict.Dict Syntax.Tm
                  -> String
                  -> V
                  -> Ty
addSpecialization level capture fieldTypes defaults x v =
  VRecord
    level
    capture
    (Dict.update fieldTypes x (\field -> setFieldValue v field))
    defaults

specialize : V -> String -> V -> V
specialize (VNeu h sp ty expansion desc) x f = case desc MkUnit of
  Just (VCode (VRecord level capture fieldTypes defaults)) ->
    VNeu
      h
      (SpSpec sp x f)
      ty
      expansion
      (\u ->
         Just (VCode (addSpecialization level capture fieldTypes defaults x f)))
  _ -> abandon
specialize v x f = abandon

-- | an implicit argument's default, of a function type that takes one
-- | first
implicitDefault : Ty -> Maybe Syntax.Tm
implicitDefault (VDecode h sp u described el) = case described MkUnit of
  Just t -> implicitDefault t
  Nothing -> Nothing
implicitDefault (VFunction level dom cod implicit dflt) = dflt
implicitDefault _ = Nothing

-- | the defaults of a record type's fields (none, for another type)
defaultsOf : Ty -> Dict.Dict Syntax.Tm
defaultsOf (VDecode h sp u described el) = case described MkUnit of
  Just t -> defaultsOf t
  Nothing -> Dict.empty
defaultsOf (VRecord level capture fieldTypes defaults) = defaults
defaultsOf _ = Dict.empty

-- Metavariables
--------------------------------------------------------------------------------

-- | `solStx` is the solution as syntax, closed, under one binder per
-- | local the metavariable was applied to
type MetaEntry =
  { ty : Ty
  , sol : Maybe V
  , solStx : Maybe Syntax.Tm
  , arity : Int
  , name : String
  , span : Params.Span
  }

type MetaCtx = Map.Map Int MetaEntry

-- | a metavariable applied to the locals in scope where it was created
metaEl : Int -> Spine V -> Ty -> V
metaEl m sp ty = reflect (HMeta m) (\u -> sp) (\u -> ty) Nothing

replay : V -> Spine V -> V
replay v SpId = v
replay v (SpApp sp a) = nom (app (replay v sp) (\u -> a))
replay v (SpProj sp l) = nom (proj (replay v sp) l)
replay v (SpSpec sp l f) = specialize (replay v sp) l f

solutionOf : MetaCtx -> Int -> Maybe V
solutionOf mc m = case Map.lookup mc m of
  Just e -> e.sol
  Nothing -> Nothing

-- | a solved metavariable at the head replaced by its solution
forceEl : MetaCtx -> V -> V
forceEl mc v@(VNeu (HMeta m) sp ty expansion desc) = case solutionOf mc m of
  Just sol -> forceEl mc (replay sol sp)
  Nothing -> v
forceEl mc v = v

forceTy : MetaCtx -> Ty -> Ty
forceTy mc t@(VDecode (HMeta m) sp u described el) = case solutionOf mc m of
  Just sol -> forceTy mc (decodeN (forceEl mc (replay sol sp)))
  Nothing -> t
forceTy mc t = t

-- Projection types
--------------------------------------------------------------------------------

typeForProjection : Locals V
                  -> Dict.Dict (Locals V -> Field)
                  -> String
                  -> Dict.Dict V
                  -> Field
typeForProjection capture fieldTypes x fields =
  (Dict.at fieldTypes (Dict.keyIndex fieldTypes x))
    (LChunkSnoc
       capture
       (Array.generate (Dict.keyIndex fieldTypes x) (\j -> Dict.at fields j)))

projTy : Ty -> V -> String -> Ty
projTy t v x = case behavior t of
  LikeRecord level capture fieldTypes ->
    fieldTy
      (typeForProjection
         capture
         fieldTypes
         x
         (Dict.mapD (\e -> nom e) (coerceToFields v)))
  _ -> abandon

-- | as `projTyMaybe`, the value's fields given (`coerceToFieldsMaybe`'s:
-- | expanded once for every field of a record, not once each)
projTyWith : Ty -> Maybe (Dict.Dict (Ev V)) -> String -> Maybe Ty
projTyWith t mf x = case behavior t of
  LikeRecord level capture fieldTypes -> case mf of
    Just fields ->
      Just
        (fieldTy
           (typeForProjection
              capture
              fieldTypes
              x
              (Dict.mapD (\e -> nom e) fields)))
    Nothing -> Nothing
  _ -> Nothing

projTyMaybe : Ty -> V -> String -> Maybe Ty
projTyMaybe t v x = projTyWith t (coerceToFieldsMaybe v) x
