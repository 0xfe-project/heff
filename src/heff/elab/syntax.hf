-- Core syntax.  Elements and types are mutually recursive: `El` is
-- parametric in the type it mentions, and `Ty` closes the knot
-- (`Tm = El Ty`), as definitions are sequential.  Their fields are
-- positional constructor arguments, for the same reason.

import array as A
import heff.util.dict as D
import heff.elab.fixed
import heff.elab.params as P

-- | abstractions (syntactic closures)
data Abs a = MkAbs String a | AbsConst a

-- | an element, over the types `t` it mentions.  `SMatch` holds for each
-- | tag the names its arguments bind, and the arm.
data El t
  = SLocal Int
  | SGlobal String
  | SCode t
  | SApp (El t) (El t)
  | SLam t (Abs (El t))
  | SCons (D.Dict (El t))
  | SProj (El t) String
  | STag String (Array (El t))
  | SMatch (El t) (D.Dict (Pair (Array String) (El t)))
  | SSpecialize (El t) String (El t)
  | SIs (El t)
  | SOpaque
  | SAbandon
  | SRec (El t)
  -- | a local definition (`where`), of type `t`: the abstraction binds
  -- | the definition itself, which its body may call under a lambda
  | SFix t (Abs (El t))
  | SImplicit String (El t)
  | SPrim String
  | SMetaApp Int (Array Int) t
  | SLitInt Int
  | SLitFloat Float64
  | SLitString String
  -- | `Bytes` (the prelude's): its bytes, kept as a string of them
  | SLitBytes String
  -- | a `Rune`: its code point, a Unicode scalar value
  | SLitRune Int
  -- | an integer of a fixed-width integer type, in its range
  | SLitFixed Fixed Int
  -- | a `Float32`: the float written, rounded to one where it is computed
  | SLitFloat32 Float64

-- | a type: `SFunction level dom cod implicit default` (an implicit
-- | argument's default, a closed term, given where it is not); `SRecord
-- | level fs ds`,
-- | the fields' types and the defaults of those that have one (each
-- | under the fields before it, as a type is, and naming nothing else
-- | local: a record checked against the type is given them for the
-- | fields it leaves out)
data Ty
  = SU P.Universe
  | SDecode (El Ty)
  | SFunction P.Level Ty (Abs Ty) P.Plicity (Maybe (El Ty))
  | SRecord P.Level (D.Dict Ty) (D.Dict (El Ty))
  | SSum (P.Variants Ty)
  | SIsTy Ty
  | SPrimInt
  | SPrimFloat
  | SPrimString
  | SPrimRune
  | SPrimArray Ty
  -- | `Int8` ... `UInt64`, `Float32`
  | SFixed Fixed

type Tm = El Ty

-- | >>> isApp (SApp (SLocal 0) (SLitInt 7))
-- | 1
isApp : Tm -> Int
isApp (SApp _ _) = 1
isApp _ = 0
