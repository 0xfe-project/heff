-- From the core to what a backend emits -- the stages, in order.
--
--   core ─[Erase]→ IR ─[Lift]→ ─[Shake]→ ─[Simplify]→ ─[Shake]→ ─[Arity]→ IR
--
-- and, for the C backend, ─[ANF]→ after (`lowerProgramAnf`).

import heff.anf as An
import heff.arity as Ar
import heff.erase as Er
import heff.globals as G
import heff.ir as I
import heff.lift as Lf
import heff.shake as Sh
import heff.simplify as Si
import map as M
import prelude

type Lowered = { defs : List I.Def, errors : List String }

saturateAll : M.Map String Int -> List I.Def -> List String -> Lowered
saturateAll ar kept errors =
  { defs = map (\d -> Ar.saturate ar d) kept, errors = errors }

lowerKept : List I.Def -> List String -> Lowered
lowerKept kept errors = saturateAll (Ar.arities kept) kept errors

lowerSimplified : List String -> List String -> Si.Simplified -> Lowered
lowerSimplified roots errors si = lowerKept (Sh.shake roots si.defs) errors

lowerErased : List String -> Er.Erased -> Lowered
lowerErased roots er =
  lowerSimplified
    roots
    er.errors
    (Si.simplifyProgram er.supply (Sh.shake roots (Lf.liftProgram er.defs)))

-- | what is reached from `roots`, lowered; what cannot be, said by key
lower : G.Globals -> List String -> Lowered
lower g roots = lowerErased roots (Er.eraseProgram g)

-- A program's entry: its computation (`key`) given the runtime's handler,
-- as a definition of its own.  The handler's monad is the continuation
-- monad (`(a -> ()) -> ()`, JavaScript's asynchrony as a handler), and
-- its algebra hands each operation to the world (`perform`, the
-- runtime's): so it is known where the program is, a record, and the
-- program's computations are simplified with it -- their handler's
-- `bind` and `ret` inlined, a copy of each made for it.

entryKey : String
entryKey = "run$entry"

-- (names of its own: `$`-numbered from where erasure's ended)
entryBody : String -> Int -> I.Expr
entryBody key n =
  EApp
    (EGlobal key)
    [ ERecord
      [ MkPair
        "ret"
        (ELam
           ["x$" ++ showInt n, "k$" ++ showInt (n + 1)]
           (EApp (EVar ("k$" ++ showInt (n + 1))) [EVar ("x$" ++ showInt n)]))
      , MkPair
        "bind"
        (ELam
           [ "m$" ++ showInt (n + 2)
           , "f$" ++ showInt (n + 3)
           , "k$" ++ showInt (n + 4)
           ]
           (EApp
              (EVar ("m$" ++ showInt (n + 2)))
              [ ELam
                ["x$" ++ showInt (n + 5)]
                (EApp
                   (EVar ("f$" ++ showInt (n + 3)))
                   [ EVar ("x$" ++ showInt (n + 5))
                   , EVar ("k$" ++ showInt (n + 4))
                   ])
              ]))
      , MkPair
        "malg"
        (ELam
           ["p$" ++ showInt (n + 6), "k$" ++ showInt (n + 7)]
           (EPrimCall
              "perform"
              [EVar ("p$" ++ showInt (n + 6)), EVar ("k$" ++ showInt (n + 7))]))
      ]
    , ELam
      ["x$" ++ showInt (n + 8), "k$" ++ showInt (n + 9)]
      (EApp (EVar ("k$" ++ showInt (n + 9))) [EVar ("x$" ++ showInt (n + 8))])
    , ELam ["x$" ++ showInt (n + 10)] (ETag "MkUnit" Nil)
    ]

withEntry : String -> Er.Erased -> Er.Erased
withEntry key er =
  { defs =
      concatList
        er.defs
        (Cons (I.mkDef entryKey entryKey (entryBody key er.supply)) Nil)
  , errors = er.errors
  , supply = er.supply + 11
  }

-- | a program running the computation `key`: its entry (`entryKey`) and
-- | what it reaches, lowered
lowerProgram : G.Globals -> String -> Lowered
lowerProgram g key =
  lowerErased (Cons entryKey Nil) (withEntry key (Er.eraseProgram g))

anfSaturated : Int -> Lowered -> Lowered
anfSaturated supply l =
  { defs = An.anfProgram supply l.defs, errors = l.errors }

-- (in A-normal form: names from where the simplifier's ended)
anfKept : Int -> List I.Def -> List String -> Lowered
anfKept supply kept errors =
  anfSaturated supply (saturateAll (Ar.arities kept) kept errors)

anfSimplified : List String -> List String -> Si.Simplified -> Lowered
anfSimplified roots errors si =
  anfKept si.supply (Sh.shake roots si.defs) errors

anfLowered : List String -> Er.Erased -> Lowered
anfLowered roots er =
  anfSimplified
    roots
    er.errors
    (Si.simplifyProgram er.supply (Sh.shake roots (Lf.liftProgram er.defs)))

-- | what is reached from `roots`, lowered as `lower` does, then in
-- | A-normal form
lowerAnf : G.Globals -> List String -> Lowered
lowerAnf g roots = anfLowered roots (Er.eraseProgram g)

-- | a program, lowered as `lowerProgram` does, then in A-normal form
-- | (heff.anf): what the C backend emits, a binding for each value
-- | computed (where, with Perceus, references are taken and dropped)
lowerProgramAnf : G.Globals -> String -> Lowered
lowerProgramAnf g key =
  anfLowered (Cons entryKey Nil) (withEntry key (Er.eraseProgram g))

-- >>> (lower G.emptyGlobals Nil).defs
