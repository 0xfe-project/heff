-- A program, elaborated through the cache: a module whose making is
-- unchanged is thawed from `.heff/<module>.hc` instead of elaborated
-- again; a fresh module that elaborated clean is frozen back
-- (`heff.cache`).  The file asked for -- the last source -- is
-- always elaborated: its watches and spans are wanted.  In any world
-- with the disk in it: the command line's, the language server's.

import co
import heff.cache as Ca
import heff.driver as Dr
import heff.load as L
import fs
import map as Mp
import prelude

type CacheAcc = { done : List Dr.Checked, hashes : Mp.Map String String }

cacheDir : L.Paths -> String
cacheDir ps = L.under ps ps.root ".heff"

cachePath : L.Paths -> String -> String
cachePath ps m = L.under ps (cacheDir ps) (m ++ ".hc")

thawTry : {e : HFunctor}
        -> {{ev : fs <: e}}
        -> L.Paths
        -> Dr.Source
        -> CacheAcc
        -> Co e (Maybe Dr.Thawed)
thawTry ps s acc = do
  mtxt <- readFile (cachePath ps s.module)
  pure (case mtxt of
    Just txt -> Ca.melt acc.hashes acc.done s txt
    Nothing -> Nothing)

cacheKeep : CacheAcc -> Dr.Checked -> CacheAcc
cacheKeep acc c =
  { done = concatList acc.done (Cons c Nil)
  , hashes = Ca.defHashesInto acc.hashes c
  }

cacheStep : CacheAcc -> Dr.Source -> Maybe Dr.Thawed -> CacheAcc
cacheStep acc s th = cacheKeep acc (Dr.elabNext acc.done s th)

-- | ... a module imported, made lean as soon as it is checked: the types
-- | of its names and its trace are asked of the file asked for alone, and
-- | kept they hold on to every environment they were found in
cacheStepLean : CacheAcc -> Dr.Source -> Maybe Dr.Thawed -> CacheAcc
cacheStepLean acc s th = cacheKeep acc (Dr.lean (Dr.elabNext acc.done s th))

cachedGo : {e : HFunctor}
         -> {{ev : fs <: e}}
         -> L.Paths
         -> List Dr.Source
         -> CacheAcc
         -> Co e CacheAcc
cachedGo ps Nil acc = pure acc
cachedGo ps (Cons s Nil) acc = pure (cacheStep acc s Nothing)
cachedGo ps (Cons s rest) acc = do
  th <- thawTry ps s acc
  cachedGo ps rest (cacheStepLean acc s th)

freezeOne : {e : HFunctor}
          -> {{ev : fs <: e}}
          -> L.Paths
          -> CacheAcc
          -> Pair Dr.Source Dr.Checked
          -> Co e Unit
freezeOne ps acc (MkPair s c) =
  if c.cached || not (null c.diags) then pure MkUnit
  else case Ca.freeze acc.hashes acc.done s c of
    Just out -> do
      ok <- writeFile (cachePath ps c.module) out
      pure MkUnit
    Nothing -> pure MkUnit

freezeAll : {e : HFunctor}
          -> {{ev : fs <: e}}
          -> L.Paths
          -> CacheAcc
          -> List (Pair Dr.Source Dr.Checked)
          -> Co e Unit
freezeAll ps acc Nil = pure MkUnit
freezeAll ps acc (Cons p rest) = do
  freezeOne ps acc p
  freezeAll ps acc rest

zipSC : List Dr.Source -> List Dr.Checked -> List (Pair Dr.Source Dr.Checked)
zipSC (Cons s ss) (Cons c cs) = Cons (MkPair s c) (zipSC ss cs)
zipSC _ _ = Nil

-- | the program, each module elaborated or thawed, the fresh clean
-- | ones frozen back
cachedProgram : {e : HFunctor}
              -> {{ev : fs <: e}}
              -> L.Loaded
              -> Co e (List Dr.Checked)
cachedProgram l = do
  acc <- cachedGo l.paths l.sources { done = Nil, hashes = Mp.empty }
  ok <- mkDir (cacheDir l.paths)
  freezeAll l.paths acc (zipSC l.sources acc.done)
  pure acc.done
