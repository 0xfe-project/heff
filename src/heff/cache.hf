-- Separate compilation, as a cache the compiler manages; this is the
-- pure side: what a cache file says, and whether it may be believed.
-- A module whose making is unchanged since it last elaborated clean is
-- thawed from `.heff/<module>.hc` instead of elaborated again
-- (`heff.commands` does the reading and writing).
--
-- What a module is made of is tracked at the definitions it uses, not
-- at whole imports: a definition's hash covers its core syntax and,
-- transitively, the definitions it mentions; a module records the hash
-- of each outside definition its own mention, and one hash per direct
-- import for what its parse takes (the names defined, the fixities).
-- `version` must be bumped when elaboration changes, there being no
-- build stamp to read from inside.

import array as A
import heff.driver as Dr
import heff.fixity as F
import heff.globals as G
import heff.import as I
import heff.params as Pm
import heff.rename as Rn
import heff.serial as Se
import heff.toplevel as T
import map as Mp
import prelude

version : String
version = "heff-cache-port/8"

-- Hashing (multiplicative; private to this cache)
--------------------------------------------------------------------------------

hashStep : Int -> Int -> Int
hashStep h c = ((h + c + 1) * 1099511628211) % 18446744073709551616

hashGo : String -> Int -> Int -> Int
hashGo s i h =
  if i >= strLength s then h else hashGo s (i + 1) (hashStep h (charCode s i))

strHash : String -> String
strHash s = showInt (hashGo s 0 14695981039346656037)

-- Hashes of the definitions, and of what a parse takes
--------------------------------------------------------------------------------

hashOf : Mp.Map String String -> String -> String
hashOf m k = fromMaybe "?" (Mp.lookup compareString k m)

nubCa : List String -> List String
nubCa Nil = Nil
nubCa (Cons x xs) = Cons x (nubCa (filter (\y -> not (strEq y x)) xs))

refsOf : G.Entry -> List String
refsOf e =
  sortBy
    strLt
    (nubCa (concatList (Rn.globalsInTy e.tySyntax) (Rn.globalsInEl e.syntax)))

defHashOne : Mp.Map String String
           -> Dr.Checked
           -> Dr.Own
           -> Mp.Map String String
defHashOne m c o =
  if Mp.member compareString o.key m then m
  else case G.lookupEntry c.top.globals o.key of
    Just e ->
      Mp.insert
        compareString
        o.key
        (strHash
           (Se.encodeTy e.tySyntax
            ++ "\n"
            ++ Se.encodeEl e.syntax
            ++ "\n"
            ++ joinWith "," (map (\k -> k ++ ":" ++ hashOf m k) (refsOf e))))
        m
    Nothing -> m

-- the module itself, a struct of its definitions, and its theory:
-- mentioned bare (`M`), they hash as all of it
wholeHash : Mp.Map String String -> Dr.Checked -> Mp.Map String String
wholeHash m c =
  Mp.insert
    compareString
    (c.module ++ "#")
    (strHash
       (joinWith
          ","
          (map (\(o : Dr.Own) -> o.key ++ ":" ++ hashOf m o.key) c.own)))
    (Mp.insert
       compareString
       (c.module ++ "#T")
       (strHash
          (joinWith
             ","
             (map (\(o : Dr.Own) -> o.key ++ ":" ++ hashOf m o.key) c.own)))
       m)

-- | each definition's hash: its core syntax, and the hashes of the
-- | definitions it mentions -- so a hash covers a definition's making,
-- | transitively.  (A primitive declared again is the same one: the
-- | first hash stands.)
defHashesInto : Mp.Map String String -> Dr.Checked -> Mp.Map String String
defHashesInto hs c = wholeHash (foldl (\m o -> defHashOne m c o) hs c.own) c

assocInt : F.Assoc -> Int
assocInt AssocLeft = 0
assocInt AssocRight = 1
assocInt AssocNone = 2

fixSig : F.Fixities -> String
fixSig f =
  joinWith
    ";"
    (map
       (\(g : F.Group) ->
          g.id
          ++ ":"
          ++ showInt (assocInt g.assoc)
          ++ ":"
          ++ joinWith " " g.ops)
       f.groups)
  ++ "|"
  ++ joinWith ";" (map (\(e : F.Edge) -> e.tighter ++ ">" ++ e.looser) f.above)

-- | what a module's parse takes from a direct import: the names it
-- | defines, and the fixities it declares
nsHashOf : Dr.Checked -> String
nsHashOf c =
  strHash
    (joinWith "," (map (\(o : Dr.Own) -> o.name) c.own)
     ++ "|"
     ++ fixSig c.fixities)

-- | the modules a file imports directly, in scope by name or by alias
directOf : Dr.Source -> List String
directOf s = Dr.importNames (Dr.importsOfSource s).imports

-- Freezing: a clean module as the cache file keeps it
--------------------------------------------------------------------------------

tokPair : Pair String String -> List String
tokPair (MkPair a b) = Cons (Se.tokStr a) (Cons (Se.tokStr b) Nil)

tokCount : {a : Type} -> (a -> List String) -> List a -> List String
tokCount f xs = Cons (showInt (length xs)) (concatMap f xs)

freezeFix : F.Fixities -> List String
freezeFix f =
  concatList
    (tokCount
       (\(g : F.Group) ->
          Cons
            (Se.tokStr g.id)
            (Cons
               (showInt (assocInt g.assoc))
               (tokCount (\o -> Cons (Se.tokStr o) Nil) g.ops)))
       f.groups)
    (tokCount
       (\(e : F.Edge) ->
          Cons (Se.tokStr e.tighter) (Cons (Se.tokStr e.looser) Nil))
       f.above)

nsOf : List Dr.Checked -> String -> String
nsOf done m = case find (\(d : Dr.Checked) -> strEq d.module m) done of
  Just d -> nsHashOf d
  Nothing -> "?"

needsOf : Dr.Checked -> List String
needsOf c =
  sortBy
    strLt
    (filter
       (\k -> not (elemBy strEq k (map (\(o : Dr.Own) -> o.key) c.own)))
       (nubCa
          (concatMap
             (\(o : Dr.Own) -> case G.lookupEntry c.top.globals o.key of
              Just e ->
                concatList (Rn.globalsInTy e.tySyntax) (Rn.globalsInEl e.syntax)
              Nothing -> Nil)
             c.own)))

freezeDef : Dr.Checked
          -> Pair Dr.Own (Pair String Pm.Span)
          -> Maybe (List String)
freezeDef c (MkPair o (MkPair _ sp)) = case G.lookupEntry c.top.globals o.key of
  Just e ->
    Just
      (Cons
         (Se.tokStr o.name)
         (Cons
            (Se.tokStr o.key)
            (Cons
               (showInt sp.start)
               (Cons
                  (showInt sp.end)
                  (Cons
                     (Se.encodeTy e.tySyntax)
                     (Cons (Se.encodeEl e.syntax) Nil))))))
  Nothing -> Nothing

zipCa : {a b : Type} -> List a -> List b -> List (Pair a b)
zipCa (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipCa xs ys)
zipCa _ _ = Nil

consJust : {a : Type} -> a -> Maybe (List a) -> Maybe (List a)
consJust x (Just ys) = Just (Cons x ys)
consJust x Nothing = Nothing

allJust : {a : Type} -> List (Maybe a) -> Maybe (List a)
allJust Nil = Just Nil
allJust (Cons Nothing _) = Nothing
allJust (Cons (Just x) xs) = consJust x (allJust xs)

-- | a clean module as the cache file keeps it: under which version, as
-- | which module (a file system that does not tell case apart has one
-- | file for `a.B` and `a.b`) and from which source it elaborated, what its parse took from each direct import,
-- | which outside definitions it mentions (at which hashes), and its
-- | own definitions' syntax
freeze : Mp.Map String String
       -> List Dr.Checked
       -> Dr.Source
       -> Dr.Checked
       -> Maybe String
freeze hashes done s c = case allJust
    (map (\p -> freezeDef c p) (zipCa c.own c.top.spans)) of
  Nothing -> Nothing
  Just defs ->
    Just
      (joinWith
         " "
         (concatList
            (Cons
               (Se.tokStr version)
               (Cons
                  (Se.tokStr s.module)
                  (Cons (Se.tokStr (strHash c.source)) (freezeFix c.fixities))))
            (concatList
               (tokCount (\m -> tokPair (MkPair m (nsOf done m))) (directOf s))
               (concatList
                  (tokCount
                     (\k -> tokPair (MkPair k (hashOf hashes k)))
                     (needsOf c))
                  (tokCount (\d -> d) defs)))))

-- Melting: believing a cache file, or not
--------------------------------------------------------------------------------

mkGroup : String -> F.Assoc -> List String -> F.Group
mkGroup gid assoc ops = { id = gid, assoc = assoc, ops = ops }

mkEdge : String -> String -> F.Edge
mkEdge tighter looser = { tighter = tighter, looser = looser }

mkFixities : List F.Group -> List F.Edge -> F.Fixities
mkFixities groups above = { groups = groups, above = above }

assocOf : Int -> Maybe F.Assoc
assocOf a =
  if a == 0 then Just AssocLeft
  else if a == 1 then Just AssocRight
  else if a == 2 then Just AssocNone
  else Nothing

meltFixGroup : String -> Int -> Maybe (Pair F.Group Int)
meltFixGroup s i =
  Se.bindG
    (Se.takeStr s i)
    (\gid j ->
       Se.bindG
         (Se.takeInt s j)
         (\a j2 ->
            Se.bindG
              (Se.takeMany
                 s
                 (\j3 -> Se.takeStr s j3)
                 j2) (\ops j3 -> case assocOf a of
            Just assoc -> Se.gotG (mkGroup gid assoc ops) j3
            Nothing -> Nothing)))

meltFixEdge : String -> Int -> Maybe (Pair F.Edge Int)
meltFixEdge s i =
  Se.bindG
    (Se.takeStr s i)
    (\t j -> Se.bindG (Se.takeStr s j) (\l j2 -> Se.gotG (mkEdge t l) j2))

meltFix : String -> Int -> Maybe (Pair F.Fixities Int)
meltFix s i =
  Se.bindG
    (Se.takeMany s (\j -> meltFixGroup s j) i)
    (\gs j ->
       Se.bindG
         (Se.takeMany s (\j2 -> meltFixEdge s j2) j)
         (\es j2 -> Se.gotG (mkFixities gs es) j2))

meltPair : String -> Int -> Maybe (Pair (Pair String String) Int)
meltPair s i =
  Se.bindG
    (Se.takeStr s i)
    (\a j -> Se.bindG (Se.takeStr s j) (\b j2 -> Se.gotG (MkPair a b) j2))

meltDef : String -> Int -> Maybe (Pair T.ThawedDef Int)
meltDef s i =
  Se.bindG
    (Se.takeStr s i)
    (\name j ->
       Se.bindG
         (Se.takeStr s j)
         (\key j2 ->
            Se.bindG
              (Se.takeInt s j2)
              (\start j3 ->
                 Se.bindG
                   (Se.takeInt s j3)
                   (\end j4 ->
                      Se.bindG
                        (Se.decodeTyAt s j4)
                        (\ty j5 ->
                           Se.bindG
                             (Se.decodeElAt s j5)
                             (\body j6 ->
                                Se.gotG
                                  (T.mkThawedDef
                                     name
                                     key
                                     { start = start, end = end }
                                     ty
                                     body)
                                  j6))))))

pairsHold : (Pair String String -> Bool) -> List (Pair String String) -> Bool
pairsHold p Nil = True
pairsHold p (Cons x xs) = p x && pairsHold p xs

-- | a module believed back from its cache file: same version, same
-- | module, same source, every direct import's namespace as it was (the source is
-- | the same, so the import list is too), every needed definition at
-- | the hash it had
meltDone : Maybe (Pair Dr.Thawed Int) -> Maybe Dr.Thawed
meltDone (Just (MkPair th _)) = Just th
meltDone Nothing = Nothing

mkThawed : F.Fixities -> List T.ThawedDef -> Dr.Thawed
mkThawed fixities defs = { fixities = fixities, defs = defs }

melt : Mp.Map String String
     -> List Dr.Checked
     -> Dr.Source
     -> String
     -> Maybe Dr.Thawed
melt hashes done s text =
  meltDone
    (Se.bindG
       (Se.takeStr text 0)
       (\v i ->
          if not (strEq v version) then Nothing
          else Se.bindG
              (Se.takeStr text i)
              (\m i1 ->
                 if not (strEq m s.module) then Nothing
                 else Se.bindG
                     (Se.takeStr text i1)
                     (\srcH i2 ->
                        if not (strEq srcH (strHash s.source)) then Nothing
                        else Se.bindG
                            (meltFix text i2)
                            (\fixities i3 ->
                               Se.bindG
                                 (Se.takeMany text (\j -> meltPair text j) i3)
                                 (\ns i4 ->
                                    if not
                                      (pairsHold
                                         (\p -> case p of
                                          MkPair m h -> strEq (nsOf done m) h)
                                         ns
                                       && length ns == length (directOf s))
                                      then Nothing
                                    else Se.bindG
                                        (Se.takeMany
                                           text
                                           (\j -> meltPair text j)
                                           i4)
                                        (\needs i5 ->
                                           if not
                                             (pairsHold
                                                (\p -> case p of
                                                 MkPair k h ->
                                                   strEq (hashOf hashes k) h)
                                                needs)
                                             then Nothing
                                           else Se.bindG
                                               (Se.takeMany
                                                  text
                                                  (\j -> meltDef text j)
                                                  i5)
                                               (\defs i6 ->
                                                  Se.gotG
                                                    (mkThawed fixities defs)
                                                    i6))))))))

-- >>> strEq (strHash "abc") (strHash "abc") && not (strEq (strHash "abc") (strHash "abd"))
-- True
