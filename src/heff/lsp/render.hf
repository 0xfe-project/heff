-- Rendering diagnostics the way `diagnostician` does, under a
-- `path:line:col` header -- a span over lines marked once, in a margin,
-- as rustc does -- and in colour where the caller says so (a terminal:
-- never the language server's, or a text kept).

import heff.syntax.diagnostic
import heff.elab.params as Pm
import heff.lsp.report as Rp
import heff.util.rune as Rn

-- | a line, how many units into it (`off`, where its text is cut), and
-- | its column, of runes (`col`, what is shown: a rune one column,
-- | whatever units it takes), each from 0
type LineCol = { line : Int, off : Int, col : Int }

-- (`i`, on line `l`, which starts at `start`)
atLine : String -> Int -> Int -> Int -> LineCol
atLine src i l start =
  { line = l, off = i - start, col = Rn.runesBetween src start i }

-- (from `start`, the start of line `l`, on, its newline at `nl`, if it
-- has one: it still belongs to the line)
lineColAt : String -> Int -> Int -> Int -> Maybe Int -> LineCol
lineColAt src i l start (Just nl) =
  if i <= nl then atLine src i l start
  else lineColAt src i (l + 1) (nl + 1) (indexFrom "\n" src (nl + 1))
lineColAt src i l start Nothing = atLine src i l start

-- | 0-based line and column
-- | >>> lineCol "x\n😀a😀b" (strLength "x\n😀a😀")
-- | { line = 1, off = strLength "😀a😀", col = 3 }
lineCol : String -> Int -> LineCol
lineCol src i = lineColAt src i 0 0 (indexFrom "\n" src 0)

numDigits : Int -> Int
numDigits x = if x < 10 then 1 else 1 + numDigits (x / 10)

repeated : Int -> String -> String
repeated k c = if k <= 0 then "" else c ^ repeated (k - 1) c

lineStartFrom : String -> Int -> Int -> Int
lineStartFrom src l start = case indexFrom "\n" src start of
  Just nl -> if l == 1 then nl + 1 else lineStartFrom src (l - 1) (nl + 1)
  Nothing -> strLength src

-- (where line `l` starts, 0-based)
lineStartAt : String -> Int -> Int
lineStartAt src 0 = 0
lineStartAt src l = lineStartFrom src l 0

lineEndAt : String -> Int -> Int
lineEndAt src start = case indexFrom "\n" src start of
  Just nl -> nl
  Nothing -> strLength src

-- | how many lines a span may be over before its middle is cut: past
-- | it, its first two lines, `...` and its last two are shown
longSpan : Int
longSpan = 6

-- (the text of line `l`, 0-based, without its newline)
lineText : String -> Int -> String
lineText src l =
  strSlice src (lineStartAt src l) (lineEndAt src (lineStartAt src l))

-- (line `l`'s number, 1-based, padded to `w`, and the bar: dim, if
-- `color`)
gutterOf : Bool -> Int -> Int -> String
gutterOf color w l =
  Rp.paint
    color
    "2"
    (showInt (l + 1) ^ repeated (w - numDigits (l + 1)) " " ^ " |")

-- (a gutter without a number, under a line)
blankGutter : Bool -> Int -> String
blankGutter color w = Rp.paint color "2" (repeated w " " ^ " |")

-- | a severity's colour: of its word and code, and of the marks under
-- | the span
severityColor : Severity -> String
severityColor SError = "1;31"
severityColor SWarning = "1;33"
severityColor SDebug = "1;36"

-- (a line wholly in the span: its gutter, and the span's margin)
insideLine : Bool -> String -> String -> Int -> Int -> String
insideLine color code src w l =
  gutterOf color w l ^ " " ^ Rp.paint color code "|" ^ " " ^ lineText src l

-- (a long span's middle, cut: in the gutter's place, and the margin)
cutLine : Bool -> String -> Int -> String
cutLine color code w =
  Rp.paint color "2" ("..." ^ repeated (w - 1) " ")
  ^ " "
  ^ Rp.paint color code "|"

insideRange : Bool -> String -> String -> Int -> Int -> Int -> List String
insideRange color code src w l le =
  if l > le then Nil
  else Cons
      (insideLine color code src w l)
      (insideRange color code src w (l + 1) le)

-- (the lines between a span's first and last: all of them, or of more
-- than `longSpan` lines, the second, `...` and the last but one)
middleLines : Bool -> String -> String -> Int -> Int -> Int -> List String
middleLines color code src w ls le =
  if le - ls + 1 > longSpan
    then [ insideLine color code src w (ls + 1)
         , cutLine color code w
         , insideLine color code src w (le - 1)
         ]
  else insideRange color code src w (ls + 1) (le - 1)

-- (only spaces are before `s` in its line)
spacesBefore : String -> LineCol -> Bool
spacesBefore src s =
  strEq
    (trim
       (strSlice src (lineStartAt src s.line) (lineStartAt src s.line + s.off)))
    ""

-- (the first line of a span over lines, and what marks its start: `/` in
-- the margin where only spaces are before it, else a line of `_` to it)
firstLines : Bool -> String -> String -> Int -> LineCol -> List String
firstLines color code src w s =
  if spacesBefore src s
    then [ gutterOf color w s.line
         ^ " "
         ^ Rp.paint color code "/"
         ^ " "
         ^ lineText src s.line
         ]
  else [ gutterOf color w s.line ^ "   " ^ lineText src s.line
       , blankGutter color w
       ^ "  "
       ^ Rp.paint color code (repeated (s.col + 1) "_" ^ "^")
       ]

-- (a span over lines, `s` to `e` (`e` its last character): a margin
-- from its start to its end, as rustc)
spanLines : Bool -> String -> String -> Int -> LineCol -> LineCol -> String
spanLines color code src w s e =
  joinWith
    "\n"
    (List.append
       (firstLines color code src w s)
       (List.append
          (middleLines color code src w s.line e.line)
          [ insideLine color code src w e.line
          , blankGutter color w
          ^ " "
          ^ Rp.paint color code ("|" ^ repeated (e.col + 1) "_" ^ "^")
          ]))

-- (a span in a line, from `b` to `e` of it, which starts at `ls`: the
-- line, and `^` under its characters, a column each)
oneLineIn : Bool
          -> String
          -> String
          -> Int
          -> Int
          -> Int
          -> Int
          -> Int
          -> String
oneLineIn color code src w l ls b e =
  gutterOf color w l
  ^ " "
  ^ lineText src l
  ^ "\n"
  ^ gutterOf color w l
  ^ " "
  ^ repeated (Rn.runesBetween src ls b) " "
  ^ Rp.paint color code (repeated (max 1 (Rn.runesBetween src b e)) "^")

-- (a span in a line: the line, and `^` under its characters)
oneLine : Bool -> String -> String -> Pm.Span -> Int -> Int -> String
oneLine color code src sp w l =
  oneLineIn
    color
    code
    src
    w
    l
    (lineStartAt src l)
    (max (lineStartAt src l) sp.start)
    (min (lineEndAt src (lineStartAt src l)) sp.end)

linesPrettyAt : Bool
              -> String
              -> String
              -> Pm.Span
              -> LineCol
              -> LineCol
              -> String
linesPrettyAt color code src sp s e =
  if s.line == e.line
    then oneLine color code src sp (numDigits (s.line + 1)) s.line
  else spanLines color code src (numDigits (e.line + 1)) s e

-- | the span's lines, each under its number: a span in a line, its
-- | characters pointed at by `^`; a span over lines, marked once, in a
-- | margin from its start to its end (as rustc); the marks in `code`'s
-- | colour, and the gutter dim, if `color`
-- | >>> linesPretty False "" "one : Int\none = 2\n" { start = 10, end = 13 }
-- | "2 | one = 2\n2 | ^^^"
-- | >>> linesPretty False "" "f =\n  case x of\n    A -> 1\n    B -> 2\n" { start = 6, end = 37 }
-- | "2 | /   case x of\n3 | |     A -> 1\n4 | |     B -> 2\n  | |__________^"
-- | >>> linesPretty False "" "f = case x of\n  A -> 1\n  B -> 2\n" { start = 4, end = 31 }
-- | "1 |   f = case x of\n  |  _____^\n2 | |   A -> 1\n3 | |   B -> 2\n  | |________^"
-- | >>> linesPretty False "" "a\nb\nc\nd\ne\nf\ng\nh\ni\nj\n" { start = 2, end = 19 }
-- | "2  | / b\n3  | | c\n...  |\n9  | | i\n10 | | j\n   | |_^"
-- |
-- | (a column is a rune, whatever units it takes)
-- | >>> linesPretty False "" "s = \"😀\" ++ 1\n" { start = strLength "s = \"😀\" ", end = strLength "s = \"😀\" ++" }
-- | "1 | s = \"😀\" ++ 1\n1 |         ^^"
-- | >>> linesPretty False "" "😀 = case x of\n  A -> \"😀\"\n" { start = strLength "😀 = ", end = strLength "😀 = case x of\n  A -> \"😀\"" }
-- | "1 |   😀 = case x of\n  |  _____^\n2 | |   A -> \"😀\"\n  | |__________^"
-- |
-- | (in colour: the escapes, `ESC` here, about the gutter and the marks)
-- | >>> joinWith "ESC" (split "\x1b" (linesPretty True "31" "x = 1\n" { start = 4, end = 5 }))
-- | "ESC[2m1 |ESC[0m x = 1\nESC[2m1 |ESC[0m     ESC[31m^ESC[0m"
linesPretty : Bool -> String -> String -> Pm.Span -> String
linesPretty color code src sp =
  linesPrettyAt
    color
    code
    src
    sp
    (lineCol src sp.start)
    (lineCol src (max sp.start (sp.end - 1)))

severityWord : Severity -> String
severityWord SDebug = "debug"
severityWord SWarning = "warning"
severityWord SError = "error"

severityLetter : Severity -> String
severityLetter SDebug = "D"
severityLetter SWarning = "W"
severityLetter SError = "E"

-- | a diagnostic's code, as every command and the language server write
-- | it: its severity's letter and four digits
-- | >>> codeOf { code = 151, severity = SWarning, msg = "", span = { start = 0, end = 0 }, note = Nothing }
-- | "W0151"
codeOf : Diag -> String
codeOf d =
  severityLetter d.severity
  ^ repeated (4 - numDigits d.code) "0"
  ^ showInt d.code

prtCode : Diag -> String
prtCode d = severityWord d.severity ^ "[" ^ codeOf d ^ "]"

-- | a diagnostic: its severity and code, its message, where it is, its
-- | note; in colour (the terminal's), if `color`
renderDiag : Bool -> String -> Diag -> String
renderDiag color src d =
  Rp.paint color (severityColor d.severity) (prtCode d)
  ^ ": "
  ^ d.msg
  ^ "\n"
  ^ linesPretty color (severityColor d.severity) src d.span
  ^ (case d.note of
     Just n -> "\n" ^ n
     Nothing -> "")

fileDiag : Bool -> String -> String -> Diag -> String
fileDiag color path src d =
  path
  ^ ":"
  ^ showInt ((lineCol src d.span.start).line + 1)
  ^ ":"
  ^ showInt ((lineCol src d.span.start).col + 1)
  ^ "\n"
  ^ renderDiag color src d
  ^ "\n\n"

-- | each diagnostic under `path:line:col` (in colour, if `color`)
renderFileDiags : Bool -> String -> String -> List Diag -> String
renderFileDiags color path src ds =
  joinWith "" (List.map (\(d : Diag) -> fileDiag color path src d) ds)
