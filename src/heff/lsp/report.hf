-- A test's report, where it meets the terminal: what differs between an
-- expectation and a value (`heff.util.diff`, word by word), and whether
-- colour may be used (`HEFF_TTY=1` says yes, `NO_COLOR` no) -- an
-- effect, so that its side is the host's.

module heff.lsp.report

import co
import heff.util.diff as Diff
import heff.util.rune as RuneUtil

data ReportF (m : Type -> Type) x = UseColor (Bool -> x) | ErrColor (Bool -> x)

-- | A test's report, at the terminal, as an effect.
report : HFunctor
report =
  { f = ReportF
  , hfmap = \m g p -> case p of
      UseColor k -> UseColor (\b -> g (k b))
      ErrColor k -> ErrColor (\b -> g (k b))
  , hmap = \m n nt p -> case p of
      UseColor k -> UseColor k
      ErrColor k -> ErrColor k
  }

-- | the standard output is a terminal, and `NO_COLOR` is not set
useColor : {e : HFunctor} -> {{ev : report <: e}} -> Co e Bool
useColor = op (ev (UseColor (\b -> b))) val

-- | the standard error is a terminal, and `NO_COLOR` is not set (where
-- | a diagnostic is written)
errColor : {e : HFunctor} -> {{ev : report <: e}} -> Co e Bool
errColor = op (ev (ErrColor (\b -> b))) val

-- | the expectation and the value, cut to where they differ, and the
-- | difference, `[-expected-]` and `{+got+}`
type Mismatch = { expected : String, got : String, diff : String }

mkMismatch : String -> String -> String -> Mismatch
mkMismatch e g d = { expected = e, got = g, diff = d }

-- | how much of a stretch alike is kept at each end of it
context : Int
context = 20

-- (its first `context` units, and its last: each where a rune starts,
-- not in one)
headOf : String -> String
headOf s = strSlice s 0 (RuneUtil.runeStart s context)

tailOf : String -> String
tailOf s =
  strSlice s (RuneUtil.runeStart s (strLength s - context)) (strLength s)

-- | a stretch alike: kept whole if short, else its ends (only the end
-- | after the start, only the start before the end), not cut in a rune
-- | >>> List.map (\(c : String) -> strEq (fromRunes (runes c)) c) (List.map (\(b : Bool) -> cut ("é" ^ joinWith "" (List.replicate 30 "😀")) b False) [False, True])
-- | [True, True]
cut : String -> Bool -> Bool -> String
cut s first last =
  if strLength s <= 2 * context + 1 then s
  else if first then "…" ^ tailOf s
  else if last then headOf s ^ "…"
  else headOf s ^ "…" ^ tailOf s

escape : String -> String
escape code = "\x1b[" ^ code ^ "m"

-- | `s` in a colour (`31`, red; `32`, green), if `color`
paint : Bool -> String -> String -> String
paint color code s = if color then escape code ^ s ^ escape "0" else s

mismatchGo : Bool
           -> Int
           -> Int
           -> List (Diff.Edit String)
           -> Mismatch
           -> Mismatch
mismatchGo color i n Nil m = m
mismatchGo color i n (Cons (Added v) rest) m =
  mismatchGo
    color
    (i + 1)
    n
    rest
    (mkMismatch
       m.expected
       (m.got ^ paint color "32" v)
       (m.diff ^ paint color "32" ("{+" ^ v ^ "+}")))
mismatchGo color i n (Cons (Removed v) rest) m =
  mismatchGo
    color
    (i + 1)
    n
    rest
    (mkMismatch
       (m.expected ^ paint color "31" v)
       m.got
       (m.diff ^ paint color "31" ("[-" ^ v ^ "-]")))
mismatchGo color i n (Cons (Same v) rest) m =
  mismatchGo
    color
    (i + 1)
    n
    rest
    (mkMismatch
       (m.expected ^ cut v (i == 0) (i == n - 1))
       (m.got ^ cut v (i == 0) (i == n - 1))
       (m.diff ^ cut v (i == 0) (i == n - 1)))

-- | what differs between `expected` and `got` (in colour, if `color`)
-- | >>> (mismatch False "a onn b" "a on b").diff
-- | "a [-onn-]{+on+} b"
mismatch : Bool -> String -> String -> Mismatch
mismatch color expected got =
  mismatchGo
    color
    0
    (List.length (Diff.diffWords expected got))
    (Diff.diffWords expected got)
    (mkMismatch "" "" "")
