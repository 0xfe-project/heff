-- A language server (the Language Server Protocol, over stdio) for `.hf`
-- files: diagnostics, hover, go to definition, completion, formatting,
-- an outline, the occurrences of a name in the document, splitting a
-- variable into cases, the module claim's name (a quick fix, and
-- `heff/moduleName` for an editor to write it); and, over the whole
-- project, references and renaming, and the symbols of every file.
--
-- A document is elaborated with what it imports, from its text in the
-- editor; an import open in the editor is read from there too, else from
-- disk.  The project -- every file under its root, with what each
-- imports -- is elaborated when it is asked about, and kept until a
-- document changes; for a name's references and renaming, only the
-- files whose text has the name are elaborated, what else they import
-- thawed from the cache.  A local's are found in its document alone.  The server pulls: it awaits a
-- message, or the time a document's check waits for, and its state goes
-- along the loop.  A failure of heff's own -- elaborating a document,
-- answering a message -- is caught: said of the document, or answered
-- the request as an error, and the server serves on.

module heff.lsp.lsp

import co
import heff.syntax.diagnostic
import heff.build.driver as Driver
import heff.syntax.fixity as Fixity
import heff.syntax.format as Format
import heff.syntax.import as Import
import json
import heff.build.load as Load
import heff.elab.params as Params
import heff.build.query as Query
import heff.lsp.render as Render
import heff.lsp.rpc as RPC
import heff.lsp.split as Split
import heff.build.session as Session
import std.ordmap as OrdMap
import rune as Rune
import std.filesystem
import heff.util.files as Files
import std.path as Path
import uint8 as UInt8

-- State
--------------------------------------------------------------------------------

type Doc = { uri : String, text : String }

-- | a document's last elaboration, of what text
type Elaborated = { text : String, program : List Driver.Checked }

-- | a project elaborated: every file of it (`names` nothing), or those
-- | whose text has one of `names`, a name's references being looked for;
-- | whether no document has changed since; and the modules elaborated
-- | in it, kept to be used again while they are as they were
type Project =
  { root : String
  , names : Maybe (List String)
  , program : List Driver.Checked
  , current : Bool
  , kept : OrdMap.OrdMap String Session.Kept
  }

-- | the documents open, by path; the last elaboration of each; when a
-- | document changed in the editor is to be checked (the typing paused);
-- | the project last elaborated, by its root, and for which names
-- | (elaborated again when a document has changed); whether the client tells of files changed on disk when
-- | asked to (`watch`); the standard library
type St =
  { docs : OrdMap.OrdMap String Doc
  , checked : OrdMap.OrdMap String Elaborated
  , due : OrdMap.OrdMap String Int
  , project : Maybe Project
  , watch : Bool
  , shutdown : Bool
  , lib : Load.Host
  }

mkSt : OrdMap.OrdMap String Doc
     -> OrdMap.OrdMap String Elaborated
     -> OrdMap.OrdMap String Int
     -> Maybe Project
     -> Bool
     -> Bool
     -> Load.Host
     -> St
mkSt docs checked due project watch shutdown lib =
  { docs = docs
  , checked = checked
  , due = due
  , project = project
  , watch = watch
  , shutdown = shutdown
  , lib = lib
  }

withDocs : OrdMap.OrdMap String Doc -> St -> St
withDocs d s = mkSt d s.checked s.due s.project s.watch s.shutdown s.lib

withChecked : OrdMap.OrdMap String Elaborated -> St -> St
withChecked c s = mkSt s.docs c s.due s.project s.watch s.shutdown s.lib

withDue : OrdMap.OrdMap String Int -> St -> St
withDue t s = mkSt s.docs s.checked t s.project s.watch s.shutdown s.lib

withProject : Maybe Project -> St -> St
withProject p s = mkSt s.docs s.checked s.due p s.watch s.shutdown s.lib

withWatch : Bool -> St -> St
withWatch w s = mkSt s.docs s.checked s.due s.project w s.shutdown s.lib

mkDoc : String -> String -> Doc
mkDoc uri text = { uri = uri, text = text }

mkElaborated : String -> List Driver.Checked -> Elaborated
mkElaborated text program = { text = text, program = program }

mkProject : String
          -> Maybe (List String)
          -> List Driver.Checked
          -> Bool
          -> OrdMap.OrdMap String Session.Kept
          -> Project
mkProject root names program current kept =
  { root = root
  , names = names
  , program = program
  , current = current
  , kept = kept
  }

-- | the project, to be elaborated again: a document has changed
staled : St -> St
staled s = case s.project of
  Just pr ->
    withProject (Just (mkProject pr.root pr.names pr.program False pr.kept)) s
  Nothing -> s

shutDown : St -> St
shutDown s = mkSt s.docs s.checked s.due s.project s.watch True s.lib

-- JSON
--------------------------------------------------------------------------------

jtrue : Json
jtrue = JBool True

jfalse : Json
jfalse = JBool False

message : List (Pair String Json) -> Json
message fs = obj (Cons (kv "jsonrpc" (jstr "2.0")) fs)

-- Positions
--------------------------------------------------------------------------------

lineEnd : String -> Int -> Int
lineEnd src i = fromMaybe (strLength src) (indexOf "\n" src i)

-- An LSP position is a line and UTF-16 code units into it, the
-- protocol's default (and all VS Code speaks); a heff string is bytes,
-- UTF-8, so a line is walked a rune at a time, each one unit of UTF-16
-- or, beyond U+FFFF, two.

-- (how many units of UTF-16 a rune takes)
units16 : Int -> Int
units16 c = if c >= 65536 then 2 else 1

-- (the units of UTF-16 of the runes that start from `i` and before `j`,
-- `n` more)
units16Go : String -> Int -> Int -> Int -> Int
units16Go src i j n =
  if i >= j || i >= strLength src then n
  else if byteAt src i < 128 then units16Go src (i + 1) j (n + 1)
  else (let r = runeAt src i
        in units16Go src (i + r.width) j (n + units16 (Rune.toInt r.rune)))

-- (from `i`, `n` units of UTF-16 in, by the line's end `e`: the start of
-- the rune there, or `e`)
offset16 : String -> Int -> Int -> Int -> Int
offset16 src i e n =
  if n <= 0 || i >= e then min i e
  else if byteAt src i < 128 then offset16 src (i + 1) e (n - 1)
  else (let r = runeAt src i
        in offset16 src (i + r.width) e (n - units16 (Rune.toInt r.rune)))

-- (line `line` and `ch` units into it, from line `l`, which starts at `i`)
offsetGo : String -> Int -> Int -> Int -> Int -> Int
offsetGo src line ch i l =
  if l >= line then offset16 src i (lineEnd src i) ch
  else case indexOf "\n" src i of
    Just e -> offsetGo src line ch (e + 1) (l + 1)
    Nothing -> strLength src

-- | an LSP position as an offset
-- | >>> List.map (offsetOf "a\n😀bc" 1) [0, 2, 3, 9]
-- | [2, strLength "a\n😀", strLength "a\n😀b", strLength "a\n😀bc"]
offsetOf : String -> Int -> Int -> Int
offsetOf src line ch = offsetGo src line ch 0 0

-- (`i`, on its line and column)
positionAt : String -> Int -> Render.LineCol -> Json
positionAt src i lc =
  obj
    [ kv "line" (num lc.line)
    , kv "character" (num (units16Go src (i - lc.off) i 0))
    ]

-- | an offset as an LSP position
-- | >>> List.map (\i -> stringify (position "a\n😀bc" i)) [2, strLength "a\n😀", 99]
-- | ["{\"line\":1,\"character\":0}", "{\"line\":1,\"character\":2}", "{\"line\":1,\"character\":4}"]
position : String -> Int -> Json
position src i =
  positionAt
    src
    (max 0 (min (strLength src) i))
    (Render.lineCol src (max 0 (min (strLength src) i)))

range : String -> Params.Span -> Json
range src sp =
  obj
    [ kv "start" (position src sp.start)
    , kv "end" (position src (max sp.start sp.end))
    ]

-- | the offset a `textDocument/...` request is at
offsetIn : String -> Json -> Int
offsetIn src params =
  offsetOf
    src
    (fromMaybe 0 (int ["position", "line"] params))
    (fromMaybe 0 (int ["position", "character"] params))

wholeSpan : String -> Params.Span
wholeSpan text = Query.mkSpan 0 (strLength text)

-- The world
--------------------------------------------------------------------------------

reply : {e : HFunctor} -> {{wire : RPC.rpc <: e}} -> Json -> Json -> Co e Unit
reply id result = RPC.send (message [kv "id" id, kv "result" result])

replyError : {e : HFunctor}
           -> {{wire : RPC.rpc <: e}}
           -> Json
           -> Int
           -> String
           -> Co e Unit
replyError id code msg =
  RPC.send
    (message
       [ kv "id" id
       , kv "error" (obj [kv "code" (num code), kv "message" (jstr msg)])
       ])

notify : {e : HFunctor}
       -> {{wire : RPC.rpc <: e}}
       -> String
       -> Json
       -> Co e Unit
notify method params =
  RPC.send (message [kv "method" (jstr method), kv "params" params])

publish : {e : HFunctor}
        -> {{wire : RPC.rpc <: e}}
        -> String
        -> List Json
        -> Co e Unit
publish uri ds =
  notify
    "textDocument/publishDiagnostics"
    (obj [kv "uri" (jstr uri), kv "diagnostics" (JArray ds)])

-- Diagnostics
--------------------------------------------------------------------------------

severityNum : Severity -> Int
severityNum SError = 1
severityNum SWarning = 2
severityNum SDebug = 4

-- | the message and note of a diagnostic, without the source snippet (an
-- | editor shows the span itself)
diagMessage : Diag -> String
diagMessage d@{ note = Just n } = d.msg ^ "\n" ^ n
diagMessage d@{ note = Nothing } = d.msg

diagnostic : String -> Diag -> Json
diagnostic src d =
  obj
    (List.append
       [ kv "range" (range src d.span)
       , kv "severity" (num (severityNum d.severity))
       , kv "source" (jstr "heff")
       , kv "message" (jstr (diagMessage d))
       ]
       (if d.code == 0 then Nil else [kv "code" (jstr (Render.codeOf d))]))

zeroSpan : Params.Span
zeroSpan = Query.mkSpan 0 0

mkDiag : Severity -> Params.Span -> String -> Diag
mkDiag sev sp msg =
  { code = 0, severity = sev, msg = msg, span = sp, note = Nothing }

importSpan : List Import.Import -> String -> Params.Span
importSpan imports m = case List.find
    (\(i : Import.Import) -> strEq i.name m)
    imports of
  Just i -> i.span
  Nothing -> zeroSpan

-- (what did not load, at the `import` line that names it)
loadError : List Import.Import -> String -> Diag
loadError imports e =
  mkDiag
    SError
    (case List.find
       (\(i : Import.Import) -> contains (" " ^ i.name ^ " ") e)
       imports of
     Just i -> i.span
     Nothing -> zeroSpan)
    e

-- (a module imported that does not elaborate, at its `import` line)
brokenImport : List Import.Import -> Driver.Checked -> Maybe Diag
brokenImport imports c =
  if not (List.null (Driver.errorsIn c))
     && List.any (\(i : Import.Import) -> strEq i.name c.module) imports
  then Just
      (mkDiag
         SWarning
         (importSpan imports c.module)
         ("module "
          ^ c.module
          ^ " ("
          ^ c.path
          ^ ") does not elaborate: "
          ^ debug (List.length (Driver.errorsIn c))
          ^ " error"
          ^ (if List.length (Driver.errorsIn c) == 1 then "" else "s")))
  else Nothing

dropLast : {a : Type} -> List a -> List a
dropLast xs = List.reverse (List.drop 1 (List.reverse xs))

catMaybesL : {a : Type} -> List (Maybe a) -> List a
catMaybesL Nil = Nil
catMaybesL (Cons (Just x) rest) = Cons x (catMaybesL rest)
catMaybesL (Cons Nothing rest) = catMaybesL rest

-- | a document's own diagnostics; what did not load; the modules it
-- | imports that do not elaborate, at their `import` lines
diagsOf : String -> List Driver.Checked -> List String -> List Diag
diagsOf src program errors =
  List.append
    (case List.last program of
     Just c -> c.diags
     Nothing -> Nil)
    (List.append
       (List.map (\e -> loadError (Import.readImports src).imports e) errors)
       (catMaybesL
          (List.map
             (\c -> brokenImport (Import.readImports src).imports c)
             (dropLast program))))

-- | a document's text as the editor has it, else the disk's
readOpen : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> St
         -> String
         -> Co e (Maybe String)
readOpen st p = case OrdMap.lookup st.docs p of
  Just d -> pure (Just d.text)
  Nothing -> Files.readFile p

keptOf : List Driver.Checked -> List Driver.Checked
keptOf program = case List.last program of
  Just c ->
    List.append (List.map Driver.lean (dropLast program)) [Driver.traceless c]
  Nothing -> Nil

-- | what a document's elaboration comes to: what is kept of the program,
-- | and the diagnostics to publish
type Analysed = { program : List Driver.Checked, diags : List Json }

mkAnalysed : List Driver.Checked -> List Json -> Analysed
mkAnalysed program diags = { program = program, diags = diags }

-- (a document's elaboration, of the program loaded: what is kept of it
-- -- the document's names with their types, for hover; of what it
-- imports, what a query over it needs -- and what is wrong)
analysisFrom : Doc -> Load.Loaded -> List Driver.Checked -> Analysed
analysisFrom d l full =
  mkAnalysed
    (keptOf full)
    (List.map
       (\x -> diagnostic d.text x)
       (diagsOf d.text (keptOf full) l.errors))

analysed : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> St
         -> String
         -> Doc
         -> Co e Analysed
analysed st f d = do
  l <- Load.loadProgramWith (\p -> readOpen st p) st.lib f
  full <- Session.cachedProgram l
  pure (analysisFrom d l full)

-- A check that did not finish
--------------------------------------------------------------------------------

-- An elaboration that stops -- abandons, fails in the runtime -- leaves
-- nothing of what it found.  The document's declarations before the
-- one it stopped at are elaborated again, alone, to say what they have
-- wrong, and to have them for a hover; which one it stopped at is
-- searched for, halving.  (Each declaration is elaborated after those
-- above it, so the text up to one elaborates if the whole did up to
-- there.)

-- | a declaration at the top level of a document: where it starts, the
-- | comments right above it with it, and its name's span
type TopDecl = { cut : Int, name : Params.Span }

mkTopDecl : Int -> Params.Span -> TopDecl
mkTopDecl cut name = { cut = cut, name = name }

-- | a line of a text: its offset, and what it says
type Line = { at : Int, text : String }

linesFrom : String -> Int -> List Line
linesFrom src i =
  if i >= strLength src then Nil
  else Cons
      { at = i, text = strSlice src i (lineEnd src i) }
      (linesFrom src (lineEnd src i + 1))

-- (where the word of a line from `i` ends)
wordEnd : String -> Int -> Int
wordEnd l i =
  if i >= strLength l || contains (strSlice l i (i + 1)) " \t\r(){}[]:,="
  then i
  else wordEnd l (i + 1)

-- (where the spaces from `i` end)
spaceEnd : String -> Int -> Int
spaceEnd l i =
  if i < strLength l && (byteAt l i == 32 || byteAt l i == 9)
  then spaceEnd l (i + 1)
  else i

firstWord : String -> String
firstWord l = strSlice l 0 (wordEnd l 0)

-- (a word a declaration's name comes after)
declKeyword : String -> Bool
declKeyword w =
  List.any
    (\k -> strEq k w)
    [ "data"
    , "type"
    , "theory"
    , "instance"
    , "mutual"
    , "infix"
    , "infixl"
    , "infixr"
    ]

-- (the span of what a declaration's line names, in the line: a word, or
-- the one after its keyword)
namedIn : String -> Params.Span
namedIn l =
  if declKeyword (firstWord l)
     && wordEnd l (spaceEnd l (wordEnd l 0)) > spaceEnd l (wordEnd l 0)
  then Query.mkSpan
      (spaceEnd l (wordEnd l 0))
      (wordEnd l (spaceEnd l (wordEnd l 0)))
  else Query.mkSpan 0 (max 1 (wordEnd l 0))

-- (what tells a declaration from the next: its name, and its keyword)
keyOf : String -> String
keyOf l =
  strSlice l (namedIn l).start (namedIn l).end
  ^ " "
  ^ (if declKeyword (firstWord l) then firstWord l else "")

-- (a comment at the start of a line)
commentLine : String -> Bool
commentLine l = startsWith "--" l || startsWith "{-" l

-- (a line a declaration starts with, or goes on with: at the start of
-- its line, no comment, no claim or import)
declLine : String -> Bool
declLine l =
  strLength l > 0
  && not (byteAt l 0 == 32 || byteAt l 0 == 9 || byteAt l 0 == 13)
  && not (commentLine l)
  && not (strEq (firstWord l) "module" || strEq (firstWord l) "import")

shiftedBy : Int -> Params.Span -> Params.Span
shiftedBy n sp = Query.mkSpan (sp.start + n) (sp.end + n)

-- (the declarations of the lines: the key of the one before, and where
-- the comments right above began)
declsGo : List Line -> String -> Maybe Int -> List TopDecl
declsGo Nil key above = Nil
declsGo (Cons l rest) key above =
  if commentLine l.text then declsGo rest key (Just (fromMaybe l.at above))
  else if declLine l.text && not (strEq (keyOf l.text) key)
  then Cons
      (mkTopDecl (fromMaybe l.at above) (shiftedBy l.at (namedIn l.text)))
      (declsGo rest (keyOf l.text) Nothing)
  else declsGo rest key Nothing

-- | the declarations at the top level of a text, in order
-- | >>> List.map (\(t : TopDecl) -> t.cut) (topDecls "module m\n\n-- | one\nx : Int\nx = 1\n\ndata T = A\n")
-- | [10, 34]
topDecls : String -> List TopDecl
topDecls src = declsGo (linesFrom src 0) "" Nothing

-- (where the text of the first `k` declarations ends)
cutOf : String -> List TopDecl -> Int -> Int
cutOf src ds k = case List.head (List.drop k ds) of
  Just t -> t.cut
  Nothing -> strLength src

-- | a document elaborated as far as its text up to `cut` goes (not kept
-- | in the cache)
analysedUpTo : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> St
             -> String
             -> Doc
             -> Int
             -> Co e Analysed
analysedUpTo st f d cut = do
  l <-
    Load.loadProgramWith
      (\p ->
         if strEq p f then pure (Just (strSlice d.text 0 cut))
         else readOpen st p)
      st.lib
      f
  acc <-
    Session.cachedGo l.paths l.sources { done = Nil, hashes = OrdMap.empty }
  pure (analysisFrom d l acc.done)

-- | where an elaboration stopped: what the declarations before have, and
-- | the declaration, if it is known
type Stopped = { analysis : Analysed, at : Maybe TopDecl }

mkStopped : Analysed -> Maybe TopDecl -> Stopped
mkStopped a t = { analysis = a, at = t }

-- (the first `lo` declarations elaborate, as `a` says; the first `hi`
-- do not)
stoppedGo : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> String
          -> Doc
          -> List TopDecl
          -> Int
          -> Int
          -> Analysed
          -> Co e Stopped
stoppedGo st f d ds lo hi a =
  if hi - lo <= 1 then pure (mkStopped a (List.head (List.drop lo ds)))
  else do
    r <-
      RPC.attempt
        (\u -> analysedUpTo st f d (cutOf d.text ds ((lo + hi) / 2)))
    either
        (\why -> stoppedGo st f d ds lo ((lo + hi) / 2) a)
        (\a2 -> stoppedGo st f d ds ((lo + hi) / 2) hi a2)
        r

-- | the diagnostic of an elaboration that stopped: at the declaration
-- | it stopped at, else at the start
stopDiag : String -> String -> Maybe TopDecl -> Json
stopDiag src why (Just t) =
  diagnostic
    src
    (mkDiag
       SError
       t.name
       ("heff could not finish checking this file: it stopped here ("
        ^ why
        ^ "); what follows is not checked"))
stopDiag src why Nothing =
  diagnostic
    src
    (mkDiag
       SError
       zeroSpan
       ("heff could not finish checking this file (" ^ why ^ ")"))

-- (the declarations before where it stopped, with the stop said)
stoppedAnalysis : String -> String -> Stopped -> Analysed
stoppedAnalysis src why s =
  mkAnalysed
    s.analysis.program
    (List.append s.analysis.diags [stopDiag src why s.at])

-- (an elaboration that stopped, of none of the declarations: in what the
-- document imports, or its text before them)
stoppedFrom : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> String
            -> Doc
            -> String
            -> List TopDecl
            -> Either String Analysed
            -> Co e Analysed
stoppedFrom st f d why ds (Left _) =
  pure (mkAnalysed Nil [stopDiag d.text why Nothing])
stoppedFrom st f d why ds (Right a) = do
  s <- stoppedGo st f d ds 0 (List.length ds) a
  pure (stoppedAnalysis d.text why s)

-- | a document whose elaboration stopped: what can be said of it
stoppedAt : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> String
          -> Doc
          -> String
          -> Co e Analysed
stoppedAt st f d why = do
  r <-
    RPC.attempt (\u -> analysedUpTo st f d (cutOf d.text (topDecls d.text) 0))
  stoppedFrom st f d why (topDecls d.text) r

-- (a document's elaboration, finished or not)
analysisOr : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> String
           -> Doc
           -> Either String Analysed
           -> Co e Analysed
analysisOr st f d (Right a) = pure a
analysisOr st f d (Left why) = stoppedAt st f d why

-- | elaborate a document open, and publish what is wrong with it; an
-- | elaboration that fails is a diagnostic too
check : {e : HFunctor}
      -> {{disk : filesystem <: e}}
      -> {{wire : RPC.rpc <: e}}
      -> St
      -> String
      -> Co e St
check st f = case OrdMap.lookup st.docs f of
  Nothing -> pure st
  Just d -> do
    r <- RPC.attempt (\u -> analysed st f d)
    a <- analysisOr st f d r
    publish d.uri a.diags
    pure
        (withChecked
           (OrdMap.insert st.checked f (mkElaborated d.text a.program))
           st)

checkAll : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> St
         -> List String
         -> Co e St
checkAll st Nil = pure st
checkAll st (Cons f rest) = do
  st2 <- check st f
  checkAll st2 rest

-- (the documents whose last elaboration had `f` in it)
dependentsOf : St -> String -> List String
dependentsOf st f =
  List.map
    (\(p : Pair String Elaborated) -> fst p)
    (List.keepIf
       (\(p : Pair String Elaborated) ->
          not (strEq (fst p) f)
          && List.any (\(c : Driver.Checked) -> strEq c.path f) (snd p).program)
       (OrdMap.toList st.checked))

-- | a document, and those open that import it (as last elaborated)
checkNow : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> St
         -> String
         -> Co e St
checkNow st f = do
  st2 <- check (withDue (OrdMap.delete st.due f) st) f
  checkAll st2 (dependentsOf st f)

-- The project
--------------------------------------------------------------------------------

nubPaths : List String -> List String
nubPaths Nil = Nil
nubPaths (Cons x xs) =
  Cons x (nubPaths (List.keepIf (\y -> not (strEq y x)) xs))

nubSources : List Driver.Source -> List Driver.Source
nubSources Nil = Nil
nubSources (Cons s ss) =
  Cons
    s
    (nubSources
       (List.keepIf (\(t : Driver.Source) -> not (strEq t.path s.path)) ss))

loadAll : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> (String -> Co e (Maybe String))
        -> Load.Host
        -> List String
        -> Co e (List Driver.Source)
loadAll read lib Nil = pure Nil
loadAll read lib (Cons f rest) = do
  l <- Load.loadProgramWith read lib f
  more <- loadAll read lib rest
  pure (List.append l.sources more)

type WithProgram = { st : St, program : List Driver.Checked }

mkWithProgram : St -> List Driver.Checked -> WithProgram
mkWithProgram st program = { st = st, program = program }

-- (a program, or none where its elaboration failed: what is asked of it
-- answered empty)
elaboratedOr : Either String Session.Elaborated -> Session.Elaborated
elaboratedOr (Right e) = e
elaboratedOr (Left why) = { program = Nil, kept = OrdMap.empty }

-- (a project elaborated for the names `had` serves one wanted for
-- `wanted`: every file elaborated serves any)
covers : Maybe (List String) -> Maybe (List String) -> Bool
covers Nothing wanted = True
covers (Just had) (Just wanted) = List.all (\n -> List.elem n had) wanted
covers (Just had) Nothing = False

-- (whether a text has one of the names)
mentions : List String -> String -> Bool
mentions names text = List.any (\n -> contains n text) names

-- (the files whose text has one of the names)
mentionedIn : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> St
            -> List String
            -> List String
            -> Co e (List String)
mentionedIn st names Nil = pure Nil
mentionedIn st names (Cons p rest) = do
  t <- readOpen st p
  more <- mentionedIn st names rest
  pure (if mentions names (fromMaybe "" t) then Cons p more else more)

-- (the files of a project that may have one of the names: every one,
-- for no names)
filesNamed : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> St
           -> Maybe (List String)
           -> List String
           -> Co e (List String)
filesNamed st Nothing files = pure files
filesNamed st (Just names) files = mentionedIn st names files

-- (a module whose names are wanted: one that may have one of them)
wanted : Maybe (List String) -> Driver.Source -> Bool
wanted Nothing s = True
wanted (Just names) s = mentions names s.source

-- (the modules kept from the project elaborated before, at the root)
keptAt : St -> String -> OrdMap.OrdMap String Session.Kept
keptAt st root = case st.project of
  Just pr -> if strEq pr.root root then pr.kept else OrdMap.empty
  Nothing -> OrdMap.empty

-- | the files, with what each imports, elaborated as one program: those
-- | `full` takes elaborated, or kept from before, the others thawed from
-- | the cache where they can be
elabFiles : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> (String -> Co e (Maybe String))
          -> Load.Host
          -> (Driver.Source -> Bool)
          -> OrdMap.OrdMap String Session.Kept
          -> String
          -> List String
          -> Co e Session.Elaborated
elabFiles read lib full kept f files = do
  sources <- loadAll read lib (nubPaths files)
  ps <- Load.pathsFor lib f
  Session.cachedWhere full kept ps (nubSources sources)

-- | the project at `root` elaborated, as far as the names go (all of it,
-- | for none): the files whose text has one of them, and `f`, with what
-- | each imports.  A module whose text has one is elaborated; the others
-- | are thawed from the cache where they can be, since no name of theirs
-- | is one of them.
projectAnew : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> String
            -> String
            -> Maybe (List String)
            -> Co e WithProgram
projectAnew st root f names = do
  r <-
    RPC.attempt (\u -> do
      files <- RPC.projectFiles root
      fs <- filesNamed st names files
      elabFiles
          (\p -> readOpen st p)
          st.lib
          (wanted names)
          (keptAt st root)
          f
          (List.append fs [f]))
  e <- pure (elaboratedOr r)
  pure
      (mkWithProgram
         (withProject
            (Just
               (mkProject
                  root
                  names
                  e.program
                  True
                  (if List.null e.program then keptAt st root else e.kept)))
            st)
         e.program)

-- | the project a document is in, as far as the names go (all of it,
-- | for none), an open file as its text is in the editor
projectFor : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> String
           -> Maybe (List String)
           -> Co e WithProgram
projectFor st f names = do
  ps <- Load.pathsFor st.lib f
  case st.project of
    Just pr ->
      if pr.current && strEq pr.root ps.root && covers pr.names names
      then pure (mkWithProgram st pr.program)
      else projectAnew st ps.root f names
    Nothing -> projectAnew st ps.root f names

-- | the project a document is in, every file of it elaborated
project : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> St
        -> String
        -> Co e WithProgram
project st f = projectFor st f Nothing

-- | ... every file of it whose text has one of the names
mentioning : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> String
           -> List String
           -> Co e WithProgram
mentioning st f names = projectFor st f (Just names)

-- Requests
--------------------------------------------------------------------------------

capabilities : Json
capabilities =
  obj
    [ kv
      "capabilities"
      (obj
         [ kv
           "textDocumentSync"
           (obj
              [ kv "openClose" jtrue
              , kv "change" (num 1)
              , kv "save" (obj [kv "includeText" jfalse])
              ])
         , kv "hoverProvider" jtrue
         , kv "definitionProvider" jtrue
         , kv "documentFormattingProvider" jtrue
         -- (after `M.`, the module's definitions)
         , kv
           "completionProvider"
           (obj [kv "triggerCharacters" (JArray [jstr "."])])
         , kv "referencesProvider" jtrue
         , kv "documentHighlightProvider" jtrue
         , kv "renameProvider" (obj [kv "prepareProvider" jtrue])
         , kv "documentSymbolProvider" jtrue
         , kv "workspaceSymbolProvider" jtrue
         -- (splitting a variable into cases; the module claim's name)
         , kv
           "codeActionProvider"
           (obj
              [ kv
                "codeActionKinds"
                (JArray [jstr "refactor.rewrite", jstr "quickfix"])
              ])
         ])
    , kv "serverInfo" (obj [kv "name" (jstr "heff")])
    ]

docPath : {e : HFunctor}
        -> {{wire : RPC.rpc <: e}}
        -> Json
        -> Co e (Maybe String)
docPath p = case str ["textDocument", "uri"] p of
  Just u -> RPC.uriPath u
  Nothing -> pure Nothing

uriOf : {e : HFunctor} -> {{wire : RPC.rpc <: e}} -> St -> String -> Co e String
uriOf st p = case OrdMap.lookup st.docs p of
  Just d -> pure d.uri
  Nothing -> RPC.pathUri p

-- | the document a request is about, elaborated as its text is now: its
-- | text, and the program (the document last), or nothing
type Asked = { st : St, text : String, program : List Driver.Checked }

mkAsked : St -> String -> List Driver.Checked -> Asked
mkAsked st text program = { st = st, text = text, program = program }

asked : St -> String -> String -> Asked
asked st f text = case OrdMap.lookup st.checked f of
  Just c ->
    if strEq c.text text then mkAsked st text c.program else mkAsked st text Nil
  Nothing -> mkAsked st text Nil

withProgram : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> Json
            -> Co e Asked
withProgram st p = do
  mf <- docPath p
  case mf of
    Nothing -> pure (mkAsked st "" Nil)
    Just f -> case OrdMap.lookup st.docs f of
      Nothing -> pure (mkAsked st "" Nil)
      Just d -> case OrdMap.lookup st.checked f of
        Just c ->
          if strEq c.text d.text then pure (asked st f d.text)
          else do
            st2 <- check st f
            pure (asked st2 f d.text)
        Nothing -> do
          st2 <- check st f
          pure (asked st2 f d.text)

-- (a hover's text: the type, and the documentation, if there is some)
withDoc : String -> String -> String
withDoc t "" = "```heff\n" ^ t ^ "\n```"
withDoc t doc = "```heff\n" ^ t ^ "\n```\n\n---\n\n" ^ doc

hoverOf : Asked -> Json -> Json
hoverOf a p = case List.last a.program of
  Just c -> case Query.typeAt c (offsetIn a.text p) of
    Just t ->
      obj
        [ kv
          "contents"
          (obj
             [ kv "kind" (jstr "markdown")
             , kv
               "value"
               (jstr (withDoc t (Query.docAt a.program (offsetIn a.text p))))
             ])
        ]
    Nothing -> JNull
  Nothing -> JNull

-- (where what the name at the position refers to is in the document)
highlightsOf : Asked -> Json -> Json
highlightsOf a p =
  JArray
    (List.map
       (\(o : Query.Occurrence) ->
          obj [kv "range" (range o.source o.span), kv "kind" (num 1)])
       (Query.highlightsAt a.program (offsetIn a.text p)))

completionItem : Query.Completion -> Json
completionItem i =
  obj
    [kv "label" (jstr i.label), kv "kind" (num 3), kv "detail" (jstr i.detail)]

childJson : String -> Query.Child -> Json
childJson src m =
  obj
    [ kv "name" (jstr m.name)
    , kv "kind" (num m.kind)
    , kv "range" (range src m.span)
    , kv "selectionRange" (range src m.span)
    ]

docSymbol : String -> Query.DocSymbol -> Json
docSymbol src y =
  obj
    [ kv "name" (jstr y.name)
    , kv "kind" (num y.kind)
    , kv
      "range"
      (range src (Query.mkSpan y.span.start (max y.span.end y.selection.end)))
    , kv "selectionRange" (range src y.selection)
    , kv "children" (JArray (List.map (\m -> childJson src m) y.children))
    ]

-- (ASCII letters to lower case: what a symbol query is matched by)
lowerGo : String -> Int -> String -> String
lowerGo s i acc =
  if i >= strLength s then acc
  else lowerGo
      s
      (i + 1)
      (acc
       ^ (if 65 <= byteAt s i && byteAt s i <= 90
          then fromByte (UInt8.fromInt (byteAt s i + 32))
          else strSlice s i (i + 1)))

lower : String -> String
lower s = lowerGo s 0 ""

-- | what the name at a request's position refers to, in the project of
-- | its document: the name, and every occurrence of it
type Pointed =
  { path : String
  , target : Query.Target
  , name : String
  , occurrences : List Query.Occurrence
  }

type Targeted = { st : St, off : Int, target : Maybe Pointed }

mkPointed : String -> Query.Target -> String -> List Query.Occurrence -> Pointed
mkPointed path target name occurrences =
  { path = path, target = target, name = name, occurrences = occurrences }

mkTargeted : St -> Int -> Maybe Pointed -> Targeted
mkTargeted st off target = { st = st, off = off, target = target }

pointedAt : List Driver.Checked -> String -> Query.Found -> Pointed
pointedAt program f t =
  mkPointed f t.target t.name (Query.occurrences program t.target t.name)

-- (a local: in its document alone; a global or a member: in the files
-- of the project that may refer to it -- else, where they could not be
-- elaborated, in the document's program)
pointedIn : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> Asked
          -> String
          -> Int
          -> Query.Found
          -> Co e Targeted
pointedIn a f off t@{ target = { local = Just _ } } =
  pure (mkTargeted a.st off (Just (pointedAt a.program f t)))
pointedIn a f off t@{ target = { local = Nothing } } = do
  wp <- mentioning a.st f [t.name]
  pure
      (mkTargeted
         wp.st
         off
         (Just
            (pointedAt
               (if List.null wp.program then a.program else wp.program)
               f
               t)))

-- | what the name at a request's position refers to, as the document's
-- | elaboration says, and every occurrence of it
withTarget : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Json
           -> Co e Targeted
withTarget st p = do
  a <- withProgram st p
  mf <- docPath p
  case mf of
    Nothing -> pure (mkTargeted a.st 0 Nothing)
    Just f -> case Query.targetAt a.program (offsetIn a.text p) of
      Just t -> pointedIn a f (offsetIn a.text p) t
      Nothing -> pure (mkTargeted a.st 0 Nothing)

locationOf : {e : HFunctor}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Query.Occurrence
           -> Co e Json
locationOf st o = do
  u <- uriOf st o.path
  pure (obj [kv "uri" (jstr u), kv "range" (range o.source o.span)])

locations : {e : HFunctor}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> List Query.Occurrence
          -> Co e (List Json)
locations st Nil = pure Nil
locations st (Cons o rest) = do
  j <- locationOf st o
  js <- locations st rest
  pure (Cons j js)

-- | occurrences, by file
type ByFile = { path : String, occurrences : List Query.Occurrence }

mkByFile : String -> List Query.Occurrence -> ByFile
mkByFile path os = { path = path, occurrences = os }

inFile : String -> List Query.Occurrence -> List Query.Occurrence
inFile p os = List.keepIf (\(o : Query.Occurrence) -> strEq o.path p) os

byFile : List Query.Occurrence -> List ByFile
byFile os =
  List.map
    (\p -> mkByFile p (inFile p os))
    (nubPaths (List.map (\(o : Query.Occurrence) -> o.path) os))

-- (each file's text with every occurrence in it renamed)
renamedText : String -> List Query.Occurrence -> String
renamedText new os =
  List.foldr
    (\(o : Query.Occurrence) src ->
       strSlice src 0 o.span.start
       ^ new
       ^ strSlice src o.span.end (strLength src))
    (case List.head os of
     Just o -> o.source
     Nothing -> "")
    os

nubCheckedPaths : List Driver.Checked -> List Driver.Checked
nubCheckedPaths Nil = Nil
nubCheckedPaths (Cons c cs) =
  Cons
    c
    (nubCheckedPaths
       (List.keepIf (\(d : Driver.Checked) -> not (strEq d.path c.path)) cs))

errorCount : List Driver.Checked -> Int
errorCount program =
  List.foldl
    (\n (c : Driver.Checked) -> n + List.length (Driver.errorsIn c))
    0
    (nubCheckedPaths program)

textOf : List (Pair String String) -> String -> Maybe String
textOf texts p = case List.find
    (\(q : Pair String String) -> strEq (fst q) p)
    texts of
  Just q -> Just (snd q)
  Nothing -> Nothing

-- (where the target is after the renaming: a local's binder moved by
-- the occurrences renamed before it)
-- (how far a local's binder moves: the occurrences renamed before it,
-- each longer or shorter by the difference)
shiftOf : Pointed -> String -> Params.Span -> Int
shiftOf t new b =
  (strLength new - strLength t.name)
  * List.length
    (List.keepIf
       (\(o : Query.Occurrence) ->
          strEq o.path t.path && o.span.start < b.start)
       t.occurrences)

renamedTarget : Pointed -> String -> Query.Target
renamedTarget t@{ target = { local = Just b } } new =
  Query.localT
    t.target.key
    (Query.mkSpan
       (b.start + shiftOf t new b)
       (b.start + shiftOf t new b + strLength new))
renamedTarget t@{ target = { local = Nothing, member = Just _ } } new =
  Query.memberT t.target.key new
renamedTarget t@{ target = { local = Nothing, member = Nothing } } new =
  Query.globalT
    (strSlice t.target.key 0 (strLength t.target.key - strLength t.name) ^ new)

-- (a renaming whose program, elaborated again, failed: refused)
renameFailed : Pointed -> String -> String -> Maybe String
renameFailed t new why =
  Just
    ("renaming `"
     ^ t.name
     ^ "` to `"
     ^ new
     ^ "` would make heff fail elaborating ("
     ^ why
     ^ ")")

renameVerdict : WithProgram
              -> Pointed
              -> String
              -> Int
              -> Int
              -> List Driver.Checked
              -> Pair St (Maybe String)
renameVerdict before t new errorsBefore errorsAfter after =
  (MkPair
     before.st
     (if errorsAfter > errorsBefore
      then Just
          ("renaming `"
           ^ t.name
           ^ "` to `"
           ^ new
           ^ "` would make "
           ^ debug (errorsAfter - errorsBefore)
           ^ " more error(s)")
      else if List.length (Query.occurrences after (renamedTarget t new) new)
              /= List.length t.occurrences
      then Just
          ("`"
           ^ new
           ^ "` is already a name some of these occurrences would refer to")
      else Nothing))

-- | Why renaming would change what the program means, if it would: with
-- | every occurrence renamed, the project is elaborated again, and the
-- | new name must be written as often as the old one was, each time
-- | referring to what was renamed -- not captured by a name already
-- | there -- and no file may have more errors than it had.
-- (the files of a program a renaming changes, and every file that
-- imports one of them, directly or not: nothing else can have more
-- errors, or another occurrence.  The program is in the order of its
-- imports, so one pass finds them)
affectedGo : List String -> List String -> List Driver.Checked -> List String
affectedGo changed mods Nil = Nil
affectedGo changed mods (Cons c rest) =
  if List.elem c.path changed
     || List.any (\d -> List.elem d mods) c.deps
  then Cons c.path (affectedGo changed (Cons c.module mods) rest)
  else affectedGo changed mods rest

inPaths : List String -> List Driver.Checked -> List Driver.Checked
inPaths paths program =
  List.keepIf (\(c : Driver.Checked) -> List.elem c.path paths) program

-- (what a renaming is held to: a local's document, as elaborated; else
-- the files of the project that have the old name or the new -- no other
-- file can come to mean something else)
renameBase : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Pointed
           -> String
           -> Co e WithProgram
renameBase st t@{ target = { local = Just _ } } new = case OrdMap.lookup
    st.checked
    t.path of
  Just e -> pure (mkWithProgram st e.program)
  Nothing -> mentioning st t.path [t.name, new]
renameBase st t@{ target = { local = Nothing } } new =
  mentioning st t.path [t.name, new]

renameChecked : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> {{wire : RPC.rpc <: e}}
              -> St
              -> Pointed
              -> String
              -> Co e (Pair St (Maybe String))
renameChecked st t new = do
  before <- renameBase st t new
  affected <-
    pure
      (affectedGo
         (List.map (\(b : ByFile) -> b.path) (byFile t.occurrences))
         Nil
         before.program)
  tried <-
    RPC.attempt
      (\u ->
         elabFiles
           (\p -> case textOf
              (List.map
                 (\(b : ByFile) ->
                    MkPair b.path (renamedText new b.occurrences))
                 (byFile t.occurrences))
              p of
            Just txt -> pure (Just txt)
            Nothing -> readOpen st p)
           st.lib
           (\(s : Driver.Source) -> List.elem s.path affected)
           OrdMap.empty
           t.path
           affected)
  pure
      (either
         (\why -> MkPair before.st (renameFailed t new why))
         (\(after : Session.Elaborated) ->
            renameVerdict
              before
              t
              new
              (errorCount (inPaths affected before.program))
              (errorCount (inPaths affected after.program))
              after.program)
         tried)

editOf : String -> Query.Occurrence -> Json
editOf new o = obj [kv "range" (range o.source o.span), kv "newText" (jstr new)]

changesOf : {e : HFunctor}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> String
          -> List ByFile
          -> Co e (List (Pair String Json))
changesOf st new Nil = pure Nil
changesOf st new (Cons b rest) = do
  u <- uriOf st b.path
  more <- changesOf st new rest
  pure
      (Cons
         (MkPair u (JArray (List.map (\o -> editOf new o) b.occurrences)))
         more)

-- (the documents' roots, each once)
rootsOf : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> St
        -> List String
        -> Co e (List (Pair String String))
rootsOf st Nil = pure Nil
rootsOf st (Cons f rest) = do
  ps <- Load.pathsFor st.lib f
  more <- rootsOf st rest
  pure (Cons (MkPair ps.root f) more)

nubRoots : List (Pair String String) -> List (Pair String String)
nubRoots Nil = Nil
nubRoots (Cons r rs) =
  Cons
    r
    (nubRoots
       (List.keepIf
          (\(q : Pair String String) -> not (strEq (fst q) (fst r)))
          rs))

projects : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> St
         -> List (Pair String String)
         -> Co e WithProgram
projects st Nil = pure (mkWithProgram st Nil)
projects st (Cons (MkPair _ f) rest) = do
  wp <- project st f
  more <- projects wp.st rest
  pure (mkWithProgram more.st (List.append wp.program more.program))

symbolJson : {e : HFunctor}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Driver.Checked
           -> Query.DocSymbol
           -> Co e Json
symbolJson st c y = do
  u <- uriOf st c.path
  pure
      (obj
         [ kv "name" (jstr y.name)
         , kv "kind" (num y.kind)
         , kv "containerName" (jstr c.module)
         , kv
           "location"
           (obj [kv "uri" (jstr u), kv "range" (range c.source y.selection)])
         ])

eachSymbol : {e : HFunctor}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Driver.Checked
           -> List Query.DocSymbol
           -> Co e (List Json)
eachSymbol st c Nil = pure Nil
eachSymbol st c (Cons y rest) = do
  j <- symbolJson st c y
  js <- eachSymbol st c rest
  pure (Cons j js)

symbolsJson : {e : HFunctor}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> String
            -> List Driver.Checked
            -> Co e (List Json)
symbolsJson st query Nil = pure Nil
symbolsJson st query (Cons c rest) = do
  here <-
    eachSymbol
      st
      c
      (List.keepIf
         (\(y : Query.DocSymbol) -> contains query (lower y.name))
         (Query.symbols c))
  more <- symbolsJson st query rest
  pure (List.append here more)

occurrenceAt : Pointed -> Int -> Maybe Query.Occurrence
occurrenceAt t off =
  List.find
    (\(o : Query.Occurrence) ->
       strEq o.path t.path && o.span.start <= off && off <= o.span.end)
    t.occurrences

prepared : {e : HFunctor}
         -> {{wire : RPC.rpc <: e}}
         -> Json
         -> Targeted
         -> Co e St
prepared id tg@{ target = Nothing } = do
  reply id JNull
  pure tg.st
prepared id tg@{ target = Just t } = case Query.renameRefused
    t.target
    t.name
    t.name of
  Just why -> do
    replyError id (0 - 32803) why
    pure tg.st
  Nothing -> case occurrenceAt t tg.off of
    Just o -> do
      reply
          id
          (obj
             [ kv "range" (range o.source o.span)
             , kv "placeholder" (jstr t.name)
             ])
      pure tg.st
    Nothing -> do
      replyError id (0 - 32803) ("`" ^ t.name ^ "` is not written here")
      pure tg.st

renamed : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> Json
        -> String
        -> Targeted
        -> Co e St
renamed id new tg@{ target = Nothing } = do
  reply id JNull
  pure tg.st
renamed id new tg@{ target = Just t } = case Query.renameRefused
    t.target
    t.name
    new of
  Just why -> do
    replyError id (0 - 32803) why
    pure tg.st
  Nothing -> do
    r <- renameChecked tg.st t new
    case snd r of
      Just why -> do
        replyError id (0 - 32803) why
        pure (fst r)
      Nothing -> do
        cs <- changesOf (fst r) new (byFile t.occurrences)
        reply id (obj [kv "changes" (JObject cs)])
        pure (fst r)

docAt : St -> Maybe String -> Maybe Doc
docAt st (Just f) = OrdMap.lookup st.docs f
docAt st Nothing = Nothing

formattedIn : {e : HFunctor}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> Json
            -> Doc
            -> Fixity.Fixities
            -> Co e St
formattedIn st id d fix = case Format.formatIn fix d.text of
  Left _ -> do
    reply id (JArray Nil)
    pure st
  Right t ->
    if strEq t d.text
    then do
      reply id (JArray Nil)
      pure st
    else do
      reply
          id
          (JArray
             [ obj
               [ kv "range" (range d.text (wholeSpan d.text))
               , kv "newText" (jstr t)
               ]
             ])
      pure st

-- | a document laid out anew, its operators cut as the fixities of what
-- | it imports say; one that cannot be is left as it is, and nothing is
-- | said of it (its diagnostics say what is wrong)
formatted : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> Json
          -> Json
          -> Co e St
formatted st id p = do
  mf <- docPath p
  case mf of
    Nothing -> do
      reply id (JArray Nil)
      pure st
    Just f -> case docAt st (Just f) of
      Nothing -> do
        reply id (JArray Nil)
        pure st
      Just d -> do
        l <- Load.loadProgramWith (\q -> readOpen st q) st.lib f
        formattedIn st id d (Driver.fixitiesIn l.sources)

-- Splitting a variable into cases
--------------------------------------------------------------------------------

-- | the type of a variable of an equation that does not use it: the
-- | document elaborated again, after what it imports as elaborated
-- | already, with the equation's body the variable alone
-- (the type of the variable, from the document probed)
probedIn : List Driver.Checked
         -> Split.Spot
         -> Maybe Driver.Source
         -> Maybe String
probedIn program s (Just source) =
  Split.typeUsedAt
    (Driver.elabNext (dropLast program) source Nothing)
    s.name
    (Split.probeAt s)
probedIn program s Nothing = Nothing

-- (a type, or none where finding it failed)
typeOr : Either String (Maybe String) -> Maybe String
typeOr (Right t) = t
typeOr (Left why) = Nothing

probedType : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> String
           -> List Driver.Checked
           -> Driver.Checked
           -> Split.Spot
           -> Co e (Maybe String)
probedType st f program c s = do
  l <-
    Load.loadProgramWith
      (\q ->
         if strEq q f then pure (Just (Split.probeText c.source s))
         else readOpen st q)
      st.lib
      f
  r <- RPC.attempt (\u -> pure (probedIn program s (List.last l.sources)))
  pure (typeOr r)

splitType : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> String
          -> List Driver.Checked
          -> Driver.Checked
          -> Split.Spot
          -> Co e (Maybe String)
splitType st f program c s = case Split.usedType c s of
  Just t -> pure (Just t)
  Nothing -> probedType st f program c s

splitAction : String -> String -> Split.Split -> Json
splitAction uri src x =
  obj
    [ kv "title" (jstr x.title)
    , kv "kind" (jstr "refactor.rewrite")
    , kv
      "edit"
      (obj
         [ kv
           "changes"
           (JObject
              [ MkPair
                uri
                (JArray
                   [ obj
                     [ kv "range" (range src (Query.mkSpan x.start x.end))
                     , kv "newText" (jstr x.text)
                     ]
                   ])
              ])
         ])
    ]

splitIn : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> St
        -> String
        -> String
        -> List Driver.Checked
        -> Driver.Checked
        -> Int
        -> Co e (List Json)
splitIn st f uri program c off = case Split.spotAt c off of
  Nothing -> pure Nil
  Just s -> do
    ty <- splitType st f program c s
    pure (case ty of
      Just t -> case Split.split program c s t of
        Just x -> [splitAction uri c.source x]
        Nothing -> Nil
      Nothing -> Nil)

-- (a kind of code action asked for that a rewrite is of)
rewriteKind : Json -> Bool
rewriteKind (JString k) = startsWith k "refactor.rewrite"
rewriteKind _ = False

-- | whether a request for code actions takes a rewrite: it names no
-- | kinds, or one a rewrite is of
wantsRewrite : Json -> Bool
wantsRewrite p = case arr ["context", "only"] p of
  Just ks -> List.any rewriteKind ks
  Nothing -> True

-- | the code actions at the start of a request's range: splitting the
-- | pattern variable there into cases
codeActions : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{wire : RPC.rpc <: e}}
            -> Asked
            -> Json
            -> Co e (List Json)
codeActions a p = do
  mf <- docPath p
  case mf of
    Just f -> case List.last a.program of
      Just c ->
        if wantsRewrite p && strEq c.source a.text
        then splitIn
            a.st
            f
            (fromMaybe "" (str ["textDocument", "uri"] p))
            a.program
            c
            (offsetOf
               a.text
               (fromMaybe 0 (int ["range", "start", "line"] p))
               (fromMaybe 0 (int ["range", "start", "character"] p)))
        else pure Nil
      Nothing -> pure Nil
    Nothing -> pure Nil

-- The module claim
--------------------------------------------------------------------------------

-- (the claim `module n` reads back as naming `n`, nothing wrong with it)
claimReads : String -> Maybe Import.Claim -> Bool
claimReads n (Just h@{ name = Just m, error = Nothing }) = strEq m n
claimReads n _ = False

-- (a name a claim can say, else none)
claimable : String -> Maybe String
claimable n =
  if claimReads n (Import.readImports ("module " ^ n ^ "\n")).claim then Just n
  else Nothing

-- | the name a file's module claim is to say: the one the loader gives the
-- | file (the one E0156 asks for), if a claim can say it; none for a
-- | manifest, which has no claim
claimOf : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> St
        -> String
        -> Co e (Maybe String)
claimOf st f =
  if Driver.isManifest f then pure Nothing
  else do
    ps <- Load.pathsFor st.lib f
    pure (claimable (Load.moduleOf ps f))

-- (where a claim's name `m` is: the first thing after `module`)
nameSpanIn : String -> Import.Claim -> String -> Params.Span
nameSpanIn src h m =
  let from = h.span.start + 6
  in let at = from + fromMaybe 1 (indexOf m (strSlice src from h.span.end) 0)
  in Query.mkSpan at (at + strLength m)

-- (the claim written anew: a whole one where there is none, the name
-- after a `module (x)` that has none, the name for a wrong one)
claimEdit : String
          -> String
          -> Maybe Import.Claim
          -> Maybe (Pair Params.Span String)
claimEdit src n Nothing =
  Just
    (MkPair zeroSpan ("module " ^ n ^ (if strEq src "" then "\n" else "\n\n")))
claimEdit src n (Just h@{ name = Nothing }) =
  Just (MkPair (Query.mkSpan (h.span.start + 6) (h.span.start + 6)) (" " ^ n))
claimEdit src n (Just h@{ name = Just m }) =
  if strEq m n then Nothing else Just (MkPair (nameSpanIn src h m) n)

-- (a diagnostic of the claim's name: missing, E0156, or wrong, E0157)
claimCode : Maybe String -> Bool
claimCode (Just c) = strEq c "E0156" || strEq c "E0157"
claimCode Nothing = False

-- (the diagnostics a request for code actions is for, of the claim's name)
claimDiags : Json -> List Json
claimDiags p =
  List.keepIf
    (\d -> claimCode (str ["code"] d))
    (fromMaybe Nil (arr ["context", "diagnostics"] p))

-- (a kind of code action asked for that a quick fix is of)
quickfixKind : Json -> Bool
quickfixKind (JString k) = startsWith k "quickfix"
quickfixKind _ = False

-- | whether a request for code actions takes a quick fix: it names no
-- | kinds, or one a quick fix is of
wantsQuickfix : Json -> Bool
wantsQuickfix p = case arr ["context", "only"] p of
  Just ks -> List.any quickfixKind ks
  Nothing -> True

claimAction : String
            -> String
            -> String
            -> List Json
            -> Pair Params.Span String
            -> Json
claimAction uri src n ds (MkPair sp text) =
  obj
    [ kv "title" (jstr ("Write the module claim `module " ^ n ^ "`"))
    , kv "kind" (jstr "quickfix")
    , kv "diagnostics" (JArray ds)
    , kv "isPreferred" jtrue
    , kv
      "edit"
      (obj
         [ kv
           "changes"
           (JObject
              [ MkPair
                uri
                (JArray
                   [obj [kv "range" (range src sp), kv "newText" (jstr text)]])
              ])
         ])
    ]

-- (the quick fix for the document `d`, its claim to say `n`)
claimFix : Doc -> List Json -> Maybe String -> List Json
claimFix d ds (Just n) = case claimEdit
    d.text
    n
    (Import.readImports d.text).claim of
  Just x -> [claimAction d.uri d.text n ds x]
  Nothing -> Nil
claimFix d ds Nothing = Nil

-- | the quick fix for a claim that names the module otherwise, or not
-- | at all, where the request is for that diagnostic: the claim the
-- | file is to have
claimFixes : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> {{wire : RPC.rpc <: e}}
           -> St
           -> Json
           -> Co e (List Json)
claimFixes st p = do
  mf <- docPath p
  case mf of
    Just f -> case OrdMap.lookup st.docs f of
      Just d ->
        if wantsQuickfix p && not (List.null (claimDiags p))
        then do
          mn <- claimOf st f
          pure (claimFix d (claimDiags p) mn)
        else pure Nil
      Nothing -> pure Nil
    Nothing -> pure Nil

-- | `heff/moduleName`: the name a file's module claim is to say, else `null`
-- | (for an editor to write the claim of a file just made)
moduleNamed : {e : HFunctor}
            -> {{disk : filesystem <: e}}
            -> {{wire : RPC.rpc <: e}}
            -> St
            -> Json
            -> Co e Json
moduleNamed st p = do
  mf <- docPath p
  case mf of
    Just f -> do
      mn <- claimOf st f
      pure (case mn of
        Just n -> jstr n
        Nothing -> JNull)
    Nothing -> pure JNull

request : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> {{wire : RPC.rpc <: e}}
        -> St
        -> String
        -> Json
        -> Json
        -> Co e St
request st m id p =
  if strEq m "initialize"
  then do
    reply id capabilities
    pure
        (withWatch
           (fromMaybe
              False
              (bool
                 [ "capabilities"
                 , "workspace"
                 , "didChangeWatchedFiles"
                 , "dynamicRegistration"
                 ]
                 p))
           st)
  else if strEq m "shutdown"
  then do
    reply id JNull
    pure (shutDown st)
  else if strEq m "textDocument/hover"
  then do
    a <- withProgram st p
    reply id (hoverOf a p)
    pure a.st
  else if strEq m "textDocument/definition"
  then do
    a <- withProgram st p
    case Query.definitionAt a.program (offsetIn a.text p) of
      Just d -> do
        u <- uriOf a.st d.path
        reply id (obj [kv "uri" (jstr u), kv "range" (range d.source d.span)])
      Nothing -> reply id JNull
    pure a.st
  else if strEq m "textDocument/documentHighlight"
  then do
    a <- withProgram st p
    reply id (highlightsOf a p)
    pure a.st
  else if strEq m "textDocument/completion"
  then do
    a <- withProgram st p
    reply
        id
        (JArray (case List.last a.program of
         Just c ->
           List.map completionItem (Query.completionsAt c (offsetIn a.text p))
         Nothing -> Nil))
    pure a.st
  else if strEq m "textDocument/documentSymbol"
  then do
    a <- withProgram st p
    reply
        id
        (JArray (case List.last a.program of
         Just c -> List.map (\y -> docSymbol a.text y) (Query.symbols c)
         Nothing -> Nil))
    pure a.st
  -- (in the projects of the documents open)
  else if strEq m "workspace/symbol"
  then do
    roots <- rootsOf st (OrdMap.keys st.docs)
    wp <- projects st (nubRoots roots)
    js <-
      symbolsJson
        wp.st
        (lower (fromMaybe "" (str ["query"] p)))
        (nubCheckedPaths wp.program)
    reply id (JArray js)
    pure wp.st
  else if strEq m "textDocument/references"
  then do
    tg <- withTarget st p
    case tg.target of
      Just t -> do
        js <-
          locations
            tg.st
            (List.keepIf
               (\(o : Query.Occurrence) ->
                  fromMaybe True (bool ["context", "includeDeclaration"] p)
                  || not o.defines)
               t.occurrences)
        reply id (JArray js)
      Nothing -> reply id JNull
    pure tg.st
  else if strEq m "textDocument/prepareRename"
  then do
    tg <- withTarget st p
    prepared id tg
  else if strEq m "textDocument/rename"
  then do
    tg <- withTarget st p
    renamed id (fromMaybe "" (str ["newName"] p)) tg
  else if strEq m "textDocument/formatting" then formatted st id p
  else if strEq m "textDocument/codeAction"
  then do
    a <- withProgram st p
    js <- codeActions a p
    fixes <- claimFixes a.st p
    reply id (JArray (List.append fixes js))
    pure a.st
  else if strEq m "heff/moduleName"
  then do
    n <- moduleNamed st p
    reply id n
    pure st
  else do
    replyError id (0 - 32601) ("no method " ^ m)
    pure st

-- Notifications
--------------------------------------------------------------------------------

registration : Json
registration =
  message
    [ kv "id" (jstr "heff-watch")
    , kv "method" (jstr "client/registerCapability")
    , kv
      "params"
      (obj
         [ kv
           "registrations"
           (JArray
              [ obj
                [ kv "id" (jstr "heff-watch")
                , kv "method" (jstr "workspace/didChangeWatchedFiles")
                , kv
                  "registerOptions"
                  (obj
                     [ kv
                       "watchers"
                       (JArray [obj [kv "globPattern" (jstr "**/*.hf")]])
                     ])
                ]
              ])
         ])
    ]

-- (full sync: the last change is the whole text)
lastChange : Json -> Maybe String
lastChange p = case arr ["contentChanges"] p of
  Just cs -> case List.last cs of
    Just c -> str ["text"] c
    Nothing -> Nothing
  Nothing -> Nothing

changed : St -> String -> String -> St
changed st f text = case OrdMap.lookup st.docs f of
  Just d -> withDocs (OrdMap.insert st.docs f (mkDoc d.uri text)) st
  Nothing -> st

closed : St -> String -> St
closed st f =
  withDue
    (OrdMap.delete st.due f)
    (withChecked
       (OrdMap.delete st.checked f)
       (withDocs (OrdMap.delete st.docs f) st))

notified : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> St
         -> String
         -> Json
         -> Co e St
notified st m p = do
  mf <- docPath p
  if strEq m "exit"
  then do
    RPC.quit (if st.shutdown then 0 else 1)
  -- (the files of a project, changed on disk -- by `jj`, `git`,
  -- another editor -- are told of: the client is asked to)
  else if strEq m "initialized"
  then if st.watch
    then do
      RPC.send registration
      pure st
    else pure st
  -- (what the documents open import may be what changed)
  else if strEq m "workspace/didChangeWatchedFiles"
  then checkAll st (OrdMap.keys st.docs)
  else case mf of
    Nothing -> pure st
    Just f ->
      if strEq m "textDocument/didOpen"
      then checkNow
          (withDocs
             (OrdMap.insert
                st.docs
                f
                (mkDoc
                   (fromMaybe "" (str ["textDocument", "uri"] p))
                   (fromMaybe "" (str ["textDocument", "text"] p))))
             st)
          f
      else if strEq m "textDocument/didChange"
      then case lastChange p of
        Just text -> do
          t <- RPC.now
          -- (checked once the typing pauses)
          pure
              (withDue
                 (OrdMap.insert st.due f (t + 200))
                 (changed st f text))
        Nothing -> pure st
      else if strEq m "textDocument/didSave" then checkNow st f
      else if strEq m "textDocument/didClose"
      then do
        case OrdMap.lookup st.docs f of
          Just d -> publish d.uri Nil
          Nothing -> pure MkUnit
        pure (closed st f)
      -- (`$/...`, and what we do not know)
      else pure st

-- (a text, as the file is on disk)
asOnDisk : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> Maybe String
         -> Maybe String
         -> Co e Bool
asOnDisk (Just f) (Just text) = do
  t <- Files.readFile f
  pure (case t of
    Just d -> strEq d text
    Nothing -> False)
asOnDisk _ _ = pure False

-- | whether what the project was elaborated from stays as it was: a
-- | document saved, or opened or closed as it is on disk, changes
-- | nothing; a document changed in the editor, or files on disk, do
keepsProject : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> {{wire : RPC.rpc <: e}}
             -> St
             -> String
             -> Json
             -> Co e Bool
keepsProject st m p =
  if strEq m "textDocument/didSave" then pure True
  else if strEq m "textDocument/didOpen"
  then do
    mf <- docPath p
    asOnDisk mf (str ["textDocument", "text"] p)
  else if strEq m "textDocument/didClose"
  then do
    mf <- docPath p
    asOnDisk
        mf (case mf of
      Just f -> case OrdMap.lookup st.docs f of
        Just d -> Just d.text
        Nothing -> Nothing
      Nothing -> Nothing)
  else pure
      (not
         (startsWith "textDocument/" m
          || strEq m "workspace/didChangeWatchedFiles"))

notification : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> {{wire : RPC.rpc <: e}}
             -> St
             -> String
             -> Json
             -> Co e St
notification st m p = do
  -- (a document changed: the project is elaborated again when asked
  -- about)
  keep <- keepsProject st m p
  notified (if keep then st else staled st) m p

-- The loop
--------------------------------------------------------------------------------

handle : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{wire : RPC.rpc <: e}}
       -> St
       -> Json
       -> Co e St
handle st msg = case str ["method"] msg of
  Just m -> case field "id" msg of
    Just id ->
      if st.shutdown && not (strEq m "shutdown")
      then do
        replyError id (0 - 32600) "shut down"
        pure st
      else request st m id (fromMaybe JNull (field "params" msg))
    Nothing -> notification st m (fromMaybe JNull (field "params" msg))
  -- (a response: we ask nothing)
  Nothing -> pure st

-- (the documents whose typing has paused by `t`)
dueBy : St -> Int -> List String
dueBy st t =
  List.map
    (\(q : Pair String Int) -> fst q)
    (List.keepIf (\(q : Pair String Int) -> snd q <= t) (OrdMap.toList st.due))

-- (how long until the next document is due, if one is)
nextDue : St -> Int -> Maybe Int
nextDue st t = case OrdMap.values st.due of
  Nil -> Nothing
  Cons d ds -> Just (max 0 (List.foldl (\a b -> min a b) d ds - t))

checkDue : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> {{wire : RPC.rpc <: e}}
         -> St
         -> List String
         -> Co e St
checkDue st Nil = pure st
checkDue st (Cons f rest) = do
  st2 <- checkNow st f
  checkDue st2 rest

-- (a request whose handling failed, answered with an error that says
-- so; a notification, a response, nothing)
failedReply : {e : HFunctor}
            -> {{wire : RPC.rpc <: e}}
            -> Maybe Json
            -> Maybe String
            -> String
            -> Co e Unit
failedReply (Just id) (Just m) why =
  replyError id (0 - 32603) ("heff failed answering " ^ m ^ " (" ^ why ^ ")")
failedReply _ _ why = pure MkUnit

-- | the state after a message: a handling that failed -- a bug of
-- | heff's -- is answered, if it was a request, and what it did undone
handled : {e : HFunctor}
        -> {{wire : RPC.rpc <: e}}
        -> St
        -> Json
        -> Either String St
        -> Co e St
handled st msg (Right st2) = pure st2
handled st msg (Left why) = do
  failedReply (field "id" msg) (str ["method"] msg) why
  pure st

-- (the documents not due any more)
undue : OrdMap.OrdMap String Int -> List String -> OrdMap.OrdMap String Int
undue due Nil = due
undue due (Cons f rest) = undue (OrdMap.delete due f) rest

-- | the state after the documents due are checked; where that failed,
-- | they are not due any more, not checked again and again
dueChecked : St -> List String -> Either String St -> St
dueChecked st fs (Right st2) = st2
dueChecked st fs (Left why) = withDue (undue st.due fs) st

-- | serve, from a state: a message answered, or the documents due checked,
-- | until the client says `exit` or goes away
serveFrom : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> {{wire : RPC.rpc <: e}}
          -> St
          -> Co e Unit
serveFrom st = do
  t <- RPC.now
  ev <- RPC.await (nextDue st t)
  case ev of
    Message msg -> do
      r <- RPC.attempt (\u -> handle st msg)
      st2 <- handled st msg r
      serveFrom st2
    Timeout -> do
      t2 <- RPC.now
      r <- RPC.attempt (\u -> checkDue st (dueBy st t2))
      serveFrom (dueChecked st (dueBy st t2) r)
    -- (the client went away without `exit`)
    Closed -> RPC.quit 1

-- | serve on stdin/stdout, on the host `h0` (the standard library, the
-- | style of paths)
serve : {e : HFunctor}
      -> {{disk : filesystem <: e}}
      -> {{wire : RPC.rpc <: e}}
      -> Load.Host
      -> Co e Unit
serve h0 = do
  lib <- RPC.absPath h0.lib
  serveFrom
      (mkSt
         OrdMap.empty
         OrdMap.empty
         OrdMap.empty
         Nothing
         False
         False
         { lib = lib
         , mod = h0.mod
         , cwd = h0.cwd
         , style = h0.style
         , heff = h0.heff
         })
