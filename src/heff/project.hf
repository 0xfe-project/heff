-- A project's package.hf: a heff file, read without elaborating it.  It
-- holds one definition, `package`, a record of strings and lists of
-- records (lib/manifest.hf is its type, for the editor and for `heff
-- publish`); its imports and the signature are passed over:
--
--   import manifest
--
--   package : Package
--   package =
--     { module = "github.com/someone/hello"
--     , heff = "0.1.0"
--     , require = [{ name = "json", path = "github.com/x/json", version = "1.2.0" }]
--     , replace = [{ name = "json", dir = "../json" }]
--     }
--
-- Nothing else is read: no definition but `package`, no expression but
-- a literal.  What is read is checked: a version is `a.b.c`, a required
-- package's path ends in `/vN` when its version's major N is 2 or more
-- (and only then), names are not required twice, a replaced name is
-- required.

import array as A
import heff.fmt.lex as L
import prelude

-- | a literal of package.hf, and the token it starts at
data Lit
  = LStr String L.Tok
  | LList (List Lit) L.Tok
  | LRec (List (Pair String Lit)) L.Tok

litTok : Lit -> L.Tok
litTok (LStr _ t) = t
litTok (LList _ t) = t
litTok (LRec _ t) = t

-- | what is wrong, and where (an offset into the text)
type Problem = { at : Int, msg : String }

problemAt : L.Tok -> String -> Problem
problemAt t msg = { at = t.start, msg = msg }

-- (a literal read, and the token after it; or what is wrong)
type Got a = Either Problem (Pair a Int)

-- | what reads a literal, and the lists and records that hold literals,
-- | call one another through this record
type LitReader = { lit : Array L.Tok -> Int -> Got Lit }

isPunct : String -> L.Tok -> Bool
isPunct x t = strEq t.kind "punct" && strEq t.text x

-- (a list's items from `i`, those so far in `acc`, last first)
itemsGo : LitReader -> Array L.Tok -> Int -> List Lit -> Got (List Lit)
itemsGo r ts i acc = case r.lit ts i of
  Left p -> Left p
  Right (MkPair x j) ->
    if isPunct "," (A.index ts j) then itemsGo r ts (j + 1) (Cons x acc)
    else if isPunct "]" (A.index ts j)
      then Right (MkPair (reverse (Cons x acc)) (j + 1))
    else Left
        (problemAt
           (A.index ts j)
           "expected `,` or `]`: an item is a literal, nothing is computed")

-- (a record's fields from `i`)
fieldsGo : LitReader
         -> Array L.Tok
         -> Int
         -> List (Pair String Lit)
         -> Got (List (Pair String Lit))
fieldsGo r ts i acc =
  if not (strEq (A.index ts i).kind "var")
    then Left (problemAt (A.index ts i) "expected a field's name")
  else if not
    (strEq (A.index ts (i + 1)).kind "sym"
     && strEq (A.index ts (i + 1)).text "=")
    then Left (problemAt (A.index ts (i + 1)) "expected `=`")
  else case r.lit ts (i + 2) of
    Left p -> Left p
    Right (MkPair x j) ->
      if isPunct "," (A.index ts j)
        then fieldsGo r ts (j + 1) (Cons (MkPair (A.index ts i).text x) acc)
      else if isPunct "}" (A.index ts j)
        then Right
            (MkPair (reverse (Cons (MkPair (A.index ts i).text x) acc)) (j + 1))
      else Left
          (problemAt
             (A.index ts j)
             "expected `,` or `}`: a field is a literal, nothing is computed")

listAt : L.Tok -> Got (List Lit) -> Got Lit
listAt t (Left p) = Left p
listAt t (Right (MkPair xs j)) = Right (MkPair (LList xs t) j)

recordAt : L.Tok -> Got (List (Pair String Lit)) -> Got Lit
recordAt t (Left p) = Left p
recordAt t (Right (MkPair fs j)) = Right (MkPair (LRec fs t) j)

litF : LitReader -> Array L.Tok -> Int -> Got Lit
litF r ts i =
  if strEq (A.index ts i).kind "str"
    then Right (MkPair (LStr (A.index ts i).text (A.index ts i)) (i + 1))
  else if isPunct "[" (A.index ts i)
    then (if isPunct "]" (A.index ts (i + 1))
            then Right (MkPair (LList Nil (A.index ts i)) (i + 2))
          else listAt (A.index ts i) (itemsGo r ts (i + 1) Nil))
  else if isPunct "{" (A.index ts i)
    then recordAt (A.index ts i) (fieldsGo r ts (i + 1) Nil)
  else Left
      (problemAt
         (A.index ts i)
         "package.hf holds strings, lists `[...]` and records `{...}`, nothing else")

litReader : LitReader
litReader = { lit = \ts i -> litF litReader ts i }

-- The declarations
--------------------------------------------------------------------------------

startsDecl : L.Tok -> Bool
startsDecl t = strEq t.kind "eof" || (t.first && t.col == 0)

-- (the next declaration's first token, from `i` on)
nextDecl : Array L.Tok -> Int -> Int
nextDecl ts i = if startsDecl (A.index ts i) then i else nextDecl ts (i + 1)

isSym : String -> L.Tok -> Bool
isSym x t = strEq t.kind "sym" && strEq t.text x

-- | the literal `package` is defined as, the declarations from `i` on
-- | read (`found`: it, if it has been met)
declsGo : Array L.Tok -> Int -> Maybe Lit -> Either Problem Lit
declsGo ts i found =
  if strEq (A.index ts i).kind "eof"
    then (case found of
          Just x -> Right x
          Nothing ->
            Left (problemAt (A.index ts i) "package.hf defines no `package`"))
  else if strEq (A.index ts i).kind "kw" && strEq (A.index ts i).text "import"
    then declsGo ts (nextDecl ts (i + 1)) found
  else if strEq (A.index ts i).kind "var"
  && strEq (A.index ts i).text "package"
  && isSym ":" (A.index ts (i + 1))
    then declsGo ts (nextDecl ts (i + 1)) found
  else if strEq (A.index ts i).kind "var"
  && strEq (A.index ts i).text "package"
  && isSym "=" (A.index ts (i + 1))
    then (case found of
          Just _ ->
            Left
              (problemAt (A.index ts i) "`package` is defined more than once")
          Nothing -> case litReader.lit ts (i + 2) of
            Left p -> Left p
            Right (MkPair x j) ->
              if startsDecl (A.index ts j) then declsGo ts j (Just x)
              else Left
                  (problemAt
                     (A.index ts j)
                     "`package` is a literal, and nothing follows it"))
  else Left
      (problemAt
         (A.index ts i)
         "package.hf holds imports, and `package` (its signature and its definition), nothing else")

-- What it says
--------------------------------------------------------------------------------

-- | a package required: the name it is imported by, where it is fetched
-- | from, its least version
type Require = { name : String, path : String, version : String }

-- | a required package taken from a directory instead
type Replace = { name : String, dir : String }

-- | what a package.hf says
type Package =
  { module : String
  , heff : String
  , require : List Require
  , replace : List Replace
  }

rangeFrom : Int -> Int -> List Int
rangeFrom i n = if i >= n then Nil else Cons i (rangeFrom (i + 1) n)

headM : List Int -> Maybe Int
headM (Cons x _) = Just x
headM Nil = Nothing

-- (the digits of a version's part: no sign, no leading zero)
isNumber : String -> Bool
isNumber s =
  strLength s > 0
  && all
    (\c -> 48 <= c && c <= 57)
    (map (\i -> charCode s i) (rangeFrom 0 (strLength s)))
  && (strLength s == 1 || not (charCode s 0 == 48))

-- | a version's three numbers, if it is `a.b.c`
version : String -> Maybe (List Int)
version v = case split "." v of
  Cons a (Cons b (Cons c Nil)) ->
    if isNumber a && isNumber b && isNumber c
      then Just (map (\x -> fromMaybe 0 (parseInt x)) [a, b, c])
    else Nothing
  _ -> Nothing

-- | a heff of version `running` builds a project written for `wanted`:
-- | the same major, and not older; under 1.0.0, the same minor
compatible : List Int -> List Int -> Bool
compatible (Cons wa (Cons wb (Cons wc Nil))) (Cons ra (Cons rb (Cons rc Nil))) =
  if wa == 0 then ra == 0 && rb == wb && rc >= wc
  else ra == wa && (rb > wb || (rb == wb && rc >= wc))
compatible _ _ = False

-- (a path's last part)
lastPart : String -> String
lastPart p = case reverse (split "/" p) of
  Cons x _ -> x
  Nil -> p

-- | `/vN` the path must end in for a version of major `n`, if any
majorSuffix : Int -> Maybe String
majorSuffix n = if n >= 2 then Just ("v" ++ showInt n) else Nothing

isMajorPart : String -> Bool
isMajorPart x =
  strLength x >= 2
  && strEq (strSlice x 0 1) "v"
  && isNumber (strSlice x 1 (strLength x))

-- | a name a package is imported by: a module name's first part
isName : String -> Bool
isName x =
  strLength x > 0
  && (97 <= charCode x 0 && charCode x 0 <= 122)
  && all
    (\c ->
       (97 <= c && c <= 122)
       || (65 <= c && c <= 90)
       || (48 <= c && c <= 57)
       || c == 95)
    (map (\i -> charCode x i) (rangeFrom 0 (strLength x)))

-- Reading the literal into a Package
--------------------------------------------------------------------------------

type Check a = Either Problem a

fieldNames : List (Pair String Lit) -> List String
fieldNames fs = map fst fs

sameNames : List String -> List String -> Bool
sameNames Nil Nil = True
sameNames (Cons x xs) (Cons y ys) = strEq x y && sameNames xs ys
sameNames _ _ = False

-- (a record with exactly these fields, in this order, as the type has them)
fieldsAre : List String -> Lit -> Check (List Lit)
fieldsAre names (LRec fs t) =
  if sameNames (fieldNames fs) names then Right (map snd fs)
  else Left
      (problemAt
         t
         ("the fields are " ++ joinWith ", " names ++ ", in this order"))
fieldsAre names x = Left (problemAt (litTok x) "expected a record `{...}`")

str : Lit -> Check String
str (LStr s _) = Right s
str x = Left (problemAt (litTok x) "expected a string")

items : Lit -> Check (List Lit)
items (LList xs _) = Right xs
items x = Left (problemAt (litTok x) "expected a list `[...]`")

versionOf : Lit -> Check String
versionOf x = case str x of
  Left p -> Left p
  Right v -> case version v of
    Just _ -> Right v
    Nothing ->
      Left
        (problemAt
           (litTok x)
           ("`" ++ v ++ "` is no version: write `a.b.c`, three numbers"))

nameOf : Lit -> Check String
nameOf x = case str x of
  Left p -> Left p
  Right n ->
    if isName n then Right n
    else Left
        (problemAt
           (litTok x)
           ("`"
            ++ n
            ++ "` cannot be imported by: a name is a lowercase letter, then letters, digits and `_`"))

-- | what is wrong with fetching version `v` from `path`, if anything: its
-- | `/vN` and the version's major disagree
majorMismatch : String -> String -> Maybe String
majorMismatch path v = case majorSuffix
    (fromMaybe 0 (headM (fromMaybe Nil (version v)))) of
  Just suffix ->
    if strEq (lastPart path) suffix then Nothing
    else Just
        ("version " ++ v ++ " is fetched from a path ending in /" ++ suffix)
  Nothing ->
    if isMajorPart (lastPart path)
      then Just
          ("version " ++ v ++ " is fetched from a path without a /vN ending")
    else Nothing

-- (the path's `/vN` agrees with the version's major)
pathFor : Lit -> String -> Check String
pathFor x v = case str x of
  Left p -> Left p
  Right path -> case majorMismatch path v of
    Just why -> Left (problemAt (litTok x) why)
    Nothing -> Right path

requireOf : Lit -> Check Require
requireOf x = case fieldsAre ["name", "path", "version"] x of
  Left p -> Left p
  Right (Cons n (Cons p (Cons v Nil))) -> case nameOf n of
    Left e -> Left e
    Right name -> case versionOf v of
      Left e -> Left e
      Right ver -> case pathFor p ver of
        Left e -> Left e
        Right path -> Right { name = name, path = path, version = ver }
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

replaceOf : Lit -> Check Replace
replaceOf x = case fieldsAre ["name", "dir"] x of
  Left p -> Left p
  Right (Cons n (Cons d Nil)) -> case nameOf n of
    Left e -> Left e
    Right name -> case str d of
      Left e -> Left e
      Right dir -> Right { name = name, dir = dir }
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

consCheck : {a : Type} -> Check a -> Check (List a) -> Check (List a)
consCheck (Left p) _ = Left p
consCheck (Right y) (Left p) = Left p
consCheck (Right y) (Right ys) = Right (Cons y ys)

allOf : {a : Type} -> (Lit -> Check a) -> List Lit -> Check (List a)
allOf f Nil = Right Nil
allOf f (Cons x rest) = consCheck (f x) (allOf f rest)

-- (the first name required twice, and where)
twiceGo : List String -> List (Pair String Lit) -> Maybe (Pair String Lit)
twiceGo seen Nil = Nothing
twiceGo seen (Cons (MkPair n x) rest) =
  if elemBy strEq n seen then Just (MkPair n x) else twiceGo (Cons n seen) rest

requiredNames : List Lit -> List Require -> List (Pair String Lit)
requiredNames xs rs = zipWith (\x (r : Require) -> MkPair r.name x) xs rs

replacedNames : List Lit -> List Replace -> List (Pair String Lit)
replacedNames xs rs = zipWith (\x (r : Replace) -> MkPair r.name x) xs rs

-- (a replaced name that is not required)
unrequired : List String -> List (Pair String Lit) -> Maybe (Pair String Lit)
unrequired names Nil = Nothing
unrequired names (Cons (MkPair n x) rest) =
  if elemBy strEq n names then unrequired names rest else Just (MkPair n x)

checkNames : List Lit -> List Require -> List Lit -> List Replace -> Check Unit
checkNames rxs rs pxs ps = case twiceGo Nil (requiredNames rxs rs) of
  Just (MkPair n x) ->
    Left (problemAt (litTok x) ("`" ++ n ++ "` is required twice"))
  Nothing -> case twiceGo Nil (replacedNames pxs ps) of
    Just (MkPair n x) ->
      Left (problemAt (litTok x) ("`" ++ n ++ "` is replaced twice"))
    Nothing -> case unrequired
        (map (\(r : Require) -> r.name) rs)
        (replacedNames pxs ps) of
      Just (MkPair n x) ->
        Left
          (problemAt (litTok x) ("`" ++ n ++ "` is replaced, but not required"))
      Nothing -> Right MkUnit

packageOf4 : Lit -> Lit -> Lit -> Lit -> Check Package
packageOf4 m h rq rp = case str m of
  Left p -> Left p
  Right mpath -> case versionOf h of
    Left p -> Left p
    Right hv -> case items rq of
      Left p -> Left p
      Right rxs -> case allOf requireOf rxs of
        Left p -> Left p
        Right rs -> case items rp of
          Left p -> Left p
          Right pxs -> case allOf replaceOf pxs of
            Left p -> Left p
            Right ps -> case checkNames rxs rs pxs ps of
              Left p -> Left p
              Right _ ->
                Right { module = mpath, heff = hv, require = rs, replace = ps }

packageOf : Lit -> Check Package
packageOf x = case fieldsAre ["module", "heff", "require", "replace"] x of
  Left p -> Left p
  Right (Cons m (Cons h (Cons rq (Cons rp Nil)))) -> packageOf4 m h rq rp
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

lexedTokens : L.Lexed -> List L.Tok
lexedTokens l = l.tokens

lexedErrors : L.Lexed -> List L.Err
lexedErrors l = l.errors

-- | a package.hf's text, read
readPackage : String -> Check Package
readPackage src = case lexedErrors (L.lex src) of
  Cons e _ -> Left { at = e.start, msg = e.msg }
  Nil -> case declsGo (A.fromList (lexedTokens (L.lex src))) 0 Nothing of
    Left p -> Left p
    Right x -> packageOf x

-- (what is wrong, said; or the module path)
said : Check Package -> String
said (Left p) = showInt p.at ++ ": " ++ p.msg
said (Right pk) =
  pk.module
  ++ " "
  ++ pk.heff
  ++ " "
  ++ joinWith
    ","
    (map (\(r : Require) -> r.name ++ "@" ++ r.version) pk.require)

-- >>> said (readPackage "import manifest\n\npackage : Package\npackage =\n  { module = \"m\"\n  , heff = \"0.1.0\"\n  , require = [{ name = \"json\", path = \"x.org/json\", version = \"1.2.0\" }]\n  , replace = []\n  }\n")
-- "m 0.1.0 json@1.2.0"

-- >>> said (readPackage "package = { module = \"m\", heff = \"0.1\", require = [], replace = [] }")
-- "33: `0.1` is no version: write `a.b.c`, three numbers"

-- >>> said (readPackage "package = { heff = \"0.1.0\", module = \"m\", require = [], replace = [] }")
-- "10: the fields are module, heff, require, replace, in this order"

-- >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"j\", path = \"x.org/j\", version = \"2.0.0\" }], replace = [] }")
-- "74: version 2.0.0 is fetched from a path ending in /v2"

-- >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"j\", path = \"x.org/j/v2\", version = \"2.0.0\" }, { name = \"j\", path = \"y.org/j\", version = \"1.0.0\" }], replace = [] }")
-- "109: `j` is required twice"

-- >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [], replace = [{ name = \"j\", dir = \"../j\" }] }")
-- "67: `j` is replaced, but not required"

-- >>> said (readPackage "package = { module = \"m\" ++ \"n\", heff = \"0.1.0\", require = [], replace = [] }")
-- "25: expected `,` or `}`: a field is a literal, nothing is computed"

-- >>> said (readPackage "helper = 1\npackage = { module = \"m\", heff = \"0.1.0\", require = [], replace = [] }")
-- "0: package.hf holds imports, and `package` (its signature and its definition), nothing else"

-- >>> compatible [0, 1, 0] [0, 1, 3]
-- True

-- >>> compatible [0, 1, 4] [0, 1, 3]
-- False

-- >>> compatible [0, 1, 0] [0, 2, 0]
-- False

-- >>> compatible [1, 2, 0] [1, 3, 0]
-- True
