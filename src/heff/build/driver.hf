-- The program, module by module.  Each file sees its own definitions
-- and those of the modules it imports, by name; what those need is
-- there too, by key, but not in scope.  Sources are handed over in
-- dependency order (`heff.build.load` finds them).

import array as Array
import heff.syntax.diagnostic
import heff.util.dict as Dict
import heff.elab.effect as Effect
import heff.compile.erase as Erase
import heff.elab.environment as Environment
import heff.syntax.fixity as Fixity
import heff.elab.globals as Globals
import heff.syntax.import as Import
import heff.compile.interp as Interp
import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import heff.syntax.surfaceprint as SurfacePrint
import heff.elab.readback as Readback
import heff.elab.rename as Rename
import heff.lsp.render as Render
import heff.syntax.surface as Surface
import heff.elab.syntax as Syntax
import heff.elab.top as Top
import heff.elab.toplevel as TopLevel
import heff.elab.value as Value
import map as Map

-- | a file of a program: the module it is, where it is, its text, the
-- | imports it writes that mean another module (one of another package,
-- | imported by the name its importer requires it by), and the modules
-- | it imports without writing them (`I.implicitModules`, but those it
-- | is made of); `shown` its path as a diagnostic names it (one of the
-- | library's as `lib/...`); `library`, whether it is one of the
-- | library's, the modules that declare primitives
type Source =
  { module : String
  , path : String
  , shown : String
  , source : String
  , renames : List (Pair String String)
  , implicit : List String
  , library : Bool
  }

-- | a file's imports, each naming the module it means
importsOfSource : Source -> Import.Imports
importsOfSource s =
  Import.renamed s.renames (Import.importsOf s.implicit s.source)

type Own = { name : String, key : String }

mkOwn : String -> String -> Own
mkOwn name key = { name = name, key = key }

type AliasQ = { module : String, alias : String }

-- | a module elaborated (`opens`, `aliases`: what the imports it writes
-- | open, and by which names it has the modules it imports as `M`)
type Checked =
  { module : String
  , path : String
  , shown : String
  , source : String
  , decls : List Presyntax.Decl
  , top : TopLevel.TopResult
  , diags : List Diag
  , own : List Own
  , deps : List String
  , opens : List String
  , aliases : List AliasQ
  , fixities : Fixity.Fixities
  , cached : Bool
  }

appendD : {a : Type} -> List a -> List a -> List a
appendD Nil ys = ys
appendD (Cons x xs) ys = Cons x (appendD xs ys)

concatMapD : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapD f Nil = Nil
concatMapD f (Cons x xs) = appendD (f x) (concatMapD f xs)

nubStrD : List String -> List String
nubStrD Nil = Nil
nubStrD (Cons x xs) = Cons x (nubStrD (List.filter (\y -> not (strEq y x)) xs))

elemStr : String -> List String -> Bool
elemStr x xs = List.elemBy strEq x xs

-- | a file given among others in dependency order, after the modules
-- | `before`: it imports without writing them the implicit modules given
-- | before it
givenAfter : List String -> String -> String -> String -> Bool -> Source
givenAfter before m path src library =
  { module = m
  , path = path
  , shown = path
  , source = src
  , renames = Nil
  , implicit = List.filter (\i -> elemStr i before) Import.implicitModules
  , library = library
  }

findChecked : List Checked -> String -> Maybe Checked
findChecked Nil m = Nothing
findChecked (Cons c rest) m =
  if strEq c.module m then Just c else findChecked rest m

depsOf : List Checked -> String -> List String
depsOf done m = case findChecked done m of
  Just c -> c.deps
  Nothing -> Nil

-- | the modules reached from some, through their imports
closureGo : List Checked -> List String -> List String -> List String
closureGo done seen Nil = seen
closureGo done seen (Cons m ms) =
  if elemStr m seen then closureGo done seen ms
  else closureGo done (Cons m seen) (appendD ms (depsOf done m))

closure : List Checked -> List String -> List String
closure done ms = closureGo done Nil ms

mergeBroken : Map.Map String Unit -> Globals.Globals -> Globals.Globals
mergeBroken b g = List.foldl (\g2 k -> Globals.addBroken k g2) g (Map.keys b)

-- (a key there already is a primitive another module declared too --
-- an error, `withTwice` says where -- and the first stays)
withEntry : String -> Checked -> Globals.Globals -> Globals.Globals
withEntry k c g = case Globals.keyedEntry g k of
  Just _ -> g
  Nothing -> case Globals.lookupEntry c.top.globals k of
    Just e -> Globals.addEntry k e g
    Nothing -> g

-- (the module's definitions, and the module itself as a value: its
-- theory and its struct travel with it)
envOne : Checked -> Globals.Globals -> Globals.Globals
envOne c g =
  withEntry
    (c.module ^ "#")
    c
    (withEntry
       (c.module ^ "#T")
       c
       (List.foldl
          (\g2 (o : Own) -> withEntry o.key c g2)
          (mergeBroken c.top.globals.broken g)
          c.own))

-- | each needed module's definitions, by key, and its broken set
envOf : List Checked -> List Checked -> Globals.Globals
envOf done needed = List.foldl (\g c -> envOne c g) Globals.emptyGlobals needed

type Imported = { name : String, key : String, module : String }

mkImported : String -> String -> String -> Imported
mkImported name key module2 = { name = name, key = key, module = module2 }

catMaybesD : {a : Type} -> List (Maybe a) -> List a
catMaybesD Nil = Nil
catMaybesD (Cons (Just x) xs) = Cons x (catMaybesD xs)
catMaybesD (Cons Nothing xs) = catMaybesD xs

anyD : {a : Type} -> (a -> Bool) -> List a -> Bool
anyD p Nil = False
anyD p (Cons x xs) = p x || anyD p xs

-- | (a name of a module imported without being written (`unwritten`)
-- | gives way to the same name of a module that is: they do not clash)
givesWay : List String -> List Imported -> Imported -> Bool
givesWay unwritten imported o =
  elemStr o.module unwritten
  && anyD
    (\(p : Imported) -> strEq p.name o.name && not (elemStr p.module unwritten))
    imported

withoutGiven : List String -> List Imported -> List Imported
withoutGiven unwritten all =
  List.filter (\(o : Imported) -> not (givesWay unwritten all o)) all

importedOf : List String -> List Checked -> List Imported
importedOf unwritten direct =
  withoutGiven
    unwritten
    (concatMapD
       (\(c : Checked) ->
          List.map (\(o : Own) -> mkImported o.name o.key c.module) c.own)
       direct)

brokenName : Checked -> String -> Maybe Imported
brokenName c k =
  if startsWith (c.module ^ ".") k
    then Just
        (mkImported
           (strSlice k (strLength c.module + 1) (strLength k))
           k
           c.module)
  else Nothing

-- | what did not elaborate in a module imported, by its name there
brokenIn : Checked -> List Imported
brokenIn c =
  catMaybesD (List.map (\k -> brokenName c k) (Map.keys c.top.globals.broken))

nubByName : List Imported -> List Imported
nubByName Nil = Nil
nubByName (Cons o rest) =
  Cons
    o
    (nubByName
       (List.filter (\(p : Imported) -> not (strEq p.name o.name)) rest))

-- (each name imported: the key it first came with, and whether another
-- key came with it too)
clashMap : Map.Map String (Pair String Bool)
         -> List Imported
         -> Map.Map String (Pair String Bool)
clashMap m Nil = m
clashMap m (Cons o rest) =
  clashMap
    (case Map.lookup compareString o.name m of
     Nothing -> Map.insert compareString o.name (MkPair o.key False) m
     Just (MkPair k c) ->
       if c || strEq k o.key then m
       else Map.insert compareString o.name (MkPair k True) m)
    rest

clashedIn : Map.Map String (Pair String Bool) -> Imported -> Bool
clashedIn m o = case Map.lookup compareString o.name m of
  Just (MkPair _ c) -> c
  Nothing -> False

-- | a name two modules imported define, each its own way: in scope as
-- | neither, a use of it unqualified is an error
clashesOf : List Imported -> List Imported
clashesOf imported =
  nubByName (List.filter (clashedIn (clashMap Map.empty imported)) imported)

spanOfName : List (Pair String Params.Span) -> String -> Maybe Params.Span
spanOfName Nil x = Nothing
spanOfName (Cons (MkPair y sp) rest) x =
  if strEq x y then Just sp else spanOfName rest x

-- (the line, from 1, the offset `at` is on)
lineAt : String -> Int -> Int
lineAt src at = (Render.lineCol src at).line + 1

-- (the module `c`, at `sp`, said)
placeAt : Checked -> Params.Span -> String
placeAt c sp =
  "by "
  ^ c.module
  ^ ", at "
  ^ c.shown
  ^ ":"
  ^ showInt (lineAt c.source sp.start)

-- (where the module `c` defines `x`, said)
placeIn : Checked -> String -> String
placeIn c x = case spanOfName (appendD c.top.spans c.top.broken) x of
  Just sp -> placeAt c sp
  Nothing -> "by " ^ c.module

-- (where an imported name is defined: said, by its key)
withPlace : List Checked -> Imported -> Globals.Globals -> Globals.Globals
withPlace done o g = case findChecked done o.module of
  Just c -> Globals.addPlace o.key (placeIn c o.name) g
  Nothing -> g

-- | the open imports' names, aliased in -- unless clashed: ambiguous then,
-- | each key's place said -- or already the key, a primitive's: found by
-- | it where no name of the module's own, or another import's, is
-- | (`G.lookupKey`)
aliasOpen : List Checked
          -> List Imported
          -> Globals.Globals
          -> List Imported
          -> Globals.Globals
aliasOpen done clashes g Nil = g
aliasOpen done clashes g (Cons o rest) =
  aliasOpen
    done
    clashes
    (if anyD (\(cl : Imported) -> strEq cl.name o.name) clashes
       then withPlace done o (Globals.addAmbiguous o.name [o.key] g)
     else if strEq o.key o.name then g
     else Globals.addAlias o.name o.key g)
    rest

-- (`M`, the module itself, a value -- unless `M` names something
-- already, as `List` does, builtin's type, where `list` is `List`)
aliasModule : Globals.Globals -> AliasQ -> Globals.Globals
aliasModule g q = case Globals.lookupName g q.alias of
  Just _ -> g
  Nothing -> Globals.addAlias q.alias (q.module ^ "#") g

-- (`import m as M`: `m`'s definitions as `M.x`, and `M` the module)
aliasQOne : List Checked -> Globals.Globals -> AliasQ -> Globals.Globals
aliasQOne done g q = case findChecked done q.module of
  Just c ->
    List.foldl
      (\g2 (o : Imported) -> Globals.addAlias (q.alias ^ "." ^ o.name) o.key g2)
      (aliasModule g q)
      (appendD
         (List.map (\(o : Own) -> mkImported o.name o.key c.module) c.own)
         (brokenIn c))
  -- (a module that did not load, its load's error said: what is used of
  -- it, `M.x`, is not an error of its own)
  Nothing -> Globals.addBroken (q.alias ^ ".") g

-- | `import m as M`: `m`'s definitions as `M.x`
aliasQualified : List Checked
               -> Globals.Globals
               -> List AliasQ
               -> Globals.Globals
aliasQualified done g Nil = g
aliasQualified done g (Cons q rest) =
  aliasQualified done (aliasQOne done g q) rest

-- | the instances a module declares, by key, in the order declared
ownInstances : Checked -> List String
ownInstances c =
  List.map
    (\(i : Globals.Instance) -> i.key)
    (List.filter
       (\(i : Globals.Instance) -> strEq i.module c.module)
       (Globals.instancesOf c.top.globals))

-- | the instances of the modules a file imports, by name or by alias --
-- | not those of what they import -- in scope for its instance searches
withImportedInstances : List Checked
                      -> List String
                      -> Globals.Globals
                      -> Globals.Globals
withImportedInstances done modules g =
  List.foldl
    (\g2 m -> case findChecked done m of
     Just c ->
       List.foldl
         (\g3 k -> Globals.addInstance k c.module g3)
         g2
         (ownInstances c)
     Nothing -> g2)
    g
    modules

knownIn : Globals.Globals -> String -> Bool
knownIn g x = case Globals.lookupName g x of
  Just _ -> True
  Nothing -> case Globals.ambiguousIn g x of
    Just _ -> True
    Nothing -> Globals.underBroken g x

-- | what does not parse: a use of it is not an error of its own
withParseBroken : (String -> String)
                -> Globals.Globals
                -> List String
                -> Globals.Globals
withParseBroken key g Nil = g
withParseBroken key g (Cons x rest) =
  withParseBroken
    key
    (Globals.addBroken (key x) (Globals.addOwn x (key x) g))
    rest

-- (a primitive's key is its bare name, unprefixed)
ownOf : String -> List String -> List Own
ownOf modName keys =
  List.map
    (\k ->
       if startsWith (modName ^ ".") k
         then mkOwn (strSlice k (strLength modName + 1) (strLength k)) k
       else mkOwn k k)
    keys

mkChecked : String
          -> String
          -> String
          -> String
          -> List Presyntax.Decl
          -> TopLevel.TopResult
          -> List Diag
          -> List Own
          -> List String
          -> List String
          -> List AliasQ
          -> Fixity.Fixities
          -> Bool
          -> Checked
mkChecked m path shown source decls top diags own deps opens aliases fixities cached =
  { module = m
  , path = path
  , shown = shown
  , source = source
  , decls = decls
  , top = top
  , diags = diags
  , own = own
  , deps = deps
  , opens = opens
  , aliases = aliases
  , fixities = fixities
  , cached = cached
  }

importNames : List Import.Import -> List String
importNames imps = nubStrD (List.map (\(i : Import.Import) -> i.name) imps)

openNames : List Import.Import -> List String
openNames Nil = Nil
openNames (Cons i@{ alias = Nothing } rest) = Cons i.name (openNames rest)
openNames (Cons { alias = Just _ } rest) = openNames rest

-- (the names of the modules imported without being written)
implicitNames : Import.Imports -> List String
implicitNames imps = List.map (\(i : Import.Import) -> i.name) imps.implicit

aliasPairs : List Import.Import -> List AliasQ
aliasPairs Nil = Nil
aliasPairs (Cons i@{ alias = Just a } rest) =
  Cons { module = i.name, alias = a } (aliasPairs rest)
aliasPairs (Cons { alias = Nothing } rest) = aliasPairs rest

-- A file, after its definitions, as a value: a struct of them, under
-- the module's own name (importers reach it by their alias,
-- `import m as M`).  Its type is the file's theory -- the
-- definitions' types as a telescope, a reference to an earlier
-- definition becoming a reference to its field -- and its fields are
-- the definitions themselves, so the struct adds no equations: `M.x`
-- and the global are one.

type SEntry =
  { name : String, key : String, ty : Syntax.Ty, level : Params.Level }

structEntryOf : Globals.Globals -> Own -> Maybe SEntry
structEntryOf g o = case Globals.lookupEntry g o.key of
  Just e ->
    Just
      { name = o.name
      , key = o.key
      , ty = e.tySyntax
      , level = Value.levelOf e.type_
      }
  Nothing -> Nothing

structEntries : Globals.Globals -> List Own -> List SEntry
structEntries g own = catMaybesD (List.map (\o -> structEntryOf g o) own)

structLevel : List SEntry -> Params.Level
structLevel es =
  List.foldl (\l (r : SEntry) -> Params.maxLevel l r.level) Small es

structIdxGo : Int -> List SEntry -> Map.Map String Int -> Map.Map String Int
structIdxGo i Nil m = m
structIdxGo i (Cons r rest) m =
  structIdxGo (i + 1) rest (Map.insert compareString r.key i m)

structIdx : List SEntry -> Map.Map String Int
structIdx es = structIdxGo 0 es Map.empty

-- | the closers, knotted over the index of the module's own keys
type CK =
  { ty : Int -> Int -> Syntax.Ty -> Syntax.Ty
  , el : Int -> Int -> Syntax.Tm -> Syntax.Tm
  }

closeAbs : {a : Type} -> (Int -> a -> a) -> Int -> Syntax.Abs a -> Syntax.Abs a
closeAbs f depth (MkAbs x t) = MkAbs x (f (depth + 1) t)
-- (a constant abstraction does not bind: its body is a step shallower)
closeAbs f depth (AbsConst t) = AbsConst (f depth t)

closeFieldsGo : CK
              -> Int
              -> Int
              -> Int
              -> List (Pair String Syntax.Ty)
              -> List (Pair String Syntax.Ty)
closeFieldsGo r i depth j Nil = Nil
closeFieldsGo r i depth j (Cons (MkPair x t) rest) =
  Cons (MkPair x (r.ty i (depth + j) t)) (closeFieldsGo r i depth (j + 1) rest)

-- | a definition's type, moved into the telescope of the fields before
-- | field `i`: a reference to an earlier definition becomes its field,
-- | by index from `depth` binders down; anything else stays the global
-- | it was
closeTypeF : CK -> Map.Map String Int -> Int -> Int -> Syntax.Ty -> Syntax.Ty
closeTypeF r idx i depth (SDecode e) = SDecode (r.el i depth e)
-- (an implicit argument's default is closed: the globals it mentions
-- stay globals)
closeTypeF r idx i depth (SFunction level dom cod implicit dflt) =
  SFunction
    level
    (r.ty i depth dom)
    (closeAbs (\d2 t2 -> r.ty i d2 t2) depth cod)
    implicit
    dflt
-- (a default names no local but the fields before it: the globals it
-- mentions stay globals)
closeTypeF r idx i depth (SRecord level fs ds) =
  SRecord level (Dict.fromList (closeFieldsGo r i depth 0 (Dict.toList fs))) ds
closeTypeF r idx i depth (SSum vs) =
  SSum (Params.variantsMap (\t2 -> r.ty i depth t2) vs)
closeTypeF r idx i depth (SIsTy t2) = SIsTy (r.ty i depth t2)
closeTypeF r idx i depth (SPrimArray t2) = SPrimArray (r.ty i depth t2)
closeTypeF r idx i depth t = t

closeCase : CK
          -> Int
          -> Int
          -> Pair (Array String) Syntax.Tm
          -> Pair (Array String) Syntax.Tm
closeCase r i depth (MkPair xs b) =
  MkPair xs (r.el i (depth + List.length (Array.toList xs)) b)

closeTermF : CK -> Map.Map String Int -> Int -> Int -> Syntax.Tm -> Syntax.Tm
closeTermF r idx i depth (SGlobal k) = case Map.lookup compareString k idx of
  Just j -> if j < i then SLocal (depth + (i - 1 - j)) else SGlobal k
  Nothing -> SGlobal k
closeTermF r idx i depth (SCode t) = SCode (r.ty i depth t)
closeTermF r idx i depth (SApp f a2) = SApp (r.el i depth f) (r.el i depth a2)
closeTermF r idx i depth (SLam t b) =
  SLam (r.ty i depth t) (closeAbs (\d2 e2 -> r.el i d2 e2) depth b)
closeTermF r idx i depth (SCons d) =
  SCons (Dict.mapD (\e2 -> r.el i depth e2) d)
closeTermF r idx i depth (SProj e2 l) = SProj (r.el i depth e2) l
closeTermF r idx i depth (STag t as) =
  STag t (Array.fromList (List.map (\e2 -> r.el i depth e2) (Array.toList as)))
closeTermF r idx i depth (SMatch e2 cs) =
  SMatch (r.el i depth e2) (Dict.mapD (\p -> closeCase r i depth p) cs)
closeTermF r idx i depth (SSpecialize e2 l v) =
  SSpecialize (r.el i depth e2) l (r.el i depth v)
closeTermF r idx i depth (SIs e2) = SIs (r.el i depth e2)
closeTermF r idx i depth (SRec e2) = SRec (r.el i depth e2)
closeTermF r idx i depth (SFix t b) =
  SFix (r.ty i depth t) (closeAbs (\d2 e2 -> r.el i d2 e2) depth b)
closeTermF r idx i depth (SImplicit x e2) = SImplicit x (r.el i depth e2)
closeTermF r idx i depth (SMetaApp m xs t) = SMetaApp m xs (r.ty i depth t)
closeTermF r idx i depth e = e

ckOf : Map.Map String Int -> CK
ckOf idx =
  { ty = \i depth t -> closeTypeF (ckOf idx) idx i depth t
  , el = \i depth e -> closeTermF (ckOf idx) idx i depth e
  }

structFieldsGo : Map.Map String Int
               -> Int
               -> List SEntry
               -> List (Pair String Syntax.Ty)
structFieldsGo idx i Nil = Nil
structFieldsGo idx i (Cons r rest) =
  Cons
    (MkPair r.name ((ckOf idx).ty i 0 r.ty))
    (structFieldsGo idx (i + 1) rest)

structBody : String -> List SEntry -> Globals.Globals -> Globals.Globals
structBody mkey es g' =
  Top.define
    g'
    (mkey ^ "#")
    (SDecode (SGlobal (mkey ^ "#T")))
    (SCons
       (Dict.fromList
          (List.map (\(r : SEntry) -> MkPair r.name (SGlobal r.key)) es)))

-- (the file's theory, a definition of its own (`m#T`), so that the
-- struct's type is a name, as every nominal type is)
structAdd : String
          -> Globals.Globals
          -> List SEntry
          -> Map.Map String Int
          -> Globals.Globals
structAdd mkey g es idx =
  structBody
    mkey
    es
    (Top.define
       g
       (mkey ^ "#T")
       (SU (if Params.eqLevel (structLevel es) Large then LargeU else SmallU))
       (SCode
          (SRecord
             (structLevel es)
             (Dict.fromList (structFieldsGo idx 0 es))
             Dict.empty)))

-- (a file that defines theories has fields no universe holds: it is its
-- definitions only, not a struct of them)
structWith : String -> Globals.Globals -> List SEntry -> Globals.Globals
structWith mkey g es =
  if List.null es || Params.eqLevel (structLevel es) TopL then g
  else structAdd mkey g es (structIdx es)

moduleStruct : String -> List Own -> Globals.Globals -> Globals.Globals
moduleStruct mkey own g = structWith mkey g (structEntries g own)

withStruct : String -> List Own -> TopLevel.TopResult -> TopLevel.TopResult
withStruct m own t =
  TopLevel.mkTop
    (moduleStruct m own t.globals)
    t.diags
    t.keys
    t.broken
    t.watches
    t.tests
    t.spans
    t.infos
    t.trace

directFix : List Checked -> Fixity.Fixities
directFix direct =
  List.foldl
    (\f (c : Checked) -> Fixity.union f c.fixities)
    Fixity.emptyFixities
    direct

-- | each module's own fixities, read from its text alone (nothing
-- | elaborated), by the module's name
type OwnFix = Pair String Fixity.Fixities

fixOf : List OwnFix -> String -> Fixity.Fixities
fixOf Nil m = Fixity.emptyFixities
fixOf (Cons (MkPair n f) rest) m = if strEq n m then f else fixOf rest m

importedFix : List OwnFix -> Import.Imports -> Fixity.Fixities
importedFix done imps =
  List.foldl
    (\f (i : Import.Import) -> Fixity.union f (fixOf done i.name))
    Fixity.emptyFixities
    imps.imports

ownFixOf : List OwnFix -> Import.Imports -> Fixity.Fixities
ownFixOf done imps = Surface.fixitiesOfText (importedFix done imps) imps.text

fixitiesGo : List OwnFix -> List Source -> Fixity.Fixities
fixitiesGo done Nil = Fixity.emptyFixities
fixitiesGo done (Cons s Nil) =
  Fixity.union
    (importedFix done (importsOfSource s))
    (ownFixOf done (importsOfSource s))
fixitiesGo done (Cons s rest) =
  fixitiesGo
    (Cons (MkPair s.module (ownFixOf done (importsOfSource s))) done)
    rest

-- | the fixities in scope in the last of the sources (each after what it
-- | imports): those of the modules it imports, and its own -- as the
-- | formatter lays operators out, without elaborating anything
fixitiesIn : List Source -> Fixity.Fixities
fixitiesIn sources = fixitiesGo Nil sources

-- | the tools add advice on how to fix the common cases
hint : Diag -> Diag
hint d@{ note = Just _ } = d
hint d@{ note = Nothing } =
  if d.code == 319
    then { code = d.code
         , severity = d.severity
         , msg = d.msg
         , span = d.span
         , note =
             Just
               "a recursive call is checked against a type: give it one, `(f ... : T)` or `let x : T = f ...`"
         }
  else if d.code == 204
    then { code = d.code
         , severity = d.severity
         , msg = d.msg
         , span = d.span
         , note =
             Just
               "name the type: `type T = ...` at top level, or a type field of the struct it is in (`t = { ... }`, then `m.t` here)"
         }
  else d

-- | a module thawed from a cache: its fixities, its definitions' core
-- | syntax, and each definition's hash as it was frozen (key, hash) --
-- | `heff.build.cache` reads one
type Thawed =
  { fixities : Fixity.Fixities
  , defs : List TopLevel.ThawedDef
  , hashes : List (Pair String String)
  }

-- (a module the cache has was elaborated clean, and nothing it is made
-- of has changed: its text is not even parsed)
-- (the definitions thawed once, for all that is made of them)
thawedChecked : Source
              -> Import.Imports
              -> Thawed
              -> TopLevel.TopResult
              -> Checked
thawedChecked s imps th t =
  mkChecked
    s.module
    s.path
    s.shown
    s.source
    Nil
    (withStruct s.module (ownOf s.module t.keys) t)
    Nil
    (ownOf s.module t.keys)
    (importNames imps.imports)
    (openNames (Import.written imps))
    (aliasPairs (Import.written imps))
    th.fixities
    True

elabThawed : Source -> Import.Imports -> Thawed -> Globals.Globals -> Checked
elabThawed s imps th g0 =
  thawedChecked s imps th (TopLevel.topThawed g0 th.defs)

-- An import the file has already -- written before it, or had without
-- being written (`import prelude`) -- is an error; `import m` and
-- `import m as M` are two, and `import prelude as P` is not had.

importedAgain : List Import.Import -> Import.Import -> Diag
importedAgain implicit i =
  { code = 334
  , severity = SError
  , msg =
      "`"
      ^ i.name
      ^ "` is imported already"
      ^ (if List.any (Import.sameImport i) implicit
           then ", without being written"
         else "")
  , span = i.span
  , note = Nothing
  }

-- (`had`: the imports before)
againGo : List Import.Import
        -> List Import.Import
        -> List Import.Import
        -> List Diag
againGo implicit had Nil = Nil
againGo implicit had (Cons i rest) =
  appendD
    (if List.any (Import.sameImport i) had then [importedAgain implicit i]
     else Nil)
    (againGo implicit (Cons i had) rest)

-- | the imports the file writes of what it has already
againDiags : Import.Imports -> List Diag
againDiags imps = againGo imps.implicit imps.implicit (Import.written imps)

elabTop : Source
        -> Import.Imports
        -> List Checked
        -> Surface.Read
        -> TopLevel.TopResult
        -> Checked
elabTop s imps direct r t =
  mkChecked
    s.module
    s.path
    s.shown
    s.source
    r.decls
    (withStruct s.module (ownOf s.module t.keys) t)
    (appendD (againDiags imps) (List.map hint (appendD r.diags t.diags)))
    (ownOf s.module t.keys)
    (importNames imps.imports)
    (openNames (Import.written imps))
    (aliasPairs (Import.written imps))
    r.fixities
    False

-- (the declarations elaborated, of those read)
elabDecls : List Checked
          -> Source
          -> Import.Imports
          -> List Checked
          -> Globals.Globals
          -> Surface.Read
          -> List Presyntax.Decl
          -> Checked
elabDecls done s imps direct g0 r decls =
  elabTop
    s
    imps
    direct
    r
    (TopLevel.topModule
       s.module
       (withParseBroken (\x -> s.module ^ "." ^ x) g0 r.broken)
       decls)

-- A primitive is the library's to declare: a module that is not one of
-- the library's has its `primitive` declarations refused, each name
-- broken -- a use of it no error of its own -- as a declaration's that
-- does not parse is.

primOf : Presyntax.Decl -> Maybe (Pair String Params.Span)
primOf (At (DeclPrimitive x _ _) sp) = Just (MkPair x sp)
primOf _ = Nothing

notPrim : Presyntax.Decl -> Bool
notPrim d = case primOf d of
  Just _ -> False
  Nothing -> True

primRefused : Pair String Params.Span -> Diag
primRefused (MkPair _ sp) =
  { code = 335
  , severity = SError
  , msg = "only the library that goes with heff declares primitives"
  , span = sp
  , note = Nothing
  }

-- | what is read of a module that is not one of the library's, its
-- | primitives refused
refusePrims : Surface.Read -> List (Pair String Params.Span) -> Surface.Read
refusePrims r refused =
  { decls = r.decls
  , diags = appendD r.diags (List.map primRefused refused)
  , fixities = r.fixities
  , broken = appendD r.broken (List.map fst refused)
  }

elabRead : List Checked
         -> Source
         -> Import.Imports
         -> List Checked
         -> Globals.Globals
         -> Surface.Read
         -> Checked
elabRead done s imps direct g0 r =
  if s.library then elabDecls done s imps direct g0 r r.decls
  else elabDecls
      done
      s
      imps
      direct
      g0
      (refusePrims r (catMaybesD (List.map primOf r.decls)))
      (List.filter notPrim r.decls)

elabEnv : List Checked
        -> Source
        -> Import.Imports
        -> List Checked
        -> Globals.Globals
        -> Checked
elabEnv done s imps direct g0 =
  elabRead
    done
    s
    imps
    direct
    g0
    (Surface.readProgramWith
       { known = \x -> knownIn g0 x
       , fixities = directFix direct
       , lenient = False
       , place = "by " ^ s.module ^ ", at " ^ s.shown
       , path = s.shown
       }
       imps.text)

elabFrom : List Checked
         -> Source
         -> Import.Imports
         -> Maybe Thawed
         -> List Checked
         -> Globals.Globals
         -> Checked
elabFrom done s imps (Just th) direct g0 = elabThawed s imps th g0
elabFrom done s imps Nothing direct g0 = elabEnv done s imps direct g0

elabClashed : List Checked
            -> Source
            -> Import.Imports
            -> Maybe Thawed
            -> List Checked
            -> List Checked
            -> List Imported
            -> List Imported
            -> Checked
elabClashed done s imps thaw direct needed imported clashes =
  elabFrom
    done
    s
    imps
    thaw
    direct
    (withImportedInstances
       done
       (importNames imps.imports)
       (aliasQualified
          done
          (aliasOpen
             done
             clashes
             (aliasOpen done clashes (envOf done needed) imported)
             (concatMapD (\(c : Checked) -> brokenIn c) direct))
          (aliasPairs imps.imports)))

-- (what is imported, and which of it clashes, reckoned once)
elabAliased : List Checked
            -> Source
            -> Import.Imports
            -> Maybe Thawed
            -> List Checked
            -> List Checked
            -> List Imported
            -> Checked
elabAliased done s imps thaw direct needed imported =
  elabClashed done s imps thaw direct needed imported (clashesOf imported)

elabDirect : List Checked
           -> Source
           -> Import.Imports
           -> Maybe Thawed
           -> List Checked
           -> List Checked
           -> Checked
elabDirect done s imps thaw direct needed =
  elabAliased
    done
    s
    imps
    thaw
    direct
    needed
    (importedOf (implicitNames imps) direct)

-- A primitive is declared once.  One declared again -- by a module made
-- of one that declares it, or twice by one -- is an error where it is
-- declared again; one that two modules declare, neither made of the
-- other, is an error where they meet: at the import that brings in the
-- second, in a module none of whose imports is made of both.  Each
-- place is said.

-- | a primitive declared: its key (its name), by which module, where
type PrimDecl = { key : String, by : Checked, span : Params.Span }

-- (a primitive's key is its name, unprefixed: of the module's own
-- definitions, those whose name is their key)
primDeclsGo : Checked
            -> List Own
            -> List (Pair String Params.Span)
            -> List PrimDecl
primDeclsGo c (Cons o os) (Cons (MkPair _ sp) sps) =
  if strEq o.name o.key
    then Cons { key = o.key, by = c, span = sp } (primDeclsGo c os sps)
  else primDeclsGo c os sps
primDeclsGo c _ _ = Nil

-- | the primitives a module declares, in order
primDecls : Checked -> List PrimDecl
primDecls c = primDeclsGo c c.own c.top.spans

-- | a primitive declared again, and where it was first
type Twice = { first : PrimDecl, again : PrimDecl }

-- (`firsts`: each primitive declared before, where it was first)
twicesGo : Map.Map String PrimDecl -> List PrimDecl -> List Twice
twicesGo firsts Nil = Nil
twicesGo firsts (Cons d rest) = case Map.lookup compareString d.key firsts of
  Just f -> Cons { first = f, again = d } (twicesGo firsts rest)
  Nothing -> twicesGo (Map.insert compareString d.key d firsts) rest

-- (the import `i` is of the module `m`, or of one made of it)
reaches : List Checked -> String -> Import.Import -> Bool
reaches done m i = elemStr m (closure done [i.name])

-- (the two declarations meet in the module `c`: it declares the second,
-- or none of its imports is made of both)
metIn : List Checked -> Import.Imports -> Checked -> Twice -> Bool
metIn done imps c t =
  strEq t.again.by.module c.module
  || not
    (List.any
       (\i ->
          reaches done t.first.by.module i && reaches done t.again.by.module i)
       imps.imports)

-- (the first import that brings in the module `m`; none, the file's
-- start)
importOfGo : List Checked -> String -> List Import.Import -> Params.Span
importOfGo done m Nil = { start = 0, end = 0 }
importOfGo done m (Cons i rest) =
  if reaches done m i then i.span else importOfGo done m rest

twiceDiag : List Checked -> Import.Imports -> Checked -> Twice -> Diag
twiceDiag done imps c t =
  { code = 336
  , severity = SError
  , msg =
      "the primitive `"
      ^ t.again.key
      ^ "` is declared "
      ^ placeAt t.first.by t.first.span
      ^ ", and "
      ^ placeAt t.again.by t.again.span
  , span =
      (if strEq t.again.by.module c.module then t.again.span
       else importOfGo done t.again.by.module imps.imports)
  , note = Nothing
  }

withDiags : Checked -> List Diag -> Checked
withDiags c Nil = c
withDiags c ds =
  mkChecked
    c.module
    c.path
    c.shown
    c.source
    c.decls
    c.top
    (appendD c.diags ds)
    c.own
    c.deps
    c.opens
    c.aliases
    c.fixities
    c.cached

-- | a module checked, the primitives declared twice that meet in it
-- | said: among those it is made of (`needed`) and its own
withTwice : List Checked -> Import.Imports -> List Checked -> Checked -> Checked
withTwice done imps needed c =
  withDiags
    c
    (List.map
       (twiceDiag done imps c)
       (List.filter
          (metIn done imps c)
          (twicesGo
             Map.empty
             (appendD (concatMapD primDecls needed) (primDecls c)))))

-- (the modules the file is made of, reckoned once)
elabMadeOf : List Checked
           -> Source
           -> Import.Imports
           -> Maybe Thawed
           -> List Checked
           -> Checked
elabMadeOf done s imps thaw needed =
  withTwice
    done
    imps
    needed
    (elabDirect
       done
       s
       imps
       thaw
       (List.filter
          (\(c : Checked) -> elemStr c.module (openNames imps.imports))
          done)
       needed)

-- (the modules reached from the imports, reckoned once)
elabNeeding : List Checked
            -> Source
            -> Import.Imports
            -> Maybe Thawed
            -> List String
            -> Checked
elabNeeding done s imps thaw reached =
  elabMadeOf
    done
    s
    imps
    thaw
    (List.filter (\(c : Checked) -> elemStr c.module reached) done)

elabWith : List Checked -> Source -> Import.Imports -> Maybe Thawed -> Checked
elabWith done s imps thaw =
  elabNeeding done s imps thaw (closure done (importNames imps.imports))

-- | one more module, elaborated after what it imports; a module `thaw`
-- | has is not read or elaborated -- its definitions come back through
-- | `topThawed` as they were stored
elabNext : List Checked -> Source -> Maybe Thawed -> Checked
elabNext done s thaw = elabWith done s (importsOfSource s) thaw

-- | the files of a program, each after what it imports, elaborated
-- | >>> List.length (checkProgram [{ module = "a", path = "a.hf", shown = "a.hf", source = "one : Int\none = 1\n", renames = Nil, implicit = Nil, library = False }, { module = "b", path = "b.hf", shown = "b.hf", source = "import a\n\ntwo : Int\ntwo = one\n", renames = Nil, implicit = Nil, library = False }])
-- | 2
checkProgram : List Source -> List Checked
checkProgram sources =
  List.foldl
    (\done s -> appendD done (Cons (elabNext done s Nothing) Nil))
    Nil
    sources

-- | a checked module without what only a tool asking about it needs --
-- | its trace, the types of its names -- as a whole project keeps it
lean : Checked -> Checked
lean c =
  mkChecked
    c.module
    c.path
    c.shown
    c.source
    c.decls
    (TopLevel.mkTop
       c.top.globals
       c.top.diags
       c.top.keys
       c.top.broken
       c.top.watches
       c.top.tests
       c.top.spans
       (List.map Environment.leanInfo c.top.infos)
       Nil)
    c.diags
    c.own
    c.deps
    c.opens
    c.aliases
    c.fixities
    c.cached

-- | ... without its trace alone (a language server never shows it)
traceless : Checked -> Checked
traceless c =
  mkChecked
    c.module
    c.path
    c.shown
    c.source
    c.decls
    (TopLevel.mkTop
       c.top.globals
       c.top.diags
       c.top.keys
       c.top.broken
       c.top.watches
       c.top.tests
       c.top.spans
       c.top.infos
       Nil)
    c.diags
    c.own
    c.deps
    c.opens
    c.aliases
    c.fixities
    c.cached

-- | ... each made lean as soon as it is checked
checkProgramLean : List Source -> List Checked
checkProgramLean sources =
  List.foldl
    (\done s -> appendD done (Cons (lean (elabNext done s Nothing)) Nil))
    Nil
    sources

-- | a checked module's definition keys, in declaration order
moduleKeys : Checked -> List String
moduleKeys c = List.map (\(o : Own) -> o.key) c.own

moduleName : Checked -> String
moduleName c = c.module

-- | a diagnostic, on one line
diagLine : Diag -> String
diagLine d = Render.prtCode d ^ ": " ^ d.msg

diagLines : Checked -> List String
diagLines c = List.map (\(d : Diag) -> diagLine d) c.diags

-- (a primitive, or a definition)
defKind : Checked -> String -> String
defKind c k = case Globals.lookupEntry c.top.globals k of
  Just e -> case e.syntax of
    SPrim _ -> "prim"
    _ -> "plain"
  Nothing -> "plain"

-- | the stored core of one definition of a checked module, printed as
-- | `=def`/`=ty`/`=body` lines
dumpLines : Checked -> String -> List String
dumpLines c k =
  Cons
    ("=def " ^ k ^ " " ^ defKind c k)
    (Cons
       ("=ty " ^ TopLevel.tyDump c.top k)
       (Cons ("=body " ^ TopLevel.bodyDump c.top k) Nil))

-- | the last module's result
lastChecked : List Checked -> Maybe Checked
lastChecked Nil = Nothing
lastChecked (Cons c Nil) = Just c
lastChecked (Cons c rest) = lastChecked rest

-- | a definition's stored core, printed, from a checked program
-- | >>> programBody (checkProgram [{ module = "a", path = "a.hf", shown = "a.hf", source = "one : Int\none = 1\n", renames = Nil, implicit = Nil, library = False }, { module = "b", path = "b.hf", shown = "b.hf", source = "import a\n\ntwo : Int\ntwo = one\n", renames = Nil, implicit = Nil, library = False }]) "b" "b.two"
-- | "(SIs (SGlobal \"a.one\"))"
programBody : List Checked -> String -> String -> String
programBody cs m k = case findChecked cs m of
  Just c -> TopLevel.bodyDump c.top k
  Nothing -> "<no such module>"

programTy : List Checked -> String -> String -> String
programTy cs m k = case findChecked cs m of
  Just c -> TopLevel.tyDump c.top k
  Nothing -> "<no such module>"

-- Watches and tests
--------------------------------------------------------------------------------

-- | a global key by the name it has in the file, else the key (a
-- | synthesized one, which no file writes, in words)
localNames : Globals.Globals -> Map.Map String String
localNames g =
  List.foldl
    (\m (p : Pair String String) -> Map.insert compareString (snd p) (fst p) m)
    Map.empty
    (Map.toList g.aliases)

localNameIn : Map.Map String String -> String -> String
localNameIn m k =
  fromMaybe (Rename.describeKey k) (Map.lookup compareString k m)

-- | a type, its globals by the names they have in the file (else by
-- | key)
showTySx : Globals.Globals -> Syntax.Ty -> String
showTySx g t =
  SurfacePrint.printTy
    SurfacePrint.plainImplicits
    0
    Nil
    (Rename.renameTy (localNameIn (localNames g)) t)

-- | a watch `-- >>> e`, with the `-- ...` lines under it, its
-- | expectation, or a doc test `-- | >>> e`, with the `-- | ...` lines
-- | under it: `expectFrom`..`expectTo` is where those lines are, or
-- | where they would go; `doc`, whether it is a doc test
type WatchInfo =
  { from : Int
  , to : Int
  , expr : String
  , ty : String
  , value : String
  , expected : Maybe String
  , holds : Bool
  , expectFrom : Int
  , expectTo : Int
  , doc : Bool
  }

type Expectation = { expected : Maybe String, from : Int, to : Int }

lineEndFrom : String -> Int -> Int
lineEndFrom src i = case indexFrom "\n" src i of
  Just j -> j
  Nothing -> strLength src

type ExpGo = { lines : List String, stop : Int }

-- | is the watch at `start` a doc test, `-- | >>> e`?
isDocTest : String -> Int -> Bool
isDocTest src start = strEq (strSlice src start (start + 8)) "-- | >>>"

-- (a line of a watch's expectation, `-- v`: `v`; not another watch's
-- line, a doc comment's or a blank one)
watchExpect : String -> Maybe String
watchExpect line =
  if strEq (strSlice line 0 2) "--"
  && not (strEq (strSlice line 0 6) "-- >>>")
  && not (strEq (strSlice line 0 4) "-- |")
  && not (strEq (trim (strSlice line 2 (strLength line))) "")
    then Just (trim (strSlice line 2 (strLength line)))
  else Nothing

-- (a line of a doc test's expectation, `-- | v`: `v`; not another doc
-- test's line or a blank one of the doc comment)
docExpect : String -> Maybe String
docExpect line =
  if strEq (strSlice line 0 4) "-- |"
  && not (strEq (strSlice line 0 8) "-- | >>>")
  && not (strEq (trim (strSlice line 4 (strLength line))) "")
    then Just (trim (strSlice line 4 (strLength line)))
  else Nothing

expectLineAt : Bool -> String -> Int -> String -> Maybe String
expectLineAt doc src i line =
  if i >= strLength src then Nothing
  else if doc then docExpect line
  else watchExpect line

expectLine : Bool -> String -> Int -> Maybe String
expectLine doc src i =
  expectLineAt doc src i (trim (strSlice src i (lineEndFrom src i)))

expectGo : Bool -> String -> Int -> List String -> ExpGo
expectGo doc src i acc = case expectLine doc src i of
  Just l ->
    expectGo
      doc
      src
      (min (strLength src) (lineEndFrom src i + 1))
      (List.append acc (Cons l Nil))
  Nothing -> { lines = acc, stop = i }

expectDone : Int -> ExpGo -> Expectation
expectDone start r =
  { expected =
      if List.null r.lines then Nothing else Just (joinWith "\n" r.lines)
  , from = start
  , to = r.stop
  }

expectAfter : Bool -> String -> Int -> Expectation
expectAfter doc src end =
  expectDone
    (min (strLength src) (lineEndFrom src end + 1))
    (expectGo doc src (min (strLength src) (lineEndFrom src end + 1)) Nil)

-- | the expectation of the watch at `sp`: the `-- ...` lines after the
-- | line its expression ends on, up to a blank one (a doc test's, the
-- | `-- | ...` lines, up to a blank one of its doc comment)
expectation : String -> Params.Span -> Expectation
expectation src sp = expectAfter (isDocTest src sp.start) src sp.end

-- (how many arguments a value of a type that behaves so takes first
-- that are types -- erased where it is compiled, as heff.compile.erase
-- reads them off the type -- the first of them the `lvl`th local)
typeArgsOf : Int -> Value.TB -> Int
typeArgsOf lvl (LikeFunction level dom cod implicit) =
  if Erase.isType lvl dom
    then 1
      + typeArgsOf
        (lvl + 1)
        (Value.behavior
           (Value.nom (Value.appClo cod (\u -> Value.local lvl dom))))
  else 0
typeArgsOf lvl _ = 0

-- | a value of the type `t` as the tools show it (`In.showResult`):
-- | given its type arguments first (as nothing: they are erased), as the
-- | compiled code has it -- `[]` of `{a : Type} -> List a`, not `#fun`
shownAt : Value.Ty -> Interp.EvalResult -> Interp.EvalResult
shownAt t r = Interp.applyErased (typeArgsOf 0 (Value.behavior t)) r

-- | a watch's value, in the globals evaluated (`In.globalEnv`, once for
-- | all the watches of a file)
evalWatch : Interp.GlobalEnv -> Globals.Entry -> String
evalWatch ge entry =
  Interp.showResult (shownAt entry.type_ (Interp.evalEntryIn ge entry))

knownG : Globals.Globals -> String -> Bool
knownG g x = case Globals.lookupName g x of
  Just _ -> True
  Nothing -> False

readExpTop : Interp.GlobalEnv -> TopLevel.TopResult -> Maybe String
readExpTop ge t =
  if not (List.null t.diags) then Nothing
  else case List.head t.watches of
    Just w -> Just (evalWatch ge w.entry)
    Nothing -> Nothing

readExpRead : Interp.GlobalEnv
            -> Globals.Globals
            -> Surface.Read
            -> Maybe String
readExpRead ge g r =
  if not (List.null r.diags) then Nothing
  else readExpTop ge (TopLevel.topWith g r.decls)

-- | the value of an expectation, read as `(e : T)` (one of more than
-- | one line, its lines after the first indented: one expression), in
-- | the globals `g`, evaluated as `ge`
readExpectation : Interp.GlobalEnv
                -> Globals.Globals
                -> String
                -> String
                -> Maybe String
readExpectation ge g ty e =
  readExpRead
    ge
    g
    (Surface.readProgram
       (\x -> knownG g x)
       ("-- >>> (" ^ joinWith "\n  " (split "\n" e) ^ " : " ^ ty ^ ")\n"))

-- an expectation is Hippogriff: it holds when it evaluates to the same,
-- however it is written; what cannot be read (`#fun`) is compared as
-- text.  A watch whose evaluation met a bug of the compiler holds
-- nothing, with an expectation or without
holdsOf : Interp.GlobalEnv
        -> Globals.Globals
        -> String
        -> Interp.EvalResult
        -> String
        -> Maybe String
        -> Bool
holdsOf ge g ty (RBug _) value e = False
holdsOf ge g ty r value Nothing = True
holdsOf ge g ty r value (Just e) =
  strEq e value
  || (case readExpectation ge g ty e of
      Just v -> strEq v value
      Nothing -> False)

dropWatchMark : String -> String
dropWatchMark s =
  if startsWith "-- >>>" s then strSlice s 6 (strLength s)
  else if startsWith "-- | >>>" s then strSlice s 8 (strLength s)
  else ""

mkWatchInfo : Checked
            -> Interp.GlobalEnv
            -> TopLevel.Watch
            -> Interp.EvalResult
            -> Expectation
            -> String
            -> WatchInfo
mkWatchInfo c ge w r ex ty =
  { from = w.span.start
  , to = w.span.end
  , expr =
      trim (dropWatchMark (trim (strSlice c.source w.span.start w.span.end)))
  , ty = ty
  , value = Interp.showResult r
  , expected = ex.expected
  , holds = holdsOf ge c.top.globals ty r (Interp.showResult r) ex.expected
  , expectFrom = ex.from
  , expectTo = ex.to
  , doc = isDocTest c.source w.span.start
  }

watchInfo : Checked -> Interp.GlobalEnv -> TopLevel.Watch -> WatchInfo
watchInfo c ge w =
  mkWatchInfo
    c
    ge
    w
    (shownAt w.entry.type_ (Interp.evalEntryIn ge w.entry))
    (expectation c.source w.span)
    (showTySx c.top.globals (Readback.readbTy 0 w.entry.type_))

watchesIn : Checked -> Interp.GlobalEnv -> List TopLevel.Watch -> List WatchInfo
watchesIn c ge ws = List.map (\w -> watchInfo c ge w) ws

-- (the globals evaluated once, for all the watches, if there are any)
watchesOf : Checked -> List TopLevel.Watch -> List WatchInfo
watchesOf c Nil = Nil
watchesOf c ws = watchesIn c (Interp.globalEnv c.top.globals) ws

watches : Checked -> List WatchInfo
watches c = watchesOf c c.top.watches

-- | a file's tests: the watches with an expectation, each under the
-- | name of the `test` before it (if any), a doc test under the name of
-- | its definition; `line`, where it is (from 1)
type TestReport = { owner : Maybe String, line : Int, watch : WatchInfo }

declStarts : Checked -> List Int
declStarts c =
  List.map (\(p : Pair String Params.Span) -> (snd p).start) c.top.spans

testOwner : Checked -> Int -> Maybe String
testOwner c from = case List.last
    (List.filter
       (\(m : TopLevel.TestDecl) ->
          m.span.start < from
          && not (List.any (\p -> m.span.start < p && p < from) (declStarts c)))
       c.top.tests) of
  Just m -> Just m.name
  Nothing -> Nothing

-- (the definition under a doc test: the first after it)
defUnder : Int
         -> Maybe (Pair String Params.Span)
         -> Pair String Params.Span
         -> Maybe (Pair String Params.Span)
defUnder to (Just a) b =
  if (snd b).start >= to && (snd b).start < (snd a).start then Just b
  else Just a
defUnder to Nothing b = if (snd b).start >= to then Just b else Nothing

docOwner : Checked -> WatchInfo -> Maybe String
docOwner c w = case List.foldl (defUnder w.to) Nothing c.top.spans of
  Just p -> Just (SurfacePrint.named (fst p))
  Nothing -> Nothing

ownerOf : Checked -> WatchInfo -> Maybe String
ownerOf c w = if w.doc then docOwner c w else testOwner c w.from

-- (a watch without an expectation is no test, but where its evaluation
-- met a bug of the compiler: that fails)
testReportOf : Checked -> WatchInfo -> Maybe TestReport
testReportOf c { expected = Nothing, holds = True } = Nothing
testReportOf c w =
  Just
    { owner = ownerOf c w
    , line = (Render.lineCol c.source w.from).line + 1
    , watch = w
    }

testFile : Checked -> List TestReport
testFile c = catMaybesD (List.map (\w -> testReportOf c w) (watches c))

-- | a file's own definitions, evaluated (by value), as a watch shows
-- | them; `bug`, whether its evaluation met a bug of the compiler
type Evaluated = { name : String, value : String, bug : Bool }

-- (a global's value as the tools show it, given its type arguments)
shownGlobal : Globals.Globals
            -> String
            -> Interp.EvalResult
            -> Interp.EvalResult
shownGlobal g k r = case Globals.lookupEntry g k of
  Just e -> shownAt e.type_ r
  Nothing -> r

evalPick : Globals.Globals
         -> List (Pair String Interp.EvalResult)
         -> List Own
         -> List Evaluated
evalPick g results Nil = Nil
evalPick g results (Cons o rest) = case List.lookupBy strEq o.key results of
  Just r -> case shownGlobal g o.key r of
    shown ->
      Cons
        { name = SurfacePrint.named o.name
        , value = Interp.showResult shown
        , bug = case shown of
            RBug _ -> True
            _ -> False
        }
        (evalPick g results rest)
  Nothing -> evalPick g results rest

evaluate : Checked -> List Evaluated
evaluate c =
  evalPick
    c.top.globals
    (Interp.evalGlobalsWhere
       (\k -> elemStr k (List.map (\(o : Own) -> o.key) c.own))
       c.top.globals)
    c.own

promoteAt : String -> Int -> Int -> List String -> String
promoteAt s from to lines =
  strSlice s 0 from
  -- the watch may be the last line, with no newline after it
  ^ (if not (strEq (strSlice s 0 from) "")
     && not (strEq (strSlice s (from - 1) from) "\n")
       then "\n"
     else "")
  ^ joinWith "" (List.map (\l -> l ^ "\n") lines)
  ^ strSlice s to (strLength s)

-- (a line of an expectation, as a watch's or a doc test's)
expectMark : WatchInfo -> String
expectMark w = if w.doc then "-- | " else "-- "

promoteOne : WatchInfo -> String -> String
promoteOne w s =
  promoteAt
    s
    w.expectFrom
    w.expectTo
    (List.map (\l -> expectMark w ^ l) (split "\n" w.value))

-- | the source, each watch's value written under it as its expectation
-- | (a doc test's in its doc comment), last first: each where the text
-- | before it is as it was
promote : Checked -> String
promote c =
  List.foldl
    (\s w -> promoteOne w s)
    c.source
    (List.sortBy
       (\(a : WatchInfo) (b : WatchInfo) -> a.from >= b.from)
       (watches c))

-- Tests (lib/check.hf)
--------------------------------------------------------------------------------

-- | what came of a test, as lib/check.hf's `Outcome` says it (read back
-- | from the interpreter's value)
data TestFailure = FailBecause String | FailDiffer String String

type TestOutcome =
  { name : String
  , ok : Bool
  , property : Bool
  , runs : Int
  , discarded : Int
  , shrinks : Int
  , labels : List (Pair String Int)
  , notes : List String
  , failure : Maybe TestFailure
  , seed : Int
  }

-- (a type that is lib/check.hf's `Test`: a test is found by its type)
isTestEl : Syntax.Tm -> Bool
isTestEl (SGlobal k) = strEq k "check.Test"
isTestEl _ = False

isTestTy : Syntax.Ty -> Bool
isTestTy (SDecode t) = isTestEl t
isTestTy _ = False

isTestOwn : Checked -> Own -> Bool
isTestOwn c o = case Globals.lookupEntry c.top.globals o.key of
  Just e -> isTestTy e.tySyntax
  Nothing -> False

-- | a file's tests: its own definitions of type `Test`, in order
testsOf : Checked -> List Own
testsOf c = List.filter (\o -> isTestOwn c o) c.own

fieldV : Interp.Val -> String -> Interp.Val
fieldV (VCons fs) x = case Dict.lookup fs x of
  Just v -> v
  Nothing -> VErased
fieldV _ x = VErased

strOfV : Interp.Val -> String
strOfV (VStr s) = s
strOfV _ = ""

intOfV : Interp.Val -> Int
intOfV (VInt i) = i
intOfV _ = 0

tagOfV : Interp.Val -> String
tagOfV (VTag x _) = x
tagOfV _ = ""

argsOfV : Interp.Val -> List Interp.Val
argsOfV (VTag _ vs) = vs
argsOfV _ = Nil

argV : Interp.Val -> Int -> Interp.Val
argV v i = fromMaybe VErased (List.head (List.drop i (argsOfV v)))

-- (a list, `Cons`es and its `Nil`)
listOfV : Interp.Val -> List Interp.Val
listOfV v =
  if strEq (tagOfV v) "Cons" then Cons (argV v 0) (listOfV (argV v 1)) else Nil

labelOfV : Interp.Val -> Pair String Int
labelOfV v = MkPair (strOfV (argV v 0)) (intOfV (argV v 1))

failureOfV : Interp.Val -> Maybe TestFailure
failureOfV v =
  if strEq (tagOfV v) "Just"
    then (if strEq (tagOfV (argV v 0)) "Differ"
            then Just
                (FailDiffer
                   (strOfV (argV (argV v 0) 0))
                   (strOfV (argV (argV v 0) 1)))
          else Just (FailBecause (strOfV (argV (argV v 0) 0))))
  else Nothing

outcomeOfV : Interp.Val -> TestOutcome
outcomeOfV v =
  { name = strOfV (fieldV v "name")
  , ok = strEq (tagOfV (fieldV v "ok")) "True"
  , property = strEq (tagOfV (fieldV v "property")) "True"
  , runs = intOfV (fieldV v "runs")
  , discarded = intOfV (fieldV v "discarded")
  , shrinks = intOfV (fieldV v "shrinks")
  , labels = List.map labelOfV (listOfV (fieldV v "labels"))
  , notes = List.map strOfV (listOfV (fieldV v "notes"))
  , failure = failureOfV (fieldV v "failure")
  , seed = intOfV (fieldV v "seed")
  }

-- (a test that came to no outcome: it abandoned, went too deep, or met a
-- bug of the compiler)
brokenOutcome : String -> Int -> String -> TestOutcome
brokenOutcome name seed why =
  { name = name
  , ok = False
  , property = False
  , runs = 0
  , discarded = 0
  , shrinks = 0
  , labels = Nil
  , notes = Nil
  , failure = Just (FailBecause why)
  , seed = seed
  }

outcomesOf : Own -> Int -> Interp.EvalResult -> List TestOutcome
outcomesOf o seed (RSucceeded v) = List.map outcomeOfV (listOfV v)
outcomesOf o seed r =
  [brokenOutcome (SurfacePrint.named o.name) seed (Interp.showResult r)]

-- (`check.runTest seed t`, as a global of its own)
testEntry : Int -> Own -> Globals.Entry
testEntry seed o =
  { syntax =
      SApp (SApp (SGlobal "check.runTest") (SLitInt seed)) (SGlobal o.key)
  , tySyntax = SPrimInt
  , value = VOpaque
  , type_ = VPrimInt
  }

testName : Int -> String
testName i = "> test " ^ showInt i

addTests : Int -> Int -> List Own -> Globals.Globals -> Globals.Globals
addTests seed i Nil g = g
addTests seed i (Cons o rest) g =
  addTests
    seed
    (i + 1)
    rest
    (Globals.addEntry (testName i) (testEntry seed o) g)

pickOutcomes : Int
             -> List (Pair String Interp.EvalResult)
             -> Int
             -> List Own
             -> List TestOutcome
pickOutcomes seed rs i Nil = Nil
pickOutcomes seed rs i (Cons o rest) =
  List.append
    (case List.lookupBy strEq (testName i) rs of
     Just r -> outcomesOf o seed r
     Nothing -> Nil)
    (pickOutcomes seed rs (i + 1) rest)

-- | each test of the file run from the seed (by the interpreter, as a
-- | watch is evaluated), what came of it
runTests : Int -> Checked -> List TestOutcome
runTests seed c =
  if List.null (testsOf c) then Nil
  else pickOutcomes
      seed
      (Interp.evalGlobalsWhere
         (\k -> startsWith "> test " k)
         (addTests seed 0 (testsOf c) c.top.globals))
      0
      (testsOf c)

-- The interface, and the diagnostics as files report them
--------------------------------------------------------------------------------

isError : Severity -> Bool
isError SError = True
isError _ = False

errorsIn : Checked -> List Diag
errorsIn c = List.filter (\(d : Diag) -> isError d.severity) c.diags

-- (the first of a module's errors, where it is and what it says)
errorAt : Checked -> List Diag -> Maybe String
errorAt c Nil = Nothing
errorAt c (Cons d _) =
  Just (Render.diagWhere c.path c.source d ^ ": " ^ diagLine d)

-- | a module's first error, `path:line:col: error[E…]: what`, if it has
-- | one
firstError : Checked -> Maybe String
firstError c = errorAt c (errorsIn c)

assocKw : Fixity.Assoc -> String
assocKw AssocLeft = "infixl"
assocKw AssocRight = "infixr"
assocKw AssocNone = "infix"

earlierGo : List Fixity.Group -> Int -> String -> Int -> Bool
earlierGo Nil i x j = True
earlierGo (Cons g rest) i x j =
  if strEq g.id x then j < i else earlierGo rest i x (j + 1)

-- `above` and `below` relate a group to groups declared before it, so
-- each relation is written on the group that came later
earlierG : List Fixity.Group -> Int -> String -> Bool
earlierG groups i x = earlierGo groups i x 0

relOf : String -> List String -> String
relOf kw ops = if List.null ops then "" else kw ^ joinWith " " ops

-- (a group below all: `below` alone, last)
belowAll : Bool -> String
belowAll True = " below"
belowAll False = ""

fixityLine : Fixity.Fixities -> Int -> Fixity.Group -> String
fixityLine fx i g =
  assocKw g.assoc
  ^ " "
  ^ joinWith " " g.ops
  ^ relOf
    " above "
    (nubStrD
       (catMaybesD
          (List.map
             (\(e : Fixity.Edge) ->
                if strEq e.tighter g.id && earlierG fx.groups i e.looser
                  then Just e.looser
                else Nothing)
             fx.above)))
  ^ relOf
    " below "
    (nubStrD
       (catMaybesD
          (List.map
             (\(e : Fixity.Edge) ->
                if strEq e.looser g.id && earlierG fx.groups i e.tighter
                  then Just e.tighter
                else Nothing)
             fx.above)))
  ^ belowAll g.loosest
  ^ "\n"

fixityLines : Fixity.Fixities -> Int -> List Fixity.Group -> String
fixityLines fx i Nil = ""
fixityLines fx i (Cons g rest) = fixityLine fx i g ^ fixityLines fx (i + 1) rest

type Glue = { out : String, multi : Bool, first : Bool }

-- a definition of more lines than one keeps blank lines around it
glueOne : Glue -> String -> Glue
glueOne acc d =
  { out =
      acc.out
      ^ (if not acc.first
         && (contains "\n" (strSlice d 0 (strLength d - 1)) || acc.multi)
           then "\n"
         else "")
      ^ d
  , multi = contains "\n" (strSlice d 0 (strLength d - 1))
  , first = False
  }

-- (the type as the signature wrote it -- `Co e Unit`, an alias folded --
-- not the readback of its evaluation, which would unfold every alias)
sigEntry : Checked -> (String -> String) -> Own -> Maybe String
sigEntry c ln o = case Globals.lookupEntry c.top.globals o.key of
  Just e ->
    Just
      (if Globals.isInstance c.top.globals o.key
         then SurfacePrint.printInstanceSig
             SurfacePrint.plainImplicits
             (SurfacePrint.named o.name)
             (Rename.renameTy ln e.tySyntax)
       else SurfacePrint.printSig
           SurfacePrint.plainImplicits
           o.name
           (SurfacePrint.named o.name)
           (Rename.renameTy ln e.tySyntax)
           (Rename.renameEl ln e.syntax))
  Nothing -> Nothing

importLines : Checked -> String
importLines c =
  joinWith "" (List.map (\m -> "import " ^ m ^ "\n") c.opens)
  ^ joinWith
    ""
    (List.map
       (\(a : AliasQ) -> "import " ^ a.module ^ " as " ^ a.alias ^ "\n")
       c.aliases)

-- | a file's interface: its imports and fixity declarations, its types
-- | in full (`data`, `type`, `theory` -- an importer sees through
-- | them), its values as signatures.  What `heff check` prints.
interface : Checked -> String
interface c =
  joinWith
    "\n"
    (List.filter
       (\s -> not (strEq s ""))
       [ importLines c
       , fixityLines c.fixities 0 c.fixities.groups
       , (List.foldl
            glueOne
            { out = "", multi = False, first = True }
            (catMaybesD
               (List.map
                  (\o -> sigEntry c (localNameIn (localNames c.top.globals)) o)
                  c.own))).out
       ])

-- Running
--------------------------------------------------------------------------------

type Runnable = { key : String, effect : Effect.Effect }

type Candidate = { name : String, key : String, effect : Effect.Effect }

runnableOf : Candidate -> Runnable
runnableOf r = { key = r.key, effect = r.effect }

-- | a computation's effect, from the type its key is stored with
effectOfKey : Checked -> String -> Maybe Effect.Effect
effectOfKey c k = case Globals.lookupEntry c.top.globals k of
  Just e -> Effect.computationEffect c.top.globals (Readback.readbTy 0 e.type_)
  Nothing -> Nothing

candOf : Checked -> Own -> Maybe Candidate
candOf c o = case effectOfKey c o.key of
  Just eff -> Just { name = o.name, key = o.key, effect = eff }
  Nothing -> Nothing

candidatesOf : Checked -> List Candidate
candidatesOf c = catMaybesD (List.map (\o -> candOf c o) c.own)

appendLv : List String -> List String -> List String
appendLv Nil ys = ys
appendLv (Cons x xs) ys = Cons x (appendLv xs ys)

candLeaves : List Candidate -> List String
candLeaves Nil = Nil
candLeaves (Cons r rest) = appendLv (Effect.leaves r.effect) (candLeaves rest)

-- | every leaf of every candidate's effect, each once: what the caller
-- | asks providers for, before it picks one to run
candidateLeaves : Checked -> List String
candidateLeaves c = nubStrD (candLeaves (candidatesOf c))

missingOf : List String -> Effect.Effect -> List String
missingOf handled eff =
  nubStrD (List.filter (\l -> not (elemStr l handled)) (Effect.leaves eff))

fitsMissing : List String -> Candidate -> List String -> Either String Runnable
fitsMissing handled r Nil = Right (runnableOf r)
fitsMissing handled r ms =
  Left
    (r.name
     ^ " has the effect "
     ^ joinWith ", " ms
     ^ ", which is not provided here (a module M provides its effect in M.provider.js, or M.provider.c for C, beside M.hf; `$host` says where it runs)")

fits : List String -> Candidate -> Either String Runnable
fits handled r = fitsMissing handled r (missingOf handled r.effect)

findNamed : List String -> Checked -> String -> Own -> Either String Runnable
findNamed handled c x o = case effectOfKey c o.key of
  Nothing -> Left (x ^ " is not a computation, `Co h a`")
  Just eff -> fits handled { name = x, key = o.key, effect = eff }

findFirst : List String -> List Candidate -> Either String Runnable
findFirst handled cands = case List.find
    (\(r : Candidate) -> List.null (missingOf handled r.effect))
    cands of
  Just r -> Right (runnableOf r)
  -- (the first there is, said why it does not do)
  Nothing -> case List.head cands of
    Just r -> fits handled r
    Nothing -> Left "no computation, `Co h a`, to run"

-- | a definition to run where there are handlers for the effects
-- | `handled`: the one named, else the first of a file's that fits
findRunnable : List String -> Checked -> Maybe String -> Either String Runnable
findRunnable handled c (Just x) = case List.find
    (\(o : Own) -> strEq o.name x)
    c.own of
  Nothing -> Left ("no definition " ^ x)
  Just o -> findNamed handled c x o
findRunnable handled c Nothing = findFirst handled (candidatesOf c)

-- The library's halves
--------------------------------------------------------------------------------

-- | a module of the library a backend has no side of, and what is said
-- | where a module imports it: lib/browser/'s in C (E0351), lib/std/'s
-- | effects of the system in JavaScript, and those of lib/std/ that
-- | import one (E0352)
type Refused =
  { module : String, code : Int, msg : String, note : Maybe String }

refusedAt : List Refused -> Import.Import -> Maybe Diag
refusedAt rs i = case List.find (\(r : Refused) -> strEq r.module i.name) rs of
  Just r ->
    Just
      { code = r.code
      , severity = SError
      , msg = r.msg
      , span = i.span
      , note = r.note
      }
  Nothing -> Nothing

writtenImports : Import.Imports -> List Import.Import
writtenImports imps = imps.imports

-- (the imports it writes, not those it has without writing them; the
-- library's own are the library's)
refusedIn : List Refused -> Source -> List Diag
refusedIn rs s =
  if s.library then Nil
  else catMaybesD
      (List.map (\i -> refusedAt rs i) (writtenImports (importsOfSource s)))

-- | a module checked, each import it writes of a module the backend
-- | refuses an error there
withRefused : List Refused -> List Source -> Checked -> Checked
withRefused rs sources c = case List.find
    (\(s : Source) -> strEq s.module c.module)
    sources of
  Just s -> withDiags c (refusedIn rs s)
  Nothing -> c
