-- A project's package.hf: a heff file, read without elaborating it.  It
-- holds one definition, `package`, a record of strings and lists of
-- records (lib/manifest.hf is its type, for the editor and for `heff
-- publish`); its imports and the signature are passed over:
--
--   import manifest
--
--   package : Package
--   package =
--     { module = "github.com/someone/hello"
--     , heff = "0.1.0"
--     , require = [{ name = "json", path = "github.com/x/json", version = "1.2.0" }]
--     , replace = [{ name = "json", dir = "../json" }]
--     }
--
-- Nothing else is read: no definition but `package`, no expression but
-- a literal.  A field that has a default in lib/manifest.hf may be left
-- out, as there (`require` and `replace` are empty lists, a build.hf's
-- `ships` too).  What is read is checked: a version is `a.b.c`, a required
-- package's path ends in `/vN` when its version's major N is 2 or more
-- (and only then), names are not required twice, a replaced name is
-- required.

import array as A
import heff.syntax.fmt.lex as L

-- | a literal of package.hf (or a build.hf), and the token it starts at
data Lit
  = LStr String L.Tok
  | LTag String L.Tok
  | LList (List Lit) L.Tok
  | LRec (List (Pair String Lit)) L.Tok

litTok : Lit -> L.Tok
litTok (LStr _ t) = t
litTok (LTag _ t) = t
litTok (LList _ t) = t
litTok (LRec _ t) = t

-- | what is wrong, and where (an offset into the text)
type Problem = { at : Int, msg : String }

problemAt : L.Tok -> String -> Problem
problemAt t msg = { at = t.start, msg = msg }

-- (a literal read, and the token after it; or what is wrong)
type Got a = Either Problem (Pair a Int)

-- | what reads a literal, and the lists and records that hold literals,
-- | call one another through this record
type LitReader = { lit : Array L.Tok -> Int -> Got Lit }

isPunct : String -> L.Tok -> Bool
isPunct x t = strEq t.kind "punct" && strEq t.text x

-- (a list's items from `i`, those so far in `acc`, last first)
itemsGo : LitReader -> Array L.Tok -> Int -> List Lit -> Got (List Lit)
itemsGo r ts i acc = case r.lit ts i of
  Left p -> Left p
  Right (MkPair x j) ->
    if isPunct "," (A.index ts j) then itemsGo r ts (j + 1) (Cons x acc)
    else if isPunct "]" (A.index ts j)
      then Right (MkPair (List.reverse (Cons x acc)) (j + 1))
    else Left
        (problemAt
           (A.index ts j)
           "expected `,` or `]`: an item is a literal, nothing is computed")

-- (a record's fields from `i`)
fieldsGo : LitReader
         -> Array L.Tok
         -> Int
         -> List (Pair String Lit)
         -> Got (List (Pair String Lit))
fieldsGo r ts i acc =
  if not (strEq (A.index ts i).kind "var")
    then Left (problemAt (A.index ts i) "expected a field's name")
  else if not
    (strEq (A.index ts (i + 1)).kind "sym"
     && strEq (A.index ts (i + 1)).text "=")
    then Left (problemAt (A.index ts (i + 1)) "expected `=`")
  else case r.lit ts (i + 2) of
    Left p -> Left p
    Right (MkPair x j) ->
      if isPunct "," (A.index ts j)
        then fieldsGo r ts (j + 1) (Cons (MkPair (A.index ts i).text x) acc)
      else if isPunct "}" (A.index ts j)
        then Right
            (MkPair
               (List.reverse (Cons (MkPair (A.index ts i).text x) acc))
               (j + 1))
      else Left
          (problemAt
             (A.index ts j)
             "expected `,` or `}`: a field is a literal, nothing is computed")

listAt : L.Tok -> Got (List Lit) -> Got Lit
listAt t (Left p) = Left p
listAt t (Right (MkPair xs j)) = Right (MkPair (LList xs t) j)

recordAt : L.Tok -> Got (List (Pair String Lit)) -> Got Lit
recordAt t (Left p) = Left p
recordAt t (Right (MkPair fs j)) = Right (MkPair (LRec fs t) j)

litF : LitReader -> Array L.Tok -> Int -> Got Lit
litF r ts i =
  if strEq (A.index ts i).kind "str"
    then Right (MkPair (LStr (A.index ts i).text (A.index ts i)) (i + 1))
  else if strEq (A.index ts i).kind "con"
    then Right (MkPair (LTag (A.index ts i).text (A.index ts i)) (i + 1))
  else if isPunct "[" (A.index ts i)
    then (if isPunct "]" (A.index ts (i + 1))
            then Right (MkPair (LList Nil (A.index ts i)) (i + 2))
          else listAt (A.index ts i) (itemsGo r ts (i + 1) Nil))
  else if isPunct "{" (A.index ts i)
    then recordAt (A.index ts i) (fieldsGo r ts (i + 1) Nil)
  else Left
      (problemAt
         (A.index ts i)
         "a manifest holds strings, tags `X`, lists `[...]` and records `{...}`, nothing else")

litReader : LitReader
litReader = { lit = \ts i -> litF litReader ts i }

-- The declarations
--------------------------------------------------------------------------------

startsDecl : L.Tok -> Bool
startsDecl t = strEq t.kind "eof" || (t.first && t.col == 0)

-- (the next declaration's first token, from `i` on)
nextDecl : Array L.Tok -> Int -> Int
nextDecl ts i = if startsDecl (A.index ts i) then i else nextDecl ts (i + 1)

isSym : String -> L.Tok -> Bool
isSym x t = strEq t.kind "sym" && strEq t.text x

-- | the literal `name` is defined as in `file` (package.hf, `package`;
-- | a build.hf, `build`), the declarations from `i` on read (`found`: it,
-- | if it has been met)
declsGo : String
        -> String
        -> Array L.Tok
        -> Int
        -> Maybe Lit
        -> Either Problem Lit
declsGo file name ts i found =
  if strEq (A.index ts i).kind "eof"
    then (case found of
          Just x -> Right x
          Nothing ->
            Left
              (problemAt (A.index ts i) (file ^ " defines no `" ^ name ^ "`")))
  else if strEq (A.index ts i).kind "kw" && strEq (A.index ts i).text "import"
    then declsGo file name ts (nextDecl ts (i + 1)) found
  else if strEq (A.index ts i).kind "var"
  && strEq (A.index ts i).text name
  && isSym ":" (A.index ts (i + 1))
    then declsGo file name ts (nextDecl ts (i + 1)) found
  else if strEq (A.index ts i).kind "var"
  && strEq (A.index ts i).text name
  && isSym "=" (A.index ts (i + 1))
    then (case found of
          Just _ ->
            Left
              (problemAt
                 (A.index ts i)
                 ("`" ^ name ^ "` is defined more than once"))
          Nothing -> case litReader.lit ts (i + 2) of
            Left p -> Left p
            Right (MkPair x j) ->
              if startsDecl (A.index ts j) then declsGo file name ts j (Just x)
              else Left
                  (problemAt
                     (A.index ts j)
                     ("`" ^ name ^ "` is a literal, and nothing follows it")))
  else Left
      (problemAt
         (A.index ts i)
         (file
          ^ " holds imports, and `"
          ^ name
          ^ "` (its signature and its definition), nothing else"))

-- What it says
--------------------------------------------------------------------------------

-- | a package required: the name it is imported by, where it is fetched
-- | from, its least version
type Require = { name : String, path : String, version : String }

-- | a required package taken from a directory instead
type Replace = { name : String, dir : String }

-- | what a package.hf says
type Package =
  { module : String
  , heff : String
  , require : List Require
  , replace : List Replace
  }

rangeFrom : Int -> Int -> List Int
rangeFrom i n = if i >= n then Nil else Cons i (rangeFrom (i + 1) n)

headM : List Int -> Maybe Int
headM (Cons x _) = Just x
headM Nil = Nothing

-- (the digits of a version's part: no sign, no leading zero)
isNumber : String -> Bool
isNumber s =
  strLength s > 0
  && List.all
    (\c -> 48 <= c && c <= 57)
    (List.map (\i -> byteAt s i) (rangeFrom 0 (strLength s)))
  && (strLength s == 1 || not (byteAt s 0 == 48))

-- | a version's three numbers, if it is `a.b.c`
version : String -> Maybe (List Int)
version v = case split "." v of
  Cons a (Cons b (Cons c Nil)) ->
    if isNumber a && isNumber b && isNumber c
      then Just (List.map (\x -> fromMaybe 0 (parseInt x)) [a, b, c])
    else Nothing
  _ -> Nothing

-- | a heff of version `running` builds a project written for `wanted`:
-- | the same major, and not older; under 1.0.0, the same minor
-- | >>> compatible [0, 1, 0] [0, 1, 3]
-- | True
-- | >>> compatible [0, 1, 4] [0, 1, 3]
-- | False
-- | >>> compatible [0, 1, 0] [0, 2, 0]
-- | False
-- | >>> compatible [1, 2, 0] [1, 3, 0]
-- | True
compatible : List Int -> List Int -> Bool
compatible (Cons wa (Cons wb (Cons wc Nil))) (Cons ra (Cons rb (Cons rc Nil))) =
  if wa == 0 then ra == 0 && rb == wb && rc >= wc
  else ra == wa && (rb > wb || (rb == wb && rc >= wc))
compatible _ _ = False

-- (a path's last part)
lastPart : String -> String
lastPart p = case List.reverse (split "/" p) of
  Cons x _ -> x
  Nil -> p

-- | `/vN` the path must end in for a version of major `n`, if any
majorSuffix : Int -> Maybe String
majorSuffix n = if n >= 2 then Just ("v" ^ showInt n) else Nothing

isMajorPart : String -> Bool
isMajorPart x =
  strLength x >= 2
  && strEq (strSlice x 0 1) "v"
  && isNumber (strSlice x 1 (strLength x))

-- | a name a package is imported by: a module name's first part
isName : String -> Bool
isName x =
  strLength x > 0
  && (97 <= byteAt x 0 && byteAt x 0 <= 122)
  && List.all
    (\c ->
       (97 <= c && c <= 122)
       || (65 <= c && c <= 90)
       || (48 <= c && c <= 57)
       || c == 95)
    (List.map (\i -> byteAt x i) (rangeFrom 0 (strLength x)))

-- Reading the literal into a Package
--------------------------------------------------------------------------------

type Check a = Either Problem a

-- | a field of a manifest's record, and what it is where it is left out,
-- | if it may be: lib/manifest.hf's default, there at the record
type Field = { name : String, left : Maybe (L.Tok -> Lit) }

required : String -> Field
required x = { name = x, left = Nothing }

-- (a field that is an empty list where it is left out)
orNone : String -> Field
orNone x = { name = x, left = Just (\t -> LList Nil t) }

-- (`a`, `a and b`, `a, b and c`)
andList : List String -> String
andList Nil = ""
andList (Cons x Nil) = x
andList (Cons x (Cons y Nil)) = x ^ " and " ^ y
andList (Cons x rest) = x ^ ", " ^ andList rest

leftOutNames : List Field -> List String
leftOutNames Nil = Nil
leftOutNames (Cons f@{ left = Just _ } rest) = Cons f.name (leftOutNames rest)
leftOutNames (Cons { left = Nothing } rest) = leftOutNames rest

-- | the fields a record of the type has, in order, and which of them it
-- | may leave out (as the elaborator says it, `heff check`)
fieldsSaid : List Field -> String
fieldsSaid fields =
  "the fields are "
  ^ joinWith ", " (List.map (\(f : Field) -> f.name) fields)
  ^ ", in this order"
  ^ (if List.null (leftOutNames fields) then ""
     else " (" ^ andList (leftOutNames fields) ^ " may be left out)")

-- (the next field written, if it is `x`: its literal, and the fields
-- written after it)
taken : String
      -> List (Pair String Lit)
      -> Maybe (Pair Lit (List (Pair String Lit)))
taken x (Cons (MkPair y v) more) =
  if strEq x y then Just (MkPair v more) else Nothing
taken x Nil = Nothing

-- (what field `f` is where it is left out, if it may be; at `t`)
leftOut : L.Tok -> Field -> Maybe Lit
leftOut t { left = Just mk } = Just (mk t)
leftOut t { left = Nothing } = Nothing

consLit : Lit -> Maybe (List Lit) -> Maybe (List Lit)
consLit v (Just vs) = Just (Cons v vs)
consLit v Nothing = Nothing

-- (each field: the next written, if it is that one, else what it is left
-- out; at the record's token `t`)
fieldsIn : L.Tok -> List Field -> List (Pair String Lit) -> Maybe (List Lit)
fieldsIn t Nil Nil = Just Nil
fieldsIn t Nil (Cons _ _) = Nothing
fieldsIn t (Cons f rest) written = case taken f.name written of
  Just (MkPair v more) -> consLit v (fieldsIn t rest more)
  Nothing -> case leftOut t f of
    Just v -> consLit v (fieldsIn t rest written)
    Nothing -> Nothing

-- (a record with these fields, in this order, as the type has them, those
-- with a default perhaps left out)
fieldsAre : List Field -> Lit -> Check (List Lit)
fieldsAre fields (LRec fs t) = case fieldsIn t fields fs of
  Just xs -> Right xs
  Nothing -> Left (problemAt t (fieldsSaid fields))
fieldsAre fields x = Left (problemAt (litTok x) "expected a record `{...}`")

str : Lit -> Check String
str (LStr s _) = Right s
str x = Left (problemAt (litTok x) "expected a string")

items : Lit -> Check (List Lit)
items (LList xs _) = Right xs
items x = Left (problemAt (litTok x) "expected a list `[...]`")

versionOf : Lit -> Check String
versionOf x = case str x of
  Left p -> Left p
  Right v -> case version v of
    Just _ -> Right v
    Nothing ->
      Left
        (problemAt
           (litTok x)
           ("`" ^ v ^ "` is no version: write `a.b.c`, three numbers"))

nameOf : Lit -> Check String
nameOf x = case str x of
  Left p -> Left p
  Right n ->
    if isName n then Right n
    else Left
        (problemAt
           (litTok x)
           ("`"
            ^ n
            ^ "` cannot be imported by: a name is a lowercase letter, then letters, digits and `_`"))

-- | what is wrong with fetching version `v` from `path`, if anything: its
-- | `/vN` and the version's major disagree
majorMismatch : String -> String -> Maybe String
majorMismatch path v = case majorSuffix
    (fromMaybe 0 (headM (fromMaybe Nil (version v)))) of
  Just suffix ->
    if strEq (lastPart path) suffix then Nothing
    else Just ("version " ^ v ^ " is fetched from a path ending in /" ^ suffix)
  Nothing ->
    if isMajorPart (lastPart path)
      then Just
          ("version " ^ v ^ " is fetched from a path without a /vN ending")
    else Nothing

-- (the path's `/vN` agrees with the version's major)
pathFor : Lit -> String -> Check String
pathFor x v = case str x of
  Left p -> Left p
  Right path -> case majorMismatch path v of
    Just why -> Left (problemAt (litTok x) why)
    Nothing -> Right path

requireOf : Lit -> Check Require
requireOf x = case fieldsAre
    [required "name", required "path", required "version"]
    x of
  Left p -> Left p
  Right (Cons n (Cons p (Cons v Nil))) -> case nameOf n of
    Left e -> Left e
    Right name -> case versionOf v of
      Left e -> Left e
      Right ver -> case pathFor p ver of
        Left e -> Left e
        Right path -> Right { name = name, path = path, version = ver }
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

replaceOf : Lit -> Check Replace
replaceOf x = case fieldsAre [required "name", required "dir"] x of
  Left p -> Left p
  Right (Cons n (Cons d Nil)) -> case nameOf n of
    Left e -> Left e
    Right name -> case str d of
      Left e -> Left e
      Right dir -> Right { name = name, dir = dir }
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

consCheck : {a : Type} -> Check a -> Check (List a) -> Check (List a)
consCheck (Left p) _ = Left p
consCheck (Right y) (Left p) = Left p
consCheck (Right y) (Right ys) = Right (Cons y ys)

allOf : {a : Type} -> (Lit -> Check a) -> List Lit -> Check (List a)
allOf f Nil = Right Nil
allOf f (Cons x rest) = consCheck (f x) (allOf f rest)

-- (the first name required twice, and where)
twiceGo : List String -> List (Pair String Lit) -> Maybe (Pair String Lit)
twiceGo seen Nil = Nothing
twiceGo seen (Cons (MkPair n x) rest) =
  if List.elemBy strEq n seen then Just (MkPair n x)
  else twiceGo (Cons n seen) rest

requiredNames : List Lit -> List Require -> List (Pair String Lit)
requiredNames xs rs = List.zipWith (\x (r : Require) -> MkPair r.name x) xs rs

replacedNames : List Lit -> List Replace -> List (Pair String Lit)
replacedNames xs rs = List.zipWith (\x (r : Replace) -> MkPair r.name x) xs rs

-- (a replaced name that is not required)
unrequired : List String -> List (Pair String Lit) -> Maybe (Pair String Lit)
unrequired names Nil = Nothing
unrequired names (Cons (MkPair n x) rest) =
  if List.elemBy strEq n names then unrequired names rest else Just (MkPair n x)

-- heff's own package
--------------------------------------------------------------------------------
-- The package `heff` is heff's: its library and its source.  The
-- compiler keeps the name: no package requires it or replaces it (it
-- comes with heff), and a project names itself so only where heff is
-- built or installed from (src/heff/build/load.hf says where that is).

-- | the package heff is
heffModule : String
heffModule = "heff"

-- (a problem with heff's own package: E0347)
reserved : String -> String
reserved msg = "error[E0347]: " ^ msg

-- | what is said of a project naming itself heff's own package where
-- | heff is not built or installed from
claimMsg : String
claimMsg =
  reserved
    "the package `heff` is heff's own, and this is not the checkout heff is built in or was installed from: name the project otherwise"

-- | what is said of requiring heff's own package
requireMsg : String
requireMsg =
  reserved
    "the package `heff` is heff's own, which comes with heff: it is not required"

replaceMsg : String -> String
replaceMsg n =
  reserved
    ("`"
     ^ n
     ^ "` is the package `heff`, heff's own, which comes with heff: it is not replaced")

-- (the first of `named` whose name is one of `names`)
firstNamed : List String -> List (Pair String Lit) -> Maybe (Pair String Lit)
firstNamed names Nil = Nothing
firstNamed names (Cons (MkPair n x) rest) =
  if List.elemBy strEq n names then Just (MkPair n x) else firstNamed names rest

requiredPaths : List Lit -> List Require -> List (Pair String Lit)
requiredPaths xs rs = List.zipWith (\x (r : Require) -> MkPair r.path x) xs rs

-- (the names heff's own package is required by)
heffNames : List Require -> List String
heffNames rs =
  List.map
    (\(r : Require) -> r.name)
    (List.filter (\(r : Require) -> strEq r.path heffModule) rs)

-- (heff's own package is neither replaced nor required)
checkHeff : List Lit -> List Require -> List Lit -> List Replace -> Check Unit
checkHeff rxs rs pxs ps = case firstNamed
    (heffNames rs)
    (replacedNames pxs ps) of
  Just (MkPair n x) -> Left (problemAt (litTok x) (replaceMsg n))
  Nothing -> case firstNamed [heffModule] (requiredPaths rxs rs) of
    Just (MkPair _ x) -> Left (problemAt (litTok x) requireMsg)
    Nothing -> Right MkUnit

checkNames : List Lit -> List Require -> List Lit -> List Replace -> Check Unit
checkNames rxs rs pxs ps = case twiceGo Nil (requiredNames rxs rs) of
  Just (MkPair n x) ->
    Left (problemAt (litTok x) ("`" ^ n ^ "` is required twice"))
  Nothing -> case twiceGo Nil (replacedNames pxs ps) of
    Just (MkPair n x) ->
      Left (problemAt (litTok x) ("`" ^ n ^ "` is replaced twice"))
    Nothing -> case unrequired
        (List.map (\(r : Require) -> r.name) rs)
        (replacedNames pxs ps) of
      Just (MkPair n x) ->
        Left
          (problemAt (litTok x) ("`" ^ n ^ "` is replaced, but not required"))
      Nothing -> checkHeff rxs rs pxs ps

packageOf4 : Lit -> Lit -> Lit -> Lit -> Check Package
packageOf4 m h rq rp = case str m of
  Left p -> Left p
  Right mpath -> case versionOf h of
    Left p -> Left p
    Right hv -> case items rq of
      Left p -> Left p
      Right rxs -> case allOf requireOf rxs of
        Left p -> Left p
        Right rs -> case items rp of
          Left p -> Left p
          Right pxs -> case allOf replaceOf pxs of
            Left p -> Left p
            Right ps -> case checkNames rxs rs pxs ps of
              Left p -> Left p
              Right _ ->
                Right { module = mpath, heff = hv, require = rs, replace = ps }

-- (a package.hf's fields)
packageFields : List Field
packageFields =
  [required "module", required "heff", orNone "require", orNone "replace"]

packageOf : Lit -> Check Package
packageOf x = case fieldsAre packageFields x of
  Left p -> Left p
  Right (Cons m (Cons h (Cons rq (Cons rp Nil)))) -> packageOf4 m h rq rp
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

lexedTokens : L.Lexed -> List L.Tok
lexedTokens l = l.tokens

lexedErrors : L.Lexed -> List L.Err
lexedErrors l = l.errors

-- (a package.hf's text, its `package` literal read)
packageLit : String -> Check Lit
packageLit src = case lexedErrors (L.lex src) of
  Cons e _ -> Left { at = e.start, msg = e.msg }
  Nil ->
    declsGo
      "package.hf"
      "package"
      (A.fromList (lexedTokens (L.lex src)))
      0
      Nothing

packageFrom : Check Lit -> Check Package
packageFrom (Left p) = Left p
packageFrom (Right x) = packageOf x

-- | a package.hf's text, read
readPackage : String -> Check Package
readPackage src = packageFrom (packageLit src)

claimAt : Check (List Lit) -> Problem
claimAt (Right (Cons m _)) = problemAt (litTok m) claimMsg
claimAt _ = { at = 0, msg = claimMsg }

claimOf : Check Lit -> Problem
claimOf (Right x) = claimAt (fieldsAre packageFields x)
claimOf (Left _) = { at = 0, msg = claimMsg }

-- | what is said of the package.hf `src`, naming itself heff's own
-- | package where heff is not built or installed from: at its `module`
-- | >>> (claimed "package = { module = \"heff\", heff = \"0.1.0\" }").at
-- | 21
claimed : String -> Problem
claimed src = claimOf (packageLit src)

-- A program's build.hf
--------------------------------------------------------------------------------

-- | what a build.hf says: app/X/main.hf is the program X, its computation
-- | `run` compiled by `backend` (`C`, `Node`, `Page`: "c", "node",
-- | "page"); `ships`, the files and directories of the project's root
-- | that `heff install` puts in the heff home with it, beside bin/
type Build = { backend : String, run : String, ships : List String }

backendOf : Lit -> Check String
backendOf (LTag "C" t) = Right "c"
backendOf (LTag "Node" t) = Right "node"
backendOf (LTag "Page" t) = Right "page"
backendOf (LTag b t) =
  Left (problemAt t ("no backend " ^ b ^ ": C, Node or Page"))
backendOf x = Left (problemAt (litTok x) "expected a backend: C, Node or Page")

-- | what is wrong with a program shipping `n`, if anything: it is the
-- | name of a file or a directory of the project's root (and, so, of the
-- | heff home, where bin/ is the programs')
shipWrong : String -> Maybe String
shipWrong "bin" =
  Just
    "a program ships no `bin`: the heff home's bin/ is where the programs are"
shipWrong n =
  if strEq n ""
  || strEq n "."
  || strEq n ".."
  || contains "/" n
  || contains "\\" n
    then Just
        ("`"
         ^ n
         ^ "` is not a name: a program ships files and directories of the project's root, by their names")
  else Nothing

shippedOf : Lit -> Check String
shippedOf x = case str x of
  Left p -> Left p
  Right n -> case shipWrong n of
    Just why -> Left (problemAt (litTok x) why)
    Nothing -> Right n

shipsOf : Lit -> Check (List String)
shipsOf x = case items x of
  Left p -> Left p
  Right xs -> allOf shippedOf xs

buildOf3 : Lit -> Lit -> Lit -> Check Build
buildOf3 b r s = case backendOf b of
  Left p -> Left p
  Right backend -> case str r of
    Left p -> Left p
    Right run -> case shipsOf s of
      Left p -> Left p
      Right ships -> Right { backend = backend, run = run, ships = ships }

buildOf : Lit -> Check Build
buildOf x = case fieldsAre
    [required "backend", required "run", orNone "ships"]
    x of
  Left p -> Left p
  Right (Cons b (Cons r (Cons s Nil))) -> buildOf3 b r s
  Right _ -> Left (problemAt (litTok x) "expected a record `{...}`")

-- | a build.hf's text, read
readBuild : String -> Check Build
readBuild src = case lexedErrors (L.lex src) of
  Cons e _ -> Left { at = e.start, msg = e.msg }
  Nil -> case declsGo
      "build.hf"
      "build"
      (A.fromList (lexedTokens (L.lex src)))
      0
      Nothing of
    Left p -> Left p
    Right x -> buildOf x

-- (what is wrong, said; or the backend, the computation run and what is
-- shipped)
-- | >>> saidBuild (readBuild "import manifest\n\nbuild : Build\nbuild = { backend = C, run = \"main\", ships = [] }\n")
-- | "c main"
-- | >>> saidBuild (readBuild "build = { backend = C, run = \"main\", ships = [\"lib\", \"package.hf\"] }")
-- | "c main lib package.hf"
-- | >>> saidBuild (readBuild "build = { backend = Page, run = \"main\", ships = [] }")
-- | "page main"
-- | >>> saidBuild (readBuild "build = { backend = Wasm, run = \"main\", ships = [] }")
-- | "20: no backend Wasm: C, Node or Page"
-- | >>> saidBuild (readBuild "build = { backend = \"c\", run = \"main\", ships = [] }")
-- | "20: expected a backend: C, Node or Page"
-- | >>> saidBuild (readBuild "build = { run = \"main\", backend = C, ships = [] }")
-- | "8: the fields are backend, run, ships, in this order (ships may be left out)"
-- | >>> saidBuild (readBuild "build = { backend = C, run = \"main\" }")
-- | "c main"
-- | >>> saidBuild (readBuild "build = { backend = C }")
-- | "8: the fields are backend, run, ships, in this order (ships may be left out)"
-- | >>> saidBuild (readBuild "build = { backend = C, ships = [\"lib\"], run = \"main\" }")
-- | "8: the fields are backend, run, ships, in this order (ships may be left out)"
-- | >>> saidBuild (readBuild "build = { backend = C, run = \"main\", ships = [\"lib/std\"] }")
-- | "46: `lib/std` is not a name: a program ships files and directories of the project's root, by their names"
-- | >>> saidBuild (readBuild "build = { backend = C, run = \"main\", ships = [\"bin\"] }")
-- | "46: a program ships no `bin`: the heff home's bin/ is where the programs are"
saidBuild : Check Build -> String
saidBuild (Left p) = showInt p.at ^ ": " ^ p.msg
saidBuild (Right a) =
  a.backend ^ " " ^ a.run ^ joinWith "" (List.map (\n -> " " ^ n) a.ships)

-- (what is wrong, said; or the module path)
-- | >>> said (readPackage "import manifest\n\npackage : Package\npackage =\n  { module = \"m\"\n  , heff = \"0.1.0\"\n  , require = [{ name = \"json\", path = \"x.org/json\", version = \"1.2.0\" }]\n  , replace = []\n  }\n")
-- | "m 0.1.0 json@1.2.0"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1\", require = [], replace = [] }")
-- | "33: `0.1` is no version: write `a.b.c`, three numbers"
-- | >>> said (readPackage "package = { heff = \"0.1.0\", module = \"m\", require = [], replace = [] }")
-- | "10: the fields are module, heff, require, replace, in this order (require and replace may be left out)"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\" }")
-- | "m 0.1.0 "
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", replace = [] }")
-- | "m 0.1.0 "
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", replace = [], require = [] }")
-- | "10: the fields are module, heff, require, replace, in this order (require and replace may be left out)"
-- | >>> said (readPackage "package = { module = \"m\", require = [] }")
-- | "10: the fields are module, heff, require, replace, in this order (require and replace may be left out)"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"j\", path = \"x.org/j\", version = \"2.0.0\" }], replace = [] }")
-- | "74: version 2.0.0 is fetched from a path ending in /v2"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"j\", path = \"x.org/j/v2\", version = \"2.0.0\" }, { name = \"j\", path = \"y.org/j\", version = \"1.0.0\" }], replace = [] }")
-- | "109: `j` is required twice"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [], replace = [{ name = \"j\", dir = \"../j\" }] }")
-- | "67: `j` is replaced, but not required"
-- | >>> said (readPackage "package = { module = \"m\" ^ \"n\", heff = \"0.1.0\", require = [], replace = [] }")
-- | "25: expected `,` or `}`: a field is a literal, nothing is computed"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"h\", path = \"heff\", version = \"0.3.0\" }] }")
-- | "53: error[E0347]: the package `heff` is heff's own, which comes with heff: it is not required"
-- | >>> said (readPackage "package = { module = \"m\", heff = \"0.1.0\", require = [{ name = \"h\", path = \"heff\", version = \"0.3.0\" }], replace = [{ name = \"h\", dir = \"../h\" }] }")
-- | "115: error[E0347]: `h` is the package `heff`, heff's own, which comes with heff: it is not replaced"
-- | >>> said (readPackage "helper = 1\npackage = { module = \"m\", heff = \"0.1.0\", require = [], replace = [] }")
-- | "0: package.hf holds imports, and `package` (its signature and its definition), nothing else"
said : Check Package -> String
said (Left p) = showInt p.at ^ ": " ^ p.msg
said (Right pk) =
  pk.module
  ^ " "
  ^ pk.heff
  ^ " "
  ^ joinWith
    ","
    (List.map (\(r : Require) -> r.name ^ "@" ^ r.version) pk.require)

-- Versions, and where they are fetched from
--------------------------------------------------------------------------------

newerGo : List Int -> List Int -> Bool
newerGo (Cons x xs) (Cons y ys) = x > y || (x == y && newerGo xs ys)
newerGo _ _ = False

-- | version `a` is newer than `b`
-- | >>> newer "1.10.0" "1.9.3"
-- | True
-- | >>> newer "1.2.0" "1.2.0"
-- | False
newer : String -> String -> Bool
newer a b = newerGo (fromMaybe Nil (version a)) (fromMaybe Nil (version b))

-- | the repository a package is fetched from: its path, without a `/vN`
-- | (each major is a tag of the one repository)
-- | >>> repoOf "github.com/x/json/v2"
-- | "github.com/x/json"
repoOf : String -> String
repoOf path =
  if isMajorPart (lastPart path)
    then strSlice path 0 (strLength path - strLength (lastPart path) - 1)
  else path

-- heff.sum
--------------------------------------------------------------------------------
-- A line for each version of a package the project reaches, fetched (not
-- replaced): its path, its version, and the git tree its tag is of --
--
--   github.com/x/json 1.2.0 tree:4b825dc642cb6eb9a060e54bf8d69288fbee4904
--
-- A tag moved to another tree since is an error.

type Sum = { path : String, version : String, hash : String }

sumLine : Int -> String -> Check (List Sum)
sumLine at line = case words line of
  Nil -> Right Nil
  Cons p (Cons v (Cons h Nil)) -> case version v of
    Just _ -> Right [{ path = p, version = v, hash = h }]
    Nothing ->
      Left { at = at, msg = "`" ^ v ^ "` is no version: write `a.b.c`" }
  _ ->
    Left
      { at = at
      , msg =
          "a line of heff.sum is a path, a version and a tree, and nothing else"
      }

sumGo : Int -> List String -> Check (List Sum)
sumGo at Nil = Right Nil
sumGo at (Cons l rest) = case sumLine at l of
  Left p -> Left p
  Right xs ->
    either
      (\p -> Left p)
      (\ys -> Right (List.append xs ys))
      (sumGo (at + strLength l + 1) rest)

-- | a heff.sum's text, read
-- | >>> readSum "a.org/x 1.0 tree:1\n"
-- | Left { at = 0, msg = "`1.0` is no version: write `a.b.c`" }
readSum : String -> Check (List Sum)
readSum text = sumGo 0 (split "\n" text)

-- | the tree heff.sum says version `v` of `path` is, if it says one
sumOf : List Sum -> String -> String -> Maybe String
sumOf sums path v = case List.filter
    (\(s : Sum) -> strEq s.path path && strEq s.version v)
    sums of
  Cons s _ -> Just s.hash
  Nil -> Nothing

sumBefore : Sum -> Sum -> Bool
sumBefore a b =
  strLt a.path b.path
  || (strEq a.path b.path && not (newer a.version b.version))

-- | heff.sum's text: a line each, by path, then version
-- | >>> showSum (either (\_ -> Nil) id (readSum "b.org/y 1.0.0 tree:2\n\na.org/x 1.10.0 tree:1\na.org/x 1.9.0 tree:0\n"))
-- | "a.org/x 1.9.0 tree:0\na.org/x 1.10.0 tree:1\nb.org/y 1.0.0 tree:2\n"
showSum : List Sum -> String
showSum sums =
  joinWith
    ""
    (List.map
       (\(s : Sum) -> s.path ^ " " ^ s.version ^ " " ^ s.hash ^ "\n")
       (List.sortBy sumBefore sums))

-- Writing package.hf
--------------------------------------------------------------------------------

-- (a string as a literal)
quoted : String -> String
quoted s =
  "\"" ^ joinWith "\\\"" (split "\"" (joinWith "\\\\" (split "\\" s))) ^ "\""

-- (`, x = [a, b]`, a list field; nothing, where it is empty, its default)
listField : String -> List String -> String
listField x Nil = ""
listField x items = ", " ^ x ^ " = [" ^ joinWith ", " items ^ "]"

showRequire : Require -> String
showRequire r =
  "{ name = "
  ^ quoted r.name
  ^ ", path = "
  ^ quoted r.path
  ^ ", version = "
  ^ quoted r.version
  ^ " }"

showReplace : Replace -> String
showReplace r = "{ name = " ^ quoted r.name ^ ", dir = " ^ quoted r.dir ^ " }"

-- | a Package as package.hf's literal (laid out by the formatter after),
-- | an empty list left out
showPackage : Package -> String
showPackage pk =
  "{ module = "
  ^ quoted pk.module
  ^ ", heff = "
  ^ quoted pk.heff
  ^ listField "require" (List.map showRequire pk.require)
  ^ listField "replace" (List.map showReplace pk.replace)
  ^ " }"

-- (where `package`'s literal is, from the declaration at `i` on)
spanGo : Array L.Tok -> Int -> Maybe (Pair Int Int)
spanGo ts i =
  if strEq (A.index ts i).kind "eof" then Nothing
  else if strEq (A.index ts i).kind "var"
  && strEq (A.index ts i).text "package"
  && isSym "=" (A.index ts (i + 1))
    then (case litReader.lit ts (i + 2) of
          Right (MkPair _ j) ->
            Just (MkPair (A.index ts (i + 2)).start (A.index ts (j - 1)).end)
          Left _ -> Nothing)
  else spanGo ts (nextDecl ts (i + 1))

-- | package.hf's text, `package` defined as `pk` instead, the rest as it
-- | was (its comments, its imports)
-- | >>> withPackage "-- mine\npackage =\n  { module = \"m\", heff = \"0.1.0\" } -- end\n" { module = "m", heff = "0.1.0", require = [{ name = "j", path = "x.org/j", version = "1.0.0" }], replace = Nil }
-- | "-- mine\npackage =\n  { module = \"m\", heff = \"0.1.0\", require = [{ name = \"j\", path = \"x.org/j\", version = \"1.0.0\" }] } -- end\n"
withPackage : String -> Package -> String
withPackage src pk = case spanGo (A.fromList (lexedTokens (L.lex src))) 0 of
  Just (MkPair from to) ->
    strSlice src 0 from ^ showPackage pk ^ strSlice src to (strLength src)
  Nothing -> src
