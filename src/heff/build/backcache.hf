-- The backend's cache, the pure side: what a file of it says, and what
-- the C backend is given from it and gives back to it.  For a module
-- `M`, `.heff/<backDir>/M.hb` keeps
--
-- - each of its definitions of the core, simplified (heff.compile.lower):
--   by the version it was made at -- the elaboration cache's hash of
--   it, which covers what it uses -- the definitions lifted from it,
--   each simplified, with what it mentions, whether it was safe before;
-- - the copies of its definitions (heff.compile.simplify): by the
--   version each was made at, what it is known by and the copies that
--   calls, and what it was made to, with the copies asked for as it was;
-- - each of its definitions' C (heff.compile.emitc), and each one's
--   JavaScript (heff.compile.emit), by a hash of what it was made of;
-- - the workers and what is lent of each component of the definitions
--   whose first is its (heff.compile.components), by a hash of what it
--   was worked out from.
--
-- Beside them, for each directory a program's C parts are written to,
-- `.heff/<backDir>/D.parts` (D a hash of the directory's path) keeps
-- what each of its modules' parts was made of (heff.compile.emitc's
-- `PartMemo`), and the bytes and the time its file was last written
-- at: what the directory holds, not what a module is, so that a
-- program written to one directory and then another is not taken for
-- the files of either.
--
-- A file is of one compiler: the hash of the program that wrote it (its
-- own executable), which a file of another is not believed by -- a
-- compiler's backend is not known by any number to bump.  Nothing in a
-- file that does not decode is believed; what is not believed is made
-- again, and written over it.  An entry made again replaces the one of
-- its key; the others stay, for the programs not compiled this time.

module heff.build.backcache

import heff.build.decoder
import heff.compile.components as Components
import heff.compile.emit as Emit
import heff.compile.emitc as EmitC
import heff.elab.fixed as Fixed
import heff.compile.ir as IR
import heff.compile.irtext as IRText
import heff.compile.lower as Lower
import heff.compile.repr as Repr
import heff.compile.simplify as Simplify
import heff.compile.spec as Spec
import std.ordmap as OrdMap

version : String
version = "heff-backend/17"

-- | the directory under `.heff/` the files are in
backDir : String
backDir = "b1"

-- Writing
--------------------------------------------------------------------------------

boolT : Bool -> String
boolT True = "t"
boolT False = "f"

-- (strings: their count, then each)
strsT : List String -> List String -> List String
strsT xs rest =
  debug (List.length xs) :: List.append (List.map IRText.tok xs) rest

pairT : Pair String String -> List String -> List String
pairT (MkPair a b) rest = IRText.tok a :: IRText.tok b :: rest

pairsGo : List (Pair String String) -> List String -> List String
pairsGo [] rest = rest
pairsGo (p :: ps) rest = pairT p (pairsGo ps rest)

pairsT : List (Pair String String) -> List String -> List String
pairsT ps rest = debug (List.length ps) :: pairsGo ps rest

-- (an expression, as a string: its variables named as they are, named
-- afresh where it is read)
exprT : IR.Expr -> String
exprT e = IRText.tok (IRText.encodeExpr e)

unitText : Lower.UnitOut -> String
unitText u =
  joinWith
    " "
    (IRText.tok u.done.key
     :: IRText.tok u.name
     :: strsT
       u.refs
       (boolT u.sgSafe
        :: debug u.sgTotal
        :: exprT u.done.body
        :: boolT u.done.safe
        :: pairsT u.done.touched Nil))

madeT : Maybe (Pair IR.Expr (List (Pair String String))) -> List String
madeT (Just (MkPair b t)) = "j" :: exprT b :: (pairsT t Nil)
madeT Nothing = ["n"]

copyText : Simplify.CopyDone -> String
copyText c =
  joinWith
    " "
    ((IRText.tok c.name)
     :: IRText.tok c.ver
     :: exprT c.recipe
     :: pairsT
       c.asks
       (debug c.depth
        :: boolT c.safe
        :: madeT c.made))

emitText : String -> EmitC.EmitKept -> String
emitText key k =
  joinWith
    " "
    (IRText.tok key
     :: IRText.tok k.ver
     :: strsT
       k.protos
       (strsT
          k.code
          (strsT
             k.strs
             (strsT
                k.lprotos
                (strsT k.lams (strsT k.shapes (strsT k.prims Nil)))))))

intsT : List Int -> List String -> List String
intsT xs rest = debug (List.length xs) :: List.append (List.map debug xs) rest

partText : EmitC.PartMemo -> String
partText m =
  joinWith
    " "
    (IRText.tok m.name
     :: IRText.tok m.home
     :: strsT
       m.keys
       (strsT
          m.vers
          (intsT
             m.sizes
             (strsT
                m.tags
                (strsT
                   m.lbls
                   (strsT
                      m.decls
                      (IRText.tok m.glob
                       :: debug m.bytes
                       :: debug m.modified
                       :: Nil)))))))

-- | a directory's parts, as written there by the compiler `id`
stampText : String -> List EmitC.PartMemo -> String
stampText id ms =
  joinWith
    " "
    (IRText.tok version
     :: IRText.tok id
     :: debug (List.length ms)
     :: List.append (List.map partText ms) [IRText.tok "end"])

jsText : String -> Emit.JsKept -> String
jsText key k =
  joinWith
    " "
    (IRText.tok key
     :: IRText.tok k.ver
     :: strsT k.lines (strsT k.params (strsT k.refs (strsT k.prims Nil))))

sigT : Repr.Sig -> List String -> List String
sigT s rest =
  strsT
    (List.map Repr.reprName s.params)
    (IRText.tok (Repr.reprName s.result) :: rest)

changesT : List (Pair Int Repr.Sig) -> List String -> List String
changesT cs rest =
  debug (List.length cs)
  :: List.foldr
    (\(c : Pair Int Repr.Sig) acc -> debug (fst c) :: sigT (snd c) acc)
    rest
    cs

maybeSigT : Maybe Repr.Sig -> List String -> List String
maybeSigT (Just s) rest = "j" :: sigT s rest
maybeSigT Nothing rest = "n" :: rest

lentT : Maybe (List Int) -> List String -> List String
lentT (Just is) rest =
  "j" :: debug (List.length is) :: List.append (List.map debug is) rest
lentT Nothing rest = "n" :: rest

memberT : Components.Member -> List String -> List String
memberT m rest =
  IRText.tok m.key
  :: changesT
    m.track.first
    (maybeSigT
       m.track.hope
       (changesT
          m.track.falls
          (changesT m.track.again (maybeSigT m.sig (lentT m.lent rest)))))

workText : String -> Components.Kept -> String
workText key k =
  joinWith
    " "
    (IRText.tok key
     :: IRText.tok k.ver
     :: debug (List.length k.members)
     :: List.foldr memberT Nil k.members)

-- Reading
--------------------------------------------------------------------------------

-- (what `d` reads, and the text it read: the separator after it left)
rawEnd : String -> Int -> Int -> Int
rawEnd s i j = if j > i && byteAt s (j - 1) == 32 then j - 1 else j

rawGot : {a : Type}
       -> String
       -> Int
       -> Maybe (Got a)
       -> Maybe (Got (Pair a String))
rawGot s i (Just (MkPair x j)) =
  Just (MkPair (MkPair x (strSlice s i (rawEnd s i j))) j)
rawGot s i Nothing = Nothing

withRaw : {a : Type} -> Dec a -> Dec (Pair a String)
withRaw d = \s i -> rawGot s i (d s i)

pairD : Dec (Pair String String)
pairD = do
  a <- str
  b <- str
  pure (MkPair a b)

-- (an expression, read when it is wanted)
later : String -> Unit -> Maybe IR.Expr
later text u = IRText.decodeExpr text

unitD : Dec Lower.KeptUnit
unitD = do
  key <- str
  name <- str
  refs <- many str
  sgSafe <- bool
  sgTotal <- int
  body <- str
  safe <- bool
  touched <- many pairD
  pure
      { def =
          { key = key
          , name = name
          , body = later body
          , safe = safe
          , touched = touched
          , sgSafe = sgSafe
          , sgTotal = sgTotal
          }
      , refs = refs
      }

-- | a definition of the core, simplified: its key, its version, the
-- | definitions lifted from it (each with its text)
type GroupIn =
  { owner : String, ver : String, units : List (Pair Lower.KeptUnit String) }

groupD : Dec GroupIn
groupD = do
  owner <- str
  ver <- str
  units <- many (withRaw unitD)
  pure { owner = owner, ver = ver, units = units }

madeOf : String -> Dec (Maybe Simplify.KeptMade)
madeOf "j" = do
  body <- str
  touched <- many pairD
  pure (Just { body = later body, touched = touched })
madeOf "n" = pure Nothing
madeOf _ = fail

copyD : Dec (Pair String Simplify.KeptCopy)
copyD = do
  name <- str
  ver <- str
  recipe <- str
  asks <- many pairD
  depth <- int
  safe <- bool
  made <- bind word madeOf
  pure
      (MkPair
         name
         { ver = ver
         , recipe = later recipe
         , asks = asks
         , depth = depth
         , safe = safe
         , made = made
         })

emitD : Dec (Pair String EmitC.EmitKept)
emitD = do
  key <- str
  ver <- str
  protos <- many str
  code <- many str
  strs <- many str
  lprotos <- many str
  lams <- many str
  shapes <- many str
  prims <- many str
  pure
      (MkPair
         key
         { ver = ver
         , protos = protos
         , code = code
         , strs = strs
         , lprotos = lprotos
         , lams = lams
         , shapes = shapes
         , prims = prims
         })

jsD : Dec (Pair String Emit.JsKept)
jsD = do
  key <- str
  ver <- str
  lines <- many str
  params <- many str
  refs <- many str
  prims <- many str
  pure
      (MkPair
         key
         { ver = ver
         , lines = lines
         , params = params
         , refs = refs
         , prims = prims
         })

partD : Dec EmitC.PartMemo
partD = do
  name <- str
  home <- str
  keys <- many str
  vers <- many str
  sizes <- many int
  tags <- many str
  lbls <- many str
  decls <- many str
  glob <- str
  bytes <- int
  modified <- int
  pure
      { name = name
      , home = home
      , keys = keys
      , vers = vers
      , sizes = sizes
      , tags = tags
      , lbls = lbls
      , decls = decls
      , glob = glob
      , bytes = bytes
      , modified = modified
      }

stampD : String -> Dec (List EmitC.PartMemo)
stampD id = do
  expect version
  expect id
  ms <- many partD
  expect "end"
  pure ms

-- | a directory's parts, as the compiler `id` wrote them there, each by
-- | its name: none, where the file is another's or does not decode
readStamp : String -> String -> OrdMap.OrdMap String EmitC.PartMemo
readStamp id text =
  List.foldl
    (\m (p : EmitC.PartMemo) -> OrdMap.insert m p.name p)
    OrdMap.empty
    (fromMaybe Nil (run (whole (stampD id)) text))

fixedRepr : Maybe Fixed.Fixed -> Dec Repr.Repr
fixedRepr (Just w) = pure (RepFix w)
fixedRepr Nothing = fail

reprOf : String -> Dec Repr.Repr
reprOf "_" = pure RepV
reprOf "Float64" = pure RepF64
reprOf "Int" = pure RepInt
reprOf x = fixedRepr (Fixed.fixedOfName x)

reprD : Dec Repr.Repr
reprD = bind str reprOf

sigD : Dec Repr.Sig
sigD = do
  params <- many reprD
  result <- reprD
  pure { params = params, result = result }

changeD : Dec (Pair Int Repr.Sig)
changeD = do
  i <- int
  s <- sigD
  pure (MkPair i s)

maybeSigOf : String -> Dec (Maybe Repr.Sig)
maybeSigOf "j" = do
  s <- sigD
  pure (Just s)
maybeSigOf "n" = pure Nothing
maybeSigOf _ = fail

lentFrom : String -> Dec (Maybe (List Int))
lentFrom "j" = do
  is <- many int
  pure (Just is)
lentFrom "n" = pure Nothing
lentFrom _ = fail

memberD : Dec Components.Member
memberD = do
  key <- str
  first <- many changeD
  hope <- bind word maybeSigOf
  falls <- many changeD
  again <- many changeD
  sig <- bind word maybeSigOf
  lent <- bind word lentFrom
  pure
      { key = key
      , track = { first = first, hope = hope, falls = falls, again = again }
      , sig = sig
      , lent = lent
      }

workD : Dec (Pair String Components.Kept)
workD = do
  key <- str
  ver <- str
  members <- many memberD
  pure (MkPair key { ver = ver, members = members })

-- | what a file keeps, each entry with its text
type Back =
  { groups : List (Pair GroupIn String)
  , copies : List (Pair (Pair String Simplify.KeptCopy) String)
  , emits : List (Pair (Pair String EmitC.EmitKept) String)
  , jss : List (Pair (Pair String Emit.JsKept) String)
  , works : List (Pair (Pair String Components.Kept) String)
  }

noBack : Back
noBack = { groups = Nil, copies = Nil, emits = Nil, jss = Nil, works = Nil }

backD : String -> Dec Back
backD id = do
  expect version
  expect id
  groups <- many (withRaw groupD)
  copies <- many (withRaw copyD)
  emits <- many (withRaw emitD)
  jss <- many (withRaw jsD)
  works <- many (withRaw workD)
  expect "end"
  pure
      { groups = groups
      , copies = copies
      , emits = emits
      , jss = jss
      , works = works
      }

-- | a file, believed if it is of this compiler (`id`) and decodes whole
readBack : String -> String -> Back
readBack id text = fromMaybe noBack (run (whole (backD id)) text)

-- What the backend is given
--------------------------------------------------------------------------------

-- | what the files keep, for both backends: definitions of the core
-- | simplified, copies
keepsOf : List Back -> Lower.Keeps
keepsOf bs =
  { units =
      List.foldl
        (\m (b : Back) ->
           List.foldl
             (\m2 (g : Pair GroupIn String) ->
                OrdMap.insert
                  m2
                  (fst g).owner
                  (MkPair (fst g).ver (List.map fst (fst g).units)))
             m
             b.groups)
        OrdMap.empty
        bs
  , copies =
      List.foldl
        (\m (b : Back) ->
           List.foldl
             (\m2 c -> OrdMap.insert m2 (fst (fst c)) (snd (fst c)))
             m
             b.copies)
        OrdMap.empty
        bs
  , works =
      List.foldl
        (\m (b : Back) ->
           List.foldl
             (\m2 w -> OrdMap.insert m2 (fst (fst w)) (snd (fst w)))
             m
             b.works)
        OrdMap.empty
        bs
  }

emitsOf : List Back -> OrdMap.OrdMap String EmitC.EmitKept
emitsOf bs =
  List.foldl
    (\m (b : Back) ->
       List.foldl
         (\m2 e -> OrdMap.insert m2 (fst (fst e)) (snd (fst e)))
         m
         b.emits)
    OrdMap.empty
    bs

jssOf : List Back -> OrdMap.OrdMap String Emit.JsKept
jssOf bs =
  List.foldl
    (\m (b : Back) ->
       List.foldl
         (\m2 e -> OrdMap.insert m2 (fst (fst e)) (snd (fst e)))
         m
         b.jss)
    OrdMap.empty
    bs

-- What it gives back, written
--------------------------------------------------------------------------------

lastDotGo : String -> Int -> Int -> Int
lastDotGo k i at =
  if i >= strLength k then at
  else lastDotGo k (i + 1) (if byteAt k i == 46 then i else at)

-- | the module a key is of, among `mods`: the longest of them it starts
-- | with, then a dot (`_`: none)
moduleIn : OrdMap.OrdMap String Unit -> String -> String
moduleIn mods k =
  if OrdMap.member mods k then k
  else if lastDotGo k 0 (0 - 1) <= 0 then "_"
  else moduleIn mods (strSlice k 0 (lastDotGo k 0 (0 - 1)))

-- | a file anew: what it kept, an entry made again in place of the one
-- | of its key
type Entries =
  { groups : OrdMap.OrdMap String String
  , copies : OrdMap.OrdMap String String
  , emits : OrdMap.OrdMap String String
  , jss : OrdMap.OrdMap String String
  , works : OrdMap.OrdMap String String
  }

entriesOf : Back -> Entries
entriesOf b =
  { groups =
      List.foldl
        (\m (g : Pair GroupIn String) -> OrdMap.insert m (fst g).owner (snd g))
        OrdMap.empty
        b.groups
  , copies =
      List.foldl
        (\m c -> OrdMap.insert m (fst (fst c)) (snd c))
        OrdMap.empty
        b.copies
  , emits =
      List.foldl
        (\m e -> OrdMap.insert m (fst (fst e)) (snd e))
        OrdMap.empty
        b.emits
  , jss =
      List.foldl
        (\m e -> OrdMap.insert m (fst (fst e)) (snd e))
        OrdMap.empty
        b.jss
  , works =
      List.foldl
        (\m w -> OrdMap.insert m (fst (fst w)) (snd w))
        OrdMap.empty
        b.works
  }

withGroup : String -> String -> Entries -> Entries
withGroup k t es =
  { groups = OrdMap.insert es.groups k t
  , copies = es.copies
  , emits = es.emits
  , jss = es.jss
  , works = es.works
  }

withCopy : String -> String -> Entries -> Entries
withCopy k t es =
  { groups = es.groups
  , copies = OrdMap.insert es.copies k t
  , emits = es.emits
  , jss = es.jss
  , works = es.works
  }

withEmit : String -> String -> Entries -> Entries
withEmit k t es =
  { groups = es.groups
  , copies = es.copies
  , emits = OrdMap.insert es.emits k t
  , jss = es.jss
  , works = es.works
  }

withJs : String -> String -> Entries -> Entries
withJs k t es =
  { groups = es.groups
  , copies = es.copies
  , emits = es.emits
  , jss = OrdMap.insert es.jss k t
  , works = es.works
  }

withWork : String -> String -> Entries -> Entries
withWork k t es =
  { groups = es.groups
  , copies = es.copies
  , emits = es.emits
  , jss = es.jss
  , works = OrdMap.insert es.works k t
  }

backOf : OrdMap.OrdMap String Back -> String -> Back
backOf olds m = fromMaybe noBack (OrdMap.lookup olds m)

-- (a module's entries so far: changed here, or as its file kept them)
entriesAt : OrdMap.OrdMap String Back
          -> OrdMap.OrdMap String Entries
          -> String
          -> Entries
entriesAt olds m k = case OrdMap.lookup m k of
  Just es -> es
  Nothing -> entriesOf (backOf olds k)

-- (a unit's text: made here, or as the file kept it)
unitTextOf : List (Pair Lower.KeptUnit String)
           -> Pair String (Maybe Lower.UnitOut)
           -> Maybe String
unitTextOf old (MkPair k (Just u)) = Just (unitText u)
unitTextOf old (MkPair k Nothing) = case List.find
    (\(p : Pair Lower.KeptUnit String) -> strEq (fst p).def.key k)
    old of
  Just p -> Just (snd p)
  Nothing -> Nothing

consJustB : String -> Maybe (List String) -> Maybe (List String)
consJustB x (Just xs) = Just (x :: xs)
consJustB x Nothing = Nothing

allJustB : List (Maybe String) -> Maybe (List String)
allJustB [] = Just Nil
allJustB (Just x :: rest) = consJustB x (allJustB rest)
allJustB (Nothing :: rest) = Nothing

groupText : String -> String -> Maybe (List String) -> Maybe String
groupText owner ver (Just us) =
  Just
    (joinWith
       " "
       (IRText.tok owner :: IRText.tok ver :: debug (List.length us) :: us))
groupText owner ver Nothing = Nothing

-- (the units the file of `m` kept for `owner`)
oldUnits : Back -> String -> List (Pair Lower.KeptUnit String)
oldUnits b owner =
  List.concatMap
    (\(g : Pair GroupIn String) ->
       if strEq (fst g).owner owner then (fst g).units else Nil)
    b.groups

-- | what a backend gives back to be kept: each definition's C, or its
-- | JavaScript
type Given =
  { groups : List Lower.GroupOut
  , copies : List Simplify.CopyDone
  , emits : List (Pair String EmitC.EmitKept)
  , jss : List (Pair String Emit.JsKept)
  , works : List (Pair String Components.Kept)
  }

-- | where the files are: the modules, and what each kept
type Files =
  { mods : OrdMap.OrdMap String Unit, olds : OrdMap.OrdMap String Back }

groupIn : Files
        -> OrdMap.OrdMap String Entries
        -> String
        -> Lower.GroupOut
        -> Maybe String
        -> OrdMap.OrdMap String Entries
groupIn fs m md g (Just t) =
  OrdMap.insert m md (withGroup g.owner t (entriesAt fs.olds m md))
groupIn fs m md g Nothing = m

addGroup : Files
         -> OrdMap.OrdMap String Entries
         -> Lower.GroupOut
         -> OrdMap.OrdMap String Entries
addGroup fs m g =
  groupIn
    fs
    m
    (moduleIn fs.mods g.owner)
    g
    (groupText
       g.owner
       g.ver
       (allJustB
          (List.map
             (unitTextOf
                (oldUnits (backOf fs.olds (moduleIn fs.mods g.owner)) g.owner))
             g.units)))

addCopy : Files
        -> OrdMap.OrdMap String Entries
        -> Simplify.CopyDone
        -> OrdMap.OrdMap String Entries
addCopy fs m c =
  OrdMap.insert
    m
    (moduleIn fs.mods (Spec.rootOf c.name))
    (withCopy
       c.name
       (copyText c)
       (entriesAt fs.olds m (moduleIn fs.mods (Spec.rootOf c.name))))

addEmit : Files
        -> OrdMap.OrdMap String Entries
        -> Pair String EmitC.EmitKept
        -> OrdMap.OrdMap String Entries
addEmit fs m (MkPair k e) =
  OrdMap.insert
    m
    (moduleIn fs.mods (Spec.rootOf k))
    (withEmit
       k
       (emitText k e)
       (entriesAt fs.olds m (moduleIn fs.mods (Spec.rootOf k))))

addJs : Files
      -> OrdMap.OrdMap String Entries
      -> Pair String Emit.JsKept
      -> OrdMap.OrdMap String Entries
addJs fs m (MkPair k e) =
  OrdMap.insert
    m
    (moduleIn fs.mods (Spec.rootOf k))
    (withJs
       k
       (jsText k e)
       (entriesAt fs.olds m (moduleIn fs.mods (Spec.rootOf k))))

addWork : Files
        -> OrdMap.OrdMap String Entries
        -> Pair String Components.Kept
        -> OrdMap.OrdMap String Entries
addWork fs m (MkPair k w) =
  OrdMap.insert
    m
    (moduleIn fs.mods (Spec.rootOf k))
    (withWork
       k
       (workText k w)
       (entriesAt fs.olds m (moduleIn fs.mods (Spec.rootOf k))))

-- | a module's file, its entries in order of their keys
backText : String -> Entries -> String
backText id es =
  joinWith
    " "
    (List.append
       [IRText.tok version, IRText.tok id, debug (OrdMap.size es.groups)]
       (List.append
          (List.map snd (OrdMap.toList es.groups))
          (debug (OrdMap.size es.copies)
           :: List.append
             (List.map snd (OrdMap.toList es.copies))
             (debug (OrdMap.size es.emits)
              :: List.append
                (List.map snd (OrdMap.toList es.emits))
                (debug (OrdMap.size es.jss)
                 :: List.append
                   (List.map snd (OrdMap.toList es.jss))
                   (debug (OrdMap.size es.works)
                    :: List.append
                      (List.map snd (OrdMap.toList es.works))
                      [IRText.tok "end"]))))))

-- | the files with something made anew in them, each by its module, as
-- | they are to be: what they kept, what was made in place of the
-- | entries of its keys
backTexts : String -> Files -> Given -> List (Pair String String)
backTexts id fs gv =
  List.map
    (\p -> MkPair (fst p) (backText id (snd p)))
    (OrdMap.toList
       (List.foldl
          (addWork fs)
          (List.foldl
             (addJs fs)
             (List.foldl
                (addEmit fs)
                (List.foldl
                   (addCopy fs)
                   (List.foldl (addGroup fs) OrdMap.empty gv.groups)
                   gv.copies)
                gv.emits)
             gv.jss)
          gv.works))
