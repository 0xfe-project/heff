-- A module's reference page, what `heff doc` writes: Markdown with a
-- title, as a site of Starlight's reads it.  The module's header comment,
-- then each definition it exposes, in the order it defines them: its
-- signature as `heff check` prints it (a type in full), laid out as
-- `heff fmt` lays that declaration out, and its doc comment, its doc tests shown as examples.  The pages' index lists the
-- modules, each with the first sentence of its header comment.

module heff.build.docpages

import co
import heff.build.commands as Commands
import heff.build.driver as Driver
import heff.build.query as Query
import heff.build.session as Session
import heff.build.testing as Testing
import heff.elab.params as Params
import heff.lsp.report as Report
import heff.syntax.format as Format
import heff.util.files as Files
import heff.util.hostpath as HostPath
import std.filesystem
import std.io
import std.path as Path
import std.process
import std.progress as Progress

-- The header comment
--------------------------------------------------------------------------------

-- (a line of the header comment, `-- text`: its text)
-- | >>> headerText "-- Paths, in a style"
-- | "Paths, in a style"
-- | >>> headerText "--"
-- | ""
headerText : String -> String
headerText l =
  if startsWith "-- " l then strSlice l 3 (strLength l)
  else strSlice l 2 (strLength l)

-- (the lines of the comments at the top, up to the first line that is
-- neither a comment's nor blank)
headerGo : List String -> List String
headerGo Nil = Nil
headerGo (Cons l rest) =
  if startsWith "--" l then Cons (headerText l) (headerGo rest)
  else if strEq (trim l) "" then Cons "" (headerGo rest)
  else Nil

-- | the module's header comment, the comment above its `module` line,
-- | its text
-- | >>> headerComment "-- Lists.\n-- Their operations.\n\nmodule list\n-- no\n"
-- | "Lists.\nTheir operations."
headerComment : String -> String
headerComment src = trim (joinWith "\n" (headerGo (split "\n" src)))

-- (the first paragraph's lines, up to a blank one)
firstParagraph : List String -> List String
firstParagraph Nil = Nil
firstParagraph (Cons l rest) =
  if strEq (trim l) "" then Nil else Cons (trim l) (firstParagraph rest)

-- (where the first sentence of the text ends, from `i`, a `. ` not in
-- code, between backquotes)
sentenceEnd : String -> Int -> Bool -> Maybe Int
sentenceEnd s i code =
  if i + 1 >= strLength s then Nothing
  else if byteAt s i == 96 then sentenceEnd s (i + 1) (not code)
  else if not code && byteAt s i == 46 && byteAt s (i + 1) == 32 then Just i
  else sentenceEnd s (i + 1) code

-- (a text up to its first sentence's end, the stop kept)
sentenceIn : String -> Maybe Int -> String
sentenceIn s (Just i) = strSlice s 0 (i + 1)
sentenceIn s Nothing = s

-- | the first sentence of a header comment, on one line
-- | >>> firstSentence "JSON (RFC 8259): a value. Import it\nby a name."
-- | "JSON (RFC 8259): a value."
-- | >>> firstSentence "By `x /. y`, divided. More."
-- | "By `x /. y`, divided."
-- | >>> firstSentence "Lists\nof things\n\nMore."
-- | "Lists of things"
firstSentence : String -> String
firstSentence header =
  sentenceIn
    (joinWith " " (firstParagraph (split "\n" header)))
    (sentenceEnd (joinWith " " (firstParagraph (split "\n" header))) 0 False)

-- The definitions
--------------------------------------------------------------------------------

-- (where the definition of this name is)
spanNamed : String -> List (Pair String Params.Span) -> Maybe Params.Span
spanNamed x Nil = Nothing
spanNamed x (Cons (MkPair y sp) rest) =
  if strEq x y then Just sp else spanNamed x rest

-- (the doc comment above the definition there, as Markdown)
docAbove : Driver.Checked -> Maybe Params.Span -> String
docAbove c (Just sp) =
  Query.docMarkdownIn
    "haskell"
    (Query.docLines c.source (Query.lineStartOf c.source sp.start))
docAbove c Nothing = ""

-- (a part of the page, a blank line after it, if it has any text)
part : String -> String
part text = if strEq (trim text) "" then "" else trim text ^ "\n\n"

-- (a byte of an operator, as a word of its anchor)
opWord : Int -> String
opWord b =
  if b == 60 then "lt"
  else if b == 62 then "gt"
  else if b == 43 then "plus"
  else if b == 45 then "minus"
  else if b == 42 then "star"
  else if b == 47 then "slash"
  else if b == 61 then "eq"
  else if b == 58 then "colon"
  else if b == 46 then "dot"
  else if b == 124 then "bar"
  else if b == 38 then "amp"
  else if b == 94 then "caret"
  else if b == 36 then "dollar"
  else if b == 33 then "bang"
  else if b == 63 then "question"
  else if b == 126 then "tilde"
  else if b == 37 then "percent"
  else if b == 64 then "at"
  else if b == 35 then "hash"
  else if b == 92 then "backslash"
  else show b

-- (a name's first byte: a letter or `_`)
nameStart : Int -> Bool
nameStart b = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95

-- | a definition's anchor on its page: its name; an operator's, `op`
-- | and a word for each of its characters
-- | >>> anchorOf "foldMap"
-- | "foldMap"
-- | >>> anchorOf "<+>"
-- | "op-lt-plus-gt"
-- | >>> anchorOf "::"
-- | "op-colon-colon"
anchorOf : String -> String
anchorOf x =
  if nameStart (byteAt x 0) then x
  else "op-"
    ^ joinWith
      "-"
      (List.map (\i -> opWord (byteAt x i)) (List.range 0 (strLength x - 1)))

-- (a signature as the formatter gave it back; as printed, on one line,
-- where it would not lay it out)
laidOutAs : String -> Either String String -> String
laidOutAs sig (Right out) = trim out
laidOutAs sig (Left why) = trim sig

-- | a signature laid out as `heff fmt` lays the declaration out in a
-- | file, the operators in scope known: a data type's tags a line each,
-- | a long type cut at its arrows, a theory's fields a line each
laidOut : Driver.Checked -> String -> String
laidOut c sig = laidOutAs sig (Format.formatIn c.fixities (trim sig ^ "\n"))

-- (a byte Markdown may read as more than itself: ASCII punctuation)
punctuation : Int -> Bool
punctuation b =
  (b >= 33 && b <= 47)
  || (b >= 58 && b <= 64)
  || (b >= 91 && b <= 96)
  || (b >= 123 && b <= 126)

-- (an operator's byte in a heading, escaped if Markdown could read it)
headingByte : String -> Int -> String
headingByte x i =
  if punctuation (byteAt x i) then "\\" ^ strSlice x i (i + 1)
  else strSlice x i (i + 1)

-- | a definition's name as its heading says it, plain text: an
-- | operator's characters escaped, so that Markdown reads none as markup
-- | >>> headingText "foldMap"
-- | "foldMap"
-- | >>> headingText "<*>"
-- | "\\<\\*\\>"
headingText : String -> String
headingText x =
  if nameStart (byteAt x 0) then x
  else joinWith
      ""
      (List.map (\i -> headingByte x i) (List.range 0 (strLength x - 1)))

-- (a definition's entry, given its signature: a heading, its name in
-- plain text and its anchor given, `{#anchor}`, so that a link to it
-- stays as the name is)
entryWith : Driver.Checked -> Driver.Own -> Maybe String -> Maybe String
entryWith c o (Just sig) =
  Just
    ("## "
     ^ headingText o.name
     ^ " {#"
     ^ anchorOf o.name
     ^ "}\n\n```haskell\n"
     ^ laidOut c sig
     ^ "\n```\n\n"
     ^ part (docAbove c (spanNamed o.name c.top.spans)))
entryWith c o Nothing = Nothing

-- | a definition's entry on the page: its name, a heading; its
-- | signature; its doc comment
entryOf : Driver.Checked -> Driver.Own -> Maybe String
entryOf c o = entryWith c o (Driver.signatureOf c o)

-- (the entries that are something, in order)
entriesOf : List (Maybe String) -> List String
entriesOf Nil = Nil
entriesOf (Cons (Just s) rest) = Cons s (entriesOf rest)
entriesOf (Cons Nothing rest) = entriesOf rest

-- The pages
--------------------------------------------------------------------------------

-- (a page's front matter: its title)
frontMatter : String -> String
frontMatter title = "---\ntitle: " ^ title ^ "\n---\n\n"

-- | a module's page: its title the module's name, its header comment,
-- | then each definition it exposes (those its claim hides are not
-- | there)
page : Driver.Checked -> String
page c =
  trim
    (frontMatter c.module
     ^ part (headerComment c.source)
     ^ joinWith
       ""
       (entriesOf
          (List.map (\o -> entryOf c o) (Driver.exposedOwn c))))
  ^ "\n"

-- | where a module's page is, under the pages' directory: a directory a
-- | level of its name, `std.path` at `std/path.md`
-- | >>> pagePath "std.path"
-- | "std/path.md"
pagePath : String -> String
pagePath m = joinWith "/" (split "." m) ^ ".md"

-- (a module's line in the index)
indexLine : Driver.Checked -> String
indexLine c =
  "- [`"
  ^ c.module
  ^ "`]("
  ^ pagePath c.module
  ^ ")"
  ^ (if strEq (headerComment c.source) "" then ""
     else ": " ^ firstSentence (headerComment c.source))
  ^ "\n"

-- (whether a module's name comes before another's)
moduleBefore : Driver.Checked -> Driver.Checked -> Bool
moduleBefore a b = strLt a.module b.module

-- | the pages' index, `index.md`: each module, in the order of their
-- | names, with the first sentence of its header comment
indexPage : List Driver.Checked -> String
indexPage cs =
  "---\ntitle: API\nsidebar:\n  label: Modules\n---\n\n"
  ^ "The modules, each a page: what it exposes, with its type and its documentation.\n\n"
  ^ joinWith "" (List.map indexLine (List.sortBy moduleBefore cs))

-- `heff doc`
--------------------------------------------------------------------------------

-- (the files `heff doc` reads, none given: the `.hf` files under `src/`,
-- if there is one here)
docFilesIn : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Maybe (List String)
           -> Co e (List String)
docFilesIn (Just _) = Testing.testFilesGo [MkPair True "src"] Nil
docFilesIn Nothing = do
  printErr "heff doc: no src/ here: run it at the project's root, or give FILEs"
  exit 1
  pure Nil

-- | the files `heff doc` reads: those given, a directory's `.hf` files
-- | for it; none given, the project's here (those under `src/`)
docFiles : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> List String
         -> Co e (List String)
docFiles Nil = do
  src <- Files.readDirectory "src"
  docFilesIn src
docFiles given = Testing.testFilesGo (List.map (\f -> MkPair True f) given) Nil

-- (a file's module, kept if it and what it imports checked)
docKept : Bool
        -> Maybe Driver.Checked
        -> List Driver.Checked
        -> List Driver.Checked
docKept False (Just c) acc = Cons c acc
docKept bad found acc = acc

-- (each file checked, after what it imports: the modules that checked,
-- in order; each that did not, its diagnostics said.  Each one more of
-- the task `chk`'s, a task under it meanwhile)
docChecked : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> {{prog : Progress.progress <: e}}
           -> Progress.Task
           -> List String
           -> List Driver.Checked
           -> Co e (List Driver.Checked)
docChecked chk Nil acc = pure (List.reverse acc)
docChecked chk (Cons f rest) acc = do
  m <- Progress.start chk f 0
  l <- Commands.load f
  badL <- Commands.printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  if Commands.anyErrors cs then Commands.putFileDiags cs else pure MkUnit
  Progress.end m
  docChecked
      chk
      rest
      (docKept (badL > 0 || Commands.anyErrors cs) (Driver.lastChecked cs) acc)

-- (a page written, its directory made first)
docPageWritten : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> String
               -> String
               -> Co e Unit
docPageWritten path text = do
  st <- Commands.styleNow
  _ <- Files.makeDirectory (HostPath.dirname st path)
  ok <- Files.writeFile path text
  if ok then pure MkUnit
  else do
    printErr ("heff doc: cannot write " ^ path)
    exit 1

-- (each module's page, under the directory: one more of the task `w`'s)
docPagesWritten : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> {{prog : Progress.progress <: e}}
                -> Progress.Task
                -> String
                -> List Driver.Checked
                -> Co e Unit
docPagesWritten w dir Nil = pure MkUnit
docPagesWritten w dir (Cons c rest) = do
  st <- Commands.styleNow
  docPageWritten
      (HostPath.join st dir (pagePath c.module))
      (page c)
  Progress.complete w
  docPagesWritten w dir rest

-- (the pages: printed one after another, or written under the directory,
-- with their index)
docWritten : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{prog : Progress.progress <: e}}
           -> Maybe String
           -> List Driver.Checked
           -> Co e Unit
docWritten Nothing cs = write (joinWith "\n" (List.map page cs))
docWritten (Just dir) cs = do
  st <- Commands.styleNow
  w <- Progress.start Progress.root "writing pages" (List.length cs + 1)
  docPagesWritten w dir cs
  docPageWritten (HostPath.join st dir "index.md") (indexPage cs)
  Progress.end w
  print
      ("heff doc: "
       ^ show (List.length cs)
       ^ " pages and their index, in "
       ^ dir)

-- | `heff doc`: a reference page of each module of the files (a
-- | directory's `.hf` files), else of the project's here (`src/`): its
-- | header comment, and each definition it exposes, its signature and
-- | its doc comment; printed, or with `--out DIR`, each written under
-- | DIR (`std.path` at DIR/std/path.md), with an index of them.  A module
-- | that does not check has no page, and its errors are said
docCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Maybe String
       -> List String
       -> Co e Unit
docCmd out given = do
  files <- docFiles given
  chk <- Progress.start Progress.root "checking modules" (List.length files)
  cs <- docChecked chk files Nil
  Progress.end chk
  docWritten out cs
  if List.length cs < List.length files then exit 1 else pure MkUnit
