-- What `heff` does: the work of each of its commands (checking,
-- compiling, running, testing, formatting, publishing, fetching), each a
-- computation that asks for the effects it has, in any world they are
-- in (the program gives them).  The command line is
-- not here: what reads it, and the world it runs in, are the program's,
-- so what is here may be used without either (#3).

module heff.build.commands

import co
import exception
import heff.build.backcache as BackCache
import heff.build.cache as Cache
import heff.build.docpages as DocPages
import heff.build.driver as Driver
import heff.elab.effect as Effect
import heff.compile.emit as Emit
import heff.compile.emitc as EmitC
import heff.compile.glue as Glue
import heff.syntax.fixity as Fixity
import heff.syntax.format as Format
import heff.build.load as Load
import heff.build.project as Project
import heff.build.query as Query
import heff.lsp.render as Render
import heff.lsp.report as Report
import heff.build.session as Session
import heff.build.watch as Watch
import heff.syntax.import as Import
import heff.util.hostpath as HostPath
import json as JSON
import regex as Regex
import std.filesystem
import std.io
import std.path as Path
import std.process
import std.progress as Progress
import std.reactor as Reactor
import std.time as Time
import std.map as Map

-- | the style of the paths of the platform heff runs on
styleNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e Path.Style
styleNow = do
  p <- platform
  pure (Path.styleOf p)

-- | the path of the heff running, in the platform's style
selfPath : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
selfPath = do
  st <- styleNow
  p <- programPath
  pure (Path.render (os := st) p)

-- | the working directory, in the platform's style
cwdNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
cwdNow = do
  st <- styleNow
  d <- workingDir
  pure (Path.render (os := st) d)

-- | the directory the compiler at `self` came with: the repository it is
-- | built in (it is `.heff/out/heff` there), or a release or the heff
-- | home (`bin/heff`, what it ships beside `bin/`)
-- | >>> ownRoot (Path.styleOf "linux") "/r/.heff/out/heff"
-- | "/r"
-- | >>> ownRoot (Path.styleOf "linux") "/opt/heff-0.2.0/bin/heff"
-- | "/opt/heff-0.2.0"
ownRoot : Path.Style -> String -> String
ownRoot st self =
  if strEq (HostPath.basename st (HostPath.dirname st self)) "out"
     && strEq
       (HostPath.basename st (HostPath.dirname st (HostPath.dirname st self)))
       ".heff"
  then HostPath.dirname st (HostPath.dirname st (HostPath.dirname st self))
  else HostPath.dirname st (HostPath.dirname st self)

-- | where the standard library is: `HEFF_LIB`, else the `lib/` the
-- | compiler came with
libDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
libDir = do
  v <- getEnv "HEFF_LIB"
  case v of
    Just lib -> pure lib
    Nothing -> do
      st <- styleNow
      self <- selfPath
      pure (HostPath.join st (ownRoot st self) "lib")

-- | where packages are fetched to: `HEFF_MODCACHE`, else
-- | `~/.cache/heff/mod`
modDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
modDir = do
  v <- getEnv "HEFF_MODCACHE"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      HostPath.join
        st
        (HostPath.join st (fromMaybe (fromMaybe "." profile) home) ".cache")
        (HostPath.join st "heff" "mod"))

-- | where heff keeps what is the user's (`bin/`, the programs `heff
-- | install` installs, and beside it what they ship): `HEFF_HOME`, else
-- | `~/.heff`
heffHome : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
heffHome = do
  v <- getEnv "HEFF_HOME"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      HostPath.join st (fromMaybe (fromMaybe "." profile) home) ".heff")

-- | the package.hf of the heff running, which says its version: in the
-- | directory it came with
ownPackage : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
ownPackage = do
  st <- styleNow
  self <- selfPath
  pure (HostPath.join st (ownRoot st self) "package.hf")

-- | the file in the heff home that says the checkout it was installed
-- | from: `heff install` of heff's own package writes it
sourceFile : Path.Style -> String -> String
sourceFile st home = HostPath.join st home "source"

-- (the checkout a heff home's `source` says)
sourceSaid : Maybe String -> List String
sourceSaid (Just text) = if strEq (trim text) "" then Nil else [trim text]
sourceSaid Nothing = Nil

-- | the library, the packages fetched, the directory heff runs in, the
-- | style of the platform's paths, and where heff is from: the directory
-- | it came with, and the checkout it was installed from -- as that
-- | directory says, if it is a heff home, and as the heff home says
hostNow : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> Co e Load.Host
hostNow = do
  lib <- libDir
  mod <- modDir
  cwd <- cwdNow
  st <- styleNow
  self <- selfPath
  home <- heffHome
  came <- readFile (sourceFile st (ownRoot st self))
  source <- readFile (sourceFile st home)
  pure
      { lib = lib
      , mod = mod
      , cwd = cwd
      , style = st
      , heff =
          Cons
            (ownRoot st self)
            (List.append (sourceSaid came) (sourceSaid source))
      }

-- | the version of heff running: the heff its own package.hf is for
ownVersion : {e : HFunctor}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e (Maybe String)
ownVersion = do
  path <- ownPackage
  text <- readFile path
  pure (case text of
    Just src -> case Project.readPackage src of
      Right p -> Just p.heff
      Left _ -> Nothing
    Nothing -> Nothing)

-- (what the package.hf at `path`, read, says of the heff running)
versionRead : String
            -> String
            -> Either Project.Problem Project.Package
            -> Either String String
versionRead path src (Right p) = Right ("heff " ^ p.heff)
versionRead path src (Left p) =
  Left ("not known: " ^ Load.problemMsg path src p)

-- | what `heff version` says: the heff running and its version, from the
-- | text of its package.hf at `path`; or, without one that reads, why
-- | that is not known
-- | >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\", heff = \"0.3.0\" }")
-- | Right "heff 0.3.0"
-- | >>> versionSaid "/h/package.hf" Nothing
-- | Left "not known: there is no /h/package.hf"
-- | >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\" }")
-- | Left "not known: /h/package.hf:1:11: the fields are module, heff, require, replace, in this order (require and replace may be left out)"
versionSaid : String -> Maybe String -> Either String String
versionSaid path Nothing = Left ("not known: there is no " ^ path)
versionSaid path (Just src) = versionRead path src (Project.readPackage src)

-- | say which heff is running: its version, as its package.hf says
versionCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e Unit
versionCmd = do
  path <- ownPackage
  text <- readFile path
  case versionSaid path text of
    Right line -> print line
    Left why -> do
      printErr ("heff version: " ^ why)
      exit 1

-- | what is wrong with the heff a project is for, if anything: this heff
-- | is `running`
-- | what is wrong with the heff `who` is for, `wanted`, if anything:
-- | this heff is `running`
heffVersions : String
             -> String
             -> String
             -> Maybe (List Int)
             -> Maybe (List Int)
             -> Maybe String
heffVersions who wanted running (Just w) (Just r) =
  if Project.compatible w r then Nothing
  else Just
      (who
       ^ " is for heff "
       ^ wanted
       ^ (if strEq (strSlice wanted 0 2) "0." then " (the same 0.x)" else "")
       ^ ", and this heff is "
       ^ running)
heffVersions who wanted running _ _ = Nothing

heffFor : Maybe String -> String -> String -> Maybe String
heffFor (Just running) who wanted =
  heffVersions
    who
    wanted
    running
    (Project.version wanted)
    (Project.version running)
heffFor Nothing who wanted = Nothing

-- (a package, as said where it is wrong)
whoOf : Load.Pkg -> String
whoOf k =
  if strEq k.own "" then "package.hf: the project" else "the package " ^ k.path

-- (what is wrong with the heff each package is for: the project, then
-- those it requires)
heffErrors : Maybe String -> List Load.Pkg -> List String
heffErrors running Nil = Nil
heffErrors running (Cons project deps) =
  List.concatMap
    (\(k : Load.Pkg) -> case heffFor running (whoOf k) k.heff of
     Just why -> [why]
     Nothing -> Nil)
    (if strEq project.heff "" then deps else Cons project deps)

withError : Load.Loaded -> String -> Load.Loaded
withError l e =
  { sources = l.sources
  , errors = Cons e l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- | FILE and its import closure, loaded from FILE's project, which must
-- | be for this heff
load : {e : HFunctor}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> String
     -> Co e Load.Loaded
load file = do
  h <- hostNow
  l <- Load.loadProgram h file
  running <- ownVersion
  pure (List.foldl withError l (heffErrors running l.packages))

-- (the files given, each a module named as from the working directory,
-- one of the library's if it is under the library)
readAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> List String
        -> List String
        -> Co e (List Driver.Source)
readAll before Nil = pure Nil
readAll before (Cons path rest) = do
  mSrc <- readFile path
  case mSrc of
    Nothing -> do
      printErr ("cannot read " ^ path)
      exit 1
      pure Nil
    Just src -> do
      st <- styleNow
      h <- hostNow
      more <- readAll (Cons (Load.moduleOf (Load.here st) path) before) rest
      pure
          (Cons
             (Driver.givenAfter
                before
                (Load.moduleOf (Load.here st) path)
                path
                src
                (Load.ofLibrary (Load.hostPaths h) path))
             more)

printLines : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  print l
  printLines rest

printDefs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Driver.Checked
          -> List String
          -> Co e Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Driver.dumpLines c k)
  printDefs c rest

printErrs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> String
          -> List String
          -> Int
          -> Co e Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  printErr (m ^ ": " ^ l)
  printErrs m rest (n + 1)

printAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> List Driver.Checked
         -> Int
         -> Co e Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Driver.moduleKeys c)
  n <- printErrs (Driver.moduleName c) (Driver.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> Co e Unit
selfcheck paths = do
  sources <- readAll Nil paths
  bad <- printAll (Driver.checkProgram sources) 0
  if bad == 0 then pure MkUnit else exit 1

-- (the errors said, the count comes back)
-- (each diagnostic said; how many are errors)
diagCount : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> List Driver.Checked
          -> Co e Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  said <- printErrs (Driver.moduleName c) (Driver.diagLines c) 0
  m <- diagCount rest
  pure (List.length (Driver.errorsIn c) + m)

elemStrM : String -> List String -> Bool
elemStrM x Nil = False
elemStrM x (Cons y rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen Nil = Nil
nubStrGo seen (Cons x rest) =
  if elemStrM x seen then nubStrGo seen rest
  else Cons x (nubStrGo (Cons x seen) rest)

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- the provider of a module, M.provider.js beside the M.hf it was loaded
-- from
pathOfModule : List Driver.Source -> String -> Maybe String
pathOfModule Nil m = Nothing
pathOfModule (Cons s rest) m =
  if strEq s.module m then Just s.path else pathOfModule rest m

readProviderAt : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> List Driver.Source
               -> String
               -> Co e (Maybe Emit.Provider)
readProviderAt sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- readFile (Load.dropHf path ^ ".provider.js")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProviders : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> List Driver.Source
              -> List String
              -> Co e (List Emit.Provider)
readProviders sources Nil = pure Nil
readProviders sources (Cons m rest) = do
  p <- readProviderAt sources m
  ps <- readProviders sources rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere)
forHost : String -> Emit.Provider -> Bool
forHost host p = case Emit.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

-- The library's halves: lib/browser/ is the page's, lib/std/'s effects
-- the system's, by C (but those with a provider in JavaScript too:
-- std.reference, std.time), and so are those of lib/std/ that import one of
-- them, however far down (std.http.server, by std.http and std.net).
-- An import of the other half is an error there.
--------------------------------------------------------------------------------

browserRefused : Driver.Source -> Driver.Refused
browserRefused s =
  { module = s.module
  , code = 351
  , msg =
      "`"
      ^ s.module
      ^ "` is the browser's (lib/browser/), for JavaScript: a C program (--backend=c) cannot import it"
  , note = Nothing
  }

systemRefused : String -> Driver.Source -> Driver.Refused
systemRefused host s =
  { module = s.module
  , code = 352
  , msg =
      "`"
      ^ s.module
      ^ "` is an effect of the system (lib/std/), for C: it has no provider for --backend="
      ^ host
  , note = Nothing
  }

-- (what the first of the imports `path` does, by which the last is
-- reached: "imports `b`, which imports it")
importsOn : List String -> String
importsOn (Cons a (Cons b Nil)) = "imports it"
importsOn (Cons a (Cons b rest)) =
  "imports `" ^ b ^ "`, which " ^ importsOn (Cons b rest)
importsOn _ = ""

-- (a module of lib/std/ that imports one with no provider for `host`, by
-- the imports `path`, the last that one)
reachingRefused : String -> Driver.Source -> List String -> Driver.Refused
reachingRefused host s path =
  { module = s.module
  , code = 352
  , msg =
      "`"
      ^ s.module
      ^ "` is the system's (lib/std/), for C: it imports an effect with no provider for --backend="
      ^ host
  , note =
      Just
        ("`"
         ^ fromMaybe s.module (List.last path)
         ^ "` is that effect: `"
         ^ s.module
         ^ "` "
         ^ importsOn path)
  }

isBrowser : Driver.Source -> Bool
isBrowser s = s.library && startsWith "browser." s.module

isStd : Driver.Source -> Bool
isStd s = s.library && startsWith "std." s.module

jsFor : String -> String -> Maybe String -> Bool
jsFor host m Nothing = False
jsFor host m (Just t) = forHost host { module = m, text = t }

-- (one of lib/std/'s with a provider in C, and none in JavaScript for
-- `host`: one for another host, or none at all)
systemOnly : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> Driver.Source
           -> Co e Bool
systemOnly host s = do
  c <- readFile (Load.dropHf s.path ^ ".provider.c")
  js <- readFile (Load.dropHf s.path ^ ".provider.js")
  pure (case c of
    Just _ -> not (jsFor host s.module js)
    Nothing -> False)

-- (lib/std/'s effects of the system with no provider for `host`)
systemOnlyOf : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> String
             -> List Driver.Source
             -> Co e (List String)
systemOnlyOf host Nil = pure Nil
systemOnlyOf host (Cons s rest) = do
  ms <- systemOnlyOf host rest
  if isStd s
  then do
    only <- systemOnly host s
    pure (if only then Cons s.module ms else ms)
  else pure ms

hasName : String -> List String -> Bool
hasName m ms = List.any (\n -> strEq n m) ms

-- (the modules a module imports, as `sources` has it)
importedBy : List Driver.Source -> String -> List String
importedBy sources m =
  maybe
    Nil
    (\(s : Driver.Source) ->
       Driver.importNames (Driver.importsOfSource s).imports)
    (List.find (\(s : Driver.Source) -> strEq s.module m) sources)

-- (from the modules to go through, each with the imports it was reached
-- by, the last it, those gone through already left: the imports by
-- which one of `only` is reached first, depth first)
reachOnly : List Driver.Source
          -> List String
          -> List String
          -> List (List String)
          -> Maybe (List String)
reachOnly sources only seen Nil = Nothing
reachOnly sources only seen (Cons path rest) =
  let m = fromMaybe "" (List.last path)
  in if hasName m seen then reachOnly sources only seen rest
  else if hasName m only then Just path
  else reachOnly
      sources
      only
      (Cons m seen)
      (List.append
         (List.map (\i -> List.append path [i]) (importedBy sources m))
         rest)

-- (a module of lib/std/ refused, where it is an effect with no provider
-- for `host` or reaches one)
refusedReaching : String
                -> List Driver.Source
                -> List String
                -> Driver.Source
                -> Maybe Driver.Refused
refusedReaching host sources only s =
  if not (isStd s) then Nothing
  else if hasName s.module only then Just (systemRefused host s)
  else maybe
      Nothing
      (\path -> Just (reachingRefused host s path))
      (reachOnly sources only Nil [[s.module]])

refusedJs : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> String
          -> List Driver.Source
          -> Co e (List Driver.Refused)
refusedJs host sources = do
  only <- systemOnlyOf host sources
  pure
      (Driver.catMaybesD (List.map (refusedReaching host sources only) sources))

-- | the library's modules a program for `host` may not import: in C,
-- | lib/browser/'s; in JavaScript, lib/std/'s effects of the system, and
-- | lib/std/'s modules that import one, however far down
refusedFor : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> List Driver.Source
           -> Co e (List Driver.Refused)
refusedFor host sources =
  if strEq host "c"
  then pure
      (List.map (\s -> browserRefused s) (List.keepIf isBrowser sources))
  else refusedJs host sources

-- | the modules checked, each import of what `host` refuses an error at
-- | the import
refusedChecked : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> String
               -> List Driver.Source
               -> List Driver.Checked
               -> Co e (List Driver.Checked)
refusedChecked host sources cs = do
  rs <- refusedFor host sources
  pure (List.map (\c -> Driver.withRefused rs sources c) cs)

providesLeaf : List Emit.Provider -> String -> Bool
providesLeaf Nil k = False
providesLeaf (Cons p rest) k =
  if strEq p.module (Effect.moduleOfKey k)
     && elemStrM (Effect.nameOfKey k) (Emit.exportedNames p.text)
  then True
  else providesLeaf rest k

emitErrs : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  printErr ("heff: not compiled: " ^ e)
  emitErrs rest

putFileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{rep : Report.report <: e}}
             -> List Driver.Checked
             -> Co e Unit
putFileDiags Nil = pure MkUnit
putFileDiags (Cons c rest) = do
  color <- Report.errColor
  if List.null c.diags then pure MkUnit
  else writeErr (Render.renderFileDiags color c.path c.source c.diags)
  putFileDiags rest

anyErrors : List Driver.Checked -> Bool
anyErrors cs =
  List.any (\(c : Driver.Checked) -> not (List.null (Driver.errorsIn c))) cs

-- (the first error of the modules checked, where it is)
firstErrorOf : List Driver.Checked -> Maybe String
firstErrorOf Nil = Nothing
firstErrorOf (Cons c rest) = case Driver.firstError c of
  Just why -> Just why
  Nothing -> firstErrorOf rest

-- (`done`: what follows the written program)
writeOut : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> String
         -> Co e Unit
         -> Emit.Output
         -> Co e Unit
writeOut outPath done o = do
  emitErrs o.errors
  if List.null o.errors
  then do
    ok <- writeFile outPath o.source
    if ok then done
    else do
      printErr ("cannot write " ^ outPath)
      exit 1
  else exit 1

-- | the runtime a C program is built with: its C, bundled into the
-- | header every part includes, and its Zig, written beside the
-- | program's C -- among the parts as `heff.zig`, or beside a program
-- | of one file `F.c` as `F.zig` -- for zig to build into an object of
-- | its own
type RuntimeC = { c : String, zig : String }

-- (where the runtime's Zig goes beside a program of one file: `F.zig`,
-- for `F.c` or `F`)
zigBeside : String -> String
zigBeside path =
  (if endsWith ".c" path then strSlice path 0 (strLength path - 2) else path)
  ^ ".zig"

-- (the runtime's Zig the compiler writes with `OUT`, a program of one
-- file or of parts, `DIR/`)
zigOf : String -> String
zigOf outPath =
  if endsWith "/" outPath then outPath ^ "heff.zig" else zigBeside outPath

-- (a C program of one file written, its runtime's Zig beside it; then
-- `done`)
writeOutC : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> String
          -> String
          -> Co e Unit
          -> Emit.Output
          -> Co e Unit
writeOutC outPath zig done o =
  writeOut
    outPath
    (do
     ok <- writeFile (zigBeside outPath) zig
     if ok then done
     else do
       printErr ("cannot write " ^ zigBeside outPath)
       exit 1)
    o

-- (a part written, unless it is there as it was: a C compiler that goes
-- by when a file changed -- zig's -- builds it again only if it did)
writeChanged : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> String
             -> String
             -> Maybe String
             -> Co e Bool
writeChanged path text (Just was) =
  if strEq was text then pure True else writeFile path text
writeChanged path text Nothing = writeFile path text

-- (the parts of a C program, each `DIR/NAME`, written where changed)
writePartsGo : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> String
             -> List (Pair String String)
             -> Co e Bool
writePartsGo dir Nil = pure True
writePartsGo dir (Cons (MkPair name text) rest) = do
  st <- styleNow
  was <- readFile (HostPath.join st dir name)
  ok <- writeChanged (HostPath.join st dir name) text was
  if ok then writePartsGo dir rest else pure False

-- (what is in `dir` and is no part of the program -- a module no longer
-- in it -- gone, so that it is not built)
removeStale : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> String
            -> List (Pair String String)
            -> List String
            -> Co e Unit
removeStale dir parts Nil = pure MkUnit
removeStale dir parts (Cons n rest) = do
  st <- styleNow
  gone <-
    if List.any (\p -> strEq (fst p) n) parts then pure True
    else remove (HostPath.join st dir n)
  removeStale dir parts rest

-- | a C program as parts, in the directory `dir`: each part written
-- | only if it changed, and what is no part of it gone
writeParts : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> String
           -> Co e Unit
           -> Pair (List (Pair String String)) (List String)
           -> Co e Unit
writeParts dir done (MkPair parts errors) = do
  emitErrs errors
  if List.null errors
  then do
    made <- makeDirectory dir
    names <- readDirectory dir
    u <- removeStale dir parts (fromMaybe Nil names)
    ok <- writePartsGo dir parts
    if ok then done
    else do
      printErr ("cannot write " ^ dir)
      exit 1
  else exit 1

-- The backend's cache (heff.build.backcache), `.heff/<backDir>/`
--------------------------------------------------------------------------------

-- | where a program's backend cache is, and what it is given: the
-- | project's paths, each definition's hash (the elaboration cache's),
-- | the program's modules
type BackIn =
  { paths : Load.Paths, hashes : Map.Map String String, modules : List String }

backDirOf : Load.Paths -> String
backDirOf ps = Load.under ps (Load.under ps ps.root ".heff") BackCache.backDir

backPath : Load.Paths -> String -> String
backPath ps m = Load.under ps (backDirOf ps) (m ^ ".hb")

-- (a file written whole, or not at all: written beside it, then moved in
-- its place)
writeWhole : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> String
           -> Co e Bool
writeWhole path text = do
  ok <- writeFile (path ^ "." ^ show (strLength text) ^ ".tmp") text
  if ok then replace (path ^ "." ^ show (strLength text) ^ ".tmp") path
  else pure False

-- (the hash kept with the copy of the executable `b`, if `kept` is one:
-- the hash, a newline, then the executable)
keptId : String -> Maybe Int -> String -> Maybe String
keptId b (Just at) kept =
  if strLength kept - at - 1 == strLength b
     && strEq (strSlice kept (at + 1) (strLength kept)) b
  then Just (strSlice kept 0 at)
  else Nothing
keptId b Nothing kept = Nothing

-- (the copy kept, with its hash `id`)
selfKept : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> String
         -> String
         -> Co e String
selfKept ps b id = do
  made <- makeDirectory (backDirOf ps)
  ok <- writeWhole (Load.under ps (backDirOf ps) "compiler") (id ^ "\n" ^ b)
  pure id

selfFrom : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> String
         -> Maybe String
         -> Co e String
selfFrom ps b (Just kept) = case keptId b (indexOf "\n" kept) kept of
  Just id -> pure id
  Nothing -> selfFrom ps b Nothing
selfFrom ps b Nothing = selfKept ps b (Cache.strHash b)

-- | the compiler's own hash: of its executable ("" where it cannot be
-- | read, the cache then not used).  Hashing it would take long each
-- | time, so a copy of it is kept beside the cache, its hash first: an
-- | executable the same as the copy has its hash.
selfHash : {e : HFunctor}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> Co e String
selfHash ps = do
  p <- selfPath
  t <- readFile p
  case t of
    Just b -> do
      kept <- readFile (Load.under ps (backDirOf ps) "compiler")
      selfFrom ps b kept
    Nothing -> pure ""

-- (each module's file, as it is: its text)
readBacks : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> Load.Paths
          -> List String
          -> Co e (List (Pair String String))
readBacks ps Nil = pure Nil
readBacks ps (Cons m rest) = do
  t <- readFile (backPath ps m)
  more <- readBacks ps rest
  pure (case t of
    Just text -> Cons (MkPair m text) more
    Nothing -> more)

-- (each file written, where it is not as it was)
writeBacks : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> Load.Paths
           -> Map.Map String String
           -> List (Pair String String)
           -> Co e Unit
writeBacks ps olds Nil = pure MkUnit
writeBacks ps olds (Cons (MkPair m text) rest) = do
  ok <-
    if strEq text (fromMaybe "" (Map.lookup olds m))
    then pure True
    else writeWhole (backPath ps m) text
  writeBacks ps olds rest

textsMap : List (Pair String String) -> Map.Map String String
textsMap ps = List.foldl (\m p -> Map.insert m (fst p) (snd p)) Map.empty ps

backsOf : String -> List (Pair String String) -> Map.Map String BackCache.Back
backsOf id ps =
  List.foldl
    (\m p -> Map.insert m (fst p) (BackCache.readBack id (snd p)))
    Map.empty
    ps

modsOf : List String -> Map.Map String Unit
modsOf ms = List.foldl (\m k -> Map.insert m k MkUnit) Map.empty ms

-- (the parts written, then what the cache is to keep anew -- `texts`,
-- the files as they were, `backs`, what they kept -- then `done`)
keptWritten : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> BackIn
            -> String
            -> String
            -> String
            -> List (Pair String String)
            -> Map.Map String BackCache.Back
            -> Co e Unit
            -> EmitC.PartsKept
            -> Co e Unit
keptWritten bi dir zig id texts backs done out =
  writeParts
    dir
    (if strEq id "" then done
     else do
       made <- makeDirectory (backDirOf bi.paths)
       writeBacks
           bi.paths
           (textsMap texts)
           (BackCache.backTexts
              id
              { mods = modsOf (Cons "_" bi.modules), olds = backs }
              { groups = out.groups
              , copies = out.copies
              , emits = out.emits
              , jss = Nil
              })
       done)
    (MkPair (Cons (MkPair "heff.zig" zig) out.parts) out.errors)

keptWith : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> BackIn
         -> String
         -> RuntimeC
         -> Co e Unit
         -> Driver.Checked
         -> List Emit.Provider
         -> Driver.Runnable
         -> String
         -> List (Pair String String)
         -> Map.Map String BackCache.Back
         -> Co e Unit
keptWith bi dir rt done c available r id texts backs =
  keptWritten
    bi
    dir
    rt.zig
    id
    texts
    backs
    done
    (EmitC.compileProgramPartsKept
       rt.c
       available
       c.top.globals
       r.key
       r.effect
       bi.hashes
       (BackCache.keepsOf (List.map snd (Map.toList backs)))
       (BackCache.emitsOf (List.map snd (Map.toList backs))))

-- (the parts of the program running `r`, made through the cache)
keptParts : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> BackIn
          -> String
          -> RuntimeC
          -> Co e Unit
          -> Driver.Checked
          -> List Emit.Provider
          -> Driver.Runnable
          -> Co e Unit
keptParts bi dir rt done c available r = do
  id <- selfHash bi.paths
  texts <-
    if strEq id "" then pure Nil else readBacks bi.paths (Cons "_" bi.modules)
  keptWith bi dir rt done c available r id texts (backsOf id texts)

-- (the JavaScript of the program running `r`, written -- then what the
-- cache is to keep anew, `texts` the files as they were, `backs` what
-- they kept -- then `done`)
jsKeptWritten : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> BackIn
              -> String
              -> String
              -> List (Pair String String)
              -> Map.Map String BackCache.Back
              -> Co e Unit
              -> Emit.OutputKept
              -> Co e Unit
jsKeptWritten bi outPath id texts backs done out =
  writeOut
    outPath
    (if strEq id "" then done
     else do
       made <- makeDirectory (backDirOf bi.paths)
       writeBacks
           bi.paths
           (textsMap texts)
           (BackCache.backTexts
              id
              { mods = modsOf (Cons "_" bi.modules), olds = backs }
              { groups = out.groups
              , copies = out.copies
              , emits = Nil
              , jss = out.jss
              })
       done)
    out.output

-- (the page's script running `r`, simplified through the cache)
jsKept : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> BackIn
       -> String
       -> Co e Unit
       -> Driver.Checked
       -> List Emit.Provider
       -> Driver.Runnable
       -> Co e Unit
jsKept bi outPath done c available r = do
  id <- selfHash bi.paths
  texts <-
    if strEq id "" then pure Nil else readBacks bi.paths (Cons "_" bi.modules)
  jsKeptWritten
      bi
      outPath
      id
      texts
      (backsOf id texts)
      done
      (Emit.compileProgramKept
         available
         c.top.globals
         r.key
         r.effect
         bi.hashes
         (BackCache.keepsOf (List.map snd (Map.toList (backsOf id texts))))
         (BackCache.jssOf (List.map snd (Map.toList (backsOf id texts)))))

compileFound : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> BackIn
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Driver.Checked
             -> List Emit.Provider
             -> Co e Unit
compileFound bi file name outPath done c available = case Driver.findRunnable
    (List.keepIf (\k -> providesLeaf available k) (Driver.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    exit 1
  Right r -> jsKept bi outPath done c available r

-- (a computation whose effects all have providers for a page: each
-- world's algebra is bundled in from its module's M.provider.js)
compileLast : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> BackIn
            -> List Driver.Source
            -> String
            -> Maybe String
            -> String
            -> Co e Unit
            -> List Driver.Checked
            -> Co e Unit
compileLast bi sources file name outPath done cs = case Driver.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProviders
        sources
        (nubStrM
           (List.map (\k -> Effect.moduleOfKey k) (Driver.candidateLeaves c)))
    compileFound
        bi
        file
        name
        outPath
        done
        c
        (List.keepIf (\p -> forHost "page" p) found)

compileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> BackIn
             -> List Driver.Source
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Bool
             -> List Driver.Checked
             -> Co e Unit
compileDiags bi sources file name outPath done badL checked = do
  cs <- refusedChecked "page" sources checked
  putFileDiags cs
  if badL || anyErrors cs then exit 1
  else compileLast bi sources file name outPath done cs

-- (what the backend's cache is given, of a program loaded and checked)
backInOf : Load.Loaded -> Session.CacheAcc -> BackIn
backInOf l acc =
  { paths = l.paths
  , hashes = acc.hashes
  , modules = List.map (\(c : Driver.Checked) -> c.module) acc.done
  }

-- | compile the computation `name` of FILE to a page's script, then go
-- | on with `done`
compileThen : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> Maybe String
            -> String
            -> String
            -> Co e Unit
            -> Co e Unit
compileThen name outPath file done = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  acc <- Session.cachedAcc l
  compileDiags
      (backInOf l acc)
      l.sources
      file
      name
      outPath
      done
      (badL > 0)
      acc.done

-- | `heff compile --backend=page`: FILE's computation `name`, a page's
-- | script, its import closure loaded with the compiler's own loader
appCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> Maybe String
       -> String
       -> String
       -> Co e Unit
appCmd name outPath file =
  compileThen
    name
    outPath
    file
    (print
       ("wrote "
        ^ outPath
        ^ ": load it in a page with <script src=\"...\"> (it imports nothing: it opens from file:// too)"))

ownExport : Driver.Own -> Emit.Export
ownExport o = Emit.mkExport o.name o.key

compileJsOut : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> String
             -> Bool
             -> Emit.Output
             -> Co e Unit
compileJsOut outPath bad o = do
  ok <- writeFile outPath o.source
  emitErrs o.errors
  if ok && not bad && List.null o.errors then pure MkUnit else exit 1

compileJsDiags : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> {{rep : Report.report <: e}}
               -> String
               -> String
               -> Bool
               -> List Driver.Checked
               -> Co e Unit
compileJsDiags file outPath badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      compileJsOut
        outPath
        (badL || anyErrors cs)
        (Emit.compileJs
           c.top.globals
           (List.map (\o -> ownExport o) (Driver.listedOwn c)))

-- | an ES module of FILE and what it imports
compileJsCmd : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> String
             -> String
             -> Co e Unit
compileJsCmd file outPath = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  compileJsDiags file outPath (badL > 0) cs

-- The C backend
--------------------------------------------------------------------------------

-- (a world's provider for the C backend: `M.provider.c` beside `M.hf`)
readProviderC : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> List Driver.Source
              -> String
              -> Co e (Maybe Emit.Provider)
readProviderC sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- readFile (Load.dropHf path ^ ".provider.c")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProvidersC : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> List Driver.Source
               -> List String
               -> Co e (List Emit.Provider)
readProvidersC sources Nil = pure Nil
readProvidersC sources (Cons m rest) = do
  p <- readProviderC sources m
  ps <- readProvidersC sources rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

providesLeafC : List Emit.Provider -> String -> Bool
providesLeafC Nil k = False
providesLeafC (Cons p rest) k =
  if strEq p.module (Effect.moduleOfKey k)
     && elemStrM (Effect.nameOfKey k) (EmitC.providedNames p.text)
  then True
  else providesLeafC rest k

compileFoundC : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> BackIn
              -> String
              -> Maybe String
              -> String
              -> RuntimeC
              -> (String -> Co e Unit)
              -> Co e Unit
              -> Driver.Checked
              -> List Emit.Provider
              -> Co e Unit
compileFoundC bi file name outPath rt failed done c available = case Driver.findRunnable
    (List.keepIf (\k -> providesLeafC available k) (Driver.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    failed ("heff: " ^ file ^ ": " ^ why)
  Right r ->
    -- (a directory, `OUT/`: the program as parts, a file for each module)
    if endsWith "/" outPath
    then keptParts
        bi
        (strSlice outPath 0 (strLength outPath - 1))
        rt
        done
        c
        available
        r
    else writeOutC
        outPath
        rt.zig
        done
        (EmitC.compileProgramC rt.c available c.top.globals r.key r.effect)

-- (a file of the runtime, the library's `c/NAME`: its text)
readRuntimeFile : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> String
                -> Co e String
readRuntimeFile name = do
  lib <- libDir
  st <- styleNow
  text <- readFile (HostPath.join st (HostPath.join st lib "c") name)
  case text of
    Nothing -> do
      printErr
          ("heff: no C runtime at "
           ^ HostPath.join st (HostPath.join st lib "c") name)
      exit 1
      pure ""
    Just t -> pure t

-- (the runtime, what a C program is bundled with: its C and its Zig)
readRuntimeC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> Co e RuntimeC
readRuntimeC = do
  c <- readRuntimeFile "runtime.c"
  zig <- readRuntimeFile "runtime.zig"
  pure { c = c, zig = zig }

compileLastC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> BackIn
             -> List Driver.Source
             -> String
             -> Maybe String
             -> String
             -> (String -> Co e Unit)
             -> Co e Unit
             -> List Driver.Checked
             -> Co e Unit
compileLastC bi sources file name outPath failed done cs = case Driver.lastChecked
    cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProvidersC
        sources
        (nubStrM
           (List.map (\k -> Effect.moduleOfKey k) (Driver.candidateLeaves c)))
    rt <- readRuntimeC
    case name of
      -- (no computation named: each of the file's definitions, shown)
      Nothing -> do
        ok <- writeFile (zigBeside outPath) rt.zig
        compileJsOut
            outPath
            (not ok)
            (EmitC.compileCheckC
               rt.c
               c.top.globals
               (List.map
                  (\(o : Driver.Own) -> MkPair o.name o.key)
                  (Driver.listedOwn c)))
      -- (with the providers written by hand, the glue of the operations
      -- the effects' modules describe in C, made here)
      Just _ -> case Glue.gluesOf
          c.top.globals
          (providesLeafC found)
          (Driver.candidateLeaves c) of
        Left why -> do
          printErr ("heff: " ^ file ^ ": " ^ why)
          failed ("heff: " ^ file ^ ": " ^ why)
        Right glues ->
          compileFoundC
            bi
            file
            name
            outPath
            rt
            failed
            done
            c
            (List.append found (List.map EmitC.glueProvider glues))

-- | compile the computation `name` of FILE, loaded (`l`), to C -- one
-- | file, or, OUT a directory (`dir/`), a file a module -- then go on
-- | with `done`; with no `name`, one file that shows each of FILE's
-- | definitions asked for, as the tests ask
-- | as `cLoaded`, but where it cannot be compiled -- it has errors, said
-- | on the error stream -- `failed` of why, its first error, not the end
cLoadedOr : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> (String -> Co e Unit)
          -> Load.Loaded
          -> Maybe String
          -> String
          -> String
          -> Co e Unit
          -> Co e Unit
cLoadedOr failed l name outPath file done = do
  badL <- printErrs "heff" l.errors 0
  acc <- Session.cachedAcc l
  cs <- refusedChecked "c" l.sources acc.done
  putFileDiags cs
  if badL > 0 || anyErrors cs
  then failed
      (fromMaybe
         (file ^ ": it does not check")
         (firstErrorOf cs))
  else compileLastC
      (backInOf l acc)
      l.sources
      file
      name
      outPath
      failed
      done
      cs

cLoaded : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> Load.Loaded
        -> Maybe String
        -> String
        -> String
        -> Co e Unit
        -> Co e Unit
cLoaded l name outPath file done =
  cLoadedOr (\why -> exit 1) l name outPath file done

-- | compile the computation `name` of FILE to C, as `cLoaded`
cThen : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{rep : Report.report <: e}}
      -> Maybe String
      -> String
      -> String
      -> Co e Unit
      -> Co e Unit
cThen name outPath file done = do
  l <- load file
  cLoaded l name outPath file done

cCmd : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{rep : Report.report <: e}}
     -> Maybe String
     -> String
     -> String
     -> Co e Unit
cCmd name outPath file =
  cThen
    name
    outPath
    file
    (print
       ("wrote "
        ^ outPath
        ^ ": build it with `zig build-obj -O ReleaseFast "
        ^ zigOf outPath
        ^ " -femit-bin=runtime.o` and `zig cc -O2 "
        ^ (if endsWith "/" outPath then outPath ^ "*.c" else outPath)
        ^ " runtime.o -o PROGRAM -lm`"))

ranOut : Ran -> String
ranOut r = r.out

ranErr : Ran -> String
ranErr r = r.err

-- | where `heff build` writes the project's programs: `.heff/bin/`
binDir : Path.Style -> String
binDir st = HostPath.join st ".heff" "bin"

-- | what a build makes, and where: the project at `root`, its programs
-- | written to `bin`, each said as it is made (`wrote`, `installed`); a
-- | page's script made too, if `pages`; what the programs ship put in
-- | `shipTo`, if it is given; their C built by zig at `opt`
type Target =
  { root : String
  , bin : String
  , said : String
  , pages : Bool
  , shipTo : Maybe String
  , opt : String
  }

-- | `heff build`'s: the project at `root`, its programs in `.heff/bin/`,
-- | built for the next change made, not to run their fastest: `-O1`,
-- | which zig builds in half the time `-O2` takes (`heff install` builds
-- | them with `-O2`)
buildTarget : Path.Style -> String -> Target
buildTarget st root =
  { root = root
  , bin = HostPath.join st root (binDir st)
  , said = "wrote"
  , pages = True
  , shipTo = Nothing
  , opt = "-O1"
  }

-- (a path of the project)
inProject : Path.Style -> Target -> String -> String
inProject st t p = HostPath.join st t.root p

-- (`app/X/F`, of the project)
appFile : Path.Style -> Target -> String -> String -> String
appFile st t x f =
  inProject st t (HostPath.join st (HostPath.join st "app" x) f)

-- (where the program X is built: `.heff/build/X/`, its C and what is
-- made of it)
partsDir : Path.Style -> Target -> String -> String
partsDir st t x =
  inProject st t (HostPath.join st (HostPath.join st ".heff" "build") x)

-- (`n`, made of the program X, in the project: `.heff/build/X/n`)
builtAt : Path.Style -> Target -> String -> String -> String
builtAt st t x n = HostPath.join st (partsDir st t x) n

-- | a program of the project: `app/X/` with a build.hf is the program X,
-- | built as its build.hf says
type App = { name : String, build : Project.Build }

-- | the project's programs read so far, and the build.hf among them that
-- | could not be read
type Apps = { apps : List App, bad : Int }

-- (a file or a directory is at `path`)
isThere : {e : HFunctor} -> {{disk : filesystem <: e}} -> String -> Co e Bool
isThere path = do
  dir <- readDirectory path
  case dir of
    Just _ -> pure True
    Nothing -> do
      file <- readFile path
      pure (case file of
        Just _ -> True
        Nothing -> False)

-- (the names among `ns` that are not of the project's root)
notInProject : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> Path.Style
             -> Target
             -> List String
             -> Co e (List String)
notInProject st t Nil = pure Nil
notInProject st t (Cons n rest) = do
  ok <- isThere (inProject st t n)
  others <- notInProject st t rest
  pure (if ok then others else Cons n others)

-- (the program X, read from its build.hf, unless what it ships is not
-- all in the project: `missing`)
appShips : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> Path.Style
         -> Target
         -> Apps
         -> String
         -> Project.Build
         -> List String
         -> Co e Apps
appShips st t acc x a Nil =
  pure { apps = Cons { name = x, build = a } acc.apps, bad = acc.bad }
appShips st t acc x a missing = do
  printErr
      (appFile st t x "build.hf"
       ^ ": it ships "
       ^ joinWith ", " (List.map (\n -> "`" ^ n ^ "`") missing)
       ^ ", which the project does not have")
  pure { apps = acc.apps, bad = acc.bad + 1 }

-- (the directory app/X, with its build.hf's text, if it has one: the
-- program X read, or what is wrong with its build.hf said)
appRead : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> Path.Style
        -> Target
        -> Apps
        -> String
        -> Maybe String
        -> Co e Apps
appRead st t acc x Nothing = pure acc
appRead st t acc x (Just text) = case Project.readBuild text of
  Left p -> do
    printErr (Load.problemMsg (appFile st t x "build.hf") text p)
    pure { apps = acc.apps, bad = acc.bad + 1 }
  Right a -> do
    missing <- notInProject st t a.ships
    appShips st t acc x a missing

-- | the project's programs, among the directories of its app/: each one's
-- | build.hf read, before any is built (each one more of the task `rd`'s)
appsIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Path.Style
       -> Target
       -> Progress.Task
       -> Apps
       -> List String
       -> Co e Apps
appsIn st t rd acc Nil = pure { apps = List.reverse acc.apps, bad = acc.bad }
appsIn st t rd acc (Cons x rest) = do
  m <- readFile (appFile st t x "build.hf")
  next <- appRead st t acc x m
  Progress.complete rd
  appsIn st t rd next rest

-- (the task done with, then `next`)
ended : {e : HFunctor}
      -> {{prog : Progress.progress <: e}}
      -> Progress.Task
      -> Co e Unit
      -> Co e Unit
ended task next = do
  Progress.end task
  next

-- (said: `path` is made; then `next`)
wrote : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> Target
      -> String
      -> Co e Unit
      -> Co e Unit
wrote t path next = do
  print (t.said ^ " " ^ path)
  next

-- (the files of `dir` among `names` whose names end so, each its path)
endingIn : Path.Style -> String -> String -> List String -> List String
endingIn st dir ending names =
  List.map
    (\n -> HostPath.join st dir n)
    (List.keepIf (\n -> endsWith ending n) names)

-- (zig's mode for the runtime's Zig, at the level the C is built at:
-- `-O0` Debug and `-O1`, a build for the next change, ReleaseSafe, both
-- with zig's checks of what the runtime does; `-Os` ReleaseSmall; `-O2`
-- and `-O3` ReleaseFast)
zigMode : List String -> String
zigMode flags =
  if List.any (\f -> strEq f "-O0") flags then "Debug"
  else if List.any (\f -> strEq f "-O1") flags then "ReleaseSafe"
  else if List.any (\f -> strEq f "-Os") flags then "ReleaseSmall"
  else if List.any (\f -> strEq f "-O2" || strEq f "-O3") flags
  then "ReleaseFast"
  else "Debug"

-- (each of the runtime's Zig files built by zig, in `mode`, into an
-- object beside it, `F.o`, a task of `z`'s: the objects, or, where one
-- could not be built, what zig said written, none)
zigObjects : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{prog : Progress.progress <: e}}
           -> Progress.Task
           -> String
           -> List String
           -> List String
           -> Co e (Maybe (List String))
zigObjects z mode Nil made = pure (Just (List.reverse made))
zigObjects z mode (Cons f rest) made = do
  o <- pure (strSlice f 0 (strLength f - 4) ^ ".o")
  r <- Progress.runUnder z "zig" ["build-obj", f, "-O", mode, "-femit-bin=" ^ o]
  if succeeded r then zigObjects z mode rest (Cons o made)
  else do
    writeErr (ranErr r)
    pure Nothing

-- (the C files of `dir`, a file a module, by `zig cc` given these flags
-- (its level, and what else the program is built with) -- which builds
-- them at once, and again only those that changed -- the program `out`:
-- a task under `p` of as many items as files and the link, what zig
-- says of them under it; else said, by `who`, and the end)
zigBuildFlagsOr : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> {{prog : Progress.progress <: e}}
                -> (String -> Co e Unit)
                -> String
                -> Path.Style
                -> List String
                -> Progress.Task
                -> String
                -> String
                -> Co e Unit
                -> Co e Unit
zigBuildFlagsOr failed who st flags p dir out next = do
  names <- readDirectory dir
  files <- pure (endingIn st dir ".c" (fromMaybe Nil names))
  zigs <- pure (endingIn st dir ".zig" (fromMaybe Nil names))
  z <- Progress.start p "zig cc" (List.length files + List.length zigs + 1)
  objects <- zigObjects z (zigMode flags) zigs Nil
  r <- case objects of
    Just os ->
      Progress.runUnder
        z
        "zig"
        (Cons
           "cc"
           (List.append
              flags
              (Cons
                 "-w"
                 (List.append files (List.append os ["-o", out, "-lm"])))))
    Nothing -> pure { ended = NotRun, out = "", err = "" }
  Progress.end z
  if succeeded r then next
  else do
    writeErr (ranErr r)
    printErr (who ^ ": `zig cc` could not build " ^ out)
    failed (who ^ ": `zig cc` could not build " ^ out)

-- (as `zigBuildFlagsOr`, at the level `opt`)
zigBuildOr : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{prog : Progress.progress <: e}}
           -> (String -> Co e Unit)
           -> String
           -> Path.Style
           -> String
           -> Progress.Task
           -> String
           -> String
           -> Co e Unit
           -> Co e Unit
zigBuildOr failed who st opt p dir out next =
  zigBuildFlagsOr failed who st [opt] p dir out next

-- (as `zigBuildOr`, the end where it cannot build)
zigBuild : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{prog : Progress.progress <: e}}
         -> String
         -> Path.Style
         -> String
         -> Progress.Task
         -> String
         -> String
         -> Co e Unit
         -> Co e Unit
zigBuild who st opt p dir out next =
  zigBuildOr (\why -> exit 1) who st opt p dir out next

-- (`.heff/build/X/` by `zig cc` at the target's level, the program X,
-- `.heff/build/X/X`: a task under the program's, `p`)
zigCc : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{prog : Progress.progress <: e}}
      -> Path.Style
      -> Target
      -> Progress.Task
      -> String
      -> Co e Unit
      -> Co e Unit
zigCc st t p x next =
  zigBuild "heff build" st t.opt p (partsDir st t x) (builtAt st t x x) next

-- (where `heff run` builds FILE: `.heff/run/F/`, F its path, its
-- separators underscores)
runDir : Load.Paths -> String -> String
runDir paths file =
  Load.under
    paths
    (Load.under paths paths.root ".heff/run")
    (joinWith "_" (HostPath.components paths.style file))

-- (a program's file, named `n`, as the system names one: `n.exe` on
-- Windows)
programFile : Path.Style -> String -> String
programFile Windows n = n ^ ".exe"
programFile Posix n = n

-- (the program `heff run` builds of FILE, `.heff/run/F/main`)
runProgram : Load.Paths -> String -> String
runProgram paths file =
  Load.under paths (runDir paths file) (programFile paths.style "main")

-- | run FILE's `main` with ARGS: compiled to C in `.heff/run/F/` (a file
-- | a module, through the backend's cache), built there by `zig cc` at
-- | -O1 as `heff build` builds, and run in heff's place
runCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> {{prog : Progress.progress <: e}}
       -> String
       -> List String
       -> Co e Unit
runCmd file progArgs = do
  l <- load file
  p <- Progress.start Progress.root file 2
  c <- Progress.start p "compiling to C" 0
  cLoaded
      l
      (Just "main")
      (runDir l.paths file ^ "/")
      file
      (ended
         c
         (zigBuild
            "heff run"
            l.paths.style
            "-O1"
            p
            (runDir l.paths file)
            (runProgram l.paths file)
            (ended p (exec (runProgram l.paths file) progArgs))))

-- (the program X, compiled as its build.hf says, in `.heff/build/X/`,
-- then `next`: a task under `bp`, the programs', of its steps -- through
-- C, compiled, then built by zig; else compiled -- each a task under it
-- as it is done)
buildApp : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Path.Style
         -> Target
         -> Progress.Task
         -> String
         -> Project.Build
         -> Co e Unit
         -> Co e Unit
buildApp st t bp x a next =
  if strEq a.backend "c"
  then do
    p <- Progress.start bp x 2
    c <- Progress.start p "compiling to C" 0
    cThen
        (Just a.run)
        (partsDir st t x ^ "/")
        (appFile st t x "main.hf")
        (ended c (zigCc st t p x (ended p next)))
  else if t.pages
  then do
    p <- Progress.start bp x 1
    c <- Progress.start p "compiling for a page" 0
    made <- makeDirectory (partsDir st t x)
    compileThen
        (Just a.run)
        (builtAt st t x (x ^ ".js"))
        (appFile st t x "main.hf")
        (ended c (ended p next))
  else do
    print ("passed over " ^ x ^ ": a page's script, not a program")
    Progress.complete bp
    next

-- (each program, by its build.hf, then `done`)
buildEach : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> {{prog : Progress.progress <: e}}
          -> Path.Style
          -> Target
          -> Progress.Task
          -> Co e Unit
          -> List App
          -> Co e Unit
buildEach st t bp done Nil = done
buildEach st t bp done (Cons a rest) =
  buildApp st t bp a.name a.build (buildEach st t bp done rest)

-- (what cannot be put in `home` said: nothing more is done)
shipFails : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> String
          -> Co e Unit
shipFails why = do
  printErr ("heff: " ^ why)
  exit 1

-- (`fresh` moved to `to`, what was there moved aside to `old` first:
-- `old` then removed; or, `fresh` not moved, what was there put back)
shipMoved : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> Target
          -> String
          -> String
          -> String
          -> Co e Unit
          -> Bool
          -> Co e Unit
shipMoved t fresh old to next True = do
  _ <- remove old
  wrote t to next
shipMoved t fresh old to next False = do
  _ <- move old to
  _ <- remove fresh
  shipFails ("cannot put " ^ fresh ^ " in place of " ^ to)

-- (the file or directory `n` of the project put in `home`, in place of
-- what was there: copied into `home` first, as `.n.new`, then moved to
-- `n`, so that a failure leaves the whole of what was there, not a part
-- of either; then `next` (a task under `sh`, the shipping's, meanwhile)
shipOne : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> String
        -> Progress.Task
        -> Co e Unit
        -> String
        -> Co e Unit
shipOne st t home sh next n = do
  it <- Progress.start sh n 0
  fresh <- pure (HostPath.join st home ("." ^ n ^ ".new"))
  old <- pure (HostPath.join st home ("." ^ n ^ ".old"))
  _ <- remove fresh
  _ <- remove old
  copied <- copy (inProject st t n) fresh
  if copied
  then do
    -- (nothing there, nothing moved aside)
    _ <- move (HostPath.join st home n) old
    moved <- move fresh (HostPath.join st home n)
    shipMoved t fresh old (HostPath.join st home n) (ended it next) moved
  else do
    _ <- remove fresh
    shipFails ("cannot copy " ^ inProject st t n ^ " to " ^ fresh)

shipAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> String
        -> Progress.Task
        -> Co e Unit
        -> List String
        -> Co e Unit
shipAll st t home sh next Nil = next
shipAll st t home sh next (Cons n rest) =
  shipOne st t home sh (shipAll st t home sh next rest) n

-- | what the programs ship, each named once
shippedBy : List App -> List String
shippedBy progs = nubStrM (List.concatMap (\(a : App) -> a.build.ships) progs)

-- (what the programs ship, put in `t.shipTo` if it is given, a task
-- meanwhile; then `done`)
shipIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Path.Style
       -> Target
       -> Co e Unit
       -> List App
       -> Maybe String
       -> Co e Unit
shipIn st t done progs Nothing = done
shipIn st t done progs (Just home) = do
  sh <-
    Progress.start
      Progress.root
      ("installing in " ^ home)
      (List.length (shippedBy progs))
  shipAll st t home sh (ended sh done) (shippedBy progs)

-- (what the program puts in `t.bin`, by its build.hf: itself, or, if
-- `t.pages`, a page's script)
madeAs : Target -> App -> Maybe String
madeAs t a =
  if strEq a.build.backend "c" then Just a.name
  else if t.pages then Just (a.name ^ ".js")
  else Nothing

-- (`n`, made of the program X, put in `t.bin` in place of what was
-- there: copied beside it first, as `.n.new`, then renamed to `n`, which
-- is done at once, so that what runs it meanwhile runs the one or the
-- other, never a part of either; or, the copy gone and what was there
-- kept, nothing more done (as on Windows, where nothing is put in place
-- of a program running); then `next` (a task under `pl`, the programs',
-- meanwhile)
placeMade : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{prog : Progress.progress <: e}}
          -> Path.Style
          -> Target
          -> Progress.Task
          -> Co e Unit
          -> String
          -> Maybe String
          -> Co e Unit
placeMade st t pl next x Nothing = do
  Progress.complete pl
  next
placeMade st t pl next x (Just n) = do
  it <- Progress.start pl n 0
  fresh <- pure (HostPath.join st t.bin ("." ^ n ^ ".new"))
  _ <- remove fresh
  copied <- copy (builtAt st t x n) fresh
  placed <-
    if copied then replace fresh (HostPath.join st t.bin n) else pure False
  if placed then wrote t (HostPath.join st t.bin n) (ended it next)
  else do
    _ <- remove fresh
    shipFails
        ("cannot put "
         ^ builtAt st t x n
         ^ " in place of "
         ^ HostPath.join st t.bin n)

placeAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Path.Style
         -> Target
         -> Progress.Task
         -> Co e Unit
         -> List App
         -> Co e Unit
placeAll st t pl next Nil = next
placeAll st t pl next (Cons a rest) =
  placeMade st t pl (placeAll st t pl next rest) a.name (madeAs t a)

-- (the programs, built, put in `t.bin`, a task meanwhile; then `next`)
placeIn : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> Co e Unit
        -> List App
        -> Co e Unit
placeIn st t next progs = do
  ok <- makeDirectory t.bin
  pl <-
    Progress.start
      Progress.root
      ("putting the programs in " ^ t.bin)
      (List.length progs)
  placeAll st t pl (ended pl next) progs

-- (the programs, built in the project, then put in `t.bin`, and what
-- they ship put where `t` says: none put anywhere unless all are built;
-- then `done`)
buildPrograms : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> {{rep : Report.report <: e}}
              -> {{prog : Progress.progress <: e}}
              -> Path.Style
              -> Target
              -> Co e Unit
              -> List App
              -> Co e Unit
buildPrograms st t done progs = do
  okC <- makeDirectory (inProject st t (HostPath.join st ".heff" "build"))
  bp <- Progress.start Progress.root "building programs" (List.length progs)
  buildEach
      st
      t
      bp
      (ended bp (placeIn st t (shipIn st t done progs t.shipTo) progs))
      progs

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.` passed over)
hfFilesGo : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> List String
          -> Co e (List String)
hfFilesGo Nil acc = pure (List.reverse acc)
hfFilesGo (Cons p rest) acc = do
  names <- readDirectory p
  case names of
    Just ns -> do
      st <- styleNow
      hfFilesGo
          (List.append
             (List.map
                (\n -> HostPath.join st p n)
                (List.keepIf (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then hfFilesGo rest (Cons p acc)
      else hfFilesGo rest acc

-- | the modules of the project checked so far, and the errors found
type Checks = { seen : List String, errors : Int }

errorCount : List Driver.Checked -> Int
errorCount cs =
  List.foldl
    (\n (c : Driver.Checked) -> n + List.length (Driver.errorsIn c))
    0
    cs

-- | FILE, a module of the project, checked with what it imports, unless
-- | it was among what a module checked before imports; the diagnostics
-- | of each module of the project's src/ said once (one more of the
-- | task `chk`'s: checked, a task under it meanwhile)
checkModule : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> {{prog : Progress.progress <: e}}
            -> Progress.Task
            -> Checks
            -> String
            -> Co e Checks
checkModule chk acc f = do
  h <- hostNow
  ps <- Load.pathsFor h f
  if elemStrM (Load.moduleOf ps f) acc.seen
  then do
    Progress.complete chk
    pure acc
  else do
    m <- Progress.start chk (Load.moduleOf ps f) 0
    l <- load f
    badL <- printErrs "heff" l.errors 0
    cs <- Session.cachedProgram l
    own <-
      pure
        (List.keepIf
           (\(c : Driver.Checked) ->
              (Load.inside l.paths l.paths.src c.path
               || strEq c.module (Load.moduleOf ps f))
              && not (elemStrM c.module acc.seen))
           cs)
    putFileDiags own
    Progress.end m
    pure
        { seen =
            List.append
              (List.map (\(c : Driver.Checked) -> c.module) own)
              acc.seen
        , errors = acc.errors + badL + errorCount own
        }

checkModules : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> {{prog : Progress.progress <: e}}
             -> Progress.Task
             -> Checks
             -> List String
             -> Co e Checks
checkModules chk acc Nil = pure acc
checkModules chk acc (Cons f rest) = do
  next <- checkModule chk acc f
  checkModules chk next rest

-- (`n` modules)
modulesSaid : Int -> String
modulesSaid 1 = "1 module"
modulesSaid n = show n ^ " modules"

-- (`n` errors)
errorsSaid : Int -> String
errorsSaid 1 = "1 error"
errorsSaid n = show n ^ " errors"

-- (what is wrong with the project, said: nothing built)
nothingBuilt : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> String
             -> String
             -> Co e Unit
nothingBuilt cmd what = do
  printErr ("heff " ^ cmd ^ ": " ^ what ^ ": nothing built")
  exit 1

-- | the whole project at `t.root` built: every module of its src/
-- | checked, and every program's build.hf read, then, if none has an
-- | error, every program of its app/ built (with none, `none`), then
-- | `done`; each a task as it is done
buildProject : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> {{prog : Progress.progress <: e}}
             -> Path.Style
             -> String
             -> Target
             -> Co e Unit
             -> Co e Unit
             -> Co e Unit
buildProject st cmd t none done = do
  files <- hfFilesGo [inProject st t "src"] Nil
  chk <- Progress.start Progress.root "checking modules" (List.length files)
  checked <- checkModules chk { seen = Nil, errors = 0 } files
  Progress.end chk
  if checked.errors > 0
  then nothingBuilt
      cmd
      (errorsSaid checked.errors ^ " in the project's modules")
  else do
    print
        ("heff "
         ^ cmd
         ^ ": "
         ^ modulesSaid (List.length checked.seen)
         ^ " checked")
    found <- readDirectory (inProject st t "app")
    rd <-
      Progress.start
        Progress.root
        "reading the programs' build.hf"
        (List.length (fromMaybe Nil found))
    progs <- appsIn st t rd { apps = Nil, bad = 0 } (fromMaybe Nil found)
    Progress.end rd
    if progs.bad > 0
    then nothingBuilt
        cmd
        (errorsSaid progs.bad ^ " in the programs' build.hf")
    else case progs.apps of
      Nil -> none
      _ -> buildPrograms st t done progs.apps

-- | build the project here, the whole of it: every module of its src/
-- | checked, then every program of it built: `app/X/` with a build.hf is
-- | the program X, app/X/main.hf compiled as its build.hf says, to
-- | `.heff/bin/`
buildCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Co e Unit
buildCmd = do
  text <- readFile "package.hf"
  st <- styleNow
  case text of
    Nothing -> do
      printErr "heff build: no package.hf here: build at the project's root"
      exit 1
    Just _ ->
      buildProject st "build" (buildTarget st ".") (pure MkUnit) (pure MkUnit)

-- (the directories of a PATH, on the platform `p`)
pathDirs : String -> String -> List String
pathDirs p path = split (if strEq p "win32" then ";" else ":") path

-- (a hint, if `bin` is not on the PATH)
onPathHint : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> Path.Style
           -> String
           -> Co e Unit
onPathHint st bin = do
  p <- platform
  path <- getEnv "PATH"
  if List.any
       (\d -> strEq (HostPath.join st d ".") (HostPath.join st bin "."))
       (pathDirs p (fromMaybe "" path))
  then pure MkUnit
  else print
      ("heff install: "
       ^ bin
       ^ " is not on the PATH: add it there to run them by their names")

-- (the package.hf's text, read, names heff's own package)
heffRead : Either Project.Problem Project.Package -> Bool
heffRead (Right pk) = strEq pk.module Project.heffModule
heffRead (Left _) = False

isHeffPackage : Maybe String -> Bool
isHeffPackage (Just text) = heffRead (Project.readPackage text)
isHeffPackage Nothing = False

-- (heff's own package installed from `dir` -- where heff is from, or it
-- would not have been built: the heff home says it was the checkout,
-- for any heff to take that checkout as heff's own; then `next`)
sourceSaved : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> Path.Style
            -> Target
            -> String
            -> String
            -> Co e Unit
            -> Co e Unit
sourceSaved st t home dir next = do
  cwd <- cwdNow
  ok <-
    writeFile
      (sourceFile st home)
      (HostPath.normalize st (HostPath.join st cwd dir) ^ "\n")
  if ok then wrote t (sourceFile st home) next
  else shipFails ("cannot write " ^ sourceFile st home)

-- | install the project at DIR: built as `heff build` builds it, but to
-- | run its fastest (zig's `-O2`), its programs into the heff home's
-- | `bin/` (`HEFF_HOME/bin`, `~/.heff/bin`), and what they ship (their
-- | build.hf's `ships`) into the heff home, beside `bin/`; heff's own
-- | package installed, the heff home's `source` says the checkout DIR is
installCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> {{prog : Progress.progress <: e}}
           -> String
           -> Co e Unit
installCmd dir = do
  st <- styleNow
  home <- heffHome
  text <- readFile (HostPath.join st dir "package.hf")
  t <-
    pure
      { root = dir
      , bin = HostPath.join st home "bin"
      , said = "installed"
      , pages = False
      , shipTo = Just home
      , opt = "-O2"
      }
  case text of
    Nothing -> do
      printErr ("heff install: no package.hf in " ^ dir)
      exit 1
    Just _ ->
      buildProject
        st
        "install"
        t
        (do
         printErr
             ("heff install: no programs in "
              ^ dir
              ^ ": app/X/ with a build.hf is the program X")
         exit 1)
        (if isHeffPackage text
         then sourceSaved st t home dir (onPathHint st t.bin)
         else onPathHint st t.bin)

-- | how `heff compile` was called: FILE, OUT, `--name`, `--backend`
type CompileOpts =
  { file : String, outPath : String, name : Maybe String, backend : String }

-- | `heff compile`, by its backend
compileTo : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> CompileOpts
          -> Co e Unit
compileTo o =
  if strEq o.backend "page" then appCmd o.name o.outPath o.file
  else if strEq o.backend "esm"
  then case o.name of
    Nothing -> compileJsCmd o.file o.outPath
    Just n -> do
      printErr
          "heff compile: an ES module runs nothing: no --name with --backend=esm"
      exit 1
  else if strEq o.backend "c" then cCmd o.name o.outPath o.file
  else do
    printErr ("heff compile: no backend " ^ o.backend ^ ": esm, page or c")
    exit 1

-- (each value printed; whether the evaluation of one met a bug of the
-- compiler, which fails)
printEvals : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> List Driver.Evaluated
           -> Co e Bool
printEvals Nil = pure False
printEvals (Cons d rest) = do
  print (d.name ^ " = " ^ d.value)
  bug <- printEvals rest
  pure (d.bug || bug)

evalDiags : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Report.report <: e}}
          -> Bool
          -> List Driver.Checked
          -> Co e Unit
evalDiags badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      bug <- printEvals (Driver.evaluate c)
      if badL || anyErrors cs || bug then exit 1 else pure MkUnit

-- | print what each definition of FILE evaluates to
evalCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> String
        -> Co e Unit
evalCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  evalDiags (badL > 0) cs

promoteDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> String
             -> Bool
             -> List Driver.Checked
             -> Co e Unit
promoteDiags file badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      if badL || anyErrors cs then exit 1
      else do
        ok <- writeFile file (Driver.promote c)
        if ok then pure MkUnit else exit 1

-- | write each watch's and doc test's value under it as its expectation
promoteCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Co e Unit
promoteCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  promoteDiags file (badL > 0) cs

-- | what testing files came to: how many files, of them how many
-- | expect errors (and have them), the expectations and how many do
-- | not hold, a line each for the files that do not check as they should
-- | (where they first went wrong), the tests and how many fail
type TestRes =
  { files : Int
  , expectErrors : Int
  , total : Int
  , failed : Int
  , unchecked : List String
  , tests : Int
  , testsFailed : Int
  , testsSkipped : Int
  }

-- | nothing tested yet
noRes : TestRes
noRes =
  { files = 0
  , expectErrors = 0
  , total = 0
  , failed = 0
  , unchecked = Nil
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- | what two runs came to, together
addRes : TestRes -> TestRes -> TestRes
addRes a b =
  { files = a.files + b.files
  , expectErrors = a.expectErrors + b.expectErrors
  , total = a.total + b.total
  , failed = a.failed + b.failed
  , unchecked = List.append a.unchecked b.unchecked
  , tests = a.tests + b.tests
  , testsFailed = a.testsFailed + b.testsFailed
  , testsSkipped = a.testsSkipped + b.testsSkipped
  }

-- (a file that does not check as it should, `why`)
uncheckedRes : String -> TestRes
uncheckedRes why =
  { files = 1
  , expectErrors = 0
  , total = 0
  , failed = 0
  , unchecked = [why]
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- (a file that expects errors, and has them)
expectedRes : TestRes
expectedRes =
  { files = 1
  , expectErrors = 1
  , total = 0
  , failed = 0
  , unchecked = Nil
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- | how `heff test` runs the tests: the seed of the properties, the
-- | pattern of the tests run (`--run`; `""`: all), how many integration
-- | tests at once, and whether golden texts are written, not held to
type TestOpts = { seed : Int, pattern : String, jobs : Int, update : Bool }

-- | a file checked, its expectations held and its unit tests and
-- | properties run, its integration tests not yet: its name, where it
-- | went wrong, its expectations, what came of its tests, the
-- | integration tests (each name and time limit), and the file loaded
-- | and checked, to build them of
type Pending =
  { file : String
  , wrong : List String
  , reports : List Driver.TestReport
  , outcomes : List Driver.TestOutcome
  , integrations : List (Pair String Int)
  , loaded : Load.Loaded
  , checked : Driver.Checked
  }

-- | a file tested: done with, or its integration tests to run yet
data Tested = Settled TestRes | Pend Pending

failLine : String -> Driver.TestReport -> Report.Mismatch -> String
failLine f r m =
  "FAIL "
  ^ f
  ^ ":"
  ^ show r.line
  ^ (case r.owner of
     Just n -> " (" ^ n ^ ")"
     Nothing -> "")
  ^ ": "
  ^ r.watch.expr
  ^ "\n  expected "
  ^ m.expected
  ^ "\n  but got  "
  ^ m.got
  ^ "\n  diff     "
  ^ m.diff

-- (each expectation that does not hold, and what differs, in colour on
-- a terminal)
printFails : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> String
           -> Bool
           -> List Driver.TestReport
           -> Co e Unit
printFails f color Nil = pure MkUnit
printFails f color (Cons r rest) = do
  print
      (failLine
         f
         r
         (Report.mismatch color (fromMaybe "" r.watch.expected) r.watch.value))
  printFails f color rest

badReports : List Driver.TestReport -> List Driver.TestReport
badReports rs = List.keepIf (\(r : Driver.TestReport) -> not r.watch.holds) rs

-- (`n` of `total`, as a part of a hundred)
percent : Int -> Int -> String
percent n total = show (if total == 0 then 0 else n * 100 / total) ^ "%"

-- | a property's statistic: how many runs held, how many were given up
-- | on, and how many had each label -- so that a property that holds
-- | only of what is trivial shows
statistic : Driver.TestOutcome -> String
statistic o =
  show o.runs
  ^ " runs"
  ^ (if o.discarded > 0 then ", " ^ show o.discarded ^ " given up on"
     else "")
  ^ joinWith
    ""
    (List.map
       (\(p : Pair String Int) -> ", " ^ percent (snd p) o.runs ^ " " ^ fst p)
       o.labels)

-- (how many shrinks made the counterexample)
shrunk : Int -> String
shrunk 0 = "not shrunk"
shrunk 1 = "shrunk once"
shrunk n = "shrunk " ^ show n ^ " times"

-- (a test's line, of one that ran)
ranLine : Driver.TestOutcome -> String
ranLine o =
  (if o.ok then "  ok    " else "  FAIL  ")
  ^ o.name
  ^ (if not o.property then ""
     else if o.ok then "  (" ^ statistic o ^ ")"
     else "  (failed after "
       ^ show o.runs
       ^ " runs held"
       ^ (if o.discarded > 0 then ", " ^ show o.discarded ^ " given up on"
          else "")
       ^ "; "
       ^ shrunk o.shrinks
       ^ "; again: --seed "
       ^ show o.seed
       ^ ")")

-- | a test's line: whether it held, its name, and for a property its
-- | statistic -- and if it failed, how far its counterexample was
-- | shrunk and the seed that runs it again; a test skipped, why
outcomeLine : Driver.TestOutcome -> String
outcomeLine o = case o.skipped of
  Just why -> "  skip  " ^ o.name ^ "  (" ^ why ^ ")"
  Nothing -> ranLine o

mismatchLines : Report.Mismatch -> List String
mismatchLines m =
  [ "        expected " ^ m.expected
  , "        but got  " ^ m.got
  , "        diff     " ^ m.diff
  ]

failLines : Bool -> Driver.TestFailure -> List String
failLines color (FailBecause why) = ["        " ^ why]
failLines color (FailDiffer expected got) =
  mismatchLines (Report.mismatch color expected got)

failureLines : Bool -> Maybe Driver.TestFailure -> List String
failureLines color Nothing = Nil
failureLines color (Just f) = failLines color f

-- | what came of each test: a line each, and under one that failed its
-- | counterexample (what it drew and noted) and what was wrong
printOutcomes : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> Bool
              -> List Driver.TestOutcome
              -> Co e Unit
printOutcomes color Nil = pure MkUnit
printOutcomes color (Cons o rest) = do
  print (outcomeLine o)
  if o.ok then pure MkUnit
  else print
      (joinWith
         "\n"
         (List.append
            (List.map (\n -> "        " ^ n) o.notes)
            (failureLines color o.failure)))
  printOutcomes color rest

badOutcomes : List Driver.TestOutcome -> List Driver.TestOutcome
badOutcomes os = List.keepIf (\(o : Driver.TestOutcome) -> not o.ok) os

skippedOutcomes : List Driver.TestOutcome -> List Driver.TestOutcome
skippedOutcomes os =
  List.keepIf
    (\(o : Driver.TestOutcome) -> maybe False (\why -> True) o.skipped)
    os

-- (how many were skipped: said only if some were)
skippedSaid : Int -> String
skippedSaid 0 = ""
skippedSaid n = ", " ^ show n ^ " skipped"

-- (how many tests held, of how many, and how many were skipped: said
-- only of a file that has some)
testsSaid : List Driver.TestOutcome -> String
testsSaid Nil = ""
testsSaid os =
  ", tests "
  ^ show
    (List.length os
     - List.length (badOutcomes os)
     - List.length (skippedOutcomes os))
  ^ "/"
  ^ show (List.length os)
  ^ skippedSaid (List.length (skippedOutcomes os))

testReport : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> List String
           -> List Driver.TestReport
           -> List Driver.TestOutcome
           -> Co e TestRes
testReport f wrong ts os = do
  color <- Report.useColor
  printFails f color (badReports ts)
  printOutcomes color os
  print
      ((if List.null (badReports ts)
           && List.null (badOutcomes os)
           && List.null wrong
        then "ok    "
        else "FAIL  ")
       ^ f
       ^ "  "
       ^ show (List.length ts - List.length (badReports ts))
       ^ "/"
       ^ show (List.length ts)
       ^ testsSaid os)
  pure
      { files = 1
      , expectErrors = 0
      , total = List.length ts
      , failed = List.length (badReports ts)
      , unchecked = wrong
      , tests = List.length os
      , testsFailed = List.length (badOutcomes os)
      , testsSkipped = List.length (skippedOutcomes os)
      }

-- | the first thing wrong with a file, its line in `heff test`'s list of
-- | the files that do not check: a module not loaded, else the first
-- | error, `path:line:col: error[E…]: what`
firstWrong : String -> List String -> List Driver.Checked -> String
firstWrong f (Cons why _) cs = why
firstWrong f Nil cs = fromMaybe (f ^ ": not checked") (firstErrorOf cs)

-- (a file checked: its expectations, and what came of its tests run
-- here, those selected; its integration tests to run yet)
pendingOf : TestOpts
          -> String
          -> List String
          -> Load.Loaded
          -> Driver.Checked
          -> Driver.TestsRun
          -> Pending
pendingOf opts f wrong l c run =
  { file = f
  , wrong = wrong
  , reports = Driver.testFile c
  , outcomes = run.outcomes
  , integrations = run.integrations
  , loaded = l
  , checked = c
  }

-- | a file checked, its tests run: passed over, nothing said of it, where
-- | `--run` gives a pattern that selects none of its tests
selectedOf : TestOpts -> Pending -> Tested
selectedOf opts p =
  if not (strEq opts.pattern "")
     && List.null p.outcomes
     && List.null p.integrations
  then Settled noRes
  else Pend p

testOneC : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> String
         -> Load.Loaded
         -> List Driver.Checked
         -> Co e Tested
testOneC opts f l cs = do
  bad <- diagCount cs
  case Driver.lastChecked cs of
    Nothing -> do
      print ("FAIL  " ^ f ^ "  0/0")
      pure (Settled (uncheckedRes (firstWrong f l.errors cs)))
    Just c ->
      pure
        (if List.null l.errors && bad == 0
         then selectedOf
             opts
             (pendingOf
                opts
                f
                Nil
                l
                c
                (Driver.runTests opts.pattern opts.seed c))
         else Pend
             (pendingOf
                opts
                f
                [firstWrong f l.errors cs]
                l
                c
                { outcomes = Nil, integrations = Nil }))

-- | the line that, the first of a file, says that the file is to report
-- | errors (a test of them): `heff test` passes it if it does, fails it
-- | if it checks, and says nothing of its errors
expectErrorsLine : String
expectErrorsLine = "-- test: expect errors"

-- | does the file's first line say it expects errors
-- | >>> List.map expectsErrors ["-- test: expect errors\nx = y\n", "-- test: expect errors", "x : Int\n-- test: expect errors\n", ""]
-- | [True, True, False, False]
expectsErrors : String -> Bool
expectsErrors src =
  strEq
    (strSlice src 0 (fromMaybe (strLength src) (indexOf "\n" src)))
    expectErrorsLine

-- (a file that expects errors: whether it has some)
testExpecting : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> String
              -> Bool
              -> Co e TestRes
testExpecting f True = do
  print ("ok    " ^ f ^ "  errors, as expected")
  pure expectedRes
testExpecting f False = do
  print ("FAIL  " ^ f ^ "  checks, but expects errors")
  pure (uncheckedRes (f ^ ": checks, but its first line expects errors"))

-- (a file loaded, tested: one that expects errors held to having some,
-- or passed over where `--run` selects tests, as it has none)
testLoaded : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> TestOpts
           -> String
           -> Bool
           -> Load.Loaded
           -> Co e Tested
testLoaded opts f True l =
  if not (strEq opts.pattern "") then pure (Settled noRes)
  else do
    cs <- Session.cachedProgram l
    r <- testExpecting f (not (List.null l.errors) || anyErrors cs)
    pure (Settled r)
testLoaded opts f False l = do
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  testOneC opts f l cs

testOneF : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> String
         -> Co e Tested
testOneF opts f = do
  src <- readFile f
  l <- load f
  testLoaded opts f (expectsErrors (fromMaybe "" src)) l

-- Golden texts
--------------------------------------------------------------------------------

-- (a byte a golden text's name may have)
goldenByte : Int -> Bool
goldenByte c =
  (c >= 48 && c <= 57)
  || (c >= 65 && c <= 90)
  || (c >= 97 && c <= 122)
  || c == 45
  || c == 95
  || c == 46

-- (a part of a golden text's name, between its `/`s: letters, digits,
-- `-`, `_` and `.`, not first)
goldenPart : String -> Bool
goldenPart n =
  strLength n > 0
  && byteAt n 0 /= 46
  && List.all (\i -> goldenByte (byteAt n i)) (List.range 0 (strLength n - 1))

-- | is it a golden text's name: parts of letters, digits, `-`, `_` and
-- | `.`, not first, between `/`s, so that it names a file under the
-- | directory and nothing else
-- | >>> List.map goldenName ["parse-error.txt", "eval/lib/list.hf.txt", "", ".hidden", "a/../b", "/a", "a/", "a b"]
-- | [True, True, False, False, False, False, False, False]
goldenName : String -> Bool
goldenName n = List.all goldenPart (split "/" n)

-- | where the golden text `name` of the test file `f` is kept: in the
-- | directory beside it named as it, without its `.hf`, with `.golden`
-- | >>> goldenPath Posix "test/check/golden.hf" "hello"
-- | "test/check/golden.golden/hello"
goldenPath : Path.Style -> String -> String -> String
goldenPath st f name =
  HostPath.join
    st
    ((if endsWith ".hf" f then strSlice f 0 (strLength f - 3) else f)
     ^ ".golden")
    name

-- | what came of holding a golden text to the one kept: it holds, it was
-- | written there (`--update`), or it does not hold (what is noted of
-- | it, and why)
data GoldenSaid = Holds | Wrote String | Wrong String Driver.TestFailure

-- (a line of a text, or none past its end)
lineOr : List String -> String
lineOr Nil = ""
lineOr (Cons l _) = l

-- | where two texts, cut into lines, first differ: the line's number,
-- | counted from `n`, and what each has there
firstDiffering : Int
               -> List String
               -> List String
               -> Pair Int (Pair String String)
firstDiffering n (Cons a argv) (Cons b bs) =
  if strEq a b then firstDiffering (n + 1) argv bs
  else MkPair n (MkPair a b)
firstDiffering n argv bs = MkPair n (MkPair (lineOr argv) (lineOr bs))

-- (a golden text that is not the one kept: the first line where they
-- differ, as a long text's whole would be too much to see)
differsAt : String -> Pair Int (Pair String String) -> GoldenSaid
differsAt path (MkPair n (MkPair kept text)) =
  Wrong
    ("golden " ^ path ^ ", line " ^ show n)
    (FailDiffer (show kept) (show text))

-- (the text, held to the one kept, or written there)
goldenAgainst : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> Bool
              -> String
              -> String
              -> String
              -> Maybe String
              -> Co e GoldenSaid
goldenAgainst update dir path text (Just kept) =
  if strEq kept text then pure Holds
  else if update
  then do
    ok <- writeFile path text
    pure
        (if ok then Wrote path
         else Wrong ("golden " ^ path) (FailBecause "could not be written"))
  else pure
      (differsAt path (firstDiffering 1 (split "\n" kept) (split "\n" text)))
goldenAgainst update dir path text Nothing =
  if update
  then do
    made <- makeDirectory dir
    ok <- writeFile path text
    pure
        (if ok then Wrote path
         else Wrong ("golden " ^ path) (FailBecause "could not be written"))
  else pure
      (Wrong
         ("golden " ^ path)
         (FailBecause "not kept yet: `heff test --update` writes it"))

-- (a golden text of the test file `f`, held or written)
goldenSaid : {e : HFunctor}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Bool
           -> String
           -> Pair String String
           -> Co e GoldenSaid
goldenSaid update f (MkPair name text) =
  if not (goldenName name)
  then pure
      (Wrong
         ("golden " ^ show name)
         (FailBecause
            "a golden text's name is a file's under the directory: letters, digits, `-`, `_` and `.`, not first, between `/`s"))
  else do
    st <- styleNow
    kept <- readFile (goldenPath st f name)
    goldenAgainst
        update
        (HostPath.dirname st (goldenPath st f name))
        (goldenPath st f name)
        text
        kept

-- (the outcome, failed: what was noted, and why)
outcomeFailed : Driver.TestOutcome
              -> String
              -> Driver.TestFailure
              -> Driver.TestOutcome
outcomeFailed o note why =
  { name = o.name
  , ok = False
  , skipped = Nothing
  , property = o.property
  , runs = o.runs
  , discarded = o.discarded
  , shrinks = o.shrinks
  , labels = o.labels
  , notes = List.append o.notes [note]
  , failure = Just why
  , seed = o.seed
  , goldens = o.goldens
  }

-- (the outcome's golden texts from these on, each held or written: the
-- outcome, failed at the first that does not hold)
goldensGo : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> Bool
          -> String
          -> Driver.TestOutcome
          -> List (Pair String String)
          -> Co e Driver.TestOutcome
goldensGo update f o Nil = pure o
goldensGo update f o (Cons g rest) = do
  said <- goldenSaid update f g
  case said of
    Holds -> goldensGo update f o rest
    Wrote path -> do
      print ("wrote " ^ path)
      goldensGo update f o rest
    Wrong note why -> pure (outcomeFailed o note why)

-- | each outcome that held, its golden texts held to those kept beside
-- | the file (or written there, `update`): one that does not hold fails
-- | it.  A test that failed is not held to them, nor are they written.
withGoldens : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> Bool
            -> String
            -> List Driver.TestOutcome
            -> Co e (List Driver.TestOutcome)
withGoldens update f Nil = pure Nil
withGoldens update f (Cons o rest) = do
  held <- if o.ok then goldensGo update f o o.goldens else pure o
  others <- withGoldens update f rest
  pure (Cons held others)

-- Integration tests
--------------------------------------------------------------------------------

-- | what `heff test` names the program it adds to a file to run its
-- | integration tests (check's `integrationMain` of them)
integrationMainName : String
integrationMainName = "heffTestIntegrations"

-- (how a file names what check defines: `Alias.`, or nothing where it
-- imports it with no name)
prefixOf : Maybe String -> String
prefixOf (Just alias) = alias ^ "."
prefixOf Nothing = ""

qualifierOf : List Import.Import -> Maybe String
qualifierOf Nil = Nothing
qualifierOf (Cons i rest) =
  if strEq i.name "check" then Just (prefixOf i.alias) else qualifierOf rest

-- (the program added to the file's text: check's `integrationMain` of
-- its tests)
integrationText : String -> List Driver.Own -> String
integrationText q ts =
  "\n\n"
  ^ integrationMainName
  ^ " : "
  ^ q
  ^ "Integrations\n"
  ^ integrationMainName
  ^ " = "
  ^ q
  ^ "integrationMain ["
  ^ joinWith ", " (List.map (\(o : Driver.Own) -> o.name) ts)
  ^ "]\n"

-- (the file's source, the program added to it)
withProgram : String -> Driver.Source -> Driver.Source
withProgram text s =
  { module = s.module
  , named = s.named
  , path = s.path
  , shown = s.shown
  , source = s.source ^ text
  , renames = s.renames
  , implicit = s.implicit
  , library = s.library
  }

-- (the imports a file writes)
writtenImports : Import.Imports -> List Import.Import
writtenImports imps = imps.imports

-- (the sources, the file's with the program added)
sourcesWith : String -> String -> List Driver.Source -> List Driver.Source
sourcesWith m text sources =
  List.map
    (\(o : Driver.Source) -> if strEq o.module m then withProgram text o else o)
    sources

-- (what was loaded, its sources these)
loadedWith : Load.Loaded -> List Driver.Source -> Load.Loaded
loadedWith l sources =
  { sources = sources
  , errors = l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- (the file's source, how it names check: the program added to it)
programAdded : Pending -> Driver.Source -> Either String Load.Loaded
programAdded p src = case qualifierOf
    (writtenImports (Driver.importsOfSource src)) of
  Nothing -> Left "its file does not import check, which runs it"
  Just q ->
    Right
      (loadedWith
         p.loaded
         (sourcesWith
            p.checked.module
            (integrationText q (Driver.testsOf p.checked))
            p.loaded.sources))

-- (the file loaded, its source with the program added: else why it
-- cannot be, as it imports no check)
integrationLoaded : Pending -> Either String Load.Loaded
integrationLoaded p = case List.find
    (\(src : Driver.Source) -> strEq src.module p.checked.module)
    p.loaded.sources of
  Nothing -> Left "its file is not among those loaded"
  Just src -> programAdded p src

-- (an integration test that came to no outcome, and why)
brokenTest : String -> String -> Driver.TestOutcome
brokenTest name why =
  { name = name
  , ok = False
  , skipped = Nothing
  , property = False
  , runs = 0
  , discarded = 0
  , shrinks = 0
  , labels = Nil
  , notes = Nil
  , failure = Just (FailBecause why)
  , seed = 0
  , goldens = Nil
  }

jsonText : JSON.Json -> String
jsonText (JString t) = t
jsonText _ = ""

jsonGolden : JSON.Json -> Pair String String
jsonGolden (JArray (Cons n (Cons t _))) = MkPair (jsonText n) (jsonText t)
jsonGolden _ = MkPair "" ""

jsonFailure : JSON.Json -> Maybe Driver.TestFailure
jsonFailure j = case JSON.str ["because"] j of
  Just why -> Just (FailBecause why)
  Nothing -> case JSON.arr ["differ"] j of
    Just (Cons expected (Cons got _)) ->
      Just (FailDiffer (jsonText expected) (jsonText got))
    _ -> Nothing

-- (an outcome as an integration test's program writes it)
outcomeOfJson : String -> JSON.Json -> Driver.TestOutcome
outcomeOfJson name j =
  { name = name
  , ok = fromMaybe False (JSON.bool ["ok"] j)
  , skipped = JSON.str ["skipped"] j
  , property = False
  , runs = 1
  , discarded = 0
  , shrinks = 0
  , labels = Nil
  , notes = List.map jsonText (fromMaybe Nil (JSON.arr ["notes"] j))
  , failure = case JSON.at ["failure"] j of
      Just f -> jsonFailure f
      Nothing -> Nothing
  , seed = 0
  , goldens = List.map jsonGolden (fromMaybe Nil (JSON.arr ["goldens"] j))
  }

-- | the environment variable that names the file an integration test's
-- | program writes its outcome to: check's `outcomeVariable`
outcomeVariable : String
outcomeVariable = "HEFF_TEST_OUTCOME"

-- | the file a test run in `dir` writes its outcome to: beside it, not
-- | in it, where the test makes and lists files
outcomeFile : String -> String
outcomeFile dir = dir ^ ".outcome"

-- (how a command ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "exited with " ^ show n
endedSaid (Signalled n) = "ended by the signal " ^ show n
endedSaid TimedOut = "killed at its time limit"
endedSaid NotRun = "not run"

-- (the last lines of a text, for a failure to show)
lastLines : Int -> String -> String
lastLines n t =
  joinWith "\n" (List.reverse (List.take n (List.reverse (split "\n" t))))

-- | what came of an integration test, its program run: what it wrote
-- | to its outcome's file, else how it ended and what it said on its
-- | error stream
ranOutcome : String -> Int -> Ran -> Maybe String -> Driver.TestOutcome
ranOutcome name limit r said = case r.ended of
  TimedOut ->
    brokenTest
      name
      ("took longer than its time limit, " ^ show limit ^ " ms: killed")
  _ -> case said of
    Nothing ->
      brokenTest
        name
        ("it "
         ^ endedSaid r.ended
         ^ ", and said nothing of how it went"
         ^ (if strEq r.err "" then "" else ":\n" ^ lastLines 20 r.err))
    Just text -> case JSON.parse text of
      Left why ->
        brokenTest name "what it said of how it went could not be read"
      Right j -> outcomeOfJson name j

subtestsOfJson : Either JSON.ParseError JSON.Json -> List String
subtestsOfJson (Right j) =
  List.map jsonText (fromMaybe Nil (JSON.arr ["subtests"] j))
subtestsOfJson (Left why) = Nil

-- | the subtests an integration test named, its program run, in order:
-- | none, if it did not say how it went
ranSubtests : Maybe String -> List String
ranSubtests Nothing = Nil
ranSubtests (Just text) = subtestsOfJson (JSON.parse text)

-- | what runs the integration tests: their program, and what is set in
-- | its environment -- `HEFF`, the heff that runs them, and
-- | `HEFF_TEST_ROOT`, the project's root, so that a test of heff runs
-- | the heff tested, on the project's files; and `HEFF_TEST_JOBS`, 1,
-- | so that a `heff test` it runs takes no more than its own slot
type Launch = { program : String, env : List (Pair String String) }

-- | an integration test to run: the file it is of (its place among those
-- | run), what runs it, its place among the file's (a subtest's, its
-- | test's place and its own among the test's subtests), the name of the
-- | test it is or is under, the names of the subtests down to it, and its
-- | time limit
type Job =
  { owner : Int
  , launch : Launch
  , place : List Int
  , top : String
  , path : List String
  , limit : Int
  }

-- | an integration test's name: its test's, and the subtests' down to it
jobName : Job -> String
jobName j = joinWith " / " (Cons j.top j.path)

-- | a test's names a level each, as `--run` selects them: its groups', its
-- | own and its subtests'
jobLevels : Job -> List String
jobLevels j = List.append (split " / " j.top) j.path

-- | is a test of these names, a level each, selected by the levels of
-- | `--run`'s pattern: each name matched by the level of its depth, those
-- | deeper than the pattern by any
levelsSelected : List Regex.Regex -> List String -> Bool
levelsSelected Nil names = True
levelsSelected (Cons r rs) Nil = True
levelsSelected (Cons r rs) (Cons n ns) =
  Regex.matches r n && levelsSelected rs ns

-- | the subtests of a test that ran, those the pattern selects, to run
-- | next: each at its place under the test's
subtestJobs : List Regex.Regex -> Job -> Int -> List String -> List Job
subtestJobs sel j k Nil = Nil
subtestJobs sel j k (Cons n rest) =
  if levelsSelected sel (List.append (jobLevels j) [n])
  then Cons
      { owner = j.owner
      , launch = j.launch
      , place = List.append j.place [k]
      , top = j.top
      , path = List.append j.path [n]
      , limit = j.limit
      }
      (subtestJobs sel j (k + 1) rest)
  else subtestJobs sel j (k + 1) rest

-- (what came of a test, of its file, at its place, and its subtests to
-- run next)
type Finished =
  { owner : Int
  , place : List Int
  , outcome : Driver.TestOutcome
  , next : List Job
  }

-- (a test that could not be run: what came of it)
brokenJob : Job -> String -> Finished
brokenJob j why =
  { owner = j.owner
  , place = j.place
  , outcome = brokenTest (jobName j) why
  , next = Nil
  }

-- (the test's program ended, its directory removed: what came of it, and
-- its subtests selected, to run next)
endedJob : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> List Regex.Regex
         -> Job
         -> String
         -> Ran
         -> Co e Finished
endedJob sel j dir ran = do
  gone <- remove dir
  said <- readFile (outcomeFile dir)
  told <- remove (outcomeFile dir)
  pure
      { owner = j.owner
      , place = j.place
      , outcome = ranOutcome (jobName j) j.limit ran said
      , next = subtestJobs sel j 0 (ranSubtests said)
      }

-- (the test's program run in the directory, given its time limit, in a
-- process group of its own, so that what it starts is killed with it:
-- held by a `with`, waited for -- a wait pending in the reactor's group
-- it is started in, the other tests going on -- then what came of it)
ranJob : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> List Regex.Regex
       -> Job
       -> String
       -> Co e Finished
ranJob sel j dir = do
  try
    ran <-
      withProcess
        { command = j.launch.program
        , args = Cons j.top j.path
        , dir = dir
        , env = Cons (MkPair outcomeVariable (outcomeFile dir)) j.launch.env
        , timeout = j.limit
        , group = True
        }
        (\p -> wait p)
    endedJob sel j dir ran
  catch (err : ProcessError) ->
    gone <- remove dir
    pure (brokenJob j ("its program could not be run: " ^ err.message))

-- (the test run, in a new directory of its own; else what came of it)
runJob : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> List Regex.Regex
       -> Job
       -> Co e Finished
runJob sel j = do
  st <- styleNow
  made <- temporaryDirectory "heff-test-"
  case made of
    Left err -> pure (brokenJob j ("no directory for it: " ^ err.message))
    Right dir -> ranJob sel j (Path.render (os := st) dir)

-- (the subtests the tests that ended named, to run next)
nextJobs : List Finished -> List Job
nextJobs fs = List.concatMap (\(f : Finished) -> f.next) fs

-- | the integration tests run, of all the files, `jobs` at most at once,
-- | each its program in a directory of its own, each a computation
-- | started in the reactor's group `g` -- pending there while its
-- | program runs, `pending` of them -- as one ends, the next starts, and
-- | the subtests it named, those `sel` selects, wait after the others
runJobs : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> List Regex.Regex
        -> Int
        -> Reactor.Group Finished
        -> List Job
        -> Int
        -> List Finished
        -> Co e (List Finished)
runJobs sel jobs g Nil 0 done = pure done
runJobs sel jobs g Nil pending done = do
  ended <- Reactor.finished g True
  runJobs
      sel
      jobs
      g
      (nextJobs ended)
      (pending - List.length ended)
      (List.append ended done)
runJobs sel jobs g (Cons j rest) pending done =
  if pending < jobs
  then do
    begun <- Reactor.start g (runJob sel j)
    case begun of
      Just f ->
        runJobs sel jobs g (List.append rest f.next) pending (Cons f done)
      Nothing -> runJobs sel jobs g rest (pending + 1) done
  else do
    ended <- Reactor.finished g True
    runJobs
        sel
        jobs
        g
        (List.append (Cons j rest) (nextJobs ended))
        (pending - List.length ended)
        (List.append ended done)

-- (the tests of a file to run, the `owner`th, each at its place)
jobsOf : Int -> Launch -> Int -> List (Pair String Int) -> List Job
jobsOf owner launch i Nil = Nil
jobsOf owner launch i (Cons (MkPair name limit) rest) =
  Cons
    { owner = owner
    , launch = launch
    , place = [i]
    , top = name
    , path = Nil
    , limit = limit
    }
    (jobsOf owner launch (i + 1) rest)

-- | is one place before another: a test's before its subtests', and
-- | those of a test in their order
placeBefore : List Int -> List Int -> Bool
placeBefore Nil bs = True
placeBefore (Cons a argv) Nil = False
placeBefore (Cons a argv) (Cons b bs) =
  if a == b then placeBefore argv bs else a < b

-- | the levels of `--run`'s pattern (none, all selected, for none or one
-- | that is not read)
patternLevels : String -> List Regex.Regex
patternLevels p =
  if strEq p "" then Nil
  else case Regex.compileLevels p of
    Left why -> Nil
    Right sel -> sel

-- (a path made real, else the one given)
pathOr : Path.Style -> String -> Either FileError Path.Path -> String
pathOr st given (Left err) = given
pathOr st given (Right real) = Path.render (os := st) real

-- (where `heff test` builds a file's integration tests: `.heff/test/F/`,
-- F its path, its separators underscores)
testDir : Load.Paths -> String -> String
testDir paths file =
  Load.under
    paths
    (Load.under paths paths.root ".heff/test")
    (joinWith "_" (HostPath.components paths.style file))

-- (a file tested to its end here, its integration tests not run: its
-- golden texts held, and its line said)
testedHere : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> Tested
           -> Co e TestRes
testedHere (Settled r) = pure r
testedHere (Pend p) = do
  os <- withGoldens False p.file p.outcomes
  testReport p.file p.wrong p.reports os

-- (does a test's name reach as deep as these levels of `--run`: one the
-- pattern selects, not one run on the way to its subtests)
reaches : List Regex.Regex -> Driver.TestOutcome -> Bool
reaches sel o = List.length (split " / " o.name) >= List.length sel

-- | a file's outcomes, `--run` given, all held and none as deep as the
-- | pattern (its tests run only on the way to subtests it does not
-- | name): the file passed over, as one whose tests it selects none of
passedOver : TestOpts -> List Driver.TestOutcome -> Bool
passedOver opts os =
  not (strEq opts.pattern "")
  && List.null (badOutcomes os)
  && not (List.any (reaches (patternLevels opts.pattern)) os)

-- (a file's outcomes, their golden texts held: its line said, else it is
-- passed over)
reported : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> Pending
         -> List Driver.TestOutcome
         -> Co e TestRes
reported opts p os =
  if passedOver opts os then pure noRes
  else testReport p.file p.wrong p.reports os

-- | a file whose integration tests are built, to run with the others':
-- | its place among those run, what came of it here, and what runs them
type Ready = { at : Int, pending : Pending, launch : Launch }

-- | a file tested: done with, its line said, or its integration tests
-- | built, to run with all the files'
data Prepared = Done TestRes | Later Ready

-- (a file's outcomes and those of its integration tests, their golden
-- texts held, its line said)
reportedWith : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> TestOpts
             -> Pending
             -> List Driver.TestOutcome
             -> Co e TestRes
reportedWith opts p more = do
  os <- withGoldens opts.update p.file (List.append p.outcomes more)
  reported opts p os

-- (a file whose integration tests cannot be built: each fails, saying
-- why, and the file is done with)
unbuilt : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> TestOpts
        -> Pending
        -> String
        -> (Prepared -> Co e Unit)
        -> Co e Unit
unbuilt opts p why k = do
  r <-
    reportedWith
      opts
      p
      (List.map
         (\(i : Pair String Int) ->
            brokenTest (fst i) ("its program could not be built: " ^ why))
         p.integrations)
  k (Done r)

-- | the file's integration tests built, as `heff run` builds, into a
-- | program of the file's (check's `integrationMain` of its tests), to
-- | run with the others': its `Ready` given to `k`
buildIntegrations : {e : HFunctor}
                  -> {{io : stdio <: e}}
                  -> {{sys : process <: e}}
                  -> {{disk : filesystem <: e}}
                  -> {{rep : Report.report <: e}}
                  -> {{prog : Progress.progress <: e}}
                  -> TestOpts
                  -> Int
                  -> Pending
                  -> (Prepared -> Co e Unit)
                  -> Co e Unit
buildIntegrations opts at p k = case integrationLoaded p of
  Left why -> unbuilt opts p why k
  Right l -> do
    task <- Progress.start Progress.root (p.file ^ ": integration tests") 2
    c <- Progress.start task "compiling to C" 0
    cLoadedOr
        (\why -> do
         Progress.end c
         Progress.end task
         unbuilt opts p why k)
        l
        (Just integrationMainName)
        (testDir l.paths p.file ^ "/")
        p.file
        (ended
           c
           (zigBuildOr
              (\why -> do
               Progress.end task
               unbuilt opts p why k)
              "heff test"
              l.paths.style
              "-O1"
              task
              (testDir l.paths p.file)
              (Load.under
                 l.paths
                 (testDir l.paths p.file)
                 (programFile l.paths.style "main")) (do
            real <-
              realPath
                (Load.under
                   l.paths
                   (testDir l.paths p.file)
                   (programFile l.paths.style "main"))
            self <- selfPath
            heff <- realPath self
            root <- realPath l.paths.root
            Progress.end task
            k
                (Later
                   { at = at
                   , pending = p
                   , launch =
                       { program = pathOr l.paths.style "" real
                       , env =
                           [ MkPair "HEFF" (pathOr l.paths.style self heff)
                           , MkPair
                             "HEFF_TEST_ROOT"
                             (pathOr l.paths.style l.paths.root root)
                           , MkPair "HEFF_TEST_JOBS" "1"
                           ]
                       }
                   }))))

-- (a file tested here, its line said, else its integration tests built:
-- then `k` of it)
prepare : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> TestOpts
        -> Int
        -> Tested
        -> (Prepared -> Co e Unit)
        -> Co e Unit
prepare opts at (Settled r) k = k (Done r)
prepare opts at (Pend p) k =
  if List.null p.integrations
  then do
    r <- reportedWith opts p Nil
    k (Done r)
  else buildIntegrations opts at p k

-- (the integration tests of the files ready, each file's)
readyJobs : List Ready -> List Job
readyJobs rs =
  List.concatMap
    (\(r : Ready) -> jobsOf r.at r.launch 0 r.pending.integrations)
    rs

-- (what came of the integration tests of the file at `at`, in its order)
outcomesOf : Int -> List Finished -> List Driver.TestOutcome
outcomesOf at fs =
  List.map
    (\(f : Finished) -> f.outcome)
    (List.sortBy
       (\(a : Finished) (b : Finished) -> placeBefore a.place b.place)
       (List.keepIf (\(f : Finished) -> f.owner == at) fs))

-- (the files ready, each its line said in turn, what came of their tests
-- added to `acc`)
reportReady : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> TestOpts
            -> List Finished
            -> List Ready
            -> TestRes
            -> Co e TestRes
reportReady opts done Nil acc = pure acc
reportReady opts done (Cons r rest) acc = do
  res <- reportedWith opts r.pending (outcomesOf r.at done)
  reportReady opts done rest (addRes acc res)

-- | the integration tests of all the files ready run, `opts.jobs` at
-- | once among them all, then each file's line said, in the files' order
runReady : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> TestOpts
         -> List Ready
         -> TestRes
         -> Co e TestRes
runReady opts Nil acc = pure acc
runReady opts ready acc = do
  task <- Progress.start Progress.root "integration tests" 0
  g <- Reactor.open
  done <-
    runJobs (patternLevels opts.pattern) opts.jobs g (readyJobs ready) 0 Nil
  Reactor.close g
  Progress.end task
  reportReady opts done ready acc

-- (the tests' part of the last line: said only if there were some)
testsHeld : Int -> Int -> Int -> String
testsHeld tests failed skipped =
  if tests == 0 then ""
  else ", "
    ^ show (tests - failed - skipped)
    ^ "/"
    ^ show tests
    ^ " tests hold"
    ^ skippedSaid skipped

-- (the files' part of the last line: how many check as they should --
-- those that expect errors by having some -- of how many)
filesSaid : TestRes -> String
filesSaid r =
  ", "
  ^ show (r.files - List.length r.unchecked)
  ^ "/"
  ^ show r.files
  ^ " files check as they should"
  ^ (if r.expectErrors == 0 then ""
     else " (" ^ show r.expectErrors ^ " with expected errors)")

-- (the files that do not check as they should, a line each, where each
-- first went wrong, as their FAIL lines may be far above)
printUnchecked : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> List String
               -> Co e Unit
printUnchecked Nil = pure MkUnit
printUnchecked ws = do
  print "files that do not check as they should:"
  printLines (List.map (\w -> "  " ^ w) ws)

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.`, and a directory below them that is a project of its
-- own (a package.hf in it), passed over)
testFilesGo : {e : HFunctor}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> List (Pair Bool String)
            -> List String
            -> Co e (List String)
testFilesGo Nil acc = pure (List.reverse acc)
testFilesGo (Cons (MkPair top p) rest) acc = do
  names <- readDirectory p
  st <- styleNow
  case names of
    Just ns -> do
      own <- if top then pure False else Load.isRoot st p
      if own then testFilesGo rest acc
      else testFilesGo
          (List.append
             (List.map
                (\n -> MkPair False (HostPath.join st p n))
                (List.keepIf (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then testFilesGo rest (Cons p acc)
      else testFilesGo rest acc

-- (the directory named, if it is one: what reading it found)
directoryIf : {a : Type} -> String -> Maybe a -> List String
directoryIf d (Just _) = [d]
directoryIf d Nothing = []

-- | the files `heff test` checks: those given, a directory's `.hf` files
-- | for it; none given, the project's here (the `.hf` files under `src/`,
-- | for their doc tests and watches, and `test/`)
testFiles : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> Co e (List String)
testFiles Nil = do
  src <- readDirectory "src"
  tests <- readDirectory "test"
  case List.append (directoryIf "src" src) (directoryIf "test" tests) of
    [] -> do
      printErr
          "heff test: no src/ nor test/ here: test at the project's root, or give FILEs"
      exit 1
      pure Nil
    roots -> testFilesGo (List.map (\r -> MkPair True r) roots) Nil
testFiles given = testFilesGo (List.map (\f -> MkPair True f) given) Nil

-- | did `--run` give a pattern that selects no test of any file
noneSelected : TestOpts -> TestRes -> Bool
noneSelected opts acc = not (strEq opts.pattern "") && acc.tests == 0

-- (the last of `heff test`: the files that do not check listed, the
-- line that adds it up, and its status)
testSummary : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> TestOpts
            -> TestRes
            -> Co e Unit
testSummary opts acc = do
  printUnchecked acc.unchecked
  if noneSelected opts acc
  then do
    printErr ("heff test: no tests match '" ^ opts.pattern ^ "'")
    exit 1
  else pure MkUnit
  print
      (show (acc.total - acc.failed)
       ^ "/"
       ^ show acc.total
       ^ " expectations hold"
       ^ testsHeld acc.tests acc.testsFailed acc.testsSkipped
       ^ filesSaid acc)
  if acc.failed > 0 || acc.testsFailed > 0 || not (List.null acc.unchecked)
  then exit 1
  else pure MkUnit

-- | check the watches' and doc tests' expectations of every file
-- | given, and run its tests (each property from `seed`), each file a
-- | task under `tk` as it is tested
testCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Progress.Task
        -> TestOpts
        -> List String
        -> TestRes
        -> List Ready
        -> Co e Unit
testCmd tk opts Nil acc ready = do
  Progress.end tk
  res <- runReady opts ready acc
  testSummary opts res
testCmd tk opts (Cons f rest) acc ready = do
  ft <- Progress.start tk f 0
  t <- testOneF opts f
  prepare
      opts
      (List.length ready)
      t (\pr -> do
    Progress.end ft
    case pr of
      Done r -> testCmd tk opts rest (addRes acc r) ready
      Later r -> testCmd tk opts rest acc (List.append ready [r]))

-- | `heff test`: the watches' expectations of the files checked, and
-- | their tests run (each property from `seed`), a task meanwhile, each
-- | file one more of its
testsCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> TestOpts
         -> List String
         -> Co e Unit
testsCmd opts files = do
  tk <- Progress.start Progress.root "testing" (List.length files)
  testCmd tk opts files noRes Nil

-- | the seed the properties are run from, unless `--seed` gives one:
-- | always the same, so that a run of the tests is a run of the same
-- | tests
defaultSeed : Int
defaultSeed = 2026

seedOf : Maybe String -> Int
seedOf Nothing = defaultSeed
seedOf (Just s) = fromMaybe defaultSeed (parseInt s)

-- | how many integration tests run at once, unless `--jobs` or
-- | HEFF_TEST_JOBS says: half the machine's cores, at least one, so that
-- | a run of the tests does not take all of it
-- | >>> List.map defaultJobs [1, 2, 3, 8, 14]
-- | [1, 1, 1, 4, 7]
defaultJobs : Int -> Int
defaultJobs cores = if cores / 2 < 1 then 1 else cores / 2

-- (how many at once: as given, if it is a number above 0)
countOf : Int -> Maybe String -> Int
countOf fallback Nothing = fallback
countOf fallback (Just n) = case parseInt n of
  Just k -> if k > 0 then k else fallback
  Nothing -> fallback

-- | `heff test`'s options read: the seed, the pattern (read here, a
-- | pattern that is not ends the run), how many integration tests at
-- | once (`--jobs`, else HEFF_TEST_JOBS, else `defaultJobs`), and
-- | whether golden texts are written
testOptions : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> Maybe String
            -> Maybe String
            -> Maybe String
            -> Bool
            -> Co e TestOpts
testOptions seed pattern jobs update = do
  case Regex.compileLevels (fromMaybe "" pattern) of
    Left why -> do
      printErr ("heff test: --run " ^ fromMaybe "" pattern ^ ": " ^ why)
      exit 2
    Right _ -> pure MkUnit
  cores <- processors
  env <- getEnv "HEFF_TEST_JOBS"
  pure
      { seed = seedOf seed
      , pattern = fromMaybe "" pattern
      , jobs = countOf (countOf (defaultJobs cores) env) jobs
      , update = update
      }

-- `heff test --watch`
--------------------------------------------------------------------------------

-- | what `heff test --watch` watches: the files tested (those given,
-- | else `test/`) and the project's -- what the files import is among
-- | them
-- | >>> testWatched Nil
-- | ["test", "package.hf", "src", "app"]
-- | >>> testWatched ["a.hf"]
-- | ["a.hf", "package.hf", "src", "app"]
testWatched : List String -> List String
testWatched Nil = "test" :: Watch.project
testWatched given = List.append given Watch.project

-- (an option given again, as it was given)
flagged : String -> Maybe String -> List String
flagged name Nothing = Nil
flagged name (Just v) = [name, v]

-- | the command line each run of `heff test --watch` is: `heff test` as
-- | it was given, without `--watch`
-- | >>> testArgs (Just "7") Nothing (Just "2") ["a.hf"]
-- | ["test", "--seed", "7", "--jobs", "2", "a.hf"]
testArgs : Maybe String
         -> Maybe String
         -> Maybe String
         -> List String
         -> List String
testArgs seed pattern jobs given =
  "test"
  :: List.append
    (flagged "--seed" seed)
    (List.append
       (flagged "--run" pattern)
       (List.append (flagged "--jobs" jobs) given))

-- (how a run of the tests went, said)
heldSaid : Ran -> String
heldSaid r = if succeeded r then "all held" else "not all held"

-- (the line between a run and the one before it: a change)
changedSaid : {e : HFunctor} -> {{io : stdio <: e}} -> Int -> Co e Unit
changedSaid 0 = pure MkUnit
changedSaid n = printErr "\nheff test: a change; tested again\n"

-- | a run of the tests, the `n`th before it: `heff test` run beside, its
-- | output the terminal's, waited for, and how it went said -- each
-- | run's output between such lines
testedAgain : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{ex : exception ProcessError <: e}}
            -> List String
            -> Int
            -> Co e Int
testedAgain argv n = do
  changedSaid n
  self <- selfPath
  try
    r <-
      withProcess
        { command = self
        , args = argv
        , input = Inherited
        , output = Inherited
        , errors = Inherited
        }
        (\p -> wait p)
    printErr
        ("heff test: tested ("
         ^ show (n + 1)
         ^ "), "
         ^ heldSaid r
         ^ "; tested again at the next change")
  catch (err : ProcessError) ->
    printErr "heff test: cannot run heff; tested again at the next change"
  return n + 1

-- | `heff test --watch`: the tests run as `heff test` runs them, then
-- | again at each change of what they test (`testWatched`), until the
-- | program is ended.  Not with `--update`: the golden texts it writes
-- | would be a change, tested again, without end
testsWatched : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{clock : Time.time <: e}}
             -> {{ex : exception ProcessError <: e}}
             -> Maybe String
             -> Maybe String
             -> Maybe String
             -> Bool
             -> List String
             -> Co e Unit
testsWatched seed pattern jobs True given = do
  printErr "heff test: --watch is not given with --update"
  exit 2
testsWatched seed pattern jobs False given = do
  _ <- testOptions seed pattern jobs False
  _ <- testFiles given
  st <- styleNow
  stamp <- Watch.stamped st (testWatched given)
  first <- testedAgain (testArgs seed pattern jobs given) 0
  Watch.watchOver
      st
      (testWatched given)
      (\n -> pure n)
      (testedAgain (testArgs seed pattern jobs given))
      stamp
      first

checkLast : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Report.report <: e}}
          -> Bool
          -> List Driver.Checked
          -> Co e Unit
checkLast badLoad cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      write (Driver.interface c)
      if badLoad || anyErrors cs then exit 1 else pure MkUnit

-- | elaborate FILE and what it imports; print its interface
checkCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> String
         -> Co e Unit
checkCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  checkLast (badL > 0) cs

-- The reference pages
--------------------------------------------------------------------------------

-- (the files `heff doc` reads, none given: the `.hf` files under `src/`,
-- if there is one here)
docFilesIn : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Maybe (List String)
           -> Co e (List String)
docFilesIn (Just _) = testFilesGo [MkPair True "src"] Nil
docFilesIn Nothing = do
  printErr "heff doc: no src/ here: run it at the project's root, or give FILEs"
  exit 1
  pure Nil

-- | the files `heff doc` reads: those given, a directory's `.hf` files
-- | for it; none given, the project's here (those under `src/`)
docFiles : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> List String
         -> Co e (List String)
docFiles Nil = do
  src <- readDirectory "src"
  docFilesIn src
docFiles given = testFilesGo (List.map (\f -> MkPair True f) given) Nil

-- (a file's module, kept if it and what it imports checked)
docKept : Bool
        -> Maybe Driver.Checked
        -> List Driver.Checked
        -> List Driver.Checked
docKept False (Just c) acc = Cons c acc
docKept bad found acc = acc

-- (each file checked, after what it imports: the modules that checked,
-- in order; each that did not, its diagnostics said)
docChecked : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> List String
           -> List Driver.Checked
           -> Co e (List Driver.Checked)
docChecked Nil acc = pure (List.reverse acc)
docChecked (Cons f rest) acc = do
  l <- load f
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  if anyErrors cs then putFileDiags cs else pure MkUnit
  docChecked
      rest
      (docKept (badL > 0 || anyErrors cs) (Driver.lastChecked cs) acc)

-- (a page written, its directory made first)
docPageWritten : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> String
               -> String
               -> Co e Unit
docPageWritten path text = do
  st <- styleNow
  _ <- makeDirectory (HostPath.dirname st path)
  ok <- writeFile path text
  if ok then pure MkUnit
  else do
    printErr ("heff doc: cannot write " ^ path)
    exit 1

-- (each module's page, under the directory)
docPagesWritten : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> String
                -> List Driver.Checked
                -> Co e Unit
docPagesWritten dir Nil = pure MkUnit
docPagesWritten dir (Cons c rest) = do
  st <- styleNow
  docPageWritten
      (HostPath.join st dir (DocPages.pagePath c.module))
      (DocPages.page c)
  docPagesWritten dir rest

-- (the pages: printed one after another, or written under the directory,
-- with their index)
docWritten : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Maybe String
           -> List Driver.Checked
           -> Co e Unit
docWritten Nothing cs = write (joinWith "\n" (List.map DocPages.page cs))
docWritten (Just dir) cs = do
  st <- styleNow
  docPagesWritten dir cs
  docPageWritten (HostPath.join st dir "index.md") (DocPages.indexPage cs)
  print
      ("heff doc: "
       ^ show (List.length cs)
       ^ " pages and their index, in "
       ^ dir)

-- | `heff doc`: a reference page of each module of the files (a
-- | directory's `.hf` files), else of the project's here (`src/`): its
-- | header comment, and each definition it exposes, its signature and
-- | its doc comment; printed, or with `--out DIR`, each written under
-- | DIR (`std.path` at DIR/std/path.md), with an index of them.  A module
-- | that does not check has no page, and its errors are said
docCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> Maybe String
       -> List String
       -> Co e Unit
docCmd out given = do
  files <- docFiles given
  cs <- docChecked files Nil
  docWritten out cs
  if List.length cs < List.length files then exit 1 else pure MkUnit

-- | what the name at each OFFSET of FILE resolved to, and its type: a
-- | line each, FILE checked once
typeAtCmd : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> String
          -> List String
          -> Co e Unit
typeAtCmd file offs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      printLines
        (List.map
           (\off ->
              fromMaybe "nothing there" (case parseInt off of
              Just o -> Query.typeAt c o
              Nothing -> Nothing))
           offs)

-- | the elaboration trace of FILE, one line per event
explainCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Co e Unit
explainCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> printLines (Query.explain c)

fmtSrc : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> String
       -> String
       -> Fixity.Fixities
       -> Co e Int
fmtSrc checkOnly f src fix = case Format.formatIn fix src of
  Left why -> do
    printErr ("heff: " ^ f ^ " not formatted: " ^ why)
    pure 1
  Right out ->
    if strEq out src then pure 0
    else if checkOnly
    then do
      print f
      pure 1
    else do
      ok <- writeFile f out
      pure 0

-- | 1 if the file is not formatted (with `--check`) or cannot be; its
-- | operators cut as the fixities of what it imports say
fmtOne : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> String
       -> Co e Int
fmtOne checkOnly f = do
  mSrc <- readFile f
  case mSrc of
    Nothing -> do
      printErr ("heff: cannot read " ^ f)
      pure 1
    Just src -> do
      l <- load f
      fmtSrc checkOnly f src (Driver.fixitiesIn l.sources)

fmtAll : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> List String
       -> Int
       -> Co e Int
fmtAll checkOnly Nil bad = pure bad
fmtAll checkOnly (Cons f rest) bad = do
  n <- fmtOne checkOnly f
  fmtAll checkOnly rest (bad + n)

-- | format FILEs in place; `--check`: only say which are not formatted
fmtCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> List String
       -> Co e Unit
fmtCmd check files = do
  bad <- fmtAll check files 0
  if bad > 0 then exit 1 else pure MkUnit

-- (the watches of the files, checked, and their tests run: how many
-- hold, of how many, and whether every file checked)
testAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> List String
        -> TestRes
        -> Co e TestRes
testAll Nil acc = pure acc
testAll (Cons f rest) acc = do
  t <-
    testOneF
      { seed = defaultSeed, pattern = "", jobs = 1, update = False }
      f
  r <- testedHere t
  testAll rest (addRes acc r)

publishFails : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> String
             -> Co e Unit
publishFails why = do
  printErr ("heff publish: " ^ why)
  exit 1

-- (git, run: what is wrong if it fails)
gitOk : {e : HFunctor}
      -> {{sys : process <: e}}
      -> String
      -> List String
      -> Co e (Maybe String)
gitOk what argv = do
  r <- run { command = "git", args = argv }
  pure
      (if succeeded r then Nothing
       else Just (what ^ ": git " ^ joinWith " " argv ^ ": " ^ trim (ranErr r)))

publishTag : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> String
           -> Project.Package
           -> Co e Unit
publishTag v pk = do
  tagged <- gitOk "not tagged" ["tag", "-a", "v" ^ v, "-m", "v" ^ v]
  case tagged of
    Just why -> publishFails why
    Nothing -> do
      pushed <- gitOk "tagged, not pushed" ["push", "origin", "v" ^ v]
      case pushed of
        Just why -> publishFails why
        Nothing ->
          print ("heff publish: " ^ pk.module ^ " " ^ v ^ ", tag v" ^ v)

publishTested : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> String
              -> Project.Package
              -> TestRes
              -> Co e Unit
publishTested v pk r =
  if r.failed > 0 || r.testsFailed > 0 || not (List.null r.unchecked)
  then publishFails
      (show r.failed
       ^ " of "
       ^ show r.total
       ^ " expectations do not hold, "
       ^ show r.testsFailed
       ^ " of "
       ^ show r.tests
       ^ " tests fail, or a file does not check")
  else publishTag v pk

publishGit : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Project.Package
           -> String
           -> Co e Unit
publishGit v pk src = do
  status <- run { command = "git", args = ["status", "--porcelain"] }
  tag <-
    run
      { command = "git"
      , args = ["rev-parse", "-q", "--verify", "refs/tags/v" ^ v]
      }
  if not (succeeded status)
  then publishFails ("not in a git repository: " ^ trim (ranErr status))
  else if not (strEq (trim (ranOut status)) "")
  then publishFails "what is published is what is committed: commit first"
  else if succeeded tag
  then publishFails ("v" ^ v ^ " is tagged already")
  else do
    files <- hfFilesGo [src] Nil
    r <- testAll files noRes
    publishTested v pk r

publishChecked : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> {{rep : Report.report <: e}}
               -> String
               -> Load.Loaded
               -> Project.Package
               -> Co e Unit
publishChecked v l pk = case Project.majorMismatch pk.module v of
  Just why -> publishFails (pk.module ^ ": " ^ why)
  Nothing -> do
    own <- Load.ownDir l.paths (Load.under l.paths l.paths.root "src")
    case own of
      Left why -> publishFails why
      Right _ -> publishGit v pk (Load.under l.paths l.paths.root "src")

-- | publish the project, at the working directory, as version V: its
-- | package.hf a Package, its path's `/vN` its major,
-- | its src/ one directory, every file of it checked, its watches
-- | holding and its tests too, all of it committed -- then tagged `vV`,
-- | the tag pushed
publishCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Co e Unit
publishCmd v = case Project.version v of
  Nothing -> publishFails ("`" ^ v ^ "` is no version: a.b.c")
  Just _ -> do
    here <- readFile "package.hf"
    case here of
      Nothing ->
        publishFails "no package.hf here: publish at the project's root"
      Just _ -> do
        l <- load "package.hf"
        badL <- printErrs "heff" l.errors 0
        cs <- Session.cachedProgram l
        putFileDiags cs
        case l.package of
          Nothing -> publishFails "package.hf does not read"
          Just pk ->
            if badL > 0 || anyErrors cs
            then publishFails "package.hf is no Package (lib/manifest.hf)"
            else publishChecked v l pk

-- | the project's name: DIR's, or (DIR being `.`) that of the working
-- | directory, CWD
projectName : Path.Style -> String -> String -> String
projectName st "." cwd = HostPath.basename st cwd
projectName st dir _ = HostPath.basename st dir

-- (the directory a project's name is of: DIR, or the working directory)
nameSource : String -> String -> String
nameSource "." cwd = cwd
nameSource dir _ = dir

-- (byte `i` of a directory's name as a package's name might have it: a
-- capital lowercased, a byte no name has `_`)
nameByteOf : String -> Int -> String
nameByteOf s i =
  if 65 <= byteAt s i && byteAt s i <= 90
  then strSlice "abcdefghijklmnopqrstuvwxyz" (byteAt s i - 65) (byteAt s i - 64)
  else if Project.isNameByte (byteAt s i)
  then strSlice s i (i + 1)
  else "_"

-- (a name, its leading digit put after a letter)
letterFirst : String -> String
letterFirst "" = "app"
letterFirst x = if 48 <= byteAt x 0 && byteAt x 0 <= 57 then "pkg_" ^ x else x

-- (a name, unless it is one no package may have)
unreserved : String -> String
unreserved x =
  if Project.isName x && not (strEq x Project.heffModule) then x
  else x ^ "_app"

-- | a package's name like a directory's, to suggest for it: lowercase,
-- | each run of other bytes `_`
-- | >>> nameLike "MyApp"
-- | "myapp"
-- | >>> nameLike "my-app"
-- | "my_app"
-- | >>> nameLike "2048 game"
-- | "pkg_2048_game"
-- | >>> nameLike "test"
-- | "test_app"
nameLike : String -> String
nameLike x =
  unreserved
    (letterFirst
       (joinWith
          "_"
          (List.keepIf
             (\(p : String) -> strLength p > 0)
             (split
                "_"
                (joinWith
                   ""
                   (List.map
                      (nameByteOf x)
                      (Project.rangeFrom 0 (strLength x))))))))

-- (what is wrong with a directory's name, NAME, as a new project's: why
-- it is no package's name, or that it is heff's own)
nameProblem : String -> Maybe String -> Maybe String
nameProblem name (Just why) =
  Just
    ("heff: the directory `"
     ^ name
     ^ "` cannot name a package ("
     ^ why
     ^ "): name it otherwise, as `heff init "
     ^ nameLike name
     ^ "`")
nameProblem name Nothing =
  if strEq name Project.heffModule
  then Just "heff: `heff` is heff's own package: name the project otherwise"
  else Nothing

-- | what is wrong with NAME, of the directory SHOWN, as a new project's
-- | name, if anything: no name at all said so, never taken as one
initProblem : String -> String -> Maybe String
initProblem shown "" =
  Just
    ("heff: the directory "
     ^ shown
     ^ " has no name to name a package by: say the project's directory, as `heff init DIR`")
initProblem shown name = nameProblem name (Project.whyNoName name)

-- (a new project's package.hf: the package NAME, for heff VERSION)
packageText : String -> String -> String
packageText name v =
  joinWith
    "\n"
    [ "import manifest"
    , ""
    , "package : Package"
    , "package = { module = \"" ^ name ^ "\", heff = \"" ^ v ^ "\" }"
    , ""
    ]

-- (a new project's module, src/NAME/greeting.hf)
moduleText : String -> String
moduleText name =
  joinWith
    "\n"
    [ "-- A module of the package, as every file of src/ is: `heff build`"
    , "-- checks them all, and `heff test` their doc tests."
    , ""
    , "module " ^ name ^ ".greeting"
    , ""
    , "-- | a greeting, of `name`"
    , "-- | >>> greeting \"heff\""
    , "-- | \"Hello, heff!\""
    , "greeting : String -> String"
    , "greeting name = \"Hello, \" ^ name ^ \"!\""
    , ""
    ]

-- (a new project's program NAME, app/NAME/main.hf)
programText : String -> String
programText name =
  joinWith
    "\n"
    [ "-- The program " ^ name ^ ": `heff build` builds it to .heff/bin/, as"
    , "-- build.hf says, and `heff install` into ~/.heff/bin/; run, without"
    , "-- a build, by `heff run app/" ^ name ^ "/main.hf`."
    , ""
    , "module app." ^ name ^ ".main"
    , ""
    , "import co"
    , "import " ^ name ^ ".greeting"
    , "import std.io"
    , ""
    , "program : {e : HFunctor} -> {{io : stdio <: e}} -> Co e Unit"
    , "program = print (greeting \"world\")"
    , ""
    , "main : Co stdio Unit"
    , "main = program (io := here stdio)"
    , ""
    ]

-- (how a new project's program is built, app/NAME/build.hf: its `main`,
-- through C)
buildText : String
buildText =
  joinWith
    "\n"
    [ "-- main.hf's `main`, compiled through C (by `zig cc`); `Page` makes a"
    , "-- page's script of it.  A field `ships = [...]` would name files and"
    , "-- directories of the project's root for `heff install` to put in the"
    , "-- heff home with it."
    , ""
    , "import manifest"
    , ""
    , "build : Build"
    , "build = { backend = C, run = \"main\" }"
    , ""
    ]

-- (a new project's test, test/greeting.hf)
testText : String -> String
testText name =
  joinWith
    "\n"
    [ "-- `heff test` runs the tests of every file of test/ (and src/): the"
    , "-- definitions of type `Test` (lib/check.hf), after the watches and doc"
    , "-- tests."
    , ""
    , "module test.greeting"
    , ""
    , "import check"
    , "import " ^ name ^ ".greeting"
    , ""
    , "greets : Test"
    , "greets ="
    , "  unit \"greeting\" (assertEqual (greeting \"test\") \"Hello, test!\")"
    , ""
    ]

-- | the files of a new project NAME, for heff VERSION: what each is, and
-- | its text -- a module, a program using it and a test of it, laid out
-- | as `heff build`, `heff test` and `heff install` take a project
projectFiles : String -> String -> List (Pair String String)
projectFiles name v =
  [ MkPair "package.hf" (packageText name v)
  , MkPair ".gitignore" (joinWith "\n" [".heff/", ""])
  , MkPair ("src/" ^ name ^ "/greeting.hf") (moduleText name)
  , MkPair ("app/" ^ name ^ "/main.hf") (programText name)
  , MkPair ("app/" ^ name ^ "/build.hf") buildText
  , MkPair "test/greeting.hf" (testText name)
  ]

-- | the files of `projectFiles` that are there already in DIR
existing : {e : HFunctor}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> String
         -> List (Pair String String)
         -> Co e (List String)
existing dir Nil = pure Nil
existing dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  there <- readFile (HostPath.join st dir f)
  others <- existing dir rest
  case there of
    Just _ -> pure (Cons f others)
    Nothing -> pure others

-- (a `.hf` file as the formatter lays it out)
laidOut : String -> String -> String
laidOut f text =
  if endsWith ".hf" f
  then (case Format.format text of
        Right out -> out
        Left _ -> text)
  else text

writeAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> String
         -> List (Pair String String)
         -> Co e Bool
writeAll dir Nil = pure True
writeAll dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  made <- makeDirectory (HostPath.dirname st (HostPath.join st dir f))
  ok <- writeFile (HostPath.join st dir f) (laidOut f text)
  if made && ok then writeAll dir rest
  else do
    printErr ("heff: cannot write " ^ HostPath.join st dir f)
    pure False

-- | a new project in DIR, NAME being DIR's: its package.hf, a .gitignore,
-- | a module of its package (`src/NAME/greeting.hf`), the program NAME
-- | (`app/NAME/`) and a test (`test/greeting.hf`); nothing is written
-- | over
initCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> String
        -> Co e Unit
initCmd dir = do
  cwd <- cwdNow
  v <- ownVersion
  st <- styleNow
  name <- pure (projectName st dir cwd)
  files <- pure (projectFiles name (fromMaybe "0.1.0" v))
  there <- existing dir files
  case initProblem (nameSource dir cwd) name of
    Just why -> do
      printErr why
      exit 1
    Nothing -> case there of
      Cons _ _ -> do
        printErr
            ("heff: "
             ^ dir
             ^ " has "
             ^ joinWith ", " there
             ^ " already; nothing written")
        exit 1
      Nil -> do
        ok <- writeAll dir files
        if ok
        then print
            ("heff: a new project in "
             ^ dir
             ^ "; there, `heff build` builds it and `heff test` tests it")
        else exit 1

-- Fetching
--------------------------------------------------------------------------------

getFails : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> String
         -> Co e Unit
getFails why = do
  printErr ("heff get: " ^ why)
  exit 1

-- | where the package at `path` is fetched from
urlOf : String -> String
urlOf path = "https://" ^ Project.repoOf path

-- (a commit's time, UTC, `YYYYMMDDhhmmss`, and its hash, as git says
-- them)
commitSaid : List String -> Maybe (Pair String String)
commitSaid (Cons time (Cons hash Nil)) = Just (MkPair time hash)
commitSaid _ = Nothing

-- | the commit `rev` names in the git repository at `dir`: its time
-- | (UTC, `YYYYMMDDhhmmss`) and its hash, if there is one
commitAt : {e : HFunctor}
         -> {{sys : process <: e}}
         -> String
         -> String
         -> Co e (Maybe (Pair String String))
commitAt dir rev = do
  r <-
    run
      { command = "git"
      , args =
          [ "log"
          , "-1"
          , "--date=format-local:%Y%m%d%H%M%S"
          , "--format=%cd %H"
          , rev ^ "^{commit}"
          , "--"
          ]
      , dir = dir
      , env = [MkPair "TZ" "UTC0"]
      }
  pure (if succeeded r then commitSaid (words (ranOut r)) else Nothing)

-- (the tag of version `v` of `path` cloned to `dir`; what is wrong)
tagCloned : {e : HFunctor}
          -> {{sys : process <: e}}
          -> String
          -> String
          -> String
          -> Co e (Maybe String)
tagCloned path v dir = do
  cloned <-
    run
      { command = "git"
      , args =
          [ "-c"
          , "advice.detachedHead=false"
          , "clone"
          , "--quiet"
          , "--depth"
          , "1"
          , "--branch"
          , "v" ^ v
          , urlOf path
          , dir
          ]
      }
  pure
      (if succeeded cloned then Nothing
       else Just
           ("cannot fetch "
            ^ path
            ^ " "
            ^ v
            ^ " (tag v"
            ^ v
            ^ " of "
            ^ urlOf path
            ^ "): "
            ^ trim (ranErr cloned)))

-- (the commit of pseudo-version `v` of `path`, its time `time` and its
-- hash's first digits `hash`, cloned to `dir` and checked out: the
-- commit of that time; what is wrong)
commitCloned : {e : HFunctor}
             -> {{sys : process <: e}}
             -> String
             -> String
             -> String
             -> String
             -> String
             -> Co e (Maybe String)
commitCloned path v time hash dir = do
  cannot <-
    pure
      ("cannot fetch "
       ^ path
       ^ " "
       ^ v
       ^ " (commit "
       ^ hash
       ^ " of "
       ^ urlOf path
       ^ "): ")
  cloned <-
    run
      { command = "git"
      , args =
          [ "clone"
          , "--quiet"
          , "--no-checkout"
          , "--filter=blob:none"
          , urlOf path
          , dir
          ]
      }
  if not (succeeded cloned) then pure (Just (cannot ^ trim (ranErr cloned)))
  else do
    out <-
      run
        { command = "git"
        , args =
            [ "-c"
            , "advice.detachedHead=false"
            , "checkout"
            , "--quiet"
            , "--detach"
            , hash ^ "^{commit}"
            ]
        , dir = dir
        }
    at <- commitAt dir "HEAD"
    pure
        (if not (succeeded out) then Just (cannot ^ trim (ranErr out))
         else case at of
           Just (MkPair t _) ->
             if strEq t time then Nothing
             else Just (cannot ^ "the commit is of " ^ t ^ ", not " ^ time)
           Nothing -> Just (cannot ^ "no such commit"))

-- (version `v` of `path` cloned to `dir`: its tag, or the commit its
-- pseudo-version names; what is wrong)
versionCloned : {e : HFunctor}
              -> {{sys : process <: e}}
              -> String
              -> String
              -> String
              -> Co e (Maybe String)
versionCloned path v dir = case Project.pseudoCommit v of
  Just (MkPair time hash) -> commitCloned path v time hash dir
  Nothing -> tagCloned path v dir

-- | version `v` of the package at `path`, in the cache: fetched there
-- | (its tag cloned, or for a pseudo-version its commit, its .git
-- | removed, made read-only, then the tree it is of written beside it)
-- | unless it is there already; the tree, or what is wrong.  A task
-- | while it is cloned.
fetched : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Load.Paths
        -> String
        -> String
        -> Co e (Either String String)
fetched ps path v = do
  dir <- pure (Load.cachedDir ps path v)
  hash <- readFile (dir ^ ".hash")
  case hash of
    Just h -> pure (Right (trim h))
    Nothing -> do
      _ <- remove dir
      _ <- makeDirectory (HostPath.dirname ps.style dir)
      f <- Progress.start Progress.root ("fetching " ^ path ^ " " ^ v) 0
      cloned <- versionCloned path v dir
      Progress.end f
      case cloned of
        Just why -> do
          _ <- remove dir
          pure (Left why)
        Nothing -> do
          tree <-
            run
              { command = "git"
              , args = ["rev-parse", "HEAD^{tree}"]
              , dir = dir
              }
          _ <- remove (HostPath.join ps.style dir ".git")
          sealed <- readOnly dir
          h <- pure ("tree:" ^ trim (ranOut tree))
          ok <- writeFile (dir ^ ".hash") (h ^ "\n")
          if succeeded tree && sealed && ok
          then do
            print ("heff get: fetched " ^ path ^ " " ^ v)
            pure (Right h)
          else pure (Left ("cannot keep " ^ path ^ " " ^ v ^ " in " ^ dir))

-- | the package.hf of version `v` of `path`, required by `by`, fetched
-- | (unless the project replaces it); its tree must be what heff.sum
-- | said, if it said one
fetchedPkg : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{prog : Progress.progress <: e}}
           -> Load.Paths
           -> Project.Package
           -> List Project.Sum
           -> String
           -> String
           -> String
           -> Co e (Either String Project.Package)
fetchedPkg ps root sums by path v = case Load.replacedDir root path of
  Just d -> Load.readPkgAt ps (Load.under ps ps.root d) path
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why -> pure (Left (by ^ " requires " ^ path ^ " " ^ v ^ ": " ^ why))
      Right h -> case Project.sumOf sums path v of
        Just want ->
          if strEq h want then Load.readPkgAt ps (Load.cachedDir ps path v) path
          else pure
              (Left
                 (path
                  ^ " "
                  ^ v
                  ^ " is "
                  ^ h
                  ^ ", and heff.sum says "
                  ^ want
                  ^ (case Project.pseudoCommit v of
                     Just _ -> ": its commit is another"
                     Nothing -> ": its tag has been moved")))
        Nothing -> Load.readPkgAt ps (Load.cachedDir ps path v) path

-- (the trees of the versions fetched, as heff.sum's lines)
sumsOf : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> Load.Paths
       -> Project.Package
       -> List Load.Visit
       -> Co e (List Project.Sum)
sumsOf ps root Nil = pure Nil
sumsOf ps root (Cons x rest) = do
  others <- sumsOf ps root rest
  h <- readFile (Load.cachedDir ps x.path x.version ^ ".hash")
  pure (case Load.replacedDir root x.path of
    Just _ -> others
    Nothing -> case h of
      Just t ->
        Cons { path = x.path, version = x.version, hash = trim t } others
      Nothing -> others)

-- (the newer of `best` and the version a line of `git ls-remote --tags`
-- names, if its tag is a version of `path`)
newerTagged : String -> Maybe String -> String -> Maybe String
newerTagged path best line = case split "refs/tags/v" line of
  Cons _ (Cons v Nil) -> case Project.version (trim v) of
    Just _ -> case Project.majorMismatch path (trim v) of
      Nothing -> case best of
        Just b -> if Project.newer (trim v) b then Just (trim v) else best
        Nothing -> Just (trim v)
      Just _ -> best
    Nothing -> best
  _ -> best

-- | the newest version tagged in the repository of `path` that it is
-- | the path of (its major), Nothing if no tag is; or what is wrong.  A
-- | task while it is asked.
newestTag : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{prog : Progress.progress <: e}}
          -> String
          -> Co e (Either String (Maybe String))
newestTag path = do
  t <- Progress.start Progress.root ("finding the newest version of " ^ path) 0
  r <-
    run
      { command = "git", args = ["ls-remote", "--tags", "--refs", urlOf path] }
  Progress.end t
  pure
      (if not (succeeded r)
       then Left
           ("cannot list the tags of " ^ urlOf path ^ ": " ^ trim (ranErr r))
       else Right (List.foldl (newerTagged path) Nothing (lines (ranOut r))))

-- (`rev` is a commit's first hex digits, 7 or more)
isCommitPrefix : String -> Bool
isCommitPrefix rev =
  strLength rev >= 7
  && strLength rev <= 40
  && Project.allBytes Project.isHex rev

-- (what git names the commit `rev` by: HEAD, the default branch's; a
-- commit's first hex digits; else a branch)
revNamed : String -> String
revNamed rev =
  if strEq rev "HEAD" || isCommitPrefix rev then rev else "refs/heads/" ^ rev

-- (the commit `rev`, said)
revSaid : String -> String
revSaid rev =
  if strEq rev "HEAD" then "commit on the default branch"
  else if isCommitPrefix rev then "commit " ^ rev
  else "branch " ^ rev

-- | the commit `rev` names in the repository of `path` -- HEAD, the
-- | default branch's; a commit, by 7 or more hex digits of its hash;
-- | else a branch -- as the pseudo-version of the path's major; or what
-- | is wrong.  A task while the repository's commits are fetched.
commitVersion : {e : HFunctor}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> {{prog : Progress.progress <: e}}
              -> Load.Paths
              -> String
              -> String
              -> Co e (Either String String)
commitVersion ps path rev = do
  dir <- pure (Load.cachedDir ps path "commits")
  _ <- remove dir
  _ <- makeDirectory (HostPath.dirname ps.style dir)
  t <-
    Progress.start
      Progress.root
      ("finding the " ^ revSaid rev ^ " of " ^ path)
      0
  cloned <-
    run
      { command = "git"
      , args =
          ["clone", "--quiet", "--bare", "--filter=tree:0", urlOf path, dir]
      }
  at <- if succeeded cloned then commitAt dir (revNamed rev) else pure Nothing
  _ <- remove dir
  Progress.end t
  pure
      (if not (succeeded cloned)
       then Left
           ("cannot list the commits of "
            ^ urlOf path
            ^ ": "
            ^ trim (ranErr cloned))
       else case at of
         Just (MkPair time hash) -> Right (Project.pseudoVersion path time hash)
         Nothing -> Left ("no " ^ revSaid rev ^ " of " ^ urlOf path))

-- | the version `heff get PATH` requires: the newest tag of the path's
-- | major, else the pseudo-version of the default branch's commit
newestOf : {e : HFunctor}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Load.Paths
         -> String
         -> Co e (Either String String)
newestOf ps path = do
  tagged <- newestTag path
  case tagged of
    Left why -> pure (Left why)
    Right (Just v) -> pure (Right v)
    Right Nothing -> commitVersion ps path "HEAD"

-- | the version `heff get PATH@REV` requires: REV if it is a version,
-- | else the pseudo-version of the commit it names
versionAt : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{prog : Progress.progress <: e}}
          -> Load.Paths
          -> String
          -> String
          -> Co e (Either String String)
versionAt ps path rev =
  if Project.isVersion rev then pure (Right rev) else commitVersion ps path rev

-- | PATH@VERSION, PATH@REV, PATH: the path, and the version or the
-- | commit (Nothing: the newest)
specOf : String -> Pair String (Maybe String)
specOf spec = case split "@" spec of
  Cons path (Cons v Nil) -> MkPair path (Just v)
  _ -> MkPair spec Nothing

-- (`r`, of version `v` if it is of `path`)
retarget : String -> String -> Project.Require -> Project.Require
retarget path v r =
  if strEq r.path path then { name = r.name, path = path, version = v } else r

-- | the project `pk`, requiring version `v` of `path`: in place of the
-- | version it required, else by the name the package's src/ gives it
requiring : Project.Package -> String -> String -> String -> Project.Package
requiring pk name path v =
  { module = pk.module
  , heff = pk.heff
  , require =
      if List.any (\(r : Project.Require) -> strEq r.path path) pk.require
      then List.map (retarget path v) pk.require
      else List.append pk.require [{ name = name, path = path, version = v }]
  , replace = pk.replace
  }

-- (the name a package fetched is imported by, its src/'s, unless its
-- package.hf does not read or is of another path)
fetchedName : Either String Project.Package
            -> Either String String
            -> Either String String
fetchedName (Left why) own = Left why
fetchedName (Right _) own = own

-- | write the project's package.hf, requiring version `v` of `path`
-- | (fetched, to know its name)
getRequire : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{prog : Progress.progress <: e}}
           -> Load.Paths
           -> String
           -> Project.Package
           -> String
           -> String
           -> Co e Bool
getRequire ps text pk path v = case Project.majorMismatch path v of
  Just why -> do
    getFails (path ^ ": " ^ why)
    pure False
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why -> do
        getFails why
        pure False
      Right _ -> do
        theirs <- Load.readPkgAt ps (Load.cachedDir ps path v) path
        own <-
          Load.ownDir
            ps
            (HostPath.join ps.style (Load.cachedDir ps path v) "src")
        case fetchedName theirs own of
          Left why -> do
            getFails why
            pure False
          Right name ->
            if not
                 (List.any
                    (\(r : Project.Require) -> strEq r.path path)
                    pk.require)
               && List.any
                 (\(r : Project.Require) -> strEq r.name name)
                 pk.require
            then do
              getFails
                  ("`"
                   ^ name
                   ^ "` is required already: add "
                   ^ path
                   ^ " to package.hf by another name")
              pure False
            else do
              ok <-
                writeFile
                  "package.hf"
                  (laidOut
                     "package.hf"
                     (Project.withPackage text (requiring pk name path v)))
              if ok
              then do
                print ("heff get: package.hf requires " ^ path ^ " " ^ v)
                pure True
              else do
                getFails "cannot write package.hf"
                pure False

-- | fetch every version the project's package.hf reaches, then write
-- | heff.sum, and load the project's packages, as a program would
getAll : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Co e Unit
getAll = do
  h <- hostNow
  ps <- Load.pathsFor h "package.hf"
  text <- readFile "package.hf"
  case Project.readPackage (fromMaybe "" text) of
    Right root -> do
      old <- Load.readSumAt ps
      case old of
        Left why -> getFails why
        Right sums -> do
          reached <-
            Load.versionsOf
              (\by path v -> fetchedPkg ps root sums by path v)
              root
          news <- sumsOf ps root (fst reached)
          wrote <-
            if strEq (Project.showSum news) "" then pure True
            else writeFile "heff.sum" (Project.showSum news)
          bad <- printErrs "heff get" (snd reached) 0
          if bad > 0 then exit 1
          else if not wrote then getFails "cannot write heff.sum"
          else do
            l <- load "package.hf"
            badL <- printErrs "heff get" l.errors 0
            if badL > 0 then exit 1
            else print
                ("heff get: "
                 ^ show (List.length (Load.selected (fst reached)))
                 ^ (if strEq (Project.showSum news) ""
                    then " packages, none fetched: no heff.sum"
                    else " packages, heff.sum written"))
    _ -> getFails "package.hf does not read: get at the project's root"

-- | fetch what the project requires, writing heff.sum; with PATH, first
-- | require it, at VERSION, or the commit REV names, else its newest
-- | (its default branch's commit, where no tag is a version)
getCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Maybe String
       -> Co e Unit
getCmd spec = do
  text <- readFile "package.hf"
  case text of
    Nothing -> getFails "no package.hf here: get at the project's root"
    Just t -> case Project.readPackage t of
      Left _ -> getFails "package.hf does not read"
      Right pk -> case spec of
        Nothing -> getAll
        Just s ->
          if strEq (fst (specOf s)) Project.heffModule
          then getFails Project.requireMsg
          else do
            h <- hostNow
            ps <- Load.pathsFor h "package.hf"
            v <- case snd (specOf s) of
              Just rev -> versionAt ps (fst (specOf s)) rev
              Nothing -> newestOf ps (fst (specOf s))
            case v of
              Left why -> getFails why
              Right ver -> do
                ok <- getRequire ps t pk (fst (specOf s)) ver
                if ok then getAll else pure MkUnit
