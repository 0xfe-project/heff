-- What `heff` does: the work of its commands (checking, compiling,
-- building, running, installing, formatting), and what every command
-- shares -- loading, diagnostics, the backends' output; testing, the
-- reference pages, publishing and fetching are modules of their own over
-- it.  Each is a computation that asks for the effects it has, in any
-- world they are in (the program gives them).  The command line is
-- not here: what reads it, and the world it runs in, are the program's,
-- so what is here may be used without either (#3).

module heff.build.commands

import co
import heff.build.backcache as BackCache
import heff.build.cache as Cache
import heff.build.driver as Driver
import heff.build.load as Load
import heff.build.project as Project
import heff.build.query as Query
import heff.build.session as Session
import heff.compile.emit as Emit
import heff.compile.emitc as EmitC
import heff.compile.glue as Glue
import heff.elab.effect as Effect
import heff.lsp.render as Render
import heff.lsp.report as Report
import heff.syntax.fixity as Fixity
import heff.syntax.format as Format
import heff.util.files as Files
import heff.util.hostpath as HostPath
import std.filesystem
import std.io
import std.ordmap as OrdMap
import std.path as Path
import std.process
import std.progress as Progress

-- | the style of the paths of the platform heff runs on
styleNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e Path.Style
styleNow = do
  p <- platform
  pure (Path.styleOf p)

-- | the path of the heff running, in the platform's style
selfPath : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
selfPath = do
  st <- styleNow
  p <- programPath
  pure (Path.render (os := st) p)

-- | the working directory, in the platform's style
cwdNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
cwdNow = do
  st <- styleNow
  d <- workingDir
  pure (Path.render (os := st) d)

-- | the directory the compiler at `self` came with: the repository it is
-- | built in (it is `.heff/out/heff` there), or a release or the heff
-- | home (`bin/heff`, what it ships beside `bin/`)
-- | >>> ownRoot (Path.styleOf "linux") "/r/.heff/out/heff"
-- | "/r"
-- | >>> ownRoot (Path.styleOf "linux") "/opt/heff-0.2.0/bin/heff"
-- | "/opt/heff-0.2.0"
ownRoot : Path.Style -> String -> String
ownRoot st self =
  if strEq (HostPath.basename st (HostPath.dirname st self)) "out"
     && strEq
       (HostPath.basename st (HostPath.dirname st (HostPath.dirname st self)))
       ".heff"
  then HostPath.dirname st (HostPath.dirname st (HostPath.dirname st self))
  else HostPath.dirname st (HostPath.dirname st self)

-- | where the standard library is: `HEFF_LIB`, else the `lib/` the
-- | compiler came with
libDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
libDir = do
  v <- getEnv "HEFF_LIB"
  case v of
    Just lib -> pure lib
    Nothing -> do
      st <- styleNow
      self <- selfPath
      pure (HostPath.join st (ownRoot st self) "lib")

-- | where packages are fetched to: `HEFF_MODCACHE`, else
-- | `~/.cache/heff/mod`
modDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
modDir = do
  v <- getEnv "HEFF_MODCACHE"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      HostPath.join
        st
        (HostPath.join st (fromMaybe (fromMaybe "." profile) home) ".cache")
        (HostPath.join st "heff" "mod"))

-- | where heff keeps what is the user's (`bin/`, the programs `heff
-- | install` installs, and beside it what they ship): `HEFF_HOME`, else
-- | `~/.heff`
heffHome : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
heffHome = do
  v <- getEnv "HEFF_HOME"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      HostPath.join st (fromMaybe (fromMaybe "." profile) home) ".heff")

-- | the package.hf of the heff running, which says its version: in the
-- | directory it came with
ownPackage : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
ownPackage = do
  st <- styleNow
  self <- selfPath
  pure (HostPath.join st (ownRoot st self) "package.hf")

-- | the file in the heff home that says the checkout it was installed
-- | from: `heff install` of heff's own package writes it
sourceFile : Path.Style -> String -> String
sourceFile st home = HostPath.join st home "source"

-- (the checkout a heff home's `source` says)
sourceSaid : Maybe String -> List String
sourceSaid (Just text) = if strEq (trim text) "" then Nil else [trim text]
sourceSaid Nothing = Nil

-- | the library, the packages fetched, the directory heff runs in, the
-- | style of the platform's paths, and where heff is from: the directory
-- | it came with, and the checkout it was installed from -- as that
-- | directory says, if it is a heff home, and as the heff home says
hostNow : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> Co e Load.Host
hostNow = do
  lib <- libDir
  mod <- modDir
  cwd <- cwdNow
  st <- styleNow
  self <- selfPath
  home <- heffHome
  came <- Files.readFile (sourceFile st (ownRoot st self))
  source <- Files.readFile (sourceFile st home)
  pure
      { lib = lib
      , mod = mod
      , cwd = cwd
      , style = st
      , heff =
          ownRoot st self :: List.append (sourceSaid came) (sourceSaid source)
      }

-- | the version of heff running: the heff its own package.hf is for
ownVersion : {e : HFunctor}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e (Maybe String)
ownVersion = do
  path <- ownPackage
  text <- Files.readFile path
  pure (case text of
    Just src -> case Project.readPackage src of
      Right p -> Just p.heff
      Left _ -> Nothing
    Nothing -> Nothing)

-- (what the package.hf at `path`, read, says of the heff running)
versionRead : String
            -> String
            -> Either Project.Problem Project.Package
            -> Either String String
versionRead path src (Right p) = Right ("heff " ^ p.heff)
versionRead path src (Left p) =
  Left ("not known: " ^ Load.problemMsg path src p)

-- | what `heff version` says: the heff running and its version, from the
-- | text of its package.hf at `path`; or, without one that reads, why
-- | that is not known
-- | >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\", heff = \"0.3.0\" }")
-- | Right "heff 0.3.0"
-- | >>> versionSaid "/h/package.hf" Nothing
-- | Left "not known: there is no /h/package.hf"
-- | >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\" }")
-- | Left "not known: /h/package.hf:1:11: the fields are module, heff, require, replace, in this order (require and replace may be left out)"
versionSaid : String -> Maybe String -> Either String String
versionSaid path Nothing = Left ("not known: there is no " ^ path)
versionSaid path (Just src) = versionRead path src (Project.readPackage src)

-- | say which heff is running: its version, as its package.hf says
versionCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Co e Unit
versionCmd = do
  path <- ownPackage
  text <- Files.readFile path
  case versionSaid path text of
    Right line -> print line
    Left why -> do
      printErr ("heff version: " ^ why)
      exit 1

-- | what is wrong with the heff a project is for, if anything: this heff
-- | is `running`
-- | what is wrong with the heff `who` is for, `wanted`, if anything:
-- | this heff is `running`
heffVersions : String
             -> String
             -> String
             -> Maybe (List Int)
             -> Maybe (List Int)
             -> Maybe String
heffVersions who wanted running (Just w) (Just r) =
  if Project.compatible w r then Nothing
  else Just
      (who
       ^ " is for heff "
       ^ wanted
       ^ (if strEq (strSlice wanted 0 2) "0." then " (the same 0.x)" else "")
       ^ ", and this heff is "
       ^ running)
heffVersions who wanted running _ _ = Nothing

heffFor : Maybe String -> String -> String -> Maybe String
heffFor (Just running) who wanted =
  heffVersions
    who
    wanted
    running
    (Project.version wanted)
    (Project.version running)
heffFor Nothing who wanted = Nothing

-- (a package, as said where it is wrong)
whoOf : Load.Pkg -> String
whoOf k =
  if strEq k.own "" then "package.hf: the project" else "the package " ^ k.path

-- (what is wrong with the heff each package is for: the project, then
-- those it requires)
heffErrors : Maybe String -> List Load.Pkg -> List String
heffErrors running [] = Nil
heffErrors running (project :: deps) =
  List.concatMap
    (\(k : Load.Pkg) -> case heffFor running (whoOf k) k.heff of
     Just why -> [why]
     Nothing -> Nil)
    (if strEq project.heff "" then deps else project :: deps)

withError : Load.Loaded -> String -> Load.Loaded
withError l e =
  { sources = l.sources
  , errors = e :: l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- | FILE and its import closure, loaded from FILE's project, which must
-- | be for this heff
load : {e : HFunctor}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> String
     -> Co e Load.Loaded
load file = do
  h <- hostNow
  l <- Load.loadProgram h file
  running <- ownVersion
  pure (List.foldl withError l (heffErrors running l.packages))

-- (the files given, each a module named as from the working directory,
-- one of the library's if it is under the library)
readAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> List String
        -> List String
        -> Co e (List Driver.Source)
readAll before [] = pure Nil
readAll before (path :: rest) = do
  mSrc <- Files.readFile path
  case mSrc of
    Nothing -> do
      printErr ("cannot read " ^ path)
      exit 1
      pure Nil
    Just src -> do
      st <- styleNow
      h <- hostNow
      more <- readAll (Load.moduleOf (Load.here st) path :: before) rest
      pure
          (Driver.givenAfter
             before
             (Load.moduleOf (Load.here st) path)
             path
             src
             (Load.ofLibrary (Load.hostPaths h) path)
           :: more)

printLines : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printLines [] = pure MkUnit
printLines (l :: rest) = do
  print l
  printLines rest

printDefs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Driver.Checked
          -> List String
          -> Co e Unit
printDefs c [] = pure MkUnit
printDefs c (k :: rest) = do
  printLines (Driver.dumpLines c k)
  printDefs c rest

printErrs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> String
          -> List String
          -> Int
          -> Co e Int
printErrs m [] n = pure n
printErrs m (l :: rest) n = do
  printErr (m ^ ": " ^ l)
  printErrs m rest (n + 1)

printAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> List Driver.Checked
         -> Int
         -> Co e Int
printAll [] bad = pure bad
printAll (c :: rest) bad = do
  printDefs c (Driver.moduleKeys c)
  n <- printErrs (Driver.moduleName c) (Driver.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> Co e Unit
selfcheck paths = do
  sources <- readAll Nil paths
  bad <- printAll (Driver.checkProgram sources) 0
  if bad == 0 then pure MkUnit else exit 1

-- (the errors said, the count comes back)
-- (each diagnostic said; how many are errors)
diagCount : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> List Driver.Checked
          -> Co e Int
diagCount [] = pure 0
diagCount (c :: rest) = do
  said <- printErrs (Driver.moduleName c) (Driver.diagLines c) 0
  m <- diagCount rest
  pure (List.length (Driver.errorsIn c) + m)

elemStrM : String -> List String -> Bool
elemStrM x [] = False
elemStrM x (y :: rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen [] = Nil
nubStrGo seen (x :: rest) =
  if elemStrM x seen then nubStrGo seen rest
  else x :: nubStrGo (x :: seen) rest

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- (the modules whose providers a program of these effects' modules is
-- bundled with: theirs, and the custodian's where std.domain's is, whose
-- `rooted` it answers -- its world need not have the custodian's effect)
providerModules : List String -> List String
providerModules ms =
  if elemStrM "std.domain" ms && not (elemStrM "custodian" ms)
  then List.append ms ["custodian"]
  else ms

-- the provider of a module, M.provider.js beside the M.hf it was loaded
-- from
pathOfModule : List Driver.Source -> String -> Maybe String
pathOfModule [] m = Nothing
pathOfModule (s :: rest) m =
  if strEq s.module m then Just s.path else pathOfModule rest m

readProviderAt : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> List Driver.Source
               -> String
               -> Co e (Maybe Emit.Provider)
readProviderAt sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- Files.readFile (Load.dropHf path ^ ".provider.js")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProviders : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> List Driver.Source
              -> List String
              -> Co e (List Emit.Provider)
readProviders sources [] = pure Nil
readProviders sources (m :: rest) = do
  p <- readProviderAt sources m
  ps <- readProviders sources rest
  pure (case p of
    Just pr -> pr :: ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere)
forHost : String -> Emit.Provider -> Bool
forHost host p = case Emit.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

-- The library's halves: lib/browser/ is the page's, lib/std/'s effects
-- the system's, by C (but those with a provider in JavaScript too:
-- std.reference, std.time), and so are those of lib/std/ that import one of
-- them, however far down (std.http.server, by std.http and std.net).
-- An import of the other half is an error there.
--------------------------------------------------------------------------------

browserRefused : Driver.Source -> Driver.Refused
browserRefused s =
  { module = s.module
  , code = 351
  , msg =
      "`"
      ^ s.module
      ^ "` is the browser's (lib/browser/), for JavaScript: a C program (--backend=c) cannot import it"
  , note = Nothing
  }

systemRefused : String -> Driver.Source -> Driver.Refused
systemRefused host s =
  { module = s.module
  , code = 352
  , msg =
      "`"
      ^ s.module
      ^ "` is an effect of the system (lib/std/), for C: it has no provider for --backend="
      ^ host
  , note = Nothing
  }

-- (what the first of the imports `path` does, by which the last is
-- reached: "imports `b`, which imports it")
importsOn : List String -> String
importsOn [a, b] = "imports it"
importsOn (a :: b :: rest) =
  "imports `" ^ b ^ "`, which " ^ importsOn (b :: rest)
importsOn _ = ""

-- (a module of lib/std/ that imports one with no provider for `host`, by
-- the imports `path`, the last that one)
reachingRefused : String -> Driver.Source -> List String -> Driver.Refused
reachingRefused host s path =
  { module = s.module
  , code = 352
  , msg =
      "`"
      ^ s.module
      ^ "` is the system's (lib/std/), for C: it imports an effect with no provider for --backend="
      ^ host
  , note =
      Just
        ("`"
         ^ fromMaybe s.module (List.last path)
         ^ "` is that effect: `"
         ^ s.module
         ^ "` "
         ^ importsOn path)
  }

isBrowser : Driver.Source -> Bool
isBrowser s = s.library && startsWith "browser." s.module

isStd : Driver.Source -> Bool
isStd s = s.library && startsWith "std." s.module

jsFor : String -> String -> Maybe String -> Bool
jsFor host m Nothing = False
jsFor host m (Just t) = forHost host { module = m, text = t }

-- (one of lib/std/'s with a provider in C, and none in JavaScript for
-- `host`: one for another host, or none at all)
systemOnly : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> Driver.Source
           -> Co e Bool
systemOnly host s = do
  c <- Files.readFile (Load.dropHf s.path ^ ".provider.c")
  js <- Files.readFile (Load.dropHf s.path ^ ".provider.js")
  pure (case c of
    Just _ -> not (jsFor host s.module js)
    Nothing -> False)

-- (lib/std/'s effects of the system with no provider for `host`)
systemOnlyOf : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> String
             -> List Driver.Source
             -> Co e (List String)
systemOnlyOf host [] = pure Nil
systemOnlyOf host (s :: rest) = do
  ms <- systemOnlyOf host rest
  if isStd s
  then do
    only <- systemOnly host s
    pure (if only then s.module :: ms else ms)
  else pure ms

hasName : String -> List String -> Bool
hasName m ms = List.any (\n -> strEq n m) ms

-- (the modules a module imports, as `sources` has it)
importedBy : List Driver.Source -> String -> List String
importedBy sources m =
  maybe
    Nil
    (\(s : Driver.Source) ->
       Driver.importNames (Driver.importsOfSource s).imports)
    (List.find (\(s : Driver.Source) -> strEq s.module m) sources)

-- (from the modules to go through, each with the imports it was reached
-- by, the last it, those gone through already left: the imports by
-- which one of `only` is reached first, depth first)
reachOnly : List Driver.Source
          -> List String
          -> List String
          -> List (List String)
          -> Maybe (List String)
reachOnly sources only seen [] = Nothing
reachOnly sources only seen (path :: rest) =
  let m = fromMaybe "" (List.last path)
  in if hasName m seen then reachOnly sources only seen rest
  else if hasName m only then Just path
  else reachOnly
      sources
      only
      (m :: seen)
      (List.append
         (List.map (\i -> List.append path [i]) (importedBy sources m))
         rest)

-- (a module of lib/std/ refused, where it is an effect with no provider
-- for `host` or reaches one)
refusedReaching : String
                -> List Driver.Source
                -> List String
                -> Driver.Source
                -> Maybe Driver.Refused
refusedReaching host sources only s =
  if not (isStd s) then Nothing
  else if hasName s.module only then Just (systemRefused host s)
  else maybe
      Nothing
      (\path -> Just (reachingRefused host s path))
      (reachOnly sources only Nil [[s.module]])

refusedJs : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> String
          -> List Driver.Source
          -> Co e (List Driver.Refused)
refusedJs host sources = do
  only <- systemOnlyOf host sources
  pure
      (Driver.catMaybesD (List.map (refusedReaching host sources only) sources))

-- | the library's modules a program for `host` may not import: in C,
-- | lib/browser/'s; in JavaScript, lib/std/'s effects of the system, and
-- | lib/std/'s modules that import one, however far down
refusedFor : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> List Driver.Source
           -> Co e (List Driver.Refused)
refusedFor host sources =
  if strEq host "c"
  then pure
      (List.map (\s -> browserRefused s) (List.keepIf isBrowser sources))
  else refusedJs host sources

-- | the modules of a program, each use of std.fuel's `limited` warned of
-- | where it is built without fuel (`fuel` false)
unfueledWarned : Bool -> List Driver.Checked -> List Driver.Checked
unfueledWarned True cs = cs
unfueledWarned False cs = List.map Driver.withLimitedWarned cs

-- | the modules checked, each import of what `host` refuses an error at
-- | the import
refusedChecked : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> String
               -> List Driver.Source
               -> List Driver.Checked
               -> Co e (List Driver.Checked)
refusedChecked host sources cs = do
  rs <- refusedFor host sources
  pure (List.map (\c -> Driver.withRefused rs sources c) cs)

providesLeaf : List Emit.Provider -> String -> Bool
providesLeaf [] k = False
providesLeaf (p :: rest) k =
  if strEq p.module (Effect.moduleOfKey k)
     && elemStrM (Effect.nameOfKey k) (Emit.exportedNames p.text)
  then True
  else providesLeaf rest k

emitErrs : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
emitErrs [] = pure MkUnit
emitErrs (e :: rest) = do
  printErr ("heff: not compiled: " ^ e)
  emitErrs rest

putFileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{rep : Report.report <: e}}
             -> List Driver.Checked
             -> Co e Unit
putFileDiags [] = pure MkUnit
putFileDiags (c :: rest) = do
  color <- Report.errColor
  if List.null c.diags then pure MkUnit
  else writeErr (Render.renderFileDiags color c.path c.source c.diags)
  putFileDiags rest

anyErrors : List Driver.Checked -> Bool
anyErrors cs =
  List.any (\(c : Driver.Checked) -> not (List.null (Driver.errorsIn c))) cs

-- (the first error of the modules checked, where it is)
firstErrorOf : List Driver.Checked -> Maybe String
firstErrorOf [] = Nothing
firstErrorOf (c :: rest) = case Driver.firstError c of
  Just why -> Just why
  Nothing -> firstErrorOf rest

-- (`done`: what follows the written program)
writeOut : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> String
         -> Co e Unit
         -> Emit.Output
         -> Co e Unit
writeOut outPath done o = do
  emitErrs o.errors
  if List.null o.errors
  then do
    ok <- Files.writeFile outPath o.source
    if ok then done
    else do
      printErr ("cannot write " ^ outPath)
      exit 1
  else exit 1

-- | the runtime a C program is built with: its C, bundled into the
-- | header every part includes, and its Zig, written beside the
-- | program's C -- among the parts as `heff.zig`, or beside a program
-- | of one file `F.c` as `F.zig` -- for zig to build into an object of
-- | its own
-- | the runtime: its C, its Zig, and its part for fuel, bundled only
-- | where it is needed (`runtimeOf`)
type RuntimeC = { c : String, zig : String, fuel : String, custody : String }

-- (a provider that needs the runtime's part for fuel says so)
saysFuel : Emit.Provider -> Bool
saysFuel p = List.any (\l -> startsWith "#define HEFF_FUEL" l) (lines p.text)

-- (a provider that needs the runtime's part for custodians says so)
saysCustody : Emit.Provider -> Bool
saysCustody p =
  List.any (\l -> startsWith "#define HEFF_CUSTODY" l) (lines p.text)

-- (... with its part for custodians where a provider needs it)
custodied : List Emit.Provider -> RuntimeC -> String -> String
custodied provs rt c =
  if List.any saysCustody provs then c ^ "\n" ^ rt.custody else c

-- | the runtime's C a program is bundled with: with its part for fuel
-- | where the program is built with fuel (`fuel`), or a provider of its
-- | needs it, and its part for custodians where a provider needs that
-- | -- else as it is, so that a program with neither is as it would be
-- | with no fuel nor custodians at all
runtimeOf : Bool -> List Emit.Provider -> RuntimeC -> String
runtimeOf fuel provs rt =
  custodied
    provs
    rt
    (if fuel || List.any saysFuel provs then rt.c ^ "\n" ^ rt.fuel else rt.c)

-- (where the runtime's Zig goes beside a program of one file: `F.zig`,
-- for `F.c` or `F`)
zigBeside : String -> String
zigBeside path =
  (if endsWith ".c" path then strSlice path 0 (strLength path - 2) else path)
  ^ ".zig"

-- (the runtime's Zig the compiler writes with `OUT`, a program of one
-- file or of parts, `DIR/`)
zigOf : String -> String
zigOf outPath =
  if endsWith "/" outPath then outPath ^ "heff.zig" else zigBeside outPath

-- (where the flags `zig cc` is given for what the program's modules say
-- their C needs are kept, a flag a line: `DIR/heff.link`, or `F.link`
-- beside a program of one file)
linkOf : String -> String
linkOf outPath =
  if endsWith "/" outPath then outPath ^ "heff.link"
  else (if endsWith ".c" outPath
        then strSlice outPath 0 (strLength outPath - 2)
        else outPath)
    ^ ".link"

-- (a C program of one file written, its runtime's Zig beside it; then
-- `done`)
writeOutC : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> String
          -> String
          -> Co e Unit
          -> Emit.Output
          -> Co e Unit
writeOutC outPath zig done o =
  writeOut
    outPath
    (do
     ok <- Files.writeFile (zigBeside outPath) zig
     if ok then done
     else do
       printErr ("cannot write " ^ zigBeside outPath)
       exit 1)
    o

-- (a part written, unless it is there as it was: a C compiler that goes
-- by when a file changed -- zig's -- builds it again only if it did)
writeChanged : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> String
             -> String
             -> Maybe String
             -> Co e Bool
writeChanged path text (Just was) =
  if strEq was text then pure True else Files.writeFile path text
writeChanged path text Nothing = Files.writeFile path text

-- (the parts of a C program, each `DIR/NAME`, written where changed)
writePartsGo : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> String
             -> List (Pair String String)
             -> Co e Bool
writePartsGo dir [] = pure True
writePartsGo dir (MkPair name text :: rest) = do
  st <- styleNow
  was <- Files.readFile (HostPath.join st dir name)
  ok <- writeChanged (HostPath.join st dir name) text was
  if ok then writePartsGo dir rest else pure False

-- (what is in `dir` and is no part of the program -- a module no longer
-- in it -- gone, so that it is not built)
removeStale : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> String
            -> List (Pair String String)
            -> List String
            -> Co e Unit
removeStale dir parts [] = pure MkUnit
removeStale dir parts (n :: rest) = do
  st <- styleNow
  gone <-
    if List.any (\p -> strEq (fst p) n) parts then pure True
    else Files.remove (HostPath.join st dir n)
  removeStale dir parts rest

-- | a C program as parts, in the directory `dir`: each part written
-- | only if it changed, and what is no part of it gone
writeParts : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> String
           -> Co e Unit
           -> Pair (List (Pair String String)) (List String)
           -> Co e Unit
writeParts dir done (MkPair parts errors) = do
  emitErrs errors
  if List.null errors
  then do
    made <- Files.makeDirectory dir
    names <- Files.readDirectory dir
    u <- removeStale dir parts (fromMaybe Nil names)
    ok <- writePartsGo dir parts
    if ok then done
    else do
      printErr ("cannot write " ^ dir)
      exit 1
  else exit 1

-- The backend's cache (heff.build.backcache), `.heff/<backDir>/`
--------------------------------------------------------------------------------

-- | where a program's backend cache is, and what it is given: the
-- | project's paths, each definition's hash (the elaboration cache's),
-- | the program's modules
type BackIn =
  { paths : Load.Paths
  , hashes : OrdMap.OrdMap String String
  , modules : List String
  , fuel : Bool
  }

backDirOf : Load.Paths -> String
backDirOf ps = Load.under ps (Load.under ps ps.root ".heff") BackCache.backDir

backPath : Load.Paths -> String -> String
backPath ps m = Load.under ps (backDirOf ps) (m ^ ".hb")

-- (a file written whole, or not at all: written beside it, then moved in
-- its place)
writeWhole : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> String
           -> String
           -> Co e Bool
writeWhole path text = do
  ok <- Files.writeFile (path ^ "." ^ debug (strLength text) ^ ".tmp") text
  if ok then Files.replace (path ^ "." ^ debug (strLength text) ^ ".tmp") path
  else pure False

-- (the hash kept with the copy of the executable `b`, if `kept` is one:
-- the hash, a newline, then the executable)
keptId : String -> Maybe Int -> String -> Maybe String
keptId b (Just at) kept =
  if strLength kept - at - 1 == strLength b
     && strEq (strSlice kept (at + 1) (strLength kept)) b
  then Just (strSlice kept 0 at)
  else Nothing
keptId b Nothing kept = Nothing

-- (the copy kept, with its hash `id`)
selfKept : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> String
         -> String
         -> Co e String
selfKept ps b id = do
  made <- Files.makeDirectory (backDirOf ps)
  ok <- writeWhole (Load.under ps (backDirOf ps) "compiler") (id ^ "\n" ^ b)
  pure id

selfFrom : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> String
         -> Maybe String
         -> Co e String
selfFrom ps b (Just kept) = case keptId b (indexOf "\n" kept 0) kept of
  Just id -> pure id
  Nothing -> selfFrom ps b Nothing
selfFrom ps b Nothing = selfKept ps b (Cache.strHash b)

-- | the compiler's own hash: of its executable ("" where it cannot be
-- | read, the cache then not used).  Hashing it would take long each
-- | time, so a copy of it is kept beside the cache, its hash first: an
-- | executable the same as the copy has its hash.
selfHash : {e : HFunctor}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> Load.Paths
         -> Co e String
selfHash ps = do
  p <- selfPath
  t <- Files.readFile p
  case t of
    Just b -> do
      kept <- Files.readFile (Load.under ps (backDirOf ps) "compiler")
      selfFrom ps b kept
    Nothing -> pure ""

-- (each module's file, as it is: its text)
readBacks : {e : HFunctor}
          -> {{disk : filesystem <: e}}
          -> Load.Paths
          -> List String
          -> Co e (List (Pair String String))
readBacks ps [] = pure Nil
readBacks ps (m :: rest) = do
  t <- Files.readFile (backPath ps m)
  more <- readBacks ps rest
  pure (case t of
    Just text -> MkPair m text :: more
    Nothing -> more)

-- (each file written, where it is not as it was)
writeBacks : {e : HFunctor}
           -> {{disk : filesystem <: e}}
           -> Load.Paths
           -> OrdMap.OrdMap String String
           -> List (Pair String String)
           -> Co e Unit
writeBacks ps olds [] = pure MkUnit
writeBacks ps olds (MkPair m text :: rest) = do
  ok <-
    if strEq text (fromMaybe "" (OrdMap.lookup olds m))
    then pure True
    else writeWhole (backPath ps m) text
  writeBacks ps olds rest

textsMap : List (Pair String String) -> OrdMap.OrdMap String String
textsMap ps =
  List.foldl (\m p -> OrdMap.insert m (fst p) (snd p)) OrdMap.empty ps

backsOf : String
        -> List (Pair String String)
        -> OrdMap.OrdMap String BackCache.Back
backsOf id ps =
  List.foldl
    (\m p -> OrdMap.insert m (fst p) (BackCache.readBack id (snd p)))
    OrdMap.empty
    ps

modsOf : List String -> OrdMap.OrdMap String Unit
modsOf ms = List.foldl (\m k -> OrdMap.insert m k MkUnit) OrdMap.empty ms

-- (the parts written, then what the cache is to keep anew -- `texts`,
-- the files as they were, `backs`, what they kept -- then `done`)
keptWritten : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> BackIn
            -> String
            -> String
            -> String
            -> List (Pair String String)
            -> OrdMap.OrdMap String BackCache.Back
            -> Co e Unit
            -> EmitC.PartsKept
            -> Co e Unit
keptWritten bi dir zig id texts backs done out =
  writeParts
    dir
    (if strEq id "" then done
     else do
       made <- Files.makeDirectory (backDirOf bi.paths)
       writeBacks
           bi.paths
           (textsMap texts)
           (BackCache.backTexts
              id
              { mods = modsOf ("_" :: bi.modules), olds = backs }
              { groups = out.groups
              , copies = out.copies
              , emits = out.emits
              , jss = Nil
              })
       done)
    (MkPair (MkPair "heff.zig" zig :: out.parts) out.errors)

keptWith : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> BackIn
         -> String
         -> RuntimeC
         -> Co e Unit
         -> Driver.Checked
         -> List Emit.Provider
         -> Driver.Runnable
         -> String
         -> List (Pair String String)
         -> OrdMap.OrdMap String BackCache.Back
         -> Co e Unit
keptWith bi dir rt done c available r id texts backs =
  keptWritten
    bi
    dir
    rt.zig
    id
    texts
    backs
    done
    (EmitC.compileProgramPartsKept
       bi.fuel
       (runtimeOf bi.fuel available rt)
       available
       c.top.globals
       r.key
       r.effect
       bi.hashes
       (BackCache.keepsOf (List.map snd (OrdMap.toList backs)))
       (BackCache.emitsOf (List.map snd (OrdMap.toList backs))))

-- (the parts of the program running `r`, made through the cache)
keptParts : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> BackIn
          -> String
          -> RuntimeC
          -> Co e Unit
          -> Driver.Checked
          -> List Emit.Provider
          -> Driver.Runnable
          -> Co e Unit
keptParts bi dir rt done c available r = do
  id <- selfHash bi.paths
  texts <-
    if strEq id "" then pure Nil else readBacks bi.paths ("_" :: bi.modules)
  keptWith bi dir rt done c available r id texts (backsOf id texts)

-- (the JavaScript of the program running `r`, written -- then what the
-- cache is to keep anew, `texts` the files as they were, `backs` what
-- they kept -- then `done`)
jsKeptWritten : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> BackIn
              -> String
              -> String
              -> List (Pair String String)
              -> OrdMap.OrdMap String BackCache.Back
              -> Co e Unit
              -> Emit.OutputKept
              -> Co e Unit
jsKeptWritten bi outPath id texts backs done out =
  writeOut
    outPath
    (if strEq id "" then done
     else do
       made <- Files.makeDirectory (backDirOf bi.paths)
       writeBacks
           bi.paths
           (textsMap texts)
           (BackCache.backTexts
              id
              { mods = modsOf ("_" :: bi.modules), olds = backs }
              { groups = out.groups
              , copies = out.copies
              , emits = Nil
              , jss = out.jss
              })
       done)
    out.output

-- (the page's script running `r`, simplified through the cache)
jsKept : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> BackIn
       -> String
       -> Co e Unit
       -> Driver.Checked
       -> List Emit.Provider
       -> Driver.Runnable
       -> Co e Unit
jsKept bi outPath done c available r = do
  id <- selfHash bi.paths
  texts <-
    if strEq id "" then pure Nil else readBacks bi.paths ("_" :: bi.modules)
  jsKeptWritten
      bi
      outPath
      id
      texts
      (backsOf id texts)
      done
      (Emit.compileProgramKept
         bi.fuel
         available
         c.top.globals
         r.key
         r.effect
         bi.hashes
         (BackCache.keepsOf (List.map snd (OrdMap.toList (backsOf id texts))))
         (BackCache.jssOf (List.map snd (OrdMap.toList (backsOf id texts)))))

compileFound : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> BackIn
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Driver.Checked
             -> List Emit.Provider
             -> Co e Unit
compileFound bi file name outPath done c available = case Driver.findRunnable
    (List.keepIf (\k -> providesLeaf available k) (Driver.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    exit 1
  Right r -> jsKept bi outPath done c available r

-- (a computation whose effects all have providers for a page: each
-- world's algebra is bundled in from its module's M.provider.js)
compileLast : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> BackIn
            -> List Driver.Source
            -> String
            -> Maybe String
            -> String
            -> Co e Unit
            -> List Driver.Checked
            -> Co e Unit
compileLast bi sources file name outPath done cs = case Driver.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProviders
        sources
        (providerModules
           (nubStrM
              (List.map
                 (\k -> Effect.moduleOfKey k)
                 (Driver.candidateLeaves c))))
    compileFound
        bi
        file
        name
        outPath
        done
        c
        (List.keepIf (\p -> forHost "page" p) found)

compileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> BackIn
             -> List Driver.Source
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Bool
             -> List Driver.Checked
             -> Co e Unit
compileDiags bi sources file name outPath done badL checked = do
  cs0 <- refusedChecked "page" sources checked
  let cs = unfueledWarned bi.fuel cs0
  putFileDiags cs
  if badL || anyErrors cs then exit 1
  else compileLast bi sources file name outPath done cs

-- (what the backend's cache is given, of a program loaded and checked,
-- built with fuel or not)
backInOf : Bool -> Load.Loaded -> Session.CacheAcc -> BackIn
backInOf fuel l acc =
  { paths = l.paths
  , hashes = acc.hashes
  , modules = List.map (\(c : Driver.Checked) -> c.module) acc.done
  , fuel = fuel
  }

-- | compile the computation `name` of FILE to a page's script, then go
-- | on with `done`
compileThen : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> Bool
            -> Maybe String
            -> String
            -> String
            -> Co e Unit
            -> Co e Unit
compileThen fuel name outPath file done = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  acc <- Session.cachedAcc l
  compileDiags
      (backInOf fuel l acc)
      l.sources
      file
      name
      outPath
      done
      (badL > 0)
      acc.done

-- | `heff compile --backend=page`: FILE's computation `name`, a page's
-- | script, its import closure loaded with the compiler's own loader
appCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> Bool
       -> Maybe String
       -> String
       -> String
       -> Co e Unit
appCmd fuel name outPath file =
  compileThen
    fuel
    name
    outPath
    file
    (print
       ("wrote "
        ^ outPath
        ^ ": load it in a page with <script src=\"...\"> (it imports nothing: it opens from file:// too)"))

ownExport : Driver.Own -> Emit.Export
ownExport o = Emit.mkExport o.name o.key

compileJsOut : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> String
             -> Bool
             -> Emit.Output
             -> Co e Unit
compileJsOut outPath bad o = do
  ok <- Files.writeFile outPath o.source
  emitErrs o.errors
  if ok then pure MkUnit else printErr ("cannot write " ^ outPath)
  if ok && not bad && List.null o.errors then pure MkUnit else exit 1

compileJsDiags : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : filesystem <: e}}
               -> {{rep : Report.report <: e}}
               -> String
               -> String
               -> Bool
               -> List Driver.Checked
               -> Co e Unit
compileJsDiags file outPath badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      compileJsOut
        outPath
        (badL || anyErrors cs)
        (Emit.compileJs
           c.top.globals
           (List.map (\o -> ownExport o) (Driver.listedOwn c)))

-- | an ES module of FILE and what it imports
compileJsCmd : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> String
             -> String
             -> Co e Unit
compileJsCmd file outPath = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  compileJsDiags file outPath (badL > 0) cs

-- The C backend
--------------------------------------------------------------------------------

-- (a world's provider for the C backend: `M.provider.c` beside `M.hf`)
readProviderC : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> List Driver.Source
              -> String
              -> Co e (Maybe Emit.Provider)
readProviderC sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- Files.readFile (Load.dropHf path ^ ".provider.c")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProvidersC : {e : HFunctor}
               -> {{disk : filesystem <: e}}
               -> List Driver.Source
               -> List String
               -> Co e (List Emit.Provider)
readProvidersC sources [] = pure Nil
readProvidersC sources (m :: rest) = do
  p <- readProviderC sources m
  ps <- readProvidersC sources rest
  pure (case p of
    Just pr -> pr :: ps
    Nothing -> ps)

providesLeafC : List Emit.Provider -> String -> Bool
providesLeafC [] k = False
providesLeafC (p :: rest) k =
  if strEq p.module (Effect.moduleOfKey k)
     && elemStrM (Effect.nameOfKey k) (EmitC.providedNames p.text)
  then True
  else providesLeafC rest k

compileFoundC : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> BackIn
              -> String
              -> Maybe String
              -> String
              -> RuntimeC
              -> (String -> Co e Unit)
              -> Co e Unit
              -> Driver.Checked
              -> List Emit.Provider
              -> Co e Unit
compileFoundC bi file name outPath rt failed done c available = case Driver.findRunnable
    (List.keepIf (\k -> providesLeafC available k) (Driver.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    failed ("heff: " ^ file ^ ": " ^ why)
  Right r ->
    -- (a directory, `OUT/`: the program as parts, a file for each module)
    if endsWith "/" outPath
    then keptParts
        bi
        (strSlice outPath 0 (strLength outPath - 1))
        rt
        done
        c
        available
        r
    else writeOutC
        outPath
        rt.zig
        done
        (EmitC.compileProgramC
           bi.fuel
           (runtimeOf bi.fuel available rt)
           available
           c.top.globals
           r.key
           r.effect)

-- (a file of the runtime, the library's `c/NAME`: its text)
readRuntimeFile : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> String
                -> Co e String
readRuntimeFile name = do
  lib <- libDir
  st <- styleNow
  text <- Files.readFile (HostPath.join st (HostPath.join st lib "c") name)
  case text of
    Nothing -> do
      printErr
          ("heff: no C runtime at "
           ^ HostPath.join st (HostPath.join st lib "c") name)
      exit 1
      pure ""
    Just t -> pure t

-- (the runtime, what a C program is bundled with: its C -- with the
-- float functions it carries itself where zig's compiler_rt would give
-- its own -- and its Zig)
readRuntimeC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> Co e RuntimeC
readRuntimeC = do
  rest <- readRuntimeFile "runtime.c"
  floats <- readRuntimeFile "fdlibm.c"
  c <- pure (rest ^ "\n" ^ floats)
  zig <- readRuntimeFile "runtime.zig"
  fuel <- readRuntimeFile "fuel.c"
  custody <- readRuntimeFile "custody.c"
  pure { c = c, zig = zig, fuel = fuel, custody = custody }

-- (pkg-config's flags of the packages, `what` `--cflags` or `--libs`:
-- its words; or what it said, where it could not give them)
pkgConfigFlags : {e : HFunctor}
               -> {{sys : process <: e}}
               -> String
               -> List String
               -> Co e (Either String (List String))
pkgConfigFlags what [] = pure (Right Nil)
pkgConfigFlags what names = do
  r <- run { command = "pkg-config", args = what :: names }
  pure
      (if succeeded r then Right (words r.out)
       else Left
           ("`pkg-config "
            ^ what
            ^ " "
            ^ joinWith " " names
            ^ "` could not say how: "
            ^ trim r.err))

-- (a framework's flags, on the platform `os`: macOS's alone has them)
frameworkFlags : String -> String -> List String
frameworkFlags "darwin" f = ["-framework", f]
frameworkFlags os f = Nil

-- | the flags `zig cc` is given for what the program's modules say their
-- | C needs, built on the platform `os` (Node.js's name): pkg-config's
-- | for its packages, then `-lNAME` of each library, then each framework
-- | -- macOS's only; elsewhere none -- each once; or why they cannot be
-- | said
linkFlags : {e : HFunctor}
          -> {{sys : process <: e}}
          -> String
          -> List Glue.Links
          -> Co e (Either String (List String))
linkFlags os ls = do
  pkgs <- pure (nubStrM (List.concatMap (\(l : Glue.Links) -> l.pkgConfig) ls))
  cflags <- pkgConfigFlags "--cflags" pkgs
  libs <- pkgConfigFlags "--libs" pkgs
  pure (case cflags of
    Left why -> Left why
    Right cs -> case libs of
      Left why -> Left why
      Right lfs ->
        Right
          (List.append
             (nubStrM (List.append cs lfs))
             (List.append
                (List.map
                   (\lib -> "-l" ^ lib)
                   (nubStrM
                      (List.concatMap (\(l : Glue.Links) -> l.libs) ls)))
                (List.concatMap
                   (frameworkFlags os)
                   (nubStrM
                      (List.concatMap
                         (\(l : Glue.Links) -> l.frameworks)
                         ls))))))

-- (the flags written where the build reads them, `linkOf outPath`, a
-- flag a line -- none, the file gone -- then `done`)
linkWritten : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> String
            -> List String
            -> Co e Unit
            -> Co e Unit
linkWritten outPath [] done = do
  _ <- Files.remove (linkOf outPath)
  done
linkWritten outPath flags done = do
  was <- Files.readFile (linkOf outPath)
  ok <- writeChanged (linkOf outPath) (joinWith "\n" flags ^ "\n") was
  if ok then done
  else do
    printErr ("cannot write " ^ linkOf outPath)
    exit 1

compileLastC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> BackIn
             -> List Driver.Source
             -> String
             -> Maybe String
             -> String
             -> (String -> Co e Unit)
             -> Co e Unit
             -> List Driver.Checked
             -> Co e Unit
compileLastC bi sources file name outPath failed done cs = case Driver.lastChecked
    cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProvidersC
        sources
        (providerModules
           (nubStrM
              (List.map
                 (\k -> Effect.moduleOfKey k)
                 (Driver.candidateLeaves c))))
    rt <- readRuntimeC
    case name of
      -- (no computation named: each of the file's definitions, shown)
      Nothing -> do
        ok <- Files.writeFile (zigBeside outPath) rt.zig
        if ok then pure MkUnit
        else printErr ("cannot write " ^ zigBeside outPath)
        compileJsOut
            outPath
            (not ok)
            (EmitC.compileCheckC
               rt.c
               c.top.globals
               (List.map
                  (\(o : Driver.Own) -> MkPair o.name o.key)
                  (Driver.listedOwn c)))
      -- (with the providers written by hand, the glue of the operations
      -- the effects' modules describe in C, made here)
      Just _ -> case Glue.gluesOf
          c.top.globals
          (providesLeafC found)
          (Driver.candidateLeaves c) of
        Left why -> do
          printErr ("heff: " ^ file ^ ": " ^ why)
          failed ("heff: " ^ file ^ ": " ^ why)
        Right glues -> case Glue.linksIn c.top.globals of
          Left why -> do
            printErr ("heff: " ^ file ^ ": " ^ why)
            failed ("heff: " ^ file ^ ": " ^ why)
          Right links -> do
            os <- platform
            flags <- linkFlags os links
            case flags of
              Left why -> do
                printErr ("heff: " ^ file ^ ": " ^ why)
                failed ("heff: " ^ file ^ ": " ^ why)
              Right fs ->
                compileFoundC
                  bi
                  file
                  name
                  outPath
                  rt
                  failed
                  (linkWritten outPath fs done)
                  c
                  (List.append found (List.map EmitC.glueProvider glues))

-- | compile the computation `name` of FILE, loaded (`l`), to C -- one
-- | file, or, OUT a directory (`dir/`), a file a module -- then go on
-- | with `done`; with no `name`, one file that shows each of FILE's
-- | definitions asked for, as the tests ask
-- | as `cLoaded`, but where it cannot be compiled -- it has errors, said
-- | on the error stream -- `failed` of why, its first error, not the end
cLoadedOr : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> Bool
          -> (String -> Co e Unit)
          -> Load.Loaded
          -> Maybe String
          -> String
          -> String
          -> Co e Unit
          -> Co e Unit
cLoadedOr fuel failed l name outPath file done = do
  badL <- printErrs "heff" l.errors 0
  acc <- Session.cachedAcc l
  cs0 <- refusedChecked "c" l.sources acc.done
  let cs = unfueledWarned fuel cs0
  putFileDiags cs
  if badL > 0 || anyErrors cs
  then failed
      (fromMaybe
         (file ^ ": it does not check")
         (firstErrorOf cs))
  else compileLastC
      (backInOf fuel l acc)
      l.sources
      file
      name
      outPath
      failed
      done
      cs

cLoaded : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> Bool
        -> Load.Loaded
        -> Maybe String
        -> String
        -> String
        -> Co e Unit
        -> Co e Unit
cLoaded fuel l name outPath file done =
  cLoadedOr fuel (\why -> exit 1) l name outPath file done

-- | compile the computation `name` of FILE to C, as `cLoaded`
cThen : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{rep : Report.report <: e}}
      -> Bool
      -> Maybe String
      -> String
      -> String
      -> Co e Unit
      -> Co e Unit
cThen fuel name outPath file done = do
  l <- load file
  cLoaded fuel l name outPath file done

cCmd : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{rep : Report.report <: e}}
     -> Bool
     -> Maybe String
     -> String
     -> String
     -> Co e Unit
cCmd fuel name outPath file =
  cThen
    fuel
    name
    outPath
    file
    (print
       ("wrote "
        ^ outPath
        ^ ": build it with `zig build-obj -O ReleaseFast "
        ^ zigOf outPath
        ^ " -femit-bin=runtime.o` and `zig cc -O2 "
        ^ (if endsWith "/" outPath then outPath ^ "*.c" else outPath)
        ^ " runtime.o -o PROGRAM -lm`, with the flags in "
        ^ linkOf outPath
        ^ " where its modules' C needs more"))

-- | `heff dump-c FILE OUT`: one C file that shows each of FILE's
-- | definitions, as the tests hold it to the interpreter's values
dumpCCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> String
         -> String
         -> Co e Unit
dumpCCmd file outPath = cThen False Nothing outPath file (pure MkUnit)

ranOut : Ran -> String
ranOut r = r.out

-- (why a command was not run, said on a line of its own; none where it
-- was)
notRunSaid : Ended -> String
notRunSaid (NotRun err) = show err ^ "\n"
notRunSaid _ = ""

-- | what a command wrote to its error stream; where it was not run, why
ranErr : Ran -> String
ranErr r = notRunSaid r.ended ^ r.err

-- | where `heff build` writes the project's programs: `.heff/bin/`
binDir : Path.Style -> String
binDir st = HostPath.join st ".heff" "bin"

-- | what a build makes, and where: the project at `root`, its programs
-- | written to `bin`, each said as it is made (`wrote`, `installed`); a
-- | page's script made too, if `pages`; what the programs ship put in
-- | `shipTo`, if it is given; their C built by zig at `opt`
type Target =
  { root : String
  , bin : String
  , said : String
  , pages : Bool
  , shipTo : Maybe String
  , opt : String
  }

-- | `heff build`'s: the project at `root`, its programs in `.heff/bin/`,
-- | built for the next change made, not to run their fastest: `-O1`,
-- | which zig builds in half the time `-O2` takes (`heff install` builds
-- | them with `-O2`)
buildTarget : Path.Style -> String -> Target
buildTarget st root =
  { root = root
  , bin = HostPath.join st root (binDir st)
  , said = "wrote"
  , pages = True
  , shipTo = Nothing
  , opt = "-O1"
  }

-- (a path of the project)
inProject : Path.Style -> Target -> String -> String
inProject st t p = HostPath.join st t.root p

-- (`app/X/F`, of the project)
appFile : Path.Style -> Target -> String -> String -> String
appFile st t x f =
  inProject st t (HostPath.join st (HostPath.join st "app" x) f)

-- (where the program X is built: `.heff/build/X/`, its C and what is
-- made of it)
partsDir : Path.Style -> Target -> String -> String
partsDir st t x =
  inProject st t (HostPath.join st (HostPath.join st ".heff" "build") x)

-- (`n`, made of the program X, in the project: `.heff/build/X/n`)
builtAt : Path.Style -> Target -> String -> String -> String
builtAt st t x n = HostPath.join st (partsDir st t x) n

-- | a program of the project: `app/X/` with a build.hf is the program X,
-- | built as its build.hf says
type App = { name : String, build : Project.Build }

-- | the project's programs read so far, and the build.hf among them that
-- | could not be read
type Apps = { apps : List App, bad : Int }

-- (a file or a directory is at `path`)
isThere : {e : HFunctor} -> {{disk : filesystem <: e}} -> String -> Co e Bool
isThere path = do
  dir <- Files.readDirectory path
  case dir of
    Just _ -> pure True
    Nothing -> do
      file <- Files.readFile path
      pure (case file of
        Just _ -> True
        Nothing -> False)

-- (the names among `ns` that are not of the project's root)
notInProject : {e : HFunctor}
             -> {{disk : filesystem <: e}}
             -> Path.Style
             -> Target
             -> List String
             -> Co e (List String)
notInProject st t [] = pure Nil
notInProject st t (n :: rest) = do
  ok <- isThere (inProject st t n)
  others <- notInProject st t rest
  pure (if ok then others else n :: others)

-- (the program X, read from its build.hf, unless what it ships is not
-- all in the project: `missing`)
appShips : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> Path.Style
         -> Target
         -> Apps
         -> String
         -> Project.Build
         -> List String
         -> Co e Apps
appShips st t acc x a [] =
  pure { apps = { name = x, build = a } :: acc.apps, bad = acc.bad }
appShips st t acc x a missing = do
  printErr
      (appFile st t x "build.hf"
       ^ ": it ships "
       ^ joinWith ", " (List.map (\n -> "`" ^ n ^ "`") missing)
       ^ ", which the project does not have")
  pure { apps = acc.apps, bad = acc.bad + 1 }

-- (the directory app/X, with its build.hf's text, if it has one: the
-- program X read, or what is wrong with its build.hf said)
appRead : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> Path.Style
        -> Target
        -> Apps
        -> String
        -> Maybe String
        -> Co e Apps
appRead st t acc x Nothing = pure acc
appRead st t acc x (Just text) = case Project.readBuild text of
  Left p -> do
    printErr (Load.problemMsg (appFile st t x "build.hf") text p)
    pure { apps = acc.apps, bad = acc.bad + 1 }
  Right a -> do
    missing <- notInProject st t a.ships
    appShips st t acc x a missing

-- | the project's programs, among the directories of its app/: each one's
-- | build.hf read, before any is built (each one more of the task `rd`'s)
appsIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Path.Style
       -> Target
       -> Progress.Task
       -> Apps
       -> List String
       -> Co e Apps
appsIn st t rd acc [] = pure { apps = List.reverse acc.apps, bad = acc.bad }
appsIn st t rd acc (x :: rest) = do
  m <- Files.readFile (appFile st t x "build.hf")
  next <- appRead st t acc x m
  Progress.complete rd
  appsIn st t rd next rest

-- (the task done with, then `next`)
ended : {e : HFunctor}
      -> {{prog : Progress.progress <: e}}
      -> Progress.Task
      -> Co e Unit
      -> Co e Unit
ended task next = do
  Progress.end task
  next

-- (said: `path` is made; then `next`)
wrote : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> Target
      -> String
      -> Co e Unit
      -> Co e Unit
wrote t path next = do
  print (t.said ^ " " ^ path)
  next

-- (the files of `dir` among `names` whose names end so, each its path)
endingIn : Path.Style -> String -> String -> List String -> List String
endingIn st dir ending names =
  List.map
    (\n -> HostPath.join st dir n)
    (List.keepIf (\n -> endsWith ending n) names)

-- (zig's mode for the runtime's Zig, at the level the C is built at:
-- `-O0` Debug and `-O1`, a build for the next change, ReleaseSafe, both
-- with zig's checks of what the runtime does; `-Os` ReleaseSmall; `-O2`
-- and `-O3` ReleaseFast)
zigMode : List String -> String
zigMode flags =
  if List.any (\f -> strEq f "-O0") flags then "Debug"
  else if List.any (\f -> strEq f "-O1") flags then "ReleaseSafe"
  else if List.any (\f -> strEq f "-Os") flags then "ReleaseSmall"
  else if List.any (\f -> strEq f "-O2" || strEq f "-O3") flags
  then "ReleaseFast"
  else "Debug"

-- (each of the runtime's Zig files built by zig, in `mode`, into an
-- object beside it, `F.o`, a task of `z`'s: the objects, or, where one
-- could not be built, how zig ran)
zigObjects : {e : HFunctor}
           -> {{prog : Progress.progress <: e}}
           -> Progress.Task
           -> String
           -> List String
           -> List String
           -> Co e (Either Ran (List String))
zigObjects z mode [] made = pure (Right (List.reverse made))
zigObjects z mode (f :: rest) made = do
  o <- pure (strSlice f 0 (strLength f - 4) ^ ".o")
  r <- Progress.runUnder z "zig" ["build-obj", f, "-O", mode, "-femit-bin=" ^ o]
  if succeeded r then zigObjects z mode rest (o :: made)
  else pure (Left r)

-- (the C files and the objects linked by `zig cc`, given these flags,
-- and after them what the modules' C needs, `links`, into `out`; or,
-- where an object was not built, how zig ran for it)
zigLinked : {e : HFunctor}
          -> {{prog : Progress.progress <: e}}
          -> Progress.Task
          -> List String
          -> List String
          -> List String
          -> String
          -> Either Ran (List String)
          -> Co e Ran
zigLinked z flags links files out (Left r) = pure r
zigLinked z flags links files out (Right os) =
  Progress.runUnder
    z
    "zig"
    ("cc"
     :: List.append
       flags
       ("-w"
        :: List.append
          files
          (List.append os (List.append links ["-o", out, "-lm"]))))

-- (the C files of `dir`, a file a module, by `zig cc` given these flags
-- (its level, and what else the program is built with) -- which builds
-- them at once, and again only those that changed -- the program `out`:
-- a task under `p` of as many items as files and the link, what zig
-- says of them under it; else said, by `who`, and the end)
zigBuildFlagsOr : {e : HFunctor}
                -> {{io : stdio <: e}}
                -> {{sys : process <: e}}
                -> {{disk : filesystem <: e}}
                -> {{prog : Progress.progress <: e}}
                -> (String -> Co e Unit)
                -> String
                -> Path.Style
                -> List String
                -> Progress.Task
                -> String
                -> String
                -> Co e Unit
                -> Co e Unit
zigBuildFlagsOr failed who st flags p dir out next = do
  names <- Files.readDirectory dir
  files <- pure (endingIn st dir ".c" (fromMaybe Nil names))
  zigs <- pure (endingIn st dir ".zig" (fromMaybe Nil names))
  z <- Progress.start p "zig cc" (List.length files + List.length zigs + 1)
  objects <- zigObjects z (zigMode flags) zigs Nil
  links <- Files.readFile (HostPath.join st dir "heff.link")
  r <-
    zigLinked
      z
      flags
      (List.keepIf (\l -> not (strEq l "")) (lines (fromMaybe "" links)))
      files
      out
      objects
  Progress.end z
  if succeeded r then next
  else do
    writeErr (ranErr r)
    printErr (who ^ ": `zig cc` could not build " ^ out)
    failed (who ^ ": `zig cc` could not build " ^ out)

-- (as `zigBuildFlagsOr`, at the level `opt`)
zigBuildOr : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{prog : Progress.progress <: e}}
           -> (String -> Co e Unit)
           -> String
           -> Path.Style
           -> String
           -> Progress.Task
           -> String
           -> String
           -> Co e Unit
           -> Co e Unit
zigBuildOr failed who st opt p dir out next =
  zigBuildFlagsOr failed who st [opt] p dir out next

-- (as `zigBuildOr`, the end where it cannot build)
zigBuild : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{prog : Progress.progress <: e}}
         -> String
         -> Path.Style
         -> String
         -> Progress.Task
         -> String
         -> String
         -> Co e Unit
         -> Co e Unit
zigBuild who st opt p dir out next =
  zigBuildOr (\why -> exit 1) who st opt p dir out next

-- (the flags of where the build.hf `a` says the C compiler also looks:
-- `-I` each of its include directories, `-L` each of its library
-- directories, from the project's root)
dirFlags : Path.Style -> Target -> Project.Build -> List String
dirFlags st t a =
  List.append
    (List.map (\d -> "-I" ^ inProject st t d) a.includeDirs)
    (List.map (\d -> "-L" ^ inProject st t d) a.libDirs)

-- (`.heff/build/X/` by `zig cc` at the target's level, and where the
-- build.hf `a` says to look, the program X, `.heff/build/X/X`: a task
-- under the program's, `p`)
zigCc : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{prog : Progress.progress <: e}}
      -> Path.Style
      -> Target
      -> Progress.Task
      -> String
      -> Project.Build
      -> Co e Unit
      -> Co e Unit
zigCc st t p x a next =
  zigBuildFlagsOr
    (\why -> exit 1)
    "heff build"
    st
    (t.opt :: dirFlags st t a)
    p
    (partsDir st t x)
    (builtAt st t x x)
    next

-- (where `heff run` builds FILE: `.heff/run/F/`, F its path, its
-- separators underscores)
runDir : Load.Paths -> String -> String
runDir paths file =
  Load.under
    paths
    (Load.under paths paths.root ".heff/run")
    (joinWith "_" (HostPath.components paths.style file))

-- (a program's file, named `n`, as the system names one: `n.exe` on
-- Windows)
programFile : Path.Style -> String -> String
programFile Windows n = n ^ ".exe"
programFile Posix n = n

-- (the program `heff run` builds of FILE, `.heff/run/F/main`)
runProgram : Load.Paths -> String -> String
runProgram paths file =
  Load.under paths (runDir paths file) (programFile paths.style "main")

-- | run FILE's `main` with ARGS: compiled to C in `.heff/run/F/` (a file
-- | a module, through the backend's cache), built there by `zig cc` at
-- | -O1 as `heff build` builds, and run in heff's place
runCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{rep : Report.report <: e}}
       -> {{prog : Progress.progress <: e}}
       -> String
       -> Bool
       -> List String
       -> Co e Unit
runCmd file fuel progArgs = do
  l <- load file
  p <- Progress.start Progress.root file 2
  c <- Progress.start p "compiling to C" 0
  cLoaded
      fuel
      l
      (Just "main")
      (runDir l.paths file ^ "/")
      file
      (ended
         c
         (zigBuild
            "heff run"
            l.paths.style
            "-O1"
            p
            (runDir l.paths file)
            (runProgram l.paths file)
            (ended p (exec (runProgram l.paths file) progArgs))))

-- (the program X, compiled as its build.hf says, in `.heff/build/X/`,
-- then `next`: a task under `bp`, the programs', of its steps -- through
-- C, compiled, then built by zig; else compiled -- each a task under it
-- as it is done)
buildApp : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Path.Style
         -> Target
         -> Progress.Task
         -> String
         -> Project.Build
         -> Co e Unit
         -> Co e Unit
buildApp st t bp x a next =
  if strEq a.backend "c"
  then do
    p <- Progress.start bp x 2
    c <- Progress.start p "compiling to C" 0
    cThen
        a.fuel
        (Just a.run)
        (partsDir st t x ^ "/")
        (appFile st t x "main.hf")
        (ended c (zigCc st t p x a (ended p next)))
  else if t.pages
  then do
    p <- Progress.start bp x 1
    c <- Progress.start p "compiling for a page" 0
    made <- Files.makeDirectory (partsDir st t x)
    compileThen
        a.fuel
        (Just a.run)
        (builtAt st t x (x ^ ".js"))
        (appFile st t x "main.hf")
        (ended c (ended p next))
  else do
    print ("passed over " ^ x ^ ": a page's script, not a program")
    Progress.complete bp
    next

-- (each program, by its build.hf, then `done`)
buildEach : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> {{prog : Progress.progress <: e}}
          -> Path.Style
          -> Target
          -> Progress.Task
          -> Co e Unit
          -> List App
          -> Co e Unit
buildEach st t bp done [] = done
buildEach st t bp done (a :: rest) =
  buildApp st t bp a.name a.build (buildEach st t bp done rest)

-- (what cannot be put in `home` said: nothing more is done)
shipFails : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> String
          -> Co e Unit
shipFails why = do
  printErr ("heff: " ^ why)
  exit 1

-- (`fresh` moved to `to`, what was there moved aside to `old` first:
-- `old` then removed; or, `fresh` not moved, what was there put back)
shipMoved : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> Target
          -> String
          -> String
          -> String
          -> Co e Unit
          -> Bool
          -> Co e Unit
shipMoved t fresh old to next True = do
  _ <- Files.remove old
  wrote t to next
shipMoved t fresh old to next False = do
  _ <- Files.move old to
  _ <- Files.remove fresh
  shipFails ("cannot put " ^ fresh ^ " in place of " ^ to)

-- (the file or directory `n` of the project put in `home`, in place of
-- what was there: copied into `home` first, as `.n.new`, then moved to
-- `n`, so that a failure leaves the whole of what was there, not a part
-- of either; then `next` (a task under `sh`, the shipping's, meanwhile)
shipOne : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> String
        -> Progress.Task
        -> Co e Unit
        -> String
        -> Co e Unit
shipOne st t home sh next n = do
  it <- Progress.start sh n 0
  fresh <- pure (HostPath.join st home ("." ^ n ^ ".new"))
  old <- pure (HostPath.join st home ("." ^ n ^ ".old"))
  _ <- Files.remove fresh
  _ <- Files.remove old
  copied <- Files.copy (inProject st t n) fresh
  if copied
  then do
    -- (nothing there, nothing moved aside)
    _ <- Files.move (HostPath.join st home n) old
    moved <- Files.move fresh (HostPath.join st home n)
    shipMoved t fresh old (HostPath.join st home n) (ended it next) moved
  else do
    _ <- Files.remove fresh
    shipFails ("cannot copy " ^ inProject st t n ^ " to " ^ fresh)

shipAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> String
        -> Progress.Task
        -> Co e Unit
        -> List String
        -> Co e Unit
shipAll st t home sh next [] = next
shipAll st t home sh next (n :: rest) =
  shipOne st t home sh (shipAll st t home sh next rest) n

-- | what the programs ship, each named once
shippedBy : List App -> List String
shippedBy progs = nubStrM (List.concatMap (\(a : App) -> a.build.ships) progs)

-- (what the programs ship, put in `t.shipTo` if it is given, a task
-- meanwhile; then `done`)
shipIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> Path.Style
       -> Target
       -> Co e Unit
       -> List App
       -> Maybe String
       -> Co e Unit
shipIn st t done progs Nothing = done
shipIn st t done progs (Just home) = do
  sh <-
    Progress.start
      Progress.root
      ("installing in " ^ home)
      (List.length (shippedBy progs))
  shipAll st t home sh (ended sh done) (shippedBy progs)

-- (what the program puts in `t.bin`, by its build.hf: itself, or, if
-- `t.pages`, a page's script)
madeAs : Target -> App -> Maybe String
madeAs t a =
  if strEq a.build.backend "c" then Just a.name
  else if t.pages then Just (a.name ^ ".js")
  else Nothing

-- (`n`, made of the program X, put in `t.bin` in place of what was
-- there: copied beside it first, as `.n.new`, then renamed to `n`, which
-- is done at once, so that what runs it meanwhile runs the one or the
-- other, never a part of either; or, the copy gone and what was there
-- kept, nothing more done (as on Windows, where nothing is put in place
-- of a program running); then `next` (a task under `pl`, the programs',
-- meanwhile)
placeMade : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{prog : Progress.progress <: e}}
          -> Path.Style
          -> Target
          -> Progress.Task
          -> Co e Unit
          -> String
          -> Maybe String
          -> Co e Unit
placeMade st t pl next x Nothing = do
  Progress.complete pl
  next
placeMade st t pl next x (Just n) = do
  it <- Progress.start pl n 0
  fresh <- pure (HostPath.join st t.bin ("." ^ n ^ ".new"))
  _ <- Files.remove fresh
  copied <- Files.copy (builtAt st t x n) fresh
  placed <-
    if copied then Files.replace fresh (HostPath.join st t.bin n)
    else pure False
  if placed then wrote t (HostPath.join st t.bin n) (ended it next)
  else do
    _ <- Files.remove fresh
    shipFails
        ("cannot put "
         ^ builtAt st t x n
         ^ " in place of "
         ^ HostPath.join st t.bin n)

placeAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Path.Style
         -> Target
         -> Progress.Task
         -> Co e Unit
         -> List App
         -> Co e Unit
placeAll st t pl next [] = next
placeAll st t pl next (a :: rest) =
  placeMade st t pl (placeAll st t pl next rest) a.name (madeAs t a)

-- (the programs, built, put in `t.bin`, a task meanwhile; then `next`)
placeIn : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Target
        -> Co e Unit
        -> List App
        -> Co e Unit
placeIn st t next progs = do
  ok <- Files.makeDirectory t.bin
  pl <-
    Progress.start
      Progress.root
      ("putting the programs in " ^ t.bin)
      (List.length progs)
  placeAll st t pl (ended pl next) progs

-- (the programs, built in the project, then put in `t.bin`, and what
-- they ship put where `t` says: none put anywhere unless all are built;
-- then `done`)
buildPrograms : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> {{rep : Report.report <: e}}
              -> {{prog : Progress.progress <: e}}
              -> Path.Style
              -> Target
              -> Co e Unit
              -> List App
              -> Co e Unit
buildPrograms st t done progs = do
  okC <- Files.makeDirectory (inProject st t (HostPath.join st ".heff" "build"))
  bp <- Progress.start Progress.root "building programs" (List.length progs)
  buildEach
      st
      t
      bp
      (ended bp (placeIn st t (shipIn st t done progs t.shipTo) progs))
      progs

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.` passed over)
hfFilesGo : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> List String
          -> Co e (List String)
hfFilesGo [] acc = pure (List.reverse acc)
hfFilesGo (p :: rest) acc = do
  names <- Files.readDirectory p
  case names of
    Just ns -> do
      st <- styleNow
      hfFilesGo
          (List.append
             (List.map
                (\n -> HostPath.join st p n)
                (List.keepIf (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then hfFilesGo rest (p :: acc)
      else hfFilesGo rest acc

-- | the modules of the project checked so far, and the errors found
type Checks = { seen : List String, errors : Int }

errorCount : List Driver.Checked -> Int
errorCount cs =
  List.foldl
    (\n (c : Driver.Checked) -> n + List.length (Driver.errorsIn c))
    0
    cs

-- | FILE, a module of the project, checked with what it imports, unless
-- | it was among what a module checked before imports; the diagnostics
-- | of each module of the project's src/ said once (one more of the
-- | task `chk`'s: checked, a task under it meanwhile)
checkModule : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> {{prog : Progress.progress <: e}}
            -> Progress.Task
            -> Checks
            -> String
            -> Co e Checks
checkModule chk acc f = do
  h <- hostNow
  ps <- Load.pathsFor h f
  if elemStrM (Load.moduleOf ps f) acc.seen
  then do
    Progress.complete chk
    pure acc
  else do
    m <- Progress.start chk (Load.moduleOf ps f) 0
    l <- load f
    badL <- printErrs "heff" l.errors 0
    cs <- Session.cachedProgram l
    own <-
      pure
        (List.keepIf
           (\(c : Driver.Checked) ->
              (Load.inside l.paths l.paths.src c.path
               || strEq c.module (Load.moduleOf ps f))
              && not (elemStrM c.module acc.seen))
           cs)
    putFileDiags own
    Progress.end m
    pure
        { seen =
            List.append
              (List.map (\(c : Driver.Checked) -> c.module) own)
              acc.seen
        , errors = acc.errors + badL + errorCount own
        }

checkModules : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> {{prog : Progress.progress <: e}}
             -> Progress.Task
             -> Checks
             -> List String
             -> Co e Checks
checkModules chk acc [] = pure acc
checkModules chk acc (f :: rest) = do
  next <- checkModule chk acc f
  checkModules chk next rest

-- (`n` modules)
modulesSaid : Int -> String
modulesSaid 1 = "1 module"
modulesSaid n = debug n ^ " modules"

-- (`n` errors)
errorsSaid : Int -> String
errorsSaid 1 = "1 error"
errorsSaid n = debug n ^ " errors"

-- (what is wrong with the project, said: nothing built)
nothingBuilt : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> String
             -> String
             -> Co e Unit
nothingBuilt cmd what = do
  printErr ("heff " ^ cmd ^ ": " ^ what ^ ": nothing built")
  exit 1

-- | the whole project at `t.root` built: every module of its src/
-- | checked, and every program's build.hf read, then, if none has an
-- | error, every program of its app/ built (with none, `none`), then
-- | `done`; each a task as it is done
buildProject : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> {{prog : Progress.progress <: e}}
             -> Path.Style
             -> String
             -> Target
             -> Co e Unit
             -> Co e Unit
             -> Co e Unit
buildProject st cmd t none done = do
  files <- hfFilesGo [inProject st t "src"] Nil
  chk <- Progress.start Progress.root "checking modules" (List.length files)
  checked <- checkModules chk { seen = Nil, errors = 0 } files
  Progress.end chk
  if checked.errors > 0
  then nothingBuilt
      cmd
      (errorsSaid checked.errors ^ " in the project's modules")
  else do
    print
        ("heff "
         ^ cmd
         ^ ": "
         ^ modulesSaid (List.length checked.seen)
         ^ " checked")
    found <- Files.readDirectory (inProject st t "app")
    rd <-
      Progress.start
        Progress.root
        "reading the programs' build.hf"
        (List.length (fromMaybe Nil found))
    progs <- appsIn st t rd { apps = Nil, bad = 0 } (fromMaybe Nil found)
    Progress.end rd
    if progs.bad > 0
    then nothingBuilt
        cmd
        (errorsSaid progs.bad ^ " in the programs' build.hf")
    else case progs.apps of
      [] -> none
      _ -> buildPrograms st t done progs.apps

-- | build the project here, the whole of it: every module of its src/
-- | checked, then every program of it built: `app/X/` with a build.hf is
-- | the program X, app/X/main.hf compiled as its build.hf says, to
-- | `.heff/bin/`
buildCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> Co e Unit
buildCmd = do
  text <- Files.readFile "package.hf"
  st <- styleNow
  case text of
    Nothing -> do
      printErr "heff build: no package.hf here: build at the project's root"
      exit 1
    Just _ ->
      buildProject st "build" (buildTarget st ".") (pure MkUnit) (pure MkUnit)

-- (the directories of a PATH, on the platform `p`)
pathDirs : String -> String -> List String
pathDirs p path = split (if strEq p "win32" then ";" else ":") path

-- (a hint, if `bin` is not on the PATH)
onPathHint : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> Path.Style
           -> String
           -> Co e Unit
onPathHint st bin = do
  p <- platform
  path <- getEnv "PATH"
  if List.any
       (\d -> strEq (HostPath.join st d ".") (HostPath.join st bin "."))
       (pathDirs p (fromMaybe "" path))
  then pure MkUnit
  else print
      ("heff install: "
       ^ bin
       ^ " is not on the PATH: add it there to run them by their names")

-- (the package.hf's text, read, names heff's own package)
heffRead : Either Project.Problem Project.Package -> Bool
heffRead (Right pk) = strEq pk.module Project.heffModule
heffRead (Left _) = False

isHeffPackage : Maybe String -> Bool
isHeffPackage (Just text) = heffRead (Project.readPackage text)
isHeffPackage Nothing = False

-- (heff's own package installed from `dir` -- where heff is from, or it
-- would not have been built: the heff home says it was the checkout,
-- for any heff to take that checkout as heff's own; then `next`)
sourceSaved : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> Path.Style
            -> Target
            -> String
            -> String
            -> Co e Unit
            -> Co e Unit
sourceSaved st t home dir next = do
  cwd <- cwdNow
  ok <-
    Files.writeFile
      (sourceFile st home)
      (HostPath.normalize st (HostPath.join st cwd dir) ^ "\n")
  if ok then wrote t (sourceFile st home) next
  else shipFails ("cannot write " ^ sourceFile st home)

-- | install the project at DIR: built as `heff build` builds it, but to
-- | run its fastest (zig's `-O2`), its programs into the heff home's
-- | `bin/` (`HEFF_HOME/bin`, `~/.heff/bin`), and what they ship (their
-- | build.hf's `ships`) into the heff home, beside `bin/`; heff's own
-- | package installed, the heff home's `source` says the checkout DIR is
installCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> {{prog : Progress.progress <: e}}
           -> String
           -> Co e Unit
installCmd dir = do
  st <- styleNow
  home <- heffHome
  text <- Files.readFile (HostPath.join st dir "package.hf")
  t <-
    pure
      { root = dir
      , bin = HostPath.join st home "bin"
      , said = "installed"
      , pages = False
      , shipTo = Just home
      , opt = "-O2"
      }
  case text of
    Nothing -> do
      printErr ("heff install: no package.hf in " ^ dir)
      exit 1
    Just _ ->
      buildProject
        st
        "install"
        t
        (do
         printErr
             ("heff install: no programs in "
              ^ dir
              ^ ": app/X/ with a build.hf is the program X")
         exit 1)
        (if isHeffPackage text
         then sourceSaved st t home dir (onPathHint st t.bin)
         else onPathHint st t.bin)

-- | how `heff compile` was called: FILE, OUT, `--name`, `--backend`
-- | `heff compile`'s: what is compiled, to where, the computation run, by
-- | what, and whether with fuel (`--fuel`: each loop ticked, as a
-- | build.hf's `fuel = True`)
type CompileOpts =
  { file : String
  , outPath : String
  , name : Maybe String
  , backend : String
  , fuel : Bool
  }

-- (the directory OUT is to be written in, if it is not there; a C
-- program's `DIR/`, its parts, is made, the directories above it too)
missingOutDir : {e : HFunctor}
              -> {{sys : process <: e}}
              -> {{disk : filesystem <: e}}
              -> CompileOpts
              -> Co e (Maybe String)
missingOutDir o =
  if strEq o.backend "c" && endsWith "/" o.outPath then pure Nothing
  else do
    st <- styleNow
    dir <- pure (HostPath.dirname st o.outPath)
    there <- Files.readDirectory (if strEq dir "" then "." else dir)
    pure (case there of
      Just _ -> Nothing
      Nothing -> Just dir)

-- (`heff compile` of a program, its OUT's directory there: the
-- computation run is NAME, else `main`)
compileThere : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> CompileOpts
             -> Co e Unit
compileThere o = do
  missing <- missingOutDir o
  case missing of
    Just dir -> do
      printErr ("heff compile: " ^ dir ^ ": no such directory")
      exit 1
    Nothing ->
      if strEq o.backend "page"
      then appCmd o.fuel (Just (fromMaybe "main" o.name)) o.outPath o.file
      else if strEq o.backend "esm" then compileJsCmd o.file o.outPath
      else cCmd o.fuel (Just (fromMaybe "main" o.name)) o.outPath o.file

-- | `heff compile`, by its backend: a page's script or a C program runs
-- | NAME, `main` without `--name`; an ES module runs nothing, each
-- | definition exported
compileTo : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> CompileOpts
          -> Co e Unit
compileTo o =
  if strEq o.backend "esm"
  then case o.name of
    Nothing -> compileThere o
    Just n -> do
      printErr
          "heff compile: an ES module runs nothing: no --name with --backend=esm"
      exit 1
  else if strEq o.backend "page" || strEq o.backend "c" then compileThere o
  else do
    printErr ("heff compile: no backend " ^ o.backend ^ ": esm, page or c")
    exit 1

-- (each value printed; whether the evaluation of one met a bug of the
-- compiler, which fails)
printEvals : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> List Driver.Evaluated
           -> Co e Bool
printEvals [] = pure False
printEvals (d :: rest) = do
  print (d.name ^ " = " ^ d.value)
  bug <- printEvals rest
  pure (d.bug || bug)

evalDiags : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Report.report <: e}}
          -> Bool
          -> List Driver.Checked
          -> Co e Unit
evalDiags badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      bug <- printEvals (Driver.evaluate c)
      if badL || anyErrors cs || bug then exit 1 else pure MkUnit

-- | print what each definition of FILE evaluates to
evalCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> String
        -> Co e Unit
evalCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  evalDiags (badL > 0) cs

promoteDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> String
             -> Bool
             -> List Driver.Checked
             -> Co e Unit
promoteDiags file badL cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      if badL || anyErrors cs then exit 1
      else do
        ok <- Files.writeFile file (Driver.promote c)
        if ok then pure MkUnit
        else do
          printErr ("heff promote: cannot write " ^ file)
          exit 1

-- | write each watch's and doc test's value under it as its expectation
promoteCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Co e Unit
promoteCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  promoteDiags file (badL > 0) cs

checkLast : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Report.report <: e}}
          -> Bool
          -> List Driver.Checked
          -> Co e Unit
checkLast badLoad cs = do
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      write (Driver.interface c)
      if badLoad || anyErrors cs then exit 1 else pure MkUnit

-- | elaborate FILE and what it imports; print its interface
checkCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> String
         -> Co e Unit
checkCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  checkLast (badL > 0) cs

-- | what the name at each OFFSET of FILE resolved to, and its type: a
-- | line each, FILE checked once
typeAtCmd : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> {{rep : Report.report <: e}}
          -> String
          -> List String
          -> Co e Unit
typeAtCmd file offs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      printLines
        (List.map
           (\off ->
              fromMaybe "nothing there" (case parseInt off of
                Just o -> Query.typeAt c o
                Nothing -> Nothing))
           offs)

-- | the elaboration trace of FILE, one line per event
explainCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> Co e Unit
explainCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  putFileDiags cs
  case Driver.lastChecked cs of
    Nothing -> exit 1
    Just c -> printLines (Query.explain c)

fmtSrc : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> String
       -> String
       -> Fixity.Fixities
       -> Co e Int
fmtSrc checkOnly f src fix = case Format.formatIn fix src of
  Left why -> do
    printErr ("heff: " ^ f ^ " not formatted: " ^ why)
    pure 1
  Right out ->
    if strEq out src then pure 0
    else if checkOnly
    then do
      print f
      pure 1
    else do
      ok <- Files.writeFile f out
      if ok then pure 0
      else do
        printErr ("heff fmt: cannot write " ^ f)
        pure 1

-- | 1 if the file is not formatted (with `--check`) or cannot be; its
-- | operators cut as the fixities of what it imports say
fmtOne : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> String
       -> Co e Int
fmtOne checkOnly f = do
  mSrc <- Files.readFile f
  case mSrc of
    Nothing -> do
      printErr ("heff: cannot read " ^ f)
      pure 1
    Just src -> do
      l <- load f
      fmtSrc checkOnly f src (Driver.fixitiesIn l.sources)

fmtAll : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> List String
       -> Int
       -> Co e Int
fmtAll checkOnly [] bad = pure bad
fmtAll checkOnly (f :: rest) bad = do
  n <- fmtOne checkOnly f
  fmtAll checkOnly rest (bad + n)

-- | format FILEs in place; `--check`: only say which are not formatted
fmtCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> Bool
       -> List String
       -> Co e Unit
fmtCmd check files = do
  bad <- fmtAll check files 0
  if bad > 0 then exit 1 else pure MkUnit

-- (a `.hf` file as the formatter lays it out)
laidOut : String -> String -> String
laidOut f text =
  if endsWith ".hf" f
  then (case Format.format text of
        Right out -> out
        Left _ -> text)
  else text
