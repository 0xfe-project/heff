-- `heff test`: files checked as they expect, their doc tests and
-- properties run, their golden texts held or written, their integration
-- tests built into programs and run, a job each, and `heff test
-- --watch`, which tests again whenever a file changes.

module heff.build.testing

import co
import exception
import heff.build.commands
import heff.build.driver as Driver
import heff.build.load as Load
import heff.build.session as Session
import heff.build.watch as Watch
import heff.lsp.report as Report
import heff.syntax.import as Import
import heff.util.files as Files
import heff.util.hostpath as HostPath
import json as JSON
import regex as Regex
import std.filesystem
import std.io
import std.path as Path
import std.process
import std.progress as Progress
import std.reactor as Reactor
import std.time as Time

-- Testing files
--------------------------------------------------------------------------------

-- | what testing files came to: how many files, of them how many
-- | expect errors (and have them), the expectations and how many do
-- | not hold, a line each for the files that do not check as they should
-- | (where they first went wrong), the tests and how many fail
type TestRes =
  { files : Int
  , expectErrors : Int
  , total : Int
  , failed : Int
  , unchecked : List String
  , tests : Int
  , testsFailed : Int
  , testsSkipped : Int
  }

-- | nothing tested yet
noRes : TestRes
noRes =
  { files = 0
  , expectErrors = 0
  , total = 0
  , failed = 0
  , unchecked = Nil
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- | what two runs came to, together
addRes : TestRes -> TestRes -> TestRes
addRes a b =
  { files = a.files + b.files
  , expectErrors = a.expectErrors + b.expectErrors
  , total = a.total + b.total
  , failed = a.failed + b.failed
  , unchecked = List.append a.unchecked b.unchecked
  , tests = a.tests + b.tests
  , testsFailed = a.testsFailed + b.testsFailed
  , testsSkipped = a.testsSkipped + b.testsSkipped
  }

-- (a file that does not check as it should, `why`)
uncheckedRes : String -> TestRes
uncheckedRes why =
  { files = 1
  , expectErrors = 0
  , total = 0
  , failed = 0
  , unchecked = [why]
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- (a file that expects errors, and has them)
expectedRes : TestRes
expectedRes =
  { files = 1
  , expectErrors = 1
  , total = 0
  , failed = 0
  , unchecked = Nil
  , tests = 0
  , testsFailed = 0
  , testsSkipped = 0
  }

-- | how `heff test` runs the tests: the seed of the properties, the
-- | pattern of the tests run (`--run`; `""`: all), how many integration
-- | tests at once, and whether golden texts are written, not held to
type TestOpts = { seed : Int, pattern : String, jobs : Int, update : Bool }

-- | a file checked, its expectations held and its unit tests and
-- | properties run, its integration tests not yet: its name, where it
-- | went wrong, its expectations, what came of its tests, the
-- | integration tests (each name and time limit), and the file loaded
-- | and checked, to build them of
type Pending =
  { file : String
  , wrong : List String
  , reports : List Driver.TestReport
  , outcomes : List Driver.TestOutcome
  , integrations : List (Pair String Int)
  , loaded : Load.Loaded
  , checked : Driver.Checked
  }

-- | a file tested: done with, or its integration tests to run yet
data Tested = Settled TestRes | Pend Pending

failLine : String -> Driver.TestReport -> Report.Mismatch -> String
failLine f r m =
  "FAIL "
  ^ f
  ^ ":"
  ^ show r.line
  ^ (case r.owner of
     Just n -> " (" ^ n ^ ")"
     Nothing -> "")
  ^ ": "
  ^ r.watch.expr
  ^ "\n  expected "
  ^ m.expected
  ^ "\n  but got  "
  ^ m.got
  ^ "\n  diff     "
  ^ m.diff

-- (each expectation that does not hold, and what differs, in colour on
-- a terminal)
printFails : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> String
           -> Bool
           -> List Driver.TestReport
           -> Co e Unit
printFails f color Nil = pure MkUnit
printFails f color (Cons r rest) = do
  print
      (failLine
         f
         r
         (Report.mismatch color (fromMaybe "" r.watch.expected) r.watch.value))
  printFails f color rest

badReports : List Driver.TestReport -> List Driver.TestReport
badReports rs = List.keepIf (\(r : Driver.TestReport) -> not r.watch.holds) rs

-- (`n` of `total`, as a part of a hundred)
percent : Int -> Int -> String
percent n total = show (if total == 0 then 0 else n * 100 / total) ^ "%"

-- | a property's statistic: how many runs held, how many were given up
-- | on, and how many had each label -- so that a property that holds
-- | only of what is trivial shows
statistic : Driver.TestOutcome -> String
statistic o =
  show o.runs
  ^ " runs"
  ^ (if o.discarded > 0 then ", " ^ show o.discarded ^ " given up on"
     else "")
  ^ joinWith
    ""
    (List.map
       (\(p : Pair String Int) -> ", " ^ percent (snd p) o.runs ^ " " ^ fst p)
       o.labels)

-- (how many shrinks made the counterexample)
shrunk : Int -> String
shrunk 0 = "not shrunk"
shrunk 1 = "shrunk once"
shrunk n = "shrunk " ^ show n ^ " times"

-- (a test's line, of one that ran)
ranLine : Driver.TestOutcome -> String
ranLine o =
  (if o.ok then "  ok    " else "  FAIL  ")
  ^ o.name
  ^ (if not o.property then ""
     else if o.ok then "  (" ^ statistic o ^ ")"
     else "  (failed after "
       ^ show o.runs
       ^ " runs held"
       ^ (if o.discarded > 0 then ", " ^ show o.discarded ^ " given up on"
          else "")
       ^ "; "
       ^ shrunk o.shrinks
       ^ "; again: --seed "
       ^ show o.seed
       ^ ")")

-- | a test's line: whether it held, its name, and for a property its
-- | statistic -- and if it failed, how far its counterexample was
-- | shrunk and the seed that runs it again; a test skipped, why
outcomeLine : Driver.TestOutcome -> String
outcomeLine o = case o.skipped of
  Just why -> "  skip  " ^ o.name ^ "  (" ^ why ^ ")"
  Nothing -> ranLine o

mismatchLines : Report.Mismatch -> List String
mismatchLines m =
  [ "        expected " ^ m.expected
  , "        but got  " ^ m.got
  , "        diff     " ^ m.diff
  ]

failLines : Bool -> Driver.TestFailure -> List String
failLines color (FailBecause why) = ["        " ^ why]
failLines color (FailDiffer expected got) =
  mismatchLines (Report.mismatch color expected got)

failureLines : Bool -> Maybe Driver.TestFailure -> List String
failureLines color Nothing = Nil
failureLines color (Just f) = failLines color f

-- | what came of each test: a line each, and under one that failed its
-- | counterexample (what it drew and noted) and what was wrong
printOutcomes : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> Bool
              -> List Driver.TestOutcome
              -> Co e Unit
printOutcomes color Nil = pure MkUnit
printOutcomes color (Cons o rest) = do
  print (outcomeLine o)
  if o.ok then pure MkUnit
  else print
      (joinWith
         "\n"
         (List.append
            (List.map (\n -> "        " ^ n) o.notes)
            (failureLines color o.failure)))
  printOutcomes color rest

badOutcomes : List Driver.TestOutcome -> List Driver.TestOutcome
badOutcomes os = List.keepIf (\(o : Driver.TestOutcome) -> not o.ok) os

skippedOutcomes : List Driver.TestOutcome -> List Driver.TestOutcome
skippedOutcomes os =
  List.keepIf
    (\(o : Driver.TestOutcome) -> maybe False (\why -> True) o.skipped)
    os

-- (how many were skipped: said only if some were)
skippedSaid : Int -> String
skippedSaid 0 = ""
skippedSaid n = ", " ^ show n ^ " skipped"

-- (how many tests held, of how many, and how many were skipped: said
-- only of a file that has some)
testsSaid : List Driver.TestOutcome -> String
testsSaid Nil = ""
testsSaid os =
  ", tests "
  ^ show
    (List.length os
     - List.length (badOutcomes os)
     - List.length (skippedOutcomes os))
  ^ "/"
  ^ show (List.length os)
  ^ skippedSaid (List.length (skippedOutcomes os))

testReport : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{rep : Report.report <: e}}
           -> String
           -> List String
           -> List Driver.TestReport
           -> List Driver.TestOutcome
           -> Co e TestRes
testReport f wrong ts os = do
  color <- Report.useColor
  printFails f color (badReports ts)
  printOutcomes color os
  print
      ((if List.null (badReports ts)
           && List.null (badOutcomes os)
           && List.null wrong
        then "ok    "
        else "FAIL  ")
       ^ f
       ^ "  "
       ^ show (List.length ts - List.length (badReports ts))
       ^ "/"
       ^ show (List.length ts)
       ^ testsSaid os)
  pure
      { files = 1
      , expectErrors = 0
      , total = List.length ts
      , failed = List.length (badReports ts)
      , unchecked = wrong
      , tests = List.length os
      , testsFailed = List.length (badOutcomes os)
      , testsSkipped = List.length (skippedOutcomes os)
      }

-- | the first thing wrong with a file, its line in `heff test`'s list of
-- | the files that do not check: a module not loaded, else the first
-- | error, `path:line:col: error[E…]: what`
firstWrong : String -> List String -> List Driver.Checked -> String
firstWrong f (Cons why _) cs = why
firstWrong f Nil cs = fromMaybe (f ^ ": not checked") (firstErrorOf cs)

-- (a file checked: its expectations, and what came of its tests run
-- here, those selected; its integration tests to run yet)
pendingOf : TestOpts
          -> String
          -> List String
          -> Load.Loaded
          -> Driver.Checked
          -> Driver.TestsRun
          -> Pending
pendingOf opts f wrong l c run =
  { file = f
  , wrong = wrong
  , reports = Driver.testFile c
  , outcomes = run.outcomes
  , integrations = run.integrations
  , loaded = l
  , checked = c
  }

-- | a file checked, its tests run: passed over, nothing said of it, where
-- | `--run` gives a pattern that selects none of its tests
selectedOf : TestOpts -> Pending -> Tested
selectedOf opts p =
  if not (strEq opts.pattern "")
     && List.null p.outcomes
     && List.null p.integrations
  then Settled noRes
  else Pend p

testOneC : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> String
         -> Load.Loaded
         -> List Driver.Checked
         -> Co e Tested
testOneC opts f l cs = do
  bad <- diagCount cs
  case Driver.lastChecked cs of
    Nothing -> do
      print ("FAIL  " ^ f ^ "  0/0")
      pure (Settled (uncheckedRes (firstWrong f l.errors cs)))
    Just c ->
      pure
        (if List.null l.errors && bad == 0
         then selectedOf
             opts
             (pendingOf
                opts
                f
                Nil
                l
                c
                (Driver.runTests opts.pattern opts.seed c))
         else Pend
             (pendingOf
                opts
                f
                [firstWrong f l.errors cs]
                l
                c
                { outcomes = Nil, integrations = Nil }))

-- | the line that, the first of a file, says that the file is to report
-- | errors (a test of them): `heff test` passes it if it does, fails it
-- | if it checks, and says nothing of its errors
expectErrorsLine : String
expectErrorsLine = "-- test: expect errors"

-- | does the file's first line say it expects errors
-- | >>> List.map expectsErrors ["-- test: expect errors\nx = y\n", "-- test: expect errors", "x : Int\n-- test: expect errors\n", ""]
-- | [True, True, False, False]
expectsErrors : String -> Bool
expectsErrors src =
  strEq
    (strSlice src 0 (fromMaybe (strLength src) (indexOf "\n" src 0)))
    expectErrorsLine

-- (a file that expects errors: whether it has some)
testExpecting : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> String
              -> Bool
              -> Co e TestRes
testExpecting f True = do
  print ("ok    " ^ f ^ "  errors, as expected")
  pure expectedRes
testExpecting f False = do
  print ("FAIL  " ^ f ^ "  checks, but expects errors")
  pure (uncheckedRes (f ^ ": checks, but its first line expects errors"))

-- (a file loaded, tested: one that expects errors held to having some,
-- or passed over where `--run` selects tests, as it has none)
testLoaded : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> TestOpts
           -> String
           -> Bool
           -> Load.Loaded
           -> Co e Tested
testLoaded opts f True l =
  if not (strEq opts.pattern "") then pure (Settled noRes)
  else do
    cs <- Session.cachedProgram l
    r <- testExpecting f (not (List.null l.errors) || anyErrors cs)
    pure (Settled r)
testLoaded opts f False l = do
  badL <- printErrs "heff" l.errors 0
  cs <- Session.cachedProgram l
  testOneC opts f l cs

testOneF : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> String
         -> Co e Tested
testOneF opts f = do
  src <- Files.readFile f
  l <- load f
  testLoaded opts f (expectsErrors (fromMaybe "" src)) l

-- Golden texts
--------------------------------------------------------------------------------

-- (a byte a golden text's name may have)
goldenByte : Int -> Bool
goldenByte c =
  (c >= 48 && c <= 57)
  || (c >= 65 && c <= 90)
  || (c >= 97 && c <= 122)
  || c == 45
  || c == 95
  || c == 46

-- (a part of a golden text's name, between its `/`s: letters, digits,
-- `-`, `_` and `.`, not first)
goldenPart : String -> Bool
goldenPart n =
  strLength n > 0
  && byteAt n 0 /= 46
  && List.all (\i -> goldenByte (byteAt n i)) (List.range 0 (strLength n - 1))

-- | is it a golden text's name: parts of letters, digits, `-`, `_` and
-- | `.`, not first, between `/`s, so that it names a file under the
-- | directory and nothing else
-- | >>> List.map goldenName ["parse-error.txt", "eval/lib/list.hf.txt", "", ".hidden", "a/../b", "/a", "a/", "a b"]
-- | [True, True, False, False, False, False, False, False]
goldenName : String -> Bool
goldenName n = List.all goldenPart (split "/" n)

-- | where the golden text `name` of the test file `f` is kept: in the
-- | directory beside it named as it, without its `.hf`, with `.golden`
-- | >>> goldenPath Posix "test/check/golden.hf" "hello"
-- | "test/check/golden.golden/hello"
goldenPath : Path.Style -> String -> String -> String
goldenPath st f name =
  HostPath.join
    st
    ((if endsWith ".hf" f then strSlice f 0 (strLength f - 3) else f)
     ^ ".golden")
    name

-- | what came of holding a golden text to the one kept: it holds, it was
-- | written there (`--update`), or it does not hold (what is noted of
-- | it, and why)
data GoldenSaid = Holds | Wrote String | Wrong String Driver.TestFailure

-- (a line of a text, or none past its end)
lineOr : List String -> String
lineOr Nil = ""
lineOr (Cons l _) = l

-- | where two texts, cut into lines, first differ: the line's number,
-- | counted from `n`, and what each has there
firstDiffering : Int
               -> List String
               -> List String
               -> Pair Int (Pair String String)
firstDiffering n (Cons a argv) (Cons b bs) =
  if strEq a b then firstDiffering (n + 1) argv bs
  else MkPair n (MkPair a b)
firstDiffering n argv bs = MkPair n (MkPair (lineOr argv) (lineOr bs))

-- (a golden text that is not the one kept: the first line where they
-- differ, as a long text's whole would be too much to see)
differsAt : String -> Pair Int (Pair String String) -> GoldenSaid
differsAt path (MkPair n (MkPair kept text)) =
  Wrong
    ("golden " ^ path ^ ", line " ^ show n)
    (FailDiffer (show kept) (show text))

-- (the text, held to the one kept, or written there)
goldenAgainst : {e : HFunctor}
              -> {{disk : filesystem <: e}}
              -> Bool
              -> String
              -> String
              -> String
              -> Maybe String
              -> Co e GoldenSaid
goldenAgainst update dir path text (Just kept) =
  if strEq kept text then pure Holds
  else if update
  then do
    ok <- Files.writeFile path text
    pure
        (if ok then Wrote path
         else Wrong ("golden " ^ path) (FailBecause "could not be written"))
  else pure
      (differsAt path (firstDiffering 1 (split "\n" kept) (split "\n" text)))
goldenAgainst update dir path text Nothing =
  if update
  then do
    made <- Files.makeDirectory dir
    ok <- Files.writeFile path text
    pure
        (if ok then Wrote path
         else Wrong ("golden " ^ path) (FailBecause "could not be written"))
  else pure
      (Wrong
         ("golden " ^ path)
         (FailBecause "not kept yet: `heff test --update` writes it"))

-- (a golden text of the test file `f`, held or written)
goldenSaid : {e : HFunctor}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> Bool
           -> String
           -> Pair String String
           -> Co e GoldenSaid
goldenSaid update f (MkPair name text) =
  if not (goldenName name)
  then pure
      (Wrong
         ("golden " ^ show name)
         (FailBecause
            "a golden text's name is a file's under the directory: letters, digits, `-`, `_` and `.`, not first, between `/`s"))
  else do
    st <- styleNow
    kept <- Files.readFile (goldenPath st f name)
    goldenAgainst
        update
        (HostPath.dirname st (goldenPath st f name))
        (goldenPath st f name)
        text
        kept

-- (the outcome, failed: what was noted, and why)
outcomeFailed : Driver.TestOutcome
              -> String
              -> Driver.TestFailure
              -> Driver.TestOutcome
outcomeFailed o note why =
  { name = o.name
  , ok = False
  , skipped = Nothing
  , property = o.property
  , runs = o.runs
  , discarded = o.discarded
  , shrinks = o.shrinks
  , labels = o.labels
  , notes = List.append o.notes [note]
  , failure = Just why
  , seed = o.seed
  , goldens = o.goldens
  }

-- (the outcome's golden texts from these on, each held or written: the
-- outcome, failed at the first that does not hold)
goldensGo : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> Bool
          -> String
          -> Driver.TestOutcome
          -> List (Pair String String)
          -> Co e Driver.TestOutcome
goldensGo update f o Nil = pure o
goldensGo update f o (Cons g rest) = do
  said <- goldenSaid update f g
  case said of
    Holds -> goldensGo update f o rest
    Wrote path -> do
      print ("wrote " ^ path)
      goldensGo update f o rest
    Wrong note why -> pure (outcomeFailed o note why)

-- | each outcome that held, its golden texts held to those kept beside
-- | the file (or written there, `update`): one that does not hold fails
-- | it.  A test that failed is not held to them, nor are they written.
withGoldens : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> Bool
            -> String
            -> List Driver.TestOutcome
            -> Co e (List Driver.TestOutcome)
withGoldens update f Nil = pure Nil
withGoldens update f (Cons o rest) = do
  held <- if o.ok then goldensGo update f o o.goldens else pure o
  others <- withGoldens update f rest
  pure (Cons held others)

-- Integration tests
--------------------------------------------------------------------------------

-- | what `heff test` names the program it adds to a file to run its
-- | integration tests (check's `integrationMain` of them)
integrationMainName : String
integrationMainName = "heffTestIntegrations"

-- (how a file names what check defines: `Alias.`, or nothing where it
-- imports it with no name)
prefixOf : Maybe String -> String
prefixOf (Just alias) = alias ^ "."
prefixOf Nothing = ""

qualifierOf : List Import.Import -> Maybe String
qualifierOf Nil = Nothing
qualifierOf (Cons i rest) =
  if strEq i.name "check" then Just (prefixOf i.alias) else qualifierOf rest

-- (the program added to the file's text: check's `integrationMain` of
-- its tests)
integrationText : String -> List Driver.Own -> String
integrationText q ts =
  "\n\n"
  ^ integrationMainName
  ^ " : "
  ^ q
  ^ "Integrations\n"
  ^ integrationMainName
  ^ " = "
  ^ q
  ^ "integrationMain ["
  ^ joinWith ", " (List.map (\(o : Driver.Own) -> o.name) ts)
  ^ "]\n"

-- (the file's source, the program added to it)
withProgram : String -> Driver.Source -> Driver.Source
withProgram text s =
  { module = s.module
  , named = s.named
  , path = s.path
  , shown = s.shown
  , source = s.source ^ text
  , renames = s.renames
  , implicit = s.implicit
  , library = s.library
  }

-- (the imports a file writes)
writtenImports : Import.Imports -> List Import.Import
writtenImports imps = imps.imports

-- (the sources, the file's with the program added)
sourcesWith : String -> String -> List Driver.Source -> List Driver.Source
sourcesWith m text sources =
  List.map
    (\(o : Driver.Source) -> if strEq o.module m then withProgram text o else o)
    sources

-- (what was loaded, its sources these)
loadedWith : Load.Loaded -> List Driver.Source -> Load.Loaded
loadedWith l sources =
  { sources = sources
  , errors = l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- (the file's source, how it names check: the program added to it)
programAdded : Pending -> Driver.Source -> Either String Load.Loaded
programAdded p src = case qualifierOf
    (writtenImports (Driver.importsOfSource src)) of
  Nothing -> Left "its file does not import check, which runs it"
  Just q ->
    Right
      (loadedWith
         p.loaded
         (sourcesWith
            p.checked.module
            (integrationText q (Driver.testsOf p.checked))
            p.loaded.sources))

-- (the file loaded, its source with the program added: else why it
-- cannot be, as it imports no check)
integrationLoaded : Pending -> Either String Load.Loaded
integrationLoaded p = case List.find
    (\(src : Driver.Source) -> strEq src.module p.checked.module)
    p.loaded.sources of
  Nothing -> Left "its file is not among those loaded"
  Just src -> programAdded p src

-- (an integration test that came to no outcome, and why)
brokenTest : String -> String -> Driver.TestOutcome
brokenTest name why =
  { name = name
  , ok = False
  , skipped = Nothing
  , property = False
  , runs = 0
  , discarded = 0
  , shrinks = 0
  , labels = Nil
  , notes = Nil
  , failure = Just (FailBecause why)
  , seed = 0
  , goldens = Nil
  }

jsonText : JSON.Json -> String
jsonText (JString t) = t
jsonText _ = ""

jsonGolden : JSON.Json -> Pair String String
jsonGolden (JArray (Cons n (Cons t _))) = MkPair (jsonText n) (jsonText t)
jsonGolden _ = MkPair "" ""

jsonFailure : JSON.Json -> Maybe Driver.TestFailure
jsonFailure j = case JSON.str ["because"] j of
  Just why -> Just (FailBecause why)
  Nothing -> case JSON.arr ["differ"] j of
    Just (Cons expected (Cons got _)) ->
      Just (FailDiffer (jsonText expected) (jsonText got))
    _ -> Nothing

-- (an outcome as an integration test's program writes it)
outcomeOfJson : String -> JSON.Json -> Driver.TestOutcome
outcomeOfJson name j =
  { name = name
  , ok = fromMaybe False (JSON.bool ["ok"] j)
  , skipped = JSON.str ["skipped"] j
  , property = False
  , runs = 1
  , discarded = 0
  , shrinks = 0
  , labels = Nil
  , notes = List.map jsonText (fromMaybe Nil (JSON.arr ["notes"] j))
  , failure = case JSON.at ["failure"] j of
      Just f -> jsonFailure f
      Nothing -> Nothing
  , seed = 0
  , goldens = List.map jsonGolden (fromMaybe Nil (JSON.arr ["goldens"] j))
  }

-- | the environment variable that names the file an integration test's
-- | program writes its outcome to: check's `outcomeVariable`
outcomeVariable : String
outcomeVariable = "HEFF_TEST_OUTCOME"

-- | the file a test run in `dir` writes its outcome to: beside it, not
-- | in it, where the test makes and lists files
outcomeFile : String -> String
outcomeFile dir = dir ^ ".outcome"

-- (how a command ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "exited with " ^ show n
endedSaid (Signalled n) = "ended by the signal " ^ show n
endedSaid TimedOut = "killed at its time limit"
endedSaid (NotRun err) = "not run: " ^ showProcessError err

-- (the last lines of a text, for a failure to show)
lastLines : Int -> String -> String
lastLines n t =
  joinWith "\n" (List.reverse (List.take n (List.reverse (split "\n" t))))

-- | what came of an integration test, its program run: what it wrote
-- | to its outcome's file, else how it ended and what it said on its
-- | error stream
ranOutcome : String -> Int -> Ran -> Maybe String -> Driver.TestOutcome
ranOutcome name limit r said = case r.ended of
  TimedOut ->
    brokenTest
      name
      ("took longer than its time limit, " ^ show limit ^ " ms: killed")
  _ -> case said of
    Nothing ->
      brokenTest
        name
        ("it "
         ^ endedSaid r.ended
         ^ ", and said nothing of how it went"
         ^ (if strEq r.err "" then "" else ":\n" ^ lastLines 20 r.err))
    Just text -> case JSON.parse text of
      Left why ->
        brokenTest name "what it said of how it went could not be read"
      Right j -> outcomeOfJson name j

subtestsOfJson : Either JSON.ParseError JSON.Json -> List String
subtestsOfJson (Right j) =
  List.map jsonText (fromMaybe Nil (JSON.arr ["subtests"] j))
subtestsOfJson (Left why) = Nil

-- | the subtests an integration test named, its program run, in order:
-- | none, if it did not say how it went
ranSubtests : Maybe String -> List String
ranSubtests Nothing = Nil
ranSubtests (Just text) = subtestsOfJson (JSON.parse text)

-- | what runs the integration tests: their program, and what is set in
-- | its environment -- `HEFF`, the heff that runs them, and
-- | `HEFF_TEST_ROOT`, the project's root, so that a test of heff runs
-- | the heff tested, on the project's files; and `HEFF_TEST_JOBS`, 1,
-- | so that a `heff test` it runs takes no more than its own slot
type Launch = { program : String, env : List (Pair String String) }

-- | an integration test to run: the file it is of (its place among those
-- | run), what runs it, its place among the file's (a subtest's, its
-- | test's place and its own among the test's subtests), the name of the
-- | test it is or is under, the names of the subtests down to it, and its
-- | time limit
type Job =
  { owner : Int
  , launch : Launch
  , place : List Int
  , top : String
  , path : List String
  , limit : Int
  }

-- | an integration test's name: its test's, and the subtests' down to it
jobName : Job -> String
jobName j = joinWith " / " (Cons j.top j.path)

-- | a test's names a level each, as `--run` selects them: its groups', its
-- | own and its subtests'
jobLevels : Job -> List String
jobLevels j = List.append (split " / " j.top) j.path

-- | is a test of these names, a level each, selected by the levels of
-- | `--run`'s pattern: each name matched by the level of its depth, those
-- | deeper than the pattern by any
levelsSelected : List Regex.Regex -> List String -> Bool
levelsSelected Nil names = True
levelsSelected (Cons r rs) Nil = True
levelsSelected (Cons r rs) (Cons n ns) =
  Regex.matches r n && levelsSelected rs ns

-- | the subtests of a test that ran, those the pattern selects, to run
-- | next: each at its place under the test's
subtestJobs : List Regex.Regex -> Job -> Int -> List String -> List Job
subtestJobs sel j k Nil = Nil
subtestJobs sel j k (Cons n rest) =
  if levelsSelected sel (List.append (jobLevels j) [n])
  then Cons
      { owner = j.owner
      , launch = j.launch
      , place = List.append j.place [k]
      , top = j.top
      , path = List.append j.path [n]
      , limit = j.limit
      }
      (subtestJobs sel j (k + 1) rest)
  else subtestJobs sel j (k + 1) rest

-- (what came of a test, of its file, at its place, and its subtests to
-- run next)
type Finished =
  { owner : Int
  , place : List Int
  , outcome : Driver.TestOutcome
  , next : List Job
  }

-- (a test that could not be run: what came of it)
brokenJob : Job -> String -> Finished
brokenJob j why =
  { owner = j.owner
  , place = j.place
  , outcome = brokenTest (jobName j) why
  , next = Nil
  }

-- (the test's program ended, its directory removed: what came of it, and
-- its subtests selected, to run next)
endedJob : {e : HFunctor}
         -> {{disk : filesystem <: e}}
         -> List Regex.Regex
         -> Job
         -> String
         -> Ran
         -> Co e Finished
endedJob sel j dir ran = do
  gone <- Files.remove dir
  said <- Files.readFile (outcomeFile dir)
  told <- Files.remove (outcomeFile dir)
  pure
      { owner = j.owner
      , place = j.place
      , outcome = ranOutcome (jobName j) j.limit ran said
      , next = subtestJobs sel j 0 (ranSubtests said)
      }

-- (the test's program run in the directory, given its time limit, in a
-- process group of its own, so that what it starts is killed with it:
-- held by a `with`, waited for -- a wait pending in the reactor's group
-- it is started in, the other tests going on -- then what came of it)
ranJob : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> List Regex.Regex
       -> Job
       -> String
       -> Co e Finished
ranJob sel j dir = do
  try
    ran <-
      withProcess
        { command = j.launch.program
        , args = Cons j.top j.path
        , dir = dir
        , env = Cons (MkPair outcomeVariable (outcomeFile dir)) j.launch.env
        , timeout = j.limit
        , group = True
        }
        (\p -> wait p)
    endedJob sel j dir ran
  catch (err : ProcessError) ->
    gone <- Files.remove dir
    pure (brokenJob j ("its program could not be run: " ^ showProcessError err))

-- (the test run, in a new directory of its own; else what came of it)
runJob : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> List Regex.Regex
       -> Job
       -> Co e Finished
runJob sel j = do
  st <- styleNow
  made <- Files.temporaryDirectory "heff-test-"
  case made of
    Left err -> pure (brokenJob j ("no directory for it: " ^ showFileError err))
    Right dir -> ranJob sel j (Path.render (os := st) dir)

-- (the subtests the tests that ended named, to run next)
nextJobs : List Finished -> List Job
nextJobs fs = List.concatMap (\(f : Finished) -> f.next) fs

-- | the integration tests run, of all the files, `jobs` at most at once,
-- | each its program in a directory of its own, each a computation
-- | started in the reactor's group `g` -- pending there while its
-- | program runs, `pending` of them -- as one ends, the next starts, and
-- | the subtests it named, those `sel` selects, wait after the others
runJobs : {e : HFunctor}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> List Regex.Regex
        -> Int
        -> Reactor.Group Finished
        -> List Job
        -> Int
        -> List Finished
        -> Co e (List Finished)
runJobs sel jobs g Nil 0 done = pure done
runJobs sel jobs g Nil pending done = do
  ended <- Reactor.finished g True
  runJobs
      sel
      jobs
      g
      (nextJobs ended)
      (pending - List.length ended)
      (List.append ended done)
runJobs sel jobs g (Cons j rest) pending done =
  if pending < jobs
  then do
    begun <- Reactor.start g (runJob sel j)
    case begun of
      Just f ->
        runJobs sel jobs g (List.append rest f.next) pending (Cons f done)
      Nothing -> runJobs sel jobs g rest (pending + 1) done
  else do
    ended <- Reactor.finished g True
    runJobs
        sel
        jobs
        g
        (List.append (Cons j rest) (nextJobs ended))
        (pending - List.length ended)
        (List.append ended done)

-- (the tests of a file to run, the `owner`th, each at its place)
jobsOf : Int -> Launch -> Int -> List (Pair String Int) -> List Job
jobsOf owner launch i Nil = Nil
jobsOf owner launch i (Cons (MkPair name limit) rest) =
  Cons
    { owner = owner
    , launch = launch
    , place = [i]
    , top = name
    , path = Nil
    , limit = limit
    }
    (jobsOf owner launch (i + 1) rest)

-- | the levels of `--run`'s pattern (none, all selected, for none or one
-- | that is not read)
patternLevels : String -> List Regex.Regex
patternLevels p =
  if strEq p "" then Nil
  else case Regex.compileLevels p of
    Left why -> Nil
    Right sel -> sel

-- (a path made real, else the one given)
pathOr : Path.Style -> String -> Either FileError Path.Path -> String
pathOr st given (Left err) = given
pathOr st given (Right real) = Path.render (os := st) real

-- (where `heff test` builds a file's integration tests: `.heff/test/F/`,
-- F its path, its separators underscores)
testDir : Load.Paths -> String -> String
testDir paths file =
  Load.under
    paths
    (Load.under paths paths.root ".heff/test")
    (joinWith "_" (HostPath.components paths.style file))

-- (a file tested to its end here, its integration tests not run: its
-- golden texts held, and its line said)
testedHere : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : filesystem <: e}}
           -> {{rep : Report.report <: e}}
           -> Tested
           -> Co e TestRes
testedHere (Settled r) = pure r
testedHere (Pend p) = do
  os <- withGoldens False p.file p.outcomes
  testReport p.file p.wrong p.reports os

-- (does a test's name reach as deep as these levels of `--run`: one the
-- pattern selects, not one run on the way to its subtests)
reaches : List Regex.Regex -> Driver.TestOutcome -> Bool
reaches sel o = List.length (split " / " o.name) >= List.length sel

-- | a file's outcomes, `--run` given, all held and none as deep as the
-- | pattern (its tests run only on the way to subtests it does not
-- | name): the file passed over, as one whose tests it selects none of
passedOver : TestOpts -> List Driver.TestOutcome -> Bool
passedOver opts os =
  not (strEq opts.pattern "")
  && List.null (badOutcomes os)
  && not (List.any (reaches (patternLevels opts.pattern)) os)

-- (a file's outcomes, their golden texts held: its line said, else it is
-- passed over)
reported : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{rep : Report.report <: e}}
         -> TestOpts
         -> Pending
         -> List Driver.TestOutcome
         -> Co e TestRes
reported opts p os =
  if passedOver opts os then pure noRes
  else testReport p.file p.wrong p.reports os

-- | a file whose integration tests are built, to run with the others':
-- | its place among those run, what came of it here, and what runs them
type Ready = { at : Int, pending : Pending, launch : Launch }

-- | a file tested: done with, its line said, or its integration tests
-- | built, to run with all the files'
data Prepared = Done TestRes | Later Ready

-- (a file's outcomes and those of its integration tests, their golden
-- texts held, its line said)
reportedWith : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{rep : Report.report <: e}}
             -> TestOpts
             -> Pending
             -> List Driver.TestOutcome
             -> Co e TestRes
reportedWith opts p more = do
  os <- withGoldens opts.update p.file (List.append p.outcomes more)
  reported opts p os

-- (a file whose integration tests cannot be built: each fails, saying
-- why, and the file is done with)
unbuilt : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> TestOpts
        -> Pending
        -> String
        -> (Prepared -> Co e Unit)
        -> Co e Unit
unbuilt opts p why k = do
  r <-
    reportedWith
      opts
      p
      (List.map
         (\(i : Pair String Int) ->
            brokenTest (fst i) ("its program could not be built: " ^ why))
         p.integrations)
  k (Done r)

-- | the file's integration tests built, as `heff run` builds, into a
-- | program of the file's (check's `integrationMain` of its tests), to
-- | run with the others': its `Ready` given to `k`
buildIntegrations : {e : HFunctor}
                  -> {{io : stdio <: e}}
                  -> {{sys : process <: e}}
                  -> {{disk : filesystem <: e}}
                  -> {{rep : Report.report <: e}}
                  -> {{prog : Progress.progress <: e}}
                  -> TestOpts
                  -> Int
                  -> Pending
                  -> (Prepared -> Co e Unit)
                  -> Co e Unit
buildIntegrations opts at p k = case integrationLoaded p of
  Left why -> unbuilt opts p why k
  Right l -> do
    task <- Progress.start Progress.root (p.file ^ ": integration tests") 2
    c <- Progress.start task "compiling to C" 0
    cLoadedOr
        (\why -> do
         Progress.end c
         Progress.end task
         unbuilt opts p why k)
        l
        (Just integrationMainName)
        (testDir l.paths p.file ^ "/")
        p.file
        (ended
           c
           (zigBuildOr
              (\why -> do
               Progress.end task
               unbuilt opts p why k)
              "heff test"
              l.paths.style
              "-O1"
              task
              (testDir l.paths p.file)
              (Load.under
                 l.paths
                 (testDir l.paths p.file)
                 (programFile l.paths.style "main")) (do
            real <-
              Files.realPath
                (Load.under
                   l.paths
                   (testDir l.paths p.file)
                   (programFile l.paths.style "main"))
            self <- selfPath
            heff <- Files.realPath self
            root <- Files.realPath l.paths.root
            Progress.end task
            k
                (Later
                   { at = at
                   , pending = p
                   , launch =
                       { program = pathOr l.paths.style "" real
                       , env =
                           [ MkPair "HEFF" (pathOr l.paths.style self heff)
                           , MkPair
                             "HEFF_TEST_ROOT"
                             (pathOr l.paths.style l.paths.root root)
                           , MkPair "HEFF_TEST_JOBS" "1"
                           ]
                       }
                   }))))

-- (a file tested here, its line said, else its integration tests built:
-- then `k` of it)
prepare : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> TestOpts
        -> Int
        -> Tested
        -> (Prepared -> Co e Unit)
        -> Co e Unit
prepare opts at (Settled r) k = k (Done r)
prepare opts at (Pend p) k =
  if List.null p.integrations
  then do
    r <- reportedWith opts p Nil
    k (Done r)
  else buildIntegrations opts at p k

-- (the integration tests of the files ready, each file's)
readyJobs : List Ready -> List Job
readyJobs rs =
  List.concatMap
    (\(r : Ready) -> jobsOf r.at r.launch 0 r.pending.integrations)
    rs

-- (what came of the integration tests of the file at `at`, in its order)
outcomesOf : Int -> List Finished -> List Driver.TestOutcome
outcomesOf at fs =
  List.map
    (\(f : Finished) -> f.outcome)
    (List.sortOn
       (\(a : Finished) -> a.place)
       (List.keepIf (\(f : Finished) -> f.owner == at) fs))

-- (the files ready, each its line said in turn, what came of their tests
-- added to `acc`)
reportReady : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> {{rep : Report.report <: e}}
            -> TestOpts
            -> List Finished
            -> List Ready
            -> TestRes
            -> Co e TestRes
reportReady opts done Nil acc = pure acc
reportReady opts done (Cons r rest) acc = do
  res <- reportedWith opts r.pending (outcomesOf r.at done)
  reportReady opts done rest (addRes acc res)

-- | the integration tests of all the files ready run, `opts.jobs` at
-- | once among them all, then each file's line said, in the files' order
runReady : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> TestOpts
         -> List Ready
         -> TestRes
         -> Co e TestRes
runReady opts Nil acc = pure acc
runReady opts ready acc = do
  task <- Progress.start Progress.root "integration tests" 0
  g <- Reactor.open
  done <-
    runJobs (patternLevels opts.pattern) opts.jobs g (readyJobs ready) 0 Nil
  Reactor.close g
  Progress.end task
  reportReady opts done ready acc

-- (the tests' part of the last line: said only if there were some)
testsHeld : Int -> Int -> Int -> String
testsHeld tests failed skipped =
  if tests == 0 then ""
  else ", "
    ^ show (tests - failed - skipped)
    ^ "/"
    ^ show tests
    ^ " tests hold"
    ^ skippedSaid skipped

-- (the files' part of the last line: how many check as they should --
-- those that expect errors by having some -- of how many)
filesSaid : TestRes -> String
filesSaid r =
  ", "
  ^ show (r.files - List.length r.unchecked)
  ^ "/"
  ^ show r.files
  ^ " files check as they should"
  ^ (if r.expectErrors == 0 then ""
     else " (" ^ show r.expectErrors ^ " with expected errors)")

-- (the files that do not check as they should, a line each, where each
-- first went wrong, as their FAIL lines may be far above)
printUnchecked : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> List String
               -> Co e Unit
printUnchecked Nil = pure MkUnit
printUnchecked ws = do
  print "files that do not check as they should:"
  printLines (List.map (\w -> "  " ^ w) ws)

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.`, and a directory below them that is a project of its
-- own (a package.hf in it), passed over)
testFilesGo : {e : HFunctor}
            -> {{sys : process <: e}}
            -> {{disk : filesystem <: e}}
            -> List (Pair Bool String)
            -> List String
            -> Co e (List String)
testFilesGo Nil acc = pure (List.reverse acc)
testFilesGo (Cons (MkPair top p) rest) acc = do
  names <- Files.readDirectory p
  st <- styleNow
  case names of
    Just ns -> do
      own <- if top then pure False else Load.isRoot st p
      if own then testFilesGo rest acc
      else testFilesGo
          (List.append
             (List.map
                (\n -> MkPair False (HostPath.join st p n))
                (List.keepIf (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then testFilesGo rest (Cons p acc)
      else testFilesGo rest acc

-- (the directory named, if it is one: what reading it found)
directoryIf : {a : Type} -> String -> Maybe a -> List String
directoryIf d (Just _) = [d]
directoryIf d Nothing = []

-- | the files `heff test` checks: those given, a directory's `.hf` files
-- | for it; none given, the project's here (the `.hf` files under `src/`,
-- | for their doc tests and watches, and `test/`)
testFiles : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : filesystem <: e}}
          -> List String
          -> Co e (List String)
testFiles Nil = do
  src <- Files.readDirectory "src"
  tests <- Files.readDirectory "test"
  case List.append (directoryIf "src" src) (directoryIf "test" tests) of
    [] -> do
      printErr
          "heff test: no src/ nor test/ here: test at the project's root, or give FILEs"
      exit 1
      pure Nil
    roots -> testFilesGo (List.map (\r -> MkPair True r) roots) Nil
testFiles given = testFilesGo (List.map (\f -> MkPair True f) given) Nil

-- | did `--run` give a pattern that selects no test of any file
noneSelected : TestOpts -> TestRes -> Bool
noneSelected opts acc = not (strEq opts.pattern "") && acc.tests == 0

-- (the last of `heff test`: the files that do not check listed, the
-- line that adds it up, and its status)
testSummary : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> TestOpts
            -> TestRes
            -> Co e Unit
testSummary opts acc = do
  printUnchecked acc.unchecked
  if noneSelected opts acc
  then do
    printErr ("heff test: no tests match '" ^ opts.pattern ^ "'")
    exit 1
  else pure MkUnit
  print
      (show (acc.total - acc.failed)
       ^ "/"
       ^ show acc.total
       ^ " expectations hold"
       ^ testsHeld acc.tests acc.testsFailed acc.testsSkipped
       ^ filesSaid acc)
  if acc.failed > 0 || acc.testsFailed > 0 || not (List.null acc.unchecked)
  then exit 1
  else pure MkUnit

-- | check the watches' and doc tests' expectations of every file
-- | given, and run its tests (each property from `seed`), each file a
-- | task under `tk` as it is tested
testCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{rep : Report.report <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{rx : Reactor.reactor <: e}}
        -> {{ex : exception ProcessError <: e}}
        -> Progress.Task
        -> TestOpts
        -> List String
        -> TestRes
        -> List Ready
        -> Co e Unit
testCmd tk opts Nil acc ready = do
  Progress.end tk
  res <- runReady opts ready acc
  testSummary opts res
testCmd tk opts (Cons f rest) acc ready = do
  ft <- Progress.start tk f 0
  t <- testOneF opts f
  prepare
      opts
      (List.length ready)
      t (\pr -> do
    Progress.end ft
    case pr of
      Done r -> testCmd tk opts rest (addRes acc r) ready
      Later r -> testCmd tk opts rest acc (List.append ready [r]))

-- | `heff test`: the watches' expectations of the files checked, and
-- | their tests run (each property from `seed`), a task meanwhile, each
-- | file one more of its
testsCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{rep : Report.report <: e}}
         -> {{prog : Progress.progress <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{ex : exception ProcessError <: e}}
         -> TestOpts
         -> List String
         -> Co e Unit
testsCmd opts files = do
  tk <- Progress.start Progress.root "testing" (List.length files)
  testCmd tk opts files noRes Nil

-- | the seed the properties are run from, unless `--seed` gives one:
-- | always the same, so that a run of the tests is a run of the same
-- | tests
defaultSeed : Int
defaultSeed = 2026

seedOf : Maybe String -> Int
seedOf Nothing = defaultSeed
seedOf (Just s) = fromMaybe defaultSeed (parseInt s)

-- | how many integration tests run at once, unless `--jobs` or
-- | HEFF_TEST_JOBS says: half the machine's cores, at least one, so that
-- | a run of the tests does not take all of it
-- | >>> List.map defaultJobs [1, 2, 3, 8, 14]
-- | [1, 1, 1, 4, 7]
defaultJobs : Int -> Int
defaultJobs cores = if cores / 2 < 1 then 1 else cores / 2

-- (how many at once: as given, if it is a number above 0)
countOf : Int -> Maybe String -> Int
countOf fallback Nothing = fallback
countOf fallback (Just n) = case parseInt n of
  Just k -> if k > 0 then k else fallback
  Nothing -> fallback

-- | `heff test`'s options read: the seed, the pattern (read here, a
-- | pattern that is not ends the run), how many integration tests at
-- | once (`--jobs`, else HEFF_TEST_JOBS, else `defaultJobs`), and
-- | whether golden texts are written
testOptions : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> Maybe String
            -> Maybe String
            -> Maybe String
            -> Bool
            -> Co e TestOpts
testOptions seed pattern jobs update = do
  case Regex.compileLevels (fromMaybe "" pattern) of
    Left why -> do
      printErr ("heff test: --run " ^ fromMaybe "" pattern ^ ": " ^ why)
      exit 2
    Right _ -> pure MkUnit
  cores <- processors
  env <- getEnv "HEFF_TEST_JOBS"
  pure
      { seed = seedOf seed
      , pattern = fromMaybe "" pattern
      , jobs = countOf (countOf (defaultJobs cores) env) jobs
      , update = update
      }

-- `heff test --watch`
--------------------------------------------------------------------------------

-- | what `heff test --watch` watches: the files tested (those given,
-- | else `test/`) and the project's -- what the files import is among
-- | them
-- | >>> testWatched Nil
-- | ["test", "package.hf", "src", "app"]
-- | >>> testWatched ["a.hf"]
-- | ["a.hf", "package.hf", "src", "app"]
testWatched : List String -> List String
testWatched Nil = "test" :: Watch.project
testWatched given = List.append given Watch.project

-- (an option given again, as it was given)
flagged : String -> Maybe String -> List String
flagged name Nothing = Nil
flagged name (Just v) = [name, v]

-- | the command line each run of `heff test --watch` is: `heff test` as
-- | it was given, without `--watch`
-- | >>> testArgs (Just "7") Nothing (Just "2") ["a.hf"]
-- | ["test", "--seed", "7", "--jobs", "2", "a.hf"]
testArgs : Maybe String
         -> Maybe String
         -> Maybe String
         -> List String
         -> List String
testArgs seed pattern jobs given =
  "test"
  :: List.append
    (flagged "--seed" seed)
    (List.append
       (flagged "--run" pattern)
       (List.append (flagged "--jobs" jobs) given))

-- (how a run of the tests went, said)
heldSaid : Ran -> String
heldSaid r = if succeeded r then "all held" else "not all held"

-- (the line between a run and the one before it: a change)
changedSaid : {e : HFunctor} -> {{io : stdio <: e}} -> Int -> Co e Unit
changedSaid 0 = pure MkUnit
changedSaid n = printErr "\nheff test: a change; tested again\n"

-- | a run of the tests, the `n`th before it: `heff test` run beside, its
-- | output the terminal's, waited for, and how it went said -- each
-- | run's output between such lines
testedAgain : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{ex : exception ProcessError <: e}}
            -> List String
            -> Int
            -> Co e Int
testedAgain argv n = do
  changedSaid n
  self <- selfPath
  try
    r <-
      withProcess
        { command = self
        , args = argv
        , input = Inherited
        , output = Inherited
        , errors = Inherited
        }
        (\p -> wait p)
    printErr
        ("heff test: tested ("
         ^ show (n + 1)
         ^ "), "
         ^ heldSaid r
         ^ "; tested again at the next change")
  catch (err : ProcessError) ->
    printErr "heff test: cannot run heff; tested again at the next change"
  return n + 1

-- | `heff test --watch`: the tests run as `heff test` runs them, then
-- | again at each change of what they test (`testWatched`), until the
-- | program is ended.  Not with `--update`: the golden texts it writes
-- | would be a change, tested again, without end
testsWatched : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : filesystem <: e}}
             -> {{clock : Time.time <: e}}
             -> {{ex : exception ProcessError <: e}}
             -> Maybe String
             -> Maybe String
             -> Maybe String
             -> Bool
             -> List String
             -> Co e Unit
testsWatched seed pattern jobs True given = do
  printErr "heff test: --watch is not given with --update"
  exit 2
testsWatched seed pattern jobs False given = do
  _ <- testOptions seed pattern jobs False
  _ <- testFiles given
  st <- styleNow
  stamp <- Watch.stamped st (testWatched given)
  first <- testedAgain (testArgs seed pattern jobs given) 0
  Watch.watchOver
      st
      (testWatched given)
      (\n -> pure n)
      (testedAgain (testArgs seed pattern jobs given))
      stamp
      first
