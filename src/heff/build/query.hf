-- What a tool asks of a file elaborated: the elaboration's trace, the
-- name at an offset (its type, where it is defined, what may be written
-- there), every occurrence of what a name refers to, and an outline.

module heff.build.query

import heff.syntax.diagnostic
import heff.build.driver as Driver
import heff.elab.environment as Environment
import heff.elab.globals as Globals
import heff.elab.locals as Locals
import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import heff.syntax.surfaceprint as SurfacePrint
import heff.elab.readback as Readback
import heff.lsp.render as Render
import heff.elab.syntax as Syntax
import heff.elab.toplevel as TopLevel
import std.map as Map

-- Small things
--------------------------------------------------------------------------------

catMaybesQ : {a : Type} -> List (Maybe a) -> List a
catMaybesQ Nil = Nil
catMaybesQ (Cons (Just x) rest) = Cons x (catMaybesQ rest)
catMaybesQ (Cons Nothing rest) = catMaybesQ rest

sameSpan : Params.Span -> Params.Span -> Bool
sameSpan a b = a.start == b.start && a.end == b.end

mkSpan : Int -> Int -> Params.Span
mkSpan s e = { start = s, end = e }

-- | a character of a name (a module path's `/` too)
isNameChar : Int -> Bool
isNameChar c =
  c == 95
  || c == 39
  || c == 47
  || 97 <= c && c <= 122
  || 65 <= c && c <= 90
  || 48 <= c && c <= 57

-- | is `x`, at `p` in `src`, a word: not part of a longer name?
wordAt : String -> Int -> String -> Bool
wordAt src p x =
  (p == 0 || not (isNameChar (byteAt src (p - 1))))
  && not (isNameChar (byteAt src (p + strLength x)))

-- | the first occurrence of a name, as a word, in a span (else the span)
nameInGo : String -> String -> Params.Span -> Int -> Params.Span
nameInGo src x sp from = case indexFrom x src from of
  Just p ->
    if p + strLength x <= sp.end
    then if wordAt src p x then mkSpan p (p + strLength x)
      else nameInGo src x sp (p + 1)
    else sp
  Nothing -> sp

nameIn : String -> String -> Params.Span -> Params.Span
nameIn src x sp = nameInGo src x sp sp.start

stripPrefixS : String -> String -> Maybe String
stripPrefixS pre s =
  if startsWith pre s then Just (strSlice s (strLength pre) (strLength s))
  else Nothing

nubByStart : List Params.Span -> List Params.Span
nubByStart Nil = Nil
nubByStart (Cons x xs) =
  Cons
    x
    (nubByStart (List.keepIf (\(y : Params.Span) -> y.start /= x.start) xs))

sortSpans : List Params.Span -> List Params.Span
sortSpans xs =
  List.sortBy (\(a : Params.Span) (b : Params.Span) -> a.start <= b.start) xs

-- The trace
--------------------------------------------------------------------------------

atLine : String -> Params.Span -> String
atLine src sp =
  show ((Render.lineCol src sp.start).line + 1)
  ^ ":"
  ^ show ((Render.lineCol src sp.start).col + 1)

-- | the elaboration trace of a file, one line per event: where, what
explain : Driver.Checked -> List String
explain c =
  List.append
    (List.map
       (\(ev : Environment.TraceEvent) ->
          atLine c.source ev.span ^ "  " ^ ev.kind ^ "  " ^ ev.text MkUnit)
       c.top.trace)
    (List.map
       (\(d : Diag) ->
          atLine c.source d.span
          ^ "  "
          ^ Render.severityWord d.severity
          ^ "  "
          ^ d.msg)
       c.diags)

-- The name at an offset
--------------------------------------------------------------------------------

infoLen : Environment.Info -> Int
infoLen i = i.span.end - i.span.start

-- (a name past its qualifier: `lookup` of `std.map.lookup`)
lastPart : String -> Int -> String
lastPart x i =
  if i <= 0 then x
  else if byteAt x (i - 1) == 46 then strSlice x i (strLength x)
  else lastPart x (i - 1)

-- | whether a global's name (or a member's, a tag's or a field's) is
-- | written where it was found: not one the lowering used there
-- | (`prelude.typeOf` for a `let mut` variable's type, a tuple's `Pair`
-- | and `MkUnit`).  A local is the variable written, if renamed
writtenAt : String -> Environment.Info -> Bool
writtenAt src { key = Nothing } = True
writtenAt src i =
  contains
    (lastPart i.name (strLength i.name))
    (strSlice src i.span.start i.span.end)

-- | the name at an offset: one written there, the innermost.  (What `do`
-- | is read into, `bind`, is no name written: its span is the block's,
-- | wider than the name, and it must not hide what is in the block.)
infoAt : Driver.Checked -> Int -> Maybe Environment.Info
infoAt c off =
  List.head
    (List.sortBy
       (\(a : Environment.Info) (b : Environment.Info) ->
          infoLen a <= infoLen b)
       (List.keepIf
          (\(i : Environment.Info) ->
             -- (a field is written with its `.`: `.x`)
             infoLen
               i
             <= strLength i.name + 1
             && i.span.start <= off
             && off <= i.span.end
             && writtenAt c.source i)
          c.top.infos))

-- | what the name at an offset resolved to, and its type
typeAt : Driver.Checked -> Int -> Maybe String
typeAt c off = case infoAt c off of
  Just i ->
    Just
      (SurfacePrint.named i.name
       ^ " : "
       ^ i.ty MkUnit
       ^ (case i.key of
          Just _ -> "   (global)"
          Nothing -> "   (local)"))
  Nothing -> Nothing

isTypedChar : Int -> Bool
isTypedChar c =
  c == 95
  || c == 39
  || c == 46
  || 97 <= c && c <= 122
  || 65 <= c && c <= 90
  || 48 <= c && c <= 57

typedFrom : String -> Int -> Int
typedFrom src i =
  if i > 0 && isTypedChar (byteAt src (i - 1)) then typedFrom src (i - 1) else i

lastDot : String -> Int -> Maybe Int
lastDot s i =
  if i < 0 then Nothing
  else if byteAt s i == 46 then Just i
  else lastDot s (i - 1)

type Completion = { label : String, detail : String }

completionDetail : Driver.Checked -> String -> String
completionDetail c x = case Globals.lookupName c.top.globals x of
  Just e -> Driver.showTySx c.top.globals (Readback.readbTy 0 e.type_)
  Nothing -> case Globals.lookupEntry c.top.globals (c.module ^ "." ^ x) of
    Just e -> Driver.showTySx c.top.globals (Readback.readbTy 0 e.type_)
    Nothing -> ""

completionOf : Driver.Checked -> String -> String -> String -> Maybe Completion
completionOf c typed qualifier x =
  if startsWith typed x && (not (strEq qualifier "") || not (contains "." x))
  then Just
      { label = fromMaybe x (stripPrefixS qualifier x)
      , detail = completionDetail c x
      }
  else Nothing

qualifierOf : String -> String
qualifierOf typed = case lastDot typed (strLength typed - 1) of
  Just i -> strSlice typed 0 (i + 1)
  Nothing -> ""

typedAt : Driver.Checked -> Int -> String
typedAt c offset = strSlice c.source (typedFrom c.source offset) offset

-- (a primitive is named by its key, by no alias)
primitiveName : String -> Syntax.Tm -> Maybe String
primitiveName k (SPrim _) = Just k
primitiveName k _ = Nothing

-- | the primitives in scope, the library's
primitivesIn : Globals.Globals -> List String
primitivesIn g =
  catMaybesQ
    (List.map
       (\(p : Pair String Globals.Entry) ->
          primitiveName (fst p) (snd p).syntax)
       (Globals.globalsList g))

-- | `abandon`, a hole while a definition is being written
keywordCompletions : String -> List Completion
keywordCompletions typed =
  if startsWith typed "abandon"
  then [ { label = "abandon"
         , detail = "a hole: checks at any small type, abandons the run"
         }
       ]
  else Nil

-- (whether only spaces, one at least, are between the line's start and
-- `i`: where a statement of a block starts)
startsStatement : String -> Int -> Int -> Bool
startsStatement src i n =
  if i > 0 && byteAt src (i - 1) == 32 then startsStatement src (i - 1) (n + 1)
  else n > 0 && (i == 0 || byteAt src (i - 1) == 10)

-- | `with`, where a statement of a block starts (`from`, where the name
-- | being typed does): a `with` statement
statementCompletions : String -> Int -> String -> List Completion
statementCompletions src from typed =
  if startsStatement src from 0 && startsWith typed "with"
  then [ { label = "with"
         , detail = "a statement: `with e as x do`, the block the `with`'s body"
         }
       ]
  else Nil

-- | What may be written where the name being typed ends, at `offset`:
-- | the names in scope that start as it does, the primitives and
-- | `abandon` too, each with its type; `with` where a statement starts.  After `M.`, the definitions of the module imported as
-- | `M`, without the `M.`.
completionsAt : Driver.Checked -> Int -> List Completion
completionsAt c offset =
  List.sortBy
    (\(a : Completion) (b : Completion) -> not (strLt b.label a.label))
    (List.append
       (List.append
          (keywordCompletions (typedAt c offset))
          (statementCompletions
             c.source
             (typedFrom c.source offset)
             (typedAt c offset)))
       (catMaybesQ
          (List.map
             (\x ->
                completionOf
                  c
                  (typedAt c offset)
                  (qualifierOf (typedAt c offset))
                  x)
             (Driver.nubStrD
                (List.append
                   (List.map (\(o : Driver.Own) -> o.name) c.own)
                   (List.append
                      (Map.keys c.top.globals.aliases)
                      (primitivesIn c.top.globals)))))))

-- References
--------------------------------------------------------------------------------

-- | What a name refers to: a global, by its key; a tag or a field
-- | (`member`) of the type `key` names; or a local (`local`: where its
-- | binder is) of the file `key` is the path of.
type Target = { key : String, member : Maybe String, local : Maybe Params.Span }

globalT : String -> Target
globalT k = { key = k, member = Nothing, local = Nothing }

memberT : String -> String -> Target
memberT k m = { key = k, member = Just m, local = Nothing }

localT : String -> Params.Span -> Target
localT path b = { key = path, member = Nothing, local = Just b }

eqMaybeStr : Maybe String -> Maybe String -> Bool
eqMaybeStr Nothing Nothing = True
eqMaybeStr (Just a) (Just b) = strEq a b
eqMaybeStr _ _ = False

eqMaybeSpan : Maybe Params.Span -> Maybe Params.Span -> Bool
eqMaybeSpan Nothing Nothing = True
eqMaybeSpan (Just a) (Just b) = sameSpan a b
eqMaybeSpan _ _ = False

eqTarget : Target -> Target -> Bool
eqTarget a b =
  strEq a.key b.key
  && eqMaybeStr a.member b.member
  && eqMaybeSpan a.local b.local

-- | a name written in a file; the span is the name's alone; `defines`:
-- | where it is defined
type Occurrence =
  { path : String, source : String, span : Params.Span, defines : Bool }

type Site = { target : Target, name : String, span : Params.Span }

type Named = { name : String, span : Params.Span }

keyOf : Driver.Checked -> String -> Maybe String
keyOf c x = case List.find (\(o : Driver.Own) -> strEq o.name x) c.own of
  Just o -> Just o.key
  Nothing -> Nothing

-- (the name alone: a tag's `'` is not part of it)
site : Target -> String -> Params.Span -> Site
site t x sp =
  { target = t
  , name = x
  , span = mkSpan (max sp.start (sp.end - strLength x)) sp.end
  }

globalSites : Driver.Checked -> String -> List Params.Span -> List Site
globalSites c x sps = case keyOf c x of
  Just k -> List.map (\sp -> site (globalT k) x sp) sps
  Nothing -> Nil

memberSites : Driver.Checked -> String -> List Named -> List Site
memberSites c x ms = case keyOf c x of
  Just k -> List.map (\(m : Named) -> site (memberT k m.name) m.name m.span) ms
  Nothing -> Nil

tagOf : Params.Spanned (Presyntax.Variant Presyntax.Expr) -> Maybe Named
tagOf (At (TagVariant t tsp _) _) = Just { name = t, span = tsp }
tagOf _ = Nothing

fieldOf : Params.Spanned (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr)
        -> Maybe Named
fieldOf (At (DeclareField x sp _ _) _) = Just { name = x, span = sp }
fieldOf _ = Nothing

sumTags : Presyntax.Expr -> List Named
sumTags (At (ESum alts) _) = catMaybesQ (List.map tagOf alts)
sumTags _ = Nil

equationHead : Params.Spanned (Presyntax.Equation Presyntax.Expr) -> Params.Span
equationHead (At (MkEquation _ fsp _ _) _) = fsp

declSites : Driver.Checked -> Presyntax.Decl -> List Site
declSites c (At (DeclEquations f fsp _ _ eqs) _) =
  globalSites c f (Cons fsp (List.map equationHead eqs))
-- (a definition with named arguments, `data Pair a b = ...`: its name
-- and its tags)
declSites c (At (DeclDefine x xsp _ _ body) _) =
  List.append (globalSites c x [xsp]) (memberSites c x (sumTags body))
declSites c (At (DeclTheory x xsp _ (At (ESig fs) _)) _) =
  List.append
    (globalSites c x [xsp])
    (memberSites c x (catMaybesQ (List.map fieldOf fs)))
declSites c (At (DeclPrimitive x sp _) _) = globalSites c x [sp]
declSites c _ = Nil

-- | Where a file defines its names, as its notation says: each
-- | declaration's name, in its signature and at the head of each
-- | equation; a `data`'s tags; a `theory`'s fields.  (A declaration that
-- | did not elaborate defines nothing to refer to.)
sites : Driver.Checked -> List Site
sites c = List.concatMap (\d -> declSites c d) c.decls

-- | where the global the name at an offset resolved to is defined, in a
-- | program (the file last): its file, and the span of its name there.
-- | (A local's binder is not kept by the elaborator: nothing, for one.)
type Definition = { path : String, source : String, span : Params.Span }

type Defines = { c : Driver.Checked, name : String, span : Params.Span }

definesGo : String
          -> Driver.Checked
          -> List Driver.Own
          -> List (Pair String Params.Span)
          -> Maybe Defines
definesGo k c (Cons o os) (Cons (MkPair _ sp) sps) =
  if strEq o.key k then Just { c = c, name = o.name, span = sp }
  else definesGo k c os sps
definesGo k c _ _ = Nothing

definitionIn : Environment.Info -> String -> Defines -> Definition
definitionIn i k d =
  { path = d.c.path
  , source = d.c.source
  , span =
      -- (the name looked for is the one at the offset: a tag's is in its
      -- type's declaration)
      case List.find
        (\(s : Site) ->
           eqTarget s.target (if i.member then memberT k i.name else globalT k))
        (sites d.c) of
      Just s -> s.span
      Nothing -> nameIn d.c.source i.name d.span
  }

definitionAt : List Driver.Checked -> Int -> Maybe Definition
definitionAt program off = case List.last program of
  Nothing -> Nothing
  Just c -> case infoAt c off of
    Nothing -> Nothing
    Just i -> case i.key of
      Nothing -> Nothing
      Just k ->
        -- (a primitive may be declared by more than one file: this
        -- one's first)
        case List.head
          (catMaybesQ
             (List.map
                (\(c2 : Driver.Checked) -> definesGo k c2 c2.own c2.top.spans)
                (List.reverse program))) of
        Just d -> Just (definitionIn i k d)
        Nothing -> Nothing

-- | a target found, and the name it is defined as
type Found = { target : Target, name : String }

ownNameOf : List Driver.Checked -> String -> Maybe String
ownNameOf Nil k = Nothing
ownNameOf (Cons c rest) k = case List.find
    (\(o : Driver.Own) -> strEq o.key k)
    c.own of
  Just o -> Just o.name
  Nothing -> ownNameOf rest k

withName : List Driver.Checked -> Target -> Maybe Found
withName program t@{ member = Just m } = Just { target = t, name = m }
withName program t@{ member = Nothing } = case ownNameOf program t.key of
  Just x -> Just { target = t, name = x }
  Nothing -> Nothing

atOff : Int -> Params.Span -> Bool
atOff off sp = sp.start <= off && off <= sp.end

orElse : {a : Type} -> Maybe a -> Maybe a -> Maybe a
orElse (Just x) _ = Just x
orElse Nothing y = y

siteFound : List Driver.Checked -> Driver.Checked -> Int -> Maybe Found
siteFound program c off = case List.find
    (\(s : Site) -> atOff off s.span)
    (sites c) of
  Just s -> withName program s.target
  Nothing -> Nothing

-- (a field used by the fields after it: the field's)
fieldFound : List Driver.Checked
           -> Driver.Checked
           -> Locals.Locals
           -> Int
           -> Maybe Found
fieldFound program c ls off = case List.find
    (\(f : Locals.FieldUse) -> atOff off f.use)
    ls.fields of
  Just f -> case List.find (\(s : Site) -> sameSpan s.span f.field) (sites c) of
    Just s -> withName program s.target
    Nothing -> Nothing
  Nothing -> Nothing

atLocal : Int -> Locals.Local -> Bool
atLocal off l = atOff off l.binder || List.any (\sp -> atOff off sp) l.uses

foundLocal : String -> Locals.Local -> Found
foundLocal path l = { target = localT path l.binder, name = l.name }

localFound : Driver.Checked -> Locals.Locals -> Int -> Maybe Found
localFound c ls off = case List.find (\l -> atLocal off l) ls.locals of
  Just l -> Just (foundLocal c.path l)
  Nothing -> Nothing

targetIn : List Driver.Checked
         -> Driver.Checked
         -> Locals.Locals
         -> Int
         -> Maybe Found
targetIn program c ls off = case infoAt c off of
  Just i -> case i.key of
    Just k ->
      withName program (if i.member then memberT k i.name else globalT k)
    Nothing ->
      orElse
        (siteFound program c off)
        (orElse (fieldFound program c ls off) (localFound c ls off))
  Nothing ->
    orElse
      (siteFound program c off)
      (orElse (fieldFound program c ls off) (localFound c ls off))

-- | the name at an offset, in a program (the file last), as what it
-- | refers to: a global or a member used there, or one the file defines
-- | there; a local, at its binder or a use; and the name it is defined as
targetAt : List Driver.Checked -> Int -> Maybe Found
targetAt program off = case List.last program of
  Just c -> targetIn program c (Locals.locals c.decls) off
  Nothing -> Nothing

-- (a name's use, as the elaborator recorded it: the name alone)
useOf : Target -> String -> Environment.Info -> Maybe Params.Span
useOf t name i =
  if eqMaybeStr i.key (Just t.key)
     && (if i.member then eqMaybeStr t.member (Just i.name)
         else eqMaybeStr t.member Nothing)
  then Just
      (mkSpan (max i.span.start (i.span.end - strLength name)) i.span.end)
  else Nothing

type Word = { text : String, span : Params.Span }

-- (a line's words, split at spaces, where they are)
wordsOf : Int -> String -> Int -> List Word -> List Word
wordsOf base line i acc =
  if i >= strLength line then List.reverse acc
  else if byteAt line i == 32 then wordsOf base line (i + 1) acc
  else wordsOf
      base
      line
      (fromMaybe (strLength line) (indexFrom " " line i))
      (Cons
         { text =
             strSlice line i (fromMaybe (strLength line) (indexFrom " " line i))
         , span =
             mkSpan
               (base + i)
               (base + fromMaybe (strLength line) (indexFrom " " line i))
         }
         acc)

fixityWords : String -> List Word -> List Params.Span
fixityWords name ws@(Cons w _) =
  if strEq w.text "infixl" || strEq w.text "infixr" || strEq w.text "infix"
  then List.map
      (\(x : Word) -> x.span)
      (List.keepIf (\(x : Word) -> strEq x.text name) ws)
  else Nil
fixityWords name Nil = Nil

-- (`infixl + - above ==`: its words that are the name)
fixityLine : String -> String -> Int -> List Params.Span
fixityLine name src p =
  fixityWords
    name
    (wordsOf
       p
       (strSlice src p (fromMaybe (strLength src) (indexFrom "\n" src p)))
       0
       Nil)

lineStarts : String -> List Int
lineStarts src =
  List.keepIf
    (\p -> p == 0 || byteAt src (p - 1) == 10)
    (List.range 0 (strLength src - 1))

-- (the words `name` from `i` up to `to` that `fits` takes)
wordsIn : (Int -> Bool)
        -> String
        -> String
        -> Int
        -> Int
        -> List Params.Span
        -> List Params.Span
wordsIn fits name src i to acc = case indexFrom name src i of
  Just p ->
    if p + strLength name <= to
    then wordsIn
        fits
        name
        src
        (p + 1)
        to
        (if wordAt src p name && fits p
         then Cons (mkSpan p (p + strLength name)) acc
         else acc)
    else List.reverse acc
  Nothing -> List.reverse acc

lineStartOf : String -> Int -> Int
lineStartOf src p =
  if p > 0 && byteAt src (p - 1) /= 10 then lineStartOf src (p - 1) else p

-- (whether `p` is in a string, a line's quotes counted from `i`)
inStringGo : String -> Int -> Int -> Bool -> Bool
inStringGo src i p inside =
  if i >= p then inside
  else if inside && byteAt src i == 92 then inStringGo src (i + 2) p inside
  else if byteAt src i == 34 then inStringGo src (i + 1) p (not inside)
  else inStringGo src (i + 1) p inside

spacesFrom : String -> Int -> Int
spacesFrom src i = if byteAt src i == 32 then spacesFrom src (i + 1) else i

spacesBefore : String -> Int -> Int
spacesBefore src i =
  if i > 0 && byteAt src (i - 1) == 32 then spacesBefore src (i - 1) else i

-- (a record's label, `{ x = ...` or `, x = ...`: the name at `p`, `n`
-- long)
isLabelAt : String -> Int -> Int -> Bool
isLabelAt src p n =
  byteAt src (spacesFrom src (p + n)) == 61
  && byteAt src (spacesFrom src (p + n) + 1) /= 61
  && spacesBefore src p > 0
  && (byteAt src (spacesBefore src p - 1) == 123
      || byteAt src (spacesBefore src p - 1) == 44)

-- (a field's name, not a tag's: not capitalised)
isFieldMember : Maybe String -> Bool
isFieldMember (Just m) = not (65 <= byteAt m 0 && byteAt m 0 <= 90)
isFieldMember Nothing = False

-- | a name in a watch's expectation, as what it is there: in a string,
-- | nothing; a label (`{ x = ...`) or after a `.`, a field; else a global
-- | or a tag
expectedFits : Target -> String -> Int -> Int -> Bool
expectedFits t src n p =
  not (inStringGo src (lineStartOf src p) p False)
  && (if isFieldMember t.member
      then isLabelAt src p n || (p > 0 && byteAt src (p - 1) == 46)
      else not (isLabelAt src p n))

-- (in a watch's expectation, a doc test's too, as text)
expectedIn : Target -> String -> Driver.Checked -> List Params.Span
expectedIn t name c =
  List.concatMap
    (\(w : TopLevel.Watch) ->
       wordsIn
         (\p -> expectedFits t c.source (strLength name) p)
         name
         c.source
         (Driver.expectation c.source w.span).from
         (Driver.expectation c.source w.span).to
         Nil)
    c.top.watches

isOperatorName : String -> Bool
isOperatorName name = not (isNameChar (byteAt name 0))

fieldUsesOf : List Site -> Locals.Locals -> List Params.Span
fieldUsesOf ss ls =
  List.map
    (\(f : Locals.FieldUse) -> f.use)
    (List.keepIf
       (\(f : Locals.FieldUse) ->
          List.any (\(s : Site) -> sameSpan s.span f.field) ss)
       ls.fields)

moreIn : Target -> String -> Driver.Checked -> List Params.Span
moreIn t name c =
  List.append
    (if isOperatorName name && eqMaybeStr t.member Nothing
     then List.concatMap
         (\p -> fixityLine name c.source p)
         (lineStarts c.source)
     else Nil)
    (if isOperatorName name then Nil else expectedIn t name c)

mkOccurrence : Driver.Checked -> Params.Span -> Bool -> Occurrence
mkOccurrence c sp defines =
  { path = c.path, source = c.source, span = sp, defines = defines }

occurrencesOf : Driver.Checked
              -> List Params.Span
              -> List Params.Span
              -> List Occurrence
occurrencesOf c defs spans =
  List.map
    (\sp ->
       mkOccurrence
         c
         sp
         (List.any (\(d : Params.Span) -> d.start == sp.start) defs))
    (nubByStart (sortSpans spans))

inFileFound : Target
            -> String
            -> Driver.Checked
            -> List Site
            -> List Params.Span
            -> List Occurrence
inFileFound t name c ss found =
  occurrencesOf
    c
    (List.map (\(s : Site) -> s.span) ss)
    (List.append found (if List.null found then Nil else moreIn t name c))

inFileSites : Target -> String -> Driver.Checked -> List Site -> List Occurrence
inFileSites t name c ss =
  inFileFound
    t
    name
    c
    ss
    (List.append
       (catMaybesQ (List.map (\i -> useOf t name i) c.top.infos))
       (List.append
          (List.map (\(s : Site) -> s.span) ss)
          (fieldUsesOf ss (Locals.locals c.decls))))

inFile : Target -> String -> Driver.Checked -> List Occurrence
inFile t name c =
  inFileSites
    t
    name
    c
    (List.keepIf (\(s : Site) -> eqTarget s.target t) (sites c))

nubByPath : List Driver.Checked -> List Driver.Checked
nubByPath Nil = Nil
nubByPath (Cons c cs) =
  Cons
    c
    (nubByPath
       (List.keepIf (\(d : Driver.Checked) -> not (strEq d.path c.path)) cs))

sameBinder : Params.Span -> Locals.Local -> Bool
sameBinder b l = sameSpan l.binder b

spansOfLocal : Locals.Local -> List Params.Span
spansOfLocal l = Cons l.binder l.uses

localOccurrences : Driver.Checked -> Params.Span -> List Occurrence
localOccurrences c b = case List.find
    (\l -> sameBinder b l)
    (Locals.locals c.decls).locals of
  Just l ->
    List.map
      (\sp -> mkOccurrence c sp (sameSpan sp b))
      (sortSpans (spansOfLocal l))
  Nothing -> Nil

-- | every occurrence in a program of what a name refers to (`name`, as
-- | it is defined), by file, in order: its definition, its uses -- the
-- | elaborator's record of each -- and, as text, in the files that use
-- | it, in a fixity declaration (an operator) and in a watch's
-- | expectation (a local: its binder and its uses, in its file)
occurrences : List Driver.Checked -> Target -> String -> List Occurrence
occurrences program t@{ local = Just b } name = case List.find
    (\(c : Driver.Checked) -> strEq c.path t.key)
    program of
  Just c -> localOccurrences c b
  Nothing -> Nil
occurrences program t@{ local = Nothing } name =
  List.concatMap (\c -> inFile t name c) (nubByPath program)

-- | a capitalised name (1), a variable (2), an operator (3), or none (0)
isNameChar2 : Int -> Bool
isNameChar2 d = d /= 47 && isNameChar d

allChars : (Int -> Bool) -> String -> Int -> Bool
allChars p s i =
  if i >= strLength s then True else p (byteAt s i) && allChars p s (i + 1)

punctuation : Int -> Bool
punctuation d =
  d == 32
  || d == 10
  || d == 40
  || d == 41
  || d == 91
  || d == 93
  || d == 123
  || d == 125
  || d == 44
  || d == 34
  || d == 96

nameClass : String -> Int
nameClass x =
  if strLength x == 0 then 0
  else if 65 <= byteAt x 0 && byteAt x 0 <= 90
  then if allChars isNameChar2 x 0 then 1 else 0
  else if byteAt x 0 == 95 || 97 <= byteAt x 0 && byteAt x 0 <= 122
  then if allChars isNameChar2 x 0 then 2 else 0
  else if allChars (\d -> not (isNameChar2 d) && not (punctuation d)) x 0 then 3
  else 0

-- | why a name cannot be renamed to another, if it cannot: a primitive is
-- | the runtime's; a name stays the kind it is (a variable, a capitalised
-- | name, an operator), and is not qualified
renameRefused : Target -> String -> String -> Maybe String
renameRefused t old new =
  if eqMaybeStr t.member Nothing
     && eqMaybeSpan t.local Nothing
     && not (contains "." t.key)
  then Just ("`" ^ old ^ "` is a primitive: its name is the runtime's")
  else if nameClass old /= nameClass new
  then Just ("`" ^ new ^ "` is not a name of the kind `" ^ old ^ "` is")
  else Nothing

-- Documentation
--------------------------------------------------------------------------------

-- | the lines of the comment right above the line that starts at
-- | `start`, up to a line that is none (a blank one), each trimmed, in
-- | order
commentAbove : String -> Int -> List String -> List String
commentAbove src start acc =
  if start <= 0 then acc
  else if startsWith
            "--"
            (trim (strSlice src (lineStartOf src (start - 1)) (start - 1)))
  then commentAbove
      src
      (lineStartOf src (start - 1))
      (Cons
         (trim (strSlice src (lineStartOf src (start - 1)) (start - 1)))
         acc)
  else acc

-- (a line of a doc comment, `-- | text`: its text)
docLine : String -> Maybe String
docLine l =
  if startsWith "-- | " l then Just (strSlice l 5 (strLength l))
  else if strEq l "-- |" then Just ""
  else Nothing

-- | the doc comment of the definition whose first line starts at
-- | `start`: its lines' text, its doc tests (`>>> e`) among them
docLines : String -> Int -> List String
docLines src start = catMaybesQ (List.map docLine (commentAbove src start Nil))

-- (laying a doc comment out as Markdown: the lines so far, last first;
-- whether in an example, and in its expectation)
type DocMd = { out : List String, code : Bool, expecting : Bool }

mkDocMd : List String -> Bool -> Bool -> DocMd
mkDocMd out code expecting = { out = out, code = code, expecting = expecting }

-- (the code block, if one is open, closed)
closeCode : DocMd -> List String
closeCode m = if m.code then Cons "```" m.out else m.out

docMdStep : String -> DocMd -> String -> DocMd
docMdStep lang m l =
  if startsWith ">>>" l
  then mkDocMd
      (Cons l (if m.code then m.out else Cons ("```" ^ lang) m.out))
      True
      True
  else if m.code && m.expecting && not (strEq (trim l) "")
  then mkDocMd (Cons l m.out) True True
  else mkDocMd (Cons l (closeCode m)) False False

-- | a doc comment as Markdown: its text as it is, its doc tests, each
-- | with its expectation under it, a code block of the language `lang`
docMarkdownIn : String -> List String -> String
docMarkdownIn lang ls =
  joinWith
    "\n"
    (List.reverse
       (closeCode (List.foldl (docMdStep lang) (mkDocMd Nil False False) ls)))

-- | a doc comment as Markdown, its doc tests as heff
docMarkdown : List String -> String
docMarkdown ls = docMarkdownIn "heff" ls

-- | the documentation of the global the name at an offset resolved to,
-- | in a program (the file last): the doc comment above its definition,
-- | as Markdown ("" where there is none)
docAt : List Driver.Checked -> Int -> String
docAt program off = case definitionAt program off of
  Just d -> docMarkdown (docLines d.source (lineStartOf d.source d.span.start))
  Nothing -> ""

-- Symbols
--------------------------------------------------------------------------------

type Child = { name : String, kind : Int, span : Params.Span }

-- | a file's definitions, for an outline: each with where it is, where
-- | its name is, and its tags or fields, or its local definitions (the
-- | kinds are the Language Server Protocol's: enum, interface, function,
-- | operator; enum member, field)
type DocSymbol =
  { name : String
  , kind : Int
  , span : Params.Span
  , selection : Params.Span
  , children : List Child
  }

kindOf : String -> String -> Int
kindOf x text =
  if strEq (strSlice text 0 5) "data " then 10
  else if strEq (strSlice text 0 7) "theory " then 11
  else if not (isNameChar (byteAt x 0)) then 25
  else 12

-- (one that did not elaborate, not even its type: still where it is)
brokenSymbol : Driver.Checked -> Pair String Params.Span -> DocSymbol
brokenSymbol c (MkPair x sp) =
  { name = x
  , kind = kindOf x (strSlice c.source sp.start sp.end)
  , span = sp
  , selection = nameIn c.source x sp
  , children = Nil
  }

isMember : Site -> Bool
isMember { target = { member = Just _ } } = True
isMember { target = { member = Nothing } } = False

childOf : Bool -> Site -> Child
childOf isData m =
  { name = m.name, kind = if isData then 22 else 8, span = m.span }

-- | a local definition (`where`), as a child of what it is in
localChild : Presyntax.Decl -> List Child
localChild (At (DeclEquations f fsp _ _ _) _) =
  [{ name = f, kind = 12, span = fsp }]
localChild _ = Nil

-- | what a walk for local definitions looks in: the expressions in an
-- | expression, in a declaration, in the order they are written
type Children =
  { e : Presyntax.Expr -> List Child, decl : Presyntax.Decl -> List Child }

paramChildren : Children
              -> Params.Spanned (Presyntax.Param Presyntax.Expr)
              -> List Child
paramChildren r (At (ExplicitParam _ _ t) _) = r.e t
paramChildren r (At (ImplicitParam _ _ t) _) = r.e t

equationChildren : Children
                 -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
                 -> List Child
equationChildren r (At (MkEquation _ _ _ rhs) _) = r.e rhs

localDeclF : Children -> Presyntax.Decl -> List Child
localDeclF r (At (DeclEquations _ _ _ ty eqs) _) =
  List.append (r.e ty) (List.concatMap (\eq -> equationChildren r eq) eqs)
localDeclF r (At (DeclDefine _ _ ps u body) _) =
  List.append
    (List.concatMap (\m -> paramChildren r m) ps)
    (List.append (r.e u) (r.e body))
localDeclF r (At (DeclTheory _ _ ps body) _) =
  List.append (List.concatMap (\m -> paramChildren r m) ps) (r.e body)
localDeclF r (At (DeclPrimitive _ _ t) _) = r.e t
localDeclF r (At (DeclTest _ _) _) = Nil
localDeclF r (At (DeclWatch e) _) = r.e e

-- | the local definitions in a declaration, those in them too
piChildren : Children
           -> Presyntax.PiBinder Presyntax.Expr Presyntax.Expr
           -> List Child
piChildren r (PiNamed _ _ t) = r.e t
piChildren r (PiImplicit _ _ _ t d) = List.append (r.e t) (maybe Nil r.e d)
piChildren r (PiInstance _ _ _ t) = r.e t
piChildren r (PiAnon t) = r.e t

lamChildren : Children -> Presyntax.LamBinder Presyntax.Expr -> List Child
lamChildren r (LamAnn _ _ t) = r.e t
lamChildren r _ = Nil

fieldDeclChildren : Children
                  -> Params.Spanned
                    (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr)
                  -> List Child
fieldDeclChildren r (At (DeclareField _ _ t d) _) =
  List.append (r.e t) (maybe Nil r.e d)
fieldDeclChildren r (At (BadFieldDecl e) _) = r.e e

variantChildren : Children
                -> Params.Spanned (Presyntax.Variant Presyntax.Expr)
                -> List Child
variantChildren r (At (TagVariant _ _ args) _) = List.concatMap r.e args
variantChildren r (At (BadVariant e) _) = r.e e

fieldSetChildren : Children
                 -> Params.Spanned (Presyntax.FieldSet Presyntax.Expr)
                 -> List Child
fieldSetChildren r (At (SetField _ _ e) _) = r.e e
fieldSetChildren r (At (BadFieldSet e) _) = r.e e

altChildren : Children
            -> Params.Spanned (Presyntax.Alt Presyntax.Expr)
            -> List Child
altChildren r (At (MkAlt _ e) _) = r.e e

stmtChildren : Children
             -> Params.Spanned (Presyntax.Stmt Presyntax.Expr)
             -> List Child
stmtChildren r (At (StmtBind _ _ e) _) = r.e e
stmtChildren r (At (StmtLet _ e) _) = r.e e
stmtChildren r (At (StmtExpr e) _) = r.e e
stmtChildren r (At (StmtLetMut _ _ e) _) = r.e e
stmtChildren r (At (StmtLetElse _ e ss) _) =
  List.append (r.e e) (List.concatMap (\m -> stmtChildren r m) ss)

catchChildren : Children
              -> Presyntax.CatchArm Presyntax.Expr
              -> List Child
catchChildren r (MkCatchArm b ss) =
  List.append (lamChildren r b) (List.concatMap (\m -> stmtChildren r m) ss)

localTermF : Children -> Presyntax.Expr -> List Child
localTermF r (At (ELocal b defs) _) =
  List.append
    (List.concatMap (\m -> localChild m) defs)
    (List.append (r.e b) (List.concatMap r.decl defs))
localTermF r (At (EApp h args) _) =
  List.append (r.e h) (List.concatMap r.e args)
localTermF r (At (ENamed _ e) _) = r.e e
localTermF r (At (EPi b cod) _) = List.append (piChildren r b) (r.e cod)
localTermF r (At (ELam b body) _) = List.append (lamChildren r b) (r.e body)
localTermF r (At (EAnn e t) _) = List.append (r.e e) (r.e t)
localTermF r (At (ESpec acc _ _ v) _) = List.append (r.e acc) (r.e v)
localTermF r (At (ESig fs) _) = List.concatMap (\f -> fieldDeclChildren r f) fs
localTermF r (At (ESum vs) _) = List.concatMap (\v -> variantChildren r v) vs
localTermF r (At (EStruct fs) _) =
  List.concatMap (\f -> fieldSetChildren r f) fs
localTermF r (At (EUpdate a fs) _) =
  List.append
    (r.e a)
    (List.concatMap
       (\f -> case f of
        At (SetPath _ e) _ -> r.e e)
       fs)
localTermF r (At (EMatch s alts) _) =
  List.append (r.e s) (List.concatMap (\a -> altChildren r a) alts)
localTermF r (At (ELetIn rhs (At (MkAlt _ e) _)) _) =
  List.append (r.e rhs) (r.e e)
localTermF r (At (EDo stmts) _) = List.concatMap (\m -> stmtChildren r m) stmts
localTermF r (At (EAssign _ _ e) _) = r.e e
localTermF r (At (EWhile c body) _) =
  List.append (r.e c) (List.concatMap (\m -> stmtChildren r m) body)
localTermF r (At (EFor _ c body) _) =
  List.append (r.e c) (List.concatMap (\m -> stmtChildren r m) body)
localTermF r (At (EIfThen c a) _) = List.append (r.e c) (r.e a)
localTermF r (At (ETry (MkTry ty body c)) _) =
  List.append (List.concatMap (\m -> stmtChildren r m) body) (catchChildren r c)
localTermF r (At (EWith w _ _ body) _) =
  List.append (r.e w) (List.concatMap (\m -> stmtChildren r m) body)
localTermF r (At (EReturn e) _) = r.e e
localTermF r (At (ENest e) _) = r.e e
localTermF r (At (ELazy e) _) = r.e e
localTermF r (At (ETuple es) _) = List.concatMap r.e es
localTermF r _ = Nil

localWalk : Children
localWalk =
  { e = \n -> localTermF localWalk n, decl = \d -> localDeclF localWalk d }

symbolWith : Driver.Checked
           -> Driver.Own
           -> Params.Span
           -> List Site
           -> DocSymbol
symbolWith c o sp own =
  { name = o.name
  , kind = kindOf o.name (strSlice c.source sp.start sp.end)
  , span = sp
  , selection = case List.find (\(s : Site) -> not (isMember s)) own of
      Just s -> s.span
      Nothing -> nameIn c.source o.name sp
  , children =
      List.append
        (List.map
           (\m ->
              childOf
                (strEq (strSlice c.source sp.start (sp.start + 5)) "data ")
                m)
           (List.keepIf isMember own))
        (List.keepIf
           (\(m : Child) -> m.span.start >= sp.start && m.span.end <= sp.end)
           (List.concatMap localWalk.decl c.decls))
  }

symbolOf : Driver.Checked -> List Site -> Driver.Own -> Params.Span -> DocSymbol
symbolOf c ss o sp =
  symbolWith
    c
    o
    sp
    (List.keepIf
       (\(s : Site) -> s.span.start >= sp.start && s.span.end <= sp.end)
       ss)

symbolsGo : Driver.Checked
          -> List Site
          -> List Driver.Own
          -> List (Pair String Params.Span)
          -> List DocSymbol
symbolsGo c ss (Cons o os) (Cons (MkPair _ sp) sps) =
  Cons (symbolOf c ss o sp) (symbolsGo c ss os sps)
symbolsGo c ss _ _ = Nil

symbols : Driver.Checked -> List DocSymbol
symbols c =
  List.sortBy
    (\(a : DocSymbol) (b : DocSymbol) -> a.span.start <= b.span.start)
    (List.append
       (symbolsGo c (sites c) c.own c.top.spans)
       (List.map (\p -> brokenSymbol c p) c.top.broken))
