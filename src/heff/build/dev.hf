-- `heff dev`: the project built as `heff build` builds it, and its C
-- programs run -- then, at each change of its files (package.hf, src/,
-- app/), built again, and what runs started again.  heff is run as
-- `heff build` for each build, so that a build that fails says why and is
-- waited past, not the end of `heff dev`; the programs it builds run
-- beside it, their output the terminal's, each held by a `with`
-- (std.process's `withProcess`) until a build after a change has made
-- them anew.

module heff.build.dev

import co
import custodian as Custodian
import exception
import heff.build.commands as Commands
import heff.build.project as Project
import heff.build.watch as Watch
import heff.util.hostpath as HostPath
import std.filesystem
import heff.util.files as Files
import std.io
import std.path as Path
import std.process
import std.progress as Progress
import std.time as Time
import std.duration as Duration

-- Running
--------------------------------------------------------------------------------

-- | a program of the project's, running, held by a `with`: its name, and
-- | whether it has ended, asked of the `with`
type Running (e : HFunctor) = { name : String, ended : Co e (Maybe Ran) }

-- | where `heff dev` is: how many builds there have been, and the
-- | programs to run (all, where none is named)
type Dev = { builds : Int, wanted : List String }

-- | a build that went well: where `heff dev` is after it, the programs it
-- | is to run, and the project's files as stamped
type Built = { dev : Dev, apps : List Commands.App, stamp : String }

-- (the program, to be run: one of C's, among those wanted)
isRun : List String -> Commands.App -> Bool
isRun wanted a =
  strEq a.build.backend "c"
  && (List.null wanted || List.elem a.name wanted)

-- (the command, to be started beside `heff dev`: its standard streams
-- `heff dev`'s)
beside : String -> List String -> Invocation
beside cmd argv =
  { command = cmd
  , args = argv
  , input = Inherited
  , output = Inherited
  , errors = Inherited
  }

-- (the programs, read from their build.hf: none where one cannot be)
appsNow : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Co e (List Commands.App)
appsNow st = do
  found <- Files.readDirectory "app"
  rd <-
    Progress.start
      Progress.root
      "reading the programs' build.hf"
      (List.length (fromMaybe Nil found))
  read <-
    Commands.appsIn
      st
      (Commands.buildTarget st ".")
      rd
      { apps = Nil, bad = 0 }
      (fromMaybe Nil found)
  Progress.end rd
  pure (if read.bad > 0 then Nil else read.apps)

-- (what a build said, where it failed: its output, then why it is
-- waited past)
failedSaid : {e : HFunctor} -> {{io : stdio <: e}} -> Ran -> Co e Unit
failedSaid r = do
  write r.out
  writeErr r.err
  printErr "heff dev: not built; built again at the next change"

-- (the names of the programs, said)
namesSaid : List Commands.App -> String
namesSaid [] = "nothing to run"
namesSaid argv = joinWith ", " (List.map (\(a : Commands.App) -> a.name) argv)

-- | the project built, as `heff build` builds it (heff run so, its
-- | output kept: said where it fails): the programs, where it went well
rebuilt : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Co e (Maybe (List Commands.App))
rebuilt st = do
  self <- Commands.selfPath
  task <- Progress.start Progress.root "building" 0
  r <- Progress.runUnder task self ["build"]
  Progress.end task
  if succeeded r
  then do
    apps <- appsNow st
    pure (Just apps)
  else do
    failedSaid r
    pure Nothing

-- (how a program ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "status " ^ debug n
endedSaid (Signalled n) = "signal " ^ debug n
endedSaid TimedOut = "timed out"
endedSaid (NotRun err) = "not run: " ^ show err

-- (the programs that have ended by themselves said, and no more asked)
stillRunning : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> List (Running e)
             -> List (Running e)
             -> Co e (List (Running e))
stillRunning acc [] = pure acc
stillRunning acc (r :: rest) = do
  s <- r.ended
  case s of
    Nothing -> stillRunning (List.append acc [r]) rest
    Just ran -> do
      printErr ("heff dev: " ^ r.name ^ " ended (" ^ endedSaid ran.ended ^ ")")
      stillRunning acc rest

-- (the project's files watched, every quarter of a second, the programs
-- running looked at meanwhile; at a change, built again -- a build that
-- fails said and waited past -- until a build goes well: what came of
-- it, the build counted)
watched : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{clock : Time.time <: e}}
        -> Path.Style
        -> Dev
        -> String
        -> List (Running e)
        -> Co e Built
watched st d stamp running = do
  Time.sleep (Duration.milliseconds 250)
  still <- stillRunning Nil running
  again <- Watch.stamped st Watch.project
  if strEq again stamp then watched st d stamp still
  else do
    apps <- rebuilt st
    case apps of
      Nothing -> watched st d again still
      Just argv ->
        pure
          { dev = { d | builds = d.builds + 1 }, apps = argv, stamp = again }

-- (the programs started, from where `heff build` put them, each held by
-- a `with` -- one that cannot be run said, and left out -- and the
-- project watched inside them all; when a build goes well, what came of
-- it: the `with`s end, the programs with them)
held : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{prog : Progress.progress <: e}}
     -> {{clock : Time.time <: e}}
     -> {{ex : exception ProcessError <: e}}
     -> {{cu : Custodian.custodian <: e}}
     -> Path.Style
     -> Dev
     -> String
     -> List (Running e)
     -> List Commands.App
     -> Co e Built
held st d stamp running [] = watched st d stamp running
held st d stamp running (a :: rest) = do
  try
    let program =
      HostPath.join st (Commands.binDir st) (Commands.programFile st a.name)
    with withProcess (beside program Nil) as p do
      held
          st
          d
          stamp
          (List.append running [{ name = a.name, ended = tryWait p }])
          rest
  catch (err : ProcessError) ->
    printErr ("heff dev: cannot run " ^ show err)
    held st d stamp running rest

-- (a build that went well, said: what is run)
builtSaid : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Dev
          -> List Commands.App
          -> Co e Unit
builtSaid d apps =
  printErr
    ("heff dev: built ("
     ^ debug d.builds
     ^ "); running "
     ^ namesSaid (List.keepIf (isRun d.wanted) apps))

-- | from a build that went well on: the build said, its programs run,
-- | held by `with`s, until the next build that goes well; then that
-- | one's, and so on -- until the program is ended
cycle : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{prog : Progress.progress <: e}}
      -> {{clock : Time.time <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> {{cu : Custodian.custodian <: e}}
      -> Path.Style
      -> Dev
      -> String
      -> List Commands.App
      -> Co e Unit
cycle st d stamp apps = do
  builtSaid d apps
  next <- held st d stamp Nil (List.keepIf (isRun d.wanted) apps)
  cycle st next.dev next.stamp next.apps

-- | `heff dev [APP...]`, at the project's root
devCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> {{clock : Time.time <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> {{cu : Custodian.custodian <: e}}
       -> List String
       -> Co e Unit
devCmd wanted = do
  text <- Files.readFile "package.hf"
  st <- Commands.styleNow
  case text of
    Nothing -> do
      printErr "heff dev: no package.hf here: run it at the project's root"
      exit 1
    Just _ -> do
      stamp <- Watch.stamped st Watch.project
      let d : Dev = { builds = 0, wanted = wanted }
      first <- rebuilt st
      case first of
        Just apps -> cycle st { d | builds = 1 } stamp apps
        Nothing -> do
          next <- watched st d stamp Nil
          cycle st next.dev next.stamp next.apps
