-- `heff dev`: the project built as `heff build` builds it, its C
-- programs run, and its pages' scripts served -- then, at each change of
-- its files (package.hf, src/, app/), built again, and what runs started
-- again.  heff is run as `heff build` for each build, so that a build
-- that fails says why and is waited past, not the end of `heff dev`; the
-- programs it builds run beside it, their output the terminal's, each
-- held by a `with` (std.process's `withProcess`) until a build after a
-- change has made them anew.  A page
-- is served by `heff dev-pages`, beside it too (std.http.server, by
-- green threads): `/NAME/` the program NAME's page -- its
-- app/NAME/index.html, or one made for it -- `/NAME/NAME.js` its script
-- as built, and the rest of app/NAME/ as it is; a page asks every half
-- second whether it has been built again (`/.heff/built`), and loads
-- itself again where it has.

module heff.build.dev

import bytes as Bytes
import co
import exception
import green
import heff.build.commands as Commands
import heff.build.project as Project
import heff.build.watch as Watch
import heff.util.hostpath as HostPath
import std.filesystem
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.path as Path
import std.process
import std.progress as Progress
import rune as Rune
import std.reactor as Reactor
import std.time as Time

-- Running
--------------------------------------------------------------------------------

-- | a program of the project's, running, held by a `with`: its name, and
-- | whether it has ended, asked of the `with`
type Running (e : HFunctor) = { name : String, ended : Co e (Maybe Ran) }

-- | where `heff dev` is: how many builds there have been, the programs
-- | to run (all, where none is named), the port the pages are served
-- | at, where what is not theirs is sent (`--proxy`), and whether the
-- | pages' server runs (once there are pages, to the end)
type Dev =
  { builds : Int
  , wanted : List String
  , port : String
  , proxy : Maybe String
  , pages : Bool
  }

-- | a build that went well: where `heff dev` is after it, the programs it
-- | is to run, and the project's files as stamped
type Built = { dev : Dev, apps : List Commands.App, stamp : String }

-- | where a build that went well is said to have been made, for the
-- | pages to see: `.heff/dev/built`, the number of the build
builtFile : Path.Style -> String
builtFile st = HostPath.join st (HostPath.join st ".heff" "dev") "built"

-- (the program, to be run: one of C's, among those wanted)
isRun : List String -> Commands.App -> Bool
isRun wanted a =
  strEq a.build.backend "c"
  && (List.null wanted || List.elemBy strEq a.name wanted)

-- (a page's program)
isPage : Commands.App -> Bool
isPage a = strEq a.build.backend "page"

-- (the command, to be started beside `heff dev`: its standard streams
-- `heff dev`'s)
beside : String -> List String -> Invocation
beside cmd argv =
  { command = cmd
  , args = argv
  , input = Inherited
  , output = Inherited
  , errors = Inherited
  }

-- (the programs, read from their build.hf: none where one cannot be)
appsNow : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Co e (List Commands.App)
appsNow st = do
  found <- readDirectory "app"
  rd <-
    Progress.start
      Progress.root
      "reading the programs' build.hf"
      (List.length (fromMaybe Nil found))
  read <-
    Commands.appsIn
      st
      (Commands.buildTarget st ".")
      rd
      { apps = Nil, bad = 0 }
      (fromMaybe Nil found)
  Progress.end rd
  pure (if read.bad > 0 then Nil else read.apps)

-- (what a build said, where it failed: its output, then why it is
-- waited past)
failedSaid : {e : HFunctor} -> {{io : stdio <: e}} -> Ran -> Co e Unit
failedSaid r = do
  write r.out
  writeErr r.err
  printErr "heff dev: not built; built again at the next change"

-- (the names of the programs, said)
namesSaid : List Commands.App -> String
namesSaid Nil = "nothing to run"
namesSaid argv = joinWith ", " (List.map (\(a : Commands.App) -> a.name) argv)

-- | the project built, as `heff build` builds it (heff run so, its
-- | output kept: said where it fails): the programs, where it went well
rebuilt : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> Path.Style
        -> Co e (Maybe (List Commands.App))
rebuilt st = do
  self <- Commands.selfPath
  task <- Progress.start Progress.root "building" 0
  r <- Progress.runUnder task self ["build"]
  Progress.end task
  if succeeded r
    then do
      apps <- appsNow st
      pure (Just apps)
    else do
      failedSaid r
      pure Nothing

-- (how a program ended, said)
endedSaid : Ended -> String
endedSaid (Exited n) = "status " ^ show n
endedSaid (Signalled n) = "signal " ^ show n
endedSaid TimedOut = "timed out"
endedSaid NotRun = "not run"

-- (the programs that have ended by themselves said, and no more asked)
stillRunning : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> List (Running e)
             -> List (Running e)
             -> Co e (List (Running e))
stillRunning acc Nil = pure acc
stillRunning acc (r :: rest) = do
  s <- r.ended
  case s of
    Nothing -> stillRunning (List.append acc [r]) rest
    Just ran -> do
      printErr ("heff dev: " ^ r.name ^ " ended (" ^ endedSaid ran.ended ^ ")")
      stillRunning acc rest

-- (the project's files watched, every quarter of a second, the programs
-- running looked at meanwhile; at a change, built again -- a build that
-- fails said and waited past -- until a build goes well: what came of
-- it, the build counted)
watched : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{prog : Progress.progress <: e}}
        -> {{clock : Time.time <: e}}
        -> Path.Style
        -> Dev
        -> String
        -> List (Running e)
        -> Co e Built
watched st d stamp running = do
  Time.sleep 250
  still <- stillRunning Nil running
  again <- Watch.stamped st Watch.project
  if strEq again stamp then watched st d stamp still
    else do
      apps <- rebuilt st
      case apps of
        Nothing -> watched st d again still
        Just argv ->
          pure
            { dev = { d | builds = d.builds + 1 }, apps = argv, stamp = again }

-- (the programs started, from where `heff build` put them, each held by
-- a `with` -- one that cannot be run said, and left out -- and the
-- project watched inside them all; when a build goes well, what came of
-- it: the `with`s end, the programs with them)
held : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : filesystem <: e}}
     -> {{prog : Progress.progress <: e}}
     -> {{clock : Time.time <: e}}
     -> {{ex : exception ProcessError <: e}}
     -> Path.Style
     -> Dev
     -> String
     -> List (Running e)
     -> List Commands.App
     -> Co e Built
held st d stamp running Nil = watched st d stamp running
held st d stamp running (a :: rest) = do
  try
    let program =
      HostPath.join st (Commands.binDir st) (Commands.programFile st a.name)
    with withProcess (beside program Nil) as p do
      held
          st
          d
          stamp
          (List.append running [{ name = a.name, ended = tryWait p }])
          rest
  catch (err : ProcessError) ->
    printErr ("heff dev: cannot run " ^ a.name)
    held st d stamp running rest

-- (a build that went well, said: where it is said to have been made, for
-- the pages, and what is run)
builtSaid : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{disk : filesystem <: e}}
          -> Path.Style
          -> Dev
          -> List Commands.App
          -> Co e Unit
builtSaid st d apps = do
  _ <- makeDirectory (HostPath.join st ".heff" "dev")
  _ <- writeFile (builtFile st) (show d.builds)
  printErr
      ("heff dev: built ("
       ^ show d.builds
       ^ "); running "
       ^ namesSaid (List.filter (isRun d.wanted) apps))

-- (the pages' server, to be started beside `heff dev`)
pagesServer : String -> Dev -> Invocation
pagesServer self d =
  beside self ("dev-pages" :: d.port :: maybe Nil (\u -> [u]) d.proxy)

-- | from a build that went well on: the pages' server started, held by a
-- | `with` to the end, once there are pages; the build said, its programs
-- | run, held by `with`s, until the next build that goes well; then that
-- | one's, and so on -- until the program is ended
cycle : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : filesystem <: e}}
      -> {{prog : Progress.progress <: e}}
      -> {{clock : Time.time <: e}}
      -> {{ex : exception ProcessError <: e}}
      -> Path.Style
      -> Dev
      -> String
      -> List Commands.App
      -> Co e Unit
cycle st d stamp apps =
  if List.any isPage apps && not d.pages
  then do
    self <- Commands.selfPath
    try
      with withProcess (pagesServer self d) as pg do
        cycle st { d | pages = True } stamp apps
    catch (err : ProcessError) ->
      printErr "heff dev: cannot serve the pages"
      cycle st { d | pages = True } stamp apps
  else do
    builtSaid st d apps
    next <- held st d stamp Nil (List.filter (isRun d.wanted) apps)
    cycle st next.dev next.stamp next.apps

-- | `heff dev [APP...] [--port N] [--proxy URL]`, at the project's root
devCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : filesystem <: e}}
       -> {{prog : Progress.progress <: e}}
       -> {{clock : Time.time <: e}}
       -> {{ex : exception ProcessError <: e}}
       -> List String
       -> Maybe String
       -> Maybe String
       -> Co e Unit
devCmd wanted port proxy = do
  text <- readFile "package.hf"
  st <- Commands.styleNow
  case text of
    Nothing -> do
      printErr "heff dev: no package.hf here: run it at the project's root"
      exit 1
    Just _ -> do
      stamp <- Watch.stamped st Watch.project
      let d : Dev =
        { builds = 0
        , wanted = wanted
        , port = fromMaybe "8000" port
        , proxy = proxy
        , pages = False
        }
      first <- rebuilt st
      case first of
        Just apps -> cycle st { d | builds = 1 } stamp apps
        Nothing -> do
          next <- watched st d stamp Nil
          cycle st next.dev next.stamp next.apps

-- The pages
--------------------------------------------------------------------------------

-- | what a page loads, to load itself again when the project is built
-- | again: it asks every half second
reloadScript : String
reloadScript =
  unlines
    [ "<script>"
    , "(function () {"
    , "  var seen = null;"
    , "  setInterval(function () {"
    , "    fetch(\"/.heff/built\", { cache: \"no-store\" })"
    , "      .then(function (r) { return r.text(); })"
    , "      .then(function (t) { if (seen === null) seen = t; else if (t !== seen) location.reload(); })"
    , "      .catch(function () {});"
    , "  }, 500);"
    , "})();"
    , "</script>"
    ]

-- | a page's HTML, the script that reloads it put before its `</body>`
-- | (at its end, where it has none)
-- | >>> withReload "<body>x</body>" == "<body>x" ^ reloadScript ^ "</body>"
-- | True
withReload : String -> String
withReload html = case indexOf "</body>" html of
  Just i -> strSlice html 0 i ^ reloadScript ^ strSlice html i (strLength html)
  Nothing -> html ^ reloadScript

-- | the page made for the program NAME, where it has no index.html: an
-- | element `#NAME` for it, and its script
madePage : String -> String
madePage name =
  unlines
    [ "<!doctype html>"
    , "<html lang=\"en\">"
    , "<head><meta charset=\"utf-8\"><title>" ^ name ^ "</title></head>"
    , "<body>"
    , "<div id=\"" ^ name ^ "\"></div>"
    , "<script src=\"" ^ name ^ ".js\"></script>"
    , "</body>"
    , "</html>"
    ]

-- | a file's type, by its extension
-- | >>> List.map typeOf ["a.html", "a.js", "a.css", "a.bin"]
-- | ["text/html; charset=utf-8", "text/javascript; charset=utf-8", "text/css; charset=utf-8", "application/octet-stream"]
typeOf : String -> String
typeOf p =
  if endsWith ".html" p then "text/html; charset=utf-8"
  else if endsWith ".js" p || endsWith ".mjs" p
  then "text/javascript; charset=utf-8"
  else if endsWith ".css" p then "text/css; charset=utf-8"
  else if endsWith ".json" p then "application/json"
  else if endsWith ".svg" p then "image/svg+xml"
  else if endsWith ".png" p then "image/png"
  else if endsWith ".jpg" p || endsWith ".jpeg" p then "image/jpeg"
  else if endsWith ".wasm" p then "application/wasm"
  else if endsWith ".txt" p then "text/plain; charset=utf-8"
  else "application/octet-stream"

-- (a response of the text, of the type, never kept by the browser)
fresh : Int -> String -> String -> HTTP.Response
fresh status kind text =
  { status = status
  , headers = [MkPair "Content-Type" kind, MkPair "Cache-Control" "no-store"]
  , body = Bytes.fromString text
  }

-- (a file's response, of its type, or 404)
fileAnswer : String -> Maybe String -> HTTP.Response
fileAnswer p (Just text) = fresh 200 (typeOf p) text
fileAnswer p Nothing = Server.plain 404 ("no " ^ p ^ "\n")

-- (a page's response: its HTML with the script that reloads it -- one
-- made for it, where it has none and its script is built; else 404)
pageAnswer : String -> Bool -> Maybe String -> HTTP.Response
pageAnswer name built (Just html) = fresh 200 (typeOf ".html") (withReload html)
pageAnswer name True Nothing =
  fresh 200 (typeOf ".html") (withReload (madePage name))
pageAnswer name False Nothing = Server.plain 404 ("no page " ^ name ^ "\n")

-- (the index: the pages built, each linked)
indexAnswer : Maybe (List String) -> HTTP.Response
indexAnswer found =
  fresh
    200
    (typeOf ".html")
    (unlines
       (List.append
          [ "<!doctype html>"
          , "<title>heff dev</title>"
          , "<h1>the pages</h1>"
          , "<ul>"
          ]
          (List.append
             (List.map
                (\js ->
                   "<li><a href=\"/"
                   ^ strSlice js 0 (strLength js - 3)
                   ^ "/\">"
                   ^ strSlice js 0 (strLength js - 3)
                   ^ "</a></li>")
                (List.filter
                   (\n ->
                      endsWith ".js" n && not (startsWith (prefix := ".") n))
                   (fromMaybe Nil found)))
             ["</ul>", reloadScript])))

-- (a request's path, its query left out)
pathOf : String -> String
pathOf target = case indexOf "?" target of
  Just i -> strSlice target 0 i
  Nothing -> target

-- (a path's parts, from its first `/` on)
partsOf : String -> List String
partsOf path = split "/" (strSlice path 1 (strLength path))

-- (a part that goes nowhere it should not: no `..`, nothing empty)
safePart : String -> Bool
safePart p = not (strEq p "..") && not (strEq p "") && not (strEq p ".")

-- | what is asked for, answered: the pages' server
answer : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> Path.Style
       -> List String
       -> Co e HTTP.Response
answer st (".heff" :: "built" :: Nil) = do
  n <- readFile (builtFile st)
  pure (fresh 200 (typeOf ".txt") (fromMaybe "0" n))
answer st ("" :: Nil) = do
  found <- readDirectory (Commands.binDir st)
  pure (indexAnswer found)
answer st (name :: Nil) =
  pure
    { status = 301
    , headers = [MkPair "Location" ("/" ^ name ^ "/")]
    , body = Bytes.fromString ""
    }
answer st (name :: "" :: Nil) = do
  html <- readFile (HostPath.join st (HostPath.join st "app" name) "index.html")
  built <- isFile (HostPath.join st (Commands.binDir st) (name ^ ".js"))
  pure (pageAnswer name built html)
answer st (name :: rest) =
  if not (List.all safePart (name :: rest))
  then pure (Server.plain 404 "no such file\n")
  else if strEq (joinWith "/" rest) (name ^ ".js")
  then do
    js <- readFile (HostPath.join st (Commands.binDir st) (name ^ ".js"))
    pure (fileAnswer (name ^ ".js") js)
  else do
    text <-
      readFile
        (List.foldl
           (\p x -> HostPath.join st p x)
           (HostPath.join st "app" name)
           rest)
    pure (fileAnswer (joinWith "/" rest) text)
answer st Nil = pure (Server.plain 404 "no such file\n")

-- (the first part of a path)
firstPart : List String -> String
firstPart (x :: _) = x
firstPart Nil = ""

-- (a path the pages' server answers itself, whatever is sent elsewhere)
ownPath : List String -> Bool
ownPath (".heff" :: "built" :: Nil) = True
ownPath ("" :: Nil) = True
ownPath ps = False

-- (a header's name, its case not minded)
lowered : String -> String
lowered s = ofRunes (List.map Rune.toLower (runes s))

-- | the headers passed on, from a client to where it is sent and back:
-- | not the connection's own, which each side writes for itself
-- | >>> passed [MkPair "Host" "x", MkPair "Content-Type" "a", MkPair "content-length" "3"]
-- | [MkPair "Content-Type" "a"]
passed : List (Pair String String) -> List (Pair String String)
passed hs =
  List.filter
    (\h ->
       not
         (List.elemBy
            strEq
            (lowered (fst h))
            [ "host"
            , "content-length"
            , "connection"
            , "transfer-encoding"
            , "keep-alive"
            ]))
    hs

-- (what came back from where a request was sent: passed on, or why
-- nothing came, 502)
relayed : String -> Either HTTP.HttpError HTTP.Response -> HTTP.Response
relayed to (Right res) = { res | headers = passed res.headers }
relayed to (Left err) =
  Server.plain
    502
    ("heff dev: nothing from " ^ to ^ ": " ^ HTTP.showError err ^ "\n")

-- | a request sent on to `to` (`http://127.0.0.1:8080`, say), as it came,
-- | and its response given back
forwarded : {e : HFunctor}
          -> {{web : HTTP.http <: e}}
          -> String
          -> Server.Request
          -> Co e HTTP.Response
forwarded to req = do
  r <-
    HTTP.send
      { url = to ^ req.target
      , method = req.method
      , headers = passed req.headers
      , body = req.body
      , follow = False
      }
  pure (relayed to r)

-- | a request to the pages' server: its own (the built count, the index,
-- | a program's page and files), or, where there is somewhere to send
-- | what is not, sent there
served : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{web : HTTP.http <: e}}
       -> Path.Style
       -> Maybe String
       -> Server.Request
       -> Co e HTTP.Response
served st Nothing req = answer st (partsOf (pathOf req.target))
served st (Just to) req = do
  mine <-
    isDirectory
      (HostPath.join st "app" (firstPart (partsOf (pathOf req.target))))
  if mine || ownPath (partsOf (pathOf req.target))
    then answer st (partsOf (pathOf req.target))
    else forwarded to req

-- (the pages no longer served: the program ended, or it could not
-- listen at the port -- said, and the program failed)
-- | the pages served at the port, as `heff dev` has them served, what is
-- | not theirs sent to `proxy` where it is given, until the program is
-- | ended (`heff dev-pages PORT [PROXY]`)
pagesCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : filesystem <: e}}
         -> {{nt : Net.net <: e}}
         -> {{rx : Reactor.reactor <: e}}
         -> {{web : HTTP.http <: e}}
         -> {{nx : exception Net.NetError <: e}}
         -> String
         -> Maybe String
         -> Co e Unit
pagesCmd port proxy = do
  st <- Commands.styleNow
  try
    with Net.withListener
           { host = "127.0.0.1", port = fromMaybe 8000 (parseInt port) }
           64 as listener do
      printErr
          ("heff dev: the pages at http://127.0.0.1:"
           ^ port
           ^ "/"
           ^ maybe "" (\to -> ", the rest sent to " ^ to) proxy)
      Reactor.scheduled
          e
          (Server.serveConcurrently
             (gr := \p -> InL p)
             (nt := \p -> InR (nt p))
             listener
             (served
                (disk := \p -> InR (disk p))
                (web := \p -> InR (web p))
                st
                proxy))
    pure MkUnit
  catch (err : Net.NetError) ->
    printErr
        ("heff dev: cannot serve the pages at port "
         ^ port
         ^ ": "
         ^ Net.showError err)
    exit 1
