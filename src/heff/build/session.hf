-- A program, elaborated through the cache: a module whose making is
-- unchanged is thawed from `.heff/<module>.hc` instead of elaborated
-- again; a fresh module that elaborated clean is frozen back
-- (`heff.build.cache`).  The file asked for -- the last source -- is
-- always elaborated: its watches and spans are wanted.  In any world
-- with the disk in it: the command line's, the language server's.

module heff.build.session

import co
import heff.build.cache as Cache
import heff.build.driver as Driver
import heff.build.load as Load
import std.ordmap as OrdMap
import std.filesystem
import heff.util.files as Files
import std.path as Path

type CacheAcc =
  { done : List Driver.Checked, hashes : OrdMap.OrdMap String String }

cacheDir : Load.Paths -> String
cacheDir ps = Load.under ps (Load.under ps ps.root ".heff") Cache.versionDir

cachePath : Load.Paths -> String -> String
cachePath ps m = Load.under ps (cacheDir ps) (m ^ ".hc")

thawTry : {e : HFunctor}
        -> {{ev : filesystem <: e}}
        -> Load.Paths
        -> Driver.Source
        -> CacheAcc
        -> Co e (Maybe Driver.Thawed)
thawTry ps s acc = do
  mtxt <- Files.readFile (cachePath ps s.module)
  pure (case mtxt of
    Just txt -> Cache.melt acc.hashes acc.done s txt
    Nothing -> Nothing)

-- (a module kept: its definitions' hashes those it was frozen with if
-- it was thawed, else computed)
cacheKeep : CacheAcc -> Maybe Driver.Thawed -> Driver.Checked -> CacheAcc
cacheKeep acc th c =
  { done = List.append acc.done (Cons c Nil)
  , hashes = case th of
      Just t -> Cache.thawedHashesInto acc.hashes t c
      Nothing -> Cache.defHashesInto acc.hashes c
  }

cacheStep : CacheAcc -> Driver.Source -> Maybe Driver.Thawed -> CacheAcc
cacheStep acc s th = cacheKeep acc th (Driver.elabNext acc.done s th)

-- | ... a module imported, made lean as soon as it is checked: the types
-- | of its names and its trace are asked of the file asked for alone, and
-- | kept they hold on to every environment they were found in
cacheStepLean : CacheAcc -> Driver.Source -> Maybe Driver.Thawed -> CacheAcc
cacheStepLean acc s th =
  cacheKeep acc th (Driver.lean (Driver.elabNext acc.done s th))

cachedGo : {e : HFunctor}
         -> {{ev : filesystem <: e}}
         -> Load.Paths
         -> List Driver.Source
         -> CacheAcc
         -> Co e CacheAcc
cachedGo ps Nil acc = pure acc
cachedGo ps (Cons s Nil) acc = pure (cacheStep acc s Nothing)
cachedGo ps (Cons s rest) acc = do
  th <- thawTry ps s acc
  cachedGo ps rest (cacheStepLean acc s th)

freezeOne : {e : HFunctor}
          -> {{ev : filesystem <: e}}
          -> Load.Paths
          -> CacheAcc
          -> Pair Driver.Source Driver.Checked
          -> Co e Unit
freezeOne ps acc (MkPair s c) =
  if c.cached || not (List.null c.diags) then pure MkUnit
  else case Cache.freeze acc.hashes acc.done s c of
    Just out -> do
      ok <- Files.writeFile (cachePath ps c.module) out
      pure MkUnit
    Nothing -> pure MkUnit

freezeAll : {e : HFunctor}
          -> {{ev : filesystem <: e}}
          -> Load.Paths
          -> CacheAcc
          -> List (Pair Driver.Source Driver.Checked)
          -> Co e Unit
freezeAll ps acc Nil = pure MkUnit
freezeAll ps acc (Cons p rest) = do
  freezeOne ps acc p
  freezeAll ps acc rest

zipSC : List Driver.Source
      -> List Driver.Checked
      -> List (Pair Driver.Source Driver.Checked)
zipSC (Cons s ss) (Cons c cs) = Cons (MkPair s c) (zipSC ss cs)
zipSC _ _ = Nil

-- | the program, each module elaborated or thawed, the fresh clean
-- | ones frozen back; with each definition's hash (heff.build.cache's:
-- | what it is made of and what it uses, transitively)
cachedAcc : {e : HFunctor}
          -> {{ev : filesystem <: e}}
          -> Load.Loaded
          -> Co e CacheAcc
cachedAcc l = do
  acc <- cachedGo l.paths l.sources { done = Nil, hashes = OrdMap.empty }
  ok <- Files.makeDirectory (cacheDir l.paths)
  freezeAll l.paths acc (zipSC l.sources acc.done)
  pure acc

-- | the program, each module elaborated or thawed, the fresh clean
-- | ones frozen back
cachedProgram : {e : HFunctor}
              -> {{ev : filesystem <: e}}
              -> Load.Loaded
              -> Co e (List Driver.Checked)
cachedProgram l = do
  acc <- cachedAcc l
  pure acc.done

-- | a module elaborated, kept to be used again: and the cache's text of
-- | it, which tells whether what it is made of is still what it was
type Kept = { checked : Driver.Checked, frozen : String }

-- | a program elaborated as `cachedWhere` does: its modules, and the
-- | modules elaborated in it that can be kept, by path
type Elaborated =
  { program : List Driver.Checked, kept : OrdMap.OrdMap String Kept }

-- (the program so far, and the modules elaborated anew in it)
type WhereAcc =
  { acc : CacheAcc, fresh : List (Pair Driver.Source Driver.Checked) }

whereAdded : WhereAcc -> Driver.Source -> Driver.Checked -> WhereAcc
whereAdded w s c =
  { acc = cacheKeep w.acc Nothing c, fresh = Cons (MkPair s c) w.fresh }

-- (a module elaborated anew, made lean)
whereFresh : WhereAcc -> Driver.Source -> WhereAcc
whereFresh w s =
  whereAdded w s (Driver.lean (Driver.elabNext w.acc.done s Nothing))

-- (a module the cache had, or kept, as it was)
whereKept : WhereAcc -> Driver.Thawed -> Driver.Checked -> WhereAcc
whereKept w th c = { acc = cacheKeep w.acc (Just th) c, fresh = w.fresh }

-- (a module `full` takes: the one kept, if its text and what it is made
-- of are as they were, else elaborated anew)
whereFull : OrdMap.OrdMap String Kept -> WhereAcc -> Driver.Source -> WhereAcc
whereFull kept w s = case OrdMap.lookup kept s.path of
  Just k ->
    if strEq k.checked.source s.source
    then case Cache.melt w.acc.hashes w.acc.done s k.frozen of
      Just th -> whereKept w th k.checked
      Nothing -> whereFresh w s
    else whereFresh w s
  Nothing -> whereFresh w s

-- (a module `full` does not take: thawed from the cache, if it can be)
whereThawed : WhereAcc -> Driver.Source -> Maybe Driver.Thawed -> WhereAcc
whereThawed w s (Just th) =
  whereKept w th (Driver.elabNext w.acc.done s (Just th))
whereThawed w s Nothing = whereFresh w s

cachedWhereGo : {e : HFunctor}
              -> {{ev : filesystem <: e}}
              -> (Driver.Source -> Bool)
              -> OrdMap.OrdMap String Kept
              -> Load.Paths
              -> List Driver.Source
              -> WhereAcc
              -> Co e WhereAcc
cachedWhereGo full kept ps Nil w = pure w
cachedWhereGo full kept ps (Cons s rest) w =
  if full s then cachedWhereGo full kept ps rest (whereFull kept w s)
  else do
    th <- thawTry ps s w.acc
    cachedWhereGo full kept ps rest (whereThawed w s th)

-- (the modules elaborated anew, frozen: those `full` takes kept, the
-- others into the cache -- a text `full` takes may be one not on disk,
-- a renaming tried)
keepFresh : {e : HFunctor}
          -> {{ev : filesystem <: e}}
          -> (Driver.Source -> Bool)
          -> Load.Paths
          -> CacheAcc
          -> OrdMap.OrdMap String Kept
          -> List (Pair Driver.Source Driver.Checked)
          -> Co e (OrdMap.OrdMap String Kept)
keepFresh full ps acc kept Nil = pure kept
keepFresh full ps acc kept (Cons (MkPair s c) rest) =
  if not (List.null c.diags) then keepFresh full ps acc kept rest
  else case Cache.freeze acc.hashes acc.done s c of
    Just out ->
      if full s
      then keepFresh
          full
          ps
          acc
          (OrdMap.insert kept s.path { checked = c, frozen = out })
          rest
      else do
        ok <- Files.writeFile (cachePath ps c.module) out
        keepFresh full ps acc kept rest
    Nothing -> keepFresh full ps acc kept rest

-- | the program, the modules `full` takes elaborated (their names, and
-- | where each is written, wanted) -- or, where their text and what they
-- | are made of are as they were, those `kept` --, the others thawed
-- | from the cache where they can be; every module made lean.  Those
-- | elaborated anew are frozen: those `full` takes kept, the others back
-- | into the cache.
cachedWhere : {e : HFunctor}
            -> {{ev : filesystem <: e}}
            -> (Driver.Source -> Bool)
            -> OrdMap.OrdMap String Kept
            -> Load.Paths
            -> List Driver.Source
            -> Co e Elaborated
cachedWhere full kept ps sources = do
  w <-
    cachedWhereGo
      full
      kept
      ps
      sources
      { acc = { done = Nil, hashes = OrdMap.empty }, fresh = Nil }
  ok <- Files.makeDirectory (cacheDir ps)
  more <- keepFresh full ps w.acc kept (List.reverse w.fresh)
  pure { program = w.acc.done, kept = more }
