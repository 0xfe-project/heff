-- A-normal form: what a computation's parts compute is computed first,
-- each bound to a name, and the computation is given the names.  An
-- operand that computes -- a call, a primitive that may fail, a match,
-- a binding -- is bound by a `let` before what it is an operand of;
-- one that is a value (a name, a literal, a lambda, a tag or record of
-- names, a field of a name, a primitive that cannot fail given names)
-- stays where it is: computing it there or before is the same, as it
-- can neither fail nor do anything.  The operands are bound left to
-- right, as they were computed (the language is call by value), and
-- nothing is bound out of a lambda or an arm.
--
-- Two shapes a backend builds loops from stay as they are: a tag whose
-- last field is a call (built in place, the call filling the hole) and
-- a string append whose right is a call or such an append (gathered
-- left to right): the call's arguments are named, the call is not.

import heff.ir as I
import heff.simplify as Si
import prelude

-- | computations drawing fresh names
type N a = Int -> Pair a Int

bindTake : {a b : Type} -> (a -> N b) -> Pair a Int -> Pair b Int
bindTake f (MkPair x n) = f x n

-- `do` is this
bind : {a b : Type} -> N a -> (a -> N b) -> N b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> N a
pure x = \n -> MkPair x n

fresh : N String
fresh = \n -> MkPair ("t$" ++ showInt n) (n + 1)

traverseN : {a b : Type} -> (a -> N b) -> List a -> N (List b)
traverseN f Nil = pure Nil
traverseN f (Cons x xs) = do
  y <- f x
  ys <- traverseN f xs
  pure (Cons y ys)

elemA : String -> List String -> Bool
elemA x Nil = False
elemA x (Cons y ys) = strEq x y || elemA x ys

allA : {a : Type} -> (a -> Bool) -> List a -> Bool
allA p Nil = True
allA p (Cons x xs) = p x && allA p xs

-- | a name or a literal
atom : I.Expr -> Bool
atom (EVar _) = True
atom (EGlobal _) = True
atom (EInt _) = True
atom (EFloat _) = True
atom (EStr _) = True
atom (EPrim _) = True
atom _ = False

-- | ... or a lambda
value : I.Expr -> Bool
value (ELam _ _) = True
value e = atom e

-- | an operand that may stay where it is
inPlace : I.Expr -> Bool
inPlace (ELam _ _) = True
inPlace (ETag _ as) = allA value as
inPlace (ERecord fs) = allA value (map snd fs)
inPlace (EProj e _) = atom e
inPlace (EPrimCall p as) = not (elemA p Si.failing) && allA atom as
inPlace e = atom e

-- | an operand, normal (by `go`), given to `k`: bound first unless it may
-- | stay; the bindings it made on the way bound before it
bindAs : I.Expr -> (I.Expr -> N I.Expr) -> N I.Expr
bindAs (ELet y c d) k = do
  r <- bindAs d k
  pure (ELet y c r)
bindAs e k =
  if inPlace e then k e
  else do
    t <- fresh
    body <- k (EVar t)
    pure (ELet t e body)

operandWith : (I.Expr -> N I.Expr) -> I.Expr -> (I.Expr -> N I.Expr) -> N I.Expr
operandWith go e k = do
  e' <- go e
  bindAs e' k

operandsWith : (I.Expr -> N I.Expr)
             -> List I.Expr
             -> (List I.Expr -> N I.Expr)
             -> N I.Expr
operandsWith go Nil k = k Nil
operandsWith go (Cons a rest) k =
  operandWith go a (\a' -> operandsWith go rest (\rest' -> k (Cons a' rest')))

-- (a binding of a binding: the inner first, names being unique)
flatLet : String -> I.Expr -> I.Expr -> I.Expr
flatLet x (ELet y c d) b = ELet y c (flatLet x d b)
flatLet x a b = ELet x a b

-- (a call left where it is: its arguments named)
callIn : (I.Expr -> N I.Expr) -> String -> List I.Expr -> (I.Expr -> N I.Expr) -> N I.Expr
callIn go g bs k = operandsWith go bs (\bs' -> k (ECall g bs'))

lastOf : List I.Expr -> Maybe I.Expr
lastOf Nil = Nothing
lastOf (Cons x Nil) = Just x
lastOf (Cons x xs) = lastOf xs

initOf : List I.Expr -> List I.Expr
initOf Nil = Nil
initOf (Cons x Nil) = Nil
initOf (Cons x xs) = Cons x (initOf xs)

-- | a tag: its last field, a call, left where it is
tagN : (I.Expr -> N I.Expr) -> String -> List I.Expr -> Maybe I.Expr -> N I.Expr
tagN go t as (Just (ECall g bs)) =
  operandsWith
    go
    (initOf as)
    (\ini -> callIn go g bs (\c -> pure (ETag t (concatList ini (Cons c Nil)))))
tagN go t as _ = operandsWith go as (\as' -> pure (ETag t as'))

-- | the right of a string append: a call, or another such append, left
-- | where it is
appendRight : (I.Expr -> N I.Expr) -> I.Expr -> (I.Expr -> N I.Expr) -> N I.Expr
appendRight go (ECall g bs) k = callIn go g bs k
appendRight go (EPrimCall p (Cons a (Cons b Nil))) k =
  if strEq p "strAppend"
    then operandWith
        go
        a
        (\a' -> appendRight go b (\b' -> k (EPrimCall p (Cons a' (Cons b' Nil)))))
  else operandWith go (EPrimCall p (Cons a (Cons b Nil))) k
appendRight go e k = operandWith go e k

primN : (I.Expr -> N I.Expr) -> String -> List I.Expr -> N I.Expr
primN go p (Cons a (Cons b Nil)) =
  if strEq p "strAppend"
    then operandWith
        go
        a
        (\a' -> appendRight go b (\b' -> pure (EPrimCall p (Cons a' (Cons b' Nil)))))
  else operandsWith go (Cons a (Cons b Nil)) (\as' -> pure (EPrimCall p as'))
primN go p as = operandsWith go as (\as' -> pure (EPrimCall p as'))

fieldN : (I.Expr -> N I.Expr) -> List (Pair String I.Expr) -> N I.Expr
fieldN go fs =
  operandsWith
    go
    (map snd fs)
    (\vs -> pure (ERecord (zipWith (\p v -> MkPair (fst p) v) fs vs)))

armN : (I.Expr -> N I.Expr) -> I.Arm -> N I.Arm
armN go (MkArm t vs b) = do
  b' <- go b
  pure (MkArm t vs b')

-- | an expression in A-normal form
norm : I.Expr -> N I.Expr
norm (ELam xs b) = do
  b' <- norm b
  pure (ELam xs b')
norm (EApp f as) =
  operandWith norm f (\f' -> operandsWith norm as (\as' -> pure (EApp f' as')))
norm (ECall g as) = operandsWith norm as (\as' -> pure (ECall g as'))
norm (EPrimCall p as) = primN norm p as
norm (ETag t as) = tagN norm t as (lastOf as)
norm (ERecord fs) = fieldN norm fs
norm (EProj e l) = operandWith norm e (\e' -> pure (EProj e' l))
norm (ELet x a b) = do
  a' <- norm a
  b' <- norm b
  pure (flatLet x a' b')
norm (EMatch s arms) =
  operandWith
    norm
    s
    (\s' -> do
     arms' <- traverseN (armN norm) arms
     pure (EMatch s' arms'))
norm e = pure e

defN : I.Def -> N I.Def
defN d = do
  b <- norm d.body
  pure (I.mkDef d.key d.name b)

-- | the definitions in A-normal form, names drawn from `supply` on
anfProgram : Int -> List I.Def -> List I.Def
anfProgram supply defs = fst (traverseN defN defs supply)

-- >>> anfProgram 0 [I.mkDef "f" "f" (ELam ["x"] (ECall "g" [ECall "h" [EVar "x"], EInt 1]))]
-- [I.mkDef "f" "f" (ELam ["x"] (ELet "t$0" (ECall "h" [EVar "x"]) (ECall "g" [EVar "t$0", EInt 1])))]

-- (a tag whose last field is a call: left where it is)
-- >>> anfProgram 0 [I.mkDef "f" "f" (ELam ["x"] (ETag "Cons" [EVar "x", ECall "f" [EVar "x"]]))]
-- [I.mkDef "f" "f" (ELam ["x"] (ETag "Cons" [EVar "x", ECall "f" [EVar "x"]]))]
