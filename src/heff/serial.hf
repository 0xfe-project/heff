-- Core syntax as text, for the cache (`heff.cache`): a stream of
-- tokens, every node a tag of fixed shape, counts before lists, and
-- strings length-prefixed (`3:abc`) so nothing is escaped.  `decode` is
-- the inverse of `encode`; what does not decode -- another compiler's
-- cache, a torn write -- is `Nothing`, and the cache treats it as
-- absent.

import array as A
import heff.dict as D
import heff.fixed
import heff.params as Pm
import heff.surface as Su
import heff.syntax as Sx

-- Writing: a list of tokens, joined with one space
--------------------------------------------------------------------------------

tokStr : String -> String
tokStr s = showInt (strLength s) ^ ":" ^ s

tokInt : Int -> String
tokInt i = showInt i

tokBool : Bool -> String
tokBool True = "t"
tokBool False = "f"

tokLevel : Pm.Level -> String
tokLevel Small = "0"
tokLevel Large = "1"
tokLevel TopL = "2"

tokPlicity : Pm.Plicity -> String
tokPlicity Expl = "0"
tokPlicity Impl = "1"
tokPlicity Inst = "2"

-- (every encoder takes the tokens that follow, and conses its own in
-- front: linear, however deep the term)
encodeAbs : {a : Type}
          -> (a -> List String -> List String)
          -> Sx.Abs a
          -> List String
          -> List String
encodeAbs f (MkAbs x e) rest = Cons "v" (Cons (tokStr x) (f e rest))
encodeAbs f (AbsConst e) rest = Cons "_" (f e rest)

encodeListGo : {a : Type}
             -> (a -> List String -> List String)
             -> List a
             -> List String
             -> List String
encodeListGo f Nil rest = rest
encodeListGo f (Cons x xs) rest = f x (encodeListGo f xs rest)

encodeMany : {a : Type}
           -> (a -> List String -> List String)
           -> List a
           -> List String
           -> List String
encodeMany f xs rest = Cons (tokInt (List.length xs)) (encodeListGo f xs rest)

encodeDict : {a : Type}
           -> (a -> List String -> List String)
           -> D.Dict a
           -> List String
           -> List String
encodeDict f d rest =
  encodeMany
    (\p rest2 -> case p of
     MkPair x v -> Cons (tokStr x) (f v rest2))
    (D.toList d)
    rest

-- | the encoders, knotted
type EK =
  { el : Sx.Tm -> List String -> List String
  , ty : Sx.Ty -> List String -> List String
  }

encodeAlt : EK -> Pair (Array String) Sx.Tm -> List String -> List String
encodeAlt k (MkPair xs b) rest =
  encodeMany (\x rest2 -> Cons (tokStr x) rest2) (A.toList xs) (k.el b rest)

encodeTermF : EK -> Sx.Tm -> List String -> List String
encodeTermF k e rest = case e of
  SLocal i -> Cons "loc" (Cons (tokInt i) rest)
  SGlobal x -> Cons "glo" (Cons (tokStr x) rest)
  SCode t -> Cons "cod" (k.ty t rest)
  SApp f a -> Cons "app" (k.el f (k.el a rest))
  SLam t b ->
    Cons "lam" (k.ty t (encodeAbs (\e2 rest2 -> k.el e2 rest2) b rest))
  SCons d -> Cons "con" (encodeDict (\e2 rest2 -> k.el e2 rest2) d rest)
  SProj e2 l -> Cons "prj" (k.el e2 (Cons (tokStr l) rest))
  STag t as ->
    Cons
      "tag"
      (Cons
         (tokStr t)
         (encodeMany (\a rest2 -> k.el a rest2) (A.toList as) rest))
  SMatch e2 cs ->
    Cons
      "mat"
      (k.el e2 (encodeDict (\alt rest2 -> encodeAlt k alt rest2) cs rest))
  SSpecialize e2 l v -> Cons "spe" (k.el e2 (Cons (tokStr l) (k.el v rest)))
  SIs e2 -> Cons "is" (k.el e2 rest)
  SOpaque -> Cons "opq" rest
  SAbandon -> Cons "abn" rest
  SRec e2 -> Cons "rec" (k.el e2 rest)
  SFix t b ->
    Cons "fix" (k.ty t (encodeAbs (\e2 rest2 -> k.el e2 rest2) b rest))
  SImplicit x e2 -> Cons "imp" (Cons (tokStr x) (k.el e2 rest))
  SPrim x -> Cons "prm" (Cons (tokStr x) rest)
  -- (zonked away before a definition is stored; decoding refuses it)
  SMetaApp _ _ _ -> Cons "meta" rest
  SLitInt i -> Cons "int" (Cons (tokStr (showInt i)) rest)
  SLitFloat x -> Cons "flt" (Cons (tokStr (showFloat x)) rest)
  SLitString s -> Cons "str" (Cons (tokStr s) rest)
  SLitRune c -> Cons "rn" (Cons (tokStr (showInt c)) rest)
  SLitFixed w n ->
    Cons "fxl" (Cons (fixedName w) (Cons (tokStr (showInt n)) rest))
  SLitFloat32 x -> Cons "f32" (Cons (tokStr (showFloat x)) rest)

-- (an implicit argument's default: `j` and it, or `n`, none)
encodeDefault : EK -> Maybe Sx.Tm -> List String -> List String
encodeDefault k (Just d) rest = Cons "j" (k.el d rest)
encodeDefault k Nothing rest = Cons "n" rest

encodeTypeF : EK -> Sx.Ty -> List String -> List String
encodeTypeF k t rest = case t of
  SU SmallU -> Cons "u" (Cons "0" rest)
  SU LargeU -> Cons "u" (Cons "1" rest)
  SDecode e -> Cons "de" (k.el e rest)
  SFunction level dom cod implicit dflt ->
    Cons
      "fn"
      (Cons
         (tokLevel level)
         (k.ty
            dom
            (encodeAbs
               (\t2 rest2 -> k.ty t2 rest2)
               cod
               (Cons (tokPlicity implicit) (encodeDefault k dflt rest)))))
  SRecord level fs ds ->
    Cons
      "rc"
      (Cons
         (tokLevel level)
         (encodeDict
            (\t2 rest2 -> k.ty t2 rest2)
            fs
            (encodeDict (\e2 rest2 -> k.el e2 rest2) ds rest)))
  SSum vs ->
    Cons
      "sm"
      (encodeDict
         (\ts rest2 ->
            encodeMany (\t2 rest3 -> k.ty t2 rest3) (A.toList ts) rest2)
         vs
         rest)
  SIsTy t2 -> Cons "ist" (k.ty t2 rest)
  SPrimInt -> Cons "pi" rest
  SPrimFloat -> Cons "pf" rest
  SPrimString -> Cons "ps" rest
  SPrimRune -> Cons "pr" rest
  SPrimArray t2 -> Cons "pa" (k.ty t2 rest)
  SFixed w -> Cons "px" (Cons (fixedName w) rest)

ek : EK
ek =
  { el = \e rest -> encodeTermF ek e rest
  , ty = \t rest -> encodeTypeF ek t rest
  }

encodeEl : Sx.Tm -> String
encodeEl e = joinWith " " (ek.el e Nil)

encodeTy : Sx.Ty -> String
encodeTy t = joinWith " " (ek.ty t Nil)

-- Reading: a cursor over the stream
--------------------------------------------------------------------------------

-- (a decoder: from a position, what it read and where it ended)
type Got a = Pair a Int

bindG : {a b : Type}
      -> Maybe (Got a)
      -> (a -> Int -> Maybe (Got b))
      -> Maybe (Got b)
bindG Nothing f = Nothing
bindG (Just (MkPair x i)) f = f x i

gotG : {a : Type} -> a -> Int -> Maybe (Got a)
gotG x i = Just (MkPair x i)

-- (after a token, one space is skipped, or the stream ends)
pastSep : String -> Int -> Int
pastSep s i = if i < strLength s && charCode s i == 32 then i + 1 else i

wordEnd : String -> Int -> Int
wordEnd s i =
  if i >= strLength s || charCode s i == 32 then i else wordEnd s (i + 1)

takeWord : String -> Int -> Maybe (Got String)
takeWord s i =
  if i >= strLength s then Nothing
  else gotG (strSlice s i (wordEnd s i)) (pastSep s (wordEnd s i))

colonAt : String -> Int -> Int
colonAt s i =
  if i >= strLength s || charCode s i == 58 then i else colonAt s (i + 1)

takeStrAt : String -> Int -> Int -> Maybe (Got String)
takeStrAt s j n =
  if j + n > strLength s then Nothing
  else gotG (strSlice s j (j + n)) (pastSep s (j + n))

-- (a length-prefixed string: nothing in it is looked at)
takeStr : String -> Int -> Maybe (Got String)
takeStr s i =
  if colonAt s i >= strLength s || colonAt s i == i then Nothing
  else takeStrAt s (colonAt s i + 1) (Su.intOfText (strSlice s i (colonAt s i)))

takeInt : String -> Int -> Maybe (Got Int)
takeInt s i = bindG (takeWord s i) (\w j -> gotG (Su.intOfText w) j)

-- (a fixed-width type, by its name)
takeFixed : String -> Int -> Maybe (Got Fixed)
takeFixed s i =
  bindG (takeWord s i) (\w j -> case fixedOfName w of
  Just f -> gotG f j
  Nothing -> Nothing)

takeBool : String -> Int -> Maybe (Got Bool)
takeBool s i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "t" then gotG True j
       else if strEq w "f" then gotG False j
       else Nothing)

takePlicity : String -> Int -> Maybe (Got Pm.Plicity)
takePlicity s i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "0" then gotG Expl j
       else if strEq w "1" then gotG Impl j
       else if strEq w "2" then gotG Inst j
       else Nothing)

takeLevel : String -> Int -> Maybe (Got Pm.Level)
takeLevel s i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "0" then gotG Small j
       else if strEq w "1" then gotG Large j
       else if strEq w "2" then gotG TopL j
       else Nothing)

-- | the decoders, knotted over the stream
type DK = { el : Int -> Maybe (Got Sx.Tm), ty : Int -> Maybe (Got Sx.Ty) }

takeAbs : {a : Type}
        -> String
        -> (Int -> Maybe (Got a))
        -> Int
        -> Maybe (Got (Sx.Abs a))
takeAbs s f i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "v"
         then bindG
             (takeStr s j)
             (\x j2 -> bindG (f j2) (\e j3 -> gotG (MkAbs x e) j3))
       else if strEq w "_" then bindG (f j) (\e j2 -> gotG (AbsConst e) j2)
       else Nothing)

takeManyG : {a : Type}
          -> (Int -> Maybe (Got a))
          -> Int
          -> Int
          -> Maybe (Got (List a))
takeManyG f n i =
  if n <= 0 then gotG Nil i
  else bindG
      (f i)
      (\x j -> bindG (takeManyG f (n - 1) j) (\xs j2 -> gotG (Cons x xs) j2))

takeMany : {a : Type}
         -> String
         -> (Int -> Maybe (Got a))
         -> Int
         -> Maybe (Got (List a))
takeMany s f i = bindG (takeInt s i) (\n j -> takeManyG f n j)

takePair : {a : Type}
         -> String
         -> (Int -> Maybe (Got a))
         -> Int
         -> Maybe (Got (Pair String a))
takePair s f i =
  bindG (takeStr s i) (\x j -> bindG (f j) (\v j2 -> gotG (MkPair x v) j2))

takeDict : {a : Type}
         -> String
         -> (Int -> Maybe (Got a))
         -> Int
         -> Maybe (Got (D.Dict a))
takeDict s f i =
  bindG (takeMany s (\j -> takePair s f j) i) (\ps j -> gotG (D.fromList ps) j)

takeAlt : String -> DK -> Int -> Maybe (Got (Pair (Array String) Sx.Tm))
takeAlt s k i =
  bindG
    (takeMany s (\j -> takeStr s j) i)
    (\xs j -> bindG (k.el j) (\b j2 -> gotG (MkPair (A.fromList xs) b) j2))

decodeTermF : DK -> String -> Int -> Maybe (Got Sx.Tm)
decodeTermF k s i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "loc" then bindG (takeInt s j) (\n j2 -> gotG (SLocal n) j2)
       else if strEq w "glo"
         then bindG (takeStr s j) (\x j2 -> gotG (SGlobal x) j2)
       else if strEq w "cod" then bindG (k.ty j) (\t j2 -> gotG (SCode t) j2)
       else if strEq w "app"
         then bindG
             (k.el j)
             (\f j2 -> bindG (k.el j2) (\a j3 -> gotG (SApp f a) j3))
       else if strEq w "lam"
         then bindG
             (k.ty j)
             (\t j2 ->
                bindG
                  (takeAbs s (\j3 -> k.el j3) j2)
                  (\b j3 -> gotG (SLam t b) j3))
       else if strEq w "con"
         then bindG (takeDict s (\j2 -> k.el j2) j) (\d j2 -> gotG (SCons d) j2)
       else if strEq w "prj"
         then bindG
             (k.el j)
             (\e j2 -> bindG (takeStr s j2) (\l j3 -> gotG (SProj e l) j3))
       else if strEq w "tag"
         then bindG
             (takeStr s j)
             (\t j2 ->
                bindG
                  (takeMany s (\j3 -> k.el j3) j2)
                  (\as j3 -> gotG (STag t (A.fromList as)) j3))
       else if strEq w "mat"
         then bindG
             (k.el j)
             (\e j2 ->
                bindG
                  (takeDict s (\j3 -> takeAlt s k j3) j2)
                  (\cs j3 -> gotG (SMatch e cs) j3))
       else if strEq w "spe"
         then bindG
             (k.el j)
             (\e j2 ->
                bindG
                  (takeStr s j2)
                  (\l j3 ->
                     bindG (k.el j3) (\v j4 -> gotG (SSpecialize e l v) j4)))
       else if strEq w "is" then bindG (k.el j) (\e j2 -> gotG (SIs e) j2)
       else if strEq w "opq" then gotG SOpaque j
       else if strEq w "abn" then gotG SAbandon j
       else if strEq w "rec" then bindG (k.el j) (\e j2 -> gotG (SRec e) j2)
       else if strEq w "fix"
         then bindG
             (k.ty j)
             (\t j2 ->
                bindG
                  (takeAbs s (\j3 -> k.el j3) j2)
                  (\b j3 -> gotG (SFix t b) j3))
       else if strEq w "imp"
         then bindG
             (takeStr s j)
             (\x j2 -> bindG (k.el j2) (\e j3 -> gotG (SImplicit x e) j3))
       else if strEq w "prm"
         then bindG (takeStr s j) (\x j2 -> gotG (SPrim x) j2)
       else if strEq w "int"
         then bindG (takeStr s j) (\x j2 -> gotG (SLitInt (Su.intOfText x)) j2)
       else if strEq w "flt"
         then bindG
             (takeStr s j)
             (\x j2 -> gotG (SLitFloat (Su.floatOfText x)) j2)
       else if strEq w "str"
         then bindG (takeStr s j) (\x j2 -> gotG (SLitString x) j2)
       else if strEq w "rn"
         then bindG (takeStr s j) (\x j2 -> gotG (SLitRune (Su.intOfText x)) j2)
       else if strEq w "fxl"
         then bindG
             (takeFixed s j)
             (\f j2 ->
                bindG
                  (takeStr s j2)
                  (\x j3 -> gotG (SLitFixed f (Su.intOfText x)) j3))
       else if strEq w "f32"
         then bindG
             (takeStr s j)
             (\x j2 -> gotG (SLitFloat32 (Su.floatOfText x)) j2)
       else Nothing)

-- (an implicit argument's default, if there is one)
takeDefault : String -> DK -> Int -> Maybe (Got (Maybe Sx.Tm))
takeDefault s k i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "j" then bindG (k.el j) (\d j2 -> gotG (Just d) j2)
       else if strEq w "n" then gotG Nothing j
       else Nothing)

decodeTypeF : DK -> String -> Int -> Maybe (Got Sx.Ty)
decodeTypeF k s i =
  bindG
    (takeWord s i)
    (\w j ->
       if strEq w "u"
         then bindG
             (takeWord s j)
             (\u j2 ->
                if strEq u "0" then gotG (SU SmallU) j2
                else if strEq u "1" then gotG (SU LargeU) j2
                else Nothing)
       else if strEq w "de" then bindG (k.el j) (\e j2 -> gotG (SDecode e) j2)
       else if strEq w "fn"
         then bindG
             (takeLevel s j)
             (\level j2 ->
                bindG
                  (k.ty j2)
                  (\dom j3 ->
                     bindG
                       (takeAbs s (\j4 -> k.ty j4) j3)
                       (\cod j4 ->
                          bindG
                            (takePlicity s j4)
                            (\implicit j5 ->
                               bindG
                                 (takeDefault s k j5)
                                 (\dflt j6 ->
                                    gotG
                                      (SFunction level dom cod implicit dflt)
                                      j6)))))
       else if strEq w "rc"
         then bindG
             (takeLevel s j)
             (\level j2 ->
                bindG
                  (takeDict s (\j3 -> k.ty j3) j2)
                  (\fs j3 ->
                     bindG
                       (takeDict s (\j4 -> k.el j4) j3)
                       (\ds j4 -> gotG (SRecord level fs ds) j4)))
       else if strEq w "sm"
         then bindG
             (takeDict
                s
                (\j2 ->
                   bindG
                     (takeMany s (\j3 -> k.ty j3) j2)
                     (\ts j3 -> gotG (A.fromList ts) j3))
                j)
             (\vs j2 -> gotG (SSum vs) j2)
       else if strEq w "ist" then bindG (k.ty j) (\t j2 -> gotG (SIsTy t) j2)
       else if strEq w "pi" then gotG SPrimInt j
       else if strEq w "pf" then gotG SPrimFloat j
       else if strEq w "ps" then gotG SPrimString j
       else if strEq w "pr" then gotG SPrimRune j
       else if strEq w "pa"
         then bindG (k.ty j) (\t j2 -> gotG (SPrimArray t) j2)
       else if strEq w "px"
         then bindG (takeFixed s j) (\f j2 -> gotG (SFixed f) j2)
       else Nothing)

dkOf : String -> DK
dkOf s =
  { el = \i -> decodeTermF (dkOf s) s i, ty = \i -> decodeTypeF (dkOf s) s i }

-- | a term, read whole (the stream must end with it)
decodeEl : String -> Maybe Sx.Tm
decodeEl s = case (dkOf s).el 0 of
  Just (MkPair e i) -> if i >= strLength s then Just e else Nothing
  Nothing -> Nothing

decodeTy : String -> Maybe Sx.Ty
decodeTy s = case (dkOf s).ty 0 of
  Just (MkPair t i) -> if i >= strLength s then Just t else Nothing
  Nothing -> Nothing

-- | decoders at a position inside a larger stream, for the cache's own
-- | fields
decodeElAt : String -> Int -> Maybe (Got Sx.Tm)
decodeElAt s i = (dkOf s).el i

decodeTyAt : String -> Int -> Maybe (Got Sx.Ty)
decodeTyAt s i = (dkOf s).ty i

