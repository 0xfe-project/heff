-- What `heff` does: the work of each of its commands (checking,
-- compiling, running, testing, formatting, publishing, fetching), each a
-- computation that asks for the effects it has, in any world they are
-- in (the program, app/heff/main.hf, gives them).  The command line is
-- not here: what reads it, and the world it runs in, are the program's,
-- so what is here may be used without either (#3).

import co
import heff.driver as Dr
import heff.effect as Ef
import heff.emit as Em
import heff.emitc as Ec
import heff.fixity as F
import heff.format as Fm
import heff.load as L
import heff.project as Pr
import heff.query as Q
import heff.render as Dg
import heff.report as Rp
import heff.session as Se
import std.filesystem
import std.io
import std.path as P
import std.process
import std.progress as Pg

-- | the style of the paths of the platform heff runs on
styleNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e P.Style
styleNow = do
  p <- platform
  pure (P.styleOf p)

-- | the directory the compiler at `self` came with: the repository it is
-- | built in (it is `.heff/out/heff` there), or a release or the heff
-- | home (`bin/heff`, what it ships beside `bin/`)
ownRoot : P.Style -> String -> String
ownRoot st self =
  if strEq (P.basename st (P.dirname st self)) "out"
  && strEq (P.basename st (P.dirname st (P.dirname st self))) ".heff"
    then P.dirname st (P.dirname st (P.dirname st self))
  else P.dirname st (P.dirname st self)

-- >>> ownRoot (P.styleOf "linux") "/r/.heff/out/heff"
-- "/r"

-- >>> ownRoot (P.styleOf "linux") "/opt/heff-0.2.0/bin/heff"
-- "/opt/heff-0.2.0"

-- | where the standard library is: `HEFF_LIB`, else the `lib/` the
-- | compiler came with
libDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
libDir = do
  v <- getEnv "HEFF_LIB"
  case v of
    Just lib -> pure lib
    Nothing -> do
      st <- styleNow
      self <- programPath
      pure (P.join st (ownRoot st self) "lib")

-- | where packages are fetched to: `HEFF_MODCACHE`, else
-- | `~/.cache/heff/mod`
modDir : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
modDir = do
  v <- getEnv "HEFF_MODCACHE"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      P.join
        st
        (P.join st (fromMaybe (fromMaybe "." profile) home) ".cache")
        (P.join st "heff" "mod"))

-- | where heff keeps what is the user's (`bin/`, the programs `heff
-- | install` installs, and beside it what they ship): `HEFF_HOME`, else
-- | `~/.heff`
heffHome : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
heffHome = do
  v <- getEnv "HEFF_HOME"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing -> P.join st (fromMaybe (fromMaybe "." profile) home) ".heff")

-- | the library, the packages fetched, the directory heff runs in, and
-- | the style of the platform's paths
hostNow : {e : HFunctor} -> {{sys : process <: e}} -> Co e L.Host
hostNow = do
  lib <- libDir
  mod <- modDir
  cwd <- workingDir
  st <- styleNow
  pure { lib = lib, mod = mod, cwd = cwd, style = st }

-- | the package.hf of the heff running, which says its version: in the
-- | directory it came with
ownPackage : {e : HFunctor} -> {{sys : process <: e}} -> Co e String
ownPackage = do
  st <- styleNow
  self <- programPath
  pure (P.join st (ownRoot st self) "package.hf")

-- | the version of heff running: the heff its own package.hf is for
ownVersion : {e : HFunctor}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> Co e (Maybe String)
ownVersion = do
  path <- ownPackage
  text <- readFile path
  pure (case text of
    Just src -> case Pr.readPackage src of
      Right p -> Just p.heff
      Left _ -> Nothing
    Nothing -> Nothing)

-- (what the package.hf at `path`, read, says of the heff running)
versionRead : String
            -> String
            -> Either Pr.Problem Pr.Package
            -> Either String String
versionRead path src (Right p) = Right ("heff " ^ p.heff)
versionRead path src (Left p) = Left ("not known: " ^ L.problemMsg path src p)

-- | what `heff version` says: the heff running and its version, from the
-- | text of its package.hf at `path`; or, without one that reads, why
-- | that is not known
versionSaid : String -> Maybe String -> Either String String
versionSaid path Nothing = Left ("not known: there is no " ^ path)
versionSaid path (Just src) = versionRead path src (Pr.readPackage src)

-- >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\", heff = \"0.3.0\" }")
-- Right "heff 0.3.0"

-- >>> versionSaid "/h/package.hf" Nothing
-- Left "not known: there is no /h/package.hf"

-- >>> versionSaid "/h/package.hf" (Just "package = { module = \"m\" }")
-- Left "not known: /h/package.hf:1:11: the fields are module, heff, require, replace, in this order (require and replace may be left out)"

-- | say which heff is running: its version, as its package.hf says
versionCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> Co e Unit
versionCmd = do
  path <- ownPackage
  text <- readFile path
  case versionSaid path text of
    Right line -> print line
    Left why -> do
      printErr ("heff version: " ^ why)
      exit 1

-- | what is wrong with the heff a project is for, if anything: this heff
-- | is `running`
-- | what is wrong with the heff `who` is for, `wanted`, if anything:
-- | this heff is `running`
heffVersions : String
             -> String
             -> String
             -> Maybe (List Int)
             -> Maybe (List Int)
             -> Maybe String
heffVersions who wanted running (Just w) (Just r) =
  if Pr.compatible w r then Nothing
  else Just
      (who
       ^ " is for heff "
       ^ wanted
       ^ (if strEq (strSlice wanted 0 2) "0." then " (the same 0.x)" else "")
       ^ ", and this heff is "
       ^ running)
heffVersions who wanted running _ _ = Nothing

heffFor : Maybe String -> String -> String -> Maybe String
heffFor (Just running) who wanted =
  heffVersions who wanted running (Pr.version wanted) (Pr.version running)
heffFor Nothing who wanted = Nothing

-- (a package, as said where it is wrong)
whoOf : L.Pkg -> String
whoOf k =
  if strEq k.own "" then "package.hf: the project" else "the package " ^ k.path

-- (what is wrong with the heff each package is for: the project, then
-- those it requires)
heffErrors : Maybe String -> List L.Pkg -> List String
heffErrors running Nil = Nil
heffErrors running (Cons project deps) =
  List.concatMap
    (\(k : L.Pkg) -> case heffFor running (whoOf k) k.heff of
     Just why -> [why]
     Nothing -> Nil)
    (if strEq project.heff "" then deps else Cons project deps)

withError : L.Loaded -> String -> L.Loaded
withError l e =
  { sources = l.sources
  , errors = Cons e l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- | FILE and its import closure, loaded from FILE's project, which must
-- | be for this heff
load : {e : HFunctor}
     -> {{sys : process <: e}}
     -> {{disk : fs <: e}}
     -> String
     -> Co e L.Loaded
load file = do
  h <- hostNow
  l <- L.loadProgram h file
  running <- ownVersion
  pure (List.foldl withError l (heffErrors running l.packages))

-- (the files given, each a module named as from the working directory,
-- one of the library's if it is under the library)
readAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> List String
        -> List String
        -> Co e (List Dr.Source)
readAll before Nil = pure Nil
readAll before (Cons path rest) = do
  mSrc <- readFile path
  case mSrc of
    Nothing -> do
      printErr ("cannot read " ^ path)
      exit 1
      pure Nil
    Just src -> do
      st <- styleNow
      h <- hostNow
      more <- readAll (Cons (L.moduleOf (L.here st) path) before) rest
      pure
          (Cons
             (Dr.givenAfter
                before
                (L.moduleOf (L.here st) path)
                path
                src
                (L.ofLibrary (L.hostPaths h) path))
             more)

printLines : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  print l
  printLines rest

printDefs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Dr.Checked
          -> List String
          -> Co e Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Dr.dumpLines c k)
  printDefs c rest

printErrs : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> String
          -> List String
          -> Int
          -> Co e Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  printErr (m ^ ": " ^ l)
  printErrs m rest (n + 1)

printAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> List Dr.Checked
         -> Int
         -> Co e Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Dr.moduleKeys c)
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> List String
          -> Co e Unit
selfcheck paths = do
  sources <- readAll Nil paths
  bad <- printAll (Dr.checkProgram sources) 0
  if bad == 0 then pure MkUnit else exit 1

-- (the errors said, the count comes back)
diagCount : {e : HFunctor} -> {{io : stdio <: e}} -> List Dr.Checked -> Co e Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  m <- diagCount rest
  pure (n + m)

elemStrM : String -> List String -> Bool
elemStrM x Nil = False
elemStrM x (Cons y rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen Nil = Nil
nubStrGo seen (Cons x rest) =
  if elemStrM x seen then nubStrGo seen rest
  else Cons x (nubStrGo (Cons x seen) rest)

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- the provider of a module, M.provider.js beside the M.hf it was loaded
-- from
pathOfModule : List Dr.Source -> String -> Maybe String
pathOfModule Nil m = Nothing
pathOfModule (Cons s rest) m =
  if strEq s.module m then Just s.path else pathOfModule rest m

readProviderAt : {e : HFunctor}
               -> {{disk : fs <: e}}
               -> List Dr.Source
               -> String
               -> Co e (Maybe Em.Provider)
readProviderAt sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- readFile (L.dropHf path ^ ".provider.js")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProviders : {e : HFunctor}
              -> {{disk : fs <: e}}
              -> List Dr.Source
              -> List String
              -> Co e (List Em.Provider)
readProviders sources Nil = pure Nil
readProviders sources (Cons m rest) = do
  p <- readProviderAt sources m
  ps <- readProviders sources rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere; `--backend=node`'s is "node")
forHost : String -> Em.Provider -> Bool
forHost host p = case Em.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

providesLeaf : List Em.Provider -> String -> Bool
providesLeaf Nil k = False
providesLeaf (Cons p rest) k =
  if strEq p.module (Ef.moduleOfKey k)
  && elemStrM (Ef.nameOfKey k) (Em.exportedNames p.text)
    then True
  else providesLeaf rest k

emitErrs : {e : HFunctor} -> {{io : stdio <: e}} -> List String -> Co e Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  printErr ("heff: not compiled: " ^ e)
  emitErrs rest

putFileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{rep : Rp.report <: e}}
             -> List Dr.Checked
             -> Co e Unit
putFileDiags Nil = pure MkUnit
putFileDiags (Cons c rest) = do
  color <- Rp.errColor
  if List.null c.diags then pure MkUnit
    else writeErr (Dg.renderFileDiags color c.path c.source c.diags)
  putFileDiags rest

anyErrors : List Dr.Checked -> Bool
anyErrors cs =
  List.any (\(c : Dr.Checked) -> not (List.null (Dr.errorsIn c))) cs

-- (`done`: what follows the written program)
writeOut : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> String
         -> Co e Unit
         -> Em.Output
         -> Co e Unit
writeOut outPath done o = do
  emitErrs o.errors
  if List.null o.errors
      then do
        ok <- writeFile outPath o.source
        if ok then done
          else do
            printErr ("cannot write " ^ outPath)
            exit 1
    else exit 1

-- (a part written, unless it is there as it was: a C compiler that goes
-- by when a file changed -- zig's -- builds it again only if it did)
writeChanged : {e : HFunctor}
             -> {{disk : fs <: e}}
             -> String
             -> String
             -> Maybe String
             -> Co e Bool
writeChanged path text (Just was) =
  if strEq was text then pure True else writeFile path text
writeChanged path text Nothing = writeFile path text

-- (the parts of a C program, each `DIR/NAME`, written where changed)
writePartsGo : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> String
             -> List (Pair String String)
             -> Co e Bool
writePartsGo dir Nil = pure True
writePartsGo dir (Cons (MkPair name text) rest) = do
  st <- styleNow
  was <- readFile (P.join st dir name)
  ok <- writeChanged (P.join st dir name) text was
  if ok then writePartsGo dir rest else pure False

-- (what is in `dir` and is no part of the program -- a module no longer
-- in it -- gone, so that it is not built)
removeStale : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> String
            -> List (Pair String String)
            -> List String
            -> Co e Unit
removeStale dir parts Nil = pure MkUnit
removeStale dir parts (Cons n rest) = do
  st <- styleNow
  gone <-
    if List.any (\p -> strEq (fst p) n) parts then pure True
    else remove (P.join st dir n)
  removeStale dir parts rest

-- | a C program as parts, in the directory `dir`: each part written
-- | only if it changed, and what is no part of it gone
writeParts : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> String
           -> Co e Unit
           -> Pair (List (Pair String String)) (List String)
           -> Co e Unit
writeParts dir done (MkPair parts errors) = do
  emitErrs errors
  if List.null errors
      then do
        made <- mkDir dir
        names <- readDir dir
        u <- removeStale dir parts (fromMaybe Nil names)
        ok <- writePartsGo dir parts
        if ok then done
          else do
            printErr ("cannot write " ^ dir)
            exit 1
    else exit 1

compileFound : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> String
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Dr.Checked
             -> List Em.Provider
             -> Co e Unit
compileFound host file name outPath done c available = case Dr.findRunnable
    (List.filter (\k -> providesLeaf available k) (Dr.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    exit 1
  Right r ->
    writeOut
      outPath
      done
      (Em.compileProgram host available c.top.globals r.key r.effect)

-- (a computation whose effects all have providers for this host: each
-- world's algebra is bundled in from its module's M.provider.js)
compileLast : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> List Dr.Source
            -> String
            -> String
            -> Maybe String
            -> String
            -> Co e Unit
            -> List Dr.Checked
            -> Co e Unit
compileLast sources host file name outPath done cs = case Dr.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProviders
        sources
        (nubStrM (List.map (\k -> Ef.moduleOfKey k) (Dr.candidateLeaves c)))
    compileFound
        host
        file
        name
        outPath
        done
        c
        (List.filter (\p -> forHost host p) found)

compileDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> {{rep : Rp.report <: e}}
             -> List Dr.Source
             -> String
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> Bool
             -> List Dr.Checked
             -> Co e Unit
compileDiags sources host file name outPath done badL cs = do
  putFileDiags cs
  if badL || anyErrors cs then exit 1
    else compileLast sources host file name outPath done cs

-- | compile the computation `name` of FILE to a program of `host`, then
-- | go on with `done`
compileThen : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> {{rep : Rp.report <: e}}
            -> String
            -> Maybe String
            -> String
            -> String
            -> Co e Unit
            -> Co e Unit
compileThen host name outPath file done = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  compileDiags l.sources host file name outPath done (badL > 0) cs

-- | compile the computation `name` of FILE to a program of `host`:
-- | FILE's import closure loaded with the compiler's own loader
compileCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Maybe String
           -> String
           -> String
           -> String
           -> Co e Unit
compileCmd host name outPath how file =
  compileThen host name outPath file (print ("wrote " ^ outPath ^ ": " ^ how))

nodeCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> Maybe String
        -> String
        -> String
        -> Co e Unit
nodeCmd name outPath file =
  compileCmd
    "node"
    name
    outPath
    ("run it with `node " ^ outPath ^ " ARGS...`")
    file

appCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{rep : Rp.report <: e}}
       -> Maybe String
       -> String
       -> String
       -> Co e Unit
appCmd name outPath file =
  compileCmd
    "page"
    name
    outPath
    "load it in a page with <script src=\"...\"> (it imports nothing: it opens from file:// too)"
    file

runDir : L.Paths -> String
runDir paths = L.under paths paths.root ".heff/run"

-- (FILE's path, its separators underscores)
runPath : L.Paths -> String -> String
runPath paths file =
  L.under
    paths
    (runDir paths)
    (joinWith "_" (P.components paths.style file) ^ ".mjs")

-- | run FILE's `main` with ARGS: compiled for Node.js to `.heff/run/`,
-- | which runs in heff's place
runCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{rep : Rp.report <: e}}
       -> String
       -> List String
       -> Co e Unit
runCmd file progArgs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  ok <- mkDir (runDir l.paths)
  compileDiags
      l.sources
      "node"
      file
      (Just "main")
      (runPath l.paths file)
      (exec "node" (runPath l.paths file :: progArgs))
      (badL > 0)
      cs

ownExport : Dr.Own -> Em.Export
ownExport o = Em.mkExport o.name o.key

compileJsOut : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> String
             -> Bool
             -> Em.Output
             -> Co e Unit
compileJsOut outPath bad o = do
  ok <- writeFile outPath o.source
  emitErrs o.errors
  if ok && not bad && List.null o.errors then pure MkUnit else exit 1

compileJsDiags : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : fs <: e}}
               -> {{rep : Rp.report <: e}}
               -> String
               -> String
               -> Bool
               -> List Dr.Checked
               -> Co e Unit
compileJsDiags file outPath badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      compileJsOut
        outPath
        (badL || anyErrors cs)
        (Em.compileJs c.top.globals (List.map (\o -> ownExport o) c.own))

-- | an ES module of FILE and what it imports
compileJsCmd : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> {{rep : Rp.report <: e}}
             -> String
             -> String
             -> Co e Unit
compileJsCmd file outPath = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  compileJsDiags file outPath (badL > 0) cs

-- The C backend
--------------------------------------------------------------------------------

-- (a world's provider for the C backend: `M.provider.c` beside `M.hf`)
readProviderC : {e : HFunctor}
              -> {{disk : fs <: e}}
              -> List Dr.Source
              -> String
              -> Co e (Maybe Em.Provider)
readProviderC sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- readFile (L.dropHf path ^ ".provider.c")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProvidersC : {e : HFunctor}
               -> {{disk : fs <: e}}
               -> List Dr.Source
               -> List String
               -> Co e (List Em.Provider)
readProvidersC sources Nil = pure Nil
readProvidersC sources (Cons m rest) = do
  p <- readProviderC sources m
  ps <- readProvidersC sources rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

providesLeafC : List Em.Provider -> String -> Bool
providesLeafC Nil k = False
providesLeafC (Cons p rest) k =
  if strEq p.module (Ef.moduleOfKey k)
  && elemStrM (Ef.nameOfKey k) (Ec.providedNames p.text)
    then True
  else providesLeafC rest k

compileFoundC : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : fs <: e}}
              -> String
              -> Maybe String
              -> String
              -> String
              -> Co e Unit
              -> Dr.Checked
              -> List Em.Provider
              -> Co e Unit
compileFoundC file name outPath runtime done c available = case Dr.findRunnable
    (List.filter (\k -> providesLeafC available k) (Dr.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ^ file ^ ": " ^ why)
    exit 1
  Right r ->
    -- (a directory, `OUT/`: the program as parts, a file for each module)
    if endsWith "/" outPath
      then writeParts
          (strSlice outPath 0 (strLength outPath - 1))
          done
          (Ec.compileProgramParts
             runtime
             available
             c.top.globals
             r.key
             r.effect)
    else writeOut
        outPath
        done
        (Ec.compileProgramC runtime available c.top.globals r.key r.effect)

-- (lib/c/runtime.c, what a C program is bundled with)
readRuntimeC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> Co e String
readRuntimeC = do
  lib <- libDir
  st <- styleNow
  runtime <- readFile (P.join st (P.join st lib "c") "runtime.c")
  case runtime of
    Nothing -> do
      printErr
          ("heff: no C runtime at " ^ P.join st (P.join st lib "c") "runtime.c")
      exit 1
      pure ""
    Just text -> pure text

compileLastC : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> List Dr.Source
             -> String
             -> Maybe String
             -> String
             -> Co e Unit
             -> List Dr.Checked
             -> Co e Unit
compileLastC sources file name outPath done cs = case Dr.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProvidersC
        sources
        (nubStrM (List.map (\k -> Ef.moduleOfKey k) (Dr.candidateLeaves c)))
    runtime <- readRuntimeC
    case name of
      -- (no computation named: each of the file's definitions, shown)
      Nothing ->
        compileJsOut
          outPath
          False
          (Ec.compileCheckC
             runtime
             c.top.globals
             (List.map (\(o : Dr.Own) -> MkPair o.name o.key) c.own))
      Just _ -> compileFoundC file name outPath runtime done c found

-- | compile the computation `name` of FILE to one C file (with no
-- | `name`, one that shows each of FILE's definitions asked for, as the
-- | tests ask: test/compile-check-c.mjs)
-- | compile the computation `name` of FILE to one C file, then go on
-- | with `done`
cThen : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : fs <: e}}
      -> {{rep : Rp.report <: e}}
      -> Maybe String
      -> String
      -> String
      -> Co e Unit
      -> Co e Unit
cThen name outPath file done = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  putFileDiags cs
  if badL > 0 || anyErrors cs then exit 1
    else compileLastC l.sources file name outPath done cs

cCmd : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : fs <: e}}
     -> {{rep : Rp.report <: e}}
     -> Maybe String
     -> String
     -> String
     -> Co e Unit
cCmd name outPath file =
  cThen
    name
    outPath
    file
    (print
       ("wrote "
        ^ outPath
        ^ ": build it with `zig cc -O2 "
        ^ (if endsWith "/" outPath then outPath ^ "*.c" else outPath)
        ^ " -o PROGRAM`"))

ranStatus : Ran -> Int
ranStatus r = r.status

ranOut : Ran -> String
ranOut r = r.out

ranErr : Ran -> String
ranErr r = r.err

-- | where `heff build` writes the project's programs: `.heff/bin/`
binDir : P.Style -> String
binDir st = P.join st ".heff" "bin"

-- | what a build makes, and where: the project at `root`, its programs
-- | written to `bin`, each said as it is made (`wrote`, `installed`); a
-- | page's script made too, if `pages`; what the programs ship put in
-- | `shipTo`, if it is given; their C built by zig at `opt`
type Target =
  { root : String
  , bin : String
  , said : String
  , pages : Bool
  , shipTo : Maybe String
  , opt : String
  }

-- | `heff build`'s: the project at `root`, its programs in `.heff/bin/`,
-- | built for the next change made, not to run their fastest: `-O1`,
-- | which zig builds in half the time `-O2` takes (`heff install` builds
-- | them with `-O2`)
buildTarget : P.Style -> String -> Target
buildTarget st root =
  { root = root
  , bin = P.join st root (binDir st)
  , said = "wrote"
  , pages = True
  , shipTo = Nothing
  , opt = "-O1"
  }

-- (a path of the project)
inProject : P.Style -> Target -> String -> String
inProject st t p = P.join st t.root p

-- (`app/X/F`, of the project)
appFile : P.Style -> Target -> String -> String -> String
appFile st t x f = inProject st t (P.join st (P.join st "app" x) f)

-- (where the program X is built: `.heff/build/X/`, its C and what is
-- made of it)
partsDir : P.Style -> Target -> String -> String
partsDir st t x = inProject st t (P.join st (P.join st ".heff" "build") x)

-- (`n`, made of the program X, in the project: `.heff/build/X/n`)
builtAt : P.Style -> Target -> String -> String -> String
builtAt st t x n = P.join st (partsDir st t x) n

-- | a program of the project: `app/X/` with a build.hf is the program X,
-- | built as its build.hf says
type App = { name : String, build : Pr.Build }

-- | the project's programs read so far, and the build.hf among them that
-- | could not be read
type Apps = { apps : List App, bad : Int }

-- (a file or a directory is at `path`)
isThere : {e : HFunctor} -> {{disk : fs <: e}} -> String -> Co e Bool
isThere path = do
  dir <- readDir path
  case dir of
    Just _ -> pure True
    Nothing -> do
      file <- readFile path
      pure (case file of
        Just _ -> True
        Nothing -> False)

-- (the names among `ns` that are not of the project's root)
notInProject : {e : HFunctor}
             -> {{disk : fs <: e}}
             -> P.Style
             -> Target
             -> List String
             -> Co e (List String)
notInProject st t Nil = pure Nil
notInProject st t (Cons n rest) = do
  ok <- isThere (inProject st t n)
  others <- notInProject st t rest
  pure (if ok then others else Cons n others)

-- (the program X, read from its build.hf, unless what it ships is not
-- all in the project: `missing`)
appShips : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> P.Style
         -> Target
         -> Apps
         -> String
         -> Pr.Build
         -> List String
         -> Co e Apps
appShips st t acc x a Nil =
  pure { apps = Cons { name = x, build = a } acc.apps, bad = acc.bad }
appShips st t acc x a missing = do
  printErr
      (appFile st t x "build.hf"
       ^ ": it ships "
       ^ joinWith ", " (List.map (\n -> "`" ^ n ^ "`") missing)
       ^ ", which the project does not have")
  pure { apps = acc.apps, bad = acc.bad + 1 }

-- (the directory app/X, with its build.hf's text, if it has one: the
-- program X read, or what is wrong with its build.hf said)
appRead : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{disk : fs <: e}}
        -> P.Style
        -> Target
        -> Apps
        -> String
        -> Maybe String
        -> Co e Apps
appRead st t acc x Nothing = pure acc
appRead st t acc x (Just text) = case Pr.readBuild text of
  Left p -> do
    printErr (L.problemMsg (appFile st t x "build.hf") text p)
    pure { apps = acc.apps, bad = acc.bad + 1 }
  Right a -> do
    missing <- notInProject st t a.ships
    appShips st t acc x a missing

-- | the project's programs, among the directories of its app/: each one's
-- | build.hf read, before any is built (each one more of the task `rd`'s)
appsIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : fs <: e}}
       -> {{prog : Pg.progress <: e}}
       -> P.Style
       -> Target
       -> Pg.Task
       -> Apps
       -> List String
       -> Co e Apps
appsIn st t rd acc Nil = pure { apps = List.reverse acc.apps, bad = acc.bad }
appsIn st t rd acc (Cons x rest) = do
  m <- readFile (appFile st t x "build.hf")
  next <- appRead st t acc x m
  Pg.complete rd
  appsIn st t rd next rest

-- (the task done with, then `next`)
ended : {e : HFunctor}
      -> {{prog : Pg.progress <: e}}
      -> Pg.Task
      -> Co e Unit
      -> Co e Unit
ended task next = do
  Pg.end task
  next

-- (said: `path` is made; then `next`)
wrote : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> Target
      -> String
      -> Co e Unit
      -> Co e Unit
wrote t path next = do
  print (t.said ^ " " ^ path)
  next

-- (`.heff/build/X/`, a C file a module, by `zig cc` -- which builds
-- them at once, and again only those that changed -- is the program X,
-- `.heff/build/X/X`: a task under the program's, `p`, of as many items
-- as files and the link, what zig says of them under it)
zigCc : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : fs <: e}}
      -> {{prog : Pg.progress <: e}}
      -> P.Style
      -> Target
      -> Pg.Task
      -> String
      -> Co e Unit
      -> Co e Unit
zigCc st t p x next = do
  names <- readDir (partsDir st t x)
  files <-
    pure
      (List.map
         (\n -> P.join st (partsDir st t x) n)
         (List.filter (\n -> endsWith ".c" n) (fromMaybe Nil names)))
  z <- Pg.start p "zig cc" (List.length files + 1)
  r <-
    Pg.runUnder
      z
      "zig"
      (List.append
         ["cc", t.opt, "-w"]
         (List.append files ["-o", builtAt st t x x, "-lm"]))
  Pg.end z
  if ranStatus r == 0 then next
    else do
      writeErr (ranErr r)
      printErr ("heff build: `zig cc` could not build " ^ builtAt st t x x)
      exit 1

-- (the program X, a Node.js program, made runnable)
nodeDone : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> P.Style
         -> Target
         -> String
         -> Co e Unit
         -> Co e Unit
nodeDone st t x next = do
  r <- run "chmod" ["+x", builtAt st t x x]
  next

-- (the program X, compiled as its build.hf says, in `.heff/build/X/`,
-- then `next`: a task under `bp`, the programs', of its steps -- through
-- C, compiled, then built by zig; else compiled -- each a task under it
-- as it is done)
buildApp : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{rep : Rp.report <: e}}
         -> {{prog : Pg.progress <: e}}
         -> P.Style
         -> Target
         -> Pg.Task
         -> String
         -> Pr.Build
         -> Co e Unit
         -> Co e Unit
buildApp st t bp x a next =
  if strEq a.backend "c"
    then do
      p <- Pg.start bp x 2
      c <- Pg.start p "compiling to C" 0
      cThen
          (Just a.run)
          (partsDir st t x ^ "/")
          (appFile st t x "main.hf")
          (ended c (zigCc st t p x (ended p next)))
  else if strEq a.backend "node"
    then do
      p <- Pg.start bp x 1
      c <- Pg.start p "compiling for Node.js" 0
      made <- mkDir (partsDir st t x)
      compileThen
          "node"
          (Just a.run)
          (builtAt st t x x)
          (appFile st t x "main.hf")
          (ended c (nodeDone st t x (ended p next)))
  else if t.pages
    then do
      p <- Pg.start bp x 1
      c <- Pg.start p "compiling for a page" 0
      made <- mkDir (partsDir st t x)
      compileThen
          "page"
          (Just a.run)
          (builtAt st t x (x ^ ".js"))
          (appFile st t x "main.hf")
          (ended c (ended p next))
  else do
    print ("passed over " ^ x ^ ": a page's script, not a program")
    Pg.complete bp
    next

-- (each program, by its build.hf, then `done`)
buildEach : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> {{rep : Rp.report <: e}}
          -> {{prog : Pg.progress <: e}}
          -> P.Style
          -> Target
          -> Pg.Task
          -> Co e Unit
          -> List App
          -> Co e Unit
buildEach st t bp done Nil = done
buildEach st t bp done (Cons a rest) =
  buildApp st t bp a.name a.build (buildEach st t bp done rest)

-- (what cannot be put in `home` said: nothing more is done)
shipFails : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> String
          -> Co e Unit
shipFails why = do
  printErr ("heff: " ^ why)
  exit 1

-- (`fresh` moved to `to`, what was there moved aside to `old` first:
-- `old` then removed; or, `fresh` not moved, what was there put back)
shipMoved : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> Target
          -> String
          -> String
          -> String
          -> Co e Unit
          -> Bool
          -> Co e Unit
shipMoved t fresh old to next True = do
  _ <- remove old
  wrote t to next
shipMoved t fresh old to next False = do
  _ <- move old to
  _ <- remove fresh
  shipFails ("cannot put " ^ fresh ^ " in place of " ^ to)

-- (the file or directory `n` of the project put in `home`, in place of
-- what was there: copied into `home` first, as `.n.new`, then moved to
-- `n`, so that a failure leaves the whole of what was there, not a part
-- of either; then `next` (a task under `sh`, the shipping's, meanwhile)
shipOne : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{prog : Pg.progress <: e}}
        -> P.Style
        -> Target
        -> String
        -> Pg.Task
        -> Co e Unit
        -> String
        -> Co e Unit
shipOne st t home sh next n = do
  it <- Pg.start sh n 0
  fresh <- pure (P.join st home ("." ^ n ^ ".new"))
  old <- pure (P.join st home ("." ^ n ^ ".old"))
  _ <- remove fresh
  _ <- remove old
  copied <- copy (inProject st t n) fresh
  if copied
      then do
        -- (nothing there, nothing moved aside)
        _ <- move (P.join st home n) old
        moved <- move fresh (P.join st home n)
        shipMoved t fresh old (P.join st home n) (ended it next) moved
    else do
      _ <- remove fresh
      shipFails ("cannot copy " ^ inProject st t n ^ " to " ^ fresh)

shipAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{prog : Pg.progress <: e}}
        -> P.Style
        -> Target
        -> String
        -> Pg.Task
        -> Co e Unit
        -> List String
        -> Co e Unit
shipAll st t home sh next Nil = next
shipAll st t home sh next (Cons n rest) =
  shipOne st t home sh (shipAll st t home sh next rest) n

-- | what the programs ship, each named once
shippedBy : List App -> List String
shippedBy progs = nubStrM (List.concatMap (\(a : App) -> a.build.ships) progs)

-- (what the programs ship, put in `t.shipTo` if it is given, a task
-- meanwhile; then `done`)
shipIn : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{prog : Pg.progress <: e}}
       -> P.Style
       -> Target
       -> Co e Unit
       -> List App
       -> Maybe String
       -> Co e Unit
shipIn st t done progs Nothing = done
shipIn st t done progs (Just home) = do
  sh <-
    Pg.start Pg.root ("installing in " ^ home) (List.length (shippedBy progs))
  shipAll st t home sh (ended sh done) (shippedBy progs)

-- (what the program puts in `t.bin`, by its build.hf: itself, or, if
-- `t.pages`, a page's script)
madeAs : Target -> App -> Maybe String
madeAs t a =
  if strEq a.build.backend "c" || strEq a.build.backend "node" then Just a.name
  else if t.pages then Just (a.name ^ ".js")
  else Nothing

-- (`n`, made of the program X, put in `t.bin` in place of what was
-- there: copied beside it first, as `.n.new`, then renamed to `n`, which
-- is done at once, so that what runs it meanwhile runs the one or the
-- other, never a part of either; or, the copy gone and what was there
-- kept, nothing more done (as on Windows, where nothing is put in place
-- of a program running); then `next` (a task under `pl`, the programs',
-- meanwhile)
placeMade : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> {{prog : Pg.progress <: e}}
          -> P.Style
          -> Target
          -> Pg.Task
          -> Co e Unit
          -> String
          -> Maybe String
          -> Co e Unit
placeMade st t pl next x Nothing = do
  Pg.complete pl
  next
placeMade st t pl next x (Just n) = do
  it <- Pg.start pl n 0
  fresh <- pure (P.join st t.bin ("." ^ n ^ ".new"))
  _ <- remove fresh
  copied <- copy (builtAt st t x n) fresh
  placed <- if copied then replace fresh (P.join st t.bin n) else pure False
  if placed then wrote t (P.join st t.bin n) (ended it next)
    else do
      _ <- remove fresh
      shipFails
          ("cannot put "
           ^ builtAt st t x n
           ^ " in place of "
           ^ P.join st t.bin n)

placeAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{prog : Pg.progress <: e}}
         -> P.Style
         -> Target
         -> Pg.Task
         -> Co e Unit
         -> List App
         -> Co e Unit
placeAll st t pl next Nil = next
placeAll st t pl next (Cons a rest) =
  placeMade st t pl (placeAll st t pl next rest) a.name (madeAs t a)

-- (the programs, built, put in `t.bin`, a task meanwhile; then `next`)
placeIn : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{prog : Pg.progress <: e}}
        -> P.Style
        -> Target
        -> Co e Unit
        -> List App
        -> Co e Unit
placeIn st t next progs = do
  ok <- mkDir t.bin
  pl <-
    Pg.start Pg.root ("putting the programs in " ^ t.bin) (List.length progs)
  placeAll st t pl (ended pl next) progs

-- (the programs, built in the project, then put in `t.bin`, and what
-- they ship put where `t` says: none put anywhere unless all are built;
-- then `done`)
buildPrograms : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> {{disk : fs <: e}}
              -> {{rep : Rp.report <: e}}
              -> {{prog : Pg.progress <: e}}
              -> P.Style
              -> Target
              -> Co e Unit
              -> List App
              -> Co e Unit
buildPrograms st t done progs = do
  okC <- mkDir (inProject st t (P.join st ".heff" "build"))
  bp <- Pg.start Pg.root "building programs" (List.length progs)
  buildEach
      st
      t
      bp
      (ended bp (placeIn st t (shipIn st t done progs t.shipTo) progs))
      progs

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.` passed over)
hfFilesGo : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> List String
          -> List String
          -> Co e (List String)
hfFilesGo Nil acc = pure (List.reverse acc)
hfFilesGo (Cons p rest) acc = do
  names <- readDir p
  case names of
    Just ns -> do
      st <- styleNow
      hfFilesGo
          (List.append
             (List.map
                (\n -> P.join st p n)
                (List.filter (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then hfFilesGo rest (Cons p acc)
      else hfFilesGo rest acc

-- | the modules of the project checked so far, and the errors found
type Checks = { seen : List String, errors : Int }

errorCount : List Dr.Checked -> Int
errorCount cs =
  List.foldl (\n (c : Dr.Checked) -> n + List.length (Dr.errorsIn c)) 0 cs

-- | FILE, a module of the project, checked with what it imports, unless
-- | it was among what a module checked before imports; the diagnostics
-- | of each module of the project's src/ said once (one more of the
-- | task `chk`'s: checked, a task under it meanwhile)
checkModule : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> {{rep : Rp.report <: e}}
            -> {{prog : Pg.progress <: e}}
            -> Pg.Task
            -> Checks
            -> String
            -> Co e Checks
checkModule chk acc f = do
  h <- hostNow
  ps <- L.pathsFor h f
  if elemStrM (L.moduleOf ps f) acc.seen
      then do
        Pg.complete chk
        pure acc
    else do
      m <- Pg.start chk (L.moduleOf ps f) 0
      l <- load f
      badL <- printErrs "heff" l.errors 0
      cs <- Se.cachedProgram l
      own <-
        pure
          (List.filter
             (\(c : Dr.Checked) ->
                (L.inside l.paths l.paths.src c.path
                 || strEq c.module (L.moduleOf ps f))
                && not (elemStrM c.module acc.seen))
             cs)
      putFileDiags own
      Pg.end m
      pure
          { seen =
              List.append
                (List.map (\(c : Dr.Checked) -> c.module) own)
                acc.seen
          , errors = acc.errors + badL + errorCount own
          }

checkModules : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> {{rep : Rp.report <: e}}
             -> {{prog : Pg.progress <: e}}
             -> Pg.Task
             -> Checks
             -> List String
             -> Co e Checks
checkModules chk acc Nil = pure acc
checkModules chk acc (Cons f rest) = do
  next <- checkModule chk acc f
  checkModules chk next rest

-- (`n` modules)
modulesSaid : Int -> String
modulesSaid 1 = "1 module"
modulesSaid n = showInt n ^ " modules"

-- (`n` errors)
errorsSaid : Int -> String
errorsSaid 1 = "1 error"
errorsSaid n = showInt n ^ " errors"

-- (what is wrong with the project, said: nothing built)
nothingBuilt : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> String
             -> String
             -> Co e Unit
nothingBuilt cmd what = do
  printErr ("heff " ^ cmd ^ ": " ^ what ^ ": nothing built")
  exit 1

-- | the whole project at `t.root` built: every module of its src/
-- | checked, and every program's build.hf read, then, if none has an
-- | error, every program of its app/ built (with none, `none`), then
-- | `done`; each a task as it is done
buildProject : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> {{rep : Rp.report <: e}}
             -> {{prog : Pg.progress <: e}}
             -> P.Style
             -> String
             -> Target
             -> Co e Unit
             -> Co e Unit
             -> Co e Unit
buildProject st cmd t none done = do
  files <- hfFilesGo [inProject st t "src"] Nil
  chk <- Pg.start Pg.root "checking modules" (List.length files)
  checked <- checkModules chk { seen = Nil, errors = 0 } files
  Pg.end chk
  if checked.errors > 0
      then nothingBuilt
          cmd
          (errorsSaid checked.errors ^ " in the project's modules")
    else do
      print
          ("heff "
           ^ cmd
           ^ ": "
           ^ modulesSaid (List.length checked.seen)
           ^ " checked")
      found <- readDir (inProject st t "app")
      rd <-
        Pg.start
          Pg.root
          "reading the programs' build.hf"
          (List.length (fromMaybe Nil found))
      progs <- appsIn st t rd { apps = Nil, bad = 0 } (fromMaybe Nil found)
      Pg.end rd
      if progs.bad > 0
          then nothingBuilt
              cmd
              (errorsSaid progs.bad ^ " in the programs' build.hf")
        else case progs.apps of
          Nil -> none
          _ -> buildPrograms st t done progs.apps

-- | build the project here, the whole of it: every module of its src/
-- | checked, then every program of it built: `app/X/` with a build.hf is
-- | the program X, app/X/main.hf compiled as its build.hf says, to
-- | `.heff/bin/`
buildCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{rep : Rp.report <: e}}
         -> {{prog : Pg.progress <: e}}
         -> Co e Unit
buildCmd = do
  text <- readFile "package.hf"
  st <- styleNow
  case text of
    Nothing -> do
      printErr "heff build: no package.hf here: build at the project's root"
      exit 1
    Just _ ->
      buildProject st "build" (buildTarget st ".") (pure MkUnit) (pure MkUnit)

-- (the directories of a PATH, on the platform `p`)
pathDirs : String -> String -> List String
pathDirs p path = split (if strEq p "win32" then ";" else ":") path

-- (a hint, if `bin` is not on the PATH)
onPathHint : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> P.Style
           -> String
           -> Co e Unit
onPathHint st bin = do
  p <- platform
  path <- getEnv "PATH"
  if List.any
      (\d -> strEq (P.join st d ".") (P.join st bin "."))
      (pathDirs p (fromMaybe "" path))
      then pure MkUnit
    else print
        ("heff install: "
         ^ bin
         ^ " is not on the PATH: add it there to run them by their names")

-- | install the project at DIR: built as `heff build` builds it, but to
-- | run its fastest (zig's `-O2`), its programs into the heff home's
-- | `bin/` (`HEFF_HOME/bin`, `~/.heff/bin`), and what they ship (their
-- | build.hf's `ships`) into the heff home, beside `bin/`
installCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> {{prog : Pg.progress <: e}}
           -> String
           -> Co e Unit
installCmd dir = do
  st <- styleNow
  home <- heffHome
  text <- readFile (P.join st dir "package.hf")
  t <-
    pure
      { root = dir
      , bin = P.join st home "bin"
      , said = "installed"
      , pages = False
      , shipTo = Just home
      , opt = "-O2"
      }
  case text of
    Nothing -> do
      printErr ("heff install: no package.hf in " ^ dir)
      exit 1
    Just _ ->
      buildProject
        st
        "install"
        t
        (do
         printErr
             ("heff install: no programs in "
              ^ dir
              ^ ": app/X/ with a build.hf is the program X")
         exit 1)
        (onPathHint st t.bin)

-- | how `heff compile` was called: FILE, OUT, `--name`, `--backend`
type CompileOpts =
  { file : String, outPath : String, name : Maybe String, backend : String }

-- | `heff compile`, by its backend
compileTo : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> {{rep : Rp.report <: e}}
          -> CompileOpts
          -> Co e Unit
compileTo o =
  if strEq o.backend "node" then nodeCmd o.name o.outPath o.file
  else if strEq o.backend "page" then appCmd o.name o.outPath o.file
  else if strEq o.backend "esm"
    then case o.name of
      Nothing -> compileJsCmd o.file o.outPath
      Just n -> do
        printErr
            "heff compile: an ES module runs nothing: no --name with --backend=esm"
        exit 1
  else if strEq o.backend "c" then cCmd o.name o.outPath o.file
  else do
    printErr
        ("heff compile: no backend " ^ o.backend ^ ": esm, page, node or c")
    exit 1

printEvals : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> List Dr.Evaluated
           -> Co e Unit
printEvals Nil = pure MkUnit
printEvals (Cons d rest) = do
  print (d.name ^ " = " ^ d.value)
  printEvals rest

evalDiags : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Rp.report <: e}}
          -> Bool
          -> List Dr.Checked
          -> Co e Unit
evalDiags badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      printEvals (Dr.evaluate c)
      if badL || anyErrors cs then exit 1 else pure MkUnit

-- | print what each definition of FILE evaluates to
evalCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> String
        -> Co e Unit
evalCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  evalDiags (badL > 0) cs

promoteDiags : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> {{disk : fs <: e}}
             -> {{rep : Rp.report <: e}}
             -> String
             -> Bool
             -> List Dr.Checked
             -> Co e Unit
promoteDiags file badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      if badL || anyErrors cs then exit 1
      else do
        ok <- writeFile file (Dr.promote c)
        if ok then pure MkUnit else exit 1

-- | write each watch's value under it as its expectation
promoteCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Co e Unit
promoteCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  promoteDiags file (badL > 0) cs

type TestRes =
  { total : Int, failed : Int, ok : Bool, tests : Int, testsFailed : Int }

failLine : String -> Dr.TestReport -> Rp.Mismatch -> String
failLine f r m =
  "FAIL "
  ^ f
  ^ (case r.owner of
     Just n -> " (" ^ n ^ ")"
     Nothing -> "")
  ^ ": "
  ^ r.watch.expr
  ^ "\n  expected "
  ^ m.expected
  ^ "\n  but got  "
  ^ m.got
  ^ "\n  diff     "
  ^ m.diff

-- (each expectation that does not hold, and what differs, in colour on
-- a terminal)
printFails : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> String
           -> Bool
           -> List Dr.TestReport
           -> Co e Unit
printFails f color Nil = pure MkUnit
printFails f color (Cons r rest) = do
  print
      (failLine
         f
         r
         (Rp.mismatch color (fromMaybe "" r.watch.expected) r.watch.value))
  printFails f color rest

badReports : List Dr.TestReport -> List Dr.TestReport
badReports rs = List.filter (\(r : Dr.TestReport) -> not r.watch.holds) rs

-- (`n` of `total`, as a part of a hundred)
percent : Int -> Int -> String
percent n total = showInt (if total == 0 then 0 else n * 100 / total) ^ "%"

-- | a property's statistic: how many runs held, how many were given up
-- | on, and how many had each label -- so that a property that holds
-- | only of what is trivial shows
statistic : Dr.TestOutcome -> String
statistic o =
  showInt o.runs
  ^ " runs"
  ^ (if o.discarded > 0 then ", " ^ showInt o.discarded ^ " given up on"
     else "")
  ^ joinWith
    ""
    (List.map
       (\(p : Pair String Int) -> ", " ^ percent (snd p) o.runs ^ " " ^ fst p)
       o.labels)

-- (how many shrinks made the counterexample)
shrunk : Int -> String
shrunk 0 = "not shrunk"
shrunk 1 = "shrunk once"
shrunk n = "shrunk " ^ showInt n ^ " times"

-- | a test's line: whether it held, its name, and for a property its
-- | statistic -- and if it failed, how far its counterexample was
-- | shrunk and the seed that runs it again
outcomeLine : Dr.TestOutcome -> String
outcomeLine o =
  (if o.ok then "  ok    " else "  FAIL  ")
  ^ o.name
  ^ (if not o.property then ""
     else if o.ok then "  (" ^ statistic o ^ ")"
     else "  (failed after "
       ^ showInt o.runs
       ^ " runs held"
       ^ (if o.discarded > 0 then ", " ^ showInt o.discarded ^ " given up on"
          else "")
       ^ "; "
       ^ shrunk o.shrinks
       ^ "; again: --seed "
       ^ showInt o.seed
       ^ ")")

mismatchLines : Rp.Mismatch -> List String
mismatchLines m =
  [ "        expected " ^ m.expected
  , "        but got  " ^ m.got
  , "        diff     " ^ m.diff
  ]

failLines : Bool -> Dr.TestFailure -> List String
failLines color (FailBecause why) = ["        " ^ why]
failLines color (FailDiffer expected got) =
  mismatchLines (Rp.mismatch color expected got)

failureLines : Bool -> Maybe Dr.TestFailure -> List String
failureLines color Nothing = Nil
failureLines color (Just f) = failLines color f

-- | what came of each test: a line each, and under one that failed its
-- | counterexample (what it drew and noted) and what was wrong
printOutcomes : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> Bool
              -> List Dr.TestOutcome
              -> Co e Unit
printOutcomes color Nil = pure MkUnit
printOutcomes color (Cons o rest) = do
  print (outcomeLine o)
  if o.ok then pure MkUnit
    else print
        (joinWith
           "\n"
           (List.append
              (List.map (\n -> "        " ^ n) o.notes)
              (failureLines color o.failure)))
  printOutcomes color rest

badOutcomes : List Dr.TestOutcome -> List Dr.TestOutcome
badOutcomes os = List.filter (\(o : Dr.TestOutcome) -> not o.ok) os

-- (how many tests held, of how many: said only of a file that has some)
testsSaid : List Dr.TestOutcome -> String
testsSaid Nil = ""
testsSaid os =
  ", tests "
  ^ showInt (List.length os - List.length (badOutcomes os))
  ^ "/"
  ^ showInt (List.length os)

testReport : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Int
           -> List Dr.TestReport
           -> List Dr.TestOutcome
           -> Co e TestRes
testReport f bad ts os = do
  color <- Rp.useColor
  printFails f color (badReports ts)
  printOutcomes color os
  print
      ((if List.null (badReports ts) && List.null (badOutcomes os) && bad == 0
          then "ok    "
        else "FAIL  ")
       ^ f
       ^ "  "
       ^ showInt (List.length ts - List.length (badReports ts))
       ^ "/"
       ^ showInt (List.length ts)
       ^ testsSaid os)
  pure
      { total = List.length ts
      , failed = List.length (badReports ts)
      , ok = bad == 0
      , tests = List.length os
      , testsFailed = List.length (badOutcomes os)
      }

testOneC : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{rep : Rp.report <: e}}
         -> Int
         -> String
         -> Int
         -> List Dr.Checked
         -> Co e TestRes
testOneC seed f bad0 cs = do
  bad <- diagCount cs
  case Dr.lastChecked cs of
    Nothing -> do
      print ("FAIL  " ^ f ^ "  0/0")
      pure { total = 0, failed = 0, ok = False, tests = 0, testsFailed = 0 }
    Just c ->
      testReport
        f
        (bad0 + bad)
        (Dr.testFile c)
        (if bad0 + bad > 0 then Nil else Dr.runTests seed c)

testOneF : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{rep : Rp.report <: e}}
         -> Int
         -> String
         -> Co e TestRes
testOneF seed f = do
  l <- load f
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  testOneC seed f badL cs

-- (the tests' part of the last line: said only if there were some)
testsHeld : Int -> Int -> String
testsHeld tests failed =
  if tests == 0 then ""
  else ", " ^ showInt (tests - failed) ^ "/" ^ showInt tests ^ " tests hold"

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.`, and a directory below them that is a project of its
-- own (a package.hf in it), passed over)
testFilesGo : {e : HFunctor}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> List (Pair Bool String)
            -> List String
            -> Co e (List String)
testFilesGo Nil acc = pure (List.reverse acc)
testFilesGo (Cons (MkPair top p) rest) acc = do
  names <- readDir p
  st <- styleNow
  case names of
    Just ns -> do
      own <- if top then pure False else L.isRoot st p
      if own then testFilesGo rest acc
        else testFilesGo
            (List.append
               (List.map
                  (\n -> MkPair False (P.join st p n))
                  (List.filter (\n -> not (startsWith "." n)) ns))
               rest)
            acc
    Nothing ->
      if endsWith ".hf" p then testFilesGo rest (Cons p acc)
      else testFilesGo rest acc

-- | the files `heff test` checks: those given, a directory's `.hf` files
-- | for it; none given, the project's tests here (the `.hf` files under
-- | `test/`)
testFiles : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> List String
          -> Co e (List String)
testFiles Nil = do
  names <- readDir "test"
  case names of
    Just _ -> testFilesGo [MkPair True "test"] Nil
    Nothing -> do
      printErr
          "heff test: no test/ here: test at the project's root, or give FILEs"
      exit 1
      pure Nil
testFiles given = testFilesGo (List.map (\f -> MkPair True f) given) Nil

-- | check the watches' expectations of every file given, and run its
-- | tests (each property from `seed`), each file a task under `tk` as
-- | it is tested
testCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> {{prog : Pg.progress <: e}}
        -> Pg.Task
        -> Int
        -> List String
        -> TestRes
        -> Co e Unit
testCmd tk seed Nil acc = do
  Pg.end tk
  print
      (showInt (acc.total - acc.failed)
       ^ "/"
       ^ showInt acc.total
       ^ " expectations hold"
       ^ testsHeld acc.tests acc.testsFailed)
  if acc.failed > 0 || acc.testsFailed > 0 || not acc.ok then exit 1
    else pure MkUnit
testCmd tk seed (Cons f rest) acc = do
  ft <- Pg.start tk f 0
  r <- testOneF seed f
  Pg.end ft
  testCmd
      tk
      seed
      rest
      { total = acc.total + r.total
      , failed = acc.failed + r.failed
      , ok = acc.ok && r.ok
      , tests = acc.tests + r.tests
      , testsFailed = acc.testsFailed + r.testsFailed
      }

-- | `heff test`: the watches' expectations of the files checked, and
-- | their tests run (each property from `seed`), a task meanwhile, each
-- | file one more of its
testsCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{rep : Rp.report <: e}}
         -> {{prog : Pg.progress <: e}}
         -> Int
         -> List String
         -> Co e Unit
testsCmd seed files = do
  tk <- Pg.start Pg.root "testing" (List.length files)
  testCmd
      tk
      seed
      files
      { total = 0, failed = 0, ok = True, tests = 0, testsFailed = 0 }

-- | the seed the properties are run from, unless `--seed` gives one:
-- | always the same, so that a run of the tests is a run of the same
-- | tests
defaultSeed : Int
defaultSeed = 2026

seedOf : Maybe String -> Int
seedOf Nothing = defaultSeed
seedOf (Just s) = fromMaybe defaultSeed (parseInt s)

checkLast : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{rep : Rp.report <: e}}
          -> Bool
          -> List Dr.Checked
          -> Co e Unit
checkLast badLoad cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      write (Dr.interface c)
      if badLoad || anyErrors cs then exit 1 else pure MkUnit

-- | elaborate FILE and what it imports; print its interface
checkCmd : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> {{rep : Rp.report <: e}}
         -> String
         -> Co e Unit
checkCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  checkLast (badL > 0) cs

-- | what the name at each OFFSET of FILE resolved to, and its type: a
-- | line each, FILE checked once
typeAtCmd : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> {{sys : process <: e}}
          -> {{disk : fs <: e}}
          -> {{rep : Rp.report <: e}}
          -> String
          -> List String
          -> Co e Unit
typeAtCmd file offs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      printLines
        (List.map
           (\off ->
              fromMaybe "nothing there" (case parseInt off of
              Just o -> Q.typeAt c o
              Nothing -> Nothing))
           offs)

-- | the elaboration trace of FILE, one line per event
explainCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Co e Unit
explainCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> printLines (Q.explain c)

fmtSrc : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{disk : fs <: e}}
       -> Bool
       -> String
       -> String
       -> F.Fixities
       -> Co e Int
fmtSrc checkOnly f src fix = case Fm.formatIn fix src of
  Left why -> do
    printErr ("heff: " ^ f ^ " not formatted: " ^ why)
    pure 1
  Right out ->
    if strEq out src then pure 0
    else if checkOnly
      then do
        print f
        pure 1
    else do
      ok <- writeFile f out
      pure 0

-- | 1 if the file is not formatted (with `--check`) or cannot be; its
-- | operators cut as the fixities of what it imports say
fmtOne : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> Bool
       -> String
       -> Co e Int
fmtOne checkOnly f = do
  mSrc <- readFile f
  case mSrc of
    Nothing -> do
      printErr ("heff: cannot read " ^ f)
      pure 1
    Just src -> do
      l <- load f
      fmtSrc checkOnly f src (Dr.fixitiesIn l.sources)

fmtAll : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> Bool
       -> List String
       -> Int
       -> Co e Int
fmtAll checkOnly Nil bad = pure bad
fmtAll checkOnly (Cons f rest) bad = do
  n <- fmtOne checkOnly f
  fmtAll checkOnly rest (bad + n)

-- | format FILEs in place; `--check`: only say which are not formatted
fmtCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> Bool
       -> List String
       -> Co e Unit
fmtCmd check files = do
  bad <- fmtAll check files 0
  if bad > 0 then exit 1 else pure MkUnit

-- (the watches of the files, checked, and their tests run: how many
-- hold, of how many, and whether every file checked)
testAll : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> List String
        -> TestRes
        -> Co e TestRes
testAll Nil acc = pure acc
testAll (Cons f rest) acc = do
  r <- testOneF defaultSeed f
  testAll
      rest
      { total = acc.total + r.total
      , failed = acc.failed + r.failed
      , ok = acc.ok && r.ok
      , tests = acc.tests + r.tests
      , testsFailed = acc.testsFailed + r.testsFailed
      }

publishFails : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> {{sys : process <: e}}
             -> String
             -> Co e Unit
publishFails why = do
  printErr ("heff publish: " ^ why)
  exit 1

-- (git, run: what is wrong if it fails)
gitOk : {e : HFunctor}
      -> {{sys : process <: e}}
      -> String
      -> List String
      -> Co e (Maybe String)
gitOk what as = do
  r <- run "git" as
  pure
      (if ranStatus r == 0 then Nothing
       else Just (what ^ ": git " ^ joinWith " " as ^ ": " ^ trim (ranErr r)))

publishTag : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> String
           -> Pr.Package
           -> Co e Unit
publishTag v pk = do
  tagged <- gitOk "not tagged" ["tag", "-a", "v" ^ v, "-m", "v" ^ v]
  case tagged of
    Just why -> publishFails why
    Nothing -> do
      pushed <- gitOk "tagged, not pushed" ["push", "origin", "v" ^ v]
      case pushed of
        Just why -> publishFails why
        Nothing ->
          print ("heff publish: " ^ pk.module ^ " " ^ v ^ ", tag v" ^ v)

publishTested : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> {{sys : process <: e}}
              -> String
              -> Pr.Package
              -> TestRes
              -> Co e Unit
publishTested v pk r =
  if r.failed > 0 || r.testsFailed > 0 || not r.ok
    then publishFails
        (showInt r.failed
         ^ " of "
         ^ showInt r.total
         ^ " expectations do not hold, "
         ^ showInt r.testsFailed
         ^ " of "
         ^ showInt r.tests
         ^ " tests fail, or a file does not check")
  else publishTag v pk

publishGit : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Pr.Package
           -> String
           -> Co e Unit
publishGit v pk src = do
  status <- run "git" ["status", "--porcelain"]
  tag <- run "git" ["rev-parse", "-q", "--verify", "refs/tags/v" ^ v]
  if not (ranStatus status == 0)
      then publishFails ("not in a git repository: " ^ trim (ranErr status))
    else if not (strEq (trim (ranOut status)) "")
      then publishFails "what is published is what is committed: commit first"
    else if ranStatus tag == 0
      then publishFails ("v" ^ v ^ " is tagged already")
    else do
      files <- hfFilesGo [src] Nil
      r <-
        testAll
          files
          { total = 0, failed = 0, ok = True, tests = 0, testsFailed = 0 }
      publishTested v pk r

publishChecked : {e : HFunctor}
               -> {{io : stdio <: e}}
               -> {{sys : process <: e}}
               -> {{disk : fs <: e}}
               -> {{rep : Rp.report <: e}}
               -> String
               -> L.Loaded
               -> Pr.Package
               -> Co e Unit
publishChecked v l pk = case Pr.majorMismatch pk.module v of
  Just why -> publishFails (pk.module ^ ": " ^ why)
  Nothing -> do
    own <- L.ownDir l.paths (L.under l.paths l.paths.root "src")
    case own of
      Left why -> publishFails why
      Right _ -> publishGit v pk (L.under l.paths l.paths.root "src")

-- | publish the project, at the working directory, as version V: its
-- | package.hf a Package (lib/manifest.hf), its path's `/vN` its major,
-- | its src/ one directory, every file of it checked, its watches
-- | holding and its tests too, all of it committed -- then tagged `vV`,
-- | the tag pushed
publishCmd : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{rep : Rp.report <: e}}
           -> String
           -> Co e Unit
publishCmd v = case Pr.version v of
  Nothing -> publishFails ("`" ^ v ^ "` is no version: a.b.c")
  Just _ -> do
    here <- readFile "package.hf"
    case here of
      Nothing ->
        publishFails "no package.hf here: publish at the project's root"
      Just _ -> do
        l <- load "package.hf"
        badL <- printErrs "heff" l.errors 0
        cs <- Se.cachedProgram l
        putFileDiags cs
        case l.package of
          Nothing -> publishFails "package.hf does not read"
          Just pk ->
            if badL > 0 || anyErrors cs
              then publishFails "package.hf is no Package (lib/manifest.hf)"
            else publishChecked v l pk

-- | the project's name: DIR's, or (DIR being `.`) the working directory's
projectName : P.Style -> String -> Maybe String -> String
projectName st "." (Just pwd) = P.basename st pwd
projectName st dir _ = P.basename st dir

-- (a new project's package.hf: the package NAME, for heff VERSION)
packageText : String -> String -> String
packageText name v =
  joinWith
    "\n"
    [ "import manifest"
    , ""
    , "package : Package"
    , "package = { module = \"" ^ name ^ "\", heff = \"" ^ v ^ "\" }"
    , ""
    ]

-- (a new project's module, src/NAME/greeting.hf)
moduleText : String -> String
moduleText name =
  joinWith
    "\n"
    [ "-- A module of the package, as every file of src/ is: `heff build`"
    , "-- checks them all, and this one's watches are checked by"
    , "-- `heff test src/" ^ name ^ "/greeting.hf`."
    , ""
    , "greeting : String -> String"
    , "greeting name = \"Hello, \" ^ name ^ \"!\""
    , ""
    , "-- >>> greeting \"heff\""
    , "-- \"Hello, heff!\""
    , ""
    ]

-- (a new project's program NAME, app/NAME/main.hf)
programText : String -> String
programText name =
  joinWith
    "\n"
    [ "-- The program " ^ name ^ ": `heff build` builds it to .heff/bin/, as"
    , "-- build.hf says, and `heff install` into ~/.heff/bin/; run on Node.js,"
    , "-- without a build, by `heff run app/" ^ name ^ "/main.hf`."
    , ""
    , "import co"
    , "import " ^ name ^ ".greeting"
    , "import std.io"
    , ""
    , "program : {{io : stdio <: stdio}} -> Co stdio Unit"
    , "program = print (greeting \"world\")"
    , ""
    , "main : Co stdio Unit"
    , "main = program (io := here stdio)"
    , ""
    ]

-- (how a new project's program is built, app/NAME/build.hf: its `main`,
-- through C)
buildText : String
buildText =
  joinWith
    "\n"
    [ "-- main.hf's `main`, compiled through C (by `zig cc`); `Node` makes a"
    , "-- Node.js program of it.  A field `ships = [...]` would name files and"
    , "-- directories of the project's root for `heff install` to put in the"
    , "-- heff home with it."
    , ""
    , "import manifest"
    , ""
    , "build : Build"
    , "build = { backend = C, run = \"main\" }"
    , ""
    ]

-- (a new project's test, test/greeting.hf)
testText : String -> String
testText name =
  joinWith
    "\n"
    [ "-- `heff test` runs the tests of every file of test/: the definitions"
    , "-- of type `Test` (lib/check.hf), after the watches."
    , ""
    , "import check"
    , "import " ^ name ^ ".greeting"
    , ""
    , "greets : Test"
    , "greets ="
    , "  unit \"greeting\" (equal showString (greeting \"test\") \"Hello, test!\")"
    , ""
    ]

-- | the files of a new project NAME, for heff VERSION: what each is, and
-- | its text -- a module, a program using it and a test of it, laid out
-- | as `heff build`, `heff test` and `heff install` take a project
projectFiles : String -> String -> List (Pair String String)
projectFiles name v =
  [ MkPair "package.hf" (packageText name v)
  , MkPair ".gitignore" (joinWith "\n" [".heff/", ""])
  , MkPair ("src/" ^ name ^ "/greeting.hf") (moduleText name)
  , MkPair ("app/" ^ name ^ "/main.hf") (programText name)
  , MkPair ("app/" ^ name ^ "/build.hf") buildText
  , MkPair "test/greeting.hf" (testText name)
  ]

-- | the files of `projectFiles` that are there already in DIR
existing : {e : HFunctor}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> String
         -> List (Pair String String)
         -> Co e (List String)
existing dir Nil = pure Nil
existing dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  there <- readFile (P.join st dir f)
  others <- existing dir rest
  case there of
    Just _ -> pure (Cons f others)
    Nothing -> pure others

-- (a `.hf` file as the formatter lays it out)
laidOut : String -> String -> String
laidOut f text =
  if endsWith ".hf" f
    then (case Fm.format text of
          Right out -> out
          Left _ -> text)
  else text

writeAll : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> {{disk : fs <: e}}
         -> String
         -> List (Pair String String)
         -> Co e Bool
writeAll dir Nil = pure True
writeAll dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  made <- mkDir (P.dirname st (P.join st dir f))
  ok <- writeFile (P.join st dir f) (laidOut f text)
  if made && ok then writeAll dir rest
    else do
      printErr ("heff: cannot write " ^ P.join st dir f)
      pure False

-- | a new project in DIR, NAME being DIR's: its package.hf, a .gitignore,
-- | a module of its package (`src/NAME/greeting.hf`), the program NAME
-- | (`app/NAME/`) and a test (`test/greeting.hf`); nothing is written
-- | over
initCmd : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> String
        -> Co e Unit
initCmd dir = do
  pwd <- getEnv "PWD"
  v <- ownVersion
  st <- styleNow
  name <- pure (projectName st dir pwd)
  files <- pure (projectFiles name (fromMaybe "0.1.0" v))
  there <- existing dir files
  if not (Pr.isName name)
      then do
        printErr
            ("heff: `"
             ^ name
             ^ "` cannot name a package: a lowercase letter, then letters, digits and `_`")
        exit 1
    else case there of
      Cons _ _ -> do
        printErr
            ("heff: "
             ^ dir
             ^ " has "
             ^ joinWith ", " there
             ^ " already; nothing written")
        exit 1
      Nil -> do
        ok <- writeAll dir files
        if ok
            then print
                ("heff: a new project in "
                 ^ dir
                 ^ "; there, `heff build` builds it and `heff test` tests it")
          else exit 1

-- Fetching
--------------------------------------------------------------------------------

getFails : {e : HFunctor}
         -> {{io : stdio <: e}}
         -> {{sys : process <: e}}
         -> String
         -> Co e Unit
getFails why = do
  printErr ("heff get: " ^ why)
  exit 1

-- | where the package at `path` is fetched from
urlOf : String -> String
urlOf path = "https://" ^ Pr.repoOf path

-- | version `v` of the package at `path`, in the cache: fetched there
-- | (its tag cloned, its .git removed, made read-only, then the tree
-- | its tag is of written beside it) unless it is there already; the
-- | tree, or what is wrong.  A task while it is cloned.
fetched : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{prog : Pg.progress <: e}}
        -> L.Paths
        -> String
        -> String
        -> Co e (Either String String)
fetched ps path v = do
  dir <- pure (L.cachedDir ps path v)
  hash <- readFile (dir ^ ".hash")
  case hash of
    Just h -> pure (Right (trim h))
    Nothing -> do
      _ <- remove dir
      _ <- mkDir (P.dirname ps.style dir)
      f <- Pg.start Pg.root ("fetching " ^ path ^ " " ^ v) 0
      cloned <-
        run
          "git"
          [ "-c"
          , "advice.detachedHead=false"
          , "clone"
          , "--quiet"
          , "--depth"
          , "1"
          , "--branch"
          , "v" ^ v
          , urlOf path
          , dir
          ]
      Pg.end f
      if not (ranStatus cloned == 0)
          then do
            _ <- remove dir
            pure
                (Left
                   ("cannot fetch "
                    ^ path
                    ^ " "
                    ^ v
                    ^ " (tag v"
                    ^ v
                    ^ " of "
                    ^ urlOf path
                    ^ "): "
                    ^ trim (ranErr cloned)))
        else do
          tree <- run "git" ["-C", dir, "rev-parse", "HEAD^{tree}"]
          _ <- remove (P.join ps.style dir ".git")
          sealed <- readOnly dir
          h <- pure ("tree:" ^ trim (ranOut tree))
          ok <- writeFile (dir ^ ".hash") (h ^ "\n")
          if ranStatus tree == 0 && sealed && ok
              then do
                print ("heff get: fetched " ^ path ^ " " ^ v)
                pure (Right h)
            else pure (Left ("cannot keep " ^ path ^ " " ^ v ^ " in " ^ dir))

-- | the package.hf of version `v` of `path`, required by `by`, fetched
-- | (unless the project replaces it); its tree must be what heff.sum
-- | said, if it said one
fetchedPkg : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{prog : Pg.progress <: e}}
           -> L.Paths
           -> Pr.Package
           -> List Pr.Sum
           -> String
           -> String
           -> String
           -> Co e (Either String Pr.Package)
fetchedPkg ps root sums by path v = case L.replacedDir root path of
  Just d -> L.readPkgAt ps (L.under ps ps.root d) path
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why -> pure (Left (by ^ " requires " ^ path ^ " " ^ v ^ ": " ^ why))
      Right h -> case Pr.sumOf sums path v of
        Just want ->
          if strEq h want then L.readPkgAt ps (L.cachedDir ps path v) path
          else pure
              (Left
                 (path
                  ^ " "
                  ^ v
                  ^ " is "
                  ^ h
                  ^ ", and heff.sum says "
                  ^ want
                  ^ ": its tag has been moved"))
        Nothing -> L.readPkgAt ps (L.cachedDir ps path v) path

-- (the trees of the versions fetched, as heff.sum's lines)
sumsOf : {e : HFunctor}
       -> {{disk : fs <: e}}
       -> L.Paths
       -> Pr.Package
       -> List L.Visit
       -> Co e (List Pr.Sum)
sumsOf ps root Nil = pure Nil
sumsOf ps root (Cons x rest) = do
  others <- sumsOf ps root rest
  h <- readFile (L.cachedDir ps x.path x.version ^ ".hash")
  pure (case L.replacedDir root x.path of
    Just _ -> others
    Nothing -> case h of
      Just t ->
        Cons { path = x.path, version = x.version, hash = trim t } others
      Nothing -> others)

-- | the newest version tagged in the repository of `path` that it is
-- | the path of (its major), or what is wrong; a task while it is asked
newestTag : {e : HFunctor}
          -> {{sys : process <: e}}
          -> {{prog : Pg.progress <: e}}
          -> String
          -> Co e (Either String String)
newestTag path = do
  t <- Pg.start Pg.root ("finding the newest version of " ^ path) 0
  r <- run "git" ["ls-remote", "--tags", "--refs", urlOf path]
  Pg.end t
  pure
      (if not (ranStatus r == 0)
         then Left
             ("cannot list the tags of " ^ urlOf path ^ ": " ^ trim (ranErr r))
       else case List.foldl
           (\(best : Maybe String) (line : String) -> case split
              "refs/tags/v"
              line of
            Cons _ (Cons v Nil) -> case Pr.version (trim v) of
              Just _ -> case Pr.majorMismatch path (trim v) of
                Nothing -> case best of
                  Just b -> if Pr.newer (trim v) b then Just (trim v) else best
                  Nothing -> Just (trim v)
                Just _ -> best
              Nothing -> best
            _ -> best)
           Nothing
           (lines (ranOut r)) of
         Just v -> Right v
         Nothing ->
           Left
             ("no tag of "
              ^ urlOf path
              ^ " is a version of "
              ^ path
              ^ " (vA.B.C, its major "
              ^ (if Pr.isMajorPart (Pr.lastPart path)
                   then "that of /" ^ Pr.lastPart path
                 else "0 or 1")
              ^ ")"))

-- | PATH@VERSION, PATH: the path, and the version (Nothing: the newest)
specOf : String -> Pair String (Maybe String)
specOf spec = case split "@" spec of
  Cons path (Cons v Nil) -> MkPair path (Just v)
  _ -> MkPair spec Nothing

-- (`r`, of version `v` if it is of `path`)
retarget : String -> String -> Pr.Require -> Pr.Require
retarget path v r =
  if strEq r.path path then { name = r.name, path = path, version = v } else r

-- | the project `pk`, requiring version `v` of `path`: in place of the
-- | version it required, else by the name the package's src/ gives it
requiring : Pr.Package -> String -> String -> String -> Pr.Package
requiring pk name path v =
  { module = pk.module
  , heff = pk.heff
  , require =
      if List.any (\(r : Pr.Require) -> strEq r.path path) pk.require
        then List.map (retarget path v) pk.require
      else List.append pk.require [{ name = name, path = path, version = v }]
  , replace = pk.replace
  }

-- | write the project's package.hf, requiring version `v` of `path`
-- | (fetched, to know its name)
getRequire : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{sys : process <: e}}
           -> {{disk : fs <: e}}
           -> {{prog : Pg.progress <: e}}
           -> L.Paths
           -> String
           -> Pr.Package
           -> String
           -> String
           -> Co e Bool
getRequire ps text pk path v = case Pr.majorMismatch path v of
  Just why -> do
    getFails (path ^ ": " ^ why)
    pure False
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why -> do
        getFails why
        pure False
      Right _ -> do
        own <- L.ownDir ps (P.join ps.style (L.cachedDir ps path v) "src")
        case own of
          Left why -> do
            getFails why
            pure False
          Right name ->
            if not
              (List.any (\(r : Pr.Require) -> strEq r.path path) pk.require)
            && List.any (\(r : Pr.Require) -> strEq r.name name) pk.require
              then do
                getFails
                    ("`"
                     ^ name
                     ^ "` is required already: add "
                     ^ path
                     ^ " to package.hf by another name")
                pure False
            else do
              ok <-
                writeFile
                  "package.hf"
                  (laidOut
                     "package.hf"
                     (Pr.withPackage text (requiring pk name path v)))
              if ok
                  then do
                    print ("heff get: package.hf requires " ^ path ^ " " ^ v)
                    pure True
                else do
                  getFails "cannot write package.hf"
                  pure False

-- | fetch every version the project's package.hf reaches, then write
-- | heff.sum, and load the project's packages, as a program would
getAll : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{prog : Pg.progress <: e}}
       -> Co e Unit
getAll = do
  h <- hostNow
  ps <- L.pathsFor h "package.hf"
  text <- readFile "package.hf"
  case Pr.readPackage (fromMaybe "" text) of
    Right root -> do
      old <- L.readSumAt ps
      case old of
        Left why -> getFails why
        Right sums -> do
          reached <-
            L.versionsOf (\by path v -> fetchedPkg ps root sums by path v) root
          news <- sumsOf ps root (fst reached)
          wrote <-
            if strEq (Pr.showSum news) "" then pure True
            else writeFile "heff.sum" (Pr.showSum news)
          bad <- printErrs "heff get" (snd reached) 0
          if bad > 0 then exit 1
            else if not wrote then getFails "cannot write heff.sum"
            else do
              l <- load "package.hf"
              badL <- printErrs "heff get" l.errors 0
              if badL > 0 then exit 1
                else print
                    ("heff get: "
                     ^ showInt (List.length (L.selected (fst reached)))
                     ^ " packages, heff.sum written")
    _ -> getFails "package.hf does not read: get at the project's root"

-- | fetch what the project requires, writing heff.sum; with PATH, first
-- | require it, at VERSION, else its newest
getCmd : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{prog : Pg.progress <: e}}
       -> Maybe String
       -> Co e Unit
getCmd spec = do
  text <- readFile "package.hf"
  case text of
    Nothing -> getFails "no package.hf here: get at the project's root"
    Just t -> case Pr.readPackage t of
      Left _ -> getFails "package.hf does not read"
      Right pk -> case spec of
        Nothing -> getAll
        Just s -> do
          h <- hostNow
          ps <- L.pathsFor h "package.hf"
          v <- case snd (specOf s) of
            Just v -> pure (Right v)
            Nothing -> newestTag (fst (specOf s))
          case v of
            Left why -> getFails why
            Right ver -> case Pr.version ver of
              Nothing -> getFails ("`" ^ ver ^ "` is no version: a.b.c")
              Just _ -> do
                ok <- getRequire ps t pk (fst (specOf s)) ver
                if ok then getAll else pure MkUnit
