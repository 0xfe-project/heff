-- The header of a file: the `import m` lines before its first
-- declaration.  The imports are read off, and the text is returned with
-- the import lines blanked out (spaces, so every offset stays where it
-- was); the formatter then puts an `import` pseudo-token at each one's
-- place.

import prelude
import heff.fmt.lex as L

type Span = { start : Int, end : Int }

type Import = { name : String, alias : Maybe String, span : Span }

type Header = { imports : List Import, text : String }

lineEndFrom : String -> Int -> Int
lineEndFrom s i =
  if i >= strLength s then i
  else if charCode s i == 10 then i
  else lineEndFrom s (i + 1)

nameC : Int -> Bool
nameC c =
  c == 46
  || c == 95
  || c == 45
  || c >= 97 && c <= 122
  || c >= 65 && c <= 90
  || c >= 48 && c <= 57

allNameC : String -> Int -> Bool
allNameC s i =
  if i >= strLength s then True else nameC (charCode s i) && allNameC s (i + 1)

isName : String -> Bool
isName x = strLength x > 0 && allNameC x 0

-- (a module's alias is capitalised, a name of its own: `M`)
isAlias : String -> Bool
isAlias x =
  strLength x > 0
  && charCode x 0 >= 65
  && charCode x 0 <= 90
  && not (contains "." x)
  && isName x

spacesOf : Int -> String
spacesOf n = if n <= 0 then "" else " " ++ spacesOf (n - 1)

blankOne : String -> Import -> String
blankOne s imp =
  strSlice s 0 imp.span.start
  ++ spacesOf (imp.span.end - imp.span.start)
  ++ strSlice s imp.span.end (strLength s)

-- (the words of an import line after `import `, empties dropped)
importWords : String -> List String
importWords rest = filter (\w -> strLength w > 0) (split " " (trim rest))

oneImport : Int -> Int -> List String -> Maybe Import
oneImport i e (Cons m Nil) =
  if isName m
    then Just { name = m, alias = Nothing, span = { start = i, end = e } }
  else Nothing
oneImport i e (Cons m (Cons kw (Cons a Nil))) =
  if strEq kw "as" && isName m && isAlias a
    then Just { name = m, alias = Just a, span = { start = i, end = e } }
  else Nothing
oneImport i e ws = Nothing

emptyOrComment : String -> Bool
emptyOrComment line =
  strLength (trim line) == 0 || strEq (strSlice (trim line) 0 2) "--"

readGo : String -> Int -> List Import -> List Import
readGo src i acc =
  if i >= strLength src then reverse acc
  else if emptyOrComment (strSlice src i (lineEndFrom src i))
    then readGo src (min (strLength src) (lineEndFrom src i + 1)) acc
  else if strEq (strSlice src i (i + 7)) "import "
    then (case oneImport
            i
            (lineEndFrom src i)
            (importWords (strSlice src (i + 7) (lineEndFrom src i))) of
          Just imp ->
            readGo
              src
              (min (strLength src) (lineEndFrom src i + 1))
              (Cons imp acc)
          Nothing -> reverse acc)
  else reverse acc

mkHeader : String -> List Import -> Header
mkHeader src imps = { imports = imps, text = foldl blankOne src imps }

-- | The imports of a file, and its text with the import lines blanked out.
readImports : String -> Header
readImports src = mkHeader src (readGo src 0 Nil)

-- (an `import` pseudo-token at each import's place, among the tokens)
importTok : Import -> L.Tok
importTok imp =
  { kind = "import"
  , text = ""
  , start = imp.span.start
  , end = imp.span.end
  , line = 0
  , col = 0
  , first = True
  }

tokLe : L.Tok -> L.Tok -> Bool
tokLe a b = a.start <= b.start

-- | The tokens with the imports' pseudo-tokens in place, in source order.
withImports : List Import -> List L.Tok -> List L.Tok
withImports imps toks = sortBy tokLe (concatList (map importTok imps) toks)

importName : Import -> String
importName imp = imp.name

importNames : Header -> List String
importNames h = map importName h.imports

headerText : Header -> String
headerText h = h.text

test headers

-- >>> importNames (readImports "import a\nimport b as B\n\nf = 1")
-- Cons "a" (Cons "b" Nil)

-- >>> headerText (readImports "import a\nf = 1")
-- "        \nf = 1"

-- >>> importNames (readImports "-- c\nimport a.b\nf = 1")
-- Cons "a.b" Nil

-- >>> importNames (readImports "f = 1\nimport a")
-- Nil
