-- Tokens and comments together, for the formatter.  Each token gets its
-- place (`ix`), its text as written (`raw`), and whether a blank line is
-- before it; each comment is attached to a token -- leading it on lines of
-- its own, inline just before it, or trailing it on its line.

import prelude
import array as A
import map as M
import heff.fixity as F
import heff.fmt.lex as L

-- | A token: `raw` is its text as written, `ix` its place, `blank` whether
-- | a blank line is before it.
type T =
  { kind : String
  , text : String
  , raw : String
  , start : Int
  , end : Int
  , col : Int
  , first : Bool
  , ix : Int
  , blank : Bool
  }

-- | A comment on lines of its own, before a token.
type Cmt = { text : String, blank : Bool }

-- | `src`: the text; `lead`: the comments on lines of their own before a
-- | token; `inline`: those just before it, on its line; `trail`: the
-- | comment after it, on its line; `noLead`: the token whose leading
-- | comments are already laid out (by the item it starts), `noTrail` the
-- | token whose trailing comment is (by the item it ends); `fix`: the
-- | fixities in scope, how a chain of operators is cut.
type Env =
  { src : String
  , lead : M.Map Int (List Cmt)
  , inline : M.Map Int (List String)
  , trail : M.Map Int String
  , noLead : Int
  , noTrail : Int
  , fix : F.Fixities
  }

type Attached = { toks : Array T, env : Env }

-- (a token or a comment, in source order, with the lines it starts and
-- ends on)
type Elem =
  { start : Int
  , end : Int
  , tok : Maybe L.Tok
  , text : String
  , startLine : Int
  , endLine : Int
  }

type LastTok = { ix : Int, line : Int }

-- (the fold's state: `toks`, `pending` and `inl` are kept last first)
type StA =
  { prevEnd : Int
  , n : Int
  , toks : List T
  , pending : List Cmt
  , inl : List String
  , lead : M.Map Int (List Cmt)
  , inline : M.Map Int (List String)
  , trail : M.Map Int String
  , lastTok : Maybe LastTok
  , k : Int
  }

countNl : String -> Int -> Int -> Int
countNl s a b =
  if a >= b then 0
  else (if charCode s a == 10 then 1 else 0) + countNl s (a + 1) b

dummy : Int -> T
dummy ix =
  { kind = "eof"
  , text = ""
  , raw = ""
  , start = 0
  , end = 0
  , col = 0
  , first = True
  , ix = ix
  , blank = False
  }

elemLe : Elem -> Elem -> Bool
elemLe a b = a.start <= b.start

-- (a token starting on `line`)
tokOnLine : Elem -> Int -> Bool
tokOnLine n line = maybe False (\_ -> n.startLine == line) n.tok

-- (`{- -}` just before a token on its line is inline, before that token)
inlineAt : Array Elem -> Int -> Elem -> Bool
inlineAt elems k e =
  strEq (strSlice e.text 0 2) "{-"
  && (if k + 1 < A.length elems then tokOnLine (A.index elems (k + 1)) e.endLine
      else False)

-- (the comment after a token on its line trails it; two of them join)
addTrail : M.Map Int String -> Int -> String -> M.Map Int String
addTrail m ix text = case M.lookup compareInt ix m of
  Nothing -> M.insert compareInt ix text m
  Just old -> M.insert compareInt ix (old ++ " " ++ text) m

stepTok : String -> StA -> Elem -> Bool -> L.Tok -> StA
stepTok src st e blank t =
  { prevEnd = e.endLine
  , n = st.n + 1
  , toks =
      Cons
        { kind = t.kind
        , text = t.text
        , raw =
            if strEq t.kind "import" then trim (strSlice src t.start t.end)
            else strSlice src t.start t.end
        , start = t.start
        , end = t.end
        , col = t.col
        , first = t.first
        , ix = st.n
        , blank = blank
        }
        st.toks
  , pending = Nil
  , inl = Nil
  , lead =
      if null st.pending then st.lead
      else M.insert compareInt st.n (reverse st.pending) st.lead
  , inline =
      if null st.inl then st.inline
      else M.insert compareInt st.n (reverse st.inl) st.inline
  , trail = st.trail
  , lastTok = Just { ix = st.n, line = e.endLine }
  , k = st.k + 1
  }

stepInline : StA -> Elem -> StA
stepInline st e =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = st.pending
  , inl = Cons e.text st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = st.trail
  , lastTok = st.lastTok
  , k = st.k + 1
  }

stepTrail : StA -> Elem -> LastTok -> StA
stepTrail st e lt =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = st.pending
  , inl = st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = addTrail st.trail lt.ix e.text
  , lastTok = Just { ix = lt.ix, line = e.endLine }
  , k = st.k + 1
  }

stepLead : StA -> Elem -> Bool -> StA
stepLead st e blank =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = Cons { text = e.text, blank = blank } st.pending
  , inl = st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = st.trail
  , lastTok = st.lastTok
  , k = st.k + 1
  }

-- (a comment neither inline nor trailing leads the next token, on lines of
-- its own)
stepCmt : Array Elem -> StA -> Elem -> Bool -> StA
stepCmt elems st e blank =
  if inlineAt elems st.k e then stepInline st e
  else case st.lastTok of
    Just lt ->
      if lt.line == e.startLine && null st.pending && null st.inl
        then stepTrail st e lt
      else stepLead st e blank
    Nothing -> stepLead st e blank

step : String -> Array Elem -> StA -> Elem -> StA
step src elems st e = case e.tok of
  Just t ->
    stepTok src st e (st.prevEnd >= 0 && e.startLine - st.prevEnd >= 2) t
  Nothing ->
    stepCmt elems st e (st.prevEnd >= 0 && e.startLine - st.prevEnd >= 2)

tokElem : L.Tok -> Elem
tokElem t =
  { start = t.start
  , end = t.end
  , tok = Just t
  , text = ""
  , startLine = 0
  , endLine = 0
  }

cmtElem : L.Cmt -> Elem
cmtElem c =
  { start = c.start
  , end = c.end
  , tok = Nothing
  , text = c.text
  , startLine = 0
  , endLine = 0
  }

type Lined = { line : Int, offset : Int, out : List Elem }

lineElem : String -> Lined -> Elem -> Lined
lineElem src acc e =
  { line = acc.line + countNl src acc.offset e.start + countNl src e.start e.end
  , offset = e.end
  , out =
      Cons
        { start = e.start
        , end = e.end
        , tok = e.tok
        , text = e.text
        , startLine = acc.line + countNl src acc.offset e.start
        , endLine =
            acc.line
            + countNl src acc.offset e.start
            + countNl src e.start e.end
        }
        acc.out
  }

emptyStA : StA
emptyStA =
  { prevEnd = -1
  , n = 0
  , toks = Nil
  , pending = Nil
  , inl = Nil
  , lead = M.empty
  , inline = M.empty
  , trail = M.empty
  , lastTok = Nothing
  , k = 0
  }

runSteps : String -> Array Elem -> StA
runSteps src elems = A.foldl (step src elems) emptyStA elems

finish : String -> StA -> Attached
finish src r =
  { toks = A.fromList (reverse r.toks)
  , env =
      { src = src
      , lead = r.lead
      , inline = r.inline
      , trail = r.trail
      , noLead = -1
      , noTrail = -1
      , fix = F.emptyFixities
      }
  }

linedOut : Lined -> List Elem
linedOut l = l.out

lineElems : String -> List Elem -> List Elem
lineElems src es =
  linedOut (foldl (lineElem src) { line = 0, offset = 0, out = Nil } es)

-- | Tokens and comments together, in order: each token with its `ix` and
-- | `raw`, each comment attached as leading, inline or trailing.
attach : String -> List L.Tok -> List L.Cmt -> Attached
attach src toks comments =
  finish
    src
    (runSteps
       src
       (A.fromList
          (reverse
             (lineElems
                src
                (sortBy
                   elemLe
                   (concatList (map tokElem toks) (map cmtElem comments)))))))

-- | the tokens alone, to be read and not laid out: each its place, no
-- | comment attached (`raw` is the token's text)
plainGo : Int -> List T -> List L.Tok -> List T
plainGo n acc Nil = reverse acc
plainGo n acc (Cons t rest) =
  plainGo
    (n + 1)
    (Cons
       { kind = t.kind
       , text = t.text
       , raw = t.text
       , start = t.start
       , end = t.end
       , col = t.col
       , first = t.first
       , ix = n
       , blank = False
       }
       acc)
    rest

plain : List L.Tok -> Array T
plain toks = A.fromList (plainGo 0 Nil toks)

-- The doctests: lex a text, attach, and show what got attached where.

cmtText : Cmt -> String
cmtText c = c.text

leadTexts : Attached -> Int -> List String
leadTexts at ix =
  map cmtText (fromMaybe Nil (M.lookup compareInt ix at.env.lead))

inlineTexts : Attached -> Int -> List String
inlineTexts at ix = fromMaybe Nil (M.lookup compareInt ix at.env.inline)

trailText : Attached -> Int -> String
trailText at ix = fromMaybe "" (M.lookup compareInt ix at.env.trail)

tokRaw : T -> String
tokRaw t = t.raw

raws : Attached -> List String
raws at = map tokRaw (A.toList at.toks)

attachLexed : String -> L.Lexed -> Attached
attachLexed src l = attach src l.tokens l.comments

attached : String -> Attached
attached src = attachLexed src (L.lex src)

test attaching

-- >>> raws (attached "f = 1 + 1")
-- Cons "f" (Cons "=" (Cons "1" (Cons "+" (Cons "1" (Cons "" Nil)))))

-- >>> leadTexts (attached "-- a\n-- b\nf = 1") 0
-- Cons "-- a" (Cons "-- b" Nil)

-- >>> trailText (attached "f = 1 -- t") 2
-- "-- t"

-- >>> inlineTexts (attached "f = {- i -} 1") 2
-- Cons "{- i -}" Nil

-- >>> trailText (attached "f = 1 -- t {- u -}") 2
-- "-- t {- u -}"
