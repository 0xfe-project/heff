-- Computing at compile time what is known then: β-reduction, the definitions that are not
-- recursive inlined (when that makes the code no bigger than a little),
-- a field of a known record, the arm of a match on a known tag.
--
-- Hippogriff's programs are pure, but for `abandon` and divergence, and
-- they are call-by-value: what is computed is computed, in order, even
-- if no one uses it.  So only what cannot fail (`pure`: a value, of
-- globals that cannot) is dropped where no one uses it, or moved to
-- where it is used; what could fail stays where it was.

import heff.ir as I
import heff.prims as Pr
import heff.spec as Sp
import map as M
import prelude

-- | how much bigger than what it replaces an inlined definition may
-- | make the code
budget : Int
budget = 24

-- | what a known definition, given all its arguments and none it can
-- | compute with, came to: those arguments as its parameters, or not
-- | inlined
data Plain = Inlined (List String) I.Expr | NotInlined

-- | specialisation: every definition so far small enough to be copied
-- | (those calling themselves too), those that are functions or records
-- | (whatever their size), the copies made (by what they were made
-- | for), those made for the definition at hand (the last first), how
-- | many there are, and the definitions whose copies are being made,
-- | one inside the other
type Specs =
  { all : M.Map String I.Expr
  , kinds : M.Map String Unit
  , specs : M.Map String String
  , made : List I.Def
  , count : Int
  , within : List String
  , trying : Int
  }

type St =
  { supply : Int
  , fuel : Int
  , defs : M.Map String I.Expr
  , safe : M.Map String Unit
  , total : M.Map String Int
  , plain : M.Map String Plain
  , sp : Specs
  }

withSp : Specs -> St -> St
withSp p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , total = s.total
  , plain = s.plain
  , sp = p
  }

withSupply : Int -> St -> St
withSupply n s =
  { supply = n
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  }

withFuel : Int -> St -> St
withFuel f s =
  { supply = s.supply
  , fuel = f
  , defs = s.defs
  , safe = s.safe
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  }

withSafe : String -> St -> St
withSafe k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = M.insert compareString k MkUnit s.safe
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  }

withPlain : String -> Plain -> St -> St
withPlain k p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , total = s.total
  , plain = M.insert compareString k p s.plain
  , sp = s.sp
  }

withDefs : M.Map String I.Expr -> St -> St
withDefs d s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = d
  , safe = s.safe
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  }

type M a = St -> Pair a St

bindTake : {a b : Type} -> (a -> M b) -> Pair a St -> Pair b St
bindTake f (MkPair x s) = f x s

bind : {a b : Type} -> M a -> (a -> M b) -> M b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> M a
pure x = \s -> MkPair x s

get : M St
get = \s -> MkPair s s

put : St -> M Unit
put s' = \s -> MkPair MkUnit s'

setFuel : Int -> M Unit
setFuel f = \s -> MkPair MkUnit (withFuel f s)

traverseS : {a b : Type} -> (a -> M b) -> List a -> M (List b)
traverseS f Nil = pure Nil
traverseS f (Cons x xs) = do
  y <- f x
  ys <- traverseS f xs
  pure (Cons y ys)

fieldsS : (I.Expr -> M I.Expr)
        -> List (Pair String I.Expr)
        -> M (List (Pair String I.Expr))
fieldsS f fs =
  traverseS
    (\p -> case p of
     MkPair l e -> do
       e' <- f e
       pure (MkPair l e'))
    fs

armsS : (I.Expr -> M I.Expr) -> List I.Arm -> M (List I.Arm)
armsS f arms =
  traverseS
    (\a -> case a of
     MkArm t vs b -> do
       b' <- f b
       pure (MkArm t vs b'))
    arms

appendL : {a : Type} -> List a -> List a -> List a
appendL Nil ys = ys
appendL (Cons x xs) ys = Cons x (appendL xs ys)

elemStr : String -> List String -> Bool
elemStr x Nil = False
elemStr x (Cons y ys) = strEq x y || elemStr x ys

zipL : {a b : Type} -> List a -> List b -> List (Pair a b)
zipL (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipL xs ys)
zipL _ _ = Nil

takeL : {a : Type} -> Int -> List a -> List a
takeL n Nil = Nil
takeL n (Cons x xs) = if n <= 0 then Nil else Cons x (takeL (n - 1) xs)

dropL : {a : Type} -> Int -> List a -> List a
dropL n Nil = Nil
dropL n (Cons x xs) = if n <= 0 then Cons x xs else dropL (n - 1) xs

minI : Int -> Int -> Int
minI a b = if a <= b then a else b

-- | the bindings, each around the next, around the body
letsOf : List (Pair String I.Expr) -> I.Expr -> I.Expr
letsOf Nil body = body
letsOf (Cons (MkPair x a) rest) body = ELet x a (letsOf rest body)

-- (an attempt undone: the names drawn and the fuel burnt kept)
restore : St -> St -> St
restore saved st =
  { supply = st.supply
  , fuel = st.fuel
  , defs = saved.defs
  , safe = saved.safe
  , total = saved.total
  , plain = st.plain
  , sp = st.sp
  }

copyTake : St -> Pair I.Expr Int -> Pair I.Expr St
copyTake s (MkPair e' n) = MkPair e' (withSupply n s)

copy : I.Expr -> M I.Expr
copy e = \s -> copyTake s (I.freshen s.supply e)

-- | a definition's body, to inline (a copy), if it may be
known : String -> M (Maybe I.Expr)
known g = do
  s <- get
  case M.lookup compareString g s.defs of
    Just b ->
      if s.fuel > 0
        then do
          u <- put (withFuel (s.fuel - 1) s)
          e <- copy b
          pure (Just e)
      else pure Nothing
    Nothing -> pure Nothing

-- | try an inlining: keep it if it is small enough
-- (inside an attempt, copies are not made, only those made taken: an
-- attempt is often undone, and the copies made for it with it.  The
-- second pass over a definition makes them where the first inlined)
trying : Int -> M Unit
trying d = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , specs = s.sp.specs
         , made = s.sp.made
         , count = s.sp.count
         , within = s.sp.within
         , trying = s.sp.trying + d
         }
         s)

attempt : I.Expr -> M I.Expr -> M I.Expr
attempt orig m = do
  saved <- get
  u0 <- trying 1
  e <- m
  u1 <- trying (0 - 1)
  if I.size e <= I.size orig + budget then pure e
    else do
      -- (the names drawn stay drawn: no name is ever given out twice.
      -- And the fuel burnt stays burnt: a speculation that did not pay
      -- is not free to try again inside every caller -- refunding it
      -- made the simplifier exponential on a file of record-tied
      -- definitions)
      st <- get
      u <- put (restore saved st)
      pure orig

type SG = { safe : M.Map String Unit, total : M.Map String Int }

-- | what cannot fail: evaluating it gives a value, at once.  A
-- | projection is of a record, always there; an application of a
-- | `total` function up to its arity builds a closure or its pure body
-- | the primitives that may fail (abandon), or call what may
failing : List String
failing =
  [ "intDiv"
  , "intMod"
  , "floatFloor"
  , "arrayIndex"
  , "arraySet"
  , "arrayGenerate"
  , "perform"
  ]

pureIn : M.Map String Unit -> M.Map String Int -> I.Expr -> Bool
pureIn safe total e = case e of
  EVar _ -> True
  EGlobal g -> M.member compareString g safe
  ELam _ _ -> True
  ERecord fs ->
    I.allI
      (map
         (\p -> case p of
          MkPair _ e2 -> pureIn safe total e2)
         fs)
  ETag _ as -> I.allI (map (\a -> pureIn safe total a) as)
  EProj e2 _ -> pureIn safe total e2
  EApp (EGlobal g) as -> case M.lookup compareString g total of
    Just ar -> length as <= ar && I.allI (map (\a -> pureIn safe total a) as)
    Nothing -> False
  ECall g as -> case M.lookup compareString g total of
    Just ar -> length as <= ar && I.allI (map (\a -> pureIn safe total a) as)
    Nothing -> False
  EPrimCall p as ->
    not (elemStr p failing) && I.allI (map (\a -> pureIn safe total a) as)
  EPrim _ -> True
  EInt _ -> True
  EFloat _ -> True
  EStr _ -> True
  _ -> False

flatCons : List String -> Pair (List String) I.Expr -> Pair (List String) I.Expr
flatCons xs (MkPair ys b) = MkPair (appendL xs ys) b

-- (lambdas in lambdas, one parameter list)
flat : I.Expr -> Pair (List String) I.Expr
flat (ELam xs b) = flatCons xs (flat b)
flat b = MkPair Nil b

sgFlat : SG -> String -> Pair (List String) I.Expr -> SG
sgFlat acc key (MkPair xs b) =
  if length xs > 0
    then if pureIn acc.safe acc.total b && not (elemStr key (I.globalsIn b))
        then { safe = M.insert compareString key MkUnit acc.safe
             , total = M.insert compareString key (length xs) acc.total
             }
      else { safe = M.insert compareString key MkUnit acc.safe
           , total = acc.total
           }
  else if pureIn acc.safe acc.total b && not (elemStr key (I.globalsIn b))
    then { safe = M.insert compareString key MkUnit acc.safe
         , total = acc.total
         }
  else acc

-- | the globals that cannot fail when used: functions, and values of
-- | such globals (each definition after those it uses; one using itself
-- | is not).  `total`: the functions whose application cannot fail
-- | either -- their body is pure under the lambdas (erased statics,
-- | record builders such as co.hf's `plus`) -- with their arity
safeGlobals : List I.Def -> SG
safeGlobals defs =
  foldl
    (\acc (d : I.Def) -> sgFlat acc d.key (flat d.body))
    { safe = M.empty, total = M.empty }
    defs

-- | a known function given fewer arguments than it takes (each pure):
-- | it only builds a closure
partialOf : St -> List I.Expr -> Maybe I.Expr -> Bool
partialOf s as (Just (ELam xs _)) =
  length as < length xs && I.allI (map (pureIn s.safe s.total) as)
partialOf s as _ = False

partialHead : St -> List I.Expr -> I.Expr -> Bool
partialHead s as (EGlobal g) = partialOf s as (M.lookup compareString g s.sp.all)
partialHead s as _ = False

partialIn : St -> I.Expr -> Bool
partialIn s (EApp f as) = partialHead s as f
partialIn s _ = False

isPure : I.Expr -> M Bool
isPure e = \s -> MkPair (pureIn s.safe s.total e || partialIn s e) s

atomic : I.Expr -> Bool
atomic e = case e of
  EVar _ -> True
  EGlobal _ -> True
  EInt _ -> True
  EFloat _ -> True
  EStr _ -> True
  EPrim _ -> True
  _ -> False

allAtomic : List I.Expr -> Bool
allAtomic as = I.allI (map (\a -> atomic a) as)

-- Constant folding
--------------------------------------------------------------------------------

boolE : Bool -> I.Expr
boolE b = ETag (if b then "True" else "False") Nil

-- | a primitive of two integers, computed (those that cannot fail)
intOp : String -> Int -> Int -> Maybe I.Expr
intOp p a b =
  if strEq p "intAdd" then Just (EInt (a + b))
  else if strEq p "intSub" then Just (EInt (a - b))
  else if strEq p "intMul" then Just (EInt (a * b))
  else if strEq p "intEq" then Just (boolE (a == b))
  else if strEq p "intLt" then Just (boolE (a < b))
  else if strEq p "intLe" then Just (boolE (a <= b))
  else Nothing

-- | ... of two strings
strOp : String -> String -> String -> Maybe I.Expr
strOp p a b =
  if strEq p "strAppend" then Just (EStr (a ++ b))
  else if strEq p "strEq" then Just (boolE (strEq a b))
  else Nothing

-- | ... of one
unOp : String -> I.Expr -> Maybe I.Expr
unOp p (EInt a) = if strEq p "intShow" then Just (EStr (showInt a)) else Nothing
unOp p (EStr a) =
  if strEq p "strLength" then Just (EInt (strLength a)) else Nothing
unOp p _ = Nothing

binOp : String -> I.Expr -> I.Expr -> Maybe I.Expr
binOp p (EInt a) (EInt b) = intOp p a b
binOp p (EStr a) (EStr b) = strOp p a b
binOp p _ _ = Nothing

foldArgs : String -> List I.Expr -> Maybe I.Expr
foldArgs p (Cons a Nil) = unOp p a
foldArgs p (Cons a (Cons b Nil)) = binOp p a b
foldArgs p _ = Nothing

-- | a primitive's call: its value, if its arguments are literals
foldPrim : String -> List I.Expr -> I.Expr
foldPrim p as = fromMaybe (EPrimCall p as) (foldArgs p as)

-- | a primitive given its arguments: a call of it, once they are all
-- | there (what the other judgments know a primitive's computation by;
-- | `heff.arity` does the same for the definitions, whose parameters are
-- | not known until the simplifier is done)
primAppN : String -> List I.Expr -> Maybe Int -> I.Expr
primAppN p as (Just n) =
  if length as == n then foldPrim p as
  else if length as > n then EApp (foldPrim p (takeL n as)) (dropL n as)
  else EApp (EPrim p) as
primAppN p as Nothing = EApp (EPrim p) as

primApp : String -> List I.Expr -> I.Expr
primApp p as = primAppN p as (Pr.primArity p)

-- | an application, in the form the simplifier keeps every one in:
-- | its head not an application (`(f a) b` is `f a b`), and a primitive
-- | given all its arguments a call of it.  Every application the
-- | simplifier makes is made by this, so no judgment need look for
-- | another form (a primitive applied, not called: `cheap` would not
-- | know it)
mkApp : I.Expr -> List I.Expr -> I.Expr
mkApp f Nil = f
mkApp (EApp g bs) as = mkApp g (appendL bs as)
mkApp (EPrim p) as = primApp p as
mkApp f as = EApp f as

-- >>> mkApp (EApp (EPrim "intLe") [EVar "n"]) [EInt 0]
-- EPrimCall "intLe" [EVar "n", EInt 0]

-- | `x` replaced by `a`, a copy of it for each occurrence
substCopies : String -> I.Expr -> I.Expr -> M I.Expr
substCopies x a e = case e of
  EVar y -> if strEq y x then copy a else pure (EVar y)
  ELam xs b -> do
    b' <- substCopies x a b
    pure (ELam xs b')
  EApp f as -> do
    f' <- substCopies x a f
    as' <- traverseS (\q -> substCopies x a q) as
    pure (mkApp f' as')
  ELet y e2 b -> do
    e2' <- substCopies x a e2
    b' <- substCopies x a b
    pure (ELet y e2' b')
  ERecord fs -> do
    fs' <- fieldsS (\q -> substCopies x a q) fs
    pure (ERecord fs')
  EProj e2 l -> do
    e2' <- substCopies x a e2
    pure (EProj e2' l)
  ETag t as -> do
    as' <- traverseS (\q -> substCopies x a q) as
    pure (ETag t as')
  EMatch s arms -> do
    s' <- substCopies x a s
    arms' <- armsS (\q -> substCopies x a q) arms
    pure (EMatch s' arms')
  EPrimCall p as -> do
    as' <- traverseS (\q -> substCopies x a q) as
    pure (EPrimCall p as')
  ECall g as -> do
    as' <- traverseS (\q -> substCopies x a q) as
    pure (ECall g as')
  _ -> pure e

-- | (lambdas in lambdas are one lambda)
lam : List String -> I.Expr -> I.Expr
lam xs e = case e of
  ELam ys b -> ELam (appendL xs ys) b
  _ -> ELam xs e

-- | the judgments, knotted
type SK =
  { simp : I.Expr -> M I.Expr
  , applyTo : I.Expr -> List I.Expr -> M I.Expr
  , project : String -> I.Expr -> M I.Expr
  , match : I.Expr -> List I.Arm -> M I.Expr
  }

occCountOf : String -> I.Expr -> Int
occCountOf x b = (I.occurrences x b).count

singletonM : String -> I.Expr -> M.Map String I.Expr
singletonM x a = M.insert compareString x a M.empty

letPure : SK -> String -> I.Expr -> I.Expr -> Int -> M I.Expr
letPure r x a b o =
  if o == 0 then r.simp b
  else if atomic a || o == 1 then r.simp (I.subst (singletonM x a) b)
  else if I.isValue a && I.size a <= 12
    then do
      b' <- substCopies x a b
      r.simp b'
  else do
    b' <- r.simp b
    pure (ELet x a b')

-- | a binding, its value simplified: what could fail is computed where
-- | it was, used or not
letIn : SK -> String -> I.Expr -> I.Expr -> M I.Expr
letIn r x a b = do
  p <- isPure a
  if not p
      then do
        b' <- r.simp b
        pure (ELet x a b')
    else letPure r x a b (occCountOf x b)

-- | `g` is a function known to take more than `n` arguments: given
-- | `n`, it only builds a closure
takesMore : St -> String -> Int -> Bool
takesMore s g n = case M.lookup compareString g s.defs of
  Just (ELam xs _) -> length xs > n
  _ -> False

-- (the arguments are the parameters, in order)
paramsAre : List String -> List I.Expr -> Bool
paramsAre Nil Nil = True
paramsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && paramsAre xs es
paramsAre _ _ = False

-- (a function that is a value already, and none of the parameters: a
-- variable, or a definition made already -- not the one being made,
-- `f x = f x`, which as `f = f` would be a value defined by itself)
etaHead : M.Map String Unit -> List String -> I.Expr -> Bool
etaHead kinds xs (EVar y) = not (elemStr y xs)
etaHead kinds xs (EGlobal g) = M.member compareString g kinds
etaHead kinds xs _ = False

-- | `\x y -> f x y` is `f`, where `f` is a value: a variable or a
-- | definition (the language is pure, and `f` computes nothing)
eta : M.Map String Unit -> I.Expr -> I.Expr
eta kinds (ELam xs (EApp f as)) =
  if paramsAre xs as && etaHead kinds xs f then f else ELam xs (EApp f as)
eta kinds e = e

simpF : SK -> I.Expr -> M I.Expr
simpF r e = case e of
  ELam xs b -> do
    b' <- r.simp b
    s <- get
    pure (eta s.sp.kinds (lam xs b'))
  -- (a call given its arguments a few at a time, `(g a) b`, is `g a b`
  -- where `g a` only builds a closure: the same computed in the same
  -- order, and the call seen whole)
  EApp (EApp (EGlobal g) bs) as -> do
    s <- get
    if takesMore s g (length bs) then r.simp (EApp (EGlobal g) (appendL bs as))
      else do
        f' <- r.simp (EApp (EGlobal g) bs)
        as' <- traverseS (\a -> r.simp a) as
        r.applyTo f' as'
  EApp f as -> do
    f' <- r.simp f
    as' <- traverseS (\a -> r.simp a) as
    r.applyTo f' as'
  ELet x a b -> do
    a' <- r.simp a
    letIn r x a' b
  ERecord fs -> do
    fs' <- fieldsS (\a -> r.simp a) fs
    pure (ERecord fs')
  EProj e2 l -> do
    e2' <- r.simp e2
    r.project l e2'
  ETag t as -> do
    as' <- traverseS (\a -> r.simp a) as
    pure (ETag t as')
  EMatch s arms -> do
    s' <- r.simp s
    arms' <- armsS (\a -> r.simp a) arms
    r.match s' arms'
  EPrimCall p as -> do
    as' <- traverseS (\a -> r.simp a) as
    pure (foldPrim p as')
  _ -> pure e

-- | an argument that tells a body nothing to compute with
opaque : I.Expr -> Bool
opaque e = case e of
  EVar _ -> True
  EInt _ -> True
  EFloat _ -> True
  EStr _ -> True
  _ -> False

allOpaque : List I.Expr -> Bool
allOpaque as = I.allI (map (\a -> opaque a) as)

-- | the most a definition's body may be for an inlining to be tried:
-- | copying and simplifying a bigger one, to find it too big, was most of
-- | what the simplifier did
inlineMax : Int
inlineMax = 50

tooBig : String -> St -> Bool
tooBig g s = case M.lookup compareString g s.defs of
  Just b -> I.size b > inlineMax
  Nothing -> False

-- | a known definition, inlined if it may be, and the result simplified
inlineCall : SK -> I.Expr -> String -> List I.Expr -> M I.Expr
inlineCall r f g as = do
  s <- get
  if tooBig g s then pure (mkApp f as)
    else do
      mb <- known g
      case mb of
        Just b -> attempt (mkApp f as) (r.applyTo b as)
        Nothing -> pure (mkApp f as)

paramsTo : List String -> List I.Expr -> M.Map String I.Expr
paramsTo xs as =
  foldl (\m p -> M.insert compareString (fst p) (snd p) m) M.empty (zipL xs as)

freshParam : String -> Pair (List String) Int -> Pair (List String) Int
freshParam base (MkPair xs n) = case I.fresh base n of
  MkPair x n2 -> MkPair (Cons x xs) n2

freshParams : Int -> M (List String)
freshParams k = \s -> case foldl
    (\acc i -> freshParam "p" acc)
    (MkPair Nil s.supply)
    (range 1 k) of
  MkPair xs n -> MkPair xs (withSupply n s)

plainKey : String -> List I.Expr -> String
plainKey g as = g ++ "/" ++ showInt (length as)

-- | (taken from what was found, so long as the fuel lasted it out)
remember : String -> Plain -> M Unit
remember k p = \s -> MkPair MkUnit (if s.fuel > 0 then withPlain k p s else s)

-- | a known definition given all its arguments, none of which it can
-- | compute with: what the call comes to is the same whatever they are,
-- | so it is found once -- for parameters of its own -- and kept, the
-- | arguments put in for them where it is used again.  (Each such call
-- | copied and simplified the body again, and most were thrown away.)
plainCall : SK -> I.Expr -> String -> List I.Expr -> M I.Expr
plainCall r f g as = do
  s <- get
  case M.lookup compareString (plainKey g as) s.plain of
    Just NotInlined -> pure (mkApp f as)
    Just (Inlined ps e) ->
      if s.fuel > 0
        then do
          u <- put (withFuel (s.fuel - 1) s)
          e2 <- copy e
          pure (I.subst (paramsTo ps as) e2)
      else pure (mkApp f as)
    Nothing -> do
      ps <- freshParams (length as)
      mb <- known g
      case mb of
        Just b -> do
          e <- r.applyTo b (map (\x -> EVar x) ps)
          if I.size e <= I.size (mkApp f as) + budget
              then do
                u <- remember (plainKey g as) (Inlined ps e)
                pure (I.subst (paramsTo ps as) e)
            else do
              st <- get
              u <- put (restore s st)
              u2 <- remember (plainKey g as) NotInlined
              pure (mkApp f as)
        Nothing -> pure (mkApp f as)

-- | a known definition called: inlined if it may be
callOf : SK -> I.Expr -> String -> List I.Expr -> Maybe I.Expr -> M I.Expr
callOf r f g as (Just (ELam xs _)) =
  if allOpaque as && length xs == length as then plainCall r f g as
  else inlineCall r f g as
callOf r f g as _ = inlineCall r f g as

-- | a lambda applied: its parameters bound to the arguments (not
-- | simplified yet: `simp` does it once all are bound), and what is left
-- | applied to the rest
applyLam : SK -> List String -> I.Expr -> List I.Expr -> M I.Expr
applyLam r xs b as = do
  red <-
    r.simp
      (letsOf
         (zipL
            (takeL (minI (length xs) (length as)) xs)
            (takeL (minI (length xs) (length as)) as))
         (if length xs > minI (length xs) (length as)
            then ELam (dropL (minI (length xs) (length as)) xs) b
          else b))
  r.applyTo red (dropL (minI (length xs) (length as)) as)

-- (the expressions are the variables, in order)
varsAre : List String -> List I.Expr -> Bool
varsAre Nil Nil = True
varsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && varsAre xs es
varsAre _ _ = False

-- | a function that is another name for a tag, `\x y -> C x y`: the tag
tagOfLam : List String -> I.Expr -> Maybe String
tagOfLam xs (ETag t es) = if varsAre xs es then Just t else Nothing
tagOfLam xs _ = Nothing

-- Specialisation
--------------------------------------------------------------------------------

-- A known definition that is not inlined -- it calls itself, or is too
-- big -- given arguments known where it is called (a definition that is
-- a function or a record, a closed lambda or record) is called as a copy
-- of it made for them: their parameters gone, the arguments in their
-- place, the copy simplified with them (`e.hmap`, `hd.bind`, `r.simp`
-- known now: inlined, or calls of known definitions in turn).  A copy
-- is made once for each definition and arguments (alike up to the names
-- they bind, `Sp.key`), and comes just before the definition it was
-- first made for.  For a definition that calls itself, only the
-- parameters every call of itself hands on unchanged (`Sp.statics`):
-- its calls are of the copy then.

-- | the most that is made: the size of a known argument, of a definition
-- | copied, copies for one program, copies being made one inside another
specArgSize : Int
specArgSize = 60

specBodySize : Int
specBodySize = 1200

specLimit : Int
specLimit = 2000

specDepth : Int
specDepth = 16

-- | an argument a copy may be made for
knownArg : M.Map String Unit -> I.Expr -> Bool
knownArg kinds (EGlobal g) = M.member compareString g kinds
knownArg kinds (ELam xs b) =
  I.size (ELam xs b) <= specArgSize && Sp.closedIn Nil (ELam xs b)
knownArg kinds (ERecord fs) =
  I.size (ERecord fs) <= specArgSize && Sp.closedIn Nil (ERecord fs)
knownArg kinds _ = False

nthE : Int -> List I.Expr -> Maybe I.Expr
nthE i Nil = Nothing
nthE i (Cons x xs) = if i == 0 then Just x else nthE (i - 1) xs

markGo : M.Map String Unit -> List I.Expr -> List Bool -> Int -> List Bool
markGo all as Nil i = Nil
markGo all as (Cons st rest) i =
  Cons
    (st && maybe False (\a -> knownArg all a) (nthE i as))
    (markGo all as rest (i + 1))

-- | the parameters a copy is made for: known there, and handed on as
-- | they are if `g` calls itself
marksOf : M.Map String Unit -> String -> List String -> I.Expr -> List I.Expr -> List Bool
marksOf all g xs b as =
  markGo
    all
    as
    (if elemStr g (I.globalsIn b) then Sp.statics g xs b
     else map (\x -> True) xs)
    0

specKey : String -> List Bool -> List I.Expr -> String
specKey g marks as =
  g
  ++ "("
  ++ joinWith
    ","
    (zipWith (\m a -> if m then Sp.key a else "_") marks (takeL (length marks) as))
  ++ ")"

keepParams : List Bool -> List String -> List String
keepParams Nil xs = xs
keepParams (Cons m ms) Nil = Nil
keepParams (Cons m ms) (Cons x xs) =
  if m then keepParams ms xs else Cons x (keepParams ms xs)

-- | each marked parameter replaced by its argument, a copy each time
substMarked : List Bool -> List String -> List I.Expr -> I.Expr -> M I.Expr
substMarked (Cons m ms) (Cons x xs) (Cons a as) e =
  if m
    then do
      e2 <- substCopies x a e
      substMarked ms xs as e2
  else substMarked ms xs as e
substMarked _ _ _ e = pure e

pushSpec : String -> String -> M Unit
pushSpec k h = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , specs = M.insert compareString k h s.sp.specs
         , made = s.sp.made
         , count = s.sp.count + 1
         , within = Cons k s.sp.within
         , trying = s.sp.trying
         }
         s)

-- | a copy that is a function, or a value computing nothing, is safe
-- | to use anywhere, as the definitions it was made from were
-- | (`safeGlobals`)
markSafe : String -> I.Expr -> M Unit
markSafe h b = \s ->
    MkPair
      MkUnit
      (if I.isValue b || pureIn s.safe s.total b then withSafe h s else s)

popSpec : String -> I.Expr -> M Unit
popSpec h b = \s ->
    MkPair
      MkUnit
      (withSp
         { all = M.insert compareString h b s.sp.all
         , kinds = M.insert compareString h MkUnit s.sp.kinds
         , specs = s.sp.specs
         , made = Cons (I.mkDef h h b) s.sp.made
         , count = s.sp.count
         , within = drop 1 s.sp.within
         , trying = s.sp.trying
         }
         s)

-- | the copy's body: the parameters left, the calls of itself of it
specBody : String -> String -> List Bool -> List I.Expr -> I.Expr -> M I.Expr
specBody g h marks as (ELam xs1 b1) = do
  b2 <- substMarked marks xs1 as (Sp.selfTo g h marks b1)
  pure (if null (keepParams marks xs1) then b2
    else ELam (keepParams marks xs1) b2)
specBody g h marks as lam1 = pure lam1

-- Arity
--------------------------------------------------------------------------------

-- A function whose every way out is a lambda, `\n -> if n <= 0 then (\hd
-- k -> a) else (\hd k -> b)` -- a computation (`Co`), made of a few
-- arguments -- takes those lambdas' parameters as its own: `\n hd k ->
-- if n <= 0 then a else b`.  A call given them all is one call, and a
-- copy may be made for them (the handler: `hd.bind`, known).  Only what
-- is cheap is crossed -- a value bound, a test of what is at hand: it is
-- computed again each time the function is given its first arguments
-- and applied -- and nothing that may fail.

-- | computing it is little, and cannot fail
cheap : M.Map String Unit -> I.Expr -> Bool
cheap safe (EVar _) = True
cheap safe (EGlobal g) = M.member compareString g safe
cheap safe (ELam _ _) = True
cheap safe (EPrim _) = True
cheap safe (EInt _) = True
cheap safe (EFloat _) = True
cheap safe (EStr _) = True
cheap safe (ETag _ as) = I.allI (map (cheap safe) as)
cheap safe (ERecord fs) = I.allI (map (cheap safe) (map snd fs))
cheap safe (EProj e _) = cheap safe e
cheap safe (ELet _ a b) = cheap safe a && cheap safe b
cheap safe (EPrimCall p as) =
  not (elemStr p failing) && I.allI (map (cheap safe) as)
cheap safe _ = False

minL : List Int -> Int
minL Nil = 0
minL (Cons x xs) = foldl (\m y -> minI m y) x xs

-- | how many parameters every way out of it takes
lamsOut : M.Map String Unit -> I.Expr -> Int
lamsOut safe (ELam ys _) = length ys
lamsOut safe (ELet _ a b) = if cheap safe a then lamsOut safe b else 0
lamsOut safe (EMatch sc arms) =
  if cheap safe sc && not (null arms)
    then minL (map (lamsOut safe) (map I.armBody arms))
  else 0
lamsOut safe _ = 0

-- | each way out without its first lambdas, their parameters `zs`
stripArm : (I.Expr -> I.Expr) -> I.Arm -> I.Arm
stripArm go (MkArm t vs b) = MkArm t vs (go b)

stripLams : List String -> I.Expr -> I.Expr
stripLams zs (ELam ys b) =
  I.subst
    (paramsTo ys (map (\z -> EVar z) zs))
    (if length ys > length zs then ELam (dropL (length zs) ys) b else b)
stripLams zs (ELet x a b) = ELet x a (stripLams zs b)
stripLams zs (EMatch sc arms) = EMatch sc (map (stripArm (stripLams zs)) arms)
stripLams zs e = e

raiseWith : List String -> I.Expr -> List String -> I.Expr
raiseWith xs b zs = ELam (appendL xs zs) (stripLams zs b)

-- | a function, taking the parameters every way out of it does.  A
-- | definition that is not a function but whose every way out is a
-- | lambda past what is cheap -- a computation, `peek = let c = ... in
-- | \hd k -> ...` -- becomes one: what it computed once it computes at
-- | each call, which is little and cannot fail, and its handler is a
-- | parameter a copy can be made for
raise : I.Expr -> M I.Expr
raise (ELam xs b) = do
  s <- get
  if lamsOut s.safe b == 0 then pure (ELam xs b)
    else do
      zs <- freshParams (lamsOut s.safe b)
      pure (raiseWith xs b zs)
raise e = do
  s <- get
  if lamsOut s.safe e == 0 then pure e
    else do
      zs <- freshParams (lamsOut s.safe e)
      pure (ELam zs (stripLams zs e))

-- | a copy made: simplified with fuel of its own
makeSpec : SK -> String -> List String -> I.Expr -> List I.Expr -> List Bool -> String -> M I.Expr
makeSpec r g xs b as marks k = do
  s <- get
  u <- pushSpec k (g ++ "$s" ++ showInt s.sp.count)
  lam1 <- copy (ELam xs b)
  body0 <- specBody g (g ++ "$s" ++ showInt s.sp.count) marks as lam1
  u2 <- setFuel 4000
  body1 <- r.simp body0
  body2 <- r.simp body1
  body3 <- raise body2
  u3 <- setFuel s.fuel
  u4 <- popSpec (g ++ "$s" ++ showInt s.sp.count) body3
  u5 <- markSafe (g ++ "$s" ++ showInt s.sp.count) body3
  -- (the copy called, and a copy of it made if it may be, for what it
  -- takes now)
  r.applyTo (EGlobal (g ++ "$s" ++ showInt s.sp.count)) (Sp.dropAt marks as)

specMarked : SK -> String -> List String -> I.Expr -> List I.Expr -> List Bool -> St -> M I.Expr
specMarked r g xs b as marks s =
  if not (any (\m -> m) marks)
    || (null (keepParams marks xs) && elemStr g (I.globalsIn b))
    then pure (mkApp (EGlobal g) as)
  else case M.lookup compareString (specKey g marks as) s.sp.specs of
    Just h -> r.applyTo (EGlobal h) (Sp.dropAt marks as)
    Nothing ->
      if s.sp.trying > 0 then pure (mkApp (EGlobal g) as)
      else makeSpec r g xs b as marks (specKey g marks as)

specLam : SK -> String -> List String -> I.Expr -> List I.Expr -> M I.Expr
specLam r g xs b as = do
  s <- get
  if s.sp.count >= specLimit
    || length s.sp.within >= specDepth
    || not (any (\a -> knownArg s.sp.kinds a) as)
    then pure (mkApp (EGlobal g) as)
    else specMarked r g xs b as (marksOf s.sp.kinds g xs b as) s

-- | a call of a definition not inlined: of a copy of it, if one may be
-- | made
trySpec : SK -> String -> List I.Expr -> M I.Expr
trySpec r g as = do
  s <- get
  case M.lookup compareString g s.sp.all of
    Just (ELam xs b) -> specLam r g xs b as
    _ -> pure (mkApp (EGlobal g) as)

-- | whether it is still the call of `g` it was
stillCall : String -> I.Expr -> Bool
stillCall g (EApp (EGlobal h) _) = strEq g h
stillCall g _ = False

specAfter : SK -> String -> List I.Expr -> I.Expr -> M I.Expr
specAfter r g as e = if stillCall g e then trySpec r g as else pure e

fieldIn : String -> List (Pair String I.Expr) -> Maybe I.Expr
fieldIn l Nil = Nothing
fieldIn l (Cons (MkPair k v) rest) = if strEq k l then Just v else fieldIn l rest

-- | a field of a record that is a definition calling itself (one of
-- | knotted judgments, `sk.simp`): a copy of it, if it is a value
knownField : String -> String -> M (Maybe I.Expr)
knownField g l = do
  s <- get
  case M.lookup compareString g s.sp.all of
    Just (ERecord fs) -> case fieldIn l fs of
      Just v ->
        if I.isValue v && s.fuel > 0
          then do
            u <- put (withFuel (s.fuel - 1) s)
            e <- copy v
            pure (Just e)
        else pure Nothing
      Nothing -> pure Nothing
    _ -> pure Nothing

-- | an application of simplified parts
applyToF : SK -> I.Expr -> List I.Expr -> M I.Expr
applyToF r f as =
  if length as == 0 then pure f
  else case f of
    EPrim p -> pure (mkApp f as)
    EApp g bs -> r.applyTo g (appendL bs as)
    -- (another name for a tag, given all its arguments: the tag given
    -- them, with no bindings between -- the tag computes its fields in
    -- order, as the bindings would, and a call in a field stays where
    -- a loop can build the value)
    ELam xs (ETag t es) ->
      if length xs == length as && varsAre xs es then pure (ETag t as)
      else applyLam r xs (ETag t es) as
    ELam xs b -> applyLam r xs b as
    ELet x a b -> do
      b' <- r.applyTo b as
      pure (ELet x a b')
    -- (the arguments go into every arm: only when that copies nothing)
    EMatch s arms ->
      if allAtomic as
        then do
          arms' <- armsS (\b -> r.applyTo b as) arms
          pure (EMatch s arms')
      else pure (mkApp (EMatch s arms) as)
    EGlobal g -> do
      s <- get
      e1 <- callOf r f g as (M.lookup compareString g s.defs)
      specAfter r g as e1
    -- (a field of a known record, applied: judged by what the
    -- application comes to, not by the size of the field)
    EProj (EGlobal g) l -> do
      mb <- known g
      case mb of
        Just b ->
          attempt (mkApp f as) (do
          h <- r.project l b
          r.applyTo h as)
        Nothing -> do
          mv <- knownField g l
          case mv of
            Just v -> attempt (mkApp f as) (r.applyTo v as)
            Nothing -> pure (mkApp f as)
    _ -> pure (mkApp f as)

findField : String -> List (Pair String I.Expr) -> Maybe I.Expr
findField l Nil = Nothing
findField l (Cons (MkPair k v) rest) =
  if strEq k l then Just v else findField l rest

-- (the other fields are computed too: dropped only if they cannot fail)
othersPure : String -> List (Pair String I.Expr) -> M Bool
othersPure l Nil = pure True
othersPure l (Cons (MkPair k f) rest) =
  if strEq k l then othersPure l rest
  else do
    p <- isPure f
    if p then othersPure l rest else pure False

projectF : SK -> String -> I.Expr -> M I.Expr
projectF r l e = case e of
  ERecord fs -> case findField l fs of
    Just v -> do
      others <- othersPure l fs
      pure (if others then v else EProj (ERecord fs) l)
    Nothing -> pure (EProj (ERecord fs) l)
  ELet x a b -> do
    b' <- r.project l b
    pure (ELet x a b')
  EGlobal g -> do
    mb <- known g
    case mb of
      Just b -> attempt (EProj e l) (r.project l b)
      Nothing -> pure (EProj e l)
  _ -> pure (EProj e l)

findArm : String -> List I.Arm -> Maybe I.Arm
findArm t Nil = Nothing
findArm t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t then Just (MkArm t2 vs b) else findArm t rest

-- Case of case
--------------------------------------------------------------------------------

-- A match on a match, `case (case a of True -> b; False -> False) of ...`
-- (`&&`, inlined), is the inner match with the outer one in each arm:
-- where an arm is a tag, the outer match chooses at once.  The outer
-- arms are copied into each inner one, so only when they are small.

-- | how big the outer arms may be, times the inner arms but one
caseBudget : Int
caseBudget = 40

tagBody : I.Arm -> Bool
tagBody (MkArm _ _ (ETag _ _)) = True
tagBody _ = False

armsOf : I.Expr -> List I.Arm
armsOf (EMatch _ arms) = arms
armsOf _ = Nil

-- (an inner arm, a copy of the outer match in it)
pushArm : SK -> List I.Arm -> I.Arm -> M I.Arm
pushArm r arms (MkArm t vs b) = do
  outer <- copy (EMatch EAbandon arms)
  b' <- r.match b (armsOf outer)
  pure (MkArm t vs b')

caseOfCase : SK -> I.Expr -> List I.Arm -> List I.Arm -> M I.Expr
caseOfCase r s2 arms2 arms =
  if any tagBody arms2
    && I.size (EMatch EAbandon arms) * (length arms2 - 1) <= caseBudget
    then do
      arms2' <- traverseS (pushArm r arms) arms2
      pure (EMatch s2 arms2')
  else pure (EMatch (EMatch s2 arms2) arms)

matchF : SK -> I.Expr -> List I.Arm -> M I.Expr
matchF r s arms = case s of
  EMatch s2 arms2 -> caseOfCase r s2 arms2 arms
  ETag t as -> case findArm t arms of
    Just (MkArm _ vs b) -> r.simp (letsOf (zipL vs as) b)
    Nothing -> pure (EMatch s arms)
  ELet x a b -> do
    b' <- r.match b arms
    pure (ELet x a b')
  EGlobal g -> do
    mb <- known g
    case mb of
      Just (ETag t2 as2) -> r.match (ETag t2 as2) arms
      _ -> pure (EMatch s arms)
  _ -> pure (EMatch s arms)

sk : SK
sk =
  { simp = \e -> simpF sk e
  , applyTo = \f as -> applyToF sk f as
  , project = \l e -> projectF sk l e
  , match = \s arms -> matchF sk s arms
  }

isKind : I.Expr -> Bool
isKind (ELam _ _) = True
isKind (ERecord _) = True
isKind _ = False

recordAll : String -> I.Expr -> St -> St
recordAll key b s =
  withSp
    { all =
        if I.size b <= specBodySize then M.insert compareString key b s.sp.all
        else s.sp.all
    , kinds =
        if isKind b then M.insert compareString key MkUnit s.sp.kinds
        else s.sp.kinds
    , specs = s.sp.specs
    , made = s.sp.made
    , count = s.sp.count
    , within = s.sp.within
    , trying = s.sp.trying
    }
    s

recordDef : String -> I.Expr -> M Unit
recordDef key b = \s ->
    -- a definition calling itself is never inlined
    MkPair
      MkUnit
      (recordAll
         key
         b
         (if elemStr key (I.globalsIn b) then s
          else withDefs (M.insert compareString key b s.defs) s))

-- | the copies made for the definition at hand, in the order they were
-- | made, taken
takeMade : M (List I.Def)
takeMade = \s ->
    MkPair
      (reverse s.sp.made)
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , specs = s.sp.specs
         , made = Nil
         , count = s.sp.count
         , within = s.sp.within
         , trying = s.sp.trying
         }
         s)

-- | a definition simplified, after the copies made for it
oneDef : I.Def -> M (List I.Def)
oneDef d = do
  u <- setFuel 4000
  -- (twice: what the first pass exposes, the second reduces)
  b1 <- sk.simp d.body
  b2 <- sk.simp b1
  b <- raise b2
  u2 <- recordDef d.key b
  u3 <- markSafe d.key b
  made <- takeMade
  pure (appendL made (Cons (I.mkDef d.key d.name b) Nil))

type Simplified = { defs : List I.Def, supply : Int }

concatDefs : List (List I.Def) -> List I.Def
concatDefs Nil = Nil
concatDefs (Cons ds rest) = appendL ds (concatDefs rest)

simplifyDone : Pair (List (List I.Def)) St -> Simplified
simplifyDone (MkPair out st) = { defs = concatDefs out, supply = st.supply }

initSt : Int -> SG -> St
initSt n0 sg =
  { supply = n0
  , fuel = 0
  , defs = M.empty
  , safe = sg.safe
  , total = sg.total
  , plain = M.empty
  , sp =
      { all = M.empty
      , kinds = M.empty
      , specs = M.empty
      , made = Nil
      , count = 0
      , within = Nil
      , trying = 0
      }
  }

-- | each definition, in order, simplified; what is inlined is taken
-- | simplified already
simplifyProgram : Int -> List I.Def -> Simplified
simplifyProgram n0 defs =
  simplifyDone (traverseS (\d -> oneDef d) defs (initSt n0 (safeGlobals defs)))

-- >>> map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "f" "f" (EApp (ELam ["x"] (EVar "x")) [EInt 1])]).defs
-- Cons (EInt 1) Nil

-- >>> map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "g" "g" (EMatch (ETag "Just" [EInt 5]) [MkArm "Just" ["x"] (EVar "x"), MkArm "Nothing" [] (EInt 0)])]).defs
-- Cons (EInt 5) Nil

-- another name for a tag, given a call: the tag given it, no binding
-- between, so a loop can build the value
-- >>> map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "c" "c" (ELam ["x", "y"] (ETag "Cons" [EVar "x", EVar "y"])), I.mkDef "f" "f" (ELam ["z"] (EApp (EApp (EGlobal "c") [EPrimCall "add" [EVar "z"]]) [EApp (EGlobal "f") [EVar "z"]]))]).defs
-- Cons (ELam (Cons "x" (Cons "y" Nil)) (ETag "Cons" (Cons (EVar "x") (Cons (EVar "y") Nil)))) (Cons (ELam (Cons "z" Nil) (ETag "Cons" (Cons (EPrimCall "add" (Cons (EVar "z") Nil)) (Cons (EApp (EGlobal "f") (Cons (EVar "z") Nil)) Nil)))) Nil)
