-- The formatter, checked: src/heff/fmt/layout.hf lays a file out anew, and here
-- the result is held to mean what the text did -- the same imports, the
-- same notation read back, the same comments in the same order.

import heff.fixity as F
import heff.import as Im
import heff.notation
import heff.surface as Su
import heff.fmt.layout as Ly
import heff.fmt.lex as L
import prelude

-- | a notation as a string, its spans forgotten: two readings mean the
-- | same where their keys are equal
ntnKey : Ntn -> String
ntnKey (At (Juxt a b) _) = "(" ++ ntnKey a ++ " " ++ ntnKey b ++ ")"
ntnKey (At (Infix a b c) _) =
  "{" ++ ntnKey a ++ " " ++ ntnKey b ++ " " ++ ntnKey c ++ "}"
ntnKey (At (NBlock s m xs) _) =
  "["
  ++ s
  ++ " "
  ++ (case m of
      Nothing -> ""
      Just n -> ntnKey n)
  ++ " | "
  ++ joinWith "; " (map ntnKey xs)
  ++ "]"
ntnKey (At (MDecl ms s n) _) =
  "<" ++ joinWith "," ms ++ " " ++ s ++ " " ++ ntnKey n ++ ">"
ntnKey (At (NTuple xs) _) = "(," ++ joinWith ", " (map ntnKey xs) ++ ")"
ntnKey (At (NBrace n) _) = "{b " ++ ntnKey n ++ "}"
ntnKey (At (NBracket n) _) = "[b " ++ ntnKey n ++ "]"
ntnKey (At (Ident x) _) = "i:" ++ x
ntnKey (At (Keyword x) _) = "k:" ++ x
ntnKey (At (NField x) _) = "f:" ++ x
ntnKey (At (NTag x) _) = "t:" ++ x
ntnKey (At (NInt i) _) = "n:" ++ showInt i
ntnKey (At (NFloat x) _) = "f:" ++ showFloat x
ntnKey (At (NString s) _) = "s:" ++ s
ntnKey (At NError _) = "error"

type Meaning =
  { imports : List String, ntns : List String, diags : List String }

readNoFixities : String -> Su.Read
readNoFixities text =
  Su.readProgramWith
    { known = Su.noKnown, fixities = F.emptyFixities, lenient = True }
    text

meaningOf : Im.Imports -> Su.Read -> Meaning
meaningOf h r =
  { imports = map (\(i : Im.Import) -> i.name) h.imports
  , ntns = map ntnKey r.ntns
  , diags = map (\(d : Diag) -> d.msg) r.diags
  }

-- | what a text means, read without what it imports (whose fixities are
-- | not known: operators bind the same way in both, whatever way)
meaningFrom : Im.Imports -> Meaning
meaningFrom h = meaningOf h (readNoFixities h.text)

meaning : String -> Meaning
meaning s = meaningFrom (Im.readImports s)

comments : String -> List String
comments s =
  map (\(c : L.Cmt) -> Ly.rtrim c.text) (L.lex (Im.readImports s).text).comments

strsEq : List String -> List String -> Bool
strsEq Nil Nil = True
strsEq (Cons a as) (Cons b bs) = strEq a b && strsEq as bs
strsEq _ _ = False

sameMeaning : String -> String -> Meaning -> Meaning -> Either String String
sameMeaning src out a b =
  if not (strsEq a.imports b.imports)
    then Left "formatting would change the imports"
  else if not (strsEq a.ntns b.ntns && strsEq a.diags b.diags)
    then Left
        "formatting would change what the file means (a bug of the formatter)"
  else if not (strsEq (comments src) (comments out))
    then Left
        "formatting would lose or move a comment across code (a bug of the formatter)"
  else Right out

-- | the formatted text means what the text did
check : String -> String -> Either String String
check src out = sameMeaning src out (meaning src) (meaning out)

-- | a file laid out anew, and checked to mean what it did
format : String -> Either String String
format src = case Ly.formatUnchecked src of
  Left why -> Left why
  Right out -> check src out

-- >>> format "f=1"
-- Right "f = 1\n"
