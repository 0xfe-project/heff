-- The untyped intermediate language between the core and the backends.
-- Every bound variable has a name of its own in a whole program, so
-- substitution never captures.

import map as M
import prelude

-- | an alternative of a match: `vars` bind the tag's arguments, in order
data ArmOf e = MkArm String (List String) e

data Expr
  = EVar String
  | EGlobal String
  | ELam (List String) Expr
  | EApp Expr (List Expr)
  | ELet String Expr Expr
  | ERecord (List (Pair String Expr))
  | EProj Expr String
  | ETag String (List Expr)
  | EMatch Expr (List (ArmOf Expr))
  -- | a primitive, as a (curried) function
  | EPrim String
  -- | a primitive, given all its arguments
  | EPrimCall String (List Expr)
  -- | a global of that arity, given all its arguments at once
  | ECall String (List Expr)
  | EInt Int
  | EFloat Float
  | EStr String
  | EAbandon
  -- | a local definition (`where`), the name bound in its body to itself:
  -- | only between erasure and `heff.lift`, which makes it a global
  | EFix String Expr

type Arm = ArmOf Expr

armTag : Arm -> String
armTag (MkArm t _ _) = t

armVars : Arm -> List String
armVars (MkArm _ vs _) = vs

armBody : Arm -> Expr
armBody (MkArm _ _ b) = b

-- | a definition: its key, the name it is known by, and its body
type Def = { key : String, name : String, body : Expr }

mkDef : String -> String -> Expr -> Def
mkDef key name body = { key = key, name = name, body = body }

-- | where fresh names come from (a counter)
type Supply = Int

fresh : String -> Supply -> Pair String Supply
fresh base n = MkPair (base ++ "$" ++ showInt n) (n + 1)

baseGo : String -> Int -> String
baseGo x i =
  if i >= strLength x then x
  else if charCode x i == 36 then strSlice x 0 i
  else baseGo x (i + 1)

-- | the base of a variable's name (what it was called in the source)
baseOf : String -> String
baseOf x = baseGo x 0

appendI : {a : Type} -> List a -> List a -> List a
appendI Nil ys = ys
appendI (Cons x xs) ys = Cons x (appendI xs ys)

concatMapI : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapI f Nil = Nil
concatMapI f (Cons x xs) = appendI (f x) (concatMapI f xs)

nubI : List String -> List String
nubI Nil = Nil
nubI (Cons x xs) = Cons x (nubI (filter (\y -> not (strEq y x)) xs))

sumI : List Int -> Int
sumI xs = foldl (\a b -> a + b) 0 xs

-- Freshening (a copy with every binder renamed afresh)
--------------------------------------------------------------------------------

type Ren = M.Map String String

renOf : Ren -> String -> String
renOf m x = case M.lookup compareString x m of
  Just y -> y
  Nothing -> x

type FreshSt = { m : Ren, n : Supply, xs : List String }

freshBindOne : FreshSt -> String -> FreshSt
freshBindOne acc x = case fresh (baseOf x) acc.n of
  MkPair x' k ->
    { m = M.insert compareString x x' acc.m, n = k, xs = Cons x' acc.xs }

freshBinders : Ren -> Supply -> List String -> FreshSt
freshBinders m n xs = foldl freshBindOne { m = m, n = n, xs = Nil } xs

type FK = { go : Ren -> Supply -> Expr -> Pair Expr Supply }

withFS : {a : Type} -> FreshSt -> (FreshSt -> a) -> a
withFS v k = k v

consPES : Expr -> Pair (List Expr) Supply -> Pair (List Expr) Supply
consPES e (MkPair es n) = MkPair (Cons e es) n

consPFS : Pair String Expr
        -> Pair (List (Pair String Expr)) Supply
        -> Pair (List (Pair String Expr)) Supply
consPFS f (MkPair fs n) = MkPair (Cons f fs) n

consPAS : Arm -> Pair (List Arm) Supply -> Pair (List Arm) Supply
consPAS a (MkPair as n) = MkPair (Cons a as) n

freshMany : FK -> Ren -> Supply -> List Expr -> Pair (List Expr) Supply
freshMany r m n Nil = MkPair Nil n
freshMany r m n (Cons e rest) = case r.go m n e of
  MkPair e' n1 -> consPES e' (freshMany r m n1 rest)

freshArms : FK -> Ren -> Supply -> List Arm -> Pair (List Arm) Supply
freshArms r m n Nil = MkPair Nil n
freshArms r m n (Cons (MkArm tag vars body) rest) =
  withFS (freshBinders m n vars) (\bs -> case r.go bs.m bs.n body of
  MkPair b' n1 ->
    consPAS (MkArm tag (reverse bs.xs) b') (freshArms r m n1 rest))

freshFields : FK
            -> Ren
            -> Supply
            -> List (Pair String Expr)
            -> Pair (List (Pair String Expr)) Supply
freshFields r m n Nil = MkPair Nil n
freshFields r m n (Cons (MkPair l e) rest) = case r.go m n e of
  MkPair e' n1 -> consPFS (MkPair l e') (freshFields r m n1 rest)

freshGo : FK -> Ren -> Supply -> Expr -> Pair Expr Supply
freshGo r m n e = case e of
  EVar x -> MkPair (EVar (renOf m x)) n
  ELam xs b ->
    withFS (freshBinders m n xs) (\bs -> case r.go bs.m bs.n b of
    MkPair b' n' -> MkPair (ELam (reverse bs.xs) b') n')
  ELet x a b -> case r.go m n a of
    MkPair a' n1 -> case fresh (baseOf x) n1 of
      MkPair x' n2 -> case r.go (M.insert compareString x x' m) n2 b of
        MkPair b' n3 -> MkPair (ELet x' a' b') n3
  EApp f as -> case r.go m n f of
    MkPair f' n1 -> case freshMany r m n1 as of
      MkPair as' n2 -> MkPair (EApp f' as') n2
  ERecord fs -> case freshFields r m n fs of
    MkPair fs' n1 -> MkPair (ERecord fs') n1
  EProj e2 l -> case r.go m n e2 of
    MkPair e' n1 -> MkPair (EProj e' l) n1
  ETag t as -> case freshMany r m n as of
    MkPair as' n1 -> MkPair (ETag t as') n1
  EMatch s arms -> case r.go m n s of
    MkPair s' n1 -> case freshArms r m n1 arms of
      MkPair arms' n2 -> MkPair (EMatch s' arms') n2
  EPrimCall p as -> case freshMany r m n as of
    MkPair as' n1 -> MkPair (EPrimCall p as') n1
  ECall g as -> case freshMany r m n as of
    MkPair as' n1 -> MkPair (ECall g as') n1
  _ -> MkPair e n

fk : FK
fk = { go = \m n e -> freshGo fk m n e }

freshen : Supply -> Expr -> Pair Expr Supply
freshen n e = fk.go M.empty n e

-- Substitution (names are unique, so nothing is captured)
--------------------------------------------------------------------------------

substGo : M.Map String Expr -> Expr -> Expr
substGo m e = case e of
  EVar x -> case M.lookup compareString x m of
    Just e2 -> e2
    Nothing -> EVar x
  ELam xs b -> ELam xs (substGo m b)
  EApp f as -> EApp (substGo m f) (map (\a -> substGo m a) as)
  ELet x a b -> ELet x (substGo m a) (substGo m b)
  ERecord fs ->
    ERecord
      (map
         (\p -> case p of
          MkPair l e2 -> MkPair l (substGo m e2))
         fs)
  EProj e2 l -> EProj (substGo m e2) l
  ETag t as -> ETag t (map (\a -> substGo m a) as)
  EMatch s arms ->
    EMatch
      (substGo m s)
      (map
         (\a -> case a of
          MkArm t vs b -> MkArm t vs (substGo m b))
         arms)
  EPrimCall p as -> EPrimCall p (map (\a -> substGo m a) as)
  ECall g as -> ECall g (map (\a -> substGo m a) as)
  _ -> e

subst : M.Map String Expr -> Expr -> Expr
subst m e = if M.size m == 0 then e else substGo m e

-- Occurrences, size, globals, values
--------------------------------------------------------------------------------

pairSndI : Pair String Expr -> Expr
pairSndI (MkPair _ e2) = e2

type Occ = { count : Int, underLam : Bool }

-- (worklists: an expression's parts before the rest -- a walk that
-- needs no list of its own for each node)
pushArms : List Arm -> List Expr -> List Expr
pushArms Nil rest = rest
pushArms (Cons a as) rest = Cons (armBody a) (pushArms as rest)

pushFields : List (Pair String Expr) -> List Expr -> List Expr
pushFields Nil rest = rest
pushFields (Cons p fs) rest = Cons (pairSndI p) (pushFields fs rest)

-- (how often `x` occurs in the worklist, `n` counted so far)
countW : String -> Int -> List Expr -> Int
countW x n Nil = n
countW x n (Cons (EVar y) rest) = countW x (if strEq y x then n + 1 else n) rest
countW x n (Cons (ELam _ b) rest) = countW x n (Cons b rest)
countW x n (Cons (EApp f as) rest) = countW x n (Cons f (appendI as rest))
countW x n (Cons (ELet _ a b) rest) = countW x n (Cons a (Cons b rest))
countW x n (Cons (ERecord fs) rest) = countW x n (pushFields fs rest)
countW x n (Cons (EProj e _) rest) = countW x n (Cons e rest)
countW x n (Cons (ETag _ as) rest) = countW x n (appendI as rest)
countW x n (Cons (EMatch s arms) rest) =
  countW x n (Cons s (pushArms arms rest))
countW x n (Cons (EPrimCall _ as) rest) = countW x n (appendI as rest)
countW x n (Cons (ECall _ as) rest) = countW x n (appendI as rest)
countW x n (Cons _ rest) = countW x n rest

-- (whether `x` occurs under a lambda in the worklist: a lambda's body
-- counted, not walked again)
lamW : String -> List Expr -> Bool
lamW x Nil = False
lamW x (Cons (ELam _ b) rest) = countW x 0 (Cons b Nil) > 0 || lamW x rest
lamW x (Cons (EApp f as) rest) = lamW x (Cons f (appendI as rest))
lamW x (Cons (ELet _ a b) rest) = lamW x (Cons a (Cons b rest))
lamW x (Cons (ERecord fs) rest) = lamW x (pushFields fs rest)
lamW x (Cons (EProj e _) rest) = lamW x (Cons e rest)
lamW x (Cons (ETag _ as) rest) = lamW x (appendI as rest)
lamW x (Cons (EMatch s arms) rest) = lamW x (Cons s (pushArms arms rest))
lamW x (Cons (EPrimCall _ as) rest) = lamW x (appendI as rest)
lamW x (Cons (ECall _ as) rest) = lamW x (appendI as rest)
lamW x (Cons _ rest) = lamW x rest

-- | how often a variable occurs, and whether any occurrence is under a
-- | lambda (where it may be evaluated any number of times)
occurrences : String -> Expr -> Occ
occurrences x e =
  { count = countW x 0 (Cons e Nil), underLam = lamW x (Cons e Nil) }

-- (the nodes in the worklist, `n` counted so far)
sizeW : Int -> List Expr -> Int
sizeW n Nil = n
sizeW n (Cons (ELam _ b) rest) = sizeW (n + 1) (Cons b rest)
sizeW n (Cons (EApp f as) rest) = sizeW (n + 1) (Cons f (appendI as rest))
sizeW n (Cons (ELet _ a b) rest) = sizeW (n + 1) (Cons a (Cons b rest))
sizeW n (Cons (ERecord fs) rest) = sizeW (n + 1) (pushFields fs rest)
sizeW n (Cons (EProj e _) rest) = sizeW (n + 1) (Cons e rest)
sizeW n (Cons (ETag _ as) rest) = sizeW (n + 1) (appendI as rest)
sizeW n (Cons (EMatch s arms) rest) =
  sizeW (n + 1) (Cons s (pushArms arms rest))
sizeW n (Cons (EPrimCall _ as) rest) = sizeW (n + 1) (appendI as rest)
sizeW n (Cons (ECall _ as) rest) = sizeW (n + 1) (appendI as rest)
sizeW n (Cons _ rest) = sizeW (n + 1) rest

size : Expr -> Int
size e = sizeW 0 (Cons e Nil)

globalsGo : Expr -> List String
globalsGo e = case e of
  EGlobal g -> Cons g Nil
  ELam _ b -> globalsGo b
  EApp f as -> appendI (globalsGo f) (concatMapI (\a -> globalsGo a) as)
  ELet _ a b -> appendI (globalsGo a) (globalsGo b)
  ERecord fs ->
    concatMapI
      (\p -> case p of
       MkPair _ e2 -> globalsGo e2)
      fs
  EProj e2 _ -> globalsGo e2
  ETag _ as -> concatMapI (\a -> globalsGo a) as
  EMatch s arms ->
    appendI (globalsGo s) (concatMapI (\a -> globalsGo (armBody a)) arms)
  EPrimCall _ as -> concatMapI (\a -> globalsGo a) as
  ECall g as -> Cons g (concatMapI (\a -> globalsGo a) as)
  _ -> Nil

globalsIn : Expr -> List String
globalsIn e = nubI (globalsGo e)

allI : List Bool -> Bool
allI Nil = True
allI (Cons b bs) = b && allI bs

-- | evaluating it does nothing but build a value: it can be dropped,
-- | moved, or duplicated (when it is small)
isValue : Expr -> Bool
isValue e = case e of
  EVar _ -> True
  EGlobal _ -> True
  ELam _ _ -> True
  ERecord fs ->
    allI
      (map
         (\p -> case p of
          MkPair _ e2 -> isValue e2)
         fs)
  ETag _ as -> allI (map (\a -> isValue a) as)
  EPrim _ -> True
  EInt _ -> True
  EFloat _ -> True
  EStr _ -> True
  _ -> False

-- | an application's head and all its arguments, the nested ones
-- | flattened
spineApp : List Expr -> Pair Expr (List Expr) -> Pair Expr (List Expr)
spineApp as (MkPair h bs) = MkPair h (appendI bs as)

spine : Expr -> Pair Expr (List Expr)
spine e = case e of
  EApp f as -> spineApp as (spine f)
  _ -> MkPair e Nil

-- >>> size (ELam ["x"] (EApp (EVar "x") [EInt 1]))
-- 4

-- >>> (occurrences "x" (ELam ["y"] (EVar "x"))).underLam
-- True
