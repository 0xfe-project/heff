-- The IR (`heff.lower`) to JavaScript, an ES module.  Emitting is
-- all this does -- what is erased, inlined, dropped or called at once
-- was decided before.
--
--   tag      T a b    ~>  { $: "T", a: [a, b] }
--   record   { l = e } ~> { l: e }
--   match             ~>  a `switch` on `$`
--   a definition of n parameters  ~>  a function of n parameters (and,
--            where it is passed on, `name$c`, its curried form)
--   a definition that is not a function  ~>  a constant, or (if
--            computing it may fail) computed once, when first used
--
-- Arguments are evaluated before the call (call-by-value); the
-- interpreter is lazy.

import heff.effect as Ef
import heff.globals as G
import heff.ir as I
import heff.lower as L
import heff.prims as Pr
import map as M
import prelude

type Output = { source : String, errors : List String }

type Export = { name : String, key : String }

mkExport : String -> String -> Export
mkExport name key = { name = name, key = key }

catMaybesL : {a : Type} -> List (Maybe a) -> List a
catMaybesL Nil = Nil
catMaybesL (Cons (Just x) xs) = Cons x (catMaybesL xs)
catMaybesL (Cons Nothing xs) = catMaybesL xs

elemStr : String -> List String -> Bool
elemStr x xs = elemBy strEq x xs

nubGo : List String -> List String -> List String
nubGo seen Nil = Nil
nubGo seen (Cons x xs) =
  if elemStr x seen then nubGo seen xs else Cons x (nubGo (Cons x seen) xs)

nubStr : List String -> List String
nubStr xs = nubGo Nil xs

unsnocCons : {a : Type} -> a -> Pair (List a) a -> Pair (List a) a
unsnocCons y (MkPair ini lst) = MkPair (Cons y ini) lst

unsnocGo : {a : Type} -> List a -> a -> Pair (List a) a
unsnocGo Nil y = MkPair Nil y
unsnocGo (Cons z rest) y = unsnocCons y (unsnocGo rest z)

-- | the list but its last element, and that element
unsnocE : {a : Type} -> List a -> Maybe (Pair (List a) a)
unsnocE Nil = Nothing
unsnocE (Cons x rest) = Just (unsnocGo rest x)

-- Names
--------------------------------------------------------------------------------

escAt : String -> Int -> String
escAt s i =
  if charCode s i == 34 then "\\\""
  else if charCode s i == 92 then "\\\\"
  else if charCode s i == 10 then "\\n"
  else if charCode s i == 13 then "\\r"
  else if charCode s i == 9 then "\\t"
  else strSlice s i (i + 1)

quoteGo : String -> Int -> String -> String
quoteGo s i acc =
  if i >= strLength s then acc else quoteGo s (i + 1) (acc ++ escAt s i)

quoteString : String -> String
quoteString s = "\"" ++ quoteGo s 0 "" ++ "\""

-- (an operator's characters as words, for the languages compiled to)
wordOf : Int -> Maybe String
wordOf c =
  if c == 43 then Just "plus"
  else if c == 45 then Just "minus"
  else if c == 42 then Just "times"
  else if c == 47 then Just "slash"
  else if c == 37 then Just "percent"
  else if c == 61 then Just "eq"
  else if c == 60 then Just "lt"
  else if c == 62 then Just "gt"
  else if c == 38 then Just "amp"
  else if c == 124 then Just "bar"
  else if c == 33 then Just "bang"
  else if c == 94 then Just "caret"
  else if c == 63 then Just "q"
  else if c == 64 then Just "at"
  else if c == 35 then Just "hash"
  else if c == 36 then Just "dollar"
  else if c == 126 then Just "tilde"
  else if c == 58 then Just "colon"
  else if c == 46 then Just "dot"
  else if c == 92 then Just "backslash"
  else Nothing

operatorGo : String -> Int -> List String -> Maybe (List String)
operatorGo x i acc =
  if i >= strLength x then Just (reverse acc)
  else case wordOf (charCode x i) of
    Just w -> operatorGo x (i + 1) (Cons w acc)
    Nothing -> Nothing

operatorDone : Maybe (List String) -> Maybe String
operatorDone (Just ws) = Just ("op_" ++ joinWith "_" ws)
operatorDone Nothing = Nothing

-- | an operator's name as a word: `+` is `op_plus`, `<=` `op_lt_eq`;
-- | nothing for a name that is not an operator
operatorName : String -> Maybe String
operatorName x =
  if strEq x "" then Nothing else operatorDone (operatorGo x 0 Nil)

lastDotFrom : String -> Int -> Maybe Int
lastDotFrom s i =
  if i < 0 then Nothing
  else if charCode s i == 46 then Just i
  else lastDotFrom s (i - 1)

spellAt : String -> Maybe Int -> String
spellAt k (Just i) = case operatorName (strSlice k (i + 1) (strLength k)) of
  Just w -> strSlice k 0 (i + 1) ++ w
  Nothing -> fromMaybe k (operatorName k)
spellAt k Nothing = fromMaybe k (operatorName k)

-- | a name, or a key (`module.name`), with its name spelt out if it is
-- | an operator: `prelude.+` is `prelude.op_plus`
spellOperator : String -> String
spellOperator k = spellAt k (lastDotFrom k (strLength k - 1))

reserved : List String
reserved =
  [ "break"
  , "case"
  , "catch"
  , "class"
  , "const"
  , "continue"
  , "debugger"
  , "default"
  , "delete"
  , "do"
  , "else"
  , "enum"
  , "export"
  , "extends"
  , "false"
  , "finally"
  , "for"
  , "function"
  , "if"
  , "import"
  , "in"
  , "instanceof"
  , "new"
  , "null"
  , "return"
  , "super"
  , "switch"
  , "this"
  , "throw"
  , "true"
  , "try"
  , "typeof"
  , "var"
  , "void"
  , "while"
  , "with"
  , "yield"
  , "let"
  , "static"
  , "implements"
  , "interface"
  , "package"
  , "private"
  , "protected"
  , "public"
  , "await"
  , "arguments"
  , "eval"
  , "undefined"
  , "NaN"
  , "Infinity"
  , "document"
  , "window"
  , "BigInt"
  , "String"
  , "Number"
  , "Object"
  , "Error"
  , "Math"
  , "JSON"
  , "setTimeout"
  , "fetch"
  , "process"
  , "console"
  , "globalThis"
  , "Promise"
  , "Array"
  , "Map"
  , "Set"
  , "Date"
  , "Symbol"
  , "RegExp"
  , "Buffer"
  , "setImmediate"
  , "queueMicrotask"
  , "structuredClone"
  , "URL"
  , "TextEncoder"
  , "TextDecoder"
  ]

isWordCode : Int -> Bool
isWordCode c =
  (97 <= c && c <= 122)
  || (65 <= c && c <= 90)
  || (48 <= c && c <= 57)
  || c == 95

safeChars : String -> Int -> String -> String
safeChars x i acc =
  if i >= strLength x then acc
  else safeChars
      x
      (i + 1)
      (acc ++ (if isWordCode (charCode x i) then strSlice x i (i + 1) else "_"))

safeRes : String -> String
safeRes s =
  if elemStr s reserved || (48 <= charCode s 0 && charCode s 0 <= 57)
    then "_" ++ s
  else s

safeFrom : String -> String
safeFrom s = safeRes (if strEq s "" then "x" else s)

safe : String -> String
safe x0 = safeFrom (safeChars (spellOperator x0) 0 "")

isIdent : String -> Bool
isIdent x = not (strEq x "") && strEq (safe x) x

propName : String -> String
propName x = if isIdent x then x else quoteString x

-- | the short name of a key (`co.bind` is `bind`)
shortName : String -> String
shortName k = fromMaybe k (last (split "." k))

-- Globals
--------------------------------------------------------------------------------

-- | how a definition is reached: its name, how many parameters it takes
-- | at once, whether it is computed when first used, and whether a call
-- | of it may give back a bounce (see Tail calls)
type GInfo = { js : String, arity : Int, lazy : Bool, bounce : Bool }

-- | a global as a value
ref : M.Map String GInfo -> String -> String
ref gs k = case M.lookup compareString k gs of
  Just i ->
    if i.arity >= 2 then i.js ++ "$c" else if i.lazy then i.js ++ "()" else i.js
  Nothing -> "undefined"

-- | the globals an expression uses as values (not called at once)
valueRefs : I.Expr -> List String
valueRefs e = case e of
  EGlobal g -> Cons g Nil
  ELam _ b -> valueRefs b
  EApp f as -> concatList (valueRefs f) (concatMap (\a -> valueRefs a) as)
  ELet _ a b -> concatList (valueRefs a) (valueRefs b)
  ERecord fs ->
    concatMap
      (\p -> case p of
       MkPair _ e2 -> valueRefs e2)
      fs
  EProj e2 _ -> valueRefs e2
  ETag _ as -> concatMap (\a -> valueRefs a) as
  EMatch s arms ->
    concatList (valueRefs s) (concatMap (\a -> valueRefs (I.armBody a)) arms)
  EPrimCall _ as -> concatMap (\a -> valueRefs a) as
  ECall _ as -> concatMap (\a -> valueRefs a) as
  _ -> Nil

-- Tail calls
--------------------------------------------------------------------------------

-- JavaScript has no tail calls, and a computation (`Co`) is all of them:
-- each step calls the rest last, so a loop of operations a handler of
-- the language handles is a stack as deep as the loop is long.  So a
-- call of an unknown function last (an application) counts itself, in
-- `$dep`, and every so often, instead of calling, gives back a bounce
-- (`$Bnc`: the function and its argument): the stack is let go of, to
-- where the call's value was asked for, which -- a call not last,
-- `$tr(f(x))` -- makes the call then, and again while it is given a
-- bounce.  A known definition called last is not counted: definitions
-- are sequential, so a chain of them always ends -- unless in a call of
-- an unknown function, which counts.  A definition that may give back
-- a bounce (`bounce`) is one that calls an unknown function last, or
-- such a definition.  (Where JavaScript calls a function of the
-- program -- the runtime, a provider, a module's user -- `$tr` and
-- `$ext` stand between.)

-- | whether it applies an unknown function last
tailApp : I.Expr -> Bool
tailApp e = case e of
  ELet _ _ b -> tailApp b
  EMatch _ arms -> any (\a -> tailApp (I.armBody a)) arms
  EApp _ _ -> True
  _ -> False

-- | the definitions it calls last
tailGlobals : I.Expr -> List String
tailGlobals e = case e of
  ELet _ _ b -> tailGlobals b
  EMatch _ arms -> concatMap (\a -> tailGlobals (I.armBody a)) arms
  ECall g _ -> Cons g Nil
  _ -> Nil

bodyBounces : M.Map String Unit -> I.Def -> Bool
bodyBounces set d = case d.body of
  ELam _ b ->
    tailApp b
    || any
      (\g -> not (strEq g d.key) && M.member compareString g set)
      (tailGlobals b)
  _ -> False

bounceStep : List I.Def -> M.Map String Unit -> M.Map String Unit
bounceStep defs set =
  foldl
    (\m (d : I.Def) ->
       if bodyBounces set d then M.insert compareString d.key MkUnit m else m)
    set
    defs

bounceGo : List I.Def -> M.Map String Unit -> M.Map String Unit
bounceGo defs set =
  if M.size (bounceStep defs set) == M.size set then set
  else bounceGo defs (bounceStep defs set)

-- | the definitions that may give back a bounce
bouncing : List I.Def -> M.Map String Unit
bouncing defs = bounceGo defs M.empty

-- Loops
--------------------------------------------------------------------------------

appendEnd : String -> Int -> I.Expr -> Bool
appendEnd key n e = case e of
  ECall k as -> strEq k key && length as == n
  EPrimCall p as -> case as of
    Cons _ (Cons rr Nil) -> strEq p "strAppend" && appendEnd key n rr
    _ -> False
  _ -> False

-- | whether it does at the end of a chain of string appends,
-- | `a ++ b ++ f xs`
appendSelf : String -> Int -> I.Expr -> Bool
appendSelf key n e = case e of
  ELet _ _ b -> appendSelf key n b
  EMatch _ arms -> any (\a -> appendSelf key n (I.armBody a)) arms
  EPrimCall p as -> case as of
    Cons _ (Cons rr Nil) -> strEq p "strAppend" && appendEnd key n rr
    _ -> False
  _ -> False

consLast : String -> Int -> Maybe I.Expr -> Bool
consLast key n (Just (ECall k bs)) = strEq k key && length bs == n
consLast key n _ = False

-- | whether it does as a constructor's last argument
consSelf : String -> Int -> I.Expr -> Bool
consSelf key n e = case e of
  ELet _ _ b -> consSelf key n b
  EMatch _ arms -> any (\a -> consSelf key n (I.armBody a)) arms
  ETag _ as -> consLast key n (last as)
  _ -> False

-- | whether the function `key` calls itself last somewhere: directly,
-- | as a constructor's last argument, or right of a string append
tailSelf : String -> Int -> I.Expr -> Bool
tailSelf key n e = case e of
  ELet _ _ b -> tailSelf key n b
  EMatch _ arms -> any (\a -> tailSelf key n (I.armBody a)) arms
  ECall k as -> strEq k key && length as == n
  _ -> consSelf key n e || appendSelf key n e

-- Scope
--------------------------------------------------------------------------------

-- | a function that is a loop: its parameters (`x$`), whether a
-- | constructor with a call of it last is built in place, its hole
-- | filled by the next round (`$root`, `$hole`, `$at`), and whether a
-- | string append ends in a call of it, gathered left to right (`$s`)
type Self = { key : String, params : List String, trmc : Bool, sapp : Bool }

-- | the names in scope: the JavaScript name of each variable, and every
-- | name taken; and, in a function that is a loop, the function (where
-- | a call of it is last, it goes round again)
type Env =
  { gs : M.Map String GInfo
  , names : M.Map String String
  , used : M.Map String Unit
  , self : Maybe Self
  }

noSelf : Env -> Env
noSelf env = { gs = env.gs, names = env.names, used = env.used, self = Nothing }

withSelf : Maybe Self -> Env -> Env
withSelf s env = { gs = env.gs, names = env.names, used = env.used, self = s }

bound : String -> String -> Env -> Env
bound x v env =
  { gs = env.gs
  , names = M.insert compareString x v env.names
  , used = M.insert compareString v MkUnit env.used
  , self = env.self
  }

type BoundN = { js : String, env : Env }

bindFrom : Env -> String -> String -> Int -> BoundN
bindFrom env x base i =
  if M.member
    compareString
    (if i == 0 then base else base ++ showInt i)
    env.used
    then bindFrom env x base (i + 1)
  else { js = if i == 0 then base else base ++ showInt i
       , env = bound x (if i == 0 then base else base ++ showInt i) env
       }

bindName : Env -> String -> BoundN
bindName env x = bindFrom env x (safe (I.baseOf x)) 0

type BoundNs = { js : List String, env : Env }

bindSnoc : BoundNs -> BoundN -> BoundNs
bindSnoc acc r = { js = concatList acc.js (Cons r.js Nil), env = r.env }

bindAll : Env -> List String -> BoundNs
bindAll env xs =
  foldl (\acc x -> bindSnoc acc (bindName acc.env x)) { js = Nil, env = env } xs

indent : Int -> String
indent n = joinWith "" (replicate n "  ")

-- | precedences: 0 an arrow or a conditional, 1 a binary operation, 2 a
-- | unary one, 3 anything that can be called or projected
type Code = { code : String, prec : Int }

atLeast : Int -> Code -> String
atLeast p c = if c.prec < p then "(" ++ c.code ++ ")" else c.code

p3 : String -> Code
p3 code = { code = code, prec = 3 }

codeOfC : Code -> String
codeOfC c = c.code

-- | a primitive given all its arguments: an operator where JavaScript
-- | has one, else its function
-- (an additive operator binds at 1, a multiplicative one at 2: both
-- left-associative, so the right operand is one tighter -- `(a - b) * c`
-- and `a / (b * c)` keep their parentheses)
primBin : String -> Code -> Code -> Code
primBin op a b =
  if strEq op "*" || strEq op "/"
    then { code = atLeast 2 a ++ " " ++ op ++ " " ++ atLeast 3 b, prec = 2 }
  else { code = atLeast 1 a ++ " " ++ op ++ " " ++ atLeast 2 b, prec = 1 }

primTest : String -> Code -> Code -> Code
primTest op a b =
  { code = atLeast 2 a ++ " " ++ op ++ " " ++ atLeast 2 b ++ " ? $T : $F"
  , prec = 0
  }

primDefault : String -> List Code -> Code
primDefault p as = p3 ("$" ++ p ++ "(" ++ joinWith ", " (map codeOfC as) ++ ")")

-- | the primitives JavaScript has an operator for, given both arguments
primOp : String -> Maybe (Code -> Code -> Code)
primOp "intAdd" = Just (primBin "+")
primOp "intSub" = Just (primBin "-")
primOp "intMul" = Just (primBin "*")
primOp "strAppend" = Just (primBin "+")
primOp "intEq" = Just (primTest "===")
primOp "strEq" = Just (primTest "===")
primOp "intLt" = Just (primTest "<")
primOp "strLt" = Just (primTest "<")
primOp "intLe" = Just (primTest "<=")
primOp "floatAdd" = Just (primBin "+")
primOp "floatSub" = Just (primBin "-")
primOp "floatMul" = Just (primBin "*")
primOp "floatDiv" = Just (primBin "/")
primOp "floatEq" = Just (primTest "===")
primOp "floatLt" = Just (primTest "<")
primOp "floatLe" = Just (primTest "<=")
primOp _ = Nothing

-- | the ones written another way, given their argument
primUnary : String -> Maybe (Code -> Code)
primUnary "intShow" = Just (\a -> p3 (atLeast 3 a ++ ".toString()"))
primUnary "strLength" = Just (\a -> p3 ("BigInt(" ++ atLeast 3 a ++ ".length)"))
primUnary _ = Nothing

primCall : String -> List Code -> Code
primCall p as = case as of
  Cons a (Cons b Nil) -> case primOp p of
    Just f -> f a b
    Nothing -> primDefault p as
  Cons a Nil -> case primUnary p of
    Just f -> f a
    Nothing -> primDefault p as
  _ -> primDefault p as

-- | whether `primCall` calls the primitive's function, `$p(...)`
callsHelper : String -> List I.Expr -> Bool
callsHelper p as = case as of
  Cons _ (Cons _ Nil) -> maybe True (\_ -> False) (primOp p)
  Cons _ Nil -> maybe True (\_ -> False) (primUnary p)
  _ -> True

-- Expressions
--------------------------------------------------------------------------------

-- | the emitter's judgments, knotted
type JK =
  { expr : Env -> Int -> I.Expr -> Code
  , body : Env -> Int -> I.Expr -> String
  , block : Env -> Int -> I.Expr -> String
  , stmts : Env -> Int -> I.Expr -> List String
  , last : Env -> Int -> I.Expr -> List String
  }

-- Conditions
--------------------------------------------------------------------------------

-- A boolean in the position of a test -- what a match on `True`/`False`
-- looks at, and its arms where they are booleans again -- is compiled to
-- a sublanguage of its own (Danvy's boolean position, Chez's `Pred`): a
-- JavaScript condition, never a `True` or `False` built to be switched on.
data Pred
  = PTrue
  | PFalse
  | PRel String
  | PNot Pred
  | PIf Pred Pred Pred
  -- | a binding, then the condition: `(x = a, p)`, `x` declared before
  -- | the statement the condition is in (AB-normal: the binding is an
  -- | assignment, so it can sit inside a condition)
  | PSeq String String Pred

isConstant : Pred -> Bool
isConstant PTrue = True
isConstant PFalse = True
isConstant _ = False

-- | `if c then t else e`, what is known of it worked out: a test of a
-- | test whose arms are constants is the inner test's arms tested
-- | (case-of-case, copying only constants)
condIf : Pred -> Pred -> Pred -> Pred
condIf (PSeq x a c) t e = PSeq x a (condIf c t e)
condIf PTrue t e = t
condIf PFalse t e = e
condIf (PNot c) t e = condIf c e t
condIf (PIf a b c) t e =
  if isConstant t && isConstant e then condIf a (condIf b t e) (condIf c t e)
  else PIf (PIf a b c) t e
condIf c PTrue PFalse = c
condIf c PFalse PTrue = PNot c
condIf c t e = PIf c t e

-- | a condition's code and how tightly it binds: 0 a conditional, 1 `||`,
-- | 2 `&&`, 3 a comparison, 4 `!` or an atom
type Cond = { code : String, prec : Int }

condAtLeast : Int -> Cond -> String
condAtLeast n c = if c.prec < n then "(" ++ c.code ++ ")" else c.code

condCode : Pred -> Cond
condCode p = case p of
  PTrue -> { code = "true", prec = 4 }
  PFalse -> { code = "false", prec = 4 }
  PRel s -> { code = s, prec = 3 }
  PSeq x a q ->
    { code = "(" ++ x ++ " = " ++ a ++ ", " ++ condAtLeast 1 (condCode q) ++ ")"
    , prec = 4
    }
  PNot q -> { code = "!" ++ condAtLeast 4 (condCode q), prec = 4 }
  PIf c t PFalse ->
    { code = condAtLeast 2 (condCode c) ++ " && " ++ condAtLeast 2 (condCode t)
    , prec = 2
    }
  PIf c PTrue e ->
    { code = condAtLeast 1 (condCode c) ++ " || " ++ condAtLeast 1 (condCode e)
    , prec = 1
    }
  PIf c PFalse e ->
    { code =
        condAtLeast 2 (condCode (PNot c))
        ++ " && "
        ++ condAtLeast 2 (condCode e)
    , prec = 2
    }
  PIf c t PTrue ->
    { code =
        condAtLeast 1 (condCode (PNot c))
        ++ " || "
        ++ condAtLeast 1 (condCode t)
    , prec = 1
    }
  PIf c t e ->
    { code =
        condAtLeast 1 (condCode c)
        ++ " ? "
        ++ condAtLeast 0 (condCode t)
        ++ " : "
        ++ condAtLeast 0 (condCode e)
    , prec = 0
    }

-- | the names a condition binds, to be declared before it (a name two
-- | arms each bind is one variable: the scopes do not overlap)
seqsOf : Pred -> List String
seqsOf p = case p of
  PSeq x _ q -> Cons x (seqsOf q)
  PNot q -> seqsOf q
  PIf c t e -> concatList (seqsOf c) (concatList (seqsOf t) (seqsOf e))
  _ -> Nil

letDeclarations : Int -> List String -> List String
letDeclarations ind Nil = Nil
letDeclarations ind xs =
  Cons (indent ind ++ "let " ++ joinWith ", " (nubStr xs) ++ ";") Nil

-- | the comparisons JavaScript has an operator for
primRel : String -> Maybe String
primRel "intEq" = Just "==="
primRel "strEq" = Just "==="
primRel "intLt" = Just "<"
primRel "strLt" = Just "<"
primRel "intLe" = Just "<="
primRel "floatEq" = Just "==="
primRel "floatLt" = Just "<"
primRel "floatLe" = Just "<="
primRel _ = Nothing

armNamed : String -> List I.Arm -> Maybe I.Expr
armNamed t Nil = Nothing
armNamed t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t && null vs then Just b else armNamed t rest

-- | a match's arms, if it is a test: one for `True`, one for `False`
boolArms : List I.Arm -> Maybe (Pair I.Expr I.Expr)
boolArms arms =
  if length arms == 2
    then case armNamed "True" arms of
      Just t -> case armNamed "False" arms of
        Just f -> Just (MkPair t f)
        Nothing -> Nothing
      Nothing -> Nothing
  else Nothing

-- | whether it is a boolean all the way down, as a condition
condShaped : I.Expr -> Bool
condShaped e = case e of
  ETag t Nil -> strEq t "True" || strEq t "False"
  EPrimCall p (Cons _ (Cons _ Nil)) -> maybe False (\_ -> True) (primRel p)
  EMatch s arms -> case boolArms arms of
    Just (MkPair t f) -> condShaped t && condShaped f
    Nothing -> False
  ELet _ _ b -> condShaped b
  _ -> False

predOfValue : JK -> Env -> Int -> I.Expr -> Pred
predOfValue r env ind e =
  PRel (atLeast 3 (r.expr env ind e) ++ ".$ === \"True\"")

predOfPrim : JK -> Env -> Int -> I.Expr -> String -> List I.Expr -> Pred
predOfPrim r env ind e p as = case primRel p of
  Just op -> case as of
    Cons a (Cons b Nil) ->
      PRel
        (atLeast 2 (r.expr env ind a)
         ++ " "
         ++ op
         ++ " "
         ++ atLeast 2 (r.expr env ind b))
    _ -> predOfValue r env ind e
  Nothing -> predOfValue r env ind e

predOfLet : (Env -> I.Expr -> Pred) -> String -> I.Expr -> BoundN -> Pred
predOfLet go a b nb = PSeq nb.js a (go nb.env b)

-- | a boolean, as a condition
predOf : JK -> Env -> Int -> I.Expr -> Pred
predOf r env ind e = case e of
  ETag t Nil ->
    if strEq t "True" then PTrue
    else if strEq t "False" then PFalse
    else predOfValue r env ind e
  EPrimCall p as -> predOfPrim r env ind e p as
  EMatch s arms -> case boolArms arms of
    Just (MkPair t f) ->
      condIf (predOf r env ind s) (predOf r env ind t) (predOf r env ind f)
    Nothing -> predOfValue r env ind e
  ELet x a b ->
    predOfLet
      (\env2 q -> predOf r env2 ind q)
      (r.expr env ind a).code
      b
      (bindName env x)
  _ -> predOfValue r env ind e

-- | a condition in an expression: where it binds, there is no statement
-- | to declare the names before, so the match is a block of its own
exprCond : JK -> Env -> Int -> I.Expr -> Pred -> (Cond -> Code) -> Code
exprCond r env ind e c k =
  if null (seqsOf c) then k (condCode c)
  else p3 ("(() => " ++ r.block env ind e ++ ")()")

-- | a test in an expression: a boolean built from the condition, or
-- | the arms chosen by it
exprTest : JK -> Env -> Int -> I.Expr -> I.Expr -> I.Expr -> I.Expr -> Code
exprTest r env ind e s t f =
  if condShaped t && condShaped f
    then exprCond
        r
        env
        ind
        e
        (predOf r env ind e)
        (\c -> { code = condAtLeast 1 c ++ " ? $T : $F", prec = 0 })
  else exprCond
      r
      env
      ind
      e
      (predOf r env ind s)
      (\c ->
         { code =
             condAtLeast 1 c
             ++ " ? "
             ++ atLeast 1 (r.expr env ind t)
             ++ " : "
             ++ atLeast 1 (r.expr env ind f)
         , prec = 0
         })

callName : Env -> String -> String
callName env g = case M.lookup compareString g env.gs of
  Just i -> i.js
  Nothing -> safe g

projSuffix : String -> String
projSuffix l = if isIdent l then "." ++ l else "[" ++ quoteString l ++ "]"

intCode : String -> Code
intCode s =
  if startsWith "-" s then { code = s ++ "n", prec = 2 } else p3 (s ++ "n")

-- (`2.0` is `2`, a number, not a BigInt)
floatCode : String -> Code
floatCode s = if startsWith "-" s then { code = s, prec = 2 } else p3 s

lamCode : JK -> Env -> Int -> I.Expr -> BoundNs -> Code
lamCode r env ind b rb =
  { code =
      joinWith "" (map (\p -> "(" ++ p ++ ") => ") rb.js) ++ r.body rb.env ind b
  , prec = 0
  }

fieldCode : JK -> Env -> Int -> Pair String I.Expr -> String
fieldCode r env ind (MkPair l e2) =
  propName l ++ ": " ++ (r.expr env ind e2).code

-- (what is inside an expression is not last in the function)
isUnitArgs : List I.Expr -> Bool
isUnitArgs (Cons (ETag t Nil) Nil) = strEq t "MkUnit"
isUnitArgs _ = False

bouncesG : Env -> String -> Bool
bouncesG env g = case M.lookup compareString g env.gs of
  Just i -> i.bounce
  Nothing -> False

-- | a call's value, through its bounces
trCode : String -> String
trCode c = "$tr(" ++ c ++ ")"

-- | whether what it returns last may be a bounce
mayBounce : Env -> I.Expr -> Bool
mayBounce env e = tailApp e || any (\g -> bouncesG env g) (tailGlobals e)

trWhen : Bool -> String -> String
trWhen b c = if b then trCode c else c

-- | a known definition called, as it is (what it gives back may be a
-- | bounce)
callCode : JK -> Env -> Int -> String -> List I.Expr -> String
callCode r env ind g as =
  callName env g
  ++ "("
  ++ joinWith ", " (map (\a -> (r.expr env ind a).code) as)
  ++ ")"

exprGo : JK -> Env -> Int -> I.Expr -> Code
exprGo r env ind e = case e of
  EVar x -> p3 (fromMaybe (safe x) (M.lookup compareString x env.names))
  EGlobal g -> p3 (ref env.gs g)
  ELam xs b -> lamCode r env ind b (bindAll env xs)
  -- (a thunk forced: its value kept on it, so that forcing it again
  -- does not compute it again -- the language is pure, `f MkUnit` is
  -- the same value every time, and what abandons is not kept)
  -- (a call not last: its value asked for, through any bounces)
  EApp f as ->
    if isUnitArgs as then p3 ("$force(" ++ (r.expr env ind f).code ++ ")")
    else foldl
        (\c a ->
           p3 (trCode (atLeast 3 c ++ "(" ++ (r.expr env ind a).code ++ ")")))
        (r.expr env ind f)
        as
  ECall g as ->
    if isUnitArgs as then p3 ("$force(" ++ callName env g ++ ")")
    else p3 (trWhen (bouncesG env g) (callCode r env ind g as))
  EProj e2 l -> p3 (atLeast 3 (r.expr env ind e2) ++ projSuffix l)
  ERecord fs ->
    p3 ("{ " ++ joinWith ", " (map (\p -> fieldCode r env ind p) fs) ++ " }")
  ETag t Nil ->
    if strEq t "True" then p3 "$T"
    else if strEq t "False" then p3 "$F"
    else p3 ("{ $: " ++ quoteString t ++ ", a: [] }")
  ETag t as ->
    p3
      ("{ $: "
       ++ quoteString t
       ++ ", a: ["
       ++ joinWith ", " (map (\a -> (r.expr env ind a).code) as)
       ++ "] }")
  EInt i -> intCode (showInt i)
  EFloat x -> floatCode (showFloat x)
  EStr s -> p3 (quoteString s)
  EAbandon -> p3 "$abandon()"
  -- (lifted before: none is left)
  EFix _ _ -> p3 "$abandon()"
  EPrim p -> p3 ("$" ++ p ++ "$c")
  EPrimCall p as -> primCall p (map (\a -> r.expr env ind a) as)
  -- (a block, called at once: what it returns last may be a bounce)
  ELet x a b ->
    p3
      (trWhen
         (mayBounce env e)
         ("(() => " ++ r.block env ind (ELet x a b) ++ ")()"))
  EMatch s arms -> case boolArms arms of
    Just (MkPair t f) -> exprTest r env ind e s t f
    Nothing ->
      p3
        (trWhen
           (mayBounce env e)
           ("(() => " ++ r.block env ind (EMatch s arms) ++ ")()"))

exprF : JK -> Env -> Int -> I.Expr -> Code
exprF r env0 ind e = exprGo r (noSelf env0) ind e

bodyCode : String -> String
bodyCode c = if strEq (strSlice c 0 1) "{" then "(" ++ c ++ ")" else c

-- | a function's body: an expression, or a block if it binds or matches
bodyF : JK -> Env -> Int -> I.Expr -> String
bodyF r env ind e = case e of
  ELet x a b -> r.block env ind (ELet x a b)
  EMatch s arms -> r.block env ind (EMatch s arms)
  EApp f as -> r.block env ind (EApp f as)
  -- (a call last that may give back a bounce gives it back: asked for
  -- here, through `$tr`, each round's stack would stay)
  ECall g as ->
    if bouncesG env g then r.block env ind (ECall g as)
    else bodyCode ((r.expr env ind e).code)
  _ -> bodyCode ((r.expr env ind e).code)

blockF : JK -> Env -> Int -> I.Expr -> String
blockF r env ind e =
  "{\n" ++ joinWith "\n" (r.stmts env (ind + 1) e) ++ "\n" ++ indent ind ++ "}"

type Scrut = { js : String, env : Env, pre : List String }

scrutBound : JK -> Env -> Int -> I.Expr -> BoundN -> Scrut
scrutBound r env ind s b =
  { js = b.js
  , env = b.env
  , pre =
      Cons
        (indent ind
         ++ "const "
         ++ b.js
         ++ " = "
         ++ (r.expr env ind s).code
         ++ ";")
        Nil
  }

scrutOf : JK -> Env -> Int -> I.Expr -> Scrut
scrutOf r env ind s = case s of
  EVar x -> case M.lookup compareString x env.names of
    Just js -> { js = js, env = env, pre = Nil }
    Nothing -> scrutBound r env ind (EVar x) (bindName env "s")
  _ -> scrutBound r env ind s (bindName env "s")

declsOf : String -> Int -> List String -> Int -> List String
declsOf js ind Nil i = Nil
declsOf js ind (Cons v rest) i =
  Cons
    (indent ind ++ "const " ++ v ++ " = " ++ js ++ ".a[" ++ showInt i ++ "];")
    (declsOf js ind rest (i + 1))

armBound : JK -> Scrut -> Int -> String -> I.Expr -> BoundNs -> List String
armBound r sc ind tag bdy rb =
  concatList
    (Cons (indent (ind + 1) ++ "case " ++ quoteString tag ++ ": {") Nil)
    (concatList
       (declsOf sc.js (ind + 2) rb.js 0)
       (concatList
          (r.stmts rb.env (ind + 2) bdy)
          (Cons (indent (ind + 1) ++ "}") Nil)))

armLines : JK -> Scrut -> Int -> I.Arm -> List String
armLines r sc ind (MkArm tag vs bdy) =
  armBound r sc ind tag bdy (bindAll sc.env vs)

-- | an arm, laid out: its tag, whether it uses none of the fields it
-- | binds, and its lines -- the body alone if so (arms whose bodies are
-- | the same then share one, under all their labels: a match with a
-- | default copies it into the arm of every tag it stands for), the
-- | whole `case` otherwise
data ArmJs = MkArmJs String Bool (List String)

armJsTag : ArmJs -> String
armJsTag (MkArmJs t _ _) = t

armJsKey : ArmJs -> Maybe String
armJsKey (MkArmJs _ True ls) = Just (joinWith "\n" ls)
armJsKey (MkArmJs _ False _) = Nothing

armJs : JK -> Scrut -> Int -> I.Arm -> ArmJs
armJs r sc ind (MkArm tag vs bdy) =
  if all (\v -> (I.occurrences v bdy).count == 0) vs
    then MkArmJs tag True (r.stmts sc.env (ind + 2) bdy)
  else MkArmJs tag False (armLines r sc ind (MkArm tag vs bdy))

sameKey : Maybe String -> ArmJs -> Bool
sameKey (Just k) a = case armJsKey a of
  Just k2 -> strEq k k2
  Nothing -> False
sameKey Nothing a = False

-- | the arms, those of one body sharing it (where the first of them was)
sharedGo : Int -> List ArmJs -> List ArmJs -> List String
sharedGo ind before Nil = Nil
sharedGo ind before (Cons a rest) = case a of
  MkArmJs tag False ls -> concatList ls (sharedGo ind (Cons a before) rest)
  MkArmJs tag True ls ->
    if any (\b -> sameKey (armJsKey a) b) before
      then sharedGo ind (Cons a before) rest
    else concatList
        (map
           (\b ->
              indent (ind + 1) ++ "case " ++ quoteString (armJsTag b) ++ ":")
           (Cons a (filter (\b -> sameKey (armJsKey a) b) rest)))
        (concatList
           (Cons (indent (ind + 1) ++ "{") Nil)
           (concatList
              ls
              (concatList
                 (Cons (indent (ind + 1) ++ "}") Nil)
                 (sharedGo ind (Cons a before) rest))))

stmtsMatch2 : JK -> Int -> List I.Arm -> Scrut -> List String
stmtsMatch2 r ind arms sc =
  if null arms
    then concatList
        sc.pre
        (Cons (indent ind ++ "return $nomatch(" ++ sc.js ++ ");") Nil)
  else concatList
      sc.pre
      (concatList
         (Cons (indent ind ++ "switch (" ++ sc.js ++ ".$) {") Nil)
         (concatList
            (sharedGo ind Nil (map (\a -> armJs r sc ind a) arms))
            (Cons
               (indent ind ++ "}")
               (Cons (indent ind ++ "return $nomatch(" ++ sc.js ++ ");") Nil))))

stmtsLet2 : JK -> Int -> I.Expr -> Code -> BoundN -> List String
stmtsLet2 r ind b ac nb =
  Cons
    (indent ind ++ "const " ++ nb.js ++ " = " ++ ac.code ++ ";")
    (r.stmts nb.env ind b)

-- | a test, as a statement: the arm the condition chooses
stmtsIf : JK -> Env -> Int -> Pred -> I.Expr -> I.Expr -> List String
stmtsIf r env ind c t f = case c of
  PTrue -> r.stmts env ind t
  PFalse -> r.stmts env ind f
  _ ->
    concatList
      (letDeclarations ind (seqsOf c))
      (concatList
         (Cons (indent ind ++ "if (" ++ (condCode c).code ++ ") {") Nil)
         (concatList
            (r.stmts env (ind + 1) t)
            (Cons
               (indent ind ++ "} else {")
               (concatList
                  (r.stmts env (ind + 1) f)
                  (Cons (indent ind ++ "}") Nil)))))

-- | a boolean returned: the condition, as a value
stmtsReturnCond : Int -> Pred -> List String
stmtsReturnCond ind c = case c of
  PTrue -> Cons (indent ind ++ "return $T;") Nil
  PFalse -> Cons (indent ind ++ "return $F;") Nil
  _ ->
    concatList
      (letDeclarations ind (seqsOf c))
      (Cons
         (indent ind
          ++ "return "
          ++ condAtLeast 1 (condCode c)
          ++ " ? $T : $F;")
         Nil)

stmtsF : JK -> Env -> Int -> I.Expr -> List String
stmtsF r env ind e = case e of
  ELet x a b -> stmtsLet2 r ind b (r.expr env ind a) (bindName env x)
  EMatch s arms -> case boolArms arms of
    Just (MkPair t f) ->
      if maybe True (\_ -> False) env.self && condShaped t && condShaped f
        then stmtsReturnCond ind (predOf r env ind e)
      else stmtsIf r env ind (predOf r env ind s) t f
    Nothing -> stmtsMatch2 r ind arms (scrutOf r env ind s)
  _ -> r.last env ind e

-- (the arguments are of this round's `const`s: assigned one by one)
again : JK -> Env -> Self -> Int -> List I.Expr -> List String
again r env s ind as =
  Cons
    (indent ind
     ++ joinWith
       " "
       (zipWith
          (\p a -> p ++ " = " ++ (r.expr env ind a).code ++ ";")
          s.params
          as)
     ++ " continue;")
    Nil

-- | the most calls of unknown functions made last, one inside the
-- | other, before the stack is let go of
bounceDepth : Int
bounceDepth = 500

atomGo : String -> Int -> Bool
atomGo c i =
  if i >= strLength c then True
  else (isWordCode (charCode c i) || charCode c i == 36) && atomGo c (i + 1)

-- | code that is a name or a literal: computing it again is nothing
isAtom : String -> Bool
isAtom c = not (strEq c "") && atomGo c 0

-- | a value as a name: itself if it is one, else a `const`'s
type Named = { js : String, pre : List String, env : Env }

namedAs : Int -> Code -> BoundN -> Named
namedAs ind c nb =
  { js = nb.js
  , pre = Cons (indent ind ++ "const " ++ nb.js ++ " = " ++ c.code ++ ";") Nil
  , env = nb.env
  }

named : Env -> Int -> String -> Code -> Named
named env ind base c =
  if isAtom c.code then { js = c.code, pre = Nil, env = env }
  else namedAs ind c (bindName env base)

bounceGive : Int -> Named -> Named -> List String
bounceGive ind f a =
  concatList
    f.pre
    (concatList
       a.pre
       (Cons
          (indent ind
           ++ "return ++$dep > "
           ++ showInt bounceDepth
           ++ " ? new $Bnc("
           ++ f.js
           ++ ", "
           ++ a.js
           ++ ") : "
           ++ f.js
           ++ "("
           ++ a.js
           ++ ");")
          Nil))

bounceNamed : Int -> Code -> Named -> List String
bounceNamed ind ac f = bounceGive ind f (named f.env ind "a" ac)

bounceLines : Env -> Int -> Code -> Code -> List String
bounceLines env ind fc ac = bounceNamed ind ac (named env ind "f" fc)

-- | a value returned: an unknown function's, called last, counted (and,
-- | every so often, a bounce instead)
returnLines : JK -> Env -> Int -> I.Expr -> List String
returnLines r env ind e = case e of
  EApp f as ->
    if isUnitArgs as then bounceLines env ind (p3 "$force") (r.expr env ind f)
    else case unsnocE as of
      Just (MkPair ini a) ->
        bounceLines
          env
          ind
          (if null ini then r.expr env ind f else r.expr env ind (EApp f ini))
          (r.expr env ind a)
      Nothing ->
        Cons (indent ind ++ "return " ++ (r.expr env ind e).code ++ ";") Nil
  -- (a known definition called last: not counted, its bounce handed on)
  ECall g as ->
    if isUnitArgs as
      then Cons (indent ind ++ "return " ++ (r.expr env ind e).code ++ ";") Nil
    else Cons (indent ind ++ "return " ++ callCode r env ind g as ++ ";") Nil
  _ -> Cons (indent ind ++ "return " ++ (r.expr env ind e).code ++ ";") Nil

lastTrmc : JK -> Env -> Int -> I.Expr -> BoundN -> List String
lastTrmc r env ind e rr =
  [ indent ind ++ "const " ++ rr.js ++ " = " ++ (r.expr env ind e).code ++ ";"
  , indent ind ++ "if ($hole) { $hole.a[$at] = " ++ rr.js ++ "; return $root; }"
  , indent ind ++ "return " ++ rr.js ++ ";"
  ]

lastOther : JK -> Env -> Self -> Int -> I.Expr -> List String
lastOther r env s ind e =
  if s.trmc then lastTrmc r env ind e (bindName env "r")
  else if s.sapp
    then Cons
        (indent ind ++ "return $s + " ++ atLeast 2 (r.expr env ind e) ++ ";")
        Nil
  else returnLines r env ind e

lastCell : JK
         -> Env
         -> Self
         -> Int
         -> String
         -> List I.Expr
         -> List I.Expr
         -> BoundN
         -> List String
lastCell r env s ind t ini bs rr =
  concatList
    [ indent ind
    ++ "const "
    ++ rr.js
    ++ " = { $: "
    ++ quoteString t
    ++ ", a: ["
    ++ joinWith
      ", "
      (concatList
         (map (\a -> (r.expr env ind a).code) ini)
         (Cons "undefined" Nil))
    ++ "] };"
    , indent ind
    ++ "if ($hole) $hole.a[$at] = "
    ++ rr.js
    ++ "; else $root = "
    ++ rr.js
    ++ ";"
    , indent ind
    ++ "$hole = "
    ++ rr.js
    ++ "; $at = "
    ++ showInt (length ini)
    ++ ";"
    ]
    (again r env s ind bs)

lastTag : JK
        -> Env
        -> Self
        -> Int
        -> String
        -> List I.Expr
        -> Maybe (Pair (List I.Expr) I.Expr)
        -> List String
lastTag r env s ind t as (Just (MkPair ini (ECall k bs))) =
  if s.trmc && strEq k s.key && length bs == length s.params
    then lastCell r env s ind t ini bs (bindName env "cell")
  else lastOther r env s ind (ETag t as)
lastTag r env s ind t as _ = lastOther r env s ind (ETag t as)

lastSelf : JK -> Env -> Self -> Int -> I.Expr -> List String
lastSelf r env s ind e = case e of
  ECall k as ->
    if strEq k s.key && length as == length s.params then again r env s ind as
    else lastOther r env s ind (ECall k as)
  -- `a ++ ... ++ f xs`: the left is gathered into `$s`, and the call
  -- goes round; what returns gives `$s` its prefix back
  EPrimCall p args -> case args of
    Cons a (Cons rr Nil) ->
      if strEq p "strAppend" && s.sapp && appendEnd s.key (length s.params) rr
        then Cons
            (indent ind ++ "$s += " ++ (r.expr env ind a).code ++ ";")
            (r.last env ind rr)
      else lastOther r env s ind (EPrimCall p args)
    _ -> lastOther r env s ind (EPrimCall p args)
  ETag t as -> lastTag r env s ind t as (unsnocE as)
  _ -> lastOther r env s ind e

-- | what is last in a function: returned, or, in a loop, the next round
lastF : JK -> Env -> Int -> I.Expr -> List String
lastF r env ind e = case env.self of
  Just s -> lastSelf r env s ind e
  Nothing -> returnLines r env ind e

jk : JK
jk =
  { expr = \env ind e -> exprF jk env ind e
  , body = \env ind e -> bodyF jk env ind e
  , block = \env ind e -> blockF jk env ind e
  , stmts = \env ind e -> stmtsF jk env ind e
  , last = \env ind e -> lastF jk env ind e
  }

-- Definitions
--------------------------------------------------------------------------------

env0Of : M.Map String GInfo -> M.Map String Unit -> Env
env0Of gs globalNames =
  { gs = gs, names = M.empty, used = globalNames, self = Nothing }

-- where a function of several parameters is used as a value, it needs
-- its curried form
wrapper : M.Map String Unit -> String -> GInfo -> List String -> List String
wrapper curried key i js =
  if i.arity >= 2 && M.member compareString key curried
    then Cons
        ("const "
         ++ i.js
         ++ "$c = "
         ++ joinWith "" (map (\p -> "(" ++ p ++ ") => ") js)
         ++ i.js
         ++ "("
         ++ joinWith ", " js
         ++ ");")
        Nil
  else Nil

-- (a call of itself last: a loop; its parameters `x$`, each round's own
-- `const`, which what it closes over keeps)
looped : String -> GInfo -> I.Expr -> BoundNs -> Bool -> Bool -> List String
looped key i b r trmc sapp =
  concatList
    [ ""
    , "const "
    ++ i.js
    ++ " = ("
    ++ joinWith ", " (map (\x -> x ++ "$") r.js)
    ++ ") => {"
    ]
    (concatList
       (if trmc then Cons "  let $root, $hole = null, $at = 0;" Nil else Nil)
       (concatList
          (if sapp then Cons "  let $s = \"\";" Nil else Nil)
          (concatList
             [ "  for (;;) {"
             , "    const "
             ++ joinWith
               ", "
               (zipWith
                  (\x v -> x ++ " = " ++ v)
                  r.js
                  (map (\x -> x ++ "$") r.js))
             ++ ";"
             ]
             (concatList
                (jk.stmts
                   (withSelf
                      (Just
                         { key = key
                         , params = map (\x -> x ++ "$") r.js
                         , trmc = trmc
                         , sapp = sapp
                         })
                      r.env)
                   2
                   b)
                (Cons "  }" (Cons "};" Nil))))))

defFun : M.Map String Unit
       -> String
       -> GInfo
       -> List String
       -> I.Expr
       -> BoundNs
       -> List String
defFun curried key i xs b r =
  concatList
    (if tailSelf key (length xs) b
       then looped
           key
           i
           b
           r
           (consSelf key (length xs) b)
           (appendSelf key (length xs) b)
     else [ ""
          , "const "
          ++ i.js
          ++ " = ("
          ++ joinWith ", " r.js
          ++ ") => "
          ++ jk.body r.env 0 b
          ++ ";"
          ])
    (wrapper curried key i r.js)

defBody : M.Map String GInfo
        -> M.Map String Unit
        -> M.Map String Unit
        -> I.Def
        -> GInfo
        -> List String
defBody gs curried globalNames d i = case d.body of
  ELam xs b -> defFun curried d.key i xs b (bindAll (env0Of gs globalNames) xs)
  _ ->
    if i.lazy
      then [ ""
           , "const "
           ++ i.js
           ++ " = $lazy(() => "
           ++ jk.body (env0Of gs globalNames) 0 d.body
           ++ ");"
           ]
    else [ ""
         , "const "
         ++ i.js
         ++ " = "
         ++ (jk.expr (env0Of gs globalNames) 0 d.body).code
         ++ ";"
         ]

defLines : M.Map String GInfo
         -> M.Map String Unit
         -> M.Map String Unit
         -> I.Def
         -> List String
defLines gs curried globalNames d = case M.lookup compareString d.key gs of
  Nothing -> Nil
  Just i -> defBody gs curried globalNames d i

-- Programs
--------------------------------------------------------------------------------

whenHas : String -> String -> String -> Maybe String
whenHas code k line = if contains k code then Just line else Nothing

-- | bounces (see Tail calls): how many calls last were made since the
-- | last one, a bounce, and a value asked for through them
trampolineStr : String
trampolineStr =
  "let $dep = 0; function $Bnc(f, a) { this.f = f; this.a = a; } const $trs = (r) => { do { $dep = 0; r = r.f(r.a); } while (r instanceof $Bnc); return r; }; const $tr = (r) => r instanceof $Bnc ? $trs(r) : r;"

-- | a value of the program given to JavaScript: a function's value is
-- | asked for through its bounces, and so are a record's functions'
extStr : String
extStr =
  "const $ext = (v) => typeof v === \"function\" ? (x) => $ext($tr(v(x))) : v !== null && typeof v === \"object\" && !Array.isArray(v) && !(\"$\" in v) ? Object.fromEntries(Object.entries(v).map(([l, x]) => [l, $ext(x)])) : v;"

-- | what the code uses of the runtime
runtime : String -> List String
runtime code =
  catMaybesL
    [ if any (\k -> contains k code) ["$tr(", "$Bnc", "$force", "$lazy"]
      then Just trampolineStr
    else Nothing
    -- (either may be used without the other)
    , if contains "$T" code || contains "$F" code
      then Just
          "const $T = { $: \"True\", a: [] }, $F = { $: \"False\", a: [] };"
    else Nothing
    , whenHas
      code
      "$abandon"
      "const $abandon = () => { throw new Error(\"heff:abandon\"); };"
    , whenHas
      code
      "$nomatch"
      "const $nomatch = (s) => { throw new Error(\"heff: no case for '\" + (s && s.$) + \"'\"); };"
    , whenHas
      code
      "$force"
      "const $force = (f) => { if (f.$m !== undefined) return f.$m; const v = $tr(f({ $: \"MkUnit\", a: [] })); f.$m = v; return v; };"
    , whenHas
      code
      "$lazy"
      "const $lazy = (f) => { let state = 0, v; return () => { if (state === 2) return v; if (state === 1) throw new Error(\"heff: defined by itself\"); state = 1; try { v = $tr(f()); state = 2; return v; } finally { if (state === 1) state = 0; } }; };"
    ]

type Uncurried = { params : List String, body : String }

uncurryDone : List String -> String -> Uncurried
uncurryDone ps s = { params = reverse ps, body = s }

uncurryGo : List String -> String -> Uncurried
uncurryGo ps s =
  if startsWith "(" s
    then case indexOf ") => " (strSlice s 1 (strLength s)) of
      Just i ->
        if isIdent (strSlice (strSlice s 1 (strLength s)) 0 i)
          then uncurryGo
              (Cons (strSlice (strSlice s 1 (strLength s)) 0 i) ps)
              (strSlice (strSlice s 1 (strLength s)) (i + 5) (strLength s - 1))
        else uncurryDone ps s
      Nothing -> uncurryDone ps s
  else uncurryDone ps s

-- | `(a) => (b) => body` as its parameters and body
uncurryJs : String -> Uncurried
uncurryJs js = uncurryGo Nil js

-- | the primitives the code uses, as it writes them: `$p(` (given all
-- | its arguments) and `$p$c` (curried)
primUses : M.Map String Unit -> I.Expr -> M.Map String Unit
primUses m e = case e of
  ELam _ b -> primUses m b
  EApp f as -> foldl primUses (primUses m f) as
  ELet _ e1 b -> primUses (primUses m e1) b
  ERecord fs -> foldl (\m2 f -> primUses m2 (snd f)) m fs
  EProj e2 _ -> primUses m e2
  ETag _ as -> foldl primUses m as
  EMatch s arms ->
    foldl (\m2 a -> primUses m2 (I.armBody a)) (primUses m s) arms
  EPrim p -> M.insert compareString ("$" ++ p ++ "$c") MkUnit m
  EPrimCall p as ->
    foldl
      primUses
      (if callsHelper p as
         then M.insert compareString ("$" ++ p ++ "(") MkUnit m
       else m)
      as
  ECall _ as -> foldl primUses m as
  _ -> m

primHelperU : M.Map String Unit -> String -> Uncurried -> List String
primHelperU uses p u =
  concatList
    (if M.member compareString ("$" ++ p ++ "(") uses
     || M.member compareString ("$" ++ p ++ "$c") uses
       then Cons
           ("const $"
            ++ p
            ++ " = ("
            ++ joinWith ", " u.params
            ++ ") => "
            ++ u.body
            ++ ";")
           Nil
     else Nil)
    (if M.member compareString ("$" ++ p ++ "$c") uses
       then Cons
           ("const $"
            ++ p
            ++ "$c = "
            ++ joinWith "" (map (\x -> "(" ++ x ++ ") => ") u.params)
            ++ "$"
            ++ p
            ++ "("
            ++ joinWith ", " u.params
            ++ ");")
           Nil
     else Nil)

primHelperOne : M.Map String Unit -> Pair String Pr.PrimImpl -> List String
primHelperOne uses (MkPair p i) = primHelperU uses p (uncurryJs i.js)

-- | the helpers of the primitives the definitions use
primHelpers : List I.Def -> List String
primHelpers defs =
  concatMap
    (\p ->
       primHelperOne
         (foldl (\m (d : I.Def) -> primUses m d.body) M.empty defs)
         p)
    Pr.allPrims

type Emitted = { lines : List String, globals : M.Map String GInfo }

shortsOf : List I.Def -> List String
shortsOf defs = map (\(d : I.Def) -> safe (shortName d.key)) defs

-- names: the short one, unless two definitions share it
jsPick : List String -> String -> String -> String
jsPick shorts key s =
  if length (filter (\t -> strEq t s) shorts) > 1 then safe key else s

jsNameOf : List String -> String -> String
jsNameOf shorts key = jsPick shorts key (safe (shortName key))

arityOfBody : I.Expr -> Int
arityOfBody b = case b of
  ELam xs _ -> length xs
  _ -> 0

depEager : M.Map String GInfo -> String -> Bool
depEager acc k = case M.lookup compareString k acc of
  Just i -> not i.lazy
  Nothing -> False

-- (a definition is computed at once when that cannot fail)
lazyOf : M.Map String GInfo -> String -> I.Expr -> Int -> Bool
lazyOf acc key b ar =
  ar == 0
  && not
    (I.isValue b
     && all (\k -> not (strEq k key) && depEager acc k) (I.globalsIn b))

infoOne : List String
        -> M.Map String Unit
        -> M.Map String GInfo
        -> I.Def
        -> M.Map String GInfo
infoOne shorts bnc acc d =
  M.insert
    compareString
    d.key
    { js = jsNameOf shorts d.key
    , arity = arityOfBody d.body
    , lazy = lazyOf acc d.key d.body (arityOfBody d.body)
    , bounce = M.member compareString d.key bnc
    }
    acc

setFrom : List String -> M.Map String Unit
setFrom xs = foldl (\m k -> M.insert compareString k MkUnit m) M.empty xs

emitLines : M.Map String GInfo -> List String -> List String -> Emitted
emitLines info code helpers =
  { lines =
      concatList
        (runtime (joinWith "\n" (concatList helpers code)))
        (concatList helpers code)
  , globals = info
  }

-- (a primitive's helper may use the runtime too: `$abandon`, `$T`)
emitDone : List I.Def -> M.Map String GInfo -> List String -> Emitted
emitDone defs info code = emitLines info code (primHelpers defs)

emitCode : List I.Def
         -> M.Map String GInfo
         -> M.Map String Unit
         -> M.Map String Unit
         -> Emitted
emitCode defs info curried globalNames =
  emitDone
    defs
    info
    (concatMap (\d -> defLines info curried globalNames d) defs)

infoAll : List String -> M.Map String Unit -> List I.Def -> M.Map String GInfo
infoAll shorts bnc defs =
  foldl (\acc d -> infoOne shorts bnc acc d) M.empty defs

emitWithShorts : List I.Def -> List String -> List String -> Emitted
emitWithShorts defs roots shorts =
  emitCode
    defs
    (infoAll shorts (bouncing defs) defs)
    (setFrom
       (concatList (concatMap (\(d : I.Def) -> valueRefs d.body) defs) roots))
    (setFrom (map (\(d : I.Def) -> jsNameOf shorts d.key) defs))

emitDefs : List I.Def -> List String -> Emitted
emitDefs defs roots = emitWithShorts defs roots (shortsOf defs)

-- Runtime
--------------------------------------------------------------------------------

-- The runtime: a computation run by a handler whose (raw) monad is the
-- continuation monad, `(a -> ()) -> ()` -- the handler is the program's
-- (`heff.lower`'s `lowerProgram`), its algebra `perform` handing each
-- operation here, to `$performer`.  An operation may finish later
-- (`Sleep`, `Fetch`, reading a file), and the rest of the computation
-- -- its continuation -- runs then: JavaScript's asynchrony, as a
-- handler, and the computation is the same whatever handles it.  There
-- is one monad for the whole program; each effect contributes an
-- algebra.  `perform` does an operation of the computation's effect:
-- `$sum` of two algebras gives each operation (`InL`, `InR`) to its
-- side's, and each world's algebra -- a provider's text, bundled
-- whole, its factories gathered (`$p0`, `$p1`, ...) -- knows its own
-- operations.  (An operation done at once goes on at once, the
-- stack deeper each time: every so often it goes on after the stack is
-- let go of, lest a long loop of them overflow it.)

runStr : String
runStr =
  joinWith
    "\n"
    [ "let $performer;"
    , "const $run = (entry, perform) => {"
    , "  const later = typeof setImmediate === \"function\" ? setImmediate : (f) => setTimeout(f, 0);"
    , "  let depth = 0;"
    , "  const now = (k) => (x) => { x = $tr(x); if (depth > 1000) { depth = 0; later(() => $tr(k(x))); return; } depth++; $tr(k(x)); };"
    , "  $performer = (p, k) => perform(p, now(k));"
    , "  return $tr(entry());"
    , "};"
    ]

sumStr : String
sumStr =
  "const $sum = (l, r) => (p, k) => p.$ === \"InL\" ? l(p.a[0], k) : r(p.a[0], k);"

hasSum : Ef.Effect -> Bool
hasSum (Plus _ _) = True
hasSum (Leaf _) = False

-- | the world's side of an effect: a provider module's name and text
-- | (`M.provider.js` beside `M.hf`; lib/std/dom.provider.js says the
-- | shape)
type Provider = { module : String, text : String }

isImportLine : String -> Bool
isImportLine l = startsWith "import " l

-- (after `export const `, up to the ` `)
exportNameOf : String -> Maybe String
exportNameOf l =
  if startsWith "export const " l
    then case indexOf " " (strSlice l 13 (strLength l)) of
      Just i -> Just (strSlice l 13 (13 + i))
      Nothing -> Just (strSlice l 13 (strLength l))
  else Nothing

-- | the factories a provider exports, in the order it declares them
-- | (a `$`-named export is the provider speaking about itself, `$host`)
exportedNames : String -> List String
exportedNames text =
  filter
    (\n -> not (startsWith "$" n))
    (catMaybesL (map (\l -> exportNameOf l) (lines text)))

hostLineOf : String -> Maybe String
hostLineOf l =
  if startsWith "export const $host = \"" l
    then case indexOf "\"" (strSlice l 22 (strLength l)) of
      Just i -> Just (strSlice l 22 (22 + i))
      Nothing -> Just (strSlice l 22 (strLength l))
  else Nothing

-- | the one host a provider's world lives in (`export const $host =
-- | "page"`), if it says so; without it, any
hostOf : String -> Maybe String
hostOf text = head (catMaybesL (map (\l -> hostLineOf l) (lines text)))

unexportLine : String -> String
unexportLine l =
  if startsWith "export const " l then "const " ++ strSlice l 13 (strLength l)
  else l

-- the provider's own module, in a scope of its own: its import lines
-- are hoisted to the file's top, its exported factories handed out
bundleProvider : Int -> Provider -> String
bundleProvider i p =
  joinWith
    "\n"
    (concatList
       [ "// " ++ p.module ++ ".provider.js"
       , "const $p" ++ showInt i ++ " = (() => {"
       ]
       (concatList
          (map
             (\l -> unexportLine l)
             (filter (\l -> not (isImportLine l)) (lines p.text)))
          [ "return { " ++ joinWith ", " (exportedNames p.text) ++ " };"
          , "})();"
          ]))

bundleAll : Int -> List Provider -> List String
bundleAll i Nil = Nil
bundleAll i (Cons p rest) = Cons (bundleProvider i p) (bundleAll (i + 1) rest)

runtimeFor : Bool -> List Provider -> Ef.Effect -> String
runtimeFor hasTr provs eff =
  joinWith
    "\n"
    (concatList
       (concatList (if hasTr then Nil else Cons trampolineStr Nil) [runStr])
       (concatList
          (if hasSum eff then Cons sumStr Nil else Nil)
          (bundleAll 0 provs)))

provIndexGo : Int -> String -> List Provider -> Int
provIndexGo i md Nil = 0
provIndexGo i md (Cons p rest) =
  if strEq p.module md then i else provIndexGo (i + 1) md rest

-- (each effect's handler, an operation of a sum going to its side's; a
-- leaf's is its provider's factory, called for a fresh algebra)
handlerOf : List Provider -> Ef.Effect -> String
handlerOf provs (Leaf k) =
  "$p"
  ++ showInt (provIndexGo 0 (Ef.moduleOfKey k) provs)
  ++ "."
  ++ Ef.nameOfKey k
  ++ "()"
handlerOf provs (Plus a b) =
  "$sum(" ++ handlerOf provs a ++ ", " ++ handlerOf provs b ++ ")"

-- Outputs
--------------------------------------------------------------------------------

findProv : String -> List Provider -> Maybe Provider
findProv md Nil = Nothing
findProv md (Cons p rest) =
  if strEq p.module md then Just p else findProv md rest

provsForGo : List Provider -> List String -> List Provider
provsForGo available Nil = Nil
provsForGo available (Cons md rest) = case findProv md available of
  Just p -> Cons p (provsForGo available rest)
  Nothing -> provsForGo available rest

-- (the chosen effect's providers, one per module, in the row's order)
provsFor : List Provider -> Ef.Effect -> List Provider
provsFor available eff =
  provsForGo available (nubStr (map (\k -> Ef.moduleOfKey k) (Ef.leaves eff)))

importLinesOf : List Provider -> List String
importLinesOf Nil = Nil
importLinesOf (Cons p rest) =
  concatList (filter (\l -> isImportLine l) (lines p.text)) (importLinesOf rest)

-- (a Node.js program runs itself again in a thread of its own, whose
-- stack is deep enough for what a heff program does; the first thread
-- passes on its arguments and -- once the program reads it -- its
-- standard input, says whether its output is a terminal, and ends with
-- the program's status -- or, where the program asked to
-- (std.process's `exec`), runs a command in its place, on the same
-- standard streams, and ends with the command's status.
-- HEFF_HEAP_MB, if set, bounds the thread's heap)
nodeHead : List String
nodeHead =
  [ "#!/usr/bin/env node"
  , "// Generated from Hippogriff; do not edit."
  , "import { Worker as $Worker, isMainThread as $isMainThread, parentPort as $parentPort } from \"node:worker_threads\";"
  , "import { spawn as $spawn } from \"node:child_process\";"
  ]

nodeRun : String -> String
nodeRun run =
  joinWith
    "\n"
    [ "if ($isMainThread) {"
    , "  if (process.stdout.isTTY) process.env.HEFF_TTY = \"1\";"
    , "  const limits = { stackSizeMb: 512, maxOldGenerationSizeMb: Number(process.env.HEFF_HEAP_MB) || undefined };"
    , "  const worker = new $Worker(new URL(import.meta.url), { argv: process.argv.slice(2), resourceLimits: limits, stdin: true });"
    , "  let piped = false, exec = null;"
    , "  worker.on(\"message\", (m) => {"
    , "    if (m && m.stdin && !piped) { piped = true; process.stdin.pipe(worker.stdin); }"
    , "    if (m && m.exec) exec = m.exec;"
    , "  });"
    , "  worker.on(\"error\", (e) => { console.error(e); process.exitCode = 1; });"
    , "  worker.on(\"exit\", (code) => {"
    , "    if (piped) { process.stdin.unpipe(worker.stdin); process.stdin.destroy(); }"
    , "    if (!exec) { process.exitCode = code; return; }"
    , "    const child = $spawn(exec[0], exec[1], { stdio: \"inherit\" });"
    , "    child.on(\"error\", (e) => { console.error(e.message); process.exitCode = 1; });"
    , "    child.on(\"exit\", (status) => { process.exitCode = status ?? 1; });"
    , "  });"
    , "} else {"
    , "  process.stdin.once(\"resume\", () => $parentPort.postMessage({ stdin: true }));"
    , "  " ++ run
    , "}"
    ]

-- (the line that runs the program, as the host runs it)
runFor : String -> String -> String
runFor host run = if strEq host "node" then nodeRun run else run

-- | whether the program's code has the bounces' runtime already
definesTr : Emitted -> Bool
definesTr m = any (\l -> strEq l trampolineStr) m.lines

runSource : String -> List Provider -> Ef.Effect -> String -> Emitted -> String
runSource host provs eff key m =
  joinWith
    "\n"
    (concatList
       (if strEq host "node" then nodeHead
        else Cons "// Generated from Hippogriff; do not edit." Nil)
       (concatList
          (nubStr (importLinesOf provs))
          (concatList
             m.lines
             [ ""
             , runtimeFor (definesTr m) provs eff
             , ""
             , runFor
               host
               ("$run(() => "
                ++ ref m.globals L.entryKey
                ++ ", "
                ++ handlerOf provs eff
                ++ ");")
             , ""
             ])))

compileLowered : String
               -> List Provider
               -> Ef.Effect
               -> String
               -> L.Lowered
               -> Output
compileLowered host provs eff key l =
  { source =
      runSource host provs eff key (emitDefs l.defs (Cons L.entryKey Nil))
  , errors = l.errors
  }

-- | one file that runs a computation (`key`) of the effect `eff` on a
-- | host (`node`, `page`): the
-- | program, the runtime, and each world's algebra from its provider --
-- | it imports nothing but what the providers do (`node:` builtins,
-- | hoisted), so a page loads it from file:// too
compileProgram : String
               -> List Provider
               -> G.Globals
               -> String
               -> Ef.Effect
               -> Output
compileProgram host available g key eff =
  compileLowered host (provsFor available eff) eff key (L.lowerProgram g key)

getterOf : M.Map String GInfo -> Export -> String
getterOf gs o =
  "  get " ++ propName o.name ++ "() { return $ext(" ++ ref gs o.key ++ "); },"

jsSource : List Export -> Emitted -> String
jsSource exports m =
  joinWith
    "\n"
    (concatList
       (Cons "// Generated from Hippogriff; do not edit." Nil)
       (concatList
          m.lines
          (concatList
             (concatList
                (if definesTr m then Nil else Cons trampolineStr Nil)
                ["", extStr, "", "export default {"])
             (concatList
                (map
                   (\o -> getterOf m.globals o)
                   (filter
                      (\(o : Export) -> M.member compareString o.key m.globals)
                      exports))
                (Cons "};" (Cons "" Nil))))))

compileExports : List Export -> L.Lowered -> Output
compileExports exports l =
  { source =
      jsSource exports (emitDefs l.defs (map (\(o : Export) -> o.key) exports))
  , errors = l.errors
  }

-- | a module whose default export has the given definitions by the
-- | given names (all of them, by their keys, if none is given)
compileJsWith : G.Globals -> List Export -> Output
compileJsWith g exports =
  compileExports exports (L.lower g (map (\(o : Export) -> o.key) exports))

compileJs : G.Globals -> List Export -> Output
compileJs g exports0 =
  compileJsWith
    g
    (if null exports0
       then map
           (\p -> case p of
            MkPair k _ -> mkExport k k)
           (G.globalsList g)
     else exports0)

-- >>> safe "co.<+>"
-- "co_op_lt_plus_gt"

-- >>> (emitDefs [I.mkDef "f" "f" (ELam ["x"] (EVar "x"))] ["f"]).lines
-- ["", "const f = (x) => x;"]
