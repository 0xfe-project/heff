-- Core syntax, printed as the heff source that constructs it, in a
-- canonical form.
-- Every constructor application is parenthesized; a nullary tag is bare.

import array as A
import heff.dict as D
import heff.params as P
import heff.syntax as Sx
import prelude

escChar : String -> String
escChar c =
  if strEq c "\"" then "\\\""
  else if strEq c "\\" then "\\\\"
  else if strEq c "\n" then "\\n"
  else if strEq c "\r" then "\\r"
  else if strEq c "\t" then "\\t"
  else c

escFrom : String -> Int -> String
escFrom s i =
  if i < strLength s then escChar (strSlice s i (i + 1)) ++ escFrom s (i + 1)
  else ""

-- | a string literal, as JavaScript (and Hippogriff) write it
quote : String -> String
quote s = "\"" ++ escFrom s 0 ++ "\""

commaSep : List String -> String
commaSep Nil = ""
commaSep (Cons x Nil) = x
commaSep (Cons x rest) = x ++ ", " ++ commaSep rest

listOf : List String -> String
listOf xs = "[" ++ commaSep xs ++ "]"

showI : Int -> String
showI n = if n < 0 then "(0 - " ++ showInt (0 - n) ++ ")" else showInt n

showLevel : P.Level -> String
showLevel Small = "Small"
showLevel Large = "Large"
showLevel TopL = "TopL"

showUniverse : P.Universe -> String
showUniverse SmallU = "SmallU"
showUniverse LargeU = "LargeU"

-- | (a plicity prints as its constructor: the dump stays readable back)
showPlicityB : P.Plicity -> String
showPlicityB Expl = "Expl"
showPlicityB Impl = "Impl"
showPlicityB Inst = "Inst"

showBool : Bool -> String
showBool True = "True"
showBool False = "False"

type Pr = { el : Sx.Tm -> String, ty : Sx.Ty -> String }

arrOf : {a : Type} -> (a -> String) -> Array a -> String
arrOf f xs = "(A.fromList " ++ listOf (map f (A.toList xs)) ++ ")"

dictOf : {a : Type} -> (a -> String) -> D.Dict a -> String
dictOf f d =
  "(D.fromList "
  ++ listOf
    (map
       (\p -> case p of
        MkPair k v -> "(MkPair " ++ quote k ++ " " ++ f v ++ ")")
       (D.toList d))
  ++ ")"

absOf : {a : Type} -> (a -> String) -> Sx.Abs a -> String
absOf f (MkAbs x b) = "(MkAbs " ++ quote x ++ " " ++ f b ++ ")"
absOf f (AbsConst b) = "(AbsConst " ++ f b ++ ")"

armOf : Pr -> Pair (Array String) Sx.Tm -> String
armOf r (MkPair xs b) = "(MkPair " ++ arrOf quote xs ++ " " ++ r.el b ++ ")"

showTermF : Pr -> Sx.Tm -> String
showTermF r (SLocal i) = "(SLocal " ++ showI i ++ ")"
showTermF r (SGlobal x) = "(SGlobal " ++ quote x ++ ")"
showTermF r (SCode a) = "(SCode " ++ r.ty a ++ ")"
showTermF r (SApp f a) = "(SApp " ++ r.el f ++ " " ++ r.el a ++ ")"
showTermF r (SLam a b) = "(SLam " ++ r.ty a ++ " " ++ absOf r.el b ++ ")"
showTermF r (SCons d) = "(SCons " ++ dictOf r.el d ++ ")"
showTermF r (SProj t x) = "(SProj " ++ r.el t ++ " " ++ quote x ++ ")"
showTermF r (STag x ts) = "(STag " ++ quote x ++ " " ++ arrOf r.el ts ++ ")"
showTermF r (SMatch t arms) =
  "(SMatch " ++ r.el t ++ " " ++ dictOf (armOf r) arms ++ ")"
showTermF r (SSpecialize t x t') =
  "(SSpecialize " ++ r.el t ++ " " ++ quote x ++ " " ++ r.el t' ++ ")"
showTermF r (SIs t) = "(SIs " ++ r.el t ++ ")"
showTermF r SOpaque = "SOpaque"
showTermF r SAbandon = "SAbandon"
showTermF r (SRec t) = "(SRec " ++ r.el t ++ ")"
showTermF r (SFix a b) = "(SFix " ++ r.ty a ++ " " ++ absOf r.el b ++ ")"
showTermF r (SImplicit x t) = "(SImplicit " ++ quote x ++ " " ++ r.el t ++ ")"
showTermF r (SPrim x) = "(SPrim " ++ quote x ++ ")"
showTermF r (SMetaApp m idxs a) =
  "(SMetaApp " ++ showI m ++ " " ++ arrOf showI idxs ++ " " ++ r.ty a ++ ")"
showTermF r (SLitInt n) = "(SLitInt " ++ showI n ++ ")"
showTermF r (SLitFloat x) = "(SLitFloat " ++ showFloat x ++ ")"
showTermF r (SLitString s) = "(SLitString " ++ quote s ++ ")"

showTypeF : Pr -> Sx.Ty -> String
showTypeF r (SU u) = "(SU " ++ showUniverse u ++ ")"
showTypeF r (SDecode t) = "(SDecode " ++ r.el t ++ ")"
showTypeF r (SFunction level dom cod implicit) =
  "(SFunction "
  ++ showLevel level
  ++ " "
  ++ r.ty dom
  ++ " "
  ++ absOf r.ty cod
  ++ " "
  ++ showPlicityB implicit
  ++ ")"
showTypeF r (SRecord level fieldTypes defaults) =
  "(SRecord "
  ++ showLevel level
  ++ " "
  ++ dictOf r.ty fieldTypes
  ++ " "
  ++ dictOf r.el defaults
  ++ ")"
showTypeF r (SSum st) = "(SSum " ++ dictOf (arrOf r.ty) st ++ ")"
showTypeF r (SIsTy t) = "(SIsTy " ++ r.ty t ++ ")"
showTypeF r SPrimInt = "SPrimInt"
showTypeF r SPrimFloat = "SPrimFloat"
showTypeF r SPrimString = "SPrimString"
showTypeF r (SPrimArray a) = "(SPrimArray " ++ r.ty a ++ ")"

pr : Pr
pr = { el = \t -> showTermF pr t, ty = \t -> showTypeF pr t }

showEl : Sx.Tm -> String
showEl t = pr.el t

showTy : Sx.Ty -> String
showTy t = pr.ty t

-- >>> showEl (SApp (SLam SPrimInt (MkAbs "x" (SLocal 0))) (SLitString "hi\n"))
-- "(SApp (SLam SPrimInt (MkAbs \"x\" (SLocal 0))) (SLitString \"hi\\n\"))"
