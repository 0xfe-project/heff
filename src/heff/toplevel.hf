-- Top-level elaboration: presyntax becomes
-- judgments (the dispatcher's functions are one knot record, `tk`),
-- declarations become globals, each elaborated in a fresh state; a
-- definition whose body fails is an error hole of its type.  A watch
-- (`-- >>> e`) elaborates to an entry of its own, kept aside.

import array as A
import heff.clauses as Cl
import heff.conversion as C
import heff.diagnostic
import heff.dict as D
import heff.environment
import heff.globals as G
import heff.memoed as M
import heff.meta as Mt
import heff.params as Pm
import heff.presyntax
import heff.prims as Pi
import heff.print as Pr
import heff.psurface as Ps
import heff.readback as Rb
import heff.rename as Rnm
import heff.rules as R
import heff.surface as Su
import heff.syntax as Sx
import heff.top as T
import heff.unify as U
import heff.value as V
import map as Mp
import prelude

-- Diagnostics (parser codes are numbered from 200)
--------------------------------------------------------------------------------

failP : {a : Type} -> Pm.Span -> Int -> String -> Elab a
failP sp code msg =
  throwE
    { code = 200 + code
    , severity = SError
    , msg = msg
    , span = sp
    , note = Nothing
    }

unexpectedNotation : {a : Type} -> Pm.Span -> String -> Elab a
unexpectedNotation sp c = failP sp 3 ("unexpected notation for " ++ c)

tryStep : {a : Type}
        -> Pair (Either Diag a) ElabSt
        -> Pair (Either Diag (Either Diag a)) ElabSt
tryStep (MkPair r st) = MkPair (Right r) st

-- | a computation, its failure as a value (the state kept either way)
tryE : {a : Type} -> Elab a -> Elab (Either Diag a)
tryE m = \st -> tryStep (m st)

-- The self, as local 0
--------------------------------------------------------------------------------

type SL = { el : Int -> Sx.Tm -> Sx.Tm, ty : Int -> Sx.Ty -> Sx.Ty }

selfTermF : SL -> String -> Int -> Sx.Tm -> Sx.Tm
selfTermF r k d t = case t of
  SGlobal x -> if strEq x k then SLocal d else SGlobal x
  SCode a -> SCode (r.ty d a)
  SApp f a -> SApp (r.el d f) (r.el d a)
  SLam dom (MkAbs x b) -> SLam (r.ty d dom) (MkAbs x (r.el (d + 1) b))
  SLam dom (AbsConst b) -> SLam (r.ty d dom) (AbsConst (r.el d b))
  SCons c -> SCons (D.mapD (r.el d) c)
  SProj e l -> SProj (r.el d e) l
  STag tg as -> STag tg (A.map (r.el d) as)
  SMatch e cs ->
    SMatch
      (r.el d e)
      (D.mapD
         (\p -> case p of
          MkPair xs b -> MkPair xs (r.el (d + A.length xs) b))
         cs)
  SSpecialize e l v -> SSpecialize (r.el d e) l (r.el d v)
  SIs e -> SIs (r.el d e)
  SRec e -> SRec (r.el d e)
  SFix dom (MkAbs x b) -> SFix (r.ty d dom) (MkAbs x (r.el (d + 1) b))
  SFix dom (AbsConst b) -> SFix (r.ty d dom) (AbsConst (r.el d b))
  SImplicit x e -> SImplicit x (r.el d e)
  SMetaApp m ix ty2 -> SMetaApp m ix (r.ty d ty2)
  _ -> t

selfTypeF : SL -> String -> Int -> Sx.Ty -> Sx.Ty
selfTypeF r k d t = case t of
  SDecode e -> SDecode (r.el d e)
  SFunction level dom (MkAbs x b) implicit ->
    SFunction level (r.ty d dom) (MkAbs x (r.ty (d + 1) b)) implicit
  SFunction level dom (AbsConst b) implicit ->
    SFunction level (r.ty d dom) (AbsConst (r.ty d b)) implicit
  SRecord level ft -> SRecord level (D.mapD (r.ty d) ft)
  SSum vs -> SSum (D.mapD (A.map (r.ty d)) vs)
  SIsTy a -> SIsTy (r.ty d a)
  SPrimArray a -> SPrimArray (r.ty d a)
  _ -> t

selfWalk : String -> SL
selfWalk k =
  { el = \d t -> selfTermF (selfWalk k) k d t
  , ty = \d t -> selfTypeF (selfWalk k) k d t
  }

-- | the global it was mentioned as, while it was not yet one: the
-- | definition itself, local 0
selfAsLocal : String -> Sx.Tm -> Sx.Tm
selfAsLocal k t = (selfWalk k).el 0 t

-- Judgments from presyntax
--------------------------------------------------------------------------------

data Judgment = ChkJ R.Chk | SynJ R.Syn | TypJ R.Typ

fromSynN : Pm.Case -> R.Syn -> Judgment
fromSynN N j = SynJ j
fromSynN De j =
  SynJ
    (MkSyn (\e -> do
     pr <- R.runSyn j (R.withFor e ForNominative)
     case pr of
       MkPair res a -> pure (MkPair (M.isM res) a)))

fromChkN : Pm.Case -> R.Chk -> Judgment
fromChkN N j = ChkJ j
fromChkN De j =
  ChkJ
    (MkChk (\e a -> do
     res <- R.runChk j (R.withFor e ForNominative) a
     pure (M.isM res)))

fromTypN : Pm.Case -> R.Typ -> Judgment
fromTypN N j = TypJ j
fromTypN De j =
  TypJ
    (MkTyp (\e -> do
     res <- R.runTyp j (R.withFor e ForNominative)
     pure (M.isTy res)))

fromTypD : Pm.Case -> Pm.Span -> R.Typ -> Elab Judgment
fromTypD N sp j = failP sp 4 "cannot use descriptive syntax in nominal position"
fromTypD De sp j = pure (TypJ j)

-- | presyntax that can only be checked, never synthesised
checksOnly : Expr -> Bool
checksOnly e = case Pm.nodeOf (spineOf e).head of
  ETag _ -> True
  EStruct _ -> True
  EMatch _ _ -> True
  ELetIn _ _ -> True
  ELocal _ _ -> True
  ETuple _ -> True
  EWord AbandonWord -> True
  ELam _ _ -> True
  _ -> False

implicitLambda : Expr -> Bool
implicitLambda (At (ELam (LamImplicit _ _) _) _) = True
implicitLambda _ = False

intoSyn : Pm.Span -> Judgment -> Elab R.Syn
intoSyn sp (ChkJ _) =
  failP sp 0 "this notation must be put in a checking position"
intoSyn sp (SynJ j) = pure j
intoSyn sp (TypJ _) =
  failP sp 0 "a type used as an element must be in checking position"

-- | the dispatcher's functions, knotted
type TK =
  { parseJ : Pm.Case -> Expr -> Elab Judgment
  , chkJ : Pm.Case -> Expr -> Elab R.Chk
  , synJ : Pm.Case -> Expr -> Elab R.Syn
  , typJ : Pm.Case -> Expr -> Elab R.Typ
  }

-- | a check, recovered from where it fails -- where its presyntax is not
-- | read, too
recoveringChk : Elab R.Chk -> Elab R.Chk
recoveringChk m = do
  r <- tryE m
  case r of
    Right c -> pure (R.recovering c)
    Left d -> pure (R.recovering (MkChk (\e a -> throwE d)))

-- | an argument: where it does not check, an error hole
argumentF : TK -> Expr -> Elab R.Chk
argumentF tk e = recoveringChk (tk.chkJ N e)

-- | an application to `e`, from `start` (where the function is) to it
elimF : TK -> Int -> R.Syn -> Expr -> Elab R.Syn
elimF tk start s (At (EProject x) sp) = pure (R.recordElim sp s x)
elimF tk start s (At (ENamed x e) sp) = do
  a <- argumentF tk e
  pure (R.functionElimNamed { start = start, end = sp.end } x s a)
elimF tk start s e = do
  a <- argumentF tk e
  pure
      (R.functionElimC
         (checksOnly e)
         { start = start, end = (Pm.spanOf e).end }
         s
         a)

elimAll : TK -> Int -> R.Syn -> List Expr -> Elab R.Syn
elimAll tk start s Nil = pure s
elimAll tk start s (Cons e rest) = do
  s' <- elimF tk start s e
  elimAll tk start s' rest

binderF : TK -> PiBinder Expr -> Elab R.Binder
binderF tk (PiNamed x _ t) = do
  a <- tk.typJ N t
  pure (Named x a)
binderF tk (PiInstance x _ sp t) = do
  a <- tk.typJ N t
  pure (NamedInstance sp x a)
binderF tk (PiImplicit x _ sp t) = do
  a <- tk.typJ N t
  pure (NamedImplicit sp x a)
binderF tk (PiAnon d) = do
  a <- tk.typJ N d
  pure (Anonymous a)

fieldDeclF : TK -> Pm.Spanned (FieldDecl Expr) -> Elab R.FieldDeclaration
fieldDeclF tk (At (DeclareField x _ t) _) = do
  a <- tk.typJ N t
  pure { name = x, typ = a }
fieldDeclF tk (At (BadFieldDecl _) sp) =
  failP sp 1 "expected a field declaration of the form `x : A`"

fieldSetF : TK -> Pm.Case -> Pm.Spanned (FieldSet Expr) -> Elab R.FieldSetting
fieldSetF tk c (At (SetField x xsp e) _) = do
  v <- recoveringChk (tk.chkJ c e)
  pure { name = x, chk = v, span = Pm.spanOf e, nameSpan = xsp }
fieldSetF tk c (At (BadFieldSet _) sp) =
  failP sp 2 "expected a field setting of the form `x = v`"

traverseEL : {a b : Type} -> (a -> Elab b) -> List a -> Elab (List b)
traverseEL f Nil = pure Nil
traverseEL f (Cons x xs) = do
  y <- f x
  ys <- traverseEL f xs
  pure (Cons y ys)

smallF : TK -> Expr -> Elab R.SmallTyp
smallF tk e = do
  t <- tk.typJ N e
  pure (R.asSmall (Pm.spanOf e) t)

variantF : TK
         -> Pm.Spanned (Variant Expr)
         -> Elab (Pair String (Array R.SmallTyp))
variantF tk (At (TagVariant x _ args) _) = do
  typs <- traverseEL (\m -> smallF tk m) args
  pure (MkPair x (A.fromList typs))
variantF tk (At (BadVariant _) sp) =
  unexpectedNotation sp "variant in a sum type"

foldlR : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldlR f z Nil = z
foldlR f z (Cons x xs) = f x (foldlR f z xs)

-- | `bind e (\x -> rest)`
doBind : Pm.Span -> Expr -> String -> Pm.Span -> Expr -> Expr
doBind sp e x xsp rest = app (At (EVar "bind") sp) [e, lamName x xsp rest]

-- | `let p = e`, the statements after it its body
letOver : Pm.Span -> Pat -> Expr -> Expr -> Expr
letOver lsp p rhs rest =
  At (ELetIn rhs (alt p rest)) { start = lsp.start, end = (Pm.spanOf rest).end }

doStep : Pm.Span -> Pm.Spanned (Stmt Expr) -> Expr -> Expr
doStep sp (At (StmtBind x xsp e) _) rest = doBind sp e x xsp rest
doStep sp (At (StmtLet p rhs) lsp) rest = letOver lsp p rhs rest
doStep sp (At (StmtExpr e) _) rest = doBind sp e "_" sp rest

doLast : Pm.Span
       -> List (Pm.Spanned (Stmt Expr))
       -> Pm.Spanned (Stmt Expr)
       -> Maybe Expr
doLast sp init (At (StmtExpr e) _) =
  Just (foldlR (\s rest -> doStep sp s rest) e init)
doLast sp init _ = Nothing

-- | `do` ... with whichever `bind` is in scope
doBlock : Pm.Span -> List (Pm.Spanned (Stmt Expr)) -> Maybe Expr
doBlock sp stmts = case reverse stmts of
  Nil -> Nothing
  Cons last init -> doLast sp (reverse init) last

-- | a whole value needs no new name: it is in hand already
bareAltRefused : {a : Type} -> String -> Pm.Span -> Elab a
bareAltRefused x sp =
  failP
    sp
    3
    ("`"
     ++ x
     ++ "` would be a new name for the whole value, which a `case` alternative cannot bind: `_` matches every other value, and the value is in hand already")

patName : Pat -> Elab String
patName (At (PatVar x) _) = pure x
patName p =
  failP (Pm.spanOf p) 3 "an argument of a `case` pattern is a pattern or a name"

doPat : Pat -> Elab (Pair String (List String))
doPat p = case (patSpineOf p).head of
  At (PatTag x _ _) _ -> do
    xs <- traverseEL (\q -> patName q) (patSpineOf p).args
    pure (MkPair x xs)
  -- extension: `_ => e` handles every tag not listed
  At (PatVar x) sp ->
    if strEq x "_" && length (patSpineOf p).args == 0 then pure (MkPair "_" Nil)
    else bareAltRefused x sp
  _ ->
    failP
      (Pm.spanOf p)
      3
      "a `case` pattern is a pattern: a tag applied to patterns, a literal, or `_`"

doCase : TK
       -> Pm.Spanned (Alt Expr)
       -> Elab (Pair String (Pair (Array String) R.Chk))
doCase tk (At (MkAlt p bodyN) _) = do
  px <- doPat p
  case px of
    MkPair x xs -> do
      body <- recoveringChk (tk.chkJ N bodyN)
      pure (MkPair x (MkPair (A.fromList xs) body))

allL : {a : Type} -> (a -> Bool) -> List a -> Bool
allL p Nil = True
allL p (Cons x xs) = p x && allL p xs

isData : Expr -> Bool
isData e = case Pm.nodeOf e of
  ETag _ -> True
  EStruct _ -> True
  ETuple _ -> True
  _ -> False

-- | `(e : T)`, `e` a tag, a record or a tuple: in the core it is `e`,
-- | which does not say its type
annotatesData : Expr -> Bool
annotatesData (At (EAnn e _) _) = isData (spineOf e).head
annotatesData _ = False

isVarP : Pat -> Bool
isVarP (At (PatVar _) _) = True
isVarP _ = False

flatPat : PatSpine -> Bool
flatPat gr = case Pm.nodeOf gr.head of
  PatTag _ _ _ -> allL isVarP gr.args
  PatVar _ -> length gr.args == 0
  _ -> False

-- | flat: a tag applied to names, or `_`; anything else goes through the
-- | match-tree compiler
flatCaseAlt : Pm.Spanned (Alt Expr) -> Bool
flatCaseAlt (At (MkAlt p _) _) = flatPat (patSpineOf p)

tagSpanOf : Pat -> List (Pair String Pm.Span) -> List (Pair String Pm.Span)
tagSpanOf p acc = case (patSpineOf p).head of
  At (PatTag x _ _) tsp -> Cons (MkPair x tsp) acc
  _ -> acc

tagSpans : List (Pm.Spanned (Alt Expr)) -> List (Pair String Pm.Span)
tagSpans Nil = Nil
tagSpans (Cons (At (MkAlt p _) _) rest) = tagSpanOf p (tagSpans rest)

checkBareOne : PatSpine -> Elab Unit
checkBareOne gr = case gr.head of
  At (PatVar x) xsp ->
    if length gr.args == 0 && not (strEq x "_") then bareAltRefused x xsp
    else pure MkUnit
  _ -> pure MkUnit

checkBareAlts : List (Pm.Spanned (Alt Expr)) -> Elab Unit
checkBareAlts Nil = pure MkUnit
checkBareAlts (Cons (At (MkAlt p _) _) rest) = do
  checkBareOne (patSpineOf p)
  checkBareAlts rest
-- Operators in patterns
--------------------------------------------------------------------------------

-- | the lambdas a body opens with, and what is under them (and under
-- | its mark of case D)
lamsOf : Int -> Sx.Tm -> Pair Int Sx.Tm
lamsOf n (SLam _ (MkAbs _ b)) = lamsOf (n + 1) b
lamsOf n (SLam _ (AbsConst b)) = lamsOf (n + 1) b
lamsOf n (SIs b) = lamsOf n b
lamsOf n b = MkPair n b

absBody : Sx.Abs Sx.Ty -> Sx.Ty
absBody (MkAbs _ t) = t
absBody (AbsConst t) = t

-- | a function type's implicit parameters, then its explicit ones: how
-- | many of each (`Nothing` if they are mixed otherwise)
paramsOf : Int -> Int -> Sx.Ty -> Maybe (Pair Int Int)
paramsOf i e (SFunction _ _ cod Impl) =
  if e > 0 then Nothing else paramsOf (i + 1) e (absBody cod)
paramsOf i e (SFunction _ _ cod Expl) = paramsOf i (e + 1) (absBody cod)
paramsOf i e (SFunction _ _ _ Inst) = Nothing
paramsOf i e _ = Just (MkPair i e)

-- | the arguments are the variables of the last `k` lambdas, in order
paramsInOrder : Int -> Int -> List Sx.Tm -> Bool
paramsInOrder k i Nil = i == k
paramsInOrder k i (Cons (SLocal j) rest) =
  j == k - 1 - i && paramsInOrder k (i + 1) rest
paramsInOrder k i _ = False

-- | `(op) x y = C x y`: the tag an operator is another name for, and how
-- | many arguments it takes
tagSynonym : G.Entry -> Maybe (Pair String Int)
tagSynonym ge = case paramsOf 0 0 ge.tySyntax of
  Just (MkPair i k) -> case lamsOf 0 ge.syntax of
    MkPair n (STag t args) ->
      if n == i + k && paramsInOrder k 0 (A.toList args) then Just (MkPair t k)
      else Nothing
    _ -> Nothing
  Nothing -> Nothing

notTagSynonym : {a : Type} -> String -> Pm.Span -> Elab a
notTagSynonym x sp =
  failP
    sp
    3
    ("`"
     ++ x
     ++ "` is not another name for a tag, so no pattern can use it: an operator in a pattern is defined as one, `("
     ++ x
     ++ ") x y = C x y`")

-- | an operator applied, `x :: xs`, in a pattern
hasOpPat : Pat -> Bool
hasOpPat p = case Pm.nodeOf p of
  PatOp _ _ _ -> True
  PatRecord fs ->
    not
      (allL
         (\f -> case f of
          MkFieldPat _ q -> not (hasOpPat q))
         fs)
  PatTag _ _ ps -> not (allL (\m -> not (hasOpPat m)) ps)
  _ -> False

-- | (`opPat`, the knot) `x = p`, a field of a record pattern
opField : (Pat -> Elab Pat) -> FieldPat Pat -> Elab (FieldPat Pat)
opField op (MkFieldPat x p) = do
  p' <- op p
  pure (MkFieldPat x p')

-- | a pattern, its operators as the tags they are other names for
opPat : G.Globals -> Pat -> Elab Pat
opPat g p = case p of
  At (PatOp x xsp args) _ -> case G.lookupKey g x of
    Just (MkPair _ ge) -> case tagSynonym ge of
      Just (MkPair t k) ->
        if k == length args
          then do
            args' <- traverseEL (\m -> opPat g m) args
            pure (patTag t xsp args')
        else notTagSynonym x xsp
      Nothing -> notTagSynonym x xsp
    Nothing -> failP xsp 3 ("no such operator " ++ x ++ " in scope")
  At (PatRecord fs) sp -> do
    fs' <- traverseEL (\m -> opField (\q -> opPat g q) m) fs
    pure (At (PatRecord fs') sp)
  At (PatTag t tsp args) _ -> do
    args' <- traverseEL (\m -> opPat g m) args
    pure (patTag t tsp args')
  _ -> pure p

altHasOp : Pm.Spanned (Alt Expr) -> Bool
altHasOp (At (MkAlt p _) _) = hasOpPat p

opAlt : G.Globals -> Pm.Spanned (Alt Expr) -> Elab (Pm.Spanned (Alt Expr))
opAlt g (At (MkAlt p body) sp) = do
  p' <- opPat g p
  pure (At (MkAlt p' body) sp)

eqnHasOp : Pm.Spanned (Equation Expr) -> Bool
eqnHasOp (At (MkEquation _ _ ps _) _) = not (allL (\m -> not (hasOpPat m)) ps)

opEquation : G.Globals
           -> Pm.Spanned (Equation Expr)
           -> Elab (Pm.Spanned (Equation Expr))
opEquation g (At (MkEquation f fsp ps rhs) sp) = do
  ps' <- traverseEL (\m -> opPat g m) ps
  pure (At (MkEquation f fsp ps' rhs) sp)

-- | a local definition's body: its equations, as a match
localEqs : TK
         -> String
         -> List (Pm.Spanned (Equation Expr))
         -> Pm.Span
         -> Elab R.Chk
localEqs tk f eqs sp = case Cl.desugar f Nil eqs sp of
  Left err -> failP err.span 10 err.msg
  Right b -> tk.chkJ N b

-- (an operator in a pattern is found where the globals are in hand)
localBody : TK
          -> String
          -> List (Pm.Spanned (Equation Expr))
          -> Pm.Span
          -> Elab R.Chk
localBody tk f eqs sp =
  if not (allL (\m -> not (eqnHasOp m)) eqs)
    then pure
        (MkChk (\e a -> do
         eqs' <- traverseEL (\m -> opEquation e.globals m) eqs
         j <- localEqs tk f eqs' sp
         R.runChk j e a))
  else localEqs tk f eqs sp

-- | extension: an equation's `where`: each local definition, `f : T` by
-- | its equations, in scope in those after it and in the equation's body
localsJ : TK -> List Decl -> Expr -> Elab R.Chk
localsJ tk Nil bodyN = tk.chkJ N bodyN
localsJ tk (d :: ds) bodyN = case Pm.nodeOf d of
  DeclEquations name _ tyN eqs -> do
    ty <- tk.typJ N tyN
    body <- localBody tk name eqs (Pm.spanOf d)
    rest <- localsJ tk ds bodyN
    pure (R.localDef name ty body rest)
  _ -> unexpectedNotation (Pm.spanOf d) "local definition"

-- | the head of a spine, parsed
parseHeadF : TK -> Pm.Case -> Expr -> Elab Judgment
parseHeadF tk c n = case n of
  -- Variable rule
  At (EVar x) sp -> pure (fromSynN c (R.find sp x))
  -- Type formers
  At (EPi b codN) _ -> do
    dom <- binderF tk b
    cod <- tk.typJ N codN
    pure (fromTypN c (R.functionFormation dom cod))
  At (ESig fields) sp -> do
    fieldDecls <- traverseEL (\m -> fieldDeclF tk m) fields
    fromTypD c sp (R.recordFormation fieldDecls)
  At (ESum variantNs) sp -> do
    variants <- traverseEL (\m -> variantF tk m) variantNs
    fromTypD c sp (R.sumFormation (D.fromList variants))
  At (EWord TypeWord) _ -> pure (fromTypN c (R.universeFormation SmallU))
  -- Introduction rules (except for tag)
  At (ELam (LamName x _) bodyN) _ -> do
    body <- recoveringChk (tk.chkJ c bodyN)
    pure (ChkJ (R.functionIntro (Pm.spanOf n) x body))
  -- extension: `\(x : T) -> e` annotates the binder
  At (ELam (LamAnn x _ tyN) bodyN) _ -> do
    dom <- tk.typJ N tyN
    bj <- tk.parseJ N bodyN
    case bj of
      SynJ body -> pure (fromSynN c (R.functionIntroSyn x dom body))
      ChkJ j ->
        pure
          (fromChkN
             c
             (R.functionIntroAnn
                (Pm.spanOf n)
                x
                dom
                (if implicitLambda bodyN then j else R.implicitLams j)))
      TypJ j ->
        pure
          (fromChkN
             c
             (R.functionIntroAnn
                (Pm.spanOf n)
                x
                dom
                (R.universeIntro (Pm.spanOf bodyN) j)))
  -- extension: `{x} => e` names an implicit argument
  At (ELam (LamImplicit x _) bodyN) _ -> do
    body <- recoveringChk (tk.chkJ c bodyN)
    pure (ChkJ (R.functionIntroImplicit (Pm.spanOf n) x body))
  At (EStruct fields) sp -> do
    fieldSettings <- traverseEL (\m -> fieldSetF tk c m) fields
    pure (ChkJ (R.recordIntro sp fieldSettings))
  -- extension: `do` ... with whichever `bind` is in scope
  At (EDo stmts) sp -> case doBlock sp stmts of
    Just n' -> tk.parseJ c n'
    Nothing -> failP sp 12 "a `do` block ends with an expression"
  At (EMatch scrutN casesN) sp ->
    -- (an operator in a pattern is found where the globals are in hand)
    if not (allL (\m -> not (altHasOp m)) casesN)
      then pure
          (fromChkN
             c
             (MkChk (\e a -> do
              casesN' <- traverseEL (\m -> opAlt e.globals m) casesN
              j <- tk.chkJ N (At (EMatch scrutN casesN') sp)
              R.runChk j e a)))
    -- (a scrutinee `(e : T)`, `e` a tag or a record, is `e` in the core,
    -- which does not say its type there: it is bound to a name, below)
    else if allL flatCaseAlt casesN && not (annotatesData scrutN)
      then do
        scrut <- tk.synJ N scrutN
        cases <- traverseEL (\m -> doCase tk m) casesN
        pure
            (fromChkN
               c
               (R.sumElim sp scrut (tagSpans casesN) (D.fromList cases)))
    -- extension: nested patterns and literals, compiled into the flat
    -- matches above, on a name for the scrutinee, bound once
    else do
      checkBareAlts casesN
      case Cl.caseTree sp casesN of
        Left err -> failP err.span 3 err.msg
        Right r -> do
          scrut <- tk.synJ N scrutN
          body <- tk.chkJ N r.tree
          pure (fromChkN c (R.caseLet r.scrutinee scrut body))
  -- extension: `let x = e in e'`, `e` synthesised (`let x : T = e` if it
  -- is not), bound once by a beta-redex; `let p = e in e'`, a `case` of
  -- one alternative, which must match every value
  At (ELetIn rhsN alt0) sp -> case alt0 of
    At (MkAlt (At (PatVar x) _) bodyN) _ -> do
      rhs <- tk.synJ N rhsN
      body <- recoveringChk (tk.chkJ N bodyN)
      pure (fromChkN c (R.caseLet x rhs body))
    _ -> tk.parseJ c (At (EMatch rhsN (Cons alt0 Nil)) sp)
  -- extension: an equation's body and its local definitions (`where`)
  At (ELocal bodyN defs) sp -> do
    j <- localsJ tk defs bodyN
    pure (fromChkN c j)
  -- Misc.
  At (EWord AbandonWord) sp -> pure (fromChkN c (R.abandonChk sp))
  At (ESpec n0 x _ v) _ -> do
    cc <- tk.chkJ N v
    s <- tk.synJ N n0
    pure (fromSynN c (R.recordSpec (Pm.spanOf n) s x cc))
  At (ESpecOther n0 n1) _ -> unexpectedNotation (Pm.spanOf n1) "specialization"
  At (EAnn n0 n1) _ -> do
    cc <- tk.chkJ c n0
    t <- tk.typJ N n1
    pure (SynJ (R.annot t cc))
  At (EWord IntWord) _ -> pure (fromTypN c R.primInt)
  At (EInt i) _ -> pure (fromSynN c (R.litInt i))
  At (EWord FloatWord) _ -> pure (fromTypN c R.primFloat)
  At (EFloat x) _ -> pure (fromSynN c (R.litFloat x))
  At (EWord StringWord) _ -> pure (fromTypN c R.primString)
  At (EString s) _ -> pure (fromSynN c (R.litString s))
  _ -> failP (Pm.spanOf n) 3 "unexpected notation"

parseArray : TK -> Pm.Case -> Expr -> List Expr -> Elab Judgment
parseArray tk c n (Cons n0 Nil) = do
  a <- tk.typJ N n0
  pure (fromTypN c (R.primArray a))
parseArray tk c n args = failP (Pm.spanOf n) 3 "`Array` takes one type"

parseF : TK -> Pm.Case -> Expr -> Elab Judgment
parseF tk c n = case (spineOf n).head of
  At (ETag x) tsp -> do
    args <- traverseEL (\m -> argumentF tk m) (spineOf n).args
    pure (fromChkN c (R.sumIntro (Pm.spanOf n) tsp x args))
  At (EWord ArrayWord) _ -> parseArray tk c n (spineOf n).args
  _ ->
    if length (spineOf n).args == 0 then parseHeadF tk c (spineOf n).head
    else do
      h <- parseHeadF tk N (spineOf n).head
      s0 <- intoSyn (Pm.spanOf (spineOf n).head) h
      s <- elimAll tk (Pm.spanOf (spineOf n).head).start s0 (spineOf n).args
      pure (fromSynN c s)

chkHeadOf : Expr -> R.Syn -> R.Chk
chkHeadOf n j = case (spineOf n).head of
  At (EVar x) _ -> R.autoRec (Pm.spanOf n) x (R.apply (Pm.spanOf n) j)
  _ -> R.apply (Pm.spanOf n) j

chkF : TK -> Pm.Case -> Expr -> Elab R.Chk
chkF tk c n = do
  j <- tk.parseJ c n
  case j of
    -- (`{x} => e` binds the implicit argument itself)
    ChkJ j2 -> pure (if implicitLambda n then j2 else R.implicitLams j2)
    SynJ j2 -> pure (R.implicitLams (chkHeadOf n j2))
    TypJ j2 -> pure (R.universeIntro (Pm.spanOf n) j2)

synF : TK -> Pm.Case -> Expr -> Elab R.Syn
synF tk c n = do
  j <- tk.parseJ c n
  intoSyn (Pm.spanOf n) j

typF : TK -> Pm.Case -> Expr -> Elab R.Typ
typF tk c n = do
  j <- tk.parseJ c n
  case j of
    ChkJ j2 -> pure (R.universeElim LargeU j2)
    SynJ j2 -> pure (R.universeElimSyn (Pm.spanOf n) j2)
    TypJ j2 -> pure j2

tk : TK
tk =
  { parseJ = \c n -> parseF tk c n
  , chkJ = \c n -> chkF tk c n
  , synJ = \c n -> synF tk c n
  , typJ = \c n -> typF tk c n
  }

-- Declarations
--------------------------------------------------------------------------------

type ArgBinding =
  { span : Pm.Span, name : String, typ : R.Typ, implicit : Pm.Plicity }

mkArgBinding : Pm.Span -> String -> R.Typ -> Pm.Plicity -> ArgBinding
mkArgBinding span name typ implicit =
  { span = span, name = name, typ = typ, implicit = implicit }

argBinding : Pm.Spanned (Param Expr) -> Elab ArgBinding
argBinding (At (ExplicitParam x _ t) sp) = do
  a <- tk.typJ N t
  pure (mkArgBinding sp x a Expl)
argBinding (At (ImplicitParam x _ t) sp) = do
  a <- tk.typJ N t
  pure (mkArgBinding sp x a Impl)

withOne : ArgBinding -> Pair R.Typ R.Chk -> Pair R.Typ R.Chk
withOne ab (MkPair t c) = case ab.implicit of
  Impl ->
    MkPair
      (R.functionFormation (NamedImplicit ab.span ab.name ab.typ) t)
      (R.functionIntroImplicit ab.span ab.name c)
  Inst ->
    MkPair
      (R.functionFormation (NamedInstance ab.span ab.name ab.typ) t)
      (R.functionIntroImplicit ab.span ab.name c)
  Expl ->
    MkPair
      (R.functionFormation (Named ab.name ab.typ) t)
      (R.functionIntro ab.span ab.name c)

withArgs : List ArgBinding -> Pair R.Typ R.Chk -> Pair R.Typ R.Chk
withArgs Nil base = base
withArgs (Cons ab rest) base = withOne ab (withArgs rest base)

type DeclJ = { name : String, ty : R.Typ, tm : R.Chk, prim : Bool }

mkDeclJ : String -> R.Typ -> R.Chk -> Bool -> DeclJ
mkDeclJ name ty tm prim = { name = name, ty = ty, tm = tm, prim = prim }

declOfParts : String -> Pair R.Typ R.Chk -> Bool -> Elab DeclJ
declOfParts name (MkPair ty tm) prim = pure (mkDeclJ name ty tm prim)

-- | `theory T a where` and its fields
theoryD : String -> List (Pm.Spanned (Param Expr)) -> Expr -> Elab DeclJ
theoryD name params bodyN = do
  args <- traverseEL (\m -> argBinding m) params
  body <- tk.chkJ De bodyN
  declOfParts
      name
      (withArgs args (MkPair (MkTyp (\e -> pure (M.univ LargeU))) body))
      False

explicitNames : List ArgBinding -> List String
explicitNames Nil = Nil
explicitNames (Cons ab rest) =
  if not (Pm.eqPlicity ab.implicit Expl) then explicitNames rest
  else Cons ab.name (explicitNames rest)

-- | `data T a = ...`, `type T a = ...`: a definition with named
-- | arguments, its type and its body
defineD : String -> List (Pm.Spanned (Param Expr)) -> Expr -> Expr -> Elab DeclJ
defineD name params tyN bodyN = do
  args <- traverseEL (\m -> argBinding m) params
  returnTyp <- tk.typJ N tyN
  body <- tk.chkJ De bodyN
  declOfParts name (withArgs args (MkPair returnTyp body)) False

equationsBody : String
              -> List ArgBinding
              -> List (Pm.Spanned (Equation Expr))
              -> Pm.Span
              -> Elab R.Chk
equationsBody name args eqs sp = do
  bodyN <- case Cl.desugar name (explicitNames args) eqs sp of
    Left err -> failP err.span 10 err.msg
    Right b -> pure b
  tk.chkJ De bodyN

-- | a definition by equations, `f : T` and `f p ... = e`; `sp`, from the
-- | type to the last equation
equationsD : String
           -> Expr
           -> List (Pm.Spanned (Equation Expr))
           -> Pm.Span
           -> Elab DeclJ
equationsD name tyN eqs sp = do
  body <-
    if not (allL (\m -> not (eqnHasOp m)) eqs)
      then pure
          (MkChk (\e a -> do
           eqs' <- traverseEL (\m -> opEquation e.globals m) eqs
           j <- equationsBody name Nil eqs' sp
           R.runChk j e a))
    else equationsBody name Nil eqs sp
  returnTyp <- tk.typJ N tyN
  declOfParts name (withArgs Nil (MkPair returnTyp body)) False

declJ : Decl -> Elab DeclJ
declJ d = case Pm.nodeOf d of
  DeclTheory name _ params bodyN -> theoryD name params bodyN
  DeclDefine name _ params tyN bodyN -> defineD name params tyN bodyN
  DeclEquations name _ tyN eqs ->
    equationsD
      name
      tyN
      eqs
      { start = (Pm.spanOf tyN).start, end = (Pm.spanOf d).end }
  -- extension: `primitive name : T`, implemented by the runtime
  DeclPrimitive x _ tyN -> do
    ty <- tk.typJ N tyN
    pure
        (mkDeclJ
           x
           ty
           (MkChk (\e a -> pure { stx = SPrim x, val = \u -> Nom VOpaque }))
           True)
  _ -> unexpectedNotation (Pm.spanOf d) "top-level declaration"

-- Elaborating one declaration
--------------------------------------------------------------------------------

-- | fail, if errors were recovered from (they are reported, this is not)
recoveredCheck : Elab Unit
recoveredCheck = do
  ds <- gets (\st -> (core st).recovered)
  if length ds == 0 then pure MkUnit
    else failElsewhere Pm.noSpan "errors recovered from"

anyL : {a : Type} -> (a -> Bool) -> List a -> Bool
anyL p Nil = False
anyL p (Cons x xs) = p x || anyL p xs

unsolvedPoisoned : V.MetaCtx -> Int -> Bool
unsolvedPoisoned mc m = case Mp.lookup compareInt m mc of
  Just me -> case me.sol of
    Just _ -> False
    Nothing -> True
  Nothing -> False

-- | fail, unreported, if an implicit argument is left that an error hole
-- | kept from being inferred
poisonedLeft : Elab Unit
poisonedLeft = do
  ps <- gets (\st -> (core st).poisoned)
  mc <- gets (\st -> (core st).metas)
  if anyL (\m -> unsolvedPoisoned mc m) (Mp.keys ps)
      then failElsewhere
          Pm.noSpan
          "an implicit argument an error kept from being inferred"
    else pure MkUnit

appendM : {a : Type} -> List a -> List a -> List a
appendM Nil ys = ys
appendM (Cons x xs) ys = Cons x (appendM xs ys)

concatMapM : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapM f Nil = Nil
concatMapM f (Cons x xs) = appendM (f x) (concatMapM f xs)

spineVals : V.Spine V.V -> List V.V
spineVals SpId = Nil
spineVals (SpApp sp e) = appendM (spineVals sp) (Cons e Nil)
spineVals (SpProj sp _) = spineVals sp
spineVals (SpSpec sp _ e) = appendM (spineVals sp) (Cons e Nil)

headMeta : V.Head -> List Int
headMeta (HMeta m) = Cons m Nil
headMeta _ = Nil

-- | the metavariables not yet solved in a value: at its head, or in
-- | its spine's arguments
metasInV : V.MetaCtx -> V.V -> List Int
metasInV mc v = case V.forceEl mc v of
  VNeu h sp ty expansion desc ->
    appendM (headMeta h) (concatMapM (\v2 -> metasInV mc v2) (spineVals sp))
  _ -> Nil

nubInt : List Int -> List Int
nubInt Nil = Nil
nubInt (Cons x xs) = Cons x (nubInt (filter (\y -> not (y == x)) xs))

shownV : G.Globals -> V.MetaCtx -> Pm.CtxShape -> V.V -> String
shownV g mc cs v =
  Ps.printEl
    Ps.plainImplicits
    0
    cs.names
    (Rnm.renameEl (Rnm.displayName g) (Rb.readbEl cs.len (V.forceEl mc v)))

aboutMeta : V.MetaCtx -> Postponed -> Maybe V.MetaEntry
aboutMeta mc p = case head
    (nubInt (appendM (metasInV mc p.left) (metasInV mc p.right))) of
  Just m -> Mp.lookup compareInt m mc
  Nothing -> Nothing

-- a problem that was retried and found contradictory: not missing
-- information, a mismatch -- say so, where the implicit was asked for
stuckWith : Pm.Span
          -> Postponed
          -> Maybe V.MetaEntry
          -> String
          -> String
          -> Diag
stuckWith fallback p about left right =
  if p.failed
    then { code = 311
         , severity = SError
         , msg =
             "the implicit arguments found do not fit together: "
             ++ left
             ++ " and "
             ++ right
             ++ " are not equal"
         , span =
             (case about of
              Just me -> me.span
              Nothing -> fallback)
         , note =
             (case about of
              Just me ->
                Just
                  ("found for `"
                   ++ me.name
                   ++ "`, it would need "
                   ++ left
                   ++ " = "
                   ++ right)
              Nothing -> Nothing)
         }
  else case about of
    Just me ->
      { code = 327
      , severity = SError
      , msg =
          "cannot infer the implicit argument `"
          ++ me.name
          ++ "`: give it, `("
          ++ me.name
          ++ " := ...)`"
      , span = me.span
      , note =
          Just
            ("what is known of it, "
             ++ left
             ++ " = "
             ++ right
             ++ ", does not say what it is")
      }
    Nothing ->
      { code = 327
      , severity = SError
      , msg =
          "cannot infer an implicit argument: "
          ++ left
          ++ " = "
          ++ right
          ++ " does not say what it is"
      , span = fallback
      , note = Nothing
      }

stuckAt : G.Globals -> Pm.Span -> Postponed -> V.MetaCtx -> Diag
stuckAt g fallback p mc =
  stuckWith
    fallback
    p
    (aboutMeta mc p)
    (shownV g mc p.shape p.left)
    (shownV g mc p.shape p.right)

stuckDiag : G.Globals -> Pm.Span -> Postponed -> Elab Diag
stuckDiag g fallback p = do
  mc <- gets (\st -> (core st).metas)
  pure (stuckAt g fallback p mc)

type Elaborated =
  { name : String
  , key : String
  , prim : Bool
  , entry : G.Entry
  , failed : Maybe Diag
  }

mkElaborated : String -> String -> Bool -> G.Entry -> Maybe Diag -> Elaborated
mkElaborated name key prim entry failed =
  { name = name, key = key, prim = prim, entry = entry, failed = failed }

-- | the entry a definition is stored as, from its core syntax alone
entryFor : G.Globals -> String -> Bool -> Sx.Ty -> Sx.Tm -> G.Entry
entryFor g k prim tyStx bodyStx =
  { syntax = bodyStx
  , tySyntax = tyStx
  , value =
      if prim then T.primValueOf g k tyStx else T.valueOf g k tyStx bodyStx
  , type_ = T.typeOf g tyStx
  }

errEntry : G.Globals -> String -> Sx.Ty -> G.Entry
errEntry g k tyStx =
  { syntax = SAbandon
  , tySyntax = tyStx
  , value = V.errorHole (T.typeOf g tyStx)
  , type_ = T.typeOf g tyStx
  }

checkStuck : G.Globals -> Pm.Span -> List Postponed -> Elab Unit
checkStuck g sp Nil = pure MkUnit
checkStuck g sp (Cons p rest) = do
  d <- stuckDiag g sp p
  throwE (a := Unit) d

checkUnsolved : List Mt.Unsolved -> Elab Unit
checkUnsolved Nil = pure MkUnit
checkUnsolved (Cons u rest) =
  throwE
    { code = 328
    , severity = SError
    , msg =
        "cannot infer the implicit argument `"
        ++ u.name
        ++ "`; give it as `{...}`"
    , span = u.span
    , note = Nothing
    }

withSelf : ElabEnv -> String -> Scope -> ElabEnv
withSelf e k sc =
  { scope = sc
  , globals = e.globals
  , elabFor = e.elabFor
  , lams = e.lams
  , self = Just k
  , insts = e.insts
  }

-- | the definition mentions itself as the global it will be; pattern
-- | unification knows it by its key
bodyEnv : G.Globals -> String -> String -> V.Ty -> ElabEnv
bodyEnv gSelf k name aval =
  withSelf
    (emptyElabEnvFor gSelf k)
    k
    (letAt
       (BDelayedBy 1)
       name
       (V.reflect (HGlobal k) (\u -> SpId) (\u -> aval) Nothing)
       aval
       (emptyElabEnvFor gSelf k).scope)

-- | the whole body phase: checked, settled, zonk-ready
bodyPhase : Pm.Span -> DeclJ -> G.Globals -> String -> V.Ty -> Elab M.El
bodyPhase dsp d gSelf k aval = do
  t <- R.runChk d.tm (bodyEnv gSelf k d.name aval) aval
  -- the implicit arguments: every one inferred, and substituted in
  stuck <- Mt.settle gSelf
  recoveredCheck
  poisonedLeft
  checkStuck gSelf dsp stuck
  unsolved <- Mt.unsolvedMetas
  checkUnsolved unsolved
  pure t

keyOf : (String -> String) -> DeclJ -> String
keyOf key d = if d.prim then d.name else key d.name

elabOut : (String -> String)
        -> G.Globals
        -> DeclJ
        -> Sx.Ty
        -> V.MetaCtx
        -> Either Diag M.El
        -> Elab Elaborated
elabOut key g d tyStx mc (Left failed) =
  pure
    (mkElaborated
       d.name
       (keyOf key d)
       d.prim
       (errEntry g (keyOf key d) tyStx)
       (Just failed))
elabOut key g d tyStx mc (Right t) =
  pure
    (mkElaborated
       d.name
       (keyOf key d)
       d.prim
       (entryFor
          g
          (keyOf key d)
          d.prim
          tyStx
          (selfAsLocal (keyOf key d) (U.zonkEl mc t.stx)))
       Nothing)

primNames : List String
primNames = map (\(p : Pair String Pi.PrimImpl) -> fst p) Pi.prims

-- | a primitive is one the runtime has
primKnown : Pm.Span -> DeclJ -> Elab Unit
primKnown sp d =
  if d.prim && not (elemBy strEq d.name primNames)
    then failWith
        (a := Unit)
        sp
        29
        ("there is no primitive called `"
         ++ d.name
         ++ "` (the runtime has: "
         ++ joinWith ", " primNames
         ++ ")")
  else pure MkUnit

elabBody : (String -> String)
         -> G.Globals
         -> Decl
         -> DeclJ
         -> M.Ty
         -> Elab Elaborated
elabBody key g n d a = do
  modify (withCore (setSelfKey (Just (keyOf key d))))
  body <-
    tryE
      (bodyPhase
         (Pm.spanOf n)
         d
         (G.addEntry
            (keyOf key d)
            { syntax = SOpaque
            , tySyntax = a.stx
            , value =
                V.reflect
                  (HGlobal (keyOf key d))
                  (\u -> SpId)
                  (\u -> M.tyN a)
                  Nothing
            , type_ = M.tyN a
            }
            g)
         (keyOf key d)
         (M.tyN a))
  modify (withCore (setSelfKey Nothing))
  primKnown (Pm.spanOf n) d
  mc <- gets (\st -> (core st).metas)
  elabOut key g d (U.zonkTy mc a.stx) mc body

-- | Elaborate one declaration.  A definition whose type elaborates and
-- | whose body does not is a definition still, `failed`: an error hole
-- | of its type.
elabDecl : (String -> String) -> G.Globals -> Decl -> Elab Elaborated
elabDecl key g n = do
  modify (withCore (setSelfKey Nothing))
  d <- declJ n
  a <- R.runTyp d.ty (emptyElabEnv g)
  -- (a type with an error hole is no type to give the definition)
  recoveredCheck
  elabBody key g n d a

watchSyn : Pm.Span -> Judgment -> Elab R.Syn
watchSyn sp (SynJ j) = pure j
watchSyn sp _ =
  failP sp 0 "a watch must say what type it has: write `-- >>> (e : T)`"

watchEntry : G.Globals -> V.MetaCtx -> M.El -> V.Ty -> G.Entry
watchEntry g mc t ty =
  entryFor
    g
    "> watch"
    False
    (U.zonkTy mc (Rb.readbTy 0 (V.forceTy mc ty)))
    (U.zonkEl mc t.stx)

watchPhase : G.Globals -> Pm.Span -> Pair M.El V.Ty -> Elab G.Entry
watchPhase g sp (MkPair t ty) = do
  stuck <- Mt.settle g
  -- (what settling met that was recovered from, too)
  recoveredCheck
  poisonedLeft
  checkStuck g sp stuck
  unsolved <- Mt.unsolvedMetas
  checkUnsolved unsolved
  mc <- gets (\st -> (core st).metas)
  pure (watchEntry g mc t ty)

-- | a watch `-- >>> e`: elaborated as an anonymous definition, its
-- | entry kept aside (never among the globals)
elabWatch : G.Globals -> Expr -> Elab G.Entry
elabWatch g n = do
  j <- tk.parseJ N n
  s <- watchSyn (Pm.spanOf n) j
  pr <- R.runSyn s (emptyElabEnv g)
  watchPhase g (Pm.spanOf n) pr

-- The module
--------------------------------------------------------------------------------

type Watch = { span : Pm.Span, entry : G.Entry }

mkWatch : Pm.Span -> G.Entry -> Watch
mkWatch span entry = { span = span, entry = entry }

type TestDecl = { name : String, span : Pm.Span }

-- | a module elaborated: its globals, what went wrong, what each
-- | definition is stored under and where it is; `broken`: the
-- | declarations that did not elaborate, not even their types (where
-- | each is); `infos` and `trace`: what elaboration found for the IDE,
-- | and its steps (for `heff explain`)
type TopResult =
  { globals : G.Globals
  , diags : List Diag
  , keys : List String
  , broken : List (Pair String Pm.Span)
  , watches : List Watch
  , tests : List TestDecl
  , spans : List (Pair String Pm.Span)
  , infos : List Info
  , trace : List TraceEvent
  }

mkTop : G.Globals
      -> List Diag
      -> List String
      -> List (Pair String Pm.Span)
      -> List Watch
      -> List TestDecl
      -> List (Pair String Pm.Span)
      -> List Info
      -> List TraceEvent
      -> TopResult
mkTop globals diags keys broken watches tests spans infos trace =
  { globals = globals
  , diags = diags
  , keys = keys
  , broken = broken
  , watches = watches
  , tests = tests
  , spans = spans
  , infos = infos
  , trace = trace
  }

appendT : {a : Type} -> List a -> List a -> List a
appendT Nil ys = ys
appendT (Cons x xs) ys = Cons x (appendT xs ys)

-- (a `failElsewhere` marker is reported where it comes from, not here)
reportedD : Diag -> List Diag
reportedD d = if reportedElsewhere d then Nil else Cons d Nil

concatMapT : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapT f Nil = Nil
concatMapT f (Cons x xs) = appendT (f x) (concatMapT f xs)

-- what a declaration's elaboration recovered from, kept: chronological
-- (the state holds them newest first)
recChron : ElabSt -> List Diag
recChron st = concatMapT reportedD (reverse (core st).recovered)

-- (the accumulator holds diagnostics newest first)
consAll : List Diag -> List Diag -> List Diag
consAll ds xs = foldl (\a x -> Cons x a) ds xs

failedList : Elaborated -> List Diag
failedList r = case r.failed of
  Just d -> reportedD d
  Nothing -> Nil

-- (not even its type: what uses it is not checked, and not refused)
topBroken : (String -> String) -> TopResult -> Decl -> List Diag -> TopResult
topBroken kf acc n diags = case declName n of
  Just x ->
    mkTop
      (G.addBroken
         (kf x)
         (if strEq (kf x) x then acc.globals
          else G.addAlias x (kf x) acc.globals))
      diags
      acc.keys
      (Cons (MkPair x (Pm.spanOf n)) acc.broken)
      acc.watches
      acc.tests
      acc.spans
      acc.infos
      acc.trace
  Nothing ->
    mkTop
      acc.globals
      diags
      acc.keys
      acc.broken
      acc.watches
      acc.tests
      acc.spans
      acc.infos
      acc.trace

-- (what a declaration's elaboration found for the IDE, and its steps,
-- kept: the state and the accumulator both hold them newest first)
keepSt : ElabSt -> TopResult -> TopResult
keepSt st acc =
  mkTop
    acc.globals
    acc.diags
    acc.keys
    acc.broken
    acc.watches
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

topTake : (String -> String)
        -> TopResult
        -> Decl
        -> Pair (Either Diag Elaborated) ElabSt
        -> TopResult
topTake kf acc n (MkPair (Left d) st) =
  topBroken
    kf
    (keepSt st acc)
    n
    (consAll acc.diags (appendT (recChron st) (reportedD d)))
topTake kf acc n (MkPair (Right r) st) =
  mkTop
    (G.addAlias r.name r.key (G.addEntry r.key r.entry acc.globals))
    (consAll acc.diags (appendT (recChron st) (failedList r)))
    (Cons r.key acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (Cons (MkPair r.name (Pm.spanOf n)) acc.spans)
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

watchTake : TopResult
          -> Pm.Span
          -> Pair (Either Diag G.Entry) ElabSt
          -> TopResult
watchTake acc sp (MkPair (Left d) st) =
  mkTop
    acc.globals
    (consAll acc.diags (appendT (recChron st) (reportedD d)))
    acc.keys
    acc.broken
    acc.watches
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)
watchTake acc sp (MkPair (Right entry) st) =
  mkTop
    acc.globals
    (consAll acc.diags (recChron st))
    acc.keys
    acc.broken
    (Cons (mkWatch sp entry) acc.watches)
    acc.tests
    acc.spans
    (appendT (core st).infos acc.infos)
    (appendT (core st).trace acc.trace)

topOne : (String -> String) -> TopResult -> Decl -> TopResult
topOne kf acc (At (DeclWatch e) sp) =
  watchTake acc sp (runE (elabWatch acc.globals e) emptySt)
-- extension: `test name`, the watches after it (with expectations) are
-- a test, named
topOne kf acc (At (DeclTest x _) sp) =
  mkTop
    acc.globals
    acc.diags
    acc.keys
    acc.broken
    acc.watches
    (Cons { name = x, span = sp } acc.tests)
    acc.spans
    acc.infos
    acc.trace
topOne kf acc n = topTake kf acc n (runE (elabDecl kf acc.globals n) emptySt)

topGo : (String -> String) -> TopResult -> List Decl -> TopResult
topGo kf acc Nil =
  mkTop
    acc.globals
    (reverse acc.diags)
    (reverse acc.keys)
    (reverse acc.broken)
    (reverse acc.watches)
    (reverse acc.tests)
    (reverse acc.spans)
    (reverse acc.infos)
    (reverse acc.trace)
topGo kf acc (Cons n rest) = topGo kf (topOne kf acc n) rest

emptyTop : G.Globals -> TopResult
emptyTop g0 = mkTop g0 Nil Nil Nil Nil Nil Nil Nil Nil

-- | every declaration of a module, each elaborated in a fresh state
topModule : String -> G.Globals -> List Decl -> TopResult
topModule modName g0 decls =
  topGo (\x -> modName ++ "." ++ x) (emptyTop g0) decls

-- | the same, on top of some existing globals, each definition under
-- | its own name (what an expectation is read with)
topWith : G.Globals -> List Decl -> TopResult
topWith g0 decls = topGo (\x -> x) (emptyTop g0) decls

-- | a definition as a cache keeps it: its key, where it is, and its
-- | core syntax (type and body)
type ThawedDef =
  { name : String, key : String, span : Pm.Span, ty : Sx.Ty, body : Sx.Tm }

mkThawedDef : String -> String -> Pm.Span -> Sx.Ty -> Sx.Tm -> ThawedDef
mkThawedDef name key span ty body =
  { name = name, key = key, span = span, ty = ty, body = body }

isForeignB : Sx.Tm -> Bool
isForeignB (SPrim _) = True
isForeignB (SIs e) = isForeignB e
isForeignB _ = False

knownEntry : G.Globals -> String -> Bool
knownEntry g k = case G.lookupEntry g k of
  Just _ -> True
  Nothing -> False

thawKeep : TopResult -> ThawedDef -> G.Globals -> TopResult
thawKeep acc d g =
  mkTop
    g
    acc.diags
    (Cons d.key acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (Cons (MkPair d.name d.span) acc.spans)
    acc.infos
    acc.trace

thawGlobals : TopResult -> ThawedDef -> G.Globals
thawGlobals acc d =
  if strEq d.key d.name
    then G.addEntry
        d.key
        (entryFor acc.globals d.key (isForeignB d.body) d.ty d.body)
        acc.globals
  else G.addAlias
      d.name
      d.key
      (G.addEntry
         d.key
         (entryFor acc.globals d.key (isForeignB d.body) d.ty d.body)
         acc.globals)

thawOne : TopResult -> ThawedDef -> TopResult
thawOne acc d =
  -- (a primitive declared again, by another module, is the same one)
  if isForeignB d.body && knownEntry acc.globals d.key
    then thawKeep acc d acc.globals
  else thawKeep acc d (thawGlobals acc d)

thawDone : TopResult -> TopResult
thawDone acc =
  mkTop
    acc.globals
    acc.diags
    (reverse acc.keys)
    acc.broken
    acc.watches
    acc.tests
    (reverse acc.spans)
    acc.infos
    acc.trace

-- | a module thawed from a cache: its definitions' syntax evaluated
-- | back into globals -- `topModule` with the elaboration already done
topThawed : G.Globals -> List ThawedDef -> TopResult
topThawed g0 defs =
  thawDone (foldl (\acc d -> thawOne acc d) (emptyTop g0) defs)

-- Checking source text, whole
--------------------------------------------------------------------------------

withParse : TopResult -> List Diag -> TopResult
withParse t ds =
  mkTop
    t.globals
    (appendT ds t.diags)
    t.keys
    t.broken
    t.watches
    t.tests
    t.spans
    t.infos
    t.trace

noImports : String -> Bool
noImports x = False

checkRead : String -> Su.Read -> TopResult
checkRead modName r =
  withParse (topModule modName G.emptyGlobals r.decls) r.diags

-- | a module's source, read and elaborated (no imports)
checkSource : String -> String -> TopResult
checkSource modName src = checkRead modName (Su.readProgram noImports src)

-- | a definition's stored core, printed
bodyDump : TopResult -> String -> String
bodyDump t k = case G.lookupEntry t.globals k of
  Just e -> Pr.showEl e.syntax
  Nothing -> "<no such definition>"

tyDump : TopResult -> String -> String
tyDump t k = case G.lookupEntry t.globals k of
  Just e -> Pr.showTy e.tySyntax
  Nothing -> "<no such definition>"

-- >>> length (topModule "m" G.emptyGlobals Nil).keys
-- 0

-- >>> (checkSource "m" "two : Int\ntwo = 2\n").keys
-- ["m.two"]

-- >>> tyDump (checkSource "m" "two : Int\ntwo = 2\n") "m.two"
-- "SPrimInt"

-- >>> bodyDump (checkSource "m" "two : Int\ntwo = 2\n") "m.two"
-- "(SIs (SLitInt 2))"

-- >>> bodyDump (checkSource "m" "idInt : Int -> Int\nidInt x = x\n") "m.idInt"
-- "(SLam (SFunction Small SPrimInt (AbsConst SPrimInt) Expl) (MkAbs \"x\" (SIs (SLocal 0))))"

-- >>> length (checkSource "m" "bad : Int\nbad = \"no\"\n").diags
-- 1
