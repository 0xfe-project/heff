-- Runes, as the compiler has them: a rune is a code point of Unicode,
-- a 32-bit value, as Go's `rune` is (lib/rune.hf has its operations);
-- here an `Int`.  One that is no Unicode scalar value -- a surrogate,
-- U+D800 to U+DFFF, one beyond U+10FFFF, or one below 0 -- no literal
-- is, and a string has U+FFFD for it, as Go's does.  What a string's
-- units are -- UTF-16 code units on every backend now (lib/c/runtime.c),
-- UTF-8 bytes to be -- nothing here says: a rune is read and written
-- only by the prelude's `runes` and `ofRunes`, which read ill-formed
-- units (a surrogate not in a pair, a byte of no rune) as U+FFFD.  An
-- ASCII character is one unit, of its code, in either.

import rune as Ru

-- | whether it is a Unicode scalar value: what a literal may be, and what
-- | a string holds of it
isScalar : Int -> Bool
isScalar c = 0 <= c && c <= 1114111 && not (55296 <= c && c <= 57343)

-- | U+FFFD: a string's rune where it is given one that is no scalar
-- | value, and where it has a surrogate not in a pair
replacement : Int
replacement = 65533

hexWith : String -> Int -> String
hexWith digits n =
  if n < 16 then strSlice digits n (n + 1)
  else hexWith digits (n / 16) ^ strSlice digits (n % 16) (n % 16 + 1)

-- | in hexadecimal, lower case: as an escape writes it, `\u{1f600}`
hex : Int -> String
hex n = hexWith "0123456789abcdef" n

padTo4 : String -> String
padTo4 s = if strLength s >= 4 then s else padTo4 ("0" ^ s)

-- | as Unicode names a code point: `U+00E9`
-- | >>> List.map codeName [233, 128512]
-- | Cons "U+00E9" (Cons "U+1F600" Nil)
codeName : Int -> String
codeName c = "U+" ^ padTo4 (hexWith "0123456789ABCDEF" c)

-- | the string of one rune (of one that is no scalar value, U+FFFD)
encode : Int -> String
encode c = ofRunes [Ru.fromInt (if isScalar c then c else replacement)]

-- | a string's runes
-- | >>> decode (ofRunes (List.map Ru.fromInt [97, 233, 128512, 55296, 1114112]))
-- | Cons 97 (Cons 233 (Cons 128512 (Cons 65533 (Cons 65533 Nil))))
decode : String -> List Int
decode s = List.map Ru.toInt (runes s)

-- | a rune, and how many units of a string it takes
type RuneAt = { code : Int, width : Int }

-- (the rune the units from `i` start with: `r`, where they are `e`, its
-- units, else U+FFFD, of one)
wholeAt : String -> Int -> Int -> String -> RuneAt
wholeAt s i r e =
  if strEq e (strSlice s i (i + strLength e))
    then { code = r, width = strLength e }
  else { code = replacement, width = 1 }

-- (the first of runes; of none, U+FFFD)
firstCode : List Int -> Int
firstCode Nil = replacement
firstCode (Cons c _) = c

-- (the rune `r`, at `i`, if the units there are its)
codeOf : String -> Int -> Int -> RuneAt
codeOf s i r = wholeAt s i r (encode r)

-- | the rune at `i`, and how many units it takes: an ASCII character's
-- | unit is its code, and of another the first rune of the four units
-- | from `i` -- as many as a rune takes, at most -- is the one there,
-- | where they start with its units; of ill-formed ones, U+FFFD of one;
-- | out of the string, `-1` of one
-- | >>> List.map (\i -> (runeAt "a😀b" i).code) [0, 1, strLength "a😀", strLength "a😀b"]
-- | [97, 128512, 98, -1]
-- | >>> List.map (\i -> (runeAt "a😀b" i).width) [0, 1, 2, strLength "a😀"]
-- | Cons 1 (Cons (strLength "😀") (Cons 1 (Cons 1 Nil)))
runeAt : String -> Int -> RuneAt
runeAt s i =
  if charCode s i < 128 then { code = charCode s i, width = 1 }
  else codeOf s i (firstCode (decode (strSlice s i (i + 4))))

-- | the rune at `i`
codeAt : String -> Int -> Int
codeAt s i = (runeAt s i).code

-- | how many units it takes
widthAt : String -> Int -> Int
widthAt s i = (runeAt s i).width

-- (how many runes start from `i` and end by `j`, those from `i` on)
runesGo : String -> Int -> Int -> Int -> Int
runesGo s i j n =
  if i >= j || i >= strLength s then n
  else if charCode s i < 128 then runesGo s (i + 1) j (n + 1)
  else (let w = widthAt s i
        in if i + w > j then n else runesGo s (i + w) j (n + 1))

-- | how many runes are between `i` and `j`, those that end by `j` (one
-- | that `j` cuts is not): a column, `i` where its line starts
-- | >>> List.map (runesBetween "a😀b" 0) [0, 1, 2, strLength "a😀", strLength "a😀b"]
-- | Cons 0 (Cons 1 (Cons 1 (Cons 2 (Cons 3 Nil))))
runesBetween : String -> Int -> Int -> Int
runesBetween s i j = runesGo s i j 0

-- (the start of the rune `k` is in, from `i`, a rune's start, on)
runeStartGo : String -> Int -> Int -> Int
runeStartGo s i k =
  if i >= strLength s then i
  else (let w = widthAt s i in if i + w > k then i else runeStartGo s (i + w) k)

-- | where the rune `k` is in starts: `k`, where one starts there
-- | >>> List.map (runeStart "a😀b") [0, 1, 2, strLength "a😀"]
-- | Cons 0 (Cons 1 (Cons 1 (Cons (strLength "a😀") Nil)))
runeStart : String -> Int -> Int
runeStart s k = runeStartGo s 0 k

-- (a control character: C0's, DEL and C1's, written as an escape)
isControl : Int -> Bool
isControl c = c < 32 || 127 <= c && c < 160

-- (between the quotes)
quoted : Int -> String
quoted 39 = "\\'"
quoted 92 = "\\\\"
quoted 10 = "\\n"
quoted 9 = "\\t"
quoted 13 = "\\r"
quoted c =
  if not (isScalar c) then encode replacement
  else if isControl c then "\\u{" ^ hex c ^ "}"
  else encode c

-- | as a literal writes it: `'a'`, `'\n'`, `'\u{1b}'`; one that is no
-- | scalar value as U+FFFD, as Go's `%q` shows it
-- | >>> List.map quote [97, 39, 92, 10, 27, 233, 128512, 55296, 0 - 1]
-- | Cons "'a'" (Cons "'\\''" (Cons "'\\\\'" (Cons "'\\n'" (Cons "'\\u{1b}'" (Cons "'é'" (Cons "'😀'" (Cons "'�'" (Cons "'�'" Nil))))))))
quote : Int -> String
quote c = "'" ^ quoted c ^ "'"
