-- The compiler's paths: strings in the style of the platform heff runs
-- on, as it is given them (its arguments, the working directory) and
-- says them (in its diagnostics, its cache's keys).  Each operation
-- reads them as std.path's paths, in the style, and writes the answer
-- back in it.

module heff.util.hostpath

import std.path as Path

-- | `b` from `a`, as std.path's `join`.
-- | >>> join Posix "src" "heff/load.hf"
-- | "src/heff/load.hf"
-- | >>> join Windows "C:\\a" "b/c.hf"
-- | "C:\\a\\b\\c.hf"
join : Path.Style -> String -> String -> String
join st a b =
  Path.render
    (os := st)
    (Path.join (Path.parse (os := st) a) (Path.parse (os := st) b))

-- | The directory `s` is in.
-- | >>> dirname Posix "/a/b/c.hf"
-- | "/a/b"
dirname : Path.Style -> String -> String
dirname st s = Path.render (os := st) (Path.dirname (Path.parse (os := st) s))

-- | The last segment of `s`.
-- | >>> basename Windows "C:\\a\\b.hf"
-- | "b.hf"
basename : Path.Style -> String -> String
basename st s = Path.basename (Path.parse (os := st) s)

-- | The segments of `s`, without the `..`s that can go.
-- | >>> components Posix "a/./b/../c"
-- | ["a", "c"]
components : Path.Style -> String -> List String
components st s = Path.components (Path.parse (os := st) s)

-- | `s` without `.`, doubled separators or the `..`s that can go.
-- | >>> normalize Posix "/a/./b/../c/"
-- | "/a/c"
normalize : Path.Style -> String -> String
normalize st s = Path.render (os := st) (Path.normal (Path.parse (os := st) s))

-- | How to get to `to` from `from`, if there is a way.
-- | >>> relative Posix "/a/b/c" "/a/d"
-- | Just ("../../d")
relative : Path.Style -> String -> String -> Maybe String
relative st from to =
  maybe
    Nothing
    (\p -> Just (Path.render (os := st) p))
    (Path.relative
       (os := st)
       (Path.parse (os := st) from)
       (Path.parse (os := st) to))

-- | `s` is `dir` or under it.
-- | >>> isUnder Posix "/a/b" "/a/b/c"
-- | True
isUnder : Path.Style -> String -> String -> Bool
isUnder st dir s =
  Path.isUnder (os := st) (Path.parse (os := st) dir) (Path.parse (os := st) s)

-- | A `/`-path (as `package.hf` writes them) in the style.
-- | >>> fromSlashes Windows "src/heff"
-- | "src\\heff"
-- | >>> Path.render (os := Windows) (Path.parse (os := Windows) "C:/a")
-- | "C:\\a"
fromSlashes : Path.Style -> String -> String
fromSlashes st s = joinWith (Path.sep st) (split "/" s)
