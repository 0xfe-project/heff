-- An ordered dictionary: the order is the order of declaration, which for
-- a record type is the order of its telescope.

import array as A
import map as M

type Dict a =
  { keys : Array String, byName : M.Map String Int, values : Array a }

empty : {a : Type} -> Dict a
empty = { keys = A.empty, byName = M.empty, values = A.empty }

indexed : {a : Type} -> Int -> List (Pair String a) -> M.Map String Int
indexed i Nil = M.empty
indexed i (Cons (MkPair x _) rest) =
  M.insert compareString x i (indexed (i + 1) rest)

fromList : {a : Type} -> List (Pair String a) -> Dict a
fromList pairs =
  { keys = A.fromList (List.map fst pairs)
  , byName = indexed 0 pairs
  , values = A.fromList (List.map snd pairs)
  }

zipKV : {a : Type} -> List String -> List a -> List (Pair String a)
zipKV (Cons k ks) (Cons v vs) = Cons (MkPair k v) (zipKV ks vs)
zipKV _ _ = Nil

toList : {a : Type} -> Dict a -> List (Pair String a)
toList d = zipKV (A.toList d.keys) (A.toList d.values)

-- | >>> lookup (fromList [MkPair "a" 1, MkPair "b" 2]) "c"
-- | Nothing
lookup : {a : Type} -> Dict a -> String -> Maybe a
lookup d x = case M.lookup compareString x d.byName of
  Nothing -> Nothing
  Just i -> A.at d.values i

-- (the callers only ask for fields that are there)
-- | >>> elemAt (fromList [MkPair "a" 1, MkPair "b" 2]) "b"
-- | 2
elemAt : {a : Type} -> Dict a -> String -> a
elemAt d x = case lookup d x of
  Just v -> v
  Nothing -> abandon

-- (the callers only ask for indices that are there)
at : {a : Type} -> Dict a -> Int -> a
at d i = case A.index d.values i of
  Just v -> v
  Nothing -> abandon

contains : {a : Type} -> Dict a -> String -> Bool
contains d x = M.member compareString x d.byName

-- | >>> keyIndex (fromList [MkPair "a" 1, MkPair "b" 2]) "b"
-- | 1
keyIndex : {a : Type} -> Dict a -> String -> Int
keyIndex d x = case M.lookup compareString x d.byName of
  Just i -> i
  Nothing -> abandon

update : {a : Type} -> Dict a -> String -> (a -> a) -> Dict a
update d x f = case M.lookup compareString x d.byName of
  Nothing -> d
  Just i -> case A.index d.values i of
    Nothing -> d
    Just v ->
      { keys = d.keys, byName = d.byName, values = A.set d.values i (f v) }

-- | >>> size (fromList [MkPair "a" 1, MkPair "b" 2])
-- | 2
size : {a : Type} -> Dict a -> Int
size d = A.length d.values

mapD : {a b : Type} -> (a -> b) -> Dict a -> Dict b
mapD f d = { keys = d.keys, byName = d.byName, values = A.map f d.values }
