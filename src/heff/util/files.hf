-- The compiler's files, where it may find none: std.filesystem's
-- operations, what they throw heard where they are done -- a file's text
-- or `Nothing`, an operation done or `False`, a status or why there is
-- none -- as the compiler asks of a cache, a project's files and what it
-- builds, in any world the files are in.

module heff.util.files

import co
import exception
import std.filesystem as Filesystem
import std.path as Path

-- (an operation of the files in a world with their throws, its throw
-- heard: what it came to, or what was thrown)
tried : {e : HFunctor}
      -> {a : Type}
      -> {{disk : Filesystem.filesystem <: e}}
      -> ({{fs :
            Filesystem.filesystem <: plus (exception Filesystem.FileError) e}}
          -> {{ex :
            exception Filesystem.FileError
            <: plus (exception Filesystem.FileError) e}}
          -> Co (plus (exception Filesystem.FileError) e) a)
      -> Co e (Either Filesystem.FileError a)
tried c =
  attempt
    Filesystem.FileError
    e
    (c (fs := \p -> InR (disk p)) (ex := \p -> InL p))

-- (... `Just` what it came to, or `Nothing`)
maybeOf : {e : HFunctor}
        -> {a : Type}
        -> Co e (Either Filesystem.FileError a)
        -> Co e (Maybe a)
maybeOf c = bind c (\r -> pure (either (\_ -> Nothing) Just r))

-- (... whether it was done)
doneOf : {e : HFunctor}
       -> Co e (Either Filesystem.FileError Unit)
       -> Co e Bool
doneOf c = bind c (\r -> pure (either (\_ -> False) (\_ -> True) r))

-- | A file's text, if it could be read.
readFile : {e : HFunctor}
         -> {{disk : Filesystem.filesystem <: e}}
         -> Path.Path
         -> Co e (Maybe String)
readFile path = maybeOf (tried (Filesystem.readFile path))

-- | Write a file: whether it was written.
writeFile : {e : HFunctor}
          -> {{disk : Filesystem.filesystem <: e}}
          -> Path.Path
          -> String
          -> Co e Bool
writeFile path text = doneOf (tried (Filesystem.writeFile path text))

-- | Make a directory and the ones above it: whether a directory is there.
makeDirectory : {e : HFunctor}
              -> {{disk : Filesystem.filesystem <: e}}
              -> Path.Path
              -> Co e Bool
makeDirectory path = doneOf (tried (Filesystem.makeDirectory path))

-- | The names in a directory, sorted, if it could be read.
readDirectory : {e : HFunctor}
              -> {{disk : Filesystem.filesystem <: e}}
              -> Path.Path
              -> Co e (Maybe (List String))
readDirectory path =
  maybeOf
    (tried
       (bind
          (Filesystem.readDirectory path)
          (\ps -> pure (List.map Path.basename ps))))

-- | Remove a file, or a directory and all it holds: whether it is gone.
remove : {e : HFunctor}
       -> {{disk : Filesystem.filesystem <: e}}
       -> Path.Path
       -> Co e Bool
remove path = doneOf (tried (Filesystem.remove path))

-- | Make a file, or a directory and all it holds, read-only: whether it
-- | was made so.
readOnly : {e : HFunctor}
         -> {{disk : Filesystem.filesystem <: e}}
         -> Path.Path
         -> Co e Bool
readOnly path = doneOf (tried (Filesystem.readOnly path))

-- | ... writable again: whether it was made so.
writable : {e : HFunctor}
         -> {{disk : Filesystem.filesystem <: e}}
         -> Path.Path
         -> Co e Bool
writable path = doneOf (tried (Filesystem.writable path))

-- | Copy a file, or a directory and all it holds, where nothing is:
-- | whether it was copied.
copy : {e : HFunctor}
     -> {{disk : Filesystem.filesystem <: e}}
     -> Path.Path
     -> Path.Path
     -> Co e Bool
copy path to = doneOf (tried (Filesystem.copy path to))

-- | Move a file, or a directory, where nothing is: whether it was moved.
move : {e : HFunctor}
     -> {{disk : Filesystem.filesystem <: e}}
     -> Path.Path
     -> Path.Path
     -> Co e Bool
move path to = doneOf (tried (Filesystem.move path to))

-- | Move a file in place of the one at `to`, at once: whether it was
-- | moved.
replace : {e : HFunctor}
        -> {{disk : Filesystem.filesystem <: e}}
        -> Path.Path
        -> Path.Path
        -> Co e Bool
replace path to = doneOf (tried (Filesystem.replace path to))

-- | What the system says of the file at a path, links followed, or why
-- | it says nothing.
pathStatus : {e : HFunctor}
           -> {{disk : Filesystem.filesystem <: e}}
           -> Path.Path
           -> Co e (Either Filesystem.FileError Filesystem.Status)
pathStatus path = tried (Filesystem.pathStatus path)

-- | A path with its links resolved, or why it has none.
realPath : {e : HFunctor}
         -> {{disk : Filesystem.filesystem <: e}}
         -> Path.Path
         -> Co e (Either Filesystem.FileError Path.Path)
realPath path = tried (Filesystem.realPath path)

-- | A directory of its own where the system keeps temporary ones, or why
-- | there is none.
temporaryDirectory : {e : HFunctor}
                   -> {{disk : Filesystem.filesystem <: e}}
                   -> String
                   -> Co e (Either Filesystem.FileError Path.Path)
temporaryDirectory prefix = tried (Filesystem.temporaryDirectory prefix)
