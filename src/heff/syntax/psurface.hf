-- Core syntax printed in the surface syntax (`heff.syntax.surface` reads
-- it back).  Blocks (`case`) are laid out: their alternatives go
-- on lines of their own, indented past the line they start on; a
-- stored definition with the shape of equations is printed back as
-- them.

import array as A
import heff.util.dict as D
import heff.elab.fixed
import heff.elab.params as Pm
import heff.util.rune as Rn
import heff.elab.syntax as Sx

-- | which arguments of an application are implicit (by the name of
-- | their binder), from its head; and whether to leave them out or
-- | write them as `(x := a)`
type Implicits =
  { names : List String -> Sx.Tm -> Array (Maybe String), hide : Bool }

-- | nothing is implicit, and what is marked so is hidden: the tools'
-- | default
arrayNone : Array (Maybe String)
arrayNone = A.fromList Nil

plainImplicits : Implicits
plainImplicits = { names = \xs e -> arrayNone, hide = True }

type Ctx = { im : Implicits, indent : Int }

deepen : Ctx -> Ctx
deepen c = { im = c.im, indent = c.indent + 2 }

-- | precedences: 0 anything, 1 an operand of `->`, `~` or an operator,
-- | 2 an argument
paren : Bool -> String -> String
paren b s = if b then "(" ^ s ^ ")" else s

spaces : Int -> String
spaces n = joinWith "" (List.replicate n " ")

wordOf : Int -> Maybe String
wordOf c =
  if c == 43 then Just "plus"
  else if c == 45 then Just "minus"
  else if c == 42 then Just "times"
  else if c == 47 then Just "slash"
  else if c == 37 then Just "percent"
  else if c == 61 then Just "eq"
  else if c == 60 then Just "lt"
  else if c == 62 then Just "gt"
  else if c == 38 then Just "amp"
  else if c == 124 then Just "bar"
  else if c == 33 then Just "bang"
  else if c == 94 then Just "caret"
  else if c == 63 then Just "q"
  else if c == 64 then Just "at"
  else if c == 35 then Just "hash"
  else if c == 36 then Just "dollar"
  else if c == 126 then Just "tilde"
  else if c == 58 then Just "colon"
  else if c == 46 then Just "dot"
  else if c == 92 then Just "backslash"
  else Nothing

operatorGo : String -> Int -> List String -> Maybe (List String)
operatorGo x i acc =
  if i >= strLength x then Just (List.reverse acc)
  else case wordOf (byteAt x i) of
    Just w -> operatorGo x (i + 1) (Cons w acc)
    Nothing -> Nothing

operatorDone : Maybe (List String) -> Maybe String
operatorDone (Just ws) = Just ("op_" ^ joinWith "_" ws)
operatorDone Nothing = Nothing

operatorName : String -> Maybe String
operatorName x =
  if strEq x "" then Nothing else operatorDone (operatorGo x 0 Nil)

isOperator : String -> Bool
isOperator x = maybe False (\w -> True) (operatorName x)

-- | a name as written alone: an operator in parentheses, `(+)`
named : String -> String
named x = if isOperator x then "(" ^ x ^ ")" else x

upper : String -> Bool
upper x = 65 <= byteAt x 0 && byteAt x 0 <= 90

nth : {a : Type} -> List a -> Int -> Maybe a
nth Nil i = Nothing
nth (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nth xs (i - 1)

-- | a local by its index; one shadowed by an inner one of the same name
-- | is primed
localName : List String -> Int -> String
localName xs i = case nth xs i of
  Just x ->
    x
    ^ joinWith
      ""
      (List.replicate
         (List.length (List.filter (\y -> strEq y x) (List.take i xs)))
         "'")
  Nothing -> "?" ^ showInt i

-- | the printers, knotted
type PK =
  { el : Ctx -> Int -> List String -> Sx.Tm -> String
  , ty : Ctx -> Int -> List String -> Sx.Ty -> String
  }

type Spine = { head : Sx.Tm, args : List Sx.Tm }

spineGo : Sx.Tm -> List Sx.Tm -> Spine
spineGo (SApp f a) acc = spineGo f (Cons a acc)
spineGo h acc = { head = h, args = acc }

spineOf : Sx.Tm -> Spine
spineOf t = spineGo t Nil

isImplicitArg : Sx.Tm -> Bool
isImplicitArg (SImplicit _ _) = True
isImplicitArg _ = False

joinM : {a : Type} -> Maybe (Maybe a) -> Maybe a
joinM (Just m) = m
joinM Nothing = Nothing

type Imp = { n : String, inner : Sx.Tm }

-- (an implicit argument: marked so by the elaborator, or (in what was
-- stored before it did) known from the head's type)
implicitName : Array (Maybe String) -> Int -> Sx.Tm -> Maybe Imp
implicitName names i (SImplicit n inner) = Just { n = n, inner = inner }
implicitName names i a = case joinM (nth (A.toList names) i) of
  Just n -> Just { n = n, inner = a }
  Nothing -> Nothing

type Lams = { names : List String, binders : List String, body : Sx.Tm }

lambdas : List String -> List String -> Sx.Tm -> Lams
lambdas ys bs (SLam (SFunction _ _ _ Impl _) (MkAbs x b)) =
  lambdas (Cons x ys) (Cons ("{" ^ x ^ "}") bs) b
lambdas ys bs (SLam (SFunction _ _ _ Inst _) (MkAbs x b)) =
  lambdas (Cons x ys) (Cons ("{" ^ x ^ "}") bs) b
lambdas ys bs (SLam _ (MkAbs x b)) = lambdas (Cons x ys) (Cons x bs) b
lambdas ys bs (SLam _ (AbsConst b)) = lambdas ys (Cons "_" bs) b
lambdas ys bs e = { names = ys, binders = List.reverse bs, body = e }

argStrs : PK
        -> Ctx
        -> List String
        -> Array (Maybe String)
        -> Int
        -> List Sx.Tm
        -> List String
argStrs k c xs names i Nil = Nil
argStrs k c xs names i (Cons a rest) = case implicitName names i a of
  Just imp ->
    if c.im.hide then argStrs k c xs names (i + 1) rest
    else Cons
        ("(" ^ imp.n ^ " := " ^ k.el c 0 xs imp.inner ^ ")")
        (argStrs k c xs names (i + 1) rest)
  Nothing -> Cons (k.el c 2 xs a) (argStrs k c xs names (i + 1) rest)

altLine : PK
        -> Ctx
        -> List String
        -> Pair String (Pair (Array String) Sx.Tm)
        -> String
altLine k inner xs (MkPair t (MkPair ys body)) =
  "\n"
  ^ spaces inner.indent
  ^ joinWith " " (Cons t (A.toList ys))
  ^ " -> "
  ^ k.el inner 0 (List.foldl (\acc y -> Cons y acc) xs (A.toList ys)) body

opHead : Sx.Tm -> String
opHead (SGlobal x) = x
opHead _ = ""

opApp : Ctx -> List String -> Spine -> Maybe (Pair Sx.Tm Sx.Tm)
opApp c xs sp@{ head = SGlobal x } = case sp.args of
  Cons l (Cons r2 Nil) ->
    if isOperator x && not (isImplicitArg l || isImplicitArg r2)
      then Just (MkPair l r2)
    else Nothing
  _ -> Nothing
opApp c xs sp = Nothing

appDone : Int -> String -> List String -> String -> String
appDone p headArg args headAlone =
  if List.null args then headAlone
  else paren (p >= 2) (joinWith " " (Cons headArg args))

appPlain : PK -> Ctx -> Int -> List String -> Spine -> String
appPlain k c p xs sp =
  appDone
    p
    (k.el c 2 xs sp.head)
    (argStrs k c xs (c.im.names xs sp.head) 0 sp.args)
    (k.el c p xs sp.head)

appStr : PK -> Ctx -> Int -> List String -> Sx.Tm -> String
appStr k c p xs t = case opApp c xs (spineOf t) of
  -- `a + b`: an operator applied to two (its fixity unknown here, an
  -- operand that is an operator's is parenthesised)
  Just (MkPair l r2) ->
    paren
      (p >= 1)
      (k.el c 1 xs l ^ " " ^ opHead (spineOf t).head ^ " " ^ k.el c 1 xs r2)
  Nothing -> appPlain k c p xs (spineOf t)

lamStr : PK -> Ctx -> Int -> List String -> Lams -> String
lamStr k c p xs l =
  paren
    (p >= 1)
    ("\\" ^ joinWith " " l.binders ^ " -> " ^ k.el c 0 l.names l.body)

consField : PK -> Ctx -> List String -> Pair String Sx.Tm -> String
consField k c xs (MkPair l e) = l ^ " = " ^ k.el c 0 xs e

consItem : Sx.Tm -> Maybe (List Sx.Tm) -> Maybe (List Sx.Tm)
consItem t (Just ts) = Just (Cons t ts)
consItem t Nothing = Nothing

-- | a list, `Cons a (Cons b Nil)`: its items, as `[a, b]` writes them
-- | (`[]`, `Nil`); not one, a chain that does not end in `Nil`
listItems : Sx.Tm -> Maybe (List Sx.Tm)
listItems (STag "Nil" ts) = if A.length ts == 0 then Just Nil else Nothing
listItems (STag "Cons" ts) =
  if A.length ts == 2 then consItem (A.index ts 0) (listItems (A.index ts 1))
  else Nothing
listItems _ = Nothing

elF : PK -> Ctx -> Int -> List String -> Sx.Tm -> String
elF k c p xs (SLocal i) = localName xs i
-- (an operator, alone: `(+)`)
elF k c p xs (SGlobal x) = if isOperator x then "(" ^ x ^ ")" else x
elF k c p xs (SCode t) = k.ty c p xs t
elF k c p xs (SApp f a) = appStr k c p xs (SApp f a)
elF k c p xs (SLam t b) = lamStr k c p xs (lambdas xs Nil (SLam t b))
elF k c p xs (SCons d) =
  "{ " ^ joinWith ", " (List.map (\f -> consField k c xs f) (D.toList d)) ^ " }"
elF k c p xs (SProj e2 l) = k.el c 2 xs e2 ^ "." ^ l
-- (a list as `[a, b]` writes it)
elF k c p xs e@(STag x ts) = case listItems e of
  Just items -> "[" ^ joinWith ", " (List.map (\a -> k.el c 0 xs a) items) ^ "]"
  Nothing ->
    if List.length (A.toList ts) == 0 then x
    else paren
        (p >= 2)
        (joinWith " " (Cons x (List.map (\a -> k.el c 2 xs a) (A.toList ts))))
elF k c p xs (SMatch s cases) =
  paren
    (p >= 1)
    ("case "
     ^ k.el c 0 xs s
     ^ " of"
     ^ joinWith
       ""
       (List.map (\alt -> altLine k (deepen c) xs alt) (D.toList cases)))
elF k c p xs (SSpecialize e2 x v) =
  paren (p >= 1) (k.el c 2 xs e2 ^ " ~ { " ^ x ^ " = " ^ k.el c 0 xs v ^ " }")
elF k c p xs (SIs e2) = k.el c p xs e2
elF k c p xs (SRec e2) = k.el c p xs e2
-- (a local definition, by its name)
elF k c p xs (SFix _ (MkAbs x _)) = x
elF k c p xs (SFix _ (AbsConst _)) = "<local>"
elF k c p xs SOpaque = "<opaque>"
elF k c p xs SAbandon = "abandon"
elF k c p xs (SMetaApp m _ _) = "?" ^ showInt m
elF k c p xs (SLitInt i) = showInt i
elF k c p xs (SLitFloat x) = showFloat x
elF k c p xs (SLitString s) = Rn.quoteString s
elF k c p xs (SLitRune ch) = Rn.quote ch
elF k c p xs (SLitFixed _ n) = showInt n
elF k c p xs (SLitFloat32 x) = showFloat x
elF k c p xs (SImplicit _ e2) = k.el c p xs e2
elF k c p xs (SPrim x) = "<primitive " ^ x ^ ">"

type FieldsAcc = { names : List String, out : List String }

-- (` = d`, a field's default, if it has one)
defaultStr : PK -> Ctx -> List String -> Maybe Sx.Tm -> String
defaultStr k c xs (Just d) = " = " ^ k.el c 0 xs d
defaultStr k c xs Nothing = ""

recordField : PK
            -> Ctx
            -> D.Dict Sx.Tm
            -> FieldsAcc
            -> Pair String Sx.Ty
            -> FieldsAcc
recordField k c ds acc (MkPair l t) =
  { names = Cons l acc.names
  , out =
      List.append
        acc.out
        (Cons
           (l
            ^ " : "
            ^ k.ty c 0 acc.names t
            ^ defaultStr k c acc.names (D.lookup ds l))
           Nil)
  }

recordDone : FieldsAcc -> List String
recordDone acc = acc.out

-- | a record type's fields, `x : A`, and `x : A = d` where `x` has a
-- | default
recordFields : PK
             -> Ctx
             -> List String
             -> List (Pair String Sx.Ty)
             -> D.Dict Sx.Tm
             -> List String
recordFields k c xs fs ds =
  recordDone
    (List.foldl
       (\acc (f : Pair String Sx.Ty) -> recordField k c ds acc f)
       { names = xs, out = Nil }
       fs)

variantStr : PK -> Ctx -> List String -> Pair String (Array Sx.Ty) -> String
variantStr k c xs (MkPair t ts) =
  joinWith " " (Cons t (List.map (\t2 -> k.ty c 2 xs t2) (A.toList ts)))

type Grouped = { names : List String, rest : Sx.Ty, ctx : List String }

-- (only binders of a universe: their types cannot mention one another;
-- not one with a default)
implicitGroup : List String -> Pm.Universe -> Sx.Ty -> List String -> Grouped
implicitGroup names u rest@(SFunction _ (SU u') (MkAbs y b) Impl Nothing) ctx =
  if Pm.eqUniverse u u'
    then implicitGroup (List.append names (Cons y Nil)) u b (Cons y ctx)
  else { names = names, rest = rest, ctx = ctx }
implicitGroup names u rest ctx = { names = names, rest = rest, ctx = ctx }

arrowGrouped : PK -> Ctx -> List String -> Sx.Ty -> Grouped -> String
arrowGrouped k c xs dom r =
  "{"
  ^ joinWith " " r.names
  ^ " : "
  ^ k.ty c 0 xs dom
  ^ "} -> "
  ^ k.ty c 0 r.ctx r.rest

arrowStr : PK
         -> Ctx
         -> List String
         -> Pm.Level
         -> Sx.Ty
         -> Sx.Abs Sx.Ty
         -> Pm.Plicity
         -> String
arrowStr k c xs level dom (MkAbs x b) implicit = case implicit of
  Impl ->
    -- `{a b : T}`: implicit binders of the same type, together
    arrowGrouped
      k
      c
      xs
      dom (case dom of
    SU u -> implicitGroup (Cons x Nil) u b (Cons x xs)
    _ -> { names = Cons x Nil, rest = b, ctx = Cons x xs })
  -- `{{x : T}} ->`, an instance binder
  Inst -> "{{" ^ x ^ " : " ^ k.ty c 0 xs dom ^ "}} -> " ^ k.ty c 0 (Cons x xs) b
  Expl -> "(" ^ x ^ " : " ^ k.ty c 0 xs dom ^ ") -> " ^ k.ty c 0 (Cons x xs) b
arrowStr k c xs level dom (AbsConst b) implicit = case implicit of
  Inst -> "{{_ : " ^ k.ty c 0 xs dom ^ "}} -> " ^ k.ty c 0 xs b
  _ -> k.ty c 1 xs dom ^ " -> " ^ k.ty c 0 xs b

-- | `{x : T := d} -> b`, an implicit binder with its default
arrowDefault : PK
             -> Ctx
             -> List String
             -> Sx.Ty
             -> Sx.Abs Sx.Ty
             -> Sx.Tm
             -> String
arrowDefault k c xs dom (MkAbs x b) d =
  "{"
  ^ x
  ^ " : "
  ^ k.ty c 0 xs dom
  ^ " := "
  ^ k.el c 0 xs d
  ^ "} -> "
  ^ k.ty c 0 (Cons x xs) b
arrowDefault k c xs dom (AbsConst b) d =
  "{_ : " ^ k.ty c 0 xs dom ^ " := " ^ k.el c 0 xs d ^ "} -> " ^ k.ty c 0 xs b

-- | a function type: an implicit binder with a default, or another
arrowOf : PK
        -> Ctx
        -> List String
        -> Pm.Level
        -> Sx.Ty
        -> Sx.Abs Sx.Ty
        -> Pm.Plicity
        -> Maybe Sx.Tm
        -> String
arrowOf k c xs level dom cod implicit (Just d) = arrowDefault k c xs dom cod d
arrowOf k c xs level dom cod implicit Nothing =
  arrowStr k c xs level dom cod implicit

tyF : PK -> Ctx -> Int -> List String -> Sx.Ty -> String
tyF k c p xs (SU SmallU) = "Type"
tyF k c p xs (SU LargeU) = "Theory"
tyF k c p xs (SDecode e) = k.el c p xs e
tyF k c p xs (SFunction level dom cod implicit dflt) =
  paren (p >= 1) (arrowOf k c xs level dom cod implicit dflt)
tyF k c p xs (SRecord _ fs ds) =
  "{ " ^ joinWith ", " (recordFields k c xs (D.toList fs) ds) ^ " }"
tyF k c p xs (SSum vs) =
  "data { "
  ^ joinWith " | " (List.map (\v -> variantStr k c xs v) (D.toList vs))
  ^ " }"
tyF k c p xs (SIsTy t2) = k.ty c p xs t2
tyF k c p xs SPrimInt = "Int"
tyF k c p xs SPrimFloat = "Float"
tyF k c p xs SPrimString = "String"
tyF k c p xs SPrimRune = "Rune"
tyF k c p xs (SPrimArray a) = paren (p >= 2) ("Array " ^ k.ty c 2 xs a)
tyF k c p xs (SFixed w) = fixedName w

pk : PK
pk = { el = \c p xs e -> elF pk c p xs e, ty = \c p xs t -> tyF pk c p xs t }

-- | >>> printEl plainImplicits 0 Nil (SApp (SApp (SGlobal "+") (SLitInt 1)) (SLitInt 2))
-- | "1 + 2"
-- | >>> printEl plainImplicits 0 Nil (STag "Cons" (A.fromList [SLitInt 1, STag "Cons" (A.fromList [SLitInt 2, STag "Nil" A.empty])]))
-- | "[1, 2]"
-- | >>> printEl plainImplicits 0 Nil (STag "Nil" A.empty)
-- | "[]"
-- | >>> printEl plainImplicits 2 Nil (STag "Cons" (A.fromList [SLitInt 1, SGlobal "xs"]))
-- | "(Cons 1 xs)"
-- | >>> printEl plainImplicits 0 Nil (STag "Cons" (A.fromList [SLitRune 97, STag "Cons" (A.fromList [SLitRune 10, STag "Nil" A.empty])]))
-- | "['a', '\\n']"
printEl : Implicits -> Int -> List String -> Sx.Tm -> String
printEl im p xs e = pk.el { im = im, indent = 0 } p xs e

-- | >>> printTy plainImplicits 0 Nil (SFunction Small SPrimInt (AbsConst SPrimInt) Expl Nothing)
-- | "Int -> Int"
-- | >>> printTy plainImplicits 0 Nil (SFunction Small SPrimString (AbsConst (SPrimArray SPrimRune)) Expl Nothing)
-- | "String -> Array Rune"
printTy : Implicits -> Int -> List String -> Sx.Ty -> String
printTy im p xs t = pk.ty { im = im, indent = 0 } p xs t

-- Equations
--------------------------------------------------------------------------------

-- | a pattern: a variable (by de Bruijn level) or a tag of patterns
data Pat = PVar Int | PTag String (List Pat)

-- | how equations are written: what separates the sides, how many
-- | equations it takes to write a definition so (one: any function is
-- | `f x = ...`), and a body
type Style =
  { sep : String, minRows : Int, body : List String -> Sx.Tm -> String }

type Clause = { pats : List Pat, names : List String, body : Sx.Tm }

mkClause : List Pat -> List String -> Sx.Tm -> Clause
mkClause pats names body = { pats = pats, names = names, body = body }

isLamE : Sx.Tm -> Bool
isLamE (SLam _ _) = True
isLamE _ = False

isMatchE : Sx.Tm -> Bool
isMatchE (SMatch _ _) = True
isMatchE _ = False

hasVar : Int -> Pat -> Bool
hasVar l (PVar l2) = l == l2
hasVar l (PTag _ qs) = List.any (\q -> hasVar l q) qs

refine : Int -> Pat -> Pat -> Pat
refine l p (PVar l2) = if l == l2 then p else PVar l2
refine l p (PTag t qs) = PTag t (List.map (\q -> refine l p q) qs)

-- | a pattern in argument position
patAtom : Style -> List String -> Pat -> String
patAtom style ns (PVar l) = fromMaybe "_" (nth ns (List.length ns - 1 - l))
patAtom style ns (PTag t Nil) = t
patAtom style ns (PTag t qs) =
  "(" ^ t ^ " " ^ joinWith " " (List.map (\q -> patAtom style ns q) qs) ^ ")"

absBody : Sx.Abs Sx.Ty -> Sx.Ty
absBody (MkAbs _ t) = t
absBody (AbsConst t) = t

subPats : Int -> Int -> List String -> List Pat
subPats base k Nil = Nil
subPats base k (Cons _ rest) =
  Cons (PVar (base + k)) (subPats base (k + 1) rest)

-- the lambdas of the explicit arguments (the type says which are); an
-- implicit one ends the equations' shape
eqLams : List String -> List Pat -> Sx.Ty -> Sx.Tm -> Clause
eqLams ns ps ty@(SFunction _ _ cod Impl _) b = case b of
  SLam _ (MkAbs x body) ->
    -- an implicit argument is not written in the equations: it is in
    -- scope
    eqLams
      (Cons x ns)
      ps
      (absBody cod)
      body
  SIs e -> if isLamE e then eqLams ns ps ty e else mkClause ps ns b
  _ -> mkClause ps ns b
eqLams ns ps ty@(SFunction _ _ cod Expl _) b = case b of
  SLam _ (MkAbs x body) ->
    eqLams
      (Cons x ns)
      (List.append ps (Cons (PVar (List.length ns)) Nil))
      (absBody cod)
      body
  -- `_ => e`: not by cases
  SLam _ (AbsConst _) -> mkClause Nil ns b
  SIs e -> if isLamE e then eqLams ns ps ty e else mkClause ps ns b
  _ -> mkClause ps ns b
-- (an instance argument is not written in the equations either: it
-- is in scope, by its name)
eqLams ns ps ty@(SFunction _ _ cod Inst _) b = case b of
  SLam _ (MkAbs x body) -> eqLams (Cons x ns) ps (absBody cod) body
  SIs e -> if isLamE e then eqLams ns ps ty e else mkClause ps ns b
  _ -> mkClause ps ns b
eqLams ns ps (SIsTy _) b = mkClause ps ns b
eqLams ns ps ty b = case b of
  SIs e -> if isLamE e then eqLams ns ps ty e else mkClause ps ns b
  _ -> mkClause ps ns b

-- refine the patterns by every `match` on one of their variables
eqGo : List String -> List Pat -> Sx.Tm -> List Clause
-- `is` marks where a description is made; equations do not show it
eqGo ns ps body@(SIs e) =
  if List.length ps > 0 && isMatchE e then eqGo ns ps e
  else Cons (mkClause ps ns body) Nil
eqGo ns ps body@(SMatch (SLocal i) arms) =
  if List.any (\p2 -> hasVar (List.length ns - 1 - i) p2) ps
    then List.concatMap
        (\arm -> case arm of
         MkPair t (MkPair xs b) ->
           eqGo
             (List.foldl (\acc x -> Cons x acc) ns (A.toList xs))
             (List.map
                (\p2 ->
                   refine
                     (List.length ns - 1 - i)
                     (PTag t (subPats (List.length ns) 0 (A.toList xs)))
                     p2)
                ps)
             b)
        (D.toList arms)
  else Cons (mkClause ps ns body) Nil
eqGo ns ps body = Cons (mkClause ps ns body) Nil

eqRow : Style -> String -> Clause -> String
eqRow style f r =
  joinWith " " (Cons f (List.map (\p2 -> patAtom style r.names p2) r.pats))
  ^ " "
  ^ style.sep
  ^ " "
  ^ style.body r.names r.body

eqRows : Style -> String -> List Pat -> List Clause -> Maybe (List String)
eqRows style f pats rows =
  if List.null pats || List.length rows < style.minRows then Nothing
  else Just (List.map (\r -> eqRow style f r) rows)

eqTake : Style -> String -> Clause -> Maybe (List String)
eqTake style f lam = eqRows style f lam.pats (eqGo lam.names lam.pats lam.body)

equationsWith : Style
              -> String
              -> List String
              -> Sx.Ty
              -> Sx.Tm
              -> Maybe (List String)
equationsWith style f names0 ty0 el0 =
  eqTake style f (eqLams names0 Nil ty0 el0)

-- Definitions and signatures
--------------------------------------------------------------------------------

primitiveOf : Sx.Tm -> Maybe String
primitiveOf (SPrim x) = Just x
primitiveOf (SIs e) = primitiveOf e
primitiveOf _ = Nothing

stripIs : Sx.Tm -> Sx.Tm
stripIs (SIs e) = stripIs e
stripIs e = e

unIsTy : Sx.Ty -> Sx.Ty
unIsTy (SIsTy d) = unIsTy d
unIsTy d = d

type Former =
  { params : List String, names : List String, def : Sx.Ty, large : Bool }

-- | `(p : A) -> ... -> Type` defined by lambdas and then a type: a
-- | `data`, a `type` or a `theory` (`large`: into `Theory`)
formerAt : List String -> List String -> Sx.Tm -> Bool -> Former
formerAt params ns (SCode d) large =
  { params = params, names = ns, def = unIsTy d, large = large }
-- (`type T = Tk.T`: a type-valued term, an alias among them)
formerAt params ns b large =
  { params = params, names = ns, def = SDecode b, large = large }

-- (a parameter of type `Type` is bare if it is lower case: `data List a`)
formerParam : List String -> String -> Sx.Ty -> String
formerParam ns x (SU SmallU) = if upper x then "(" ^ x ^ " : Type)" else x
formerParam ns x dom =
  "("
  ^ x
  ^ " : "
  ^ printTy { names = \xs2 e2 -> arrayNone, hide = False } 0 ns dom
  ^ ")"

typeFormer : Sx.Ty -> Sx.Tm -> List String -> List String -> Maybe Former
typeFormer (SU u) body ns params =
  Just (formerAt params ns (stripIs body) (Pm.eqUniverse u LargeU))
typeFormer t@(SFunction _ dom (MkAbs _ cod) Expl _) body ns params = case body of
  SLam _ (MkAbs x b) ->
    typeFormer
      cod
      b
      (Cons x ns)
      (List.append params (Cons (formerParam ns x dom) Nil))
  SIs b -> typeFormer t b ns params
  _ -> Nothing
typeFormer t body ns params = case body of
  SIs b -> typeFormer t b ns params
  _ -> Nothing

formerHead : String -> List String -> String
formerHead name params = joinWith " " (Cons name params)

formerOf : Ctx -> String -> Former -> Maybe String
formerOf c name tf@{ def = SSum vs } =
  if tf.large then Nothing
  else Just
      ("data "
       ^ formerHead name tf.params
       ^ (if List.null (D.toList vs) then ""
          else " = "
            ^ joinWith
              " | "
              (List.map (\v -> variantStr pk c tf.names v) (D.toList vs)))
       ^ "\n")
formerOf c name tf@{ def = SRecord _ fs ds } =
  if tf.large
    then Just
        ("theory "
         ^ formerHead name tf.params
         ^ " where\n"
         ^ joinWith
           "\n"
           (List.map
              (\l -> "  " ^ l)
              (recordFields pk c tf.names (D.toList fs) ds))
         ^ "\n")
  else Just
      ("type "
       ^ formerHead name tf.params
       ^ " = "
       ^ pk.ty c 0 tf.names tf.def
       ^ "\n")
formerOf c name tf =
  if tf.large then Nothing
  else Just
      ("type "
       ^ formerHead name tf.params
       ^ " = "
       ^ pk.ty c 0 tf.names tf.def
       ^ "\n")

-- | a definition written back as `data`, `type` or `theory`, where it
-- | has their shape
former : Implicits -> String -> Sx.Ty -> Sx.Tm -> Maybe String
former im name t body = case typeFormer t body (Cons name Nil) Nil of
  Just tf -> formerOf { im = im, indent = 0 } name tf
  Nothing -> Nothing

printGeneral : Implicits -> String -> Sx.Ty -> Sx.Tm -> String
printGeneral im name t body =
  name
  ^ " : "
  ^ printTy im 0 Nil t
  ^ "\n"
  ^ (case equationsWith
       { sep = "="
       , minRows = 1
       , body = \ns e -> pk.el { im = im, indent = 0 } 0 ns e
       }
       name
       (Cons name Nil)
       t
       body of
     Just eqs -> joinWith "" (List.map (\l -> l ^ "\n") eqs)
     Nothing ->
       name
       ^ " = "
       ^ pk.el { im = im, indent = 0 } 0 (Cons name Nil) body
       ^ "\n")

-- | a stored definition: as `data`, `type`, `theory` or `primitive`
-- | where it has their shape, else a signature and equations
printDef : Implicits -> String -> Sx.Ty -> Sx.Tm -> String
printDef im name t body = case primitiveOf body of
  Just _ -> "primitive " ^ name ^ " : " ^ printTy im 0 Nil t ^ "\n"
  Nothing -> fromMaybe (printGeneral im name t body) (former im name t body)

-- | a definition as an interface has it: `data`, `type` and `theory` in
-- | full -- an importer sees through them -- and any other as its
-- | signature.  `shown` is the name as a signature writes it (an
-- | operator in parentheses)
printSig : Implicits -> String -> String -> Sx.Ty -> Sx.Tm -> String
printSig im name shown t body = case primitiveOf body of
  Just _ -> shown ^ " : " ^ printTy im 0 Nil t ^ "\n"
  Nothing ->
    fromMaybe
      (shown ^ " : " ^ printTy im 0 Nil t ^ "\n")
      (former im name t body)
