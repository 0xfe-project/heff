-- The reader: text into presyntax.  The text is read once, by `heff.syntax.cst`
-- (the concrete syntax the formatter lays out too); here what it reads
-- is lowered into the presyntax the elaborator takes -- which names are
-- in scope (a capitalised one is a tag unless it is), how operators bind
-- (the fixities), the sugar taken apart, and signatures met with their
-- equations.  `P` is the lowering's monad -- state threaded, a diagnostic
-- thrown -- and this module's `bind` is its; the lowering's functions
-- call one another, so they are the fields of one record, `lw`.

module heff.syntax.surface

import array as Array
import heff.syntax.cst as CST
import heff.syntax.diagnostic
import heff.elab.fixed as Fixed
import heff.syntax.fixity as Fixity
import heff.syntax.fmt.lex as Lex
import heff.syntax.fmt.tokens as Tokens
import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import heff.util.rune as RuneUtil
import std.map as Map

type Binders = { f : String, names : List String, implicits : List String }

mkBinders : String -> List String -> List String -> Binders
mkBinders f names implicits = { f = f, names = names, implicits = implicits }

-- | `toks`: the tokens read (the lowering looks one past a parenthesis);
-- | `scope`: the names bound where the lowering is; `binders`: the names
-- | each signature binds, by the name it is of (the last read first);
-- | `patVars`: those of the equation being lowered; `fix`: the fixities
-- | in scope; `lenient`: unrelated operators bind as one left-associative
-- | group (the formatter's reading); `at`: where an offset is, said
-- | `path:line:col`; `knot`: the names of the `mutual` block being
-- | lowered, each to the name of the record that knots them
type St =
  { toks : Array CST.T
  , scope : List String
  , known : String -> Bool
  , binders : Map.Map String (List Binders)
  , patVars : List String
  , fix : Fixity.Fixities
  , lenient : Bool
  , at : Int -> String
  , knot : Map.Map String String
  }

type P a = St -> Pair (Either Diag a) St

bindStep : {a b : Type}
         -> Pair (Either Diag a) St
         -> (a -> P b)
         -> Pair (Either Diag b) St
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

bind : {a b : Type} -> P a -> (a -> P b) -> P b
bind m f = \st -> bindStep (m st) f

pure : {a : Type} -> a -> P a
pure x = \st -> MkPair (Right x) st

pGets : {a : Type} -> (St -> a) -> P a
pGets f = \st -> MkPair (Right (f st)) st

pModify : (St -> St) -> P Unit
pModify f = \st -> MkPair (Right MkUnit) (f st)

throwP : {a : Type} -> Diag -> P a
throwP d = \st -> MkPair (Left d) st

diag : Params.Span -> String -> Diag
diag span msg =
  { code = 150, severity = SError, msg = msg, span = span, note = Nothing }

mkSt : Array CST.T
     -> List String
     -> (String -> Bool)
     -> Map.Map String (List Binders)
     -> List String
     -> Fixity.Fixities
     -> Bool
     -> (Int -> String)
     -> Map.Map String String
     -> St
mkSt toks scope known binders patVars fix lenient at knot =
  { toks = toks
  , scope = scope
  , known = known
  , binders = binders
  , patVars = patVars
  , fix = fix
  , lenient = lenient
  , at = at
  , knot = knot
  }

setScope : List String -> St -> St
setScope sc s =
  mkSt s.toks sc s.known s.binders s.patVars s.fix s.lenient s.at s.knot

setBinders : Map.Map String (List Binders) -> St -> St
setBinders b s =
  mkSt s.toks s.scope s.known b s.patVars s.fix s.lenient s.at s.knot

setPatVars : List String -> St -> St
setPatVars pv s =
  mkSt s.toks s.scope s.known s.binders pv s.fix s.lenient s.at s.knot

setKnot : Map.Map String String -> St -> St
setKnot k s =
  mkSt s.toks s.scope s.known s.binders s.patVars s.fix s.lenient s.at k

-- Tokens and spans
--------------------------------------------------------------------------------

-- | `:` annotates (`::` is an operator: the prelude's cons)
isAnnText : String -> Bool
isAnnText x = strEq x ":"

-- (a token as the lexer gives it: the fixities are read from those)
spanOf : Lex.Tok -> Params.Span
spanOf t = { start = t.start, end = t.end }

spanT : CST.T -> Params.Span
spanT t = { start = t.start, end = t.end }

spanTT : CST.T -> CST.T -> Params.Span
spanTT a b = { start = a.start, end = b.end }

spanTE : CST.T -> Int -> Params.Span
spanTE a e = { start = a.start, end = e }

mkSpan : Int -> Int -> Params.Span
mkSpan a b = { start = a, end = b }

appendS : {a : Type} -> List a -> List a -> List a
appendS Nil ys = ys
appendS (Cons x xs) ys = Cons x (appendS xs ys)

withScope : {a : Type} -> List String -> P a -> P a
withScope xs p = do
  saved <- pGets (\s -> s.scope)
  pModify (\s -> setScope (appendS xs s.scope) s)
  x <- p
  pModify (\s -> setScope saved s)
  pure x

instance instanceMonadP : Monad P
instanceMonadP = { pure = pure, bind = bind }

traverseS : {a b : Type} -> (a -> P b) -> List a -> P (List b)
traverseS = traverse (mo := instanceMonadP)

-- | the items of a block, lowered: what one binds is in scope in those
-- | after it, not after the block
block : {a b : Type} -> (a -> P b) -> List a -> P (List b)
block f xs = do
  saved <- pGets (\s -> s.scope)
  ys <- traverseS f xs
  pModify (\s -> setScope saved s)
  pure ys

-- Number literals
--------------------------------------------------------------------------------

-- (a digit's value: `0`-`9`, `a`-`f`, `A`-`F`)
digitOf : Int -> Int
digitOf c = if c >= 97 then c - 87 else if c >= 65 then c - 55 else c - 48

-- (the digits of `s` from `i` to `stop`, in `base`; a `_` is a separator)
digitsVal : Int -> String -> Int -> Int -> Int -> Int
digitsVal base s i stop n =
  if i >= stop then n
  else if byteAt s i == 95 then digitsVal base s (i + 1) stop n
  else digitsVal base s (i + 1) stop (n * base + digitOf (byteAt s i))

-- (an integer's digits from `i`, after `0x` hexadecimal, after `0b`
-- binary, else decimal)
magnitudeOf : String -> Int -> Int
magnitudeOf s i =
  if strEq (strSlice s i (i + 2)) "0x" || strEq (strSlice s i (i + 2)) "0X"
  then digitsVal 16 s (i + 2) (strLength s) 0
  else if strEq (strSlice s i (i + 2)) "0b" || strEq (strSlice s i (i + 2)) "0B"
  then digitsVal 2 s (i + 2) (strLength s) 0
  else digitsVal 10 s i (strLength s) 0

-- | an integer as the lexer writes it: a sign, then decimal digits, or
-- | hexadecimal after `0x`, binary after `0b`, `_` between digits
intOfText : String -> Int
intOfText s =
  if startsWith "-" s then 0 - magnitudeOf s 1
  else if startsWith "+" s then magnitudeOf s 1
  else magnitudeOf s 0

ipow10 : Int -> Int
ipow10 k = if k <= 0 then 1 else 10 * ipow10 (k - 1)

expOf : String -> Int
expOf ex =
  if startsWith "-" ex then 0 - intOfText (strSlice ex 1 (strLength ex))
  else if startsWith "+" ex then intOfText (strSlice ex 1 (strLength ex))
  else intOfText ex

dotAt : String -> Int -> Int
dotAt s i =
  if i >= strLength s then strLength s
  else if byteAt s i == 46 then i
  else dotAt s (i + 1)

-- (the digits with the dot taken out: an exact integer mantissa, and
-- how many digits were after the dot)
mantScale : String -> Int -> Int
mantScale m d = if d >= strLength m then 0 else strLength m - d - 1

mantInt : String -> Int -> Int
mantInt m d =
  if d >= strLength m then intOfText m
  else intOfText (strSlice m 0 d ^ strSlice m (d + 1) (strLength m))

splitExp : String -> Int -> Int
splitExp s i =
  if i >= strLength s then strLength s
  else if byteAt s i == 101 || byteAt s i == 69 then i
  else splitExp s (i + 1)

-- (one conversion, not a float computation per digit: `M * 10^p` is an
-- exact integer when `p >= 0`, and one division otherwise -- so the
-- value is the literal's, as JavaScript reads it)
floatAt : Int -> Int -> Float64
floatAt m p =
  if p >= 0 then toFloat (m * ipow10 p)
  else toFloat m /. toFloat (ipow10 (0 - p))

floatSplit : String -> Int -> Float64
floatSplit s eAt =
  floatAt
    (mantInt (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))
    ((if eAt >= strLength s then 0
      else expOf (strSlice s (eAt + 1) (strLength s)))
     - mantScale (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))

-- (`a.b`, with an optional sign and an optional `e`/`E` exponent)
floatOfDigits : String -> Float64
floatOfDigits s =
  if startsWith "-" s
  then 0.0
    - floatSplit
      (strSlice s 1 (strLength s))
      (splitExp (strSlice s 1 (strLength s)) 0)
  else if startsWith "+" s
  then floatSplit
      (strSlice s 1 (strLength s))
      (splitExp (strSlice s 1 (strLength s)) 0)
  else floatSplit s (splitExp s 0)

-- | a float as the lexer writes it: `a.b`, with an optional sign and an
-- | optional `e`/`E` exponent, `_` between digits
floatOfText : String -> Float64
floatOfText s = floatOfDigits (joinWith "" (split "_" s))

type Operand a = { op : CST.T, e : a }

mkOperand : {a : Type} -> CST.T -> a -> Operand a
mkOperand t e = { op = t, e = e }

piBinderNames : Presyntax.PiBinder Presyntax.Expr Presyntax.Expr -> List String
piBinderNames (PiNamed x _ _) = Cons x Nil
piBinderNames (PiImplicit x _ _ _ _) = Cons x Nil
piBinderNames (PiInstance x _ _ _) = Cons x Nil
piBinderNames (PiAnon _) = Nil

-- | the names a (function) type binds: `(x : A) -> ...`, `{x : A} -> ...`
piBinders : Presyntax.Expr -> List String
piBinders (At (EPi b rest) _) = appendS (piBinderNames b) (piBinders rest)
piBinders _ = Nil

-- | the names of the implicit parameters, `{x : A} -> ...`
piImplicits : Presyntax.Expr -> List String
piImplicits (At (EPi (PiImplicit x _ _ _ _) rest) _) = Cons x (piImplicits rest)
piImplicits (At (EPi (PiInstance x _ _ _) rest) _) = Cons x (piImplicits rest)
piImplicits (At (EPi _ rest) _) = piImplicits rest
piImplicits _ = Nil

paramName : Params.Spanned (Presyntax.Param Presyntax.Expr) -> String
paramName (At (ExplicitParam x _ _) _) = x
paramName (At (ImplicitParam x _ _) _) = x

concatMapS : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapS f Nil = Nil
concatMapS f (Cons x xs) = appendS (f x) (concatMapS f xs)

-- | the names a pattern binds (`_` binds nothing; a tag is no
-- | variable; nor is a capitalised name, unless `pv`, the parameters the
-- | signature names, has it)
boundBy : List String -> CST.Pat -> List String
boundBy pv (PAtom t) =
  if strEq t.kind "var" && not (strEq t.text "_") then Cons t.text Nil
  else if strEq t.kind "con" && List.elemBy strEq t.text pv then Cons t.text Nil
  else Nil
boundBy pv (PCon c args) = concatMapS (\q -> boundBy pv q) args
boundBy pv (PParen o q c) = boundBy pv q
boundBy pv (PList o ps commas c) = concatMapS (\q -> boundBy pv q) ps
boundBy pv (PSeg q cc spec) = boundBy pv q
boundBy pv (POp l op q) = appendS (boundBy pv l) (boundBy pv q)
boundBy pv (PRec o fs commas c) = concatMapS (\q -> boundBy pv q) fs
boundBy pv (PField x eq q) = boundBy pv q
boundBy pv (PAs x at q) = Cons x.text (boundBy pv q)

isVarE : Presyntax.Expr -> Bool
isVarE (At (EVar _) _) = True
isVarE _ = False

-- (a name as written: a capitalised one is a tag, but not a tag made of
-- other syntax, `[]`)
isNameE : Presyntax.Expr -> Bool
isNameE (At (EVar _) _) = True
isNameE (At (ETag x) sp) = sp.end - sp.start == strLength x
isNameE _ = False

asNameE : Presyntax.Expr -> Presyntax.Expr
asNameE (At (ETag x) sp) = At (EVar x) sp
asNameE e = e

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) xs) = Cons x (catMaybesS xs)
catMaybesS (Cons Nothing xs) = catMaybesS xs

identOf : Presyntax.Expr -> Maybe String
identOf (At (EVar x) _) = Just x
identOf (At (ETag x) _) = Just x
identOf _ = Nothing

identsOfG : Presyntax.Expr -> List String
identsOfG g =
  catMaybesS
    (List.map
       identOf
       (Cons (Presyntax.spineOf g).head (Presyntax.spineOf g).args))

asBinderOn : Presyntax.Expr -> P Presyntax.Expr
asBinderOn e@(At (EAnn g _) _) = do
  pModify (\s -> setScope (appendS (identsOfG g) s.scope) s)
  pure e
asBinderOn e = pure e

allS : {a : Type} -> (a -> Bool) -> List a -> Bool
allS p Nil = True
allS p (Cons x xs) = p x && allS p xs

nameBinder : Presyntax.Expr -> Presyntax.Expr
nameBinder (At (EAnn g t) _) =
  if allS isNameE (Cons (Presyntax.spineOf g).head (Presyntax.spineOf g).args)
  then Presyntax.ann
      (Presyntax.app
         (asNameE (Presyntax.spineOf g).head)
         (List.map asNameE (Presyntax.spineOf g).args))
      t
  else Presyntax.ann g t
nameBinder e0 = e0

-- | `A : T` as a binder: what is left of `:` is names (in scope after)
asBinder : Presyntax.Expr -> P Presyntax.Expr
asBinder e0 = asBinderOn (nameBinder e0)

foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

-- | `d -> b`, from the binder to the type
piOf : Presyntax.PiBinder Presyntax.Expr Presyntax.Expr
     -> Params.Span
     -> Presyntax.Expr
     -> Presyntax.Expr
piOf d dsp b = At (EPi d b) (Presyntax.spanning dsp (Params.spanOf b))

-- | what is left of `->`: a type, or what is in braces, `{x : A}` (and
-- | `{x : A := d}`, its default), or in double braces, `{{x : A}}` (where
-- | they are)
data ArrowLhs
  = Plain Presyntax.Expr
  | Braced Presyntax.Expr (Maybe Presyntax.Expr) Params.Span
  | Bracketed Presyntax.Expr Params.Span

-- | a type alone, or `(x : A)`
plainBinder : Presyntax.Expr -> Presyntax.PiBinder Presyntax.Expr Presyntax.Expr
plainBinder (At (EAnn (At (EVar x) xsp) t) _) = PiNamed x xsp t
plainBinder d = PiAnon d

-- | `(a b : T) -> B` is `(a : T) -> (b : T) -> B`; `{a b : T} -> B`, the
-- | same with implicit arguments (`{a b : T := d}`, each its default)
arrowNames : Presyntax.Expr
           -> Presyntax.Expr
           -> Presyntax.Expr
           -> Maybe Params.Span
           -> Maybe Presyntax.Expr
           -> Presyntax.Expr
           -> Presyntax.Expr
arrowNames rhs g ty braces dflt orig =
  if allS isVarE (Cons (Presyntax.spineOf g).head (Presyntax.spineOf g).args)
  then foldr
      (\x b -> case x of
       At (EVar y) ysp -> case braces of
         Just bsp -> piOf (PiImplicit y ysp bsp ty dflt) bsp b
         Nothing ->
           piOf
             (PiNamed y ysp ty)
             (Presyntax.spanning ysp (Params.spanOf ty))
             b
       _ -> b)
      rhs
      (Cons (Presyntax.spineOf g).head (Presyntax.spineOf g).args)
  else case braces of
    Just bsp ->
      piOf
        (PiAnon
           (At
              (EInvalid "an implicit argument is named: `{x : T} -> ...`")
              bsp))
        bsp
        rhs
    Nothing -> piOf (plainBinder orig) (Params.spanOf orig) rhs

arrowBinop : ArrowLhs -> Presyntax.Expr -> Presyntax.Expr
arrowBinop (Plain (At (EAnn g ty) sp)) rhs =
  arrowNames rhs g ty Nothing Nothing (At (EAnn g ty) sp)
arrowBinop (Plain d) rhs = piOf (PiAnon d) (Params.spanOf d) rhs
arrowBinop (Braced (At (EAnn g ty) sp) dflt bsp) rhs =
  arrowNames rhs g ty (Just bsp) dflt (At (EAnn g ty) sp)
arrowBinop (Braced d dflt bsp) rhs =
  piOf
    (PiAnon
       (At (EInvalid "an implicit argument is named: `{x : T} -> ...`") bsp))
    bsp
    rhs
arrowBinop (Bracketed (At (EAnn (At (EVar x) xsp) t) _) bsp) rhs =
  piOf (PiInstance x xsp bsp t) bsp rhs
arrowBinop (Bracketed d bsp) rhs =
  piOf
    (PiAnon
       (At (EInvalid "an instance argument is named: `{{x : T}} -> ...`") bsp))
    bsp
    rhs

-- | `e ~ { x = v }`, a setting at a time
specOne : Presyntax.Expr
        -> Params.Spanned (Presyntax.FieldSet Presyntax.Expr)
        -> Presyntax.Expr
specOne acc (At (SetField x _ v) fsp) =
  At (ESpec acc x fsp v) (Presyntax.spanning (Params.spanOf acc) fsp)
specOne acc (At (BadFieldSet e) fsp) =
  At (EInvalid "a specialisation sets a field by its name: `x = v`") fsp

-- The shunting yard
--------------------------------------------------------------------------------

type Shunt a = { ops : List CST.T, out : List a }

maxI : Int -> Int -> Int
maxI a b = if a < b then b else a

boolAnn : Params.Span -> Presyntax.Expr -> Presyntax.Expr
boolAnn osp e = Presyntax.ann e (At (EImplicitVar "Bool") osp)

-- (the sides are annotated with the `Bool` in scope)
shortcut : CST.T
         -> Presyntax.Expr
         -> Presyntax.Expr
         -> Presyntax.Expr
         -> Presyntax.Expr
shortcut op c a b =
  boolAnn
    (spanT op)
    (At
       (EMatch
          (boolAnn (spanT op) c)
          [ Presyntax.alt (Presyntax.patTag "True" (spanT op) Nil) a
          , Presyntax.alt (Presyntax.patTag "False" (spanT op) Nil) b
          ])
       (mkSpan
          (Params.spanOf c).start
          (maxI (Params.spanOf a).end (Params.spanOf b).end)))

-- | `&&` and `||` are `if`: the right side is computed only if needed
applyOp : CST.T -> Presyntax.Expr -> Presyntax.Expr -> Presyntax.Expr
applyOp op l r =
  if strEq op.text "&&" then shortcut op l r (At (ETag "False") (spanT op))
  else if strEq op.text "||" then shortcut op l (At (ETag "True") (spanT op)) r
  else Presyntax.app (At (EVar op.text) (spanT op)) [l, r]

-- | in a pattern, an operator is applied as a tag is: its operands are
-- | its arguments
applyPatOp : CST.T -> Presyntax.Pat -> Presyntax.Pat -> Presyntax.Pat
applyPatOp op l r = Presyntax.patOp op.text (spanT op) [l, r]

-- (stacks newest first: push is `Cons`)
reduceS : {a : Type} -> (CST.T -> a -> a -> a) -> Shunt a -> Shunt a
reduceS apply st@{ ops = Cons o os } = case st.out of
  Cons r (Cons l rest) -> { ops = os, out = Cons (apply o l r) rest }
  _ -> st
reduceS apply st@{ ops = Nil } = st

-- (two operators neither binds tighter than)
unrelatedMsg : Fixity.Fixities -> String -> String -> String
unrelatedMsg fix a b =
  if Fixity.bothLoosest fix a b
  then "`" ^ a ^ "` and `" ^ b ^ "` are both the loosest: add parentheses"
  else "`"
    ^ a
    ^ "` and `"
    ^ b
    ^ "` are not related: add parentheses, or declare which binds tighter (`above`, `below`)"

-- | `before` is on the stack, `op` comes: does `before` reduce first?
firstS : Fixity.Fixities -> Bool -> CST.T -> CST.T -> P Bool
firstS fix lenient before op = case Fixity.relate fix before.text op.text of
  Tighter -> pure True
  Looser -> pure False
  Same AssocLeft -> pure True
  Same AssocRight -> pure False
  Same AssocNone ->
    throwP
      (diag
         (spanT op)
         (if strEq before.text op.text
          then "`" ^ op.text ^ "` does not associate: add parentheses"
          else "`"
            ^ before.text
            ^ "` and `"
            ^ op.text
            ^ "` do not associate: add parentheses"))
  Unrelated ->
    if lenient then pure True
    else throwP (diag (spanT op) (unrelatedMsg fix before.text op.text))
  Undeclared x ->
    if lenient then pure True
    else throwP
        (diag
           (spanT (if strEq x op.text then op else before))
           ("`"
            ^ x
            ^ "` has no fixity: declare it (`infixl "
            ^ x
            ^ "`), or import the module that does"))

pushS : {a : Type}
      -> (CST.T -> a -> a -> a)
      -> Fixity.Fixities
      -> Bool
      -> Shunt a
      -> Operand a
      -> P (Shunt a)
pushS apply fix lenient st@{ ops = Nil } r =
  pure { ops = Cons r.op st.ops, out = Cons r.e st.out }
pushS apply fix lenient st@{ ops = Cons before os } r = do
  done <- firstS fix lenient before r.op
  if done then pushS apply fix lenient (reduceS apply st) r
    else pure { ops = Cons r.op st.ops, out = Cons r.e st.out }

pushAll : {a : Type}
        -> (CST.T -> a -> a -> a)
        -> Fixity.Fixities
        -> Bool
        -> Shunt a
        -> List (Operand a)
        -> P (Shunt a)
pushAll apply fix lenient st Nil = pure st
pushAll apply fix lenient st (Cons r rest) = do
  st' <- pushS apply fix lenient st r
  pushAll apply fix lenient st' rest

checkFixOf : {a : Type} -> Fixity.Fixities -> Bool -> List (Operand a) -> P Unit
checkFixOf fix lenient Nil = pure MkUnit
checkFixOf fix lenient (Cons r rest) = case Fixity.groupOf fix r.op.text of
  Just _ -> checkFixOf fix lenient rest
  Nothing ->
    if lenient then checkFixOf fix lenient rest
    else throwP
        (diag
           (spanT r.op)
           ("`"
            ^ r.op.text
            ^ "` has no fixity: declare it (`infixl "
            ^ r.op.text
            ^ "`), or import the module that does"))

reduceAll : {a : Type} -> (CST.T -> a -> a -> a) -> Shunt a -> Shunt a
reduceAll apply st@{ ops = Nil } = st
reduceAll apply st@{ ops = Cons o os } = reduceAll apply (reduceS apply st)

shuntOut : {a : Type} -> Shunt a -> List a
shuntOut st = st.out

headOr : {a : Type} -> a -> List a -> a
headOr z Nil = z
headOr z (Cons x xs) = x

-- | operators and operands into a tree, refusing operators that do not
-- | go together
resolve : {a : Type} -> (CST.T -> a -> a -> a) -> a -> List (Operand a) -> P a
resolve apply e0 rest = do
  fix <- pGets (\s -> s.fix)
  lenient <- pGets (\s -> s.lenient)
  checkFixOf fix lenient rest
  st <- pushAll apply fix lenient { ops = Nil, out = Cons e0 Nil } rest
  pure (headOr e0 (shuntOut (reduceAll apply st)))

-- Declarations
--------------------------------------------------------------------------------

-- | what a top-level declaration is, before signatures meet equations:
-- | a signature (what it declares, the name, where it is written, the
-- | type, where the signature is), an equation (where it is), a
-- | declaration whole, or a doc test (a watch, before it meets the
-- | definition it is of)
data Item
  = Sig Presyntax.Declared String Params.Span Presyntax.Expr Params.Span
  | Eqn String (Params.Spanned (Presyntax.Equation Presyntax.Expr)) Params.Span
  | Whole Presyntax.Decl
  | Doc Presyntax.Decl

-- Signatures meet their equations
--------------------------------------------------------------------------------

defOf : Presyntax.Declared
      -> String
      -> Params.Span
      -> Presyntax.Expr
      -> Params.Span
      -> List (Params.Spanned (Presyntax.Equation Presyntax.Expr))
      -> Presyntax.Decl
defOf declared f fsp ty sp eqs = At (DeclEquations f fsp declared ty eqs) sp

-- | the equations of a name, in order, and where the last of them ends
type Eqns =
  { eqns : List (Params.Spanned (Presyntax.Equation Presyntax.Expr))
  , end : Int
  }

-- (`e` before the equations `rest` of its name has after it)
eqnsCons : Params.Spanned (Presyntax.Equation Presyntax.Expr)
         -> Params.Span
         -> Maybe Eqns
         -> Eqns
eqnsCons e esp Nothing = { eqns = Cons e Nil, end = esp.end }
eqnsCons e esp (Just rest) =
  { eqns = Cons e rest.eqns, end = maxI esp.end rest.end }

-- (a declaration that defines a name: what a doc test may be of)
definesDecl : Presyntax.Decl -> Bool
definesDecl (At (DeclTest _ _) _) = False
definesDecl (At (DeclWatch _) _) = False
definesDecl _ = True

-- | the equations of `f` right under its signature, of the items after
-- | it: up to the next definition (a test or a watch between them is
-- | passed over)
eqnsUnder : String -> List Item -> Maybe Eqns
eqnsUnder f Nil = Nothing
eqnsUnder f (Cons (Eqn g e esp) rest) =
  if strEq f g then Just (eqnsCons e esp (eqnsUnder f rest)) else Nothing
eqnsUnder f (Cons (Whole d) rest) =
  if definesDecl d then Nothing else eqnsUnder f rest
eqnsUnder f (Cons (Doc _) rest) = eqnsUnder f rest
eqnsUnder f (Cons (Sig _ _ _ _ _) rest) = Nothing

-- | the names, to be looked up: one pass, not one for each look
nameSet : List String -> Map.Map String Unit
nameSet Nil = Map.empty
nameSet (Cons x rest) = Map.insert (nameSet rest) x MkUnit

isIn : Map.Map String Unit -> String -> Bool
isIn names x = Map.member names x

assembleSig : Presyntax.Declared
            -> String
            -> Params.Span
            -> Presyntax.Expr
            -> Params.Span
            -> Maybe Eqns
            -> Maybe Presyntax.Decl
assembleSig declared f fsp ty sp Nothing = Nothing
assembleSig declared f fsp ty sp (Just es) =
  Just (defOf declared f fsp ty (mkSpan sp.start (maxI sp.end es.end)) es.eqns)

-- (`rest`, the items after the one assembled)
assembleOne : Map.Map String Unit -> List Item -> Item -> Maybe Presyntax.Decl
assembleOne broken rest (Whole d) = Just d
assembleOne broken rest (Doc d) = Just d
assembleOne broken rest (Sig declared f fsp ty sp) =
  if isIn broken f
  then Just
      (defOf
         declared
         f
         fsp
         ty
         sp
         [ At
           (MkEquation f fsp Nil (At (EWord AbandonWord) sp))
           (Presyntax.spanning fsp sp)
         ])
  else assembleSig declared f fsp ty sp (eqnsUnder f rest)
assembleOne broken rest (Eqn _ _ _) = Nothing

consJust : {a : Type} -> Maybe a -> List a -> List a
consJust Nothing xs = xs
consJust (Just x) xs = Cons x xs

assembleGo : Map.Map String Unit
           -> List Item
           -> List Presyntax.Decl
           -> List Presyntax.Decl
assembleGo broken Nil acc = List.reverse acc
assembleGo broken (Cons it rest) acc =
  assembleGo broken rest (consJust (assembleOne broken rest it) acc)

-- | each signature met with the equations right under it
assemble : List String -> List Item -> List Presyntax.Decl
assemble broken items = assembleGo (nameSet broken) items Nil

-- | the names with a signature
sigNames : List Item -> Map.Map String Unit
sigNames Nil = Map.empty
sigNames (Cons (Sig _ f _ _ _) rest) = Map.insert (sigNames rest) f MkUnit
sigNames (Cons _ rest) = sigNames rest

-- | the names with an equation
eqnNames : List Item -> Map.Map String Unit
eqnNames Nil = Map.empty
eqnNames (Cons (Eqn f _ _) rest) = Map.insert (eqnNames rest) f MkUnit
eqnNames (Cons _ rest) = eqnNames rest

assembleDiagOne : Map.Map String Unit
                -> Map.Map String Unit
                -> Map.Map String Unit
                -> Item
                -> Maybe Diag
assembleDiagOne broken sigs eqns (Sig _ f _ _ sp) =
  if not (isIn eqns f) && not (isIn broken f)
  then Just (diag sp ("`" ^ f ^ "` has a type but no definition"))
  else Nothing
assembleDiagOne broken sigs eqns (Eqn f _ sp) =
  if not (isIn sigs f) && not (isIn broken f)
  then Just (diag sp ("`" ^ f ^ "` needs a type: `" ^ f ^ " : ...`"))
  else Nothing
assembleDiagOne broken sigs eqns (Whole _) = Nothing
assembleDiagOne broken sigs eqns (Doc _) = Nothing

assembleDiags : List String -> List Item -> List Diag
assembleDiags broken items =
  catMaybesS
    (List.map
       (assembleDiagOne (nameSet broken) (sigNames items) (eqnNames items))
       items)

-- Each name defined once
--------------------------------------------------------------------------------

-- | what an item defines: a name, where it is written, the name whose
-- | equations may come after it, what is said if the name is defined
-- | already, whether it is a primitive's; or nothing (an equation under
-- | its signature, a test, a watch)
data Defines = Names String Params.Span (Maybe String) String Bool | Passes

twiceMsg : String -> String
twiceMsg x = "`" ^ x ^ "` is defined twice"

apartMsg : String -> String
apartMsg x =
  "`"
  ^ x
  ^ "` is defined twice: its equations are apart, another definition between them"

isOpen : Maybe String -> String -> Bool
isOpen Nothing g = False
isOpen (Just f) g = strEq f g

eqnNameSpan : Params.Spanned (Presyntax.Equation Presyntax.Expr) -> Params.Span
eqnNameSpan (At (MkEquation _ fsp _ _) _) = fsp

wholeDefines : Presyntax.Decl -> Defines
wholeDefines (At (DeclDefine x xsp _ _ _) _) =
  Names x xsp Nothing (twiceMsg x) False
wholeDefines (At (DeclTheory x xsp _ _) _) =
  Names x xsp Nothing (twiceMsg x) False
wholeDefines (At (DeclPrimitive x xsp _) _) =
  Names x xsp Nothing (twiceMsg x) True
wholeDefines _ = Passes

-- (`open`: the name whose equations may come next)
definesOf : Maybe String -> Item -> Defines
definesOf open (Sig _ f fsp _ _) = Names f fsp (Just f) (twiceMsg f) False
definesOf open (Eqn g e _) =
  if isOpen open g then Passes
  else Names g (eqnNameSpan e) (Just g) (apartMsg g) False
definesOf open (Whole d) = wholeDefines d
definesOf open (Doc _) = Passes

-- | the names defined so far, each where it is first; those of them
-- | declared primitives; the name whose equations may come next; what
-- | is wrong (the last first)
type Defined =
  { seen : Map.Map String Params.Span
  , prims : Map.Map String Unit
  , open : Maybe String
  , diags : List Diag
  }

seenPlus : Map.Map String Params.Span
         -> String
         -> Params.Span
         -> Map.Map String Params.Span
seenPlus seen x sp =
  if Map.member seen x then seen
  else Map.insert seen x sp

-- (`x`, defined again at `sp`, if it is defined already; `at` says where
-- the first is)
twiceOf : (Int -> String)
        -> String
        -> Params.Span
        -> String
        -> Maybe Params.Span
        -> List Diag
        -> List Diag
twiceOf at x sp msg Nothing diags = diags
twiceOf at x sp msg (Just first) diags =
  Cons
    { code = 153
    , severity = SError
    , msg = msg
    , span = sp
    , note = Just ("`" ^ x ^ "` is first defined at " ^ at first.start)
    }
    diags

-- (where `x` is first defined, if it is; a primitive declared again is
-- E0336's, which says both places)
firstOf : Defined -> String -> Bool -> Maybe Params.Span
firstOf d x True = if isIn d.prims x then Nothing else Map.lookup d.seen x
firstOf d x False = Map.lookup d.seen x

primsPlus : Map.Map String Unit -> String -> Bool -> Map.Map String Unit
primsPlus prims x True = Map.insert prims x MkUnit
primsPlus prims x False = prims

definedStep : (Int -> String) -> Defined -> Defines -> Defined
definedStep at d Passes = d
definedStep at d (Names x sp next msg prim) =
  { seen = seenPlus d.seen x sp
  , prims = primsPlus d.prims x prim
  , open = next
  , diags = twiceOf at x sp msg (firstOf d x prim) d.diags
  }

definedDiags : Defined -> List Diag
definedDiags d = d.diags

-- | a name defined twice, at the second: by a signature, a `data`,
-- | `type`, `theory` or `primitive` (not a primitive declared again),
-- | or equations with no signature right above them (definitions are in order, each after those it uses, so a
-- | definition's equations are right under its signature)
twiceDiags : (Int -> String) -> List Item -> List Diag
twiceDiags at items =
  List.reverse
    (definedDiags
       (List.foldl
          (\(d : Defined) it -> definedStep at d (definesOf d.open it))
          { seen = Map.empty, prims = Map.empty, open = Nothing, diags = Nil }
          items))

-- Doc tests meet their definitions
--------------------------------------------------------------------------------

-- A doc test, `-- | >>> e`, is a line of the doc comment right above a
-- definition: it is checked after the definition, as a watch written
-- under it would be, with it and what is above it in scope.  Between
-- the doc test and the definition there are only comment lines (the
-- rest of the doc comment): a blank line, a declaration or the end of
-- the file there, and the doc test is of nothing -- it stays where it
-- is, checked there as a watch, and is warned of.

lineEndS : String -> Int -> Int
lineEndS src i = fromMaybe (strLength src) (indexFrom "\n" src i)

-- (each line from the one at `i` up to the line `to` is on a `--`
-- comment)
commentLinesFrom : String -> Int -> Int -> Bool
commentLinesFrom src i to =
  if lineEndS src i >= to then True
  else if startsWith "--" (trim (strSlice src i (lineEndS src i)))
  then commentLinesFrom src (lineEndS src i + 1) to
  else False

-- | only comment lines after the line `from` is on, up to `to`
commentsOnly : String -> Int -> Int -> Bool
commentsOnly src from to = commentLinesFrom src (lineEndS src from + 1) to

itemStart : Item -> Int
itemStart (Sig _ _ _ _ sp) = sp.start
itemStart (Eqn _ _ sp) = sp.start
itemStart (Whole d) = (Params.spanOf d).start
itemStart (Doc d) = (Params.spanOf d).start

-- (a signature starts a definition, so does `data`, `type`, `theory` or
-- `primitive`; an equation, a test or a watch does not)
definesItem : Item -> Bool
definesItem (Sig _ _ _ _ _) = True
definesItem (Whole d) = definesDecl d
definesItem _ = False

-- | the items so far, the doc tests waiting for their definition (each
-- | list last first), and what is wrong
type Placed =
  { items : List Item, waiting : List Presyntax.Decl, diags : List Diag }

mkPlaced : List Item -> List Presyntax.Decl -> List Diag -> Placed
mkPlaced items waiting diags =
  { items = items, waiting = waiting, diags = diags }

strayDiag : Presyntax.Decl -> Diag
strayDiag d =
  { code = 151
  , severity = SWarning
  , msg =
      "a doc test is of the definition right under its doc comment, no blank line between: there is none here, so it is checked here, as a watch"
  , span = Params.spanOf d
  , note =
      Just
        "write it as a watch, `-- >>> e`, or move it into the doc comment right above the definition it is of"
  }

-- (the doc tests waiting, of no definition: left where they are, each
-- warned of)
strand : Placed -> Placed
strand p =
  mkPlaced
    (appendS (List.map (\d -> Whole d) p.waiting) p.items)
    Nil
    (appendS (List.map strayDiag p.waiting) p.diags)

-- (whether what is at `at` is right under the doc test waiting last)
nextTo : String -> List Presyntax.Decl -> Int -> Bool
nextTo src (Cons d _) at = commentsOnly src (Params.spanOf d).end at
nextTo src Nil at = False

-- (another doc test, of the same definition as those waiting if it is
-- right under them)
docNext : String -> Placed -> Presyntax.Decl -> Placed
docNext src p d =
  if List.null p.waiting || nextTo src p.waiting (Params.spanOf d).start
  then mkPlaced p.items (Cons d p.waiting) p.diags
  else mkPlaced (strand p).items (Cons d Nil) (strand p).diags

-- (a definition: the doc tests right above it after it)
defNext : String -> Placed -> Item -> Placed
defNext src p it =
  if nextTo src p.waiting (itemStart it)
  then mkPlaced
      (appendS (List.map (\d -> Whole d) p.waiting) (Cons it p.items))
      Nil
      p.diags
  else mkPlaced (Cons it (strand p).items) Nil (strand p).diags

placeStep : String -> Placed -> Item -> Placed
placeStep src p (Doc d) = docNext src p d
placeStep src p it =
  if definesItem it then defNext src p it
  else mkPlaced (Cons it (strand p).items) Nil (strand p).diags

-- | the items, each doc test after the definition it is of; a doc test
-- | of none where it is, warned of
placeDocs : String -> List Item -> Placed
placeDocs src items =
  strand (List.foldl (\p it -> placeStep src p it) (mkPlaced Nil Nil Nil) items)

-- The lowering, knotted through `lw`
--------------------------------------------------------------------------------

atomOf : CST.E -> Maybe CST.T
atomOf (Atom t) = Just t
atomOf _ = Nothing

symAtom : CST.E -> Maybe CST.T
symAtom (Atom t) = if strEq t.kind "sym" then Just t else Nothing
symAtom _ = Nothing

-- | an operator's right side, as written: the operator, and its operand
opRhsOf : CST.E -> Pair CST.T CST.E
opRhsOf (OpRhs op e) = MkPair op e
opRhsOf e = MkPair (CST.firstE e) e

-- | `{x : A}`, and `{x : A := d}`: braces around one declaration (not a
-- | record's field, set or with its default)
bracedOne : CST.E -> Maybe CST.E
bracedOne (Braces o (Cons f Nil) commas c) = case f of
  EFSet x eq e -> Nothing
  EFDefault d eq e -> if strEq eq.text ":=" then Just f else Nothing
  _ -> Just f
bracedOne _ = Nothing

-- | `{ x = e, ... }` or `{}`: a record's settings
settingsOf : CST.E -> Maybe (List CST.E)
settingsOf (Braces o Nil commas c) = Just Nil
settingsOf (Braces o fs@(Cons (EFSet x eq e) rest) commas c) = Just fs
settingsOf _ = Nothing

-- | `a : T`
isAnnE : Presyntax.Expr -> Bool
isAnnE (At (EAnn _ _) _) = True
isAnnE _ = False

type Lw =
  { e : CST.E -> P Presyntax.Expr
  , pat : CST.Pat -> P Presyntax.Pat
  , decl : CST.D -> P (List Item)
  }

-- | a keyword written as a word: a built-in type, or `abandon` (where
-- | the text becomes the word it is, once)
wordKw : String -> Presyntax.SyntaxWord
wordKw "Int" = IntWord
wordKw "Float64" = FloatWord
wordKw "String" = StringWord
wordKw "Rune" = RuneWord
wordKw "Array" = ArrayWord
wordKw "abandon" = AbandonWord
wordKw x = case Fixed.fixedOfName x of
  Just w -> FixedWord w
  Nothing -> TypeWord

-- | a literal, a keyword or a name, as the token says
atomTok : CST.T -> Presyntax.Expr
atomTok t =
  if strEq t.kind "var" then At (EVar t.text) (spanT t)
  else if strEq t.kind "int" then At (EInt (intOfText t.text)) (spanT t)
  else if strEq t.kind "float" then At (EFloat (floatOfText t.text)) (spanT t)
  else if strEq t.kind "str" then At (EString t.text) (spanT t)
  else if strEq t.kind "rune"
  then At (ERune (RuneUtil.codeAt t.text 0)) (spanT t)
  else if strEq t.kind "sym" then At (EVar t.text) (spanT t)
  else At (EWord (wordKw t.text)) (spanT t)

-- | the same, in a pattern
patTok : CST.T -> Presyntax.Pat
patTok t =
  if strEq t.kind "var" then At (PatVar t.text) (spanT t)
  else if strEq t.kind "int" then At (PatInt (intOfText t.text)) (spanT t)
  else if strEq t.kind "float" then At (PatFloat (floatOfText t.text)) (spanT t)
  else if strEq t.kind "str" then At (PatString t.text) (spanT t)
  else if strEq t.kind "rune"
  then At (PatRune (RuneUtil.codeAt t.text 0)) (spanT t)
  else if strEq t.kind "sym" then At (PatVar t.text) (spanT t)
  else At (PatWord (wordKw t.text)) (spanT t)

withFields : Presyntax.Expr -> List CST.T -> Presyntax.Expr
withFields e fs =
  Presyntax.app e (List.map (\(f : CST.T) -> At (EProject f.text) (spanT f)) fs)

-- (`M.x` is a name `M`, an import's alias, gives)
qualifiedBy : St -> CST.T -> List CST.T -> Bool
qualifiedBy s t (Cons f _) = s.known (t.text ^ "." ^ f.text)
qualifiedBy s t Nil = False

-- (`M.x`, a definition of the module imported as `M`, and the fields
-- after it)
qualifiedE : CST.T -> List CST.T -> Presyntax.Expr
qualifiedE t (Cons f rest) =
  withFields (At (EVar (t.text ^ "." ^ f.text)) (spanTT t f)) rest
qualifiedE t Nil = At (ETag t.text) (spanT t)

-- (`M.x` where `M` is an import's alias that has `x` and a local name
-- too: which is meant is not said)
clashAt : CST.T -> String -> Params.Span -> Diag
clashAt t x sp =
  { code = 152
  , severity = SError
  , msg =
      "`"
      ^ t.text
      ^ "` is both an import's alias and a local name here: `"
      ^ t.text
      ^ "."
      ^ x
      ^ "` could be either"
  , span = sp
  , note =
      Just
        ("rename the local `"
         ^ t.text
         ^ "`, or import the module as another name")
  }

aliasClash : CST.T -> List CST.T -> Diag
aliasClash t (Cons f _) = clashAt t f.text (spanTT t f)
aliasClash t Nil = clashAt t "" (spanT t)

-- | a capitalised name: a variable or a definition in scope, or a tag;
-- | `M.x`, a definition of the module imported as `M` -- an error if `M`
-- | is a variable here too
conAtom : CST.T -> List CST.T -> P Presyntax.Expr
conAtom t fs = do
  local <- pGets (\s -> List.elemBy strEq t.text s.scope)
  qualified <- pGets (\s -> qualifiedBy s t fs)
  inScope <- pGets (\s -> local || s.known t.text)
  if qualified && local then throwP (aliasClash t fs)
    else pure
        (if qualified then qualifiedE t fs
         else if inScope then withFields (At (EVar t.text) (spanT t)) fs
         else withFields (At (ETag t.text) (spanT t)) fs)

-- | a capitalised keyword with fields, `Rune.x`: where `Rune` is an
-- | import's alias, a definition of the module imported as `Rune` (or, if
-- | it has no `x`, the module, as for any alias) -- a type has no fields;
-- | else the keyword
kwAtom : CST.T -> List CST.T -> P Presyntax.Expr
kwAtom t fs = do
  qualified <- pGets (\s -> qualifiedBy s t fs)
  aliased <- pGets (\s -> s.known t.text)
  pure
      (if qualified then qualifiedE t fs
       else if aliased then withFields (At (EVar t.text) (spanT t)) fs
       else withFields (atomTok t) fs)

-- | `e.x.y`: what is projected, and the fields
data Fields = MkFields CST.E (List CST.T)

fieldsOf : CST.E -> List CST.T -> Fields
fieldsOf (EField e f) acc = fieldsOf e (Cons f acc)
fieldsOf e acc = MkFields e acc

-- | the token after `t` is `->`: what is in the parentheses `t` closes
-- | binds names
arrowAfter : St -> CST.T -> Bool
arrowAfter s t = case Array.index s.toks (t.ix + 1) of
  Just u -> strEq u.kind "sym" && strEq u.text "->"
  Nothing -> False

-- | `[a, b, c]`, `Cons a (Cons b (Cons c Nil))`, and `[]`, `Nil`
listE : Params.Span -> List Presyntax.Expr -> Presyntax.Expr
listE sp xs =
  foldr
    (\x rest -> Presyntax.app (At (ETag "Cons") sp) [x, rest])
    (At (ETag "Nil") sp)
    xs

listP : Params.Span -> List Presyntax.Pat -> Presyntax.Pat
listP sp xs =
  foldr
    (\x rest -> Presyntax.patTag "Cons" sp [x, rest])
    (Presyntax.patTag "Nil" sp Nil)
    xs

-- | `x : T` in a binder's braces, and nothing else
declarationL : Lw -> CST.E -> P Presyntax.Expr
declarationL r e = do
  e0 <- r.e e
  d <- asBinder e0
  if isAnnE d then pure d
    else throwP (diag (Params.spanOf d) "a field is `name : Type`")

-- (from the field's start to its default's end, if it has one)
spanWith : Params.Span -> Maybe Presyntax.Expr -> Params.Span
spanWith sp Nothing = sp
spanWith sp (Just d) = Presyntax.spanning sp (Params.spanOf d)

-- | `x : T`, a field of a record type, and its default `d`, if it has one
fieldDeclOf : Presyntax.Expr
            -> Maybe Presyntax.Expr
            -> Params.Spanned
              (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr)
fieldDeclOf (At (EAnn (At (EVar x) xsp) t) sp) d =
  At (DeclareField x xsp t d) (spanWith sp d)
fieldDeclOf e d = At (BadFieldDecl e) (Params.spanOf e)

-- | `x : T`, or `x : T = d`, a field of a record type (`x : T := d` is
-- | none: an implicit argument's)
fieldL : Lw
       -> CST.E
       -> P (Params.Spanned (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr))
fieldL r (EFDefault e eq d) = do
  e' <- declarationL r e
  d' <- r.e d
  pure
      (if strEq eq.text "=" then fieldDeclOf e' (Just d')
       else At (BadFieldDecl e') (Params.spanOf e'))
fieldL r e = do
  e' <- declarationL r e
  pure (fieldDeclOf e' Nothing)

settingL : Lw -> CST.E -> P (Params.Spanned (Presyntax.FieldSet Presyntax.Expr))
settingL r (EFSet x eq e) = do
  e' <- r.e e
  pure
      (At
         (SetField x.text (spanT x) e')
         (Presyntax.spanning (spanT x) (Params.spanOf e')))
settingL r e = do
  e' <- r.e e
  pure (At (BadFieldSet e') (Params.spanOf e'))

-- | the fields of `x.y.z`, each where it is (the parser reads only those)
pathOf : CST.E
       -> List (Pair String Params.Span)
       -> List (Pair String Params.Span)
pathOf (EField e f) acc = pathOf e (Cons (MkPair f.text (spanT f)) acc)
pathOf (Atom x) acc = Cons (MkPair x.text (spanT x)) acc
pathOf e acc = acc

-- | `x.y = v` in an update
updateSettingL : Lw
               -> CST.E
               -> P (Params.Spanned (Presyntax.UpdateSet Presyntax.Expr))
updateSettingL r (EUSet path eq e) = do
  e' <- r.e e
  pure
      (At
         (SetPath (pathOf path Nil) e')
         (Presyntax.spanning (spanT (CST.firstE path)) (Params.spanOf e')))
updateSettingL r e = do
  e' <- r.e e
  pure (At (SetPath Nil e') (Params.spanOf e'))

isSetting : CST.E -> Bool
isSetting (EFSet x eq e) = True
isSetting e = False

-- | what is in the braces of `{x : A} -> B`, and of `{x : A := d} -> B`
-- | its default (in scope there: the binders before it, not `x`)
bracedL : Lw -> CST.E -> Params.Span -> P ArrowLhs
bracedL r (EFDefault e eq d) sp = do
  d' <- r.e d
  e' <- declarationL r e
  pure (Braced e' (Just d') sp)
bracedL r f sp = do
  e' <- declarationL r f
  pure (Braced e' Nothing sp)

bracesL : Lw -> CST.T -> List CST.E -> CST.T -> P Presyntax.Expr
bracesL r o Nil c = pure (At (EStruct Nil) (spanTT o c))
bracesL r o fs@(Cons f rest) c =
  if isSetting f
  then do
    fs' <- traverseS (\m -> settingL r m) fs
    pure (At (EStruct fs') (spanTT o c))
  else do
    fs' <- traverseS (\m -> fieldL r m) fs
    pure (At (ESig fs') (spanTT o c))

-- | `C x y`, a tag applied
conL : Lw -> CST.T -> List CST.E -> P Presyntax.Expr
conL r c args = do
  args' <- traverseS r.e args
  pure (Presyntax.app (At (ETag c.text) (spanT c)) args')

-- | a tag applied to types, an alternative of a sum type
variantOf : Presyntax.Expr -> Params.Spanned (Presyntax.Variant Presyntax.Expr)
variantOf e = case (Presyntax.spineOf e).head of
  At (ETag t) tsp ->
    At (TagVariant t tsp (Presyntax.spineOf e).args) (Params.spanOf e)
  _ -> At (BadVariant e) (Params.spanOf e)

variantL : Lw -> CST.E -> P (Params.Spanned (Presyntax.Variant Presyntax.Expr))
variantL r (ECon c args) = do
  e <- conL r c args
  pure (variantOf e)
variantL r e = do
  e' <- r.e e
  pure (variantOf e')

-- | a lambda's binder, and where it starts
type LamB = { binder : Presyntax.LamBinder Presyntax.Expr, span : Params.Span }

lamBinderL : Lw -> CST.E -> P LamB
lamBinderL r (BVar x) =
  pure { binder = LamName x.text (spanT x), span = spanT x }
lamBinderL r (BImp o x c) =
  pure { binder = LamImplicit x.text (spanT x), span = spanTT o c }
lamBinderL r (BAnn o x cc ty c) = do
  ty' <- r.e ty
  pure
      { binder = LamAnn x.text (spanT x) ty'
      , span = Presyntax.spanning (spanT x) (Params.spanOf ty')
      }
lamBinderL r e =
  throwP
    (diag (spanT (CST.firstE e)) ("unexpected `" ^ (CST.firstE e).text ^ "`"))

lamBound : LamB -> List String
lamBound { binder = LamName x _ } = Cons x Nil
lamBound { binder = LamImplicit x _ } = Cons x Nil
lamBound { binder = LamAnn x _ _ } = Cons x Nil

-- | `\x {y} _ -> e`
lambdaL : Lw -> List CST.E -> CST.E -> P Presyntax.Expr
lambdaL r binders body = do
  bs <- traverseS (\b -> lamBinderL r b) binders
  withScope (concatMapS lamBound bs) (do
    body' <- r.e body
    pure
        (foldr
           (\(b : LamB) e ->
              At
                (ELam b.binder e)
                (Presyntax.spanning b.span (Params.spanOf e)))
           body'
           bs))

-- | `C x y -> e`: `x` and `y` are bound in `e`
altL : Lw -> CST.E -> P (Params.Spanned (Presyntax.Alt Presyntax.Expr))
altL r (EAlt p arrow e) = do
  p' <- r.pat p
  withScope (boundBy Nil p) (do
    e' <- r.e e
    pure (Presyntax.alt p' e'))
altL r e =
  throwP
    (diag (spanT (CST.firstE e)) ("unexpected `" ^ (CST.firstE e).text ^ "`"))

-- | `if c then a else b`, a `case` on `True` and `False`
ifE : Params.Span
    -> Presyntax.Expr
    -> Presyntax.Expr
    -> Presyntax.Expr
    -> Presyntax.Expr
ifE sp c a b =
  At
    (EMatch
       (Presyntax.boolOf c)
       [ Presyntax.alt (Presyntax.patTag "True" sp Nil) a
       , Presyntax.alt (Presyntax.patTag "False" sp Nil) b
       ])
    sp

-- | `p = e`, or `p : T = e`, after `let`: the pattern, and what it is
-- | bound to (annotated, `(e : T)`)
letHeadL : Lw
         -> CST.Pat
         -> Maybe (Pair CST.T CST.E)
         -> CST.E
         -> P (Pair Presyntax.Pat Presyntax.Expr)
letHeadL r p ann0 e = do
  p' <- r.pat p
  case ann0 of
    Just (MkPair cc ty) -> do
      ty' <- r.e ty
      e' <- r.e e
      pure
          (MkPair
             p'
             (At
                (EAnn e' ty')
                (mkSpan (Params.spanOf ty').start (Params.spanOf e').end)))
    Nothing -> do
      e' <- r.e e
      pure (MkPair p' e')

-- | `in e` after `let p = e'`: `p`'s variables are bound in `e`
letBodyL : Lw
         -> CST.T
         -> Pair Presyntax.Pat Presyntax.Expr
         -> List String
         -> CST.E
         -> P Presyntax.Expr
letBodyL r kw (MkPair p rhs) names body =
  withScope names (do
  body' <- r.e body
  pure
      (At
         (ELetIn rhs (Presyntax.alt p body'))
         (spanTE kw (CST.lastE body).end)))

-- | `let p = e in e'`
letL : Lw -> CST.E -> P Presyntax.Expr
letL r (ELet kw p ann0 eq e (Just (MkPair i body))) = do
  h <- letHeadL r p ann0 e
  letBodyL r kw h (boundBy Nil p) body
letL r e =
  throwP
    (diag (spanT (CST.firstE e)) ("unexpected `" ^ (CST.firstE e).text ^ "`"))

-- | a statement of a `do` block: `x <- e` (`x` bound in the statements
-- | after it), `let p = e` (`p`'s variables bound in them), or `e`
stmtL : Lw -> CST.E -> P (Params.Spanned (Presyntax.Stmt Presyntax.Expr))
stmtL r (ESBind x arrow e) = do
  e' <- r.e e
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (At
         (StmtBind x.text (spanT x) e')
         (Presyntax.spanning (spanT x) (Params.spanOf e')))
stmtL r (ELet kw p ann0 eq e Nothing) = do
  h <- letHeadL r p ann0 e
  pModify (\s -> setScope (appendS (boundBy Nil p) s.scope) s)
  pure (At (StmtLet (fst h) (snd h)) (spanTE kw (CST.lastE e).end))
stmtL r (ELetMut kw m x ann0 eq e) = do
  h <- letHeadL r (PAtom x) ann0 e
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (At
         (StmtLetMut x.text (spanT x) (snd h))
         (spanTE kw (CST.lastE e).end))
stmtL r e = do
  e' <- r.e e
  pure (At (StmtExpr e') (Params.spanOf e'))

-- | `(err := T)` after `try`: the type of the throws it hears
tryTypeL : Lw -> Maybe CST.E -> P (Maybe Presyntax.Expr)
tryTypeL r Nothing = pure Nothing
tryTypeL r (Just (Named o x k e c)) =
  if strEq x.text "err"
  then do
    e' <- r.e e
    pure (Just e')
  else pure
      (Just
         (At
            (EInvalid
               "a `try` names the type of the throws it hears as `(err := T)`")
            (spanT x)))
tryTypeL r (Just e) =
  pure
    (Just
       (At
          (EInvalid
             "a `try` names the type of the throws it hears as `(err := T)`")
          (spanT (CST.firstE e))))

-- | `catch x -> ...`: `x` bound in its statements
catchL : Lw -> CST.E -> P (Presyntax.CatchArm Presyntax.Expr)
catchL r (ECatch kw b arrow body) = do
  lb <- lamBinderL r b
  ss <- withScope (lamBound lb) (block (\m -> stmtL r m) body)
  pure (MkCatchArm lb.binder ss)
catchL r e =
  throwP
    (diag (spanT (CST.firstE e)) ("unexpected `" ^ (CST.firstE e).text ^ "`"))

-- (what is there, lowered)
maybeL : Lw -> Maybe CST.E -> P (Maybe Presyntax.Expr)
maybeL r Nothing = pure Nothing
maybeL r (Just e) = do
  e' <- r.e e
  pure (Just e')

-- | `if let p = e then a`, and `else b` if there is one: `p`'s variables
-- | bound in `a`
ifLetL : Lw
       -> Params.Span
       -> CST.Pat
       -> CST.E
       -> CST.E
       -> Maybe CST.E
       -> P Presyntax.Expr
ifLetL r sp p e a b = do
  e' <- r.e e
  p' <- r.pat p
  a' <- withScope (boundBy Nil p) (r.e a)
  b' <- maybeL r b
  pure (At (EIfLet p' e' a' b') sp)

-- | an operator's operands, as written
operandL : Lw -> CST.E -> P (Operand Presyntax.Expr)
operandL r m = case opRhsOf m of
  MkPair op e -> do
    e' <- r.e e
    pure (mkOperand op e')

parenL : Lw -> CST.T -> CST.E -> CST.T -> P Presyntax.Expr
parenL r o e c = case symAtom e of
  Just t -> pure (At (EVar t.text) (spanT t))
  Nothing -> do
    e' <- r.e e
    after <- pGets (\s -> arrowAfter s c)
    if after then asBinder e' else pure e'

-- | `x -> y`, with `(a b : T) -> B` for `(a : T) -> (b : T) -> B`, and
-- | `{a : T} -> B` binding an implicit argument; `T ~ { f = v }`, a
-- | specialisation (the syntax's operators are these two)
opL : Lw -> CST.E -> CST.T -> CST.E -> P Presyntax.Expr
opL r a op b =
  if strEq op.text "->"
  then do
    a' <- case bracedOne a of
      Just f -> bracedL r f (spanTT (CST.firstE a) (CST.lastE a))
      Nothing -> case a of
        InstB o o2 d c1 c -> do
          d' <- declarationL r d
          pure (Bracketed d' (spanTT o c))
        _ -> do
          e <- r.e a
          pure (Plain e)
    b' <- r.e b
    pure (arrowBinop a' b')
  else do
    a' <- r.e a
    case settingsOf b of
      Just fs -> do
        fs' <- traverseS (\m -> settingL r m) fs
        pure (List.foldl (\acc f -> specOne acc f) a' fs')
      Nothing -> do
        b' <- r.e b
        pure
            (At
               (EInvalid "a specialisation sets fields: `T ~ { x = v }`")
               (Presyntax.spanning (Params.spanOf a') (Params.spanOf b')))

-- Binaries

-- A segment of a binary, `v::spec`: its spec is words, numbers,
-- `size(n)` and `unit(n)` between `-`s -- what it is (`integer`,
-- `binary` or `bytes`, `bits` or `bitstring`, `float`, `utf8`, `utf16`,
-- `utf32`), its size (a number, or `size(n)`, `n` a number or a name),
-- its unit (`unit(n)`, what the size counts: bits, 1 for an integer,
-- bits and a float, 8 for bytes), its endianness (`big`, `little`) and
-- sign (`signed`, `unsigned`), each said at most once.  An integer is of
-- 1 to 64 bits, a float of 32 or 64; a code point says no size.  A
-- string is its bytes, all of them.  Where no type is said, a string is
-- bytes, a float a `float`, a rune `utf8`, anything else an integer.

-- | a spec, as read so far: each part, if it is said (its size, a number
-- | or a name, of units)
type Spec =
  { ty : Maybe Presyntax.SegmentType
  , size : Presyntax.SegmentSize
  , unit : Maybe Int
  , little : Maybe Bool
  , signed : Maybe Bool
  }

emptySpec : Spec
emptySpec =
  { ty = Nothing
  , size = SizeDefault
  , unit = Nothing
  , little = Nothing
  , signed = Nothing
  }

-- | what a segment's value is, as the spec is checked against it
data SegValue = StrValue | IntValue Int | FloatValue | RuneValue | OtherValue

saidTwice : {a : Type} -> Params.Span -> String -> P a
saidTwice sp what = throwP (diag sp ("a segment says its " ^ what ^ " once"))

typeSaid : Params.Span
         -> Presyntax.SegmentType
         -> Maybe Presyntax.SegmentType
         -> Spec
         -> P Spec
typeSaid sp ty Nothing s = pure { s | ty = Just ty }
typeSaid sp ty (Just _) s = saidTwice sp "type"

sizeSaid : Params.Span
         -> Presyntax.SegmentSize
         -> Presyntax.SegmentSize
         -> Spec
         -> P Spec
sizeSaid sp n SizeDefault s = pure { s | size = n }
sizeSaid sp n _ s = saidTwice sp "size"

unitSaid : Params.Span -> Int -> Maybe Int -> Spec -> P Spec
unitSaid sp n Nothing s = pure { s | unit = Just n }
unitSaid sp n (Just _) s = saidTwice sp "unit"

littleSaid : Params.Span -> Bool -> Maybe Bool -> Spec -> P Spec
littleSaid sp b Nothing s = pure { s | little = Just b }
littleSaid sp b (Just _) s = saidTwice sp "endianness"

signedSaid : Params.Span -> Bool -> Maybe Bool -> Spec -> P Spec
signedSaid sp b Nothing s = pure { s | signed = Just b }
signedSaid sp b (Just _) s = saidTwice sp "sign"

-- (a spec's tokens, the groups between `-`s; `cur`, the group read so
-- far, the last first)
specGroups : List CST.T -> List CST.T -> List (List CST.T) -> List (List CST.T)
specGroups Nil cur acc = List.reverse (Cons (List.reverse cur) acc)
specGroups (Cons t rest) cur acc =
  if strEq t.text "-" then specGroups rest Nil (Cons (List.reverse cur) acc)
  else specGroups rest (Cons t cur) acc

notSpec : {a : Type} -> Params.Span -> P a
notSpec sp =
  throwP
    (diag
       sp
       "a segment's spec is its type (`integer`, `binary`, `bits`, `float`, `utf8`, `utf16`, `utf32`), size (`16`, `size(n)`), unit (`unit(8)`), endianness (`big`, `little`) and sign (`signed`, `unsigned`), between `-`s: `x::16-little`")

-- (a word of a spec: a type, an endianness, a sign)
specWord : CST.T -> Spec -> P Spec
specWord t s =
  if strEq t.text "integer" then typeSaid (spanT t) SegmentInteger s.ty s
  else if strEq t.text "binary" || strEq t.text "bytes"
  then typeSaid (spanT t) SegmentBinary s.ty s
  else if strEq t.text "bits" || strEq t.text "bitstring"
  then typeSaid (spanT t) SegmentBits s.ty s
  else if strEq t.text "float" then typeSaid (spanT t) SegmentFloat s.ty s
  else if strEq t.text "utf8" then typeSaid (spanT t) (SegmentUtf 8) s.ty s
  else if strEq t.text "utf16" then typeSaid (spanT t) (SegmentUtf 16) s.ty s
  else if strEq t.text "utf32" then typeSaid (spanT t) (SegmentUtf 32) s.ty s
  else if strEq t.text "big" then littleSaid (spanT t) False s.little s
  else if strEq t.text "little" then littleSaid (spanT t) True s.little s
  else if strEq t.text "signed" then signedSaid (spanT t) True s.signed s
  else if strEq t.text "unsigned" then signedSaid (spanT t) False s.signed s
  else notSpec (spanT t)

-- (`n` in `size(n)`, of units)
sizeOf : CST.T -> Presyntax.SegmentSize
sizeOf n =
  if strEq n.kind "int" then SizeNumber (intOfText n.text)
  else SizeName n.text (spanT n) 1

-- (`unit(n)`: of 1 to 256 bits)
unitOf : Params.Span -> CST.T -> Spec -> P Spec
unitOf sp n s =
  if strEq n.kind "int" && 1 <= intOfText n.text && intOfText n.text <= 256
  then unitSaid sp (intOfText n.text) s.unit s
  else throwP (diag sp "a unit is a number of bits, 1 to 256: `unit(8)`")

-- (a group of a spec: a word, a number, `size(n)`, `unit(n)`)
specGroup : Params.Span -> Spec -> List CST.T -> P Spec
specGroup sp s (Cons t Nil) =
  if strEq t.kind "int"
  then sizeSaid (spanT t) (SizeNumber (intOfText t.text)) s.size s
  else if strEq t.kind "var" then specWord t s
  else notSpec (spanT t)
specGroup sp s (Cons f (Cons o (Cons n (Cons c Nil)))) =
  if strEq f.text "size"
     && strEq o.text "("
     && strEq c.text ")"
     && (strEq n.kind "int" || strEq n.kind "var")
  then sizeSaid (spanTT f c) (sizeOf n) s.size s
  else if strEq f.text "unit" && strEq o.text "(" && strEq c.text ")"
  then unitOf (spanTT f c) n s
  else notSpec (spanTT f c)
specGroup sp s (Cons t rest) = notSpec (spanT t)
specGroup sp s Nil = notSpec sp

specGroupsOf : Params.Span -> Spec -> List (List CST.T) -> P Spec
specGroupsOf sp s Nil = pure s
specGroupsOf sp s (Cons g gs) = do
  s' <- specGroup sp s g
  specGroupsOf sp s' gs

-- | the spec after `::` (`cc`, where an empty one is said)
specOf : CST.T -> List CST.T -> P Spec
specOf cc toks = specGroupsOf (spanT cc) emptySpec (specGroups toks Nil Nil)

orFalse : Maybe Bool -> Bool
orFalse (Just b) = b
orFalse Nothing = False

-- (a segment's type, as said, else a string's bytes, a float's a float,
-- a rune's UTF-8 and anything else an integer)
typeOf : SegValue -> Maybe Presyntax.SegmentType -> Presyntax.SegmentType
typeOf v (Just t) = t
typeOf StrValue Nothing = SegmentBinary
typeOf FloatValue Nothing = SegmentFloat
typeOf RuneValue Nothing = SegmentUtf 8
typeOf v Nothing = SegmentInteger

-- (what a size counts, as said, else bytes' 8 bits and the others' 1)
unitIn : Presyntax.SegmentType -> Maybe Int -> Int
unitIn ty (Just u) = u
unitIn SegmentBinary Nothing = 8
unitIn ty Nothing = 1

-- (a size, of units, in bits)
sizeIn : Int -> Presyntax.SegmentSize -> Presyntax.SegmentSize
sizeIn unit SizeDefault = SizeDefault
sizeIn unit (SizeNumber n) = SizeNumber (n * unit)
sizeIn unit (SizeName x xsp _) = SizeName x xsp unit

-- | 2 to the `k`
twoToS : Int -> Int
twoToS k = if k <= 0 then 1 else 2 * twoToS (k - 1)

-- (whether `v` is an integer of `n` bits: in a pattern, as the sign
-- says it is read; written, either)
fitsIn : Bool -> Bool -> Int -> Int -> Bool
fitsIn True True n v = 0 - twoToS (n - 1) <= v && v < twoToS (n - 1)
fitsIn True False n v = 0 <= v && v < twoToS n
fitsIn False signed n v = 0 - twoToS (n - 1) <= v && v < twoToS n

sizeBits : Presyntax.SegmentSize -> Maybe Int
sizeBits SizeDefault = Just 8
sizeBits (SizeNumber n) = Just n
sizeBits (SizeName _ _ _) = Nothing

-- (a number, in an integer's segment of `n` bits)
integerFits : Bool -> Params.Span -> SegValue -> Spec -> Int -> P Unit
integerFits inPat sp (IntValue v) s n =
  if fitsIn inPat (orFalse s.signed) n v then pure MkUnit
  else throwP
      (diag
         sp
         (show v
          ^ " does not fit in "
          ^ show n
          ^ " bits"
          ^ (if not inPat then ""
             else if orFalse s.signed then ", signed"
             else ", unsigned")))
integerFits inPat sp v s n = pure MkUnit

-- (an integer's segment: its size, of 1 to 64 bits; a number, if it
-- is, in it)
integerChecks : Bool -> Params.Span -> SegValue -> Spec -> Maybe Int -> P Unit
integerChecks inPat sp v s (Just n) =
  if n < 1 || n > 64
  then throwP
      (diag sp ("an integer's segment is of 1 to 64 bits, not " ^ show n))
  else integerFits inPat sp v s n
integerChecks inPat sp v s Nothing = pure MkUnit

segFails : Params.Span -> String -> P Unit
segFails sp what = throwP (diag sp what)

-- (a value written, of the kind of its segment's type: a string bytes, a
-- float a float, a rune and a number a code point, a number an integer)
valueKind : Params.Span -> SegValue -> Presyntax.SegmentType -> P Unit
valueKind sp StrValue SegmentBinary = pure MkUnit
valueKind sp StrValue ty =
  segFails sp "a string's segment is its bytes, as they are: `\"GET\"`"
valueKind sp FloatValue SegmentFloat = pure MkUnit
valueKind sp FloatValue ty =
  segFails sp "a float's segment is a float: `1.5::float`"
valueKind sp RuneValue (SegmentUtf _) = pure MkUnit
valueKind sp RuneValue ty =
  segFails sp "a rune's segment is a code point: `'é'::utf8`"
valueKind sp (IntValue c) (SegmentUtf _) =
  if Presyntax.isScalarValue c then pure MkUnit
  else segFails sp (show c ^ " is no Unicode scalar value")
valueKind sp (IntValue _) SegmentInteger = pure MkUnit
valueKind sp (IntValue _) ty =
  segFails sp "a number's segment is an integer: `1`, `258::16`"
valueKind sp v ty = pure MkUnit

-- (a unit said, of a size said)
unitChecks : Params.Span -> Spec -> P Unit
unitChecks sp { size = SizeDefault, unit = Just _ } =
  segFails sp "a unit is what a size counts: say the size, `x::size(4)-unit(8)`"
unitChecks sp s = pure MkUnit

-- (a segment of no endianness nor sign said)
flagsNone : Params.Span -> Spec -> String -> P Unit
flagsNone sp { little = Nothing, signed = Nothing } what = pure MkUnit
flagsNone sp s what = segFails sp what

-- (a segment's own, by its type: of its size, endianness and sign)
typeChecks : Bool
           -> Params.Span
           -> SegValue
           -> Spec
           -> Presyntax.SegmentType
           -> Presyntax.SegmentSize
           -> P Unit
typeChecks inPat sp v s SegmentInteger size =
  integerChecks inPat sp v s (sizeBits size)
typeChecks inPat sp StrValue { size = SizeDefault, little = Nothing, signed = Nothing } SegmentBinary _ =
  pure MkUnit
typeChecks inPat sp StrValue s SegmentBinary _ =
  segFails
    sp
    "a string's segment is its bytes, all of them, as they are: `\"GET\"`"
typeChecks inPat sp v s SegmentBinary _ =
  if not (unitIn SegmentBinary s.unit % 8 == 0)
  then segFails
      sp
      "bytes are whole bytes: their unit is a multiple of 8, `x::binary-size(2)-unit(16)`"
  else flagsNone
      sp
      s
      "bytes are of no endianness nor sign: `x::binary`, `x::binary-size(4)`"
typeChecks inPat sp v s SegmentBits _ =
  flagsNone
    sp
    s
    "bits are of no endianness nor sign: `x::bits`, `x::bits-size(3)`"
typeChecks inPat sp v { signed = Just _ } SegmentFloat _ =
  segFails sp "a float is of no sign: `x::float`, `x::float-32-little`"
typeChecks inPat sp v s SegmentFloat SizeDefault = pure MkUnit
typeChecks inPat sp v s SegmentFloat (SizeNumber 64) = pure MkUnit
typeChecks inPat sp v s SegmentFloat (SizeNumber 32) = pure MkUnit
typeChecks inPat sp v s SegmentFloat (SizeNumber n) =
  segFails sp ("a float's segment is of 32 or 64 bits, not " ^ show n)
typeChecks inPat sp v s SegmentFloat _ =
  segFails sp "a float's size is a number, 32 or 64: `x::float-32`"
typeChecks inPat sp v { size = SizeDefault, unit = Nothing, signed = Nothing, little = Nothing } (SegmentUtf w) _ =
  pure MkUnit
typeChecks inPat sp v { size = SizeDefault, unit = Nothing, signed = Nothing } (SegmentUtf w) _ =
  if w == 8 then segFails sp "UTF-8 is of no endianness: `c::utf8`"
  else pure MkUnit
typeChecks inPat sp v { signed = Just _ } (SegmentUtf w) _ =
  segFails sp ("a code point is of no sign: `c::utf" ^ show w ^ "`")
typeChecks inPat sp v s (SegmentUtf w) _ =
  segFails
    sp
    ("a `utf"
     ^ show w
     ^ "` segment is as long as its code point: it says no size, `c::utf"
     ^ show w
     ^ "`")

-- | the segment `v::spec`, checked (`inPat`: in a pattern), its size in
-- | bits
segmentOf : {e : Type}
          -> Bool
          -> Params.Span
          -> e
          -> SegValue
          -> Spec
          -> P (Params.Spanned (Presyntax.Segment e))
segmentOf inPat sp e v s = do
  u1 <- valueKind sp v (typeOf v s.ty)
  u2 <- unitChecks sp s
  u3 <-
    typeChecks
      inPat
      sp
      v
      s
      (typeOf v s.ty)
      (sizeIn (unitIn (typeOf v s.ty) s.unit) s.size)
  pure
      (At
         (MkSegment
            e
            (typeOf v s.ty)
            (sizeIn (unitIn (typeOf v s.ty) s.unit) s.size)
            (orFalse s.little)
            (orFalse s.signed))
         sp)

valueOfE : Presyntax.Expr -> SegValue
valueOfE (At (EString _) _) = StrValue
valueOfE (At (EInt v) _) = IntValue v
valueOfE (At (EFloat _) _) = FloatValue
valueOfE (At (ERune _) _) = RuneValue
valueOfE _ = OtherValue

-- | a segment of a binary, written
segmentL : Lw -> CST.E -> P (Params.Spanned (Presyntax.Segment Presyntax.Expr))
segmentL r (Seg v cc spec) = do
  v' <- r.e v
  s <- specOf cc spec
  segmentOf
      False
      (spanTE (CST.firstE v) (CST.lastE (Seg v cc spec)).end)
      v'
      (valueOfE v')
      s
segmentL r e = do
  v' <- r.e e
  segmentOf
      False
      (spanTE (CST.firstE e) (CST.lastE e).end)
      v'
      (valueOfE v')
      emptySpec

valueOfP : Presyntax.Pat -> SegValue
valueOfP (At (PatString _) _) = StrValue
valueOfP (At (PatInt v) _) = IntValue v
valueOfP (At (PatFloat _) _) = FloatValue
valueOfP (At (PatRune _) _) = RuneValue
valueOfP _ = OtherValue

-- (what a pattern's segment holds: a name, `_`, a number, a string or a
-- rune)
segmentValue : CST.Pat -> Bool
segmentValue (PAtom t) =
  List.elemBy strEq t.kind ["var", "int", "float", "str", "rune"]
segmentValue (PParen o p c) = segmentValue p
segmentValue p = False

-- (a pattern's segment that takes all that is left: bytes or bits of no
-- size said, but a string)
takesRest : Presyntax.Segment Presyntax.Pat -> Bool
takesRest (MkSegment (At (PatString _) _) _ _ _ _) = False
takesRest (MkSegment _ SegmentBinary SizeDefault _ _) = True
takesRest (MkSegment _ SegmentBits SizeDefault _ _) = True
takesRest _ = False

valueChecked : Params.Span -> Bool -> P Unit
valueChecked sp True = pure MkUnit
valueChecked sp False =
  throwP
    (diag
       sp
       "a segment of a binary pattern holds a name, `_`, a number, a string or a rune")

segmentAt : {a : Type} -> Params.Spanned a -> a
segmentAt (At x _) = x

-- | a segment of a binary pattern (`last`: the last one)
patSegmentWith : Lw
               -> Bool
               -> Params.Span
               -> CST.Pat
               -> Spec
               -> P (Params.Spanned (Presyntax.Segment Presyntax.Pat))
patSegmentWith r last sp p s = do
  u <- valueChecked sp (segmentValue p)
  p' <- r.pat p
  seg <- segmentOf True sp p' (valueOfP p') s
  if not last && takesRest (segmentAt seg)
    then throwP
        (diag
           sp
           "only the last segment takes what is left: say this one's size, `x::binary-size(n)`, `x::bits-size(n)`")
    else pure seg

patSegmentL : Lw
            -> Bool
            -> CST.Pat
            -> P (Params.Spanned (Presyntax.Segment Presyntax.Pat))
patSegmentL r last (PSeg p cc spec) = do
  s <- specOf cc spec
  patSegmentWith
      r
      last
      (spanTE (CST.firstP p) (CST.lastP (PSeg p cc spec)).end)
      p
      s
patSegmentL r last p =
  patSegmentWith r last (spanTE (CST.firstP p) (CST.lastP p).end) p emptySpec

patSegmentsL : Lw
             -> List CST.Pat
             -> P (List (Params.Spanned (Presyntax.Segment Presyntax.Pat)))
patSegmentsL r Nil = pure Nil
patSegmentsL r (Cons p rest) = do
  x <- patSegmentL r (List.null rest) p
  xs <- patSegmentsL r rest
  pure (Cons x xs)

-- | an argument: `(x := e)` names the parameter it is for
argL : Lw -> CST.E -> P Presyntax.Expr
argL r (Named o x k e c) = do
  e' <- r.e e
  pure (At (ENamed x.text e') (spanTT o c))
argL r e = r.e e

-- | a name, a variable or a definition: one of the `mutual` block being
-- | lowered, not shadowed, is its field of the block's knot (the knot is
-- | no name written: its span is wider than its name, so that the tools
-- | show the field, not it)
varAtom : CST.T -> List CST.T -> P Presyntax.Expr
varAtom t fs = do
  local <- pGets (\s -> List.elemBy strEq t.text s.scope)
  knot <- pGets (\s -> Map.lookup s.knot t.text)
  pure (case knot of
    Just k ->
      if local then withFields (atomTok t) fs
      else withFields
          (At (EVar k) (mkSpan t.start (t.start + strLength k + 2)))
          (Cons t fs)
    Nothing -> withFields (atomTok t) fs)

-- | an expression
exprL : Lw -> CST.E -> P Presyntax.Expr
exprL r (Atom t) =
  if strEq t.kind "con" then conAtom t Nil
  else if strEq t.kind "var" then varAtom t Nil
  else pure (atomTok t)
exprL r (EField e f) = case fieldsOf (EField e f) Nil of
  MkFields (Atom t) fs ->
    if strEq t.kind "con" then conAtom t fs
    else if strEq t.kind "kw" then kwAtom t fs
    else if strEq t.kind "var" then varAtom t fs
    else pure (withFields (atomTok t) fs)
  MkFields b fs -> do
    b' <- r.e b
    pure (withFields b' fs)
exprL r (ENeg m e) = do
  e' <- r.e e
  pure (Presyntax.app (At (EVar "neg") (spanT m)) [e'])
exprL r (EParen o e c) = parenL r o e c
exprL r (Named o x k e c) = do
  e' <- r.e e
  pure
      (At
         (EInvalid
            ("`("
             ^ x.text
             ^ " := ...)` names an argument, after a function: `f ("
             ^ x.text
             ^ " := e)`"))
         (spanTT o c))
exprL r (Tup o es commas c) =
  if strEq o.text "b["
  then do
    segs <- traverseS (\m -> segmentL r m) es
    pure (At (EBinary segs) (spanTT o c))
  else if strEq o.text "["
  then do
    es' <- traverseS r.e es
    pure (listE (spanTT o c) es')
  else do
    es' <- traverseS r.e es
    pure
        (At
           (EInvalid
              "heff has no tuples: a record holds values together, `{ x = a, y = b }`")
           (spanTT o c))
exprL r (Braces o fs commas c) = bracesL r o fs c
exprL r (Update o rec bar fs commas c) = do
  rec' <- r.e rec
  fs' <- traverseS (\m -> updateSettingL r m) fs
  pure (At (EUpdate rec' fs') (spanTT o c))
exprL r (InstB o o2 d c1 c) = do
  d' <- declarationL r d
  pure
      (At
         (EInvalid
            "an instance argument is bound before `->`: `{{x : T}} -> ...`")
         (spanTT o c))
exprL r (Sum kw o alts bars c) = do
  alts' <- traverseS (\a -> variantL r a) alts
  pure (At (ESum alts') (spanTT kw c))
exprL r (ECon c args) = conL r c args
exprL r (App h args) = do
  h' <- r.e h
  args' <- traverseS (\m -> argL r m) args
  pure (Presyntax.app h' args')
exprL r (Op a op b) = opL r a op b
exprL r (Ops a rest) = do
  a' <- r.e a
  rest' <- traverseS (\m -> operandL r m) rest
  resolve applyOp a' rest'
exprL r (Ann e cc ty) = do
  e' <- r.e e
  ty' <- r.e ty
  pure (Presyntax.ann e' ty')
exprL r (Lam bs binders arrow body) = lambdaL r binders body
exprL r e0@(Case kw scrut o alts) = do
  scrut' <- r.e scrut
  alts' <- block (\a -> altL r a) alts
  pure (At (EMatch scrut' alts') (spanTE kw (CST.lastE e0).end))
exprL r (If kw (ELetCond lk p eq e) th a el b) =
  ifLetL r (spanTE kw (CST.lastE b).end) p e a (Just b)
exprL r (IfThen kw (ELetCond lk p eq e) th a) =
  ifLetL r (spanTE kw (CST.lastE a).end) p e a Nothing
exprL r e0@(ETry kw ty body c) = do
  ty' <- tryTypeL r ty
  body' <- block (\m -> stmtL r m) body
  c' <- catchL r c
  pure (At (ETry (MkTry ty' body' c')) (spanTE kw (CST.lastE e0).end))
exprL r (If kw c th a el b) = do
  c' <- r.e c
  a' <- r.e a
  b' <- r.e b
  pure (ifE (spanTE kw (CST.lastE b).end) c' a' b')
exprL r e0@(Do kw stmts) = do
  stmts' <- block (\m -> stmtL r m) stmts
  pure (At (EDo stmts') (spanTE kw (CST.lastE e0).end))
exprL r e0@(ELet kw p ann0 eq e body) = letL r e0
exprL r (EAssign x k e) = do
  e' <- r.e e
  pure (At (EAssign x.text (spanT x) e') (spanTE x (CST.lastE e).end))
exprL r e0@(EWhile kw c d body) = do
  c' <- r.e c
  body' <- block (\m -> stmtL r m) body
  pure (At (EWhile c' body') (spanTE kw (CST.lastE e0).end))
exprL r e0@(EFor kw p i c d body) = do
  c' <- r.e c
  p' <- r.pat p
  body' <- withScope (boundBy Nil p) (block (\m -> stmtL r m) body)
  pure (At (EFor p' c' body') (spanTE kw (CST.lastE e0).end))
exprL r (EJump kw) =
  pure (At (if strEq kw.text "break" then EBreak else EContinue) (spanT kw))
exprL r (EReturn kw e) = do
  e' <- r.e e
  pure (At (EReturn e') (spanTE kw (CST.lastE e).end))
exprL r (ENest o arrow e c) = do
  e' <- r.e e
  pure (At (ENest e') (spanTT o c))
exprL r (IfThen kw c th a) = do
  c' <- r.e c
  a' <- r.e a
  pure (At (EIfThen c' a') (spanTE kw (CST.lastE a).end))
exprL r e0 =
  throwP
    (diag (spanT (CST.firstE e0)) ("unexpected `" ^ (CST.firstE e0).text ^ "`"))

-- Patterns

-- | `p op q op' r`: the first, and each operator with what follows it
data PChain = MkPChain CST.Pat (List (Pair CST.T CST.Pat))

pchainCons : CST.Pat -> CST.T -> PChain -> PChain
pchainCons l op (MkPChain rh rest) = MkPChain l (Cons (MkPair op rh) rest)

pchainOf : CST.Pat -> PChain
pchainOf (POp l op r) = pchainCons l op (pchainOf r)
pchainOf p = MkPChain p Nil

patOperandL : Lw -> Pair CST.T CST.Pat -> P (Operand Presyntax.Pat)
patOperandL r (MkPair op p) = do
  p' <- r.pat p
  pure (mkOperand op p')

fieldPatL : Lw -> CST.Pat -> P (Presyntax.FieldPat Presyntax.Pat)
fieldPatL r (PField x eq p) = do
  p' <- r.pat p
  pure (MkFieldPat x.text p')
fieldPatL r p =
  throwP
    (diag (spanT (CST.firstP p)) ("unexpected `" ^ (CST.firstP p).text ^ "`"))

-- | a pattern: an operator in it is another name for a tag (elaboration
-- | finds which), its operands as the fixities say
patL : Lw -> CST.Pat -> P Presyntax.Pat
patL r (PAtom t) =
  if strEq t.kind "con"
  then do
    -- (a capitalised parameter of the signature is a variable)
    isVar <- pGets (\s -> List.elemBy strEq t.text s.patVars)
    pure
        (if isVar then At (PatVar t.text) (spanT t)
         else Presyntax.patTag t.text (spanT t) Nil)
  else pure (patTok t)
patL r (PCon c args) = do
  args' <- traverseS r.pat args
  pure (Presyntax.patTag c.text (spanT c) args')
patL r (PParen o p c) = r.pat p
patL r (PList o ps commas c) =
  if strEq o.text "b["
  then do
    segs <- patSegmentsL r ps
    pure (At (PatBinary segs) (spanTT o c))
  else do
    ps' <- traverseS r.pat ps
    pure (listP (spanTT o c) ps')
patL r (PRec o fs commas c) = do
  fs' <- traverseS (\f -> fieldPatL r f) fs
  pure (At (PatRecord fs') (spanTT o c))
patL r (POp l op q) = case pchainOf (POp l op q) of
  MkPChain h rest -> do
    h' <- r.pat h
    rest' <- traverseS (\m -> patOperandL r m) rest
    resolve applyPatOp h' rest'
patL r (PField x eq p) = r.pat p
patL r (PSeg p cc spec) = throwP (diag (spanT cc) "unexpected `::`")
patL r (PAs x at p) = do
  p' <- r.pat p
  pure (At (PatAs x.text (spanT x) p') (spanTT x (CST.lastP p)))

-- Declarations

-- | what a signature or an equation defines: `f`, `C`, or `(+)`
type DeclName = { name : String, span : Params.Span }

declNameOf : List CST.T -> DeclName
declNameOf (Cons t (Cons op (Cons c Nil))) = { name = op.text, span = spanT op }
declNameOf (Cons t rest) = { name = t.text, span = spanT t }
declNameOf Nil = { name = "", span = mkSpan 0 0 }

firstStart : List CST.T -> Int
firstStart (Cons t _) = t.start
firstStart Nil = 0

bindersFor : St -> String -> List Binders
bindersFor s f = fromMaybe Nil (Map.lookup s.binders f)

-- | `b` the binders of the signature last read of its name
addBinders : Binders -> St -> St
addBinders b s =
  setBinders
    (Map.insert s.binders b.f (Cons b (bindersFor s b.f)))
    s

-- | a signature, of a definition or an instance (`declared`); `start`,
-- | where it starts -- an instance's, at `instance`
sigL : Lw -> Presyntax.Declared -> Int -> List CST.T -> CST.E -> P (List Item)
sigL r declared start names ty = do
  ty' <- r.e ty
  pModify
      (\s ->
         addBinders
           (mkBinders (declNameOf names).name (piBinders ty') (piImplicits ty'))
           s)
  pure
      (Cons
         (Sig
            declared
            (declNameOf names).name
            (declNameOf names).span
            ty'
            (mkSpan start (CST.lastE ty).end))
         Nil)

lastDEnd : List CST.D -> Int -> Int
lastDEnd ds e = case List.last ds of
  Just d -> (CST.lastD d).end
  Nothing -> e

-- | `e where` and the local definitions, signatures and equations, as at
-- | the top level
whereL : Lw -> CST.T -> List CST.D -> Presyntax.Expr -> P Presyntax.Expr
whereL r kw ds rhs = do
  saved <- pGets (\s -> s.binders)
  items <- block r.decl ds
  pModify (\s -> setBinders saved s)
  at <- pGets (\s -> s.at)
  case appendS
      (twiceDiags at (concatMapS (\x -> x) items))
      (assembleDiags Nil (concatMapS (\x -> x) items)) of
    Cons d _ -> throwP d
    Nil ->
      pure
        (At
           (ELocal rhs (assemble Nil (concatMapS (\x -> x) items)))
           (mkSpan (Params.spanOf rhs).start (lastDEnd ds kw.end)))

-- | `f p ... = e`, perhaps followed by `where`
eqnL : Lw
     -> List CST.T
     -> List CST.Pat
     -> CST.E
     -> Maybe (Pair CST.T (List CST.D))
     -> P (List Item)
eqnL r names pats rhs w = do
  sig <- pGets (\s -> bindersFor s (declNameOf names).name)
  pModify (\s -> setPatVars (concatMapS (\(b : Binders) -> b.names) sig) s)
  pats' <- traverseS r.pat pats
  pModify (\s -> setPatVars Nil s)
  -- (an implicit parameter is not written, but bound all the same, by
  -- the name the signature gives it)
  withScope
      (appendS
         (concatMapS
            (boundBy (concatMapS (\(b : Binders) -> b.names) sig))
            pats)
         (concatMapS (\(b : Binders) -> b.implicits) sig)) (do
    rhs0 <- r.e rhs
    rhs' <- case w of
      Just (MkPair kw ds) -> whereL r kw ds rhs0
      Nothing -> pure rhs0
    pure
        (Cons
           (Eqn
              (declNameOf names).name
              (At
                 (MkEquation
                    (declNameOf names).name
                    (declNameOf names).span
                    pats'
                    rhs')
                 (mkSpan (firstStart names) (Params.spanOf rhs').end))
              (mkSpan (firstStart names) (Params.spanOf rhs').end))
           Nil))

-- | `x : T`, `x` a name: the name, where it is, the type
type NameAnn = { name : String, span : Params.Span, ty : Presyntax.Expr }

nameAnn : Presyntax.Expr -> Maybe NameAnn
nameAnn (At (EAnn (At (EVar x) xsp) t) _) =
  Just { name = x, span = xsp, ty = t }
nameAnn _ = Nothing

paramOf : Presyntax.Expr -> P (Params.Spanned (Presyntax.Param Presyntax.Expr))
paramOf p = case nameAnn p of
  Just q ->
    pure
      (At
         (ExplicitParam q.name q.span q.ty)
         (Presyntax.spanning q.span (Params.spanOf q.ty)))
  Nothing ->
    throwP (diag (Params.spanOf p) "a parameter is `a`, `(x : T)` or `{x : T}`")

-- | `(x : T)` or `{x : T}`, a parameter of a type
dataParamOf : Lw -> CST.E -> P (Params.Spanned (Presyntax.Param Presyntax.Expr))
dataParamOf r e = case bracedOne e of
  Just f -> do
    d <- declarationL r f
    case nameAnn d of
      Just q ->
        pure
          (At
             (ImplicitParam q.name q.span q.ty)
             (spanTT (CST.firstE e) (CST.lastE e)))
      Nothing ->
        throwP
          (diag (Params.spanOf d) "a parameter is `a`, `(x : T)` or `{x : T}`")
  Nothing -> do
    p0 <- r.e e
    p <- if strEq (CST.firstE e).text "(" then asBinder p0 else pure p0
    paramOf p

-- | a parameter of a type: `a` (a type), `(x : T)` or `{x : T}`
dataParamL : Lw -> CST.E -> P (Params.Spanned (Presyntax.Param Presyntax.Expr))
dataParamL r e = case atomOf e of
  Just x ->
    pure
      (At
         (ExplicitParam x.text (spanT x) (At (EWord TypeWord) (spanT x)))
         (spanT x))
  Nothing -> dataParamOf r e

-- | `data T a = C x y | D`, and `data T : U = ...`
dataL : Lw
      -> CST.D
      -> CST.T
      -> CST.T
      -> List CST.E
      -> Maybe (Pair CST.T CST.E)
      -> Maybe CST.DAlts
      -> P (List Item)
dataL r d kw name params universe alts = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    universe' <- case universe of
      Just (MkPair cc u) -> r.e u
      Nothing -> pure (At (EWord TypeWord) (spanT name))
    alts' <- traverseS (\a -> variantL r a) (CST.altsOf alts)
    pure
        (Cons
           (Whole
              (At
                 (DeclDefine
                    name.text
                    (spanT name)
                    params'
                    universe'
                    (At (ESum alts') (spanTE kw (CST.lastD d).end)))
                 (spanTE kw (CST.lastD d).end)))
           Nil))

-- | `type T a = ...`
typeL : Lw -> CST.T -> CST.T -> List CST.E -> CST.E -> P (List Item)
typeL r kw name params body = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    body' <- r.e body
    pure
        (Cons
           (Whole
              (At
                 (DeclDefine
                    name.text
                    (spanT name)
                    params'
                    (At (EWord TypeWord) (spanTE kw (CST.lastE body).end))
                    body')
                 (spanTE kw (CST.lastE body).end)))
           Nil))

-- (a theory's field's default, if it has one)
defaultL : Lw -> Maybe (Pair CST.T CST.E) -> P (Maybe Presyntax.Expr)
defaultL r Nothing = pure Nothing
defaultL r (Just (MkPair eq d)) = do
  d' <- r.e d
  pure (Just d')

-- | a field of a theory, and its default: in scope in the fields after
-- | it (not in its default)
theoryFieldL : Lw
             -> CST.TF
             -> P
               (Params.Spanned
                  (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr))
theoryFieldL r (MkTF x cc ty d) = do
  ty' <- r.e ty
  d' <- defaultL r d
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (At
         (DeclareField x.text (spanT x) ty' d')
         (Presyntax.spanning (spanT x) (Params.spanOf (fromMaybe ty' d'))))

-- | `theory T a where` and its fields
theoryL : Lw
        -> CST.D
        -> CST.T
        -> CST.T
        -> List CST.E
        -> List CST.TF
        -> P (List Item)
theoryL r d kw name params fields = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    fields' <- block (\f -> theoryFieldL r f) fields
    pure
        (Cons
           (Whole
              (At
                 (DeclTheory
                    name.text
                    (spanT name)
                    params'
                    (At (ESig fields') (spanTE kw (CST.lastD d).end)))
                 (spanTE kw (CST.lastD d).end)))
           Nil))

-- | `primitive x : T`
primitiveL : Lw -> CST.T -> CST.T -> CST.E -> P (List Item)
primitiveL r kw x ty = do
  ty' <- r.e ty
  pure
      (Cons
         (Whole
            (At
               (DeclPrimitive x.text (spanT x) ty')
               (spanTE kw (CST.lastE ty).end)))
         Nil)

-- (a watch is a declaration whole; a doc test waits for its definition)
watchItem : CST.T -> Presyntax.Decl -> Item
watchItem w d = if strEq w.kind "doctest" then Doc d else Whole d

-- Mutual definitions, knotted through a record
--------------------------------------------------------------------------------

-- A `mutual` block's definitions, `f1 : T1` ... `fn : Tn`, are the
-- fields of a record type made for them, and each is defined as its
-- field of a record built once, the knot, whose fields call the bodies,
-- each given the knot as one more argument, first: in a body, a name of
-- the block is its field of the knot given.  The knot's fields are
-- lambdas, so the knot is built before any body runs (a definition whose
-- type is no function's, so that its field's lambda is refused, is said
-- by the elaborator to take no argument), and a body is checked as any
-- definition's, its equations as written.
--
--   type M = { f1 : T1, ..., fn : Tn }    -- M, k, f1' ... fn' unspeakable
--   f1' : M -> T1
--   f1' k p ... = e                       -- f1 ... fn in e are k.f1 ... k.fn
--   k : M
--   k = { f1 = \x -> f1' k x, ... }
--   f1 : T1
--   f1 = k.f1
--
-- The names made are of the first definition's, `Mutual#f1`,
-- `mutual#f1`, and of each definition's, `fi#mutual`: the same wherever
-- the block is, and no name a text writes (the presyntax makes them, and
-- says them as the text has them where one is shown).

-- | the name of the block's first definition, the block's names made of
firstSig : List CST.D -> Maybe String
firstSig Nil = Nothing
firstSig (Cons (DSig names cc ty) rest) = Just (declNameOf names).name
firstSig (Cons _ rest) = firstSig rest

-- | a definition of a `mutual` block, its signature met with its
-- | equations: the name, where it is, its type, its equations, and its
-- | span, from the signature to the last equation
type MutualDef =
  { name : String
  , span : Params.Span
  , ty : Presyntax.Expr
  , eqns : List (Params.Spanned (Presyntax.Equation Presyntax.Expr))
  , whole : Params.Span
  }

-- | the block's definitions, in order (its items hold together: checked
-- | before); a watch among them is kept where it is
mutualDefs : List Item -> List (Either Item MutualDef)
mutualDefs Nil = Nil
mutualDefs (Cons (Sig _ f fsp ty sp) rest) = case eqnsUnder f rest of
  Just es ->
    Cons
      (Right
         { name = f
         , span = fsp
         , ty = ty
         , eqns = es.eqns
         , whole = mkSpan sp.start (maxI sp.end es.end)
         })
      (mutualDefs rest)
  Nothing -> mutualDefs rest
mutualDefs (Cons (Eqn _ _ _) rest) = mutualDefs rest
mutualDefs (Cons it rest) = Cons (Left it) (mutualDefs rest)

-- | the equation of `f` whose patterns are not `n`, as its first's are
unevenAt : String
         -> Int
         -> List (Params.Spanned (Presyntax.Equation Presyntax.Expr))
         -> Maybe Diag
unevenAt f n Nil = Nothing
unevenAt f n (Cons (At (MkEquation _ _ pats _) sp) rest) =
  if List.length pats == n then unevenAt f n rest
  else Just
      (diag
         sp
         ("every equation of `"
          ^ f
          ^ "` has "
          ^ show n
          ^ " pattern(s), as its first: this one has "
          ^ show (List.length pats)))

-- (equations that differ in their patterns: refused as written, before
-- the knot is each one's first pattern)
unevenDiag : Either Item MutualDef -> Maybe Diag
unevenDiag (Right d) = case d.eqns of
  Nil -> Nothing
  Cons (At (MkEquation _ _ pats _) _) rest ->
    unevenAt d.name (List.length pats) rest
unevenDiag (Left _) = Nothing

-- | the field of the record type a definition is
mutualField : MutualDef
            -> Params.Spanned
              (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr)
mutualField d = At (DeclareField d.name d.span d.ty Nothing) d.whole

-- (the equation, the knot its first pattern, of the body `f'`)
knotEqn : String
        -> String
        -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
        -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
knotEqn k f' (At (MkEquation _ fsp pats body) sp) =
  At (MkEquation f' fsp (Cons (At (PatVar k) fsp) pats) body) sp

-- | the body of a definition, `f' : M -> T`, given the knot `k` first
mutualBody : Presyntax.Expr -> String -> MutualDef -> Item
mutualBody tyE k d =
  Whole
    (At
       (DeclEquations
          (Presyntax.bodyName d.name)
          d.span
          AsDefinition
          (At (EPi (PiAnon tyE) d.ty) (Params.spanOf d.ty))
          (List.map (\e -> knotEqn k (Presyntax.bodyName d.name) e) d.eqns))
       d.whole)

-- | a field of the knot: `f = \x -> f' k x`
knotField : String
          -> MutualDef
          -> Params.Spanned (Presyntax.FieldSet Presyntax.Expr)
knotField k d =
  At
    (SetField
       d.name
       d.span
       (At
          (ELam
             (LamName (Presyntax.argName d.name) d.span)
             (Presyntax.app
                (At (EVar (Presyntax.bodyName d.name)) d.span)
                [ At (EVar k) d.span
                , At (EVar (Presyntax.argName d.name)) d.span
                ]))
          d.span))
    d.span

-- | the knot, `k : M`, its fields calling the bodies
mutualKnot : Presyntax.Expr -> String -> Params.Span -> List MutualDef -> Item
mutualKnot tyE k bsp defs =
  Whole
    (At
       (DeclEquations
          k
          bsp
          AsDefinition
          tyE
          [ At
            (MkEquation
               k
               bsp
               Nil
               (At (EStruct (List.map (knotField k) defs)) bsp))
            bsp
          ])
       bsp)

-- | the definition as the module has it, `f : T`, `f = k.f`; a watch as
-- | it is
mutualPublic : String -> Either Item MutualDef -> List Item
mutualPublic k (Left it) = Cons it Nil
mutualPublic k (Right d) =
  [ Sig AsDefinition d.name d.span d.ty d.whole
  , Eqn
    d.name
    (At
       (MkEquation
          d.name
          d.span
          Nil
          (Presyntax.app (At (EVar k) d.span) [At (EProject d.name) d.span]))
       d.whole)
    d.whole
  ]

rightsOf : {a b : Type} -> List (Either a b) -> List b
rightsOf Nil = Nil
rightsOf (Cons (Right x) rest) = Cons x (rightsOf rest)
rightsOf (Cons (Left _) rest) = rightsOf rest

-- | the names a `mutual` block defines, each to its knot
knotOf : String -> List CST.D -> Map.Map String String
knotOf k Nil = Map.empty
knotOf k (Cons (DSig names cc ty) rest) =
  Map.insert (knotOf k rest) (declNameOf names).name k
knotOf k (Cons _ rest) = knotOf k rest

-- | the items of a `mutual` block, lowered with its names knotted
mutualItems : Lw -> String -> List CST.D -> P (List Item)
mutualItems r k ds = do
  pModify (\s -> setKnot (knotOf k ds) s)
  items <- block r.decl ds
  pModify (\s -> setKnot Map.empty s)
  at <- pGets (\s -> s.at)
  case appendS
      (twiceDiags at (concatMapS (\x -> x) items))
      (assembleDiags Nil (concatMapS (\x -> x) items)) of
    Cons d _ -> throwP d
    Nil -> pure (concatMapS (\x -> x) items)

-- | the block's items: the record type `m`, the bodies, the knot `k`,
-- | then the definitions as the module has them (`ksp`: the keyword;
-- | `bsp`: the block)
mutualOut : Params.Span
          -> Params.Span
          -> String
          -> String
          -> List (Either Item MutualDef)
          -> List Item
mutualOut ksp bsp m k defs =
  Cons
    (Whole
       (At
          (DeclDefine
             m
             ksp
             Nil
             (At (EWord TypeWord) ksp)
             (At (ESig (List.map mutualField (rightsOf defs))) bsp))
          bsp))
    (appendS
       (List.map (mutualBody (At (EVar m) ksp) k) (rightsOf defs))
       (Cons
          (mutualKnot (At (EVar m) ksp) k bsp (rightsOf defs))
          (concatMapS (mutualPublic k) defs)))

-- | `mutual` and its definitions
mutualL : Lw -> CST.T -> List CST.D -> P (List Item)
mutualL r kw ds = case firstSig ds of
  Nothing ->
    throwP
      (diag
         (spanT kw)
         "a `mutual` block holds definitions, each a signature and its equations")
  Just f1 -> do
    items <- mutualItems r (Presyntax.knotName f1) ds
    case catMaybesS (List.map unevenDiag (mutualDefs items)) of
      Cons d _ -> throwP d
      Nil ->
        pure
          (mutualOut
             (spanT kw)
             (spanTE kw (lastDEnd ds kw.end))
             (Presyntax.knotType f1)
             (Presyntax.knotName f1)
             (mutualDefs items))

-- | a declaration, lowered: what it is before signatures meet equations
declL : Lw -> CST.D -> P (List Item)
declL r (DImport t) = pure Nil
-- (read before the rest, by `fixityDecls`)
declL r (DFixity kw ts) = pure Nil
declL r (DSig names cc ty) = sigL r AsDefinition (firstStart names) names ty
declL r (DInstance kw names cc ty) = sigL r AsInstance kw.start names ty
declL r (DEqn names pats eq rhs w) = eqnL r names pats rhs w
declL r d@(DData kw name params universe alts) =
  dataL r d kw name params universe alts
declL r (DType kw name params eq body) = typeL r kw name params body
declL r d@(DTheory kw name params w fields) = theoryL r d kw name params fields
declL r (DMutual kw ds) = mutualL r kw ds
declL r (DPrimitive kw x cc ty) = primitiveL r kw x ty
declL r (DTest kw x) =
  pure (Cons (Whole (At (DeclTest x.text (spanT x)) (spanTT kw x))) Nil)
declL r (DWatch w e) = do
  e' <- r.e e
  pure (Cons (watchItem w (At (DeclWatch e') (spanTE w (CST.lastE e).end))) Nil)

lw : Lw
lw =
  { e = \e st -> exprL lw e st
  , pat = \p st -> patL lw p st
  , decl = \d st -> declL lw d st
  }

-- The program
--------------------------------------------------------------------------------

-- | the names a file defines (so that a capitalised one is not a tag)
-- (`inMutual`: under `mutual`, where a signature is indented)
prescanGo : Array Lex.Tok -> Int -> Bool -> List String -> List String
prescanGo ts k inMutual acc = case Array.index ts k of
  Nothing -> List.reverse acc
  Just t -> case Array.index ts (k + 1) of
    Nothing -> prescanGo ts (k + 1) inMutual acc
    Just u ->
      if t.first && t.col == 0 && strEq t.kind "kw" && strEq t.text "mutual"
      then prescanGo ts (k + 1) True acc
      else if t.first
              && t.col == 0
              && strEq t.kind "kw"
              && List.elemBy strEq t.text ["data", "type", "theory", "instance"]
      then prescanGo ts (k + 1) False (Cons u.text acc)
      else if t.first
              && (t.col == 0 || inMutual)
              && (strEq t.kind "var" || strEq t.kind "con")
              && strEq u.kind "sym"
              && isAnnText u.text
      then prescanGo ts (k + 1) (inMutual && t.col > 0) (Cons t.text acc)
      else prescanGo
          ts
          (k + 1)
          (inMutual && not (t.first && t.col == 0))
          acc

prescan : Array Lex.Tok -> List String
prescan ts = prescanGo ts 0 False Nil

-- Fixity declarations, read before the rest
--------------------------------------------------------------------------------

type FixDecl =
  { assoc : Fixity.Assoc
  , ops : List Lex.Tok
  , above : List Lex.Tok
  , below : List Lex.Tok
  , loosest : Bool
  , errors : List Diag
  , span : Params.Span
  , line : Int
  }

restOfDecl : Array Lex.Tok -> Int -> List Lex.Tok -> List Lex.Tok
restOfDecl ts j acc = case Array.index ts j of
  Nothing -> List.reverse acc
  Just t ->
    if strEq t.kind "eof" || (t.first && t.col == 0) then List.reverse acc
    else restOfDecl ts (j + 1) (Cons t acc)

takeSyms : List Lex.Tok -> List Lex.Tok
takeSyms Nil = Nil
takeSyms (Cons u rest) =
  if strEq u.kind "sym" then Cons u (takeSyms rest) else Nil

dropN : {a : Type} -> Int -> List a -> List a
dropN n Nil = Nil
dropN n (Cons x rest) = if n <= 0 then Cons x rest else dropN (n - 1) rest

type AB =
  { above : List Lex.Tok
  , below : List Lex.Tok
  , loosest : Bool
  , errors : List Diag
  }

-- (`above` and the operators it is above, which it names)
abAbove : AB -> Lex.Tok -> List Lex.Tok -> AB
abAbove acc w Nil =
  { above = acc.above
  , below = acc.below
  , loosest = acc.loosest
  , errors =
      Cons
        (diag
           (spanOf w)
           "`above` names the operators it is above (`below` alone is below all)")
        acc.errors
  }
abAbove acc w ops =
  { above = appendS acc.above ops
  , below = acc.below
  , loosest = acc.loosest
  , errors = acc.errors
  }

-- (`below` and the operators it is below; alone, below all)
abBelow : AB -> List Lex.Tok -> AB
abBelow acc Nil =
  { above = acc.above, below = acc.below, loosest = True, errors = acc.errors }
abBelow acc ops =
  { above = acc.above
  , below = appendS acc.below ops
  , loosest = acc.loosest
  , errors = acc.errors
  }

abGo : AB -> List Lex.Tok -> AB
abGo acc Nil = acc
abGo acc (Cons w tail) =
  if strEq w.kind "var" && strEq w.text "above"
  then abGo
      (abAbove acc w (takeSyms tail))
      (dropN (List.length (takeSyms tail)) tail)
  else if strEq w.kind "var" && strEq w.text "below"
  then abGo
      (abBelow acc (takeSyms tail))
      (dropN (List.length (takeSyms tail)) tail)
  else { above = acc.above
       , below = acc.below
       , loosest = acc.loosest
       , errors =
           Cons
             (diag
                (spanOf w)
                ("expected `above` or `below` and operators, not `"
                 ^ w.text
                 ^ "`"))
             acc.errors
       }

assocOf : String -> Fixity.Assoc
assocOf "infixl" = AssocLeft
assocOf "infixr" = AssocRight
assocOf s = AssocNone

lastEnd : Lex.Tok -> List Lex.Tok -> Int
lastEnd t Nil = t.end
lastEnd t (Cons u Nil) = u.end
lastEnd t (Cons u rest) = lastEnd t rest

fixDeclDone : Lex.Tok -> List Lex.Tok -> List Lex.Tok -> AB -> FixDecl
fixDeclDone t rest ops r =
  { assoc = assocOf t.text
  , ops = ops
  , above = r.above
  , below = r.below
  , loosest = r.loosest
  , errors = List.reverse r.errors
  , span = mkSpan t.start (lastEnd t rest)
  , line = t.line
  }

fixDeclParts : Lex.Tok -> List Lex.Tok -> FixDecl
fixDeclParts t rest =
  fixDeclDone
    t
    rest
    (takeSyms rest)
    (abGo
       { above = Nil, below = Nil, loosest = False, errors = Nil }
       (dropN (List.length (takeSyms rest)) rest))

fixDeclOf : Array Lex.Tok -> Int -> Lex.Tok -> FixDecl
fixDeclOf ts k t = fixDeclParts t (restOfDecl ts (k + 1) Nil)

fixDeclAt : Array Lex.Tok -> Int -> Lex.Tok -> Maybe FixDecl
fixDeclAt ts k t =
  if t.first
     && t.col == 0
     && strEq t.kind "kw"
     && List.elemBy strEq t.text ["infixl", "infixr", "infix"]
  then Just (fixDeclOf ts k t)
  else Nothing

fixDecls : Array Lex.Tok -> Int -> List FixDecl -> List FixDecl
fixDecls ts k acc = case Array.index ts k of
  Nothing -> List.reverse acc
  Just t -> case fixDeclAt ts k t of
    Just d -> fixDecls ts (k + 1) (Cons d acc)
    Nothing -> fixDecls ts (k + 1) acc

-- (where a declaration is, said: the file's place and its line; not
-- known, nothing)
placeOfLine : String -> Int -> String
placeOfLine "" line = ""
placeOfLine place line = place ^ ":" ^ show (line + 1)

groupOfDecl : String -> FixDecl -> Maybe Fixity.Group
groupOfDecl place { ops = Nil } = Nothing
groupOfDecl place d@{ ops = Cons op rest } =
  Just
    { id = op.text
    , assoc = d.assoc
    , ops = List.map (\(u : Lex.Tok) -> u.text) d.ops
    , loosest = d.loosest
    , at = placeOfLine place d.line
    }

mapMaybeG : {a : Type} -> (Fixity.Group -> a) -> Maybe Fixity.Group -> Maybe a
mapMaybeG f Nothing = Nothing
mapMaybeG f (Just g) = Just (f g)

mkEdge : String -> String -> Fixity.Edge
mkEdge t l = { tighter = t, looser = l }

edgesOf : Fixity.Fixities -> FixDecl -> List Fixity.Edge
edgesOf scope { ops = Nil } = Nil
edgesOf scope d@{ ops = Cons op rest } =
  appendS
    (catMaybesS
       (List.map
          (\(r : Lex.Tok) ->
             mapMaybeG
               (\g -> mkEdge op.text g.id)
               (Fixity.groupOf scope r.text))
          d.above))
    -- (nothing is below the loosest: that is an error, not an edge)
    (catMaybesS
       (List.map
          (\(r : Lex.Tok) ->
             mapMaybeG
               (\g -> mkEdge g.id op.text)
               (Fixity.groupOf scope r.text))
          (List.filter
             (\(r : Lex.Tok) ->
                not (Fixity.loosestOf (Fixity.groupOf scope r.text)))
             d.below)))

anyS : {a : Type} -> (a -> Bool) -> List a -> Bool
anyS p Nil = False
anyS p (Cons x xs) = p x || anyS p xs

anyGroupHas : Fixity.Fixities -> Lex.Tok -> Lex.Tok -> Bool
anyGroupHas all g u =
  anyS
    (\(h : Fixity.Group) ->
       not (strEq h.id g.text) && List.elemBy strEq u.text h.ops)
    all.groups

cycleDiag : Fixity.Fixities -> FixDecl -> List Diag
cycleDiag all { ops = Nil } = Nil
cycleDiag all d@{ ops = Cons g rest } =
  appendS
    (List.map
       (\(u : Lex.Tok) ->
          diag (spanOf u) ("the fixity of `" ^ u.text ^ "` is declared twice"))
       (List.filter (\(u : Lex.Tok) -> anyGroupHas all g u) d.ops))
    (if Fixity.bindsTighter all g.text g.text
     then Cons
         (diag
            d.span
            ("these fixities go round: `"
             ^ g.text
             ^ "` ends up above itself"))
         Nil
     else Nil)

-- (where a group is declared, said, in parentheses; not known, nothing)
declaredAt : String -> String
declaredAt "" = ""
declaredAt at = " (" ^ at ^ ")"

-- (`below` the loosest, `u`: what is declared below it, if it names it)
belowWhat : List Lex.Tok -> Lex.Tok -> String
belowWhat (Cons op _) u =
  "`"
  ^ op.text
  ^ "` cannot be declared below `"
  ^ u.text
  ^ "`: `"
  ^ u.text
  ^ "`"
belowWhat Nil u = "nothing can be declared below `" ^ u.text ^ "`: it"

belowLoosestDiag : FixDecl -> Lex.Tok -> Fixity.Group -> Diag
belowLoosestDiag d u g =
  diag
    (spanOf u)
    (belowWhat d.ops u
     ^ " is the loosest operator, below every other, declared `below` with nothing after it"
     ^ declaredAt g.at)

-- | an operator declared below one of a group below all: the bottom has
-- | nothing below it
belowLoosest : Fixity.Fixities -> FixDecl -> Lex.Tok -> Maybe Diag
belowLoosest scope d u =
  mapMaybeG (\g -> belowLoosestDiag d u g) (Fixity.loosestGroup scope u.text)

noGroup : Fixity.Fixities -> Lex.Tok -> Bool
noGroup scope u = case Fixity.groupOf scope u.text of
  Just _ -> False
  Nothing -> True

fixDiagsOf : Fixity.Fixities -> Fixity.Fixities -> FixDecl -> List Diag
fixDiagsOf scope all d =
  appendS
    (List.map
       (\(u : Lex.Tok) ->
          diag (spanOf u) ("`" ^ u.text ^ "` is syntax, not an operator"))
       (List.filter
          (\(u : Lex.Tok) -> List.elemBy strEq u.text Fixity.reserved)
          d.ops))
    (appendS
       (List.map
          (\(u : Lex.Tok) ->
             diag
               (spanOf u)
               ("`"
                ^ u.text
                ^ "` has no fixity to be above or below: declare it first"))
          (List.filter
             (\(u : Lex.Tok) -> noGroup scope u)
             (appendS d.above d.below)))
       (appendS
          (catMaybesS (List.map (\u -> belowLoosest scope d u) d.below))
          (appendS
             (if List.length d.ops == 0
              then Cons
                  (diag
                     d.span
                     "a fixity declaration names its operators: `infixl + -`")
                  Nil
              else Nil)
             (appendS d.errors (cycleDiag all d)))))

type FixRead = { fixities : Fixity.Fixities, diags : List Diag }

fixityOut : Fixity.Fixities
          -> List FixDecl
          -> List Fixity.Group
          -> List Fixity.Edge
          -> FixRead
fixityOut imported decls groups edges =
  { fixities = { groups = groups, above = edges }
  , diags =
      concatMapS
        (fixDiagsOf
           (Fixity.union imported { groups = groups, above = Nil })
           (Fixity.union imported { groups = groups, above = edges }))
        decls
  }

fixityDone : Fixity.Fixities -> List FixDecl -> List Fixity.Group -> FixRead
fixityDone imported decls groups =
  fixityOut
    imported
    decls
    groups
    (concatMapS
       (edgesOf (Fixity.union imported { groups = groups, above = Nil }))
       decls)

fixityFrom : String -> Fixity.Fixities -> List FixDecl -> FixRead
fixityFrom place imported decls =
  fixityDone
    imported
    decls
    (catMaybesS
       (List.map
          (\d -> groupOfDecl place d)
          (List.filter (\(d : FixDecl) -> not (List.length d.ops == 0)) decls)))

-- | the fixity declarations of a file, read before the rest (`place`: the
-- | file, said, `by prelude, at lib/prelude.hf`; else nothing)
fixityDecls : String -> Fixity.Fixities -> Array Lex.Tok -> FixRead
fixityDecls place imported ts = fixityFrom place imported (fixDecls ts 0 Nil)

-- | a text's own fixities, read without the rest of it
fixitiesOfText : Fixity.Fixities -> String -> Fixity.Fixities
fixitiesOfText imported src =
  (fixityDecls "" imported (Array.fromList (Lex.lex src).tokens)).fixities

-- The program loop
--------------------------------------------------------------------------------

type ProgRes = { items : List Item, diags : List Diag, broken : List String }

appendRev : {a : Type} -> List a -> List a -> List a
appendRev Nil acc = acc
appendRev (Cons x xs) acc = appendRev xs (Cons x acc)

brokenPlus : Maybe String -> List String -> List String
brokenPlus Nothing broken = broken
brokenPlus (Just x) broken = Cons x broken

mkProgRes : List Item -> List Diag -> List String -> ProgRes
mkProgRes items diags broken = { items = items, diags = diags, broken = broken }

-- | a declaration, lowered where nothing local is in scope
lowerDecl : CST.D -> St -> Pair (Either Diag (List Item)) St
lowerDecl d s = lw.decl d (setScope Nil s)

-- | each declaration read (`cs`), then lowered (`s`); one that is wrong
-- | is passed over, the name it would define broken
progGo : CST.St -> St -> List Item -> List Diag -> List String -> ProgRes
progGo cs s items diags broken =
  if CST.textDone cs
  then mkProgRes
      (List.reverse items)
      (List.reverse diags)
      (List.reverse broken)
  else case CST.declStep cs of
    MkPair (Left d) cs2 ->
      progGo
        (CST.skipDecl cs2)
        s
        items
        (Cons d diags)
        (brokenPlus (CST.declaredAt cs2) broken)
    MkPair (Right dc) cs2 -> case lowerDecl dc s of
      MkPair (Left d) s2 ->
        progGo
          (CST.skipDecl cs2)
          s2
          items
          (Cons d diags)
          (brokenPlus (CST.declaredAt cs2) broken)
      MkPair (Right ds) s2 ->
        if strEq (CST.cur cs2).kind "eof"
        then progGo cs2 s2 (appendRev ds items) diags broken
        else progGo
            (CST.skipDecl cs2)
            s2
            (appendRev ds items)
            (Cons
               (diag
                  (spanT (CST.cur cs2))
                  ("unexpected `" ^ (CST.cur cs2).text ^ "`"))
               diags)
            broken

-- Entry points
--------------------------------------------------------------------------------

-- | `place`: the file, said, `by prelude, at lib/prelude.hf` (where its
-- | fixities are declared, said with the line); `path`: the file's path,
-- | as a diagnostic names it (where a name is first defined, said)
type Options =
  { known : String -> Bool
  , fixities : Fixity.Fixities
  , lenient : Bool
  , place : String = ""
  , path : String = ""
  }

type Read =
  { decls : List Presyntax.Decl
  , diags : List Diag
  , fixities : Fixity.Fixities
  , broken : List String
  }

lexDiagOf : Lex.Err -> Diag
lexDiagOf e =
  { code = 150
  , severity = SError
  , msg = e.msg
  , span = { start = e.start, end = e.end }
  , note = Nothing
  }

-- | what is known: what the file imports, or `declared`, what it declares
knownOr : (String -> Bool) -> Map.Map String Unit -> String -> Bool
knownOr known declared x = known x || isIn declared x

-- (the line and column, each from 1, of `i`, on line `l`, which starts
-- at `start`; a column counts runes)
lineColFrom : String -> Int -> Int -> Int -> String
lineColFrom src i l start = case indexFrom "\n" src start of
  Just nl ->
    if nl < i then lineColFrom src i (l + 1) (nl + 1)
    else show l ^ ":" ^ show (RuneUtil.runesBetween src start i + 1)
  Nothing -> show l ^ ":" ^ show (RuneUtil.runesBetween src start i + 1)

-- | where the offset `i` of `src` is, said `path:line:col`
-- | >>> placeOfOffset "a.hf" "x\ny = 1\n" 4
-- | "a.hf:2:3"
placeOfOffset : String -> String -> Int -> String
placeOfOffset "" src i = lineColFrom src i 1 0
placeOfOffset path src i = path ^ ":" ^ lineColFrom src i 1 0

initialSt : Options
          -> (Int -> String)
          -> Array CST.T
          -> List String
          -> Fixity.Fixities
          -> St
initialSt o at toks declared own =
  mkSt
    toks
    Nil
    (knownOr o.known (nameSet declared))
    Map.empty
    Nil
    (Fixity.union o.fixities own)
    o.lenient
    at
    Map.empty

readPlaced : (Int -> String)
           -> List Diag
           -> FixRead
           -> ProgRes
           -> Placed
           -> Read
readPlaced at lexDiags own r placed =
  { decls = assemble r.broken (List.reverse placed.items)
  , diags =
      appendS
        lexDiags
        (appendS
           own.diags
           (appendS
              r.diags
              (appendS
                 (List.reverse placed.diags)
                 (appendS
                    (assembleDiags r.broken r.items)
                    (twiceDiags at r.items)))))
  , fixities = own.fixities
  , broken = r.broken
  }

readOut : (Int -> String) -> String -> List Diag -> FixRead -> ProgRes -> Read
readOut at src lexDiags own r =
  readPlaced at lexDiags own r (placeDocs src r.items)

readRun : String
        -> Options
        -> Array CST.T
        -> List Diag
        -> List String
        -> FixRead
        -> Read
readRun src o toks lexDiags declared own =
  readOut
    (placeOfOffset o.path src)
    src
    lexDiags
    own
    (progGo
       (CST.initialSt toks)
       (initialSt o (placeOfOffset o.path src) toks declared own.fixities)
       Nil
       Nil
       Nil)

readToks : String
         -> Options
         -> Array Lex.Tok
         -> Array CST.T
         -> List Diag
         -> Read
readToks src o ltoks toks lexDiags =
  readRun
    src
    o
    toks
    lexDiags
    (prescan ltoks)
    (fixityDecls o.place o.fixities ltoks)

readLexed : String -> Options -> Lex.Lexed -> Read
readLexed src o l =
  readToks
    src
    o
    (Array.fromList l.tokens)
    (Tokens.plain l.tokens)
    (List.map lexDiagOf l.errors)

-- | `fixities`: those of what the file imports; the result's, the file's
-- | own.  `broken`: the declarations that do not parse.
readProgramWith : Options -> String -> Read
readProgramWith o src = readLexed src o (Lex.lex src)

-- | the program, as declarations the elaborator takes
readProgram : (String -> Bool) -> String -> Read
readProgram known src =
  readProgramWith
    { known = known, fixities = Fixity.emptyFixities, lenient = False }
    src

-- | >>> List.length (readProgram noKnown "idInt : Int -> Int\nidInt x = x\n").decls
-- | 1
-- | >>> List.length (readProgram noKnown "data Color = Red | Green\n\nnext : Color -> Color\nnext c = case c of\n  Red -> Green\n  Green -> Red\n").decls
-- | 2
-- | >>> List.length (readProgram noKnown "x : Int\nx = ) oops\n").diags
-- | 1
noKnown : String -> Bool
noKnown x = False
