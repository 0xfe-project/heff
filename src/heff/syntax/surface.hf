-- The reader: text into presyntax.  The text is read once, by `heff.syntax.cst`
-- (the concrete syntax the formatter lays out too); here what it reads
-- is lowered into the presyntax the elaborator takes -- which names are
-- in scope (a capitalised one is a tag unless it is), how operators bind
-- (the fixities), the sugar taken apart, and signatures met with their
-- equations.  `P` is the lowering's monad -- state threaded, a diagnostic
-- thrown -- and this module's `bind` is its; the lowering's functions
-- call one another, so they are the fields of one record, `lw`.

import array as A
import heff.syntax.cst as C
import heff.syntax.diagnostic
import heff.elab.fixed as Fx
import heff.syntax.fixity as F
import heff.syntax.fmt.lex as L
import heff.syntax.fmt.toks as Tk
import heff.elab.params as Pm
import heff.syntax.presyntax as Notation
import heff.util.rune as Rn
import map as Mp

type Binders = { f : String, names : List String, implicits : List String }

mkBinders : String -> List String -> List String -> Binders
mkBinders f names implicits = { f = f, names = names, implicits = implicits }

-- | `toks`: the tokens read (the lowering looks one past a parenthesis);
-- | `scope`: the names bound where the lowering is; `binders`: the names
-- | each signature binds, by the name it is of (the last read first);
-- | `patVars`: those of the equation being lowered; `fix`: the fixities
-- | in scope; `lenient`: unrelated operators bind as one left-associative
-- | group (the formatter's reading)
type St =
  { toks : Array C.T
  , scope : List String
  , known : String -> Bool
  , binders : Mp.Map String (List Binders)
  , patVars : List String
  , fix : F.Fixities
  , lenient : Bool
  }

type P a = St -> Pair (Either Diag a) St

bindStep : {a b : Type}
         -> Pair (Either Diag a) St
         -> (a -> P b)
         -> Pair (Either Diag b) St
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

bind : {a b : Type} -> P a -> (a -> P b) -> P b
bind m f = \st -> bindStep (m st) f

pure : {a : Type} -> a -> P a
pure x = \st -> MkPair (Right x) st

pGets : {a : Type} -> (St -> a) -> P a
pGets f = \st -> MkPair (Right (f st)) st

pModify : (St -> St) -> P Unit
pModify f = \st -> MkPair (Right MkUnit) (f st)

throwP : {a : Type} -> Diag -> P a
throwP d = \st -> MkPair (Left d) st

diag : Pm.Span -> String -> Diag
diag span msg =
  { code = 150, severity = SError, msg = msg, span = span, note = Nothing }

mkSt : Array C.T
     -> List String
     -> (String -> Bool)
     -> Mp.Map String (List Binders)
     -> List String
     -> F.Fixities
     -> Bool
     -> St
mkSt toks scope known binders patVars fix lenient =
  { toks = toks
  , scope = scope
  , known = known
  , binders = binders
  , patVars = patVars
  , fix = fix
  , lenient = lenient
  }

setScope : List String -> St -> St
setScope sc s = mkSt s.toks sc s.known s.binders s.patVars s.fix s.lenient

setBinders : Mp.Map String (List Binders) -> St -> St
setBinders b s = mkSt s.toks s.scope s.known b s.patVars s.fix s.lenient

setPatVars : List String -> St -> St
setPatVars pv s = mkSt s.toks s.scope s.known s.binders pv s.fix s.lenient

-- Tokens and spans
--------------------------------------------------------------------------------

-- | `:` annotates (`::` is an operator: the prelude's cons)
isAnnText : String -> Bool
isAnnText x = strEq x ":"

-- (a token as the lexer gives it: the fixities are read from those)
spanOf : L.Tok -> Pm.Span
spanOf t = { start = t.start, end = t.end }

spanT : C.T -> Pm.Span
spanT t = { start = t.start, end = t.end }

spanTT : C.T -> C.T -> Pm.Span
spanTT a b = { start = a.start, end = b.end }

spanTE : C.T -> Int -> Pm.Span
spanTE a e = { start = a.start, end = e }

mkSpan : Int -> Int -> Pm.Span
mkSpan a b = { start = a, end = b }

appendS : {a : Type} -> List a -> List a -> List a
appendS Nil ys = ys
appendS (Cons x xs) ys = Cons x (appendS xs ys)

withScope : {a : Type} -> List String -> P a -> P a
withScope xs p = do
  saved <- pGets (\s -> s.scope)
  pModify (\s -> setScope (appendS xs s.scope) s)
  x <- p
  pModify (\s -> setScope saved s)
  pure x

traverseS : {a b : Type} -> (a -> P b) -> List a -> P (List b)
traverseS f Nil = pure Nil
traverseS f (Cons x xs) = do
  y <- f x
  ys <- traverseS f xs
  pure (Cons y ys)

-- | the items of a block, lowered: what one binds is in scope in those
-- | after it, not after the block
block : {a b : Type} -> (a -> P b) -> List a -> P (List b)
block f xs = do
  saved <- pGets (\s -> s.scope)
  ys <- traverseS f xs
  pModify (\s -> setScope saved s)
  pure ys

-- Number literals
--------------------------------------------------------------------------------

-- (a digit's value: `0`-`9`, `a`-`f`, `A`-`F`)
digitOf : Int -> Int
digitOf c = if c >= 97 then c - 87 else if c >= 65 then c - 55 else c - 48

-- (the digits of `s` from `i` to `stop`, in `base`; a `_` is a separator)
digitsVal : Int -> String -> Int -> Int -> Int -> Int
digitsVal base s i stop n =
  if i >= stop then n
  else if byteAt s i == 95 then digitsVal base s (i + 1) stop n
  else digitsVal base s (i + 1) stop (n * base + digitOf (byteAt s i))

-- (an integer's digits from `i`, after `0x` hexadecimal, after `0b`
-- binary, else decimal)
magnitudeOf : String -> Int -> Int
magnitudeOf s i =
  if strEq (strSlice s i (i + 2)) "0x" || strEq (strSlice s i (i + 2)) "0X"
    then digitsVal 16 s (i + 2) (strLength s) 0
  else if strEq (strSlice s i (i + 2)) "0b" || strEq (strSlice s i (i + 2)) "0B"
    then digitsVal 2 s (i + 2) (strLength s) 0
  else digitsVal 10 s i (strLength s) 0

-- | an integer as the lexer writes it: a sign, then decimal digits, or
-- | hexadecimal after `0x`, binary after `0b`, `_` between digits
intOfText : String -> Int
intOfText s =
  if startsWith "-" s then 0 - magnitudeOf s 1
  else if startsWith "+" s then magnitudeOf s 1
  else magnitudeOf s 0

ipow10 : Int -> Int
ipow10 k = if k <= 0 then 1 else 10 * ipow10 (k - 1)

expOf : String -> Int
expOf ex =
  if startsWith "-" ex then 0 - intOfText (strSlice ex 1 (strLength ex))
  else if startsWith "+" ex then intOfText (strSlice ex 1 (strLength ex))
  else intOfText ex

dotAt : String -> Int -> Int
dotAt s i =
  if i >= strLength s then strLength s
  else if byteAt s i == 46 then i
  else dotAt s (i + 1)

-- (the digits with the dot taken out: an exact integer mantissa, and
-- how many digits were after the dot)
mantScale : String -> Int -> Int
mantScale m d = if d >= strLength m then 0 else strLength m - d - 1

mantInt : String -> Int -> Int
mantInt m d =
  if d >= strLength m then intOfText m
  else intOfText (strSlice m 0 d ^ strSlice m (d + 1) (strLength m))

splitExp : String -> Int -> Int
splitExp s i =
  if i >= strLength s then strLength s
  else if byteAt s i == 101 || byteAt s i == 69 then i
  else splitExp s (i + 1)

-- (one conversion, not a float computation per digit: `M * 10^p` is an
-- exact integer when `p >= 0`, and one division otherwise -- so the
-- value is the literal's, as JavaScript reads it)
floatAt : Int -> Int -> Float64
floatAt m p =
  if p >= 0 then toFloat (m * ipow10 p)
  else toFloat m /. toFloat (ipow10 (0 - p))

floatSplit : String -> Int -> Float64
floatSplit s eAt =
  floatAt
    (mantInt (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))
    ((if eAt >= strLength s then 0
      else expOf (strSlice s (eAt + 1) (strLength s)))
     - mantScale (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))

-- (`a.b`, with an optional sign and an optional `e`/`E` exponent)
floatOfDigits : String -> Float64
floatOfDigits s =
  if startsWith "-" s
    then 0.0
      -. floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else if startsWith "+" s
    then floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else floatSplit s (splitExp s 0)

-- | a float as the lexer writes it: `a.b`, with an optional sign and an
-- | optional `e`/`E` exponent, `_` between digits
floatOfText : String -> Float64
floatOfText s = floatOfDigits (joinWith "" (split "_" s))

type Operand a = { op : C.T, e : a }

mkOperand : {a : Type} -> C.T -> a -> Operand a
mkOperand t e = { op = t, e = e }

piBinderNames : Notation.PiBinder Notation.Expr Notation.Expr -> List String
piBinderNames (PiNamed x _ _) = Cons x Nil
piBinderNames (PiImplicit x _ _ _ _) = Cons x Nil
piBinderNames (PiInstance x _ _ _) = Cons x Nil
piBinderNames (PiAnon _) = Nil

-- | the names a (function) type binds: `(x : A) -> ...`, `{x : A} -> ...`
piBinders : Notation.Expr -> List String
piBinders (At (EPi b rest) _) = appendS (piBinderNames b) (piBinders rest)
piBinders _ = Nil

-- | the names of the implicit parameters, `{x : A} -> ...`
piImplicits : Notation.Expr -> List String
piImplicits (At (EPi (PiImplicit x _ _ _ _) rest) _) = Cons x (piImplicits rest)
piImplicits (At (EPi (PiInstance x _ _ _) rest) _) = Cons x (piImplicits rest)
piImplicits (At (EPi _ rest) _) = piImplicits rest
piImplicits _ = Nil

paramName : Pm.Spanned (Notation.Param Notation.Expr) -> String
paramName (At (ExplicitParam x _ _) _) = x
paramName (At (ImplicitParam x _ _) _) = x

concatMapS : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapS f Nil = Nil
concatMapS f (Cons x xs) = appendS (f x) (concatMapS f xs)

-- | the names a pattern binds (`_` binds nothing; a tag is no
-- | variable; nor is a capitalised name, unless `pv`, the parameters the
-- | signature names, has it)
boundBy : List String -> C.Pat -> List String
boundBy pv (PAtom t) =
  if strEq t.kind "var" && not (strEq t.text "_") then Cons t.text Nil
  else if strEq t.kind "con" && List.elemBy strEq t.text pv then Cons t.text Nil
  else Nil
boundBy pv (PCon c args) = concatMapS (\q -> boundBy pv q) args
boundBy pv (PParen o q c) = boundBy pv q
boundBy pv (PList o ps commas c) = concatMapS (\q -> boundBy pv q) ps
boundBy pv (POp l op q) = appendS (boundBy pv l) (boundBy pv q)
boundBy pv (PRec o fs commas c) = concatMapS (\q -> boundBy pv q) fs
boundBy pv (PField x eq q) = boundBy pv q
boundBy pv (PAs x at q) = Cons x.text (boundBy pv q)

isVarE : Notation.Expr -> Bool
isVarE (At (EVar _) _) = True
isVarE _ = False

-- (a name as written: a capitalised one is a tag, but not a tag made of
-- other syntax, `[]`)
isNameE : Notation.Expr -> Bool
isNameE (At (EVar _) _) = True
isNameE (At (ETag x) sp) = sp.end - sp.start == strLength x
isNameE _ = False

asNameE : Notation.Expr -> Notation.Expr
asNameE (At (ETag x) sp) = At (EVar x) sp
asNameE e = e

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) xs) = Cons x (catMaybesS xs)
catMaybesS (Cons Nothing xs) = catMaybesS xs

identOf : Notation.Expr -> Maybe String
identOf (At (EVar x) _) = Just x
identOf (At (ETag x) _) = Just x
identOf _ = Nothing

identsOfG : Notation.Expr -> List String
identsOfG g =
  catMaybesS
    (List.map
       identOf
       (Cons (Notation.spineOf g).head (Notation.spineOf g).args))

asBinderOn : Notation.Expr -> P Notation.Expr
asBinderOn e@(At (EAnn g _) _) = do
  pModify (\s -> setScope (appendS (identsOfG g) s.scope) s)
  pure e
asBinderOn e = pure e

allS : {a : Type} -> (a -> Bool) -> List a -> Bool
allS p Nil = True
allS p (Cons x xs) = p x && allS p xs

nameBinder : Notation.Expr -> Notation.Expr
nameBinder (At (EAnn g t) _) =
  if allS isNameE (Cons (Notation.spineOf g).head (Notation.spineOf g).args)
    then Notation.ann
        (Notation.app
           (asNameE (Notation.spineOf g).head)
           (List.map asNameE (Notation.spineOf g).args))
        t
  else Notation.ann g t
nameBinder e0 = e0

-- | `A : T` as a binder: what is left of `:` is names (in scope after)
asBinder : Notation.Expr -> P Notation.Expr
asBinder e0 = asBinderOn (nameBinder e0)

foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

-- | `d -> b`, from the binder to the type
piOf : Notation.PiBinder Notation.Expr Notation.Expr
     -> Pm.Span
     -> Notation.Expr
     -> Notation.Expr
piOf d dsp b = At (EPi d b) (Notation.spanning dsp (Pm.spanOf b))

-- | what is left of `->`: a type, or what is in braces, `{x : A}` (and
-- | `{x : A := d}`, its default), or in double braces, `{{x : A}}` (where
-- | they are)
data ArrowLhs
  = Plain Notation.Expr
  | Braced Notation.Expr (Maybe Notation.Expr) Pm.Span
  | Bracketed Notation.Expr Pm.Span

-- | a type alone, or `(x : A)`
plainBinder : Notation.Expr -> Notation.PiBinder Notation.Expr Notation.Expr
plainBinder (At (EAnn (At (EVar x) xsp) t) _) = PiNamed x xsp t
plainBinder d = PiAnon d

-- | `(a b : T) -> B` is `(a : T) -> (b : T) -> B`; `{a b : T} -> B`, the
-- | same with implicit arguments (`{a b : T := d}`, each its default)
arrowNames : Notation.Expr
           -> Notation.Expr
           -> Notation.Expr
           -> Maybe Pm.Span
           -> Maybe Notation.Expr
           -> Notation.Expr
           -> Notation.Expr
arrowNames rhs g ty braces dflt orig =
  if allS isVarE (Cons (Notation.spineOf g).head (Notation.spineOf g).args)
    then foldr
        (\x b -> case x of
         At (EVar y) ysp -> case braces of
           Just bsp -> piOf (PiImplicit y ysp bsp ty dflt) bsp b
           Nothing ->
             piOf (PiNamed y ysp ty) (Notation.spanning ysp (Pm.spanOf ty)) b
         _ -> b)
        rhs
        (Cons (Notation.spineOf g).head (Notation.spineOf g).args)
  else case braces of
    Just bsp ->
      piOf
        (PiAnon
           (At
              (EInvalid "an implicit argument is named: `{x : T} -> ...`")
              bsp))
        bsp
        rhs
    Nothing -> piOf (plainBinder orig) (Pm.spanOf orig) rhs

arrowBinop : ArrowLhs -> Notation.Expr -> Notation.Expr
arrowBinop (Plain (At (EAnn g ty) sp)) rhs =
  arrowNames rhs g ty Nothing Nothing (At (EAnn g ty) sp)
arrowBinop (Plain d) rhs = piOf (PiAnon d) (Pm.spanOf d) rhs
arrowBinop (Braced (At (EAnn g ty) sp) dflt bsp) rhs =
  arrowNames rhs g ty (Just bsp) dflt (At (EAnn g ty) sp)
arrowBinop (Braced d dflt bsp) rhs =
  piOf
    (PiAnon
       (At (EInvalid "an implicit argument is named: `{x : T} -> ...`") bsp))
    bsp
    rhs
arrowBinop (Bracketed (At (EAnn (At (EVar x) xsp) t) _) bsp) rhs =
  piOf (PiInstance x xsp bsp t) bsp rhs
arrowBinop (Bracketed d bsp) rhs =
  piOf
    (PiAnon
       (At (EInvalid "an instance argument is named: `{{x : T}} -> ...`") bsp))
    bsp
    rhs

-- | `e ~ { x = v }`, a setting at a time
specOne : Notation.Expr
        -> Pm.Spanned (Notation.FieldSet Notation.Expr)
        -> Notation.Expr
specOne acc (At (SetField x _ v) fsp) =
  At (ESpec acc x fsp v) (Notation.spanning (Pm.spanOf acc) fsp)
specOne acc (At (BadFieldSet e) fsp) =
  At (EInvalid "a specialisation sets a field by its name: `x = v`") fsp

-- The shunting yard
--------------------------------------------------------------------------------

type Shunt a = { ops : List C.T, out : List a }

maxI : Int -> Int -> Int
maxI a b = if a < b then b else a

boolAnn : Pm.Span -> Notation.Expr -> Notation.Expr
boolAnn osp e = Notation.ann e (At (EImplicitVar "Bool") osp)

-- (the sides are annotated with the `Bool` in scope)
shortcut : C.T
         -> Notation.Expr
         -> Notation.Expr
         -> Notation.Expr
         -> Notation.Expr
shortcut op c a b =
  boolAnn
    (spanT op)
    (At
       (EMatch
          (boolAnn (spanT op) c)
          [ Notation.alt (Notation.patTag "True" (spanT op) Nil) a
          , Notation.alt (Notation.patTag "False" (spanT op) Nil) b
          ])
       (mkSpan (Pm.spanOf c).start (maxI (Pm.spanOf a).end (Pm.spanOf b).end)))

-- | `&&` and `||` are `if`: the right side is computed only if needed
applyOp : C.T -> Notation.Expr -> Notation.Expr -> Notation.Expr
applyOp op l r =
  if strEq op.text "&&" then shortcut op l r (At (ETag "False") (spanT op))
  else if strEq op.text "||" then shortcut op l (At (ETag "True") (spanT op)) r
  else Notation.app (At (EVar op.text) (spanT op)) [l, r]

-- | in a pattern, an operator is applied as a tag is: its operands are
-- | its arguments
applyPatOp : C.T -> Notation.Pat -> Notation.Pat -> Notation.Pat
applyPatOp op l r = Notation.patOp op.text (spanT op) [l, r]

-- (stacks newest first: push is `Cons`)
reduceS : {a : Type} -> (C.T -> a -> a -> a) -> Shunt a -> Shunt a
reduceS apply st@{ ops = Cons o os } = case st.out of
  Cons r (Cons l rest) -> { ops = os, out = Cons (apply o l r) rest }
  _ -> st
reduceS apply st@{ ops = Nil } = st

-- (two operators neither binds tighter than)
unrelatedMsg : F.Fixities -> String -> String -> String
unrelatedMsg fix a b =
  if F.bothLoosest fix a b
    then "`" ^ a ^ "` and `" ^ b ^ "` are both the loosest: add parentheses"
  else "`"
    ^ a
    ^ "` and `"
    ^ b
    ^ "` are not related: add parentheses, or declare which binds tighter (`above`, `below`)"

-- | `before` is on the stack, `op` comes: does `before` reduce first?
firstS : F.Fixities -> Bool -> C.T -> C.T -> P Bool
firstS fix lenient before op = case F.relate fix before.text op.text of
  Tighter -> pure True
  Looser -> pure False
  Same AssocLeft -> pure True
  Same AssocRight -> pure False
  Same AssocNone ->
    throwP
      (diag
         (spanT op)
         (if strEq before.text op.text
            then "`" ^ op.text ^ "` does not associate: add parentheses"
          else "`"
            ^ before.text
            ^ "` and `"
            ^ op.text
            ^ "` do not associate: add parentheses"))
  Unrelated ->
    if lenient then pure True
    else throwP (diag (spanT op) (unrelatedMsg fix before.text op.text))
  Undeclared x ->
    if lenient then pure True
    else throwP
        (diag
           (spanT (if strEq x op.text then op else before))
           ("`"
            ^ x
            ^ "` has no fixity: declare it (`infixl "
            ^ x
            ^ "`), or import the module that does"))

pushS : {a : Type}
      -> (C.T -> a -> a -> a)
      -> F.Fixities
      -> Bool
      -> Shunt a
      -> Operand a
      -> P (Shunt a)
pushS apply fix lenient st@{ ops = Nil } r =
  pure { ops = Cons r.op st.ops, out = Cons r.e st.out }
pushS apply fix lenient st@{ ops = Cons before os } r = do
  done <- firstS fix lenient before r.op
  if done then pushS apply fix lenient (reduceS apply st) r
    else pure { ops = Cons r.op st.ops, out = Cons r.e st.out }

pushAll : {a : Type}
        -> (C.T -> a -> a -> a)
        -> F.Fixities
        -> Bool
        -> Shunt a
        -> List (Operand a)
        -> P (Shunt a)
pushAll apply fix lenient st Nil = pure st
pushAll apply fix lenient st (Cons r rest) = do
  st' <- pushS apply fix lenient st r
  pushAll apply fix lenient st' rest

checkFixOf : {a : Type} -> F.Fixities -> Bool -> List (Operand a) -> P Unit
checkFixOf fix lenient Nil = pure MkUnit
checkFixOf fix lenient (Cons r rest) = case F.groupOf fix r.op.text of
  Just _ -> checkFixOf fix lenient rest
  Nothing ->
    if lenient then checkFixOf fix lenient rest
    else throwP
        (diag
           (spanT r.op)
           ("`"
            ^ r.op.text
            ^ "` has no fixity: declare it (`infixl "
            ^ r.op.text
            ^ "`), or import the module that does"))

reduceAll : {a : Type} -> (C.T -> a -> a -> a) -> Shunt a -> Shunt a
reduceAll apply st@{ ops = Nil } = st
reduceAll apply st@{ ops = Cons o os } = reduceAll apply (reduceS apply st)

shuntOut : {a : Type} -> Shunt a -> List a
shuntOut st = st.out

headOr : {a : Type} -> a -> List a -> a
headOr z Nil = z
headOr z (Cons x xs) = x

-- | operators and operands into a tree, refusing operators that do not
-- | go together
resolve : {a : Type} -> (C.T -> a -> a -> a) -> a -> List (Operand a) -> P a
resolve apply e0 rest = do
  fix <- pGets (\s -> s.fix)
  lenient <- pGets (\s -> s.lenient)
  checkFixOf fix lenient rest
  st <- pushAll apply fix lenient { ops = Nil, out = Cons e0 Nil } rest
  pure (headOr e0 (shuntOut (reduceAll apply st)))

-- Declarations
--------------------------------------------------------------------------------

-- | what a top-level declaration is, before signatures meet equations:
-- | a signature (the name, where it is written, the type, where the
-- | signature is), an equation (where it is), a declaration whole, or a
-- | doc test (a watch, before it meets the definition it is of)
data Item
  = Sig String Pm.Span Notation.Expr Pm.Span
  | Eqn String (Pm.Spanned (Notation.Equation Notation.Expr)) Pm.Span
  | Whole Notation.Decl
  | Doc Notation.Decl

-- Signatures meet their equations
--------------------------------------------------------------------------------

defOf : String
      -> Pm.Span
      -> Notation.Expr
      -> Pm.Span
      -> List (Pm.Spanned (Notation.Equation Notation.Expr))
      -> Notation.Decl
defOf f fsp ty sp eqs = At (DeclEquations f fsp ty eqs) sp

-- | the equations of a name, in order, and where the last of them ends
type Eqns =
  { eqns : List (Pm.Spanned (Notation.Equation Notation.Expr)), end : Int }

-- (`e` before the equations `rest` of its name has after it)
eqnsCons : Pm.Spanned (Notation.Equation Notation.Expr)
         -> Pm.Span
         -> Maybe Eqns
         -> Eqns
eqnsCons e esp Nothing = { eqns = Cons e Nil, end = esp.end }
eqnsCons e esp (Just rest) =
  { eqns = Cons e rest.eqns, end = maxI esp.end rest.end }

eqnsAdd : String
        -> Pm.Spanned (Notation.Equation Notation.Expr)
        -> Pm.Span
        -> Mp.Map String Eqns
        -> Mp.Map String Eqns
eqnsAdd g e esp m =
  Mp.insert compareString g (eqnsCons e esp (Mp.lookup compareString g m)) m

-- | each name's equations: one pass, not one for each signature
eqnsByName : List Item -> Mp.Map String Eqns
eqnsByName Nil = Mp.empty
eqnsByName (Cons (Eqn g e esp) rest) = eqnsAdd g e esp (eqnsByName rest)
eqnsByName (Cons _ rest) = eqnsByName rest

-- | the names, to be looked up: one pass, not one for each look
nameSet : List String -> Mp.Map String Unit
nameSet Nil = Mp.empty
nameSet (Cons x rest) = Mp.insert compareString x MkUnit (nameSet rest)

isIn : Mp.Map String Unit -> String -> Bool
isIn names x = Mp.member compareString x names

assembleSig : String
            -> Pm.Span
            -> Notation.Expr
            -> Pm.Span
            -> Maybe Eqns
            -> Maybe Notation.Decl
assembleSig f fsp ty sp Nothing = Nothing
assembleSig f fsp ty sp (Just es) =
  Just (defOf f fsp ty (mkSpan sp.start (maxI sp.end es.end)) es.eqns)

assembleOne : Mp.Map String Unit
            -> Mp.Map String Eqns
            -> Item
            -> Maybe Notation.Decl
assembleOne broken byName (Whole d) = Just d
assembleOne broken byName (Doc d) = Just d
assembleOne broken byName (Sig f fsp ty sp) =
  if isIn broken f
    then Just
        (defOf
           f
           fsp
           ty
           sp
           [ At
             (MkEquation f fsp Nil (At (EWord AbandonWord) sp))
             (Notation.spanning fsp sp)
           ])
  else assembleSig f fsp ty sp (Mp.lookup compareString f byName)
assembleOne broken byName (Eqn _ _ _) = Nothing

assemble : List String -> List Item -> List Notation.Decl
assemble broken items =
  catMaybesS (List.map (assembleOne (nameSet broken) (eqnsByName items)) items)

-- | the names with a signature
sigNames : List Item -> Mp.Map String Unit
sigNames Nil = Mp.empty
sigNames (Cons (Sig f _ _ _) rest) =
  Mp.insert compareString f MkUnit (sigNames rest)
sigNames (Cons _ rest) = sigNames rest

-- | the names with an equation
eqnNames : List Item -> Mp.Map String Unit
eqnNames Nil = Mp.empty
eqnNames (Cons (Eqn f _ _) rest) =
  Mp.insert compareString f MkUnit (eqnNames rest)
eqnNames (Cons _ rest) = eqnNames rest

assembleDiagOne : Mp.Map String Unit
                -> Mp.Map String Unit
                -> Mp.Map String Unit
                -> Item
                -> Maybe Diag
assembleDiagOne broken sigs eqns (Sig f _ _ sp) =
  if not (isIn eqns f) && not (isIn broken f)
    then Just (diag sp ("`" ^ f ^ "` has a type but no definition"))
  else Nothing
assembleDiagOne broken sigs eqns (Eqn f _ sp) =
  if not (isIn sigs f) && not (isIn broken f)
    then Just (diag sp ("`" ^ f ^ "` needs a type: `" ^ f ^ " : ...`"))
  else Nothing
assembleDiagOne broken sigs eqns (Whole _) = Nothing
assembleDiagOne broken sigs eqns (Doc _) = Nothing

assembleDiags : List String -> List Item -> List Diag
assembleDiags broken items =
  catMaybesS
    (List.map
       (assembleDiagOne (nameSet broken) (sigNames items) (eqnNames items))
       items)

-- Doc tests meet their definitions
--------------------------------------------------------------------------------

-- A doc test, `-- | >>> e`, is a line of the doc comment right above a
-- definition: it is checked after the definition, as a watch written
-- under it would be, with it and what is above it in scope.  Between
-- the doc test and the definition there are only comment lines (the
-- rest of the doc comment): a blank line, a declaration or the end of
-- the file there, and the doc test is of nothing -- it stays where it
-- is, checked there as a watch, and is warned of.

lineEndS : String -> Int -> Int
lineEndS src i = fromMaybe (strLength src) (indexFrom "\n" src i)

-- (each line from the one at `i` up to `to` a `--` comment)
commentLinesFrom : String -> Int -> Int -> Bool
commentLinesFrom src i to =
  if i >= to then True
  else if startsWith "--" (trim (strSlice src i (lineEndS src i)))
    then commentLinesFrom src (lineEndS src i + 1) to
  else False

-- | only comment lines after the line `from` is on, up to `to`
commentsOnly : String -> Int -> Int -> Bool
commentsOnly src from to = commentLinesFrom src (lineEndS src from + 1) to

itemStart : Item -> Int
itemStart (Sig _ _ _ sp) = sp.start
itemStart (Eqn _ _ sp) = sp.start
itemStart (Whole d) = (Pm.spanOf d).start
itemStart (Doc d) = (Pm.spanOf d).start

-- (a declaration that defines a name: what a doc test may be of)
definesDecl : Notation.Decl -> Bool
definesDecl (At (DeclTest _ _) _) = False
definesDecl (At (DeclWatch _) _) = False
definesDecl _ = True

-- (a signature starts a definition, so does `data`, `type`, `theory` or
-- `primitive`; an equation, a test or a watch does not)
definesItem : Item -> Bool
definesItem (Sig _ _ _ _) = True
definesItem (Whole d) = definesDecl d
definesItem _ = False

-- | the items so far, the doc tests waiting for their definition (each
-- | list last first), and what is wrong
type Placed =
  { items : List Item, waiting : List Notation.Decl, diags : List Diag }

mkPlaced : List Item -> List Notation.Decl -> List Diag -> Placed
mkPlaced items waiting diags =
  { items = items, waiting = waiting, diags = diags }

strayDiag : Notation.Decl -> Diag
strayDiag d =
  { code = 151
  , severity = SWarning
  , msg =
      "a doc test is of the definition right under its doc comment, no blank line between: there is none here, so it is checked here, as a watch"
  , span = Pm.spanOf d
  , note =
      Just
        "write it as a watch, `-- >>> e`, or move it into the doc comment right above the definition it is of"
  }

-- (the doc tests waiting, of no definition: left where they are, each
-- warned of)
strand : Placed -> Placed
strand p =
  mkPlaced
    (appendS (List.map (\d -> Whole d) p.waiting) p.items)
    Nil
    (appendS (List.map strayDiag p.waiting) p.diags)

-- (whether what is at `at` is right under the doc test waiting last)
nextTo : String -> List Notation.Decl -> Int -> Bool
nextTo src (Cons d _) at = commentsOnly src (Pm.spanOf d).end at
nextTo src Nil at = False

-- (another doc test, of the same definition as those waiting if it is
-- right under them)
docNext : String -> Placed -> Notation.Decl -> Placed
docNext src p d =
  if List.null p.waiting || nextTo src p.waiting (Pm.spanOf d).start
    then mkPlaced p.items (Cons d p.waiting) p.diags
  else mkPlaced (strand p).items (Cons d Nil) (strand p).diags

-- (a definition: the doc tests right above it after it)
defNext : String -> Placed -> Item -> Placed
defNext src p it =
  if nextTo src p.waiting (itemStart it)
    then mkPlaced
        (appendS (List.map (\d -> Whole d) p.waiting) (Cons it p.items))
        Nil
        p.diags
  else mkPlaced (Cons it (strand p).items) Nil (strand p).diags

placeStep : String -> Placed -> Item -> Placed
placeStep src p (Doc d) = docNext src p d
placeStep src p it =
  if definesItem it then defNext src p it
  else mkPlaced (Cons it (strand p).items) Nil (strand p).diags

-- | the items, each doc test after the definition it is of; a doc test
-- | of none where it is, warned of
placeDocs : String -> List Item -> Placed
placeDocs src items =
  strand (List.foldl (\p it -> placeStep src p it) (mkPlaced Nil Nil Nil) items)

-- The lowering, knotted through `lw`
--------------------------------------------------------------------------------

atomOf : C.E -> Maybe C.T
atomOf (Atom t) = Just t
atomOf _ = Nothing

symAtom : C.E -> Maybe C.T
symAtom (Atom t) = if strEq t.kind "sym" then Just t else Nothing
symAtom _ = Nothing

-- | an operator's right side, as written: the operator, and its operand
opRhsOf : C.E -> Pair C.T C.E
opRhsOf (OpRhs op e) = MkPair op e
opRhsOf e = MkPair (C.firstE e) e

-- | `{x : A}`, and `{x : A := d}`: braces around one declaration (not a
-- | record's field, set or with its default)
bracedOne : C.E -> Maybe C.E
bracedOne (Braces o (Cons f Nil) commas c) = case f of
  EFSet x eq e -> Nothing
  EFDefault d eq e -> if strEq eq.text ":=" then Just f else Nothing
  _ -> Just f
bracedOne _ = Nothing

-- | `{ x = e, ... }` or `{}`: a record's settings
settingsOf : C.E -> Maybe (List C.E)
settingsOf (Braces o Nil commas c) = Just Nil
settingsOf (Braces o fs@(Cons (EFSet x eq e) rest) commas c) = Just fs
settingsOf _ = Nothing

-- | `a : T`
isAnnE : Notation.Expr -> Bool
isAnnE (At (EAnn _ _) _) = True
isAnnE _ = False

type Lw =
  { e : C.E -> P Notation.Expr
  , pat : C.Pat -> P Notation.Pat
  , decl : C.D -> P (List Item)
  }

-- | a keyword written as a word: a built-in type, or `abandon` (where
-- | the text becomes the word it is, once)
wordKw : String -> Notation.SyntaxWord
wordKw "Int" = IntWord
wordKw "Float64" = FloatWord
wordKw "String" = StringWord
wordKw "Rune" = RuneWord
wordKw "Array" = ArrayWord
wordKw "abandon" = AbandonWord
wordKw x = case Fx.fixedOfName x of
  Just w -> FixedWord w
  Nothing -> TypeWord

-- | a literal, a keyword or a name, as the token says
atomTok : C.T -> Notation.Expr
atomTok t =
  if strEq t.kind "var" then At (EVar t.text) (spanT t)
  else if strEq t.kind "int" then At (EInt (intOfText t.text)) (spanT t)
  else if strEq t.kind "float" then At (EFloat (floatOfText t.text)) (spanT t)
  else if strEq t.kind "str" then At (EString t.text) (spanT t)
  else if strEq t.kind "rune" then At (ERune (Rn.codeAt t.text 0)) (spanT t)
  else if strEq t.kind "sym" then At (EVar t.text) (spanT t)
  else At (EWord (wordKw t.text)) (spanT t)

-- | the same, in a pattern
patTok : C.T -> Notation.Pat
patTok t =
  if strEq t.kind "var" then At (PatVar t.text) (spanT t)
  else if strEq t.kind "int" then At (PatInt (intOfText t.text)) (spanT t)
  else if strEq t.kind "float" then At (PatFloat (floatOfText t.text)) (spanT t)
  else if strEq t.kind "str" then At (PatString t.text) (spanT t)
  else if strEq t.kind "rune" then At (PatRune (Rn.codeAt t.text 0)) (spanT t)
  else if strEq t.kind "sym" then At (PatVar t.text) (spanT t)
  else At (PatWord (wordKw t.text)) (spanT t)

withFields : Notation.Expr -> List C.T -> Notation.Expr
withFields e fs =
  Notation.app e (List.map (\(f : C.T) -> At (EProject f.text) (spanT f)) fs)

-- (`M.x` is a name `M`, an import's alias, gives)
qualifiedBy : St -> C.T -> List C.T -> Bool
qualifiedBy s t (Cons f _) = s.known (t.text ^ "." ^ f.text)
qualifiedBy s t Nil = False

-- (`M.x`, a definition of the module imported as `M`, and the fields
-- after it)
qualifiedE : C.T -> List C.T -> Notation.Expr
qualifiedE t (Cons f rest) =
  withFields (At (EVar (t.text ^ "." ^ f.text)) (spanTT t f)) rest
qualifiedE t Nil = At (ETag t.text) (spanT t)

-- (`M.x` where `M` is an import's alias that has `x` and a local name
-- too: which is meant is not said)
clashAt : C.T -> String -> Pm.Span -> Diag
clashAt t x sp =
  { code = 152
  , severity = SError
  , msg =
      "`"
      ^ t.text
      ^ "` is both an import's alias and a local name here: `"
      ^ t.text
      ^ "."
      ^ x
      ^ "` could be either"
  , span = sp
  , note =
      Just
        ("rename the local `"
         ^ t.text
         ^ "`, or import the module as another name")
  }

aliasClash : C.T -> List C.T -> Diag
aliasClash t (Cons f _) = clashAt t f.text (spanTT t f)
aliasClash t Nil = clashAt t "" (spanT t)

-- | a capitalised name: a variable or a definition in scope, or a tag;
-- | `M.x`, a definition of the module imported as `M` -- an error if `M`
-- | is a variable here too
conAtom : C.T -> List C.T -> P Notation.Expr
conAtom t fs = do
  local <- pGets (\s -> List.elemBy strEq t.text s.scope)
  qualified <- pGets (\s -> qualifiedBy s t fs)
  inScope <- pGets (\s -> local || s.known t.text)
  if qualified && local then throwP (aliasClash t fs)
    else pure
        (if qualified then qualifiedE t fs
         else if inScope then withFields (At (EVar t.text) (spanT t)) fs
         else withFields (At (ETag t.text) (spanT t)) fs)

-- | a capitalised keyword with fields, `Rune.x`: where `Rune` is an
-- | import's alias, a definition of the module imported as `Rune` (or, if
-- | it has no `x`, the module, as for any alias) -- a type has no fields;
-- | else the keyword
kwAtom : C.T -> List C.T -> P Notation.Expr
kwAtom t fs = do
  qualified <- pGets (\s -> qualifiedBy s t fs)
  aliased <- pGets (\s -> s.known t.text)
  pure
      (if qualified then qualifiedE t fs
       else if aliased then withFields (At (EVar t.text) (spanT t)) fs
       else withFields (atomTok t) fs)

-- | `e.x.y`: what is projected, and the fields
data Fields = MkFields C.E (List C.T)

fieldsOf : C.E -> List C.T -> Fields
fieldsOf (EField e f) acc = fieldsOf e (Cons f acc)
fieldsOf e acc = MkFields e acc

-- | the token after `t` is `->`: what is in the parentheses `t` closes
-- | binds names
arrowAfter : St -> C.T -> Bool
arrowAfter s t =
  t.ix + 1 < A.length s.toks
  && strEq (A.index s.toks (t.ix + 1)).kind "sym"
  && strEq (A.index s.toks (t.ix + 1)).text "->"

-- | `[a, b, c]`, `Cons a (Cons b (Cons c Nil))`, and `[]`, `Nil`
listE : Pm.Span -> List Notation.Expr -> Notation.Expr
listE sp xs =
  foldr
    (\x rest -> Notation.app (At (ETag "Cons") sp) [x, rest])
    (At (ETag "Nil") sp)
    xs

listP : Pm.Span -> List Notation.Pat -> Notation.Pat
listP sp xs =
  foldr
    (\x rest -> Notation.patTag "Cons" sp [x, rest])
    (Notation.patTag "Nil" sp Nil)
    xs

-- | `x : T` in a binder's braces, and nothing else
declarationL : Lw -> C.E -> P Notation.Expr
declarationL r e = do
  e0 <- r.e e
  d <- asBinder e0
  if isAnnE d then pure d
    else throwP (diag (Pm.spanOf d) "a field is `name : Type`")

-- (from the field's start to its default's end, if it has one)
spanWith : Pm.Span -> Maybe Notation.Expr -> Pm.Span
spanWith sp Nothing = sp
spanWith sp (Just d) = Notation.spanning sp (Pm.spanOf d)

-- | `x : T`, a field of a record type, and its default `d`, if it has one
fieldDeclOf : Notation.Expr
            -> Maybe Notation.Expr
            -> Pm.Spanned (Notation.FieldDecl Notation.Expr Notation.Expr)
fieldDeclOf (At (EAnn (At (EVar x) xsp) t) sp) d =
  At (DeclareField x xsp t d) (spanWith sp d)
fieldDeclOf e d = At (BadFieldDecl e) (Pm.spanOf e)

-- | `x : T`, or `x : T = d`, a field of a record type (`x : T := d` is
-- | none: an implicit argument's)
fieldL : Lw
       -> C.E
       -> P (Pm.Spanned (Notation.FieldDecl Notation.Expr Notation.Expr))
fieldL r (EFDefault e eq d) = do
  e' <- declarationL r e
  d' <- r.e d
  pure
      (if strEq eq.text "=" then fieldDeclOf e' (Just d')
       else At (BadFieldDecl e') (Pm.spanOf e'))
fieldL r e = do
  e' <- declarationL r e
  pure (fieldDeclOf e' Nothing)

settingL : Lw -> C.E -> P (Pm.Spanned (Notation.FieldSet Notation.Expr))
settingL r (EFSet x eq e) = do
  e' <- r.e e
  pure
      (At
         (SetField x.text (spanT x) e')
         (Notation.spanning (spanT x) (Pm.spanOf e')))
settingL r e = do
  e' <- r.e e
  pure (At (BadFieldSet e') (Pm.spanOf e'))

isSetting : C.E -> Bool
isSetting (EFSet x eq e) = True
isSetting e = False

-- | what is in the braces of `{x : A} -> B`, and of `{x : A := d} -> B`
-- | its default (in scope there: the binders before it, not `x`)
bracedL : Lw -> C.E -> Pm.Span -> P ArrowLhs
bracedL r (EFDefault e eq d) sp = do
  d' <- r.e d
  e' <- declarationL r e
  pure (Braced e' (Just d') sp)
bracedL r f sp = do
  e' <- declarationL r f
  pure (Braced e' Nothing sp)

bracesL : Lw -> C.T -> List C.E -> C.T -> P Notation.Expr
bracesL r o Nil c = pure (At (EStruct Nil) (spanTT o c))
bracesL r o fs@(Cons f rest) c =
  if isSetting f
    then do
      fs' <- traverseS (\m -> settingL r m) fs
      pure (At (EStruct fs') (spanTT o c))
  else do
    fs' <- traverseS (\m -> fieldL r m) fs
    pure (At (ESig fs') (spanTT o c))

-- | `C x y`, a tag applied
conL : Lw -> C.T -> List C.E -> P Notation.Expr
conL r c args = do
  args' <- traverseS r.e args
  pure (Notation.app (At (ETag c.text) (spanT c)) args')

-- | a tag applied to types, an alternative of a sum type
variantOf : Notation.Expr -> Pm.Spanned (Notation.Variant Notation.Expr)
variantOf e = case (Notation.spineOf e).head of
  At (ETag t) tsp ->
    At (TagVariant t tsp (Notation.spineOf e).args) (Pm.spanOf e)
  _ -> At (BadVariant e) (Pm.spanOf e)

variantL : Lw -> C.E -> P (Pm.Spanned (Notation.Variant Notation.Expr))
variantL r (ECon c args) = do
  e <- conL r c args
  pure (variantOf e)
variantL r e = do
  e' <- r.e e
  pure (variantOf e')

-- | a lambda's binder, and where it starts
type LamB = { binder : Notation.LamBinder Notation.Expr, span : Pm.Span }

lamBinderL : Lw -> C.E -> P LamB
lamBinderL r (BVar x) =
  pure { binder = LamName x.text (spanT x), span = spanT x }
lamBinderL r (BImp o x c) =
  pure { binder = LamImplicit x.text (spanT x), span = spanTT o c }
lamBinderL r (BAnn o x cc ty c) = do
  ty' <- r.e ty
  pure
      { binder = LamAnn x.text (spanT x) ty'
      , span = Notation.spanning (spanT x) (Pm.spanOf ty')
      }
lamBinderL r e =
  throwP (diag (spanT (C.firstE e)) ("unexpected `" ^ (C.firstE e).text ^ "`"))

lamBound : LamB -> List String
lamBound { binder = LamName x _ } = Cons x Nil
lamBound { binder = LamImplicit x _ } = Cons x Nil
lamBound { binder = LamAnn x _ _ } = Cons x Nil

-- | `\x {y} _ -> e`
lambdaL : Lw -> List C.E -> C.E -> P Notation.Expr
lambdaL r binders body = do
  bs <- traverseS (\b -> lamBinderL r b) binders
  withScope (concatMapS lamBound bs) (do
    body' <- r.e body
    pure
        (foldr
           (\(b : LamB) e ->
              At (ELam b.binder e) (Notation.spanning b.span (Pm.spanOf e)))
           body'
           bs))

-- | `C x y -> e`: `x` and `y` are bound in `e`
altL : Lw -> C.E -> P (Pm.Spanned (Notation.Alt Notation.Expr))
altL r (EAlt p arrow e) = do
  p' <- r.pat p
  withScope (boundBy Nil p) (do
    e' <- r.e e
    pure (Notation.alt p' e'))
altL r e =
  throwP (diag (spanT (C.firstE e)) ("unexpected `" ^ (C.firstE e).text ^ "`"))

-- | `if c then a else b`, a `case` on `True` and `False`
ifE : Pm.Span
    -> Notation.Expr
    -> Notation.Expr
    -> Notation.Expr
    -> Notation.Expr
ifE sp c a b =
  At
    (EMatch
       c
       [ Notation.alt (Notation.patTag "True" sp Nil) a
       , Notation.alt (Notation.patTag "False" sp Nil) b
       ])
    sp

-- | `p = e`, or `p : T = e`, after `let`: the pattern, and what it is
-- | bound to (annotated, `(e : T)`)
letHeadL : Lw
         -> C.Pat
         -> Maybe (Pair C.T C.E)
         -> C.E
         -> P (Pair Notation.Pat Notation.Expr)
letHeadL r p ann0 e = do
  p' <- r.pat p
  case ann0 of
    Just (MkPair cc ty) -> do
      ty' <- r.e ty
      e' <- r.e e
      pure
          (MkPair
             p'
             (At
                (EAnn e' ty')
                (mkSpan (Pm.spanOf ty').start (Pm.spanOf e').end)))
    Nothing -> do
      e' <- r.e e
      pure (MkPair p' e')

-- | `in e` after `let p = e'`: `p`'s variables are bound in `e`
letBodyL : Lw
         -> C.T
         -> Pair Notation.Pat Notation.Expr
         -> List String
         -> C.E
         -> P Notation.Expr
letBodyL r kw (MkPair p rhs) names body =
  withScope names (do
  body' <- r.e body
  pure (At (ELetIn rhs (Notation.alt p body')) (spanTE kw (C.lastE body).end)))

-- | `let p = e in e'`
letL : Lw -> C.E -> P Notation.Expr
letL r (ELet kw p ann0 eq e (Just (MkPair i body))) = do
  h <- letHeadL r p ann0 e
  letBodyL r kw h (boundBy Nil p) body
letL r e =
  throwP (diag (spanT (C.firstE e)) ("unexpected `" ^ (C.firstE e).text ^ "`"))

-- | a statement of a `do` block: `x <- e` (`x` bound in the statements
-- | after it), `let p = e` (`p`'s variables bound in them), or `e`
stmtL : Lw -> C.E -> P (Pm.Spanned (Notation.Stmt Notation.Expr))
stmtL r (ESBind x arrow e) = do
  e' <- r.e e
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (At
         (StmtBind x.text (spanT x) e')
         (Notation.spanning (spanT x) (Pm.spanOf e')))
stmtL r (ELet kw p ann0 eq e Nothing) = do
  h <- letHeadL r p ann0 e
  pModify (\s -> setScope (appendS (boundBy Nil p) s.scope) s)
  pure (At (StmtLet (fst h) (snd h)) (spanTE kw (C.lastE e).end))
stmtL r e = do
  e' <- r.e e
  pure (At (StmtExpr e') (Pm.spanOf e'))

-- | an operator's operands, as written
operandL : Lw -> C.E -> P (Operand Notation.Expr)
operandL r m = case opRhsOf m of
  MkPair op e -> do
    e' <- r.e e
    pure (mkOperand op e')

parenL : Lw -> C.T -> C.E -> C.T -> P Notation.Expr
parenL r o e c = case symAtom e of
  Just t -> pure (At (EVar t.text) (spanT t))
  Nothing -> do
    e' <- r.e e
    after <- pGets (\s -> arrowAfter s c)
    if after then asBinder e' else pure e'

-- | `x -> y`, with `(a b : T) -> B` for `(a : T) -> (b : T) -> B`, and
-- | `{a : T} -> B` binding an implicit argument; `T ~ { f = v }`, a
-- | specialisation (the syntax's operators are these two)
opL : Lw -> C.E -> C.T -> C.E -> P Notation.Expr
opL r a op b =
  if strEq op.text "->"
    then do
      a' <- case bracedOne a of
        Just f -> bracedL r f (spanTT (C.firstE a) (C.lastE a))
        Nothing -> case a of
          InstB o o2 d c1 c -> do
            d' <- declarationL r d
            pure (Bracketed d' (spanTT o c))
          _ -> do
            e <- r.e a
            pure (Plain e)
      b' <- r.e b
      pure (arrowBinop a' b')
  else do
    a' <- r.e a
    case settingsOf b of
      Just fs -> do
        fs' <- traverseS (\m -> settingL r m) fs
        pure (List.foldl (\acc f -> specOne acc f) a' fs')
      Nothing -> do
        b' <- r.e b
        pure
            (At
               (EInvalid "a specialisation sets fields: `T ~ { x = v }`")
               (Notation.spanning (Pm.spanOf a') (Pm.spanOf b')))

-- | an argument: `(x := e)` names the parameter it is for
argL : Lw -> C.E -> P Notation.Expr
argL r (Named o x k e c) = do
  e' <- r.e e
  pure (At (ENamed x.text e') (spanTT o c))
argL r e = r.e e

-- | an expression
exprL : Lw -> C.E -> P Notation.Expr
exprL r (Atom t) =
  if strEq t.kind "con" then conAtom t Nil else pure (atomTok t)
exprL r (EField e f) = case fieldsOf (EField e f) Nil of
  MkFields (Atom t) fs ->
    if strEq t.kind "con" then conAtom t fs
    else if strEq t.kind "kw" then kwAtom t fs
    else pure (withFields (atomTok t) fs)
  MkFields b fs -> do
    b' <- r.e b
    pure (withFields b' fs)
exprL r (EParen o e c) = parenL r o e c
exprL r (Named o x k e c) = do
  e' <- r.e e
  pure
      (At
         (EInvalid
            ("`("
             ^ x.text
             ^ " := ...)` names an argument, after a function: `f ("
             ^ x.text
             ^ " := e)`"))
         (spanTT o c))
exprL r (Tup o es commas c) =
  if strEq o.text "["
    then do
      es' <- traverseS r.e es
      pure (listE (spanTT o c) es')
  else do
    es' <- traverseS r.e es
    pure
        (At
           (EInvalid
              "heff has no tuples: a record holds values together, `{ x = a, y = b }`")
           (spanTT o c))
exprL r (Braces o fs commas c) = bracesL r o fs c
exprL r (InstB o o2 d c1 c) = do
  d' <- declarationL r d
  pure
      (At
         (EInvalid
            "an instance argument is bound before `->`: `{{x : T}} -> ...`")
         (spanTT o c))
exprL r (Sum kw o alts bars c) = do
  alts' <- traverseS (\a -> variantL r a) alts
  pure (At (ESum alts') (spanTT kw c))
exprL r (ECon c args) = conL r c args
exprL r (App h args) = do
  h' <- r.e h
  args' <- traverseS (\m -> argL r m) args
  pure (Notation.app h' args')
exprL r (Op a op b) = opL r a op b
exprL r (Ops a rest) = do
  a' <- r.e a
  rest' <- traverseS (\m -> operandL r m) rest
  resolve applyOp a' rest'
exprL r (Ann e cc ty) = do
  e' <- r.e e
  ty' <- r.e ty
  pure (Notation.ann e' ty')
exprL r (Lam bs binders arrow body) = lambdaL r binders body
exprL r e0@(Case kw scrut o alts) = do
  scrut' <- r.e scrut
  alts' <- block (\a -> altL r a) alts
  pure (At (EMatch scrut' alts') (spanTE kw (C.lastE e0).end))
exprL r (If kw c th a el b) = do
  c' <- r.e c
  a' <- r.e a
  b' <- r.e b
  pure (ifE (spanTE kw (C.lastE b).end) c' a' b')
exprL r e0@(Do kw stmts) = do
  stmts' <- block (\m -> stmtL r m) stmts
  pure (At (EDo stmts') (spanTE kw (C.lastE e0).end))
exprL r e0@(ELet kw p ann0 eq e body) = letL r e0
exprL r e0 =
  throwP
    (diag (spanT (C.firstE e0)) ("unexpected `" ^ (C.firstE e0).text ^ "`"))

-- Patterns

-- | `p op q op' r`: the first, and each operator with what follows it
data PChain = MkPChain C.Pat (List (Pair C.T C.Pat))

pchainCons : C.Pat -> C.T -> PChain -> PChain
pchainCons l op (MkPChain rh rest) = MkPChain l (Cons (MkPair op rh) rest)

pchainOf : C.Pat -> PChain
pchainOf (POp l op r) = pchainCons l op (pchainOf r)
pchainOf p = MkPChain p Nil

patOperandL : Lw -> Pair C.T C.Pat -> P (Operand Notation.Pat)
patOperandL r (MkPair op p) = do
  p' <- r.pat p
  pure (mkOperand op p')

fieldPatL : Lw -> C.Pat -> P (Notation.FieldPat Notation.Pat)
fieldPatL r (PField x eq p) = do
  p' <- r.pat p
  pure (MkFieldPat x.text p')
fieldPatL r p =
  throwP (diag (spanT (C.firstP p)) ("unexpected `" ^ (C.firstP p).text ^ "`"))

-- | a pattern: an operator in it is another name for a tag (elaboration
-- | finds which), its operands as the fixities say
patL : Lw -> C.Pat -> P Notation.Pat
patL r (PAtom t) =
  if strEq t.kind "con"
    then do
      -- (a capitalised parameter of the signature is a variable)
      isVar <- pGets (\s -> List.elemBy strEq t.text s.patVars)
      pure
          (if isVar then At (PatVar t.text) (spanT t)
           else Notation.patTag t.text (spanT t) Nil)
  else pure (patTok t)
patL r (PCon c args) = do
  args' <- traverseS r.pat args
  pure (Notation.patTag c.text (spanT c) args')
patL r (PParen o p c) = r.pat p
patL r (PList o ps commas c) = do
  ps' <- traverseS r.pat ps
  pure (listP (spanTT o c) ps')
patL r (PRec o fs commas c) = do
  fs' <- traverseS (\f -> fieldPatL r f) fs
  pure (At (PatRecord fs') (spanTT o c))
patL r (POp l op q) = case pchainOf (POp l op q) of
  MkPChain h rest -> do
    h' <- r.pat h
    rest' <- traverseS (\m -> patOperandL r m) rest
    resolve applyPatOp h' rest'
patL r (PField x eq p) = r.pat p
patL r (PAs x at p) = do
  p' <- r.pat p
  pure (At (PatAs x.text (spanT x) p') (spanTT x (C.lastP p)))

-- Declarations

-- | what a signature or an equation defines: `f`, `C`, or `(+)`
type DeclName = { name : String, span : Pm.Span }

declNameOf : List C.T -> DeclName
declNameOf (Cons t (Cons op (Cons c Nil))) = { name = op.text, span = spanT op }
declNameOf (Cons t rest) = { name = t.text, span = spanT t }
declNameOf Nil = { name = "", span = mkSpan 0 0 }

firstStart : List C.T -> Int
firstStart (Cons t _) = t.start
firstStart Nil = 0

bindersFor : St -> String -> List Binders
bindersFor s f = fromMaybe Nil (Mp.lookup compareString f s.binders)

-- | `b` the binders of the signature last read of its name
addBinders : Binders -> St -> St
addBinders b s =
  setBinders
    (Mp.insert compareString b.f (Cons b (bindersFor s b.f)) s.binders)
    s

sigL : Lw -> List C.T -> C.E -> P (List Item)
sigL r names ty = do
  ty' <- r.e ty
  pModify
      (\s ->
         addBinders
           (mkBinders (declNameOf names).name (piBinders ty') (piImplicits ty'))
           s)
  pure
      (Cons
         (Sig
            (declNameOf names).name
            (declNameOf names).span
            ty'
            (mkSpan (firstStart names) (C.lastE ty).end))
         Nil)

lastDEnd : List C.D -> Int -> Int
lastDEnd ds e = case List.last ds of
  Just d -> (C.lastD d).end
  Nothing -> e

-- | `e where` and the local definitions, signatures and equations, as at
-- | the top level
whereL : Lw -> C.T -> List C.D -> Notation.Expr -> P Notation.Expr
whereL r kw ds rhs = do
  saved <- pGets (\s -> s.binders)
  items <- block r.decl ds
  pModify (\s -> setBinders saved s)
  case assembleDiags Nil (concatMapS (\x -> x) items) of
    Cons d _ -> throwP d
    Nil ->
      pure
        (At
           (ELocal rhs (assemble Nil (concatMapS (\x -> x) items)))
           (mkSpan (Pm.spanOf rhs).start (lastDEnd ds kw.end)))

-- | `f p ... = e`, perhaps followed by `where`
eqnL : Lw
     -> List C.T
     -> List C.Pat
     -> C.E
     -> Maybe (Pair C.T (List C.D))
     -> P (List Item)
eqnL r names pats rhs w = do
  sig <- pGets (\s -> bindersFor s (declNameOf names).name)
  pModify (\s -> setPatVars (concatMapS (\(b : Binders) -> b.names) sig) s)
  pats' <- traverseS r.pat pats
  pModify (\s -> setPatVars Nil s)
  -- (an implicit parameter is not written, but bound all the same, by
  -- the name the signature gives it)
  withScope
      (appendS
         (concatMapS
            (boundBy (concatMapS (\(b : Binders) -> b.names) sig))
            pats)
         (concatMapS (\(b : Binders) -> b.implicits) sig)) (do
    rhs0 <- r.e rhs
    rhs' <- case w of
      Just (MkPair kw ds) -> whereL r kw ds rhs0
      Nothing -> pure rhs0
    pure
        (Cons
           (Eqn
              (declNameOf names).name
              (At
                 (MkEquation
                    (declNameOf names).name
                    (declNameOf names).span
                    pats'
                    rhs')
                 (mkSpan (firstStart names) (Pm.spanOf rhs').end))
              (mkSpan (firstStart names) (Pm.spanOf rhs').end))
           Nil))

-- | `x : T`, `x` a name: the name, where it is, the type
type NameAnn = { name : String, span : Pm.Span, ty : Notation.Expr }

nameAnn : Notation.Expr -> Maybe NameAnn
nameAnn (At (EAnn (At (EVar x) xsp) t) _) =
  Just { name = x, span = xsp, ty = t }
nameAnn _ = Nothing

paramOf : Notation.Expr -> P (Pm.Spanned (Notation.Param Notation.Expr))
paramOf p = case nameAnn p of
  Just q ->
    pure
      (At
         (ExplicitParam q.name q.span q.ty)
         (Notation.spanning q.span (Pm.spanOf q.ty)))
  Nothing ->
    throwP (diag (Pm.spanOf p) "a parameter is `a`, `(x : T)` or `{x : T}`")

-- | `(x : T)` or `{x : T}`, a parameter of a type
dataParamOf : Lw -> C.E -> P (Pm.Spanned (Notation.Param Notation.Expr))
dataParamOf r e = case bracedOne e of
  Just f -> do
    d <- declarationL r f
    case nameAnn d of
      Just q ->
        pure
          (At
             (ImplicitParam q.name q.span q.ty)
             (spanTT (C.firstE e) (C.lastE e)))
      Nothing ->
        throwP (diag (Pm.spanOf d) "a parameter is `a`, `(x : T)` or `{x : T}`")
  Nothing -> do
    p0 <- r.e e
    p <- if strEq (C.firstE e).text "(" then asBinder p0 else pure p0
    paramOf p

-- | a parameter of a type: `a` (a type), `(x : T)` or `{x : T}`
dataParamL : Lw -> C.E -> P (Pm.Spanned (Notation.Param Notation.Expr))
dataParamL r e = case atomOf e of
  Just x ->
    pure
      (At
         (ExplicitParam x.text (spanT x) (At (EWord TypeWord) (spanT x)))
         (spanT x))
  Nothing -> dataParamOf r e

-- | `data T a = C x y | D`, and `data T : U = ...`
dataL : Lw
      -> C.D
      -> C.T
      -> C.T
      -> List C.E
      -> Maybe (Pair C.T C.E)
      -> Maybe C.DAlts
      -> P (List Item)
dataL r d kw name params universe alts = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    universe' <- case universe of
      Just (MkPair cc u) -> r.e u
      Nothing -> pure (At (EWord TypeWord) (spanT name))
    alts' <- traverseS (\a -> variantL r a) (C.altsOf alts)
    pure
        (Cons
           (Whole
              (At
                 (DeclDefine
                    name.text
                    (spanT name)
                    params'
                    universe'
                    (At (ESum alts') (spanTE kw (C.lastD d).end)))
                 (spanTE kw (C.lastD d).end)))
           Nil))

-- | `type T a = ...`
typeL : Lw -> C.T -> C.T -> List C.E -> C.E -> P (List Item)
typeL r kw name params body = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    body' <- r.e body
    pure
        (Cons
           (Whole
              (At
                 (DeclDefine
                    name.text
                    (spanT name)
                    params'
                    (At (EWord TypeWord) (spanTE kw (C.lastE body).end))
                    body')
                 (spanTE kw (C.lastE body).end)))
           Nil))

-- (a theory's field's default, if it has one)
defaultL : Lw -> Maybe (Pair C.T C.E) -> P (Maybe Notation.Expr)
defaultL r Nothing = pure Nothing
defaultL r (Just (MkPair eq d)) = do
  d' <- r.e d
  pure (Just d')

-- | a field of a theory, and its default: in scope in the fields after
-- | it (not in its default)
theoryFieldL : Lw
             -> C.TF
             -> P (Pm.Spanned (Notation.FieldDecl Notation.Expr Notation.Expr))
theoryFieldL r (MkTF x cc ty d) = do
  ty' <- r.e ty
  d' <- defaultL r d
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (At
         (DeclareField x.text (spanT x) ty' d')
         (Notation.spanning (spanT x) (Pm.spanOf (fromMaybe ty' d'))))

-- | `theory T a where` and its fields
theoryL : Lw -> C.D -> C.T -> C.T -> List C.E -> List C.TF -> P (List Item)
theoryL r d kw name params fields = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (List.map paramName params') (do
    fields' <- block (\f -> theoryFieldL r f) fields
    pure
        (Cons
           (Whole
              (At
                 (DeclTheory
                    name.text
                    (spanT name)
                    params'
                    (At (ESig fields') (spanTE kw (C.lastD d).end)))
                 (spanTE kw (C.lastD d).end)))
           Nil))

-- | `primitive x : T`
primitiveL : Lw -> C.T -> C.T -> C.E -> P (List Item)
primitiveL r kw x ty = do
  ty' <- r.e ty
  pure
      (Cons
         (Whole
            (At
               (DeclPrimitive x.text (spanT x) ty')
               (spanTE kw (C.lastE ty).end)))
         Nil)

-- (a watch is a declaration whole; a doc test waits for its definition)
watchItem : C.T -> Notation.Decl -> Item
watchItem w d = if strEq w.kind "doctest" then Doc d else Whole d

-- | a declaration, lowered: what it is before signatures meet equations
declL : Lw -> C.D -> P (List Item)
declL r (DImport t) = pure Nil
-- (read before the rest, by `fixityDecls`)
declL r (DFixity kw ts) = pure Nil
declL r (DSig names cc ty) = sigL r names ty
declL r (DEqn names pats eq rhs w) = eqnL r names pats rhs w
declL r d@(DData kw name params universe alts) =
  dataL r d kw name params universe alts
declL r (DType kw name params eq body) = typeL r kw name params body
declL r d@(DTheory kw name params w fields) = theoryL r d kw name params fields
declL r (DPrimitive kw x cc ty) = primitiveL r kw x ty
declL r (DTest kw x) =
  pure (Cons (Whole (At (DeclTest x.text (spanT x)) (spanTT kw x))) Nil)
declL r (DWatch w e) = do
  e' <- r.e e
  pure (Cons (watchItem w (At (DeclWatch e') (spanTE w (C.lastE e).end))) Nil)

lw : Lw
lw =
  { e = \e st -> exprL lw e st
  , pat = \p st -> patL lw p st
  , decl = \d st -> declL lw d st
  }

-- The program
--------------------------------------------------------------------------------

-- | the names a file defines (so that a capitalised one is not a tag)
prescanGo : Array L.Tok -> Int -> List String -> List String
prescanGo ts k acc =
  if k >= A.length ts then List.reverse acc
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && strEq (A.index ts k).kind "kw"
  && List.elemBy strEq (A.index ts k).text ["data", "type", "theory"]
  && k + 1 < A.length ts
    then prescanGo ts (k + 1) (Cons (A.index ts (k + 1)).text acc)
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && (strEq (A.index ts k).kind "var" || strEq (A.index ts k).kind "con")
  && k + 1 < A.length ts
  && strEq (A.index ts (k + 1)).kind "sym"
  && isAnnText (A.index ts (k + 1)).text
    then prescanGo ts (k + 1) (Cons (A.index ts k).text acc)
  else prescanGo ts (k + 1) acc

prescan : Array L.Tok -> List String
prescan ts = prescanGo ts 0 Nil

-- Fixity declarations, read before the rest
--------------------------------------------------------------------------------

type FixDecl =
  { assoc : F.Assoc
  , ops : List L.Tok
  , above : List L.Tok
  , below : List L.Tok
  , loosest : Bool
  , errors : List Diag
  , span : Pm.Span
  , line : Int
  }

restOfDecl : Array L.Tok -> Int -> List L.Tok -> List L.Tok
restOfDecl ts j acc =
  if j >= A.length ts then List.reverse acc
  else if strEq (A.index ts j).kind "eof"
  || ((A.index ts j).first && (A.index ts j).col == 0)
    then List.reverse acc
  else restOfDecl ts (j + 1) (Cons (A.index ts j) acc)

takeSyms : List L.Tok -> List L.Tok
takeSyms Nil = Nil
takeSyms (Cons u rest) =
  if strEq u.kind "sym" then Cons u (takeSyms rest) else Nil

dropN : {a : Type} -> Int -> List a -> List a
dropN n Nil = Nil
dropN n (Cons x rest) = if n <= 0 then Cons x rest else dropN (n - 1) rest

type AB =
  { above : List L.Tok, below : List L.Tok, loosest : Bool, errors : List Diag }

-- (`above` and the operators it is above, which it names)
abAbove : AB -> L.Tok -> List L.Tok -> AB
abAbove acc w Nil =
  { above = acc.above
  , below = acc.below
  , loosest = acc.loosest
  , errors =
      Cons
        (diag
           (spanOf w)
           "`above` names the operators it is above (`below` alone is below all)")
        acc.errors
  }
abAbove acc w ops =
  { above = appendS acc.above ops
  , below = acc.below
  , loosest = acc.loosest
  , errors = acc.errors
  }

-- (`below` and the operators it is below; alone, below all)
abBelow : AB -> List L.Tok -> AB
abBelow acc Nil =
  { above = acc.above, below = acc.below, loosest = True, errors = acc.errors }
abBelow acc ops =
  { above = acc.above
  , below = appendS acc.below ops
  , loosest = acc.loosest
  , errors = acc.errors
  }

abGo : AB -> List L.Tok -> AB
abGo acc Nil = acc
abGo acc (Cons w tail) =
  if strEq w.kind "var" && strEq w.text "above"
    then abGo
        (abAbove acc w (takeSyms tail))
        (dropN (List.length (takeSyms tail)) tail)
  else if strEq w.kind "var" && strEq w.text "below"
    then abGo
        (abBelow acc (takeSyms tail))
        (dropN (List.length (takeSyms tail)) tail)
  else { above = acc.above
       , below = acc.below
       , loosest = acc.loosest
       , errors =
           Cons
             (diag
                (spanOf w)
                ("expected `above` or `below` and operators, not `"
                 ^ w.text
                 ^ "`"))
             acc.errors
       }

assocOf : String -> F.Assoc
assocOf "infixl" = AssocLeft
assocOf "infixr" = AssocRight
assocOf s = AssocNone

lastEnd : L.Tok -> List L.Tok -> Int
lastEnd t Nil = t.end
lastEnd t (Cons u Nil) = u.end
lastEnd t (Cons u rest) = lastEnd t rest

fixDeclDone : L.Tok -> List L.Tok -> List L.Tok -> AB -> FixDecl
fixDeclDone t rest ops r =
  { assoc = assocOf t.text
  , ops = ops
  , above = r.above
  , below = r.below
  , loosest = r.loosest
  , errors = List.reverse r.errors
  , span = mkSpan t.start (lastEnd t rest)
  , line = t.line
  }

fixDeclParts : L.Tok -> List L.Tok -> FixDecl
fixDeclParts t rest =
  fixDeclDone
    t
    rest
    (takeSyms rest)
    (abGo
       { above = Nil, below = Nil, loosest = False, errors = Nil }
       (dropN (List.length (takeSyms rest)) rest))

fixDeclOf : Array L.Tok -> Int -> L.Tok -> FixDecl
fixDeclOf ts k t = fixDeclParts t (restOfDecl ts (k + 1) Nil)

fixDeclAt : Array L.Tok -> Int -> L.Tok -> Maybe FixDecl
fixDeclAt ts k t =
  if t.first
  && t.col == 0
  && strEq t.kind "kw"
  && List.elemBy strEq t.text ["infixl", "infixr", "infix"]
    then Just (fixDeclOf ts k t)
  else Nothing

fixDecls : Array L.Tok -> Int -> List FixDecl -> List FixDecl
fixDecls ts k acc =
  if k >= A.length ts then List.reverse acc
  else case fixDeclAt ts k (A.index ts k) of
    Just d -> fixDecls ts (k + 1) (Cons d acc)
    Nothing -> fixDecls ts (k + 1) acc

-- (where a declaration is, said: the file's place and its line; not
-- known, nothing)
placeOfLine : String -> Int -> String
placeOfLine "" line = ""
placeOfLine place line = place ^ ":" ^ showInt (line + 1)

groupOfDecl : String -> FixDecl -> Maybe F.Group
groupOfDecl place { ops = Nil } = Nothing
groupOfDecl place d@{ ops = Cons op rest } =
  Just
    { id = op.text
    , assoc = d.assoc
    , ops = List.map (\(u : L.Tok) -> u.text) d.ops
    , loosest = d.loosest
    , at = placeOfLine place d.line
    }

mapMaybeG : {a : Type} -> (F.Group -> a) -> Maybe F.Group -> Maybe a
mapMaybeG f Nothing = Nothing
mapMaybeG f (Just g) = Just (f g)

mkEdge : String -> String -> F.Edge
mkEdge t l = { tighter = t, looser = l }

edgesOf : F.Fixities -> FixDecl -> List F.Edge
edgesOf scope { ops = Nil } = Nil
edgesOf scope d@{ ops = Cons op rest } =
  appendS
    (catMaybesS
       (List.map
          (\(r : L.Tok) ->
             mapMaybeG (\g -> mkEdge op.text g.id) (F.groupOf scope r.text))
          d.above))
    -- (nothing is below the loosest: that is an error, not an edge)
    (catMaybesS
       (List.map
          (\(r : L.Tok) ->
             mapMaybeG (\g -> mkEdge g.id op.text) (F.groupOf scope r.text))
          (List.filter
             (\(r : L.Tok) -> not (F.loosestOf (F.groupOf scope r.text)))
             d.below)))

anyS : {a : Type} -> (a -> Bool) -> List a -> Bool
anyS p Nil = False
anyS p (Cons x xs) = p x || anyS p xs

anyGroupHas : F.Fixities -> L.Tok -> L.Tok -> Bool
anyGroupHas all g u =
  anyS
    (\(h : F.Group) ->
       not (strEq h.id g.text) && List.elemBy strEq u.text h.ops)
    all.groups

cycleDiag : F.Fixities -> FixDecl -> List Diag
cycleDiag all { ops = Nil } = Nil
cycleDiag all d@{ ops = Cons g rest } =
  appendS
    (List.map
       (\(u : L.Tok) ->
          diag (spanOf u) ("the fixity of `" ^ u.text ^ "` is declared twice"))
       (List.filter (\(u : L.Tok) -> anyGroupHas all g u) d.ops))
    (if F.bindsTighter all g.text g.text
       then Cons
           (diag
              d.span
              ("these fixities go round: `"
               ^ g.text
               ^ "` ends up above itself"))
           Nil
     else Nil)

-- (where a group is declared, said, in parentheses; not known, nothing)
declaredAt : String -> String
declaredAt "" = ""
declaredAt at = " (" ^ at ^ ")"

-- (`below` the loosest, `u`: what is declared below it, if it names it)
belowWhat : List L.Tok -> L.Tok -> String
belowWhat (Cons op _) u =
  "`"
  ^ op.text
  ^ "` cannot be declared below `"
  ^ u.text
  ^ "`: `"
  ^ u.text
  ^ "`"
belowWhat Nil u = "nothing can be declared below `" ^ u.text ^ "`: it"

belowLoosestDiag : FixDecl -> L.Tok -> F.Group -> Diag
belowLoosestDiag d u g =
  diag
    (spanOf u)
    (belowWhat d.ops u
     ^ " is the loosest operator, below every other, declared `below` with nothing after it"
     ^ declaredAt g.at)

-- | an operator declared below one of a group below all: the bottom has
-- | nothing below it
belowLoosest : F.Fixities -> FixDecl -> L.Tok -> Maybe Diag
belowLoosest scope d u =
  mapMaybeG (\g -> belowLoosestDiag d u g) (F.loosestGroup scope u.text)

noGroup : F.Fixities -> L.Tok -> Bool
noGroup scope u = case F.groupOf scope u.text of
  Just _ -> False
  Nothing -> True

fixDiagsOf : F.Fixities -> F.Fixities -> FixDecl -> List Diag
fixDiagsOf scope all d =
  appendS
    (List.map
       (\(u : L.Tok) ->
          diag (spanOf u) ("`" ^ u.text ^ "` is syntax, not an operator"))
       (List.filter
          (\(u : L.Tok) -> List.elemBy strEq u.text F.reserved)
          d.ops))
    (appendS
       (List.map
          (\(u : L.Tok) ->
             diag
               (spanOf u)
               ("`"
                ^ u.text
                ^ "` has no fixity to be above or below: declare it first"))
          (List.filter
             (\(u : L.Tok) -> noGroup scope u)
             (appendS d.above d.below)))
       (appendS
          (catMaybesS (List.map (\u -> belowLoosest scope d u) d.below))
          (appendS
             (if List.length d.ops == 0
                then Cons
                    (diag
                       d.span
                       "a fixity declaration names its operators: `infixl + -`")
                    Nil
              else Nil)
             (appendS d.errors (cycleDiag all d)))))

type FixRead = { fixities : F.Fixities, diags : List Diag }

fixityOut : F.Fixities -> List FixDecl -> List F.Group -> List F.Edge -> FixRead
fixityOut imported decls groups edges =
  { fixities = { groups = groups, above = edges }
  , diags =
      concatMapS
        (fixDiagsOf
           (F.union imported { groups = groups, above = Nil })
           (F.union imported { groups = groups, above = edges }))
        decls
  }

fixityDone : F.Fixities -> List FixDecl -> List F.Group -> FixRead
fixityDone imported decls groups =
  fixityOut
    imported
    decls
    groups
    (concatMapS
       (edgesOf (F.union imported { groups = groups, above = Nil }))
       decls)

fixityFrom : String -> F.Fixities -> List FixDecl -> FixRead
fixityFrom place imported decls =
  fixityDone
    imported
    decls
    (catMaybesS
       (List.map
          (\d -> groupOfDecl place d)
          (List.filter (\(d : FixDecl) -> not (List.length d.ops == 0)) decls)))

-- | the fixity declarations of a file, read before the rest (`place`: the
-- | file, said, `by prelude, at lib/prelude.hf`; else nothing)
fixityDecls : String -> F.Fixities -> Array L.Tok -> FixRead
fixityDecls place imported ts = fixityFrom place imported (fixDecls ts 0 Nil)

-- | a text's own fixities, read without the rest of it
fixitiesOfText : F.Fixities -> String -> F.Fixities
fixitiesOfText imported src =
  (fixityDecls "" imported (A.fromList (L.lex src).tokens)).fixities

-- The program loop
--------------------------------------------------------------------------------

type ProgRes = { items : List Item, diags : List Diag, broken : List String }

appendRev : {a : Type} -> List a -> List a -> List a
appendRev Nil acc = acc
appendRev (Cons x xs) acc = appendRev xs (Cons x acc)

brokenPlus : Maybe String -> List String -> List String
brokenPlus Nothing broken = broken
brokenPlus (Just x) broken = Cons x broken

mkProgRes : List Item -> List Diag -> List String -> ProgRes
mkProgRes items diags broken = { items = items, diags = diags, broken = broken }

-- | a declaration, lowered where nothing local is in scope
lowerDecl : C.D -> St -> Pair (Either Diag (List Item)) St
lowerDecl d s = lw.decl d (setScope Nil s)

-- | each declaration read (`cs`), then lowered (`s`); one that is wrong
-- | is passed over, the name it would define broken
progGo : C.St -> St -> List Item -> List Diag -> List String -> ProgRes
progGo cs s items diags broken =
  if C.textDone cs
    then mkProgRes
        (List.reverse items)
        (List.reverse diags)
        (List.reverse broken)
  else case C.declStep cs of
    MkPair (Left d) cs2 ->
      progGo
        (C.skipDecl cs2)
        s
        items
        (Cons d diags)
        (brokenPlus (C.declaredAt cs2) broken)
    MkPair (Right dc) cs2 -> case lowerDecl dc s of
      MkPair (Left d) s2 ->
        progGo
          (C.skipDecl cs2)
          s2
          items
          (Cons d diags)
          (brokenPlus (C.declaredAt cs2) broken)
      MkPair (Right ds) s2 ->
        if strEq (C.cur cs2).kind "eof"
          then progGo cs2 s2 (appendRev ds items) diags broken
        else progGo
            (C.skipDecl cs2)
            s2
            (appendRev ds items)
            (Cons
               (diag
                  (spanT (C.cur cs2))
                  ("unexpected `" ^ (C.cur cs2).text ^ "`"))
               diags)
            broken

-- Entry points
--------------------------------------------------------------------------------

-- | `place`: the file, said, `by prelude, at lib/prelude.hf` (where its
-- | fixities are declared, said with the line)
type Options =
  { known : String -> Bool
  , fixities : F.Fixities
  , lenient : Bool
  , place : String = ""
  }

type Read =
  { decls : List Notation.Decl
  , diags : List Diag
  , fixities : F.Fixities
  , broken : List String
  }

lexDiagOf : L.Err -> Diag
lexDiagOf e =
  { code = 150
  , severity = SError
  , msg = e.msg
  , span = { start = e.start, end = e.end }
  , note = Nothing
  }

-- | what is known: what the file imports, or `declared`, what it declares
knownOr : (String -> Bool) -> Mp.Map String Unit -> String -> Bool
knownOr known declared x = known x || isIn declared x

initialSt : Options -> Array C.T -> List String -> F.Fixities -> St
initialSt o toks declared own =
  mkSt
    toks
    Nil
    (knownOr o.known (nameSet declared))
    Mp.empty
    Nil
    (F.union o.fixities own)
    o.lenient

readPlaced : List Diag -> FixRead -> ProgRes -> Placed -> Read
readPlaced lexDiags own r placed =
  { decls = assemble r.broken (List.reverse placed.items)
  , diags =
      appendS
        lexDiags
        (appendS
           own.diags
           (appendS
              r.diags
              (appendS
                 (List.reverse placed.diags)
                 (assembleDiags r.broken r.items))))
  , fixities = own.fixities
  , broken = r.broken
  }

readOut : String -> List Diag -> FixRead -> ProgRes -> Read
readOut src lexDiags own r = readPlaced lexDiags own r (placeDocs src r.items)

readRun : String
        -> Options
        -> Array C.T
        -> List Diag
        -> List String
        -> FixRead
        -> Read
readRun src o toks lexDiags declared own =
  readOut
    src
    lexDiags
    own
    (progGo
       (C.initialSt toks)
       (initialSt o toks declared own.fixities)
       Nil
       Nil
       Nil)

readToks : String -> Options -> Array L.Tok -> Array C.T -> List Diag -> Read
readToks src o ltoks toks lexDiags =
  readRun
    src
    o
    toks
    lexDiags
    (prescan ltoks)
    (fixityDecls o.place o.fixities ltoks)

readLexed : String -> Options -> L.Lexed -> Read
readLexed src o l =
  readToks
    src
    o
    (A.fromList l.tokens)
    (Tk.plain l.tokens)
    (List.map lexDiagOf l.errors)

-- | `fixities`: those of what the file imports; the result's, the file's
-- | own.  `broken`: the declarations that do not parse.
readProgramWith : Options -> String -> Read
readProgramWith o src = readLexed src o (L.lex src)

-- | the program, as declarations the elaborator takes
readProgram : (String -> Bool) -> String -> Read
readProgram known src =
  readProgramWith
    { known = known, fixities = F.emptyFixities, lenient = False }
    src

-- | >>> List.length (readProgram noKnown "idInt : Int -> Int\nidInt x = x\n").decls
-- | 1
-- | >>> List.length (readProgram noKnown "data Color = Red | Green\n\nnext : Color -> Color\nnext c = case c of\n  Red -> Green\n  Green -> Red\n").decls
-- | 2
-- | >>> List.length (readProgram noKnown "x : Int\nx = ) oops\n").diags
-- | 1
noKnown : String -> Bool
noKnown x = False
