-- Operators and how they bind, declared relatively.  A group is named
-- by its first operator; binding tighter is transitive through `above`.
-- A group declared `below` with no operators (`infixr $ below`) is
-- `loosest`: below every group that is not -- the bottom, with nothing
-- below it.

module heff.syntax.fixity

data Assoc = AssocLeft | AssocRight | AssocNone

-- | `at`: where the group is declared, said (`by prelude, at
-- | lib/prelude.hf:94`), if it is known
type Group =
  { id : String
  , assoc : Assoc
  , ops : List String
  , loosest : Bool = False
  , at : String = ""
  }

type Edge = { tighter : String, looser : String }

-- | the groups, and which binds tighter than which (by groups' ids)
type Fixities = { groups : List Group, above : List Edge }

emptyFixities : Fixities
emptyFixities = { groups = Nil, above = Nil }

nubByG : List Group -> List Group
nubByG Nil = Nil
nubByG (Cons g rest) =
  Cons g (nubByG (List.keepIf (\(h : Group) -> not (strEq g.id h.id)) rest))

nubByE : List Edge -> List Edge
nubByE Nil = Nil
nubByE (Cons p rest) =
  Cons
    p
    (nubByE
       (List.keepIf
          (\(q : Edge) ->
             not (strEq p.tighter q.tighter && strEq p.looser q.looser))
          rest))

appendF : {a : Type} -> List a -> List a -> List a
appendF Nil ys = ys
appendF (Cons x xs) ys = Cons x (appendF xs ys)

-- | (the same group from two places is one)
union : Fixities -> Fixities -> Fixities
union a b =
  { groups = nubByG (appendF a.groups b.groups)
  , above = nubByE (appendF a.above b.above)
  }

findG : (Group -> Bool) -> List Group -> Maybe Group
findG p Nil = Nothing
findG p (Cons g rest) = if p g then Just g else findG p rest

groupOf : Fixities -> String -> Maybe Group
groupOf f op = findG (\g -> List.elemBy strEq op g.ops) f.groups

-- | how an operator is to the one after it, `a op b op' c`
data Relation = Tighter | Looser | Same Assoc | Unrelated | Undeclared String

loosestOf : Maybe Group -> Bool
loosestOf (Just g) = g.loosest
loosestOf Nothing = False

loosestIn : Maybe Group -> Maybe Group
loosestIn (Just g) = if g.loosest then Just g else Nothing
loosestIn Nothing = Nothing

-- | the group of an operator, if it is below all
loosestGroup : Fixities -> String -> Maybe Group
loosestGroup f op = loosestIn (groupOf f op)

-- | two operators, each of a group below all
bothLoosest : Fixities -> String -> String -> Bool
bothLoosest f op op' = loosestOf (groupOf f op) && loosestOf (groupOf f op')

-- | the groups below all
loosests : Fixities -> List String
loosests f =
  List.map
    (\(g : Group) -> g.id)
    (List.keepIf (\(g : Group) -> g.loosest) f.groups)

-- | the groups a group is directly above: those it is declared above,
-- | and those below all, unless it is one
losers : Fixities -> String -> List String
losers f head =
  appendF
    (List.map
       (\(p : Edge) -> p.looser)
       (List.keepIf (\(p : Edge) -> strEq p.tighter head) f.above))
    (if loosestOf (findG (\g -> strEq g.id head) f.groups) then Nil
     else loosests f)

-- | a group binds tighter than another (by their ids), through a chain
-- | of `above`
tighterGo : Fixities -> String -> List String -> List String -> Bool
tighterGo f to Nil seen = False
tighterGo f to (Cons head tail) seen =
  if List.elemBy strEq head seen then tighterGo f to tail seen
  else List.elemBy strEq to (losers f head)
    || tighterGo f to (appendF tail (losers f head)) (Cons head seen)

-- | >>> bindsTighter (union emptyFixities { groups = [{ id = "*", assoc = AssocLeft, ops = ["*"] }, { id = "+", assoc = AssocLeft, ops = ["+"] }, { id = "==", assoc = AssocNone, ops = ["=="] }], above = [{ tighter = "*", looser = "+" }, { tighter = "+", looser = "==" }] }) "*" "=="
-- | True
bindsTighter : Fixities -> String -> String -> Bool
bindsTighter f from to = tighterGo f to (Cons from Nil) Nil

-- | >>> relate { groups = [{ id = "+", assoc = AssocLeft, ops = ["+"] }, { id = "$", assoc = AssocRight, ops = ["$"], loosest = True }, { id = "<>", assoc = AssocRight, ops = ["<>"] }], above = [{ tighter = "+", looser = "<>" }] } "$" "<>"
-- | Looser
relate : Fixities -> String -> String -> Relation
relate f op op' = case groupOf f op of
  Nothing -> Undeclared op
  Just g -> case groupOf f op' of
    Nothing -> Undeclared op'
    Just g' ->
      if strEq g.id g'.id then Same g.assoc
      else if bindsTighter f g.id g'.id then Tighter
      else if bindsTighter f g'.id g.id then Looser
      else Unrelated

-- | symbols that are syntax, never operators
reserved : List String
reserved = ["->", ":", "=", "|", "<-", "\\", ":=", "=>", "."]
