-- The presyntax: what the lowering (`heff.syntax.surface`) gives, and what the
-- elaborator reads.  It comes in two layers.  `Expr` is the text as
-- written -- which names are variables and which are tags, operators
-- bound as the fixities say, signatures met with their equations; what
-- the tools read (the language server, the formatter).  `Checkable`,
-- `Inferable` and `TypeForm` are the same, each term in the judgment it
-- is elaborated by (`classify`): checked against a type, inferring one,
-- or a type -- what the elaborator reads.  A term in the wrong one is
-- `IInvalid`, there.  Each node is `Params.Spanned`: where it is written.
--
-- Types are defined one after another, so what a term holds is
-- parametric in the terms it holds, and the last type of each layer
-- closes the knot.  Notation that has no reading where it is written is
-- `EInvalid`, what to write instead (and a field, a setting or a variant
-- that is not one is `Bad...`): elaboration says so, there.

import heff.elab.fixed
import heff.elab.params as Params
import uint8 as UInt8

-- | the syntax's own words, written where a name could be: the built-in
-- | types and `abandon`
data SyntaxWord
  = TypeWord
  | IntWord
  | FloatWord
  | StringWord
  | RuneWord
  | ArrayWord
  | AbandonWord
  | FixedWord Fixed

-- Binaries
--------------------------------------------------------------------------------

-- | what a segment of a binary, `b[...]`, is: an integer (an `Int`),
-- | bytes (`binary`, `bytes`: a `Bytes`), bits (`bits`, `bitstring`: a
-- | `Bits`), a float (`float`: a `Float64`, IEEE's, of 64 or 32 bits),
-- | or a code point as UTF-8, UTF-16 or UTF-32 (`utf8`, `utf16`, `utf32`:
-- | written of an `Int` or a `Rune`, read as a `Rune`)
data SegmentType
  = SegmentInteger
  | SegmentBinary
  | SegmentBits
  | SegmentFloat
  | SegmentUtf Int

-- | a segment's size, in bits, its unit taken in: none (an integer's is
-- | 8 bits, a float's 64; bytes and bits are all there are -- in a
-- | pattern, all that are left; a code point's, its own), a number, or a
-- | name (in a pattern, one an earlier segment binds, else one in scope)
-- | times its unit
data SegmentSize
  = SizeDefault
  | SizeNumber Int
  | SizeName String Params.Span Int

-- | `v::spec`, a segment of a binary: its value (a string written is its
-- | UTF-8 bytes), what it is, its size, whether it is little-endian and
-- | whether signed
data Segment e = MkSegment e SegmentType SegmentSize Bool Bool

-- | the flags the prelude's `bytesIntAt` and `bytesOfInt` take: 1
-- | little-endian, 2 signed
segmentFlags : Bool -> Bool -> Int
segmentFlags little signed =
  (if little then 1 else 0) + (if signed then 2 else 0)

-- A binary is `Bits` where one of its segments is `bits`, or where its
-- segments' bits past whole bytes add up to no multiple of 8 -- or to
-- what is not known where it is elaborated: a size a name, of a unit
-- that is no multiple of 8, or bits all that are left; otherwise it is
-- `Bytes`.

-- | how many of a segment's bits are past whole bytes, where it is
-- | known
segmentOdd : SegmentType -> SegmentSize -> Maybe Int
segmentOdd SegmentBits SizeDefault = Nothing
segmentOdd ty SizeDefault = Just 0
segmentOdd ty (SizeNumber n) = Just (n % 8)
segmentOdd ty (SizeName _ _ unit) = if unit % 8 == 0 then Just 0 else Nothing

isBitsSegment : SegmentType -> Bool
isBitsSegment SegmentBits = True
isBitsSegment _ = False

segOdd : {e : Type} -> Params.Spanned (Segment e) -> Maybe Int
segOdd (At (MkSegment _ ty size _ _) _) = segmentOdd ty size

segBits : {e : Type} -> Params.Spanned (Segment e) -> Bool
segBits (At (MkSegment _ ty _ _ _) _) = isBitsSegment ty

-- (bits past whole bytes added up, after `acc`, where each is known)
oddSum : List (Maybe Int) -> Int -> Maybe Int
oddSum Nil acc = Just (acc % 8)
oddSum (Cons Nothing _) acc = Nothing
oddSum (Cons (Just n) rest) acc = oddSum rest (acc + n)

oddIsZero : Maybe Int -> Bool
oddIsZero (Just n) = n == 0
oddIsZero Nothing = False

-- | whether a binary of the segments is `Bits` (else it is `Bytes`)
isBitsBinary : {e : Type} -> List (Params.Spanned (Segment e)) -> Bool
isBitsBinary segs =
  List.any segBits segs || not (oddIsZero (oddSum (List.map segOdd segs) 0))

-- | whether each segment is whole bytes, and none `bits`: a binary that
-- | is read and written as bytes, never as bits
wholeByteSegments : {e : Type} -> List (Params.Spanned (Segment e)) -> Bool
wholeByteSegments segs =
  not (List.any segBits segs)
  && List.all (\m -> oddIsZero (segOdd m)) segs

-- (the `k` bytes of `u`, not negative, the most significant first,
-- after `acc`)
natBytes : Int -> Int -> String -> String
natBytes k u acc =
  if k <= 0 then acc
  else natBytes (k - 1) (u / 256) (fromByte (UInt8.fromInt (u % 256)) ^ acc)

-- (the bytes of `s`, the last first)
reversedBytes : String -> Int -> String -> String
reversedBytes s i acc =
  if i >= strLength s then acc
  else reversedBytes s (i + 1) (strSlice s i (i + 1) ^ acc)

-- (bytes, the most significant first, in the order a segment has them)
inOrder : Bool -> String -> String
inOrder True b = reversedBytes b 0 ""
inOrder False b = b

-- (2 to the `k`)
twoTo : Int -> Int
twoTo k = if k <= 0 then 1 else 2 * twoTo (k - 1)

-- | the integer `v`, its low `bits` bits (a multiple of 8), as a segment
-- | writes it: its bytes, the most significant first, or the least where
-- | `little`
-- | >>> integerBytes 16 False 16706
-- | "AB"
-- | >>> integerBytes 24 True 16706
-- | "BA\u{0}"
integerBytes : Int -> Bool -> Int -> String
integerBytes bits little v =
  inOrder
    little
    (natBytes (bits / 8) ((v % twoTo bits + twoTo bits) % twoTo bits) "")

-- | the code point `c`, a scalar value, as UTF-8, as `c::utf8` writes it
-- | >>> List.map (\c -> strLength (utf8Of c)) [65, 233, 8364, 128512]
-- | [1, 2, 3, 4]
utf8Of : Int -> String
utf8Of c =
  if c < 128 then natBytes 1 c ""
  else if c < 2048 then natBytes 2 ((192 + c / 64) * 256 + 128 + c % 64) ""
  else if c < 65536
  then natBytes
      3
      (((224 + c / 4096) * 256 + 128 + c / 64 % 64) * 256 + 128 + c % 64)
      ""
  else natBytes
      4
      ((((240 + c / 262144) * 256 + 128 + c / 4096 % 64) * 256
        + 128
        + c / 64 % 64)
       * 256
       + 128
       + c % 64)
      ""

-- | whether `c` is a Unicode scalar value, as a code point a segment
-- | writes is
isScalarValue : Int -> Bool
isScalarValue c = 0 <= c && c <= 1114111 && not (55296 <= c && c <= 57343)

-- Patterns
--------------------------------------------------------------------------------

-- | `x = p`, a field of a record pattern
data FieldPat p = MkFieldPat String p

-- | `PatTag`'s and `PatOp`'s span is the tag's or the operator's;
-- | `PatOp`, an operator applied, is the tag it is another name for once
-- | elaboration knows which
data PatF
  = PatVar String
  | PatTag String Params.Span (List (Params.Spanned PatF))
  | PatOp String Params.Span (List (Params.Spanned PatF))
  | PatInt Int
  | PatFloat Float64
  | PatString String
  -- | `b[...]`, a binary taken apart by its segments
  | PatBinary (List (Params.Spanned (Segment (Params.Spanned PatF))))
  -- | a rune literal, by its code point
  | PatRune Int
  | PatRecord (List (FieldPat (Params.Spanned PatF)))
  | PatWord SyntaxWord
  -- | `x@p`: `p`, the value it matches also named `x` (where `x` is)
  | PatAs String Params.Span (Params.Spanned PatF)

type Pat = Params.Spanned PatF

-- What an expression holds
--------------------------------------------------------------------------------

-- | a lambda's binder, `x`, `{x}` or `(x : T)`: the name, where it is
data LamBinder e
  = LamName String Params.Span
  | LamImplicit String Params.Span
  | LamAnn String Params.Span e

-- | a function type's binder, `(x : A)`, `{x : A}` (perhaps with its
-- | default, `{x : A := d}`), `{{x : A}}`, or a type alone: the name,
-- | where it is, where the braces are, its type `t` (and a default, a
-- | term `c`)
data PiBinder t c
  = PiNamed String Params.Span t
  | PiImplicit String Params.Span Params.Span t (Maybe c)
  | PiInstance String Params.Span Params.Span t
  | PiAnon t

-- | `p -> e`
data Alt e = MkAlt Pat e

-- | a statement of a `do` block: `x <- e`, `let p = e`, `e`, and `let
-- | mut x = e` (the name, where it is, what it is first; `let mut x : T =
-- | e` holds `(e : T)`)
data Stmt e
  = StmtBind String Params.Span e
  | StmtLet Pat e
  | StmtExpr e
  | StmtLetMut String Params.Span e

-- | statements, a block's or an arm's
type Stmts e = List (Params.Spanned (Stmt e))

-- | a `try` statement's `catch` arm: its binder (`x`, `(x : T)`), its
-- | statements
data CatchArm e = MkCatchArm (LamBinder e) (Stmts e)

-- | `try ... catch x -> ... finally ...`: the type of the throws its
-- | `catch` arm hears if given (`try (err := T)`), the statements tried,
-- | the `catch` arm and the `finally` block, either perhaps not there
data TryF e = MkTry (Maybe e) (Stmts e) (Maybe (CatchArm e)) (Maybe (Stmts e))

-- | `x : A` in a record type, and `x : A = d`, `d` its default (the
-- | types `t`, the default a term `c`)
data FieldDecl t c
  = DeclareField String Params.Span t (Maybe c)
  | BadFieldDecl t

-- | `x = e` in a record
data FieldSet e = SetField String Params.Span e | BadFieldSet e

-- | `x.y = e` in an update, `{ r | x.y = e }`: the path of fields (one,
-- | at least), each where it is, and the value
data UpdateSet e = SetPath (List (Pair String Params.Span)) e

-- | `C A B`, an alternative of a sum type: the tag, where it is, the
-- | types of its arguments
data Variant e = TagVariant String Params.Span (List e) | BadVariant e

-- | a parameter of a type or a theory, `a`, `(x : T)` or `{x : T}`
data Param e
  = ExplicitParam String Params.Span e
  | ImplicitParam String Params.Span e

-- | `f p ... = e`: the name, where it is, the patterns, the body
data Equation e = MkEquation String Params.Span (List Pat) e

-- | what a definition by equations is declared as: a definition, or an
-- | instance (`instance f : T`), which an instance argument after it may
-- | be found as
data Declared = AsDefinition | AsInstance

-- | a declaration, over terms `c` and types `t`: a definition by
-- | equations (its name, where it is, what it is declared as, its type,
-- | its equations); a `data` or `type` (its parameters, its universe, its
-- | body); a `theory` (its parameters, its fields, a record type); a
-- | primitive; a test; a watch (a doc test too)
data DeclF c t
  = DeclEquations String Params.Span Declared t (List
                                                   (Params.Spanned
                                                      (Equation c)))
  | DeclDefine String Params.Span (List (Params.Spanned (Param t))) t c
  | DeclTheory String Params.Span (List (Params.Spanned (Param t))) c
  | DeclPrimitive String Params.Span t
  | DeclTest String Params.Span
  | DeclWatch c

-- Expressions
--------------------------------------------------------------------------------

-- | `EImplicitVar`, a name the lowering writes, which the text does not
-- | (the `Bool` of `&&`); `EApp`'s arguments are its spine, `e.x`
-- | (`EProject`) and `(x := e)` (`ENamed`) among them; `ESpec`, `e ~ {
-- | x = v }` (the field, where its setting is, the value); `EUpdate`,
-- | `{ r | x = v }`, a record with fields replaced; `ELetIn`,
-- | `let p = e in e'`; `ELocal`, an equation's body and its local
-- | definitions
data ExprF
  = EVar String
  | EImplicitVar String
  | ETag String
  | EInt Int
  | EFloat Float64
  | EString String
  -- | `b[...]`, a binary: `Bytes`, made of its segments
  | EBinary (List (Params.Spanned (Segment (Params.Spanned ExprF))))
  | ERune Int
  | EWord SyntaxWord
  | EApp (Params.Spanned ExprF) (List (Params.Spanned ExprF))
  | EProject String
  | ENamed String (Params.Spanned ExprF)
  | EPi (PiBinder (Params.Spanned ExprF) (Params.Spanned ExprF)) (Params.Spanned
                                                                    ExprF)
  | ELam (LamBinder (Params.Spanned ExprF)) (Params.Spanned ExprF)
  | EAnn (Params.Spanned ExprF) (Params.Spanned ExprF)
  | ESpec (Params.Spanned ExprF) String Params.Span (Params.Spanned ExprF)
  | ESig (List
            (Params.Spanned
               (FieldDecl (Params.Spanned ExprF) (Params.Spanned ExprF))))
  | ESum (List (Params.Spanned (Variant (Params.Spanned ExprF))))
  | EStruct (List (Params.Spanned (FieldSet (Params.Spanned ExprF))))
  | EUpdate (Params.Spanned ExprF) (List
                                      (Params.Spanned
                                         (UpdateSet (Params.Spanned ExprF))))
  | EMatch (Params.Spanned ExprF) (List
                                     (Params.Spanned
                                        (Alt (Params.Spanned ExprF))))
  | ELetIn (Params.Spanned ExprF) (Params.Spanned (Alt (Params.Spanned ExprF)))
  | EDo (List (Params.Spanned (Stmt (Params.Spanned ExprF))))
  | ELocal (Params.Spanned ExprF) (List
                                     (Params.Spanned
                                        (DeclF
                                           (Params.Spanned ExprF)
                                           (Params.Spanned ExprF))))
  | EInvalid String
  -- A `do` block's statements (and its statements' arms, an `if`'s or a
  -- `case`'s), each nothing anywhere else: `x := e` (the variable, where
  -- it is, the value); `while c do ...`; `for p in e do ...`; `if c then
  -- s`, with no `else`; `break`; `continue`; `return e`; `try`.  And
  -- `(<- c)`, the value of an action where it is used, in a `do` block
  -- only.  `if let p = e then a else b` is a value too, and a statement
  -- without its `else`.
  | EAssign String Params.Span (Params.Spanned ExprF)
  | EWhile (Params.Spanned ExprF) (List
                                     (Params.Spanned
                                        (Stmt (Params.Spanned ExprF))))
  | EFor Pat (Params.Spanned ExprF) (List
                                       (Params.Spanned
                                          (Stmt (Params.Spanned ExprF))))
  | EIfThen (Params.Spanned ExprF) (Params.Spanned ExprF)
  | EBreak
  | EContinue
  | EReturn (Params.Spanned ExprF)
  | ENest (Params.Spanned ExprF)
  | EIfLet Pat (Params.Spanned ExprF) (Params.Spanned ExprF) (Maybe
                                                                (Params.Spanned
                                                                   ExprF))
  | ETry (TryF (Params.Spanned ExprF))

type Expr = Params.Spanned ExprF

type Decl = Params.Spanned (DeclF Expr Expr)

-- Building
--------------------------------------------------------------------------------

-- | from the start of one to the end of the other
spanning : Params.Span -> Params.Span -> Params.Span
spanning a b = { start = a.start, end = b.end }

-- (the last of `xs`, or `z` if there is none)
lastOr : {a : Type} -> a -> List a -> a
lastOr z Nil = z
lastOr z (Cons x Nil) = x
lastOr z (Cons x xs) = lastOr z xs

-- | `f` applied to `args`: an application's spine is one, however it is
-- | written (`(f x) y` is `f x y`)
app : Expr -> List Expr -> Expr
app f Nil = f
app (At (EApp h xs) sp) args =
  At
    (EApp h (List.append xs args))
    (spanning sp (Params.spanOf (lastOr h args)))
app f args =
  At (EApp f args) (spanning (Params.spanOf f) (Params.spanOf (lastOr f args)))

-- | an expression as a head applied to a spine (no spine, if it is no
-- | application)
type Spine = { head : Expr, args : List Expr }

-- | >>> (spineOf (app (app (At (EVar "f") Params.noSpan) [At (EVar "x") Params.noSpan]) [At (EVar "y") Params.noSpan])).args
-- | [At (EVar "x") { start = 0, end = 0 }, At (EVar "y") { start = 0, end = 0 }]
spineOf : Expr -> Spine
spineOf (At (EApp h xs) _) = { head = h, args = xs }
spineOf e = { head = e, args = Nil }

-- | a pattern as a head applied to its arguments
type PatSpine = { head : Pat, args : List Pat }

-- (a tag applied, or an operator: the head keeps the tag's or the
-- operator's span)
patSpineOf : Pat -> PatSpine
patSpineOf (At (PatTag t tsp ps) _) =
  { head = At (PatTag t tsp Nil) tsp, args = ps }
patSpineOf (At (PatOp x xsp ps) _) = { head = At (PatVar x) xsp, args = ps }
patSpineOf p = { head = p, args = Nil }

-- | `C ps`, its span from the tag to the last pattern
patTag : String -> Params.Span -> List Pat -> Pat
patTag t tsp ps =
  At
    (PatTag t tsp ps)
    (spanning tsp (Params.spanOf (lastOr (At (PatVar t) tsp) ps)))

-- | `op ps`, its span from the operator to the last pattern
patOp : String -> Params.Span -> List Pat -> Pat
patOp x xsp ps =
  At
    (PatOp x xsp ps)
    (spanning xsp (Params.spanOf (lastOr (At (PatVar x) xsp) ps)))

-- | `p -> e`, from the pattern to the body
alt : {a : Type}
    -> Pat
    -> Params.Spanned a
    -> Params.Spanned (Alt (Params.Spanned a))
alt p e = At (MkAlt p e) (spanning (Params.spanOf p) (Params.spanOf e))

-- | `\x -> e`, from the binder to the body
lamName : String -> Params.Span -> Expr -> Expr
lamName x xsp e = At (ELam (LamName x xsp) e) (spanning xsp (Params.spanOf e))

-- | `e : T`, from the one to the other
ann : Expr -> Expr -> Expr
ann e t = At (EAnn e t) (spanning (Params.spanOf e) (Params.spanOf t))

-- | the name a declaration defines (a watch defines none)
declName : {c t : Type} -> Params.Spanned (DeclF c t) -> Maybe String
declName (At (DeclEquations f _ _ _ _) _) = Just f
declName (At (DeclDefine x _ _ _ _) _) = Just x
declName (At (DeclTheory x _ _ _) _) = Just x
declName (At (DeclPrimitive x _ _) _) = Just x
declName (At (DeclTest x _) _) = Just x
declName (At (DeclWatch _) _) = Nothing

-- Terms in their judgments
--------------------------------------------------------------------------------

-- | an argument in an application's spine: a term, `.x`, `(x := e)`
data Arg c = ArgExplicit c | ArgProject String | ArgNamed String c

-- | a term that infers its type, over checkable terms `c` and types `t`:
-- | `IAnnLam`, `\(x : T) -> e` with `e` inferring; `IInvalid`, what is
-- | wrong here (its code, what to write, and a note: what to do)
data InferableF c t
  = IVar String
  | IInt Int
  | IFloat Float64
  | IString String
  -- | `Bytes`, a binary written whole: its bytes
  | IBytes String
  -- | the definition or primitive of the key `k`, whatever its name stands
  -- | for where it is (what a binary is made and taken apart by)
  | IPrim String
  | IRune Int
  | IApp (Params.Spanned (InferableF c t)) (List (Params.Spanned (Arg c)))
  | IAnn c t
  | ISpec (Params.Spanned (InferableF c t)) String Params.Span c
  -- | `{ r | x = v }`: of `r`'s type
  | IUpdate (Params.Spanned (InferableF c t)) (List
                                                 (Params.Spanned (UpdateSet c)))
  | IAnnLam String Params.Span t (Params.Spanned (InferableF c t))
  | IInvalid Int String (Maybe String)
  -- | in descriptive position: elaborated as nominal, its result marked
  -- | so (see "Descriptive positions")
  | INominal (Params.Spanned (InferableF c t))
  -- | `x`, at its span, matched by a literal pattern: whether it is equal
  -- | to the literal, by the equality of its type, or by `eq` where that
  -- | is not known (heff.elab.clauses makes it)
  | ILitEq String Params.Span String c

-- | a term checked against a type, over types `t`: `CInf`, a term that
-- | infers its type, checked against it; `CType`, a type, as an element
-- | of a universe; `CTag`, a tag applied
data CheckableF t
  = CInf (Params.Spanned (InferableF (Params.Spanned (CheckableF t)) t))
  | CType t
  | CLam String Params.Span (Params.Spanned (CheckableF t))
  | CImplicitLam String Params.Span (Params.Spanned (CheckableF t))
  | CAnnLam String Params.Span t (Params.Spanned (CheckableF t))
  | CTag String Params.Span (List (Params.Spanned (CheckableF t)))
  | CStruct (List (Params.Spanned (FieldSet (Params.Spanned (CheckableF t)))))
  | CMatch (Params.Spanned (InferableF (Params.Spanned (CheckableF t)) t)) (List
                                                                              (Params.Spanned
                                                                                 (Alt
                                                                                    (Params.Spanned
                                                                                       (CheckableF
                                                                                          t)))))
  | CLetIn (Params.Spanned
              (InferableF (Params.Spanned (CheckableF t)) t)) (Params.Spanned
                                                                 (Alt
                                                                    (Params.Spanned
                                                                       (CheckableF
                                                                          t))))
  | CLocal (Params.Spanned (CheckableF t)) (List
                                              (Params.Spanned
                                                 (DeclF
                                                    (Params.Spanned
                                                       (CheckableF t))
                                                    t)))
  | CAbandon
  | CNominal (Params.Spanned (CheckableF t))

-- | a type: `TInf`, a term that infers a universe; `TChk`, one checked
-- | against one
data TypeFormF
  = TPi (PiBinder
           (Params.Spanned TypeFormF)
           (Params.Spanned
              (CheckableF (Params.Spanned TypeFormF)))) (Params.Spanned
                                                           TypeFormF)
  | TSig (List
            (Params.Spanned
               (FieldDecl
                  (Params.Spanned TypeFormF)
                  (Params.Spanned (CheckableF (Params.Spanned TypeFormF))))))
  | TSum (List (Params.Spanned (Variant (Params.Spanned TypeFormF))))
  | TType
  | TInt
  | TFloat
  | TString
  | TRune
  | TArray (Params.Spanned TypeFormF)
  | TFixed Fixed
  | TInf (Params.Spanned
            (InferableF
               (Params.Spanned (CheckableF (Params.Spanned TypeFormF)))
               (Params.Spanned TypeFormF)))
  | TChk (Params.Spanned (CheckableF (Params.Spanned TypeFormF)))
  | TNominal (Params.Spanned TypeFormF)

type TypeForm = Params.Spanned TypeFormF

type Checkable = Params.Spanned (CheckableF TypeForm)

type Inferable = Params.Spanned (InferableF Checkable TypeForm)

-- | a declaration, its terms in their judgments
type Declaration = Params.Spanned (DeclF Checkable TypeForm)

-- | an inferring term as a head applied to its spine
type InfSpine =
  { head : Inferable, args : List (Params.Spanned (Arg Checkable)) }

infSpineOf : Inferable -> InfSpine
infSpineOf (At (IApp h xs) _) = { head = h, args = xs }
infSpineOf i = { head = i, args = Nil }

-- | `f args`, from the function to the last argument
infApp : Inferable -> List (Params.Spanned (Arg Checkable)) -> Inferable
infApp f args =
  At
    (IApp f args)
    (spanning
       (Params.spanOf f)
       (Params.spanOf (lastOr (At (ArgProject "") (Params.spanOf f)) args)))

-- | `\x -> e`, from the binder to the body
chkLam : String -> Params.Span -> Checkable -> Checkable
chkLam x xsp e = At (CLam x xsp e) (spanning xsp (Params.spanOf e))

-- | an inferring term, checked
chkOf : Inferable -> Checkable
chkOf i = At (CInf i) (Params.spanOf i)

-- Classifying
--------------------------------------------------------------------------------

-- A `do` block, taken apart
--------------------------------------------------------------------------------

-- A `do` block is taken apart through the `bind` and `pure` in scope,
-- by name (`run do`'s through the identity monad's, `idBind` and
-- `idPure`): `x <- e` and `e` are `bind e (\x -> ...)`, `let p = e` a
-- `let` over the statements after it; it ends with an expression.
--
-- Its imperative statements are taken apart into tail calls, so a loop
-- in any monad is a local tail-recursive function:
--
-- - a `let mut x` is a variable bound again at each `x := e` (`let x =
--   e in ...`), and a parameter of each function below;
-- - `while c do body` is a local function of the variables, `loop`,
--   whose body is `if c then body else after`, `after` a local function
--   of them too, of what follows the loop (a join point); `for p in e do
--   body` is the same, over the cursor of `e`'s `Iterate` (`iterateOf`,
--   the instance itself where each use is, so that its `Elem` is the
--   type it says), `loop` taking the cursor first and matching its `next`;
-- - in a loop's body, `continue` is the call of the next turn, `break`
--   the call of `after`, and the body's end the next turn; `return e`
--   is `pure e`, anywhere: every function above is in tail position, so
--   its answer is the block's;
-- - an `if` or a `case` among the statements, whose arms are
--   statements too (an arm's `do` block one of this block's statements),
--   calls a join point of the variables, what follows it, at each arm's
--   end -- where an arm does anything above, or has an action's value,
--   `(<- c)`; else it is an action, as any;
-- - `(<- c)` in a statement is a name bound by `bind c` before the
--   statement; in an `if` or a `case` used as a value (and `&&`, `||`,
--   which are `if`), the arm it is in is an action of its own, its
--   `(<- c)` bound at its start, the others `pure`, and the whole is the
--   statement's `(<- ...)`.  In a lambda it is an error: its body runs
--   later, so is `return`, `break`, and setting the block's variable
--   (which the lambda holds the value of);
-- - `if let p = e then a else b` is a `case` of `e`, `p` and `_`, as a
--   statement too (with no `else`, its arm is none);
-- - `try` is a scope (the scope module's `scoped`, around the exception
--   module's `recover` where there is a `catch` arm; with no `finally`,
--   the `recover` alone): its statements are one scope further in, and their
--   answer is what to do once it is left, which follows it (`leaveScope`).
--   Their end is `pure` of the call of what follows the `try` (a join
--   point), and a jump out of `k` scopes `pure` of what to do once the
--   next is left, `k` deep (`leaving`): each scope is released on the way
--   out, the innermost first, and the call made after, a tail call.  The
--   `finally` block is a computation of its own, of the variables as the
--   `try` began, which nothing leaves but its end.
--
-- A function's parameters are of its variables' types, `typeOf x`, and
-- what it gives is left to be found, `inferred MkUnit` (both the
-- prelude's, which the type they are of decides); the functions'
-- names, and the names bound for the values, are none the text can
-- write (`loop#12`, by the offset of what they are of).

-- | the names a `do` block is taken apart through
type DoNames = { bind : String, pure : String }

coNames : DoNames
coNames = { bind = "bind", pure = "pure" }

idNames : DoNames
idNames = { bind = "idBind", pure = "idPure" }

-- | a call of a local function above (a loop's next turn, what follows a
-- | loop, a join point), with the variables' values: the function (and
-- | the arguments before them), the variables, whether the function
-- | takes a `Unit` where there are none, and how many scopes (`try`) it
-- | is in
type Jump = { head : Expr, vars : List String, unit : Bool, depth : Int }

-- | where the statements are: the names, the variables (`let mut`) in
-- | scope, the innermost loop's `continue` and `break`, the block's span,
-- | how many scopes (`try`) they are in, whether they are a `finally`
-- | block's (which nothing leaves but its end), and the variables of the
-- | block around such a block, which it sees and cannot set
type DoCx =
  { names : DoNames
  , muts : List String
  , loop : Maybe (Pair Jump Jump)
  , sp : Params.Span
  , depth : Int
  , final : Bool
  , sealed : List String
  }

-- | what follows the statements' end: the last one's value is the
-- | block's (`EndValue`), or a call (`EndJump`)
data End = EndValue | EndJump Jump

-- (the variables' values passed, or a `Unit` for none)
varArgs : Params.Span -> Bool -> List String -> List Expr
varArgs sp True Nil = [At (ETag "MkUnit") sp]
varArgs sp unit vars = List.map (\x -> At (EVar x) sp) vars

callJump : Params.Span -> Jump -> Expr
callJump sp j = app j.head (varArgs sp j.unit j.vars)

-- | `\(_ : Unit) -> e`: what to do once a scope is left
thunkOf : Params.Span -> Expr -> Expr
thunkOf sp e = At (ELam (LamAnn "_" sp (At (EVar "Unit") sp)) e) sp

-- | a type to be found: the prelude's `inferred MkUnit`, whose implicit
-- | argument, the type, is left to the uses to solve
holeE : Params.Span -> Expr
holeE sp = app (At (EVar "inferred") sp) [At (ETag "MkUnit") sp]

-- | the type of the variable `x` in scope: the prelude's `typeOf x`
typeOfE : Params.Span -> String -> Expr
typeOfE sp x = app (At (EVar "typeOf") sp) [At (EVar x) sp]

-- (the variables as parameters, each of its variable's type where the
-- function is defined, or a `Unit`)
varParams : Params.Span -> Bool -> List String -> List (Pair Pat Expr)
varParams sp True Nil = [MkPair (At (PatVar "_") sp) (At (EVar "Unit") sp)]
varParams sp unit vars =
  List.map (\x -> MkPair (At (PatVar x) sp) (typeOfE sp x)) vars

-- | `f ps = body`, a local definition, its type to be found but for the
-- | number of its parameters
localFun : String -> Params.Span -> List (Pair Pat Expr) -> Expr -> Decl
localFun f sp ps body =
  At
    (DeclEquations
       f
       sp
       AsDefinition
       (List.foldr (\p t -> At (EPi (PiAnon (snd p)) t) sp) (holeE sp) ps)
       [At (MkEquation f sp (List.map fst ps) body) sp])
    sp

-- | `let x = v in body`
letVar : String -> Params.Span -> Expr -> Expr -> Expr
letVar x xsp v body =
  At
    (ELetIn v (alt (At (PatVar x) xsp) body))
    (spanning xsp (Params.spanOf body))

-- | `(e : _)`: checked at a type to be found (a tag, a record, as well
-- | as what infers its type)
annHole : Expr -> Expr
annHole e = At (EAnn e (holeE (Params.spanOf e))) (Params.spanOf e)

matchOf : Params.Span -> Expr -> List (Params.Spanned (Alt Expr)) -> Expr
matchOf sp s alts = At (EMatch s alts) sp

-- | a condition: a tag alone, `True`, infers no type, so it is the
-- | built-in `Bool`'s; any other is as it is (a module's own `Bool`
-- | is matched as well)
boolOf : Expr -> Expr
boolOf (At (ETag t) sp) = ann (At (ETag t) sp) (At (EVar "builtin.Bool") sp)
boolOf c = c

ifOf : Params.Span -> Expr -> Expr -> Expr -> Expr
ifOf sp c a b =
  matchOf
    sp
    (boolOf c)
    [alt (patTag "True" sp Nil) a, alt (patTag "False" sp Nil) b]

-- | `if let p = e then a else b`: a `case` of `e`, `p` and any other
ifLetOf : Params.Span -> Pat -> Expr -> Expr -> Expr -> Expr
ifLetOf sp p s a b = matchOf sp s [alt p a, alt (At (PatVar "_") sp) b]

pureOf : DoCx -> Params.Span -> Expr -> Expr
pureOf cx sp v = app (At (EVar cx.names.pure) sp) [v]

-- | `call`, from `n` scopes in: each scope's answer is what to do once it
-- | is left, `pure` of it, so `call` is made once all `n` are (each
-- | released on the way, the innermost first)
leaving : DoCx -> Params.Span -> Int -> Expr -> Expr
leaving cx sp n call =
  if n <= 0 then call
  else pureOf cx sp (thunkOf sp (annHole (leaving cx sp (n - 1) call)))

-- | a jump to a local function, from where the statements are
jumpCall : DoCx -> Params.Span -> Jump -> Expr
jumpCall cx sp j = leaving cx sp (cx.depth - j.depth) (callJump sp j)

doBind : DoCx -> Expr -> String -> Params.Span -> Expr -> Expr
doBind cx e x xsp rest =
  app (At (EVar cx.names.bind) cx.sp) [e, lamName x xsp rest]

badE : Params.Span -> String -> Expr
badE sp why = At (EInvalid why) sp

-- (a name of what is made at `sp`)
madeName : String -> Params.Span -> String
madeName what sp = what ^ "#" ^ show sp.start

-- | the variables a pattern binds
patNames : Pat -> List String
patNames (At (PatVar x) _) = if strEq x "_" then Nil else [x]
patNames (At (PatTag _ _ ps) _) = List.concatMap patNames ps
patNames (At (PatOp _ _ ps) _) = List.concatMap patNames ps
patNames (At (PatAs x _ q) _) = Cons x (patNames q)
patNames (At (PatRecord fs) _) =
  List.concatMap
    (\f -> case f of
     MkFieldPat _ q -> patNames q)
    fs
patNames _ = Nil

isMut : DoCx -> String -> Bool
isMut cx x = List.any (\y -> strEq x y) cx.muts

-- | a variable of the block, or of the block around a `finally` block
-- | (which no name bound in it may be either)
isSealed : DoCx -> String -> Bool
isSealed cx x = isMut cx x || List.any (\y -> strEq x y) cx.sealed

-- | a name bound again that is a variable of the block: refused (what
-- | `continue` passes on would not be the variable)
mutClash : String -> String
mutClash x =
  "`"
  ^ x
  ^ "` is a `let mut` variable here: name what is bound another name (or set the variable, `"
  ^ x
  ^ " := e`)"

-- (the first of the names that is a variable of the block)
firstMut : DoCx -> List String -> Maybe String
firstMut cx xs = List.find (\x -> isSealed cx x) xs

-- The expressions a statement holds, gone through in the order they are
-- written (and run), a state threaded through them

pairK : {a b c : Type} -> Pair a b -> (a -> b -> c) -> c
pairK (MkPair x y) k = k x y

-- (`y` before what `k` makes of the state)
consAfter : {s a : Type}
          -> Pair s a
          -> (s -> Pair s (List a))
          -> Pair s (List a)
consAfter (MkPair st y) k = pairK (k st) (\st2 ys -> MkPair st2 (Cons y ys))

accList : {s a : Type} -> (s -> a -> Pair s a) -> s -> List a -> Pair s (List a)
accList f st Nil = MkPair st Nil
accList f st (Cons x xs) = consAfter (f st x) (\st1 -> accList f st1 xs)

-- | each expression held at the top of a statement, by `f`
stmtAcc : {s : Type}
        -> (s -> Expr -> Pair s Expr)
        -> s
        -> Params.Spanned (Stmt Expr)
        -> Pair s (Params.Spanned (Stmt Expr))
stmtAcc f st (At (StmtBind x xsp e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (StmtBind x xsp e') sp))
stmtAcc f st (At (StmtLet p e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (StmtLet p e') sp))
stmtAcc f st (At (StmtExpr e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (StmtExpr e') sp))
stmtAcc f st (At (StmtLetMut x xsp e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (StmtLetMut x xsp e') sp))

altAcc : {s : Type}
       -> (s -> Expr -> Pair s Expr)
       -> s
       -> Params.Spanned (Alt Expr)
       -> Pair s (Params.Spanned (Alt Expr))
altAcc f st (At (MkAlt p e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (MkAlt p e') sp))

fieldSetAcc : {s : Type}
            -> (s -> Expr -> Pair s Expr)
            -> s
            -> Params.Spanned (FieldSet Expr)
            -> Pair s (Params.Spanned (FieldSet Expr))
fieldSetAcc f st (At (SetField x xsp e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (SetField x xsp e') sp))
fieldSetAcc f st (At (BadFieldSet e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (BadFieldSet e') sp))

updateSetAcc : {s : Type}
             -> (s -> Expr -> Pair s Expr)
             -> s
             -> Params.Spanned (UpdateSet Expr)
             -> Pair s (Params.Spanned (UpdateSet Expr))
updateSetAcc f st (At (SetPath path e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (SetPath path e') sp))

segmentAcc : {s : Type}
           -> (s -> Expr -> Pair s Expr)
           -> s
           -> Params.Spanned (Segment Expr)
           -> Pair s (Params.Spanned (Segment Expr))
segmentAcc f st (At (MkSegment v ty size little signed) sp) =
  pairK
    (f st v)
    (\st1 v' -> MkPair st1 (At (MkSegment v' ty size little signed) sp))

maybeAcc : {s a : Type}
         -> (s -> a -> Pair s a)
         -> s
         -> Maybe a
         -> Pair s (Maybe a)
maybeAcc f st Nothing = MkPair st Nothing
maybeAcc f st (Just x) = pairK (f st x) (\st1 x' -> MkPair st1 (Just x'))

catchAcc : {s : Type}
         -> (s -> Expr -> Pair s Expr)
         -> s
         -> CatchArm Expr
         -> Pair s (CatchArm Expr)
catchAcc f st (MkCatchArm b ss) =
  pairK (accList (stmtAcc f) st ss) (\st1 ss' -> MkPair st1 (MkCatchArm b ss'))

-- | each expression of a `try`'s statements, by `f` (its type, none)
tryAcc : {s : Type}
       -> (s -> Expr -> Pair s Expr)
       -> s
       -> TryF Expr
       -> Pair s (TryF Expr)
tryAcc f st (MkTry err body c fin) =
  pairK
    (accList (stmtAcc f) st body)
    (\st1 body' ->
       pairK
         (maybeAcc (catchAcc f) st1 c)
         (\st2 c' ->
            pairK
              (maybeAcc (accList (stmtAcc f)) st2 fin)
              (\st3 fin' -> MkPair st3 (MkTry err body' c' fin'))))

-- | the expressions an expression holds, by `f`, in the order they are
-- | written (a lambda's body, its own; a type, none)
childrenAcc : {s : Type}
            -> (s -> Expr -> Pair s Expr)
            -> s
            -> Expr
            -> Pair s Expr
childrenAcc f st (At (EApp h args) sp) =
  pairK
    (f st h)
    (\st1 h' ->
       pairK
         (accList f st1 args)
         (\st2 args' -> MkPair st2 (At (EApp h' args') sp)))
childrenAcc f st (At (ENamed x e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (ENamed x e') sp))
childrenAcc f st (At (ELam b body) sp) =
  pairK (f st body) (\st1 body' -> MkPair st1 (At (ELam b body') sp))
childrenAcc f st (At (EAnn e t) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (EAnn e' t) sp))
childrenAcc f st (At (ESpec a x xsp v) sp) =
  pairK
    (f st a)
    (\st1 a' ->
       pairK (f st1 v) (\st2 v' -> MkPair st2 (At (ESpec a' x xsp v') sp)))
childrenAcc f st (At (EStruct fs) sp) =
  pairK
    (accList (fieldSetAcc f) st fs)
    (\st1 fs' -> MkPair st1 (At (EStruct fs') sp))
childrenAcc f st (At (EUpdate a fs) sp) =
  pairK
    (f st a)
    (\st1 a' ->
       pairK
         (accList (updateSetAcc f) st1 fs)
         (\st2 fs' -> MkPair st2 (At (EUpdate a' fs') sp)))
childrenAcc f st (At (EBinary segs) sp) =
  pairK
    (accList (segmentAcc f) st segs)
    (\st1 segs' -> MkPair st1 (At (EBinary segs') sp))
childrenAcc f st (At (EMatch s alts) sp) =
  pairK
    (f st s)
    (\st1 s' ->
       pairK
         (accList (altAcc f) st1 alts)
         (\st2 alts' -> MkPair st2 (At (EMatch s' alts') sp)))
childrenAcc f st (At (ELetIn rhs a) sp) =
  pairK
    (f st rhs)
    (\st1 rhs' ->
       pairK (altAcc f st1 a) (\st2 a' -> MkPair st2 (At (ELetIn rhs' a') sp)))
childrenAcc f st (At (EDo ss) sp) =
  pairK (accList (stmtAcc f) st ss) (\st1 ss' -> MkPair st1 (At (EDo ss') sp))
childrenAcc f st (At (EAssign x xsp e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (EAssign x xsp e') sp))
childrenAcc f st (At (EWhile c body) sp) =
  pairK
    (f st c)
    (\st1 c' ->
       pairK
         (accList (stmtAcc f) st1 body)
         (\st2 body' -> MkPair st2 (At (EWhile c' body') sp)))
childrenAcc f st (At (EFor p c body) sp) =
  pairK
    (f st c)
    (\st1 c' ->
       pairK
         (accList (stmtAcc f) st1 body)
         (\st2 body' -> MkPair st2 (At (EFor p c' body') sp)))
childrenAcc f st (At (EIfThen c a) sp) =
  pairK
    (f st c)
    (\st1 c' -> pairK (f st1 a) (\st2 a' -> MkPair st2 (At (EIfThen c' a') sp)))
childrenAcc f st (At (EReturn e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (EReturn e') sp))
childrenAcc f st (At (ENest e) sp) =
  pairK (f st e) (\st1 e' -> MkPair st1 (At (ENest e') sp))
childrenAcc f st (At (EIfLet p s a b) sp) =
  pairK
    (f st s)
    (\st1 s' ->
       pairK
         (f st1 a)
         (\st2 a' ->
            pairK
              (maybeAcc f st2 b)
              (\st3 b' -> MkPair st3 (At (EIfLet p s' a' b') sp))))
childrenAcc f st (At (ETry tr) sp) =
  pairK (tryAcc f st tr) (\st1 tr' -> MkPair st1 (At (ETry tr') sp))
childrenAcc f st e = MkPair st e

-- | the expressions an expression holds, each by `f`
mapChildren : (Expr -> Expr) -> Expr -> Expr
mapChildren f e = snd (childrenAcc (\u c -> MkPair u (f c)) (MkUnit : Unit) e)

-- | whether an expression holds `(<- c)` to bind before it (not in a
-- | lambda or a `do` block of its own)
hasNest : Expr -> Bool
hasNest (At (ENest _) _) = True
hasNest (At (ELam _ _) _) = False
hasNest (At (EDo _) _) = False
hasNest (At (ETry _) _) = False
hasNest e = fst (childrenAcc (\b c -> MkPair (b || hasNest c) c) False e)

-- What a closure may not do: in a lambda's body, `(<- c)`, `return`,
-- `break` and `continue` (not of a `do` block of its own); in a lambda,
-- or in a `do` block of its own, set a variable of the block around

-- | the variables of the blocks around, and whether in a lambda
type Guard = { muts : List String, inLam : Bool }

-- (the variables a block declares, `let mut`)
declaredMuts : List (Params.Spanned (Stmt Expr)) -> List String
declaredMuts Nil = Nil
declaredMuts (Cons (At (StmtLetMut x _ _) _) rest) = Cons x (declaredMuts rest)
declaredMuts (Cons _ rest) = declaredMuts rest

guardE : Guard -> Expr -> Expr
guardE g (At (ENest c) sp) =
  if g.inLam
  then badE
      sp
      "`(<- c)` is in a lambda, whose body runs later, not where the statement does: bind the action's value before, `x <- c`"
  else At (ENest (guardE g c)) sp
guardE g (At (EReturn v) sp) =
  if g.inLam
  then badE
      sp
      "`return` is in a lambda: it ends the `do` block it is a statement of, and a lambda's body is no statement"
  else At (EReturn (guardE g v)) sp
guardE g (At EBreak sp) =
  if g.inLam
  then badE
      sp
      "`break` is in a lambda: a loop's statements are its body's, and a lambda's body is none of them"
  else At EBreak sp
guardE g (At EContinue sp) =
  if g.inLam
  then badE
      sp
      "`continue` is in a lambda: a loop's statements are its body's, and a lambda's body is none of them"
  else At EContinue sp
guardE g (At (EAssign x xsp v) sp) =
  if List.any (\y -> strEq x y) g.muts
  then badE
      xsp
      ("`"
       ^ x
       ^ "` is a `let mut` variable of the `do` block around: a closure (a lambda, or a `do` block of its own) holds its value, and cannot set it")
  else At (EAssign x xsp (guardE g v)) sp
guardE g (At (ELam b body) sp) =
  At (ELam b (guardE { muts = g.muts, inLam = True } body)) sp
guardE g (At (EDo ss) sp) =
  mapChildren
    (guardE
       { muts =
           List.filter
             (\x -> not (List.any (\y -> strEq x y) (declaredMuts ss)))
             g.muts
       , inLam = False
       })
    (At (EDo ss) sp)
guardE g e = mapChildren (guardE g) e

-- The values of actions, `(<- c)`, bound before what holds them: a
-- statement's are bound before it, in the order they are written (each
-- a name and the action, the last first)

type Bound = List (Pair String Expr)

-- | `binds`, each around the next, `inner` innermost
wrapBinds : DoCx -> Bound -> Expr -> Expr
wrapBinds cx binds inner =
  List.foldl
    (\acc b -> doBind cx (snd b) (fst b) (Params.spanOf (snd b)) acc)
    inner
    binds

-- | an arm as an action of its own: its `(<- c)` bound at its start
-- | (by `lift`), then `pure` of it
asAction : (Bound -> Expr -> Pair Bound Expr) -> DoCx -> Expr -> Expr
asAction lift cx b =
  pairK
    (lift Nil b)
    (\bs b' -> wrapBinds cx bs (pureOf cx (Params.spanOf b') b'))

altHasNest : Params.Spanned (Alt Expr) -> Bool
altHasNest (At (MkAlt _ b) _) = hasNest b

-- (an arm made by `f`)
altBy : (Expr -> Expr) -> Params.Spanned (Alt Expr) -> Params.Spanned (Alt Expr)
altBy f (At (MkAlt p b) sp) = At (MkAlt p (f b)) sp

-- | an expression's `(<- c)` lifted out of it, the guard said for its
-- | lambdas and `do` blocks of their own: what to bind before it, and it
type Lift = { cx : DoCx, guard : Guard }

liftE : Lift -> Bound -> Expr -> Pair Bound Expr
liftE l acc (At (ENest c) sp) =
  pairK
    (liftE l acc c)
    (\acc1 c' ->
       MkPair
         (Cons (MkPair (madeName "v" sp) c') acc1)
         (At (EVar (madeName "v" sp)) sp))
liftE l acc (At (ELam b body) sp) =
  MkPair acc (guardE l.guard (At (ELam b body) sp))
liftE l acc (At (EDo ss) sp) = MkPair acc (guardE l.guard (At (EDo ss) sp))
-- (an arm that holds one is an action of its own, `pure` the others':
-- the whole, the statement's `(<- ...)`)
liftE l acc (At (EMatch s alts) sp) =
  pairK
    (liftE l acc s)
    (\acc1 s' ->
       if List.any altHasNest alts
       then MkPair
           (Cons
              (MkPair
                 (madeName "v" sp)
                 (At
                    (EMatch
                       s'
                       (List.map (altBy (asAction (liftE l) l.cx)) alts))
                    sp))
              acc1)
           (At (EVar (madeName "v" sp)) sp)
       else pairK
           (accList (altAcc (liftE l)) acc1 alts)
           (\acc2 alts' -> MkPair acc2 (At (EMatch s' alts') sp)))
liftE l acc (At (ELetIn rhs (At (MkAlt p body) asp)) sp) =
  pairK
    (liftE l acc rhs)
    (\acc1 rhs' ->
       if hasNest body
       then MkPair
           (Cons
              (MkPair
                 (madeName "v" sp)
                 (At
                    (ELetIn
                       rhs'
                       (At (MkAlt p (asAction (liftE l) l.cx body)) asp))
                    sp))
              acc1)
           (At (EVar (madeName "v" sp)) sp)
       else pairK
           (liftE l acc1 body)
           (\acc2 body' ->
              MkPair acc2 (At (ELetIn rhs' (At (MkAlt p body') asp)) sp)))
liftE l acc (At (EIfLet p s a (Just b)) sp) = liftE l acc (ifLetOf sp p s a b)
liftE l acc (At (ETry tr) sp) = MkPair acc (At (ETry tr) sp)
liftE l acc e = childrenAcc (liftE l) acc e

-- | `k` of the expression, its `(<- c)` bound before
hoist : DoCx -> Expr -> (Expr -> Expr) -> Expr
hoist cx e k =
  pairK
    (liftE { cx = cx, guard = { muts = cx.muts, inLam = False } } Nil e)
    (\bs e' -> wrapBinds cx bs (k e'))

-- Statements

-- | an arm's statements: a `do` block's, or the one
armStmts : Expr -> List (Params.Spanned (Stmt Expr))
armStmts (At (EDo ss) _) = ss
armStmts e = [At (StmtExpr e) (Params.spanOf e)]

-- (whether a statement of an arm does what an action cannot: `ctl`,
-- `isControl`)
stmtNeeds : (Expr -> Bool) -> Params.Spanned (Stmt Expr) -> Bool
stmtNeeds ctl (At (StmtExpr e) _) = ctl e || hasNest e
stmtNeeds ctl (At (StmtBind _ _ e) _) = hasNest e
stmtNeeds ctl (At (StmtLet _ e) _) = hasNest e
stmtNeeds ctl (At (StmtLetMut _ _ _) _) = True

armNeeds : (Expr -> Bool) -> Params.Spanned (Alt Expr) -> Bool
armNeeds ctl (At (MkAlt _ b) _) = List.any (stmtNeeds ctl) (armStmts b)

-- | whether a statement is one of the block's own (not an action): `x :=
-- | e`, a loop, a jump, `return`, an `if` without `else`, an `if` or a
-- | `case` whose arms are
isControl : Expr -> Bool
isControl (At (EAssign _ _ _) _) = True
isControl (At (EWhile _ _) _) = True
isControl (At (EFor _ _ _) _) = True
isControl (At (EIfThen _ _) _) = True
isControl (At EBreak _) = True
isControl (At EContinue _) = True
isControl (At (EReturn _) _) = True
isControl (At (EMatch _ alts) _) = List.any (armNeeds isControl) alts
isControl (At (EIfLet _ _ _ Nothing) _) = True
isControl (At (EIfLet p s a (Just b)) sp) = isControl (ifLetOf sp p s a b)
isControl (At (ETry _) _) = True
isControl _ = False

-- | an arm of an `if` or a `case` of statements: its pattern, its
-- | statements
altStmts : Params.Spanned (Alt Expr)
         -> Pair Pat (List (Params.Spanned (Stmt Expr)))
altStmts (At (MkAlt p b) _) = MkPair p (armStmts b)

-- | the statements, taken apart, knotted
type DoT = { stmts : DoCx -> List (Params.Spanned (Stmt Expr)) -> End -> Expr }

-- | what the statements' end leads to
endOf : DoCx -> Params.Span -> End -> Expr
endOf cx sp EndValue =
  leaving cx sp cx.depth (pureOf cx sp (At (ETag "MkUnit") sp))
endOf cx sp (EndJump j) = jumpCall cx sp j

withMut : DoCx -> String -> DoCx
withMut cx x =
  { names = cx.names
  , muts = List.append cx.muts [x]
  , loop = cx.loop
  , sp = cx.sp
  , depth = cx.depth
  , final = cx.final
  , sealed = cx.sealed
  }

withLoop : DoCx -> Jump -> Jump -> DoCx
withLoop cx cont brk =
  { names = cx.names
  , muts = cx.muts
  , loop = Just (MkPair cont brk)
  , sp = cx.sp
  , depth = cx.depth
  , final = cx.final
  , sealed = cx.sealed
  }

-- | the statements of a scope (`try`), one further in
inScope : DoCx -> DoCx
inScope cx =
  { names = cx.names
  , muts = cx.muts
  , loop = cx.loop
  , sp = cx.sp
  , depth = cx.depth + 1
  , final = cx.final
  , sealed = cx.sealed
  }

-- | a `finally` block's statements: a computation of their own, no
-- | variables of their own yet, the block's seen and not set, nothing to
-- | jump to
finalCx : DoCx -> DoCx
finalCx cx =
  { names = cx.names
  , muts = Nil
  , loop = Nothing
  , sp = cx.sp
  , depth = 0
  , final = True
  , sealed = List.append cx.muts cx.sealed
  }

-- | what leaves a `finally` block, refused
leavesFinally : String -> String
leavesFinally what =
  what
  ^ " is in a `finally` block: it runs as the `try` is left, however that is, and goes on to where that was going -- it is left at its end only"

-- | `break` or `continue`: the call it is, the last of its statements
jumpTo : DoCx
       -> Params.Span
       -> List (Params.Spanned (Stmt Expr))
       -> Maybe Jump
       -> String
       -> Expr
jumpTo cx sp (Cons s _) j what =
  badE
    (Params.spanOf s)
    ("nothing after " ^ what ^ " runs: it is the last statement")
jumpTo cx sp Nil (Just j) what = jumpCall cx sp j
jumpTo cx sp Nil Nothing what =
  if cx.final then badE sp (leavesFinally what)
  else badE
      sp
      (what ^ " is in a loop only: `while c do ...`, `for x in e do ...`")

continueOf : Maybe (Pair Jump Jump) -> Maybe Jump
continueOf (Just (MkPair c b)) = Just c
continueOf Nothing = Nothing

breakOf : Maybe (Pair Jump Jump) -> Maybe Jump
breakOf (Just (MkPair c b)) = Just b
breakOf Nothing = Nothing

-- | an arm of an `if` or a `case` of statements: its pattern, and its
-- | statements up to `end`
armT : DoT
     -> DoCx
     -> End
     -> Pair Pat (List (Params.Spanned (Stmt Expr)))
     -> Params.Spanned (Alt Expr)
armT t cx end (MkPair p ss) = case firstMut cx (patNames p) of
  Just x -> alt p (badE (Params.spanOf p) (mutClash x))
  Nothing -> alt p (t.stmts cx ss end)

-- (a `catch` arm's statements, if there is one)
catchStmts : Maybe (CatchArm Expr) -> List (Params.Spanned (Stmt Expr))
catchStmts Nothing = Nil
catchStmts (Just (MkCatchArm _ ss)) = ss

-- | whether statements may reach their end: not if the last is a jump,
-- | `return`, an `if` or a `case` of statements none of whose arms does
-- | (`isControl`'s), or a `try` neither whose statements nor whose
-- | `catch` arm does
stmtsFall : List (Params.Spanned (Stmt Expr)) -> Bool
stmtsFall ss = case List.last ss of
  Just (At (StmtExpr e) _) -> exprFalls e
  _ -> True
  where
  exprFalls : Expr -> Bool
  exprFalls (At EBreak _) = False
  exprFalls (At EContinue _) = False
  exprFalls (At (EReturn _) _) = False
  exprFalls (At (EMatch s alts) sp) =
    not (isControl (At (EMatch s alts) sp))
    || List.any (\a -> stmtsFall (snd (altStmts a))) alts
  exprFalls (At (EIfLet p s a (Just b)) sp) = exprFalls (ifLetOf sp p s a b)
  exprFalls (At (ETry (MkTry _ body Nothing _)) _) = stmtsFall body
  exprFalls (At (ETry (MkTry _ body c _)) _) =
    stmtsFall body || stmtsFall (catchStmts c)
  exprFalls _ = True

-- (an arm that reaches its end and binds nothing the statements after
-- it could see: they may go on in it)
bindsNothing : Pair Pat (List (Params.Spanned (Stmt Expr))) -> Bool
bindsNothing (MkPair p ss) =
  List.null (patNames p)
  && List.all
    (\s -> case s of
     At (StmtExpr _) _ -> True
     _ -> False)
    ss

-- (one arm reaches its end, and binds nothing)
oneFalls : List (Pair Pat (List (Params.Spanned (Stmt Expr)))) -> Bool
oneFalls (Cons a Nil) = bindsNothing a
oneFalls _ = False

-- (the arm `rest` goes on in, or another)
armOn : DoT
      -> DoCx
      -> List (Params.Spanned (Stmt Expr))
      -> End
      -> Pair Pat (List (Params.Spanned (Stmt Expr)))
      -> Params.Spanned (Alt Expr)
armOn t cx rest end (MkPair p ss) =
  if stmtsFall ss then armT t cx end (MkPair p (List.append ss rest))
  else armT t cx end (MkPair p ss)

-- | an `if` or a `case` of statements: each arm up to what follows it, a
-- | join point of the variables, called at the end of each arm that
-- | reaches it -- but where one arm alone does, and binds nothing,
-- | what follows goes on in it (`if c then continue` is an `else`)
condT : DoT
      -> DoCx
      -> Params.Span
      -> Expr
      -> List (Pair Pat (List (Params.Spanned (Stmt Expr))))
      -> List (Params.Spanned (Stmt Expr))
      -> End
      -> Expr
condT t cx sp s arms Nil end =
  hoist cx s (\s' -> matchOf sp s' (List.map (armT t cx end) arms))
condT t cx sp s arms rest end =
  if oneFalls (List.filter (\a -> stmtsFall (snd a)) arms)
  then hoist cx s (\s' -> matchOf sp s' (List.map (armOn t cx rest end) arms))
  else hoist
      cx
      s
      (\s' ->
         At
           (ELocal
              (matchOf
                 sp
                 s'
                 (List.map
                    (armT
                       t
                       cx
                       (EndJump
                          { head = At (EVar (madeName "join" sp)) sp
                          , vars = cx.muts
                          , unit = True
                          , depth = cx.depth
                          }))
                    arms))
              [ localFun
                (madeName "join" sp)
                sp
                (varParams sp True cx.muts)
                (t.stmts cx rest end)
              ])
           sp)

-- | `while c do body`: `loop`, the next turn, and `after`, what follows
whileT : DoT
       -> DoCx
       -> Params.Span
       -> Expr
       -> List (Params.Spanned (Stmt Expr))
       -> List (Params.Spanned (Stmt Expr))
       -> End
       -> Expr
whileT t cx sp c body rest end =
  At
    (ELocal
       (callJump sp loopJ)
       [ localFun
         (madeName "after" sp)
         sp
         (varParams sp True cx.muts)
         (t.stmts cx rest end)
       , localFun
         (madeName "loop" sp)
         sp
         (varParams sp True cx.muts)
         (hoist
            cx
            c
            (\c' ->
               ifOf
                 sp
                 c'
                 (t.stmts (withLoop cx loopJ afterJ) body (EndJump loopJ))
                 (callJump sp afterJ)))
       ])
    sp
  where
  loopJ : Jump
  loopJ =
    { head = At (EVar (madeName "loop" sp)) sp
    , vars = cx.muts
    , unit = True
    , depth = cx.depth
    }
  afterJ : Jump
  afterJ =
    { head = At (EVar (madeName "after" sp)) sp
    , vars = cx.muts
    , unit = True
    , depth = cx.depth
    }

-- | `for p in e do body`: `e` bound once, its `Iterate` found for it,
-- | `loop` of the cursor and the variables, `after` of the variables
forT : DoT
     -> DoCx
     -> Params.Span
     -> Pat
     -> Expr
     -> List (Params.Spanned (Stmt Expr))
     -> List (Params.Spanned (Stmt Expr))
     -> End
     -> Expr
forT t cx sp p coll body rest end =
  hoist
    cx
    coll
    (\c' ->
       letVar
         (madeName "coll" sp)
         sp
         (annHole c')
         (letVar
            (madeName "next" sp)
            sp
            (app it [At (EProject "next") sp])
            (At
               (ELocal
                  (app
                     (var "loop")
                     (Cons
                        (app it [At (EProject "start") sp, var "coll"])
                        (varArgs sp False cx.muts)))
                  [ localFun
                    (madeName "after" sp)
                    sp
                    (varParams sp True cx.muts)
                    (t.stmts cx rest end)
                  , localFun
                    (madeName "loop" sp)
                    sp
                    (Cons
                       (MkPair
                          (At (PatVar (madeName "cursor" sp)) sp)
                          (app it [At (EProject "Cursor") sp]))
                       (varParams sp False cx.muts))
                    (matchOf
                       sp
                       (app (var "next") [var "cursor"])
                       [ alt (patTag "Nothing" sp Nil) (callJump sp afterJ)
                       , alt
                             (patTag
                                "Just"
                                sp
                                [ patTag
                                  "MkPair"
                                  sp
                                  [p, At (PatVar (madeName "rest" sp)) sp]
                                ]) (case firstMut cx (patNames p) of
                           Just x -> badE (Params.spanOf p) (mutClash x)
                           Nothing ->
                             t.stmts
                               (withLoop cx nextJ afterJ)
                               body
                               (EndJump nextJ))
                       ])
                  ])
               sp)))
  where
  var : String -> Expr
  var what = At (EVar (madeName what sp)) sp
  -- (the collection's `Iterate`, found where each use is: the instance
  -- itself, so that its `Elem` is the type it says; its `next` is bound
  -- once, outside the loop, which then holds no collection)
  it : Expr
  it = app (At (EVar "iterateOf") sp) [var "coll"]
  afterJ : Jump
  afterJ = { head = var "after", vars = cx.muts, unit = True, depth = cx.depth }
  nextJ : Jump
  nextJ =
    { head = app (var "loop") [var "rest"]
    , vars = cx.muts
    , unit = False
    , depth = cx.depth
    }

-- (the names a `catch` arm's binder binds, and where it is)
binderNames : LamBinder Expr -> List String
binderNames (LamName x _) = if strEq x "_" then Nil else [x]
binderNames (LamImplicit x _) = [x]
binderNames (LamAnn x _ _) = if strEq x "_" then Nil else [x]

binderSpan : LamBinder Expr -> Params.Span
binderSpan (LamName _ sp) = sp
binderSpan (LamImplicit _ sp) = sp
binderSpan (LamAnn _ sp _) = sp

-- | a `catch` arm: the handler of what is thrown, its statements up to
-- | `end`
catchT : DoT -> DoCx -> Params.Span -> End -> CatchArm Expr -> Expr
catchT t cx sp end (MkCatchArm b ss) = At (ELam b (t.stmts cx ss end)) sp

-- | what is wrong with a `catch` arm's binder, if anything: an implicit
-- | one, or one that names a variable of the block
catchWrong : DoCx -> Maybe (CatchArm Expr) -> Maybe Expr
catchWrong cx Nothing = Nothing
catchWrong cx (Just (MkCatchArm (LamImplicit x xsp) _)) =
  Just
    (badE
       xsp
       "what a `catch` arm hears is its argument: `catch x -> ...`, or `catch (x : T) -> ...`")
catchWrong cx (Just (MkCatchArm b _)) =
  maybe
    Nothing
    (\x -> Just (badE (binderSpan b) (mutClash x)))
    (firstMut cx (binderNames b))

-- | a `finally` block: the scope's release, its statements, then `pure
-- | MkUnit`
finallyT : DoT -> DoCx -> List (Params.Spanned (Stmt Expr)) -> Expr
finallyT t cx ss =
  t.stmts
    (finalCx cx)
    ss
    (EndJump
       { head = At (EVar cx.names.pure) cx.sp
       , vars = Nil
       , unit = True
       , depth = 0
       })

-- (the type of what the `catch` arm hears given, `(err := T)`, as an
-- argument)
errArgs : Params.Span -> Maybe Expr -> List Expr
errArgs sp Nothing = Nil
errArgs sp (Just ty) = [At (ENamed "err" ty) (Params.spanOf ty)]

-- | the statements tried, heard by the `catch` arm if there is one (the
-- | exception module's `recover`)
heardT : DoT
       -> DoCx
       -> Params.Span
       -> End
       -> Maybe Expr
       -> Expr
       -> Maybe (CatchArm Expr)
       -> Expr
heardT t cx sp end err tried Nothing = tried
heardT t cx sp end err tried (Just h) =
  app
    (At (EVar "recover") sp)
    (List.append (errArgs sp err) [tried, catchT t cx sp end h])

-- | what a `try` runs, one scope in, each part up to `end`: the
-- | statements tried, heard by the `catch` arm, released by the `finally`
-- | block (the scope module's `scoped`, acquiring nothing) -- its answer,
-- | what to do once it is left
tryHeard : DoT
         -> DoCx
         -> Params.Span
         -> End
         -> Maybe Expr
         -> Expr
         -> Maybe (CatchArm Expr)
         -> Maybe (List (Params.Spanned (Stmt Expr)))
         -> Expr
tryHeard t cx sp end err tried Nothing Nothing =
  badE sp "a `try` has a `catch` arm, a `finally` block, or both"
tryHeard t cx sp end (Just ty) tried Nothing (Just fs) =
  badE
    (Params.spanOf ty)
    "a `try` with no `catch` arm hears no throw: `(err := T)` names the type of what its `catch` arm hears"
tryHeard t cx sp end err tried h Nothing = heardT t cx sp end err tried h
tryHeard t cx sp end err tried h (Just fs) =
  app
    (At (EVar "scoped") sp)
    [ pureOf cx sp (At (ETag "MkUnit") sp)
    , thunkOf sp (finallyT t cx fs)
    , thunkOf sp (heardT t cx sp end err tried h)
    ]

-- | a `try`'s scope, its statements up to `end`, then what its answer
-- | says to do, by co's `leaveScope`: go on after it
-- | (`end`), or jump further out
tryScope : DoT -> DoCx -> Params.Span -> TryF Expr -> End -> Expr
tryScope t cx sp (MkTry err body h fin) end =
  app
    (At (EVar cx.names.bind) cx.sp)
    [ tryHeard t (inScope cx) sp end err (t.stmts (inScope cx) body end) h fin
    , At (EVar "leaveScope") sp
    ]

-- (`try ...`, and the statements after it, a join point)
tryJoin : DoT
        -> DoCx
        -> Params.Span
        -> TryF Expr
        -> List (Params.Spanned (Stmt Expr))
        -> End
        -> Expr
tryJoin t cx sp tr rest end =
  At
    (ELocal
       (tryScope
          t
          cx
          sp
          tr
          (EndJump
             { head = At (EVar (madeName "join" sp)) sp
             , vars = cx.muts
             , unit = True
             , depth = cx.depth
             }))
       [ localFun
         (madeName "join" sp)
         sp
         (varParams sp True cx.muts)
         (t.stmts cx rest end)
       ])
    sp

-- | `try ...`, and the statements after it, a join point (what follows
-- | it) where there are any (and it reaches its end)
tryT : DoT
     -> DoCx
     -> Params.Span
     -> TryF Expr
     -> List (Params.Spanned (Stmt Expr))
     -> End
     -> Expr
tryT t cx sp tr Nil end = tryScope t cx sp tr end
tryT t cx sp tr (Cons s rest) end =
  if stmtsFall [At (StmtExpr (At (ETry tr) sp)) sp]
  then tryJoin t cx sp tr (Cons s rest) end
  else badE
      (Params.spanOf s)
      "nothing after this `try` runs: neither its statements nor its `catch` arm reach their end"

-- (`try ...` and the statements after it, unless its `catch` arm's
-- binder is wrong: then that, said)
tryOr : DoT
      -> DoCx
      -> Params.Span
      -> TryF Expr
      -> List (Params.Spanned (Stmt Expr))
      -> End
      -> Maybe Expr
      -> Expr
tryOr t cx sp tr rest end (Just wrong) = wrong
tryOr t cx sp tr rest end Nothing = tryT t cx sp tr rest end

-- (an `if let`'s `else`, its statements: none, where there is none)
elseStmts : Maybe Expr -> List (Params.Spanned (Stmt Expr))
elseStmts Nothing = Nil
elseStmts (Just b) = armStmts b

-- | a statement of the block's own (`isControl`), and the statements
-- | after it
controlT : DoT
         -> DoCx
         -> Expr
         -> List (Params.Spanned (Stmt Expr))
         -> End
         -> Expr
controlT t cx (At (EAssign x xsp v) sp) rest end =
  if isMut cx x
  then hoist
      cx
      v
      (\v' ->
         letVar
           x
           xsp
           (At (EAnn v' (typeOfE xsp x)) (Params.spanOf v'))
           (t.stmts cx rest end))
  else if isSealed cx x
  then badE
      xsp
      ("`"
       ^ x
       ^ "` is a `let mut` variable of the block around a `finally` block: the block runs as the `try` is left, seeing the variables as they were where the `try` began, and cannot set them")
  else badE
      xsp
      ("`"
       ^ x
       ^ "` is not a `let mut` variable: only one is set, `let mut "
       ^ x
       ^ " = e`")
controlT t cx (At EBreak sp) rest end =
  jumpTo cx sp rest (breakOf cx.loop) "`break`"
controlT t cx (At EContinue sp) rest end =
  jumpTo cx sp rest (continueOf cx.loop) "`continue`"
controlT t cx (At (EReturn v) sp) (Cons s _) end =
  badE (Params.spanOf s) "nothing after `return` runs: it is the last statement"
controlT t cx (At (EReturn v) sp) Nil end =
  if cx.final then badE sp (leavesFinally "`return`")
  else hoist cx v (\v' -> leaving cx sp cx.depth (pureOf cx sp v'))
controlT t cx (At (EWhile c body) sp) rest end = whileT t cx sp c body rest end
controlT t cx (At (EFor p c body) sp) rest end = forT t cx sp p c body rest end
controlT t cx (At (EIfThen c a) sp) rest end =
  condT
    t
    cx
    sp
    (boolOf c)
    [ MkPair (patTag "True" sp Nil) (armStmts a)
    , MkPair (patTag "False" sp Nil) Nil
    ]
    rest
    end
controlT t cx (At (EMatch s alts) sp) rest end =
  condT
    t
    cx
    sp
    s
    (List.map altStmts alts)
    rest
    end
controlT t cx (At (EIfLet p s a b) sp) rest end =
  condT
    t
    cx
    sp
    s
    [MkPair p (armStmts a), MkPair (At (PatVar "_") sp) (elseStmts b)]
    rest
    end
controlT t cx (At (ETry (MkTry err body h fin)) sp) rest end =
  tryOr t cx sp (MkTry err body h fin) rest end (catchWrong cx h)
controlT t cx e rest end =
  hoist cx e (\e' -> doBind cx e' "_" cx.sp (t.stmts cx rest end))

-- | the last statement, whose value is the block's
lastT : DoT -> DoCx -> Params.Spanned (Stmt Expr) -> Expr
lastT t cx (At (StmtExpr e) sp) =
  if isControl e then controlT t cx e Nil EndValue
  else if cx.depth > 0
  then hoist
      cx
      e
      (\e' ->
         doBind
           cx
           e'
           (madeName "last" sp)
           sp
           (leaving
              cx
              sp
              cx.depth
              (pureOf cx sp (At (EVar (madeName "last" sp)) sp))))
  else hoist cx e (\e' -> e')
lastT t cx (At _ sp) = badE sp "a `do` block ends with an expression"

-- | `let p = e` and the statements after it, `body`
letStmt : Params.Span -> Expr -> Pat -> Expr -> Expr
letStmt lsp e p body =
  At
    (ELetIn e (alt p body))
    { start = lsp.start, end = (Params.spanOf body).end }

-- | a statement, and the statements after it
stmtT : DoT
      -> DoCx
      -> Params.Spanned (Stmt Expr)
      -> List (Params.Spanned (Stmt Expr))
      -> End
      -> Expr
stmtT t cx (At (StmtBind x xsp e) sp) rest end =
  if isMut cx x then badE xsp (mutClash x)
  else hoist cx e (\e' -> doBind cx e' x xsp (t.stmts cx rest end))
stmtT t cx (At (StmtLet p e) lsp) rest end = case firstMut cx (patNames p) of
  Just x -> badE (Params.spanOf p) (mutClash x)
  Nothing -> hoist cx e (\e' -> letStmt lsp e' p (t.stmts cx rest end))
stmtT t cx (At (StmtLetMut x xsp e) sp) rest end =
  if isMut cx x then badE xsp (mutClash x)
  else hoist
      cx
      e
      (\e' -> letVar x xsp (annHole e') (t.stmts (withMut cx x) rest end))
stmtT t cx (At (StmtExpr e) sp) rest end =
  if isControl e then controlT t cx e rest end
  else hoist cx e (\e' -> doBind cx e' "_" cx.sp (t.stmts cx rest end))

stmtsF : DoT -> DoCx -> List (Params.Spanned (Stmt Expr)) -> End -> Expr
stmtsF t cx Nil end = endOf cx cx.sp end
stmtsF t cx (Cons s Nil) EndValue = lastT t cx s
stmtsF t cx (Cons s rest) end = stmtT t cx s rest end

doT : DoT
doT = { stmts = \cx ss end -> stmtsF doT cx ss end }

-- (a block ends with an expression)
endsWell : List (Params.Spanned (Stmt Expr)) -> Bool
endsWell ss = case List.last ss of
  Just (At (StmtExpr _) _) -> True
  _ -> False

-- | a `do` block, taken apart through `names`; nothing, if it does not
-- | end with an expression
doBlock : DoNames
        -> Params.Span
        -> List (Params.Spanned (Stmt Expr))
        -> Maybe Expr
doBlock names sp stmts =
  if endsWell stmts
  then Just
      (doT.stmts
         { names = names
         , muts = Nil
         , loop = Nothing
         , sp = sp
         , depth = 0
         , final = False
         , sealed = Nil
         }
         stmts
         EndValue)
  else Nothing

-- | `run do ...`: the block through the identity monad's names
runArgs : Expr -> List Expr -> List Expr
runArgs (At (EVar f) _) (Cons (At (EDo ss) dsp) Nil) =
  if strEq f "run"
  then [ fromMaybe
         (badE dsp "a `do` block ends with an expression")
         (doBlock idNames dsp ss)
       ]
  else [At (EDo ss) dsp]
runArgs h args = args

-- | a term in the judgment it is elaborated by
data Classified
  = IsInferable Inferable
  | IsCheckable Checkable
  | IsType TypeForm

classifiedSpan : Classified -> Params.Span
classifiedSpan (IsInferable i) = Params.spanOf i
classifiedSpan (IsCheckable c) = Params.spanOf c
classifiedSpan (IsType t) = Params.spanOf t

invalid : Int -> String -> Params.Span -> Inferable
invalid code why sp = At (IInvalid code why Nothing) sp

-- | a notation that is only checked, as a message names it
checkedOnly : CheckableF TypeForm -> String
checkedOnly (CStruct _) = "a record"
checkedOnly (CLam _ _ _) = "a lambda"
checkedOnly (CImplicitLam _ _ _) = "a lambda"
checkedOnly (CAnnLam _ _ _ _) = "a lambda"
checkedOnly (CTag _ _ _) = "a tag"
checkedOnly (CMatch _ _) = "a `case`"
checkedOnly (CLetIn _ _) = "a `let` whose body is checked"
checkedOnly (CLocal _ _) = "a term with `where`"
checkedOnly CAbandon = "`abandon`"
checkedOnly _ = "this notation"

-- | the ways to put a notation that is only checked where its type is
-- | known, any of them
checkedWays : String
checkedWays =
  "any of these: give the type where it is bound, `let x : T = ...`; give it in place, `(e : T)`; or write it where a type is expected of it, as an argument of a function whose type is known or as the body of a definition with a signature"

-- | where a term infers its type (a function applied, a scrutinee, what
-- | `let x` is bound to, what is specialised)
toInferable : Classified -> Inferable
toInferable (IsInferable i) = i
toInferable (IsCheckable (At c sp)) =
  At
    (IInvalid
       0
       (checkedOnly c
        ^ " does not infer its type: it must be put where its type is known")
       (Just checkedWays))
    sp
toInferable (IsType (At (TSig fs) sp)) =
  invalid 4 "cannot use descriptive syntax in nominal position" sp
toInferable (IsType (At (TSum vs) sp)) =
  invalid 4 "cannot use descriptive syntax in nominal position" sp
toInferable (IsType t) =
  At
    (IInvalid
       0
       "a type used as an element does not infer the universe it is in: it must be put where that is known"
       (Just checkedWays))
    (Params.spanOf t)

toCheckable : Classified -> Checkable
toCheckable (IsInferable i) = At (CInf i) (Params.spanOf i)
toCheckable (IsCheckable c) = c
toCheckable (IsType t) = At (CType t) (Params.spanOf t)

toTypeForm : Classified -> TypeForm
toTypeForm (IsInferable i) = At (TInf i) (Params.spanOf i)
toTypeForm (IsCheckable c) = At (TChk c) (Params.spanOf c)
toTypeForm (IsType t) = t

-- | the classifier, knotted: an expression, a declaration
type Classifier = { e : Expr -> Classified, decl : Decl -> Declaration }

inferable : Classifier -> Expr -> Inferable
inferable r e = toInferable (r.e e)

checkable : Classifier -> Expr -> Checkable
checkable r e = toCheckable (r.e e)

typeForm : Classifier -> Expr -> TypeForm
typeForm r e = toTypeForm (r.e e)

wordOf : SyntaxWord -> Params.Span -> Classified
wordOf TypeWord sp = IsType (At TType sp)
wordOf IntWord sp = IsType (At TInt sp)
wordOf FloatWord sp = IsType (At TFloat sp)
wordOf StringWord sp = IsType (At TString sp)
wordOf RuneWord sp = IsType (At TRune sp)
wordOf ArrayWord sp =
  IsType (At (TInf (invalid 3 "`Array` takes one type" sp)) sp)
wordOf AbandonWord sp = IsCheckable (At CAbandon sp)
wordOf (FixedWord w) sp = IsType (At (TFixed w) sp)

-- | an argument in a spine
argOf : Classifier -> Expr -> Params.Spanned (Arg Checkable)
argOf r (At (EProject x) sp) = At (ArgProject x) sp
argOf r (At (ENamed x e) sp) = At (ArgNamed x (checkable r e)) sp
argOf r e = At (ArgExplicit (checkable r e)) (Params.spanOf e)

-- | `h args`: a tag applied, `Array T`, or a function applied
appOf : Classifier -> Expr -> List Expr -> Params.Span -> Classified
appOf r (At (ETag t) tsp) args sp =
  IsCheckable (At (CTag t tsp (List.map (checkable r) args)) sp)
appOf r (At (EWord ArrayWord) _) (Cons a Nil) sp =
  IsType (At (TArray (typeForm r a)) sp)
appOf r (At (EWord ArrayWord) _) args sp =
  IsType (At (TInf (invalid 3 "`Array` takes one type" sp)) sp)
appOf r h args sp =
  IsInferable (At (IApp (inferable r h) (List.map (argOf r) args)) sp)

-- (what there may be, mapped)
mapMaybe : {a b : Type} -> (a -> b) -> Maybe a -> Maybe b
mapMaybe f Nothing = Nothing
mapMaybe f (Just x) = Just (f x)

piBinderOf : Classifier -> PiBinder Expr Expr -> PiBinder TypeForm Checkable
piBinderOf r (PiNamed x xsp t) = PiNamed x xsp (typeForm r t)
piBinderOf r (PiImplicit x xsp bsp t d) =
  PiImplicit x xsp bsp (typeForm r t) (mapMaybe (checkable r) d)
piBinderOf r (PiInstance x xsp bsp t) = PiInstance x xsp bsp (typeForm r t)
piBinderOf r (PiAnon t) = PiAnon (typeForm r t)

altOf : Classifier
      -> Params.Spanned (Alt Expr)
      -> Params.Spanned (Alt Checkable)
altOf r (At (MkAlt p b) sp) = At (MkAlt p (checkable r b)) sp

fieldDeclOf : Classifier
            -> Params.Spanned (FieldDecl Expr Expr)
            -> Params.Spanned (FieldDecl TypeForm Checkable)
fieldDeclOf r (At (DeclareField x xsp t d) sp) =
  At (DeclareField x xsp (typeForm r t) (mapMaybe (checkable r) d)) sp
fieldDeclOf r (At (BadFieldDecl e) sp) = At (BadFieldDecl (typeForm r e)) sp

fieldSetOf : Classifier
           -> Params.Spanned (FieldSet Expr)
           -> Params.Spanned (FieldSet Checkable)
fieldSetOf r (At (SetField x xsp e) sp) = At (SetField x xsp (checkable r e)) sp
fieldSetOf r (At (BadFieldSet e) sp) = At (BadFieldSet (checkable r e)) sp

updateSetOf : Classifier
            -> Params.Spanned (UpdateSet Expr)
            -> Params.Spanned (UpdateSet Checkable)
updateSetOf r (At (SetPath path e) sp) = At (SetPath path (checkable r e)) sp

variantOf : Classifier
          -> Params.Spanned (Variant Expr)
          -> Params.Spanned (Variant TypeForm)
variantOf r (At (TagVariant t tsp args) sp) =
  At (TagVariant t tsp (List.map (typeForm r) args)) sp
variantOf r (At (BadVariant e) sp) = At (BadVariant (typeForm r e)) sp

-- | `\(x : T) -> e`: inferring, if `e` does
annLamOf : String
         -> Params.Span
         -> TypeForm
         -> Classified
         -> Params.Span
         -> Classified
annLamOf x xsp t (IsInferable b) sp = IsInferable (At (IAnnLam x xsp t b) sp)
annLamOf x xsp t b sp = IsCheckable (At (CAnnLam x xsp t (toCheckable b)) sp)

-- A binary, `b[...]`, written: `Bytes` or `Bits`, as `isBitsBinary`
-- says.  Of segments each whole bytes, its bytes: those written whole,
-- if each segment is (a number of a size written, a string, a code point
-- written in UTF-8), else its segments' bytes put together
-- (`bytesConcat`) -- those written whole together, each other an
-- integer written as bytes (`bytesOfInt`), bytes (the first so many,
-- where its size is said: `bytesSized`), a float's bits (`floatBits`)
-- or a code point (`utf8Bytes`, `utf16Bytes`, `utf32Bytes`), by the
-- prelude's primitives and definitions.  Otherwise each segment is made
-- bits (`bitsOfInt`, `bitsSized`, the others' bytes `bitsOfBytes`), they
-- are put together (`bitsConcat`), and, the binary `Bytes`, made bytes
-- again (`bitsBytes`).  A `bits` segment whose value is a binary written
-- there, `b[1, 2]::bits`, is that binary made bits, whatever it is.

-- (a segment's bytes, where it is written whole)
wholeInteger : SegmentSize -> Bool -> Int -> Maybe String
wholeInteger SizeDefault little v = Just (integerBytes 8 little v)
wholeInteger (SizeNumber n) little v =
  if n % 8 == 0 then Just (integerBytes n little v) else Nothing
wholeInteger (SizeName _ _ _) little v = Nothing

wholeSegment : Segment Expr -> Maybe String
wholeSegment (MkSegment (At (EInt v) _) SegmentInteger size little _) =
  wholeInteger size little v
wholeSegment (MkSegment (At (EString s) _) SegmentBinary SizeDefault _ _) =
  Just s
wholeSegment (MkSegment (At (EInt c) _) (SegmentUtf 8) _ _ _) = Just (utf8Of c)
wholeSegment (MkSegment (At (ERune c) _) (SegmentUtf 8) _ _ _) = Just (utf8Of c)
wholeSegment _ = Nothing

-- (each segment's bytes, if each is written whole, after `acc`)
wholeBinary : List (Params.Spanned (Segment Expr)) -> String -> Maybe String
wholeBinary Nil acc = Just acc
wholeBinary (Cons (At seg _) rest) acc = case wholeSegment seg of
  Just s -> wholeBinary rest (acc ^ s)
  Nothing -> Nothing

-- (the primitive or definition `p` applied to `args`)
primApp : String -> List Checkable -> Params.Span -> Inferable
primApp p args sp =
  At (IApp (At (IPrim p) sp) (List.map (\c -> At (ArgExplicit c) sp) args)) sp

primCall : String -> List Checkable -> Params.Span -> Checkable
primCall p args sp = chkOf (primApp p args sp)

intTerm : Int -> Params.Span -> Checkable
intTerm n sp = chkOf (At (IInt n) sp)

-- (a size in bits: `n` where none is said)
sizeTerm : SegmentSize -> Int -> Params.Span -> Checkable
sizeTerm SizeDefault n sp = intTerm n sp
sizeTerm (SizeNumber m) _ sp = intTerm m sp
sizeTerm (SizeName x xsp 1) _ sp = chkOf (At (IVar x) xsp)
sizeTerm (SizeName x xsp unit) _ sp =
  primCall "intMul" [chkOf (At (IVar x) xsp), intTerm unit sp] sp

-- (a size in bytes, of a size that is whole bytes)
bytesTerm : SegmentSize -> Params.Span -> Checkable
bytesTerm (SizeName x xsp 8) sp = chkOf (At (IVar x) xsp)
bytesTerm (SizeName x xsp unit) sp =
  primCall "intMul" [chkOf (At (IVar x) xsp), intTerm (unit / 8) sp] sp
bytesTerm (SizeNumber n) sp = intTerm (n / 8) sp
bytesTerm SizeDefault sp = intTerm 0 sp

-- (a code point's, of an `Int` or a `Rune`)
codePointTerm : Classifier -> Expr -> Params.Span -> Checkable
codePointTerm r v sp = primCall "prelude.codePointOf" [checkable r v] sp

-- (a segment that is whole bytes, not written whole, as `Bytes`)
bytesPart : Classifier -> Params.Spanned (Segment Expr) -> Checkable
bytesPart r (At (MkSegment v SegmentInteger size little signed) sp) =
  primCall
    "bytesOfInt"
    [ sizeTerm size 8 sp
    , intTerm (segmentFlags little signed) sp
    , checkable r v
    ]
    sp
bytesPart r (At (MkSegment v SegmentBinary SizeDefault _ _) sp) = checkable r v
bytesPart r (At (MkSegment v SegmentBinary size _ _) sp) =
  primCall "prelude.bytesSized" [bytesTerm size sp, checkable r v] sp
bytesPart r (At (MkSegment v SegmentFloat size little _) sp) =
  primCall
    "bytesOfInt"
    [ sizeTerm size 64 sp
    , intTerm (segmentFlags little False) sp
    , primCall "floatBits" [sizeTerm size 64 sp, checkable r v] sp
    ]
    sp
bytesPart r (At (MkSegment v (SegmentUtf 8) _ _ _) sp) =
  primCall "prelude.utf8Bytes" [codePointTerm r v sp] sp
bytesPart r (At (MkSegment v (SegmentUtf 16) _ little _) sp) =
  primCall
    "prelude.utf16Bytes"
    [intTerm (segmentFlags little False) sp, codePointTerm r v sp]
    sp
bytesPart r (At (MkSegment v (SegmentUtf _) _ little _) sp) =
  primCall
    "prelude.utf32Bytes"
    [intTerm (segmentFlags little False) sp, codePointTerm r v sp]
    sp
-- (none: a binary of `bits` is made of bits)
bytesPart r (At (MkSegment v SegmentBits _ _ _) sp) =
  primCall "bitsBytes" [checkable r v] sp

-- | how a binary of bits made inside another is made: `b[1, 2]::bits`
type Nest =
  { bits : List (Params.Spanned (Segment Expr)) -> Params.Span -> Checkable }

-- (the value of a `bits` segment: a binary written there, made bits)
-- (a binary's segments, of a binary written)
binarySegments : ExprF -> Maybe (List (Params.Spanned (Segment Expr)))
binarySegments (EBinary segs) = Just segs
binarySegments _ = Nothing

bitsValueOf : Nest
            -> Classifier
            -> Expr
            -> Maybe (List (Params.Spanned (Segment Expr)))
            -> Checkable
bitsValueOf k r v (Just segs) = k.bits segs (Params.spanOf v)
bitsValueOf k r v Nothing = checkable r v

bitsValue : Nest -> Classifier -> Expr -> Checkable
bitsValue k r (At e sp) = bitsValueOf k r (At e sp) (binarySegments e)

-- (a segment, not written whole, as `Bits`)
bitsPart : Nest -> Classifier -> Params.Spanned (Segment Expr) -> Checkable
bitsPart k r (At (MkSegment v SegmentInteger size little signed) sp) =
  primCall
    "bitsOfInt"
    [ sizeTerm size 8 sp
    , intTerm (segmentFlags little signed) sp
    , checkable r v
    ]
    sp
bitsPart k r (At (MkSegment v SegmentBits SizeDefault _ _) sp) = bitsValue k r v
bitsPart k r (At (MkSegment v SegmentBits size _ _) sp) =
  primCall "prelude.bitsSized" [sizeTerm size 0 sp, bitsValue k r v] sp
bitsPart k r seg = primCall "bitsOfBytes" [bytesPart r seg] (Params.spanOf seg)

-- | how the parts of a binary are made: a segment not written whole, and
-- | bytes that are
type Maker =
  { part : Params.Spanned (Segment Expr) -> Checkable
  , run : String -> Params.Span -> Checkable
  }

-- (the bytes written whole so far, `run`, among the parts, the last
-- first)
partsWith : Maker
          -> Maybe (Pair String Params.Span)
          -> List Checkable
          -> List Checkable
partsWith m Nothing acc = acc
partsWith m (Just (MkPair s sp)) acc = Cons (m.run s sp) acc

runWith : Maybe (Pair String Params.Span)
        -> String
        -> Params.Span
        -> Maybe (Pair String Params.Span)
runWith Nothing s sp = Just (MkPair s sp)
runWith (Just (MkPair s0 sp0)) s sp = Just (MkPair (s0 ^ s) (spanning sp0 sp))

-- (the parts of the segments, the last first: those written whole one
-- after another together, `run` those so far)
binaryParts : Maker
            -> List (Params.Spanned (Segment Expr))
            -> Maybe (Pair String Params.Span)
            -> List Checkable
            -> List Checkable
binaryParts m Nil run acc = partsWith m run acc
binaryParts m (Cons (At seg sp) rest) run acc = case wholeSegment seg of
  Just s -> binaryParts m rest (runWith run s sp) acc
  Nothing ->
    binaryParts m rest Nothing (Cons (m.part (At seg sp)) (partsWith m run acc))

-- (a list of them, as its tags make it)
listOfChk : List Checkable -> Params.Span -> Checkable
listOfChk Nil sp = At (CTag "Nil" sp Nil) sp
listOfChk (Cons x xs) sp = At (CTag "Cons" sp [x, listOfChk xs sp]) sp

-- (the parts put together by `p`)
concatOf : String
         -> Maker
         -> List (Params.Spanned (Segment Expr))
         -> Params.Span
         -> Inferable
concatOf p m segs sp =
  primApp p [listOfChk (List.reverse (binaryParts m segs Nothing Nil)) sp] sp

bytesMaker : Classifier -> Maker
bytesMaker r = { part = bytesPart r, run = \s sp -> chkOf (At (IBytes s) sp) }

bitsMaker : Nest -> Classifier -> Maker
bitsMaker k r =
  { part = bitsPart k r
  , run = \s sp -> primCall "bitsOfBytes" [chkOf (At (IBytes s) sp)] sp
  }

-- (bytes, written whole where they are)
bytesBinary : Classifier
            -> List (Params.Spanned (Segment Expr))
            -> Params.Span
            -> Maybe String
            -> Classified
bytesBinary r segs sp (Just s) = IsInferable (At (IBytes s) sp)
bytesBinary r segs sp Nothing =
  IsInferable (concatOf "bytesConcat" (bytesMaker r) segs sp)

-- (made of bits: `Bits`, or, `bytes`, made bytes again)
bitsBinary : Nest
           -> Classifier
           -> List (Params.Spanned (Segment Expr))
           -> Params.Span
           -> Bool
           -> Classified
bitsBinary k r segs sp False =
  IsInferable (concatOf "bitsConcat" (bitsMaker k r) segs sp)
bitsBinary k r segs sp True =
  IsInferable
    (primApp
       "bitsBytes"
       [chkOf (concatOf "bitsConcat" (bitsMaker k r) segs sp)]
       sp)

-- | a binary, written (`asBits`: made bits, whatever it is)
binaryIn : Classifier
         -> Bool
         -> List (Params.Spanned (Segment Expr))
         -> Params.Span
         -> Classified
binaryIn r asBits segs sp =
  if asBits || isBitsBinary segs
  then bitsBinary
      { bits = \s sp2 -> toCheckable (binaryIn r True s sp2) }
      r
      segs
      sp
      False
  else if wholeByteSegments segs
  then bytesBinary r segs sp (wholeBinary segs "")
  else bitsBinary
      { bits = \s sp2 -> toCheckable (binaryIn r True s sp2) }
      r
      segs
      sp
      True

binaryOf : Classifier
         -> List (Params.Spanned (Segment Expr))
         -> Params.Span
         -> Classified
binaryOf r segs sp = binaryIn r False segs sp

classifyTermF : Classifier -> Expr -> Classified
classifyTermF r (At (EVar x) sp) = IsInferable (At (IVar x) sp)
classifyTermF r (At (EImplicitVar x) sp) = IsInferable (At (IVar x) sp)
classifyTermF r (At (ETag t) sp) = IsCheckable (At (CTag t sp Nil) sp)
classifyTermF r (At (EInt i) sp) = IsInferable (At (IInt i) sp)
classifyTermF r (At (EFloat x) sp) = IsInferable (At (IFloat x) sp)
classifyTermF r (At (EString x) sp) = IsInferable (At (IString x) sp)
classifyTermF r (At (EBinary segs) sp) = binaryOf r segs sp
classifyTermF r (At (ERune c) sp) = IsInferable (At (IRune c) sp)
classifyTermF r (At (EWord w) sp) = wordOf w sp
classifyTermF r (At (EApp h args) sp) = appOf r h (runArgs h args) sp
classifyTermF r (At (EPi b cod) sp) =
  IsType (At (TPi (piBinderOf r b) (typeForm r cod)) sp)
classifyTermF r (At (ELam (LamName x xsp) body) sp) =
  IsCheckable (At (CLam x xsp (checkable r body)) sp)
classifyTermF r (At (ELam (LamImplicit x xsp) body) sp) =
  IsCheckable (At (CImplicitLam x xsp (checkable r body)) sp)
classifyTermF r (At (ELam (LamAnn x xsp t) body) sp) =
  annLamOf x xsp (typeForm r t) (r.e body) sp
classifyTermF r (At (EAnn a t) sp) =
  IsInferable (At (IAnn (checkable r a) (typeForm r t)) sp)
classifyTermF r (At (ESpec a x fsp v) sp) =
  IsInferable (At (ISpec (inferable r a) x fsp (checkable r v)) sp)
classifyTermF r (At (ESig fs) sp) =
  IsType (At (TSig (List.map (fieldDeclOf r) fs)) sp)
classifyTermF r (At (ESum vs) sp) =
  IsType (At (TSum (List.map (variantOf r) vs)) sp)
classifyTermF r (At (EStruct fs) sp) =
  IsCheckable (At (CStruct (List.map (fieldSetOf r) fs)) sp)
classifyTermF r (At (EUpdate a fs) sp) =
  IsInferable (At (IUpdate (inferable r a) (List.map (updateSetOf r) fs)) sp)
classifyTermF r (At (EMatch s alts) sp) =
  IsCheckable (At (CMatch (inferable r s) (List.map (altOf r) alts)) sp)
classifyTermF r (At (ELetIn rhs a) sp) =
  IsCheckable (At (CLetIn (inferable r rhs) (altOf r a)) sp)
classifyTermF r (At (EDo stmts) sp) = case doBlock coNames sp stmts of
  Just e' -> r.e e'
  Nothing -> IsInferable (invalid 12 "a `do` block ends with an expression" sp)
classifyTermF r (At (ELocal body ds) sp) =
  IsCheckable (At (CLocal (checkable r body) (List.map r.decl ds)) sp)
classifyTermF r (At (EInvalid why) sp) = IsInferable (invalid 3 why sp)
classifyTermF r (At (EAssign x _ _) sp) =
  IsInferable
    (invalid
       3
       ("`"
        ^ x
        ^ " := e` sets a `let mut` variable: it is a statement of a `do` block")
       sp)
classifyTermF r (At (EWhile _ _) sp) =
  IsInferable (invalid 3 "a `while` loop is a statement of a `do` block" sp)
classifyTermF r (At (EFor _ _ _) sp) =
  IsInferable (invalid 3 "a `for` loop is a statement of a `do` block" sp)
classifyTermF r (At (EIfThen _ _) sp) =
  IsInferable
    (invalid
       3
       "an `if` without `else` is a statement of a `do` block: a value's has an `else`"
       sp)
classifyTermF r (At EBreak sp) =
  IsInferable
    (invalid
       3
       "`break` is a statement of a loop's body: `while c do ...`, `for x in e do ...`"
       sp)
classifyTermF r (At EContinue sp) =
  IsInferable
    (invalid
       3
       "`continue` is a statement of a loop's body: `while c do ...`, `for x in e do ...`"
       sp)
classifyTermF r (At (EReturn _) sp) =
  IsInferable
    (invalid
       3
       "`return e` ends a `do` block as one of its statements (or an arm of its `if` or `case`), not as a value"
       sp)
classifyTermF r (At (EIfLet p s a (Just b)) sp) = r.e (ifLetOf sp p s a b)
classifyTermF r (At (EIfLet _ _ _ Nothing) sp) =
  IsInferable
    (invalid
       3
       "an `if let` without `else` is a statement of a `do` block: a value's has an `else`"
       sp)
classifyTermF r (At (ETry _) sp) =
  IsInferable
    (invalid
       3
       "a `try` is a statement of a `do` block (or an arm of its `if` or `case`)"
       sp)
classifyTermF r (At (ENest _) sp) =
  IsInferable
    (invalid
       3
       "`(<- c)`, the value of an action, is in a statement of a `do` block"
       sp)
classifyTermF r (At _ sp) = IsInferable (invalid 3 "unexpected notation" sp)

paramOf : Classifier
        -> Params.Spanned (Param Expr)
        -> Params.Spanned (Param TypeForm)
paramOf r (At (ExplicitParam x xsp t) sp) =
  At (ExplicitParam x xsp (typeForm r t)) sp
paramOf r (At (ImplicitParam x xsp t) sp) =
  At (ImplicitParam x xsp (typeForm r t)) sp

equationOf : Classifier
           -> Params.Spanned (Equation Expr)
           -> Params.Spanned (Equation Checkable)
equationOf r (At (MkEquation f fsp ps rhs) sp) =
  At (MkEquation f fsp ps (checkable r rhs)) sp

-- | a watch infers what it is: it says its type
watchOf : Classified -> Checkable
watchOf (IsInferable i) = At (CInf i) (Params.spanOf i)
watchOf c =
  At
    (CInf
       (invalid
          0
          "a watch must say what type it has: write `>>> (e : T)`"
          (classifiedSpan c)))
    (classifiedSpan c)

classifyDeclF : Classifier -> Decl -> Declaration
classifyDeclF r (At (DeclEquations f fsp declared ty eqs) sp) =
  At
    (DeclEquations f fsp declared (typeForm r ty) (List.map (equationOf r) eqs))
    sp
classifyDeclF r (At (DeclDefine x xsp ps u body) sp) =
  At
    (DeclDefine
       x
       xsp
       (List.map (paramOf r) ps)
       (typeForm r u)
       (checkable r body))
    sp
classifyDeclF r (At (DeclTheory x xsp ps body) sp) =
  At (DeclTheory x xsp (List.map (paramOf r) ps) (checkable r body)) sp
classifyDeclF r (At (DeclPrimitive x xsp t) sp) =
  At (DeclPrimitive x xsp (typeForm r t)) sp
classifyDeclF r (At (DeclTest x xsp) sp) = At (DeclTest x xsp) sp
classifyDeclF r (At (DeclWatch e) sp) = At (DeclWatch (watchOf (r.e e))) sp

classifier : Classifier
classifier =
  { e = \e -> classifyTermF classifier e
  , decl = \d -> classifyDeclF classifier d
  }

-- | a declaration, each term in the judgment it is elaborated by
classify : Decl -> Declaration
classify d = classifier.decl d

-- Descriptive positions
--------------------------------------------------------------------------------

-- Where a term is written decides whether it is in descriptive
-- position (the body of a `theory`, of a `data`/`type` definition, of a
-- definition by equations, and what passes it on) or nominal
-- (everywhere else).  So it is marked here, once, before elaboration
-- (`mark`, at each declaration's terms), and the elaborator takes no
-- position along:
--
-- - in descriptive position, a term that does not pass it on is
--   elaborated as a nominal one, its result marked so (`INominal`,
--   `CNominal`, `TNominal`);
-- - a record or sum type in nominal position is E0204, an `IInvalid`
--   (as `toInferable` makes one).
--
-- What passes descriptive position on: a lambda's body (`\x -> e`,
-- `{x} => e`), a record's fields, an annotation's term (`(e : T)`), and
-- a term that is a type, or a type that is a term (`CInf`, `CType`,
-- `TInf`, `TChk`).  Everything else is nominal: a function and its
-- arguments, an annotation's type, a binder's type, a record or sum
-- type's field and variant types, a match's scrutinee and arms, a
-- `let`'s bound term and body, a local definition.  A definition by
-- equations is in descriptive position as the clause compiler makes it
-- (its lambdas, its match), so it is marked after (`heff.elab.toplevel`).

mapAt : {a b : Type} -> (a -> b) -> Params.Spanned a -> Params.Spanned b
mapAt f (At x sp) = At (f x) sp

-- | the marking judgments, knotted
type MK =
  { i : Params.Case -> Inferable -> Inferable
  , c : Params.Case -> Checkable -> Checkable
  , t : Params.Case -> TypeForm -> TypeForm
  }

argN : MK -> Arg Checkable -> Arg Checkable
argN r (ArgExplicit c) = ArgExplicit (r.c N c)
argN r (ArgProject x) = ArgProject x
argN r (ArgNamed x c) = ArgNamed x (r.c N c)

altN : MK -> Alt Checkable -> Alt Checkable
altN r (MkAlt p b) = MkAlt p (r.c N b)

fieldSetM : MK -> Params.Case -> FieldSet Checkable -> FieldSet Checkable
fieldSetM r cs (SetField x sp e) = SetField x sp (r.c cs e)
fieldSetM r cs (BadFieldSet e) = BadFieldSet (r.c cs e)

updateSetN : MK -> UpdateSet Checkable -> UpdateSet Checkable
updateSetN r (SetPath path e) = SetPath path (r.c N e)

fieldDeclN : MK -> FieldDecl TypeForm Checkable -> FieldDecl TypeForm Checkable
fieldDeclN r (DeclareField x sp t d) =
  DeclareField x sp (r.t N t) (mapMaybe (r.c N) d)
fieldDeclN r (BadFieldDecl e) = BadFieldDecl (r.t N e)

variantN : MK -> Variant TypeForm -> Variant TypeForm
variantN r (TagVariant x sp ts) = TagVariant x sp (List.map (r.t N) ts)
variantN r (BadVariant e) = BadVariant (r.t N e)

piN : MK -> PiBinder TypeForm Checkable -> PiBinder TypeForm Checkable
piN r (PiNamed x sp t) = PiNamed x sp (r.t N t)
piN r (PiImplicit x sp sp2 t d) =
  PiImplicit x sp sp2 (r.t N t) (mapMaybe (r.c N) d)
piN r (PiInstance x sp sp2 t) = PiInstance x sp sp2 (r.t N t)
piN r (PiAnon t) = PiAnon (r.t N t)

paramN : MK -> Param TypeForm -> Param TypeForm
paramN r (ExplicitParam x sp t) = ExplicitParam x sp (r.t N t)
paramN r (ImplicitParam x sp t) = ImplicitParam x sp (r.t N t)

eqN : MK -> Equation Checkable -> Equation Checkable
eqN r (MkEquation f sp ps rhs) = MkEquation f sp ps (r.c N rhs)

-- (a local definition: nominal throughout)
declN : MK -> DeclF Checkable TypeForm -> DeclF Checkable TypeForm
declN r (DeclEquations f sp declared ty eqs) =
  DeclEquations f sp declared (r.t N ty) (List.map (mapAt (eqN r)) eqs)
declN r (DeclDefine x sp ps u body) =
  DeclDefine x sp (List.map (mapAt (paramN r)) ps) (r.t N u) (r.c N body)
declN r (DeclTheory x sp ps body) =
  DeclTheory x sp (List.map (mapAt (paramN r)) ps) (r.c N body)
declN r (DeclPrimitive x sp t) = DeclPrimitive x sp (r.t N t)
declN r (DeclTest x sp) = DeclTest x sp
declN r (DeclWatch c) = DeclWatch (r.c N c)

-- (nominal: each part as its place says)
infNode : MK -> InferableF Checkable TypeForm -> InferableF Checkable TypeForm
infNode r (IApp h args) = IApp (r.i N h) (List.map (mapAt (argN r)) args)
infNode r (IAnn c t) = IAnn (r.c N c) (r.t N t)
infNode r (ISpec a x sp v) = ISpec (r.i N a) x sp (r.c N v)
infNode r (IUpdate a fs) =
  IUpdate (r.i N a) (List.map (mapAt (updateSetN r)) fs)
infNode r (IAnnLam x sp t b) = IAnnLam x sp (r.t N t) (r.i N b)
infNode r (ILitEq x sp eq lit) = ILitEq x sp eq (r.c N lit)
infNode r n = n

chkNode : MK -> CheckableF TypeForm -> CheckableF TypeForm
chkNode r (CInf i) = CInf (r.i N i)
chkNode r (CType t) = CType (r.t N t)
chkNode r (CLam x sp b) = CLam x sp (r.c N b)
chkNode r (CImplicitLam x sp b) = CImplicitLam x sp (r.c N b)
chkNode r (CAnnLam x sp t b) = CAnnLam x sp (r.t N t) (r.c N b)
chkNode r (CTag x sp args) = CTag x sp (List.map (r.c N) args)
chkNode r (CStruct fs) = CStruct (List.map (mapAt (fieldSetM r N)) fs)
chkNode r (CMatch sc alts) = CMatch (r.i N sc) (List.map (mapAt (altN r)) alts)
chkNode r (CLetIn rhs alt) = CLetIn (r.i N rhs) (mapAt (altN r) alt)
chkNode r (CLocal body ds) = CLocal (r.c N body) (List.map (mapAt (declN r)) ds)
chkNode r n = n

typNode : MK -> TypeFormF -> TypeFormF
typNode r (TPi b cod) = TPi (piN r b) (r.t N cod)
typNode r (TSig fs) = TSig (List.map (mapAt (fieldDeclN r)) fs)
typNode r (TSum vs) = TSum (List.map (mapAt (variantN r)) vs)
typNode r (TArray a) = TArray (r.t N a)
typNode r (TInf i) = TInf (r.i N i)
typNode r (TChk c) = TChk (r.c N c)
typNode r n = n

-- (descriptive: passed on, or elaborated as nominal and marked)
infDe : MK -> Params.Span -> InferableF Checkable TypeForm -> Inferable
infDe r sp (IAnn c t) = At (IAnn (r.c De c) (r.t N t)) sp
infDe r sp (IInvalid code why note) = At (IInvalid code why note) sp
infDe r sp n = At (INominal (At (infNode r n) sp)) sp

chkDe : MK -> Params.Span -> CheckableF TypeForm -> Checkable
chkDe r sp (CInf i) = At (CInf (r.i De i)) sp
chkDe r sp (CType t) = At (CType (r.t De t)) sp
chkDe r sp (CLam x xsp b) = At (CLam x xsp (r.c De b)) sp
chkDe r sp (CImplicitLam x xsp b) = At (CImplicitLam x xsp (r.c De b)) sp
chkDe r sp (CStruct fs) = At (CStruct (List.map (mapAt (fieldSetM r De)) fs)) sp
chkDe r sp n = At (CNominal (At (chkNode r n) sp)) sp

typDe : MK -> Params.Span -> TypeFormF -> TypeForm
typDe r sp (TSig fs) = At (typNode r (TSig fs)) sp
typDe r sp (TSum vs) = At (typNode r (TSum vs)) sp
typDe r sp (TInf i) = At (TInf (r.i De i)) sp
typDe r sp (TChk c) = At (TChk (r.c De c)) sp
typDe r sp n = At (TNominal (At (typNode r n) sp)) sp

-- (nominal: a record or sum type is E0204)
descriptiveHere : Params.Span -> TypeForm
descriptiveHere sp =
  At
    (TInf (invalid 4 "cannot use descriptive syntax in nominal position" sp))
    sp

typNom : MK -> Params.Span -> TypeFormF -> TypeForm
typNom r sp (TSig _) = descriptiveHere sp
typNom r sp (TSum _) = descriptiveHere sp
typNom r sp n = At (typNode r n) sp

markI : MK -> Params.Case -> Inferable -> Inferable
markI r N (At n sp) = At (infNode r n) sp
markI r De (At n sp) = infDe r sp n

markC : MK -> Params.Case -> Checkable -> Checkable
markC r N (At n sp) = At (chkNode r n) sp
markC r De (At n sp) = chkDe r sp n

markT : MK -> Params.Case -> TypeForm -> TypeForm
markT r N (At n sp) = typNom r sp n
markT r De (At n sp) = typDe r sp n

mk : MK
mk =
  { i = \cs n -> markI mk cs n
  , c = \cs n -> markC mk cs n
  , t = \cs n -> markT mk cs n
  }

-- | a term, its descriptive positions marked (`De`: it is in one)
markTerm : Params.Case -> Checkable -> Checkable
markTerm cs n = mk.c cs n

-- | a type, its descriptive positions marked
markType : Params.Case -> TypeForm -> TypeForm
markType cs n = mk.t cs n

-- | what a term in descriptive position, elaborated as nominal, is
unNominal : Inferable -> Inferable
unNominal (At (INominal i) _) = i
unNominal i = i
