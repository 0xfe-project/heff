-- The concrete syntax of the `.hf` files: the one reading of the text,
-- which the formatter lays out anew and `heff.syntax.surface` lowers into the
-- notation the elaborator takes.  It keeps every token (the notation drops
-- parentheses and sugar); nothing is resolved here -- which names are in
-- scope, how declared operators bind (`Ops`, `POp` keep them as written):
-- those are the lowering's.
--
-- A parser is `P a`: a function of the token state, giving the state
-- after it, and a value or what is wrong (a diagnostic, where); `bind`
-- makes `do` notation work for it.  The grammar's functions call one
-- another, so they are the fields of one record, `gram`; each `xxxF`
-- function takes that record.
--
-- The sums are flat: a `case` alternative, a `do` statement, a brace
-- field, a constructor's arguments and an operator's right side are
-- constructors of `E` (`EAlt`, `ESBind`, `EFSet`, `EFDefault`,
-- `ECon`, `OpRhs`), as the language defines types one after another.

import array as Array
import co
import exception
import heff.syntax.diagnostic
import heff.elab.fixed as Fixed
import heff.syntax.fixity as Fixity
import heff.syntax.fmt.imports as Imports
import heff.syntax.fmt.lex as Lex
import heff.syntax.fmt.tokens as Tokens
import heff.elab.params as Params
import state

type T = Tokens.T

-- The concrete syntax
--------------------------------------------------------------------------------

data Pat
  = PCon T (List Pat)
  | PAtom T
  | PParen T Pat T
  | PList T (List Pat) (List T) T
  -- | `p op q`, `q` perhaps another (`p op q op' r`): as written
  | POp Pat T Pat
  -- | `{ x = p, ... }`, its fields each `PField`
  | PRec T (List Pat) (List T) T
  | PField T T Pat
  -- | `x@p`, written close (no space on either side of the `@`)
  | PAs T T Pat
  -- | `p::spec`, a segment of a binary pattern (`PList`, its bracket
  -- | `b[`): the pattern, `::`, the spec's tokens
  | PSeg Pat T (List T)

data E
  = Atom T
  | EParen T E T
  | Named T T T E T
  -- | `(a, b)`, or `[a, b]`, or a binary, `b[a, b]` (its brackets say
  -- | which)
  | Tup T (List E) (List T) T
  -- | `e::spec`, a segment of a binary: the value, `::`, the spec's
  -- | tokens (words, numbers, `-`, `size(n)`'s)
  | Seg E T (List T)
  | Braces T (List E) (List T) T
  -- | `{ e | x = v, y.z = w }`, a record with fields replaced: the
  -- | record, `|`, the settings (each `EUSet`)
  | Update T E T (List E) (List T) T
  -- | `x.y = v` in an update: the field's path (a name, its fields), `=`,
  -- | the value
  | EUSet E T E
  -- | `{{x : T}}`, an instance binder
  | InstB T T E T T
  | EFSet T T E
  -- | `x : A = d`, a record type's field and its default; `x : A := d`,
  -- | an implicit argument's
  | EFDefault E T E
  | Sum T T (List E) (List T) T
  | ECon T (List E)
  | EField E T
  -- | `-x`, written close: the `-` and what it negates, an argument's
  -- | worth (`-p.x`, `-(f y)`)
  | ENeg T E
  | App E (List E)
  | Op E T E
  | Ops E (List E)
  | OpRhs T E
  | Ann E T E
  | BVar T
  | BImp T T T
  | BAnn T T T E T
  | Lam T (List E) T E
  | Case T E T (List E)
  | EAlt Pat T E
  | If T E T E T E
  | Do T (List E)
  | ESBind T T E
  -- | `let p : T = e in e'`, the annotation and the body each perhaps
  -- | not there (a `do` block's `let p = e` has no body)
  | ELet T Pat (Maybe (Pair T E)) T E (Maybe (Pair T E))

-- | a theory's field, `x : A`, and its default, `= d`, if it has one
data TF = MkTF T T E (Maybe (Pair T E))

data DAlts = MkDAlts T (List E) (List T)

data D
  = DImport T
  | DFixity T (List T)
  | DSig (List T) T E
  -- | `instance f : T`, the signature of an instance: the keyword, then
  -- | as a signature
  | DInstance T (List T) T E
  -- | an equation, perhaps followed by `where` and local declarations
  | DEqn (List T) (List Pat) T E (Maybe (Pair T (List D)))
  | DData T T (List E) (Maybe (Pair T E)) (Maybe DAlts)
  | DType T T (List E) T E
  | DTheory T T (List E) T (List TF)
  | DPrimitive T T T E
  | DTest T T
  -- | a watch, `-- >>> e`, or a doc test, `-- | >>> e` (the token's
  -- | kind says which: `watch`, `doctest`)
  | DWatch T E

-- The reader's state and monad
--------------------------------------------------------------------------------

-- | `top`: where the declaration being read starts (a line starting at
-- | the left margin after it ends it); `stack`: the columns of the blocks
-- | open, innermost first (-1 inside brackets, where lines end nothing);
-- | `start`: the token the item being read starts with
type St = { toks : Array T, i : Int, top : Int, stack : List Int, start : Int }

-- | What reading does to the world: it has a state, and it may fail
-- | with a diagnostic.  Reading is a computation of these (lib/co.hf),
-- | and its `do` is `co`'s; the reader's handler is below.
reader : HFunctor
reader = state St <+> exception Diag

type P a = Co reader a

pGets : {a : Type} -> (St -> a) -> P a
pGets f = op (inl (state St) (exception Diag) (Get f)) val

pPut : St -> P Unit
pPut s = op (inl (state St) (exception Diag) (Put s MkUnit)) val

pModify : (St -> St) -> P Unit
pModify f = bind (pGets f) pPut

throwP : {a : Type} -> Diag -> P a
throwP d = op (inr (state St) (exception Diag) (Throw d)) val

-- | The reader's handler: a state threaded through, and a failure that
-- | ends reading where it is, with the state there.  (Specialised for
-- | it, a reading is the state passing it would be by hand.)
type Read a = St -> Pair (Either Diag a) St

bindStep : {a b : Type}
         -> Pair (Either Diag a) St
         -> (a -> Read b)
         -> Pair (Either Diag b) St
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

-- (a `Catch`: what is caught is heard where it was thrown, the state kept)
catchStep : {a : Type}
          -> (Diag -> Read a)
          -> Pair (Either Diag a) St
          -> Pair (Either Diag a) St
catchStep h (MkPair (Left d) st) = h d st
catchStep h r = r

readStateAlg : {a : Type} -> StateF St Read a -> Read a
readStateAlg (Get k) = \st -> MkPair (Right (k st)) st
readStateAlg (Put s2 x) = \st -> MkPair (Right x) s2

readExceptionAlg : {a : Type} -> ExceptionF Diag Read a -> Read a
readExceptionAlg (Throw d) = \st -> MkPair (Left d) st
readExceptionAlg (Catch c h) = \st -> catchStep h (c st)

readSumAlg : {a : Type} -> SumF (StateF St) (ExceptionF Diag) Read a -> Read a
readSumAlg (InL t) = readStateAlg t
readSumAlg (InR q) = readExceptionAlg q

readH : Handler reader
readH =
  { M = Read
  , ret = \x st -> MkPair (Right x) st
  , bind = \m k st -> bindStep (m st) k
  , malg = \p -> readSumAlg p
  }

-- | a reading, from a state
runP : {a : Type} -> P a -> St -> Pair (Either Diag a) St
runP m st = handle readH m st

diag : Params.Span -> String -> Diag
diag span msg =
  { code = 150, severity = SError, msg = msg, span = span, note = Nothing }

mkSt : Array T -> Int -> Int -> List Int -> Int -> St
mkSt toks i top stack start =
  { toks = toks, i = i, top = top, stack = stack, start = start }

setI : Int -> St -> St
setI i s = mkSt s.toks i s.top s.stack s.start

setStack : List Int -> St -> St
setStack k s = mkSt s.toks s.i s.top k s.start

setStart : Int -> St -> St
setStart x s = mkSt s.toks s.i s.top s.stack x

-- Tokens and layout
--------------------------------------------------------------------------------

-- | `:` annotates (`::` is an operator: the prelude's cons)
isAnnText : String -> Bool
isAnnText x = strEq x ":"

spanOf : T -> Params.Span
spanOf t = { start = t.start, end = t.end }

spanTT : T -> T -> Params.Span
spanTT a b = { start = a.start, end = b.end }

endBefore : St -> Int -> Int
endBefore s j =
  if j <= 0 then 0
  else case Array.index s.toks (min j (Array.length s.toks) - 1) of
    Just t -> t.end
    Nothing -> 0

-- | where the text ends, as a token
eofAt : Int -> T
eofAt e =
  { kind = "eof"
  , text = ""
  , raw = ""
  , start = e
  , end = e
  , col = 0
  , first = True
  , ix = 0 - 1
  , blank = False
  }

atTok : St -> Int -> T -> T
atTok s j t =
  if strEq t.kind "eof"
  || (j > s.top && t.first && t.col == 0 && not (strEq t.kind "eof"))
    then eofAt (endBefore s j)
  else t

-- | the token at an index, as the declaration being read sees it: a line
-- | starting at the left margin ends it
tokAt : St -> Int -> T
tokAt s j = case Array.index s.toks j of
  Just t -> atTok s j t
  Nothing -> eofAt (endBefore s j)

cur : St -> T
cur s = tokAt s s.i

-- | a token, as an error says what it found
shown : T -> String
shown t =
  if strEq t.kind "eof" then "the end of the declaration"
  else "`" ^ t.text ^ "`"

peek : P T
peek = pGets cur

peekAt : Int -> P T
peekAt k = pGets (\s -> tokAt s (s.i + k))

next : P T
next = do
  t <- peek
  pModify (\s -> setI (s.i + 1) s)
  pure t

nextN : Int -> P (List T)
nextN n =
  if n <= 0 then pure Nil
  else do
    t <- next
    ts <- nextN (n - 1)
    pure (Cons t ts)

isKind : T -> String -> Bool
isKind t k = strEq t.kind k

isText : T -> String -> Bool
isText t x = strEq t.text x

isKw : T -> String -> Bool
isKw t x = isKind t "kw" && isText t x

stackTop : List Int -> Int
stackTop s = fromMaybe 0 (List.head s)

-- | the token ends what is being read: it is the end, or starts a line
-- | not indented past the current block
atBoundary : P Bool
atBoundary =
  pGets
    (\s ->
       strEq (cur s).kind "eof"
       || ((cur s).first
           && (cur s).col <= stackTop s.stack
           && not (s.i == s.start)))

expectAnn : P T
expectAnn = do
  t <- peek
  if isKind t "sym" && isAnnText t.text then next
    else throwP (diag (spanOf t) "expected `:`")

expectSym : String -> P T
expectSym x = do
  t <- peek
  if isKind t "sym" && isText t x then next
    else throwP (diag (spanOf t) ("expected `" ^ x ^ "`, not " ^ shown t))

expectPunct : String -> P T
expectPunct x = do
  t <- peek
  if isKind t "punct" && isText t x then next
    else throwP (diag (spanOf t) ("expected `" ^ x ^ "`, not " ^ shown t))

expectKw : String -> P T
expectKw x = do
  t <- peek
  if isKind t "kw" && isText t x then next
    else throwP (diag (spanOf t) ("expected `" ^ x ^ "`, not " ^ shown t))

expectKind : String -> String -> P T
expectKind k what = do
  t <- peek
  if isKind t k then next
    else throwP (diag (spanOf t) ("expected " ^ what ^ ", not " ^ shown t))

-- | the token starts the block's next item (a line starting `where` ends
-- | the block: the `where` of an equation)
continuesBlock : T -> Int -> Bool
continuesBlock t col =
  not (isKind t "eof") && t.first && t.col == col && not (isKw t "where")

blockGo : {a : Type} -> P a -> Int -> List a -> P (List a)
blockGo item col acc = do
  pModify (\s -> setStart s.i s)
  x <- item
  t' <- peek
  if continuesBlock t' col then blockGo item col (Cons x acc)
    else pure (List.reverse (Cons x acc))

-- | the items of a block: the first sets the column
block : {a : Type} -> P a -> P (List a)
block item = do
  t <- peek
  if isKind t "eof" then throwP (diag (spanOf t) "a block is empty")
    else do
      outer <- pGets (\s -> stackTop s.stack)
      if t.first && t.col <= outer
          then throwP
              (diag (spanOf t) "a block must be indented past what it is in")
        else do
          pModify (\s -> setStack (Cons t.col s.stack) s)
          xs <- blockGo item t.col Nil
          pModify (\s -> setStack (List.drop 1 s.stack) s)
          pure xs

-- | inside brackets, lines do not end anything
inBrackets : {a : Type} -> P a -> P a
inBrackets p = do
  pModify (\s -> setStack (Cons (0 - 1) s.stack) s)
  x <- p
  pModify (\s -> setStack (List.drop 1 s.stack) s)
  pure x

startsAtom : T -> Bool
startsAtom t =
  List.elemBy
    strEq
    t.kind
    ["var", "con", "int", "float", "str", "rune", "neg"]
  || (isKind t "kw"
      && (List.elemBy
            strEq
            t.text
            [ "Type"
            , "Int"
            , "Float64"
            , "String"
            , "Rune"
            , "Array"
            , "data"
            , "abandon"
            ]
          || Fixed.isFixedName t.text))
  || (isKind t "punct"
      && (isText t "(" || isText t "{" || isText t "[" || isText t "b["))

startsItem : T -> Bool
startsItem t =
  startsAtom t || isKind t "var" || (isKind t "punct" && isText t "(")

-- | as many as there are (a failure that reads nothing ends them)
manyGo : {a : Type} -> P a -> List a -> P (List a)
manyGo p acc = do
  b <- atBoundary
  t <- peek
  if b || not (startsItem t) then pure (List.reverse acc)
    else do
      x <- p
      manyGo p (Cons x acc)

many : {a : Type} -> P a -> P (List a)
many p = manyGo p Nil

-- | items between separators, and the separators
data Sep a = MkSep (List a) (List T)

sepGo : {a : Type} -> String -> P a -> List a -> List T -> P (Sep a)
sepGo sep p items seps = do
  t <- peek
  if isText t sep
      then do
        s <- next
        y <- p
        sepGo sep p (Cons y items) (Cons s seps)
    else pure (MkSep (List.reverse items) (List.reverse seps))

sepBy1 : {a : Type} -> String -> P a -> P (Sep a)
sepBy1 sep p = do
  x <- p
  sepGo sep p (Cons x Nil) Nil

-- | a symbol that is an operator (not syntax)
isOperator : T -> Bool
isOperator t = isKind t "sym" && not (List.elemBy strEq t.text Fixity.reserved)

-- | a token that starts a closed expression (one that runs to the end)
startsClosed : T -> Bool
startsClosed t =
  isText t "\\"
  || (isKind t "kw" && List.elemBy strEq t.text ["case", "if", "do", "let"])

-- | the syntax's operators, loosest first: `->` (right), `~` (right)
symPrec : String -> Int
symPrec "->" = 1
symPrec "~" = 2
symPrec s = 0 - 1

mkSum : T -> T -> Sep E -> T -> E
mkSum kw o (MkSep items seps) c = Sum kw o items seps c

mkBraces : T -> Sep E -> T -> E
mkBraces o (MkSep items seps) c = Braces o items seps c

mkUpdate : T -> E -> T -> Sep E -> T -> E
mkUpdate o r bar (MkSep items seps) c = Update o r bar items seps c

mkTup : T -> Sep E -> T -> E
mkTup o (MkSep items seps) c = Tup o items seps c

mkPList : T -> Sep Pat -> T -> Pat
mkPList o (MkSep items seps) c = PList o items seps c

mkPRec : T -> Sep Pat -> T -> Pat
mkPRec o (MkSep items seps) c = PRec o items seps c

mkDAlts : T -> Sep E -> DAlts
mkDAlts eq (MkSep items seps) = MkDAlts eq items seps

-- The expression grammar, knotted through `gram`
--------------------------------------------------------------------------------

type Gram =
  { expr : P E
  , opExpr : Int -> P E
  , userOps : P E
  , app : P E
  , atom : P E
  , pattern : P Pat
  , patHead : P Pat
  , patAtom : P Pat
  , lambda : P E
  , caseE : P E
  , ifE : P E
  , doE : P E
  , letE : P E
  }

exprHead : Gram -> T -> P E
exprHead g t =
  if isText t "\\" && isKind t "sym" then g.lambda
  else if isKw t "case" then g.caseE
  else if isKw t "if" then g.ifE
  else if isKw t "do" then g.doE
  else if isKw t "let" then g.letE
  else g.opExpr 0

exprF : Gram -> P E
exprF g = do
  t <- peek
  e <- exprHead g t
  t' <- peek
  b <- atBoundary
  if isAnnText t'.text && isKind t' "sym" && not b
      then do
        cc <- next
        ty <- g.expr
        pure (Ann e cc ty)
    else pure e

-- the codomain of `->` may be a lambda, a case, ... as any expression
arrowRhsF : Gram -> P E
arrowRhsF g = do
  t <- peek
  if startsClosed t then g.expr else g.opExpr 1

opLoopF : Gram -> Int -> E -> P E
opLoopF g minPrec lhs = do
  t <- peek
  b <- atBoundary
  if isKind t "sym" && symPrec t.text >= 1 && symPrec t.text >= minPrec && not b
      then do
        op <- next
        rhs <-
          if symPrec t.text == 1 then arrowRhsF g else g.opExpr (symPrec t.text)
        opLoopF g minPrec (Op lhs op rhs)
    else pure lhs

opExprF : Gram -> Int -> P E
opExprF g minPrec = do
  lhs <- g.userOps
  opLoopF g minPrec lhs

operandsF : Gram -> List E -> P (List E)
operandsF g acc = do
  t <- peek
  b <- atBoundary
  if isOperator t && not b
      then do
        op <- next
        u <- peek
        if startsClosed u
            then do
              e <- g.expr
              pure (List.reverse (Cons (OpRhs op e) acc))
          else do
            e <- g.app
            operandsF g (Cons (OpRhs op e) acc)
    else pure (List.reverse acc)

-- | `a + b * c`, as written.  An operand is an application, or, last, a
-- | lambda, `case`, `if` or `do`
userOpsF : Gram -> P E
userOpsF g = do
  e0 <- g.app
  rest <- operandsF g Nil
  pure (if List.null rest then e0 else Ops e0 rest)

-- | application: a head and its arguments
appF : Gram -> P E
appF g = do
  h <- g.atom
  args <- many g.atom
  pure (if List.null args then h else App h args)

fieldsGo : E -> P E
fieldsGo e = do
  t <- peek
  if isKind t "field"
      then do
        f <- next
        fieldsGo (EField e f)
    else pure e

settingF : Gram -> P E
settingF g = do
  x <- next
  eq <- expectSym "="
  e <- g.expr
  pure (EFSet x eq e)

-- | `x.y = v`, a setting of an update
updateSettingF : Gram -> P E
updateSettingF g = do
  t <- peek
  if not (isKind t "var")
      then throwP
          (diag
             (spanOf t)
             "an update sets a field by its name: `{ r | x = v }`")
    else do
      x <- next
      path <- fieldsGo (Atom x)
      eq <- expectSym "="
      e <- g.expr
      pure (EUSet path eq e)

-- | `| x = v, ...` after the record in `{ r | x = v, ... }`
updateF : Gram -> T -> E -> P E
updateF g o r = do
  bar <- next
  fs <- sepBy1 "," (updateSettingF g)
  c <- expectPunct "}"
  pure (mkUpdate o r bar fs c)

-- | what is in braces, and `= d` after it: a record type's field and its
-- | default; or `:= d`, an implicit argument's
defaultedF : Gram -> P E
defaultedF g = do
  e <- g.expr
  t <- peek
  b <- atBoundary
  if isKind t "sym" && (isText t "=" || isText t ":=") && not b
      then do
        eq <- next
        d <- g.expr
        pure (EFDefault e eq d)
    else pure e

-- | `{ x : A, ... }` (a record type, its fields perhaps with defaults,
-- | `x : A = d`), `{ x = e, ... }` (a record), `{ r | x = e, ... }` (a
-- | record updated), `{}`, `{x : A}` (an implicit binder), and `{{x :
-- | A}}` (an instance one)
bracesF : Gram -> P E
bracesF g = do
  o <- next
  inBrackets (do
    t <- peek
    t2 <- peekAt 1
    if isKind t "punct" && isText t "{"
        then do
          o2 <- next
          d <- inBrackets g.expr
          c1 <- expectPunct "}"
          c <- expectPunct "}"
          pure (InstB o o2 d c1 c)
      else if isText t "}"
        then do
          c <- next
          pure (Braces o Nil Nil c)
      else if isText t2 "="
        then do
          fs <- sepBy1 "," (settingF g)
          c <- expectPunct "}"
          pure (mkBraces o fs c)
      else do
        f <- defaultedF g
        t' <- peek
        if isKind t' "sym" && isText t' "|" then updateF g o f
          else do
            fs <- sepGo "," (defaultedF g) (Cons f Nil) Nil
            c <- expectPunct "}"
            pure (mkBraces o fs c))

-- | `C x y`, an alternative of a sum
altConF : Gram -> P E
altConF g = do
  c <- next
  args <- many g.atom
  pure (ECon c args)

-- | `data { A x | B }`, a sum type without a name
anonymousSumF : Gram -> P E
anonymousSumF g = do
  kw <- next
  o <- expectPunct "{"
  inBrackets (do
    alts <- sepBy1 "|" (altConF g)
    c <- expectPunct "}"
    pure (mkSum kw o alts c))

-- | `[a, b, c]` (of expressions or of patterns), and `[]`
listOfF : {a b : Type} -> P a -> (T -> Sep a -> T -> b) -> P b
listOfF item mk = do
  o <- next
  inBrackets (do
    t <- peek
    xs <- if isText t "]" then pure (MkSep Nil Nil) else sepBy1 "," item
    c <- expectPunct "]"
    pure (mk o xs c))

-- | `( e )`, `(a, b)`, `(x := e)` (a named argument), `(+)`
parensF : Gram -> P E
parensF g = do
  o <- next
  inBrackets (do
    t <- peek
    t2 <- peekAt 1
    if isOperator t && isText t2 ")"
        then do
          op <- next
          c <- next
          pure (EParen o (Atom op) c)
      else if (isKind t "var" || isKind t "con")
      && isKind t2 "sym"
      && isText t2 ":="
        then do
          x <- next
          k <- next
          e <- g.expr
          c <- expectPunct ")"
          pure (Named o x k e c)
      else do
        e <- g.expr
        t' <- peek
        if isText t' ","
            then do
              r <- sepGo "," g.expr (Cons e Nil) Nil
              c <- expectPunct ")"
              pure (mkTup o r c)
          else do
            c <- expectPunct ")"
            pure (EParen o e c))

-- A binary, `b[...]`: its segments, each a value, perhaps `::` and a
-- spec.  The first `::` outside brackets ends the value (cons, `::`, in
-- one, is in parentheses); the spec is the words, numbers, `-`s and
-- parentheses up to the next `,` or `]` (the lowering reads it).

-- | a token of a spec: a word, a number, `-`, `(`, `)`
isSpecTok : T -> Bool
isSpecTok t =
  isKind t "var"
  || isKind t "int"
  || (isKind t "punct" && (isText t "(" || isText t ")"))
  || ((isKind t "sym" || isKind t "neg") && isText t "-")

-- | a spec's tokens
specToksGo : List T -> P (List T)
specToksGo acc = do
  t <- peek
  if isSpecTok t
      then do
        x <- next
        specToksGo (Cons x acc)
    else pure (List.reverse acc)

-- (an operand's operators up to a `::`)
segOperandsF : Gram -> List E -> P (List E)
segOperandsF g acc = do
  t <- peek
  if isOperator t && not (isText t "::")
      then do
        op <- next
        u <- peek
        if startsClosed u
            then do
              e <- g.expr
              pure (List.reverse (Cons (OpRhs op e) acc))
          else do
            e <- g.app
            segOperandsF g (Cons (OpRhs op e) acc)
    else pure (List.reverse acc)

-- | a segment's value: `a + b`, as written, or a lambda, `case`, `if`,
-- | `do`
segValueF : Gram -> P E
segValueF g = do
  t <- peek
  if startsClosed t then g.expr
    else do
      e0 <- g.app
      rest <- segOperandsF g Nil
      pure (if List.null rest then e0 else Ops e0 rest)

-- | a segment of a binary: `e`, or `e::spec`
segmentF : Gram -> P E
segmentF g = do
  v <- segValueF g
  t <- peek
  if isKind t "sym" && isText t "::"
      then do
        cc <- next
        spec <- specToksGo Nil
        pure (Seg v cc spec)
    else pure v

atomBase : Gram -> T -> P E
atomBase g t =
  if List.elemBy
    strEq
    t.kind
    ["var", "con", "int", "float", "str", "rune"]
  || (isKind t "kw"
      && (List.elemBy
            strEq
            t.text
            ["Type", "Int", "Float64", "String", "Rune", "Array", "abandon"]
          || Fixed.isFixedName t.text))
    then do
      a <- next
      pure (Atom a)
  else if isKw t "data" then anonymousSumF g
  else if isKind t "neg"
    then do
      m <- next
      e <- g.atom
      pure (ENeg m e)
  else if isKind t "punct" && isText t "(" then parensF g
  else if isKind t "punct" && isText t "{" then bracesF g
  else if isKind t "punct" && isText t "[" then listOfF g.expr mkTup
  else if isKind t "punct" && isText t "b[" then listOfF (segmentF g) mkTup
  else throwP (diag (spanOf t) ("expected an expression, not " ^ shown t))

-- | the arguments of an application, with fields: `x`, `C`, `3`, `"s"`,
-- | `(e)`, `{...}`, `p.x`
atomF : Gram -> P E
atomF g = do
  t <- peek
  b <- atBoundary
  if b || not (startsAtom t)
      then throwP (diag (spanOf t) ("expected an expression, not " ^ shown t))
    else do
      base <- atomBase g t
      fieldsGo base

-- | `x`, `{x}`, `(x : T)`
lamBinderF : Gram -> P E
lamBinderF g = do
  t <- peek
  if isKind t "var" || isKind t "con"
      then do
        x <- next
        pure (BVar x)
    else if isKind t "punct" && isText t "{"
      then do
        o <- next
        x <- peek
        if not (isKind x "var" || isKind x "con")
            then throwP (diag (spanOf x) "expected an implicit argument's name")
          else do
            x2 <- next
            c <- expectPunct "}"
            pure (BImp o x2 c)
    else if isKind t "punct" && isText t "("
      then do
        o <- next
        inBrackets (do
          x <- peek
          if not (isKind x "var" || isKind x "con")
              then throwP
                  (diag (spanOf x) "expected a binder's name: `\\(x : T) -> e`")
            else do
              x2 <- next
              cc <- expectAnn
              ty <- g.expr
              c <- expectPunct ")"
              pure (BAnn o x2 cc ty c))
    else throwP
        (diag (spanOf t) "a lambda binds names: `\\x y -> e`, `\\(x : T) -> e`")

lamBinders : Gram -> List E -> P (List E)
lamBinders g acc = do
  t <- peek
  if isKind t "var"
    || isKind t "con"
    || (isKind t "punct" && (isText t "{" || isText t "("))
      then do
        b <- lamBinderF g
        lamBinders g (Cons b acc)
    else pure (List.reverse acc)

-- | `\x {y} _ -> e`
lambdaF : Gram -> P E
lambdaF g = do
  bs <- next
  b0 <- lamBinderF g
  more <- lamBinders g Nil
  arrow <- expectSym "->"
  body <- g.expr
  pure (Lam bs (Cons b0 more) arrow body)

alternativeF : Gram -> P E
alternativeF g = do
  p <- g.pattern
  arrow <- expectSym "->"
  e <- g.expr
  pure (EAlt p arrow e)

-- | `case e of` and its alternatives, `C x y -> e`
caseExprF : Gram -> P E
caseExprF g = do
  kw <- next
  scrut <- g.expr
  o <- expectKw "of"
  alts <- block (alternativeF g)
  pure (Case kw scrut o alts)

ifExprF : Gram -> P E
ifExprF g = do
  kw <- next
  c <- g.expr
  th <- expectKw "then"
  a <- g.expr
  el <- expectKw "else"
  b <- g.expr
  pure (If kw c th a el b)

-- | `let`'s pattern, its annotation if any, `=`, and what it is bound to
data LetHead = MkLetHead Pat (Maybe (Pair T E)) T E

letHeadF : Gram -> P LetHead
letHeadF g = do
  p <- g.pattern
  t <- peek
  ann <-
    if isKind t "sym" && isAnnText t.text
      then do
        cc <- next
        ty <- g.expr
        pure (Just (MkPair cc ty))
    else pure Nothing
  eq <- expectSym "="
  e <- g.expr
  pure (MkLetHead p ann eq e)

letOf : T -> LetHead -> Maybe (Pair T E) -> E
letOf kw (MkLetHead p ann eq e) body = ELet kw p ann eq e body

-- | `in e` after `let p = e'`
letBodyF : Gram -> T -> LetHead -> P E
letBodyF g kw h = do
  i <- expectKw "in"
  body <- g.expr
  pure (letOf kw h (Just (MkPair i body)))

-- | `let p = e in e'`
letExprF : Gram -> P E
letExprF g = do
  kw <- next
  h <- letHeadF g
  letBodyF g kw h

-- | `let p = e` in a `do` block (followed by `in`, it is the expression)
letStmtF : Gram -> P E
letStmtF g = do
  kw <- next
  h <- letHeadF g
  t <- peek
  if isKw t "in" then letBodyF g kw h else pure (letOf kw h Nothing)

-- | `x <- e`, `let p = e`, or `e`
statementF : Gram -> P E
statementF g = do
  t <- peek
  t2 <- peekAt 1
  if isKw t "let" then letStmtF g
    else if isKind t "var" && isText t2 "<-"
      then do
        x <- next
        arrow <- next
        e <- g.expr
        pure (ESBind x arrow e)
    else g.expr

doExprF : Gram -> P E
doExprF g = do
  kw <- next
  stmts <- block (statementF g)
  pure (Do kw stmts)

-- | `x = p` in a record pattern
fieldPatF : Gram -> P Pat
fieldPatF g = do
  x <- expectKind "var" "a field name"
  eq <- expectSym "="
  p <- g.pattern
  pure (PField x eq p)

-- | `{ x = p, ... }`, a record pattern
recordPatF : Gram -> P Pat
recordPatF g = do
  o <- next
  inBrackets (do
    fs <- sepBy1 "," (fieldPatF g)
    c <- expectPunct "}"
    pure (mkPRec o fs c))

patHeadF : Gram -> P Pat
patHeadF g = do
  t <- peek
  if isKind t "con"
      then do
        c <- next
        args <- many g.patAtom
        pure (PCon c args)
    else g.patAtom

-- | a pattern: `C p ...`, or an atomic one; or such patterns between
-- | operators, `x :: xs` (an operator is another name for a tag:
-- | elaboration finds which)
patternF : Gram -> P Pat
patternF g = do
  p <- g.patHead
  t <- peek
  b <- atBoundary
  if isOperator t && not b
      then do
        op <- next
        r <- g.pattern
        pure (POp p op r)
    else pure p

-- | a segment of a binary pattern: `p`, or `p::spec`
patSegmentF : Gram -> P Pat
patSegmentF g = do
  p <- g.patAtom
  t <- peek
  if isKind t "sym" && isText t "::"
      then do
        cc <- next
        spec <- specToksGo Nil
        pure (PSeg p cc spec)
    else pure p

-- | `x`, `_`, `C` (with no arguments), a literal, `x@p`, `[...]`, `{...}`, `(p)`
patAtomF : Gram -> P Pat
patAtomF g = do
  t <- peek
  t2 <- peekAt 1
  t3 <- peekAt 2
  b <- atBoundary
  if b then throwP (diag (spanOf t) "expected a pattern")
    else if isKind t "var"
    && isText t2 "@"
    && t.end == t2.start
    && t2.end == t3.start
      then do
        x <- next
        at <- next
        p <- g.patAtom
        pure (PAs x at p)
    else if List.elemBy
      strEq
      t.kind
      ["var", "con", "int", "float", "str", "rune"]
      then do
        x <- next
        pure (PAtom x)
    else if isKind t "punct" && isText t "[" then listOfF g.pattern mkPList
    else if isKind t "punct" && isText t "b["
      then listOfF (patSegmentF g) mkPList
    else if isKind t "punct" && isText t "{" then recordPatF g
    else if isKind t "punct" && isText t "("
      then do
        o <- next
        inBrackets (do
          p <- g.pattern
          c <- expectPunct ")"
          pure (PParen o p c))
    else if isKind t "neg"
      then throwP
          (diag (spanOf t) "a pattern negates only a number, its sign: `-1`")
    else throwP (diag (spanOf t) ("expected a pattern, not " ^ shown t))

gram : Gram
gram =
  { expr = \st -> exprF gram st
  , opExpr = \minPrec st -> opExprF gram minPrec st
  , userOps = \st -> userOpsF gram st
  , app = \st -> appF gram st
  , atom = \st -> atomF gram st
  , pattern = \st -> patternF gram st
  , patHead = \st -> patHeadF gram st
  , patAtom = \st -> patAtomF gram st
  , lambda = \st -> lambdaF gram st
  , caseE = \st -> caseExprF gram st
  , ifE = \st -> ifExprF gram st
  , doE = \st -> doExprF gram st
  , letE = \st -> letExprF gram st
  }

-- The declarations
--------------------------------------------------------------------------------

-- | a parameter of a type: `a` (a type), `(x : T)` or `{x : T}` (what is
-- | inside, the lowering's to check)
dataParam : P E
dataParam = do
  t <- peek
  b <- atBoundary
  if b then throwP (diag (spanOf t) "no parameter here")
    else if isKind t "con"
      then throwP
          (diag
             (spanOf t)
             ("a type's parameter is lower case, or given its type: `("
              ^ t.text
              ^ " :: Type)`"))
    else if isKind t "var"
      then do
        x <- next
        pure (Atom x)
    else if isText t "(" || isText t "{" then gram.atom
    else throwP (diag (spanOf t) "no parameter here")

manyParams : List E -> P (List E)
manyParams acc = do
  b <- atBoundary
  t <- peek
  if b || not (startsItem t) then pure (List.reverse acc)
    else do
      x <- dataParam
      manyParams (Cons x acc)

dataAlternative : P E
dataAlternative = do
  c <- next
  if isKind c "con"
      then do
        args <- many gram.atom
        pure (ECon c args)
    else throwP (diag (spanOf c) "a constructor starts with a capital")

-- (a type is a term: its name cannot also be a constructor's)
checkAltNames : String -> List E -> P Unit
checkAltNames name Nil = pure MkUnit
checkAltNames name (Cons (ECon c args) rest) =
  if strEq c.text name
    then throwP
        (diag
           (spanOf c)
           ("`"
            ^ c.text
            ^ "` names the type; its constructor needs another name, e.g. `Mk"
            ^ c.text
            ^ "`"))
  else checkAltNames name rest
checkAltNames name (Cons _ rest) = checkAltNames name rest

altsOf : Maybe DAlts -> List E
altsOf (Just (MkDAlts eq alts bars)) = alts
altsOf Nothing = Nil

-- | `data T a = C x y | D`, and `data T : U = ...`
dataDecl : P D
dataDecl = do
  kw <- next
  name <- expectKind "con" "the name of a type"
  params <- manyParams Nil
  t0 <- peek
  universe <-
    if isAnnText t0.text && isKind t0 "sym"
      then do
        cc <- next
        u <- gram.app
        pure (Just (MkPair cc u))
    else pure Nothing
  t <- peek
  alts <-
    if isText t "="
      then do
        eq <- next
        r <- sepBy1 "|" dataAlternative
        pure (Just (mkDAlts eq r))
    else pure Nothing
  checkAltNames name.text (altsOf alts)
  pure (DData kw name params universe alts)

-- | `type T a = ...`
typeDecl : P D
typeDecl = do
  kw <- next
  name <- expectKind "con" "the name of a type"
  params <- manyParams Nil
  eq <- expectSym "="
  body <- gram.expr
  pure (DType kw name params eq body)

-- (`= d`, a theory's field's default, if there is one)
fieldDefault : P (Maybe (Pair T E))
fieldDefault = do
  t <- peek
  b <- atBoundary
  if isKind t "sym" && isText t "=" && not b
      then do
        eq <- next
        d <- gram.expr
        pure (Just (MkPair eq d))
    else pure Nothing

theoryField : P TF
theoryField = do
  x <- next
  if not (isKind x "var" || isKind x "con")
      then throwP (diag (spanOf x) "a field is `name : Type`")
    else do
      cc <- expectAnn
      ty <- gram.expr
      d <- fieldDefault
      pure (MkTF x cc ty d)

-- | `theory T a where` and its fields
theoryDecl : P D
theoryDecl = do
  kw <- next
  name <- expectKind "con" "the name of a theory"
  params <- manyParams Nil
  w <- expectKw "where"
  fields <- block theoryField
  pure (DTheory kw name params w fields)

-- | `primitive name : T`, a primitive: the runtime's, its type said
primitiveDecl : P D
primitiveDecl = do
  kw <- next
  x <- expectKind "var" "the primitive's name"
  cc <- expectAnn
  ty <- gram.expr
  pure (DPrimitive kw x cc ty)

-- | (what a fixity declaration says is read before the rest, from the
-- | tokens: here they are only kept)
fixityRest : List T -> P (List T)
fixityRest acc = do
  u <- peek
  if isKind u "eof" || (u.first && u.col == 0) then pure (List.reverse acc)
    else do
      v <- next
      fixityRest (Cons v acc)

-- | how many tokens name what a signature or an equation defines: `f`,
-- | `C`, or `(+)`
declNameLen : T -> T -> T -> Int
declNameLen t t2 t3 =
  if isKind t "var" || isKind t "con" then 1
  else if isText t "(" && isOperator t2 && isText t3 ")" then 3
  else 0

-- | `instance f : T`, an instance's signature: its equations are written
-- | as any definition's
instanceDecl : P D
instanceDecl = do
  kw <- next
  t <- peek
  t2 <- peekAt 1
  t3 <- peekAt 2
  if declNameLen t t2 t3 == 0
      then throwP (diag (spanOf t) "an instance is named: `instance f : T`")
    else do
      name <- nextN (declNameLen t t2 t3)
      cc <- expectAnn
      ty <- gram.expr
      pure (DInstance kw name cc ty)

-- | a signature, or an equation, perhaps followed by `where` and its
-- | local declarations (each read by `item`)
sigOrEqn : P D -> T -> P D
sigOrEqn item t = do
  t2 <- peekAt 1
  t3 <- peekAt 2
  if declNameLen t t2 t3 == 0
      then throwP
          (diag (spanOf t) ("a declaration cannot start with `" ^ t.text ^ "`"))
    else do
      u <- peekAt (declNameLen t t2 t3)
      if isAnnText u.text
          then do
            name <- nextN (declNameLen t t2 t3)
            cc <- next
            ty <- gram.expr
            pure (DSig name cc ty)
        else do
          name <- nextN (declNameLen t t2 t3)
          pats <- many gram.patAtom
          eq <- expectSym "="
          rhs <- gram.expr
          w <- peek
          locals <-
            if isKw w "where"
              then do
                kw <- next
                ds <- block item
                pure (Just (MkPair kw ds))
            else pure Nothing
          pure (DEqn name pats eq rhs locals)

-- | a local declaration, of a `where`: a signature or an equation (an
-- | instance is the module's, declared at the top level)
localDecl : P D
localDecl = \st ->
    (do
     t <- peek
     if isKw t "instance"
         then throwP
             (diag
                (spanOf t)
                "an instance is declared at the top level, not in a `where`")
       else sigOrEqn localDecl t)
      st

declAt : T -> P D
declAt t =
  if isKind t "import"
    then do
      i <- next
      pure (DImport i)
  else if isKw t "data" then dataDecl
  else if isKw t "type" then typeDecl
  else if isKw t "theory" then theoryDecl
  else if isKw t "primitive" then primitiveDecl
  else if isKw t "instance" then instanceDecl
  else if isKw t "infixl" || isKw t "infixr" || isKw t "infix"
    then do
      kw <- next
      ts <- fixityRest Nil
      pure (DFixity kw ts)
  else if isKw t "test"
    then do
      kw <- next
      x <- expectKind "var" "a test's name"
      pure (DTest kw x)
  else if isKind t "watch" || isKind t "doctest"
    then do
      w <- next
      e <- gram.expr
      pure (DWatch w e)
  else sigOrEqn localDecl t

-- | a top-level declaration
decl : P D
decl = do
  t <- peek
  declAt t

-- The program, declaration by declaration
--------------------------------------------------------------------------------

-- | the tokens of a text, read from the first
initialSt : Array T -> St
initialSt toks = mkSt toks 0 0 (Cons 0 Nil) 0

-- | a declaration starts here
declReset : St -> St
declReset s = mkSt s.toks s.i s.i (Cons 0 Nil) s.i

skipFrom : St -> St
skipFrom s = if strEq (cur s).kind "eof" then s else skipFrom (setI (s.i + 1) s)

-- | on to the next declaration (past the first token of this one, at
-- | least)
skipDecl : St -> St
skipDecl s =
  skipFrom
    (setStack
       (Cons 0 Nil)
       (setI (if s.i < s.top + 1 then s.top + 1 else s.i) s))

-- | one declaration read where `s` is (reset), and the state after it
declStep : St -> Pair (Either Diag D) St
declStep s = runP decl (declReset s)

-- | is the state at the end of the text (not of a declaration)?
textDone : St -> Bool
textDone s = strEq (tokAt (declReset s) s.i).kind "eof"

-- | the name the declaration starting at `top` defines, as far as it says
declaredOne : T -> Maybe String
declaredOne t =
  if isKind t "var" || isKind t "con" then Just t.text else Nothing

declaredTwo : T -> T -> Maybe String
declaredTwo t u =
  if isKind t "kw"
  && List.elemBy
    strEq
    t.text
    ["data", "type", "theory", "primitive", "instance"]
    then Just u.text
  else if isText t "(" && isKind u "sym" then Just u.text
  else declaredOne t

declaredAt : St -> Maybe String
declaredAt s = case Array.index s.toks s.top of
  Just t -> case Array.index s.toks (s.top + 1) of
    Just u -> declaredTwo t u
    Nothing -> declaredOne t
  Nothing -> Nothing

-- | why a text does not parse, as the formatter says it
notParsing : Diag -> String
notParsing d =
  "the file does not parse (at offset "
  ^ show d.span.start
  ^ ": "
  ^ d.msg
  ^ ")"

-- (every declaration, the first thing wrong ending it)
programGo : St -> List D -> Either String (List D)
programGo s acc =
  if textDone s then Right (List.reverse acc)
  else case declStep s of
    MkPair (Left d) s2 -> Left (notParsing d)
    MkPair (Right d) s2 ->
      if strEq (cur s2).kind "eof" then programGo s2 (Cons d acc)
      else Left
          (notParsing
             (diag (spanOf (cur s2)) ("unexpected `" ^ (cur s2).text ^ "`")))

-- | The declarations of the tokens (`Tokens.attach`'s, imports merged in).
parseToks : Array T -> Either String (List D)
parseToks ts = programGo (initialSt ts) Nil

parseAttached : Tokens.Attached -> Either String (List D)
parseAttached at = parseToks at.toks

parseLexed : String -> Imports.Header -> Lex.Lexed -> Either String (List D)
parseLexed src hdr l =
  parseAttached
    (Tokens.attach src (Imports.withImports hdr.imports l.tokens) l.comments)

parseHeader : String -> Imports.Header -> Either String (List D)
parseHeader src hdr = parseLexed src hdr (Lex.lex hdr.text)

-- | A file's declarations: its imports read off, the rest lexed and read.
parseFile : String -> Either String (List D)
parseFile src = parseHeader src (Imports.readImports src)

-- The first and the last token of a piece, for the comments' sake
--------------------------------------------------------------------------------

firstP : Pat -> T
firstP (POp l op r) = firstP l
firstP (PCon t args) = t
firstP (PAtom t) = t
firstP (PParen o p c) = o
firstP (PList o ps commas c) = o
firstP (PRec o fs commas c) = o
firstP (PField x eq p) = x
firstP (PAs x at p) = x
firstP (PSeg p cc spec) = firstP p

lastP : Pat -> T
lastP (POp l op r) = lastP r
lastP (PCon t args) = case List.last args of
  Just p -> lastP p
  Nothing -> t
lastP (PAtom t) = t
lastP (PParen o p c) = c
lastP (PList o ps commas c) = c
lastP (PRec o fs commas c) = c
lastP (PField x eq p) = lastP p
lastP (PAs x at p) = lastP p
lastP (PSeg p cc spec) = fromMaybe cc (List.last spec)

firstE : E -> T
firstE (Atom t) = t
firstE (EParen o e c) = o
firstE (Named o x k e c) = o
firstE (Tup o es commas c) = o
firstE (Seg v cc spec) = firstE v
firstE (Braces o fs commas c) = o
firstE (InstB o o2 d c1 c) = o
firstE (Update o r bar fs commas c) = o
firstE (EUSet x eq e) = firstE x
firstE (EFSet x eq e) = x
firstE (EFDefault e eq d) = firstE e
firstE (Sum kw o alts bars c) = kw
firstE (ECon c args) = c
firstE (EField e f) = firstE e
firstE (ENeg m e) = m
firstE (App h args) = firstE h
firstE (Op a op b) = firstE a
firstE (Ops a rest) = firstE a
firstE (OpRhs op e) = op
firstE (Ann e cc ty) = firstE e
firstE (BVar t) = t
firstE (BImp o x c) = o
firstE (BAnn o x cc ty c) = o
firstE (Lam bs binders arrow body) = bs
firstE (Case kw scrut of2 alts) = kw
firstE (EAlt p arrow body) = firstP p
firstE (If kw c th a el b) = kw
firstE (Do kw stmts) = kw
firstE (ESBind x arrow e) = x
firstE (ELet kw p ann eq e body) = kw

lastE : E -> T
lastE (Atom t) = t
lastE (EParen o e c) = c
lastE (Named o x k e c) = c
lastE (Tup o es commas c) = c
lastE (Seg v cc spec) = fromMaybe cc (List.last spec)
lastE (Braces o fs commas c) = c
lastE (InstB o o2 d c1 c) = c
lastE (Update o r bar fs commas c) = c
lastE (EUSet x eq e) = lastE e
lastE (EFSet x eq e) = lastE e
lastE (EFDefault e eq d) = lastE d
lastE (Sum kw o alts bars c) = c
lastE (ECon c args) =
  (case List.last args of
   Just e -> lastE e
   Nothing -> c)
lastE (EField e f) = f
lastE (ENeg m e) = lastE e
lastE (App h args) =
  (case List.last args of
   Just e -> lastE e
   Nothing -> lastE h)
lastE (Op a op b) = lastE b
lastE (Ops a rest) =
  (case List.last rest of
   Just e -> lastE e
   Nothing -> lastE a)
lastE (OpRhs op e) = lastE e
lastE (Ann e cc ty) = lastE ty
lastE (BVar t) = t
lastE (BImp o x c) = c
lastE (BAnn o x cc ty c) = c
lastE (Lam bs binders arrow body) = lastE body
lastE (Case kw scrut of2 alts) =
  (case List.last alts of
   Just e -> lastE e
   Nothing -> of2)
lastE (EAlt p arrow body) = lastE body
lastE (If kw c th a el b) = lastE b
lastE (Do kw stmts) =
  (case List.last stmts of
   Just e -> lastE e
   Nothing -> kw)
lastE (ESBind x arrow e) = lastE e
lastE (ELet kw p ann eq e body) =
  (case body of
   Just (MkPair i b) -> lastE b
   Nothing -> lastE e)

-- (`lastE` of the element, if there is one; the fallback otherwise)
lastEOr : T -> Maybe E -> T
lastEOr t Nothing = t
lastEOr t (Just e) = lastE e

nmFirst : List T -> T
nmFirst n = fromMaybe (eofAt 0) (List.head n)

firstD : D -> T
firstD (DImport t) = t
firstD (DFixity kw ts) = kw
firstD (DSig n cc ty) = nmFirst n
firstD (DInstance kw n cc ty) = kw
firstD (DEqn n pats eq rhs w) = nmFirst n
firstD (DData kw name params universe alts) = kw
firstD (DType kw name params eq body) = kw
firstD (DTheory kw name params w fields) = kw
firstD (DPrimitive kw x cc ty) = kw
firstD (DTest kw x) = kw
firstD (DWatch w e) = w

tfLast : TF -> T
tfLast (MkTF x cc ty Nothing) = lastE ty
tfLast (MkTF x cc ty (Just (MkPair eq d))) = lastE d

dataLastPlain : T -> List E -> Maybe (Pair T E) -> T
dataLastPlain name params (Just (MkPair cc u)) = lastE u
dataLastPlain name params Nothing = lastEOr name (List.last params)

dataLast : T -> List E -> Maybe (Pair T E) -> Maybe DAlts -> T
dataLast name params universe (Just (MkDAlts eq alts bars)) =
  lastEOr (dataLastPlain name params universe) (List.last alts)
dataLast name params universe Nothing = dataLastPlain name params universe

lastTF : T -> Maybe TF -> T
lastTF t Nothing = t
lastTF t (Just f) = tfLast f

lastD : D -> T
lastD (DImport t) = t
lastD (DFixity kw ts) = fromMaybe kw (List.last ts)
lastD (DSig n cc ty) = lastE ty
lastD (DInstance kw n cc ty) = lastE ty
lastD (DEqn n pats eq rhs (Just (MkPair kw ds))) = case List.last ds of
  Just d -> lastD d
  Nothing -> kw
lastD (DEqn n pats eq rhs Nothing) = lastE rhs
lastD (DData kw name params universe alts) = dataLast name params universe alts
lastD (DType kw name params eq body) = lastE body
lastD (DTheory kw name params w fields) = lastTF w (List.last fields)
lastD (DPrimitive kw x cc ty) = lastE ty
lastD (DTest kw x) = x
lastD (DWatch w e) = lastE e

-- Every token, in order: reading loses none
--------------------------------------------------------------------------------

interleaveT : List (List T) -> List T -> List T
interleaveT Nil seps = Nil
interleaveT (Cons e es) Nil = List.append e (interleaveT es Nil)
interleaveT (Cons e es) (Cons s ss) =
  if List.null es then e else List.append e (Cons s (interleaveT es ss))

tsP : Pat -> List T
tsP (POp l op r) = List.append (tsP l) (Cons op (tsP r))
tsP (PCon t args) = Cons t (List.concatMap tsP args)
tsP (PAtom t) = Cons t Nil
tsP (PParen o p c) = Cons o (List.append (tsP p) (Cons c Nil))
tsP (PList o ps commas c) =
  Cons o (List.append (interleaveT (List.map tsP ps) commas) (Cons c Nil))
tsP (PRec o fs commas c) =
  Cons o (List.append (interleaveT (List.map tsP fs) commas) (Cons c Nil))
tsP (PField x eq p) = Cons x (Cons eq (tsP p))
tsP (PAs x at p) = Cons x (Cons at (tsP p))
tsP (PSeg p cc spec) = List.append (tsP p) (Cons cc spec)

tsE : E -> List T
tsE (Atom t) = Cons t Nil
tsE (EParen o e c) = Cons o (List.append (tsE e) (Cons c Nil))
tsE (Named o x k e c) =
  Cons o (Cons x (Cons k (List.append (tsE e) (Cons c Nil))))
tsE (Tup o es commas c) =
  Cons o (List.append (interleaveT (List.map tsE es) commas) (Cons c Nil))
tsE (Seg v cc spec) = List.append (tsE v) (Cons cc spec)
tsE (Braces o fs commas c) =
  Cons o (List.append (interleaveT (List.map tsE fs) commas) (Cons c Nil))
tsE (InstB o o2 d c1 c) =
  Cons o (Cons o2 (List.append (tsE d) (Cons c1 (Cons c Nil))))
tsE (Update o r bar fs commas c) =
  Cons
    o
    (List.append
       (tsE r)
       (Cons
          bar
          (List.append (interleaveT (List.map tsE fs) commas) (Cons c Nil))))
tsE (EUSet x eq e) = List.append (tsE x) (Cons eq (tsE e))
tsE (EFSet x eq e) = Cons x (Cons eq (tsE e))
tsE (EFDefault e eq d) = List.append (tsE e) (Cons eq (tsE d))
tsE (Sum kw o alts bars c) =
  Cons
    kw
    (Cons o (List.append (interleaveT (List.map tsE alts) bars) (Cons c Nil)))
tsE (ECon c args) = Cons c (List.concatMap tsE args)
tsE (EField e f) = List.append (tsE e) (Cons f Nil)
tsE (ENeg m e) = Cons m (tsE e)
tsE (App h args) = List.append (tsE h) (List.concatMap tsE args)
tsE (Op a op b) = List.append (tsE a) (Cons op (tsE b))
tsE (Ops a rest) = List.append (tsE a) (List.concatMap tsE rest)
tsE (OpRhs op e) = Cons op (tsE e)
tsE (Ann e cc ty) = List.append (tsE e) (Cons cc (tsE ty))
tsE (BVar t) = Cons t Nil
tsE (BImp o x c) = Cons o (Cons x (Cons c Nil))
tsE (BAnn o x cc ty c) =
  Cons o (Cons x (Cons cc (List.append (tsE ty) (Cons c Nil))))
tsE (Lam bs binders arrow body) =
  Cons bs (List.append (List.concatMap tsE binders) (Cons arrow (tsE body)))
tsE (Case kw scrut of2 alts) =
  Cons kw (List.append (tsE scrut) (Cons of2 (List.concatMap tsE alts)))
tsE (EAlt p arrow body) = List.append (tsP p) (Cons arrow (tsE body))
tsE (If kw c th a el b) =
  Cons
    kw
    (List.append (tsE c) (Cons th (List.append (tsE a) (Cons el (tsE b)))))
tsE (Do kw stmts) = Cons kw (List.concatMap tsE stmts)
tsE (ESBind x arrow e) = Cons x (Cons arrow (tsE e))
tsE (ELet kw p ann eq e body) =
  Cons
    kw
    (List.append
       (tsP p)
       (List.append
          (case ann of
           Just (MkPair cc ty) -> Cons cc (tsE ty)
           Nothing -> Nil)
          (Cons
             eq
             (List.append (tsE e) (case body of
              Just (MkPair i b) -> Cons i (tsE b)
              Nothing -> Nil)))))

tsTF : TF -> List T
tsTF (MkTF x cc ty Nothing) = Cons x (Cons cc (tsE ty))
tsTF (MkTF x cc ty (Just (MkPair eq d))) =
  Cons x (Cons cc (List.append (tsE ty) (Cons eq (tsE d))))

tsUniverse : Maybe (Pair T E) -> List T
tsUniverse Nothing = Nil
tsUniverse (Just (MkPair cc u)) = Cons cc (tsE u)

tsDAlts : Maybe DAlts -> List T
tsDAlts Nothing = Nil
tsDAlts (Just (MkDAlts eq alts bars)) =
  Cons eq (interleaveT (List.map tsE alts) bars)

tsD : D -> List T
tsD (DImport t) = Cons t Nil
tsD (DFixity kw ts) = Cons kw ts
tsD (DSig n cc ty) = List.append n (Cons cc (tsE ty))
tsD (DInstance kw n cc ty) = Cons kw (List.append n (Cons cc (tsE ty)))
tsD (DEqn n pats eq rhs w) =
  List.append
    n
    (List.append
       (List.concatMap tsP pats)
       (Cons
          eq
          (List.append (tsE rhs) (case w of
           Just (MkPair kw ds) -> Cons kw (List.concatMap tsD ds)
           Nothing -> Nil))))
tsD (DData kw name params universe alts) =
  Cons
    kw
    (Cons
       name
       (List.append
          (List.concatMap tsE params)
          (List.append (tsUniverse universe) (tsDAlts alts))))
tsD (DType kw name params eq body) =
  Cons
    kw
    (Cons name (List.append (List.concatMap tsE params) (Cons eq (tsE body))))
tsD (DTheory kw name params w fields) =
  Cons
    kw
    (Cons
       name
       (List.append
          (List.concatMap tsE params)
          (Cons w (List.concatMap tsTF fields))))
tsD (DPrimitive kw x cc ty) = Cons kw (Cons x (Cons cc (tsE ty)))
tsD (DTest kw x) = Cons kw (Cons x Nil)
tsD (DWatch w e) = Cons w (tsE e)

tokIx : T -> Int
tokIx t = t.ix

listEqInt : List Int -> List Int -> Bool
listEqInt Nil Nil = True
listEqInt (Cons x xs) (Cons y ys) = if x == y then listEqInt xs ys else False
listEqInt a b = False

notEof : T -> Bool
notEof t = not (strEq t.kind "eof")

-- | "ok" when reading the file keeps every token, in order; the parse
-- | error, or "differ", otherwise.
roundtripD : Array T -> List D -> String
roundtripD ts ds =
  if listEqInt
    (List.map tokIx (List.concatMap tsD ds))
    (List.map tokIx (List.filter notEof (Array.toList ts)))
    then "ok"
  else "differ"

roundtripAttached : Tokens.Attached -> String
roundtripAttached at = case parseToks at.toks of
  Left e -> e
  Right ds -> roundtripD at.toks ds

roundtripLexed : String -> Imports.Header -> Lex.Lexed -> String
roundtripLexed src hdr l =
  roundtripAttached
    (Tokens.attach src (Imports.withImports hdr.imports l.tokens) l.comments)

roundtripHeader : String -> Imports.Header -> String
roundtripHeader src hdr = roundtripLexed src hdr (Lex.lex hdr.text)

roundtrip : String -> String
roundtrip src = roundtripHeader src (Imports.readImports src)

-- (how many declarations, and each one's kind, for the doctests)
dKind : D -> String
dKind (DImport t) = "import"
dKind (DFixity kw ts) = "fixity"
dKind (DSig n cc ty) = "sig"
dKind (DInstance kw n cc ty) = "instance"
dKind (DEqn n pats eq rhs w) = "eqn"
dKind (DData kw name params universe alts) = "data"
dKind (DType kw name params eq body) = "type"
dKind (DTheory kw name params w fields) = "theory"
dKind (DPrimitive kw x cc ty) = "primitive"
dKind (DTest kw x) = "test"
dKind (DWatch w e) = w.kind

dKinds : String -> String
dKinds src = case parseFile src of
  Left e -> e
  Right ds -> joinWith " " (List.map dKind ds)

test reading

