-- The formatter, checked: the layout lays a file out anew, and here
-- the result is held to mean what the text did -- the same imports, the
-- same presyntax read back, the same comments in the same order.

module heff.syntax.format

import heff.syntax.diagnostic
import heff.elab.fixed as Fixed
import heff.syntax.fixity as Fixity
import heff.syntax.import as Import
import heff.elab.params as Params
import heff.syntax.presyntax as Presyntax
import heff.syntax.surface as Surface
import heff.syntax.fmt.layout as Layout
import heff.syntax.fmt.lex as Lex

-- | presyntax as a string, its spans forgotten: two readings mean the
-- | same where their keys are equal
wordKey : Presyntax.SyntaxWord -> String
wordKey TypeWord = "Type"
wordKey IntWord = "Int"
wordKey FloatWord = "Float64"
wordKey StringWord = "String"
wordKey RuneWord = "Rune"
wordKey ArrayWord = "Array"
wordKey AbandonWord = "abandon"
wordKey (FixedWord w) = Fixed.fixedName w

-- (each piece in brackets, so that no two readings are one key)
keyOf : String -> List String -> String
keyOf c parts = "(" ^ c ^ joinWith "" (List.map (\x -> " " ^ x) parts) ^ ")"

listKey : {a : Type} -> (a -> String) -> List a -> String
listKey f xs = "[" ^ joinWith ", " (List.map f xs) ^ "]"

segmentTypeKey : Presyntax.SegmentType -> String
segmentTypeKey SegmentInteger = "integer"
segmentTypeKey SegmentBinary = "binary"
segmentTypeKey SegmentBits = "bits"
segmentTypeKey SegmentFloat = "float"
segmentTypeKey (SegmentUtf n) = "utf" ^ debug n

segmentSizeKey : Presyntax.SegmentSize -> String
segmentSizeKey SizeDefault = "default"
segmentSizeKey (SizeNumber n) = debug n
segmentSizeKey (SizeName x _ unit) = x ^ "*" ^ debug unit

boolKey : Bool -> String
boolKey True = "true"
boolKey False = "false"

-- | a segment of a binary, its value keyed by `f`
segmentKey : {e : Type}
           -> (e -> String)
           -> Params.Spanned (Presyntax.Segment e)
           -> String
segmentKey f (At (MkSegment v ty size little signed) _) =
  keyOf
    "segment"
    [ f v
    , segmentTypeKey ty
    , segmentSizeKey size
    , boolKey little
    , boolKey signed
    ]

patKey : Presyntax.Pat -> String
patKey (At (PatVar x) _) = keyOf "var" [x]
patKey (At (PatTag t _ ps) _) = keyOf "tag" [t, listKey patKey ps]
patKey (At (PatOp x _ ps) _) = keyOf "op" [x, listKey patKey ps]
patKey (At (PatInt i) _) = keyOf "int" [debug i]
patKey (At (PatFloat x) _) = keyOf "float" [debug (Presyntax.decimalFloat64 x)]
patKey (At (PatString x) _) = keyOf "string" [x]
patKey (At (PatBinary segs) _) =
  keyOf "binary" [listKey (\m -> segmentKey patKey m) segs]
patKey (At (PatRune c) _) = keyOf "rune" [debug c]
patKey (At (PatRecord fs) _) =
  keyOf
    "record"
    [ listKey
      (\f -> case f of
       MkFieldPat x q -> keyOf "field" [x, patKey q])
      fs
    ]
patKey (At (PatWord w) _) = keyOf "word" [wordKey w]
patKey (At (PatAs x _ q) _) = keyOf "as" [x, patKey q]

type Keys = { e : Presyntax.Expr -> String, decl : Presyntax.Decl -> String }

paramKey : Keys -> Params.Spanned (Presyntax.Param Presyntax.Expr) -> String
paramKey r (At (ExplicitParam x _ t) _) = keyOf "explicit" [x, r.e t]
paramKey r (At (ImplicitParam x _ t) _) = keyOf "implicit" [x, r.e t]

piKey : Keys -> Presyntax.PiBinder Presyntax.Expr Presyntax.Expr -> String
piKey r (PiNamed x _ t) = keyOf "named" [x, r.e t]
piKey r (PiImplicit x _ _ t Nothing) = keyOf "implicit" [x, r.e t]
piKey r (PiImplicit x _ _ t (Just d)) = keyOf "implicit" [x, r.e t, r.e d]
piKey r (PiInstance x _ _ t) = keyOf "instance" [x, r.e t]
piKey r (PiAnon t) = keyOf "anon" [r.e t]

lamKey : Keys -> Presyntax.LamBinder Presyntax.Expr -> String
lamKey r (LamName x _) = keyOf "name" [x]
lamKey r (LamImplicit x _) = keyOf "implicit" [x]
lamKey r (LamAnn x _ t) = keyOf "ann" [x, r.e t]

fieldDeclKey : Keys
             -> Params.Spanned
               (Presyntax.FieldDecl Presyntax.Expr Presyntax.Expr)
             -> String
fieldDeclKey r (At (DeclareField x _ t Nothing) _) = keyOf "field" [x, r.e t]
fieldDeclKey r (At (DeclareField x _ t (Just d)) _) =
  keyOf "field" [x, r.e t, r.e d]
fieldDeclKey r (At (BadFieldDecl e) _) = keyOf "bad" [r.e e]

variantKey : Keys -> Params.Spanned (Presyntax.Variant Presyntax.Expr) -> String
variantKey r (At (TagVariant t _ args) _) =
  keyOf "variant" [t, listKey r.e args]
variantKey r (At (BadVariant e) _) = keyOf "bad" [r.e e]

fieldSetKey : Keys
            -> Params.Spanned (Presyntax.FieldSet Presyntax.Expr)
            -> String
fieldSetKey r (At (SetField x _ e) _) = keyOf "set" [x, r.e e]
fieldSetKey r (At (BadFieldSet e) _) = keyOf "bad" [r.e e]

updateSetKey : Keys
             -> Params.Spanned (Presyntax.UpdateSet Presyntax.Expr)
             -> String
updateSetKey r (At (SetPath path e) _) =
  keyOf "path" [listKey (\(f : Pair String Params.Span) -> fst f) path, r.e e]

altKey : Keys -> Params.Spanned (Presyntax.Alt Presyntax.Expr) -> String
altKey r (At (MkAlt p e) _) = keyOf "alt" [patKey p, r.e e]

stmtKey : Keys -> Params.Spanned (Presyntax.Stmt Presyntax.Expr) -> String
stmtKey r (At (StmtBind x _ e) _) = keyOf "bind" [x, r.e e]
stmtKey r (At (StmtLet p e) _) = keyOf "let" [patKey p, r.e e]
stmtKey r (At (StmtExpr e) _) = keyOf "expr" [r.e e]
stmtKey r (At (StmtLetMut x _ e) _) = keyOf "mut" [x, r.e e]
stmtKey r (At (StmtLetElse p e ss) _) =
  keyOf "letelse" [patKey p, r.e e, listKey (stmtKey r) ss]

equationKey : Keys
            -> Params.Spanned (Presyntax.Equation Presyntax.Expr)
            -> String
equationKey r (At (MkEquation g _ ps rhs) _) =
  keyOf "equation" [g, listKey patKey ps, r.e rhs]

-- (what is there, none or one)
maybeKeys : {a : Type} -> Maybe a -> List a
maybeKeys Nothing = Nil
maybeKeys (Just x) = [x]

catchKey : Keys -> Presyntax.CatchArm Presyntax.Expr -> String
catchKey r (MkCatchArm b ss) =
  keyOf "catch" [lamKey r b, listKey (stmtKey r) ss]

keyTermF : Keys -> Presyntax.Expr -> String
keyTermF r (At (EVar x) _) = keyOf "var" [x]
keyTermF r (At (EImplicitVar x) _) = keyOf "implicit" [x]
keyTermF r (At (ENotationVar x _ _) _) = keyOf "notation" [x]
keyTermF r (At (ETag x) _) = keyOf "tag" [x]
keyTermF r (At (EInt i) _) = keyOf "int" [debug i]
keyTermF r (At (EFloat x) _) =
  keyOf "float" [debug (Presyntax.decimalFloat64 x)]
keyTermF r (At (EString x) _) = keyOf "string" [x]
keyTermF r (At (EBinary segs) _) =
  keyOf "binary" [listKey (\m -> segmentKey r.e m) segs]
keyTermF r (At (ERune c) _) = keyOf "rune" [debug c]
keyTermF r (At (EWord w) _) = keyOf "word" [wordKey w]
keyTermF r (At (EApp h args) _) = keyOf "app" [r.e h, listKey r.e args]
keyTermF r (At (EProject x) _) = keyOf "project" [x]
keyTermF r (At (ENamed x e) _) = keyOf "named" [x, r.e e]
keyTermF r (At (EPi b cod) _) = keyOf "pi" [piKey r b, r.e cod]
keyTermF r (At (ELam b body) _) = keyOf "lam" [lamKey r b, r.e body]
keyTermF r (At (EAnn e t) _) = keyOf "ann" [r.e e, r.e t]
keyTermF r (At (ESpec acc x _ v) _) = keyOf "spec" [r.e acc, x, r.e v]
keyTermF r (At (ESig fs) _) = keyOf "sig" [listKey (fieldDeclKey r) fs]
keyTermF r (At (ESum vs) _) = keyOf "sum" [listKey (variantKey r) vs]
keyTermF r (At (EStruct fs) _) = keyOf "struct" [listKey (fieldSetKey r) fs]
keyTermF r (At (EUpdate a fs) _) =
  keyOf "update" [r.e a, listKey (updateSetKey r) fs]
keyTermF r (At (EMatch s alts) _) =
  keyOf "match" [r.e s, listKey (altKey r) alts]
keyTermF r (At (ELetIn rhs (At (MkAlt p e) _)) _) =
  keyOf "let" [r.e rhs, patKey p, r.e e]
keyTermF r (At (EDo stmts) _) = keyOf "do" [listKey (stmtKey r) stmts]
keyTermF r (At (ELocal body ds) _) = keyOf "local" [r.e body, listKey r.decl ds]
keyTermF r (At (EInvalid why) _) = keyOf "invalid" [why]
keyTermF r (At (EAssign x _ e) _) = keyOf "assign" [x, r.e e]
keyTermF r (At (EWhile c body) _) =
  keyOf "while" [r.e c, listKey (stmtKey r) body]
keyTermF r (At (EFor p c body) _) =
  keyOf "for" [patKey p, r.e c, listKey (stmtKey r) body]
keyTermF r (At (EIfThen c a) _) = keyOf "ifthen" [r.e c, r.e a]
keyTermF r (At EBreak _) = keyOf "break" Nil
keyTermF r (At EContinue _) = keyOf "continue" Nil
keyTermF r (At (EReturn e) _) = keyOf "return" [r.e e]
keyTermF r (At (ENest e) _) = keyOf "nest" [r.e e]
keyTermF r (At (ELazy e) _) = keyOf "lazy" [r.e e]
keyTermF r (At (ETuple es) _) = keyOf "tuple" [listKey r.e es]
keyTermF r (At (ETry (MkTry ty body c)) _) =
  keyOf
    "try"
    [listKey r.e (maybeKeys ty), listKey (stmtKey r) body, catchKey r c]
keyTermF r (At (EWith w x _ body) _) =
  keyOf "with" [r.e w, x, listKey (stmtKey r) body]
keyTermF r (At (EWithBound bs w body) _) =
  keyOf
    "withbound"
    [ listKey
      (\b -> case b of
       At (MkBinding x _ m) _ -> keyOf "binding" [x, r.e m])
      bs
    , listKey r.e (maybeKeys w)
    , listKey (stmtKey r) body
    ]

-- (an instance's `instance` is of what it means: the formatter keeps it)
declaredKey : Presyntax.Declared -> String
declaredKey AsDefinition = "definition"
declaredKey AsInstance = "instance"

keyDeclF : Keys -> Presyntax.Decl -> String
keyDeclF r (At (DeclEquations f _ declared ty eqs) _) =
  keyOf
    "equations"
    [f, declaredKey declared, r.e ty, listKey (equationKey r) eqs]
keyDeclF r (At (DeclDefine x _ ps u body) _) =
  keyOf "define" [x, listKey (paramKey r) ps, r.e u, r.e body]
keyDeclF r (At (DeclTheory x _ ps body) _) =
  keyOf "theory" [x, listKey (paramKey r) ps, r.e body]
keyDeclF r (At (DeclPrimitive x _ t) _) = keyOf "primitive" [x, r.e t]
keyDeclF r (At (DeclTest x _) _) = keyOf "test" [x]
keyDeclF r (At (DeclWatch e) _) = keyOf "watch" [r.e e]

keys : Keys
keys = { e = \n -> keyTermF keys n, decl = \d -> keyDeclF keys d }

type Meaning =
  { imports : List String, decls : List String, diags : List String }

readNoFixities : String -> Surface.Read
readNoFixities text =
  Surface.readProgramWith
    { known = Surface.noKnown, fixities = Fixity.emptyFixities, lenient = True }
    text

-- (what the module claim says, each entry as it is meant: its name,
-- whether it lists what it exposes, and each entry)
exposedMeant : Maybe Import.Claim -> List String
exposedMeant (Just h) =
  Cons
    ("module " ^ fromMaybe "" h.name ^ (if h.listed then " (" else ""))
    (List.map
       (\(x : Import.Exposed) -> x.name ^ (if x.tags then "(..)" else ""))
       h.exposes)
exposedMeant Nothing = Nil

meaningOf : Import.Imports -> Surface.Read -> Meaning
meaningOf h r =
  { imports =
      List.append
        (exposedMeant h.claim)
        (List.map (\(i : Import.Import) -> i.name) h.imports)
  , decls = List.map keys.decl r.decls
  , diags = List.map (\(d : Diag) -> d.msg) r.diags
  }

-- | what a text means, read without what it imports (whose fixities are
-- | not known: operators bind the same way in both, whatever way)
meaningFrom : Import.Imports -> Meaning
meaningFrom h = meaningOf h (readNoFixities h.text)

meaning : String -> Meaning
meaning s = meaningFrom (Import.readImports s)

comments : String -> List String
comments s =
  List.map
    (\(c : Lex.Cmt) -> Layout.rtrim c.text)
    (Lex.lex (Import.readImports s).text).comments

strsEq : List String -> List String -> Bool
strsEq Nil Nil = True
strsEq (Cons a argv) (Cons b bs) = strEq a b && strsEq argv bs
strsEq _ _ = False

sameMeaning : String -> String -> Meaning -> Meaning -> Either String String
sameMeaning src out a b =
  if not (strsEq a.imports b.imports)
  then Left "formatting would change the module claim or the imports"
  else if not (strsEq a.decls b.decls && strsEq a.diags b.diags)
  then Left
      "formatting would change what the file means (a bug of the formatter)"
  else if not (strsEq (comments src) (comments out))
  then Left
      "formatting would lose or move a comment across code (a bug of the formatter)"
  else Right out

-- | the formatted text means what the text did
check : String -> String -> Either String String
check src out = sameMeaning src out (meaning src) (meaning out)

-- | a file laid out anew, a chain of operators cut as the fixities in
-- | scope say (`Dr.fixitiesIn`), and checked to mean what it did
formatIn : Fixity.Fixities -> String -> Either String String
formatIn f src = case Layout.formatUncheckedIn f src of
  Left why -> Left why
  Right out -> check src out

-- | (knowing only the file's own fixities, not what it imports)
-- | >>> format "f=1"
-- | Right "f = 1\n"
format : String -> Either String String
format src =
  formatIn
    (Surface.fixitiesOfText Fixity.emptyFixities (Import.readImports src).text)
    src
