-- The formatter, checked: src/heff/syntax/fmt/layout.hf lays a file out anew, and here
-- the result is held to mean what the text did -- the same imports, the
-- same presyntax read back, the same comments in the same order.

import heff.syntax.diagnostic
import heff.elab.fixed as Fx
import heff.syntax.fixity as F
import heff.syntax.import as Im
import heff.elab.params as Pm
import heff.syntax.presyntax as Notation
import heff.syntax.surface as Su
import heff.syntax.fmt.layout as Ly
import heff.syntax.fmt.lex as L

-- | presyntax as a string, its spans forgotten: two readings mean the
-- | same where their keys are equal
wordKey : Notation.SyntaxWord -> String
wordKey TypeWord = "Type"
wordKey IntWord = "Int"
wordKey FloatWord = "Float"
wordKey StringWord = "String"
wordKey RuneWord = "Rune"
wordKey ArrayWord = "Array"
wordKey AbandonWord = "abandon"
wordKey (FixedWord w) = Fx.fixedName w

-- (each piece in brackets, so that no two readings are one key)
keyOf : String -> List String -> String
keyOf c parts = "(" ^ c ^ joinWith "" (List.map (\x -> " " ^ x) parts) ^ ")"

listKey : {a : Type} -> (a -> String) -> List a -> String
listKey f xs = "[" ^ joinWith ", " (List.map f xs) ^ "]"

patKey : Notation.Pat -> String
patKey p = case Pm.nodeOf p of
  PatVar x -> keyOf "var" [x]
  PatTag t _ ps -> keyOf "tag" [t, listKey patKey ps]
  PatOp x _ ps -> keyOf "op" [x, listKey patKey ps]
  PatInt i -> keyOf "int" [showInt i]
  PatFloat x -> keyOf "float" [showFloat x]
  PatString x -> keyOf "string" [x]
  PatRune c -> keyOf "rune" [showInt c]
  PatRecord fs ->
    keyOf
      "record"
      [ listKey
        (\f -> case f of
         MkFieldPat x q -> keyOf "field" [x, patKey q])
        fs
      ]
  PatWord w -> keyOf "word" [wordKey w]
  PatAs x _ q -> keyOf "as" [x, patKey q]

type Keys = { e : Notation.Expr -> String, decl : Notation.Decl -> String }

paramKey : Keys -> Pm.Spanned (Notation.Param Notation.Expr) -> String
paramKey r (At (ExplicitParam x _ t) _) = keyOf "explicit" [x, r.e t]
paramKey r (At (ImplicitParam x _ t) _) = keyOf "implicit" [x, r.e t]

keyTermF : Keys -> Notation.Expr -> String
keyTermF r n = case Pm.nodeOf n of
  EVar x -> keyOf "var" [x]
  EImplicitVar x -> keyOf "implicit" [x]
  ETag x -> keyOf "tag" [x]
  EInt i -> keyOf "int" [showInt i]
  EFloat x -> keyOf "float" [showFloat x]
  EString x -> keyOf "string" [x]
  ERune c -> keyOf "rune" [showInt c]
  EWord w -> keyOf "word" [wordKey w]
  EApp h args -> keyOf "app" [r.e h, listKey r.e args]
  EProject x -> keyOf "project" [x]
  ENamed x e -> keyOf "named" [x, r.e e]
  EPi b cod ->
    keyOf
      "pi"
      [ (case b of
         PiNamed x _ t -> keyOf "named" [x, r.e t]
         PiImplicit x _ _ t Nothing -> keyOf "implicit" [x, r.e t]
         PiImplicit x _ _ t (Just d) -> keyOf "implicit" [x, r.e t, r.e d]
         PiInstance x _ _ t -> keyOf "instance" [x, r.e t]
         PiAnon t -> keyOf "anon" [r.e t])
      , r.e cod
      ]
  ELam b body ->
    keyOf
      "lam"
      [ (case b of
         LamName x _ -> keyOf "name" [x]
         LamImplicit x _ -> keyOf "implicit" [x]
         LamAnn x _ t -> keyOf "ann" [x, r.e t])
      , r.e body
      ]
  EAnn e t -> keyOf "ann" [r.e e, r.e t]
  ESpec acc x _ v -> keyOf "spec" [r.e acc, x, r.e v]
  ESig fs ->
    keyOf
      "sig"
      [ listKey
        (\f -> case f of
         At (DeclareField x _ t Nothing) _ -> keyOf "field" [x, r.e t]
         At (DeclareField x _ t (Just d)) _ -> keyOf "field" [x, r.e t, r.e d]
         At (BadFieldDecl e) _ -> keyOf "bad" [r.e e])
        fs
      ]
  ESum vs ->
    keyOf
      "sum"
      [ listKey
        (\v -> case v of
         At (TagVariant t _ args) _ -> keyOf "variant" [t, listKey r.e args]
         At (BadVariant e) _ -> keyOf "bad" [r.e e])
        vs
      ]
  EStruct fs ->
    keyOf
      "struct"
      [ listKey
        (\f -> case f of
         At (SetField x _ e) _ -> keyOf "set" [x, r.e e]
         At (BadFieldSet e) _ -> keyOf "bad" [r.e e])
        fs
      ]
  EMatch s alts ->
    keyOf
      "match"
      [ r.e s
      , listKey
        (\a -> case a of
         At (MkAlt p e) _ -> keyOf "alt" [patKey p, r.e e])
        alts
      ]
  ELetIn rhs (At (MkAlt p e) _) -> keyOf "let" [r.e rhs, patKey p, r.e e]
  EDo stmts ->
    keyOf
      "do"
      [ listKey
        (\m -> case m of
         At (StmtBind x _ e) _ -> keyOf "bind" [x, r.e e]
         At (StmtLet p e) _ -> keyOf "let" [patKey p, r.e e]
         At (StmtExpr e) _ -> keyOf "expr" [r.e e])
        stmts
      ]
  ELocal body ds -> keyOf "local" [r.e body, listKey r.decl ds]
  EInvalid why -> keyOf "invalid" [why]

keyDeclF : Keys -> Notation.Decl -> String
keyDeclF r d = case Pm.nodeOf d of
  DeclEquations f _ ty eqs ->
    keyOf
      "equations"
      [ f
      , r.e ty
      , listKey
        (\eq -> case eq of
         At (MkEquation g _ ps rhs) _ ->
           keyOf "equation" [g, listKey patKey ps, r.e rhs])
        eqs
      ]
  DeclDefine x _ ps u body ->
    keyOf "define" [x, listKey (paramKey r) ps, r.e u, r.e body]
  DeclTheory x _ ps body ->
    keyOf "theory" [x, listKey (paramKey r) ps, r.e body]
  DeclPrimitive x _ t -> keyOf "primitive" [x, r.e t]
  DeclTest x _ -> keyOf "test" [x]
  DeclWatch e -> keyOf "watch" [r.e e]

keys : Keys
keys = { e = \n -> keyTermF keys n, decl = \d -> keyDeclF keys d }

type Meaning =
  { imports : List String, decls : List String, diags : List String }

readNoFixities : String -> Su.Read
readNoFixities text =
  Su.readProgramWith
    { known = Su.noKnown, fixities = F.emptyFixities, lenient = True }
    text

meaningOf : Im.Imports -> Su.Read -> Meaning
meaningOf h r =
  { imports = List.map (\(i : Im.Import) -> i.name) h.imports
  , decls = List.map keys.decl r.decls
  , diags = List.map (\(d : Diag) -> d.msg) r.diags
  }

-- | what a text means, read without what it imports (whose fixities are
-- | not known: operators bind the same way in both, whatever way)
meaningFrom : Im.Imports -> Meaning
meaningFrom h = meaningOf h (readNoFixities h.text)

meaning : String -> Meaning
meaning s = meaningFrom (Im.readImports s)

comments : String -> List String
comments s =
  List.map
    (\(c : L.Cmt) -> Ly.rtrim c.text)
    (L.lex (Im.readImports s).text).comments

strsEq : List String -> List String -> Bool
strsEq Nil Nil = True
strsEq (Cons a as) (Cons b bs) = strEq a b && strsEq as bs
strsEq _ _ = False

sameMeaning : String -> String -> Meaning -> Meaning -> Either String String
sameMeaning src out a b =
  if not (strsEq a.imports b.imports)
    then Left "formatting would change the imports"
  else if not (strsEq a.decls b.decls && strsEq a.diags b.diags)
    then Left
        "formatting would change what the file means (a bug of the formatter)"
  else if not (strsEq (comments src) (comments out))
    then Left
        "formatting would lose or move a comment across code (a bug of the formatter)"
  else Right out

-- | the formatted text means what the text did
check : String -> String -> Either String String
check src out = sameMeaning src out (meaning src) (meaning out)

-- | a file laid out anew, a chain of operators cut as the fixities in
-- | scope say (`Dr.fixitiesIn`), and checked to mean what it did
formatIn : F.Fixities -> String -> Either String String
formatIn f src = case Ly.formatUncheckedIn f src of
  Left why -> Left why
  Right out -> check src out

-- | (knowing only the file's own fixities, not what it imports)
format : String -> Either String String
format src =
  formatIn (Su.fixitiesOfText F.emptyFixities (Im.readImports src).text) src

-- >>> format "f=1"
-- Right "f = 1\n"
