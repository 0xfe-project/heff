-- The lexer of the `.hf` syntax.  Every token knows its column and
-- whether it is the first on its line: all the layout rule needs.
-- Comments are not tokens; they are returned apart, for the formatter.
-- The kinds are var, con, field, int, float, str, rune, sym, punct, kw,
-- watch, doctest, and one eof at the end.
--
-- The loop is one self-recursion: `step` reads one thing and says where to
-- go on (a `Step`), and `lexGo` applies each step to what has been read.

import heff.util.rune as R

type Tok =
  { kind : String
  , text : String
  , start : Int
  , end : Int
  , line : Int
  , col : Int
  , first : Bool
  }

type Err = { start : Int, end : Int, msg : String }

type Cmt = { start : Int, end : Int, text : String }

type Lexed = { tokens : List Tok, errors : List Err, comments : List Cmt }

-- | One thing read: where the loop is after it, the line bookkeeping, and
-- | the token, error or comment it found, if any.  A column is of runes:
-- | `lineStart` is where the line starts, on by as many units as its
-- | runes before `i` take beyond one each (in a string, a rune literal,
-- | a comment or a character no token starts with, where a rune may be
-- | more than one unit), so that it is `i - lineStart`.
type Step =
  { i : Int
  , line : Int
  , lineStart : Int
  , first : Bool
  , tok : Maybe Tok
  , err : Maybe Err
  , cmt : Maybe Cmt
  }

-- (the small results of the scanners)
type NumEnd = { end : Int, isFloat : Bool }

type StrEnd = { i : Int, text : String, closed : Bool, bad : Maybe Err }

-- (a code point read, and where what it was read from ends; `ok`, whether
-- there was one)
type CodeEnd = { ok : Bool, end : Int, code : Int }

type BlockEnd =
  { i : Int, line : Int, lineStart : Int, first : Bool, closed : Bool }

keywords : List String
keywords =
  [ "data"
  , "type"
  , "theory"
  , "primitive"
  , "instance"
  , "import"
  , "case"
  , "of"
  , "if"
  , "then"
  , "else"
  , "do"
  , "where"
  , "let"
  , "in"
  , "test"
  , "Type"
  , "Int"
  , "Float64"
  , "String"
  , "Rune"
  , "Array"
  , "Int8"
  , "Int16"
  , "Int32"
  , "Int64"
  , "UInt8"
  , "UInt16"
  , "UInt32"
  , "UInt64"
  , "Float32"
  , "abandon"
  , "infixl"
  , "infixr"
  , "infix"
  ]

symChars : String
symChars = "!#$%&*+./<=>?@\\^|-~:"

isLowerC : Int -> Bool
isLowerC c = c >= 97 && c <= 122 || c == 95

isUpperC : Int -> Bool
isUpperC c = c >= 65 && c <= 90

isLetterC : Int -> Bool
isLetterC c = isLowerC c || isUpperC c

isDigitC : Int -> Bool
isDigitC c = c >= 48 && c <= 57

isNameC : Int -> Bool
isNameC c = isLetterC c || isDigitC c || c == 39

isSymC : Int -> Bool
isSymC c = c >= 0 && contains (fromByte c) symChars

isPunctC : Int -> Bool
isPunctC c = c >= 0 && contains (fromByte c) "()[]{},"

-- (a name goes on over letters, digits and primes, and over a `/` right
-- before a letter: `Bwd/elemAt`)
nameEnd : String -> Int -> Int
nameEnd s j =
  if isNameC (byteAt s j) then nameEnd s (j + 1)
  else if byteAt s j == 47 && isLetterC (byteAt s (j + 1))
    then nameEnd s (j + 2)
  else j

-- (a field's name: letters, digits and primes only)
plainEnd : String -> Int -> Int
plainEnd s j = if isNameC (byteAt s j) then plainEnd s (j + 1) else j

-- (digits of which `ok` says, a `_` between two of them a separator:
-- `1_000_000`)
digitsBy : (Int -> Bool) -> String -> Int -> Int
digitsBy ok s j =
  if ok (byteAt s j) then digitsBy ok s (j + 1)
  else if byteAt s j == 95 && ok (byteAt s (j + 1)) then digitsBy ok s (j + 2)
  else j

digitsEnd : String -> Int -> Int
digitsEnd s j = digitsBy isDigitC s j

isHexC : Int -> Bool
isHexC c = isDigitC c || c >= 97 && c <= 102 || c >= 65 && c <= 70

isBinC : Int -> Bool
isBinC c = c == 48 || c == 49

dashesEnd : String -> Int -> Int
dashesEnd s j = if byteAt s j == 45 then dashesEnd s (j + 1) else j

eolEnd : String -> Int -> Int
eolEnd s j =
  if j < strLength s && not (byteAt s j == 10) then eolEnd s (j + 1) else j

-- (a run of symbol characters, stopped before `--`: `-->` is one operator,
-- `a --b` is an operand and a comment)
symEnd : String -> Int -> Int
symEnd s j =
  if isSymC (byteAt s j) && not (byteAt s j == 45 && byteAt s (j + 1) == 45)
    then symEnd s (j + 1)
  else j

-- (the exponent, if one is at `b`, after a dot: `6.02e23`, `1.5e-3`)
numExp : String -> Int -> NumEnd
numExp s b =
  if (byteAt s b == 101 || byteAt s b == 69)
  && (isDigitC (byteAt s (b + 1))
      || (byteAt s (b + 1) == 43 || byteAt s (b + 1) == 45)
      && isDigitC (byteAt s (b + 2)))
    then { end = digitsEnd s (b + 2), isFloat = True }
  else { end = b, isFloat = True }

numFrac : String -> Int -> NumEnd
numFrac s a =
  if byteAt s a == 46 && isDigitC (byteAt s (a + 1))
    then numExp s (digitsEnd s (a + 2))
  else { end = a, isFloat = False }

-- (an integer in another base, at `j` its first digit after `0x`, `0b`)
numBase : (Int -> Bool) -> String -> Int -> NumEnd
numBase ok s j = { end = digitsBy ok s j, isFloat = False }

-- (from the number's first digit, at `j`: hexadecimal after `0x`, binary
-- after `0b`, else decimal, a float if a dot and a digit follow)
numFrom : String -> Int -> NumEnd
numFrom s j =
  if byteAt s j == 48
  && (byteAt s (j + 1) == 120 || byteAt s (j + 1) == 88)
  && isHexC (byteAt s (j + 2))
    then numBase isHexC s (j + 2)
  else if byteAt s j == 48
  && (byteAt s (j + 1) == 98 || byteAt s (j + 1) == 66)
  && isBinC (byteAt s (j + 2))
    then numBase isBinC s (j + 2)
  else numFrac s (digitsEnd s (j + 1))

-- (from the first character of the number, a digit or a `-`)
numScan : String -> Int -> NumEnd
numScan s i = if byteAt s i == 45 then numFrom s (i + 1) else numFrom s i

-- Escapes, a string's and a rune literal's alike: `\n` `\t` `\r`,
-- `\u{1F600}` a code point in hexadecimal (its UTF-8 bytes, in a
-- string), and `\` before any other character that character (`\"`,
-- `\'`, `\\`, and `\u` not before `{`, digits and `}`); a string's
-- alone, `\xff`, a byte of two hexadecimal digits, any byte, of a rune
-- or not.  What a `\u{...}` stands for, as what a rune literal is, must
-- be a Unicode scalar value: from U+0000 to U+10FFFF, but the
-- surrogates.

noCode : CodeEnd
noCode = { ok = False, end = 0, code = 0 }

-- (the code point an escape `\c` stands for)
escCode : Int -> Int
escCode 110 = 10
escCode 116 = 9
escCode 114 = 13
escCode c = c

hexDigitValue : Int -> Int
hexDigitValue c =
  if isDigitC c then c - 48 else if c >= 97 then c - 87 else c - 55

-- (the value of the hexadecimal digits from `j` to `e`)
hexValue : String -> Int -> Int -> Int -> Int
hexValue s j e acc =
  if j >= e then acc
  else hexValue s (j + 1) e (acc * 16 + hexDigitValue (byteAt s j))

hexRunEnd : String -> Int -> Int
hexRunEnd s j = if isHexC (byteAt s j) then hexRunEnd s (j + 1) else j

-- (`\u{...}`, from its `u`, at `j`: the digits from `j + 2` to `e`, a `}`
-- at `e`; with none, or no `}`, `\u` is a `u`)
uniEsc : String -> Int -> Int -> CodeEnd
uniEsc s j e =
  if e > j + 2 && byteAt s e == 125
    then { ok = True, end = e + 1, code = hexValue s (j + 2) e 0 }
  else { ok = True, end = j + 1, code = 117 }

-- | an escape, from the character after its `\`, at `j`: the code point
-- | it stands for, and where it ends; none at the end of the line or the
-- | file
escAt : String -> Int -> CodeEnd
escAt s j =
  if byteAt s j == 117 && byteAt s (j + 1) == 123
    then uniEsc s j (hexRunEnd s (j + 2))
  else if j >= strLength s || byteAt s j == 10 then noCode
  else { ok = True, end = j + R.widthAt s j, code = escCode (R.codeAt s j) }

-- (what is wrong with the code point `what` stands for, where it is no
-- scalar value)
scalarErr : String -> Int -> String
scalarErr what c =
  what
  ^ " is a Unicode scalar value: "
  ^ R.codeName c
  ^ (if c > 1114111 then " is beyond U+10FFFF" else " is a surrogate")

-- (in a string, the escape at `k`; where there is none -- a `\` last on
-- its line -- the character after the `\` as it is)
orUnit : String -> Int -> CodeEnd -> CodeEnd
orUnit s k e = if e.ok then e else { ok = True, end = k + 1, code = byteAt s k }

-- (the first escape of a string that is no scalar value: `bad` if there
-- was one before, else this one, from its `\` at `j`, if it is)
badEsc : Maybe Err -> Int -> CodeEnd -> Maybe Err
badEsc (Just b) j e = Just b
badEsc Nothing j e =
  if R.isScalar e.code then Nothing
  else Just { start = j, end = e.end, msg = scalarErr "a `\\u{...}`" e.code }

-- (a string's `\xNN`, from its `x`, at `j`: two hexadecimal digits, a
-- byte; with fewer, `\x` is an `x`)
isByteEsc : String -> Int -> Bool
isByteEsc s j =
  byteAt s j == 120 && isHexC (byteAt s (j + 1)) && isHexC (byteAt s (j + 2))

-- (the text of a string literal, escapes done; `i` is at the closing quote,
-- or where the line or the file ended; `bad`, its first escape that is no
-- scalar value)
strScan : String -> Int -> String -> Maybe Err -> StrEnd
strScan s j acc bad =
  if j >= strLength s || byteAt s j == 10
    then { i = j, text = acc, closed = False, bad = bad }
  else if byteAt s j == 34 then { i = j, text = acc, closed = True, bad = bad }
  else if byteAt s j == 92 && isByteEsc s (j + 1)
    then strScan s (j + 4) (acc ^ fromByte (hexValue s (j + 2) (j + 4) 0)) bad
  else if byteAt s j == 92 && j + 1 < strLength s
    then (let e = orUnit s (j + 1) (escAt s (j + 1))
          in strScan s e.end (acc ^ R.encode e.code) (badEsc bad j e))
  else strScan s (j + 1) (acc ^ strSlice s j (j + 1)) bad

-- A rune literal: a `'` where a token starts (in a name it is a prime:
-- the name is read on over it), one character or an escape, and a `'`.
-- Where no `'` closes it, the first is an unexpected character, as it
-- was.

-- (closed by a `'` at `j`: the literal, of the code point `c`)
closedAt : String -> Int -> Int -> CodeEnd
closedAt s j c =
  if byteAt s j == 39 then { ok = True, end = j + 1, code = c } else noCode

-- (an escape, closed)
closedEsc : String -> CodeEnd -> CodeEnd
closedEsc s e = if e.ok then closedAt s e.end e.code else noCode

-- (from the opening `'`, at `i`)
runeScan : String -> Int -> CodeEnd
runeScan s i =
  if byteAt s (i + 1) == 92 then closedEsc s (escAt s (i + 2))
  else if i + 1 >= strLength s
  || byteAt s (i + 1) == 39
  || byteAt s (i + 1) == 10
    then noCode
  else closedAt s (i + 1 + R.widthAt s (i + 1)) (R.codeAt s (i + 1))

-- (a `{- -}` comment, nested; from its `{-`, with the line bookkeeping)
blockScan : String -> Int -> Int -> Int -> Int -> Bool -> BlockEnd
blockScan s j depth line lineStart first =
  if j >= strLength s
    then { i = j
         , line = line
         , lineStart = lineStart
         , first = first
         , closed = False
         }
  else if byteAt s j == 123 && byteAt s (j + 1) == 45
    then blockScan s (j + 2) (depth + 1) line lineStart first
  else if byteAt s j == 45 && byteAt s (j + 1) == 125
    then (if depth == 1
            then { i = j + 2
                 , line = line
                 , lineStart = lineStart
                 , first = first
                 , closed = True
                 }
          else blockScan s (j + 2) (depth - 1) line lineStart first)
  else if byteAt s j == 10
    then blockScan s (j + 1) depth (line + 1) (j + 1) True
  else blockScan s (j + 1) depth line lineStart first

-- (`-` right before a digit is a negative number's sign, unless it is
-- right after an operand -- a name, a literal, a field, a closing
-- bracket, no space between: `a - 1` and `a-1` subtract, `f -1` and
-- `a -1` are applied to -1)
operandBefore : List Tok -> Int -> Bool
operandBefore Nil start = False
operandBefore (Cons t _) start =
  t.end == start
  && (List.elemBy
        strEq
        t.kind
        ["var", "con", "int", "float", "str", "rune", "field"]
      || strEq t.kind "punct" && List.elemBy strEq t.text [")", "]", "}"])

-- (`-` where it would be a number's sign, right before a name or a `(`
-- instead of a digit, negates what it is before: `f -x` is `f (-x)`, as
-- `f -1` is `f (-1)`, while `a - x` and `a-x` subtract)
startsNegated : Int -> Bool
startsNegated c = isLetterC c || c == 40

-- (`.x` right after an operand is a field, and right after a capitalised
-- keyword too, no space between: `Rune.toInt`, where `Rune` is a module's
-- alias as well as a type)
fieldBefore : List Tok -> Int -> Bool
fieldBefore Nil start = False
fieldBefore (Cons t rest) start =
  operandBefore (Cons t rest) start
  || t.end == start && strEq t.kind "kw" && isUpperC (byteAt t.text 0)

-- (`lineStart`, past the units from `i` to `j`: on by those of a rune
-- beyond its first)
skewed : String -> Int -> Int -> Int -> Int
skewed src lineStart i j = lineStart + (j - i) - R.runesBetween src i j

mkTok : String -> String -> Int -> Int -> Int -> Int -> Bool -> Tok
mkTok kind text start end line col first =
  { kind = kind
  , text = text
  , start = start
  , end = end
  , line = line
  , col = col
  , first = first
  }

-- (a step that read the one token, from `i` to `j`)
tokStep : Int -> Int -> Int -> Tok -> Step
tokStep j line lineStart t =
  { i = j
  , line = line
  , lineStart = lineStart
  , first = False
  , tok = Just t
  , err = Nothing
  , cmt = Nothing
  }

nameKind : String -> Int -> String
nameKind text c =
  if List.elemBy strEq text keywords then "kw"
  else if isUpperC c then "con"
  else "var"

nameStep : String -> Int -> Int -> Int -> Bool -> Int -> Step
nameStep src i line lineStart first j =
  tokStep
    j
    line
    lineStart
    (mkTok
       (nameKind (strSlice src i j) (byteAt src i))
       (strSlice src i j)
       i
       j
       line
       (i - lineStart)
       first)

fieldStep : String -> Int -> Int -> Int -> Bool -> Int -> Step
fieldStep src i line lineStart first j =
  tokStep
    j
    line
    lineStart
    (mkTok "field" (strSlice src (i + 1) j) i j line (i - lineStart) first)

numStep : String -> Int -> Int -> Int -> Bool -> NumEnd -> Step
numStep src i line lineStart first r =
  tokStep
    r.end
    line
    lineStart
    (mkTok
       (if r.isFloat then "float" else "int")
       (strSlice src i r.end)
       i
       r.end
       line
       (i - lineStart)
       first)

symStep : String -> Int -> Int -> Int -> Bool -> Int -> Step
symStep src i line lineStart first j =
  tokStep
    j
    line
    lineStart
    (mkTok "sym" (strSlice src i j) i j line (i - lineStart) first)

strStep : String -> Int -> Int -> Int -> Bool -> StrEnd -> Step
strStep src i line lineStart first r =
  { i = if r.closed then r.i + 1 else r.i
  , line = line
  , lineStart = skewed src lineStart i (if r.closed then r.i + 1 else r.i)
  , first = False
  , tok =
      Just
        (mkTok
           "str"
           r.text
           i
           (if r.closed then r.i + 1 else r.i)
           line
           (i - lineStart)
           first)
  , err =
      if r.closed then r.bad
      else Just { start = i, end = r.i, msg = "a string is never closed" }
  , cmt = Nothing
  }

-- (a character no token starts with, of `w` units)
unexpectedOf : String -> Int -> Int -> Int -> Bool -> Int -> Step
unexpectedOf src i line lineStart first w =
  { i = i + w
  , line = line
  , lineStart = lineStart + w - 1
  , first = first
  , tok = Nothing
  , err =
      Just
        { start = i
        , end = i + w
        , msg = "unexpected character " ^ strSlice src i (i + w)
        }
  , cmt = Nothing
  }

-- | a character no token starts with: the whole of its rune
unexpectedStep : String -> Int -> Int -> Int -> Bool -> Step
unexpectedStep src i line lineStart first =
  unexpectedOf src i line lineStart first (R.widthAt src i)

-- (a rune's token: its text the rune, as a string)
runeStep : String -> Int -> Int -> Int -> Bool -> CodeEnd -> Step
runeStep src i line lineStart first r =
  { i = r.end
  , line = line
  , lineStart = skewed src lineStart i r.end
  , first = False
  , tok =
      Just (mkTok "rune" (R.encode r.code) i r.end line (i - lineStart) first)
  , err =
      if R.isScalar r.code then Nothing
      else Just
          { start = i, end = r.end, msg = scalarErr "a rune literal" r.code }
  , cmt = Nothing
  }

-- (a `'` where a token starts: a rune literal, if one is there)
quoteStep : String -> Int -> Int -> Int -> Bool -> CodeEnd -> Step
quoteStep src i line lineStart first r =
  if r.ok then runeStep src i line lineStart first r
  else unexpectedStep src i line lineStart first

lineCmtStep : String -> Int -> Int -> Int -> Bool -> Int -> Step
lineCmtStep src i line lineStart first e =
  { i = e
  , line = line
  , lineStart = lineStart
  , first = first
  , tok = Nothing
  , err = Nothing
  , cmt = Just { start = i, end = e, text = strSlice src i e }
  }

-- (a `{- -}` comment, from `i`, of a line from `lineStart`; where it
-- ends, its last line's start, on by its runes' units after the first)
blockCmtStep : String -> Int -> Int -> BlockEnd -> Step
blockCmtStep src i lineStart r =
  { i = r.i
  , line = r.line
  , lineStart =
      if r.lineStart == lineStart then skewed src lineStart i r.i
      else skewed src r.lineStart r.lineStart r.i
  , first = r.first
  , tok = Nothing
  , err =
      if r.closed then Nothing
      else Just { start = i, end = r.i, msg = "a `{-` comment is never closed" }
  , cmt = Just { start = i, end = r.i, text = strSlice src i r.i }
  }

-- | One thing read at `i`: a token, a comment, whitespace, or an error.
stepAt : String -> Int -> Int -> Int -> Bool -> List Tok -> Int -> Step
stepAt src i line lineStart first toks c =
  if c == 10
    then { i = i + 1
         , line = line + 1
         , lineStart = i + 1
         , first = True
         , tok = Nothing
         , err = Nothing
         , cmt = Nothing
         }
  else if c == 32 || c == 9 || c == 13
    then { i = i + 1
         , line = line
         , lineStart = lineStart
         , first = first
         , tok = Nothing
         , err = Nothing
         , cmt = Nothing
         }
  -- a line `-- >>> e` is a watch token, and `-- | >>> e`, in a doc
  -- comment, a doctest token; two dashes or more, not part of an
  -- operator, are a comment to the end of the line
  else if c == 45 && strEq (strSlice src i (i + 6)) "-- >>>"
    then tokStep
        (i + 6)
        line
        lineStart
        (mkTok "watch" "-- >>>" i (i + 6) line (i - lineStart) first)
  else if c == 45 && strEq (strSlice src i (i + 8)) "-- | >>>"
    then tokStep
        (i + 8)
        line
        lineStart
        (mkTok "doctest" "-- | >>>" i (i + 8) line (i - lineStart) first)
  else if c == 45
  && dashesEnd src i - i >= 2
  && not (isSymC (byteAt src (dashesEnd src i)))
    then lineCmtStep src i line lineStart first (eolEnd src i)
  else if c == 123 && byteAt src (i + 1) == 45
    then blockCmtStep src i lineStart (blockScan src i 0 line lineStart first)
  else if isLetterC c then nameStep src i line lineStart first (nameEnd src i)
  else if c == 46 && isLetterC (byteAt src (i + 1)) && fieldBefore toks i
    then fieldStep src i line lineStart first (plainEnd src (i + 1))
  else if isDigitC c
  || c == 45 && isDigitC (byteAt src (i + 1)) && not (operandBefore toks i)
    then numStep src i line lineStart first (numScan src i)
  else if c == 45
  && startsNegated (byteAt src (i + 1))
  && not (operandBefore toks i)
    then tokStep
        (i + 1)
        line
        lineStart
        (mkTok "neg" "-" i (i + 1) line (i - lineStart) first)
  else if c == 34
    then strStep src i line lineStart first (strScan src (i + 1) "" Nothing)
  else if isPunctC c
    then tokStep
        (i + 1)
        line
        lineStart
        (mkTok
           "punct"
           (strSlice src i (i + 1))
           i
           (i + 1)
           line
           (i - lineStart)
           first)
  else if isSymC c then symStep src i line lineStart first (symEnd src (i + 1))
  else if c == 39 then quoteStep src i line lineStart first (runeScan src i)
  else unexpectedStep src i line lineStart first

step : String -> Int -> Int -> Int -> Bool -> List Tok -> Step
step src i line lineStart first toks =
  stepAt src i line lineStart first toks (byteAt src i)

maybeCons : {a : Type} -> Maybe a -> List a -> List a
maybeCons Nothing xs = xs
maybeCons (Just x) xs = Cons x xs

-- (apply the step just taken, and take the next; each list holds what has
-- been read, last first)
lexGo : String -> Step -> List Tok -> List Err -> List Cmt -> Lexed
lexGo src st toks errs cmts =
  if st.i >= strLength src
    then { tokens =
             List.reverse
               (Cons
                  (mkTok
                     "eof"
                     ""
                     (strLength src)
                     (strLength src)
                     (st.line + 1)
                     0
                     True)
                  (maybeCons st.tok toks))
         , errors = List.reverse (maybeCons st.err errs)
         , comments = List.reverse (maybeCons st.cmt cmts)
         }
  else lexGo
      src
      (step src st.i st.line st.lineStart st.first (maybeCons st.tok toks))
      (maybeCons st.tok toks)
      (maybeCons st.err errs)
      (maybeCons st.cmt cmts)

-- | The tokens of a file, and apart from them the comments.
lex : String -> Lexed
lex src =
  lexGo
    src
    { i = 0
    , line = 0
    , lineStart = 0
    , first = True
    , tok = Nothing
    , err = Nothing
    , cmt = Nothing
    }
    Nil
    Nil
    Nil

-- (kind:text, for the doctests)
showTok : Tok -> String
showTok t = t.kind ^ ":" ^ t.text

-- (`(lex src).tokens` in one step panics the elaborator today: an
-- ill-typed projection; through a binder it is fine)
showLexed : Lexed -> String
showLexed l = joinWith " " (List.map showTok l.tokens)

showToks : String -> String
showToks src = showLexed (lex src)

cmtText : Cmt -> String
cmtText c = c.text

tokCol : Tok -> Int
tokCol t = t.col

tokFirst : Tok -> Bool
tokFirst t = t.first

cmtTexts : Lexed -> List String
cmtTexts l = List.map cmtText l.comments

tokText : Tok -> String
tokText t = t.text

tokTexts : Lexed -> List String
tokTexts l = List.map tokText l.tokens

tokCols : Lexed -> List Int
tokCols l = List.map tokCol l.tokens

tokFirsts : Lexed -> List Bool
tokFirsts l = List.map tokFirst l.tokens

errMsg : Err -> String
errMsg e = e.msg

errMsgs : Lexed -> List String
errMsgs l = List.map errMsg l.errors

test lexing

