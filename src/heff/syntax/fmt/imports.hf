-- The header of a file: its name and what it exposes (`module a.b (x,
-- T(..))`) and the
-- `import m` lines, before its first declaration.  They are read off,
-- and the text is returned with them blanked out (spaces, so every
-- offset stays where it was); the formatter then puts an `import`
-- pseudo-token at each one's place, the module header's laid out.

module heff.syntax.fmt.imports

import heff.syntax.fmt.lex as Lex
import heff.syntax.import as Import

type Span = { start : Int, end : Int }

type Import = { name : String, alias : Maybe String, span : Span }

type Header =
  { imports : List Import
  , exposing : Maybe Import.Header
  , text : String
  }

lineEndFrom : String -> Int -> Int
lineEndFrom s i =
  if i >= strLength s then i
  else if byteAt s i == 10 then i
  else lineEndFrom s (i + 1)

nameC : Int -> Bool
nameC c =
  c == 46
  || c == 95
  || c == 45
  || c >= 97 && c <= 122
  || c >= 65 && c <= 90
  || c >= 48 && c <= 57

allNameC : String -> Int -> Bool
allNameC s i =
  if i >= strLength s then True else nameC (byteAt s i) && allNameC s (i + 1)

isName : String -> Bool
isName x = strLength x > 0 && allNameC x 0

-- (a module's alias is capitalised, a name of its own: `M`)
isAlias : String -> Bool
isAlias x =
  strLength x > 0
  && byteAt x 0 >= 65
  && byteAt x 0 <= 90
  && not (contains "." x)
  && isName x

spacesOf : Int -> String
spacesOf n = if n <= 0 then "" else " " ^ spacesOf (n - 1)

blankOne : String -> Import -> String
blankOne s imp =
  strSlice s 0 imp.span.start
  ^ spacesOf (imp.span.end - imp.span.start)
  ^ strSlice s imp.span.end (strLength s)

-- (the words of an import line after `import `, empties dropped)
importWords : String -> List String
importWords rest = List.filter (\w -> strLength w > 0) (split " " (trim rest))

oneImport : Int -> Int -> List String -> Maybe Import
oneImport i e (Cons m Nil) =
  if isName m
  then Just { name = m, alias = Nothing, span = { start = i, end = e } }
  else Nothing
oneImport i e (Cons m (Cons kw (Cons a Nil))) =
  if strEq kw "as" && isName m && isAlias a
  then Just { name = m, alias = Just a, span = { start = i, end = e } }
  else Nothing
oneImport i e ws = Nothing

emptyOrComment : String -> Bool
emptyOrComment line =
  strLength (trim line) == 0 || strEq (strSlice (trim line) 0 2) "--"

readGo : String -> Int -> List Import -> List Import
readGo src i acc =
  if i >= strLength src then List.reverse acc
  else if emptyOrComment (strSlice src i (lineEndFrom src i))
  then readGo src (min (strLength src) (lineEndFrom src i + 1)) acc
  else if strEq (strSlice src i (i + 7)) "import "
  then (case oneImport
          i
          (lineEndFrom src i)
          (importWords (strSlice src (i + 7) (lineEndFrom src i))) of
        Just imp ->
          readGo
            src
            (min (strLength src) (lineEndFrom src i + 1))
            (Cons imp acc)
        Nothing -> List.reverse acc)
  else List.reverse acc

mkHeader : Maybe Import.Header -> String -> List Import -> Header
mkHeader hdr src imps =
  { imports = imps, exposing = hdr, text = List.foldl blankOne src imps }

-- (the text with the module header blanked out)
blankExposing : Maybe Import.Header -> String -> String
blankExposing (Just h) s =
  strSlice s 0 h.span.start
  ^ spacesOf (h.span.end - h.span.start)
  ^ strSlice s h.span.end (strLength s)
blankExposing Nothing s = s

-- (the imports of the text, its module header blanked out)
readBlanked : Maybe Import.Header -> String -> Header
readBlanked hdr t = mkHeader hdr t (readGo t 0 Nil)

-- | The imports of a file, and its text with the header and the import
-- | lines blanked out.
readImports : String -> Header
readImports src =
  readBlanked
    (Import.readImports src).header
    (blankExposing (Import.readImports src).header src)

-- (an `import` pseudo-token at each import's place, among the tokens)
importTok : Import -> Lex.Tok
importTok imp =
  { kind = "import"
  , text = ""
  , start = imp.span.start
  , end = imp.span.end
  , line = 0
  , col = 0
  , first = True
  }

tokLe : Lex.Tok -> Lex.Tok -> Bool
tokLe a b = a.start <= b.start

-- (an entry as a header writes it: an operator in parentheses)
entryText : Import.Exposed -> String
entryText e =
  (if Import.isIdent e.name then e.name else "(" ^ e.name ^ ")")
  ^ (if e.tags then "(..)" else "")

-- (`module`, and the module's name where the header says it)
moduleWord : Maybe String -> String
moduleWord (Just name) = "module " ^ name
moduleWord Nothing = "module"

-- | the module header as it is laid out: its name; its list, where it
-- | has one, on the line where it fits, else an entry a line
exposingText : Maybe String -> Bool -> List String -> String
exposingText name False es = moduleWord name
exposingText name True es =
  if strLength (moduleWord name ^ " (" ^ joinWith ", " es ^ ")") <= 80
  then moduleWord name ^ " (" ^ joinWith ", " es ^ ")"
  else moduleWord name ^ "\n  ( " ^ joinWith "\n  , " es ^ "\n  )"

-- (what the module header's pseudo-token says: laid out, unless what it
-- says is wrong -- then as it is written)
exposingSaid : Import.Header -> String
exposingSaid h = case h.error of
  Just _ -> ""
  Nothing -> exposingText h.name h.listed (List.map entryText h.exposes)

exposingToks : Maybe Import.Header -> List Lex.Tok
exposingToks (Just h) =
  [ { kind = "import"
    , text = exposingSaid h
    , start = h.span.start
    , end = h.span.end
    , line = 0
    , col = 0
    , first = True
    }
  ]
exposingToks Nothing = Nil

-- | The tokens with the header's pseudo-tokens in place, in source
-- | order.
withImports : Header -> List Lex.Tok -> List Lex.Tok
withImports hdr toks =
  List.sortBy
    tokLe
    (List.append
       (List.append
          (exposingToks hdr.exposing)
          (List.map importTok hdr.imports))
       toks)

importName : Import -> String
importName imp = imp.name

importNames : Header -> List String
importNames h = List.map importName h.imports

headerText : Header -> String
headerText h = h.text

test headers

-- >>> importNames (readImports "import a\nimport b as B\n\nf = 1")
-- Cons "a" (Cons "b" Nil)

-- >>> headerText (readImports "import a\nf = 1")
-- "        \nf = 1"

-- >>> importNames (readImports "-- c\nimport a.b\nf = 1")
-- Cons "a.b" Nil

-- >>> importNames (readImports "f = 1\nimport a")
-- Nil

-- >>> importNames (readImports "-- c\nmodule (x, T(..))\n\nimport a\nf = 1")
-- Cons "a" Nil

-- >>> exposingText Nothing True ["With", "withFile"]
-- "module (With, withFile)"

-- >>> exposingText (Just "std.with") True ["With", "withFile"]
-- "module std.with (With, withFile)"

-- >>> exposingText (Just "std.with") False Nil
-- "module std.with"
