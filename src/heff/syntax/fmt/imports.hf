-- The module claim and the `import` lines among the tokens the
-- formatter lays out: each, as the imports' reading found it, an
-- `import` pseudo-token at its place, the module claim's laid out.

module heff.syntax.fmt.imports

import heff.syntax.fmt.lex as Lex
import heff.syntax.import as Import

-- (an `import` pseudo-token at each import's place, among the tokens)
importTok : Import.Import -> Lex.Tok
importTok imp =
  { kind = "import"
  , text = ""
  , start = imp.span.start
  , end = imp.span.end
  , line = 0
  , col = 0
  , first = True
  }

-- (an entry as a claim writes it: an operator in parentheses)
entryText : Import.Exposed -> String
entryText e =
  (if Import.isIdent e.name then e.name else "(" ^ e.name ^ ")")
  ^ (if e.tags then "(..)" else "")

-- (`module`, and the module's name where the claim says it)
moduleWord : Maybe String -> String
moduleWord (Just name) = "module " ^ name
moduleWord Nothing = "module"

-- | the module claim as it is laid out: its name; its list, where it
-- | has one, on the line where it fits, else an entry a line
exposingText : Maybe String -> Bool -> List String -> String
exposingText name False es = moduleWord name
exposingText name True es =
  if strLength (moduleWord name ^ " (" ^ joinWith ", " es ^ ")") <= 80
  then moduleWord name ^ " (" ^ joinWith ", " es ^ ")"
  else moduleWord name ^ "\n  ( " ^ joinWith "\n  , " es ^ "\n  )"

-- (what the module claim's pseudo-token says: laid out, unless what it
-- says is wrong -- then as it is written)
exposingSaid : Import.Claim -> String
exposingSaid h = case h.error of
  Just _ -> ""
  Nothing -> exposingText h.name h.listed (List.map entryText h.exposes)

exposingToks : Maybe Import.Claim -> List Lex.Tok
exposingToks (Just h) =
  [ { kind = "import"
    , text = exposingSaid h
    , start = h.span.start
    , end = h.span.end
    , line = 0
    , col = 0
    , first = True
    }
  ]
exposingToks Nothing = Nil

-- | The tokens with the claim's pseudo-tokens in place, in source
-- | order.
withImports : Import.Imports -> List Lex.Tok -> List Lex.Tok
withImports imps toks =
  List.sortOn
    (\(t : Lex.Tok) -> t.start)
    (List.append
       (List.append
          (exposingToks imps.claim)
          (List.map importTok imps.imports))
       toks)

test claims

-- >>> exposingText Nothing True ["With", "withFile"]
-- "module (With, withFile)"

-- >>> exposingText (Just "std.with") True ["With", "withFile"]
-- "module std.with (With, withFile)"

-- >>> exposingText (Just "std.with") False Nil
-- "module std.with"
