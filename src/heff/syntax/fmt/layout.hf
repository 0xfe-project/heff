-- Laying a file out anew.
-- The concrete syntax from `heff.syntax.cst` is turned into a `doc` document and
-- rendered at width 80; blank lines between declarations are kept, at most
-- one, and each comment goes where it was attached; a definition under
-- `-- fmt: skip` is kept as written.  What lays an expression out calls
-- itself through the record `lay`, as the grammar does through `gram`.

module heff.syntax.fmt.layout

import array as Array
import heff.syntax.cst as CST
import heff.syntax.fixity as Fixity
import heff.syntax.fmt.imports as Imports
import heff.syntax.fmt.lex as Lex
import heff.syntax.fmt.tokens as Tokens
import std.map as Map
import std.doc

type T = Tokens.T

-- (a line to keep blank, and a line break inside a comment: what is left
-- blank otherwise, from a line break forced by a comment, is dropped)
blankMark : String
blankMark = "\x01"

newlineMark : String
newlineMark = "\x02"

replaceAll : String -> String -> String -> String
replaceAll pat rep s = joinWith rep (split pat s)

rtrimEnd : String -> Int -> Int
rtrimEnd s e =
  if e > 0
     && (byteAt s (e - 1) == 32
         || byteAt s (e - 1) == 9
         || byteAt s (e - 1) == 13)
  then rtrimEnd s (e - 1)
  else e

rtrim : String -> String
rtrim s = strSlice s 0 (rtrimEnd s (strLength s))

comment : String -> Doc
comment s = text (replaceAll "\n" newlineMark s)

blankLine : Doc
blankLine = text blankMark <> hardline

foldDocs : List Doc -> Doc
foldDocs ds = List.foldl (\a b -> a <> b) emptyDoc ds

-- Tokens with their comments

leadOf : Tokens.Env -> T -> List Tokens.Cmt
leadOf env t = fromMaybe Nil (Map.lookup env.lead t.ix)

trailOf : Tokens.Env -> T -> Doc
trailOf env t = case Map.lookup env.trail t.ix of
  Nothing -> emptyDoc
  Just c -> text " " <> comment c <> hardline

cmtLead : Tokens.Cmt -> Doc
cmtLead c = hardline <> comment c.text

inlineDoc : String -> Doc
inlineDoc c = comment c <> text " "

tokLead : Tokens.Env -> T -> List Tokens.Cmt
tokLead env t = if t.ix == env.noLead then Nil else leadOf env t

-- | A token, with its comments: those before it on lines of their own, and
-- | the one after it on its line (after which the line ends).
tok : Tokens.Env -> T -> Doc
tok env t =
  (if List.null (tokLead env t) then emptyDoc
   else foldDocs (List.map cmtLead (tokLead env t)) <> hardline)
  <> foldDocs
    (List.map inlineDoc (fromMaybe Nil (Map.lookup env.inline t.ix)))
  <> text t.raw
  <> (if t.ix == env.noTrail then emptyDoc else trailOf env t)

cmtBlank : Tokens.Cmt -> Bool
cmtBlank c = c.blank

tokBlank : T -> Bool
tokBlank t = t.blank

tokIx2 : T -> Int
tokIx2 t = t.ix

tokEnd : T -> Int
tokEnd t = t.end

-- | a blank line was before the item (before its comments, if any)
blankBefore : Tokens.Env -> T -> Bool
blankBefore env t = case List.head (leadOf env t) of
  Just c -> cmtBlank c
  Nothing -> tokBlank t

noComments : Tokens.Env -> Int -> Int -> Tokens.Env
noComments env noLead noTrail =
  { src = env.src
  , lead = env.lead
  , inline = env.inline
  , trail = env.trail
  , noLead = noLead
  , noTrail = noTrail
  , fix = env.fix
  }

leadDocs : List Tokens.Cmt -> Int -> Doc
leadDocs Nil i = emptyDoc
leadDocs (Cons c cs) i =
  (if i > 0 && cmtBlank c then blankLine else emptyDoc)
  <> comment c.text
  <> hardline
  <> leadDocs cs (i + 1)

-- | an item (a declaration, or an item of a block) from the token `first`
-- | to `last`, at the current column: its leading comments there, the rest
-- | of it indented further, so that no line of it could start another, and
-- | the comment after it (outside what it groups, which it would break)
item : Tokens.Env -> T -> T -> (Tokens.Env -> Doc) -> Doc
item env first last2 body =
  leadDocs (leadOf env first) 0
  <> (if not (List.null (leadOf env first)) && tokBlank first then blankLine
      else emptyDoc)
  <> nest
    2
    (body (noComments env (tokIx2 first) (tokIx2 last2))
     -- (unless an item around it ends there too, and lays it out)
     <> (if tokIx2 last2 == env.noTrail then emptyDoc else trailOf env last2))

itemsGo : {a : Type}
        -> Tokens.Env
        -> (a -> T)
        -> (a -> T)
        -> (Tokens.Env -> a -> Doc)
        -> Int
        -> List a
        -> Doc
itemsGo env first last2 doc2 i Nil = emptyDoc
itemsGo env first last2 doc2 i (Cons x xs) =
  hardline
  <> (if i > 0 && blankBefore env (first x) then blankLine else emptyDoc)
  <> item env (first x) (last2 x) (\e -> doc2 e x)
  <> itemsGo env first last2 doc2 (i + 1) xs

-- | items, each on a line of its own, blank lines between kept
items : {a : Type}
      -> Tokens.Env
      -> (a -> T)
      -> (a -> T)
      -> (Tokens.Env -> a -> Doc)
      -> List a
      -> Doc
items env first last2 doc2 xs = itemsGo env first last2 doc2 0 xs

-- The expressions

-- (an application whose last argument is a `do` block, `run do`)
endsInDo : List CST.E -> Bool
endsInDo args = case List.last args of
  Just (Do kw stmts) -> True
  _ -> False

-- | what is right of `=` (or `->`, `<-`): a lambda, `case` or `do` right
-- | there (a `do` an application's last argument, `run do`, too),
-- | anything else on the next line if it does not fit
opensBlock : CST.E -> Bool
opensBlock (Lam bs binders arrow body) = True
opensBlock (Case kw scrut of2 alts) = True
opensBlock (Do kw stmts) = True
opensBlock (App h args) = endsInDo args
opensBlock e = False

-- | a `do` or `case`, or a lambda to one (or an application to one, `run
-- | do`): its items are lines of their own
hangs : CST.E -> Bool
hangs (Lam bs binders arrow body) = hangs body
hangs (Case kw scrut of2 alts) = True
hangs (Do kw stmts) = True
hangs (App h args) = endsInDo args
hangs e = False

-- | a record's setting, or a record type's field with its default: in
-- | braces, a field, never a binder (`x : A := d` is a binder's)
isFSet : CST.E -> Bool
isFSet (EFSet x eq e) = True
isFSet (EFDefault d eq e) = strEq eq.text "="
isFSet e = False

-- Line breaks as written.  A bracketed group, an application, a chain
-- of operators, `if`, `let` written over several lines stays broken,
-- even if it would fit on one; written on one line, it is put on one if
-- it fits (as ormolu and elm-format do).  What is laid out broken is
-- written broken, so a file formatted again stays as it is.

-- (a line break in `s` from `a` to before `b`)
newlineIn : String -> Int -> Int -> Bool
newlineIn s a b =
  if a >= b then False
  else if byteAt s a == 10 then True
  else newlineIn s (a + 1) b

-- | the brackets `o` and `c` were written on lines apart
linesApart : Tokens.Env -> T -> T -> Bool
linesApart env o c = newlineIn env.src o.end c.start

-- | `d`, or a hard line break if the group was written broken there: one
-- | no group around it can flatten, so the group breaks at each of its
-- | lines
breakIf : Bool -> Doc -> Doc
breakIf True d = hardline
breakIf False d = d

-- | `e` was written at the start of a line
startsLine : CST.E -> Bool
startsLine e = (CST.firstE e).first

-- | a chain was written broken at the operator: before it, or after it
brokenAt : CST.E -> Bool
brokenAt (OpRhs op e) = op.first || startsLine e
brokenAt e = False

-- | the arguments, each after a line break, a hard one where an argument
-- | was written at the start of a line
argLines : (CST.E -> Doc) -> List CST.E -> Doc
argLines one args =
  foldDocs (List.map (\a -> breakIf (startsLine a) line <> one a) args)

-- | `a -> b -> c` (or `@`, `*`) as its operands
data Chain = MkChain CST.E (List CST.E)

sameOp : T -> List CST.E -> Bool
sameOp op Nil = True
sameOp op (Cons (OpRhs op2 e) rest) = strEq op2.text op.text
sameOp op other = False

chainOp : CST.E -> T -> CST.E -> Chain -> Chain
chainOp a op b (MkChain bf rest) =
  if sameOp op rest then MkChain a (Cons (OpRhs op bf) rest)
  else MkChain a (Cons (OpRhs op b) Nil)

chain : CST.E -> Chain
chain (Op a op b) = chainOp a op b (chain b)
chain e = MkChain e Nil

anyArrow : List CST.E -> Bool
anyArrow Nil = False
anyArrow (Cons (OpRhs op e) rest) =
  if strEq op.text "->" then True else anyArrow rest
anyArrow (Cons e rest) = anyArrow rest

unsnocRev : List CST.E -> Maybe (Pair (List CST.E) CST.E)
unsnocRev Nil = Nothing
unsnocRev (Cons x rev) = Just (MkPair (List.reverse rev) x)

unsnocE : List CST.E -> Maybe (Pair (List CST.E) CST.E)
unsnocE es = unsnocRev (List.reverse es)

-- (`pOne` is `pP env`: the two call one another, so one is passed in)
pListGo : Tokens.Env
        -> (CST.Pat -> Doc)
        -> List CST.Pat
        -> List T
        -> Bool
        -> Doc
pListGo env pOne Nil commas isFirst = emptyDoc
pListGo env pOne (Cons p ps) commas isFirst =
  (if isFirst then emptyDoc
   else (case List.head commas of
         Just comma -> tok env comma <> text " "
         Nothing -> emptyDoc))
  <> pOne p
  <> pListGo env pOne ps (if isFirst then commas else List.drop 1 commas) False

pP : Tokens.Env -> CST.Pat -> Doc
pP env (POp l op r) = pP env l <+> tok env op <+> pP env r
pP env (PCon c args) =
  tok env c <> foldDocs (List.map (\p -> text " " <> pP env p) args)
pP env (PAtom t) = tok env t
pP env (PParen o p c) = tok env o <> pP env p <> tok env c
pP env (PList o ps commas c) =
  tok env o <> pListGo env (\p2 -> pP env p2) ps commas True <> tok env c
pP env (PRec o fs commas c) =
  tok env o <+> pListGo env (\p2 -> pP env p2) fs commas True <+> tok env c
pP env (PField x eq p) = tok env x <+> tok env eq <+> pP env p
pP env (PAs x at p) = tok env x <> tok env at <> pP env p
-- (a segment of a binary pattern, close: `x::16-big`)
pP env (PSeg p cc spec) =
  pP env p <> tok env cc <> foldDocs (List.map (\t -> tok env t) spec)

-- A chain of several tightnesses breaks at its loosest operators, each
-- tighter run kept whole while it fits -- as the fixities in scope say,
-- for layout alone (how they bind is the parser's business).  An
-- operator not declared, or two unrelated, lay the chain out flat.

consOp : String -> Maybe (List String) -> Maybe (List String)
consOp o (Just ops) = Just (o :: ops)
consOp o Nothing = Nothing

-- | the operators of a chain, if every one is declared
opsOf : Fixity.Fixities -> List CST.E -> Maybe (List String)
opsOf f Nil = Just Nil
opsOf f (OpRhs op e :: rs) = case Fixity.groupOf f op.text of
  Just _ -> consOp op.text (opsOf f rs)
  Nothing -> Nothing
opsOf f (_ :: rs) = Nothing

loosestGo : Fixity.Fixities -> String -> List String -> Maybe String
loosestGo f m Nil = Just m
loosestGo f m (o :: os) = case Fixity.relate f m o of
  Tighter -> loosestGo f o os
  Looser -> loosestGo f m os
  Same _ -> loosestGo f m os
  _ -> Nothing

-- | the loosest operator of a chain, if each is declared and all related
loosest : Fixity.Fixities -> List CST.E -> Maybe String
loosest f rest = case opsOf f rest of
  Just (o :: os) -> loosestGo f o os
  _ -> Nothing

sameAs : Fixity.Fixities -> String -> String -> Bool
sameAs f m s = case Fixity.relate f m s of
  Same _ -> True
  _ -> False

isSameIn : Fixity.Fixities -> String -> CST.E -> Bool
isSameIn f m (OpRhs op e) = sameAs f m op.text
isSameIn f m r = False

-- | an application whose last argument is a `do` or `case`: its items
-- | are lines of their own, indented from the line
hangsLast : CST.E -> Bool
hangsLast (App h args) = case unsnocE args of
  Just (MkPair init2 (EParen o e c)) -> hangs e
  Just (MkPair init2 a) -> hangs a
  Nothing -> False
hangsLast e = False

-- | an item of a list or tuple, a block in it (or at its end) indented
-- | past the commas, as a record's field is: else the items of a `case`
-- | would be under the commas, and a comma would end the last one
elemDoc : (CST.E -> Doc) -> CST.E -> Doc
elemDoc one e = if hangs e || hangsLast e then nest 4 (one e) else one e

theory Lay where
  pE : Tokens.Env -> CST.E -> Doc
  rhsOf : Tokens.Env -> CST.E -> Doc
  letHead : Tokens.Env
          -> T
          -> CST.Pat
          -> Maybe (Pair T CST.E)
          -> T
          -> CST.E
          -> Doc
  letLink : Tokens.Env
          -> T
          -> CST.Pat
          -> Maybe (Pair T CST.E)
          -> T
          -> CST.E
          -> T
          -> CST.E
          -> Doc
  ifLink : Tokens.Env -> T -> CST.E -> T -> CST.E -> Doc
  elseOf : Tokens.Env -> T -> CST.E -> Doc
  appDoc : Tokens.Env -> CST.E -> List CST.E -> Doc
  chainOperand : Tokens.Env -> List CST.E -> CST.E -> Doc
  binderDoc : Tokens.Env -> CST.E -> Doc
  opRhsDoc : Tokens.Env -> List CST.E -> CST.E -> Doc
  opsRhsDoc : Tokens.Env -> CST.E -> Doc
  opsChainDoc : Tokens.Env -> CST.E -> List CST.E -> Doc
  opsCut : Tokens.Env -> String -> CST.E -> List CST.E -> List CST.E -> Doc
  altDoc : Tokens.Env -> CST.E -> Doc
  stmtDoc : Tokens.Env -> CST.E -> Doc
  rhsField : Tokens.Env -> CST.E -> Doc

lay : Lay
lay =
  { pE = \env e0 -> case e0 of
      Atom t -> tok env t
      BVar t -> tok env t
      BImp o x c -> tok env o <> tok env x <> tok env c
      BAnn o x cc ty c ->
        tok env o <> tok env x <+> tok env cc <+> lay.pE env ty <> tok env c
      BPat p -> pP env p
      EParen o e c -> tok env o <> align (lay.pE env e) <> tok env c
      Named o x k e c ->
        tok env o <> tok env x <+> tok env k <+> lay.pE env e <> tok env c
      Tup o es commas c ->
        (case es of
         Nil -> tok env o <> tok env c
         Cons e1 more ->
           group
             (align
                (tok env o
                 <> flatAlt (text " ") emptyDoc
                 <> elemDoc (lay.pE env) e1
                 <> foldDocs
                   (List.zipWith
                      (\comma e ->
                         linebreak <> tok env comma <+> elemDoc (lay.pE env) e)
                      commas
                      more)
                 <> breakIf (linesApart env o c) linebreak
                 <> tok env c)))
      -- (a segment of a binary, close: `x::16-big`)
      Seg v cc spec ->
        lay.pE env v
        <> tok env cc
        <> foldDocs (List.map (\t -> tok env t) spec)
      InstB o o2 d c1 c ->
        tok env o <> tok env o2 <> lay.pE env d <> tok env c1 <> tok env c
      Braces o fs commas c ->
        (case fs of
         Nil -> tok env o <> tok env c
         Cons f1 more ->
           group
             (align
                (tok env o <+> nest 4 (lay.rhsField env f1)
                 <> foldDocs
                   (List.zipWith
                      (\comma f ->
                         linebreak
                         <> tok env comma <+> nest 4 (lay.rhsField env f))
                      commas
                      more)
                 <> breakIf (linesApart env o c) line
                 <> tok env c)))
      -- (`{ r | x = v, y = w }`, or broken: `|` under the brace, the
      -- settings after it a line each)
      Update o r bar fs commas c ->
        (case fs of
         Nil -> tok env o <+> lay.pE env r <+> tok env bar <+> tok env c
         Cons f1 more ->
           group
             (align
                (tok env o <+> nest 2 (lay.pE env r)
                 <> line
                 <> tok env bar <+> nest 4 (lay.rhsField env f1)
                 <> foldDocs
                   (List.zipWith
                      (\comma f ->
                         linebreak
                         <> tok env comma <+> nest 4 (lay.rhsField env f))
                      commas
                      more)
                 <> breakIf (linesApart env o c) line
                 <> tok env c)))
      EUSet x eq e -> lay.pE env x <+> tok env eq <> lay.rhsOf env e
      EFSet x eq e -> tok env x <+> tok env eq <> lay.rhsOf env e
      EFDefault d eq e -> lay.pE env d <+> tok env eq <> lay.rhsOf env e
      Sum kw o alts bars c ->
        (case alts of
         Nil -> tok env kw <+> tok env o <+> tok env c
         Cons a1 more ->
           tok env kw
           <+> group
             (align
                (tok env o <+> lay.pE env a1
                 <> foldDocs
                   (List.zipWith
                      (\bar a ->
                         breakIf (linesApart env o c) line
                         <> tok env bar <+> lay.pE env a)
                      bars
                      more)
                 <+> tok env c)))
      ECon c args ->
        tok env c <> foldDocs (List.map (\a -> text " " <> lay.pE env a) args)
      EField e f -> lay.pE env e <> tok env f
      ENeg m e -> tok env m <> lay.pE env e
      ETilde m e -> tok env m <> lay.pE env e
      App h args -> lay.appDoc env h args
      Op a op b ->
        (case chain (Op a op b) of
         MkChain first rest ->
           group
             (lay.chainOperand env rest first
              <> foldDocs
                (List.map
                   (\r -> breakIf (brokenAt r) line <> lay.opRhsDoc env rest r)
                   rest)))
      Ops a rest -> lay.opsChainDoc env a rest
      OpRhs op e -> tok env op <+> lay.pE env e
      Ann e cc ty ->
        group (lay.pE env e <+> tok env cc <> nest 2 (line <> lay.pE env ty))
      Lam bs binders arrow body ->
        tok env bs
        <> concatWith (\a b -> a <+> b) (List.map (lay.binderDoc env) binders)
        <+> tok env arrow
        <> (if opensBlock body then text " " <> lay.pE env body
            else group (nest 2 (line <> lay.pE env body)))
      Case kw scrut of2 alts ->
        tok env kw <+> lay.pE env scrut <+> tok env of2
        <> items env CST.firstE CST.lastE (\e a -> lay.altDoc e a) alts
      EAlt p arrow body -> pP env p <+> tok env arrow <> lay.rhsOf env body
      If kw c th a el b ->
        group (lay.ifLink env kw c th a <> lay.elseOf env el b)
      Do kw stmts ->
        tok env kw
        <> items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) stmts
      ESBind x arrow e -> pP env x <+> tok env arrow <> lay.rhsOf env e
      -- (`in` under `let`, if it does not fit on the line; a `let` after
      -- `in` goes on at the same depth, a chain, not a staircase)
      ELet kw p ann eq e body ->
        (case body of
         Nothing -> lay.letHead env kw p ann eq e
         Just (MkPair i b) -> align (group (lay.letLink env kw p ann eq e i b)))
      -- (one statement written on the `else`'s line stays there)
      ELetElse kw p ann eq e el ss ->
        lay.letHead env kw p ann eq e
        <+> tok env el
        <> (case ss of
            Cons s1 Nil ->
              if (CST.firstE s1).first
              then items
                  env
                  CST.firstE
                  CST.lastE
                  (\e2 s2 -> lay.stmtDoc e2 s2)
                  ss
              else text " " <> lay.stmtDoc env s1
            _ ->
              items env CST.firstE CST.lastE (\e2 s2 -> lay.stmtDoc e2 s2) ss)
      ELetMut kw m x ann eq e ->
        tok env kw <+> tok env m <+> tok env x
        <> (case ann of
            Just (MkPair cc ty) -> text " " <> tok env cc <+> lay.pE env ty
            Nothing -> emptyDoc)
        <+> tok env eq
        <> lay.rhsOf env e
      EAssign x k e -> tok env x <+> tok env k <> lay.rhsOf env e
      EWhile kw c d body ->
        tok env kw <+> align (lay.pE env c) <+> tok env d
        <> items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) body
      EFor kw p i c d body ->
        tok env kw
        <+> pP env p
        <+> tok env i
        <+> align (lay.pE env c)
        <+> tok env d
        <> items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) body
      EWith kw e a x d body ->
        tok env kw
        <+> align (lay.pE env e)
        <+> tok env a
        <+> pP env x
        <+> tok env d
        <> items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) body
      EJump kw -> tok env kw
      EReturn kw e -> tok env kw <+> nest 2 (lay.pE env e)
      ENest o arrow e c ->
        tok env o <> tok env arrow <+> lay.pE env e <> tok env c
      IfThen kw c th a -> group (lay.ifLink env kw c th a)
      -- (`catch` under `try`, each part's statements indented past it)
      ETry kw ty body c ->
        align
          (tok env kw
           <> (case ty of
               Just t -> text " " <> lay.pE env t
               Nothing -> emptyDoc)
           <> nest
             2
             (items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) body)
           <> hardline
           <> lay.pE env c)
      ECatch kw b arrow body ->
        tok env kw
        <+> lay.binderDoc env b
        <+> tok env arrow
        <> nest
          2
          (items env CST.firstE CST.lastE (\e s -> lay.stmtDoc e s) body)
  , rhsOf = \env e ->
        if opensBlock e then text " " <> lay.pE env e
        else group (line <> lay.pE env e)
  , letHead = \env kw p ann eq e ->
        tok env kw <+> pP env p
        <> (case ann of
            Just (MkPair cc ty) -> text " " <> tok env cc <+> lay.pE env ty
            Nothing -> emptyDoc)
        <+> tok env eq
        <> lay.rhsOf env e
  , letLink = \env kw p ann eq e i b ->
        nest 2 (lay.letHead env kw p ann eq e)
        <> breakIf (i.first || startsLine b) line
        <> tok env i
        <+> (case b of
             ELet kw2 p2 ann2 eq2 e2 (Just (MkPair i2 b2)) ->
               lay.letLink env kw2 p2 ann2 eq2 e2 i2 b2
             _ -> lay.pE env b)
  -- (`else if` goes on at the same depth: a chain, not a staircase, and
  -- each link holds `if ... then ...` on one line while it fits; a
  -- broken `then` is under `if`, as `else` is, and a broken condition
  -- goes on under its own first token)
  , ifLink = \env kw c th a ->
        group
          (tok env kw <+> align (lay.pE env c)
           <> breakIf (th.first || startsLine a) line
           <> tok env th <+> nest 2 (lay.pE env a))
  , elseOf = \env el b -> case b of
      If kw c th a el2 b2 ->
        breakIf (el.first || startsLine b) line
        <> tok env el <+> lay.ifLink env kw c th a
        <> lay.elseOf env el2 b2
      _ ->
        breakIf (el.first || startsLine b) line
        <> tok env el <+> nest 2 (lay.pE env b)
  -- (a block last, `f x (\y -> do`, stays on the line, and its items are
  -- indented from the line, not from the parenthesis)
  , appDoc = \env h args -> case unsnocE args of
      Nothing -> lay.pE env h
      Just pr ->
        (case pr of
         MkPair init2 lastA ->
           (case lastA of
            EParen o e c ->
              if hangs e
              then group
                  (lay.pE env h
                   <> nest
                     2
                     (argLines (lay.pE env) init2))
                <+> tok env o
                <> lay.pE env e
                <> tok env c
              else group
                  (lay.pE env h
                   <> nest
                     2
                     (argLines (lay.pE env) args))
            _ ->
              if hangs lastA
              then group
                  (lay.pE env h
                   <> nest
                     2
                     (argLines (lay.pE env) init2))
                <+> lay.pE env lastA
              else group
                  (lay.pE env h
                   <> nest
                     2
                     (argLines (lay.pE env) args))))
  -- (`{x :: A} -> B`: an implicit binder, written close)
  , chainOperand = \env rest e -> case e of
      Braces o fs commas c ->
        (case fs of
         Cons d rest2 ->
           if List.null rest2
              && anyArrow rest
              && not (isFSet d)
              && List.null commas
           then tok env o <> lay.pE env d <> tok env c
           else lay.pE env (Braces o fs commas c)
         Nil -> lay.pE env (Braces o fs commas c))
      _ -> lay.pE env e
  , binderDoc = \env b -> case b of
      BVar t -> tok env t
      BImp o x c -> tok env o <> tok env x <> tok env c
      BAnn o x cc ty c ->
        tok env o <> tok env x <+> tok env cc <+> lay.pE env ty <> tok env c
      BPat p -> pP env p
      _ -> lay.pE env b
  , opRhsDoc = \env rest r -> case r of
      OpRhs op e -> tok env op <+> lay.chainOperand env rest e
      _ -> lay.pE env r
  , opsRhsDoc = \env r -> case r of
      OpRhs op e -> tok env op <+> lay.pE env e
      _ -> lay.pE env r
  -- (a chain of declared operators: flat when one tightness, or one not
  -- declared; else cut at the loosest, each piece a chain again)
  , opsChainDoc = \env first rest -> case loosest env.fix rest of
      Just m ->
        if List.all (isSameIn env.fix m) rest
        then group
            (lay.pE env first
             <> foldDocs
               (List.map
                  (\r -> breakIf (brokenAt r) line <> lay.opsRhsDoc env r)
                  rest))
        else group (lay.opsCut env m first Nil rest)
      Nothing ->
        group
          (lay.pE env first
           <> foldDocs
             (List.map
                (\r -> breakIf (brokenAt r) line <> lay.opsRhsDoc env r)
                rest))
  , opsCut = \env m f acc rs -> case rs of
      Nil -> lay.opsChainDoc env f (List.reverse acc)
      r :: rest2 ->
        (case r of
         OpRhs op e ->
           if sameAs env.fix m op.text
           then lay.opsChainDoc env f (List.reverse acc)
             <> breakIf (brokenAt r) line
             <> tok env op <+> lay.opsCut env m e Nil rest2
           else lay.opsCut env m f (r :: acc) rest2
         _ -> lay.opsCut env m f (r :: acc) rest2)
  , altDoc = \env a -> case a of
      EAlt p arrow body -> pP env p <+> tok env arrow <> lay.rhsOf env body
      _ -> lay.pE env a
  -- (a broken `then` and `else` under the `if`, as outside a block: not
  -- indented as the rest of a statement is)
  , stmtDoc = \env s -> case s of
      ESBind x arrow e -> pP env x <+> tok env arrow <> lay.rhsOf env e
      If _ _ _ _ _ _ -> nest (0 - 2) (lay.pE env s)
      IfThen _ _ _ _ -> nest (0 - 2) (lay.pE env s)
      _ -> lay.pE env s
  -- (a block in a field is indented past the commas: the `nest 4` is at
  -- the use)
  , rhsField = \env f -> case f of
      EUSet x eq e -> lay.pE env x <+> tok env eq <> lay.rhsOf env e
      EFSet x eq e -> tok env x <+> tok env eq <> lay.rhsOf env e
      EFDefault d eq e -> lay.pE env d <+> tok env eq <> lay.rhsOf env e
      _ -> lay.pE env f
  }

-- The declarations

-- | `:: A -> B`, the arrows under `::` if it does not fit
sig : Tokens.Env -> T -> CST.E -> Doc
sig env cc ty = align (tok env cc <+> lay.pE env ty)

nmDoc : Tokens.Env -> List T -> Doc
nmDoc env n = foldDocs (List.map (tok env) n)

-- | a signature's names, `f, g`, as written: the commas between them
namesDoc : Tokens.Env -> List (List T) -> List T -> Doc
namesDoc env Nil commas = emptyDoc
namesDoc env (Cons n ns) commas =
  nmDoc env n
  <> foldDocs (List.zipWith (\c m -> tok env c <+> nmDoc env m) commas ns)

-- (a declaration's parameters are not broken: on one line, however long)
paramsDoc : Tokens.Env -> List CST.E -> Doc
paramsDoc env params =
  foldDocs (List.map (\p -> text " " <> flatten (lay.pE env p)) params)

tokFirst : T -> Bool
tokFirst t = t.first

-- | where alternatives break: always, if `=` or a `|` was written at the
-- | start of a line; else only if they do not fit
altBreak : T -> List T -> Doc
altBreak eq bars =
  if tokFirst eq || List.any tokFirst bars then hardline else line

dataAltsDoc : Tokens.Env -> Maybe CST.DAlts -> Doc
dataAltsDoc env Nothing = emptyDoc
dataAltsDoc env (Just (MkDAlts eq Nil bars)) = emptyDoc
dataAltsDoc env (Just (MkDAlts eq (Cons a1 more) bars)) =
  group
    (altBreak eq bars
     <> tok env eq <+> lay.pE env a1
     <> foldDocs
       (List.zipWith
          (\bar a -> altBreak eq bars <> tok env bar <+> lay.pE env a)
          bars
          more))

universeDoc : Tokens.Env -> Maybe (Pair T CST.E) -> Doc
universeDoc env Nothing = emptyDoc
universeDoc env (Just (MkPair cc u)) = text " " <> tok env cc <+> lay.pE env u

tfFirst : CST.TF -> T
tfFirst (MkTF xs commas cc ty d) = CST.nmFirst xs

tfLast2 : CST.TF -> T
tfLast2 f = CST.tfLast f

-- (a theory's field, and its default after it, `= d`)
tfDefault : Tokens.Env -> Maybe (Pair T CST.E) -> Doc
tfDefault env Nothing = emptyDoc
tfDefault env (Just (MkPair eq d)) = text " " <> tok env eq <> lay.rhsOf env d

tfDoc : Tokens.Env -> CST.TF -> Doc
tfDoc env (MkTF xs commas cc ty d) =
  namesDoc env (CST.oneEach xs) commas <+> sig env cc ty <> tfDefault env d

srcSlice : Tokens.Env -> Int -> Int -> String
srcSlice env a b = strSlice env.src a b

-- (the line break before a declaration but the first, and a blank line
-- if one was before it)
declSep : Tokens.Env -> Int -> CST.D -> Doc
declSep env i d =
  if i > 0
  then hardline
    <> (if blankBefore env (CST.firstD d) then blankLine else emptyDoc)
  else emptyDoc

-- | declarations, one after another, a blank line between two kept
declsGo : Tokens.Env -> (Tokens.Env -> CST.D -> Doc) -> Int -> List CST.D -> Doc
declsGo env one i Nil = emptyDoc
declsGo env one i (Cons d ds) =
  declSep env i d
  <> item env (CST.firstD d) (CST.lastD d) (\e -> one e d)
  <> declsGo env one (i + 1) ds

-- | `where` under an equation, its declarations under it at its column
-- | (#73; the comment after the equation's body, before it)
whereDoc : Tokens.Env
         -> (Tokens.Env -> CST.D -> Doc)
         -> T
         -> Maybe (Pair T (List CST.D))
         -> Doc
whereDoc env one rhsLast Nothing = emptyDoc
whereDoc env one rhsLast (Just (MkPair kw ds)) =
  (case Map.lookup env.trail rhsLast.ix of
   Just _ -> trailOf env rhsLast
   Nothing -> hardline)
  <> tok env kw
  <> hardline
  <> declsGo env one 0 ds

-- (the equation's body, its comment after it laid out by `whereDoc`)
rhsEnv : Tokens.Env -> T -> Maybe (Pair T (List CST.D)) -> Tokens.Env
rhsEnv env rhsLast Nothing = env
rhsEnv env rhsLast (Just _) = noComments env env.noLead (tokIx2 rhsLast)

pD : Tokens.Env -> CST.D -> Doc
pD env (DImport t) = tok env t
pD env (DFixity kw ts) =
  tok env kw <> foldDocs (List.map (\t -> text " " <> tok env t) ts)
pD env (DSig ns commas cc ty) = namesDoc env ns commas <+> sig env cc ty
pD env (DInstance kw n cc ty) = tok env kw <+> nmDoc env n <+> sig env cc ty
pD env (DEqn n pats eq rhs w) =
  nmDoc env n
  <> foldDocs (List.map (\p -> text " " <> pP env p) pats) <+> tok env eq
  <> lay.rhsOf (rhsEnv env (CST.lastE rhs) w) rhs
  <> whereDoc env (\e d -> pD e d) (CST.lastE rhs) w
pD env (DData kw name params universe alts) =
  tok env kw <+> tok env name
  <> paramsDoc env params
  <> universeDoc env universe
  <> dataAltsDoc env alts
pD env (DType kw name params eq body) =
  tok env kw <+> tok env name
  <> paramsDoc env params <+> tok env eq
  <> lay.rhsOf env body
pD env (DTheory kw name params w fields) =
  tok env kw <+> tok env name
  <> paramsDoc env params <+> tok env w
  <> items env tfFirst tfLast2 tfDoc fields
pD env (DMutual kw ds) =
  tok env kw <> hardline <> declsGo env (\e d -> pD e d) 0 ds
pD env (DPrimitive kw x cc ty) = tok env kw <+> tok env x <+> sig env cc ty
pD env (DTest kw x) = tok env kw <+> tok env x
-- (a watch, or a doc test: its mark, a space, and its expression as
-- written -- its expectation is the lines under it)
pD env (DWatch w e) =
  tok env w
  <> (if strEq (trim (srcSlice env (tokEnd w) (CST.firstE e).start)) ""
      then text " "
        <> comment (srcSlice env (CST.firstE e).start (tokEnd (CST.lastE e)))
      else comment (srcSlice env (tokEnd w) (tokEnd (CST.lastE e))))

eofLeadDocs : Tokens.Env -> List Tokens.Cmt -> Doc
eofLeadDocs env Nil = emptyDoc
eofLeadDocs env (Cons c cs) =
  hardline
  <> (if cmtBlank c then blankLine else emptyDoc)
  <> comment c.text
  <> eofLeadDocs env cs

-- Definitions kept as written: a line `-- fmt: skip` among the comments
-- right above a top-level declaration (no blank line between) keeps it
-- as it is written, a signature with the equations of its name after
-- it; above a doc test, the definition the doc test is of.  Elsewhere
-- the line is a comment like any other.

isSkip : Tokens.Cmt -> Bool
isSkip c = strEq (rtrim c.text) "-- fmt: skip"

-- (of the comments before a token, last first, those after the last
-- blank line)
nearGo : List Tokens.Cmt -> List Tokens.Cmt -> List Tokens.Cmt
nearGo Nil acc = acc
nearGo (Cons c cs) acc =
  if cmtBlank c then Cons c acc else nearGo cs (Cons c acc)

-- | a `-- fmt: skip` right above the token, no blank line between
skipsAt : Tokens.Env -> T -> Bool
skipsAt env t =
  not (tokBlank t) && List.any isSkip (nearGo (List.reverse (leadOf env t)) Nil)

tokText : T -> String
tokText t = t.text

nameText : List T -> String
nameText n = joinWith "" (List.map tokText n)

-- (the name a signature or an equation defines; "" of another
-- declaration)
defName : CST.D -> String
defName (DSig (Cons n Nil) commas cc ty) = nameText n
defName (DInstance kw n cc ty) = nameText n
defName (DEqn n pats eq rhs w) = nameText n
defName d = ""

isEqnOf : String -> CST.D -> Bool
isEqnOf x (DEqn n pats eq rhs w) = strEq (nameText n) x
isEqnOf x d = False

-- (the last declaration of the definition from `d`: the last of the
-- equations of its name right after it, or `d`)
defLast : String -> CST.D -> List CST.D -> CST.D
defLast x d Nil = d
defLast x d (Cons e es) = if isEqnOf x e then defLast x e es else d

-- (what is after the definition: the equations of its name dropped)
afterDef : String -> List CST.D -> List CST.D
afterDef x Nil = Nil
afterDef x (Cons e es) = if isEqnOf x e then afterDef x es else Cons e es

gapEnd : String -> Int -> Int
gapEnd s i = if byteAt s i == 32 || byteAt s i == 9 then gapEnd s (i + 1) else i

-- (a `--` comment at `j`, as the lexer reads one)
lineCmtAt : String -> Int -> Bool
lineCmtAt s j =
  byteAt s j == 45
  && Lex.dashesEnd s j - j >= 2
  && not (Lex.isSymC (byteAt s (Lex.dashesEnd s j)))

blockCmtAt : String -> Int -> Bool
blockCmtAt s j = byteAt s j == 123 && byteAt s (j + 1) == 45

blockEnd : Lex.BlockEnd -> Int
blockEnd r = r.i

-- | where the comments after a token on its line end; `i`, where the
-- | token ends, if there are none
trailEnd : String -> Int -> Int
trailEnd s i =
  if lineCmtAt s (gapEnd s i) then Lex.eolEnd s (gapEnd s i)
  else if blockCmtAt s (gapEnd s i)
  then trailEnd s (blockEnd (Lex.blockScan s (gapEnd s i) 0 0 0 False))
  else i

inlineOf : Tokens.Env -> T -> List String
inlineOf env t = fromMaybe Nil (Map.lookup env.inline t.ix)

-- | a definition kept as written: its leading comments laid out as an
-- | item's, then its text copied, from its first token to the comments
-- | after its last on its line
asWritten : Tokens.Env -> T -> T -> Doc
asWritten env first last2 =
  leadDocs (leadOf env first) 0
  <> foldDocs (List.map inlineDoc (inlineOf env first))
  <> comment (srcSlice env first.start (trailEnd env.src last2.end))

isDocTest : CST.D -> Bool
isDocTest (DWatch w e) = strEq w.kind "doctest"
isDocTest d = False

-- (no blank line above the token, nor above its comments)
attached : Tokens.Env -> T -> Bool
attached env t = not (tokBlank t) && not (List.any cmtBlank (leadOf env t))

-- | is the declaration kept as written: a `-- fmt: skip` right above it,
-- | or right above the doc tests right above it (`above`)
skipped : Tokens.Env -> Bool -> CST.D -> Bool
skipped env above d =
  above && attached env (CST.firstD d) || skipsAt env (CST.firstD d)

-- A watch ending a `mutual` block: its expectation, the `-- v` lines
-- under it, is among the comments before what follows the block, and
-- would be laid out there, at the column of the block's keyword.  It is
-- laid out under the watch instead, at its column.

-- | a line of a watch's expectation (`doc`: a doc test's): a comment
-- | `-- v` right under it, not a doc comment's line (a doc test's, a doc
-- | comment's line `-- | v`), neither blank nor after a blank line
expectLine : Bool -> Tokens.Cmt -> Bool
expectLine doc c =
  not c.blank
  && strEq (strSlice c.text 0 2) "--"
  && (if doc
      then strEq (strSlice c.text 0 4) "-- |"
        && not (strEq (trim (strSlice c.text 4 (strLength c.text))) "")
      else not (strEq (strSlice c.text 0 4) "-- |")
        && not (strEq (trim (strSlice c.text 2 (strLength c.text))) ""))

-- (the expectation among the comments before a token: its first lines)
expectLines : Bool -> List Tokens.Cmt -> List Tokens.Cmt
expectLines doc Nil = Nil
expectLines doc (Cons c cs) =
  if expectLine doc c then Cons c (expectLines doc cs) else Nil

-- | the expectation of a watch ending a `mutual` block: the lines under
-- | it, among the comments before the token after the block
blockExpect : Tokens.Env -> CST.D -> List Tokens.Cmt
blockExpect env (DMutual kw ds) = case List.last ds of
  Just (DWatch w e) ->
    expectLines
      (strEq w.kind "doctest")
      (fromMaybe Nil (Map.lookup env.lead (tokIx2 (CST.lastE e) + 1)))
  _ -> Nil
blockExpect env d = Nil

-- (the comments before the token `ix`, the first `n` of them laid out
-- already)
leadLaid : Tokens.Env -> Int -> Int -> Tokens.Env
leadLaid env ix n =
  if n == 0 then env
  else { src = env.src
       , lead =
           Map.insert
             env.lead
             ix
             (List.drop n (fromMaybe Nil (Map.lookup env.lead ix)))
       , inline = env.inline
       , trail = env.trail
       , noLead = env.noLead
       , noTrail = env.noTrail
       , fix = env.fix
       }

-- | the expectation's lines under the watch, indented as the block's
-- | definitions are
expectDocs : List Tokens.Cmt -> Doc
expectDocs cs = nest 2 (foldDocs (List.map cmtLead cs))

-- | the declarations, each laid out, or kept as written under
-- | `-- fmt: skip` with the equations of its name after it (`above`: a
-- | `-- fmt: skip` above the doc tests just laid out); then the comments
-- | at the end of the file
topLevelGo : Tokens.Env -> Int -> Bool -> T -> List CST.D -> Doc
topLevelGo env i above eof Nil = eofLeadDocs env (leadOf env eof)
topLevelGo env i above eof (Cons d ds) =
  declSep env i d
  <> (if isDocTest d
      then item env (CST.firstD d) (CST.lastD d) (\e -> pD e d)
        <> topLevelGo env (i + 1) (skipped env above d) eof ds
      else if skipped env above d
      then asWritten env (CST.firstD d) (CST.lastD (defLast (defName d) d ds))
        <> topLevelGo env (i + 1) False eof (afterDef (defName d) ds)
      else let expect = blockExpect env d
           in item env (CST.firstD d) (CST.lastD d) (\e -> pD e d)
           <> expectDocs expect
           <> topLevelGo
             (leadLaid env (tokIx2 (CST.lastD d) + 1) (List.length expect))
             (i + 1)
             False
             eof
             ds)

topLevel : Tokens.Env -> List CST.D -> T -> Doc
topLevel env ds eof = topLevelGo env 0 False eof ds

-- Rendering

keptLines : List String -> List String
keptLines Nil = Nil
keptLines (Cons l ls) =
  if strEq (trim l) blankMark then Cons "" (keptLines ls)
  else if strEq (trim l) "" then keptLines ls
  else Cons l (keptLines ls)

render2 : Doc -> String
render2 d =
  replaceAll
    newlineMark
    "\n"
    (joinWith "\n" (keptLines (List.map rtrim (split "\n" (renderWidth 80 d)))))
  ^ "\n"

eofOf : Array T -> T
eofOf ts = case Array.index ts (Array.length ts - 1) of
  Just t -> t
  Nothing -> Tokens.dummy (-1)

fmtParsed : Tokens.Attached
          -> Either String (List CST.D)
          -> Either String String
fmtParsed at (Left e) = Left e
fmtParsed at (Right ds) = Right (render2 (topLevel at.env ds (eofOf at.toks)))

withFix : Fixity.Fixities -> Tokens.Attached -> Tokens.Attached
withFix f at =
  { toks = at.toks
  , env =
      { src = at.env.src
      , lead = at.env.lead
      , inline = at.env.inline
      , trail = at.env.trail
      , noLead = at.env.noLead
      , noTrail = at.env.noTrail
      , fix = f
      }
  }

fmtAttached : Tokens.Attached -> Either String String
fmtAttached at = fmtParsed at (CST.parseToks at.toks)

fmtLexed : Fixity.Fixities
         -> String
         -> Imports.Claim
         -> Lex.Lexed
         -> Either String String
fmtLexed f src claim l =
  if not (List.null l.errors) then Left "the file does not lex"
  else fmtAttached
      (withFix
         f
         (Tokens.attach
            src
            (Imports.withImports claim l.tokens)
            l.comments))

fmtClaim : Fixity.Fixities -> String -> Imports.Claim -> Either String String
fmtClaim f src claim = fmtLexed f src claim (Lex.lex claim.text)

-- | A file laid out anew, a chain of operators cut as the fixities in
-- | scope say; what it means not checked (the caller checks).
formatUncheckedIn : Fixity.Fixities -> String -> Either String String
formatUncheckedIn f src = fmtClaim f src (Imports.readImports src)

-- | (with no fixities known: every chain of operators laid out flat)
formatUnchecked : String -> Either String String
formatUnchecked src = formatUncheckedIn Fixity.emptyFixities src

test laying

-- >>> formatUnchecked "f=1"
-- Right "f = 1\n"

-- >>> formatUnchecked "f :  Int -> Int\nf x   =  x + 1"
-- Right "f : Int -> Int\nf x = x + 1\n"

-- >>> formatUnchecked "-- lead\nf = 1 -- trail"
-- Right "-- lead\nf = 1 -- trail\n"

-- >>> formatUnchecked "f = case x of\n  A -> 1\n  B -> 2"
-- Right "f = case x of\n  A -> 1\n  B -> 2\n"

-- >>> formatUnchecked "import a\n\ng = do\n  y <- f 1\n  pure y"
-- Right "import a\n\ng = do\n  y <- f 1\n  pure y\n"

-- >>> formatUnchecked "-- fmt: skip\nm  =  [ 1, 0,\n        0, 1 ]\nn  =  1"
-- Right "-- fmt: skip\nm  =  [ 1, 0,\n        0, 1 ]\nn = 1\n"
