-- Tokens and comments together, for the formatter.  Each token gets its
-- place (`ix`), its text as written (`raw`), and whether a blank line is
-- before it; each comment is attached to a token -- leading it on lines of
-- its own, inline just before it, or trailing it on its line.

module heff.syntax.fmt.tokens

import array as Array
import std.ordmap as OrdMap
import heff.syntax.fixity as Fixity
import heff.syntax.fmt.lex as Lex

-- | A token: `raw` is its text as written, `ix` its place, `blank` whether
-- | a blank line is before it.
type T =
  { kind : String
  , text : String
  , raw : String
  , start : Int
  , end : Int
  , col : Int
  , first : Bool
  , ix : Int
  , blank : Bool
  }

-- | A comment on lines of its own, before a token.
type Cmt = { text : String, blank : Bool }

-- | `src`: the text; `lead`: the comments on lines of their own before a
-- | token; `inline`: those just before it, on its line; `trail`: the
-- | comment after it, on its line; `noLead`: the token whose leading
-- | comments are already laid out (by the item it starts), `noTrail` the
-- | token whose trailing comment is (by the item it ends); `fix`: the
-- | fixities in scope, how a chain of operators is cut.
type Env =
  { src : String
  , lead : OrdMap.OrdMap Int (List Cmt)
  , inline : OrdMap.OrdMap Int (List String)
  , trail : OrdMap.OrdMap Int String
  , noLead : Int
  , noTrail : Int
  , fix : Fixity.Fixities
  }

type Attached = { toks : Array T, env : Env }

-- (a token or a comment, in source order, with the lines it starts and
-- ends on)
type Elem =
  { start : Int
  , end : Int
  , tok : Maybe Lex.Tok
  , text : String
  , startLine : Int
  , endLine : Int
  }

type LastTok = { ix : Int, line : Int }

-- (the fold's state: `toks`, `pending` and `inl` are kept last first)
type StA =
  { prevEnd : Int
  , n : Int
  , toks : List T
  , pending : List Cmt
  , inl : List String
  , lead : OrdMap.OrdMap Int (List Cmt)
  , inline : OrdMap.OrdMap Int (List String)
  , trail : OrdMap.OrdMap Int String
  , lastTok : Maybe LastTok
  , k : Int
  }

countNl : String -> Int -> Int -> Int
countNl s a b =
  if a >= b then 0
  else (if byteAt s a == 10 then 1 else 0) + countNl s (a + 1) b

dummy : Int -> T
dummy ix =
  { kind = "eof"
  , text = ""
  , raw = ""
  , start = 0
  , end = 0
  , col = 0
  , first = True
  , ix = ix
  , blank = False
  }

-- (a token starting on `line`)
tokOnLine : Elem -> Int -> Bool
tokOnLine n line = maybe False (\_ -> n.startLine == line) n.tok

-- (`{- -}` just before a token on its line is inline, before that token)
inlineAt : Array Elem -> Int -> Elem -> Bool
inlineAt elems k e =
  strEq (strSlice e.text 0 2) "{-"
  && (case Array.index elems (k + 1) of
      Just n -> tokOnLine n e.endLine
      Nothing -> False)

-- (the comment after a token on its line trails it; two of them join)
addTrail : OrdMap.OrdMap Int String -> Int -> String -> OrdMap.OrdMap Int String
addTrail m ix text = case OrdMap.lookup m ix of
  Nothing -> OrdMap.insert m ix text
  Just old -> OrdMap.insert m ix (old ^ " " ^ text)

stepTok : String -> StA -> Elem -> Bool -> Lex.Tok -> StA
stepTok src st e blank t =
  { prevEnd = e.endLine
  , n = st.n + 1
  , toks =
      { kind = t.kind
      , text = t.text
      , raw =
          if strEq t.kind "import" && not (strEq t.text "") then t.text
          else if strEq t.kind "import" then trim (strSlice src t.start t.end)
          else strSlice src t.start t.end
      , start = t.start
      , end = t.end
      , col = t.col
      , first = t.first
      , ix = st.n
      , blank = blank
      }
      :: st.toks
  , pending = Nil
  , inl = Nil
  , lead =
      if List.null st.pending then st.lead
      else OrdMap.insert st.lead st.n (List.reverse st.pending)
  , inline =
      if List.null st.inl then st.inline
      else OrdMap.insert st.inline st.n (List.reverse st.inl)
  , trail = st.trail
  , lastTok = Just { ix = st.n, line = e.endLine }
  , k = st.k + 1
  }

stepInline : StA -> Elem -> StA
stepInline st e =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = st.pending
  , inl = e.text :: st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = st.trail
  , lastTok = st.lastTok
  , k = st.k + 1
  }

stepTrail : StA -> Elem -> LastTok -> StA
stepTrail st e lt =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = st.pending
  , inl = st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = addTrail st.trail lt.ix e.text
  , lastTok = Just { ix = lt.ix, line = e.endLine }
  , k = st.k + 1
  }

stepLead : StA -> Elem -> Bool -> StA
stepLead st e blank =
  { prevEnd = e.endLine
  , n = st.n
  , toks = st.toks
  , pending = { text = e.text, blank = blank } :: st.pending
  , inl = st.inl
  , lead = st.lead
  , inline = st.inline
  , trail = st.trail
  , lastTok = st.lastTok
  , k = st.k + 1
  }

-- (a comment neither inline nor trailing leads the next token, on lines of
-- its own)
stepCmt : Array Elem -> StA -> Elem -> Bool -> StA
stepCmt elems st e blank =
  if inlineAt elems st.k e then stepInline st e
  else case st.lastTok of
    Just lt ->
      if lt.line == e.startLine && List.null st.pending && List.null st.inl
      then stepTrail st e lt
      else stepLead st e blank
    Nothing -> stepLead st e blank

step : String -> Array Elem -> StA -> Elem -> StA
step src elems st e@{ tok = Just t } =
  stepTok src st e (st.prevEnd >= 0 && e.startLine - st.prevEnd >= 2) t
step src elems st e@{ tok = Nothing } =
  stepCmt elems st e (st.prevEnd >= 0 && e.startLine - st.prevEnd >= 2)

tokElem : Lex.Tok -> Elem
tokElem t =
  { start = t.start
  , end = t.end
  , tok = Just t
  , text = ""
  , startLine = 0
  , endLine = 0
  }

cmtElem : Lex.Cmt -> Elem
cmtElem c =
  { start = c.start
  , end = c.end
  , tok = Nothing
  , text = c.text
  , startLine = 0
  , endLine = 0
  }

type Lined = { line : Int, offset : Int, out : List Elem }

lineElem : String -> Lined -> Elem -> Lined
lineElem src acc e =
  { line = acc.line + countNl src acc.offset e.start + countNl src e.start e.end
  , offset = e.end
  , out =
      { start = e.start
      , end = e.end
      , tok = e.tok
      , text = e.text
      , startLine = acc.line + countNl src acc.offset e.start
      , endLine =
          acc.line
          + countNl src acc.offset e.start
          + countNl src e.start e.end
      }
      :: acc.out
  }

emptyStA : StA
emptyStA =
  { prevEnd = -1
  , n = 0
  , toks = Nil
  , pending = Nil
  , inl = Nil
  , lead = OrdMap.empty
  , inline = OrdMap.empty
  , trail = OrdMap.empty
  , lastTok = Nothing
  , k = 0
  }

runSteps : String -> Array Elem -> StA
runSteps src elems = Array.foldl (step src elems) emptyStA elems

finish : String -> StA -> Attached
finish src r =
  { toks = Array.fromList (List.reverse r.toks)
  , env =
      { src = src
      , lead = r.lead
      , inline = r.inline
      , trail = r.trail
      , noLead = -1
      , noTrail = -1
      , fix = Fixity.emptyFixities
      }
  }

linedOut : Lined -> List Elem
linedOut l = l.out

lineElems : String -> List Elem -> List Elem
lineElems src es =
  linedOut (List.foldl (lineElem src) { line = 0, offset = 0, out = Nil } es)

-- | Tokens and comments together, in order: each token with its `ix` and
-- | `raw`, each comment attached as leading, inline or trailing.
attach : String -> List Lex.Tok -> List Lex.Cmt -> Attached
attach src toks comments =
  finish
    src
    (runSteps
       src
       (Array.fromList
          (List.reverse
             (lineElems
                src
                (List.sortOn
                   (\(e : Elem) -> e.start)
                   (List.append
                      (List.map tokElem toks)
                      (List.map cmtElem comments)))))))

-- | the tokens alone, to be read and not laid out: each its place, no
-- | comment attached (`raw` is the token's text)
plainGo : Int -> List T -> List Lex.Tok -> List T
plainGo n acc [] = List.reverse acc
plainGo n acc (t :: rest) =
  plainGo
    (n + 1)
    ({ kind = t.kind
     , text = t.text
     , raw = t.text
     , start = t.start
     , end = t.end
     , col = t.col
     , first = t.first
     , ix = n
     , blank = False
     }
     :: acc)
    rest

plain : List Lex.Tok -> Array T
plain toks = Array.fromList (plainGo 0 Nil toks)
