-- Local definitions lifted: an `EFix f e` -- a `where` definition, its
-- body `e` mentioning itself as `f` -- becomes a global of its own, which
-- takes the variables `e` mentions and does not bind (those of what it
-- is defined in) as its first arguments.  Where the definition stood,
-- and where `e` mentions `f`, is that global given them; a loop of the
-- local definition is a loop of the global, and a call of it a call of
-- the global.

import heff.ir as I

-- The variables an expression mentions and does not bind
--------------------------------------------------------------------------------

-- (in the order they are first met)
addFree : List String -> String -> List String -> List String
addFree bound x acc =
  if List.elemBy strEq x bound || List.elemBy strEq x acc then acc else x :: acc

freeGo : List String -> I.Expr -> List String -> List String
freeGo bound e acc = case e of
  EVar x -> addFree bound x acc
  ELam xs b -> freeGo (I.appendI xs bound) b acc
  EApp f as -> List.foldl (\a x -> freeGo bound x a) (freeGo bound f acc) as
  ELet x a b -> freeGo (x :: bound) b (freeGo bound a acc)
  ERecord fs -> List.foldl (\a f -> freeGo bound (snd f) a) acc fs
  EProj x _ _ -> freeGo bound x acc
  ETag _ es -> List.foldl (\a x -> freeGo bound x a) acc es
  EMatch x arms ->
    List.foldl
      (\a arm -> freeGo (I.appendI (I.armVars arm) bound) (I.armBody arm) a)
      (freeGo bound x acc)
      arms
  EPrimCall _ es -> List.foldl (\a x -> freeGo bound x a) acc es
  ECall _ es -> List.foldl (\a x -> freeGo bound x a) acc es
  EFix f b -> freeGo (f :: bound) b acc
  _ -> acc

-- | the variables `e` mentions and does not bind, but `bound`
freeVars : List String -> I.Expr -> List String
freeVars bound e = List.reverse (freeGo bound e Nil)

-- A variable replaced (the names in a program are its own: nothing is
-- captured)
--------------------------------------------------------------------------------

replaceGo : String -> I.Expr -> I.Expr -> I.Expr
replaceGo x r e = case e of
  EVar y -> if strEq y x then r else e
  ELam xs b -> ELam xs (replaceGo x r b)
  EApp f as -> EApp (replaceGo x r f) (List.map (replaceGo x r) as)
  ELet y a b -> ELet y (replaceGo x r a) (replaceGo x r b)
  ERecord fs ->
    ERecord (List.map (\f -> MkPair (fst f) (replaceGo x r (snd f))) fs)
  EProj y l sh -> EProj (replaceGo x r y) l sh
  ETag t es -> ETag t (List.map (replaceGo x r) es)
  EMatch y arms ->
    EMatch
      (replaceGo x r y)
      (List.map
         (\arm ->
            MkArm
              (I.armTag arm)
              (I.armVars arm)
              (replaceGo x r (I.armBody arm)))
         arms)
  EPrimCall p es -> EPrimCall p (List.map (replaceGo x r) es)
  ECall k es -> ECall k (List.map (replaceGo x r) es)
  EFix f b -> EFix f (replaceGo x r b)
  _ -> e

-- Lifting
--------------------------------------------------------------------------------

-- | the globals made so far (the last first), and how many
type Acc = { out : List I.Def, n : Int }

type LiftK = { go : I.Def -> Acc -> I.Expr -> Pair I.Expr Acc }

consLifted : I.Expr -> Pair (List I.Expr) Acc -> Pair (List I.Expr) Acc
consLifted x (MkPair xs acc) = MkPair (x :: xs) acc

-- (each of a list, in order)
liftMany : LiftK -> I.Def -> Acc -> List I.Expr -> Pair (List I.Expr) Acc
liftMany k d acc Nil = MkPair Nil acc
liftMany k d acc (x :: xs) = case k.go d acc x of
  MkPair x2 acc2 -> consLifted x2 (liftMany k d acc2 xs)

liftFields : LiftK
           -> I.Def
           -> Acc
           -> List (Pair String I.Expr)
           -> Pair (List (Pair String I.Expr)) Acc
liftFields k d acc fs = case liftMany k d acc (List.map snd fs) of
  MkPair es acc2 -> MkPair (List.zipWith (\f x -> MkPair (fst f) x) fs es) acc2

liftArms : LiftK -> I.Def -> Acc -> List I.Arm -> Pair (List I.Arm) Acc
liftArms k d acc arms = case liftMany k d acc (List.map I.armBody arms) of
  MkPair bs acc2 ->
    MkPair
      (List.zipWith (\arm b -> MkArm (I.armTag arm) (I.armVars arm) b) arms bs)
      acc2

-- | the global a local definition is, given the variables it takes
calledAs : String -> List String -> I.Expr
calledAs key Nil = EGlobal key
calledAs key fvs = EApp (EGlobal key) (List.map (\x -> EVar x) fvs)

-- | its body, taking those variables first
withParams : List String -> I.Expr -> I.Expr
withParams Nil b = b
withParams fvs (ELam xs b) = ELam (I.appendI fvs xs) b
withParams fvs b = ELam fvs b

-- | the global of a local definition `f`, of the definition `d`
liftedDef : I.Def -> Int -> String -> List String -> I.Expr -> I.Def
liftedDef d n f fvs body =
  I.mkDef
    (d.key ^ "." ^ I.baseOf f ^ "$" ^ showInt n)
    (d.name ^ "." ^ I.baseOf f)
    (withParams
       fvs
       (replaceGo
          f
          (calledAs (d.key ^ "." ^ I.baseOf f ^ "$" ^ showInt n) fvs)
          body))

-- (the local definition's global, its own local definitions lifted too)
liftFixDef : LiftK -> Acc -> List String -> I.Def -> Pair I.Expr Acc
liftFixDef k acc fvs ld = case k.go
    ld
    { out = acc.out, n = acc.n + 1 }
    ld.body of
  MkPair b2 acc2 ->
    MkPair
      (calledAs ld.key fvs)
      { out = I.mkDef ld.key ld.name b2 :: acc2.out, n = acc2.n }

liftFix : LiftK -> I.Def -> Acc -> String -> I.Expr -> Pair I.Expr Acc
liftFix k d acc f body =
  liftFixDef
    k
    acc
    (freeVars (f :: Nil) body)
    (liftedDef d acc.n f (freeVars (f :: Nil) body) body)

fixOf : I.Expr -> Maybe (Pair String I.Expr)
fixOf e = case e of
  EFix f b -> Just (MkPair f b)
  _ -> Nothing

-- (`\x -> b`, of one parameter)
oneParam : I.Expr -> Maybe (Pair String I.Expr)
oneParam e = case e of
  ELam xs b -> case xs of
    x :: Nil -> Just (MkPair x b)
    _ -> Nothing
  _ -> Nothing

liftArgs : LiftK -> I.Def -> Acc -> I.Expr -> List I.Expr -> Pair I.Expr Acc
liftArgs k d acc f as = case liftMany k d acc (f :: as) of
  MkPair (f2 :: as2) acc2 -> MkPair (EApp f2 as2) acc2
  MkPair Nil acc2 -> MkPair (EApp f as) acc2

-- (a local definition bound by a beta-redex, as elaboration binds it: its
-- name is its global, given the variables, wherever it is used -- so that
-- what is defined after it takes those variables, not it)
liftRedex : LiftK
          -> I.Def
          -> Acc
          -> String
          -> I.Expr
          -> I.Expr
          -> Pair I.Expr Acc
liftRedex k d acc x b a = case fixOf a of
  Just (MkPair f fb) -> case liftFix k d acc f fb of
    MkPair call acc2 -> k.go d acc2 (replaceGo x call b)
  Nothing -> liftArgs k d acc (ELam [x] b) [a]

liftApp : LiftK -> I.Def -> Acc -> I.Expr -> List I.Expr -> Pair I.Expr Acc
liftApp k d acc f as = case oneParam f of
  Just (MkPair x b) -> case as of
    a :: Nil -> liftRedex k d acc x b a
    _ -> liftArgs k d acc f as
  Nothing -> liftArgs k d acc f as

liftGo : LiftK -> I.Def -> Acc -> I.Expr -> Pair I.Expr Acc
liftGo k d acc e = case e of
  EFix f b -> liftFix k d acc f b
  ELam xs b -> case k.go d acc b of
    MkPair b2 acc2 -> MkPair (ELam xs b2) acc2
  EApp f as -> liftApp k d acc f as
  ELet x a b -> case liftMany k d acc [a, b] of
    MkPair (a2 :: b2 :: Nil) acc2 -> MkPair (ELet x a2 b2) acc2
    MkPair _ acc2 -> MkPair e acc2
  ERecord fs -> case liftFields k d acc fs of
    MkPair fs2 acc2 -> MkPair (ERecord fs2) acc2
  EProj x l sh -> case k.go d acc x of
    MkPair x2 acc2 -> MkPair (EProj x2 l sh) acc2
  ETag t es -> case liftMany k d acc es of
    MkPair es2 acc2 -> MkPair (ETag t es2) acc2
  EMatch x arms -> case k.go d acc x of
    MkPair x2 acc2 -> case liftArms k d acc2 arms of
      MkPair arms2 acc3 -> MkPair (EMatch x2 arms2) acc3
  EPrimCall p es -> case liftMany k d acc es of
    MkPair es2 acc2 -> MkPair (EPrimCall p es2) acc2
  ECall c es -> case liftMany k d acc es of
    MkPair es2 acc2 -> MkPair (ECall c es2) acc2
  _ -> MkPair e acc

lk : LiftK
lk = { go = \d acc e -> liftGo lk d acc e }

-- | a definition, and the globals of its local definitions
liftDef : I.Def -> List I.Def
liftDef d = case lk.go d { out = Nil, n = 0 } d.body of
  MkPair b acc -> I.mkDef d.key d.name b :: List.reverse acc.out

-- | every local definition of the program a global of its own
liftProgram : List I.Def -> List I.Def
liftProgram defs = List.concatMap liftDef defs

