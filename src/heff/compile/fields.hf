-- A record read only field by field, its fields read where it is bound
-- (#116).  A variable of a record never used whole, only read fields of
-- at its shape, keeps the record -- and each field of it -- held until
-- its last read: a field taken out and changed before that, an array
-- set, is held twice there, and copied whole.
--
--   push v x =                          push v x =
--     let s = if v.len == ... then        let s1 = v.slots in let n = v.len in
--       ... else v.slots                  let s = if n == ... then ... else s1
--     in { slots = Array.set s v.len x,   in { slots = Array.set s n x, len = n + 1 }
--          len = v.len + 1 }
--
-- Each field it reads is read where it is bound, once, so the record is
-- given up at the last of those reads -- its other fields' references
-- given back with it -- and what is taken out of it is held alone after
-- (heff.compile.refcount).  Reading a field of a record of a known shape
-- cannot fail, and the record does not change: it is the same read
-- there.  Only where it reads two fields or more, one of them not a
-- number -- what a set may change in place.
--
-- A record also used whole, or updated -- built anew at its shape, a
-- field of it read at its own place (`{ x = p.x + 1, y = p.y }`), built
-- in its cell (heff.compile.refcount) -- has the numbers read of it after
-- that read where it is bound, in the arms reading them of a match there:
-- read after, they would keep it held, and its cell not the one rebuilt
-- (nbody's `pull`: `b.mass` read after the call the updated `b` is given
-- to).  Its fields read at their own places stay, for the update.
--
-- Only the C backend counts references: this runs on what it is given
-- (heff.compile.lower), before the monadic form.

module heff.compile.fields

import heff.compile.ir as IR
import heff.compile.repr as Repr
import heff.compile.supply
import heff.elab.primitive
import std.ordmap as OrdMap

elemS : String -> List String -> Bool
elemS x [] = False
elemS x (y :: ys) = strEq x y || elemS x ys

sameLabels : List String -> List String -> Bool
sameLabels [] [] = True
sameLabels (a :: xs) (b :: ys) = strEq a b && sameLabels xs ys
sameLabels _ _ = False

-- What is read
--------------------------------------------------------------------------------

-- (a field of a record built of the labels `ls`: read from `v`'s at its
-- own place, `v` read at that shape)
keptOf : String -> List String -> Pair String IR.Expr -> Bool
keptOf v ls (MkPair l (EProj (EVar y) l2 sh _)) =
  strEq y v && strEq l l2 && sameLabels ls sh
keptOf v ls _ = False

-- | a field read of the variable: its label, its record's shape, its type
type Read = { l : String, sh : List String, t : IR.FieldTy }

-- (an arm's body, unless it binds `v` again)
armOwn : String -> IR.Arm -> List IR.Expr -> List IR.Expr
armOwn v (MkArm _ vs b) rest = if elemS v vs then rest else b :: rest

-- (the fields of `v` the worklist reads, onto `acc`: none where it uses
-- `v` whole, updates it, or reads it at no shape known; not under a
-- binding of `v` again)
readsW : String -> List Read -> List IR.Expr -> Maybe (List Read)
readsW v acc [] = Just acc
readsW v acc (EProj (EVar y) l sh t :: rest) =
  if not (strEq y v) then readsW v acc rest
  else if List.null sh then Nothing
  else readsW v ({ l = l, sh = sh, t = t } :: acc) rest
readsW v acc (EVar y :: rest) = if strEq y v then Nothing else readsW v acc rest
readsW v acc (ELam xs b :: rest) =
  readsW v acc (if elemS v xs then rest else b :: rest)
readsW v acc (ELet x a b :: rest) =
  readsW v acc (a :: (if strEq x v then rest else b :: rest))
readsW v acc (ERecord fs _ :: rest) =
  if List.any (keptOf v (List.map fst fs)) fs then Nothing
  else readsW v acc (IR.pushFields fs rest)
readsW v acc (EMatch s arms :: rest) =
  readsW v acc (s :: List.foldr (armOwn v) rest arms)
readsW v acc (ESet xs a b :: rest) =
  readsW v acc (a :: (if elemS v xs then rest else b :: rest))
readsW v acc (e :: rest) = readsW v acc (IR.partsOnto e rest)

-- (each label once, in the order first read)
labelsOnce : List Read -> List Read -> List Read
labelsOnce acc [] = List.reverse acc
labelsOnce acc (r :: rs) =
  if List.any (\(q : Read) -> strEq q.l r.l) acc then labelsOnce acc rs
  else labelsOnce (r :: acc) rs

-- (a type whose values a record may keep flat: a number)
number : IR.FieldTy -> Bool
number t = not (Repr.isBoxed (Repr.flatOf t))

-- (each label read once, the reads all of one shape)
oneShape : List Read -> List Read
oneShape [] = Nil
oneShape (r :: rs) =
  if List.all (\(q : Read) -> sameLabels q.sh r.sh) rs
  then labelsOnce Nil (List.reverse (r :: rs))
  else Nil

-- (the fields of `v` to read where it is bound, of those it reads: two
-- or more, one not a number)
toRead : List Read -> List Read
toRead rs =
  let once = oneShape rs
  in if List.length once >= 2
        && List.any (\(q : Read) -> not (number q.t)) once
  then once
  else Nil

-- Numbers read after
--------------------------------------------------------------------------------

-- (the variable an expression reads a number of, at a known shape, onto
-- `acc`)
numberOf : IR.Expr -> List String -> List String
numberOf (EProj (EVar y) _ sh t) acc =
  if number t && not (List.null sh) && not (elemS y acc) then y :: acc
  else acc
numberOf e acc = acc

-- (... the worklist reads)
numbersW : List String -> List IR.Expr -> List String
numbersW acc [] = acc
numbersW acc (e :: rest) = numbersW (numberOf e acc) (IR.partsOnto e rest)

-- | how a variable held for more than its fields is used: the fields
-- | read of it, those read after it is held -- used whole, updated, or
-- | read at no shape known -- how often it is so held, and whether it
-- | is at this point of the walk
type Uses = { reads : List Read, late : List Read, holds : Int, now : Bool }

heldOf : Uses -> Uses
heldOf u = { reads = u.reads, late = u.late, holds = u.holds + 1, now = True }

readOf : Read -> Uses -> Uses
readOf r u =
  { reads = r :: u.reads
  , late = if u.now then r :: u.late else u.late
  , holds = u.holds
  , now = u.now
  }

nowAs : Bool -> Uses -> Uses
nowAs b u = { reads = u.reads, late = u.late, holds = u.holds, now = b }

-- (the fields of a record built of the labels `ls`, but those read from
-- `v`'s at their own places)
unkept : String -> List String -> List (Pair String IR.Expr) -> List IR.Expr
unkept v ls fs = List.map snd (List.keepIf (\f -> not (keptOf v ls f)) fs)

-- (how the worklist uses `v`, onto `u`, in the order it is computed; not
-- under a binding of `v` again.  What a lambda reads is read after: it
-- would be held by the lambda.  Each arm is walked from where its match
-- is.)
usesW : String -> Uses -> List IR.Expr -> Uses
usesW v u [] = u
usesW v u (EProj (EVar y) l sh t :: rest) =
  if not (strEq y v) then usesW v u rest
  else if List.null sh then usesW v (heldOf u) rest
  else usesW v (readOf { l = l, sh = sh, t = t } u) rest
usesW v u (EVar y :: rest) = usesW v (if strEq y v then heldOf u else u) rest
usesW v u (ELam xs b :: rest) =
  if elemS v xs then usesW v u rest
  else let r : Uses = usesW v (nowAs True u) [b]
       in usesW v (nowAs (u.now || r.holds > u.holds) r) rest
usesW v u (ELet x a b :: rest) =
  usesW v u (a :: (if strEq x v then rest else b :: rest))
usesW v u (ERecord fs _ :: rest) =
  let ls = List.map fst fs
  in if List.any (keptOf v ls) fs
  then usesW v (heldOf (usesW v u (unkept v ls fs))) rest
  else usesW v u (IR.pushFields fs rest)
usesW v u (EMatch s arms :: rest) =
  let at : Uses = usesW v u [s]
  in let after : Uses =
    List.foldl
      (\(acc : Uses) arm ->
         let r : Uses = usesW v (nowAs at.now acc) (armOwn v arm Nil)
         in nowAs (acc.now || r.now) r)
      (nowAs False at)
      arms
  in usesW v after rest
usesW v u (ESet xs a b :: rest) =
  usesW v u (a :: (if elemS v xs then rest else b :: rest))
usesW v u (e :: rest) = usesW v u (IR.partsOnto e rest)

-- (whether the label is read after the variable is held, and only as a
-- number)
lateNumber : Uses -> Read -> Bool
lateNumber u q =
  List.all (\(r : Read) -> not (strEq r.l q.l) || number r.t) u.reads
  && List.any (\(r : Read) -> strEq r.l q.l) u.late

-- (the numbers of `v` to read where it is bound, of those read after it
-- is held)
lateRead : Uses -> List Read
lateRead u =
  if List.null u.late then Nil
  else List.keepIf (lateNumber u) (oneShape u.reads)

-- Reads put where it is bound
--------------------------------------------------------------------------------

-- | a field read where the variable is bound, and the variable it is bound to
type Bound = { r : Read, x : String }

boundOf : Read -> S Bound
boundOf r = \n -> case IR.fresh r.l n of
  MkPair x n2 -> MkPair { r = r, x = x } n2

boundAt : List Bound -> String -> Maybe String
boundAt [] l = Nothing
boundAt (b :: bs) l = if strEq b.r.l l then Just b.x else boundAt bs l

-- (`e`, each read of `v` the variable it is bound to; not under a
-- binding of `v` again)
readIn : String -> List Bound -> IR.Expr -> IR.Expr
readIn v bs (EProj (EVar y) l sh t) =
  if strEq y v
  then case boundAt bs l of
    Just x -> EVar x
    Nothing -> EProj (EVar y) l sh t
  else EProj (EVar y) l sh t
readIn v bs (ERecord fs ts) =
  let ls = List.map fst fs
  in ERecord
    (List.map
       (\f -> if keptOf v ls f then f else MkPair (fst f) (readIn v bs (snd f)))
       fs)
    ts
readIn v bs e = IR.mapParts (\xs p -> if elemS v xs then p else readIn v bs p) e

-- (the reads, bound in front of `e`)
letsOf : String -> List Bound -> IR.Expr -> IR.Expr
letsOf v [] e = e
letsOf v (b :: bs) e =
  ELet b.x (EProj (EVar v) b.r.l b.r.sh b.r.t) (letsOf v bs e)

-- (the reads that `e` makes)
usedIn : IR.Expr -> List Bound -> List Bound
usedIn e bs = List.keepIf (\(b : Bound) -> IR.countW b.x 0 [e] > 0) bs

-- (... bound in front of `e`, or where it is a match on neither `v` nor
-- them, in each arm those it makes: not where the match does not go)
placed : String -> List Bound -> IR.Expr -> IR.Expr
placed v bs (EMatch s arms) =
  if IR.countW v 0 [s] == 0 && List.null (usedIn s bs)
  then EMatch s (List.map (IR.mapArm (\_ b -> placed v (usedIn b bs) b)) arms)
  else letsOf v bs (EMatch s arms)
placed v bs e = letsOf v bs e

-- (`b`, where `v` is bound: the fields `rs` read there, in front of it
-- -- or, `held`, in the arms reading them of a match there)
readsBy : Bool -> List Read -> String -> IR.Expr -> S IR.Expr
readsBy held [] v b = pure b
readsBy held rs v b = do
  bs <- traverseS boundOf rs
  pure
      (if held then placed v bs (readIn v bs b)
       else letsOf v bs (readIn v bs b))

-- (`b`, where `v` is bound: the fields it reads read there, if they are)
readAt : IR.Expr -> String -> S IR.Expr
readAt b v = case readsW v Nil [b] of
  Just rs -> readsBy False (toRead rs) v b
  Nothing -> pure b

-- (... where the variables `xs` are bound)
readsAt : List String -> IR.Expr -> S IR.Expr
readsAt [] b = pure b
readsAt (x :: xs) b = do
  b2 <- readAt b x
  readsAt xs b2

-- | an expression, each variable of a record read only field by field
-- | read where it is bound, inner ones first
go : IR.Expr -> S IR.Expr
go e = IR.traverseParts (\xs p -> bind (go p) (readsAt xs)) e

-- (`b`, where `v` is bound, if it is one of `ns`, read as numbers: those
-- read after it is held read there)
lateAt : List String -> IR.Expr -> String -> S IR.Expr
lateAt ns b v =
  if elemS v ns
  then readsBy
      True
      (lateRead
         (usesW v { reads = Nil, late = Nil, holds = 0, now = False } [b]))
      v
      b
  else pure b

latesAt : List String -> List String -> IR.Expr -> S IR.Expr
latesAt ns [] b = pure b
latesAt ns (x :: xs) b = do
  b2 <- lateAt ns b x
  latesAt ns xs b2

-- | an expression, the numbers of each of `ns` held for more read where
-- | it is bound, inner ones first
goLate : List String -> IR.Expr -> S IR.Expr
goLate ns e = IR.traverseParts (\xs p -> bind (goLate ns p) (latesAt ns xs)) e

-- (... where numbers are read)
lateIn : List String -> IR.Expr -> S IR.Expr
lateIn [] e = pure e
lateIn ns e = goLate ns e

defOf : IR.Def -> S IR.Def
defOf d = do
  b <- go d.body
  b2 <- lateIn (numbersW Nil [b]) b
  pure (IR.mkDef d.key d.name b2)

-- | the program, each variable of a record read only field by field read
-- | where it is bound, and the numbers of one held for more read after;
-- | where fresh names go on from
-- | >>> snd (fieldsProgram 0 [IR.mkDef "f" "f" (ELam ["b"] (ELet "c" (ECall "g" [ERecord [MkPair "m" (EProj (EVar "b") "m" ["m"] FtFloat)] [FtFloat]]) (EPrimCall FloatAdd [EVar "c", EProj (EVar "b") "m" ["m"] FtFloat])))])
-- | 1
fieldsProgram : IR.Supply -> List IR.Def -> Pair (List IR.Def) IR.Supply
fieldsProgram n defs = traverseS defOf defs n
