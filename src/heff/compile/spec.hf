-- Specialisation, the parts that compute nothing (`heff.compile.simplify` does
-- the rest): a key that tells known arguments apart (the same for two
-- copies of one value, whatever their binders are named), which
-- parameters a function hands on to itself unchanged, and its calls of
-- itself as calls of a copy given only the others.

module heff.compile.spec

import heff.elab.fixed as Fixed
import heff.compile.ir as IR
import std.map as Map

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

appendS : {a : Type} -> List a -> List a -> List a
appendS Nil ys = ys
appendS (Cons x xs) ys = Cons x (appendS xs ys)

allS : {a : Type} -> (a -> Bool) -> List a -> Bool
allS p Nil = True
allS p (Cons x xs) = p x && allS p xs

-- (an arm's body, its variables bound)
armClosed : (List String -> IR.Expr -> Bool) -> List String -> IR.Arm -> Bool
armClosed go env (MkArm _ vs b) = go (appendS vs env) b

-- | whether every variable it mentions is bound in it or in `env`
-- | >>> closedIn Nil (ELam ["x"] (EVar "y"))
-- | False
closedIn : List String -> IR.Expr -> Bool
closedIn env (EVar x) = elemS x env
closedIn env (ELam xs b) = closedIn (appendS xs env) b
closedIn env (EApp f args) = closedIn env f && allS (closedIn env) args
closedIn env (ELet x a b) = closedIn env a && closedIn (Cons x env) b
closedIn env (ERecord fs _) = allS (closedIn env) (List.map snd fs)
closedIn env (EProj e _ _ _) = closedIn env e
closedIn env (ETag _ args _) = allS (closedIn env) args
closedIn env (EMatch s arms) =
  closedIn env s && allS (armClosed closedIn env) arms
closedIn env (EPrimCall _ args) = allS (closedIn env) args
closedIn env (ECall _ args) = allS (closedIn env) args
closedIn env (EBool c) = allS (closedIn env) (IR.condParts c)
closedIn env (EFix _ _) = False
closedIn env _ = True

-- | whether it computes without calling anything -- primitives, fields,
-- | tags, matches -- and so is little more than the call of its closure
-- | would cost: a lambda that may be given to a copy, the variables it
-- | captures the copy's
-- | >>> callsNothing (ELam ["x"] (EPrimCall "intAdd" [EVar "x", EVar "r"]))
-- | True
-- | >>> callsNothing (ELam ["x"] (EApp (EVar "f") [EVar "x"]))
-- | False
callsNothing : IR.Expr -> Bool
callsNothing (ELam _ b) = callsNothing b
callsNothing (ELet _ a b) = callsNothing a && callsNothing b
callsNothing (ERecord fs _) = allS callsNothing (List.map snd fs)
callsNothing (EProj e _ _ _) = callsNothing e
callsNothing (ETag _ args _) = allS callsNothing args
callsNothing (EMatch s arms) =
  callsNothing s && allS callsNothing (List.map IR.armBody arms)
callsNothing (EPrimCall _ args) = allS callsNothing args
callsNothing (EBool c) = allS callsNothing (IR.condParts c)
callsNothing (EApp _ _) = False
callsNothing (ECall _ _) = False
callsNothing (EFix _ _) = False
callsNothing _ = True

-- | ... or calls a global once, at its end, given what calls nothing: a
-- | partial application made a lambda (`\x -> scale t x`), which costs
-- | what calling its closure would, the call made at once
-- | >>> callsOnce (ELam ["x"] (EApp (EGlobal "g") [EVar "t", EVar "x"]))
-- | True
-- | >>> callsOnce (ELam ["x"] (EApp (EGlobal "g") [EApp (EVar "f") [EVar "x"]]))
-- | False
callsOnce : IR.Expr -> Bool
callsOnce (ELam _ b) = callsOnce b
callsOnce (EApp (EGlobal _) args) = allS callsNothing args
callsOnce _ = False

posGo : String -> List String -> Int -> Int
posGo x Nil i = 0 - 1
posGo x (Cons y ys) i = if strEq x y then i else posGo x ys (i + 1)

keysBy : (IR.Expr -> String) -> List IR.Expr -> String
keysBy go es = joinWith "," (List.map go es)

fieldKey : (IR.Expr -> String) -> Pair String IR.Expr -> String
fieldKey go (MkPair l v) = l ^ "=" ^ go v

armKey : (List String -> IR.Expr -> String) -> List String -> IR.Arm -> String
armKey go env (MkArm t vs b) =
  "|"
  ^ t
  ^ show (List.length vs)
  ^ ":"
  ^ go (appendS (List.reverse vs) env) b

-- (a condition's key, of its expressions' keys)
condKey : (IR.Expr -> String) -> IR.Cond -> String
condKey go CTrue = "T"
condKey go CFalse = "F"
condKey go (CRel p a b) = "R" ^ p ^ "(" ^ go a ^ "," ^ go b ^ ")"
condKey go (CTest e) = "S(" ^ go e ^ ")"
condKey go (CNot c) = "N(" ^ condKey go c ^ ")"
condKey go (CIf a b c) =
  "I(" ^ condKey go a ^ "," ^ condKey go b ^ "," ^ condKey go c ^ ")"

-- (a variable is where it was bound, counted from the nearest binder)
keyGo : List String -> IR.Expr -> String
keyGo env (EVar x) = "v" ^ show (posGo x env 0)
keyGo env (EGlobal g) = "g" ^ g ^ ";"
keyGo env (ELam xs b) =
  "L"
  ^ show (List.length xs)
  ^ "("
  ^ keyGo (appendS (List.reverse xs) env) b
  ^ ")"
keyGo env (EApp f args) =
  "A(" ^ keyGo env f ^ ":" ^ keysBy (keyGo env) args ^ ")"
keyGo env (ELet x a b) = "T(" ^ keyGo env a ^ ":" ^ keyGo (Cons x env) b ^ ")"
keyGo env (ERecord fs ts) =
  "R("
  ^ joinWith "," (List.map (fieldKey (keyGo env)) fs)
  ^ ":"
  ^ joinWith "," (List.map IR.fieldTyName ts)
  ^ ")"
keyGo env (EProj e l sh t) =
  "P("
  ^ keyGo env e
  ^ "."
  ^ l
  ^ "/"
  ^ joinWith "," sh
  ^ ":"
  ^ IR.fieldTyName t
  ^ ")"
keyGo env (ETag t args _) = "C" ^ t ^ "(" ^ keysBy (keyGo env) args ^ ")"
keyGo env (EMatch s arms) =
  "M(" ^ keyGo env s ^ joinWith "" (List.map (armKey keyGo env) arms) ^ ")"
keyGo env (EPrim p) = "p" ^ p ^ ";"
keyGo env (EPrimCall p args) = "Q" ^ p ^ "(" ^ keysBy (keyGo env) args ^ ")"
keyGo env (ECall g args) = "K" ^ g ^ "(" ^ keysBy (keyGo env) args ^ ")"
keyGo env (EInt i) = "i" ^ show i
keyGo env (EFloat x) = "f" ^ show x
keyGo env (EStr s) = "s" ^ show (strLength s) ^ ":" ^ s
keyGo env (EBytes s) = "b" ^ show (strLength s) ^ ":" ^ s
keyGo env (EFixed w n) = "x" ^ Fixed.showFixed w ^ ":" ^ show n
keyGo env (EFloat32 x) = "y" ^ show x
keyGo env EAbandon = "X"
keyGo env (EFix _ _) = "F"
keyGo env (EBool c) = "o(" ^ condKey (keyGo env) c ^ ")"

-- | a closed value's key: alike for two copies of it
-- | >>> strEq (key (ELam ["x"] (EVar "x"))) (key (ELam ["y"] (EVar "y")))
-- | True
key : IR.Expr -> String
key e = keyGo Nil e

-- | the key of a value closed but for `vars` (the last bound nearest):
-- | where each of them is used tells two values apart
-- | >>> strEq (keyIn ["a", "b"] (EVar "a")) (keyIn ["a", "b"] (EVar "b"))
-- | False
keyIn : List String -> IR.Expr -> String
keyIn vars e = keyGo (List.reverse vars) e

-- (two polynomial hashes, each modulo a prime below 2^31)
hashGo : String -> Int -> Int -> Int -> String
hashGo s i a b =
  if i >= strLength s then show a ^ "x" ^ show b
  else hashGo
      s
      (i + 1)
      ((a * 1000003 + byteAt s i + 1) % 2147483647)
      ((b * 999983 + byteAt s i + 1) % 2147483629)

-- | a short name for a text: a hash of it
hashText : String -> String
hashText s = hashGo s 0 5381 7919

-- (the definition a copy is of: its name up to the first copy's mark)
rootAt : String -> Maybe Int -> String
rootAt g (Just i) = strSlice g 0 i
rootAt g Nothing = g

rootOf : String -> String
rootOf g = rootAt g (indexOf "$s" g)

-- | a copy's name: by what it is made for -- the definition and its
-- | key -- not by how many were made before it, nor by who made it
-- | first, so that a copy is named alike in every program, and a name
-- | is one copy
copyName : String -> String -> String
copyName g k = rootOf g ^ "$s" ^ hashText k

-- Shapes: what a copy is made for
--------------------------------------------------------------------------------

-- A copy is made for what its known arguments are, not for the numbers
-- and texts written in them, nor for what their binders are called: a
-- literal in a known argument is a parameter of the copy, given it
-- where the copy is called, and every binder is named alike (`a`).  So
-- is a variable a known lambda captures (`\x -> x * x + r`), once
-- however often it is used: the copy is given `r`, not a closure.  So
-- arguments alike but for those are given one copy, the same whoever
-- asks for it first; and a copy for a number that grows each time one
-- is asked for (`{ indent = c.indent + 2 }`) is the same copy, not one
-- more for each number.

-- | shaping, so far: the binders in scope renamed, the variables
-- | captured and the literals taken out (the last first, each a variable
-- | of `vars`; a variable captured, by `caps` too), the names drawn
type ShapeSt =
  { ren : Map.Map String String
  , caps : Map.Map String String
  , vars : List String
  , holes : List IR.Expr
  , n : Int
  }

-- | a known argument as the copy has it (`e`), its literals variables
-- | (`vars`) given `holes` where it is called; names drawn up to `n`
type Shaped = { e : IR.Expr, vars : List String, holes : List IR.Expr, n : Int }

type ShapeGo = IR.Expr -> ShapeSt -> Pair IR.Expr ShapeSt

-- (a literal taken out, a variable in its place)
holeOf : IR.Expr -> ShapeSt -> Pair IR.Expr ShapeSt
holeOf lit st =
  MkPair
    (EVar ("lit$" ^ show st.n))
    { ren = st.ren
    , caps = st.caps
    , vars = Cons ("lit$" ^ show st.n) st.vars
    , holes = Cons lit st.holes
    , n = st.n + 1
    }

-- (a binder named `a`, afresh)
bindOne : Pair (List String) ShapeSt -> String -> Pair (List String) ShapeSt
bindOne (MkPair xs st) x =
  MkPair
    (Cons ("a$" ^ show st.n) xs)
    { ren = Map.insert st.ren x ("a$" ^ show st.n)
    , caps = st.caps
    , vars = st.vars
    , holes = st.holes
    , n = st.n + 1
    }

bindAll : List String -> ShapeSt -> Pair (List String) ShapeSt
bindAll xs st = case List.foldl bindOne (MkPair Nil st) xs of
  MkPair ys st2 -> MkPair (List.reverse ys) st2

-- (a variable captured, taken out the first time it is seen)
capOf : String -> ShapeSt -> Pair IR.Expr ShapeSt
capOf x st =
  MkPair
    (EVar ("lit$" ^ show st.n))
    { ren = st.ren
    , caps = Map.insert st.caps x ("lit$" ^ show st.n)
    , vars = Cons ("lit$" ^ show st.n) st.vars
    , holes = Cons (EVar x) st.holes
    , n = st.n + 1
    }

-- (a variable: bound in the value, renamed; captured, its hole)
varIn : String
      -> ShapeSt
      -> Maybe String
      -> Maybe String
      -> Pair IR.Expr ShapeSt
varIn x st (Just y) _ = MkPair (EVar y) st
varIn x st Nothing (Just h) = MkPair (EVar h) st
varIn x st Nothing Nothing = capOf x st

-- (out of a binding's scope: its binders as they were before it)
unbound : Map.Map String String -> Pair IR.Expr ShapeSt -> Pair IR.Expr ShapeSt
unbound ren (MkPair e st) =
  MkPair
    e
    { ren = ren, caps = st.caps, vars = st.vars, holes = st.holes, n = st.n }

withFst : (IR.Expr -> IR.Expr) -> Pair IR.Expr ShapeSt -> Pair IR.Expr ShapeSt
withFst f (MkPair e st) = MkPair (f e) st

manyTo : (List IR.Expr -> IR.Expr)
       -> Pair (List IR.Expr) ShapeSt
       -> Pair IR.Expr ShapeSt
manyTo f (MkPair es st) = MkPair (f es) st

consShaped : IR.Expr
           -> Pair (List IR.Expr) ShapeSt
           -> Pair (List IR.Expr) ShapeSt
consShaped e (MkPair es st) = MkPair (Cons e es) st

-- (`e` shaped, then the rest after it)
manyThen : (ShapeSt -> Pair (List IR.Expr) ShapeSt)
         -> Pair IR.Expr ShapeSt
         -> Pair (List IR.Expr) ShapeSt
manyThen more (MkPair e st) = consShaped e (more st)

shapeMany : ShapeGo -> List IR.Expr -> ShapeSt -> Pair (List IR.Expr) ShapeSt
shapeMany go Nil st = MkPair Nil st
shapeMany go (Cons e rest) st = manyThen (shapeMany go rest) (go e st)

-- (a binding's body, its binders renamed)
boundThen : ShapeGo
          -> IR.Expr
          -> (List String -> IR.Expr -> IR.Expr)
          -> Map.Map String String
          -> Pair (List String) ShapeSt
          -> Pair IR.Expr ShapeSt
boundThen go b f ren (MkPair ys st) = withFst (f ys) (unbound ren (go b st))

-- (an application's head, then its arguments)
appThen : ShapeGo
        -> List IR.Expr
        -> Pair IR.Expr ShapeSt
        -> Pair IR.Expr ShapeSt
appThen go args (MkPair f st) = manyTo (\es -> EApp f es) (shapeMany go args st)

-- (the name a binder was given)
oneName : String -> List String -> String
oneName x (Cons y _) = y
oneName x Nil = x

-- (a binding's value, then its body)
letThen : ShapeGo
        -> String
        -> IR.Expr
        -> Pair IR.Expr ShapeSt
        -> Pair IR.Expr ShapeSt
letThen go x b (MkPair a st) =
  boundThen go b (\ys b2 -> ELet (oneName x ys) a b2) st.ren (bindAll [x] st)

labelsTo : List (Pair String IR.Expr)
         -> List IR.Expr
         -> List (Pair String IR.Expr)
labelsTo (Cons (MkPair l _) fs) (Cons e es) = Cons (MkPair l e) (labelsTo fs es)
labelsTo _ _ = Nil

consArm : IR.Arm -> Pair (List IR.Arm) ShapeSt -> Pair (List IR.Arm) ShapeSt
consArm a (MkPair args st) = MkPair (Cons a args) st

-- (an arm, its binders renamed, then the arms after it)
armThen : (ShapeSt -> Pair (List IR.Arm) ShapeSt)
        -> String
        -> Pair (List String) (Pair IR.Expr ShapeSt)
        -> Pair (List IR.Arm) ShapeSt
armThen more t (MkPair vs (MkPair b st)) = consArm (MkArm t vs b) (more st)

armBound : ShapeGo
         -> IR.Expr
         -> Map.Map String String
         -> Pair (List String) ShapeSt
         -> Pair (List String) (Pair IR.Expr ShapeSt)
armBound go b ren (MkPair vs st) = MkPair vs (unbound ren (go b st))

shapeArms : ShapeGo -> List IR.Arm -> ShapeSt -> Pair (List IR.Arm) ShapeSt
shapeArms go Nil st = MkPair Nil st
shapeArms go (Cons (MkArm t vs b) rest) st =
  armThen (shapeArms go rest) t (armBound go b st.ren (bindAll vs st))

matchThen : ShapeGo
          -> List IR.Arm
          -> Pair IR.Expr ShapeSt
          -> Pair IR.Expr ShapeSt
matchThen go arms (MkPair sc st) = case shapeArms go arms st of
  MkPair arms2 st2 -> MkPair (EMatch sc arms2) st2

withShapedC : {a : Type}
            -> Pair IR.Cond ShapeSt
            -> (IR.Cond -> ShapeSt -> a)
            -> a
withShapedC (MkPair c st) k = k c st

-- (a condition shaped, its expressions in order)
shapeCond : ShapeGo -> IR.Cond -> ShapeSt -> Pair IR.Cond ShapeSt
shapeCond go CTrue st = MkPair CTrue st
shapeCond go CFalse st = MkPair CFalse st
shapeCond go (CRel p a b) st = case go a st of
  MkPair a2 st1 -> case go b st1 of
    MkPair b2 st2 -> MkPair (CRel p a2 b2) st2
shapeCond go (CTest e) st = case go e st of
  MkPair e2 st1 -> MkPair (CTest e2) st1
shapeCond go (CNot c) st =
  withShapedC (shapeCond go c st) (\c2 st1 -> MkPair (CNot c2) st1)
shapeCond go (CIf a b c) st =
  withShapedC
    (shapeCond go a st)
    (\a2 st1 ->
       withShapedC
         (shapeCond go b st1)
         (\b2 st2 ->
            withShapedC
              (shapeCond go c st2)
              (\c2 st3 -> MkPair (CIf a2 b2 c2) st3)))

shapeGo : IR.Expr -> ShapeSt -> Pair IR.Expr ShapeSt
shapeGo (EVar x) st =
  varIn
    x
    st
    (Map.lookup st.ren x)
    (Map.lookup st.caps x)
shapeGo (EInt i) st = holeOf (EInt i) st
shapeGo (EFloat x) st = holeOf (EFloat x) st
shapeGo (EStr t) st = holeOf (EStr t) st
shapeGo (ELam xs b) st =
  boundThen shapeGo b (\ys b2 -> ELam ys b2) st.ren (bindAll xs st)
shapeGo (EApp f args) st = appThen shapeGo args (shapeGo f st)
shapeGo (ELet x a b) st = letThen shapeGo x b (shapeGo a st)
shapeGo (ERecord fs ts) st =
  manyTo
    (\es -> ERecord (labelsTo fs es) ts)
    (shapeMany shapeGo (List.map snd fs) st)
shapeGo (EProj e l sh t) st = withFst (\e2 -> EProj e2 l sh t) (shapeGo e st)
shapeGo (ETag t args ts) st =
  manyTo (\es -> ETag t es ts) (shapeMany shapeGo args st)
shapeGo (EMatch sc arms) st = matchThen shapeGo arms (shapeGo sc st)
shapeGo (EPrimCall p args) st =
  manyTo (\es -> EPrimCall p es) (shapeMany shapeGo args st)
shapeGo (ECall g args) st =
  manyTo (\es -> ECall g es) (shapeMany shapeGo args st)
shapeGo (EBool c) st =
  withShapedC (shapeCond shapeGo c st) (\c2 st1 -> MkPair (EBool c2) st1)
shapeGo e st = MkPair e st

shapedOf : Pair IR.Expr ShapeSt -> Shaped
shapedOf (MkPair e st) =
  { e = e
  , vars = List.reverse st.vars
  , holes = List.reverse st.holes
  , n = st.n
  }

-- | a known argument shaped, the names it is given drawn from `n` on
-- | >>> (shapeOf 0 (ELam ["x"] (EPrimCall "intAdd" [EVar "x", EInt 1]))).e
-- | ELam (Cons "a$0" Nil) (EPrimCall "intAdd" (Cons (EVar "a$0") (Cons (EVar "lit$1") Nil)))
-- | >>> strEq (key (shapeOf 0 (ELam ["x"] (EInt 1))).e) (key (shapeOf 7 (ELam ["y"] (EInt 2))).e)
-- | True
-- | >>> (shapeOf 0 (ELam ["x"] (EPrimCall "intAdd" [EVar "r", EVar "r"]))).holes
-- | [EVar "r"]
shapeOf : Int -> IR.Expr -> Shaped
shapeOf n e =
  shapedOf
    (shapeGo
       e
       { ren = Map.empty, caps = Map.empty, vars = Nil, holes = Nil, n = n })

-- Calls of itself
--------------------------------------------------------------------------------

type Use = Maybe (List IR.Expr)

-- (an application's head: a call of `g`, given `as`)
callUse : String -> IR.Expr -> List IR.Expr -> List Use
callUse g (EGlobal h) args = if strEq h g then Cons (Just args) Nil else Nil
callUse g _ args = Nil

-- (... and the uses in it, unless it is a global, called)
headUses : (IR.Expr -> List Use) -> IR.Expr -> List Use
headUses go (EGlobal _) = Nil
headUses go f = go f

-- | each use of the global `g`: the arguments of a call of it, or
-- | `Nothing` where it is not called (a value, handed on)
usesOf : String -> IR.Expr -> List Use
usesOf g (EGlobal h) = if strEq h g then Cons Nothing Nil else Nil
usesOf g (EApp f args) =
  appendS
    (callUse g f args)
    (appendS (headUses (usesOf g) f) (List.concatMap (usesOf g) args))
usesOf g (ELam _ b) = usesOf g b
usesOf g (ELet _ a b) = appendS (usesOf g a) (usesOf g b)
usesOf g (ERecord fs _) = List.concatMap (usesOf g) (List.map snd fs)
usesOf g (EProj e _ _ _) = usesOf g e
usesOf g (ETag _ args _) = List.concatMap (usesOf g) args
usesOf g (EMatch s arms) =
  appendS (usesOf g s) (List.concatMap (usesOf g) (List.map IR.armBody arms))
usesOf g (EPrimCall _ args) = List.concatMap (usesOf g) args
usesOf g (EBool c) = List.concatMap (usesOf g) (IR.condParts c)
usesOf g (ECall h args) =
  appendS (callUse g (EGlobal h) args) (List.concatMap (usesOf g) args)
usesOf g _ = Nil

nthS : {a : Type} -> Int -> List a -> Maybe a
nthS i Nil = Nothing
nthS i (Cons x xs) = if i == 0 then Just x else nthS (i - 1) xs

isVarOf : String -> Maybe IR.Expr -> Bool
isVarOf x (Just (EVar y)) = strEq x y
isVarOf x _ = False

handsOn : String -> Int -> Use -> Bool
handsOn x i (Just args) = isVarOf x (nthS i args)
handsOn x i Nothing = False

staticGo : List Use -> List String -> Int -> List Bool
staticGo uses Nil i = Nil
staticGo uses (Cons x xs) i =
  Cons (allS (handsOn x i) uses) (staticGo uses xs (i + 1))

-- | for each parameter of `g` (`\xs -> b`), whether every call of itself
-- | hands it on as it is: a copy for a known argument there is a copy
-- | for every round
-- | >>> statics "f" ["a", "n"] (EApp (EGlobal "f") [EVar "a", EPrimCall "intSub" [EVar "n", EInt 1]])
-- | [True, False]
statics : String -> List String -> IR.Expr -> List Bool
statics g xs b = staticGo (usesOf g b) xs 0

-- | the arguments but those at the positions marked
dropAt : List Bool -> List IR.Expr -> List IR.Expr
dropAt Nil args = args
dropAt (Cons d ds) Nil = Nil
dropAt (Cons d ds) (Cons a args) =
  if d then dropAt ds args else Cons a (dropAt ds args)

-- (an application's head, `g` made `h`; any other, gone through)
selfHead : (IR.Expr -> IR.Expr) -> String -> String -> IR.Expr -> IR.Expr
selfHead go g h (EGlobal k) = EGlobal (if strEq k g then h else k)
selfHead go g h f = go f

-- (... and its arguments, the marked ones left out of a call of `g`,
-- `pre` before the others)
selfArgs : String
         -> List IR.Expr
         -> List Bool
         -> IR.Expr
         -> List IR.Expr
         -> List IR.Expr
selfArgs g pre ds (EGlobal k) args =
  if strEq k g then appendS pre (dropAt ds args) else args
selfArgs g pre ds f args = args

selfField : (IR.Expr -> IR.Expr) -> Pair String IR.Expr -> Pair String IR.Expr
selfField go (MkPair l v) = MkPair l (go v)

selfArm : (IR.Expr -> IR.Expr) -> IR.Arm -> IR.Arm
selfArm go (MkArm t vs b) = MkArm t vs (go b)

-- | the calls of `g` as calls of `h`, the marked arguments left out
-- | and `pre` given first (the literals of a copy's known arguments)
-- | >>> selfTo "f" "f$s0" Nil [True, False] (EApp (EGlobal "f") [EVar "a", EApp (EGlobal "f") [EVar "a", EVar "n"]])
-- | EApp (EGlobal "f$s0") [EApp (EGlobal "f$s0") [EVar "n"]]
selfTo : String -> String -> List IR.Expr -> List Bool -> IR.Expr -> IR.Expr
selfTo g h pre ds (EApp f args) =
  EApp
    (selfHead (selfTo g h pre ds) g h f)
    (List.map (selfTo g h pre ds) (selfArgs g pre ds f args))
selfTo g h pre ds (ELam xs b) = ELam xs (selfTo g h pre ds b)
selfTo g h pre ds (ELet x a b) =
  ELet x (selfTo g h pre ds a) (selfTo g h pre ds b)
selfTo g h pre ds (ERecord fs ts) =
  ERecord (List.map (selfField (selfTo g h pre ds)) fs) ts
selfTo g h pre ds (EProj e l sh t) = EProj (selfTo g h pre ds e) l sh t
selfTo g h pre ds (ETag t args ts) =
  ETag t (List.map (selfTo g h pre ds) args) ts
selfTo g h pre ds (EMatch s arms) =
  EMatch (selfTo g h pre ds s) (List.map (selfArm (selfTo g h pre ds)) arms)
selfTo g h pre ds (EPrimCall p args) =
  EPrimCall p (List.map (selfTo g h pre ds) args)
selfTo g h pre ds (ECall k args) = ECall k (List.map (selfTo g h pre ds) args)
selfTo g h pre ds (EBool c) = EBool (IR.condMap (selfTo g h pre ds) c)
selfTo g h pre ds e = e
