-- Fields read early.  A body that rebuilds a record, or gives it away,
-- before a call (`{ x = b.x, vx = ..., mass = b.mass }` handed to it),
-- and after the call reads only numbers of it (`b.mass`, flat, #39), has
-- those read before: so the record is wanted no longer after the call,
-- and its cell is the one rebuilt (heff.compile.refcount, "Records
-- updated"), not kept across the call while a new one is made.  Reading
-- a number of a record cannot fail, and the record does not change, so
-- it is the same read earlier.
--
-- This runs on what is lowered (heff.compile.lower), each call at its
-- arity, for both backends.

module heff.compile.early

import heff.compile.ir as IR
import heff.compile.repr as Repr

-- | computations drawing fresh names
type S a = Int -> Pair a Int

bindTake : {a b : Type} -> (a -> S b) -> Pair a Int -> Pair b Int
bindTake f (MkPair x n) = f x n

-- `do` is this
bind : {a b : Type} -> S a -> (a -> S b) -> S b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> S a
pure x = \n -> MkPair x n

instance instanceMonadS : Monad S
instanceMonadS = { pure = pure, bind = bind }

traverseS : {a b : Type} -> (a -> S b) -> List a -> S (List b)
traverseS = traverse (mo := instanceMonadS)

elemE : String -> List String -> Bool
elemE x Nil = False
elemE x (Cons y ys) = strEq x y || elemE x ys

sameLabels : List String -> List String -> Bool
sameLabels Nil Nil = True
sameLabels (Cons a as) (Cons b bs) = strEq a b && sameLabels as bs
sameLabels _ _ = False

-- (a type whose values a record may keep flat: a number)
numberTy : IR.FieldTy -> Bool
numberTy t = not (Repr.isBoxed (Repr.flatOf t))

-- What is looked at
--------------------------------------------------------------------------------

-- (what is in an expression, in front of `rest`: in a lambda too, if
-- `lams`)
pushKids : Bool -> IR.Expr -> List IR.Expr -> List IR.Expr
pushKids lams (ELam _ b) rest = if lams then Cons b rest else rest
pushKids lams (EApp f as) rest = Cons f (IR.appendI as rest)
pushKids lams (ELet _ a b) rest = Cons a (Cons b rest)
pushKids lams (ERecord fs _) rest = IR.pushFields fs rest
pushKids lams (EProj e _ _ _) rest = Cons e rest
pushKids lams (ETag _ as _) rest = IR.appendI as rest
pushKids lams (EMatch s arms) rest = Cons s (IR.pushArms arms rest)
pushKids lams (EPrimCall _ as) rest = IR.appendI as rest
pushKids lams (ECall _ as) rest = IR.appendI as rest
pushKids lams _ rest = rest

isCall : IR.Expr -> Bool
isCall (EApp _ _) = True
isCall (ECall _ _) = True
isCall _ = False

-- (whether the worklist calls a function, but in a lambda)
callsW : List IR.Expr -> Bool
callsW Nil = False
callsW (Cons e rest) = isCall e || callsW (pushKids False e rest)

-- | a field read of a variable's record, of a shape known (none: not
-- | known)
type Read = { v : String, l : String, sh : List String, t : IR.FieldTy }

-- (an expression that reads a field of a variable)
varRead : String -> IR.Expr -> Maybe Read
varRead l (EVar v) = Just { v = v, l = l, sh = Nil, t = FtAny }
varRead l e = Nothing

withField : List String -> IR.FieldTy -> Maybe Read -> Maybe Read
withField sh t (Just r) = Just { v = r.v, l = r.l, sh = sh, t = t }
withField sh t Nothing = Nothing

readOfE : IR.Expr -> Maybe Read
readOfE (EProj e l sh t) = withField sh t (varRead l e)
readOfE e = Nothing

isNumber : Maybe Read -> Bool
isNumber (Just r) = numberTy r.t && not (List.null r.sh)
isNumber Nothing = False

numberRead : Maybe Read -> List Read -> List Read
numberRead (Just r) acc = if isNumber (Just r) then Cons r acc else acc
numberRead Nothing acc = acc

-- (whether the worklist reads a number of a variable's record: where
-- none does, nothing is read early, and nothing more is looked at)
numbersW : List IR.Expr -> Bool
numbersW Nil = False
numbersW (Cons e rest) = isNumber (readOfE e) || numbersW (pushKids True e rest)

-- (the numbers read of variables in the worklist, each time)
readsW : List Read -> List IR.Expr -> List Read
readsW acc Nil = acc
readsW acc (Cons e rest) =
  readsW (numberRead (readOfE e) acc) (pushKids True e rest)

readOfVar : String -> Maybe Read -> Bool
readOfVar x (Just r) = strEq x r.v
readOfVar x Nothing = False

-- (how many fields of `x` the worklist reads, whatever they are)
projW : String -> Int -> List IR.Expr -> Int
projW x n Nil = n
projW x n (Cons e rest) =
  projW x (if readOfVar x (readOfE e) then n + 1 else n) (pushKids True e rest)

-- (... of `x`, at its own place of a record of the labels `ls`)
ownRead : String -> List String -> String -> Maybe Read -> Bool
ownRead x ls l (Just r) = strEq x r.v && strEq l r.l && sameLabels ls r.sh
ownRead x ls l Nothing = False

ownField : String -> List String -> Pair String IR.Expr -> Bool
ownField x ls (MkPair l e) = ownRead x ls l (readOfE e)

-- (a record of `x`'s shape with a field of `x` at its own place: one
-- that may be built in `x`'s cell)
rebuilds : String -> IR.Expr -> Bool
rebuilds x (ERecord fs _) = List.any (ownField x (List.map fst fs)) fs
rebuilds x e = False

-- (whether the worklist rebuilds `x`)
rebuiltW : String -> List IR.Expr -> Bool
rebuiltW x Nil = False
rebuiltW x (Cons e rest) = rebuilds x e || rebuiltW x (pushKids True e rest)

-- | whether `x`'s numbers read `after` are read early: `x` is only read
-- | so there, and rebuilt or given away (used but to read a field)
-- | `before`, and is not bound among `bound`
readsEarly : List String
           -> List IR.Expr
           -> List IR.Expr
           -> List Read
           -> String
           -> Bool
readsEarly bound before after rs x =
  not (elemE x bound)
  && IR.countW x 0 after
  == List.length (List.filter (\(r : Read) -> strEq r.v x) rs)
  && (rebuiltW x before || IR.countW x 0 before > projW x 0 before)

-- (each read once: its variable and label)
readsOnce : List Read -> List Read -> List Read
readsOnce acc Nil = List.reverse acc
readsOnce acc (Cons r rs) =
  if List.any (\(q : Read) -> strEq q.v r.v && strEq q.l r.l) acc
  then readsOnce acc rs
  else readsOnce (Cons r acc) rs

-- (the reads made early, of the reads `after`)
earlyReads : List String -> List IR.Expr -> List IR.Expr -> List Read
earlyReads bound before after =
  let rs = readsW Nil after
  in readsOnce
    Nil
    (List.filter (\(r : Read) -> readsEarly bound before after rs r.v) rs)

-- Reads put early
--------------------------------------------------------------------------------

-- | a read made early, and the variable it is bound to
type Early = { r : Read, x : String }

earlyOf : Read -> S Early
earlyOf r = \n -> case IR.fresh r.l n of
  MkPair x n2 -> MkPair { r = r, x = x } n2

-- (the variable a read is bound to, if it is made early)
earlyAt : List Early -> String -> String -> Maybe String
earlyAt Nil v l = Nothing
earlyAt (Cons e es) v l =
  if strEq e.r.v v && strEq e.r.l l then Just e.x else earlyAt es v l

-- (... those not of the variables bound again)
unbound : List String -> List Early -> List Early
unbound xs es = List.filter (\(e : Early) -> not (elemE e.r.v xs)) es

projRead : List Early
         -> IR.Expr
         -> String
         -> List String
         -> IR.FieldTy
         -> IR.Expr
projRead es (EVar v) l sh t = case earlyAt es v l of
  Just x -> EVar x
  Nothing -> EProj (EVar v) l sh t
projRead es e l sh t = EProj e l sh t

-- (an arm, its reads made early but of the variables it binds)
armRead : (List Early -> IR.Expr -> IR.Expr) -> List Early -> IR.Arm -> IR.Arm
armRead go es (MkArm t vs b) = MkArm t vs (go (unbound vs es) b)

readGo : List Early -> IR.Expr -> IR.Expr
readGo es (EProj e l sh t) = projRead es (readGo es e) l sh t
readGo es (ELam xs b) = ELam xs (readGo (unbound xs es) b)
readGo es (EApp f as) = EApp (readGo es f) (List.map (readGo es) as)
readGo es (ELet x a b) = ELet x (readGo es a) (readGo (unbound [x] es) b)
readGo es (ERecord fs ts) =
  ERecord (List.map (\p -> MkPair (fst p) (readGo es (snd p))) fs) ts
readGo es (ETag t as ts) = ETag t (List.map (readGo es) as) ts
readGo es (EMatch s arms) =
  EMatch (readGo es s) (List.map (armRead readGo es) arms)
readGo es (EPrimCall p as) = EPrimCall p (List.map (readGo es) as)
readGo es (ECall g as) = ECall g (List.map (readGo es) as)
readGo es e = e

-- | the reads made early, each the variable it is bound to
readIn : List Early -> IR.Expr -> IR.Expr
readIn es e = if List.null es then e else readGo es e

-- (the reads made early, bound in front of `e`)
letsEarly : List Early -> IR.Expr -> IR.Expr
letsEarly Nil e = e
letsEarly (Cons x xs) e =
  ELet x.x (EProj (EVar x.r.v) x.r.l x.r.sh x.r.t) (letsEarly xs e)

-- A body's spine: its bindings, in order, and what it comes to

type Bind = Pair String IR.Expr

consBind : String
         -> IR.Expr
         -> Pair (List Bind) IR.Expr
         -> Pair (List Bind) IR.Expr
consBind x a (MkPair bs e) = MkPair (Cons (MkPair x a) bs) e

spineOf : IR.Expr -> Pair (List Bind) IR.Expr
spineOf (ELet x a b) = consBind x a (spineOf b)
spineOf e = MkPair Nil e

letsOf : List Bind -> IR.Expr -> IR.Expr
letsOf Nil e = e
letsOf (Cons (MkPair x a) bs) e = ELet x a (letsOf bs e)

-- | the bindings before the first that calls, and from it on
type Cut = { before : List Bind, from : List Bind }

cutGo : List Bind -> List Bind -> Cut
cutGo acc Nil = { before = List.reverse acc, from = Nil }
cutGo acc (Cons b bs) =
  if callsW [snd b] then { before = List.reverse acc, from = Cons b bs }
  else cutGo (Cons b acc) bs

-- (a binding, its reads made early)
bindRead : List Early -> Bind -> Bind
bindRead es (MkPair x a) = MkPair x (readIn es a)

-- (a binding that calls, `call`, the reads after it made early)
atBinding : List Bind -> Bind -> List Bind -> IR.Expr -> S IR.Expr
atBinding before call after last = do
  es <-
    traverseS
      earlyOf
      (earlyReads
         (List.map fst (List.append before (Cons call after)))
         (List.map snd (List.append before [call]))
         (List.append (List.map snd after) [last]))
  pure
      (letsEarly
         es
         (letsOf
            (List.append before (Cons call (List.map (bindRead es) after)))
            (readIn es last)))

-- (a match on what calls, `s`, the reads in its arms made early)
atMatch : List Bind -> IR.Expr -> List IR.Arm -> S IR.Expr
atMatch before s arms = do
  es <-
    traverseS
      earlyOf
      (earlyReads
         (List.append (List.map fst before) (List.concatMap IR.armVars arms))
         (List.append (List.map snd before) [s])
         (List.map IR.armBody arms))
  pure
      (letsEarly
         es
         (letsOf before (EMatch s (List.map (armRead readIn es) arms))))

-- (the spine cut at its first call: the bindings before it, from it on,
-- and what it comes to)
atEnd : List Bind -> IR.Expr -> S IR.Expr
atEnd before (EMatch s arms) =
  if callsW [s] then atMatch before s arms
  else pure (letsOf before (EMatch s arms))
atEnd before last = pure (letsOf before last)

atFrom : List Bind -> List Bind -> IR.Expr -> S IR.Expr
atFrom before (Cons call after) last = atBinding before call after last
atFrom before Nil last = atEnd before last

atCut : Cut -> IR.Expr -> S IR.Expr
atCut c last = atFrom c.before c.from last

-- | a body, its reads after its first call made early where they may be
readEarly : IR.Expr -> S IR.Expr
readEarly e = case spineOf e of
  MkPair bs last -> atCut (cutGo Nil bs) last

-- The walk
--------------------------------------------------------------------------------

-- (what is walked of an expression: `go`, given whether a body begins
-- there, its spine to be cut)
type Walk = Bool -> IR.Expr -> S IR.Expr

armWith : Walk -> IR.Arm -> S IR.Arm
armWith go (MkArm t vs b) = do
  b2 <- go True b
  pure (MkArm t vs b2)

fieldWith : Walk -> Pair String IR.Expr -> S (Pair String IR.Expr)
fieldWith go (MkPair l e) = do
  e2 <- go True e
  pure (MkPair l e2)

-- (what is in an expression walked: a binding's body on in its spine)
kidsWith : Walk -> IR.Expr -> S IR.Expr
kidsWith go (ELam xs b) = do
  b2 <- go True b
  pure (ELam xs b2)
kidsWith go (EApp f as) = do
  f2 <- go True f
  as2 <- traverseS (go True) as
  pure (EApp f2 as2)
kidsWith go (ELet x a b) = do
  a2 <- go True a
  b2 <- go False b
  pure (ELet x a2 b2)
kidsWith go (ERecord fs ts) = do
  fs2 <- traverseS (fieldWith go) fs
  pure (ERecord fs2 ts)
kidsWith go (EProj e l sh t) = do
  e2 <- go True e
  pure (EProj e2 l sh t)
kidsWith go (ETag t as ts) = do
  as2 <- traverseS (go True) as
  pure (ETag t as2 ts)
kidsWith go (EMatch s arms) = do
  s2 <- go True s
  arms2 <- traverseS (armWith go) arms
  pure (EMatch s2 arms2)
kidsWith go (EPrimCall p as) = do
  as2 <- traverseS (go True) as
  pure (EPrimCall p as2)
kidsWith go (ECall g as) = do
  as2 <- traverseS (go True) as
  pure (ECall g as2)
kidsWith go e = pure e

-- (a body's spine: bindings, or a match)
spined : IR.Expr -> Bool
spined (ELet _ _ _) = True
spined (EMatch _ _) = True
spined _ = False

-- | an expression walked, each body's reads after its first call made
-- | early: where a body begins (`at`), its spine cut, and walked on not
-- | cut again
walk : Bool -> IR.Expr -> S IR.Expr
walk at e =
  if at && spined e then bind (readEarly e) (walk False) else kidsWith walk e

earlyDef : IR.Def -> S IR.Def
earlyDef d =
  if numbersW [d.body]
  then bind (walk True d.body) (\b -> pure (IR.mkDef d.key d.name b))
  else pure d

-- | the definitions, the numbers each body reads of a record after a
-- | call read before it, where so the record may be rebuilt in its cell
-- | >>> snd (earlyProgram 0 [IR.mkDef "f" "f" (ELam ["b"] (ELet "c" (ECall "g" [ERecord [MkPair "m" (EProj (EVar "b") "m" ["m"] FtFloat)] [FtFloat]]) (EPrimCall "add" [EVar "c", EProj (EVar "b") "m" ["m"] FtFloat])))])
-- | 1
earlyProgram : Int -> List IR.Def -> Pair (List IR.Def) Int
earlyProgram supply defs = traverseS earlyDef defs supply
