-- The IR (`heff.compile.lower`) to JavaScript, an ES module.  Emitting is
-- all this does -- what is erased, inlined, dropped or called at once
-- was decided before.
--
--   tag      T a b    ~>  { $: "T", a: [a, b] }
--   record   { l = e } ~> { l: e }
--   match             ~>  a `switch` on `$`
--   a definition of n parameters  ~>  a function of n parameters (and,
--            where it is passed on, `name$c`, its curried form)
--   a definition that is not a function  ~>  a constant, or (if
--            computing it may fail) computed once, when first used
--
-- Arguments are evaluated before the call (call-by-value); the
-- interpreter is lazy.

import heff.elab.effect as Ef
import heff.compile.facts as F
import heff.elab.fixed as Fx
import heff.elab.globals as G
import heff.compile.imp as Mp
import heff.compile.ir as I
import heff.compile.irtext as Ir
import heff.compile.lower as L
import heff.compile.prims as Pr
import heff.compile.simplify as Si
import map as M

type Output = { source : String, errors : List String }

type Export = { name : String, key : String }

mkExport : String -> String -> Export
mkExport name key = { name = name, key = key }

catMaybesL : {a : Type} -> List (Maybe a) -> List a
catMaybesL Nil = Nil
catMaybesL (Cons (Just x) xs) = Cons x (catMaybesL xs)
catMaybesL (Cons Nothing xs) = catMaybesL xs

elemStr : String -> List String -> Bool
elemStr x xs = List.elemBy strEq x xs

nubGo : List String -> List String -> List String
nubGo seen Nil = Nil
nubGo seen (Cons x xs) =
  if elemStr x seen then nubGo seen xs else Cons x (nubGo (Cons x seen) xs)

nubStr : List String -> List String
nubStr xs = nubGo Nil xs

unsnocCons : {a : Type} -> a -> Pair (List a) a -> Pair (List a) a
unsnocCons y (MkPair ini lst) = MkPair (Cons y ini) lst

unsnocGo : {a : Type} -> List a -> a -> Pair (List a) a
unsnocGo Nil y = MkPair Nil y
unsnocGo (Cons z rest) y = unsnocCons y (unsnocGo rest z)

-- | the list but its last element, and that element
unsnocE : {a : Type} -> List a -> Maybe (Pair (List a) a)
unsnocE Nil = Nothing
unsnocE (Cons x rest) = Just (unsnocGo rest x)

-- Names
--------------------------------------------------------------------------------

hexDigitOf : Int -> String
hexDigitOf d = strSlice "0123456789abcdef" d (d + 1)

-- (a byte not ASCII's as a JavaScript string writes it, `\xc3`: the
-- code unit of it the byte string has)
escAt : String -> Int -> String
escAt s i =
  if byteAt s i == 34 then "\\\""
  else if byteAt s i == 92 then "\\\\"
  else if byteAt s i == 10 then "\\n"
  else if byteAt s i == 13 then "\\r"
  else if byteAt s i == 9 then "\\t"
  else if byteAt s i >= 128
    then "\\x" ^ hexDigitOf (byteAt s i / 16) ^ hexDigitOf (byteAt s i % 16)
  else strSlice s i (i + 1)

quoteGo : String -> Int -> String -> String
quoteGo s i acc =
  if i >= strLength s then acc else quoteGo s (i + 1) (acc ^ escAt s i)

quoteString : String -> String
quoteString s = "\"" ^ quoteGo s 0 "" ^ "\""

-- (an operator's characters as words, for the languages compiled to)
wordOf : Int -> Maybe String
wordOf c =
  if c == 43 then Just "plus"
  else if c == 45 then Just "minus"
  else if c == 42 then Just "times"
  else if c == 47 then Just "slash"
  else if c == 37 then Just "percent"
  else if c == 61 then Just "eq"
  else if c == 60 then Just "lt"
  else if c == 62 then Just "gt"
  else if c == 38 then Just "amp"
  else if c == 124 then Just "bar"
  else if c == 33 then Just "bang"
  else if c == 94 then Just "caret"
  else if c == 63 then Just "q"
  else if c == 64 then Just "at"
  else if c == 35 then Just "hash"
  else if c == 36 then Just "dollar"
  else if c == 126 then Just "tilde"
  else if c == 58 then Just "colon"
  else if c == 46 then Just "dot"
  else if c == 92 then Just "backslash"
  else Nothing

operatorGo : String -> Int -> List String -> Maybe (List String)
operatorGo x i acc =
  if i >= strLength x then Just (List.reverse acc)
  else case wordOf (byteAt x i) of
    Just w -> operatorGo x (i + 1) (Cons w acc)
    Nothing -> Nothing

operatorDone : Maybe (List String) -> Maybe String
operatorDone (Just ws) = Just ("op_" ^ joinWith "_" ws)
operatorDone Nothing = Nothing

-- | an operator's name as a word: `+` is `op_plus`, `<=` `op_lt_eq`;
-- | nothing for a name that is not an operator
operatorName : String -> Maybe String
operatorName x =
  if strEq x "" then Nothing else operatorDone (operatorGo x 0 Nil)

lastDotFrom : String -> Int -> Maybe Int
lastDotFrom s i =
  if i < 0 then Nothing
  else if byteAt s i == 46 then Just i
  else lastDotFrom s (i - 1)

spellAt : String -> Maybe Int -> String
spellAt k (Just i) = case operatorName (strSlice k (i + 1) (strLength k)) of
  Just w -> strSlice k 0 (i + 1) ^ w
  Nothing -> fromMaybe k (operatorName k)
spellAt k Nothing = fromMaybe k (operatorName k)

-- | a name, or a key (`module.name`), with its name spelt out if it is
-- | an operator: `prelude.+` is `prelude.op_plus`
spellOperator : String -> String
spellOperator k = spellAt k (lastDotFrom k (strLength k - 1))

reserved : List String
reserved =
  [ "break"
  , "case"
  , "catch"
  , "class"
  , "const"
  , "continue"
  , "debugger"
  , "default"
  , "delete"
  , "do"
  , "else"
  , "enum"
  , "export"
  , "extends"
  , "false"
  , "finally"
  , "for"
  , "function"
  , "if"
  , "import"
  , "in"
  , "instanceof"
  , "new"
  , "null"
  , "return"
  , "super"
  , "switch"
  , "this"
  , "throw"
  , "true"
  , "try"
  , "typeof"
  , "var"
  , "void"
  , "while"
  , "with"
  , "yield"
  , "let"
  , "static"
  , "implements"
  , "interface"
  , "package"
  , "private"
  , "protected"
  , "public"
  , "await"
  , "arguments"
  , "eval"
  , "undefined"
  , "NaN"
  , "Infinity"
  , "document"
  , "window"
  , "BigInt"
  , "String"
  , "Number"
  , "Object"
  , "Error"
  , "Math"
  , "JSON"
  , "setTimeout"
  , "fetch"
  , "process"
  , "console"
  , "globalThis"
  , "Promise"
  , "Array"
  , "Map"
  , "Set"
  , "Date"
  , "Symbol"
  , "RegExp"
  , "Buffer"
  , "setImmediate"
  , "queueMicrotask"
  , "structuredClone"
  , "URL"
  , "TextEncoder"
  , "TextDecoder"
  , "Uint8Array"
  ]

isWordCode : Int -> Bool
isWordCode c =
  (97 <= c && c <= 122)
  || (65 <= c && c <= 90)
  || (48 <= c && c <= 57)
  || c == 95

safeChars : String -> Int -> String -> String
safeChars x i acc =
  if i >= strLength x then acc
  else safeChars
      x
      (i + 1)
      (acc ^ (if isWordCode (byteAt x i) then strSlice x i (i + 1) else "_"))

safeRes : String -> String
safeRes s =
  if elemStr s reserved || (48 <= byteAt s 0 && byteAt s 0 <= 57) then "_" ^ s
  else s

safeFrom : String -> String
safeFrom s = safeRes (if strEq s "" then "x" else s)

-- | >>> safe "co.<+>"
-- | "co_op_lt_plus_gt"
safe : String -> String
safe x0 = safeFrom (safeChars (spellOperator x0) 0 "")

isIdent : String -> Bool
isIdent x = not (strEq x "") && strEq (safe x) x

propName : String -> String
propName x = if isIdent x then x else quoteString x

-- | the short name of a key (`co.bind` is `bind`)
shortName : String -> String
shortName k = fromMaybe k (List.last (split "." k))

-- Globals
--------------------------------------------------------------------------------

-- | how a definition is reached: its name, how many parameters it takes
-- | at once, whether it is computed when first used, and whether a call
-- | of it may give back a bounce (see Tail calls)
type GInfo = { js : String, arity : Int, lazy : Bool, bounce : Bool }

-- | a global as a value
ref : M.Map String GInfo -> String -> String
ref gs k = case M.lookup compareString k gs of
  Just i ->
    if i.arity >= 2 then i.js ^ "$c" else if i.lazy then i.js ^ "()" else i.js
  Nothing -> "undefined"

-- | the globals a definition uses as values (not called at once)
valueRefs : Mp.Def -> List String
valueRefs d =
  catMaybesL
    (List.map
       (\p -> case p of
        PartVal (SGlobal g) -> Just g
        _ -> Nothing)
       (Mp.partsOf d))

-- Tail calls
--------------------------------------------------------------------------------

-- JavaScript has no tail calls, and a computation (`Co`) is all of them:
-- each step calls the rest last, so a loop of operations a handler of
-- the language handles is a stack as deep as the loop is long.  So a
-- call of an unknown function last (an application) counts itself, in
-- `$dep`, and every so often, instead of calling, gives back a bounce
-- (`$Bnc`: the function and its argument): the stack is let go of, to
-- where the call's value was asked for, which -- a call not last,
-- `$tr(f(x))` -- makes the call then, and again while it is given a
-- bounce.  A known definition called last is not counted: definitions
-- are sequential, so a chain of them always ends -- unless in a call of
-- an unknown function, which counts.  A definition that may give back
-- a bounce (`bounce`) is one that calls an unknown function last, or
-- such a definition.  (Where JavaScript calls a function of the
-- program -- the runtime, a provider, a module's user -- `$tr` and
-- `$ext` stand between.)

-- (which definitions may: heff.compile.facts's `bounce`)

-- Loops
--------------------------------------------------------------------------------

-- Scope
--------------------------------------------------------------------------------

-- | a function that is a loop: its parameters (`x$`)
type Self = { key : String, params : List String }

-- | precedences: 0 an arrow or a conditional, 1 a binary operation, 2 a
-- | unary one, 3 anything that can be called or projected
type Code = { code : String, prec : Int }

-- | the names in scope: the JavaScript name of each variable, and every
-- | name taken; and, in a function that is a loop, the function (where
-- | a call of it is last, it goes round again)
-- | (`inl`: the names whose one use computes them, by their code: see
-- | `inlined`)
type Env =
  { gs : M.Map String GInfo
  , names : M.Map String String
  , used : M.Map String Unit
  , self : Maybe Self
  , inl : M.Map String Code
  }

noSelf : Env -> Env
noSelf env =
  { gs = env.gs
  , names = env.names
  , used = env.used
  , self = Nothing
  , inl = env.inl
  }

withSelf : Maybe Self -> Env -> Env
withSelf s env =
  { gs = env.gs, names = env.names, used = env.used, self = s, inl = env.inl }

bound : String -> String -> Env -> Env
bound x v env =
  { gs = env.gs
  , names = M.insert compareString x v env.names
  , used = M.insert compareString v MkUnit env.used
  , self = env.self
  , inl = env.inl
  }

type BoundN = { js : String, env : Env }

bindFrom : Env -> String -> String -> Int -> BoundN
bindFrom env x base i =
  if M.member compareString (if i == 0 then base else base ^ showInt i) env.used
    then bindFrom env x base (i + 1)
  else { js = if i == 0 then base else base ^ showInt i
       , env = bound x (if i == 0 then base else base ^ showInt i) env
       }

bindName : Env -> String -> BoundN
bindName env x = bindFrom env x (safe (I.baseOf x)) 0

type BoundNs = { js : List String, env : Env }

bindSnoc : BoundNs -> BoundN -> BoundNs
bindSnoc acc r = { js = List.append acc.js (Cons r.js Nil), env = r.env }

bindAll : Env -> List String -> BoundNs
bindAll env xs =
  List.foldl
    (\acc x -> bindSnoc acc (bindName acc.env x))
    { js = Nil, env = env }
    xs

indent : Int -> String
indent n = joinWith "" (List.replicate n "  ")

atLeast : Int -> Code -> String
atLeast p c = if c.prec < p then "(" ^ c.code ^ ")" else c.code

p3 : String -> Code
p3 code = { code = code, prec = 3 }

codeOfC : Code -> String
codeOfC c = c.code

-- | a primitive given all its arguments: an operator where JavaScript
-- | has one, else its function
-- (an additive operator binds at 1, a multiplicative one at 2: both
-- left-associative, so the right operand is one tighter -- `(a - b) * c`
-- and `a / (b * c)` keep their parentheses)
primBin : String -> Code -> Code -> Code
primBin op a b =
  if strEq op "*" || strEq op "/"
    then { code = atLeast 2 a ^ " " ^ op ^ " " ^ atLeast 3 b, prec = 2 }
  else { code = atLeast 1 a ^ " " ^ op ^ " " ^ atLeast 2 b, prec = 1 }

primTest : String -> Code -> Code -> Code
primTest op a b =
  { code = atLeast 2 a ^ " " ^ op ^ " " ^ atLeast 2 b ^ " ? $T : $F", prec = 0 }

primDefault : String -> List Code -> Code
primDefault p as =
  p3 ("$" ^ p ^ "(" ^ joinWith ", " (List.map codeOfC as) ^ ")")

-- | the primitives JavaScript has an operator for, given both arguments
primOp : String -> Maybe (Code -> Code -> Code)
primOp "intAdd" = Just (primBin "+")
primOp "intSub" = Just (primBin "-")
primOp "intMul" = Just (primBin "*")
primOp "strAppend" = Just (primBin "+")
primOp "intEq" = Just (primTest "===")
primOp "strEq" = Just (primTest "===")
primOp "intLt" = Just (primTest "<")
primOp "strLt" = Just (primTest "<")
primOp "intLe" = Just (primTest "<=")
primOp "floatAdd" = Just (primBin "+")
primOp "floatSub" = Just (primBin "-")
primOp "floatMul" = Just (primBin "*")
primOp "floatDiv" = Just (primBin "/")
primOp "floatEq" = Just (primTest "===")
primOp "floatLt" = Just (primTest "<")
primOp "floatLe" = Just (primTest "<=")
primOp _ = Nothing

-- | the ones written another way, given their argument
primUnary : String -> Maybe (Code -> Code)
primUnary "intShow" = Just (\a -> p3 (atLeast 3 a ^ ".toString()"))
primUnary "strLength" = Just (\a -> p3 ("BigInt(" ^ atLeast 3 a ^ ".length)"))
primUnary _ = Nothing

primCall : String -> List Code -> Code
primCall p as@(Cons a (Cons b Nil)) = case primOp p of
  Just f -> f a b
  Nothing -> primDefault p as
primCall p as@(Cons a Nil) = case primUnary p of
  Just f -> f a
  Nothing -> primDefault p as
primCall p as = primDefault p as

-- | heff.compile.trmc's: a hole, and a cell's field set where its index
-- | is known, written as JavaScript writes them
cellPrim : String -> List Mp.Val -> Bool
cellPrim "hole" Nil = True
cellPrim "setField" (Cons _ (Cons (SInt _) (Cons _ Nil))) = True
cellPrim _ _ = False

-- | whether `primCall` calls the primitive's function, `$p(...)`
callsHelper : String -> List Mp.Val -> Bool
callsHelper p as@(Cons _ (Cons (SInt _) (Cons _ Nil))) = not (cellPrim p as)
callsHelper p (Cons _ (Cons _ Nil)) = maybe True (\_ -> False) (primOp p)
callsHelper p (Cons _ Nil) = maybe True (\_ -> False) (primUnary p)
callsHelper p as = not (cellPrim p as)

-- Conditions
--------------------------------------------------------------------------------

-- A condition (heff.compile.imp's `Pred`) as JavaScript writes it: `&&`,
-- `||`, `?:` and `!` of comparisons, a `Bool` looked at by its tag, and a
-- binding inside it an assignment, `(x = a, p)`, `x` declared before the
-- statement the condition is in.
data JPred
  = JTrue
  | JFalse
  | JRel String
  | JNot JPred
  | JIf JPred JPred JPred
  | JSeq String String JPred

-- | a condition's code and how tightly it binds: 0 a conditional, 1 `||`,
-- | 2 `&&`, 3 a comparison, 4 `!` or an atom
type CondCode = { code : String, prec : Int }

condAtLeast : Int -> CondCode -> String
condAtLeast n c = if c.prec < n then "(" ^ c.code ^ ")" else c.code

condCode : JPred -> CondCode
condCode JTrue = { code = "true", prec = 4 }
condCode JFalse = { code = "false", prec = 4 }
condCode (JRel s) = { code = s, prec = 3 }
condCode (JSeq x a q) =
  { code = "(" ^ x ^ " = " ^ a ^ ", " ^ condAtLeast 1 (condCode q) ^ ")"
  , prec = 4
  }
condCode (JNot q) = { code = "!" ^ condAtLeast 4 (condCode q), prec = 4 }
condCode (JIf c t JFalse) =
  { code = condAtLeast 2 (condCode c) ^ " && " ^ condAtLeast 2 (condCode t)
  , prec = 2
  }
condCode (JIf c JTrue e) =
  { code = condAtLeast 1 (condCode c) ^ " || " ^ condAtLeast 1 (condCode e)
  , prec = 1
  }
condCode (JIf c JFalse e) =
  { code =
      condAtLeast 2 (condCode (JNot c)) ^ " && " ^ condAtLeast 2 (condCode e)
  , prec = 2
  }
condCode (JIf c t JTrue) =
  { code =
      condAtLeast 1 (condCode (JNot c)) ^ " || " ^ condAtLeast 1 (condCode t)
  , prec = 1
  }
condCode (JIf c t e) =
  { code =
      condAtLeast 1 (condCode c)
      ^ " ? "
      ^ condAtLeast 0 (condCode t)
      ^ " : "
      ^ condAtLeast 0 (condCode e)
  , prec = 0
  }

-- | the names a condition binds, to be declared before it (a name two
-- | arms each bind is one variable: the scopes do not overlap)
seqsOf : JPred -> List String
seqsOf (JSeq x _ q) = Cons x (seqsOf q)
seqsOf (JNot q) = seqsOf q
seqsOf (JIf c t e) = List.append (seqsOf c) (List.append (seqsOf t) (seqsOf e))
seqsOf p = Nil

letDeclarations : Int -> List String -> List String
letDeclarations ind Nil = Nil
letDeclarations ind xs =
  Cons (indent ind ^ "let " ^ joinWith ", " (nubStr xs) ^ ";") Nil

-- (a fixed-width type's comparison, its values numbers or BigInts)
fixedRel : Fx.FixedPrim -> Maybe String
fixedRel { op = OpEq } = Just "==="
fixedRel { op = OpLt } = Just "<"
fixedRel { op = OpLe } = Just "<="
fixedRel p = Nothing

-- | the comparisons JavaScript has an operator for
primRel : String -> Maybe String
primRel "intEq" = Just "==="
primRel "strEq" = Just "==="
primRel "intLt" = Just "<"
primRel "strLt" = Just "<"
primRel "intLe" = Just "<="
primRel "floatEq" = Just "==="
primRel "floatLt" = Just "<"
primRel "floatLe" = Just "<="
primRel "runeEq" = Just "==="
primRel "runeLt" = Just "<"
primRel "runeLe" = Just "<="
primRel p = maybe Nothing fixedRel (Fx.fixedPrimOf p)

-- | a `Bool` from a condition
boolCode : JPred -> Code
boolCode JTrue = p3 "$T"
boolCode JFalse = p3 "$F"
boolCode c = { code = condAtLeast 1 (condCode c) ^ " ? $T : $F", prec = 0 }

-- (a name made a variable that something after it may not take)
using : Env -> String -> Env
using env x =
  { gs = env.gs
  , names = env.names
  , used = M.insert compareString x MkUnit env.used
  , self = env.self
  , inl = env.inl
  }

usingAll : Env -> List String -> Env
usingAll env xs = List.foldl using env xs

-- Values
--------------------------------------------------------------------------------

-- | statements' lines, and the names after them
type Printed = { lines : List String, env : Env }

-- | the printer's judgments, knotted: a value, a step not last, a
-- | condition, a body (an expression or a block), what is last,
-- | statements
type JK =
  { val : Env -> Int -> Mp.Val -> Code
  , op : Env -> Int -> Mp.Comp -> Code
  , cond : Env -> Int -> Mp.Cond -> JPred
  , body : Env -> Int -> Mp.Tl -> String
  , tail : Env -> Int -> Mp.Tl -> List String
  , stmts : Env -> Int -> List Mp.St -> Maybe Mp.Tl -> Printed
  }

callName : Env -> String -> String
callName env g = case M.lookup compareString g env.gs of
  Just i -> i.js
  Nothing -> safe g

projSuffix : String -> String
projSuffix l = if isIdent l then "." ^ l else "[" ^ quoteString l ^ "]"

intCode : String -> Code
intCode s =
  if startsWith "-" s then { code = s ^ "n", prec = 2 } else p3 (s ^ "n")

-- (`2.0` is `2`, a number, not a BigInt)
floatCode : String -> Code
floatCode s = if startsWith "-" s then { code = s, prec = 2 } else p3 s

-- | a fixed-width integer: of 64 bits, a BigInt, as an `Int` is; of fewer,
-- | a number
fixedCode : Fx.Fixed -> Int -> Code
fixedCode w n =
  if Fx.fixedBits w == 64 then intCode (showInt n) else floatCode (showInt n)

lamCode : JK -> Int -> Mp.Tl -> BoundNs -> Code
lamCode r ind t rb =
  { code =
      joinWith "" (List.map (\p -> "(" ^ p ^ ") => ") rb.js)
      ^ r.body rb.env ind t
  , prec = 0
  }

fieldCode : JK -> Env -> Int -> Pair String Mp.Val -> String
fieldCode r env ind (MkPair l v) = propName l ^ ": " ^ (r.val env ind v).code

-- (a primitive given all its arguments; heff.compile.trmc's written as
-- JavaScript writes them)
primVal : JK -> Env -> Int -> String -> List Mp.Val -> Code
primVal r env ind "hole" Nil = p3 "undefined"
primVal r env ind "setField" (Cons d (Cons (SInt k) (Cons v Nil))) =
  { code =
      atLeast 3 (r.val env ind d)
      ^ ".a["
      ^ showInt k
      ^ "] = "
      ^ codeOfC (r.val env ind v)
  , prec = 0
  }
primVal r env ind p as = primCall p (List.map (r.val env ind) as)

valGo : JK -> Env -> Int -> Mp.Val -> Code
valGo r env ind (SVar x) = case M.lookup compareString x env.inl of
  Just c -> c
  Nothing -> p3 (fromMaybe (safe x) (M.lookup compareString x env.names))
valGo r env ind (SGlobal g) = p3 (ref env.gs g)
valGo r env ind (SInt i) = intCode (showInt i)
valGo r env ind (SFloat x) = floatCode (showFloat x)
valGo r env ind (SFixed w n) = fixedCode w n
-- (a `Float32` is a number, rounded to one)
valGo r env ind (SFloat32 x) = p3 ("Math.fround(" ^ showFloat x ^ ")")
valGo r env ind (SStr s) = p3 (quoteString s)
valGo r env ind (SPrimFn p) = p3 ("$" ^ p ^ "$c")
valGo r env ind (SLam xs (MkBlock t)) =
  lamCode r ind t (bindAll (noSelf env) xs)
valGo r env ind (STag t Nil) =
  if strEq t "True" then p3 "$T"
  else if strEq t "False" then p3 "$F"
  else p3 ("{ $: " ^ quoteString t ^ ", a: [] }")
valGo r env ind (STag t as) =
  p3
    ("{ $: "
     ^ quoteString t
     ^ ", a: ["
     ^ joinWith ", " (List.map (\a -> (r.val env ind a).code) as)
     ^ "] }")
valGo r env ind (SRec fs _) =
  p3 ("{ " ^ joinWith ", " (List.map (\f -> fieldCode r env ind f) fs) ^ " }")
valGo r env ind (SProj v l _ _) =
  p3 (atLeast 3 (r.val env ind v) ^ projSuffix l)
valGo r env ind (SPrim p as) = primVal r env ind p as

-- Steps
--------------------------------------------------------------------------------

-- (a thunk forced: its value kept on it, so that forcing it again does
-- not compute it again -- the language is pure, `f MkUnit` is the same
-- value every time, and what abandons is not kept)
isUnitArgs : List Mp.Val -> Bool
isUnitArgs (Cons (STag t Nil) Nil) = strEq t "MkUnit"
isUnitArgs _ = False

bouncesG : Env -> String -> Bool
bouncesG env g = case M.lookup compareString g env.gs of
  Just i -> i.bounce
  Nothing -> False

-- | a call's value, through its bounces
trCode : String -> String
trCode c = "$tr(" ^ c ^ ")"

trWhen : Bool -> String -> String
trWhen b c = if b then trCode c else c

-- | a known definition called, as it is (what it gives back may be a
-- | bounce)
callCode : JK -> Env -> Int -> String -> List Mp.Val -> String
callCode r env ind g as =
  callName env g
  ^ "("
  ^ joinWith ", " (List.map (\a -> (r.val env ind a).code) as)
  ^ ")"

-- | a function applied to arguments one at a time, each call's value
-- | asked for through its bounces
applied : JK -> Env -> Int -> Code -> List Mp.Val -> Code
applied r env ind c as =
  List.foldl
    (\c2 a -> p3 (trCode (atLeast 3 c2 ^ "(" ^ (r.val env ind a).code ^ ")")))
    c
    as

-- | a step not last: its value, through any bounces
opGo : JK -> Env -> Int -> Mp.Comp -> Code
opGo r env ind (OSimple v) = r.val env ind v
opGo r env ind (OCall g as) =
  if isUnitArgs as then p3 ("$force(" ^ callName env g ^ ")")
  else p3 (trWhen (bouncesG env g) (callCode r env ind g as))
opGo r env ind (OApply f as) =
  if isUnitArgs as then p3 ("$force(" ^ (r.val env ind f).code ^ ")")
  else applied r env ind (r.val env ind f) as
opGo r env ind (OPrim p as) = primCall p (List.map (r.val env ind) as)
opGo r env ind OAbandon = p3 "$abandon()"
opGo r env ind (OBool c) = boolCode (r.cond env ind c)

seqAs : JK -> Env -> Int -> Mp.Comp -> Mp.Cond -> BoundN -> JPred
seqAs r env ind o c nb = JSeq nb.js (r.op env ind o).code (r.cond nb.env ind c)

-- | the condition, the names it binds chosen
condGo : JK -> Env -> Int -> Mp.Cond -> JPred
condGo r env ind PTrue = JTrue
condGo r env ind PFalse = JFalse
condGo r env ind (PRel p a b) =
  JRel
    (atLeast 2 (r.val env ind a)
     ^ " "
     ^ fromMaybe "===" (primRel p)
     ^ " "
     ^ atLeast 2 (r.val env ind b))
condGo r env ind (PBool v) =
  JRel (atLeast 3 (r.val env ind v) ^ ".$ === \"True\"")
condGo r env ind (PNot c) = JNot (r.cond env ind c)
condGo r env ind (PIf a b c) =
  JIf (r.cond env ind a) (r.cond env ind b) (r.cond env ind c)
condGo r env ind (PLet x o c) = seqAs r env ind o c (bindName env x)

-- (a step and the names its condition binds, declared before it)
type Stepped = { code : Code, decls : List String }

boolStep : JPred -> Stepped
boolStep jc = { code = boolCode jc, decls = seqsOf jc }

stepOf : JK -> Env -> Int -> Mp.Comp -> Stepped
stepOf r env ind (OBool c) = boolStep (r.cond env ind c)
stepOf r env ind o = { code = r.op env ind o, decls = Nil }

-- Statements
--------------------------------------------------------------------------------

-- | what a match looks at: a name, or a value bound to one first
type Scrut = { js : String, env : Env, pre : List String }

scrutBound : JK -> Env -> Int -> Mp.Val -> BoundN -> Scrut
scrutBound r env ind v b =
  { js = b.js
  , env = b.env
  , pre =
      Cons
        (indent ind ^ "const " ^ b.js ^ " = " ^ (r.val env ind v).code ^ ";")
        Nil
  }

scrutOf : JK -> Env -> Int -> Mp.Val -> Scrut
scrutOf r env ind (SVar x) = case M.lookup compareString x env.names of
  Just js -> { js = js, env = env, pre = Nil }
  Nothing -> scrutBound r env ind (SVar x) (bindName env "s")
scrutOf r env ind v = scrutBound r env ind v (bindName env "s")

declsOf : String -> Int -> List String -> Int -> List String
declsOf js ind Nil i = Nil
declsOf js ind (Cons v rest) i =
  Cons
    (indent ind ^ "const " ^ v ^ " = " ^ js ^ ".a[" ^ showInt i ^ "];")
    (declsOf js ind rest (i + 1))

-- | an arm, laid out: its tag, whether it uses none of the fields it
-- | binds, and its lines -- the body alone if so (arms whose bodies are
-- | the same then share one, under all their labels: a match with a
-- | default copies it into the arm of every tag it stands for), the
-- | whole `case` otherwise
data ArmJs = MkArmJs String Bool (List String)

armJsTag : ArmJs -> String
armJsTag (MkArmJs t _ _) = t

armJsKey : ArmJs -> Maybe String
armJsKey (MkArmJs _ True ls) = Just (joinWith "\n" ls)
armJsKey (MkArmJs _ False _) = Nothing

armBound : Scrut
         -> Int
         -> String
         -> (Env -> Int -> List String)
         -> BoundNs
         -> ArmJs
armBound sc ind tag lines rb =
  MkArmJs
    tag
    False
    (List.append
       (Cons (indent (ind + 1) ^ "case " ^ quoteString tag ^ ": {") Nil)
       (List.append
          (declsOf sc.js (ind + 2) rb.js 0)
          (List.append
             (lines rb.env (ind + 2))
             (Cons (indent (ind + 1) ^ "}") Nil))))

-- | an arm, its body's lines made by `lines` (an environment, an
-- | indentation) and its parts (whether it names its fields)
armJs : Scrut
      -> Int
      -> String
      -> List String
      -> List Mp.Part
      -> (Env -> Int -> List String)
      -> ArmJs
armJs sc ind tag vs parts lines =
  if List.all (\v -> not (Mp.namedIn v parts)) vs
    then MkArmJs tag True (lines sc.env (ind + 2))
  else armBound sc ind tag lines (bindAll sc.env vs)

sameKey : Maybe String -> ArmJs -> Bool
sameKey (Just k) a = case armJsKey a of
  Just k2 -> strEq k k2
  Nothing -> False
sameKey Nothing a = False

-- | the arms, those of one body sharing it (where the first of them was)
sharedGo : Int -> List ArmJs -> List ArmJs -> List String
sharedGo ind before Nil = Nil
sharedGo ind before (Cons a@(MkArmJs tag False ls) rest) =
  List.append ls (sharedGo ind (Cons a before) rest)
sharedGo ind before (Cons a@(MkArmJs tag True ls) rest) =
  if List.any (\b -> sameKey (armJsKey a) b) before
    then sharedGo ind (Cons a before) rest
  else List.append
      (List.map
         (\b -> indent (ind + 1) ^ "case " ^ quoteString (armJsTag b) ^ ":")
         (Cons a (List.filter (\b -> sameKey (armJsKey a) b) rest)))
      (List.append
         (Cons (indent (ind + 1) ^ "{") Nil)
         (List.append
            ls
            (List.append
               (Cons (indent (ind + 1) ^ "}") Nil)
               (sharedGo ind (Cons a before) rest))))

-- | a match: `switch` on the tag, the arms, then `inside` (a default)
-- | and `after` (what follows if no arm is taken)
switchLines : Scrut
            -> Int
            -> List ArmJs
            -> List String
            -> List String
            -> List String
switchLines sc ind arms inside after =
  List.append
    sc.pre
    (List.append
       (Cons (indent ind ^ "switch (" ^ sc.js ^ ".$) {") Nil)
       (List.append
          (sharedGo ind Nil arms)
          (List.append inside (Cons (indent ind ^ "}") after))))

-- (an `if`, each arm's lines made by `lines`, a constant condition the
-- one arm alone)
ifLines : Int
        -> JPred
        -> (Int -> List String)
        -> (Int -> List String)
        -> List String
ifLines ind JTrue t f = t ind
ifLines ind JFalse t f = f ind
ifLines ind c t f =
  List.append
    (letDeclarations ind (seqsOf c))
    (List.append
       (Cons (indent ind ^ "if (" ^ (condCode c).code ^ ") {") Nil)
       (List.append
          (t (ind + 1))
          (Cons
             (indent ind ^ "} else {")
             (List.append (f (ind + 1)) (Cons (indent ind ^ "}") Nil)))))

letBound : Int -> Stepped -> BoundN -> Printed
letBound ind st nb =
  { lines =
      List.append
        (letDeclarations ind st.decls)
        (Cons (indent ind ^ "const " ^ nb.js ^ " = " ^ st.code.code ^ ";") Nil)
  , env = nb.env
  }

letStmt : Int -> Stepped -> String -> Env -> Printed
letStmt ind st x env = letBound ind st (bindName (usingAll env st.decls) x)

declStmt : Int -> BoundN -> Printed
declStmt ind nb =
  { lines = Cons (indent ind ^ "let " ^ nb.js ^ ";") Nil, env = nb.env }

setStmt : Int -> Stepped -> String -> Env -> Printed
setStmt ind st x env =
  { lines =
      List.append
        (letDeclarations ind st.decls)
        (Cons
           (indent ind
            ^ fromMaybe (safe x) (M.lookup compareString x env.names)
            ^ " = "
            ^ st.code.code
            ^ ";")
           Nil)
  , env = usingAll env st.decls
  }

-- (a match as a statement: each arm's statements, then on; no arm taken,
-- the program fails)
caseStmt : JK -> Int -> List (Mp.Arm (List Mp.St)) -> Scrut -> Printed
caseStmt r ind arms sc =
  { lines =
      switchLines
        sc
        ind
        (List.map
           (\arm -> case arm of
            MkArm tag vs ss ->
              armJs
                sc
                ind
                tag
                vs
                (Mp.stmtsParts ss)
                (\e i ->
                   List.append
                     (r.stmts e i ss Nothing).lines
                     (Cons (indent i ^ "break;") Nil)))
           arms)
        (Cons (indent (ind + 1) ^ "default: $nomatch(" ^ sc.js ^ ");") Nil)
        Nil
  , env = sc.env
  }

-- | a statement's lines, and the names after it
stmtGo : JK -> Env -> Int -> Mp.St -> Printed
stmtGo r env ind (SLet x o) = letStmt ind (stepOf r env ind o) x env
stmtGo r env ind (SDecl x) = declStmt ind (bindName env x)
stmtGo r env ind (SSet x o) = setStmt ind (stepOf r env ind o) x env
stmtGo r env ind (SIf c ts fs) =
  { lines =
      ifLines
        ind
        (r.cond env ind c)
        (\i -> (r.stmts env i ts Nothing).lines)
        (\i -> (r.stmts env i fs Nothing).lines)
  , env = usingAll env (seqsOf (r.cond env ind c))
  }
stmtGo r env ind (SCase v arms) = caseStmt r ind arms (scrutOf r env ind v)

stmtsAfter : Printed -> Printed -> Printed
stmtsAfter a b = { lines = List.append a.lines b.lines, env = b.env }

stmtsThen : JK -> Int -> List Mp.St -> Maybe Mp.Tl -> Printed -> Printed
stmtsThen r ind rest after p = stmtsAfter p (r.stmts p.env ind rest after)

-- (a name whose one use, in what follows it, computes it instead: in
-- JavaScript, a value a `const` holds is held to the end of its block --
-- in a loop, a round -- however soon it is used, so a long list one step
-- makes and the next takes apart would be held while the steps after go
-- on, where a call made in place lets it go once it is taken apart)
inlined : Env -> String -> Code -> Env
inlined env x c =
  { gs = env.gs
  , names = env.names
  , used = env.used
  , self = env.self
  , inl = M.insert compareString x c env.inl
  }

-- (whether a binding computes its one use instead: not a condition's
-- `Bool`, whose names are declared before)
inlinable : String -> Mp.Comp -> List Mp.St -> Maybe Mp.Tl -> Bool
inlinable x (OBool _) rest after = False
inlinable x o rest after =
  Mp.usedOnceNext
    x
    (case rest of
     Cons st _ -> Mp.firstNames st
     Nil -> case after of
       Just t -> Mp.firstNamesTl t
       Nothing -> Nil)
    (List.append (Mp.stmtsParts rest) (case after of
     Just t -> Mp.tailParts t
     Nothing -> Nil))

stmtsGo : JK -> Env -> Int -> List Mp.St -> Maybe Mp.Tl -> Printed
stmtsGo r env ind Nil after = { lines = Nil, env = env }
stmtsGo r env ind (Cons (SLet x o) rest) after =
  if inlinable x o rest after
    then r.stmts (inlined env x (r.op env ind o)) ind rest after
  else stmtsThen r ind rest after (stmtGo r env ind (SLet x o))
stmtsGo r env ind (Cons st rest) after =
  stmtsThen r ind rest after (stmtGo r env ind st)

-- What is last
--------------------------------------------------------------------------------

-- (the arguments are of this round's `const`s: assigned one by one)
again : JK -> Env -> Int -> List Mp.Val -> List String
again r env@{ self = Just s } ind as =
  Cons
    (indent ind
     ^ joinWith
       " "
       (List.zipWith
          (\p a -> p ^ " = " ^ (r.val env ind a).code ^ ";")
          s.params
          as)
     ^ " continue;")
    Nil
again r env ind as = Cons (indent ind ^ "return $abandon();") Nil

-- | the most calls of unknown functions made last, one inside the
-- | other, before the stack is let go of
bounceDepth : Int
bounceDepth = 500

atomGo : String -> Int -> Bool
atomGo c i =
  if i >= strLength c then True
  else (isWordCode (byteAt c i) || byteAt c i == 36) && atomGo c (i + 1)

-- | code that is a name or a literal: computing it again is nothing
isAtom : String -> Bool
isAtom c = not (strEq c "") && atomGo c 0

-- | a value as a name: itself if it is one, else a `const`'s
type Named = { js : String, pre : List String, env : Env }

namedAs : Int -> Code -> BoundN -> Named
namedAs ind c nb =
  { js = nb.js
  , pre = Cons (indent ind ^ "const " ^ nb.js ^ " = " ^ c.code ^ ";") Nil
  , env = nb.env
  }

named : Env -> Int -> String -> Code -> Named
named env ind base c =
  if isAtom c.code then { js = c.code, pre = Nil, env = env }
  else namedAs ind c (bindName env base)

bounceGive : Int -> Named -> Named -> List String
bounceGive ind f a =
  List.append
    f.pre
    (List.append
       a.pre
       (Cons
          (indent ind
           ^ "return ++$dep > "
           ^ showInt bounceDepth
           ^ " ? new $Bnc("
           ^ f.js
           ^ ", "
           ^ a.js
           ^ ") : "
           ^ f.js
           ^ "("
           ^ a.js
           ^ ");")
          Nil))

bounceNamed : Int -> Code -> Named -> List String
bounceNamed ind ac f = bounceGive ind f (named f.env ind "a" ac)

bounceLines : Env -> Int -> Code -> Code -> List String
bounceLines env ind fc ac = bounceNamed ind ac (named env ind "f" fc)

-- | a `Bool` returned: the condition, as a value
returnCond : Int -> JPred -> List String
returnCond ind JTrue = Cons (indent ind ^ "return $T;") Nil
returnCond ind JFalse = Cons (indent ind ^ "return $F;") Nil
returnCond ind c =
  List.append
    (letDeclarations ind (seqsOf c))
    (Cons
       (indent ind ^ "return " ^ condAtLeast 1 (condCode c) ^ " ? $T : $F;")
       Nil)

-- | a value returned: an unknown function's, called last, counted (and,
-- | every so often, a bounce instead); a known definition's, called
-- | last, not counted, its bounce handed on
returnLines : JK -> Env -> Int -> Mp.Comp -> List String
returnLines r env ind (OApply f as) =
  if isUnitArgs as then bounceLines env ind (p3 "$force") (r.val env ind f)
  else case unsnocE as of
    Just (MkPair ini a) ->
      bounceLines
        env
        ind
        (applied r env ind (r.val env ind f) ini)
        (r.val env ind a)
    Nothing -> Cons (indent ind ^ "return " ^ (r.val env ind f).code ^ ";") Nil
returnLines r env ind o@(OCall g as) =
  if isUnitArgs as
    then Cons (indent ind ^ "return " ^ (r.op env ind o).code ^ ";") Nil
  else Cons (indent ind ^ "return " ^ callCode r env ind g as ^ ";") Nil
returnLines r env ind (OBool c) = returnCond ind (r.cond env ind c)
returnLines r env ind o =
  Cons (indent ind ^ "return " ^ (r.op env ind o).code ^ ";") Nil

tailAfter : JK -> Int -> Mp.Tl -> Printed -> List String
tailAfter r ind t p = List.append p.lines (r.tail p.env ind t)

caseTail : JK -> Int -> List (Mp.Arm Mp.Tl) -> Scrut -> List String
caseTail r ind arms sc =
  switchLines
    sc
    ind
    (List.map
       (\arm -> case arm of
        MkArm tag vs t ->
          armJs sc ind tag vs (Mp.tailParts t) (\e i -> r.tail e i t))
       arms)
    Nil
    (Cons (indent ind ^ "return $nomatch(" ^ sc.js ^ ");") Nil)

-- | what is last: returned, or, in a loop, the next round
tailGo : JK -> Env -> Int -> Mp.Tl -> List String
tailGo r env ind (TSeq ss t) = tailAfter r ind t (r.stmts env ind ss (Just t))
tailGo r env ind (TReturn o) = returnLines r env ind o
tailGo r env ind (TLoop as) = again r env ind as
tailGo r env ind (TIf c t f) =
  ifLines ind (r.cond env ind c) (\i -> r.tail env i t) (\i -> r.tail env i f)
tailGo r env ind (TCase v arms) = caseTail r ind arms (scrutOf r env ind v)

bodyCode : String -> String
bodyCode c = if strEq (strSlice c 0 1) "{" then "(" ^ c ^ ")" else c

-- (a step returned that is an expression's worth: not an unknown
-- function's call, counted, nor a known one's that may bounce, nor a
-- condition's `Bool`)
exprBody : Env -> Mp.Comp -> Bool
exprBody env (OApply _ _) = False
exprBody env (OCall g _) = not (bouncesG env g)
exprBody env (OBool _) = False
exprBody env o = True

blockOf : JK -> Env -> Int -> Mp.Tl -> String
blockOf r env ind t =
  "{\n" ^ joinWith "\n" (r.tail env (ind + 1) t) ^ "\n" ^ indent ind ^ "}"

-- | a function's body: an expression, or a block if it does more
bodyGo : JK -> Env -> Int -> Mp.Tl -> String
bodyGo r env ind t@(TReturn o) =
  if exprBody env o then bodyCode (r.op env ind o).code else blockOf r env ind t
bodyGo r env ind t = blockOf r env ind t

jk : JK
jk =
  { val = \env ind v -> valGo jk env ind v
  , op = \env ind o -> opGo jk env ind o
  , cond = \env ind c -> condGo jk env ind c
  , body = \env ind t -> bodyGo jk env ind t
  , tail = \env ind t -> tailGo jk env ind t
  , stmts = \env ind ss after -> stmtsGo jk env ind ss after
  }

-- Definitions
--------------------------------------------------------------------------------

env0Of : M.Map String GInfo -> M.Map String Unit -> Env
env0Of gs met =
  { gs = gs, names = M.empty, used = met, self = Nothing, inl = M.empty }

-- where a function of several parameters is used as a value, it needs
-- its curried form
wrapper : M.Map String Unit -> String -> GInfo -> List String -> List String
wrapper curried key i js =
  if i.arity >= 2 && M.member compareString key curried
    then Cons
        ("const "
         ^ i.js
         ^ "$c = "
         ^ joinWith "" (List.map (\p -> "(" ^ p ^ ") => ") js)
         ^ i.js
         ^ "("
         ^ joinWith ", " js
         ^ ");")
        Nil
  else Nil

-- | whether it goes round again somewhere (heff.compile.imp's `TLoop`)
loops : Mp.Tl -> Bool
loops (TSeq _ t) = loops t
loops (TLoop _) = True
loops (TIf _ t e) = loops t || loops e
loops (TCase _ arms) =
  List.any
    (\arm -> case arm of
     MkArm _ _ t -> loops t)
    arms
loops t = False

-- (a loop; its parameters `x$`, each round's own `const`, which what it
-- closes over keeps)
looped : String -> GInfo -> Mp.Tl -> BoundNs -> List String
looped key i t r =
  List.append
    [ ""
    , "const "
    ^ i.js
    ^ " = ("
    ^ joinWith ", " (List.map (\x -> x ^ "$") r.js)
    ^ ") => {"
    ]
    (List.append
       [ "  for (;;) {"
       , "    const "
       ^ joinWith
         ", "
         (List.zipWith
            (\x v -> x ^ " = " ^ v)
            r.js
            (List.map (\x -> x ^ "$") r.js))
       ^ ";"
       ]
       (List.append
          (jk.tail
             (withSelf
                (Just { key = key, params = List.map (\x -> x ^ "$") r.js })
                r.env)
             2
             t)
          (Cons "  }" (Cons "};" Nil))))

defFun : String -> GInfo -> Mp.Tl -> BoundNs -> List String
defFun key i t r =
  if loops t then looped key i t r
  else [ ""
       , "const "
       ^ i.js
       ^ " = ("
       ^ joinWith ", " r.js
       ^ ") => "
       ^ jk.body r.env 0 t
       ^ ";"
       ]

-- (a value computed at once: an expression; else in a block, called)
eagerCode : Env -> Mp.Tl -> String
eagerCode env (TReturn o) = (jk.op env 0 o).code
eagerCode env t = "(() => " ^ blockOf jk env 0 t ^ ")()"

-- | a definition's lines -- its curried form apart, which is the
-- | program's to say (`wrapper`) -- and its parameters' names
type DefCode = { lines : List String, params : List String }

defFunCode : String -> GInfo -> Mp.Tl -> BoundNs -> DefCode
defFunCode key i t r = { lines = defFun key i t r, params = r.js }

defCodeOf : M.Map String GInfo
          -> M.Map String Unit
          -> String
          -> Mp.Body
          -> GInfo
          -> DefCode
defCodeOf gs met key (DefFun xs (MkBlock t)) i =
  defFunCode key i t (bindAll (env0Of gs met) xs)
defCodeOf gs met key (DefVal (MkBlock t)) i =
  { lines =
      if i.lazy
        then [ ""
             , "const "
             ^ i.js
             ^ " = $lazy(() => "
             ^ jk.body (env0Of gs met) 0 t
             ^ ");"
             ]
      else ["", "const " ^ i.js ^ " = " ^ eagerCode (env0Of gs met) t ^ ";"]
  , params = Nil
  }

-- Programs
--------------------------------------------------------------------------------

whenHas : String -> String -> String -> Maybe String
whenHas code k line = if contains k code then Just line else Nothing

-- | the helpers a String crosses to the host and back by, each its name
-- | and its line (lib/browser/dom.provider.js says which is for what): a
-- | String is a JavaScript string each of whose code units is one of its
-- | bytes; the host's text is its UTF-8 (what is not UTF-8 U+FFFD, and
-- | a surrogate not in a pair, as `TextDecoder` and `TextEncoder` have
-- | it, a BOM kept), text that is ASCII as it is, and the host's bytes
-- | are its bytes -- by `Buffer` where there is one (Node.js), else by
-- | the web's encoders
strHelpers : List (Pair String String)
strHelpers =
  [ MkPair
    "$toJs"
    "const $toJs = typeof Buffer === \"function\" ? (s) => /^[\\x00-\\x7f]*$/.test(s) ? s : Buffer.from(s, \"latin1\").toString(\"utf8\") : (s) => /^[\\x00-\\x7f]*$/.test(s) ? s : new TextDecoder(\"utf-8\", { ignoreBOM: true }).decode(Uint8Array.from(s, (c) => c.charCodeAt(0)));"
  , MkPair
    "$fromJs"
    "const $fromJs = typeof Buffer === \"function\" ? (t) => /^[\\x00-\\x7f]*$/.test(t) ? t : Buffer.from(t, \"utf8\").toString(\"latin1\") : (t) => { if (/^[\\x00-\\x7f]*$/.test(t)) return t; const b = new TextEncoder().encode(t); let s = \"\"; for (let i = 0; i < b.length; i += 8192) s += String.fromCharCode.apply(null, b.subarray(i, i + 8192)); return s; };"
  , MkPair
    "$toBytes"
    "const $toBytes = typeof Buffer === \"function\" ? (s) => Buffer.from(s, \"latin1\") : (s) => Uint8Array.from(s, (c) => c.charCodeAt(0));"
  , MkPair
    "$fromBytes"
    "const $fromBytes = typeof Buffer === \"function\" ? (b) => (Buffer.isBuffer(b) ? b : Buffer.from(b)).toString(\"latin1\") : (b) => { const u = new Uint8Array(b); let s = \"\"; for (let i = 0; i < u.length; i += 8192) s += String.fromCharCode.apply(null, u.subarray(i, i + 8192)); return s; };"
  ]

strHelperIn : String -> Pair String String -> Maybe String
strHelperIn text (MkPair k line) = whenHas text k line

-- | the string helpers `text` uses
strHelpersIn : String -> List String
strHelpersIn text = catMaybesL (List.map (\h -> strHelperIn text h) strHelpers)

-- | bounces (see Tail calls): how many calls last were made since the
-- | last one, a bounce, and a value asked for through them
trampolineStr : String
trampolineStr =
  "let $dep = 0; function $Bnc(f, a) { this.f = f; this.a = a; } const $trs = (r) => { do { $dep = 0; r = r.f(r.a); } while (r instanceof $Bnc); return r; }; const $tr = (r) => r instanceof $Bnc ? $trs(r) : r;"

-- | a value of the program given to JavaScript: a function's value is
-- | asked for through its bounces, and so are a record's functions' (a
-- | `Bytes`, a `Uint8Array`, is no record)
extStr : String
extStr =
  "const $ext = (v) => typeof v === \"function\" ? (x) => $ext($tr(v(x))) : v !== null && typeof v === \"object\" && !Array.isArray(v) && !(v instanceof Uint8Array) && !(\"$\" in v) ? Object.fromEntries(Object.entries(v).map(([l, x]) => [l, $ext(x)])) : v;"

-- | what the code uses of the runtime
runtime : String -> List String
runtime code =
  List.append
    (catMaybesL
       [ if List.any (\k -> contains k code) ["$tr(", "$Bnc", "$force", "$lazy"]
         then Just trampolineStr
       else Nothing
       -- (either may be used without the other)
       , if contains "$T" code || contains "$F" code
         then Just
             "const $T = { $: \"True\", a: [] }, $F = { $: \"False\", a: [] };"
       else Nothing
       , whenHas
         code
         "$abandon"
         "const $abandon = () => { throw new Error(\"heff:abandon\"); };"
       , whenHas
         code
         "$nomatch"
         "const $nomatch = (s) => { throw new Error(\"heff: no case for '\" + (s && s.$) + \"'\"); };"
       , whenHas
         code
         "$force"
         "const $force = (f) => { if (f.$m !== undefined) return f.$m; const v = $tr(f({ $: \"MkUnit\", a: [] })); f.$m = v; return v; };"
       , whenHas
         code
         "$lazy"
         "const $lazy = (f) => { let state = 0, v; return () => { if (state === 2) return v; if (state === 1) throw new Error(\"heff: defined by itself\"); state = 1; try { v = $tr(f()); state = 2; return v; } finally { if (state === 1) state = 0; } }; };"
       ])
    (strHelpersIn code)

type Uncurried = { params : List String, body : String }

uncurryDone : List String -> String -> Uncurried
uncurryDone ps s = { params = List.reverse ps, body = s }

uncurryGo : List String -> String -> Uncurried
uncurryGo ps s =
  if startsWith "(" s
    then case indexOf ") => " (strSlice s 1 (strLength s)) of
      Just i ->
        if isIdent (strSlice (strSlice s 1 (strLength s)) 0 i)
          then uncurryGo
              (Cons (strSlice (strSlice s 1 (strLength s)) 0 i) ps)
              (strSlice (strSlice s 1 (strLength s)) (i + 5) (strLength s - 1))
        else uncurryDone ps s
      Nothing -> uncurryDone ps s
  else uncurryDone ps s

-- | `(a) => (b) => body` as its parameters and body
uncurryJs : String -> Uncurried
uncurryJs js = uncurryGo Nil js

primCalled : M.Map String Unit -> String -> List Mp.Val -> M.Map String Unit
primCalled m p as =
  if callsHelper p as then M.insert compareString ("$" ^ p ^ "(") MkUnit m
  else m

-- | the primitives the code uses, as it writes them: `$p(` (given all
-- | its arguments) and `$p$c` (curried)
primUses : M.Map String Unit -> Mp.Part -> M.Map String Unit
primUses m (PartVal (SPrimFn p)) =
  M.insert compareString ("$" ^ p ^ "$c") MkUnit m
primUses m (PartVal (SPrim p as)) = primCalled m p as
primUses m (PartOp (OPrim p as)) = primCalled m p as
primUses m part = m

primHelperU : M.Map String Unit -> String -> Uncurried -> List String
primHelperU uses p u =
  List.append
    (if M.member compareString ("$" ^ p ^ "(") uses
     || M.member compareString ("$" ^ p ^ "$c") uses
       then Cons
           ("const $"
            ^ p
            ^ " = ("
            ^ joinWith ", " u.params
            ^ ") => "
            ^ u.body
            ^ ";")
           Nil
     else Nil)
    (if M.member compareString ("$" ^ p ^ "$c") uses
       then Cons
           ("const $"
            ^ p
            ^ "$c = "
            ^ joinWith "" (List.map (\x -> "(" ^ x ^ ") => ") u.params)
            ^ "$"
            ^ p
            ^ "("
            ^ joinWith ", " u.params
            ^ ");")
           Nil
     else Nil)

primHelperOne : M.Map String Unit -> Pair String Pr.PrimImpl -> List String
primHelperOne uses (MkPair p i) = primHelperU uses p (uncurryJs i.js)

-- (the helpers of those of the primitives `uses` has)
primHelpersOf : M.Map String Unit -> List String
primHelpersOf uses = List.concatMap (\p -> primHelperOne uses p) Pr.allPrims

type Emitted = { lines : List String, globals : M.Map String GInfo }

shortsOf : List String -> List String
shortsOf keys = List.map (\k -> safe (shortName k)) keys

-- names: the short one, unless two definitions share it
jsPick : List String -> String -> String -> String
jsPick shorts key s =
  if List.length (List.filter (\t -> strEq t s) shorts) > 1 then safe key else s

jsNameOf : List String -> String -> String
jsNameOf shorts key = jsPick shorts key (safe (shortName key))

infoOne : List String
        -> F.Facts
        -> M.Map String GInfo
        -> String
        -> M.Map String GInfo
infoOne shorts facts acc key =
  M.insert
    compareString
    key
    { js = jsNameOf shorts key
    , arity = fromMaybe 0 (M.lookup compareString key facts.arity)
    , lazy = M.member compareString key facts.lazy
    , bounce = M.member compareString key facts.bounce
    }
    acc

setFrom : List String -> M.Map String Unit
setFrom xs = List.foldl (\m k -> M.insert compareString k MkUnit m) M.empty xs

emitLines : M.Map String GInfo -> List String -> List String -> Emitted
emitLines info code helpers =
  { lines =
      List.append
        (runtime (joinWith "\n" (List.append helpers code)))
        (List.append helpers code)
  , globals = info
  }

infoAll : List String -> F.Facts -> List String -> M.Map String GInfo
infoAll shorts facts keys =
  List.foldl (\acc k -> infoOne shorts facts acc k) M.empty keys

-- The backend's cache: a definition's JavaScript as it keeps it
--------------------------------------------------------------------------------

-- A definition's JavaScript depends on the definition alone -- as both
-- backends are given it (heff.compile.lower's `shared`), its variables
-- named again from 0 -- and on what is known of itself and of the
-- globals it mentions (their names, arities, whether lazy, whether their
-- calls may bounce): a local is named past the names of those alone, not
-- of every global (`namesIn`).  The cache
-- (heff.build.backcache) keeps it by a hash of those (`jsVer`), with what
-- the program wants of it: its parameters' names, for its curried form;
-- the globals it uses as values, which have one; the primitives it uses,
-- which have helpers.

-- | a definition's JavaScript, as the cache keeps it
type JsKept =
  { ver : String
  , lines : List String
  , params : List String
  , refs : List String
  , prims : List String
  }

-- | what the printer knows of the whole program: each global's name and
-- | facts
type JsProgram = { info : M.Map String GInfo }

-- (each once, in order: through a map, not a list searched)
sortedOnceJ : List String -> List String
sortedOnceJ xs = List.map fst (M.toList (setFrom xs))

-- | what the printer knows of a program of the definitions `keys`
jsProgramOf : F.Facts -> List String -> JsProgram
jsProgramOf facts keys = { info = infoAll (shortsOf keys) facts keys }

-- (what is known of a global)
globalJsH : JsProgram -> String -> List Ir.HItem -> List Ir.HItem
globalJsH p g rest = case M.lookup compareString g p.info of
  Just i ->
    Cons
      (HS g)
      (Cons
         (HS i.js)
         (Cons
            (HN i.arity)
            (Cons
               (HN (if i.lazy then 1 else 0))
               (Cons (HN (if i.bounce then 1 else 0)) rest))))
  Nothing -> Cons (HS g) (Cons (HS "") rest)

-- | what a definition's JavaScript is made of, hashed: its key, its body
-- | (named again from 0), what is known of itself and of what it
-- | mentions
jsVer : JsProgram -> String -> I.Expr -> String
jsVer p key b =
  Ir.hashOf
    (Cons
       (HS "js")
       (Cons
          (HS key)
          (Cons
             (HE b)
             (List.foldr
                (globalJsH p)
                Nil
                (sortedOnceJ (Cons key (I.globalsIn b)))))))

keptCode : String -> Mp.Def -> DefCode -> JsKept
keptCode v d c =
  { ver = v
  , lines = c.lines
  , params = c.params
  , refs = valueRefs d
  , prims = List.map fst (M.toList (List.foldl primUses M.empty (Mp.partsOf d)))
  }

-- (a global a definition mentions)
globalOfPart : Mp.Part -> Maybe String
globalOfPart (PartVal (SGlobal g)) = Just g
globalOfPart (PartOp (OCall g _)) = Just g
globalOfPart _ = Nothing

jsOfGlobal : JsProgram -> String -> Maybe String
jsOfGlobal p g = case M.lookup compareString g p.info of
  Just i -> Just i.js
  Nothing -> Nothing

-- | the names a definition's locals are named past: of itself and of the
-- | globals it mentions, not of every global -- one it does not mention
-- | a local of its may hide, unharmed
namesIn : JsProgram -> Mp.Def -> M.Map String Unit
namesIn p d =
  setFrom
    (catMaybesL
       (List.map
          (jsOfGlobal p)
          (Cons
             (Mp.defKey d)
             (catMaybesL (List.map globalOfPart (Mp.partsOf d))))))

-- | a definition printed
keptOfDef : JsProgram -> String -> Mp.Def -> JsKept
keptOfDef p v d = case M.lookup compareString (Mp.defKey d) p.info of
  Just i ->
    keptCode v d (defCodeOf p.info (namesIn p d) (Mp.defKey d) (Mp.defBody d) i)
  Nothing -> keptCode v d { lines = Nil, params = Nil }

-- | the definitions' entries, last first, and those made here
type JsAcc =
  { entries : List (Pair String JsKept), fresh : List (Pair String JsKept) }

keptAtVerJ : String -> Maybe JsKept -> Maybe JsKept
keptAtVerJ v (Just k) = if strEq k.ver v then Just k else Nothing
keptAtVerJ v Nothing = Nothing

jsMade : JsAcc -> String -> JsKept -> JsAcc
jsMade acc key k =
  { entries = Cons (MkPair key k) acc.entries
  , fresh = Cons (MkPair key k) acc.fresh
  }

jsAt : JsProgram
     -> M.Map String JsKept
     -> JsAcc
     -> I.Def
     -> Pair I.Expr Int
     -> String
     -> JsAcc
jsAt p kept acc d own v = case keptAtVerJ
    v
    (M.lookup compareString d.key kept) of
  Just k -> { entries = Cons (MkPair d.key k) acc.entries, fresh = acc.fresh }
  Nothing -> jsMade acc d.key (keptOfDef p v (L.jsDef d own))

jsWith : JsProgram
       -> M.Map String JsKept
       -> JsAcc
       -> I.Def
       -> Pair I.Expr Int
       -> JsAcc
jsWith p kept acc d own = jsAt p kept acc d own (jsVer p d.key (fst own))

jsOne : JsProgram -> M.Map String JsKept -> JsAcc -> I.Def -> JsAcc
jsOne p kept acc d = jsWith p kept acc d (I.freshen 0 d.body)

-- (a definition's lines, and its curried form where it has one)
entryLines : JsProgram -> M.Map String Unit -> Pair String JsKept -> List String
entryLines p curried (MkPair key k) = case M.lookup compareString key p.info of
  Just i -> List.append k.lines (wrapper curried key i k.params)
  Nothing -> k.lines

-- (the program: the definitions used as values -- by `roots` too --
-- each with its curried form)
assembled : JsProgram
          -> List (Pair String JsKept)
          -> M.Map String Unit
          -> Emitted
assembled p es curried =
  emitLines
    p.info
    (List.concatMap (entryLines p curried) es)
    (primHelpersOf
       (setFrom
          (List.concatMap (\(e : Pair String JsKept) -> (snd e).prims) es)))

-- | the definitions printed, and those printed here, not taken from the
-- | cache (`kept`)
type EmittedKept = { emitted : Emitted, fresh : List (Pair String JsKept) }

emittedOf : JsProgram -> List String -> JsAcc -> EmittedKept
emittedOf p roots acc =
  { emitted =
      assembled
        p
        (List.reverse acc.entries)
        (setFrom
           (List.append
              (List.concatMap
                 (\(e : Pair String JsKept) -> (snd e).refs)
                 acc.entries)
              roots))
  , fresh = acc.fresh
  }

emitKeptIn : JsProgram
           -> List I.Def
           -> List String
           -> M.Map String JsKept
           -> EmittedKept
emitKeptIn p defs roots kept =
  emittedOf
    p
    roots
    (List.foldl (jsOne p kept) { entries = Nil, fresh = Nil } defs)

-- | the definitions (as both backends are given them), each printed --
-- | or taken as the cache keeps it, where it keeps it at its version --
-- | `roots` the globals the program's host uses
emitKept : F.Facts
         -> List I.Def
         -> List String
         -> M.Map String JsKept
         -> EmittedKept
emitKept facts defs roots kept =
  emitKeptIn
    (jsProgramOf facts (List.map (\(d : I.Def) -> d.key) defs))
    defs
    roots
    kept

-- | >>> (emitDefs (F.factsOf [I.mkDef "f" "f" (ELam ["x"] (EVar "x"))]) [I.mkDef "f" "f" (ELam ["x"] (EVar "x"))] ["f"]).lines
-- | ["", "const f = (x) => x;"]
emitDefs : F.Facts -> List I.Def -> List String -> Emitted
emitDefs facts defs roots = (emitKept facts defs roots M.empty).emitted

-- Runtime
--------------------------------------------------------------------------------

-- The runtime: a computation run by a handler whose (raw) monad is the
-- continuation monad, `(a -> ()) -> ()` -- the handler is the program's
-- (`heff.compile.lower`'s `lowerProgram`), its algebra `perform` handing each
-- operation here, to `$performer`.  An operation may finish later
-- (`Sleep`, `Fetch`, reading a file), and the rest of the computation
-- -- its continuation -- runs then: JavaScript's asynchrony, as a
-- handler, and the computation is the same whatever handles it.  There
-- is one monad for the whole program; each effect contributes an
-- algebra.  `perform` does an operation of the computation's effect:
-- `$sum` of two algebras gives each operation (`InL`, `InR`) to its
-- side's, and each world's algebra -- a provider's text, bundled
-- whole, its factories gathered (`$p0`, `$p1`, ...) -- knows its own
-- operations; what they hand out the world holds (`$world`), for them
-- all.  (An operation done at once goes on at once, the stack deeper
-- each time: every so often it goes on after the stack is let go of,
-- lest a long loop of them overflow it.)

runStr : String
runStr =
  joinWith
    "\n"
    [ "let $performer;"
    , "const $run = (entry, perform) => {"
    , "  const later = typeof setImmediate === \"function\" ? setImmediate : (f) => setTimeout(f, 0);"
    , "  let depth = 0;"
    , "  const now = (k) => (x) => { x = $tr(x); if (depth > 1000) { depth = 0; later(() => $tr(k(x))); return; } depth++; $tr(k(x)); };"
    , "  $performer = (p, k) => perform(p, now(k));"
    , "  return $tr(entry());"
    , "};"
    ]

sumStr : String
sumStr =
  "const $sum = (l, r) => (p, k) => p.$ === \"InL\" ? l(p.a[0], k) : r(p.a[0], k);"

-- The world: the things the providers hand out, held in one table for
-- them all, so that one effect's provider takes what another's handed
-- out (lib/std/handle.hf says how).  Each factory is given it.  A
-- thing's number is a BigInt, the same while it is held; released, the
-- thing is let go of (by `free`, if its holder gave one) and its number
-- is no one's again.
worldStr : String
worldStr =
  joinWith
    "\n"
    [ "const $world = (() => {"
    , "  const things = new Map(), numbers = new Map();"
    , "  let next = 0n;"
    , "  const at = (i) => { const t = things.get(i); if (!t) throw new Error(\"heff: the world holds nothing numbered \" + i); return t; };"
    , "  return {"
    , "    hold: (x, free) => { let i = numbers.get(x); if (i === undefined) { i = next++; numbers.set(x, i); things.set(i, { x, free }); } return i; },"
    , "    get: (i) => at(i).x,"
    , "    release: (i) => { const t = at(i); things.delete(i); numbers.delete(t.x); if (t.free) t.free(t.x); },"
    , "  };"
    , "})();"
    ]

hasSum : Ef.Effect -> Bool
hasSum (Plus _ _) = True
hasSum (Leaf _) = False

-- | the world's side of an effect: a provider module's name and text
-- | (`M.provider.js` beside `M.hf`; lib/browser/dom.provider.js says the
-- | shape)
type Provider = { module : String, text : String }

isImportLine : String -> Bool
isImportLine l = startsWith "import " l

-- (after `export const `, up to the ` `)
exportNameOf : String -> Maybe String
exportNameOf l =
  if startsWith "export const " l
    then case indexOf " " (strSlice l 13 (strLength l)) of
      Just i -> Just (strSlice l 13 (13 + i))
      Nothing -> Just (strSlice l 13 (strLength l))
  else Nothing

-- | the factories a provider exports, in the order it declares them
-- | (a `$`-named export is the provider speaking about itself, `$host`)
exportedNames : String -> List String
exportedNames text =
  List.filter
    (\n -> not (startsWith "$" n))
    (catMaybesL (List.map (\l -> exportNameOf l) (lines text)))

hostLineOf : String -> Maybe String
hostLineOf l =
  if startsWith "export const $host = \"" l
    then case indexOf "\"" (strSlice l 22 (strLength l)) of
      Just i -> Just (strSlice l 22 (22 + i))
      Nothing -> Just (strSlice l 22 (strLength l))
  else Nothing

-- | the one host a provider's world lives in (`export const $host =
-- | "page"`), if it says so; without it, any
hostOf : String -> Maybe String
hostOf text =
  List.head (catMaybesL (List.map (\l -> hostLineOf l) (lines text)))

unexportLine : String -> String
unexportLine l =
  if startsWith "export const " l then "const " ^ strSlice l 13 (strLength l)
  else l

-- the provider's own module, in a scope of its own: its import lines
-- are hoisted to the file's top, its exported factories handed out
bundleProvider : Int -> Provider -> String
bundleProvider i p =
  joinWith
    "\n"
    (List.append
       [ "// " ^ p.module ^ ".provider.js"
       , "const $p" ^ showInt i ^ " = (() => {"
       ]
       (List.append
          (List.map
             (\l -> unexportLine l)
             (List.filter (\l -> not (isImportLine l)) (lines p.text)))
          [ "return { " ^ joinWith ", " (exportedNames p.text) ^ " };"
          , "})();"
          ]))

bundleAll : Int -> List Provider -> List String
bundleAll i Nil = Nil
bundleAll i (Cons p rest) = Cons (bundleProvider i p) (bundleAll (i + 1) rest)

-- (the string helpers the providers use that the program's code, `have`,
-- has not brought already)
provStrHelpers : List String -> List Provider -> List String
provStrHelpers have provs =
  List.filter
    (\l -> not (List.any (\h -> strEq h l) have))
    (strHelpersIn (joinWith "\n" (List.map (\(p : Provider) -> p.text) provs)))

runtimeFor : Bool -> List String -> List Provider -> Ef.Effect -> String
runtimeFor hasTr have provs eff =
  joinWith
    "\n"
    (List.append
       (List.append
          (if hasTr then Nil else Cons trampolineStr Nil)
          [runStr, worldStr])
       (List.append
          (if hasSum eff then Cons sumStr Nil else Nil)
          (List.append (provStrHelpers have provs) (bundleAll 0 provs))))

provIndexGo : Int -> String -> List Provider -> Int
provIndexGo i md Nil = 0
provIndexGo i md (Cons p rest) =
  if strEq p.module md then i else provIndexGo (i + 1) md rest

-- (each effect's handler, an operation of a sum going to its side's; a
-- leaf's is its provider's factory, called for a fresh algebra, given
-- the world)
handlerOf : List Provider -> Ef.Effect -> String
handlerOf provs (Leaf k) =
  "$p"
  ^ showInt (provIndexGo 0 (Ef.moduleOfKey k) provs)
  ^ "."
  ^ Ef.nameOfKey k
  ^ "($world)"
handlerOf provs (Plus a b) =
  "$sum(" ^ handlerOf provs a ^ ", " ^ handlerOf provs b ^ ")"

-- Outputs
--------------------------------------------------------------------------------

findProv : String -> List Provider -> Maybe Provider
findProv md Nil = Nothing
findProv md (Cons p rest) =
  if strEq p.module md then Just p else findProv md rest

provsForGo : List Provider -> List String -> List Provider
provsForGo available Nil = Nil
provsForGo available (Cons md rest) = case findProv md available of
  Just p -> Cons p (provsForGo available rest)
  Nothing -> provsForGo available rest

-- (the chosen effect's providers, one per module, in the row's order)
provsFor : List Provider -> Ef.Effect -> List Provider
provsFor available eff =
  provsForGo
    available
    (nubStr (List.map (\k -> Ef.moduleOfKey k) (Ef.leaves eff)))

importLinesOf : List Provider -> List String
importLinesOf Nil = Nil
importLinesOf (Cons p rest) =
  List.append
    (List.filter (\l -> isImportLine l) (lines p.text))
    (importLinesOf rest)

-- (a Node.js program runs itself again in a thread of its own, whose
-- stack is deep enough for what a heff program does; the first thread
-- passes on its arguments and -- once the program reads it -- its
-- standard input, says whether its output is a terminal, and ends with
-- the program's status -- or, where the program asked to
-- (std.process's `exec`), runs a command in its place, on the same
-- standard streams, and ends with the command's status.
-- HEFF_HEAP_MB, if set, bounds the thread's heap)
nodeHead : List String
nodeHead =
  [ "#!/usr/bin/env node"
  , "// Generated from Hippogriff; do not edit."
  , "import { Worker as $Worker, isMainThread as $isMainThread, parentPort as $parentPort } from \"node:worker_threads\";"
  , "import { spawn as $spawn } from \"node:child_process\";"
  ]

nodeRun : String -> String
nodeRun run =
  joinWith
    "\n"
    [ "if ($isMainThread) {"
    , "  if (process.stdout.isTTY) process.env.HEFF_TTY = \"1\";"
    , "  const limits = { stackSizeMb: 512, maxOldGenerationSizeMb: Number(process.env.HEFF_HEAP_MB) || undefined };"
    , "  const worker = new $Worker(new URL(import.meta.url), { argv: process.argv.slice(2), resourceLimits: limits, stdin: true });"
    , "  let piped = false, exec = null;"
    , "  worker.on(\"message\", (m) => {"
    , "    if (m && m.stdin && !piped) { piped = true; process.stdin.pipe(worker.stdin); }"
    , "    if (m && m.exec) exec = m.exec;"
    , "  });"
    , "  worker.on(\"error\", (e) => { console.error(e); process.exitCode = 1; });"
    , "  worker.on(\"exit\", (code) => {"
    , "    if (piped) { process.stdin.unpipe(worker.stdin); process.stdin.destroy(); }"
    , "    if (!exec) { process.exitCode = code; return; }"
    , "    const child = $spawn(exec[0], exec[1], { stdio: \"inherit\" });"
    , "    child.on(\"error\", (e) => { console.error(e.message); process.exitCode = 1; });"
    , "    child.on(\"exit\", (status) => { process.exitCode = status ?? 1; });"
    , "  });"
    , "} else {"
    , "  process.stdin.once(\"resume\", () => $parentPort.postMessage({ stdin: true }));"
    , "  " ^ run
    , "}"
    ]

-- (the line that runs the program, as the host runs it)
runFor : String -> String -> String
runFor host run = if strEq host "node" then nodeRun run else run

-- | whether the program's code has the bounces' runtime already
definesTr : Emitted -> Bool
definesTr m = List.any (\l -> strEq l trampolineStr) m.lines

-- (a page loads its script as a classic script, not a module: what one
-- defines at its top is the page's, a global -- where `top`, the
-- page's own, cannot be defined again, and where two programs on a
-- page would both define `$run`.  So a page's program is a function's
-- body, called at once: what it defines is its own, and it runs in
-- strict mode, as a module does.  (Not a block: in a block, outside
-- strict mode, a `function` such as `$Bnc` would be the page's too.)
-- It needs nothing of the page but what is the page's already --
-- `document`, `setTimeout`, `fetch` -- and it starts itself, so it
-- gives the page nothing.)
scopeFor : String -> List String -> List String
scopeFor host body =
  if strEq host "page"
    then Cons
        "(() => {"
        (Cons "\"use strict\";" (List.append body ["})();", ""]))
  else List.append body [""]

runSource : String -> List Provider -> Ef.Effect -> String -> Emitted -> String
runSource host provs eff key m =
  joinWith
    "\n"
    (List.append
       (if strEq host "node" then nodeHead
        else Cons "// Generated from Hippogriff; do not edit." Nil)
       (List.append
          (nubStr (importLinesOf provs))
          (scopeFor
             host
             (List.append
                m.lines
                [ ""
                , runtimeFor (definesTr m) m.lines provs eff
                , ""
                , runFor
                  host
                  ("$run(() => "
                   ^ ref m.globals L.entryKey
                   ^ ", "
                   ^ handlerOf provs eff
                   ^ ");")
                ]))))

compileLowered : String
               -> List Provider
               -> Ef.Effect
               -> String
               -> L.LoweredShared
               -> Output
compileLowered host provs eff key l =
  { source =
      runSource
        host
        provs
        eff
        key
        (emitDefs l.facts l.defs (Cons L.entryKey Nil))
  , errors = l.errors
  }

-- | one file that runs a computation (`key`) of the effect `eff` on a
-- | host (`node`, `page`): the
-- | program, the runtime, and each world's algebra from its provider --
-- | it imports nothing but what the providers do (`node:` builtins,
-- | hoisted), so a page loads it from file:// too
compileProgram : String
               -> List Provider
               -> G.Globals
               -> String
               -> Ef.Effect
               -> Output
compileProgram host available g key eff =
  compileLowered host (provsFor available eff) eff key (L.lowerProgram g key)

-- | a program `compileProgram` makes through the backend's cache
-- | (heff.build.backcache), and what the cache is to keep anew
type OutputKept =
  { output : Output
  , groups : List L.GroupOut
  , copies : List Si.CopyDone
  , jss : List (Pair String JsKept)
  }

keptEmitted : String
            -> List Provider
            -> Ef.Effect
            -> String
            -> L.SimplifiedKept
            -> L.LoweredShared
            -> EmittedKept
            -> OutputKept
keptEmitted host provs eff key sk l ek =
  { output =
      { source = runSource host provs eff key ek.emitted, errors = l.errors }
  , groups = sk.groups
  , copies = sk.copies
  , jss = ek.fresh
  }

keptLowered : String
            -> List Provider
            -> Ef.Effect
            -> String
            -> M.Map String JsKept
            -> L.SimplifiedKept
            -> L.LoweredShared
            -> OutputKept
keptLowered host provs eff key kept sk l =
  keptEmitted
    host
    provs
    eff
    key
    sk
    l
    (emitKept l.facts l.defs (Cons L.entryKey Nil) kept)

keptOutput : String
           -> List Provider
           -> Ef.Effect
           -> String
           -> M.Map String JsKept
           -> L.SimplifiedKept
           -> OutputKept
keptOutput host provs eff key kept sk =
  keptLowered host provs eff key kept sk (L.sharedKeptOf sk)

-- | the program `compileProgram` makes, each definition of the core the
-- | cache keeps at its version (`vers`, `ks`, heff.compile.lower) taken
-- | as it keeps it, and each definition's JavaScript as it keeps it at
-- | what it is made of (`kept`)
compileProgramKept : String
                   -> List Provider
                   -> G.Globals
                   -> String
                   -> Ef.Effect
                   -> M.Map String String
                   -> L.Keeps
                   -> M.Map String JsKept
                   -> OutputKept
compileProgramKept host available g key eff vers ks kept =
  keptOutput
    host
    (provsFor available eff)
    eff
    key
    kept
    (L.lowerProgramKept g key vers ks)

getterOf : M.Map String GInfo -> Export -> String
getterOf gs o =
  "  get " ^ propName o.name ^ "() { return $ext(" ^ ref gs o.key ^ "); },"

jsSource : List Export -> Emitted -> String
jsSource exports m =
  joinWith
    "\n"
    (List.append
       (Cons "// Generated from Hippogriff; do not edit." Nil)
       (List.append
          m.lines
          (List.append
             (List.append
                (if definesTr m then Nil else Cons trampolineStr Nil)
                ["", extStr, "", "export default {"])
             (List.append
                (List.map
                   (\o -> getterOf m.globals o)
                   (List.filter
                      (\(o : Export) -> M.member compareString o.key m.globals)
                      exports))
                (Cons "};" (Cons "" Nil))))))

compileExports : List Export -> L.LoweredShared -> Output
compileExports exports l =
  { source =
      jsSource
        exports
        (emitDefs l.facts l.defs (List.map (\(o : Export) -> o.key) exports))
  , errors = l.errors
  }

-- | a module whose default export has the given definitions by the
-- | given names (all of them, by their keys, if none is given)
compileJsWith : G.Globals -> List Export -> Output
compileJsWith g exports =
  compileExports exports (L.lower g (List.map (\(o : Export) -> o.key) exports))

compileJs : G.Globals -> List Export -> Output
compileJs g exports0 =
  compileJsWith
    g
    (if List.null exports0
       then List.map
           (\p -> case p of
            MkPair k _ -> mkExport k k)
           (G.globalsList g)
     else exports0)
