-- From the core to what a backend emits -- the stages, in order, the
-- same for both backends (#40):
--
--   core ─[Erase]→ IR ─[Lift]→ ─[Worlds]→ ─[Shake]→ ─[Simplify]→ ─[Shake]→
--        ─[Once]→ ─[Fuse]→ ─[Shake]→ ─[Defun]→ ─[Call arity]→ ─[Arity]→ ─[TRMC]→
--        ─[Cycles]→ ─[Scalars]→ ─[Unbox]→ ─[CPR]→ ─[Records]→ ─[Shake]→ ─[Fuel]→ IR
--
-- (Fuel only where the program is built with fuel: heff.compile.fuel;
-- Worlds, heff.compile.worlds: a world of globals, a global of its own;
-- Records, heff.compile.records: a record of statics in a function, a
-- global of its own)
--
-- then, for the JavaScript backend, for each definition ─[Monadic]→
-- ─[Runes]→ ─[Imp]→ (`jsDef`, heff.compile.runes, heff.compile.imperative);
-- for the C backend, before
-- them, ─[Array loops]→ (heff.compile.arrayloops: a `generate` of a
-- lambda made a loop), and after, ─[Rematch]→
-- (heff.compile.rematch: a tag matched again where its arms part)
-- ─[Fields]→ (heff.compile.fields: a record read only field by field, read
-- where it is bound) ─[Tokens]→ (heff.compile.tokens: functions copied to be given a cell)
-- ─[Monadic]→
-- (`cKeptOf`, heff.compile.monadic: a binding for each value
-- computed, where its reference counts are taken and dropped) ─[Runes]→
-- (heff.compile.runes: a string's rune and its width read once) ─[Ranges]→
-- (heff.compile.ranges: an `Int` known to fit a word computed as one), then for
-- each definition ─[Imp]→ ─[Repr]→ ─[Rc]→ ─[Owned]→ ─[Tested]→ ─[Bounds]→
-- ─[Generate]→ (`cDef`: heff.compile.repr, the variables kept
-- unboxed; heff.compile.refcount; heff.compile.owned, a loop's array
-- checked held alone once; heff.compile.tested, a read where its index
-- was tested not checked again; heff.compile.bounds, a loop's index
-- checked in range and its arrays read checked flat once;
-- heff.compile.generate, an array generated of numbers built flat),
-- the functions' workers worked out first, of the whole program
-- (heff.compile.worker).  An emitter only prints what this makes.

module heff.compile.lower

import heff.compile.arrayloops as ArrayLoops
import heff.compile.borrow as Borrow
import heff.compile.bounds as Bounds
import heff.compile.cpr as CPR
import heff.compile.callarity as CallArity
import heff.compile.cycles as Cycles
import heff.compile.defun as Defun
import heff.compile.erase as Erase
import heff.compile.facts as Facts
import heff.compile.fields as Fields
import heff.compile.fuel as Fuel
import heff.compile.fuse as Fuse
import heff.compile.generate as Generate
import heff.elab.globals as Globals
import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.compile.irtext as IRText
import heff.compile.lift as Lift
import heff.compile.monadic as Monadic
import heff.compile.once as Once
import heff.compile.owned as Owned
import heff.elab.primitive
import heff.compile.ranges as Ranges
import heff.compile.refcount as RefCount
import heff.compile.records as Records
import heff.compile.rematch as Rematch
import heff.compile.runes as Runes
import heff.compile.repr as Repr
import heff.compile.scalars as Scalars
import heff.compile.shake as Shake
import heff.compile.statics as Statics
import heff.compile.tokens as Tokens
import heff.compile.simplify as Simplify
import heff.compile.tested as Tested
import heff.compile.trmc as TRMC
import heff.compile.worker as Worker
import heff.compile.worlds as Worlds
import std.ordmap as OrdMap

-- | the definitions, what is known of them (heff.compile.facts), and
-- | what could not be lowered, said by key: as a backend is given them
type Lowered = { defs : List IR.Def, facts : Facts.Facts, errors : List String }

-- | what a backend lowers on to, from what is reached of what is fused:
-- | given the roots, where fresh names go on from, the definitions, and
-- | what could not be lowered
type Rest = List String -> Int -> List IR.Def -> List String -> Lowered

-- (the arities, of the whole program, computed once)
saturated : OrdMap.OrdMap String Int -> CallArity.Called -> TRMC.Trmced
saturated ar c =
  TRMC.trmcProgram c.supply (List.map (\d -> CallArity.saturate ar d) c.defs)

calledShared : CallArity.Called -> TRMC.Trmced
calledShared c = saturated (CallArity.arities c.defs) c

-- (the definitions, and where fresh names go on from, as each pass after
-- TRMC gives them on)
trmced : Pair (List IR.Def) Int -> TRMC.Trmced
trmced (MkPair defs n) = { defs = defs, supply = n }

-- (... the functions calling one another last round a cycle made one)
cyclesShared : TRMC.Trmced -> TRMC.Trmced
cyclesShared t = trmced (Cycles.cyclesProgram t.supply t.defs)

-- (... a loop's record parameters carried round as their fields)
scalarsShared : TRMC.Trmced -> TRMC.Trmced
scalarsShared t = trmced (Scalars.scalarsProgram t.supply t.defs)

-- (... a loop's tag parameters carried round as their fields)
unboxShared : TRMC.Trmced -> TRMC.Trmced
unboxShared t = trmced (Scalars.unboxProgram t.supply t.defs)

shakenCprd : List String -> CPR.Cprd -> CPR.Cprd
shakenCprd roots c =
  { defs = Shake.shake roots c.defs, supply = c.supply, tuples = c.tuples }

fueledWith : CPR.Cprd -> Pair (List IR.Def) Int -> CPR.Cprd
fueledWith c (MkPair defs n) = { defs = defs, supply = n, tuples = c.tuples }

-- (... each function that may loop ticked at its entry, heff.compile.fuel,
-- where the program is built with fuel)
fueled : Bool -> CPR.Cprd -> CPR.Cprd
fueled False c = c
fueled True c = fueledWith c (Fuel.fuelProgram c.supply c.defs)

-- (... each record of statics in a function a global, heff.compile.records)
recordsCprd : CPR.Cprd -> CPR.Cprd
recordsCprd c =
  { defs = Records.recordsProgram c.defs, supply = c.supply, tuples = c.tuples }

-- (... a function giving back what it builds given a worker giving it
-- back taken apart, its records of statics globals, what is reached from
-- `roots` of that)
cprShared : Bool -> List String -> TRMC.Trmced -> CPR.Cprd
cprShared fuel roots t =
  fueled
    fuel
    (shakenCprd roots (recordsCprd (CPR.cprProgram t.supply t.defs)))

-- (a copy's continuations made tags, heff.compile.defun; then each call
-- at the arity it is made at)
defunCalled : Pair (List IR.Def) Int -> CallArity.Called
defunCalled (MkPair defs n) = CallArity.callArity n defs

-- | what both backends are given: the lambdas a recursive copy is
-- | handed by its group made tags (heff.compile.defun), each call at the arity it is made at,
-- | and each at its function's (heff.compile.callarity), a call of itself
-- | built around made a loop (heff.compile.trmc), functions calling one
-- | another last round a cycle made one loop (heff.compile.cycles), a loop's record parameters carried round as
-- | their fields, and its tag parameters too (heff.compile.scalars), a
-- | function giving back a tag it builds given a worker giving back its
-- | fields (heff.compile.cpr), each record of statics in a function a
-- | global (heff.compile.records), each function that may loop ticked at its
-- | entry (heff.compile.fuel); where fresh
-- | names go on from, and the workers giving back tuples
shared : Bool -> List String -> Int -> List IR.Def -> CPR.Cprd
shared fuel roots supply kept =
  cprShared
    fuel
    roots
    (unboxShared
       (scalarsShared
          (cyclesShared
             (calledShared (defunCalled (Defun.defunProgram supply kept))))))

-- (the definitions as both backends are given them, `shared`: the
-- JavaScript backend's, each made imperative apart, `jsDef`)
sharedLowered : List String -> CPR.Cprd -> Lowered
sharedLowered errors t =
  { defs = t.defs
  , facts = Facts.withTuples t.tuples (Facts.factsOf t.defs)
  , errors = errors
  }

-- (a string's rune and its width read once, heff.compile.runes; where
-- fresh names go on from)
runesRead : Pair (List IR.Def) Int -> Pair (List IR.Def) Int
runesRead (MkPair defs n) = Runes.runesProgram n defs

-- (the definition made imperative: as it is in monadic form, if it is)
jsImp : IR.Def -> Pair (List IR.Def) Int -> Imperative.Def
jsImp d (MkPair (Cons m _) n) = Imperative.impDef True n m
jsImp d (MkPair Nil n) = Imperative.impDef True n d

-- | a definition as the JavaScript backend prints it, from its body named
-- | again from 0 (`IR.freshen`: so that it is the same whatever is
-- | lowered with it, its names drawn past `n`): in monadic form
-- | (heff.compile.monadic), a rune and its width read once
-- | (heff.compile.runes), made imperative (heff.compile.imperative),
-- | each name used once next computed there (`Imperative.onceInlined`)
jsDef : IR.Def -> Pair IR.Expr Int -> Imperative.Def
jsDef d (MkPair b0 n) =
  Imperative.onceInlined
    (jsImp
       (IR.mkDef d.key d.name b0)
       (runesRead
          (Monadic.monadicFrom n (Cons (IR.mkDef d.key d.name b0) Nil))))

lowerKept : Bool -> Rest
lowerKept fuel roots supply kept errors =
  sharedLowered errors (shared fuel roots supply kept)

-- (... fused (heff.compile.fuse), and what is reached of that: what a
-- consumer was called on, made by a producer, gone)
onceFused : Pair (List IR.Def) Int -> Fuse.Fused
onceFused (MkPair defs n) = Fuse.fuseProgram n defs

-- (what is reached, each local function only called a global of its own
-- (heff.compile.lift), each function called once put where it is called
-- (heff.compile.once), fused)
fusedOf : List String -> Simplify.Simplified -> Fuse.Fused
fusedOf roots si =
  onceFused
    (Once.inlineOnce
       roots
       si.supply
       (Shake.shake roots (Lift.liftCalled si.defs)))

fusedWith : Rest -> List String -> List String -> Fuse.Fused -> Lowered
fusedWith rest roots errors f =
  rest roots f.supply (Shake.shake roots f.defs) errors

-- (... lowered on by the backend's `rest`)
simplifiedWith : Rest
               -> List String
               -> List String
               -> Simplify.Simplified
               -> Lowered
simplifiedWith rest roots errors si =
  fusedWith rest roots errors (fusedOf roots si)

erasedWith : Rest -> List String -> Erase.Erased -> Lowered
erasedWith rest roots er =
  simplifiedWith
    rest
    roots
    er.errors
    (Simplify.simplifyProgram
       er.supply
       (Shake.shake roots (Worlds.worldsProgram (Lift.liftProgram er.defs))))

-- | what is reached from `roots`, lowered; what cannot be, said by key
-- | >>> (lower Globals.emptyGlobals Nil).defs
-- | []
lower : Globals.Globals -> List String -> Lowered
lower g roots = erasedWith (lowerKept False) roots (Erase.eraseProgram g)

-- A program's entry: its computation (`key`) given the runtime's handler,
-- as a definition of its own.  The handler's monad is the continuation
-- monad (`(a -> ()) -> ()`, JavaScript's asynchrony as a handler), and
-- its algebra hands each operation to the world (`perform`, the
-- runtime's): so it is known where the program is, a record, and the
-- program's computations are simplified with it -- their handler's
-- `bind` and `ret` inlined, a copy of each made for it.
--
-- Where the world has the custodian's effect, the monad reads the
-- custodian current too, as Reader does (`Maybe Custodian -> (a -> ())
-- -> ()`, `Nothing` the root's): `bind` hands it on, the custodian's
-- `Under k body` runs `body` given `Just k`, and each operation tells
-- the runtime the one it is performed in (`CustodyIn`) just before it,
-- for the providers to read.  What an operation carries to run is given
-- the custodian current there by the provider that runs it.  A world
-- without custodians has no such argument; where it has std.domain's
-- effect, whose `rooted` reaches the runtime's custodians, what is due
-- is run before each operation all the same.

entryKey : String
entryKey = "run$entry"

-- | What a program's entry does of custodians: nothing; runs the
-- | releases due before each operation; or that, and reads the
-- | custodian current too.
data EntryCustody = NoCustody | DueOnly | Reading

-- (names of its own: `$`-numbered from where erasure's ended)
-- | what a program of the world whose effects are of these modules does
-- | of custodians: where it has the custodian's effect, it reads the one
-- | current and runs the releases due; where it has std.domain's, whose
-- | `rooted` gives a world without the custodian's effect the runtime's
-- | custodians, it runs the releases due
-- | >>> dueWorld ["std.io", "custodian"]
-- | Reading
-- | >>> dueWorld ["std.domain"]
-- | DueOnly
-- | >>> dueWorld ["std.io"]
-- | NoCustody
dueWorld : List String -> EntryCustody
dueWorld ms =
  if List.any (\m -> strEq m "custodian") ms then Reading
  else if List.any (\m -> strEq m "std.domain") ms then DueOnly
  else NoCustody

-- (a name of the entry's own, the `i`th after `n`)
entryName : String -> Int -> Int -> String
entryName s n i = s ^ "$" ^ debug (n + i)

-- (an operation performed: where releases are due, what is due on the
-- domain run first, and the custodian current told the runtime)
performed : EntryCustody -> Int -> IR.Expr
performed NoCustody n =
  EPrimCall Perform [EVar (entryName "p" n 6), EVar (entryName "k" n 7)]
performed DueOnly n =
  ELet
    (entryName "due" n 6)
    (EPrimCall CustodianDue Nil)
    (EPrimCall Perform [EVar (entryName "p" n 6), EVar (entryName "k" n 7)])
performed Reading n =
  ELet
    (entryName "due" n 6)
    (EPrimCall CustodianDue Nil)
    (ELet
       (entryName "in" n 11)
       (EPrimCall CustodyIn [EVar (entryName "c" n 12)])
       (EPrimCall Perform [EVar (entryName "p" n 6), EVar (entryName "k" n 7)]))

-- (the continuation monad's `ret`, `bind` and algebra, and the program's
-- computation run: given its handler, what follows it, and its end)
entryCps : EntryCustody -> String -> Int -> IR.Expr
entryCps due key n =
  EApp
    (EGlobal key)
    [ ERecord
      [ MkPair
        "ret"
        (ELam
           [entryName "x" n 0, entryName "k" n 1]
           (EApp (EVar (entryName "k" n 1)) [EVar (entryName "x" n 0)]))
      , MkPair
        "bind"
        (ELam
           [entryName "m" n 2, entryName "f" n 3, entryName "k" n 4]
           (EApp
              (EVar (entryName "m" n 2))
              [ ELam
                [entryName "x" n 5]
                (EApp
                   (EVar (entryName "f" n 3))
                   [EVar (entryName "x" n 5), EVar (entryName "k" n 4)])
              ]))
      , MkPair
        "malg"
        (ELam [entryName "p" n 6, entryName "k" n 7] (performed due n))
      ]
      [FtOther, FtOther, FtOther]
    , ELam
      [entryName "x" n 8, entryName "k" n 9]
      (EApp (EVar (entryName "k" n 9)) [EVar (entryName "x" n 8)])
    , ELam [entryName "x" n 10] (ETag "MkUnit" Nil Nil)
    ]

-- (... the monad reading the custodian current, `c$`: `Nothing` at first)
entryReading : String -> Int -> IR.Expr
entryReading key n =
  EApp
    (EGlobal key)
    [ ERecord
      [ MkPair
        "ret"
        (ELam
           [entryName "x" n 0, entryName "c" n 13, entryName "k" n 1]
           (EApp (EVar (entryName "k" n 1)) [EVar (entryName "x" n 0)]))
      , MkPair
        "bind"
        (ELam
           [ entryName "m" n 2
           , entryName "f" n 3
           , entryName "c" n 14
           , entryName "k" n 4
           ]
           (EApp
              (EVar (entryName "m" n 2))
              [ EVar (entryName "c" n 14)
              , ELam
                [entryName "x" n 5]
                (EApp
                   (EVar (entryName "f" n 3))
                   [ EVar (entryName "x" n 5)
                   , EVar (entryName "c" n 14)
                   , EVar (entryName "k" n 4)
                   ])
              ]))
      , MkPair
        "malg"
        (ELam
           [entryName "p" n 6, entryName "c" n 12, entryName "k" n 7]
           (performed Reading n))
      ]
      [FtOther, FtOther, FtOther]
    , ELam
      [entryName "x" n 8, entryName "c" n 15, entryName "k" n 9]
      (EApp (EVar (entryName "k" n 9)) [EVar (entryName "x" n 8)])
    , ETag "Nothing" Nil Nil
    , ELam [entryName "x" n 10] (ETag "MkUnit" Nil Nil)
    ]

entryBody : EntryCustody -> String -> Int -> IR.Expr
entryBody Reading key n = entryReading key n
entryBody due key n = entryCps due key n

-- (... its workers, of what else is known)
withWorkersOf : List IR.Def -> Facts.Facts -> Facts.Facts
withWorkersOf defs facts = Facts.withWorkers (Worker.workers facts defs) facts

-- (the C backend's: what each function is lent, too, the tags' fields
-- that may be flat, and its worker)
cFacts : List IR.Def -> Facts.Facts -> Facts.Facts
cFacts defs facts =
  withWorkersOf
    defs
    (Facts.withSureRecs
       (Facts.sureRecords defs)
       (Facts.withFlat (Facts.flatTags defs) (Facts.sureTags defs) facts))

-- (what each function is lent: not a copy's cell, which it is given,
-- heff.compile.tokens)
lentOf : Facts.Tokens -> List IR.Def -> OrdMap.OrdMap String (List Int)
lentOf tk defs =
  OrdMap.fromList
    (List.map
       (\p ->
          if OrdMap.member tk.cells (fst p)
          then MkPair (fst p) (List.keepIf (\i -> i /= 0) (snd p))
          else p)
       (OrdMap.toList (Borrow.borrowing defs)))

cLowered : List String
         -> OrdMap.OrdMap String Int
         -> Facts.Tokens
         -> Ranges.Ranged
         -> Lowered
cLowered errors tuples tk r =
  { defs = r.defs
  , facts =
      cFacts
        r.defs
        (Facts.withWords
           r.words
           (Facts.withTuples
              tuples
              (Facts.withLent
                 (lentOf tk r.defs)
                 (Facts.withTokens tk (Facts.factsOf r.defs)))))
  , errors = errors
  }

-- (in monadic form, a rune and its width read once, its `Int`s known
-- words done on words: heff.compile.ranges)
cTokened : List String -> OrdMap.OrdMap String Int -> Tokens.Tokened -> Lowered
cTokened errors tuples t =
  cLowered
    errors
    tuples
    t.tokens
    (Ranges.rangeProgram
       (fst (runesRead (Monadic.monadicFrom t.supply t.defs))))

-- (functions copied to be given a cell, heff.compile.tokens)
cRematched : List String
           -> OrdMap.OrdMap String Int
           -> Pair (List IR.Def) Int
           -> Lowered
cRematched errors tuples (MkPair defs n) =
  cTokened errors tuples (Tokens.tokensProgram tuples n defs)

-- (a record read only field by field read where it is bound,
-- heff.compile.fields)
fieldsRead : Pair (List IR.Def) Int -> Pair (List IR.Def) Int
fieldsRead (MkPair defs n) = Fields.fieldsProgram n defs

-- (a tag matched again where its arms part, heff.compile.rematch)
cShared : List String -> CPR.Cprd -> Lowered
cShared errors t =
  cRematched
    errors
    t.tuples
    (fieldsRead (Rematch.rematchProgram t.supply t.defs))

-- (... each `generate` of a lambda worth a loop made one first,
-- heff.compile.arrayloops)
cLooped : Bool
        -> List String
        -> List String
        -> Pair (List IR.Def) Int
        -> Lowered
cLooped fuel roots errors (MkPair defs n) =
  cShared errors (shared fuel roots n defs)

-- (as both backends have it, in monadic form: names from where the
-- simplifier's ended)
cKept : Bool -> Rest
cKept fuel roots supply kept errors =
  cLooped fuel roots errors (ArrayLoops.loopsProgram supply kept)

-- | what is reached from `roots`, lowered as `lower` does, then in
-- | monadic form
lowerC : Globals.Globals -> List String -> Lowered
lowerC g roots = erasedWith (cKept False) roots (Erase.eraseProgram g)

-- (a definition made imperative, its variables kept unboxed where they
-- may be (heff.compile.repr), its references counted (heff.compile.refcount),
-- its loops' arrays held alone where they may be (heff.compile.owned), and
-- read and set unchecked where their index is tested
-- (heff.compile.tested) or checked once, checked flat once where a loop
-- reads them (heff.compile.bounds), its arrays generated of numbers
-- built flat (heff.compile.generate), its value's constants laid out as
-- static data (heff.compile.statics))
rcOf : Facts.Facts -> Imperative.Def -> RefCount.Def
rcOf facts md =
  Statics.staticDef
    (Generate.generateDef
       (Bounds.boundsDef
          (Tested.testedDef
             (Owned.ownedDef
                (RefCount.rcDef
                   facts
                   (Repr.reprsWords
                      (Facts.knowOf facts)
                      (Facts.wordsOf facts (Imperative.defKey md))
                      md)
                   md)))))

-- | a definition of the C backend's, as it prints it, from its body named
-- | again from 0 (`IR.freshen`: so that it is the same whatever is
-- | lowered with it, its names drawn past `n`): made imperative
-- | (heff.compile.imperative), its variables kept unboxed where they may be,
-- | its references counted (`rcOf`)
cDef : Facts.Facts -> IR.Def -> Pair IR.Expr Int -> RefCount.Def
cDef facts d (MkPair b0 n) =
  rcOf facts (Imperative.impDef True n (IR.mkDef d.key d.name b0))

-- The backend's cache (heff.build.backcache)
--------------------------------------------------------------------------------

-- What a definition of the core is simplified to depends on what it is
-- made of alone (heff.compile.simplify), so the cache keeps it, by its
-- version -- what it is made of, hashed: given, for each definition of
-- the core (the elaboration cache's hash of it).  One it keeps at its
-- version is not erased again, nor simplified: what is lifted from it is
-- taken as it keeps it, by what it mentions (what it reaches), whether
-- it was safe before it was simplified, and what it was simplified to.

-- | a definition lifted from one of the core (itself among them), as the
-- | cache keeps it, with the globals its erased body mentions
type KeptUnit = { def : Simplify.KeptDef, refs : List String }

-- | what the cache keeps: for each definition of the core, by its key,
-- | the version it keeps it at and the definitions lifted from it, in
-- | order; the copies, by name
type Keeps =
  { units : OrdMap.OrdMap String (Pair String (List KeptUnit))
  , copies : OrdMap.OrdMap String Simplify.KeptCopy
  }

-- | the cache keeping nothing: each definition erased and simplified here
noKeeps : Keeps
noKeeps = { units = OrdMap.empty, copies = OrdMap.empty }

-- | a definition lifted from one of the core, simplified here, as the
-- | cache is to keep it
type UnitOut =
  { done : Simplify.Done
  , name : String
  , refs : List String
  , sgSafe : Bool
  , sgTotal : Int
  }

-- | the definitions lifted from one of the core (`owner`, at version
-- | `ver`), in order: each simplified here, or taken as the cache keeps
-- | it (`Nothing`)
type GroupOut =
  { owner : String, ver : String, units : List (Pair String (Maybe UnitOut)) }

-- | a program simplified -- what both backends lower on from -- what
-- | could not be, said by key, and what the cache is to keep of it
type SimplifiedKept =
  { simplified : Simplify.Simplified
  , errors : List String
  , groups : List GroupOut
  , copies : List Simplify.CopyDone
  }

-- | a program lowered for the C backend, and what the cache is to keep
type LoweredKept =
  { lowered : Lowered, groups : List GroupOut, copies : List Simplify.CopyDone }

-- | ... lowered on for the C backend, then in monadic form
-- | (heff.compile.monadic): what it emits, a binding for each value
-- | computed (where, with Perceus, references are taken and dropped)
cKeptOf : Bool -> SimplifiedKept -> LoweredKept
cKeptOf fuel sk =
  { lowered =
      simplifiedWith (cKept fuel) (Cons entryKey Nil) sk.errors sk.simplified
  , groups = sk.groups
  , copies = sk.copies
  }

-- | ... lowered on for the JavaScript backend
sharedKeptOf : Bool -> SimplifiedKept -> Lowered
sharedKeptOf fuel sk =
  simplifiedWith (lowerKept fuel) (Cons entryKey Nil) sk.errors sk.simplified

-- (what is to be simplified, from the definition of the core `owner`;
-- what it mentions)
type Piece =
  { owner : String
  , key : String
  , name : String
  , item : Simplify.Item
  , refs : List String
  }

-- (a definition of the core, erased: its local definitions lifted, its
-- worlds of globals each a global of its own)
liftedDefs : IR.Def -> List IR.Def
liftedDefs d = Worlds.worldsProgram (Lift.liftDef d)

findDef : String -> List IR.Def -> Maybe IR.Def
findDef k Nil = Nothing
findDef k (Cons d ds) = if strEq d.key k then Just d else findDef k ds

redoErased : String
           -> String
           -> Int
           -> Either String (Pair IR.Expr Int)
           -> Pair (Maybe IR.Def) Int
redoErased k uk n (Right (MkPair body n2)) =
  MkPair (findDef uk (liftedDefs (IR.mkDef k k body))) n2
redoErased k uk n (Left _) = MkPair Nothing n

keptPiece : Globals.Globals -> String -> Globals.Entry -> KeptUnit -> Piece
keptPiece g k e u =
  { owner = k
  , key = u.def.key
  , name = u.def.name
  , item =
      Kept u.def (\n -> redoErased k u.def.key n (Erase.definition g k e n))
  , refs = u.refs
  }

freshPiece : String -> IR.Def -> Piece
freshPiece k d =
  { owner = k
  , key = d.key
  , name = d.name
  , item = Fresh d
  , refs = IR.globalsIn d.body
  }

type PieceAcc = { pieces : List Piece, errors : List String, supply : Int }

revOnto : {a : Type} -> List a -> List a -> List a
revOnto Nil acc = acc
revOnto (Cons x xs) acc = revOnto xs (Cons x acc)

-- (the units the cache keeps for `k`, if at the version it has)
keptFor : OrdMap.OrdMap String String
        -> Keeps
        -> String
        -> Maybe (List KeptUnit)
keptFor vers ks k = case OrdMap.lookup ks.units k of
  Just (MkPair v us) ->
    if not (strEq v "")
       && strEq v (fromMaybe "" (OrdMap.lookup vers k))
    then Just us
    else Nothing
  Nothing -> Nothing

erasedPieces : String
             -> PieceAcc
             -> Either String (Pair IR.Expr Int)
             -> PieceAcc
erasedPieces k acc (Right (MkPair body n)) =
  { pieces =
      revOnto
        (List.map (freshPiece k) (liftedDefs (IR.mkDef k k body)))
        acc.pieces
  , errors = acc.errors
  , supply = n
  }
erasedPieces k acc (Left err) =
  { pieces = acc.pieces
  , errors = Cons (k ^ ": " ^ err) acc.errors
  , supply = acc.supply
  }

pieceStep : Globals.Globals
          -> OrdMap.OrdMap String String
          -> Keeps
          -> PieceAcc
          -> Pair String Globals.Entry
          -> PieceAcc
pieceStep g vers ks acc (MkPair k e) =
  if Erase.isType 0 e.type_ then acc
  else case keptFor vers ks k of
    Just us ->
      { pieces = revOnto (List.map (keptPiece g k e) us) acc.pieces
      , errors = acc.errors
      , supply = acc.supply
      }
    Nothing -> erasedPieces k acc (Erase.definition g k e acc.supply)

-- (the entry's version: its computation's, if it has one)
-- (the entry's version's prefix, by what it does of custodians)
entryPrefix : EntryCustody -> String
entryPrefix NoCustody = "entry/"
entryPrefix DueOnly = "entry-dueonly/"
entryPrefix Reading = "entry-due/"

entryVer : EntryCustody -> OrdMap.OrdMap String String -> String -> String
entryVer due vers key = case OrdMap.lookup vers key of
  Just v -> if strEq v "" then "" else entryPrefix due ^ v
  Nothing -> ""

entryKept : EntryCustody -> String -> KeptUnit -> Piece
entryKept due key u =
  { owner = entryKey
  , key = u.def.key
  , name = u.def.name
  , item =
      Kept
        u.def
        (\m ->
           MkPair
             (Just (IR.mkDef entryKey entryKey (entryBody due key m)))
             (m + 16))
  , refs = u.refs
  }

entryPieces : EntryCustody
            -> OrdMap.OrdMap String String
            -> Keeps
            -> String
            -> Int
            -> List Piece
entryPieces due vers ks key n = case keptFor vers ks entryKey of
  Just us -> List.map (entryKept due key) us
  Nothing ->
    Cons
      (freshPiece entryKey (IR.mkDef entryKey entryKey (entryBody due key n)))
      Nil

-- (each definition's version: of the definition of the core it is lifted
-- from, and of its key)
unitVers : OrdMap.OrdMap String String
         -> List Piece
         -> OrdMap.OrdMap String String
unitVers vers ps =
  List.foldl
    (\m (p : Piece) -> case OrdMap.lookup vers p.owner of
     Just v ->
       if strEq v "" then m
       else OrdMap.insert m p.key (IRText.hashOf [HS v, HS p.key])
     Nothing -> m)
    OrdMap.empty
    ps

doneMap : List Simplify.Done -> OrdMap.OrdMap String Simplify.Done
doneMap ds =
  List.foldl
    (\m (d : Simplify.Done) -> OrdMap.insert m d.key d)
    OrdMap.empty
    ds

unitOut : Simplify.SG
        -> OrdMap.OrdMap String Simplify.Done
        -> Piece
        -> Maybe UnitOut
unitOut sg dm p = case OrdMap.lookup dm p.key of
  Just d ->
    Just
      { done = d
      , name = p.name
      , refs = p.refs
      , sgSafe = OrdMap.member sg.safe p.key
      , sgTotal = fromMaybe (0 - 1) (OrdMap.lookup sg.total p.key)
      }
  Nothing -> Nothing

-- (one simplified here: the copies it asked for each with a version)
storable : Maybe UnitOut -> Bool
storable (Just u) = Simplify.allVersKnown u.done.touched
storable Nothing = True

-- (the pieces of each definition of the core, which are together)
groupCons : Piece -> List (List Piece) -> List (List Piece)
groupCons p (Cons (Cons q qs) rest) =
  if strEq p.owner q.owner then Cons (Cons p (Cons q qs)) rest
  else Cons (Cons p Nil) (Cons (Cons q qs) rest)
groupCons p gs = Cons (Cons p Nil) gs

groupGo : List Piece -> List (List Piece)
groupGo Nil = Nil
groupGo (Cons p ps) = groupCons p (groupGo ps)

-- (a definition of the core, to be kept anew: one with a version, of
-- which something was simplified here, each storable)
groupOut : OrdMap.OrdMap String String
         -> Simplify.SG
         -> OrdMap.OrdMap String Simplify.Done
         -> List Piece
         -> Maybe GroupOut
groupOut vers sg dm Nil = Nothing
groupOut vers sg dm (Cons p ps) =
  if strEq (fromMaybe "" (OrdMap.lookup vers p.owner)) ""
     || not
       (List.any (\(q : Piece) -> OrdMap.member dm q.key) (Cons p ps))
     || not (List.all (\q -> storable (unitOut sg dm q)) (Cons p ps))
  then Nothing
  else Just
      { owner = p.owner
      , ver = fromMaybe "" (OrdMap.lookup vers p.owner)
      , units =
          List.map (\(q : Piece) -> MkPair q.key (unitOut sg dm q)) (Cons p ps)
      }

keptLowered : List String
            -> OrdMap.OrdMap String String
            -> Simplify.SG
            -> List Piece
            -> Simplify.Simplified
            -> SimplifiedKept
keptLowered errors vers sg ps si =
  { simplified = si
  , errors = errors
  , groups =
      Simplify.catMaybesS
        (List.map (groupOut vers sg (doneMap si.done)) (groupGo ps))
  , copies = si.copies
  }

simplifyWith : List String
             -> OrdMap.OrdMap String String
             -> Keeps
             -> Int
             -> List Piece
             -> Simplify.SG
             -> SimplifiedKept
simplifyWith errors vers ks n ps sg =
  keptLowered
    errors
    vers
    sg
    ps
    (Simplify.simplifyItems
       n
       sg
       (unitVers vers ps)
       ks.copies
       (List.map (\(p : Piece) -> p.item) ps))

simplifyPieces : List String
               -> OrdMap.OrdMap String String
               -> Keeps
               -> Int
               -> List Piece
               -> SimplifiedKept
simplifyPieces errors vers ks n ps =
  simplifyWith
    errors
    vers
    ks
    n
    ps
    (Simplify.safeItems (List.map (\(p : Piece) -> p.item) ps))

refsMap : List Piece -> OrdMap.OrdMap String (List String)
refsMap ps =
  List.foldl
    (\m (q : Piece) -> OrdMap.insert m q.key q.refs)
    OrdMap.empty
    ps

reachedIn : OrdMap.OrdMap String Unit -> List Piece -> List Piece
reachedIn r ps = List.keepIf (\(p : Piece) -> OrdMap.member r p.key) ps

-- (what is reached from the entry)
reachedPieces : List Piece -> List Piece
reachedPieces ps = reachedIn (Shake.reached (Cons entryKey Nil) (refsMap ps)) ps

piecesWith : EntryCustody
           -> OrdMap.OrdMap String String
           -> Keeps
           -> String
           -> PieceAcc
           -> SimplifiedKept
piecesWith due vers ks key acc =
  simplifyPieces
    (List.reverse acc.errors)
    vers
    ks
    (acc.supply + 16)
    (reachedPieces
       (List.reverse
          (revOnto (entryPieces due vers ks key acc.supply) acc.pieces)))

-- | a program running the computation `key`, its entry (`entryKey`) and
-- | what it reaches, simplified -- each definition of the core the cache keeps at its version (`vers`)
-- | taken as it keeps it -- and what the cache is to keep of it
lowerProgramKept : EntryCustody
                 -> Globals.Globals
                 -> String
                 -> OrdMap.OrdMap String String
                 -> Keeps
                 -> SimplifiedKept
lowerProgramKept due g key vers ks =
  piecesWith
    due
    (OrdMap.insert vers entryKey (entryVer due vers key))
    ks
    key
    (List.foldl
       (pieceStep g vers ks)
       { pieces = Nil, errors = Nil, supply = 0 }
       (Globals.globalsList g))
