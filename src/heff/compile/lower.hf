-- From the core to what a backend emits -- the stages, in order, the
-- same for both backends (#40):
--
--   core ─[Erase]→ IR ─[Lift]→ ─[Shake]→ ─[Simplify]→ ─[Shake]→
--        ─[Fuse]→ ─[Shake]→ ─[Call arity]→ ─[Arity]→ ─[TRMC]→ ─[Early]→
--        ─[CPR]→ ─[Shake]→ IR
--
-- then, for the JavaScript backend, for each definition ─[Monadic]→
-- ─[Imp]→ (`jsDef`, heff.compile.imperative); for the C backend, ─[Monadic]→
-- (`lowerProgramC`, heff.compile.monadic: a binding for each value
-- computed, where its reference counts are taken and dropped), then for
-- each definition ─[Imp]→ ─[Repr]→ ─[Rc]→ (`cDef`: heff.compile.repr, the
-- variables kept unboxed; heff.compile.refcount), the functions' workers worked
-- out first, of the whole program (heff.compile.worker).  An emitter only
-- prints what this makes.

import heff.compile.arity as Arity
import heff.compile.borrow as Borrow
import heff.compile.cpr as Cpr
import heff.compile.callarity as CallArity
import heff.compile.early as Early
import heff.compile.erase as Erase
import heff.compile.facts as Facts
import heff.compile.fuse as Fuse
import heff.elab.globals as Globals
import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.compile.irtext as IRText
import heff.compile.lift as Lift
import heff.compile.monadic as Monadic
import heff.compile.refcount as RefCount
import heff.compile.repr as Repr
import heff.compile.shake as Shake
import heff.compile.simplify as Simplify
import heff.compile.trmc as TRMC
import heff.compile.worker as Worker
import map as Map

-- | the definitions, what is known of them (heff.compile.facts), and
-- | what could not be lowered, said by key
type Lowered = { defs : List IR.Def, facts : Facts.Facts, errors : List String }

-- (the arities, of the whole program, computed once)
saturated : Map.Map String Int -> CallArity.Called -> TRMC.Trmced
saturated ar c =
  TRMC.trmcProgram c.supply (List.map (\d -> Arity.saturate ar d) c.defs)

calledShared : CallArity.Called -> TRMC.Trmced
calledShared c = saturated (Arity.arities c.defs) c

-- (... the numbers of a record read after a call read before it)
readEarly : Pair (List IR.Def) Int -> TRMC.Trmced
readEarly (MkPair defs n) = { defs = defs, supply = n }

earlyShared : TRMC.Trmced -> TRMC.Trmced
earlyShared t = readEarly (Early.earlyProgram t.supply t.defs)

shakenCprd : List String -> Cpr.Cprd -> Cpr.Cprd
shakenCprd roots c =
  { defs = Shake.shake roots c.defs, supply = c.supply, tuples = c.tuples }

-- (... a function giving back what it builds given a worker giving it
-- back taken apart, what is reached from `roots` of that)
cprShared : List String -> TRMC.Trmced -> Cpr.Cprd
cprShared roots t = shakenCprd roots (Cpr.cprProgram t.supply t.defs)

-- | what both backends are given: each call at the arity it is made at,
-- | and each at its function's (heff.compile.arity), a call of itself
-- | built around made a loop (heff.compile.trmc), the numbers of a
-- | record read after a call read before it (heff.compile.early), a
-- | function giving back a tag it builds given a worker giving back its
-- | fields (heff.compile.cpr); where fresh names go on from, and the
-- | workers giving back tuples
shared : List String -> Int -> List IR.Def -> Cpr.Cprd
shared roots supply kept =
  cprShared roots (earlyShared (calledShared (CallArity.callArity supply kept)))

-- | the definitions as both backends are given them (`shared`), what is
-- | known of them, and what could not be lowered, said by key: the
-- | JavaScript backend's, each made imperative apart (`jsDef`)
type LoweredShared =
  { defs : List IR.Def, facts : Facts.Facts, errors : List String }

sharedLowered : List String -> Cpr.Cprd -> LoweredShared
sharedLowered errors t =
  { defs = t.defs
  , facts = Facts.withTuples t.tuples (Facts.factsOf t.defs)
  , errors = errors
  }

-- | a definition as the JavaScript backend prints it, from its body named
-- | again from 0 (`IR.freshen`: so that it is the same whatever is
-- | lowered with it, its names drawn past `n`): in monadic form
-- | (heff.compile.monadic), made imperative (heff.compile.imperative)
jsDef : IR.Def -> Pair IR.Expr Int -> Imperative.Def
jsDef d (MkPair b0 n) = case Monadic.monadicFrom
    n
    (Cons (IR.mkDef d.key d.name b0) Nil) of
  MkPair (Cons m _) n2 -> Imperative.impDef True n2 m
  MkPair Nil n2 -> Imperative.impDef True n2 (IR.mkDef d.key d.name b0)

lowerKept : List String -> Int -> List IR.Def -> List String -> LoweredShared
lowerKept roots supply kept errors =
  sharedLowered errors (shared roots supply kept)

-- (what is reached, fused (heff.compile.fuse), and what is reached of
-- that: what a consumer was called on, made by a producer, gone)
fusedOf : List String -> Simplify.Simplified -> Fuse.Fused
fusedOf roots si = Fuse.fuseProgram si.supply (Shake.shake roots si.defs)

lowerFused : List String -> List String -> Fuse.Fused -> LoweredShared
lowerFused roots errors f =
  lowerKept roots f.supply (Shake.shake roots f.defs) errors

lowerSimplified : List String
                -> List String
                -> Simplify.Simplified
                -> LoweredShared
lowerSimplified roots errors si = lowerFused roots errors (fusedOf roots si)

lowerErased : List String -> Erase.Erased -> LoweredShared
lowerErased roots er =
  lowerSimplified
    roots
    er.errors
    (Simplify.simplifyProgram
       er.supply
       (Shake.shake roots (Lift.liftProgram er.defs)))

-- | what is reached from `roots`, lowered; what cannot be, said by key
-- | >>> (lower Globals.emptyGlobals Nil).defs
-- | []
lower : Globals.Globals -> List String -> LoweredShared
lower g roots = lowerErased roots (Erase.eraseProgram g)

-- A program's entry: its computation (`key`) given the runtime's handler,
-- as a definition of its own.  The handler's monad is the continuation
-- monad (`(a -> ()) -> ()`, JavaScript's asynchrony as a handler), and
-- its algebra hands each operation to the world (`perform`, the
-- runtime's): so it is known where the program is, a record, and the
-- program's computations are simplified with it -- their handler's
-- `bind` and `ret` inlined, a copy of each made for it.

entryKey : String
entryKey = "run$entry"

-- (names of its own: `$`-numbered from where erasure's ended)
entryBody : String -> Int -> IR.Expr
entryBody key n =
  EApp
    (EGlobal key)
    [ ERecord
      [ MkPair
        "ret"
        (ELam
           ["x$" ^ show n, "k$" ^ show (n + 1)]
           (EApp (EVar ("k$" ^ show (n + 1))) [EVar ("x$" ^ show n)]))
      , MkPair
        "bind"
        (ELam
           [ "m$" ^ show (n + 2)
           , "f$" ^ show (n + 3)
           , "k$" ^ show (n + 4)
           ]
           (EApp
              (EVar ("m$" ^ show (n + 2)))
              [ ELam
                ["x$" ^ show (n + 5)]
                (EApp
                   (EVar ("f$" ^ show (n + 3)))
                   [ EVar ("x$" ^ show (n + 5))
                   , EVar ("k$" ^ show (n + 4))
                   ])
              ]))
      , MkPair
        "malg"
        (ELam
           ["p$" ^ show (n + 6), "k$" ^ show (n + 7)]
           (EPrimCall
              "perform"
              [EVar ("p$" ^ show (n + 6)), EVar ("k$" ^ show (n + 7))]))
      ]
      [FtOther, FtOther, FtOther]
    , ELam
      ["x$" ^ show (n + 8), "k$" ^ show (n + 9)]
      (EApp (EVar ("k$" ^ show (n + 9))) [EVar ("x$" ^ show (n + 8))])
    , ELam ["x$" ^ show (n + 10)] (ETag "MkUnit" Nil Nil)
    ]

withEntry : String -> Erase.Erased -> Erase.Erased
withEntry key er =
  { defs =
      List.append
        er.defs
        (Cons (IR.mkDef entryKey entryKey (entryBody key er.supply)) Nil)
  , errors = er.errors
  , supply = er.supply + 11
  }

-- | a program running the computation `key`: its entry (`entryKey`) and
-- | what it reaches, lowered
lowerProgram : Globals.Globals -> String -> LoweredShared
lowerProgram g key =
  lowerErased (Cons entryKey Nil) (withEntry key (Erase.eraseProgram g))

-- (... its workers, of what else is known)
withWorkersOf : List IR.Def -> Facts.Facts -> Facts.Facts
withWorkersOf defs facts = Facts.withWorkers (Worker.workers facts defs) facts

-- (the C backend's: what each function is lent, too, the tags' fields
-- that may be flat, and its worker)
cFacts : List IR.Def -> Facts.Facts -> Facts.Facts
cFacts defs facts =
  withWorkersOf
    defs
    (Facts.withSureRecs
       (Facts.sureRecords defs)
       (Facts.withFlat (Facts.flatTags defs) (Facts.sureTags defs) facts))

cLowered : List String -> Map.Map String Int -> List IR.Def -> Lowered
cLowered errors tuples defs =
  { defs = defs
  , facts =
      cFacts
        defs
        (Facts.withTuples
           tuples
           (Facts.withLent (Borrow.borrowing defs) (Facts.factsOf defs)))
  , errors = errors
  }

cShared : List String -> Cpr.Cprd -> Lowered
cShared errors t =
  cLowered errors t.tuples (Monadic.monadicProgram t.supply t.defs)

-- (as both backends have it, in monadic form: names from where the
-- simplifier's ended)
cKept : List String -> Int -> List IR.Def -> List String -> Lowered
cKept roots supply kept errors = cShared errors (shared roots supply kept)

cFused : List String -> List String -> Fuse.Fused -> Lowered
cFused roots errors f = cKept roots f.supply (Shake.shake roots f.defs) errors

cSimplified : List String -> List String -> Simplify.Simplified -> Lowered
cSimplified roots errors si = cFused roots errors (fusedOf roots si)

cErased : List String -> Erase.Erased -> Lowered
cErased roots er =
  cSimplified
    roots
    er.errors
    (Simplify.simplifyProgram
       er.supply
       (Shake.shake roots (Lift.liftProgram er.defs)))

-- | what is reached from `roots`, lowered as `lower` does, then in
-- | monadic form
lowerC : Globals.Globals -> List String -> Lowered
lowerC g roots = cErased roots (Erase.eraseProgram g)

-- | a program, lowered as `lowerProgram` does, then in monadic form
-- | (heff.compile.monadic): what the C backend emits, a binding for each value
-- | computed (where, with Perceus, references are taken and dropped)
lowerProgramC : Globals.Globals -> String -> Lowered
lowerProgramC g key =
  cErased (Cons entryKey Nil) (withEntry key (Erase.eraseProgram g))

-- (a definition made imperative, its variables kept unboxed where they
-- may be (heff.compile.repr), its references counted (heff.compile.refcount))
rcOf : Facts.Facts -> Imperative.Def -> RefCount.Def
rcOf facts md = RefCount.rcDef facts (Repr.reprsWith (Facts.knowOf facts) md) md

-- | a definition of the C backend's, as it prints it, from its body named
-- | again from 0 (`IR.freshen`: so that it is the same whatever is
-- | lowered with it, its names drawn past `n`): made imperative
-- | (heff.compile.imperative), its variables kept unboxed where they may be,
-- | its references counted (`rcOf`)
cDef : Facts.Facts -> IR.Def -> Pair IR.Expr Int -> RefCount.Def
cDef facts d (MkPair b0 n) =
  rcOf facts (Imperative.impDef True n (IR.mkDef d.key d.name b0))

-- The backend's cache (heff.build.backcache)
--------------------------------------------------------------------------------

-- What a definition of the core is simplified to depends on what it is
-- made of alone (heff.compile.simplify), so the cache keeps it, by its
-- version -- what it is made of, hashed: given, for each definition of
-- the core (the elaboration cache's hash of it).  One it keeps at its
-- version is not erased again, nor simplified: what is lifted from it is
-- taken as it keeps it, by what it mentions (what it reaches), whether
-- it was safe before it was simplified, and what it was simplified to.

-- | a definition lifted from one of the core (itself among them), as the
-- | cache keeps it, with the globals its erased body mentions
type KeptUnit = { def : Simplify.KeptDef, refs : List String }

-- | what the cache keeps: for each definition of the core, by its key,
-- | the version it keeps it at and the definitions lifted from it, in
-- | order; the copies, by name
type Keeps =
  { units : Map.Map String (Pair String (List KeptUnit))
  , copies : Map.Map String Simplify.KeptCopy
  }

-- | a definition lifted from one of the core, simplified here, as the
-- | cache is to keep it
type UnitOut =
  { done : Simplify.Done
  , name : String
  , refs : List String
  , sgSafe : Bool
  , sgTotal : Int
  }

-- | the definitions lifted from one of the core (`owner`, at version
-- | `ver`), in order: each simplified here, or taken as the cache keeps
-- | it (`Nothing`)
type GroupOut =
  { owner : String, ver : String, units : List (Pair String (Maybe UnitOut)) }

-- | a program simplified -- what both backends lower on from -- what
-- | could not be, said by key, and what the cache is to keep of it
type SimplifiedKept =
  { simplified : Simplify.Simplified
  , errors : List String
  , groups : List GroupOut
  , copies : List Simplify.CopyDone
  }

-- | a program lowered for the C backend, and what the cache is to keep
type LoweredKept =
  { lowered : Lowered, groups : List GroupOut, copies : List Simplify.CopyDone }

-- | ... lowered on as `lowerProgramC` does
cKeptOf : SimplifiedKept -> LoweredKept
cKeptOf sk =
  { lowered = cSimplified (Cons entryKey Nil) sk.errors sk.simplified
  , groups = sk.groups
  , copies = sk.copies
  }

-- | ... lowered on as `lowerProgram` does
sharedKeptOf : SimplifiedKept -> LoweredShared
sharedKeptOf sk = lowerSimplified (Cons entryKey Nil) sk.errors sk.simplified

-- (what is to be simplified, from the definition of the core `owner`;
-- what it mentions)
type Piece =
  { owner : String
  , key : String
  , name : String
  , item : Simplify.Item
  , refs : List String
  }

findDef : String -> List IR.Def -> Maybe IR.Def
findDef k Nil = Nothing
findDef k (Cons d ds) = if strEq d.key k then Just d else findDef k ds

redoErased : String
           -> String
           -> Int
           -> Either String (Pair IR.Expr Int)
           -> Pair (Maybe IR.Def) Int
redoErased k uk n (Right (MkPair body n2)) =
  MkPair (findDef uk (Lift.liftDef (IR.mkDef k k body))) n2
redoErased k uk n (Left _) = MkPair Nothing n

keptPiece : Globals.Globals -> String -> Globals.Entry -> KeptUnit -> Piece
keptPiece g k e u =
  { owner = k
  , key = u.def.key
  , name = u.def.name
  , item =
      Kept u.def (\n -> redoErased k u.def.key n (Erase.definition g k e n))
  , refs = u.refs
  }

freshPiece : String -> IR.Def -> Piece
freshPiece k d =
  { owner = k
  , key = d.key
  , name = d.name
  , item = Fresh d
  , refs = IR.globalsIn d.body
  }

type PieceAcc = { pieces : List Piece, errors : List String, supply : Int }

revOnto : {a : Type} -> List a -> List a -> List a
revOnto Nil acc = acc
revOnto (Cons x xs) acc = revOnto xs (Cons x acc)

-- (the units the cache keeps for `k`, if at the version it has)
keptFor : Map.Map String String -> Keeps -> String -> Maybe (List KeptUnit)
keptFor vers ks k = case Map.lookup compareString k ks.units of
  Just (MkPair v us) ->
    if not (strEq v "")
    && strEq v (fromMaybe "" (Map.lookup compareString k vers))
      then Just us
    else Nothing
  Nothing -> Nothing

erasedPieces : String
             -> PieceAcc
             -> Either String (Pair IR.Expr Int)
             -> PieceAcc
erasedPieces k acc (Right (MkPair body n)) =
  { pieces =
      revOnto
        (List.map (freshPiece k) (Lift.liftDef (IR.mkDef k k body)))
        acc.pieces
  , errors = acc.errors
  , supply = n
  }
erasedPieces k acc (Left err) =
  { pieces = acc.pieces
  , errors = Cons (k ^ ": " ^ err) acc.errors
  , supply = acc.supply
  }

pieceStep : Globals.Globals
          -> Map.Map String String
          -> Keeps
          -> PieceAcc
          -> Pair String Globals.Entry
          -> PieceAcc
pieceStep g vers ks acc (MkPair k e) =
  if Erase.isType 0 e.type_ then acc
  else case keptFor vers ks k of
    Just us ->
      { pieces = revOnto (List.map (keptPiece g k e) us) acc.pieces
      , errors = acc.errors
      , supply = acc.supply
      }
    Nothing -> erasedPieces k acc (Erase.definition g k e acc.supply)

-- (the entry's version: its computation's, if it has one)
entryVer : Map.Map String String -> String -> String
entryVer vers key = case Map.lookup compareString key vers of
  Just v -> if strEq v "" then "" else "entry/" ^ v
  Nothing -> ""

entryKept : String -> KeptUnit -> Piece
entryKept key u =
  { owner = entryKey
  , key = u.def.key
  , name = u.def.name
  , item =
      Kept
        u.def
        (\m ->
           MkPair
             (Just (IR.mkDef entryKey entryKey (entryBody key m)))
             (m + 11))
  , refs = u.refs
  }

entryPieces : Map.Map String String -> Keeps -> String -> Int -> List Piece
entryPieces vers ks key n = case keptFor vers ks entryKey of
  Just us -> List.map (entryKept key) us
  Nothing ->
    Cons
      (freshPiece entryKey (IR.mkDef entryKey entryKey (entryBody key n)))
      Nil

-- (each definition's version: of the definition of the core it is lifted
-- from, and of its key)
unitVers : Map.Map String String -> List Piece -> Map.Map String String
unitVers vers ps =
  List.foldl
    (\m (p : Piece) -> case Map.lookup compareString p.owner vers of
     Just v ->
       if strEq v "" then m
       else Map.insert compareString p.key (IRText.hashOf [HS v, HS p.key]) m
     Nothing -> m)
    Map.empty
    ps

doneMap : List Simplify.Done -> Map.Map String Simplify.Done
doneMap ds =
  List.foldl
    (\m (d : Simplify.Done) -> Map.insert compareString d.key d m)
    Map.empty
    ds

unitOut : Simplify.SG -> Map.Map String Simplify.Done -> Piece -> Maybe UnitOut
unitOut sg dm p = case Map.lookup compareString p.key dm of
  Just d ->
    Just
      { done = d
      , name = p.name
      , refs = p.refs
      , sgSafe = Map.member compareString p.key sg.safe
      , sgTotal = fromMaybe (0 - 1) (Map.lookup compareString p.key sg.total)
      }
  Nothing -> Nothing

-- (one simplified here: the copies it asked for each with a version)
storable : Maybe UnitOut -> Bool
storable (Just u) = Simplify.allVersKnown u.done.touched
storable Nothing = True

-- (the pieces of each definition of the core, which are together)
groupCons : Piece -> List (List Piece) -> List (List Piece)
groupCons p (Cons (Cons q qs) rest) =
  if strEq p.owner q.owner then Cons (Cons p (Cons q qs)) rest
  else Cons (Cons p Nil) (Cons (Cons q qs) rest)
groupCons p gs = Cons (Cons p Nil) gs

groupGo : List Piece -> List (List Piece)
groupGo Nil = Nil
groupGo (Cons p ps) = groupCons p (groupGo ps)

-- (a definition of the core, to be kept anew: one with a version, of
-- which something was simplified here, each storable)
groupOut : Map.Map String String
         -> Simplify.SG
         -> Map.Map String Simplify.Done
         -> List Piece
         -> Maybe GroupOut
groupOut vers sg dm Nil = Nothing
groupOut vers sg dm (Cons p ps) =
  if strEq (fromMaybe "" (Map.lookup compareString p.owner vers)) ""
  || not
    (List.any (\(q : Piece) -> Map.member compareString q.key dm) (Cons p ps))
  || not (List.all (\q -> storable (unitOut sg dm q)) (Cons p ps))
    then Nothing
  else Just
      { owner = p.owner
      , ver = fromMaybe "" (Map.lookup compareString p.owner vers)
      , units =
          List.map (\(q : Piece) -> MkPair q.key (unitOut sg dm q)) (Cons p ps)
      }

keptLowered : List String
            -> Map.Map String String
            -> Simplify.SG
            -> List Piece
            -> Simplify.Simplified
            -> SimplifiedKept
keptLowered errors vers sg ps si =
  { simplified = si
  , errors = errors
  , groups =
      Simplify.catMaybesS
        (List.map (groupOut vers sg (doneMap si.done)) (groupGo ps))
  , copies = si.copies
  }

simplifyWith : List String
             -> Map.Map String String
             -> Keeps
             -> Int
             -> List Piece
             -> Simplify.SG
             -> SimplifiedKept
simplifyWith errors vers ks n ps sg =
  keptLowered
    errors
    vers
    sg
    ps
    (Simplify.simplifyItems
       n
       sg
       (unitVers vers ps)
       ks.copies
       (List.map (\(p : Piece) -> p.item) ps))

simplifyPieces : List String
               -> Map.Map String String
               -> Keeps
               -> Int
               -> List Piece
               -> SimplifiedKept
simplifyPieces errors vers ks n ps =
  simplifyWith
    errors
    vers
    ks
    n
    ps
    (Simplify.safeItems (List.map (\(p : Piece) -> p.item) ps))

refsMap : List Piece -> Map.Map String (List String)
refsMap ps =
  List.foldl
    (\m (q : Piece) -> Map.insert compareString q.key q.refs m)
    Map.empty
    ps

reachedIn : Map.Map String Unit -> List Piece -> List Piece
reachedIn r ps =
  List.filter (\(p : Piece) -> Map.member compareString p.key r) ps

-- (what is reached from the entry)
reachedPieces : List Piece -> List Piece
reachedPieces ps = reachedIn (Shake.reached (Cons entryKey Nil) (refsMap ps)) ps

piecesWith : Map.Map String String
           -> Keeps
           -> String
           -> PieceAcc
           -> SimplifiedKept
piecesWith vers ks key acc =
  simplifyPieces
    (List.reverse acc.errors)
    vers
    ks
    (acc.supply + 11)
    (reachedPieces
       (List.reverse (revOnto (entryPieces vers ks key acc.supply) acc.pieces)))

-- | a program, simplified as `lowerProgram` and `lowerProgramC` do --
-- | each definition of the core the cache keeps at its version (`vers`)
-- | taken as it keeps it -- and what the cache is to keep of it
lowerProgramKept : Globals.Globals
                 -> String
                 -> Map.Map String String
                 -> Keeps
                 -> SimplifiedKept
lowerProgramKept g key vers ks =
  piecesWith
    (Map.insert compareString entryKey (entryVer vers key) vers)
    ks
    key
    (List.foldl
       (pieceStep g vers ks)
       { pieces = Nil, errors = Nil, supply = 0 }
       (Globals.globalsList g))
