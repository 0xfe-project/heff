-- Recursion modulo a constructor, and modulo a string append (#40): a
-- call of itself last but for what is put around it, made a loop, as a
-- call of itself last is.
--
-- A function that, where it ends, builds a tag whose last field is a
-- call of itself (`map f (x :: xs) = f x :: map f xs`) builds the tag
-- with a hole in that field, and a copy of it made to fill a hole
-- (`map$dps`, destination passing) fills it: given the cell and the
-- field, it puts there what the function would have given, and where
-- that is such a tag again, builds it with a hole, puts it there, and
-- goes round to fill its hole --
--
--   map f l = case l of                    map$dps f l d i = case l of
--     Nil -> Nil                             Nil -> setField d i Nil
--     x :: xs ->                             x :: xs ->
--       let c = f x :: _                       let c = f x :: _
--       let u = map$dps f xs c 1               let u = setField d i c
--       in c                                   in map$dps f xs u 1
--
-- so it is a call of itself last, a loop in either backend, however long
-- the list.  The cell is filled before anything else sees it: the hole is
-- `0`, which is no object, and `setField` puts the field's value there
-- and gives it back -- the cell the next round fills, held by the one
-- before it, so lent to the copy (heff.compile.borrow).
--
-- A function that ends in a string append whose right is a call of
-- itself (`showAll (x :: xs) = debug x ^ "," ^ showAll xs`) is given
-- what it has appended so far (`showAll$acc`), the left of each append
-- appended to it, in order, before it goes round.
--
-- This runs on what is lowered (heff.compile.lower), each call at its
-- arity, for both backends.

module heff.compile.trmc

import heff.compile.ir as IR
import heff.elab.primitive
import heff.compile.supply
import std.ordmap as OrdMap

-- | `setField d i v`: field `i` of the cell `d`, made here and seen by
-- | nothing else yet, set to `v`
setFieldPrim : Prim
setFieldPrim = SetField

-- | what a field waits as, a primitive: what each backend writes as
-- | nothing to drop (`undefined`; `0`, no object)
hole : IR.Expr
hole = EPrimCall Hole Nil

initOf : {a : Type} -> List a -> List a
initOf Nil = Nil
initOf (Cons x Nil) = Nil
initOf (Cons x xs) = Cons x (initOf xs)

-- | the function itself, called at its arity
type Self = { key : String, arity : Int }

selfCall : Self -> IR.Expr -> Bool
selfCall s (ECall g args) = strEq g s.key && List.length args == s.arity
selfCall s _ = False

-- | the fields' types of a tag built with a hole last: the hole's a `V`
-- | (it is no number to be kept flat, #64)
holeTys : List IR.FieldTy -> List IR.FieldTy
holeTys ts = List.append (initOf ts) [FtAny]

-- | a tag whose last field is a call of itself, or another such tag
consEnds : Self -> IR.Expr -> Bool
consEnds s (ETag t args _) = case List.last args of
  Just l -> selfCall s l || consEnds s l
  Nothing -> False
consEnds s _ = False

-- | a string append whose right is a call of itself, or another such
-- | append
appendEnds : Self -> IR.Expr -> Bool
appendEnds s (EPrimCall StrAppend (Cons a (Cons r Nil))) =
  selfCall s r || appendEnds s r
appendEnds s _ = False

-- (at each place the function ends at, `f`)
atTails : (IR.Expr -> S IR.Expr) -> IR.Expr -> S IR.Expr
atTails f e = IR.waysM (mo := instanceMonadS) f e

-- Destinations
--------------------------------------------------------------------------------

-- | the copy that fills a hole: its key, and the field it fills where
-- | every cell it is given is filled at the same one (a `Cons`'s tail,
-- | `1`), else a parameter of it
type Dps = { key : String, at : Maybe Int }

-- (where the copy is given the hole it fills: the cell, and the field if
-- it is a parameter)
dpsTail : Dps -> IR.Expr -> IR.Expr -> List IR.Expr
dpsTail p d i = case p.at of
  Just _ -> [d]
  Nothing -> [d, i]

-- | `e`, put in field `i` of the cell `d`: a call of itself goes round
-- | with the hole; a tag ending in one is built with a hole, put there,
-- | and its hole filled the same way
fill : Self -> Dps -> IR.Expr -> IR.Expr -> IR.Expr -> S IR.Expr
fill s p d i e =
  if selfCall s e
  then case e of
    ECall _ args -> pure (ECall p.key (List.append args (dpsTail p d i)))
    _ -> pure e
  else if consEnds s e
  then case e of
    ETag t args ts -> do
      c <- freshS "cell"
      u <- freshS "u"
      rest <-
        fill
          s
          p
          (EVar u)
          (EInt (List.length args - 1))
          (fromMaybe e (List.last args))
      pure
          (ELet
             c
             (ETag t (List.append (initOf args) [hole]) (holeTys ts))
             (ELet u (EPrimCall setFieldPrim [d, i, EVar c]) rest))
    _ -> pure e
  else pure (EPrimCall setFieldPrim [d, i, e])

-- | where the function itself ends in such a tag: the tag built with a
-- | hole, which the copy fills, and given
startCell : Self -> Dps -> IR.Expr -> S IR.Expr
startCell s p e =
  if consEnds s e
  then case e of
    ETag t args ts -> do
      c <- freshS "cell"
      u <- freshS "u"
      rest <-
        fill
          s
          p
          (EVar c)
          (EInt (List.length args - 1))
          (fromMaybe e (List.last args))
      pure
          (ELet
             c
             (ETag t (List.append (initOf args) [hole]) (holeTys ts))
             (ELet u rest (EVar c)))
    _ -> pure e
  else pure e

-- | the fields the copy is given cells to fill at, of a way out: a tag
-- | ending in a call of itself
holesAt : Self -> IR.Expr -> List Int
holesAt s (ETag t args _) = case List.last args of
  Just l ->
    if selfCall s l then [List.length args - 1]
    else if consEnds s l then holesAt s l
    else Nil
  Nothing -> Nil
holesAt s _ = Nil

-- | the one field every hole is at, if there is one
sameAt : List Int -> Maybe Int
sameAt Nil = Nothing
sameAt (Cons k ks) = if List.all (\j -> j == k) ks then Just k else Nothing

-- Accumulators
--------------------------------------------------------------------------------

strAppend : IR.Expr -> IR.Expr -> IR.Expr
strAppend a b = EPrimCall StrAppend [a, b]

-- | `e` appended to `acc` a piece at a time: an append on the left of
-- | another, `(x ^ ",") ^ f xs`, is not made a string of its own first
appendedTo : IR.Expr -> IR.Expr -> IR.Expr
appendedTo acc (EPrimCall StrAppend (Cons a (Cons b Nil))) =
  strAppend (appendedTo acc a) b
appendedTo acc e = strAppend acc e

-- | `e` appended to what is appended so far, `acc` (`ak`, the copy that
-- | is given it): the left of an append ending in a call of itself
-- | appended to it, and the call goes round with it
gather : Self -> String -> IR.Expr -> IR.Expr -> S IR.Expr
gather s ak acc e =
  if selfCall s e
  then case e of
    ECall _ args -> pure (ECall ak (List.append args [acc]))
    _ -> pure e
  else if appendEnds s e
  then case e of
    EPrimCall _ (Cons a (Cons r Nil)) -> do
      x <- freshS "s"
      rest <- gather s ak (EVar x) r
      pure (ELet x (appendedTo acc a) rest)
    _ -> pure e
  else pure (appendedTo acc e)

-- | where the function itself ends in such an append: its left is what
-- | is appended so far, computed first, as it was
startAcc : Self -> String -> IR.Expr -> S IR.Expr
startAcc s ak e =
  if appendEnds s e
  then case e of
    EPrimCall _ (Cons a (Cons r Nil)) -> do
      x <- freshS "s"
      rest <- gather s ak (EVar x) r
      pure (ELet x a rest)
    _ -> pure e
  else pure e

-- Products
--------------------------------------------------------------------------------

-- A function giving back a tag one field of which is built round what
-- a call of itself gave in that field, the others given back as the call
-- gave them -- a list rebuilt with what is threaded through it, `case
-- go s cs of MkRan cs2 z -> MkRan (c :: cs2) z` -- has a copy fill that
-- field instead: given the cell and the field, it gives back the tag
-- with a hole there, and what its call of itself gives, it gives back as
-- it is, a call last, so a loop --
--
--   go s l = case l of                     go$dps s l d = case l of
--     Nil -> MkRan Nil s                     Nil -> let u = setField d 1 Nil
--     c :: cs -> case go (s + c) cs of              in MkRan _ s
--       MkRan cs2 z -> MkRan (c :: cs2) z    c :: cs ->
--                                              let cell = c :: _
--                                              let u = setField d 1 cell
--                                              in go$dps (s + c) cs u
--
-- and the function itself builds the first cell, and takes apart what
-- the copy gives, the cell in that field.  What is built round the call
-- is built before it, so only of values, naming nothing the call gave.

-- | a call of itself taken apart, its fields given back as the call
-- | gave them but one (`field`), built round what it gave there: the
-- | call's arguments, the arm's names, the tag built
type Prod =
  { tag : String
  , field : Int
  , args : List IR.Expr
  , vs : List String
  , es : List IR.Expr
  , ts : List IR.FieldTy
  }

isJustP : {a : Type} -> Maybe a -> Bool
isJustP (Just _) = True
isJustP Nothing = False

nthOr : {a : Type} -> a -> Int -> List a -> a
nthOr d k Nil = d
nthOr d k (Cons x xs) = if k == 0 then x else nthOr d (k - 1) xs

-- (the list, its element `k` replaced by `x`)
replaceAt : {a : Type} -> Int -> a -> List a -> List a
replaceAt k x ys =
  List.zipWith
    (\i y -> if i == k then x else y)
    (List.range 0 (List.length ys - 1))
    ys

isTagE : IR.Expr -> Bool
isTagE (ETag _ _ _) = True
isTagE e = False

isVarNamed : String -> IR.Expr -> Bool
isVarNamed v (EVar w) = strEq v w
isVarNamed v e = False

-- (a value naming none of `vs`)
valueFree : List String -> IR.Expr -> Bool
valueFree vs e =
  IR.isValue e && List.all (\x -> (IR.occurrences x e).count == 0) vs

-- | a tag of values naming none of `vs` but its last field: the name
-- | `v`, or another such tag
chainTo : String -> List String -> IR.Expr -> Bool
chainTo v vs (ETag t args _) =
  List.all (valueFree vs) (initOf args)
  && maybe False (\l -> isVarNamed v l || chainTo v vs l) (List.last args)
chainTo v vs e = False

-- | the field of the hole the last tag of such a chain has
chainHole : IR.Expr -> Int
chainHole (ETag t args _) =
  maybe
    0
    (\l -> if isTagE l then chainHole l else List.length args - 1)
    (List.last args)
chainHole e = 0

-- (a field given back as the call gave it: the name the arm bound it to)
passes : Pair String IR.Expr -> Bool
passes (MkPair v e) = not (strEq v "_") && isVarNamed v e

-- (the one field not given back so, if it is built round what the call
-- gave there)
oneChain : List String -> List (Pair Int (Pair String IR.Expr)) -> Maybe Int
oneChain vs (Cons (MkPair j (MkPair v e)) Nil) =
  if not (strEq v "_") && chainTo v vs e then Just j else Nothing
oneChain vs ps = Nothing

prodAt : List String -> List IR.Expr -> Maybe Int
prodAt vs es =
  oneChain
    vs
    (List.keepIf
       (\p -> not (passes (snd p)))
       (List.zip (List.range 0 (List.length vs - 1)) (List.zip vs es)))

prodArm : Self -> List IR.Expr -> IR.Arm -> Maybe Prod
prodArm s args (MkArm t vs (ETag t2 es ts)) =
  if strEq t t2 && List.length vs == List.length es
  then maybe
      Nothing
      (\j ->
         Just { tag = t, field = j, args = args, vs = vs, es = es, ts = ts })
      (prodAt vs es)
  else Nothing
prodArm s args a = Nothing

prodArms : Self -> List IR.Expr -> List IR.Arm -> Maybe Prod
prodArms s args (Cons a Nil) = prodArm s args a
prodArms s args arms = Nothing

prodCall : Self -> IR.Expr -> List IR.Arm -> Maybe Prod
prodCall s (ECall g args) arms =
  if strEq g s.key && List.length args == s.arity then prodArms s args arms
  else Nothing
prodCall s c arms = Nothing

-- | a way out taking apart a call of itself so
prodOf : Self -> IR.Expr -> Maybe Prod
prodOf s (EMatch c arms) = prodCall s c arms
prodOf s e = Nothing

-- | the ways out of `e`, such a match one of them, `f` at each
prodTails : Self -> (IR.Expr -> S IR.Expr) -> IR.Expr -> S IR.Expr
prodTails s f (ELet x a b) = do
  b2 <- prodTails s f b
  pure (ELet x a b2)
prodTails s f (ESet xs a b) = do
  b2 <- prodTails s f b
  pure (ESet xs a b2)
prodTails s f (EMatch c arms) =
  if isJustP (prodOf s (EMatch c arms)) then f (EMatch c arms)
  else do
    arms2 <-
      traverseS
        (IR.traverseArmM (mo := instanceMonadS) (\_ b -> prodTails s f b))
        arms
    pure (EMatch c arms2)
prodTails s f e = f e

-- | ... listed
prodWays : Self -> IR.Expr -> List IR.Expr
prodWays s (ELet _ _ b) = prodWays s b
prodWays s (ESet _ _ b) = prodWays s b
prodWays s (EMatch c arms) =
  if isJustP (prodOf s (EMatch c arms)) then [EMatch c arms]
  else List.concatMap (\a -> prodWays s (IR.armBody a)) arms
prodWays s e = [e]

maybeList : {a : Type} -> Maybe a -> List a
maybeList (Just x) = [x]
maybeList Nothing = Nil

-- (a way out the copy may give: abandoned, the tag built, or a call of
-- itself taken apart as `q` is)
wayFits : Self -> Prod -> IR.Expr -> Bool
wayFits s q EAbandon = True
wayFits s q (ETag t es _) = strEq t q.tag && List.length es == List.length q.es
wayFits s q e =
  maybe
    False
    (\(r : Prod) -> strEq r.tag q.tag && r.field == q.field)
    (prodOf s e)

-- | the calls of itself taken apart so, where every way out fits them
-- | >>> List.map (\(q : Prod) -> q.field) (prodsOf { key = "f", arity = 1 } (EMatch (EVar "l") [MkArm "Nil" Nil (ETag "R" [ETag "Nil" Nil Nil, EVar "l"] [FtAny, FtAny]), MkArm "Cons" ["c", "cs"] (EMatch (ECall "f" [EVar "cs"]) [MkArm "R" ["r", "z"] (ETag "R" [ETag "Cons" [EVar "c", EVar "r"] [FtAny, FtAny], EVar "z"] [FtAny, FtAny])])]))
-- | [0]
prodsOf : Self -> IR.Expr -> List Prod
prodsOf s b =
  let ways = prodWays s b
  in let prods = List.concatMap (\w -> maybeList (prodOf s w)) ways
  in case prods of
  Cons q _ -> if List.all (wayFits s q) ways then prods else Nil
  Nil -> Nil

-- | the chain `e` built a cell at a time, each with a hole last, put in
-- | field `i` of `d`; then `k`, given the last cell and its hole's field
cells : IR.Expr
      -> IR.Expr
      -> IR.Expr
      -> (IR.Expr -> IR.Expr -> S IR.Expr)
      -> S IR.Expr
cells d i (ETag t args ts) k = do
  c <- freshS "cell"
  u <- freshS "u"
  rest <-
    cells
      (EVar u)
      (EInt (List.length args - 1))
      (fromMaybe EAbandon (List.last args))
      k
  pure
      (ELet
         c
         (ETag t (List.append (initOf args) [hole]) (holeTys ts))
         (ELet u (EPrimCall setFieldPrim [d, i, EVar c]) rest))
cells d i e k = k d i

-- (a field bound to a name first, unless it is a value: the fields
-- computed in their order, though one is put in a cell first)
fieldBound : IR.Expr -> S (Pair (List (Pair String IR.Expr)) IR.Expr)
fieldBound e =
  if IR.isValue e then pure (MkPair Nil e)
  else do
    x <- freshS "f"
    pure (MkPair [MkPair x e] (EVar x))

letsAround : List (Pair String IR.Expr) -> IR.Expr -> IR.Expr
letsAround Nil b = b
letsAround (Cons (MkPair x e) rest) b = ELet x e (letsAround rest b)

-- | a way out of the copy filling field `i` of `d`: a call of itself
-- | taken apart goes round, the cells built round it put there; a tag
-- | built puts its field `j` there, and is given with a hole in it
prodFill : Self -> Dps -> IR.Expr -> IR.Expr -> Int -> IR.Expr -> S IR.Expr
prodFill s p d i j (ETag t es ts) = do
  bs <- traverseS fieldBound es
  u <- freshS "u"
  let es2 = List.map snd bs
  pure
      (letsAround
         (List.concatMap fst bs)
         (ELet
            u
            (EPrimCall setFieldPrim [d, i, nthOr EAbandon j es2])
            (ETag t (replaceAt j hole es2) (replaceAt j FtAny ts))))
prodFill s p d i j e = case prodOf s e of
  Just q ->
    cells
      d
      i
      (nthOr EAbandon j q.es)
      (\d2 i2 -> pure (ECall p.key (List.append q.args (dpsTail p d2 i2))))
  Nothing -> pure e

-- | a way out of the function itself taking apart a call of itself so:
-- | the first cell built, the copy called to fill it, and what it gives
-- | taken apart, the cell in that field
prodStart : Self -> Dps -> Int -> IR.Expr -> S IR.Expr
prodStart s p j e = case prodOf s e of
  Just q -> case nthOr EAbandon j q.es of
    ETag t args ts -> do
      c <- freshS "cell"
      rest <-
        cells
          (EVar c)
          (EInt (List.length args - 1))
          (fromMaybe EAbandon (List.last args))
          (\d2 i2 ->
             pure
               (EMatch
                  (ECall p.key (List.append q.args (dpsTail p d2 i2)))
                  [ MkArm
                    q.tag
                    (replaceAt j "_" q.vs)
                    (ETag q.tag (replaceAt j (EVar c) q.es) q.ts)
                  ]))
      pure
          (ELet c (ETag t (List.append (initOf args) [hole]) (holeTys ts)) rest)
    _ -> pure e
  Nothing -> pure e

-- Calls bound
--------------------------------------------------------------------------------

-- What comes here is in monadic form (heff.compile.monadic): each
-- operand that computes bound first, in the order it is computed, so a
-- call of itself is bound too -- `let r = f xs in x :: r`, `let r = go s
-- cs in case r of ...` -- and what is put round it is computed before
-- it.  Where a way out is such a binding, its one use what is built
-- round it alone, the call is put back there: nothing is computed
-- between the two, so the order is the same, and the forms above see it.
-- What a way out computes after the call stays after it.

-- (`e` built round the name `r` alone: a tag whose last field is it, or
-- another such tag; an append whose right is it, or another such; a
-- match on it)
around : String -> IR.Expr -> Bool
around r (ETag _ args _) =
  maybe False (\l -> isVarNamed r l || around r l) (List.last args)
around r (EPrimCall StrAppend (Cons _ (Cons b Nil))) =
  isVarNamed r b || around r b
around r (EMatch c _) = isVarNamed r c
around r e = False

-- (`r` bound to `a` before `b`: the call put back where it is used, if
-- it is one of itself, used once, by what is built round it alone)
rebound : Self -> String -> IR.Expr -> IR.Expr -> IR.Expr
rebound s r a b =
  if selfCall s a && around r b && (IR.occurrences r b).count == 1
  then IR.subst (OrdMap.singleton r a) b
  else ELet r a b

-- | the ways out of `e`, a call of itself bound there and used once, by
-- | what is built round it alone, put back where it is used
-- | >>> unbound { key = "f", arity = 1 } (ELet "r" (ECall "f" [EVar "xs"]) (ETag "Cons" [EVar "x", EVar "r"] [FtAny, FtAny]))
-- | ETag "Cons" [EVar "x", ECall "f" [EVar "xs"]] [FtAny, FtAny]
unbound : Self -> IR.Expr -> IR.Expr
unbound s (ELet r a b) = rebound s r a (unbound s b)
unbound s (ESet xs a b) = ESet xs a (unbound s b)
unbound s (EMatch c arms) =
  EMatch c (List.map (IR.mapArm (\_ b -> unbound s b)) arms)
unbound s e = e

-- Definitions
--------------------------------------------------------------------------------

-- | `d` and the copy of it that fills a hole
destined : Self -> IR.Def -> List String -> IR.Expr -> S (List IR.Def)
destined s d xs b = do
  let p : Dps =
    { key = d.key ^ "$dps"
    , at = sameAt (List.concatMap (holesAt s) (IR.waysList b))
    }
  b0 <- atTails (startCell s p) b
  copy <- \n -> IR.freshen n (ELam xs b)
  dv <- freshS "d"
  iv <- freshS "i"
  copyDef <- case copy of
    ELam ys cb -> do
      cb' <-
        atTails
          (fill s p (EVar dv) (case p.at of
           Just k -> EInt k
           Nothing -> EVar iv))
          cb
      pure
          (IR.mkDef
             p.key
             (d.name ^ "$dps")
             (ELam
                (List.append ys (case p.at of
                 Just _ -> [dv]
                 Nothing -> [dv, iv]))
                cb'))
    _ -> pure (IR.mkDef p.key (d.name ^ "$dps") copy)
  pure [IR.mkDef d.key d.name (ELam xs b0), copyDef]

-- | `d` and the copy of it given what is appended so far
gathered : Self -> IR.Def -> List String -> IR.Expr -> S (List IR.Def)
gathered s d xs b = do
  b0 <- atTails (startAcc s (d.key ^ "$acc")) b
  copy <- \n -> IR.freshen n (ELam xs b)
  av <- freshS "acc"
  copyDef <- case copy of
    ELam ys cb -> do
      cb' <- atTails (gather s (d.key ^ "$acc") (EVar av)) cb
      pure
          (IR.mkDef
             (d.key ^ "$acc")
             (d.name ^ "$acc")
             (ELam (List.append ys [av]) cb'))
    _ -> pure (IR.mkDef (d.key ^ "$acc") (d.name ^ "$acc") copy)
  pure [IR.mkDef d.key d.name (ELam xs b0), copyDef]

-- (where the copy is given the field it fills: the one every cell is
-- filled at, else its parameter `iv`)
holeField : Dps -> String -> IR.Expr
holeField p iv = case p.at of
  Just k -> EInt k
  Nothing -> EVar iv

dpsParams : Dps -> String -> String -> List String
dpsParams p dv iv = case p.at of
  Just _ -> [dv]
  Nothing -> [dv, iv]

-- | `d` and the copy of it that fills field `j` of what it gives back,
-- | `prods` its calls of itself taken apart
producted : Self
          -> IR.Def
          -> List String
          -> IR.Expr
          -> List Prod
          -> Int
          -> S (List IR.Def)
producted s d xs b prods j = do
  let p : Dps =
    { key = d.key ^ "$dps"
    , at =
        sameAt
          (List.map (\(q : Prod) -> chainHole (nthOr EAbandon j q.es)) prods)
    }
  b0 <- prodTails s (prodStart s p j) b
  copy <- \n -> IR.freshen n (ELam xs b)
  dv <- freshS "d"
  iv <- freshS "i"
  copyDef <- case copy of
    ELam ys cb -> do
      cb' <- prodTails s (prodFill s p (EVar dv) (holeField p iv) j) cb
      pure
          (IR.mkDef
             p.key
             (d.name ^ "$dps")
             (ELam (List.append ys (dpsParams p dv iv)) cb'))
    _ -> pure (IR.mkDef p.key (d.name ^ "$dps") copy)
  pure [IR.mkDef d.key d.name (ELam xs b0), copyDef]

-- (... where it has such calls of itself)
productedOr : Self
            -> IR.Def
            -> List String
            -> IR.Expr
            -> List Prod
            -> S (List IR.Def)
productedOr s d xs b (Cons q rest) = producted s d xs b (Cons q rest) q.field
productedOr s d xs b Nil = pure [d]

-- | the definitions, and where fresh names go on from
type Trmced = { defs : List IR.Def, supply : Int }

defT : IR.Def -> S (List IR.Def)
defT d = case d.body of
  ELam xs b0 ->
    let s : Self = { key = d.key, arity = List.length xs }
    in let b = unbound s b0
    in if List.any (consEnds s) (IR.waysList b) then destined s d xs b
    else if List.any (appendEnds s) (IR.waysList b) then gathered s d xs b
    else productedOr s d xs b (prodsOf s b)
  _ -> pure [d]

-- | the definitions, each that ends in a call of itself put in a tag or
-- | right of a string append made a loop, names drawn from `supply` on
-- | >>> (trmcProgram 0 [IR.mkDef "f" "f" (ELam ["x"] (ETag "Cons" [EVar "x", ECall "f" [EVar "x"]] [FtAny, FtOther]))]).defs
-- | [{ key = "f", name = "f", body = ELam ["x"] (ELet "cell$0" (ETag "Cons" [EVar "x", EPrimCall Hole []] [FtAny, FtAny]) (ELet "u$1" (ECall "f$dps" [EVar "x", EVar "cell$0"]) (EVar "cell$0"))) }, { key = "f$dps", name = "f$dps", body = ELam ["x$2", "d$3"] (ELet "cell$5" (ETag "Cons" [EVar "x$2", EPrimCall Hole []] [FtAny, FtAny]) (ELet "u$6" (EPrimCall SetField [EVar "d$3", EInt 1, EVar "cell$5"]) (ECall "f$dps" [EVar "x$2", EVar "u$6"]))) }]
trmcProgram : Int -> List IR.Def -> Trmced
trmcProgram supply defs = case traverseS defT defs supply of
  MkPair dss n -> { defs = List.concatMap (\ds -> ds) dss, supply = n }
