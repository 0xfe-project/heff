-- Recursion modulo a constructor, and modulo a string append (#40): a
-- call of itself last but for what is put around it, made a loop, as a
-- call of itself last is.
--
-- A function that, where it ends, builds a tag whose last field is a
-- call of itself (`map f (x :: xs) = f x :: map f xs`) builds the tag
-- with a hole in that field, and a copy of it made to fill a hole
-- (`map$dps`, destination passing) fills it: given the cell and the
-- field, it puts there what the function would have given, and where
-- that is such a tag again, builds it with a hole, puts it there, and
-- goes round to fill its hole --
--
--   map f l = case l of                    map$dps f l d i = case l of
--     Nil -> Nil                             Nil -> setField d i Nil
--     x :: xs ->                             x :: xs ->
--       let c = f x :: _                       let c = f x :: _
--       let u = map$dps f xs c 1               let u = setField d i c
--       in c                                   in map$dps f xs c 1
--
-- so it is a call of itself last, a loop in either backend, however long
-- the list.  The cell is filled before anything else sees it: the hole is
-- `0`, which is no object, and `setField` puts the field's value there.
--
-- A function that ends in a string append whose right is a call of
-- itself (`showAll (x :: xs) = showInt x ^ "," ^ showAll xs`) is given
-- what it has appended so far (`showAll$acc`), the left of each append
-- appended to it, in order, before it goes round.
--
-- This runs on what is lowered (heff.compile.lower), each call at its
-- arity, for both backends.

import heff.compile.ir as IR

-- | computations drawing fresh names
type S a = Int -> Pair a Int

bindTake : {a b : Type} -> (a -> S b) -> Pair a Int -> Pair b Int
bindTake f (MkPair x n) = f x n

-- `do` is this
bind : {a b : Type} -> S a -> (a -> S b) -> S b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> S a
pure x = \n -> MkPair x n

traverseS : {a b : Type} -> (a -> S b) -> List a -> S (List b)
traverseS f Nil = pure Nil
traverseS f (Cons x xs) = do
  y <- f x
  ys <- traverseS f xs
  pure (Cons y ys)

freshS : String -> S String
freshS base = \n -> IR.fresh base n

-- | `setField d i v`: field `i` of the cell `d`, made here and seen by
-- | nothing else yet, set to `v`
setFieldPrim : String
setFieldPrim = "setField"

-- | what a field waits as, a primitive: what each backend writes as
-- | nothing to drop (`undefined`; `0`, no object)
hole : IR.Expr
hole = EPrimCall "hole" Nil

lastOf : List IR.Expr -> Maybe IR.Expr
lastOf Nil = Nothing
lastOf (Cons x Nil) = Just x
lastOf (Cons x xs) = lastOf xs

initOf : List IR.Expr -> List IR.Expr
initOf Nil = Nil
initOf (Cons x Nil) = Nil
initOf (Cons x xs) = Cons x (initOf xs)

-- | the function itself, called at its arity
type Self = { key : String, arity : Int }

selfCall : Self -> IR.Expr -> Bool
selfCall s (ECall g as) = strEq g s.key && List.length as == s.arity
selfCall s _ = False

-- | a tag whose last field is a call of itself, or another such tag
consEnds : Self -> IR.Expr -> Bool
consEnds s (ETag t as) = case lastOf as of
  Just l -> selfCall s l || consEnds s l
  Nothing -> False
consEnds s _ = False

-- | a string append whose right is a call of itself, or another such
-- | append
appendEnds : Self -> IR.Expr -> Bool
appendEnds s (EPrimCall p (Cons a (Cons r Nil))) =
  strEq p "strAppend" && (selfCall s r || appendEnds s r)
appendEnds s _ = False

-- | whether `p` holds of a place the function ends at
anyTail : (IR.Expr -> Bool) -> IR.Expr -> Bool
anyTail p (ELet _ _ b) = anyTail p b
anyTail p (EMatch _ arms) = List.any (\a -> anyTail p (IR.armBody a)) arms
anyTail p e = p e

-- (at each place the function ends at, `f`)
atTails : (IR.Expr -> S IR.Expr) -> IR.Expr -> S IR.Expr
atTails f (ELet x a b) = do
  b' <- atTails f b
  pure (ELet x a b')
atTails f (EMatch sc arms) = do
  arms' <-
    traverseS
      (\arm -> case arm of
       MkArm t vs b -> do
         b' <- atTails f b
         pure (MkArm t vs b'))
      arms
  pure (EMatch sc arms')
atTails f e = f e

-- Destinations
--------------------------------------------------------------------------------

-- | the copy that fills a hole: its key, and the field it fills where
-- | every cell it is given is filled at the same one (a `Cons`'s tail,
-- | `1`), else a parameter of it
type Dps = { key : String, at : Maybe Int }

-- (where the copy is given the hole it fills: the cell, and the field if
-- it is a parameter)
dpsTail : Dps -> IR.Expr -> IR.Expr -> List IR.Expr
dpsTail p d i = case p.at of
  Just _ -> [d]
  Nothing -> [d, i]

-- | `e`, put in field `i` of the cell `d`: a call of itself goes round
-- | with the hole; a tag ending in one is built with a hole, put there,
-- | and its hole filled the same way
fill : Self -> Dps -> IR.Expr -> IR.Expr -> IR.Expr -> S IR.Expr
fill s p d i e =
  if selfCall s e
    then case e of
      ECall _ as -> pure (ECall p.key (List.append as (dpsTail p d i)))
      _ -> pure e
  else if consEnds s e
    then case e of
      ETag t as -> do
        c <- freshS "cell"
        u <- freshS "u"
        rest <-
          fill
            s
            p
            (EVar c)
            (EInt (List.length as - 1))
            (fromMaybe e (lastOf as))
        pure
            (ELet
               c
               (ETag t (List.append (initOf as) [hole]))
               (ELet u (EPrimCall setFieldPrim [d, i, EVar c]) rest))
      _ -> pure e
  else pure (EPrimCall setFieldPrim [d, i, e])

-- | where the function itself ends in such a tag: the tag built with a
-- | hole, which the copy fills, and given
startCell : Self -> Dps -> IR.Expr -> S IR.Expr
startCell s p e =
  if consEnds s e
    then case e of
      ETag t as -> do
        c <- freshS "cell"
        u <- freshS "u"
        rest <-
          fill
            s
            p
            (EVar c)
            (EInt (List.length as - 1))
            (fromMaybe e (lastOf as))
        pure
            (ELet
               c
               (ETag t (List.append (initOf as) [hole]))
               (ELet u rest (EVar c)))
      _ -> pure e
  else pure e

-- | the fields the copy is given cells to fill at: of each tag ending in
-- | a call of itself, where it ends
holesAt : Self -> IR.Expr -> List Int
holesAt s (ELet _ _ b) = holesAt s b
holesAt s (EMatch _ arms) = List.concatMap (\a -> holesAt s (IR.armBody a)) arms
holesAt s (ETag t as) = case lastOf as of
  Just l ->
    if selfCall s l then [List.length as - 1]
    else if consEnds s l then holesAt s l
    else Nil
  Nothing -> Nil
holesAt s _ = Nil

-- | the one field every hole is at, if there is one
sameAt : List Int -> Maybe Int
sameAt Nil = Nothing
sameAt (Cons k ks) = if List.all (\j -> j == k) ks then Just k else Nothing

-- Accumulators
--------------------------------------------------------------------------------

strAppend : IR.Expr -> IR.Expr -> IR.Expr
strAppend a b = EPrimCall "strAppend" [a, b]

-- | `e` appended to what is appended so far, `acc` (`ak`, the copy that
-- | is given it): the left of an append ending in a call of itself
-- | appended to it, and the call goes round with it
gather : Self -> String -> IR.Expr -> IR.Expr -> S IR.Expr
gather s ak acc e =
  if selfCall s e
    then case e of
      ECall _ as -> pure (ECall ak (List.append as [acc]))
      _ -> pure e
  else if appendEnds s e
    then case e of
      EPrimCall _ (Cons a (Cons r Nil)) -> do
        x <- freshS "s"
        rest <- gather s ak (EVar x) r
        pure (ELet x (strAppend acc a) rest)
      _ -> pure e
  else pure (strAppend acc e)

-- | where the function itself ends in such an append: its left is what
-- | is appended so far, computed first, as it was
startAcc : Self -> String -> IR.Expr -> S IR.Expr
startAcc s ak e =
  if appendEnds s e
    then case e of
      EPrimCall _ (Cons a (Cons r Nil)) -> do
        x <- freshS "s"
        rest <- gather s ak (EVar x) r
        pure (ELet x a rest)
      _ -> pure e
  else pure e

-- Definitions
--------------------------------------------------------------------------------

-- | `d` and the copy of it that fills a hole
destined : Self -> IR.Def -> List String -> IR.Expr -> S (List IR.Def)
destined s d xs b = do
  let p : Dps = { key = d.key ^ "$dps", at = sameAt (holesAt s b) }
  b0 <- atTails (startCell s p) b
  copy <- \n -> IR.freshen n (ELam xs b)
  dv <- freshS "d"
  iv <- freshS "i"
  copyDef <- case copy of
    ELam ys cb -> do
      cb' <-
        atTails
          (fill s p (EVar dv) (case p.at of
           Just k -> EInt k
           Nothing -> EVar iv))
          cb
      pure
          (IR.mkDef
             p.key
             (d.name ^ "$dps")
             (ELam
                (List.append ys (case p.at of
                 Just _ -> [dv]
                 Nothing -> [dv, iv]))
                cb'))
    _ -> pure (IR.mkDef p.key (d.name ^ "$dps") copy)
  pure [IR.mkDef d.key d.name (ELam xs b0), copyDef]

-- | `d` and the copy of it given what is appended so far
gathered : Self -> IR.Def -> List String -> IR.Expr -> S (List IR.Def)
gathered s d xs b = do
  b0 <- atTails (startAcc s (d.key ^ "$acc")) b
  copy <- \n -> IR.freshen n (ELam xs b)
  av <- freshS "acc"
  copyDef <- case copy of
    ELam ys cb -> do
      cb' <- atTails (gather s (d.key ^ "$acc") (EVar av)) cb
      pure
          (IR.mkDef
             (d.key ^ "$acc")
             (d.name ^ "$acc")
             (ELam (List.append ys [av]) cb'))
    _ -> pure (IR.mkDef (d.key ^ "$acc") (d.name ^ "$acc") copy)
  pure [IR.mkDef d.key d.name (ELam xs b0), copyDef]

-- | the definitions, and where fresh names go on from
type Trmced = { defs : List IR.Def, supply : Int }

defT : IR.Def -> S (List IR.Def)
defT d = case d.body of
  ELam xs b ->
    let s : Self = { key = d.key, arity = List.length xs }
    in if anyTail (consEnds s) b then destined s d xs b
    else if anyTail (appendEnds s) b then gathered s d xs b
    else pure [d]
  _ -> pure [d]

-- | the definitions, each that ends in a call of itself put in a tag or
-- | right of a string append made a loop, names drawn from `supply` on
-- | >>> (trmcProgram 0 [IR.mkDef "f" "f" (ELam ["x"] (ETag "Cons" [EVar "x", ECall "f" [EVar "x"]]))]).defs
-- | [{ key = "f", name = "f", body = ELam ["x"] (ELet "cell$0" (ETag "Cons" [EVar "x", EPrimCall "hole" []]) (ELet "u$1" (ECall "f$dps" [EVar "x", EVar "cell$0"]) (EVar "cell$0"))) }, { key = "f$dps", name = "f$dps", body = ELam ["x$2", "d$3"] (ELet "cell$5" (ETag "Cons" [EVar "x$2", EPrimCall "hole" []]) (ELet "u$6" (EPrimCall "setField" [EVar "d$3", EInt 1, EVar "cell$5"]) (ECall "f$dps" [EVar "x$2", EVar "cell$5"]))) }]
trmcProgram : Int -> List IR.Def -> Trmced
trmcProgram supply defs = case traverseS defT defs supply of
  MkPair dss n -> { defs = List.concatMap (\ds -> ds) dss, supply = n }
