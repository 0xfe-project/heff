-- Only what is reached from the definitions asked for is kept.

module heff.compile.shake

import heff.compile.ir as IR
import std.ordmap as OrdMap

bodiesOf : List IR.Def -> OrdMap.OrdMap String IR.Expr
bodiesOf defs =
  List.foldl
    (\m (d : IR.Def) -> OrdMap.insert m d.key d.body)
    OrdMap.empty
    defs

appendK : {a : Type} -> List a -> List a -> List a
appendK Nil ys = ys
appendK (Cons x xs) ys = Cons x (appendK xs ys)

reachGo : OrdMap.OrdMap String IR.Expr
        -> OrdMap.OrdMap String Unit
        -> List String
        -> OrdMap.OrdMap String Unit
reachGo bodies seen Nil = seen
reachGo bodies seen (Cons head tail) =
  if OrdMap.member seen head then reachGo bodies seen tail
  else reachGo
      bodies
      (OrdMap.insert seen head MkUnit)
      (appendK
         (case OrdMap.lookup bodies head of
          Just b -> IR.globalsIn b
          Nothing -> Nil)
         tail)

filterReach : OrdMap.OrdMap String Unit -> List IR.Def -> List IR.Def
filterReach reached defs =
  List.keepIf (\(d : IR.Def) -> OrdMap.member reached d.key) defs

-- | >>> List.length (shake ["a"] [{ key = "a", name = "a", body = EGlobal "b" }, { key = "b", name = "b", body = EInt 1 }, { key = "c", name = "c", body = EInt 2 }])
-- | 2
shake : List String -> List IR.Def -> List IR.Def
shake roots defs = filterReach (reachGo (bodiesOf defs) OrdMap.empty roots) defs

reachBy : OrdMap.OrdMap String (List String)
        -> OrdMap.OrdMap String Unit
        -> List String
        -> OrdMap.OrdMap String Unit
reachBy refs seen Nil = seen
reachBy refs seen (Cons head tail) =
  if OrdMap.member seen head then reachBy refs seen tail
  else reachBy
      refs
      (OrdMap.insert seen head MkUnit)
      (appendK (fromMaybe Nil (OrdMap.lookup refs head)) tail)

-- | what is reached from `roots`, each definition known by the globals it
-- | mentions (`refs`)
reached : List String
        -> OrdMap.OrdMap String (List String)
        -> OrdMap.OrdMap String Unit
reached roots refs = reachBy refs OrdMap.empty roots
