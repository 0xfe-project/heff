-- Only what is reached from the definitions asked for is kept.

module heff.compile.shake

import heff.compile.ir as IR
import std.map as Map

bodiesOf : List IR.Def -> Map.Map String IR.Expr
bodiesOf defs =
  List.foldl
    (\m (d : IR.Def) -> Map.insert m d.key d.body)
    Map.empty
    defs

appendK : {a : Type} -> List a -> List a -> List a
appendK Nil ys = ys
appendK (Cons x xs) ys = Cons x (appendK xs ys)

reachGo : Map.Map String IR.Expr
        -> Map.Map String Unit
        -> List String
        -> Map.Map String Unit
reachGo bodies seen Nil = seen
reachGo bodies seen (Cons head tail) =
  if Map.member seen head then reachGo bodies seen tail
  else reachGo
      bodies
      (Map.insert seen head MkUnit)
      (appendK
         (case Map.lookup bodies head of
          Just b -> IR.globalsIn b
          Nothing -> Nil)
         tail)

filterReach : Map.Map String Unit -> List IR.Def -> List IR.Def
filterReach reached defs =
  List.filter (\(d : IR.Def) -> Map.member reached d.key) defs

-- | >>> List.length (shake ["a"] [{ key = "a", name = "a", body = EGlobal "b" }, { key = "b", name = "b", body = EInt 1 }, { key = "c", name = "c", body = EInt 2 }])
-- | 2
shake : List String -> List IR.Def -> List IR.Def
shake roots defs = filterReach (reachGo (bodiesOf defs) Map.empty roots) defs

reachBy : Map.Map String (List String)
        -> Map.Map String Unit
        -> List String
        -> Map.Map String Unit
reachBy refs seen Nil = seen
reachBy refs seen (Cons head tail) =
  if Map.member seen head then reachBy refs seen tail
  else reachBy
      refs
      (Map.insert seen head MkUnit)
      (appendK (fromMaybe Nil (Map.lookup refs head)) tail)

-- | what is reached from `roots`, each definition known by the globals it
-- | mentions (`refs`)
reached : List String -> Map.Map String (List String) -> Map.Map String Unit
reached roots refs = reachBy refs Map.empty roots
