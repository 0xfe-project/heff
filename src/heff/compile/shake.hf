-- Only what is reached from the definitions asked for is kept.

import heff.compile.ir as I
import map as M

bodiesOf : List I.Def -> M.Map String I.Expr
bodiesOf defs =
  List.foldl
    (\m (d : I.Def) -> M.insert compareString d.key d.body m)
    M.empty
    defs

appendK : {a : Type} -> List a -> List a -> List a
appendK Nil ys = ys
appendK (Cons x xs) ys = Cons x (appendK xs ys)

reachGo : M.Map String I.Expr
        -> M.Map String Unit
        -> List String
        -> M.Map String Unit
reachGo bodies seen Nil = seen
reachGo bodies seen (Cons head tail) =
  if M.member compareString head seen then reachGo bodies seen tail
  else reachGo
      bodies
      (M.insert compareString head MkUnit seen)
      (appendK
         (case M.lookup compareString head bodies of
          Just b -> I.globalsIn b
          Nothing -> Nil)
         tail)

filterReach : M.Map String Unit -> List I.Def -> List I.Def
filterReach reached defs =
  List.filter (\(d : I.Def) -> M.member compareString d.key reached) defs

-- | >>> List.length (shake ["a"] [{ key = "a", name = "a", body = EGlobal "b" }, { key = "b", name = "b", body = EInt 1 }, { key = "c", name = "c", body = EInt 2 }])
-- | 2
shake : List String -> List I.Def -> List I.Def
shake roots defs = filterReach (reachGo (bodiesOf defs) M.empty roots) defs

reachBy : M.Map String (List String)
        -> M.Map String Unit
        -> List String
        -> M.Map String Unit
reachBy refs seen Nil = seen
reachBy refs seen (Cons head tail) =
  if M.member compareString head seen then reachBy refs seen tail
  else reachBy
      refs
      (M.insert compareString head MkUnit seen)
      (appendK (fromMaybe Nil (M.lookup compareString head refs)) tail)

-- | what is reached from `roots`, each definition known by the globals it
-- | mentions (`refs`)
reached : List String -> M.Map String (List String) -> M.Map String Unit
reached roots refs = reachBy refs M.empty roots
