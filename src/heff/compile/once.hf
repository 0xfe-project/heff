-- Functions called once: a function the program calls at one place
-- alone -- given all its arguments there, not one of the roots, and up
-- to half again as big as the simplifier inlines (`onceMax`) -- is put
-- where it is called, its parameters bound to the arguments in order, as
-- the call binds them.  Nothing else reaches it then, so it is gone and
-- no code is copied, which is what the simplifier's limit on the size of
-- what it inlines (heff.compile.simplify) is for.  The call's cost goes,
-- and what the two did with a value between them is one piece of code:
-- a record built by one and updated by the other is updated in the cell
-- it was built in (heff.compile.refcount).
--
-- The simplifier decides by a definition and what it mentions alone, as
-- the backend's cache keeps it; how many places call a function is the
-- whole program's to say, so this runs after it, on what is reached,
-- before fusion copies what it fuses (heff.compile.lower), for both
-- backends.  A body put where it is called is moved, not copied, and
-- named afresh: it captures nothing.

module heff.compile.once

import heff.compile.ir as IR
import std.ordmap as OrdMap

-- What may be put where it is called
--------------------------------------------------------------------------------

-- | a function: its parameters and its body
type Callee = { xs : List String, b : IR.Expr }

-- | the most a function called once may be to be put where it is
-- | called: a caller made one function of many big ones, the passes
-- | after this one slower on it than on its parts (the compiler compiling
-- | itself 1% slower so, 1.5% at 100), and copied whole where a pass
-- | makes two of a function (heff.compile.trmc)
onceMax : Int
onceMax = 75

-- (the definition, if it is a function no bigger than that, not a root)
smallOf : List String -> String -> IR.Expr -> Maybe Callee
smallOf roots g (ELam xs b) =
  if not (IR.sizeAbove onceMax b) && not (List.elem g roots)
  then Just { xs = xs, b = b }
  else Nothing
smallOf roots g e = Nothing

insertJust : OrdMap.OrdMap String Callee
           -> String
           -> Maybe Callee
           -> OrdMap.OrdMap String Callee
insertJust m g (Just c) = OrdMap.insert m g c
insertJust m g Nothing = m

smallsOf : List String -> List IR.Def -> OrdMap.OrdMap String Callee
smallsOf roots defs =
  List.foldl
    (\m (d : IR.Def) -> insertJust m d.key (smallOf roots d.key d.body))
    OrdMap.empty
    defs

-- Calls counted
--------------------------------------------------------------------------------

-- | how a function is mentioned: how many times, and how many arguments
-- | the last was given (-1: none, mentioned as a value)
type Uses = { n : Int, args : Int }

usedOnce : Int -> Maybe Uses -> Uses
usedOnce k (Just u) = { n = u.n + 1, args = k }
usedOnce k Nothing = { n = 1, args = k }

-- (`g` mentioned, given `k` arguments: counted if it may be put where
-- it is called)
used : OrdMap.OrdMap String Callee
     -> OrdMap.OrdMap String Uses
     -> String
     -> Int
     -> OrdMap.OrdMap String Uses
used small m g k =
  if OrdMap.member small g
  then OrdMap.insert m g (usedOnce k (OrdMap.lookup m g))
  else m

-- (the functions the worklist mentions, onto `m`)
usesW : OrdMap.OrdMap String Callee
      -> OrdMap.OrdMap String Uses
      -> List IR.Expr
      -> OrdMap.OrdMap String Uses
usesW small m [] = m
usesW small m (EApp (EGlobal g) argv :: rest) =
  usesW small (used small m g (List.length argv)) (IR.appendI argv rest)
usesW small m (ECall g argv :: rest) =
  usesW small (used small m g (List.length argv)) (IR.appendI argv rest)
usesW small m (EGlobal g :: rest) = usesW small (used small m g (0 - 1)) rest
usesW small m (e :: rest) = usesW small m (IR.partsOnto e rest)

usesOf : OrdMap.OrdMap String Callee -> List IR.Def -> OrdMap.OrdMap String Uses
usesOf small defs =
  List.foldl
    (\m (d : IR.Def) -> usesW small m [d.body])
    OrdMap.empty
    defs

-- What is put where it is called
--------------------------------------------------------------------------------

calledOnce : Callee -> Maybe Uses -> Bool
calledOnce c (Just u) = u.n == 1 && u.args == List.length c.xs
calledOnce c Nothing = False

-- (... the function, if it is called once, given all its arguments, and
-- not by itself)
withOnce : OrdMap.OrdMap String Uses
         -> OrdMap.OrdMap String Callee
         -> Pair String Callee
         -> OrdMap.OrdMap String Callee
withOnce uses m (MkPair g c) =
  if calledOnce c (OrdMap.lookup uses g)
     && not (List.elem g (IR.globalsGo c.b))
  then OrdMap.insert m g c
  else m

calleesOf : List String -> List IR.Def -> OrdMap.OrdMap String Callee
calleesOf roots defs =
  let small = smallsOf roots defs
  in List.foldl
    (withOnce (usesOf small defs))
    OrdMap.empty
    (OrdMap.toList small)

-- (... named afresh: a function lifted out of another keeps the names
-- it had there, heff.compile.lift, and is put back among them here)
calleeFresh : OrdMap.OrdMap String Callee
            -> String
            -> Pair IR.Expr IR.Supply
            -> Pair (OrdMap.OrdMap String Callee) IR.Supply
calleeFresh m g (MkPair (ELam xs b) n) =
  MkPair (OrdMap.insert m g { xs = xs, b = b }) n
calleeFresh m g (MkPair e n) = MkPair m n

freshCallee : Pair (OrdMap.OrdMap String Callee) IR.Supply
            -> Pair String Callee
            -> Pair (OrdMap.OrdMap String Callee) IR.Supply
freshCallee (MkPair m n) (MkPair g c) =
  calleeFresh m g (IR.freshen n (ELam c.xs c.b))

freshCallees : IR.Supply
             -> OrdMap.OrdMap String Callee
             -> Pair (OrdMap.OrdMap String Callee) IR.Supply
freshCallees n cs =
  List.foldl freshCallee (MkPair OrdMap.empty n) (OrdMap.toList cs)

-- (the parameters bound to the arguments, in order, around the body)
bound : List String -> List IR.Expr -> IR.Expr -> IR.Expr
bound (x :: xs) (a :: argv) b = ELet x a (bound xs argv b)
bound _ _ b = b

-- (the call, made of its arguments `argv` by `call`, or the body of the
-- function called once, put through `go`)
calledAs : (IR.Expr -> IR.Expr)
         -> List IR.Expr
         -> (List IR.Expr -> IR.Expr)
         -> Maybe Callee
         -> IR.Expr
calledAs go argv call (Just c) = bound c.xs argv (go c.b)
calledAs go argv call Nothing = call argv

-- (the function called once, unless it is being put where it is called
-- already)
calleeAt : OrdMap.OrdMap String Callee -> List String -> String -> Maybe Callee
calleeAt cs going g = if List.elem g going then Nothing else OrdMap.lookup cs g

-- A match on what a body put here gives -- each way out of it building
-- a tag no other way builds, a lookup's `Nothing` and `Just` -- is given
-- to those ways: each arm moved to the one way that chooses it, none
-- copied, and no tag built.  It is the case of case the simplifier
-- makes, which ran before the body was put here.

armOf : String -> List IR.Arm -> Maybe IR.Arm
armOf t arms = List.find (\a -> strEq (IR.armTag a) t) arms

isJustO : {a : Type} -> Maybe a -> Bool
isJustO (Just _) = True
isJustO Nothing = False

-- (each tag built by one way out alone, and matched by an arm)
eachOnce : List IR.Arm -> List String -> Bool
eachOnce arms [] = True
eachOnce arms (t :: ts) =
  not (List.elem t ts) && isJustO (armOf t arms) && eachOnce arms ts

-- (each way out builds a tag or is abandoned)
movable : List IR.Arm -> IR.Ways -> Bool
movable arms (MkPair ts n) = n == 0 && eachOnce arms ts

-- (the arm chosen by the tag a way out builds, there: its fields bound)
chosen : List IR.Arm -> String -> List IR.Expr -> List IR.FieldTy -> IR.Expr
chosen arms t argv ts = case armOf t arms of
  Just a -> bound (IR.armVars a) argv (IR.armBody a)
  Nothing -> ETag t argv ts

-- (the arms given to a way out)
moved : List IR.Arm -> IR.Expr -> IR.Expr
moved arms (ETag t argv ts) = chosen arms t argv ts
moved arms e = e

-- A match of one arm taking apart a tag that many ways out build -- a
-- step function's `MkStepped y c s` from each of its equations -- is
-- what follows, once: the names it binds set by each way out, its
-- values (`ESet`, `EValues`), no tag built.  The simplifier does the
-- same with a binding taken apart at once (its `givenSet`).

-- (the values a way out gives: the fields of the tag `t`, `n` of them;
-- one abandoned gives none)
valuesOut : String -> Int -> IR.Expr -> Maybe IR.Expr
valuesOut t n EAbandon = Just EAbandon
valuesOut t n (ETag u argv _) =
  if strEq t u && List.length argv == n then Just (EValues argv) else Nothing
valuesOut t n e = Nothing

-- (the names set: a field bound to none, `_`, a name of its own, of
-- the name `x` the arm binds, which is the program's alone)
setNamesOf : String -> List String -> List String
setNamesOf x ys =
  List.zipWith
    (\y i -> if strEq y "_" then x ^ "$_" ^ debug i else y)
    ys
    (List.range 0 (List.length ys - 1))

-- (a tag a value of which may be taken for its fields: not a lazy
-- value's box, nor a worker's tuple)
apartTagOf : String -> Bool
apartTagOf t =
  not (strEq t IR.defaultTag)
  && not (strEq t "MkLazy")
  && not (IR.isTupleTag t)

-- (the names set by each way out, if it is such a match: some way out
-- builds the tag, a field of which is bound to a name)
setOf : IR.Expr -> List IR.Arm -> Maybe IR.Expr
setOf s [MkArm t vs b] = case List.find
    (\v -> not (strEq v "_"))
    vs of
  Just x ->
    if apartTagOf t && List.elem t (fst (IR.waysOut s))
    then maybe
        Nothing
        (\s2 -> Just (ESet (setNamesOf x vs) s2 b))
        (IR.waysM
           (mo := instanceMonadMaybe)
           (valuesOut t (List.length vs))
           s)
    else Nothing
  Nothing -> Nothing
setOf s arms = Nothing

-- | a match on `s`, given to its ways out where it may be
-- | >>> matchOn (EMatch (EVar "c") [MkArm "True" Nil (ETag "Nothing" Nil Nil), MkArm "False" Nil (ETag "Just" [EVar "x"] [FtAny])]) [MkArm "Just" ["y"] (EVar "y"), MkArm "Nothing" Nil (EInt 0)]
-- | EMatch (EVar "c") [MkArm "True" [] (EInt 0), MkArm "False" [] (ELet "y" (EVar "x") (EVar "y"))]
-- | >>> matchOn (EMatch (EVar "c") [MkArm "True" Nil (ETag "P" [EInt 1, EInt 2] [FtAny, FtAny]), MkArm "False" Nil (ETag "P" [EInt 3, EInt 4] [FtAny, FtAny])]) [MkArm "P" ["a", "_"] (EVar "a")]
-- | ESet ["a", "a$_1"] (EMatch (EVar "c") [MkArm "True" [] (EValues [EInt 1, EInt 2]), MkArm "False" [] (EValues [EInt 3, EInt 4])]) (EVar "a")
matchOn : IR.Expr -> List IR.Arm -> IR.Expr
matchOn s arms =
  if movable arms (IR.waysOut s) then IR.waysMap (moved arms) s
  else fromMaybe (EMatch s arms) (setOf s arms)

-- (a match, its parts gone through: given to its ways out where it may
-- be)
matchOnOf : IR.Expr -> IR.Expr
matchOnOf (EMatch s arms) = matchOn s arms
matchOnOf e = e

-- | an expression, each function called once in it put where it is
-- | called, and so on into it (`going`: those being put so)
inlined : OrdMap.OrdMap String Callee -> List String -> IR.Expr -> IR.Expr
inlined cs going (EApp (EGlobal g) argv) =
  calledAs
    (\b -> inlined cs (g :: going) b)
    (List.map (\a -> inlined cs going a) argv)
    (\argv2 -> EApp (EGlobal g) argv2)
    (calleeAt cs going g)
inlined cs going (ECall g argv) =
  calledAs
    (\b -> inlined cs (g :: going) b)
    (List.map (\a -> inlined cs going a) argv)
    (\argv2 -> ECall g argv2)
    (calleeAt cs going g)
inlined cs going (EMatch s arms) =
  matchOnOf (IR.mapParts (\_ p -> inlined cs going p) (EMatch s arms))
inlined cs going e = IR.mapParts (\_ p -> inlined cs going p) e

-- (the definitions but those put where they are called, each with
-- those in it put so)
inlinedDefs : List IR.Def
            -> OrdMap.OrdMap String Callee
            -> Pair (OrdMap.OrdMap String Callee) IR.Supply
            -> Pair (List IR.Def) IR.Supply
inlinedDefs defs cs (MkPair fresh n) =
  MkPair
    (List.map
       (\(d : IR.Def) -> IR.mkDef d.key d.name (inlined fresh Nil d.body))
       (List.keepIf (\(d : IR.Def) -> not (OrdMap.member cs d.key)) defs))
    n

-- | the program, each function called once put where it is called, named
-- | afresh, and gone: what reaches its call reaches it so, the caller
-- | from the roots or put where it is called in turn; where fresh names
-- | go on from
-- | >>> List.map (\(d : IR.Def) -> d.body) (fst (inlineOnce ["m"] 7 [IR.mkDef "f" "f" (ELam ["x"] (EPrimCall IntAdd [EVar "x", EInt 1])), IR.mkDef "m" "m" (EApp (EGlobal "f") [EInt 2])]))
-- | [ELet "x$7" (EInt 2) (EPrimCall IntAdd [EVar "x$7", EInt 1])]
inlineOnce : List String
           -> IR.Supply
           -> List IR.Def
           -> Pair (List IR.Def) IR.Supply
inlineOnce roots n defs =
  let cs = calleesOf roots defs
  in inlinedDefs defs cs (freshCallees n cs)
