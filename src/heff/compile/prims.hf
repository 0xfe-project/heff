-- The primitives, as the backend needs them -- each primitive's arity,
-- and its JavaScript (a curried function; `$T`/`$F` the answers, builtin's
-- True and False).

module heff.compile.prims

import heff.elab.fixed as Fixed

type PrimImpl = { arity : Int, js : String }

mkPrim : Int -> String -> PrimImpl
mkPrim arity js = { arity = arity, js = js }

-- (the rune at `i` of a string of bytes, a JavaScript string each of
-- whose code units is one of its bytes, and how many bytes it takes: an
-- ill-formed part U+FFFD, as long as the longest start of a well-formed
-- sequence it is (the "maximal subpart" WHATWG's decoder takes, as
-- `TextDecoder` does); `i` out of the string, U+FFFD of none)
utf8AtJs : String
utf8AtJs =
  joinWith
    " "
    [ "((s, i) => { const n = s.length; if (!(i >= 0 && i < n)) return [65533, 0];"
    , "const b = s.charCodeAt(i); if (b < 128) return [b, 1];"
    , "let m, c, lo = 128, hi = 191;"
    , "if (b >= 194 && b <= 223) { m = 1; c = b & 31; }"
    , "else if (b >= 224 && b <= 239) { m = 2; c = b & 15; if (b === 224) lo = 160; else if (b === 237) hi = 159; }"
    , "else if (b >= 240 && b <= 244) { m = 3; c = b & 7; if (b === 240) lo = 144; else if (b === 244) hi = 143; }"
    , "else return [65533, 1];"
    , "for (let k = 1; k <= m; k++) { const d = i + k < n ? s.charCodeAt(i + k) : -1;"
    , "if (d < lo || d > hi) return [65533, k]; lo = 128; hi = 191; c = c * 64 + (d & 63); }"
    , "return [c, m + 1]; })"
    ]

-- (the primitives of a string as bytes, UTF-8, as JavaScript has it: a
-- string each of whose code units is one of its bytes; its runes read
-- as `utf8AtJs` reads one, and a rune that is no scalar value U+FFFD in
-- a string; `strToJS` and `strFromJS` its text as JavaScript's string
-- and back, by the helpers a provider has, heff.compile.emit's
-- `strHelpers`)
bytePrims : List (Pair String PrimImpl)
bytePrims =
  [ MkPair
    "strByteAt"
    (mkPrim
       2
       "(a) => (i) => i >= 0n && i < BigInt(a.length) ? BigInt(a.charCodeAt(Number(i))) : -1n")
  , MkPair "strFromByte" (mkPrim 1 "(c) => String.fromCharCode(c)")
  , MkPair
    "strRuneAt"
    (mkPrim 2 ("(s) => (i) => " ^ utf8AtJs ^ "(s, Number(i))[0]"))
  , MkPair
    "strRuneWidth"
    (mkPrim 2 ("(s) => (i) => BigInt(" ^ utf8AtJs ^ "(s, Number(i))[1])"))
  , MkPair
    "strRuneCount"
    (mkPrim
       1
       ("(s) => { const at = "
        ^ utf8AtJs
        ^ "; let n = 0; for (let i = 0; i < s.length; i += at(s, i)[1]) n++; return BigInt(n); }"))
  , MkPair
    "strRunes"
    (mkPrim
       1
       ("(s) => { const at = "
        ^ utf8AtJs
        ^ "; const r = []; for (let i = 0; i < s.length;) { const b = s.charCodeAt(i); if (b < 128) { r.push(b); i++; } else { const [c, w] = at(s, i); r.push(c); i += w; } } let l = { $: \"Nil\", a: [] }; for (let i = r.length - 1; i >= 0; i--) l = { $: \"Cons\", a: [r[i], l] }; return l; }"))
  , MkPair
    "strOfRunes"
    (mkPrim
       1
       "(l) => { let s = \"\"; while (l.$ === \"Cons\") { let c = l.a[0]; if (!(c >= 0 && c <= 0x10FFFF && (c < 0xD800 || c > 0xDFFF))) c = 0xFFFD; s += c < 0x80 ? String.fromCharCode(c) : c < 0x800 ? String.fromCharCode(0xC0 | c >> 6, 0x80 | c & 63) : c < 0x10000 ? String.fromCharCode(0xE0 | c >> 12, 0x80 | c >> 6 & 63, 0x80 | c & 63) : String.fromCharCode(0xF0 | c >> 18, 0x80 | c >> 12 & 63, 0x80 | c >> 6 & 63, 0x80 | c & 63); l = l.a[1]; } return s; }")
  , MkPair "strToJS" (mkPrim 1 "(s) => $toJs(s)")
  , MkPair "strFromJS" (mkPrim 1 "(t) => $fromJs(t)")
  ]

-- (what the primitives of a binary's segments share, the runtime's
-- as JavaScript has them: `rd`, the `n` bits at bit `at`, the most
-- significant first; `le`, an integer of `n` bits little-endian (its
-- bytes the least significant first, then the bits left, the most
-- significant), as written (`out`) or read; `int`, an integer read as the
-- flags `f` say (1 little-endian, 2 signed); `word`, one as it is
-- written; `wr`, bits put where they are 0; `mk`, `Bits` of `n` bits (a
-- `Uint8Array`, its `bits` the length); `cp`, bits copied)
bitsJs : String
bitsJs =
  joinWith
    " "
    [ "const rd = (a, at, n) => { let u = 0n; if (at % 8 === 0 && n % 8 === 0) { for (let i = at / 8; i < (at + n) / 8; i++) u = (u << 8n) | BigInt(a[i]); } else { for (let i = at; i < at + n; i++) u = (u << 1n) | BigInt((a[i >> 3] >> (7 - (i & 7))) & 1); } return u; };"
    , "const le = (u, n, out) => { const k = n >> 3, r = n & 7; let w = 0n; if (out) { for (let i = 0; i < k; i++) w = (w << 8n) | ((u >> BigInt(8 * i)) & 255n); if (r) w = (w << BigInt(r)) | ((u >> BigInt(8 * k)) & BigInt((1 << r) - 1)); } else { if (r) w = (u & BigInt((1 << r) - 1)) << BigInt(8 * k); for (let i = 0; i < k; i++) w |= ((u >> BigInt(n - 8 * (i + 1))) & 255n) << BigInt(8 * i); } return w; };"
    , "const int = (a, at, n, f) => { let u = rd(a, at, n); if (f & 1n) u = le(u, n, false); return (f & 2n) ? BigInt.asIntN(n, u) : u; };"
    , "const word = (v, n, f) => { const u = BigInt.asUintN(n, v); return (f & 1n) ? le(u, n, true) : u; };"
    , "const wr = (a, at, w, n) => { for (let i = 0; i < n; i++) if ((w >> BigInt(n - 1 - i)) & 1n) a[(at + i) >> 3] |= 0x80 >> ((at + i) & 7); };"
    , "const mk = (n) => { const r = new Uint8Array((n + 7) >> 3); r.bits = n; return r; };"
    , "const cp = (d, at, s, from, n) => { let i = 0; if (at % 8 === 0 && from % 8 === 0) { d.set(s.subarray(from / 8, from / 8 + (n >> 3)), at / 8); i = n - (n & 7); } for (; i < n; i++) if ((s[(from + i) >> 3] >> (7 - ((from + i) & 7))) & 1) d[(at + i) >> 3] |= 0x80 >> ((at + i) & 7); };"
    ]

-- (`bytes`'s: a `Bytes` is a `Uint8Array`, never changed once made, a
-- byte a number; one made of a string, a byte of each code unit, and a
-- string made of one its text, UTF-8, as `TextDecoder` reads it (what is
-- not UTF-8 U+FFFD, a BOM kept), by heff.compile.emit's `$fromJs`)
bytesPrims : List (Pair String PrimImpl)
bytesPrims =
  [ MkPair "bytesLength" (mkPrim 1 "(a) => BigInt(a.length)")
  , MkPair
    "bytesAt"
    (mkPrim
       2
       "(a) => (i) => i >= 0n && i < BigInt(a.length) ? a[Number(i)] : $abandon()")
  , MkPair
    "bytesSlice"
    (mkPrim 3 "(a) => (i) => (j) => a.slice(Number(i), Number(j))")
  , MkPair
    "bytesAppend"
    (mkPrim
       2
       "(a) => (b) => { const r = new Uint8Array(a.length + b.length); r.set(a); r.set(b, a.length); return r; }")
  , MkPair
    "bytesConcat"
    (mkPrim
       1
       "(l) => { let n = 0; for (let c = l; c.$ === \"Cons\"; c = c.a[1]) n += c.a[0].length; const r = new Uint8Array(n); for (let k = 0; l.$ === \"Cons\"; l = l.a[1]) { r.set(l.a[0], k); k += l.a[0].length; } return r; }")
  , MkPair
    "bytesEq"
    (mkPrim
       2
       "(a) => (b) => { if (a.length !== b.length) return $F; for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return $F; return $T; }")
  , MkPair
    "bytesFromList"
    (mkPrim
       1
       "(l) => { const r = []; while (l.$ === \"Cons\") { r.push(l.a[0]); l = l.a[1]; } return Uint8Array.from(r); }")
  , MkPair
    "bytesToList"
    (mkPrim
       1
       "(a) => { let l = { $: \"Nil\", a: [] }; for (let i = a.length - 1; i >= 0; i--) l = { $: \"Cons\", a: [a[i], l] }; return l; }")
  , MkPair
    "bytesFromString"
    (mkPrim
       1
       "(s) => { const r = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) r[i] = s.charCodeAt(i); return r; }")
  , MkPair
    "bytesAsString"
    (mkPrim
       1
       "(a) => { let s = \"\"; for (let i = 0; i < a.length; i += 8192) s += String.fromCharCode.apply(null, a.subarray(i, i + 8192)); return s; }")
  , MkPair
    "bytesToString"
    (mkPrim
       1
       "(a) => $fromJs(new TextDecoder(\"utf-8\", { ignoreBOM: true }).decode(a))")
  -- (a binary's segments', as the runtime's: an integer of `n` bits
  -- at bit `o`, the flags `f` 1 for little-endian, 2 for signed)
  , MkPair
    "bytesIntAt"
    (mkPrim
       4
       ("(a) => (o) => (n) => (f) => { "
        ^ bitsJs
        ^ " const at = Number(o), m = Number(n); if (!(at >= 0 && m >= 0 && m <= 64 && at + m <= a.length * 8)) return $abandon(); return int(a, at, m, f); }"))
  , MkPair
    "bytesOfInt"
    (mkPrim
       3
       ("(n) => (f) => (v) => { "
        ^ bitsJs
        ^ " const m = Number(n); if (!(m >= 0 && m <= 64 && m % 8 === 0)) return $abandon(); const r = new Uint8Array(m / 8); wr(r, 0, word(v, m, f), m); return r; }"))
  , MkPair
    "bytesHasAt"
    (mkPrim
       3
       "(a) => (o) => (b) => { const at = Number(o); if (!(at >= 0 && at <= a.length - b.length)) return $F; for (let i = 0; i < b.length; i++) if (a[at + i] !== b[i]) return $F; return $T; }")
  ]

-- (`bits`'s: `Bits` are a `Uint8Array` whose `bits` is their length,
-- the bits past it 0, never changed once made; of bytes, and as bytes,
-- the same buffer; a `Float64`'s bits, IEEE's, of 64 or of 32, a NaN the
-- quiet one, its sign 0, as the runtime has them)
bitsPrims : List (Pair String PrimImpl)
bitsPrims =
  [ MkPair "bitsLength" (mkPrim 1 "(a) => BigInt(a.bits)")
  , MkPair
    "bitsIntAt"
    (mkPrim
       4
       ("(a) => (o) => (n) => (f) => { "
        ^ bitsJs
        ^ " const at = Number(o), m = Number(n); if (!(at >= 0 && m >= 0 && m <= 64 && at + m <= a.bits)) return $abandon(); return int(a, at, m, f); }"))
  , MkPair
    "bitsOfInt"
    (mkPrim
       3
       ("(n) => (f) => (v) => { "
        ^ bitsJs
        ^ " const m = Number(n); if (!(m >= 0 && m <= 64)) return $abandon(); const r = mk(m); wr(r, 0, word(v, m, f), m); return r; }"))
  , MkPair
    "bitsConcat"
    (mkPrim
       1
       ("(l) => { "
        ^ bitsJs
        ^ " let n = 0; for (let c = l; c.$ === \"Cons\"; c = c.a[1]) n += c.a[0].bits; const r = mk(n); for (let k = 0; l.$ === \"Cons\"; l = l.a[1]) { cp(r, k, l.a[0], 0, l.a[0].bits); k += l.a[0].bits; } return r; }"))
  , MkPair
    "bitsSlice"
    (mkPrim
       3
       ("(a) => (o) => (n) => { "
        ^ bitsJs
        ^ " const at = Number(o), m = Number(n); if (!(at >= 0 && m >= 0 && at + m <= a.bits)) return $abandon(); const r = mk(m); cp(r, 0, a, at, m); return r; }"))
  , MkPair
    "bitsOfBytes"
    (mkPrim
       1
       "(a) => { const r = new Uint8Array(a.buffer, a.byteOffset, a.length); r.bits = a.length * 8; return r; }")
  , MkPair
    "bitsBytes"
    (mkPrim
       1
       "(a) => a.bits % 8 !== 0 ? $abandon() : new Uint8Array(a.buffer, a.byteOffset, a.length)")
  , MkPair
    "bitsEq"
    (mkPrim
       2
       "(a) => (b) => { if (a.bits !== b.bits) return $F; for (let i = 0; i < a.length; i++) if (a[i] !== b[i]) return $F; return $T; }")
  , MkPair
    "floatBits"
    (mkPrim
       2
       "(n) => (x) => { const v = new DataView(new ArrayBuffer(8)); if (n === 64n) { if (x !== x) return 0x7ff8000000000000n; v.setFloat64(0, x); return v.getBigUint64(0); } if (n === 32n) { if (x !== x) return 0x7fc00000n; v.setFloat32(0, x); return BigInt(v.getUint32(0)); } return $abandon(); }")
  , MkPair
    "floatOfBits"
    (mkPrim
       2
       "(n) => (u) => { const v = new DataView(new ArrayBuffer(8)); if (n === 64n) { v.setBigUint64(0, BigInt.asUintN(64, u)); return v.getFloat64(0); } if (n === 32n) { v.setUint32(0, Number(BigInt.asUintN(32, u))); return v.getFloat32(0); } return $abandon(); }")
  ]

-- (std.math's, `floatSin` to `floatPow`: JavaScript's `Math`, as C's libm
-- has them -- `floatPow` as C's `pow`, where 1 to the power NaN is 1, and
-- so is -1 to an infinite one; a `Rune` is a number, its code point, of
-- 32 bits; a string is a JavaScript string each of whose code units is
-- one of its bytes, so that its length, a slice, `+`, `===` and `<` are
-- of bytes as they are)
-- (A division by 0 is 0, its remainder the dividend, computed as `a * b`
-- and `a - b`: an operation V8 has never seen run is a path it cuts, but
-- a constant or an argument returned there it joins to every quotient,
-- boxing each -- a third slower, where `%` is in a loop.)
-- (an array's elements, JavaScript's numbers -- a `Float64`'s, a
-- `Float32`'s, a fixed-width integer's of up to 32 bits -- as a
-- `Float64Array`, which holds each as it is: the array `r`'s)
numbersJs : String -> String
numbersJs r =
  "((r) => r.length > 0 && typeof r[0] === \"number\" ? Float64Array.from(r) : r)("
  ^ r
  ^ ")"

basicPrims : List (Pair String PrimImpl)
basicPrims =
  [ MkPair "intAdd" (mkPrim 2 "(a) => (b) => a + b")
  , MkPair "intSub" (mkPrim 2 "(a) => (b) => a - b")
  , MkPair "intMul" (mkPrim 2 "(a) => (b) => a * b")
  , MkPair
    "intDiv"
    (mkPrim
       2
       "(a) => (b) => { if (b === 0n) return a * b; const q = a / b, r = a % b; return r !== 0n && (r < 0n) !== (b < 0n) ? q - 1n : q; }")
  , MkPair
    "intMod"
    (mkPrim
       2
       "(a) => (b) => { if (b === 0n) return a - b; const r = a % b; return r !== 0n && (r < 0n) !== (b < 0n) ? r + b : r; }")
  , MkPair "intEq" (mkPrim 2 "(a) => (b) => a === b ? $T : $F")
  , MkPair "intLt" (mkPrim 2 "(a) => (b) => a < b ? $T : $F")
  , MkPair "intLe" (mkPrim 2 "(a) => (b) => a <= b ? $T : $F")
  , MkPair "intShow" (mkPrim 1 "(a) => a.toString()")
  , MkPair "intAnd" (mkPrim 2 "(a) => (b) => a & b")
  , MkPair "intOr" (mkPrim 2 "(a) => (b) => a | b")
  , MkPair "intXor" (mkPrim 2 "(a) => (b) => a ^ b")
  , MkPair "intShl" (mkPrim 2 "(a) => (b) => b < 0n ? a >> -b : a << b")
  , MkPair "intShr" (mkPrim 2 "(a) => (b) => b < 0n ? a << -b : a >> b")
  , MkPair "floatAdd" (mkPrim 2 "(a) => (b) => a + b")
  , MkPair "floatSub" (mkPrim 2 "(a) => (b) => a - b")
  , MkPair "floatMul" (mkPrim 2 "(a) => (b) => a * b")
  , MkPair "floatDiv" (mkPrim 2 "(a) => (b) => a / b")
  , MkPair "floatEq" (mkPrim 2 "(a) => (b) => a === b ? $T : $F")
  , MkPair "floatLt" (mkPrim 2 "(a) => (b) => a < b ? $T : $F")
  , MkPair "floatLe" (mkPrim 2 "(a) => (b) => a <= b ? $T : $F")
  , MkPair
    "floatShow"
    (mkPrim
       1
       "(a) => { const s = String(a); return isNaN(s + \".0\") ? s : s + \".0\"; }")
  , MkPair "floatFromInt" (mkPrim 1 "(a) => Number(a)")
  , MkPair "floatSqrt" (mkPrim 1 "(a) => Math.sqrt(a)")
  , MkPair
    "onWindows"
    (mkPrim
       1
       "(u) => typeof process !== \"undefined\" && process.platform === \"win32\" ? $T : $F")
  , MkPair
    "floatFloor"
    (mkPrim 1 "(a) => Number.isFinite(a) ? BigInt(Math.floor(a)) : 0n")
  , MkPair "floatSin" (mkPrim 1 "(a) => Math.sin(a)")
  , MkPair "floatCos" (mkPrim 1 "(a) => Math.cos(a)")
  , MkPair "floatTan" (mkPrim 1 "(a) => Math.tan(a)")
  , MkPair "floatAsin" (mkPrim 1 "(a) => Math.asin(a)")
  , MkPair "floatAcos" (mkPrim 1 "(a) => Math.acos(a)")
  , MkPair "floatAtan" (mkPrim 1 "(a) => Math.atan(a)")
  , MkPair "floatAtan2" (mkPrim 2 "(a) => (b) => Math.atan2(a, b)")
  , MkPair "floatExp" (mkPrim 1 "(a) => Math.exp(a)")
  , MkPair "floatLog" (mkPrim 1 "(a) => Math.log(a)")
  , MkPair
    "floatPow"
    (mkPrim
       2
       "(a) => (b) => a === 1 || (a === -1 && Math.abs(b) === Infinity) ? 1 : Math.pow(a, b)")
  , MkPair "arrayLength" (mkPrim 1 "(a) => BigInt(a.length)")
  , MkPair
    "arrayIndex"
    (mkPrim
       2
       "(a) => (i) => i >= 0n && i < BigInt(a.length) ? a[Number(i)] : $abandon()")
  , MkPair
    "arraySet"
    (mkPrim
       3
       "(a) => (i) => (x) => { if (!(i >= 0n && i < BigInt(a.length))) return a; const b = a.slice(); b[Number(i)] = x; return b; }")
  , MkPair
    "arrayGenerate"
    (mkPrim
       2
       ("(n) => (f) => "
        ^ numbersJs
          "Array.from({ length: n > 0n ? Number(n) : 0 }, (_, k) => $tr(f(BigInt(k))))"))
  , MkPair
    "arrayFromList"
    (mkPrim
       1
       ("(l) => { const r = []; while (l.$ === \"Cons\") { r.push(l.a[0]); l = l.a[1]; } return "
        ^ numbersJs "r"
        ^ "; }"))
  , MkPair
    "arrayToList"
    (mkPrim
       1
       "(a) => a.reduceRight((rest, x) => ({ $: \"Cons\", a: [x, rest] }), { $: \"Nil\", a: [] })")
  , MkPair
    "arrayReplicate"
    (mkPrim
       2
       "(n) => (x) => { const m = n > 0n ? Number(n) : 0; return typeof x === \"number\" ? new Float64Array(m).fill(x) : new Array(m).fill(x); }")
  , MkPair
    "arraySlice"
    (mkPrim 3 "(a) => (i) => (j) => a.slice(Number(i), Number(j))")
  , MkPair
    "arrayAppend"
    (mkPrim
       2
       "(a) => (b) => { if (b.length === 0) return a; if (a.length === 0) return b; if (!(a instanceof Float64Array)) return a.concat(b); const r = new Float64Array(a.length + b.length); r.set(a); r.set(b, a.length); return r; }")
  , MkPair "hole" (mkPrim 0 "undefined")
  , MkPair
    "setField"
    (mkPrim 3 "(d) => (i) => (v) => { d.a[i] = v; return d; }")
  , MkPair "strAppend" (mkPrim 2 "(a) => (b) => a + b")
  , MkPair "strLength" (mkPrim 1 "(a) => BigInt(a.length)")
  , MkPair
    "strSlice"
    (mkPrim 3 "(a) => (i) => (j) => a.slice(Number(i), Number(j))")
  , MkPair "strEq" (mkPrim 2 "(a) => (b) => a === b ? $T : $F")
  , MkPair "strLt" (mkPrim 2 "(a) => (b) => a < b ? $T : $F")
  , MkPair
    "strCompare"
    (mkPrim 2 "(a) => (b) => a < b ? -1n : a === b ? 0n : 1n")
  , MkPair
    "strFind"
    (mkPrim
       3
       "(n) => (s) => (i) => { const k = i < 0n ? 0 : Number(i); return k + n.length > s.length ? -1n : BigInt(s.indexOf(n, k)); }")
  , MkPair "runeEq" (mkPrim 2 "(a) => (b) => a === b ? $T : $F")
  , MkPair "runeLt" (mkPrim 2 "(a) => (b) => a < b ? $T : $F")
  , MkPair "runeLe" (mkPrim 2 "(a) => (b) => a <= b ? $T : $F")
  , MkPair "runeToInt" (mkPrim 1 "(a) => BigInt(a)")
  , MkPair "runeFromInt" (mkPrim 1 "(a) => Number(BigInt.asIntN(32, a))")
  , MkPair "keep" (mkPrim 1 "(x) => x")
  ]

-- The fixed-width types' (heff.elab.fixed): an integer of up to 32 bits is a
-- number, one of 64 a BigInt, each of its type's range; a `Float32` is a
-- number, rounded to one (`Math.fround`).
--------------------------------------------------------------------------------

-- (an integer's result, wrapped around to the type's range)
narrowJs : Fixed.Fixed -> String -> String
narrowJs I8 e = "(" ^ e ^ ") << 24 >> 24"
narrowJs I16 e = "(" ^ e ^ ") << 16 >> 16"
narrowJs I32 e = "(" ^ e ^ ") | 0"
narrowJs I64 e = "BigInt.asIntN(64, " ^ e ^ ")"
narrowJs U8 e = "(" ^ e ^ ") & 255"
narrowJs U16 e = "(" ^ e ^ ") & 65535"
narrowJs U32 e = "(" ^ e ^ ") >>> 0"
narrowJs U64 e = "BigInt.asUintN(64, " ^ e ^ ")"
narrowJs F32 e = "Math.fround(" ^ e ^ ")"

isBig : Fixed.Fixed -> Bool
isBig w = Fixed.fixedBits w == 64

-- (zero, and the mask of a shift's amount: as many as the bits)
zeroJs : Fixed.Fixed -> String
zeroJs w = if isBig w then "0n" else "0"

shiftMaskJs : Fixed.Fixed -> String
shiftMaskJs w = show (Fixed.fixedBits w - 1) ^ (if isBig w then "n" else "")

bin : String -> String
bin body = "(a) => (b) => " ^ body

-- (by zero, `byZero`: a division is total, 0 by 0, its remainder the
-- dividend -- of 64 bits, a BigInt, computed, as `basicPrims` says)
byNonZero : Fixed.Fixed -> String -> String -> String
byNonZero w byZero e = bin ("b === " ^ zeroJs w ^ " ? " ^ byZero ^ " : " ^ e)

relJs : String -> String
relJs op = bin ("a " ^ op ^ " b ? $T : $F")

-- (a shift right: of a signed type, or of 64 bits (a BigInt of the
-- type's range), arithmetic; else logical)
rightJs : Fixed.Fixed -> String
rightJs w = if Fixed.fixedSigned w || isBig w then ">>" else ">>>"

-- (a shift by `op`, by the count modulo the bits; by a negative count, of
-- a signed type, one by `back`, the other way, by its size)
shiftJs : Fixed.Fixed -> String -> String -> String
shiftJs w op back =
  if Fixed.fixedSigned w
  then "b < "
    ^ zeroJs w
    ^ " ? "
    ^ narrowJs w ("a " ^ back ^ " (-b & " ^ shiftMaskJs w ^ ")")
    ^ " : "
    ^ narrowJs w ("a " ^ op ^ " (b & " ^ shiftMaskJs w ^ ")")
  else narrowJs w ("a " ^ op ^ " (b & " ^ shiftMaskJs w ^ ")")

-- (an integer type's operation)
intOpJs : Fixed.Fixed -> Fixed.FixedOp -> String
intOpJs w OpAdd = bin (narrowJs w "a + b")
intOpJs w OpSub = bin (narrowJs w "a - b")
intOpJs w OpMul =
  bin (narrowJs w (if isBig w then "a * b" else "Math.imul(a, b)"))
intOpJs w OpDiv =
  byNonZero
    w
    (if isBig w then "a * b" else "0")
    (narrowJs w (if isBig w then "a / b" else "Math.trunc(a / b)"))
intOpJs w OpRem =
  byNonZero w (if isBig w then "a - b" else "a") (narrowJs w "a % b")
intOpJs w OpEq = relJs "==="
intOpJs w OpLt = relJs "<"
intOpJs w OpLe = relJs "<="
intOpJs w OpAnd = bin (narrowJs w "a & b")
intOpJs w OpOr = bin (narrowJs w "a | b")
intOpJs w OpXor = bin (narrowJs w "a ^ b")
intOpJs w OpShl = bin (shiftJs w "<<" (rightJs w))
intOpJs w OpShr = bin (shiftJs w (rightJs w) "<<")
intOpJs w OpShow = "(a) => a.toString()"
intOpJs w OpFromInt =
  if isBig w then "(a) => " ^ narrowJs w "a"
  else "(a) => Number(BigInt.as"
    ^ (if Fixed.fixedSigned w then "IntN(" else "UintN(")
    ^ show (Fixed.fixedBits w)
    ^ ", a))"
intOpJs w OpToInt = if isBig w then "(a) => a" else "(a) => BigInt(a)"
intOpJs w _ = "(a) => $abandon()"

-- (a `Float32` shown: the fewest digits that read back as the same one,
-- as the runtime's `heff_float32Show` says -- for each count of
-- digits, the number of that many nearest it, of two as near the one whose
-- last digit is even -- computed exactly, its bits a fraction of BigInts
-- (`toPrecision` would take the greater of two as near))
float32ShowJs : String
float32ShowJs =
  joinWith
    " "
    [ "(a) => { let t = a; if (Number.isFinite(a) && a !== 0) {"
    , "const v = new DataView(new ArrayBuffer(4)); v.setFloat32(0, Math.abs(a));"
    , "const b = v.getUint32(0), be = b >>> 23;"
    , "const m = BigInt(be ? (b & 8388607) | 8388608 : b & 8388607), e = (be || 1) - 150;"
    , "const n = e >= 0 ? m << BigInt(e) : m, d = e >= 0 ? 1n : 1n << BigInt(-e);"
    , "const ge = (k) => k >= 0 ? n >= d * 10n ** BigInt(k) : n * 10n ** BigInt(-k) >= d;"
    , "let k = Math.floor(Math.log10(Math.abs(a))); while (!ge(k)) k--; while (ge(k + 1)) k++;"
    , "for (let p = 1; p <= 9; p++) { const s = k - p + 1;"
    , "const num = s >= 0 ? n : n * 10n ** BigInt(-s), den = s >= 0 ? d * 10n ** BigInt(s) : d;"
    , "let q = num / den; const r2 = 2n * (num % den);"
    , "if (r2 > den || (r2 === den && (q & 1n))) q++;"
    , "const c = Number(q + \"e\" + s) * Math.sign(a);"
    , "if (Math.fround(c) === a) { t = c; break; } } }"
    , "const s = String(t); return isNaN(s + \".0\") ? s : s + \".0\"; }"
    ]

-- (`Float32`'s)
float32OpJs : Fixed.FixedOp -> String
float32OpJs OpAdd = bin "Math.fround(a + b)"
float32OpJs OpSub = bin "Math.fround(a - b)"
float32OpJs OpMul = bin "Math.fround(a * b)"
float32OpJs OpDiv = bin "Math.fround(a / b)"
float32OpJs OpEq = relJs "==="
float32OpJs OpLt = relJs "<"
float32OpJs OpLe = relJs "<="
float32OpJs OpSqrt = "(a) => Math.fround(Math.sqrt(a))"
float32OpJs OpShow = float32ShowJs
float32OpJs OpFromFloat = "(a) => Math.fround(a)"
float32OpJs OpToFloat = "(a) => a"
float32OpJs OpFromInt = "(a) => Math.fround(Number(a))"
float32OpJs OpFloor = "(a) => Number.isFinite(a) ? BigInt(Math.floor(a)) : 0n"
float32OpJs _ = "(a) => $abandon()"

fixedJs : Fixed.FixedPrim -> String
fixedJs p =
  if Fixed.isFloat32 p.fixed then float32OpJs p.op else intOpJs p.fixed p.op

fixedImpl : Fixed.FixedPrim -> Pair String PrimImpl
fixedImpl p =
  MkPair (Fixed.fixedPrimName p) (mkPrim (Fixed.opArity p.op) (fixedJs p))

-- (murmur3's finish, of a BigInt from 0 up to 2^64)
fmixJs : String
fmixJs =
  "((h) => { const M = 0xffffffffffffffffn; h ^= h >> 33n; h = h * 0xff51afd7ed558ccdn & M; h ^= h >> 33n; h = h * 0xc4ceb9fe1a85ec53n & M; return h ^ (h >> 33n); })"

-- (the hashes, std.hashmap's, the same numbers as the runtime's:
-- a string's bytes 8 at a time, a word read as two
-- halves of 32 bits)
hashPrims : List (Pair String PrimImpl)
hashPrims =
  [ MkPair
    "strHash"
    (mkPrim
       1
       ("(s) => { const M = 0xffffffffffffffffn, n = s.length; let h = BigInt(n), i = 0; const half = (j, e) => { let x = 0; for (let k = Math.min(j + 4, e) - 1; k >= j; k--) x = x * 256 + s.charCodeAt(k); return BigInt(x); }; const step = (w) => { h = ((((h << 5n) | (h >> 59n)) & M) ^ w) * 0x517cc1b727220a95n & M; }; for (; i < n; i += 8) step(half(i, n) | half(i + 4, n) << 32n); return "
        ^ fmixJs
        ^ "(h) >> 2n; }"))
  , MkPair
    "intHash"
    (mkPrim 1 ("(a) => " ^ fmixJs ^ "(BigInt.asUintN(64, a)) >> 2n"))
  , MkPair
    "trieSlot"
    (mkPrim
       3
       "(bm) => (h) => (s) => { const bit = 1n << ((h >> s) & 31n); let m = bm & (bit - 1n), c = 0n; while (m) { m &= m - 1n; c++; } return bm & bit ? c : -1n - c; }")
  ]

-- | the primitives the library may declare (`primitive`)
-- | >>> List.map (\(p : Pair String PrimImpl) -> (snd p).js) (List.keepIf (\(p : Pair String PrimImpl) -> strEq (fst p) "int8Div") prims)
-- | Cons "(a) => (b) => b === 0 ? 0 : (Math.trunc(a / b)) << 24 >> 24" Nil
prims : List (Pair String PrimImpl)
prims =
  List.append
    basicPrims
    (List.append
       bytePrims
       (List.append
          bytesPrims
          (List.append
             bitsPrims
             (List.append hashPrims (List.map fixedImpl Fixed.fixedPrims)))))

-- | the primitives the compiler writes, which no program names: an
-- | operation of a program's world handed to the world (only the
-- | runtime has it, `$performer`; see `heff.compile.lower`'s `lowerProgram`)
internal : List (Pair String PrimImpl)
internal = [MkPair "perform" (mkPrim 2 "(p) => (k) => $performer(p, k)")]

-- | every primitive a backend has
allPrims : List (Pair String PrimImpl)
allPrims = List.append prims internal

primArityGo : String -> List (Pair String PrimImpl) -> Maybe Int
primArityGo p Nil = Nothing
primArityGo p (Cons (MkPair k i) rest) =
  if strEq k p then Just i.arity else primArityGo p rest

-- | >>> primArity "strSlice"
-- | Just 3
-- | >>> primArity "uint8Shl"
-- | Just 2
primArity : String -> Maybe Int
primArity p = primArityGo p allPrims
