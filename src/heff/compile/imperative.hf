-- The imperative form both backends print (#40): Bowman's AB-normal form
-- ("A Low-Level Look at A-Normal Form", OOPSLA 2024, figures 10 and 20).
-- What is lowered (heff.compile.lower) is in monadic form, a binding of
-- a match kept one; here it is made statements and a tail:
--
--   let x = case s of A -> a; B -> b in c   ~>   var x; switch s { A: x = a; B: x = b }; c
--
-- each arm setting `x` -- the binding pushed into the arms, not `c`
-- copied into them, nor a join point made: what A-normal form cannot do
-- without, a variable set does here (`set! x (if v t1 t2)` is `if v (set!
-- x t1) (set! x t2)`, figure 11).  An operand is simple: a name, a
-- literal, a lambda, or a tag, a record, a field or a primitive that
-- cannot fail, of simple ones; what is not is bound before.
--
-- A test of a `Bool` -- a match with arms `True` and `False` -- is in
-- boolean position (Bowman, section 6.2; Chez's L11 `Pred`): its
-- condition is a `Pred`, a comparison or a `Bool` looked at, never a
-- `True` or `False` built to be matched on, and a match on a test whose
-- arms are constants is the test the other way round (case of case).
--
-- A call of itself last, from a function's own body (not a lambda in
-- it), is the next round of a loop (`TLoop`).
--
-- Types are defined one after another: what holds a lambda's body is
-- parametric in it (`b`), and `Block` closes the knot.

module heff.compile.imperative

import heff.compile.ir as IR
import heff.elab.primitive
import heff.compile.ranges as Ranges
import heff.compile.simplify as Simplify
import heff.compile.supply
import heff.elab.fixed as Fixed
import std.ordmap as OrdMap

-- | an operand: computing it cannot fail nor do anything
data Simple b
  = SVar String
  | SGlobal String
  | SInt Int
  | SFloat Float64
  | SStr String
  -- | `Bytes`, a literal's, kept as a string of them
  | SBytes String
  | SFixed Fixed.Fixed Int
  | SFloat32 Float64
  -- | a primitive, as a (curried) function
  | SPrimFn Prim
  | SLam (List String) b
  -- | a tag: its arguments, and each one's type (`IR.FieldTy`)
  | STag String (List (Simple b)) (List IR.FieldTy)
  -- | a record: its fields, and each one's type (`IR.FieldTy`)
  | SRec (List (Pair String (Simple b))) (List IR.FieldTy)
  -- | a field, by its label, of a record of the shape (if known), and
  -- | the field's type
  | SProj (Simple b) String (List String) IR.FieldTy
  -- | a primitive that cannot fail, given all its arguments
  | SPrim Prim (List (Simple b))

-- | what is computed in one step, its operands simple (`p` a condition)
data Op p b
  = OSimple (Simple b)
  -- | a definition of that arity, given all its arguments
  | OCall String (List (Simple b))
  | OApply (Simple b) (List (Simple b))
  -- | a primitive that may fail
  | OPrim Prim (List (Simple b))
  | OAbandon
  -- | the `Bool` a condition is
  | OBool p

-- | a condition: `PRel`, a comparison, a primitive of two operands; `PBool`,
-- | a `Bool` looked at; `PLet`, a name bound in it, before what follows
-- | in it (and only where that is computed)
data Pred b
  = PTrue
  | PFalse
  | PRel Prim (Simple b) (Simple b)
  | PBool (Simple b)
  | PNot (Pred b)
  | PIf (Pred b) (Pred b) (Pred b)
  | PLet String (Op (Pred b) b) (Pred b)

-- | an arm: its tag, the names bound to its fields (in order), its body
data Arm a = MkArm String (List String) a

-- | a statement: `SLet`, a name bound to what is computed; `SDecl`, a name
-- | that statements after it set (`SSet`), each where it is reached;
-- | `SOnce`, a name computed where it is used, its one use being in what
-- | is computed first after it (for JavaScript: `onceInlined`)
data Stmt b
  = SLet String (Op (Pred b) b)
  | SOnce String (Op (Pred b) b)
  | SDecl String
  | SSet String (Op (Pred b) b)
  | SIf (Pred b) (List (Stmt b)) (List (Stmt b))
  | SCase (Simple b) (List (Arm (List (Stmt b))))

-- | what is last: statements, then what follows them; a value returned;
-- | the next round of the loop the function is
data Tail b
  = TSeq (List (Stmt b)) (Tail b)
  | TReturn (Op (Pred b) b)
  | TLoop (List (Simple b))
  | TIf (Pred b) (Tail b) (Tail b)
  | TCase (Simple b) (List (Arm (Tail b)))

-- | a body: what a function or a lambda does
data Block = MkBlock (Tail Block)

type Val = Simple Block

type Cond = Pred Block

type Comp = Op Cond Block

type St = Stmt Block

type Tl = Tail Block

-- | a definition: a function, its parameters and body; or a value,
-- | computed by a body
data Body = DefFun (List String) Block | DefVal Block

-- | a definition, by its key and the name it is known by
data Def = MkDef String String Body

defKey : Def -> String
defKey (MkDef k _ _) = k

defBody : Def -> Body
defBody (MkDef _ _ b) = b

-- What is simple
--------------------------------------------------------------------------------

-- | whether it is simple: computed where it is or before, the same
isSimple : IR.Expr -> Bool
isSimple (EVar _) = True
isSimple (EGlobal _) = True
isSimple (EInt _) = True
isSimple (EFloat _) = True
isSimple (EStr _) = True
isSimple (EBytes _) = True
isSimple (EFixed _ _) = True
isSimple (EFloat32 _) = True
isSimple (EPrim _) = True
isSimple (ELam _ _) = True
isSimple (ETag _ args _) = List.all isSimple args
isSimple (ERecord fs _) = List.all (\f -> isSimple (snd f)) fs
isSimple (EProj e _ _ _) = isSimple e
isSimple (EPrimCall p args) =
  not (Simplify.primFails p) && List.all isSimple args
isSimple _ = False

-- | the function a body is a loop of, if it is one's own (not a lambda's)
type Self = { key : String, arity : Int }

-- | statements that end setting `x` (`set`) or binding it (`let`) to
-- | what is computed, or setting each of `xs` to a value (`EValues`)
data Dest = DSet String | DLet String | DSets (List String)

-- | the code generator's judgments, knotted
-- | (`full`: a condition made of any test of a `Bool`; else of a
-- | comparison alone, looked at where it is made)
type G =
  { full : Bool
  , simple : IR.Expr -> S Val
  , tail : Maybe Self -> IR.Expr -> S Tl
  , bindTo : String -> IR.Expr -> S (List St)
  , toDest : Dest -> IR.Expr -> S (List St)
  , atom : IR.Expr -> S (Pair (List St) Val)
  , op : IR.Expr -> S (Pair (List St) Comp)
  , pred : IR.Expr -> S (Maybe Cond)
  }

-- Conditions
--------------------------------------------------------------------------------

-- | the comparisons a condition is made of (the backends each have them
-- | as an operator, or a test of their own)
isRel : Prim -> Bool
isRel p = IR.isRel p

armNamed : String -> List IR.Arm -> Maybe IR.Expr
armNamed t Nil = Nothing
armNamed t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t && List.null vs then Just b else armNamed t rest

-- | a match's arms, if it is a test: one for `True`, one for `False`
boolArms : List IR.Arm -> Maybe (Pair IR.Expr IR.Expr)
boolArms arms =
  if List.length arms == 2
  then case armNamed "True" arms of
    Just t -> case armNamed "False" arms of
      Just f -> Just (MkPair t f)
      Nothing -> Nothing
    Nothing -> Nothing
  else Nothing

-- | whether it is a boolean all the way down, as a condition
condShaped : IR.Expr -> Bool
condShaped (ETag t Nil _) = strEq t "True" || strEq t "False"
condShaped (EPrimCall p (Cons _ (Cons _ Nil))) = isRel p
condShaped (EMatch s arms) = case boolArms arms of
  Just (MkPair t f) -> condShaped t && condShaped f
  Nothing -> False
condShaped (ELet _ _ b) = condShaped b
condShaped e = False

-- (whether `x` is named in the arms)
armsName : String -> List IR.Arm -> Bool
armsName x arms =
  List.any (\a -> (IR.occurrences x (IR.armBody a)).count > 0) arms

-- (a comparison, what a condition is made of)
isRelCall : IR.Expr -> Bool
isRelCall (EPrimCall p (Cons _ (Cons _ Nil))) = isRel p
isRelCall e = False

isJustM : {a : Type} -> Maybe a -> Bool
isJustM (Just _) = True
isJustM Nothing = False

-- | `let x = a in case x of True -> ..; False -> ..`, `x` named nowhere
-- | else -- as monadic form binds what a match looks at -- as the test
-- | of `a`; and so where the match is bound, `let y = case x of .. in e`
-- | (the binding of `x` sunk to where it is looked at)
sinkTest : String -> IR.Expr -> IR.Expr -> Maybe IR.Expr
sinkTest x a (EMatch (EVar y) arms) =
  if strEq x y
     && isRelCall a
     && isJustM (boolArms arms)
     && not (armsName x arms)
  then Just (EMatch a arms)
  else Nothing
sinkTest x a (ELet z (EMatch (EVar y) arms) e) =
  if strEq x y
     && isRelCall a
     && isJustM (boolArms arms)
     && not (armsName x arms)
     && (IR.occurrences x e).count == 0
  then Just (ELet z (EMatch a arms) e)
  else Nothing
sinkTest x a b = Nothing

isConstant : Cond -> Bool
isConstant PTrue = True
isConstant PFalse = True
isConstant _ = False

-- | `if c then t else e`, as a condition: a test of a test whose arms
-- | are constants taken apart (case of case), where that copies only
-- | constants
condIf : Cond -> Cond -> Cond -> Cond
condIf (PLet x o c) t e = PLet x o (condIf c t e)
condIf PTrue t e = t
condIf PFalse t e = e
condIf (PNot c) t e = condIf c e t
condIf (PIf a b c) t e =
  if isConstant t && isConstant e then condIf a (condIf b t e) (condIf c t e)
  else PIf (PIf a b c) t e
condIf c PTrue PFalse = c
condIf c PFalse PTrue = PNot c
condIf c t e = PIf c t e

letIn : String -> Comp -> Maybe Cond -> Maybe Cond
letIn x o (Just q) = Just (PLet x o q)
letIn x o Nothing = Nothing

-- (statements in a condition: only bindings, each where it is computed)
predLets : List St -> Cond -> Maybe Cond
predLets Nil p = Just p
predLets (Cons (SLet x o) rest) p = letIn x o (predLets rest p)
predLets _ p = Nothing

-- | a `Bool` computed, looked at
predValue : G -> IR.Expr -> S (Maybe Cond)
predValue g e =
  if isSimple e
  then do
    v <- g.simple e
    pure (Just (PBool v))
  else do
    t <- freshS "c"
    ss <- g.bindTo t e
    pure (predLets ss (PBool (SVar t)))

-- (a comparison, its operands bound before where they are not simple)
relPred : G -> Prim -> IR.Expr -> IR.Expr -> S (Maybe Cond)
relPred g p a b = do
  pa <- g.atom a
  pb <- g.atom b
  pure (predLets (List.append (fst pa) (fst pb)) (PRel p (snd pa) (snd pb)))

-- (each part a condition)
ifPred : Maybe Cond -> Maybe Cond -> Maybe Cond -> Maybe Cond
ifPred (Just a) (Just b) (Just c) = Just (condIf a b c)
ifPred _ _ _ = Nothing

-- | a condition (heff.compile.ir's), as one here: the same, its operands
-- | bound where they are computed
condPred : G -> IR.Cond -> S (Maybe Cond)
condPred g CTrue = pure (Just PTrue)
condPred g CFalse = pure (Just PFalse)
condPred g (CRel p a b) = relPred g p a b
condPred g (CTest e) = g.pred e
condPred g (CNot c) = do
  p <- condPred g c
  pure (case p of
    Just q -> Just (condIf q PFalse PTrue)
    Nothing -> Nothing)
condPred g (CIf a b c) = do
  pa <- condPred g a
  pb <- condPred g b
  pc <- condPred g c
  pure (ifPred pa pb pc)

predAny : G -> IR.Expr -> S (Maybe Cond)
predAny g (ETag t Nil _) =
  if strEq t "True" then pure (Just PTrue)
  else if strEq t "False" then pure (Just PFalse)
  else pure (Just (PBool (STag t Nil Nil)))
predAny g e@(EPrimCall p (Cons a (Cons b Nil))) =
  if isRel p
  then do
    pa <- g.atom a
    pb <- g.atom b
    pure (predLets (List.append (fst pa) (fst pb)) (PRel p (snd pa) (snd pb)))
  else predValue g e
predAny g e@(EMatch s arms) = case boolArms arms of
  Just (MkPair t f) -> do
    ps <- g.pred s
    pt <- g.pred t
    pf <- g.pred f
    pure (case ps of
      Just cs -> case pt of
        Just ct -> case pf of
          Just cf -> Just (condIf cs ct cf)
          Nothing -> Nothing
        Nothing -> Nothing
      Nothing -> Nothing)
  Nothing -> predValue g e
predAny g (ELet x a b) = case sinkTest x a b of
  Just e2 -> g.pred e2
  Nothing -> do
    ss <- g.bindTo x a
    pb <- g.pred b
    pure (case pb of
      Just q -> predLets ss q
      Nothing -> Nothing)
predAny g (EBool c) = condPred g c
predAny g e = predValue g e

isCondE : IR.Expr -> Bool
isCondE (EBool _) = True
isCondE e = False

-- | a `Bool`, as a condition (none, where what computes it is not
-- | bindings alone; nor, not `full`, where it is not a comparison or a
-- | condition)
predOf : G -> IR.Expr -> S (Maybe Cond)
predOf g e =
  if g.full || isRelCall e || isCondE e then predAny g e else pure Nothing

-- Statements
--------------------------------------------------------------------------------

simpleOf : G -> IR.Expr -> S Val
simpleOf g (EVar x) = pure (SVar x)
simpleOf g (EGlobal k) = pure (SGlobal k)
simpleOf g (EInt i) = pure (SInt i)
simpleOf g (EFloat x) = pure (SFloat x)
simpleOf g (EStr s) = pure (SStr s)
simpleOf g (EBytes s) = pure (SBytes s)
simpleOf g (EFixed w i) = pure (SFixed w i)
simpleOf g (EFloat32 x) = pure (SFloat32 x)
simpleOf g (EPrim p) = pure (SPrimFn p)
simpleOf g (ELam xs b) = do
  t <- g.tail Nothing b
  pure (SLam xs (MkBlock t))
simpleOf g (ETag t args ts) = do
  vs <- traverseS g.simple args
  pure (STag t vs ts)
simpleOf g (ERecord fs ts) = do
  vs <- traverseS (\f -> g.simple (snd f)) fs
  pure (SRec (List.zipWith (\f v -> MkPair (fst f) v) fs vs) ts)
simpleOf g (EProj e l sh t) = do
  v <- g.simple e
  pure (SProj v l sh t)
simpleOf g (EPrimCall p args) = do
  vs <- traverseS g.simple args
  pure (SPrim p vs)
-- (not simple: no operand is made of it -- `isSimple` is asked first)
simpleOf g e = pure (SVar "$notSimple")

-- | an operand: simple, or bound before by the statements given
atomOf : G -> IR.Expr -> S (Pair (List St) Val)
atomOf g e =
  if isSimple e
  then do
    v <- g.simple e
    pure (MkPair Nil v)
  else do
    t <- freshS "t"
    ss <- g.bindTo t e
    pure (MkPair ss (SVar t))

atomsOf : G -> List IR.Expr -> S (Pair (List St) (List Val))
atomsOf g Nil = pure (MkPair Nil Nil)
atomsOf g (Cons e es) = do
  a <- g.atom e
  rest <- atomsOf g es
  pure (MkPair (List.append (fst a) (fst rest)) (Cons (snd a) (snd rest)))

opWith : Pair (List St) (List Val) -> (List Val -> Comp) -> Pair (List St) Comp
opWith (MkPair ss vs) k = MkPair ss (k vs)

-- | what is computed in one step (not a binding, nor a match), its
-- | operands bound before where they are not simple
opOf : G -> IR.Expr -> S (Pair (List St) Comp)
opOf g (ECall k args) = do
  r <- atomsOf g args
  pure (opWith r (\vs -> OCall k vs))
opOf g (EApp f args) = do
  r <- atomsOf g (Cons f args)
  pure
      (opWith r (\vs -> case vs of
       Cons fv avs -> OApply fv avs
       Nil -> OAbandon))
opOf g (EPrimCall p args) = do
  r <- atomsOf g args
  pure
      (opWith
         r
         (\vs ->
            if Simplify.primFails p then OPrim p vs else OSimple (SPrim p vs)))
opOf g (ETag t args ts) = do
  r <- atomsOf g args
  pure (opWith r (\vs -> OSimple (STag t vs ts)))
opOf g (ERecord fs ts) = do
  r <- atomsOf g (List.map snd fs)
  pure
      (opWith
         r
         (\vs ->
            OSimple (SRec (List.zipWith (\f v -> MkPair (fst f) v) fs vs) ts)))
opOf g (EProj e l sh t) = do
  r <- atomsOf g (Cons e Nil)
  pure
      (opWith r (\vs -> case vs of
       Cons v _ -> OSimple (SProj v l sh t)
       Nil -> OAbandon))
opOf g EAbandon = pure (MkPair Nil OAbandon)
opOf g (EFix _ _) = pure (MkPair Nil OAbandon)
opOf g e = do
  v <- g.simple e
  pure (MkPair Nil (OSimple v))

-- | a test whose arms are `Bool`s too: the `Bool` the whole is
boolOf : G -> IR.Expr -> S (Maybe Comp)
boolOf g e = do
  p <- g.pred e
  pure (case p of
    Just c -> Just (OBool c)
    Nothing -> Nothing)

destStmt : Dest -> Comp -> St
destStmt (DSet x) o = SSet x o
destStmt (DLet x) o = SLet x o
destStmt (DSets xs) o = SLet "_" o

-- (what an arm gives the destination: a binding's name is set there)
armDest : Dest -> Dest
armDest (DLet x) = DSet x
armDest d = d

caseSet : G -> Dest -> IR.Expr -> List IR.Arm -> S (List St)
caseSet g d s arms = do
  sv <- g.atom s
  args <-
    traverseS
      (\arm -> case arm of
       MkArm t vs b -> do
         sb <- g.toDest d b
         pure (MkArm t vs sb))
      arms
  pure (List.append (fst sv) (Cons (SCase (snd sv) args) Nil))

-- (each arm setting the destination; a test, by its condition)
matchSet : G -> Dest -> IR.Expr -> List IR.Arm -> S (List St)
matchSet g d s arms = case boolArms arms of
  Just (MkPair t f) -> do
    p <- g.pred s
    case p of
      Just c -> do
        st <- g.toDest d t
        sf <- g.toDest d f
        pure (Cons (SIf c st sf) Nil)
      Nothing -> caseSet g d s arms
  Nothing -> caseSet g d s arms

-- (`xs` declared right before the statement that sets them, after what
-- that statement looks at is bound)
declsBefore : List String -> List St -> List St
declsBefore xs Nil = List.map (\x -> SDecl x) xs
declsBefore xs (Cons st Nil) = List.append (List.map (\x -> SDecl x) xs) [st]
declsBefore xs (Cons st rest) = Cons st (declsBefore xs rest)

declBefore : String -> List St -> List St
declBefore x ss = declsBefore [x] ss

-- | a match that sets the destination in each arm: where it is bound, it
-- | is declared first
matchTo : G -> Dest -> IR.Expr -> List IR.Arm -> S (List St)
matchTo g d s arms = do
  sw <- matchSet g (armDest d) s arms
  pure (case d of
    DLet x -> declBefore x sw
    _ -> sw)

-- | `xs` set by the way out of `a` taken (heff.compile.ir's `ESet`), each
-- | way its values: declared before the statement that sets them; where
-- | there is one way, each bound to its value
setsOf : G -> List String -> IR.Expr -> S (List St)
setsOf g xs (ELet y a b) = do
  sa <- g.bindTo y a
  sb <- setsOf g xs b
  pure (List.append sa sb)
setsOf g xs (ESet ys a b) = do
  sa <- setsOf g ys a
  sb <- setsOf g xs b
  pure (List.append sa sb)
setsOf g xs (EValues es) = do
  ss <- traverseS (\p -> g.bindTo (fst p) (snd p)) (List.zip xs es)
  pure (List.foldr List.append Nil ss)
setsOf g xs (EMatch s arms) = do
  sw <- matchSet g (DSets xs) s arms
  pure (declsBefore xs sw)
setsOf g xs e = do
  sw <- g.toDest (DSets xs) e
  pure (List.append (List.map (\x -> SDecl x) xs) sw)

-- | `e`'s value, given to the destination
toDest : G -> Dest -> IR.Expr -> S (List St)
toDest g d (ELet y a b) = case sinkTest y a b of
  Just e2 -> toDest g d e2
  Nothing -> do
    sa <- g.bindTo y a
    sb <- toDest g d b
    pure (List.append sa sb)
-- (the values of a way out, each set)
toDest g (DSets xs) (EValues es) = do
  r <- atomsOf g es
  pure
      (List.append
         (fst r)
         (List.zipWith (\x v -> SSet x (OSimple v)) xs (snd r)))
toDest g d (ESet xs a b) = do
  sa <- setsOf g xs a
  sb <- toDest g d b
  pure (List.append sa sb)
-- (a condition: the `Bool` it is; else as the matches it is made of)
toDest g d e@(EBool c) = do
  bo <- boolOf g e
  case bo of
    Just o -> pure (Cons (destStmt d o) Nil)
    Nothing -> toDest g d (IR.condExpr c)
toDest g d e@(EMatch s arms) = case boolArms arms of
  Just (MkPair t f) ->
    if g.full && condShaped t && condShaped f
    then do
      bo <- boolOf g e
      case bo of
        Just o -> pure (Cons (destStmt d o) Nil)
        Nothing -> matchTo g d s arms
    else matchTo g d s arms
  Nothing -> matchTo g d s arms
toDest g (DSets xs) e = do
  r <- g.op e
  t <- freshS "t"
  pure (List.append (fst r) (Cons (SLet t (snd r)) Nil))
toDest g d e = do
  r <- g.op e
  pure (List.append (fst r) (Cons (destStmt d (snd r)) Nil))

-- Tails
--------------------------------------------------------------------------------

isSelf : Maybe Self -> String -> List IR.Expr -> Bool
isSelf (Just s) k args = strEq s.key k && List.length args == s.arity
isSelf Nothing k args = False

tailSeq : List St -> Tl -> Tl
tailSeq Nil t = t
tailSeq ss (TSeq ss2 t) = TSeq (List.append ss ss2) t
tailSeq ss t = TSeq ss t

isNothingM : {a : Type} -> Maybe a -> Bool
isNothingM Nothing = True
isNothingM (Just _) = False

opTail : G -> IR.Expr -> S Tl
opTail g e = do
  r <- g.op e
  pure (tailSeq (fst r) (TReturn (snd r)))

caseTail : G -> Maybe Self -> IR.Expr -> List IR.Arm -> S Tl
caseTail g self s arms = do
  sv <- g.atom s
  args <-
    traverseS
      (\arm -> case arm of
       MkArm t vs b -> do
         tb <- g.tail self b
         pure (MkArm t vs tb))
      arms
  pure (tailSeq (fst sv) (TCase (snd sv) args))

-- (a test: by its condition, if it is one; else a match)
testTail : G
         -> Maybe Self
         -> IR.Expr
         -> IR.Expr
         -> IR.Expr
         -> List IR.Arm
         -> S Tl
testTail g self s t f arms = do
  p <- g.pred s
  case p of
    Just c -> do
      tt <- g.tail self t
      tf <- g.tail self f
      pure (TIf c tt tf)
    Nothing -> caseTail g self s arms

-- | what is last, in a function's body (`self`, the function, where a
-- | call of it is the next round) or a lambda's
tailOf : G -> Maybe Self -> IR.Expr -> S Tl
tailOf g self (ELet y a b) = case sinkTest y a b of
  Just e2 -> g.tail self e2
  Nothing -> do
    sa <- g.bindTo y a
    tb <- g.tail self b
    pure (tailSeq sa tb)
tailOf g self e@(EMatch s arms) = case boolArms arms of
  Just (MkPair t f) ->
    if g.full && isNothingM self && condShaped t && condShaped f
    then do
      bo <- boolOf g e
      case bo of
        Just o -> pure (TReturn o)
        Nothing -> testTail g self s t f arms
    else testTail g self s t f arms
  Nothing -> caseTail g self s arms
tailOf g self (ESet xs a b) = do
  sa <- setsOf g xs a
  tb <- g.tail self b
  pure (tailSeq sa tb)
tailOf g self e@(EBool c) = do
  bo <- boolOf g e
  case bo of
    Just o -> pure (TReturn o)
    Nothing -> g.tail self (IR.condExpr c)
tailOf g self e@(ECall k args) =
  if isSelf self k args
  then do
    r <- atomsOf g args
    pure (tailSeq (fst r) (TLoop (snd r)))
  else opTail g e
tailOf g self e = opTail g e

-- | the code generator: `full`, or with conditions of comparisons alone
genOf : Bool -> G
genOf full =
  { full = full
  , simple = \e -> simpleOf (genOf full) e
  , tail = \self e -> tailOf (genOf full) self e
  , bindTo = \x e -> toDest (genOf full) (DLet x) e
  , toDest = \d e -> toDest (genOf full) d e
  , atom = \e -> atomOf (genOf full) e
  , op = \e -> opOf (genOf full) e
  , pred = \e -> predOf (genOf full) e
  }

-- Definitions
--------------------------------------------------------------------------------

-- | whether a way out calls itself: a loop
tailSelf : String -> Int -> IR.Expr -> Bool
tailSelf key n (ECall k args) = strEq k key && List.length args == n
tailSelf key n e = False

-- (the function, where it is a loop)
loopOf : String -> List String -> IR.Expr -> Maybe Self
loopOf key xs b =
  if List.any (tailSelf key (List.length xs)) (IR.waysList b)
  then Just ({ key = key, arity = List.length xs } : Self)
  else Nothing

defOf : G -> IR.Def -> S Def
defOf g d = case d.body of
  ELam xs b -> do
    t <- g.tail (loopOf d.key xs b) b
    pure (MkDef d.key d.name (DefFun xs (MkBlock t)))
  b -> do
    t <- g.tail Nothing b
    pure (MkDef d.key d.name (DefVal (MkBlock t)))

-- | a definition, imperative (`full` as `genOf` says), fresh names drawn
-- | from `supply` on
-- | >>> defKey (impDef True 0 (IR.mkDef "f" "f" (ELam ["x"] (EVar "x"))))
-- | "f"
impDef : Bool -> Int -> IR.Def -> Def
impDef full supply d = fst (defOf (genOf full) d supply)

-- Parts
--------------------------------------------------------------------------------

-- | a part of a body: each simple value, each step
data Part = PartVal Val | PartOp Comp

-- | the walk, knotted: each of a kind's parts, before `acc`
type PK =
  { val : Val -> List Part -> List Part
  , op : Comp -> List Part -> List Part
  , cond : Cond -> List Part -> List Part
  , sts : List St -> List Part -> List Part
  , tl : Tl -> List Part -> List Part
  }

partsVals : PK -> List Val -> List Part -> List Part
partsVals r vs acc = List.foldr (\v a -> r.val v a) acc vs

-- (a value and what it is made of, inside a lambda too)
partsVal : PK -> Val -> List Part -> List Part
partsVal r v@(SLam _ (MkBlock t)) acc = Cons (PartVal v) (r.tl t acc)
partsVal r v@(STag _ args _) acc = Cons (PartVal v) (partsVals r args acc)
partsVal r v@(SRec fs _) acc =
  Cons (PartVal v) (partsVals r (List.map snd fs) acc)
partsVal r v@(SProj w _ _ _) acc = Cons (PartVal v) (r.val w acc)
partsVal r v@(SPrim _ args) acc = Cons (PartVal v) (partsVals r args acc)
partsVal r v acc = Cons (PartVal v) acc

partsOp : PK -> Comp -> List Part -> List Part
partsOp r o@(OSimple v) acc = Cons (PartOp o) (r.val v acc)
partsOp r o@(OCall _ args) acc = Cons (PartOp o) (partsVals r args acc)
partsOp r o@(OApply f args) acc =
  Cons (PartOp o) (partsVals r (Cons f args) acc)
partsOp r o@(OPrim _ args) acc = Cons (PartOp o) (partsVals r args acc)
partsOp r o@(OBool c) acc = Cons (PartOp o) (r.cond c acc)
partsOp r o acc = Cons (PartOp o) acc

partsCond : PK -> Cond -> List Part -> List Part
partsCond r (PRel _ a b) acc = r.val a (r.val b acc)
partsCond r (PBool v) acc = r.val v acc
partsCond r (PNot c) acc = r.cond c acc
partsCond r (PIf a b c) acc = r.cond a (r.cond b (r.cond c acc))
partsCond r (PLet _ o c) acc = r.op o (r.cond c acc)
partsCond r _ acc = acc

partsSt : PK -> St -> List Part -> List Part
partsSt r (SLet _ o) acc = r.op o acc
partsSt r (SOnce _ o) acc = r.op o acc
partsSt r (SSet _ o) acc = r.op o acc
partsSt r (SIf c ts fs) acc = r.cond c (r.sts ts (r.sts fs acc))
partsSt r (SCase v arms) acc =
  r.val
    v
    (List.foldr
       (\arm a -> case arm of
        MkArm _ _ ss -> r.sts ss a)
       acc
       arms)
partsSt r _ acc = acc

partsSts : PK -> List St -> List Part -> List Part
partsSts r ss acc = List.foldr (\st a -> partsSt r st a) acc ss

partsTl : PK -> Tl -> List Part -> List Part
partsTl r (TSeq ss t) acc = r.sts ss (r.tl t acc)
partsTl r (TReturn o) acc = r.op o acc
partsTl r (TLoop vs) acc = partsVals r vs acc
partsTl r (TIf c t e) acc = r.cond c (r.tl t (r.tl e acc))
partsTl r (TCase v arms) acc =
  r.val
    v
    (List.foldr
       (\arm a -> case arm of
        MkArm _ _ t -> r.tl t a)
       acc
       arms)

pk : PK
pk =
  { val = \v acc -> partsVal pk v acc
  , op = \o acc -> partsOp pk o acc
  , cond = \c acc -> partsCond pk c acc
  , sts = \ss acc -> partsSts pk ss acc
  , tl = \t acc -> partsTl pk t acc
  }

-- | the parts of a tail
tailParts : Tl -> List Part
tailParts t = pk.tl t Nil

-- | the parts of statements
stmtsParts : List St -> List Part
stmtsParts ss = pk.sts ss Nil

-- | the parts of a definition
partsOf : Def -> List Part
partsOf (MkDef _ _ (DefFun _ (MkBlock t))) = tailParts t
partsOf (MkDef _ _ (DefVal (MkBlock t))) = tailParts t

-- | whether `x` is named in the parts
namedIn : String -> List Part -> Bool
namedIn x ps =
  List.any
    (\p -> case p of
     PartVal (SVar y) -> strEq x y
     _ -> False)
    ps

-- What is computed first
--------------------------------------------------------------------------------

-- (the names a value mentions, outside any lambda)
valNamesTop : Val -> List String -> List String
valNamesTop (SVar x) acc = Cons x acc
valNamesTop (STag _ args _) acc = List.foldr valNamesTop acc args
valNamesTop (SRec fs _) acc = List.foldr valNamesTop acc (List.map snd fs)
valNamesTop (SProj v _ _ _) acc = valNamesTop v acc
valNamesTop (SPrim _ args) acc = List.foldr valNamesTop acc args
valNamesTop v acc = acc

-- (... of a step's operands: not a condition's, which may bind names)
opNamesTop : Comp -> List String
opNamesTop (OSimple v) = valNamesTop v Nil
opNamesTop (OCall _ args) = List.foldr valNamesTop Nil args
opNamesTop (OApply f args) = List.foldr valNamesTop Nil (Cons f args)
opNamesTop (OPrim _ args) = List.foldr valNamesTop Nil args
opNamesTop o = Nil

-- | the names a statement mentions in what it computes first, before
-- | anything that may fail or not be computed at all (an arm, a lambda):
-- | where a name bound just before it, and named nowhere else, may be
-- | computed instead -- the same, in the same order
firstNames : St -> List String
firstNames (SLet _ o) = opNamesTop o
firstNames (SOnce _ o) = opNamesTop o
firstNames (SSet _ o) = opNamesTop o
firstNames (SCase v _) = valNamesTop v Nil
firstNames st = Nil

-- | ... a tail's
firstNamesTl : Tl -> List String
firstNamesTl (TSeq (Cons st _) _) = firstNames st
firstNamesTl (TReturn o) = opNamesTop o
firstNamesTl (TLoop vs) = List.foldr valNamesTop Nil vs
firstNamesTl (TCase v _) = valNamesTop v Nil
firstNamesTl t = Nil

-- | how many times `x` is named in the parts
timesIn : String -> List Part -> Int
timesIn x ps =
  List.length
    (List.keepIf
       (\p -> case p of
        PartVal (SVar y) -> strEq x y
        _ -> False)
       ps)

-- | whether a binding of `x` may be computed where it is used instead:
-- | named once in what follows it, there, first (`next`, what comes right
-- | after it; `rest`, all that does)
usedOnceNext : String -> List String -> List Part -> Bool
usedOnceNext x next rest =
  List.length (List.keepIf (\y -> strEq x y) next) == 1 && timesIn x rest == 1

-- Bindings used once
--------------------------------------------------------------------------------

-- In JavaScript a value a `const` holds is held to the end of its block
-- -- in a loop, a round -- however soon it is used, so a long list one
-- step makes and the next takes apart would be held while the steps
-- after go on, where a call made in place lets it go once it is taken
-- apart: a name whose one use, in what follows it, computes it instead
-- is `SOnce`.

-- (whether a binding computes its one use instead: not a condition's
-- `Bool`, whose names are declared before)
inlinable : String -> Comp -> List St -> Maybe Tl -> Bool
inlinable x (OBool _) rest after = False
inlinable x o rest after =
  usedOnceNext
    x
    (case rest of
     Cons st _ -> firstNames st
     Nil -> case after of
       Just t -> firstNamesTl t
       Nothing -> Nil)
    (List.append (stmtsParts rest) (case after of
     Just t -> tailParts t
     Nothing -> Nil))

-- (the walk, knotted: statements are given what follows them, `after`)
type OnceK =
  { val : Val -> Val
  , op : Comp -> Comp
  , cond : Cond -> Cond
  , sts : List St -> Maybe Tl -> List St
  , tl : Tl -> Tl
  }

onceVal : OnceK -> Val -> Val
onceVal k (SLam xs (MkBlock t)) = SLam xs (MkBlock (k.tl t))
onceVal k (STag tag args ts) = STag tag (List.map k.val args) ts
onceVal k (SRec fs ts) =
  SRec (List.map (\f -> MkPair (fst f) (k.val (snd f))) fs) ts
onceVal k (SProj v l ls t) = SProj (k.val v) l ls t
onceVal k (SPrim p args) = SPrim p (List.map k.val args)
onceVal k v = v

onceOp : OnceK -> Comp -> Comp
onceOp k (OSimple v) = OSimple (k.val v)
onceOp k (OCall g args) = OCall g (List.map k.val args)
onceOp k (OApply f args) = OApply (k.val f) (List.map k.val args)
onceOp k (OPrim p args) = OPrim p (List.map k.val args)
onceOp k (OBool c) = OBool (k.cond c)
onceOp k o = o

onceCond : OnceK -> Cond -> Cond
onceCond k (PRel p a b) = PRel p (k.val a) (k.val b)
onceCond k (PBool v) = PBool (k.val v)
onceCond k (PNot c) = PNot (k.cond c)
onceCond k (PIf a b c) = PIf (k.cond a) (k.cond b) (k.cond c)
onceCond k (PLet x o c) = PLet x (k.op o) (k.cond c)
onceCond k c = c

onceArm : {a : Type} -> (a -> a) -> Arm a -> Arm a
onceArm f (MkArm tag vs b) = MkArm tag vs (f b)

onceSt : OnceK -> St -> St
onceSt k (SLet x o) = SLet x (k.op o)
onceSt k (SOnce x o) = SOnce x (k.op o)
onceSt k (SSet x o) = SSet x (k.op o)
onceSt k (SIf c ts fs) = SIf (k.cond c) (k.sts ts Nothing) (k.sts fs Nothing)
onceSt k (SCase v arms) =
  SCase (k.val v) (List.map (onceArm (\ss -> k.sts ss Nothing)) arms)
onceSt k st = st

onceSts : OnceK -> List St -> Maybe Tl -> List St
onceSts k Nil after = Nil
onceSts k (Cons (SLet x o) rest) after =
  Cons
    (if inlinable x o rest after then SOnce x (k.op o) else SLet x (k.op o))
    (k.sts rest after)
onceSts k (Cons st rest) after = Cons (onceSt k st) (k.sts rest after)

onceTl : OnceK -> Tl -> Tl
onceTl k (TSeq ss t) = TSeq (k.sts ss (Just t)) (k.tl t)
onceTl k (TReturn o) = TReturn (k.op o)
onceTl k (TLoop vs) = TLoop (List.map k.val vs)
onceTl k (TIf c t e) = TIf (k.cond c) (k.tl t) (k.tl e)
onceTl k (TCase v arms) = TCase (k.val v) (List.map (onceArm k.tl) arms)

onceK : OnceK
onceK =
  { val = \v -> onceVal onceK v
  , op = \o -> onceOp onceK o
  , cond = \c -> onceCond onceK c
  , sts = \ss after -> onceSts onceK ss after
  , tl = \t -> onceTl onceK t
  }

onceBody : Body -> Body
onceBody (DefFun xs (MkBlock t)) = DefFun xs (MkBlock (onceK.tl t))
onceBody (DefVal (MkBlock t)) = DefVal (MkBlock (onceK.tl t))

-- | each binding whose one use, in what follows it, may compute it
-- | instead, `SOnce`: computed there
onceInlined : Def -> Def
onceInlined (MkDef key name b) = MkDef key name (onceBody b)
