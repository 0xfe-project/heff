-- The intermediate language as text, and hashed, for the backend's cache
-- (heff.build.backcache): a stream of tokens as heff.build.serial writes
-- core syntax -- every node a tag of fixed shape, counts before lists,
-- strings length-prefixed (`3:abc`) -- and `decodeExpr` its inverse; a
-- hash of an expression, walked without writing it out.

module heff.compile.irtext

import heff.build.decoder
import heff.elab.fixed
import heff.compile.ir as IR
import heff.elab.primitive
import heff.syntax.surface as Surface

-- Writing
--------------------------------------------------------------------------------

tok : String -> String
tok s = debug (strLength s) ^ ":" ^ s

-- (every encoder conses its tokens in front of those that follow)
strsT : List String -> List String -> List String
strsT [] rest = rest
strsT (x :: xs) rest = tok x :: strsT xs rest

manyT : List String -> List String -> List String
manyT xs rest = debug (List.length xs) :: strsT xs rest

type EK = { go : IR.Expr -> List String -> List String }

exprsT : EK -> List IR.Expr -> List String -> List String
exprsT k [] rest = rest
exprsT k (e :: es) rest = k.go e (exprsT k es rest)

fieldsT : EK -> List (Pair String IR.Expr) -> List String -> List String
fieldsT k [] rest = rest
fieldsT k (MkPair l e :: fs) rest = tok l :: k.go e (fieldsT k fs rest)

armsT : EK -> List IR.Arm -> List String -> List String
armsT k [] rest = rest
armsT k (MkArm t vs b :: arms) rest =
  tok t :: manyT vs (k.go b (armsT k arms rest))

-- (a condition: a tag of its own for each of its forms)
condT : EK -> IR.Cond -> List String -> List String
condT k CTrue rest = "T" :: rest
condT k CFalse rest = "F" :: rest
condT k (CRel p a b) rest = "R" :: tok (primName p) :: k.go a (k.go b rest)
condT k (CTest e) rest = "S" :: k.go e rest
condT k (CNot c) rest = "N" :: condT k c rest
condT k (CIf a b c) rest = "I" :: condT k a (condT k b (condT k c rest))

encodeF : EK -> IR.Expr -> List String -> List String
encodeF k (EVar x) rest = "v" :: tok x :: rest
encodeF k (EGlobal g) rest = "g" :: tok g :: rest
encodeF k (ELam xs b) rest = "l" :: manyT xs (k.go b rest)
encodeF k (EApp f args) rest =
  "a" :: k.go f (debug (List.length args) :: exprsT k args rest)
encodeF k (ELet x a b) rest = "t" :: tok x :: k.go a (k.go b rest)
encodeF k (ERecord fs ts) rest =
  "r"
  :: debug (List.length fs)
  :: fieldsT k fs (manyT (List.map IR.fieldTyName ts) rest)
encodeF k (EProj e l sh t) rest =
  "p" :: k.go e (tok l :: manyT sh (tok (IR.fieldTyName t) :: rest))
encodeF k (ETag t args ts) rest =
  "c"
  :: tok t
  :: debug (List.length args)
  :: exprsT k args (manyT (List.map IR.fieldTyName ts) rest)
encodeF k (EMatch s arms) rest =
  "m" :: k.go s (debug (List.length arms) :: armsT k arms rest)
encodeF k (EPrim p) rest = "q" :: tok (primName p) :: rest
encodeF k (EPrimCall p args) rest =
  "k" :: tok (primName p) :: debug (List.length args) :: exprsT k args rest
encodeF k (ECall g args) rest =
  "K" :: tok g :: debug (List.length args) :: exprsT k args rest
encodeF k (EInt i) rest = "i" :: tok (debug i) :: rest
encodeF k (EFloat x) rest = "f" :: tok (debug x) :: rest
encodeF k (EStr s) rest = "s" :: tok s :: rest
encodeF k (EBytes s) rest = "b" :: tok s :: rest
encodeF k (EFixed w n) rest = "x" :: fixedName w :: tok (debug n) :: rest
encodeF k (EFloat32 x) rest = "y" :: tok (debug x) :: rest
encodeF k EAbandon rest = "X" :: rest
encodeF k (EFix f b) rest = "F" :: tok f :: k.go b rest
encodeF k (EBool c) rest = "o" :: condT k c rest
encodeF k (ESet xs a b) rest = "e" :: manyT xs (k.go a (k.go b rest))
encodeF k (EValues es) rest = "w" :: debug (List.length es) :: exprsT k es rest

ek : EK
ek = { go = \e rest -> encodeF ek e rest }

-- | an expression as text
encodeExpr : IR.Expr -> String
encodeExpr e = joinWith " " (ek.go e Nil)

-- Reading
--------------------------------------------------------------------------------

type DK = { go : Dec IR.Expr }

consD : {a : Type} -> Dec a -> Dec (List a) -> Dec (List a)
consD d more = do
  x <- d
  xs <- more
  pure (x :: xs)

-- (`n` of what `d` reads)
nD : {a : Type} -> Dec a -> Int -> Dec (List a)
nD d n = if n <= 0 then pure Nil else consD d (nD d (n - 1))

manyD : {a : Type} -> Dec a -> Dec (List a)
manyD d = bind int (nD d)

fieldD : DK -> Dec (Pair String IR.Expr)
fieldD k = do
  l <- str
  e <- k.go
  pure (MkPair l e)

armD : DK -> Dec IR.Arm
armD k = do
  t <- str
  vs <- manyD str
  b <- k.go
  pure (MkArm t vs b)

-- (a primitive, by its name)
primD : Dec Prim
primD = do
  x <- str
  found (primOfName x)

fixedD : Dec Fixed
fixedD = do
  w <- word
  found (fixedOfName w)

fieldTyD : Dec IR.FieldTy
fieldTyD = do
  x <- str
  found (IR.fieldTyOfName x)

type CK = { go : Dec IR.Cond }

condOfTag : DK -> CK -> String -> Dec IR.Cond
condOfTag k c "T" = pure CTrue
condOfTag k c "F" = pure CFalse
condOfTag k c "R" = do
  p <- primD
  a <- k.go
  b <- k.go
  pure (CRel p a b)
condOfTag k c "S" = do
  e <- k.go
  pure (CTest e)
condOfTag k c "N" = do
  x <- c.go
  pure (CNot x)
condOfTag k c "I" = do
  a <- c.go
  b <- c.go
  x <- c.go
  pure (CIf a b x)
condOfTag k c _ = fail

ckOf : DK -> CK
ckOf k = { go = \s i -> bind word (condOfTag k (ckOf k)) s i }

exprOf : DK -> String -> Dec IR.Expr
exprOf k "v" = do
  x <- str
  pure (EVar x)
exprOf k "g" = do
  g <- str
  pure (EGlobal g)
exprOf k "l" = do
  xs <- manyD str
  b <- k.go
  pure (ELam xs b)
exprOf k "a" = do
  f <- k.go
  args <- manyD k.go
  pure (EApp f args)
exprOf k "t" = do
  x <- str
  a <- k.go
  b <- k.go
  pure (ELet x a b)
exprOf k "r" = do
  fs <- manyD (fieldD k)
  ts <- manyD fieldTyD
  pure (ERecord fs ts)
exprOf k "p" = do
  e <- k.go
  l <- str
  sh <- manyD str
  t <- fieldTyD
  pure (EProj e l sh t)
exprOf k "c" = do
  t <- str
  args <- manyD k.go
  ts <- manyD fieldTyD
  pure (ETag t args ts)
exprOf k "m" = do
  s <- k.go
  arms <- manyD (armD k)
  pure (EMatch s arms)
exprOf k "q" = do
  p <- primD
  pure (EPrim p)
exprOf k "k" = do
  p <- primD
  args <- manyD k.go
  pure (EPrimCall p args)
exprOf k "K" = do
  g <- str
  args <- manyD k.go
  pure (ECall g args)
exprOf k "i" = do
  x <- str
  pure (EInt (Surface.intOfText x))
exprOf k "f" = do
  x <- str
  pure (EFloat (Surface.floatOfText x))
exprOf k "s" = do
  x <- str
  pure (EStr x)
exprOf k "b" = do
  x <- str
  pure (EBytes x)
exprOf k "x" = do
  w <- fixedD
  x <- str
  pure (EFixed w (Surface.intOfText x))
exprOf k "y" = do
  x <- str
  pure (EFloat32 (Surface.floatOfText x))
exprOf k "X" = pure EAbandon
exprOf k "e" = do
  xs <- manyD str
  a <- k.go
  b <- k.go
  pure (ESet xs a b)
exprOf k "w" = do
  es <- manyD k.go
  pure (EValues es)
exprOf k "o" = do
  c <- (ckOf k).go
  pure (EBool c)
exprOf k "F" = do
  f <- str
  b <- k.go
  pure (EFix f b)
exprOf k _ = fail

dk : DK
dk = { go = \s i -> bind word (exprOf dk) s i }

-- | an expression, read from where the stream is
takeExpr : Dec IR.Expr
takeExpr = dk.go

-- | an expression, read whole from its text
-- | >>> decodeExpr (encodeExpr (ELam ["x$1", "a b"] (EMatch (EVar "x$1") [MkArm "Cons" ["h", "t"] (EApp (EGlobal "m.f") [EStr "3:a b", EInt (0 - 7), EProj (ERecord [MkPair "l" (EFloat 0.5)] [FtFloat]) "l" ["l"] FtFloat])])))
-- | Just (ELam (Cons "x$1" (Cons "a b" Nil)) (EMatch (EVar "x$1") (Cons (MkArm "Cons" (Cons "h" (Cons "t" Nil)) (EApp (EGlobal "m.f") (Cons (EStr "3:a b") (Cons (EInt (-7)) (Cons (EProj (ERecord (Cons (MkPair "l" (EFloat 0.5)) Nil) (Cons FtFloat Nil)) "l" (Cons "l" Nil) FtFloat) Nil))))) Nil)))
decodeExpr : String -> Maybe IR.Expr
decodeExpr s = run (whole takeExpr) s

-- Hashing: two polynomial hashes, each modulo a prime below 2^31, of
-- what the text would be (its tags, counts and strings), walked as a
-- worklist -- no text made
--------------------------------------------------------------------------------

stepA : Int -> Int -> Int
stepA h c = (h * 1000003 + c + 1) % 2147483647

stepB : Int -> Int -> Int
stepB h c = (h * 999983 + c + 1) % 2147483629

-- | what is still to be hashed: an expression, a string, a number
data HItem = HE IR.Expr | HS String | HN Int | HC IR.Cond

-- (a string's bytes, then its end)
bytesH : String -> Int -> Int -> Int -> Pair Int Int
bytesH s i a b =
  if i >= strLength s then MkPair (stepA a 256) (stepB b 256)
  else bytesH s (i + 1) (stepA a (byteAt s i)) (stepB b (byteAt s i))

strsH : List String -> List HItem -> List HItem
strsH [] rest = rest
strsH (x :: xs) rest = HS x :: strsH xs rest

exprsH : List IR.Expr -> List HItem -> List HItem
exprsH [] rest = rest
exprsH (e :: es) rest = HE e :: exprsH es rest

fieldsH : List (Pair String IR.Expr) -> List HItem -> List HItem
fieldsH [] rest = rest
fieldsH (MkPair l e :: fs) rest = HS l :: HE e :: fieldsH fs rest

armsH : List IR.Arm -> List HItem -> List HItem
armsH [] rest = rest
armsH (MkArm t vs b :: arms) rest =
  HS t :: HN (List.length vs) :: strsH vs (HE b :: armsH arms rest)

-- (a node: its tag's number, then its parts, before the rest)
nodeH : IR.Expr -> List HItem -> List HItem
nodeH (EVar x) rest = HN 1 :: HS x :: rest
nodeH (EGlobal g) rest = HN 2 :: HS g :: rest
nodeH (ELam xs b) rest = HN 3 :: HN (List.length xs) :: strsH xs (HE b :: rest)
nodeH (EApp f args) rest =
  HN 4 :: HE f :: HN (List.length args) :: exprsH args rest
nodeH (ELet x a b) rest = HN 5 :: HS x :: HE a :: HE b :: rest
nodeH (ERecord fs ts) rest =
  HN 6
  :: HN (List.length fs)
  :: fieldsH
    fs
    (HN (List.length ts) :: strsH (List.map IR.fieldTyName ts) rest)
nodeH (EProj e l sh t) rest =
  HN 7
  :: HE e
  :: HS l
  :: HN (List.length sh)
  :: strsH sh (HS (IR.fieldTyName t) :: rest)
nodeH (ETag t args ts) rest =
  HN 8
  :: HS t
  :: HN (List.length args)
  :: exprsH
    args
    (HN (List.length ts) :: strsH (List.map IR.fieldTyName ts) rest)
nodeH (EMatch s arms) rest =
  HN 9 :: HE s :: HN (List.length arms) :: armsH arms rest
nodeH (EPrim p) rest = HN 10 :: HS (primName p) :: rest
nodeH (EPrimCall p args) rest =
  HN 11 :: HS (primName p) :: HN (List.length args) :: exprsH args rest
nodeH (ECall g args) rest =
  HN 12 :: HS g :: HN (List.length args) :: exprsH args rest
nodeH (EInt i) rest = HN 13 :: HS (debug i) :: rest
nodeH (EFloat x) rest = HN 14 :: HS (debug x) :: rest
nodeH (EStr s) rest = HN 15 :: HS s :: rest
nodeH (EFixed w n) rest = HN 16 :: HS (fixedName w) :: HS (debug n) :: rest
nodeH (EFloat32 x) rest = HN 17 :: HS (debug x) :: rest
nodeH EAbandon rest = HN 18 :: rest
nodeH (EFix f b) rest = HN 19 :: HS f :: HE b :: rest
nodeH (EBytes s) rest = HN 20 :: HS s :: rest
nodeH (EBool c) rest = HN 21 :: HC c :: rest
nodeH (ESet xs a b) rest =
  HN 22 :: HN (List.length xs) :: strsH xs (HE a :: HE b :: rest)
nodeH (EValues es) rest = HN 23 :: HN (List.length es) :: exprsH es rest

-- (a condition: its form's number, then its parts)
condH : IR.Cond -> List HItem -> List HItem
condH CTrue rest = HN 30 :: rest
condH CFalse rest = HN 31 :: rest
condH (CRel p a b) rest = HN 32 :: HS (primName p) :: HE a :: HE b :: rest
condH (CTest e) rest = HN 33 :: HE e :: rest
condH (CNot c) rest = HN 34 :: HC c :: rest
condH (CIf a b c) rest = HN 35 :: HC a :: HC b :: HC c :: rest

hashTake : (Int -> Int -> List HItem -> Pair Int Int)
         -> List HItem
         -> Pair Int Int
         -> Pair Int Int
hashTake go rest (MkPair a b) = go a b rest

hashW : Int -> Int -> List HItem -> Pair Int Int
hashW a b [] = MkPair a b
hashW a b (HN n :: rest) = hashW (stepA a (n + 300)) (stepB b (n + 300)) rest
hashW a b (HS s :: rest) = hashTake hashW rest (bytesH s 0 a b)
hashW a b (HE e :: rest) = hashW a b (nodeH e rest)
hashW a b (HC c :: rest) = hashW a b (condH c rest)

-- | strings and expressions hashed, in order, into one hash
-- | >>> strEq (hashOf [HE (ELam ["x"] (EVar "x"))]) (hashOf [HE (ELam ["x"] (EVar "x"))])
-- | True
-- | >>> strEq (hashOf [HE (EStr "ab"), HS "c"]) (hashOf [HE (EStr "a"), HS "bc"])
-- | False
hashOf : List HItem -> String
hashOf items = case hashW 5381 7919 items of
  MkPair a b -> debug a ^ "-" ^ debug b
