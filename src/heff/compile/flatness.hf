-- Arrays a loop reads checked flat once, for the C backend: an array of
-- a fixed-width number (`Int64`, `UInt8`, ...) may keep its elements
-- flat or as `V`s, so a read of one, known in range where its index was
-- tested (`arrayIndexInAny`, heff.compile.tested), looks at how it keeps
-- them, each read -- each round of a loop.  But an array that a loop
-- gives itself, or itself set, each round keeps them as it did where
-- the loop was entered (a `set` writes an element as the array keeps
-- them, a copy keeps them as the array it is of).
--
-- So a function going round a loop (`CLoop`) whose reads in range are of
-- such arrays checks, once, where it is entered, that each keeps the
-- number read flat (`arrayKeeps`), and if so goes round a copy of its
-- loop of its own, those reads not looking (`arrayIndexIn`); if not,
-- round the loop as it was.  An array held alone where the loop is
-- entered (heff.compile.owned, `arrayOwn` of the number) is flat there
-- already: its reads look nowhere, with no check.

module heff.compile.flatness

import heff.compile.bounds as Bounds
import heff.compile.owned as Owned
import heff.compile.refcount as RefCount
import heff.compile.repr as Repr

-- Reads
--------------------------------------------------------------------------------

-- | a read of an array kept flat: the array (a parameter of the loop's
-- | that keeps how it keeps its elements), the number read
type Read = Pair String Repr.Repr

-- (the array of `arrays` that a variable is, if one is)
baseOf : Bounds.Info -> Maybe String -> Maybe String
baseOf info (Just y) = Bounds.baseOf info y
baseOf info Nothing = Nothing

readOf : Repr.Repr -> Maybe String -> List Read
readOf r (Just b) = [MkPair b r]
readOf r Nothing = Nil

-- (a fixed-width number's read known in range, of one of `arrays`)
ownRead : Bounds.Info -> RefCount.Value -> List Read
ownRead info (RPrimAt "arrayIndexInAny" (RepFix w) (Cons a _)) =
  readOf (RepFix w) (baseOf info (Bounds.varOf a))
ownRead info e = Nil

-- | the reads of arrays kept flat in a value (not in a lambda's body)
readsIn : Bounds.Info -> RefCount.Value -> List Read
readsIn info e =
  List.append
    (ownRead info e)
    (List.concatMap (readsIn info) (Owned.kids e))

-- | ... in a body
readsOf : Bounds.Info -> List RefCount.Statement -> List Read
readsOf info ss =
  List.concatMap (\p -> readsIn info (snd p)) (Bounds.scoped info Nil ss)

sameRead : Read -> Read -> Bool
sameRead (MkPair a r) (MkPair b s) = strEq a b && Repr.reprEq r s

isRead : List Read -> Read -> Bool
isRead rs r = List.any (sameRead r) rs

nubReads : List Read -> List Read -> List Read
nubReads seen Nil = Nil
nubReads seen (Cons r rs) =
  if isRead seen r then nubReads seen rs
  else Cons r (nubReads (Cons r seen) rs)

-- | the arrays held alone where the function is entered, each kept flat
-- | as the number (heff.compile.owned)
ownedSt : RefCount.Statement -> List Read
ownedSt (CSet x (RPrimAt "arrayOwn" r (Cons (RLocal y) Nil))) =
  if strEq x y then [MkPair x r] else Nil
ownedSt s = Nil

-- Flat
--------------------------------------------------------------------------------

-- (a read of one of the arrays known flat, not looking)
flatRead : Bounds.Info -> List Read -> RefCount.Value -> RefCount.Value
flatRead info flat (RPrimAt "arrayIndexInAny" r (Cons a es)) =
  if maybe False (\b -> isRead flat (MkPair b r)) (baseOf info (Bounds.varOf a))
  then RPrimAt "arrayIndexIn" r (Cons a es)
  else RPrimAt "arrayIndexInAny" r (Cons a es)
flatRead info flat e = e

-- | where the copy of the loop starts
label : String
label = "Flat"

-- (the loop again: round the copy, `toCopy`, or as it was)
again : Bool -> List String -> List RefCount.Value -> RefCount.Statement
again True ps es = CLoopTo label ps es
again False ps es = CLoop ps es

-- | a statement, each value made by `f` (bottom up, not in a lambda's
-- | body), going round the copy again where `toCopy`
mapSt : (List RefCount.Statement -> List RefCount.Statement)
      -> (RefCount.Value -> RefCount.Value)
      -> Bool
      -> RefCount.Statement
      -> RefCount.Statement
mapSt go f toCopy (CLet x e) = CLet x (Bounds.mapExp f e)
mapSt go f toCopy (CSet x e) = CSet x (Bounds.mapExp f e)
mapSt go f toCopy (CReturn e) = CReturn (Bounds.mapExp f e)
mapSt go f toCopy (CIf c a b) =
  CIf (Owned.mapCond (Bounds.mapExp f) c) (go a) (go b)
mapSt go f toCopy (CSwitch e arms r) =
  CSwitch (Bounds.mapExp f e) (List.map (Bounds.fixArm go) arms) r
mapSt go f toCopy (CInPlace g es) =
  CInPlace (Bounds.mapExp f g) (List.map (Bounds.mapExp f) es)
mapSt go f toCopy (CRoomed g es) =
  CRoomed (Bounds.mapExp f g) (List.map (Bounds.mapExp f) es)
mapSt go f toCopy (CTail g es) =
  CTail (Bounds.mapExp f g) (List.map (Bounds.mapExp f) es)
mapSt go f toCopy (CLoop ps es) =
  again toCopy ps (List.map (Bounds.mapExp f) es)
mapSt go f toCopy (CJump g w es) = CJump g w (List.map (Bounds.mapExp f) es)
mapSt go f toCopy s = s

mapStmts : (RefCount.Value -> RefCount.Value)
         -> Bool
         -> List RefCount.Statement
         -> List RefCount.Statement
mapStmts f toCopy ss = List.map (mapSt (mapStmts f toCopy) f toCopy) ss

-- The check
--------------------------------------------------------------------------------

keepsFlat : Read -> RefCount.Test
keepsFlat (MkPair b r) = CondBool (RPrimAt "arrayKeeps" r (Cons (RDup b) Nil))

allOf : List RefCount.Test -> RefCount.Test
allOf Nil = CondTrue
allOf (Cons c Nil) = c
allOf (Cons c cs) = CondIf c (allOf cs) CondFalse

-- The function
--------------------------------------------------------------------------------

-- (the function, its reads of `owned` not looking, and where `checked`
-- are kept flat, round a copy of its loop whose reads of those do not
-- either)
flatWith : RefCount.Fun
         -> Bounds.Info
         -> List Read
         -> List Read
         -> RefCount.Fun
flatWith f info owned Nil =
  { key = f.key
  , params = f.params
  , lent = f.lent
  , entry = f.entry
  , body = mapStmts (flatRead info owned) False f.body
  , reprs = f.reprs
  , ret = f.ret
  , wrapper = f.wrapper
  }
flatWith f info owned checked =
  { key = f.key
  , params = f.params
  , lent = f.lent
  , entry =
      List.append
        f.entry
        (Cons
           (CIf
              (allOf (List.map keepsFlat checked))
              (Cons
                 (CLabel label)
                 (mapStmts
                    (flatRead info (List.append owned checked))
                    True
                    f.body))
              Nil)
           Nil)
  , body = mapStmts (flatRead info owned) False f.body
  , reprs = f.reprs
  , ret = f.ret
  , wrapper = f.wrapper
  }

flatReads : RefCount.Fun -> Bounds.Info -> List Read -> RefCount.Fun
flatReads f info Nil = f
flatReads f info rs =
  flatWith
    f
    info
    (List.keepIf (isRead (List.concatMap ownedSt f.entry)) rs)
    (List.keepIf
       (\r -> not (isRead (List.concatMap ownedSt f.entry) r))
       rs)

flatLoop : RefCount.Fun
         -> List (Pair String RefCount.Value)
         -> List Bounds.Again
         -> RefCount.Fun
flatLoop f ds ags =
  let info : Bounds.Info =
    { indices = Nil, arrays = Bounds.kept f ds ags, defs = ds }
  in flatReads f info (nubReads Nil (readsOf info f.body))

-- | a function going round a loop, its arrays read in range checked
-- | flat once where it is entered, where they may be
flatnessFun : RefCount.Fun -> RefCount.Fun
flatnessFun f =
  let ags = Bounds.agains Nil f.body
  in if List.null ags || Bounds.labelled False f.body then f
  else flatLoop f (Owned.defsOf Nil f.body) ags

-- | a definition of the C backend's, its loops' arrays read in range
-- | checked flat once where they may be
flatnessDef : RefCount.Def -> RefCount.Def
flatnessDef (DFun f) = DFun (flatnessFun f)
flatnessDef d = d
