-- Arrays generated by a loop (#102), for the C backend: `generate n f`
-- of a lambda calls the lambda, a closure, for each element (the
-- runtime's `heff_arrayGenerate`), its value boxed, so that nothing of
-- it is inlined, and no loop of it made vector operations.  Here such a
-- `generate` is a loop of its own, a global given what the lambda
-- captures, its body the lambda's, setting each element of the array it
-- is going round with:
--
--   generate n (\i -> e)              let m = n in
--                                     if m <= 0 then generate m (\_ -> abandon)
--                                     else let y = e[i := 0] in
--                                       loop$generate 1 (replicate m y)
--
--   loop$generate i a = if i < arrayLength a
--                       then loop$generate (i + 1) (arraySet a i e) else a
--
-- -- the first element built first, the array made of it (flat where it
-- is a number), the others set into it in place (heff.compile.owned
-- checks the array held only there once; heff.compile.bounds the index
-- once).  A `map`, a `generate` of `arrayLength xs` whose lambda reads
-- `xs` only at its index, writes each element where it read it, into
-- `xs` itself, where `xs` keeps its elements as the first one built
-- would be kept (`arrayKeepsAs`: flat as one number, or `V`s), so
-- that `xs`, held only there, is changed in place:
--
--   loop$map i a = if i < arrayLength a
--                  then loop$map (i + 1) (arraySet a i e[xs := a]) else a
--
-- A lambda that calls a function it does not know, or is big (its body
-- copied twice, three times for a `map`), is left a closure.  The
-- JavaScript backend has no `set` in place, and keeps `generate`: this
-- runs on what the C backend is given (heff.compile.lower), first.

module heff.compile.arrayloops

import heff.compile.ir as IR
import heff.compile.lift as Lift
import std.ordmap as OrdMap
import heff.elab.primitive

-- Going through, drawing names and making loops
--------------------------------------------------------------------------------

-- | where fresh names go on from, the loops made so far (the last
-- | first), and how many
type St = { n : IR.Supply, out : List IR.Def, k : Int }

-- | computations drawing fresh names and making loops
type S a = St -> Pair a St

bindTake : {a b : Type} -> (a -> S b) -> Pair a St -> Pair b St
bindTake f (MkPair x s) = f x s

-- `do` is this
bind : {a b : Type} -> S a -> (a -> S b) -> S b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> S a
pure x = \s -> MkPair x s

instance instanceMonadS : Monad S
instanceMonadS = { pure = pure, bind = bind }

-- (a value, the supply where it ended)
supplied : {a : Type} -> St -> Pair a IR.Supply -> Pair a St
supplied s (MkPair x n) = MkPair x { n = n, out = s.out, k = s.k }

-- (a variable named afresh)
freshVar : String -> S String
freshVar base = \s -> supplied s (IR.fresh base s.n)

-- (an expression, each name it binds drawn afresh)
freshened : IR.Expr -> S IR.Expr
freshened e = \s -> supplied s (IR.freshen s.n e)

-- (the number of the next loop, counted)
nextLoop : S Int
nextLoop = \s -> MkPair s.k { n = s.n, out = s.out, k = s.k + 1 }

-- (a loop made)
made : IR.Def -> S Unit
made d = \s -> MkPair MkUnit { n = s.n, out = Cons d s.out, k = s.k }

-- What may be a loop
--------------------------------------------------------------------------------

-- | how big a lambda's body may be: it is copied, two or three times
bodyLimit : Int
bodyLimit = 100

-- | whether it calls a function it does not know: a variable's
-- | >>> List.map callsUnknown [EApp (EVar "f") [EInt 1], EPrimCall IntAdd [EVar "x", EInt 1]]
-- | [True, False]
callsUnknown : IR.Expr -> Bool
callsUnknown (EApp (EVar _) _) = True
callsUnknown e = List.any callsUnknown (IR.partsOnto e Nil)

-- | whether a lambda's body is worth a loop: it computes something, calls
-- | nothing it does not know, and is not too big to copy
worthALoop : IR.Expr -> Bool
worthALoop EAbandon = False
worthALoop e = not (callsUnknown e) && not (IR.sizeAbove bodyLimit e)

-- (whether a primitive's call reads `xs` at `i`)
readsAt : String -> String -> Prim -> List IR.Expr -> Bool
readsAt xs i ArrayIndex (Cons (EVar a) (Cons (EVar j) Nil)) =
  strEq a xs && strEq j i
readsAt xs i p es = False

-- | whether `e` mentions `xs` only to read it at `i`
-- | >>> List.map (readOnlyAt "xs" "i") [EPrimCall ArrayIndex [EVar "xs", EVar "i"], EPrimCall ArrayIndex [EVar "xs", EInt 0]]
-- | [True, False]
readOnlyAt : String -> String -> IR.Expr -> Bool
readOnlyAt xs i (EVar y) = not (strEq y xs)
readOnlyAt xs i (EPrimCall p es) =
  readsAt xs i p es || List.all (readOnlyAt xs i) es
readOnlyAt xs i e = List.all (readOnlyAt xs i) (IR.partsOnto e Nil)

-- | the array a `generate` of its length maps, if it is one
mapped : IR.Expr -> Maybe String
mapped (EPrimCall ArrayLength (Cons (EVar xs) Nil)) = Just xs
mapped e = Nothing

-- The loops
--------------------------------------------------------------------------------

vars : List String -> List IR.Expr
vars xs = List.map (\x -> EVar x) xs

-- | a loop's body: below the length of the array `a`, the element at
-- | `i` set to `e`, then on, at `i + 1`; past it, `a`
loopBody : String -> List String -> String -> String -> IR.Expr -> IR.Expr
loopBody key ps i a e =
  IR.ifOf
    (EPrimCall IntLt [EVar i, EPrimCall ArrayLength [EVar a]])
    (EApp
       (EGlobal key)
       (List.append
          (vars ps)
          [ EPrimCall IntAdd [EVar i, EInt 1]
          , EPrimCall ArraySet [EVar a, EVar i, e]
          ]))
    (EVar a)

-- | a loop, the global `key`, given `ps` and then the index `i` and the
-- | array `a`, its element at `i` being `e`: its names drawn afresh
loopOf : String
       -> String
       -> List String
       -> String
       -> String
       -> IR.Expr
       -> S Unit
loopOf key name ps i a e = do
  body <-
    freshened
      (ELam (List.append ps [i, a]) (loopBody key ps i a e))
  made (IR.mkDef key name body)

-- (a call of the loop `key`, given `ps`, from 1 with the array `a`)
fromOne : String -> List String -> IR.Expr -> IR.Expr
fromOne key ps a = EApp (EGlobal key) (List.append (vars ps) [EInt 1, a])

-- | what a loop is made of: the definition's key and name, the lambda's
-- | parameter and body, the variables it captures, the loop's number, the
-- | length's variable and the first element's
type Gen =
  { key : String
  , name : String
  , i : String
  , e : IR.Expr
  , ps : List String
  , k : Int
  , m : String
  , y : String
  }

-- (the loop setting the elements of an array made of the first,
-- `replicate m y`, from 1)
freshCall : Gen -> IR.Expr
freshCall g =
  fromOne
    (g.key ^ "$generate" ^ show g.k)
    g.ps
    (EPrimCall ArrayReplicate [EVar g.m, EVar g.y])

-- | of a `map` of `xs`: the loop writing into `xs` where it keeps its
-- | elements as the first, `y`, would be kept, `y` set at 0 first; else
-- | the other
inPlace : Gen -> String -> S IR.Expr
inPlace g xs = do
  a <- freshVar "a"
  loopOf
      (g.key ^ "$map" ^ show g.k)
      (g.name ^ ".map")
      (List.keepIf (\p -> not (strEq p xs)) g.ps)
      g.i
      a
      (IR.subst (OrdMap.insert OrdMap.empty xs (EVar a)) g.e)
  pure
      (IR.ifOf
         (EPrimCall ArrayKeepsAs [EVar xs, EVar g.y])
         (fromOne
            (g.key ^ "$map" ^ show g.k)
            (List.keepIf (\p -> not (strEq p xs)) g.ps)
            (EPrimCall ArraySet [EVar xs, EInt 0, EVar g.y]))
         (freshCall g))

-- (the loops, the first element built: in place too, of a `map`)
afterFirst : Gen -> Maybe String -> S IR.Expr
afterFirst g (Just xs) =
  if readOnlyAt xs g.i g.e then inPlace g xs else pure (freshCall g)
afterFirst g Nothing = pure (freshCall g)

-- (... the first element, `y`, built: `e` at 0)
withFirst : Gen -> IR.Expr -> S IR.Expr
withFirst g n = do
  u <- freshVar "u"
  a <- freshVar "a"
  first <- freshened (IR.subst (OrdMap.insert OrdMap.empty g.i (EInt 0)) g.e)
  loopOf (g.key ^ "$generate" ^ show g.k) (g.name ^ ".generate") g.ps g.i a g.e
  rest <- afterFirst g (mapped n)
  pure
      (ELet
         g.m
         n
         (IR.ifOf
            (EPrimCall IntLe [EVar g.m, EInt 0])
            (EPrimCall ArrayGenerate [EVar g.m, ELam [u] EAbandon])
            (ELet g.y first rest)))

-- | `generate n (\i -> e)` as a loop, of the definition `key` known as
-- | `name`: `e` worth one
asLoop : String -> String -> IR.Expr -> String -> IR.Expr -> S IR.Expr
asLoop key name n i e = do
  k <- nextLoop
  m <- freshVar "m"
  y <- freshVar "y"
  withFirst
      { key = key
      , name = name
      , i = i
      , e = e
      , ps = Lift.freeVars [i] e
      , k = k
      , m = m
      , y = y
      }
      n

-- (a `generate` of a lambda of one parameter, a loop where it is worth one)
generated : String -> String -> IR.Expr -> IR.Expr -> S IR.Expr
generated key name n (ELam (Cons i Nil) e) =
  if worthALoop e then asLoop key name n i e
  else pure (EPrimCall ArrayGenerate [n, ELam [i] e])
generated key name n f = pure (EPrimCall ArrayGenerate [n, f])

-- (a primitive's call, its operands gone through already)
primOf : String -> String -> Prim -> List IR.Expr -> S IR.Expr
primOf key name ArrayGenerate (Cons n (Cons f Nil)) = generated key name n f
primOf key name p es = pure (EPrimCall p es)

-- Everywhere
--------------------------------------------------------------------------------

-- (a node, its parts gone through already)
nodeOf : String -> String -> IR.Expr -> S IR.Expr
nodeOf key name (EPrimCall p es) = primOf key name p es
nodeOf key name e = pure e

-- | an expression of the definition `key` known as `name`, each
-- | `generate` worth a loop made one, inner ones first
go : String -> String -> IR.Expr -> S IR.Expr
go key name e =
  bind
    (IR.traversePartsM (mo := instanceMonadS) (\_ p -> go key name p) e)
    (nodeOf key name)

-- (a definition gone through, and the loops made of it after it)
defLoops : Pair IR.Expr St -> IR.Def -> Pair (List IR.Def) IR.Supply
defLoops (MkPair b s) d =
  MkPair (Cons (IR.mkDef d.key d.name b) (List.reverse s.out)) s.n

defOf : IR.Supply -> IR.Def -> Pair (List IR.Def) IR.Supply
defOf n d = defLoops (go d.key d.name d.body { n = n, out = Nil, k = 0 }) d

-- (... in front of those gone through already)
defsOnto : Pair (List (List IR.Def)) IR.Supply
         -> IR.Def
         -> Pair (List (List IR.Def)) IR.Supply
defsOnto (MkPair acc n) d = case defOf n d of
  MkPair ds n2 -> MkPair (Cons ds acc) n2

-- | the program, each `generate` worth a loop made one, the loops after
-- | the definition they are of; where fresh names go on from
-- | >>> List.map (\(d : IR.Def) -> d.key) (fst (loopsProgram 10 [IR.mkDef "m.f" "f" (ELam ["xs"] (EPrimCall ArrayGenerate [EPrimCall ArrayLength [EVar "xs"], ELam ["i"] (EPrimCall FloatAdd [EPrimCall ArrayIndex [EVar "xs", EVar "i"], EFloat 1.0])]))]))
-- | ["m.f", "m.f$generate0", "m.f$map0"]
loopsProgram : IR.Supply -> List IR.Def -> Pair (List IR.Def) IR.Supply
loopsProgram n defs = case List.foldl defsOnto (MkPair Nil n) defs of
  MkPair acc n2 -> MkPair (List.concatMap (\ds -> ds) (List.reverse acc)) n2
