-- Calls with all their arguments at once.
-- A definition that is a function of `n` parameters is called directly
-- (`ECall`) wherever it is given `n` arguments or more; the same for
-- primitives.

import heff.compile.ir as I
import heff.compile.prims as Pr
import map as M

arityOne : M.Map String Int -> I.Def -> M.Map String Int
arityOne m d@{ body = ELam xs _ } =
  M.insert compareString d.key (List.length xs) m
arityOne m d = m

-- | the definitions that are functions, and of how many parameters
arities : List I.Def -> M.Map String Int
arities defs = List.foldl arityOne M.empty defs

takeA : {a : Type} -> Int -> List a -> List a
takeA n Nil = Nil
takeA n (Cons x xs) = if n <= 0 then Nil else Cons x (takeA (n - 1) xs)

dropA : {a : Type} -> Int -> List a -> List a
dropA n Nil = Nil
dropA n (Cons x xs) = if n <= 0 then Cons x xs else dropA (n - 1) xs

restOf : I.Expr -> List I.Expr -> I.Expr
restOf f as = if List.length as == 0 then f else EApp f as

type SK = { go : I.Expr -> I.Expr }

callOf : SK -> M.Map String Int -> I.Expr -> List I.Expr -> I.Expr
callOf r ar h@(EGlobal g) as = case M.lookup compareString g ar of
  Just n ->
    if List.length as >= n then restOf (ECall g (takeA n as)) (dropA n as)
    else EApp (r.go h) as
  Nothing -> EApp (r.go h) as
callOf r ar h@(EPrim p) as = case Pr.primArity p of
  Just n ->
    if List.length as >= n then restOf (EPrimCall p (takeA n as)) (dropA n as)
    else EApp (r.go h) as
  Nothing -> EApp (r.go h) as
callOf r ar h as = EApp (r.go h) as

satGo : SK -> M.Map String Int -> I.Expr -> I.Expr
satGo r ar (EApp f as0) = case I.spine (EApp f as0) of
  MkPair h as -> callOf r ar h (List.map (\a -> r.go a) as)
satGo r ar (ELam xs b) = ELam xs (r.go b)
satGo r ar (ELet x a b) = ELet x (r.go a) (r.go b)
satGo r ar (ERecord fs ts) =
  ERecord
    (List.map
       (\p -> case p of
        MkPair l e2 -> MkPair l (r.go e2))
       fs)
    ts
satGo r ar (EProj e2 l sh t) = EProj (r.go e2) l sh t
satGo r ar (ETag t as) = ETag t (List.map (\a -> r.go a) as)
satGo r ar (EMatch s arms) =
  EMatch
    (r.go s)
    (List.map
       (\a -> case a of
        MkArm t vs b -> MkArm t vs (r.go b))
       arms)
satGo r ar (EPrimCall p as) = EPrimCall p (List.map (\a -> r.go a) as)
satGo r ar (ECall g as) = ECall g (List.map (\a -> r.go a) as)
satGo r ar e = e

satOf : M.Map String Int -> SK
satOf ar = { go = \e -> satGo (satOf ar) ar e }

-- | >>> (saturate (arities [{ key = "f", name = "f", body = ELam ["x", "y"] (EVar "x") }]) { key = "g", name = "g", body = EApp (EGlobal "f") [EInt 1, EInt 2] }).body
-- | ECall "f" [EInt 1, EInt 2]
saturate : M.Map String Int -> I.Def -> I.Def
saturate ar d = { key = d.key, name = d.name, body = (satOf ar).go d.body }
