-- Calls with all their arguments at once.
-- A definition that is a function of `n` parameters is called directly
-- (`ECall`) wherever it is given `n` arguments or more; the same for
-- primitives.

module heff.compile.arity

import heff.compile.ir as IR
import heff.compile.prims as Prims
import std.ordmap as OrdMap

arityOne : OrdMap.OrdMap String Int -> IR.Def -> OrdMap.OrdMap String Int
arityOne m d@{ body = ELam xs _ } = OrdMap.insert m d.key (List.length xs)
arityOne m d = m

-- | the definitions that are functions, and of how many parameters
arities : List IR.Def -> OrdMap.OrdMap String Int
arities defs = List.foldl arityOne OrdMap.empty defs

restOf : IR.Expr -> List IR.Expr -> IR.Expr
restOf f args = if List.length args == 0 then f else EApp f args

callOf : (IR.Expr -> IR.Expr)
       -> OrdMap.OrdMap String Int
       -> IR.Expr
       -> List IR.Expr
       -> IR.Expr
callOf go ar h@(EGlobal g) args = case OrdMap.lookup ar g of
  Just n ->
    if List.length args >= n
    then restOf (ECall g (List.take n args)) (List.drop n args)
    else EApp (go h) args
  Nothing -> EApp (go h) args
callOf go ar h@(EPrim p) args = case Prims.primArity p of
  Just n ->
    if List.length args >= n
    then restOf (EPrimCall p (List.take n args)) (List.drop n args)
    else EApp (go h) args
  Nothing -> EApp (go h) args
callOf go ar h args = EApp (go h) args

-- (an application taken apart: its head, its arguments gone through)
spineOf : (IR.Expr -> IR.Expr)
        -> OrdMap.OrdMap String Int
        -> Pair IR.Expr (List IR.Expr)
        -> IR.Expr
spineOf go ar (MkPair h args) = callOf go ar h (List.map go args)

satGo : OrdMap.OrdMap String Int -> IR.Expr -> IR.Expr
satGo ar (EApp f args) = spineOf (satGo ar) ar (IR.spine (EApp f args))
satGo ar e = IR.mapParts (\_ p -> satGo ar p) e

-- | >>> (saturate (arities [{ key = "f", name = "f", body = ELam ["x", "y"] (EVar "x") }]) { key = "g", name = "g", body = EApp (EGlobal "f") [EInt 1, EInt 2] }).body
-- | ECall "f" [EInt 1, EInt 2]
saturate : OrdMap.OrdMap String Int -> IR.Def -> IR.Def
saturate ar d = { key = d.key, name = d.name, body = satGo ar d.body }
