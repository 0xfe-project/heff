-- Borrowing, for the C backend: which of each function's parameters
-- are lent to it, not given (heff.compile.facts's `lent`), worked out
-- over the program in monadic form (heff.compile.lower).

module heff.compile.borrow

import heff.compile.ir as IR
import std.ordmap as OrdMap

borOf : OrdMap.OrdMap String (List Int) -> String -> List Int
borOf bor g = fromMaybe Nil (OrdMap.lookup bor g)

paramsAt : Bool -> List Int -> List String -> List String
paramsAt want bi xs =
  List.map
    fst
    (List.keepIf
       (\p ->
          if want then List.elemBy (\i j -> i == j) (snd p) bi
          else not (List.elemBy (\i j -> i == j) (snd p) bi))
       (List.zipWith
          (\x i -> MkPair x i)
          xs
          (List.range 0 (List.length xs - 1))))

-- | the primitives that only read the strings or arrays they are given,
-- | each with a form in the runtime that is lent them (`_lent`, given a
-- | mask of the operands given it)
lendingPrims : List String
lendingPrims =
  [ "strLength"
  , "strSlice"
  , "strEq"
  , "strLt"
  , "strCompare"
  , "strFind"
  , "strByteAt"
  , "strRuneAt"
  , "strRuneWidth"
  , "strHash"
  , "strHashRange"
  , "strEqRange"
  , "arrayLength"
  , "arrayIndex"
  ]

-- A function's parameter is lent, not given (borrowed), where the
-- function only looks at it: matches on it, lends it on to a call's
-- borrowed parameter, or to one of `lendingPrims` -- the fields a match
-- on it binds are then lent too.  The caller keeps its reference; the callee counts none.  A
-- parameter one of whose matches builds a tag of the matched one's size
-- stays given (its cell is reused there), and so does one a loop (a call
-- of itself) would be given a value held.  Every parameter is lent at
-- first; what is not is taken away until nothing changes.

isVar : String -> IR.Expr -> Bool
isVar p (EVar x) = strEq p x
isVar p _ = False

indexedE : List IR.Expr -> List (Pair IR.Expr Int)
indexedE es =
  List.zipWith (\e i -> MkPair e i) es (List.range 0 (List.length es - 1))

-- (... of a condition: a comparison's operands as a primitive's, a
-- `Bool` looked at as a match's)
onlyLentCond : (IR.Expr -> Bool) -> String -> IR.Cond -> Bool
onlyLentCond go p (CRel q a b) =
  List.all
    (\x -> (isVar p x && List.elemBy strEq q lendingPrims) || go x)
    [a, b]
onlyLentCond go p (CTest e) = isVar p e || go e
onlyLentCond go p (CNot c) = onlyLentCond go p c
onlyLentCond go p (CIf a b c) =
  onlyLentCond go p a && onlyLentCond go p b && onlyLentCond go p c
onlyLentCond go p c = True

-- (each use of `p` in it only looked at or lent: written out, as
-- `loopLent` is, not by `IR.partsOnto` -- each is asked of each
-- parameter of each function, round after round, and so the compiler
-- compiling itself took a few in a thousand more instructions)
onlyLent : OrdMap.OrdMap String (List Int) -> String -> IR.Expr -> Bool
onlyLent bor p (EVar x) = not (strEq p x)
onlyLent bor p (EMatch s arms) =
  (isVar p s || onlyLent bor p s)
  && List.all (\a -> onlyLent bor p (IR.armBody a)) arms
onlyLent bor p (ECall g args) =
  List.all
    (\pr ->
       (isVar p (fst pr) && List.elemBy (\i j -> i == j) (snd pr) (borOf bor g))
       || onlyLent bor p (fst pr))
    (indexedE args)
onlyLent bor p (ELam _ b) = onlyLent bor p b
onlyLent bor p (EApp f args) = List.all (onlyLent bor p) (Cons f args)
onlyLent bor p (ELet _ a b) = onlyLent bor p a && onlyLent bor p b
onlyLent bor p (ERecord fs _) = List.all (\f -> onlyLent bor p (snd f)) fs
onlyLent bor p (EProj e _ _ _) = onlyLent bor p e
onlyLent bor p (ETag _ args _) = List.all (onlyLent bor p) args
onlyLent bor p (EPrimCall q args) =
  List.all
    (\a -> (isVar p a && List.elemBy strEq q lendingPrims) || onlyLent bor p a)
    args
onlyLent bor p (EBool c) = onlyLentCond (onlyLent bor p) p c
onlyLent bor p (ESet _ a b) = onlyLent bor p a && onlyLent bor p b
onlyLent bor p (EValues es) = List.all (onlyLent bor p) es
onlyLent bor p _ = True

-- (whether some node of the worklist is one `f` holds of)
anyW : (IR.Expr -> Bool) -> List IR.Expr -> Bool
anyW f Nil = False
anyW f (Cons e rest) = f e || anyW f (IR.partsOnto e rest)

-- (a tag of `n` fields -- not a tuple, which is no cell,
-- heff.compile.cpr)
buildsHere : Int -> IR.Expr -> Bool
buildsHere n (ETag t args _) = List.length args == n && not (IR.isTupleTag t)
buildsHere n _ = False

-- (whether it builds one)
buildsSize : Int -> IR.Expr -> Bool
buildsSize n e = anyW (buildsHere n) (Cons e Nil)

armReuses : IR.Arm -> Bool
armReuses (MkArm _ vs b) = not (List.null vs) && buildsSize (List.length vs) b

-- (a match on `p` that may reuse its cell)
reusesHere : String -> IR.Expr -> Bool
reusesHere p (EMatch s arms) = isVar p s && List.any armReuses arms
reusesHere p _ = False

-- (whether a match in it may reuse the cell of `p`)
reuses : String -> IR.Expr -> Bool
reuses p e = anyW (reusesHere p) (Cons e Nil)

scrutLent : List String -> IR.Expr -> Bool
scrutLent ds (EVar x) = List.elemBy strEq x ds
scrutLent ds _ = False

-- Elements lent: `let x = arrayIndex a i`, `a` lent, is lent too -- the
-- array holds it while it is lent -- where `x` is known to be no number
-- an array may keep flat (heff.compile.refcount's "Elements lent", which
-- reads it so): a match (not an `if`) looks at it, or the function is
-- given it, calling itself, at a parameter a match looks at.  So a walk
-- down nested arrays, a trie's lookup, lends each level on to the next.

-- | a function, as it calls itself: its key, its parameters, its body
type Loop = { key : String, params : List String, body : IR.Expr }

-- (whether a match's arms, as `IR.boolArms` has them, are no `if`'s)
notIf : Maybe (Pair IR.Expr IR.Expr) -> Bool
notIf Nothing = True
notIf (Just _) = False

-- (a match, not an `if`, looking at `x`)
matchOn : String -> IR.Expr -> Bool
matchOn x (EMatch s arms) = isVar x s && notIf (IR.boolArms arms)
matchOn x _ = False

-- (whether `x` is given at one of the parameters a match in `b` looks at)
taggedArg : IR.Expr -> String -> List String -> List IR.Expr -> Bool
taggedArg b x (Cons p ps) (Cons a rest) =
  (isVar x a && anyW (matchOn p) (Cons b Nil)) || taggedArg b x ps rest
taggedArg b x _ _ = False

-- (a call of the function itself giving `x` where a match looks at it)
loopOn : Loop -> String -> IR.Expr -> Bool
loopOn lp x (ECall g args) =
  strEq g lp.key && taggedArg lp.body x lp.params args
loopOn lp x _ = False

-- (`let x = a`, an element of an array lent with `ds`, lent too)
peeks : Loop -> List String -> String -> IR.Expr -> IR.Expr -> Bool
peeks lp ds x (EPrimCall q (Cons a _)) b =
  strEq q "arrayIndex"
  && scrutLent ds a
  && anyW (\e -> matchOn x e || loopOn lp x e) (Cons b Nil)
peeks lp ds x _ b = False

-- (the variables lent with `ds`: the fields of matches on them, and
-- their elements (above))
lentVars : Loop -> List String -> IR.Expr -> List String
lentVars lp ds (EMatch s arms) =
  List.concatMap
    (\a ->
       if scrutLent ds s
       then List.append
           (IR.armVars a)
           (lentVars lp (List.append (IR.armVars a) ds) (IR.armBody a))
       else lentVars lp ds (IR.armBody a))
    arms
lentVars lp ds (ELet x a b) =
  List.append
    (lentVars lp ds a)
    (if peeks lp ds x a b then Cons x (lentVars lp (Cons x ds) b)
     else lentVars lp ds b)
lentVars lp ds (ESet _ a b) = List.append (lentVars lp ds a) (lentVars lp ds b)
lentVars lp ds _ = Nil

-- (each call of `key` given at `i` one of `ds`)
loopLent : String -> Int -> List String -> IR.Expr -> Bool
loopLent key i ds (ECall g args) =
  (not (strEq g key)
   || List.all
     (\pr -> not (snd pr == i) || List.any (\d -> isVar d (fst pr)) ds)
     (indexedE args))
  && List.all (loopLent key i ds) args
loopLent key i ds (EMatch s arms) =
  loopLent key i ds s && List.all (\a -> loopLent key i ds (IR.armBody a)) arms
loopLent key i ds (ELet _ a b) = loopLent key i ds a && loopLent key i ds b
loopLent key i ds (ETag _ args _) = List.all (loopLent key i ds) args
loopLent key i ds (EApp f args) = List.all (loopLent key i ds) (Cons f args)
loopLent key i ds (EBool c) = List.all (loopLent key i ds) (IR.condParts c)
loopLent key i ds (ESet _ a b) = loopLent key i ds a && loopLent key i ds b
loopLent key i ds (EValues es) = List.all (loopLent key i ds) es
loopLent key i ds _ = True

lentAt : OrdMap.OrdMap String (List Int)
       -> String
       -> List String
       -> IR.Expr
       -> List String
       -> Int
       -> Bool
lentAt bor key xs b ds i = case List.drop i xs of
  Cons p _ -> onlyLent bor p b && not (reuses p b) && loopLent key i ds b
  Nil -> False

borDef : OrdMap.OrdMap String (List Int)
       -> IR.Def
       -> OrdMap.OrdMap String (List Int)
borDef bor d@{ body = ELam xs b } =
  OrdMap.insert
    bor
    d.key
    (List.keepIf
       (lentAt
          bor
          d.key
          xs
          b
          (List.append
             (paramsAt True (borOf bor d.key) xs)
             (lentVars
                { key = d.key, params = xs, body = b }
                (paramsAt True (borOf bor d.key) xs)
                b)))
       (borOf bor d.key))
borDef bor d = bor

borSize : OrdMap.OrdMap String (List Int) -> Int
borSize bor =
  List.sum (List.map (\p -> List.length (snd p)) (OrdMap.toList bor))

-- (again until no parameter is taken away: `size` how many were lent)
borFix : List IR.Def
       -> Int
       -> OrdMap.OrdMap String (List Int)
       -> OrdMap.OrdMap String (List Int)
borFix defs size bor =
  if borSize bor == size then bor
  else borFix defs (borSize bor) (List.foldl borDef bor defs)

borAll : OrdMap.OrdMap String (List Int)
       -> IR.Def
       -> OrdMap.OrdMap String (List Int)
borAll m d@{ body = ELam xs _ } =
  OrdMap.insert m d.key (List.range 0 (List.length xs - 1))
borAll m d = m

-- | each function's borrowed parameters, by index
borrowing : List IR.Def -> OrdMap.OrdMap String (List Int)
borrowing defs = borFix defs (0 - 1) (List.foldl borAll OrdMap.empty defs)
