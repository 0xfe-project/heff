-- A program's definitions, their references counted (heff.compile.rc,
-- through heff.compile.lower's `cDef`), as C, for lib/c/runtime.c,
-- compiled by `zig cc` (#20).  What is decided is decided there; here it
-- is only printed.
--
--   a definition of n parameters  ~>  a C function of n parameters
--            (`g_K`), and a closure of it (`g_K_clo`) where it is a value;
--            a call of itself last, a loop (`goto top`); of another
--            of n parameters, a jump (`HEFF_LAST`: clang's `musttail`)
--   a definition that is not a function  ~>  computed when first used
--            (`g_K_get`)
--   a lambda  ~>  a C function of its own (`lam_N`), what it mentions
--            and does not bind kept in its closure
--   a tag, a record  ~>  `heff_tag_n`, `heff_rec_n`, built at the size
--            the emitter knows: tags and labels numbered (`TAG_x`,
--            `LBL_x`), a record's fields in the order it is written in
--   a string  ~>  a static object, its bytes (`HEFF_LIT`, a C string
--            literal of them)
--   a call last of an unknown function  ~>  `heff_tail` (counted, a
--            bounce every so often); a call not last, its value through
--            `heff_tr` -- as src/heff/compile/emit.hf does (`Em.bouncing`),
--            a closure taking the arguments given called where it is
--            (`heff_call`).  From a lambda, a jump where the function is
--            a closure taking the arguments given: put where the
--            lambda's were, if it took as many (`inPlace`), else in
--            `heff_room` (`roomed`)
--
-- A program is one file: the runtime, the providers of its worlds
-- (`M.provider.c`), and its code; its entry is heff.compile.lower's `entryKey`,
-- its algebra (`perform`) handing each operation to its world's
-- provider by the sum the effect is.

import heff.elab.effect as Ef
import heff.compile.borrow as Bo
import heff.compile.emit as Em
import heff.compile.facts as F
import heff.elab.fixed as Fx
import heff.elab.globals as G
import heff.compile.ir as I
import heff.compile.irtext as Ir
import heff.compile.lower as L
import heff.compile.prims as Pr
import heff.compile.rc as Rc
import heff.compile.simplify as Si
import map as M
import uint8 as U8

-- Names
--------------------------------------------------------------------------------

hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

isAlnum : Int -> Bool
isAlnum c =
  (97 <= c && c <= 122) || (65 <= c && c <= 90) || (48 <= c && c <= 57)

mangleChar : Int -> String
mangleChar c =
  if isAlnum c then strFromByte (U8.fromInt c)
  else "_" ^ hexDigit (intDiv (intMod c 256) 16) ^ hexDigit (intMod c 16)

-- (from `i`, a run of letters and digits scanned to `j`: each run taken
-- whole, not a letter at a time)
mangleW : String -> Int -> Int -> String -> String
mangleW s i j acc =
  if j < strLength s && isAlnum (byteAt s j) then mangleW s i (j + 1) acc
  else if j >= strLength s then acc ^ strSlice s i j
  else mangleW
      s
      (j + 1)
      (j + 1)
      (acc ^ strSlice s i j ^ mangleChar (byteAt s j))

-- | a name as C spells it: letters and digits kept, the rest `_xx`
-- | >>> mangle "co.<+>"
-- | "co_2e_3c_2b_3e"
mangle : String -> String
mangle s = mangleW s 0 0 ""

cGlobal : String -> String
cGlobal k = "g_" ^ mangle k

cLocal : String -> String
cLocal x = "v_" ^ mangle x

tagName : String -> String
tagName t = "TAG_" ^ mangle t

lblName : String -> String
lblName l = "LBL_" ^ mangle l

-- Tags and labels
--------------------------------------------------------------------------------

-- | the tags lib/c/runtime.c knows, numbered as it numbers them
knownTags : List String
knownTags =
  [ "True"
  , "False"
  , "Nil"
  , "Cons"
  , "MkUnit"
  , "Just"
  , "Nothing"
  , "MkPair"
  , "InL"
  , "InR"
  ]

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

-- (the variable an expression is, if it is one; the definition: so that
-- an equation looking for one does not copy its fallback into an arm for
-- each other kind of expression)
varOf : I.Expr -> Maybe String
varOf (EVar x) = Just x
varOf _ = Nothing

globalOf : I.Expr -> Maybe String
globalOf (EGlobal g) = Just g
globalOf _ = Nothing

nubS : List String -> List String -> List String
nubS acc Nil = List.reverse acc
nubS acc (Cons x xs) = if elemS x acc then nubS acc xs else nubS (Cons x acc) xs

armTags : List I.Arm -> List String
armTags arms = List.map I.armTag arms

-- (each the one's before the other's: only the first copied)
pairCat : Pair (List String) (List String)
        -> Pair (List String) (List String)
        -> Pair (List String) (List String)
pairCat (MkPair ts ls) (MkPair ts2 ls2) =
  MkPair (List.append ts ts2) (List.append ls ls2)

-- (the tags and labels an expression mentions)
namesIn : (I.Expr -> Pair (List String) (List String))
        -> List I.Expr
        -> Pair (List String) (List String)
namesIn go es = List.foldr (\e acc -> pairCat (go e) acc) (MkPair Nil Nil) es

withLbls : List String
         -> Pair (List String) (List String)
         -> Pair (List String) (List String)
withLbls ls (MkPair ts ls2) = MkPair ts (List.append ls ls2)

withTags : List String
         -> Pair (List String) (List String)
         -> Pair (List String) (List String)
withTags ts (MkPair ts2 ls) = MkPair (List.append ts ts2) ls

tagsLbls : I.Expr -> Pair (List String) (List String)
tagsLbls (ELam _ b) = tagsLbls b
tagsLbls (EApp f as) = namesIn tagsLbls (Cons f as)
tagsLbls (ELet _ a b) = namesIn tagsLbls [a, b]
tagsLbls (ERecord fs) =
  withLbls (List.map fst fs) (namesIn tagsLbls (List.map snd fs))
tagsLbls (EProj e l _) = withLbls (Cons l Nil) (tagsLbls e)
tagsLbls (ETag t as) = withTags (Cons t Nil) (namesIn tagsLbls as)
tagsLbls (EMatch s arms) =
  withTags (armTags arms) (namesIn tagsLbls (Cons s (List.map I.armBody arms)))
tagsLbls (EPrimCall _ as) = namesIn tagsLbls as
tagsLbls (ECall _ as) = namesIn tagsLbls as
tagsLbls _ = MkPair Nil Nil

identAt : String -> Int -> Int -> String
identAt text start i =
  if i < strLength text && (isAlnum (byteAt text i) || byteAt text i == 95)
    then identAt text start (i + 1)
  else strSlice text start i

-- (`TAG_x` or `LBL_x` in a provider's text: the tags or labels it makes
-- or reads)
namesInGo : String -> String -> Int -> List String -> List String
namesInGo pre text i acc = case indexOf
    pre
    (strSlice text i (strLength text)) of
  Nothing -> acc
  Just j ->
    namesInGo
      pre
      text
      (i + j + strLength pre)
      (Cons (identAt text (i + j + strLength pre) (i + j + strLength pre)) acc)

numbered : Int -> List String -> M.Map String Int -> M.Map String Int
numbered n Nil m = m
numbered n (Cons x xs) m =
  if M.member compareString x m then numbered n xs m
  else numbered (n + 1) xs (M.insert compareString x n m)

-- A tag's number, and a label's, is by its name, not by what other
-- tags and labels the program has: a hash of the name (the next number
-- free, if another took it), so that a tag added does not number the
-- others again.  Tags are numbered past those the runtime knows, below
-- 2^16 (an object keeps its tag in 16 bits); labels below 2^31.

-- (a text's hash, below `m`)
hashBelow : String -> Int -> Int -> Int -> Int
hashBelow t m i a =
  if i >= strLength t then a
  else hashBelow t m (i + 1) ((a * 31 + byteAt t i + 1) % m)

-- (the number `h` or, if taken, the next free after it)
slotFrom : Int -> Int -> Int -> M.Map Int Unit -> Int
slotFrom base m h taken =
  if M.member compareInt (base + h) taken
    then slotFrom base m ((h + 1) % m) taken
  else base + h

-- (each name, in order, numbered at its hash past `base`, below `base + m`)
hashedGo : Int
         -> Int
         -> List String
         -> M.Map String Int
         -> M.Map Int Unit
         -> M.Map String Int
hashedGo base m Nil names taken = names
hashedGo base m (Cons x xs) names taken =
  if M.member compareString x names then hashedGo base m xs names taken
  else hashedGo
      base
      m
      xs
      (M.insert
         compareString
         x
         (slotFrom base m (hashBelow x m 0 7) taken)
         names)
      (M.insert
         compareInt
         (slotFrom base m (hashBelow x m 0 7) taken)
         MkUnit
         taken)

-- What emitting reads: the numbers of tags and labels, and what is known
-- of the program (heff.compile.facts)
--------------------------------------------------------------------------------

type CE = { tags : M.Map String Int, lbls : M.Map String Int, facts : F.Facts }

-- What emitting makes on the way: the lambdas, the strings and the
-- labels of records, each a C definition of its own
--------------------------------------------------------------------------------

-- (`owner`: the C name of the definition being emitted, which names its
-- lambdas and strings; `nlam`, `nstr` count them within it -- so that a
-- definition's C is the same whatever is emitted before it.  What each
-- makes, and the shapes and primitives each uses, by its owner)
type CS =
  { owner : String
  , nlam : Int
  , lams : List (Pair String String)
  , protos : List (Pair String String)
  , nstr : Int
  , strs : List (Pair String String)
  , shapes : List (Pair String String)
  , prims : List (Pair String String)
  }

type C a = CS -> Pair a CS

bindTake : {a b : Type} -> (a -> C b) -> Pair a CS -> Pair b CS
bindTake f (MkPair x s) = f x s

bind : {a b : Type} -> C a -> (a -> C b) -> C b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> C a
pure x = \s -> MkPair x s

traverseC : {a b : Type} -> (a -> C b) -> List a -> C (List b)
traverseC f Nil = pure Nil
traverseC f (Cons x xs) = do
  y <- f x
  ys <- traverseC f xs
  pure (Cons y ys)

-- (a byte in octal, as a C string's escape has it: three digits, so that
-- no digit after it is read as its)
octal : Int -> String
octal b = showInt (b / 64) ^ showInt (b / 8 % 8) ^ showInt (b % 8)

-- (the byte `b`, at `i`, as a C string literal has it: printable ASCII as
-- it is but `"`, `\` and `?` (which a trigraph starts with), escaped;
-- another in octal)
cByte : String -> Int -> Int -> String
cByte s i 34 = "\\\""
cByte s i 92 = "\\\\"
cByte s i 63 = "\\?"
cByte s i b =
  if 32 <= b && b < 127 then strSlice s i (i + 1) else "\\" ^ octal b

-- (from `i`, between the quotes, into `acc`)
cBytesGo : String -> Int -> String -> String
cBytesGo s i acc =
  if i >= strLength s then acc
  else cBytesGo s (i + 1) (acc ^ cByte s i (byteAt s i))

-- | a static string, by lib/c/runtime.c's `HEFF_LIT`: its bytes, as a C
-- | string literal writes them
-- | >>> strDef "s" "ab"
-- | "HEFF_LIT(s, 2, \"ab\");"
-- | >>> strDef "s" ""
-- | "HEFF_LIT(s, 0, \"\");"
-- | >>> strDef "s" "a\"\\??=\n\u{e9}"
-- | "HEFF_LIT(s, 9, \"a\\\"\\\\\\?\\?=\\012\\303\\251\");"
-- | >>> strDef "s" "1\xff2"
-- | "HEFF_LIT(s, 3, \"1\\3772\");"
strDef : String -> String -> String
strDef name str =
  "HEFF_LIT("
  ^ name
  ^ ", "
  ^ showInt (strLength str)
  ^ ", \""
  ^ cBytesGo str 0 ""
  ^ "\");"

-- | a static string
strLit : String -> C String
strLit str = \s ->
    MkPair
      ("((V)&" ^ s.owner ^ "_str" ^ showInt s.nstr ^ ")")
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr + 1
      , strs =
          Cons
            (MkPair s.owner (strDef (s.owner ^ "_str" ^ showInt s.nstr) str))
            s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

-- (a shape's name: its labels, mangled, by `__` -- which no mangled
-- name has in it -- so that it is named alike in every program, not by
-- the numbers its labels have in this one)
shapeKey : List String -> String
shapeKey ls = joinWith "__" (List.map mangle ls)

-- (whether the owner `o` has `k` among its: theirs are those first, the
-- definition being emitted's)
ownHas : String -> String -> List (Pair String String) -> Bool
ownHas o k (Cons (MkPair o2 k2) rest) =
  strEq o o2 && (strEq k k2 || ownHas o k rest)
ownHas o k Nil = False

-- (`k`, the owner's, once)
ownAdd : String
       -> String
       -> List (Pair String String)
       -> List (Pair String String)
ownAdd o k ps = if ownHas o k ps then ps else Cons (MkPair o k) ps

-- | a record's labels, in the order it is written in, as a static array
shapeLit : List String -> C String
shapeLit ls = \s ->
    MkPair
      ("shape_" ^ shapeKey ls)
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = ownAdd s.owner (shapeKey ls) s.shapes
      , prims = s.prims
      }

-- | a primitive, as a value: a closure of it
primLit : String -> C String
primLit p = \s ->
    MkPair
      ("((V)&prim_" ^ p ^ "_clo)")
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = ownAdd s.owner p s.prims
      }

newLam : C String
newLam = \s ->
    MkPair
      (s.owner ^ "_lam" ^ showInt s.nlam)
      { owner = s.owner
      , nlam = s.nlam + 1
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

addLam : String -> String -> C Unit
addLam proto def = \s ->
    MkPair
      MkUnit
      { owner = s.owner
      , nlam = s.nlam
      , lams = Cons (MkPair s.owner def) s.lams
      , protos = Cons (MkPair s.owner proto) s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

-- Expressions
--------------------------------------------------------------------------------

-- | the printer's judgments, knotted: an expression, statements
type CK =
  { exp : Rc.Value -> C String, stmts : List Rc.Statement -> C (List String) }

argsArr : List String -> String
argsArr vs = if List.null vs then "NULL" else "(V[]){" ^ joinWith ", " vs ^ "}"

-- (an integer the runtime keeps in a word, from -2^62 up to 2^62, or one
-- it cannot)
intLit : Int -> String
intLit n =
  if n < 4611686018427387904 && n >= (0 - 4611686018427387904)
    then "MK_INT(" ^ showInt n ^ "LL)"
  else "HEFF_BIG(\"" ^ showInt n ^ "\")"

floatLit : Float64 -> String
floatLit x =
  if strEq (showFloat x) "NaN" then "heff_flt(NAN)"
  else if strEq (showFloat x) "Infinity" then "heff_flt(INFINITY)"
  else if strEq (showFloat x) "-Infinity" then "heff_flt(-INFINITY)"
  else "heff_flt(" ^ showFloat x ^ ")"

-- (a fixed-width integer: of 64 bits, kept as an `Int` is; of fewer, in a
-- word)
fixedLit : Fx.Fixed -> Int -> String
fixedLit w n =
  if Fx.fixedBits w == 64 then intLit n else "MK_INT(" ^ showInt n ^ "LL)"

primName : String -> String
primName p = "heff_" ^ p

-- (a drop, as what is dropped is known to be: a tag given back as one
-- (`heff_drop_tag`), not looked at by `heff_drop`; a cell kept and not
-- built in, freed (`heff_drop_cell`); so are a record (`heff_drop_rec`)
-- and a closure (`heff_drop_clo`) of known size)
dropAs : String -> Rc.Known -> String
dropAs x (KnownTag n) = "heff_drop_tag(" ^ cLocal x ^ ", " ^ showInt n ^ ");"
dropAs x (KnownCell n) = "heff_drop_cell(" ^ cLocal x ^ ", " ^ showInt n ^ ");"
dropAs x (KnownRec n) = "heff_drop_rec(" ^ cLocal x ^ ", " ^ showInt n ^ ");"
dropAs x (KnownClo n) = "heff_drop_clo(" ^ cLocal x ^ ", " ^ showInt n ^ ");"

dropLine : Rc.Drop -> String
dropLine (MkDrop x Nothing) = "heff_drop(" ^ cLocal x ^ ");"
dropLine (MkDrop x (Just k)) = dropAs x k

-- (a call's operand, bound before the call where it is not plain: `a_i`;
-- a value lent, `b_i`, dropped after it)
type Bound = { arg : String, pre : List String, post : List String }

boundAs : Int -> String -> List String -> Bound
boundAs i v post =
  { arg = "a_" ^ showInt i
  , pre = Cons ("V a_" ^ showInt i ^ " = " ^ v ^ ";") Nil
  , post = post
  }

argC : CK -> Int -> Rc.Operand -> C Bound
argC k i (Given e) = do
  v <- k.exp e
  pure (boundAs i v Nil)
argC k i (LentVar x drops) =
  pure (boundAs i (cLocal x) (List.map dropLine drops))
argC k i (LentValue e) = do
  v <- k.exp e
  pure
      { arg = "b_" ^ showInt i
      , pre = Cons ("V b_" ^ showInt i ^ " = " ^ v ^ ";") Nil
      , post = Cons ("heff_drop(b_" ^ showInt i ^ ");") Nil
      }

callHead : String -> Bool -> String
callHead g tr = (if tr then "heff_tr(" else "(") ^ cGlobal g ^ "("

-- (a call with any lent: every operand computed before the call in its
-- order, since a lent one computed first would run before the operands
-- left of it, which may still want what it consumes; the lent dropped
-- after)
callBound : String -> Bool -> List Bound -> String
callBound g tr bs =
  "({ "
  ^ joinWith " " (List.concatMap (\(b : Bound) -> b.pre) bs)
  ^ " V r_ = "
  ^ callHead g tr
  ^ joinWith ", " (List.map (\(b : Bound) -> b.arg) bs)
  ^ ")); "
  ^ joinWith " " (List.concatMap (\(b : Bound) -> b.post) bs)
  ^ " r_; })"

callLent : CK -> String -> Bool -> List Rc.Operand -> C String
callLent k g tr args = do
  bs <-
    traverseC
      (\p -> argC k (snd p) (fst p))
      (List.zipWith
         (\a i -> MkPair a i)
         args
         (List.range 0 (List.length args - 1)))
  pure (callBound g tr bs)

-- | a call of `g`, through any bounces if `tr`
callC : CK -> String -> Bool -> List Rc.Operand -> C String
callC k g tr args =
  if Rc.lentPlain args
    then bind
        (traverseC k.exp (List.map Rc.argExp args))
        (\vs -> pure (callHead g tr ^ joinWith ", " vs ^ "))"))
  else callLent k g tr args

-- (the closure given up where the body starts, what it holds taken: a
-- closure holding nothing is static, nothing to give back)
selfTake : List String -> List String
selfTake fv =
  if List.null fv then Nil
  else Cons ("  heff_clo_take(self, " ^ showInt (List.length fv) ^ ");") Nil

lamLines : String -> List String -> List String -> List String -> List String
lamLines k xs fv body =
  List.append
    (Cons ("static V " ^ k ^ "(V self, V *args) {") Nil)
    (List.append
       (List.zipWith
          (\x i -> "  V " ^ cLocal x ^ " = args[" ^ showInt i ^ "];")
          xs
          (List.range 0 (List.length xs - 1)))
       (List.append
          (List.zipWith
             (\x i ->
                "  V " ^ cLocal x ^ " = heff_env(self)[" ^ showInt i ^ "];")
             fv
             (List.range 0 (List.length fv - 1)))
          (List.append
             (selfTake fv)
             (List.append (List.map (\l -> "  " ^ l) body) (Cons "}" Nil)))))

-- (a lambda's closure: made with what it holds, or, holding nothing, one
-- of its own, static and immortal -- made once, not at each use)
lamProto : String -> Int -> List String -> String
lamProto k n fv =
  if List.null fv
    then "static V "
      ^ k
      ^ "(V self, V *args); static Clo "
      ^ k
      ^ "_clo = {{0x80000000u, K_CLO, 0}, "
      ^ k
      ^ ", "
      ^ showInt n
      ^ ", 0};"
  else "static V " ^ k ^ "(V self, V *args);"

-- | a lambda: a C function of its own (`lam_N`), numbered before the
-- | lambdas in its body
lamC : CK
     -> List String
     -> List String
     -> List Rc.Value
     -> List Rc.Statement
     -> C String
lamC k xs fv held body = do
  name <- newLam
  ls <- k.stmts body
  u <-
    addLam
      (lamProto name (List.length xs) fv)
      (joinWith "\n" (lamLines name xs fv ls))
  vs <- traverseC k.exp held
  pure
      (if List.null fv then "((V)&" ^ name ^ "_clo)"
       else "heff_clo_n("
         ^ name
         ^ ", "
         ^ showInt (List.length xs)
         ^ ", "
         ^ showInt (List.length fv)
         ^ ", "
         ^ argsArr vs
         ^ ")")

-- (a record built in `x`'s cell (`heff_rec_reuse_n`, lib/c/runtime.c):
-- the fields not kept computed first, `vs` at their places `changed`,
-- then stored in it)
updateText : String -> String -> Int -> Int -> List String -> List Int -> String
updateText x shape keep n vs changed =
  "({ "
  ^ joinWith
    ""
    (List.zipWith (\v i -> "V rv_" ^ showInt i ^ " = " ^ v ^ "; ") vs changed)
  ^ "V rr_ = heff_rec_reuse_n("
  ^ cLocal x
  ^ ", "
  ^ showInt keep
  ^ "ULL, "
  ^ showInt n
  ^ ", "
  ^ shape
  ^ "); "
  ^ joinWith
    ""
    (List.map
       (\i -> "heff_rfield(rr_, " ^ showInt i ^ ") = rv_" ^ showInt i ^ "; ")
       changed)
  ^ "rr_; })"

-- | a condition, as C's (an `int`): a comparison, the runtime's of it
-- | (`heff_intLt_c`); a test of tests, `&&`, `||` or `?:`; a name bound
-- | in it, dropped once it is decided
testC : CK -> Rc.Test -> C String
testC k CondTrue = pure "1"
testC k CondFalse = pure "0"
testC k (CondRel p es) =
  bind
    (traverseC k.exp es)
    (\vs -> pure (primName p ^ "_c(" ^ joinWith ", " vs ^ ")"))
testC k (CondBool e) =
  bind (k.exp e) (\v -> pure ("(" ^ v ^ " == NTAG(TAG_True))"))
testC k (CondNot c) = bind (testC k c) (\v -> pure ("!" ^ v))
testC k (CondIf a b CondFalse) = do
  va <- testC k a
  vb <- testC k b
  pure ("(" ^ va ^ " && " ^ vb ^ ")")
testC k (CondIf a CondTrue c) = do
  va <- testC k a
  vc <- testC k c
  pure ("(" ^ va ^ " || " ^ vc ^ ")")
testC k (CondIf a b c) = do
  va <- testC k a
  vb <- testC k b
  vc <- testC k c
  pure ("(" ^ va ^ " ? " ^ vb ^ " : " ^ vc ^ ")")
testC k (CondLet x e c) = do
  v <- k.exp e
  vc <- testC k c
  pure
      ("({ V "
       ^ cLocal x
       ^ " = "
       ^ v
       ^ "; int c_ = "
       ^ vc
       ^ "; heff_drop("
       ^ cLocal x
       ^ "); c_; })")

-- (an operator of one operand: its name, then the operand's, closed)
wrapC : CK -> String -> String -> Rc.Value -> C String
wrapC k pre post e = bind (k.exp e) (\v -> pure (pre ^ v ^ post))

expF : CK -> Rc.Value -> C String
expF k (RLocal x) = pure (cLocal x)
expF k (RDup x) = pure ("heff_dup(" ^ cLocal x ^ ")")
expF k (RClo g) = pure ("((V)&" ^ cGlobal g ^ "_clo)")
expF k (RGet g) = pure ("heff_dup(" ^ cGlobal g ^ "_get())")
expF k (RGetRaw g) = pure (cGlobal g ^ "_get()")
expF k (RInt n) = pure (intLit n)
expF k (RFloat x) = pure (floatLit x)
expF k (RStr s) = strLit s
expF k (RFixed w n) = pure (fixedLit w n)
expF k (RF32 x) = pure ("heff_f32((float)" ^ showFloat x ^ ")")
expF k (RNTag t) = pure ("NTAG(" ^ tagName t ^ ")")
expF k (RTag t es) = do
  vs <- traverseC k.exp es
  pure
      ("heff_tag_n("
       ^ tagName t
       ^ ", "
       ^ showInt (List.length es)
       ^ ", "
       ^ argsArr vs
       ^ ")")
expF k (RTagIn ru t es) = do
  vs <- traverseC k.exp (Cons ru es)
  pure
      ("heff_tag_at_n("
       ^ fromMaybe "0" (List.head vs)
       ^ ", "
       ^ tagName t
       ^ ", "
       ^ showInt (List.length es)
       ^ ", "
       ^ argsArr (List.drop 1 vs)
       ^ ")")
expF k (RRec ls es) = do
  vs <- traverseC k.exp es
  shape <- shapeLit ls
  pure
      ("heff_rec_n("
       ^ showInt (List.length ls)
       ^ ", "
       ^ shape
       ^ ", "
       ^ argsArr vs
       ^ ")")
expF k (RRecIn x keep n ls changed) = do
  vs <- traverseC k.exp (List.map snd changed)
  shape <- shapeLit ls
  pure (updateText x shape keep n vs (List.map fst changed))
expF k (RField e i) = wrapC k "heff_rfield(" (", " ^ showInt i ^ ")") e
expF k (RDupE e) = wrapC k "heff_dup(" ")" e
expF k (RGetN e i n) =
  wrapC k "heff_get_n(" (", " ^ showInt i ^ ", " ^ showInt n ^ ")") e
expF k (RTakeField x i) =
  pure ("heff_take_field(" ^ cLocal x ^ ", " ^ showInt i ^ ")")
expF k (RGetLabel e l) = wrapC k "heff_get(" (", " ^ lblName l ^ ")") e
expF k (RPrimFn p) = primLit p
expF k (RPrim p es) = do
  vs <- traverseC k.exp es
  pure (primName p ^ "(" ^ joinWith ", " vs ^ ")")
expF k (RLam xs fv held (MkCode body)) = lamC k xs fv held body
expF k (RCall g tr args) = callC k g tr args
expF k (RApply f es) = do
  vs <- traverseC k.exp (Cons f es)
  pure
      ("heff_tr(heff_call("
       ^ fromMaybe "0" (List.head vs)
       ^ ", "
       ^ showInt (List.length es)
       ^ ", "
       ^ argsArr (List.drop 1 vs)
       ^ "))")
expF k (RBool c) = bind (testC k c) (\v -> pure ("heff_bool(" ^ v ^ ")"))
expF k RAbandon = pure "heff_abandon()"

-- Statements
--------------------------------------------------------------------------------

indented : List String -> List String
indented ls = List.map (\l -> "  " ^ l) ls

-- (the loop again: the arguments, then the parameters)
again : List String -> List String -> List String
again ps vs =
  List.append
    (List.zipWith
       (\v i -> "V t_" ^ showInt i ^ " = " ^ v ^ ";")
       vs
       (List.range 0 (List.length vs - 1)))
    (List.append
       (List.zipWith
          (\p i -> cLocal p ^ " = t_" ^ showInt i ^ ";")
          ps
          (List.range 0 (List.length vs - 1)))
       (Cons "goto top;" Nil))

-- (a call last of an unknown function, from a lambda taking at least as
-- many arguments: the function, then its arguments, put where the
-- lambda's were -- read already, and its caller's, neither its own frame
-- nor its closure, which `heff_clo_take` may have freed -- and a
-- closure taking exactly those called by a jump (`heff_exact`,
-- `HEFF_LAST`), its C function's type the lambda's (`Fn`).  Anything
-- else, as any call last of an unknown function: `heff_tail`, counted)
inPlace : List String -> List String
inPlace vs =
  List.append
    (Cons ("V f_ = " ^ fromMaybe "0" (List.head vs) ^ ";") Nil)
    (List.append
       (List.zipWith
          (\v i -> "args[" ^ showInt i ^ "] = " ^ v ^ ";")
          (List.drop 1 vs)
          (List.range 0 (List.length vs - 2)))
       [ "if (heff_exact(f_, "
       ^ showInt (List.length vs - 1)
       ^ ", args)) HEFF_LAST return ((Clo *)f_)->fn(f_, args);"
       , "return heff_tail(f_, " ^ showInt (List.length vs - 1) ^ ", args);"
       ])

-- (a call last of an unknown function, from a lambda taking fewer
-- arguments, of no more than fit in `heff_room`: the arguments put there,
-- and a closure taking exactly those called by a jump, given them there
-- -- they are read at once by what is called, before anything else is,
-- so a call made from there that puts its own there is after they are
-- read.  Anything else, as any call last of an unknown function: given
-- them where the lambda is, by `heff_tail`, counted)
roomed : List String -> List String
roomed vs =
  List.append
    (Cons ("V f_ = " ^ fromMaybe "0" (List.head vs) ^ ";") Nil)
    (List.append
       (List.zipWith
          (\v i -> "heff_room[" ^ showInt i ^ "] = " ^ v ^ ";")
          (List.drop 1 vs)
          (List.range 0 (List.length vs - 2)))
       [ "if (heff_exact(f_, "
       ^ showInt (List.length vs - 1)
       ^ ", heff_room)) HEFF_LAST return ((Clo *)f_)->fn(f_, heff_room);"
       , "return heff_tail(f_, "
       ^ showInt (List.length vs - 1)
       ^ ", (V[]){"
       ^ joinWith
         ", "
         (List.map
            (\i -> "heff_room[" ^ showInt i ^ "]")
            (List.range 0 (List.length vs - 2)))
       ^ "});"
       ])

-- (a field the arm wants: its own reference, or, the scrutinee given
-- up or lent, the scrutinee's, taken over or lent)
fieldLine : String -> Bool -> Pair String Int -> String
fieldLine sv plain (MkPair v i) =
  "  V "
  ^ cLocal v
  ^ " = "
  ^ (if plain then "heff_field(" ^ sv ^ ", " ^ showInt i ^ ")"
     else "heff_dup(heff_field(" ^ sv ^ ", " ^ showInt i ^ "))")
  ^ ";"

-- (the scrutinee given up at once (`heff_take_n`): its shell freed and
-- the fields not wanted dropped; or its cell kept (`heff_take_reuse_n`))
takeLines : String -> Rc.Take -> List String
takeLines sv TakeNone = Nil
takeLines sv (TakeN mask n) =
  Cons
    ("heff_take_n(" ^ sv ^ ", " ^ showInt mask ^ "ULL, " ^ showInt n ^ ");")
    Nil
takeLines sv (TakeKeep ru mask n) =
  Cons
    ("V "
     ^ cLocal ru
     ^ " = heff_take_reuse_n("
     ^ sv
     ^ ", "
     ^ showInt mask
     ^ "ULL, "
     ^ showInt n
     ^ ");")
    Nil

armF : CK -> String -> Rc.CaseArm -> C (List String)
armF k sv (MkCArm t fields plain take body leaves) = do
  ls <- k.stmts body
  pure
      (List.append
         (Cons ("case " ^ tagName t ^ ": {") Nil)
         (List.append
            (List.map (fieldLine sv plain) fields)
            (List.append
               (indented (List.append (takeLines sv take) ls))
               (List.append
                  (if leaves then Cons "  break;" Nil else Nil)
                  (Cons "}" Nil)))))

nomatchLine : Bool -> String -> String
nomatchLine True sv = "default: return heff_nomatch(" ^ sv ^ ");"
nomatchLine False sv = "default: heff_nomatch(" ^ sv ^ ");"

-- (a statement of one line, of an expression)
lineC : CK -> String -> String -> Rc.Value -> C (List String)
lineC k pre post e = bind (k.exp e) (\v -> pure (Cons (pre ^ v ^ post) Nil))

stmtF : CK -> Rc.Statement -> C (List String)
stmtF k (CDrop d) = pure (Cons (dropLine d) Nil)
stmtF k (CLet x e) = lineC k ("V " ^ cLocal x ^ " = ") ";" e
stmtF k (CDecl x) = pure (Cons ("V " ^ cLocal x ^ ";") Nil)
stmtF k (CSet x e) = lineC k (cLocal x ^ " = ") ";" e
stmtF k CAbandon = pure (Cons "heff_abandon();" Nil)
stmtF k (CIf c yes no) = do
  v <- testC k c
  ys <- k.stmts yes
  ns <- k.stmts no
  pure
      (Cons
         ("if (" ^ v ^ ") {")
         (List.append
            (indented ys)
            (Cons "} else {" (List.append (indented ns) (Cons "}" Nil)))))
stmtF k (CSwitch e arms returns) = do
  sv <- k.exp e
  as <- traverseC (armF k sv) arms
  pure
      (List.append
         (Cons ("switch (heff_tag_of(" ^ sv ^ ")) {") Nil)
         (List.append
            (List.concatMap (\x -> x) as)
            (Cons (nomatchLine returns sv) (Cons "}" Nil))))
stmtF k (CReturn e) = lineC k "return " ";" e
stmtF k (CInPlace f es) =
  bind (traverseC k.exp (Cons f es)) (\vs -> pure (inPlace vs))
stmtF k (CRoomed f es) =
  bind (traverseC k.exp (Cons f es)) (\vs -> pure (roomed vs))
stmtF k (CTail f es) = do
  vs <- traverseC k.exp (Cons f es)
  pure
      (Cons
         ("return heff_tail("
          ^ fromMaybe "0" (List.head vs)
          ^ ", "
          ^ showInt (List.length es)
          ^ ", "
          ^ argsArr (List.drop 1 vs)
          ^ ");")
         Nil)
stmtF k (CLoop ps es) = bind (traverseC k.exp es) (\vs -> pure (again ps vs))
stmtF k (CJump g es) = do
  vs <- traverseC k.exp es
  pure
      (Cons
         ("HEFF_LAST return " ^ cGlobal g ^ "(" ^ joinWith ", " vs ^ ");")
         Nil)

stmtsF : CK -> List Rc.Statement -> C (List String)
stmtsF k ss =
  bind (traverseC (stmtF k) ss) (\ls -> pure (List.concatMap (\x -> x) ls))

ck : CK
ck = { exp = \e -> expF ck e, stmts = \ss -> stmtsF ck ss }

-- Definitions
--------------------------------------------------------------------------------

paramList : List String -> String
paramList xs =
  if List.null xs then "void"
  else joinWith ", " (List.map (\x -> "V " ^ cLocal x) xs)

-- | a definition's prototypes, and its code
type Emitted1 = { protos : List String, code : List String }

elemI : Int -> List Int -> Bool
elemI i Nil = False
elemI i (Cons j js) = i == j || elemI i js

-- (a closure's entry: the arguments given, those lent dropped after --
-- read before the call, as a lambda reads its own: they may be in
-- `heff_room`, which the call may put others in)
entryCall : String -> List Int -> Int -> String
entryCall key bi n =
  if List.null bi
    then "  return "
      ^ cGlobal key
      ^ "("
      ^ joinWith
        ", "
        (List.map (\i -> "a[" ^ showInt i ^ "]") (List.range 0 (n - 1)))
      ^ ");"
  else "  "
    ^ joinWith
      " "
      (List.map (\i -> "V a" ^ showInt i ^ " = a[" ^ showInt i ^ "];") bi)
    ^ " V r = "
    ^ cGlobal key
    ^ "("
    ^ joinWith
      ", "
      (List.map
         (\i -> if elemI i bi then "a" ^ showInt i else "a[" ^ showInt i ^ "]")
         (List.range 0 (n - 1)))
    ^ "); "
    ^ joinWith " " (List.map (\i -> "heff_drop(a" ^ showInt i ^ ");") bi)
    ^ " return r;"

funDef : String -> List String -> List Int -> List Rc.Statement -> C Emitted1
funDef key xs bi body = do
  ls <- ck.stmts body
  pure
      { protos =
          [ "static V " ^ cGlobal key ^ "(" ^ paramList xs ^ ");"
          , "static V " ^ cGlobal key ^ "_entry(V self, V *a);"
          , "static Clo "
          ^ cGlobal key
          ^ "_clo = {{0x80000000u, K_CLO, 0}, "
          ^ cGlobal key
          ^ "_entry, "
          ^ showInt (List.length xs)
          ^ ", 0};"
          ]
      , code =
          List.append
            [ ""
            , "static V " ^ cGlobal key ^ "(" ^ paramList xs ^ ") {"
            , "top: ;"
            ]
            (List.append
               (indented ls)
               [ "}"
               , "static V " ^ cGlobal key ^ "_entry(V self, V *a) {"
               , "  (void)self;"
               , entryCall key bi (List.length xs)
               , "}"
               ])
      }

valDef : String -> List Rc.Statement -> C Emitted1
valDef key body = do
  ls <- ck.stmts body
  pure
      { protos = Cons ("static V " ^ cGlobal key ^ "_get(void);") Nil
      , code =
          List.append
            [ ""
            , "static V " ^ cGlobal key ^ "_val;"
            , "static HEFF_ONCE " ^ cGlobal key ^ "_st;"
            , "static V " ^ cGlobal key ^ "_init(void) {"
            ]
            (List.append
               (indented ls)
               [ "}"
               , "static V " ^ cGlobal key ^ "_get(void) {"
               , "  if (HEFF_DONE("
               ^ cGlobal key
               ^ "_st)) return "
               ^ cGlobal key
               ^ "_val;"
               , "  return heff_global(&"
               ^ cGlobal key
               ^ "_val, &"
               ^ cGlobal key
               ^ "_st, "
               ^ cGlobal key
               ^ "_init);"
               , "}"
               ])
      }

defC : Rc.Def -> C Emitted1
defC (DFun key xs bi body) = funDef key xs bi body
defC (DVal key body) = valDef key body

-- The world's algebra
--------------------------------------------------------------------------------

-- (each node of the effect's sum, a function handing an operation on:
-- `InL` to the left, `InR` to the right, a leaf to its provider)
-- (a sum: its left's nodes `la`, from `n + 1` to `na`, then its right's)
plusDone : Int
         -> List String
         -> Int
         -> Pair (List String) Int
         -> Pair (List String) Int
plusDone n la na (MkPair lb nb) =
  MkPair
    (List.append
       la
       (List.append
          lb
          [ "static V heff_perform_"
          ^ showInt n
          ^ "(V p, V k) { int l = heff_tag_of(p) == TAG_InL; V q = heff_dup(heff_field(p, 0)); heff_drop(p); return l ? heff_perform_"
          ^ showInt (n + 1)
          ^ "(q, k) : heff_perform_"
          ^ showInt na
          ^ "(q, k); }"
          ]))
    nb

plusNodes : (Ef.Effect -> Int -> Pair (List String) Int)
          -> Int
          -> Ef.Effect
          -> Pair (List String) Int
          -> Pair (List String) Int
plusNodes go n b (MkPair la na) = plusDone n la na (go b na)

performNodes : Ef.Effect -> Int -> Pair (List String) Int
performNodes (Leaf k) n =
  MkPair
    [ "static V heff_perform_"
    ^ showInt n
    ^ "(V p, V k) { return heff_provider_"
    ^ Ef.nameOfKey k
    ^ "(p, k); }"
    ]
    (n + 1)
performNodes (Plus a b) n = plusNodes performNodes n b (performNodes a (n + 1))

performCode : Ef.Effect -> List String
performCode eff =
  List.append
    (fst (performNodes eff 0))
    ["static V heff_perform(V p, V k) { return heff_perform_0(p, k); }"]

-- The program
--------------------------------------------------------------------------------

primCloDef : String -> List String
primCloDef p = case Pr.primArity p of
  Just n ->
    [ "static V prim_"
    ^ p
    ^ "_entry(V self, V *a) { (void)self; return "
    ^ primName p
    ^ "("
    ^ joinWith
      ", "
      (List.map (\i -> "a[" ^ showInt i ^ "]") (List.range 0 (n - 1)))
    ^ "); }"
    , "static Clo prim_"
    ^ p
    ^ "_clo = {{0x80000000u, K_CLO, 0}, prim_"
    ^ p
    ^ "_entry, "
    ^ showInt n
    ^ ", 0};"
    ]
  Nothing -> Nil

shapeDef : String -> String
shapeDef key =
  "static uint32_t shape_"
  ^ key
  ^ "[] = {"
  ^ joinWith
    ", "
    (List.map
       (\m -> "LBL_" ^ m)
       (List.filter (\m -> strLength m > 0) (split "__" key)))
  ^ "};"

-- (a definition emitted on its own: its lambdas and strings named from
-- it and counted from 0, its variables named again from 0 -- what it
-- emits does not depend on what was emitted before it, nor on the names
-- drawn for other definitions)
ownDef : String -> C Unit
ownDef o = \s ->
    MkPair
      MkUnit
      { owner = o
      , nlam = 0
      , lams = s.lams
      , protos = s.protos
      , nstr = 0
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

defOwn : CE -> I.Def -> C Emitted1
defOwn ce d = do
  u <- ownDef (cGlobal d.key)
  defC (L.cDef ce.facts d (I.freshen 0 d.body))

defsC : CE -> List I.Def -> C (List Emitted1)
defsC ce defs = traverseC (defOwn ce) defs

emptyCS : CS
emptyCS =
  { owner = ""
  , nlam = 0
  , lams = Nil
  , protos = Nil
  , nstr = 0
  , strs = Nil
  , shapes = Nil
  , prims = Nil
  }

-- (each once, the first kept, in order)
onceInOrder : M.Map String Unit -> List String -> List String
onceInOrder seen Nil = Nil
onceInOrder seen (Cons x xs) =
  if M.member compareString x seen then onceInOrder seen xs
  else Cons x (onceInOrder (M.insert compareString x MkUnit seen) xs)

-- (what the owners use, each once, in the order first used)
usedOnce : List (Pair String String) -> List String
usedOnce ps = onceInOrder M.empty (List.map snd (List.reverse ps))

-- | the names of what is numbered, each with its number (`heff_show`'s)
namesTable : String -> M.Map String Int -> List String
namesTable name m =
  [ "static const HeffName "
  ^ name
  ^ "[] = {"
  ^ joinWith
    ", "
    (List.map
       (\p -> "{" ^ showInt (snd p) ^ ", \"" ^ fst p ^ "\"}")
       (M.toList m))
  ^ (if M.size m == 0 then "{0, NULL}" else "")
  ^ "};"
  ]

-- | how the program ends: its entry, run; or (`checkEnd`) each of the
-- | file's definitions, by its name, shown
type Ending = { prefix : List String, end : CE -> List String }

runEnd : Ef.Effect -> CE -> List String
runEnd eff ce =
  List.append
    (performCode eff)
    [ ""
    , "static V heff_entry(void) { return " ^ cGlobal L.entryKey ^ "_get(); }"
    , ""
    ]

-- (a definition's value, as a getter: a function's is its closure)
globalGet : CE -> Pair String String -> List String
globalGet ce (MkPair name key) =
  if M.member compareString key ce.facts.arity
    then [ "static V gget_"
         ^ mangle key
         ^ "(void) { return (V)&"
         ^ cGlobal key
         ^ "_clo; }"
         ]
  else Nil

getterOf : CE -> String -> String
getterOf ce key =
  if M.member compareString key ce.facts.arity then "gget_" ^ mangle key
  else cGlobal key ^ "_get"

definedIn : List I.Def -> String -> Bool
definedIn defs key = List.any (\(d : I.Def) -> strEq d.key key) defs

checkEnd : List (Pair String String) -> List I.Def -> CE -> List String
checkEnd exports defs ce =
  List.append
    [ "static V heff_perform(V p, V k) { (void)p; (void)k; return heff_abandon(); }"
    ]
    (List.append
       (List.concatMap
          (globalGet ce)
          (List.filter (\p -> definedIn defs (snd p)) exports))
       (List.append
          (namesTable "heff_tag_names_arr" ce.tags)
          (List.append
             (namesTable "heff_lbl_names_arr" ce.lbls)
             [ "static const Global heff_globals_arr[] = {"
             ^ joinWith
               ", "
               (List.map
                  (\p -> "{\"" ^ fst p ^ "\", " ^ getterOf ce (snd p) ^ "}")
                  (List.filter (\p -> definedIn defs (snd p)) exports))
             ^ (if List.null
                  (List.filter (\p -> definedIn defs (snd p)) exports)
                  then "{NULL, NULL}"
                else "")
             ^ "};"
             , "static void heff_check_init(void) {"
             , "  heff_globals = heff_globals_arr;"
             , "  heff_nglobals = "
             ^ showInt
               (List.length
                  (List.filter (\p -> definedIn defs (snd p)) exports))
             ^ ";"
             , "  heff_tag_names = heff_tag_names_arr;"
             , "  heff_ntag_names = " ^ showInt (M.size ce.tags) ^ ";"
             , "  heff_lbl_names = heff_lbl_names_arr;"
             , "  heff_nlbl_names = " ^ showInt (M.size ce.lbls) ^ ";"
             , "}"
             , ""
             ])))

programCE : String -> List Em.Provider -> Ending -> List I.Def -> CE -> String
programCE runtime provs ending defs ce = case defsC ce defs emptyCS of
  MkPair ems s ->
    joinWith
      "\n"
      (List.append
         (Cons "// Generated from Hippogriff; do not edit." ending.prefix)
         (List.append
            (List.map
               (\p -> "#define " ^ tagName (fst p) ^ " " ^ showInt (snd p))
               (List.filter
                  (\p -> not (elemS (fst p) knownTags))
                  (M.toList ce.tags)))
            (List.append
               (List.map
                  (\p -> "#define " ^ lblName (fst p) ^ " " ^ showInt (snd p))
                  (M.toList ce.lbls))
               (List.append
                  (Cons runtime Nil)
                  (List.append
                     (List.map (\(p : Em.Provider) -> p.text) provs)
                     (List.append
                        (Cons "static V heff_perform(V p, V k);" Nil)
                        (List.append
                           (List.map snd (List.reverse s.strs))
                           (List.append
                              (List.map shapeDef (usedOnce s.shapes))
                              (List.append
                                 (List.concatMap
                                    (\(e : Emitted1) -> e.protos)
                                    ems)
                                 (List.append
                                    (List.map snd (List.reverse s.protos))
                                    (List.append
                                       (List.concatMap
                                          primCloDef
                                          (usedOnce s.prims))
                                       (List.append
                                          (List.concatMap
                                             (\(e : Emitted1) -> e.code)
                                             ems)
                                          (List.append
                                             (List.map
                                                snd
                                                (List.reverse s.lams))
                                             (ending.end ce))))))))))))))

-- (each once, in order: through a map, not a list searched)
sortedOnce : List String -> List String
sortedOnce xs =
  List.map
    fst
    (M.toList
       (List.foldl
          (\m x -> M.insert compareString x (MkUnit : Unit) m)
          M.empty
          xs))

-- (what the emitter knows of the whole program)
ceOf : List Em.Provider -> F.Facts -> Pair (List String) (List String) -> CE
ceOf provs facts names =
  { tags =
      hashedGo
        10
        65526
        (sortedOnce
           (List.filter
              (\t -> not (elemS t knownTags))
              (List.append
                 (fst names)
                 (List.concatMap
                    (\(p : Em.Provider) -> namesInGo "TAG_" p.text 0 Nil)
                    provs))))
        (numbered 0 knownTags M.empty)
        M.empty
  , lbls =
      hashedGo
        0
        2147483647
        (sortedOnce
           (List.append
              (snd names)
              (List.concatMap
                 (\(p : Em.Provider) -> namesInGo "LBL_" p.text 0 Nil)
                 provs)))
        M.empty
        M.empty
  , facts = facts
  }

programWith : String
            -> List Em.Provider
            -> Ending
            -> F.Facts
            -> List I.Def
            -> Pair (List String) (List String)
            -> String
programWith runtime provs ending facts defs names =
  programCE runtime provs ending defs (ceOf provs facts names)

-- Parts: the program in a file for each module (`--split`), which a C
-- compiler builds apart -- and builds again only what changed
--------------------------------------------------------------------------------

-- (a definition's module: its key up to its last dot)
lastDotGo : String -> Int -> Int -> Int
lastDotGo k i at =
  if i >= strLength k then at
  else lastDotGo k (i + 1) (if byteAt k i == 46 then i else at)

moduleAt : String -> Int -> String
moduleAt k at = if at < 0 then k else strSlice k 0 at

moduleOfKey : String -> String
moduleOfKey k = moduleAt k (lastDotGo k 0 (0 - 1))

-- (a line of the program as a part has it: a definition's functions
-- seen from every part, not only its own -- what a definition keeps to
-- itself (`_val`, `_st`, `_init`) stays its own)
pubLine : String -> String
pubLine l =
  if startsWith "static V g_" l
  && not (endsWith "_val;" l)
  && not (contains "_init(void)" l)
    then strSlice l 7 (strLength l)
  else if startsWith "static V heff_perform(" l then strSlice l 7 (strLength l)
  else l

-- (a definition's closure: defined in its own part, declared in others)
isCloDef : String -> Bool
isCloDef l = startsWith "static Clo g_" l

cloDecl : String -> String
cloDecl l = case indexOf " =" l of
  Just at -> "extern Clo " ^ strSlice l 11 at ^ ";"
  Nothing -> l

-- (heff.h, which every part includes: the runtime -- what each part
-- declares and defines for itself, the numbers of the tags and labels
-- it uses too, is in it, so that heff.h is the same whatever the
-- program, and a part changed does not make every part be built again)
partHead : String -> Ending -> List String
partHead runtime ending =
  List.append
    (Cons "// Generated from Hippogriff; do not edit." Nil)
    (List.append ending.prefix [runtime, "V heff_perform(V p, V k);"])

-- (the numbers of the tags and labels a part uses)
numbersOf : CE -> Pair (List String) (List String) -> List String
numbersOf ce (MkPair ts ls) =
  List.append
    (List.map
       (\t ->
          "#define "
          ^ tagName t
          ^ " "
          ^ showInt (fromMaybe 0 (M.lookup compareString t ce.tags)))
       (List.filter (\t -> not (elemS t knownTags)) (sortedOnce ts)))
    (List.map
       (\l ->
          "#define "
          ^ lblName l
          ^ " "
          ^ showInt (fromMaybe 0 (M.lookup compareString l ce.lbls)))
       (sortedOnce ls))

-- (a definition, declared to a part that uses it: a function's code,
-- entry and closure, a value's getter -- by its arity, not by its
-- parameters' names, so that a part changes only when what it uses does)
declOf : CE -> String -> List String
declOf ce k = case M.lookup compareString k ce.facts.arity of
  Just n ->
    [ "V "
    ^ cGlobal k
    ^ "("
    ^ (if n == 0 then "void" else joinWith ", " (List.replicate n "V"))
    ^ ");"
    , "V " ^ cGlobal k ^ "_entry(V self, V *a);"
    , "extern Clo " ^ cGlobal k ^ "_clo;"
    ]
  Nothing -> ["V " ^ cGlobal k ^ "_get(void);"]

-- (what was made for each definition -- its strings, its lambdas --
-- by the definition it was made for)
byOwner : List (Pair String String) -> M.Map String (List String)
byOwner ps =
  List.foldl
    (\m p ->
       M.insert
         compareString
         (fst p)
         (Cons (snd p) (fromMaybe Nil (M.lookup compareString (fst p) m)))
         m)
    M.empty
    ps

linesOf : M.Map String (List String) -> String -> List String
linesOf m o = fromMaybe Nil (M.lookup compareString o m)

-- (a definition, as its part has it)
ownLines : CS
         -> M.Map String (List String)
         -> M.Map String (List String)
         -> M.Map String (List String)
         -> Pair I.Def Emitted1
         -> List String
ownLines s strs protos lams (MkPair d e) =
  List.append
    (linesOf strs (cGlobal d.key))
    (List.append
       (List.map pubLine (linesOf protos (cGlobal d.key)))
       (List.append
          (List.map
             (\l -> strSlice l 7 (strLength l))
             (List.filter isCloDef e.protos))
          (List.append
             (List.map pubLine e.code)
             (List.map pubLine (linesOf lams (cGlobal d.key))))))

pairKey : Pair I.Def Emitted1 -> String
pairKey (MkPair d _) = d.key

-- (the definitions, by module, each module's in order)
byModule : List (Pair I.Def Emitted1)
         -> M.Map String (List (Pair I.Def Emitted1))
byModule ps =
  List.foldl
    (\m p ->
       M.insert
         compareString
         (moduleOfKey (pairKey p))
         (Cons
            p
            (fromMaybe
               Nil
               (M.lookup compareString (moduleOfKey (pairKey p)) m)))
         m)
    M.empty
    (List.reverse ps)

zipDE : List I.Def -> List Emitted1 -> List (Pair I.Def Emitted1)
zipDE (Cons d ds) (Cons e es) = Cons (MkPair d e) (zipDE ds es)
zipDE _ _ = Nil

-- (what a definition uses: the definitions it calls or mentions, and
-- itself)
usesOf : Pair I.Def Emitted1 -> List String
usesOf (MkPair d _) = Cons d.key (I.globalsIn d.body)

-- (what the owners of a part use, each once: shapes, primitives)
usedBy : M.Map String (List String) -> List (Pair I.Def Emitted1) -> List String
usedBy m ps =
  sortedOnce (List.concatMap (\p -> linesOf m (cGlobal (pairKey p))) ps)

-- (a module's part: heff.h, then what it uses declared -- the shapes and
-- primitives its definitions use, and the definitions -- then its own)
modulePart : List String
           -> CE
           -> CS
           -> M.Map String (List String)
           -> M.Map String (List String)
           -> M.Map String (List String)
           -> M.Map String (List String)
           -> M.Map String (List String)
           -> Pair String (List (Pair I.Def Emitted1))
           -> Pair String String
modulePart head ce s shapes prims strs protos lams (MkPair m ps) =
  MkPair
    (m ^ ".c")
    (joinWith
       "\n"
       (List.append
          head
          (List.append
             (numbersOf
                ce
                (namesIn
                   tagsLbls
                   (List.map (\(p : Pair I.Def Emitted1) -> (fst p).body) ps)))
             (List.append
                (List.map shapeDef (usedBy shapes ps))
                (List.append
                   (List.concatMap primCloDef (usedBy prims ps))
                   (List.append
                      (List.concatMap
                         (declOf ce)
                         (sortedOnce (List.concatMap usesOf ps)))
                      (List.concatMap (ownLines s strs protos lams) ps)))))))

-- | the part with the program's `main`, its worlds' providers and its
-- | algebra: named, as `run$entry.c` is, as no module's part is -- a
-- | module `main` has its own, `main.c`
entryPart : String
entryPart = "run$main.c"

partsWith : String
          -> List Em.Provider
          -> Ending
          -> List I.Def
          -> CE
          -> Pair (List Emitted1) CS
          -> List (Pair String String)
partsWith runtime provs ending defs ce (MkPair ems s) =
  Cons
    (MkPair "heff.h" (joinWith "\n" (partHead runtime ending)))
    (Cons
       (MkPair
          entryPart
          (joinWith
             "\n"
             (Cons
                "#include \"heff.h\""
                (List.append
                   (numbersOf
                      ce
                      (MkPair
                         (List.concatMap
                            (\(p : Em.Provider) ->
                               namesInGo "TAG_" p.text 0 Nil)
                            provs)
                         (List.concatMap
                            (\(p : Em.Provider) ->
                               namesInGo "LBL_" p.text 0 Nil)
                            provs)))
                   (List.append
                      (declOf ce L.entryKey)
                      (List.append
                         (List.map (\(p : Em.Provider) -> p.text) provs)
                         (List.map pubLine (ending.end ce))))))))
       (List.map
          (modulePart
             [ "// Generated from Hippogriff; do not edit."
             , "#define HEFF_PART"
             , "#include \"heff.h\""
             ]
             ce
             s
             (byOwner s.shapes)
             (byOwner s.prims)
             (byOwner s.strs)
             (byOwner s.protos)
             (byOwner s.lams))
          (M.toList (byModule (zipDE defs ems)))))

-- The backend's cache: a definition's C as it keeps it
--------------------------------------------------------------------------------

-- A definition's C depends on the definition alone -- as it is lowered,
-- its variables named again from 0 (`defOwn`) -- and on what is known
-- of itself and of the globals it mentions: whether each is a function
-- and of how many parameters, whether its calls may give back a bounce,
-- which of its parameters are lent.  The cache (heff.build.backcache)
-- keeps it by a hash of those (`emitVer`), with what was made for it on
-- the way: its strings and lambdas, the shapes and primitives it uses,
-- each in the order made.

-- | a definition's C, as the cache keeps it
type EmitKept =
  { ver : String
  , protos : List String
  , code : List String
  , strs : List String
  , lprotos : List String
  , lams : List String
  , shapes : List String
  , prims : List String
  }

-- (what is known of a global)
globalH : CE -> String -> List Ir.HItem -> List Ir.HItem
globalH ce g rest =
  Cons
    (HS g)
    (Cons
       (HN (fromMaybe (0 - 1) (M.lookup compareString g ce.facts.arity)))
       (Cons
          (HN (if M.member compareString g ce.facts.bounce then 1 else 0))
          (Cons
             (HS (joinWith "," (List.map showInt (Bo.borOf ce.facts.lent g))))
             rest)))

-- | what a definition's C is made of, hashed: its key, its body (named
-- | again from 0), and what is known of itself and of what it mentions
emitVer : CE -> String -> I.Expr -> String
emitVer ce key b =
  Ir.hashOf
    (Cons
       (HS key)
       (Cons
          (HE b)
          (List.foldr
             (globalH ce)
             Nil
             (sortedOnce (Cons key (I.globalsIn b))))))

-- (what a definition made on its own: the C state it was emitted from
-- held nothing else)
ownStart : String -> CS
ownStart o =
  { owner = o
  , nlam = 0
  , lams = Nil
  , protos = Nil
  , nstr = 0
  , strs = Nil
  , shapes = Nil
  , prims = Nil
  }

madeLines : List (Pair String String) -> List String
madeLines ps = List.reverse (List.map snd ps)

keptOf : String -> Emitted1 -> CS -> EmitKept
keptOf v e s =
  { ver = v
  , protos = e.protos
  , code = e.code
  , strs = madeLines s.strs
  , lprotos = madeLines s.protos
  , lams = madeLines s.lams
  , shapes = madeLines s.shapes
  , prims = madeLines s.prims
  }

pushOwn : String
        -> List String
        -> List (Pair String String)
        -> List (Pair String String)
pushOwn o Nil acc = acc
pushOwn o (Cons l ls) acc = pushOwn o ls (Cons (MkPair o l) acc)

-- (what the definition `o` made, as if made after what `s` holds)
mergeKept : String -> EmitKept -> CS -> CS
mergeKept o k s =
  { owner = s.owner
  , nlam = s.nlam
  , lams = pushOwn o k.lams s.lams
  , protos = pushOwn o k.lprotos s.protos
  , nstr = s.nstr
  , strs = pushOwn o k.strs s.strs
  , shapes = pushOwn o k.shapes s.shapes
  , prims = pushOwn o k.prims s.prims
  }

type EmitAcc =
  { ems : List Emitted1, s : CS, fresh : List (Pair String EmitKept) }

keptHit : EmitAcc -> String -> EmitKept -> EmitAcc
keptHit acc key k =
  { ems = Cons { protos = k.protos, code = k.code } acc.ems
  , s = mergeKept (cGlobal key) k acc.s
  , fresh = acc.fresh
  }

freshEmitted : EmitAcc -> String -> String -> Pair Emitted1 CS -> EmitAcc
freshEmitted acc key v (MkPair e s1) =
  { ems = Cons e acc.ems
  , s = mergeKept (cGlobal key) (keptOf v e s1) acc.s
  , fresh = Cons (MkPair key (keptOf v e s1)) acc.fresh
  }

keptAtVer : String -> Maybe EmitKept -> Maybe EmitKept
keptAtVer v (Just k) = if strEq k.ver v then Just k else Nothing
keptAtVer v Nothing = Nothing

emitAt : CE
       -> M.Map String EmitKept
       -> EmitAcc
       -> I.Def
       -> Pair I.Expr Int
       -> String
       -> EmitAcc
emitAt ce kept acc d own v = case keptAtVer
    v
    (M.lookup compareString d.key kept) of
  Just k -> keptHit acc d.key k
  Nothing ->
    freshEmitted
      acc
      d.key
      v
      (defC (L.cDef ce.facts d own) (ownStart (cGlobal d.key)))

emitWith : CE
         -> M.Map String EmitKept
         -> EmitAcc
         -> I.Def
         -> Pair I.Expr Int
         -> EmitAcc
emitWith ce kept acc d own =
  emitAt ce kept acc d own (emitVer ce d.key (fst own))

emitOne : CE -> M.Map String EmitKept -> EmitAcc -> I.Def -> EmitAcc
emitOne ce kept acc d = emitWith ce kept acc d (I.freshen 0 d.body)

-- | each definition emitted as `defsC` does -- as the cache keeps it,
-- | where it keeps it at its version -- and those emitted here
defsKept : CE -> M.Map String EmitKept -> List I.Def -> EmitAcc
defsKept ce kept defs =
  List.foldl (emitOne ce kept) { ems = Nil, s = emptyCS, fresh = Nil } defs

partsCE : String
        -> List Em.Provider
        -> Ending
        -> List I.Def
        -> CE
        -> List (Pair String String)
partsCE runtime provs ending defs ce =
  partsWith runtime provs ending defs ce (defsC ce defs emptyCS)

-- | the program as parts, each by its file's name: heff.h, run$main.c
-- | (`entryPart`), then a part for each module
programParts : String
             -> List Em.Provider
             -> Ending
             -> F.Facts
             -> List I.Def
             -> List (Pair String String)
programParts runtime provs ending facts defs =
  partsCE
    runtime
    provs
    ending
    defs
    (ceOf
       provs
       facts
       (namesIn tagsLbls (List.map (\(d : I.Def) -> d.body) defs)))

-- | the program, its runtime and its providers before it
programC : String
         -> List Em.Provider
         -> Ending
         -> F.Facts
         -> List I.Def
         -> String
programC runtime provs ending facts defs =
  programWith
    runtime
    provs
    ending
    facts
    defs
    (namesIn tagsLbls (List.map (\(d : I.Def) -> d.body) defs))

outputOf : String -> List Em.Provider -> Ending -> L.Lowered -> Em.Output
outputOf runtime provs ending l =
  { source = programC runtime provs ending l.facts l.defs, errors = l.errors }

checkOut : String -> List (Pair String String) -> L.Lowered -> Em.Output
checkOut runtime exports l =
  { source =
      programC
        runtime
        Nil
        { prefix = Cons "#define HEFF_CHECK" Nil
        , end = checkEnd exports l.defs
        }
        l.facts
        l.defs
  , errors = l.errors
  }

-- (what comes before the runtime: `#define HEFF_THREADS 1` where a
-- provider says it, which runs the program in threads of its own, so
-- that the runtime is built for them (lib/c/runtime.c, "Threads"))
threadsLine : String
threadsLine = "#define HEFF_THREADS 1"

saysThreads : Em.Provider -> Bool
saysThreads p =
  List.any (\l -> startsWith "#define HEFF_THREADS" l) (lines p.text)

runPrefix : List Em.Provider -> List String
runPrefix provs = if List.any saysThreads provs then [threadsLine] else Nil

-- | one C file that runs the computation `key` of the effect `eff`: the
-- | runtime (lib/c/runtime.c), each world's provider, and the program
compileProgramC : String
                -> List Em.Provider
                -> G.Globals
                -> String
                -> Ef.Effect
                -> Em.Output
compileProgramC runtime provs g key eff =
  outputOf
    runtime
    provs
    { prefix = runPrefix provs, end = runEnd eff }
    (L.lowerProgramC g key)

partsOf : String
        -> List Em.Provider
        -> Ef.Effect
        -> L.Lowered
        -> Pair (List (Pair String String)) (List String)
partsOf runtime provs eff l =
  MkPair
    (programParts
       runtime
       provs
       { prefix = runPrefix provs, end = runEnd eff }
       l.facts
       l.defs)
    l.errors

-- | the program `compileProgramC` makes, as parts (`programParts`), and
-- | what is wrong with it
compileProgramParts : String
                    -> List Em.Provider
                    -> G.Globals
                    -> String
                    -> Ef.Effect
                    -> Pair (List (Pair String String)) (List String)
compileProgramParts runtime provs g key eff =
  partsOf runtime provs eff (L.lowerProgramC g key)

-- | the program as parts, made through the backend's cache: what is
-- | wrong with it, and what the cache is to keep anew -- definitions of
-- | the core simplified, copies, definitions' C
type PartsKept =
  { parts : List (Pair String String)
  , errors : List String
  , groups : List L.GroupOut
  , copies : List Si.CopyDone
  , emits : List (Pair String EmitKept)
  }

keptPartsAcc : String
             -> List Em.Provider
             -> Ending
             -> L.LoweredKept
             -> CE
             -> EmitAcc
             -> PartsKept
keptPartsAcc runtime provs ending lk ce acc =
  { parts =
      partsWith
        runtime
        provs
        ending
        lk.lowered.defs
        ce
        (MkPair (List.reverse acc.ems) acc.s)
  , errors = lk.lowered.errors
  , groups = lk.groups
  , copies = lk.copies
  , emits = acc.fresh
  }

keptPartsCE : String
            -> List Em.Provider
            -> Ending
            -> M.Map String EmitKept
            -> L.LoweredKept
            -> CE
            -> PartsKept
keptPartsCE runtime provs ending kept lk ce =
  keptPartsAcc runtime provs ending lk ce (defsKept ce kept lk.lowered.defs)

keptParts : String
          -> List Em.Provider
          -> Ef.Effect
          -> M.Map String EmitKept
          -> L.LoweredKept
          -> PartsKept
keptParts runtime provs eff kept lk =
  keptPartsCE
    runtime
    provs
    { prefix = Nil, end = runEnd eff }
    kept
    lk
    (ceOf
       provs
       lk.lowered.facts
       (namesIn tagsLbls (List.map (\(d : I.Def) -> d.body) lk.lowered.defs)))

-- | the parts `compileProgramParts` makes, made through the backend's
-- | cache (heff.build.backcache): each definition of the core taken as
-- | it keeps it at its version (`vers`, `ks`, heff.compile.lower), each
-- | definition's C as it keeps it at what it is made of (`kept`)
compileProgramPartsKept : String
                        -> List Em.Provider
                        -> G.Globals
                        -> String
                        -> Ef.Effect
                        -> M.Map String String
                        -> L.Keeps
                        -> M.Map String EmitKept
                        -> PartsKept
compileProgramPartsKept runtime provs g key eff vers ks kept =
  keptParts runtime provs eff kept (L.cKeptOf (L.lowerProgramKept g key vers ks))

-- | one C file that shows the definitions it is asked for, of those
-- | given (each by its name and key), as test/load-js.mjs shows
-- | JavaScript's: what the tests hold the backend to
compileCheckC : String -> G.Globals -> List (Pair String String) -> Em.Output
compileCheckC runtime g exports =
  checkOut runtime exports (L.lowerC g (List.map snd exports))

catMaybesC : {a : Type} -> List (Maybe a) -> List a
catMaybesC Nil = Nil
catMaybesC (Cons (Just x) rest) = Cons x (catMaybesC rest)
catMaybesC (Cons Nothing rest) = catMaybesC rest

-- | the effects a C provider provides: its `heff_provider_X` definitions
-- | >>> providedNames "static V heff_provider_stdio(V p, V k) {"
-- | ["stdio"]
providedNames : String -> List String
providedNames text =
  catMaybesC
    (List.map
       (\l ->
          if startsWith "static V heff_provider_" l then Just (identAt l 23 23)
          else Nothing)
       (lines text))
