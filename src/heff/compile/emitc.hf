-- A program's definitions, their references counted (heff.compile.refcount,
-- through heff.compile.lower's `cDef`), as C, for lib/c/runtime.c,
-- compiled by `zig cc` (#20).  What is decided is decided there; here it
-- is only printed.
--
--   a definition of n parameters  ~>  a C function of n parameters
--            (`g_K`), and a closure of it (`g_K_clo`) where it is a value;
--            a call of itself last, a loop (`goto top`); of another
--            of n parameters, a jump (`HEFF_LAST`: clang's `musttail`).
--            One with a worker (heff.compile.worker), its worker
--            (`g_K_w`), taking and giving numbers unboxed, which a known
--            call calls, and `g_K` its wrapper
--   a definition that is not a function  ~>  computed when first used
--            (`g_K_get`)
--   a lambda  ~>  a C function of its own (`lam_N`), what it mentions
--            and does not bind kept in its closure
--   a tag, a record  ~>  `heff_tag_n`, `heff_rec_n`, built at the size
--            the emitter knows: tags and labels numbered (`TAG_x`,
--            `LBL_x`), a record's fields in the order it is written in
--   a string  ~>  a static object, its bytes (`HEFF_LIT`, a C string
--            literal of them); a `Bytes` literal too (`HEFF_BYTES`)
--   a call last of an unknown function  ~>  `heff_tail` (counted, a
--            bounce every so often); a call not last, its value through
--            `heff_tr` -- as src/heff/compile/emit.hf does (`Emit.bouncing`),
--            a closure taking the arguments given called where it is
--            (`heff_call`).  From a lambda, a jump where the function is
--            a closure taking the arguments given: put where the
--            lambda's were, if it took as many (`inPlace`), else in
--            `heff_room` (`roomed`)
--
-- A program is one file: the runtime, the providers of its worlds
-- (`M.provider.c`), and its code; its entry is heff.compile.lower's `entryKey`,
-- its algebra (`perform`) handing each operation to its world's
-- provider by the sum the effect is.

import heff.elab.effect as Effect
import heff.compile.borrow as Borrow
import heff.compile.emit as Emit
import heff.compile.facts as Facts
import heff.elab.fixed as Fixed
import heff.elab.globals as Globals
import heff.compile.ir as IR
import heff.compile.irtext as IRText
import heff.compile.lower as Lower
import heff.compile.prims as Prims
import heff.compile.refcount as RefCount
import heff.compile.repr as Repr
import heff.compile.simplify as Simplify
import map as Map
import uint8 as UInt8

-- Names
--------------------------------------------------------------------------------

hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

isAlnum : Int -> Bool
isAlnum c =
  (97 <= c && c <= 122) || (65 <= c && c <= 90) || (48 <= c && c <= 57)

mangleChar : Int -> String
mangleChar c =
  if isAlnum c then strFromByte (UInt8.fromInt c)
  else "_" ^ hexDigit (intDiv (intMod c 256) 16) ^ hexDigit (intMod c 16)

-- (from `i`, a run of letters and digits scanned to `j`: each run taken
-- whole, not a letter at a time)
mangleW : String -> Int -> Int -> String -> String
mangleW s i j acc =
  if j < strLength s && isAlnum (byteAt s j) then mangleW s i (j + 1) acc
  else if j >= strLength s then acc ^ strSlice s i j
  else mangleW
      s
      (j + 1)
      (j + 1)
      (acc ^ strSlice s i j ^ mangleChar (byteAt s j))

-- | a name as C spells it: letters and digits kept, the rest `_xx`
-- | >>> mangle "co.<+>"
-- | "co_2e_3c_2b_3e"
mangle : String -> String
mangle s = mangleW s 0 0 ""

cGlobal : String -> String
cGlobal k = "g_" ^ mangle k

cLocal : String -> String
cLocal x = "v_" ^ mangle x

tagName : String -> String
tagName t = "TAG_" ^ mangle t

lblName : String -> String
lblName l = "LBL_" ^ mangle l

-- Tags and labels
--------------------------------------------------------------------------------

-- | the tags lib/c/runtime.c knows, numbered as it numbers them
knownTags : List String
knownTags =
  [ "True"
  , "False"
  , "Nil"
  , "Cons"
  , "MkUnit"
  , "Just"
  , "Nothing"
  , "MkPair"
  , "InL"
  , "InR"
  ]

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

-- (the variable an expression is, if it is one; the definition: so that
-- an equation looking for one does not copy its fallback into an arm for
-- each other kind of expression)
varOf : IR.Expr -> Maybe String
varOf (EVar x) = Just x
varOf _ = Nothing

globalOf : IR.Expr -> Maybe String
globalOf (EGlobal g) = Just g
globalOf _ = Nothing

nubS : List String -> List String -> List String
nubS acc Nil = List.reverse acc
nubS acc (Cons x xs) = if elemS x acc then nubS acc xs else nubS (Cons x acc) xs

armTags : List IR.Arm -> List String
armTags arms = List.map IR.armTag arms

-- (each the one's before the other's: only the first copied)
pairCat : Pair (List String) (List String)
        -> Pair (List String) (List String)
        -> Pair (List String) (List String)
pairCat (MkPair ts ls) (MkPair ts2 ls2) =
  MkPair (List.append ts ts2) (List.append ls ls2)

-- (the tags and labels an expression mentions)
namesIn : (IR.Expr -> Pair (List String) (List String))
        -> List IR.Expr
        -> Pair (List String) (List String)
namesIn go es = List.foldr (\e acc -> pairCat (go e) acc) (MkPair Nil Nil) es

withLbls : List String
         -> Pair (List String) (List String)
         -> Pair (List String) (List String)
withLbls ls (MkPair ts ls2) = MkPair ts (List.append ls ls2)

withTags : List String
         -> Pair (List String) (List String)
         -> Pair (List String) (List String)
withTags ts (MkPair ts2 ls) = MkPair (List.append ts ts2) ls

tagsLbls : IR.Expr -> Pair (List String) (List String)
tagsLbls (ELam _ b) = tagsLbls b
tagsLbls (EApp f as) = namesIn tagsLbls (Cons f as)
tagsLbls (ELet _ a b) = namesIn tagsLbls [a, b]
tagsLbls (ERecord fs _) =
  withLbls (List.map fst fs) (namesIn tagsLbls (List.map snd fs))
tagsLbls (EProj e l _ _) = withLbls (Cons l Nil) (tagsLbls e)
tagsLbls (ETag t as _) = withTags (Cons t Nil) (namesIn tagsLbls as)
tagsLbls (EMatch s arms) =
  withTags (armTags arms) (namesIn tagsLbls (Cons s (List.map IR.armBody arms)))
tagsLbls (EPrimCall _ as) = namesIn tagsLbls as
tagsLbls (ECall _ as) = namesIn tagsLbls as
tagsLbls _ = MkPair Nil Nil

identAt : String -> Int -> Int -> String
identAt text start i =
  if i < strLength text && (isAlnum (byteAt text i) || byteAt text i == 95)
    then identAt text start (i + 1)
  else strSlice text start i

-- (`TAG_x` or `LBL_x` in a provider's text: the tags or labels it makes
-- or reads)
namesInGo : String -> String -> Int -> List String -> List String
namesInGo pre text i acc = case indexOf
    pre
    (strSlice text i (strLength text)) of
  Nothing -> acc
  Just j ->
    namesInGo
      pre
      text
      (i + j + strLength pre)
      (Cons (identAt text (i + j + strLength pre) (i + j + strLength pre)) acc)

numbered : Int -> List String -> Map.Map String Int -> Map.Map String Int
numbered n Nil m = m
numbered n (Cons x xs) m =
  if Map.member compareString x m then numbered n xs m
  else numbered (n + 1) xs (Map.insert compareString x n m)

-- A tag's number, and a label's, is by its name, not by what other
-- tags and labels the program has: a hash of the name (the next number
-- free, if another took it), so that a tag added does not number the
-- others again.  Tags are numbered past those the runtime knows, below
-- 2^16 (an object keeps its tag in 16 bits); labels below 2^31.

-- (a text's hash, below `m`)
hashBelow : String -> Int -> Int -> Int -> Int
hashBelow t m i a =
  if i >= strLength t then a
  else hashBelow t m (i + 1) ((a * 31 + byteAt t i + 1) % m)

-- (the number `h` or, if taken, the next free after it)
slotFrom : Int -> Int -> Int -> Map.Map Int Unit -> Int
slotFrom base m h taken =
  if Map.member compareInt (base + h) taken
    then slotFrom base m ((h + 1) % m) taken
  else base + h

-- (each name, in order, numbered at its hash past `base`, below `base + m`)
hashedGo : Int
         -> Int
         -> List String
         -> Map.Map String Int
         -> Map.Map Int Unit
         -> Map.Map String Int
hashedGo base m Nil names taken = names
hashedGo base m (Cons x xs) names taken =
  if Map.member compareString x names then hashedGo base m xs names taken
  else hashedGo
      base
      m
      xs
      (Map.insert
         compareString
         x
         (slotFrom base m (hashBelow x m 0 7) taken)
         names)
      (Map.insert
         compareInt
         (slotFrom base m (hashBelow x m 0 7) taken)
         MkUnit
         taken)

-- What emitting reads: the numbers of tags and labels, and what is known
-- of the program (heff.compile.facts)
--------------------------------------------------------------------------------

type CE =
  { tags : Map.Map String Int, lbls : Map.Map String Int, facts : Facts.Facts }

-- What emitting makes on the way: the lambdas, the strings and the
-- labels of records, each a C definition of its own
--------------------------------------------------------------------------------

-- (`owner`: the C name of the definition being emitted, which names its
-- lambdas and strings; `nlam`, `nstr` count them within it -- so that a
-- definition's C is the same whatever is emitted before it.  What each
-- makes, and the shapes and primitives each uses, by its owner)
type CS =
  { owner : String
  , nlam : Int
  , lams : List (Pair String String)
  , protos : List (Pair String String)
  , nstr : Int
  , strs : List (Pair String String)
  , shapes : List (Pair String String)
  , prims : List (Pair String String)
  }

type C a = CS -> Pair a CS

bindTake : {a b : Type} -> (a -> C b) -> Pair a CS -> Pair b CS
bindTake f (MkPair x s) = f x s

bind : {a b : Type} -> C a -> (a -> C b) -> C b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> C a
pure x = \s -> MkPair x s

traverseC : {a b : Type} -> (a -> C b) -> List a -> C (List b)
traverseC f Nil = pure Nil
traverseC f (Cons x xs) = do
  y <- f x
  ys <- traverseC f xs
  pure (Cons y ys)

-- (a byte in octal, as a C string's escape has it: three digits, so that
-- no digit after it is read as its)
octal : Int -> String
octal b = show (b / 64) ^ show (b / 8 % 8) ^ show (b % 8)

-- (the byte `b`, at `i`, as a C string literal has it: printable ASCII as
-- it is but `"`, `\` and `?` (which a trigraph starts with), escaped;
-- another in octal)
cByte : String -> Int -> Int -> String
cByte s i 34 = "\\\""
cByte s i 92 = "\\\\"
cByte s i 63 = "\\?"
cByte s i b =
  if 32 <= b && b < 127 then strSlice s i (i + 1) else "\\" ^ octal b

-- (from `i`, between the quotes, into `acc`)
cBytesGo : String -> Int -> String -> String
cBytesGo s i acc =
  if i >= strLength s then acc
  else cBytesGo s (i + 1) (acc ^ cByte s i (byteAt s i))

-- | a static string, by lib/c/runtime.c's `HEFF_LIT` (`Bytes`, by its
-- | `HEFF_BYTES`, the macro `mac`): its bytes, as a C string literal
-- | writes them
-- | >>> strDef "HEFF_LIT" "s" "ab"
-- | "HEFF_LIT(s, 2, \"ab\");"
-- | >>> strDef "HEFF_LIT" "s" ""
-- | "HEFF_LIT(s, 0, \"\");"
-- | >>> strDef "HEFF_LIT" "s" "a\"\\??=\n\u{e9}"
-- | "HEFF_LIT(s, 9, \"a\\\"\\\\\\?\\?=\\012\\303\\251\");"
-- | >>> strDef "HEFF_BYTES" "s" "1\xff2"
-- | "HEFF_BYTES(s, 3, \"1\\3772\");"
strDef : String -> String -> String -> String
strDef mac name str =
  mac
  ^ "("
  ^ name
  ^ ", "
  ^ show (strLength str)
  ^ ", \""
  ^ cBytesGo str 0 ""
  ^ "\");"

-- | a static string, or `Bytes`, by the macro `mac`
strLit : String -> String -> C String
strLit mac str = \s ->
    MkPair
      ("((V)&" ^ s.owner ^ "_str" ^ show s.nstr ^ ")")
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr + 1
      , strs =
          Cons
            (MkPair
               s.owner
               (strDef mac (s.owner ^ "_str" ^ show s.nstr) str))
            s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

-- (a shape's name: its labels, mangled, by `__` -- which no mangled
-- name has in it -- so that it is named alike in every program, not by
-- the numbers its labels have in this one)
shapeKey : List String -> String
shapeKey ls = joinWith "__" (List.map mangle ls)

-- (whether the owner `o` has `k` among its: theirs are those first, the
-- definition being emitted's)
ownHas : String -> String -> List (Pair String String) -> Bool
ownHas o k (Cons (MkPair o2 k2) rest) =
  strEq o o2 && (strEq k k2 || ownHas o k rest)
ownHas o k Nil = False

-- (`k`, the owner's, once)
ownAdd : String
       -> String
       -> List (Pair String String)
       -> List (Pair String String)
ownAdd o k ps = if ownHas o k ps then ps else Cons (MkPair o k) ps

-- | a record's labels, in the order it is written in, as a static array
shapeLit : List String -> C String
shapeLit ls = \s ->
    MkPair
      ("shape_" ^ shapeKey ls)
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = ownAdd s.owner (shapeKey ls) s.shapes
      , prims = s.prims
      }

-- | a primitive, as a value: a closure of it
primLit : String -> C String
primLit p = \s ->
    MkPair
      ("((V)&prim_" ^ p ^ "_clo)")
      { owner = s.owner
      , nlam = s.nlam
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = ownAdd s.owner p s.prims
      }

newLam : C String
newLam = \s ->
    MkPair
      (s.owner ^ "_lam" ^ show s.nlam)
      { owner = s.owner
      , nlam = s.nlam + 1
      , lams = s.lams
      , protos = s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

addLam : String -> String -> C Unit
addLam proto def = \s ->
    MkPair
      MkUnit
      { owner = s.owner
      , nlam = s.nlam
      , lams = Cons (MkPair s.owner def) s.lams
      , protos = Cons (MkPair s.owner proto) s.protos
      , nstr = s.nstr
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

-- Expressions
--------------------------------------------------------------------------------

-- | the printer's judgments, knotted: an expression, statements; and
-- | the C type of each variable (heff.compile.repr's)
type CK =
  { exp : RefCount.Value -> C String
  , stmts : List RefCount.Statement -> C (List String)
  , ctype : String -> String
  }

-- Unboxed numbers (#39): each fixed-width type its C type, `Float64` a
-- `double`, by a suffix in the runtime's names (`heff_box_i64`)
--------------------------------------------------------------------------------

fixedSuffix : Fixed.Fixed -> String
fixedSuffix w =
  if Fixed.isFloat32 w then "f32"
  else (if Fixed.fixedSigned w then "i" else "u") ^ show (Fixed.fixedBits w)

reprSuffix : Repr.Repr -> String
reprSuffix (RepFix w) = fixedSuffix w
reprSuffix RepF64 = "f64"
reprSuffix RepV = "v"

fixedType : Fixed.Fixed -> String
fixedType w =
  if Fixed.isFloat32 w then "float"
  else (if Fixed.fixedSigned w then "int" else "uint")
    ^ show (Fixed.fixedBits w)
    ^ "_t"

-- | how C declares a variable kept so
cType : Repr.Repr -> String
cType (RepFix w) = fixedType w
cType RepF64 = "double"
cType RepV = "V"

-- (an integer of the type, a C constant: its value modulo 2^64, as an
-- unsigned constant, made the type)
fixedConst : Fixed.Fixed -> Int -> String
fixedConst w n =
  if n < 0 then "((" ^ fixedType w ^ ")-" ^ show (0 - n) ^ "ULL)"
  else "((" ^ fixedType w ^ ")" ^ show n ^ "ULL)"

-- (a double, a C constant)
doubleConst : Float64 -> String
doubleConst x =
  if strEq (show x) "NaN" then "NAN"
  else if strEq (show x) "Infinity" then "INFINITY"
  else if strEq (show x) "-Infinity" then "(-INFINITY)"
  else "(" ^ show x ^ ")"

-- (a C operator, of a primitive done as one)
opSymbol : Fixed.FixedOp -> String
opSymbol OpAdd = "+"
opSymbol OpSub = "-"
opSymbol OpMul = "*"
opSymbol OpDiv = "/"
opSymbol OpAnd = "&"
opSymbol OpOr = "|"
opSymbol OpXor = "^"
opSymbol OpEq = "=="
opSymbol OpLt = "<"
opSymbol OpLe = "<="
opSymbol o = ""

-- (`Float64`'s primitives done as C's operators, and as libm's functions)
floatSymbols : List (Pair String String)
floatSymbols =
  [ MkPair "floatAdd" "+"
  , MkPair "floatSub" "-"
  , MkPair "floatMul" "*"
  , MkPair "floatDiv" "/"
  , MkPair "floatEq" "=="
  , MkPair "floatLt" "<"
  , MkPair "floatLe" "<="
  ]

floatSymbol : String -> String
floatSymbol p = fromMaybe "" (List.lookupBy strEq p floatSymbols)

libmNames : List (Pair String String)
libmNames =
  [ MkPair "floatSqrt" "sqrt"
  , MkPair "floatSin" "sin"
  , MkPair "floatCos" "cos"
  , MkPair "floatTan" "tan"
  , MkPair "floatAsin" "asin"
  , MkPair "floatAcos" "acos"
  , MkPair "floatAtan" "atan"
  , MkPair "floatExp" "exp"
  , MkPair "floatLog" "log"
  , MkPair "floatAtan2" "atan2"
  , MkPair "floatPow" "pow"
  , MkPair "floatFromInt" "heff_from_int_f64"
  , MkPair "floatFloor" "heff_floor_f64"
  ]

arg0 : List String -> String
arg0 vs = fromMaybe "0" (List.head vs)

arg1 : List String -> String
arg1 vs = fromMaybe "0" (List.head (List.drop 1 vs))

infixC : String -> List String -> String
infixC op vs = "(" ^ arg0 vs ^ " " ^ op ^ " " ^ arg1 vs ^ ")"

callOf : String -> List String -> String
callOf f vs = f ^ "(" ^ joinWith ", " vs ^ ")"

-- (`a op b` on 64 bits, unsigned, where no overflow is undefined,
-- wrapped to the type)
wrapped : Fixed.Fixed -> String -> List String -> String
wrapped w op vs =
  "(("
  ^ fixedType w
  ^ ")((uint64_t)"
  ^ arg0 vs
  ^ " "
  ^ op
  ^ " (uint64_t)"
  ^ arg1 vs
  ^ "))"

-- (an integer type's operation: on 64 bits, unsigned (where no overflow
-- is undefined), wrapped to the type; a division, a shift, the
-- runtime's, as its primitives do them)
intU : Fixed.Fixed -> Fixed.FixedOp -> List String -> String
intU w OpAdd vs = wrapped w "+" vs
intU w OpSub vs = wrapped w "-" vs
intU w OpMul vs = wrapped w "*" vs
intU w OpDiv vs = callOf ("heff_div_" ^ fixedSuffix w) vs
intU w OpRem vs = callOf ("heff_rem_" ^ fixedSuffix w) vs
intU w OpShl vs = callOf ("heff_shl_" ^ fixedSuffix w) vs
intU w OpShr vs = callOf ("heff_shr_" ^ fixedSuffix w) vs
intU w OpFromInt vs = callOf ("heff_from_int_" ^ fixedSuffix w) vs
intU w OpToInt vs = callOf ("heff_box_" ^ fixedSuffix w) vs
intU w op vs = "((" ^ fixedType w ^ ")" ^ infixC (opSymbol op) vs ^ ")"

-- | ... of a `Float32`
float32U : Fixed.FixedOp -> List String -> String
float32U OpSqrt vs = callOf "sqrtf" vs
float32U OpFromFloat vs = "((float)" ^ arg0 vs ^ ")"
float32U OpToFloat vs = "((double)" ^ arg0 vs ^ ")"
float32U OpFromInt vs = callOf "heff_from_int_f32" vs
float32U OpFloor vs = callOf "heff_floor_f32" vs
float32U op vs = "((float)" ^ infixC (opSymbol op) vs ^ ")"

isRelOp : Fixed.FixedOp -> Bool
isRelOp OpEq = True
isRelOp OpLt = True
isRelOp OpLe = True
isRelOp o = False

fixedU : Fixed.FixedPrim -> List String -> String
fixedU fp vs =
  if isRelOp fp.op then "heff_bool(" ^ infixC (opSymbol fp.op) vs ^ ")"
  else if Fixed.isFloat32 fp.fixed then float32U fp.op vs
  else intU fp.fixed fp.op vs

-- | ... of a `Float64`: C's operator, or libm's function
float64U : String -> List String -> String
float64U p vs =
  if strEq p "floatEq" || strEq p "floatLt" || strEq p "floatLe"
    then "heff_bool(" ^ infixC (floatSymbol p) vs ^ ")"
  else if strLength (floatSymbol p) > 0 then infixC (floatSymbol p) vs
  else callOf (fromMaybe p (List.lookupBy strEq p libmNames)) vs

primUOf : String -> Maybe Fixed.FixedPrim -> List String -> String
primUOf p (Just fp) vs = fixedU fp vs
primUOf p Nothing vs = float64U p vs

-- | a primitive done on unboxed operands (heff.compile.repr's `primShape`)
primU : String -> List String -> String
primU p vs = primUOf p (Fixed.fixedPrimOf p) vs

relSymbol : String -> Maybe Fixed.FixedPrim -> String
relSymbol p (Just fp) = opSymbol fp.op
relSymbol p Nothing = floatSymbol p

-- | a comparison of unboxed operands, as C's condition
relU : String -> List String -> String
relU p vs = infixC (relSymbol p (Fixed.fixedPrimOf p)) vs

argsArr : List String -> String
argsArr vs = if List.null vs then "NULL" else "(V[]){" ^ joinWith ", " vs ^ "}"

-- (an integer the runtime keeps in a word, from -2^62 up to 2^62, or one
-- it cannot)
intLit : Int -> String
intLit n =
  if n < 4611686018427387904 && n >= (0 - 4611686018427387904)
    then "MK_INT(" ^ show n ^ "LL)"
  else "HEFF_BIG(\"" ^ show n ^ "\")"

floatLit : Float64 -> String
floatLit x =
  if strEq (show x) "NaN" then "heff_flt(NAN)"
  else if strEq (show x) "Infinity" then "heff_flt(INFINITY)"
  else if strEq (show x) "-Infinity" then "heff_flt(-INFINITY)"
  else "heff_flt(" ^ show x ^ ")"

-- (a fixed-width integer: of 64 bits, kept as an `Int` is; of fewer, in a
-- word)
fixedLit : Fixed.Fixed -> Int -> String
fixedLit w n =
  if Fixed.fixedBits w == 64 then intLit n else "MK_INT(" ^ show n ^ "LL)"

primName : String -> String
primName p = "heff_" ^ p

-- (a drop, as what is dropped is known to be: a tag given back as one
-- (`heff_drop_tag`), not looked at by `heff_drop`; a cell kept and not
-- built in, freed (`heff_drop_cell`); so are a record (`heff_drop_rec`)
-- and a closure (`heff_drop_clo`) of known size)
dropAs : String -> RefCount.Known -> String
dropAs x (KnownTag n) = "heff_drop_tag(" ^ cLocal x ^ ", " ^ show n ^ ");"
dropAs x (KnownCell n) = "heff_drop_cell(" ^ cLocal x ^ ", " ^ show n ^ ");"
dropAs x (KnownRec n) = "heff_drop_rec(" ^ cLocal x ^ ", " ^ show n ^ ");"
dropAs x (KnownClo n) = "heff_drop_clo(" ^ cLocal x ^ ", " ^ show n ^ ");"

dropLine : RefCount.Drop -> String
dropLine (MkDrop x Nothing) = "heff_drop(" ^ cLocal x ^ ");"
dropLine (MkDrop x (Just k)) = dropAs x k

-- (a call's operand, bound before the call where it is not plain: `a_i`;
-- a value lent, `b_i`, dropped after it)
type Bound = { arg : String, pre : List String, post : List String }

boundAs : Int -> String -> List String -> Bound
boundAs i v post =
  { arg = "a_" ^ show i
  , pre = Cons ("V a_" ^ show i ^ " = " ^ v ^ ";") Nil
  , post = post
  }

argC : CK -> Int -> RefCount.Operand -> C Bound
argC k i (Given e) = do
  v <- k.exp e
  pure (boundAs i v Nil)
argC k i (GivenU r e) = do
  v <- k.exp e
  pure
      { arg = "a_" ^ show i
      , pre = Cons (cType r ^ " a_" ^ show i ^ " = " ^ v ^ ";") Nil
      , post = Nil
      }
argC k i (LentVar x drops) =
  pure (boundAs i (cLocal x) (List.map dropLine drops))
argC k i (LentValue e) = do
  v <- k.exp e
  pure
      { arg = "b_" ^ show i
      , pre = Cons ("V b_" ^ show i ^ " = " ^ v ^ ";") Nil
      , post = Cons ("heff_drop(b_" ^ show i ^ ");") Nil
      }

-- | the C function a known call calls: the function's, or its worker
-- | (`g_K_w`, #39)
calleeName : String -> Bool -> String
calleeName g True = cGlobal g ^ "_w"
calleeName g False = cGlobal g

isWorkerCall : Maybe Repr.Repr -> Bool
isWorkerCall (Just _) = True
isWorkerCall Nothing = False

-- (what a known call gives: its worker's repr, else a `V`)
givenOf : Maybe Repr.Repr -> Repr.Repr
givenOf (Just r) = r
givenOf Nothing = RepV

callHead : String -> Bool -> Maybe Repr.Repr -> String
callHead g tr w =
  (if tr then "heff_tr(" else "(") ^ calleeName g (isWorkerCall w) ^ "("

-- (a call with any lent: every operand computed before the call in its
-- order, since a lent one computed first would run before the operands
-- left of it, which may still want what it consumes; the lent dropped
-- after)
callBound : String -> Bool -> Maybe Repr.Repr -> List Bound -> String
callBound g tr w bs =
  "({ "
  ^ joinWith " " (List.concatMap (\(b : Bound) -> b.pre) bs)
  ^ " "
  ^ cType (givenOf w)
  ^ " r_ = "
  ^ callHead g tr w
  ^ joinWith ", " (List.map (\(b : Bound) -> b.arg) bs)
  ^ ")); "
  ^ joinWith " " (List.concatMap (\(b : Bound) -> b.post) bs)
  ^ " r_; })"

callLent : CK
         -> String
         -> Bool
         -> Maybe Repr.Repr
         -> List RefCount.Operand
         -> C String
callLent k g tr w args = do
  bs <-
    traverseC
      (\p -> argC k (snd p) (fst p))
      (List.zipWith
         (\a i -> MkPair a i)
         args
         (List.range 0 (List.length args - 1)))
  pure (callBound g tr w bs)

-- | a call of `g` (its worker, if `w`), through any bounces if `tr`
callC : CK
      -> String
      -> Bool
      -> Maybe Repr.Repr
      -> List RefCount.Operand
      -> C String
callC k g tr w args =
  if RefCount.lentPlain args
    then bind
        (traverseC k.exp (List.map RefCount.argExp args))
        (\vs -> pure (callHead g tr w ^ joinWith ", " vs ^ "))"))
  else callLent k g tr w args

-- (the closure given up where the body starts, what it holds taken: a
-- closure holding nothing is static, nothing to give back)
selfTake : List String -> List String
selfTake fv =
  if List.null fv then Nil
  else Cons ("  heff_clo_take(self, " ^ show (List.length fv) ^ ");") Nil

lamLines : String -> List String -> List String -> List String -> List String
lamLines k xs fv body =
  List.append
    (Cons ("static V " ^ k ^ "(V self, V *args) {") Nil)
    (List.append
       (List.zipWith
          (\x i -> "  V " ^ cLocal x ^ " = args[" ^ show i ^ "];")
          xs
          (List.range 0 (List.length xs - 1)))
       (List.append
          (List.zipWith
             (\x i -> "  V " ^ cLocal x ^ " = heff_env(self)[" ^ show i ^ "];")
             fv
             (List.range 0 (List.length fv - 1)))
          (List.append
             (selfTake fv)
             (List.append (List.map (\l -> "  " ^ l) body) (Cons "}" Nil)))))

-- (a lambda's closure: made with what it holds, or, holding nothing, one
-- of its own, static and immortal -- made once, not at each use)
lamProto : String -> Int -> List String -> String
lamProto k n fv =
  if List.null fv
    then "static V "
      ^ k
      ^ "(V self, V *args); static Clo "
      ^ k
      ^ "_clo = {{0x80000000u, K_CLO, 0}, "
      ^ k
      ^ ", "
      ^ show n
      ^ ", 0};"
  else "static V " ^ k ^ "(V self, V *args);"

-- | a lambda: a C function of its own (`lam_N`), numbered before the
-- | lambdas in its body
lamC : CK
     -> List String
     -> List String
     -> List RefCount.Value
     -> List RefCount.Statement
     -> C String
lamC k xs fv held body = do
  name <- newLam
  ls <- k.stmts body
  u <-
    addLam
      (lamProto name (List.length xs) fv)
      (joinWith "\n" (lamLines name xs fv ls))
  vs <- traverseC k.exp held
  pure
      (if List.null fv then "((V)&" ^ name ^ "_clo)"
       else "heff_clo_n("
         ^ name
         ^ ", "
         ^ show (List.length xs)
         ^ ", "
         ^ show (List.length fv)
         ^ ", "
         ^ argsArr vs
         ^ ")")

-- (a record built in `x`'s cell (`heff_rec_reuse_nf`, lib/c/runtime.c;
-- `heff_rec_reuse_na`, `suffix` "a", where those stored anew are flat in
-- every record of its shape): the fields not kept computed first, `vs`
-- at their places `changed`, then stored in it; `flats`, the bits of its
-- flat fields kept and of those stored, as rc says them)
updateText : String
           -> String
           -> String
           -> Int
           -> String
           -> Int
           -> List String
           -> List Int
           -> String
updateText suffix x shape keep flats n vs changed =
  "({ "
  ^ joinWith
    ""
    (List.zipWith (\v i -> "V rv_" ^ show i ^ " = " ^ v ^ "; ") vs changed)
  ^ "V rr_ = heff_rec_reuse_n"
  ^ suffix
  ^ "("
  ^ cLocal x
  ^ ", "
  ^ show keep
  ^ "ULL, "
  ^ show n
  ^ ", "
  ^ shape
  ^ ", "
  ^ flats
  ^ "); "
  ^ joinWith
    ""
    (List.map
       (\i -> "heff_rfield(rr_, " ^ show i ^ ") = rv_" ^ show i ^ "; ")
       changed)
  ^ "rr_; })"

-- Lent strings
--------------------------------------------------------------------------------

-- | the primitives that only read their strings, each with a `_lent`
-- | form in lib/c/runtime.c: given a mask of the operands given it, the
-- | others lent
lendingPrims : List String
lendingPrims =
  [ "strLength"
  , "strSlice"
  , "strEq"
  , "strLt"
  , "strCompare"
  , "strFind"
  , "strByteAt"
  , "strRuneAt"
  , "strRuneWidth"
  ]

-- (an operand that takes nothing another is given: a variable, a
-- reference taken of one, a literal)
plainOperand : RefCount.Value -> Bool
plainOperand (RLocal _) = True
plainOperand (RDup _) = True
plainOperand (RInt _) = True
plainOperand (RStr _) = True
plainOperand (RNTag _) = True
plainOperand _ = False

givesUp : String -> RefCount.Value -> Bool
givesUp x (RLocal y) = strEq x y
givesUp x _ = False

-- (an operand lent: a reference taken of a variable, which the variable
-- holds through the call, as no operand gives it up)
lentOperand : List RefCount.Value -> RefCount.Value -> Bool
lentOperand es (RDup x) = not (List.any (givesUp x) es)
lentOperand es _ = False

-- | whether a primitive's call lends an operand: one of `lendingPrims`,
-- | its operands plain (none computed, which might give up what is lent
-- | before it is read), one of them lent
lends : String -> List RefCount.Value -> Bool
lends p es =
  elemS p lendingPrims
  && List.all plainOperand es
  && List.any (lentOperand es) es

-- (the mask of the operands given, from the one of `bit` on)
givenMask : List RefCount.Value -> List RefCount.Value -> Int -> Int
givenMask es Nil bit = 0
givenMask es (Cons e rest) bit =
  (if lentOperand es e then 0 else bit) + givenMask es rest (bit * 2)

-- (an operand as the `_lent` form takes it: lent, the variable itself)
asLent : List RefCount.Value -> RefCount.Value -> RefCount.Value
asLent es (RDup x) = if lentOperand es (RDup x) then RLocal x else RDup x
asLent es e = e

-- | a call of a primitive's `_lent` form (`suffix` after its name: `_c`
-- | for a condition's)
lentPrimC : CK -> String -> String -> List RefCount.Value -> C String
lentPrimC k p suffix es = do
  vs <- traverseC k.exp (List.map (asLent es) es)
  pure
      (primName p
       ^ suffix
       ^ "_lent("
       ^ joinWith ", " vs
       ^ ", "
       ^ show (givenMask es es 1)
       ^ ")")

-- | a condition, as C's (an `int`): a comparison, the runtime's of it
-- | (`heff_intLt_c`); a test of tests, `&&`, `||` or `?:`; a name bound
-- | in it, dropped once it is decided
testC : CK -> RefCount.Test -> C String
testC k CondTrue = pure "1"
testC k CondFalse = pure "0"
testC k (CondRel p es) =
  if lends p es then lentPrimC k p "_c" es
  else bind
      (traverseC k.exp es)
      (\vs -> pure (primName p ^ "_c(" ^ joinWith ", " vs ^ ")"))
testC k (CondRelU p es) = bind (traverseC k.exp es) (\vs -> pure (relU p vs))
testC k (CondBool e) =
  bind (k.exp e) (\v -> pure ("(" ^ v ^ " == NTAG(TAG_True))"))
testC k (CondNot c) = bind (testC k c) (\v -> pure ("!" ^ v))
testC k (CondIf a b CondFalse) = do
  va <- testC k a
  vb <- testC k b
  pure ("(" ^ va ^ " && " ^ vb ^ ")")
testC k (CondIf a CondTrue c) = do
  va <- testC k a
  vc <- testC k c
  pure ("(" ^ va ^ " || " ^ vc ^ ")")
testC k (CondIf a b c) = do
  va <- testC k a
  vb <- testC k b
  vc <- testC k c
  pure ("(" ^ va ^ " ? " ^ vb ^ " : " ^ vc ^ ")")
testC k (CondLet x e c drops) = do
  v <- k.exp e
  vc <- testC k c
  pure
      ("({ "
       ^ k.ctype x
       ^ " "
       ^ cLocal x
       ^ " = "
       ^ v
       ^ "; int c_ = "
       ^ vc
       ^ "; "
       ^ joinWith "" (List.map (\d -> dropLine d ^ " ") drops)
       ^ "c_; })")

-- (an operator of one operand: its name, then the operand's, closed)
wrapC : CK -> String -> String -> RefCount.Value -> C String
wrapC k pre post e = bind (k.exp e) (\v -> pure (pre ^ v ^ post))

expF : CK -> RefCount.Value -> C String
expF k (RLocal x) = pure (cLocal x)
expF k (RDup x) = pure ("heff_dup(" ^ cLocal x ^ ")")
expF k (RClo g) = pure ("((V)&" ^ cGlobal g ^ "_clo)")
expF k (RGet g) = pure ("heff_dup(" ^ cGlobal g ^ "_get())")
expF k (RGetRaw g) = pure (cGlobal g ^ "_get()")
expF k (RInt n) = pure (intLit n)
expF k (RFloat x) = pure (floatLit x)
expF k (RStr s) = strLit "HEFF_LIT" s
expF k (RBytes s) = strLit "HEFF_BYTES" s
expF k (RFixed w n) = pure (fixedLit w n)
expF k (RF32 x) = pure ("heff_f32((float)" ^ show x ^ ")")
expF k (RNTag t) = pure ("NTAG(" ^ tagName t ^ ")")
expF k (RTag t flat es) = do
  vs <- traverseC k.exp es
  pure
      ((if flat == 0 then "heff_tag_n(" else "heff_tag_nf(")
       ^ tagName t
       ^ ", "
       ^ show (List.length es)
       ^ (if flat == 0 then ", " else ", " ^ show flat ^ "u, ")
       ^ argsArr vs
       ^ ")")
expF k (RTagIn ru t flat es) = do
  vs <- traverseC k.exp (Cons ru es)
  pure
      ((if flat == 0 then "heff_tag_at_n(" else "heff_tag_at_nf(")
       ^ fromMaybe "0" (List.head vs)
       ^ ", "
       ^ tagName t
       ^ ", "
       ^ show (List.length es)
       ^ (if flat == 0 then ", " else ", " ^ show flat ^ "u, ")
       ^ argsArr (List.drop 1 vs)
       ^ ")")
expF k (RRec ls flat es) = do
  vs <- traverseC k.exp es
  shape <- shapeLit ls
  pure
      ((if flat == 0 then "heff_rec_n(" else "heff_rec_nf(")
       ^ show (List.length ls)
       ^ ", "
       ^ shape
       ^ (if flat == 0 then ", " else ", " ^ show flat ^ "u, ")
       ^ argsArr vs
       ^ ")")
expF k (RRecIn x keep kept flat n ls changed su) = do
  vs <- traverseC k.exp (List.map snd changed)
  shape <- shapeLit ls
  pure
      (updateText
         (if su then "a" else "f")
         x
         shape
         keep
         (show kept ^ "u, " ^ show flat ^ "u")
         n
         vs
         (List.map fst changed))
expF k (RField e i) = wrapC k "heff_rfield(" (", " ^ show i ^ ")") e
expF k (RDupE e) = wrapC k "heff_dup(" ")" e
expF k (RFieldV e i) = wrapC k "heff_rget_v(" (", " ^ show i ^ ")") e
expF k (RGetN e i n) =
  wrapC k "heff_get_n(" (", " ^ show i ^ ", " ^ show n ^ ")") e
expF k (RFieldU r su e i) =
  wrapC
    k
    ((if su then "heff_rflat_" else "heff_rget_") ^ reprSuffix r ^ "(")
    (", " ^ show i ^ ")")
    e
expF k (RGetNU r su e i n) =
  wrapC
    k
    ((if su then "heff_get_nflat_" else "heff_get_n_") ^ reprSuffix r ^ "(")
    (", " ^ show i ^ ", " ^ show n ^ ")")
    e
expF k (RWord r e) = wrapC k ("heff_word_" ^ reprSuffix r ^ "(") ")" e
expF k (RTakeField x i) =
  pure ("heff_take_field(" ^ cLocal x ^ ", " ^ show i ^ ")")
expF k (RGetLabel e l) = wrapC k "heff_get(" (", " ^ lblName l ^ ")") e
expF k (RPrimFn p) = primLit p
expF k (RPrim p es) =
  if lends p es then lentPrimC k p "" es
  else bind
      (traverseC k.exp es)
      (\vs -> pure (primName p ^ "(" ^ joinWith ", " vs ^ ")"))
expF k (RLam xs fv held (MkCode body)) = lamC k xs fv held body
expF k (RCall g tr w args) = callC k g tr w args
expF k (RApply f es) = do
  vs <- traverseC k.exp (Cons f es)
  pure
      ("heff_tr(heff_call("
       ^ fromMaybe "0" (List.head vs)
       ^ ", "
       ^ show (List.length es)
       ^ ", "
       ^ argsArr (List.drop 1 vs)
       ^ "))")
expF k (RBool c) = bind (testC k c) (\v -> pure ("heff_bool(" ^ v ^ ")"))
expF k RAbandon = pure "heff_abandon()"
expF k (RBox r e) = wrapC k ("heff_box_" ^ reprSuffix r ^ "(") ")" e
expF k (RUnbox r e) = wrapC k ("heff_unbox_" ^ reprSuffix r ^ "(") ")" e
expF k (RPeek r e) = wrapC k ("heff_peek_" ^ reprSuffix r ^ "(") ")" e
expF k (RPrimU p es) = bind (traverseC k.exp es) (\vs -> pure (primU p vs))
expF k (RFixU w n) = pure (fixedConst w n)
expF k (RF32U x) = pure ("((float)" ^ doubleConst x ^ ")")
expF k (RF64U x) = pure (doubleConst x)

-- Statements
--------------------------------------------------------------------------------

indented : List String -> List String
indented ls = List.map (\l -> "  " ^ l) ls

-- (the loop again: the arguments, then the parameters -- each as its
-- parameter is kept, `ts`)
again : List String -> List String -> List String -> List String
again ts ps vs =
  List.append
    (List.zipWith
       (\tv i -> fst tv ^ " t_" ^ show i ^ " = " ^ snd tv ^ ";")
       (List.zip ts vs)
       (List.range 0 (List.length vs - 1)))
    (List.append
       (List.zipWith
          (\p i -> cLocal p ^ " = t_" ^ show i ^ ";")
          ps
          (List.range 0 (List.length vs - 1)))
       (Cons "goto top;" Nil))

-- (a call last of an unknown function, from a lambda taking at least as
-- many arguments: the function, then its arguments, put where the
-- lambda's were -- read already, and its caller's, neither its own frame
-- nor its closure, which `heff_clo_take` may have freed -- and a
-- closure taking exactly those called by a jump (`heff_exact`,
-- `HEFF_LAST`), its C function's type the lambda's (`Fn`).  Anything
-- else, as any call last of an unknown function: `heff_tail`, counted)
inPlace : List String -> List String
inPlace vs =
  List.append
    (Cons ("V f_ = " ^ fromMaybe "0" (List.head vs) ^ ";") Nil)
    (List.append
       (List.zipWith
          (\v i -> "args[" ^ show i ^ "] = " ^ v ^ ";")
          (List.drop 1 vs)
          (List.range 0 (List.length vs - 2)))
       [ "if (heff_exact(f_, "
       ^ show (List.length vs - 1)
       ^ ", args)) HEFF_LAST return ((Clo *)f_)->fn(f_, args);"
       , "return heff_tail(f_, " ^ show (List.length vs - 1) ^ ", args);"
       ])

-- (a call last of an unknown function, from a lambda taking fewer
-- arguments, of no more than fit in `heff_room`: the arguments put there,
-- and a closure taking exactly those called by a jump, given them there
-- -- they are read at once by what is called, before anything else is,
-- so a call made from there that puts its own there is after they are
-- read.  Anything else, as any call last of an unknown function: given
-- them where the lambda is, by `heff_tail`, counted)
roomed : List String -> List String
roomed vs =
  List.append
    (Cons ("V f_ = " ^ fromMaybe "0" (List.head vs) ^ ";") Nil)
    (List.append
       (List.zipWith
          (\v i -> "heff_room[" ^ show i ^ "] = " ^ v ^ ";")
          (List.drop 1 vs)
          (List.range 0 (List.length vs - 2)))
       [ "if (heff_exact(f_, "
       ^ show (List.length vs - 1)
       ^ ", heff_room)) HEFF_LAST return ((Clo *)f_)->fn(f_, heff_room);"
       , "return heff_tail(f_, "
       ^ show (List.length vs - 1)
       ^ ", (V[]){"
       ^ joinWith
         ", "
         (List.map
            (\i -> "heff_room[" ^ show i ^ "]")
            (List.range 0 (List.length vs - 2)))
       ^ "});"
       ])

-- (a field the arm wants: its own reference, or, the scrutinee given
-- up or lent, the scrutinee's, taken over or lent)
fieldLine : String -> Bool -> Pair String Int -> String
fieldLine sv plain (MkPair v i) =
  "  V "
  ^ cLocal v
  ^ " = "
  ^ (if plain then "heff_field(" ^ sv ^ ", " ^ show i ^ ")"
     else "heff_dup(heff_field(" ^ sv ^ ", " ^ show i ^ "))")
  ^ ";"

-- (a field that may be flat (#64), read as its variable is kept: a
-- number, flat or not, or -- flat in every tag of it (`sure`) -- as it
-- is; a `V` of its own, boxed if it is flat)
flatLine : CK
         -> String
         -> List Int
         -> Pair String (Pair Int Repr.Repr)
         -> String
flatLine k sv sure (MkPair v (MkPair i r)) =
  "  "
  ^ k.ctype v
  ^ " "
  ^ cLocal v
  ^ (if List.any (\j -> j == i) sure && not (Repr.isBoxed r)
       then " = heff_tflat_"
     else " = heff_tget_")
  ^ reprSuffix r
  ^ "("
  ^ sv
  ^ ", "
  ^ show i
  ^ ");"

-- (... of a tag that may have flat fields (#64), which look; whose fields
-- given up are all flat, which drop none)
flatSuffix : RefCount.Flatness -> String
flatSuffix FlatNone = ""
flatSuffix FlatSome = "f"
flatSuffix FlatAll = "a"

-- (the scrutinee given up at once (`heff_take_n`): its shell freed and
-- the fields not wanted dropped; or its cell kept (`heff_take_reuse_n`))
takeLines : String -> RefCount.Take -> List String
takeLines sv TakeNone = Nil
takeLines sv (TakeN fl mask n) =
  Cons
    ("heff_take_n"
     ^ flatSuffix fl
     ^ "("
     ^ sv
     ^ ", "
     ^ show mask
     ^ "ULL, "
     ^ show n
     ^ ");")
    Nil
takeLines sv (TakeKeep fl ru mask n) =
  Cons
    ("V "
     ^ cLocal ru
     ^ " = heff_take_reuse_n"
     ^ flatSuffix fl
     ^ "("
     ^ sv
     ^ ", "
     ^ show mask
     ^ "ULL, "
     ^ show n
     ^ ");")
    Nil

armF : CK -> String -> RefCount.CaseArm -> C (List String)
armF k sv (MkCArm t fields flats sure plain take body leaves) = do
  ls <- k.stmts body
  pure
      (List.append
         (Cons ("case " ^ tagName t ^ ": {") Nil)
         (List.append
            (List.append
               (List.map (fieldLine sv plain) fields)
               (List.map (flatLine k sv sure) flats))
            (List.append
               (indented (List.append (takeLines sv take) ls))
               (List.append
                  (if leaves then Cons "  break;" Nil else Nil)
                  (Cons "}" Nil)))))

nomatchLine : Bool -> String -> String
nomatchLine True sv = "default: return heff_nomatch(" ^ sv ^ ");"
nomatchLine False sv = "default: heff_nomatch(" ^ sv ^ ");"

-- (a statement of one line, of an expression)
lineC : CK -> String -> String -> RefCount.Value -> C (List String)
lineC k pre post e = bind (k.exp e) (\v -> pure (Cons (pre ^ v ^ post) Nil))

stmtF : CK -> RefCount.Statement -> C (List String)
stmtF k (CDrop d) = pure (Cons (dropLine d) Nil)
stmtF k (CLet x e) = lineC k (k.ctype x ^ " " ^ cLocal x ^ " = ") ";" e
stmtF k (CDecl x) = pure (Cons (k.ctype x ^ " " ^ cLocal x ^ ";") Nil)
stmtF k (CSet x e) = lineC k (cLocal x ^ " = ") ";" e
stmtF k CAbandon = pure (Cons "heff_abandon();" Nil)
stmtF k (CIf c yes no) = do
  v <- testC k c
  ys <- k.stmts yes
  ns <- k.stmts no
  pure
      (Cons
         ("if (" ^ v ^ ") {")
         (List.append
            (indented ys)
            (Cons "} else {" (List.append (indented ns) (Cons "}" Nil)))))
stmtF k (CSwitch e arms returns) = do
  sv <- k.exp e
  as <- traverseC (armF k sv) arms
  pure
      (List.append
         (Cons ("switch (heff_tag_of(" ^ sv ^ ")) {") Nil)
         (List.append
            (List.concatMap (\x -> x) as)
            (Cons (nomatchLine returns sv) (Cons "}" Nil))))
stmtF k (CReturn e) = lineC k "return " ";" e
stmtF k (CInPlace f es) =
  bind (traverseC k.exp (Cons f es)) (\vs -> pure (inPlace vs))
stmtF k (CRoomed f es) =
  bind (traverseC k.exp (Cons f es)) (\vs -> pure (roomed vs))
stmtF k (CTail f es) = do
  vs <- traverseC k.exp (Cons f es)
  pure
      (Cons
         ("return heff_tail("
          ^ fromMaybe "0" (List.head vs)
          ^ ", "
          ^ show (List.length es)
          ^ ", "
          ^ argsArr (List.drop 1 vs)
          ^ ");")
         Nil)
stmtF k (CLoop ps es) =
  bind (traverseC k.exp es) (\vs -> pure (again (List.map k.ctype ps) ps vs))
stmtF k (CJump g w es) = do
  vs <- traverseC k.exp es
  pure
      (Cons
         ("HEFF_LAST return " ^ calleeName g w ^ "(" ^ joinWith ", " vs ^ ");")
         Nil)

stmtsF : CK -> List RefCount.Statement -> C (List String)
stmtsF k ss =
  bind (traverseC (stmtF k) ss) (\ls -> pure (List.concatMap (\x -> x) ls))

-- | the printer, of a definition whose variables are kept as `rs` says
ckOf : Repr.Reprs -> CK
ckOf rs =
  { exp = \e -> expF (ckOf rs) e
  , stmts = \ss -> stmtsF (ckOf rs) ss
  , ctype = \x -> cType (Repr.reprOf rs x)
  }

-- Definitions
--------------------------------------------------------------------------------

-- (each parameter of its C type: a `V`, or unboxed, a worker's)
paramList : CK -> List String -> String
paramList k xs =
  if List.null xs then "void"
  else joinWith ", " (List.map (\x -> k.ctype x ^ " " ^ cLocal x) xs)

-- | a definition's prototypes, and its code
type Emitted1 = { protos : List String, code : List String }

elemI : Int -> List Int -> Bool
elemI i Nil = False
elemI i (Cons j js) = i == j || elemI i js

-- (a closure's entry: the arguments given, those lent dropped after --
-- read before the call, as a lambda reads its own: they may be in
-- `heff_room`, which the call may put others in)
entryCall : String -> List Int -> Int -> String
entryCall key bi n =
  if List.null bi
    then "  return "
      ^ cGlobal key
      ^ "("
      ^ joinWith
        ", "
        (List.map (\i -> "a[" ^ show i ^ "]") (List.range 0 (n - 1)))
      ^ ");"
  else "  "
    ^ joinWith
      " "
      (List.map (\i -> "V a" ^ show i ^ " = a[" ^ show i ^ "];") bi)
    ^ " V r = "
    ^ cGlobal key
    ^ "("
    ^ joinWith
      ", "
      (List.map
         (\i -> if elemI i bi then "a" ^ show i else "a[" ^ show i ^ "]")
         (List.range 0 (n - 1)))
    ^ "); "
    ^ joinWith " " (List.map (\i -> "heff_drop(a" ^ show i ^ ");") bi)
    ^ " return r;"

hasWrapper : Maybe RefCount.Wrapper -> Bool
hasWrapper (Just _) = True
hasWrapper Nothing = False

-- (a function's C function's head: the function's, or its worker's)
funHead : String -> List String -> Repr.Reprs -> Repr.Repr -> Bool -> String
funHead key xs rs ret w =
  "static "
  ^ cType ret
  ^ " "
  ^ calleeName key w
  ^ "("
  ^ paramList (ckOf rs) xs
  ^ ")"

-- (a function with a worker: its wrapper, of `V`s, a function of the
-- function's own name -- what its closure's entry calls)
wrapperProto : String -> Repr.Reprs -> Maybe RefCount.Wrapper -> List String
wrapperProto key rs (Just (MkWrapper ws _)) =
  Cons ("static V " ^ cGlobal key ^ "(" ^ paramList (ckOf rs) ws ^ ");") Nil
wrapperProto key rs Nothing = Nil

wrapperCode : String -> Repr.Reprs -> Maybe RefCount.Wrapper -> C (List String)
wrapperCode key rs (Just (MkWrapper ws body)) = do
  ls <- (ckOf rs).stmts body
  pure
      (Cons
         ("static V " ^ cGlobal key ^ "(" ^ paramList (ckOf rs) ws ^ ") {")
         (List.append (indented ls) (Cons "}" Nil)))
wrapperCode key rs Nothing = pure Nil

funDef : RefCount.Fun -> C Emitted1
funDef f = do
  es <- (ckOf f.reprs).stmts f.entry
  ls <- (ckOf f.reprs).stmts f.body
  wl <- wrapperCode f.key f.reprs f.wrapper
  pure
      { protos =
          Cons
            (funHead f.key f.params f.reprs f.ret (hasWrapper f.wrapper) ^ ";")
            (List.append
               (wrapperProto f.key f.reprs f.wrapper)
               [ "static V " ^ cGlobal f.key ^ "_entry(V self, V *a);"
               , "static Clo "
               ^ cGlobal f.key
               ^ "_clo = {{0x80000000u, K_CLO, 0}, "
               ^ cGlobal f.key
               ^ "_entry, "
               ^ show (List.length f.params)
               ^ ", 0};"
               ])
      , code =
          List.append
            (Cons
               ""
               (Cons
                  (funHead f.key f.params f.reprs f.ret (hasWrapper f.wrapper)
                   ^ " {")
                  (List.append (indented es) (Cons "top: ;" Nil))))
            (List.append
               (indented ls)
               (Cons
                  "}"
                  (List.append
                     wl
                     [ "static V " ^ cGlobal f.key ^ "_entry(V self, V *a) {"
                     , "  (void)self;"
                     , entryCall f.key f.lent (List.length f.params)
                     , "}"
                     ])))
      }

valDef : String -> List RefCount.Statement -> Repr.Reprs -> C Emitted1
valDef key body rs = do
  ls <- (ckOf rs).stmts body
  pure
      { protos = Cons ("static V " ^ cGlobal key ^ "_get(void);") Nil
      , code =
          List.append
            [ ""
            , "static V " ^ cGlobal key ^ "_val;"
            , "static HEFF_ONCE " ^ cGlobal key ^ "_st;"
            , "static V " ^ cGlobal key ^ "_init(void) {"
            ]
            (List.append
               (indented ls)
               [ "}"
               , "static V " ^ cGlobal key ^ "_get(void) {"
               , "  if (HEFF_DONE("
               ^ cGlobal key
               ^ "_st)) return "
               ^ cGlobal key
               ^ "_val;"
               , "  return heff_global(&"
               ^ cGlobal key
               ^ "_val, &"
               ^ cGlobal key
               ^ "_st, "
               ^ cGlobal key
               ^ "_init);"
               , "}"
               ])
      }

defC : RefCount.Def -> C Emitted1
defC (DFun f) = funDef f
defC (DVal key body rs) = valDef key body rs

-- The world's algebra
--------------------------------------------------------------------------------

-- (each node of the effect's sum, a function handing an operation on:
-- `InL` to the left, `InR` to the right, a leaf to its provider)
-- (a sum: its left's nodes `la`, from `n + 1` to `na`, then its right's)
plusDone : Int
         -> List String
         -> Int
         -> Pair (List String) Int
         -> Pair (List String) Int
plusDone n la na (MkPair lb nb) =
  MkPair
    (List.append
       la
       (List.append
          lb
          [ "static V heff_perform_"
          ^ show n
          ^ "(V p, V k) { int l = heff_tag_of(p) == TAG_InL; V q = heff_dup(heff_field(p, 0)); heff_drop(p); return l ? heff_perform_"
          ^ show (n + 1)
          ^ "(q, k) : heff_perform_"
          ^ show na
          ^ "(q, k); }"
          ]))
    nb

plusNodes : (Effect.Effect -> Int -> Pair (List String) Int)
          -> Int
          -> Effect.Effect
          -> Pair (List String) Int
          -> Pair (List String) Int
plusNodes go n b (MkPair la na) = plusDone n la na (go b na)

performNodes : Effect.Effect -> Int -> Pair (List String) Int
performNodes (Leaf k) n =
  MkPair
    [ "static V heff_perform_"
    ^ show n
    ^ "(V p, V k) { return heff_provider_"
    ^ Effect.nameOfKey k
    ^ "(p, k); }"
    ]
    (n + 1)
performNodes (Plus a b) n = plusNodes performNodes n b (performNodes a (n + 1))

performCode : Effect.Effect -> List String
performCode eff =
  List.append
    (fst (performNodes eff 0))
    ["static V heff_perform(V p, V k) { return heff_perform_0(p, k); }"]

-- The program
--------------------------------------------------------------------------------

primCloDef : String -> List String
primCloDef p = case Prims.primArity p of
  Just n ->
    [ "static V prim_"
    ^ p
    ^ "_entry(V self, V *a) { (void)self; return "
    ^ primName p
    ^ "("
    ^ joinWith
      ", "
      (List.map (\i -> "a[" ^ show i ^ "]") (List.range 0 (n - 1)))
    ^ "); }"
    , "static Clo prim_"
    ^ p
    ^ "_clo = {{0x80000000u, K_CLO, 0}, prim_"
    ^ p
    ^ "_entry, "
    ^ show n
    ^ ", 0};"
    ]
  Nothing -> Nil

shapeDef : String -> String
shapeDef key =
  "static uint32_t shape_"
  ^ key
  ^ "[] = {"
  ^ joinWith
    ", "
    (List.map
       (\m -> "LBL_" ^ m)
       (List.filter (\m -> strLength m > 0) (split "__" key)))
  ^ "};"

-- (a definition emitted on its own: its lambdas and strings named from
-- it and counted from 0, its variables named again from 0 -- what it
-- emits does not depend on what was emitted before it, nor on the names
-- drawn for other definitions)
ownDef : String -> C Unit
ownDef o = \s ->
    MkPair
      MkUnit
      { owner = o
      , nlam = 0
      , lams = s.lams
      , protos = s.protos
      , nstr = 0
      , strs = s.strs
      , shapes = s.shapes
      , prims = s.prims
      }

defOwn : CE -> IR.Def -> C Emitted1
defOwn ce d = do
  u <- ownDef (cGlobal d.key)
  defC (Lower.cDef ce.facts d (IR.freshen 0 d.body))

defsC : CE -> List IR.Def -> C (List Emitted1)
defsC ce defs = traverseC (defOwn ce) defs

emptyCS : CS
emptyCS =
  { owner = ""
  , nlam = 0
  , lams = Nil
  , protos = Nil
  , nstr = 0
  , strs = Nil
  , shapes = Nil
  , prims = Nil
  }

-- (each once, the first kept, in order)
onceInOrder : Map.Map String Unit -> List String -> List String
onceInOrder seen Nil = Nil
onceInOrder seen (Cons x xs) =
  if Map.member compareString x seen then onceInOrder seen xs
  else Cons x (onceInOrder (Map.insert compareString x MkUnit seen) xs)

-- (what the owners use, each once, in the order first used)
usedOnce : List (Pair String String) -> List String
usedOnce ps = onceInOrder Map.empty (List.map snd (List.reverse ps))

-- | the names of what is numbered, each with its number (`heff_show`'s)
namesTable : String -> Map.Map String Int -> List String
namesTable name m =
  [ "static const HeffName "
  ^ name
  ^ "[] = {"
  ^ joinWith
    ", "
    (List.map
       (\p -> "{" ^ show (snd p) ^ ", \"" ^ fst p ^ "\"}")
       (Map.toList m))
  ^ (if Map.size m == 0 then "{0, NULL}" else "")
  ^ "};"
  ]

-- | how the program ends: its entry, run; or (`checkEnd`) each of the
-- | file's definitions, by its name, shown
type Ending = { prefix : List String, end : CE -> List String }

runEnd : Effect.Effect -> CE -> List String
runEnd eff ce =
  List.append
    (performCode eff)
    [ ""
    , "static V heff_entry(void) { return "
    ^ cGlobal Lower.entryKey
    ^ "_get(); }"
    , ""
    ]

-- (a definition's value, as a getter: a function's is its closure)
globalGet : CE -> Pair String String -> List String
globalGet ce (MkPair name key) =
  if Map.member compareString key ce.facts.arity
    then [ "static V gget_"
         ^ mangle key
         ^ "(void) { return (V)&"
         ^ cGlobal key
         ^ "_clo; }"
         ]
  else Nil

getterOf : CE -> String -> String
getterOf ce key =
  if Map.member compareString key ce.facts.arity then "gget_" ^ mangle key
  else cGlobal key ^ "_get"

definedIn : List IR.Def -> String -> Bool
definedIn defs key = List.any (\(d : IR.Def) -> strEq d.key key) defs

checkEnd : List (Pair String String) -> List IR.Def -> CE -> List String
checkEnd exports defs ce =
  List.append
    [ "static V heff_perform(V p, V k) { (void)p; (void)k; return heff_abandon(); }"
    ]
    (List.append
       (List.concatMap
          (globalGet ce)
          (List.filter (\p -> definedIn defs (snd p)) exports))
       (List.append
          (namesTable "heff_tag_names_arr" ce.tags)
          (List.append
             (namesTable "heff_lbl_names_arr" ce.lbls)
             [ "static const Global heff_globals_arr[] = {"
             ^ joinWith
               ", "
               (List.map
                  (\p -> "{\"" ^ fst p ^ "\", " ^ getterOf ce (snd p) ^ "}")
                  (List.filter (\p -> definedIn defs (snd p)) exports))
             ^ (if List.null
                  (List.filter (\p -> definedIn defs (snd p)) exports)
                  then "{NULL, NULL}"
                else "")
             ^ "};"
             , "static void heff_check_init(void) {"
             , "  heff_globals = heff_globals_arr;"
             , "  heff_nglobals = "
             ^ show
               (List.length
                  (List.filter (\p -> definedIn defs (snd p)) exports))
             ^ ";"
             , "  heff_tag_names = heff_tag_names_arr;"
             , "  heff_ntag_names = " ^ show (Map.size ce.tags) ^ ";"
             , "  heff_lbl_names = heff_lbl_names_arr;"
             , "  heff_nlbl_names = " ^ show (Map.size ce.lbls) ^ ";"
             , "}"
             , ""
             ])))

programCE : String
          -> List Emit.Provider
          -> Ending
          -> List IR.Def
          -> CE
          -> String
programCE runtime provs ending defs ce = case defsC ce defs emptyCS of
  MkPair ems s ->
    joinWith
      "\n"
      (List.append
         (Cons "// Generated from Hippogriff; do not edit." ending.prefix)
         (List.append
            (List.map
               (\p -> "#define " ^ tagName (fst p) ^ " " ^ show (snd p))
               (List.filter
                  (\p -> not (elemS (fst p) knownTags))
                  (Map.toList ce.tags)))
            (List.append
               (List.map
                  (\p -> "#define " ^ lblName (fst p) ^ " " ^ show (snd p))
                  (Map.toList ce.lbls))
               (List.append
                  (Cons runtime Nil)
                  (List.append
                     (List.map (\(p : Emit.Provider) -> p.text) provs)
                     (List.append
                        (Cons "static V heff_perform(V p, V k);" Nil)
                        (List.append
                           (List.map snd (List.reverse s.strs))
                           (List.append
                              (List.map shapeDef (usedOnce s.shapes))
                              (List.append
                                 (List.concatMap
                                    (\(e : Emitted1) -> e.protos)
                                    ems)
                                 (List.append
                                    (List.map snd (List.reverse s.protos))
                                    (List.append
                                       (List.concatMap
                                          primCloDef
                                          (usedOnce s.prims))
                                       (List.append
                                          (List.concatMap
                                             (\(e : Emitted1) -> e.code)
                                             ems)
                                          (List.append
                                             (List.map
                                                snd
                                                (List.reverse s.lams))
                                             (ending.end ce))))))))))))))

-- (each once, in order: through a map, not a list searched)
sortedOnce : List String -> List String
sortedOnce xs =
  List.map
    fst
    (Map.toList
       (List.foldl
          (\m x -> Map.insert compareString x (MkUnit : Unit) m)
          Map.empty
          xs))

-- (what the emitter knows of the whole program)
-- (the tags' fields flat in every tag of them the program builds, of the
-- tags only the program builds: not the runtime's (`knownTags`), nor
-- those a provider names -- either may build one, its fields `V`s)
builtOnlyHere : List String -> Repr.FlatTags -> Repr.FlatTags
builtOnlyHere others sure =
  Map.fromList
    compareString
    (List.filter (\p -> not (elemS (fst p) others)) (Map.toList sure))

-- (the shapes' fields flat in every record of them the program builds,
-- of the shapes no provider names a label of -- it may build one, its
-- fields `V`s)
shapesOnlyHere : List String -> Repr.FlatTags -> Repr.FlatTags
shapesOnlyHere lbls sure =
  Map.fromList
    compareString
    (List.filter
       (\p ->
          not
            (List.any
               (\l -> contains ("," ^ l ^ ",") ("," ^ fst p ^ ","))
               lbls))
       (Map.toList sure))

ceOf : List Emit.Provider
     -> Facts.Facts
     -> Pair (List String) (List String)
     -> CE
ceOf provs facts names =
  { tags =
      hashedGo
        10
        65526
        (sortedOnce
           (List.filter
              (\t -> not (elemS t knownTags))
              (List.append
                 (fst names)
                 (List.concatMap
                    (\(p : Emit.Provider) -> namesInGo "TAG_" p.text 0 Nil)
                    provs))))
        (numbered 0 knownTags Map.empty)
        Map.empty
  , lbls =
      hashedGo
        0
        2147483647
        (sortedOnce
           (List.append
              (snd names)
              (List.concatMap
                 (\(p : Emit.Provider) -> namesInGo "LBL_" p.text 0 Nil)
                 provs)))
        Map.empty
        Map.empty
  , facts =
      Facts.withSureRecs
        (shapesOnlyHere
           (List.concatMap
              (\(p : Emit.Provider) -> namesInGo "LBL_" p.text 0 Nil)
              provs)
           facts.sureRecs)
        (Facts.withFlat
           facts.flat
           (builtOnlyHere
              (List.append
                 knownTags
                 (List.concatMap
                    (\(p : Emit.Provider) -> namesInGo "TAG_" p.text 0 Nil)
                    provs))
              facts.sure)
           facts)
  }

programWith : String
            -> List Emit.Provider
            -> Ending
            -> Facts.Facts
            -> List IR.Def
            -> Pair (List String) (List String)
            -> String
programWith runtime provs ending facts defs names =
  programCE runtime provs ending defs (ceOf provs facts names)

-- Parts: the program in a file for each module (`--split`), which a C
-- compiler builds apart -- and builds again only what changed
--------------------------------------------------------------------------------

-- (a definition's module: its key up to its last dot)
lastDotGo : String -> Int -> Int -> Int
lastDotGo k i at =
  if i >= strLength k then at
  else lastDotGo k (i + 1) (if byteAt k i == 46 then i else at)

moduleAt : String -> Int -> String
moduleAt k at = if at < 0 then k else strSlice k 0 at

moduleOfKey : String -> String
moduleOfKey k = moduleAt k (lastDotGo k 0 (0 - 1))

-- (a line of the program as a part has it: a definition's functions
-- seen from every part, not only its own -- what a definition keeps to
-- itself (`_val`, `_st`, `_init`) stays its own)
-- (the C types of what a worker takes and gives unboxed, #39)
unboxedCTypes : List String
unboxedCTypes =
  [ "double"
  , "float"
  , "int8_t"
  , "int16_t"
  , "int32_t"
  , "int64_t"
  , "uint8_t"
  , "uint16_t"
  , "uint32_t"
  , "uint64_t"
  ]

-- (a worker's head: its C type, then its name)
isWorkerLine : String -> Bool
isWorkerLine l =
  List.any (\t -> startsWith ("static " ^ t ^ " g_") l) unboxedCTypes

pubLine : String -> String
pubLine l =
  if startsWith "static V g_" l
  && not (endsWith "_val;" l)
  && not (contains "_init(void)" l)
    then strSlice l 7 (strLength l)
  else if startsWith "static V heff_perform(" l then strSlice l 7 (strLength l)
  else if isWorkerLine l then strSlice l 7 (strLength l)
  else l

-- (a definition's closure: defined in its own part, declared in others)
isCloDef : String -> Bool
isCloDef l = startsWith "static Clo g_" l

cloDecl : String -> String
cloDecl l = case indexOf " =" l of
  Just at -> "extern Clo " ^ strSlice l 11 at ^ ";"
  Nothing -> l

-- (heff.h, which every part includes: the runtime -- what each part
-- declares and defines for itself, the numbers of the tags and labels
-- it uses too, is in it, so that heff.h is the same whatever the
-- program, and a part changed does not make every part be built again)
partHead : String -> Ending -> List String
partHead runtime ending =
  List.append
    (Cons "// Generated from Hippogriff; do not edit." Nil)
    (List.append ending.prefix [runtime, "V heff_perform(V p, V k);"])

-- (the numbers of the tags and labels a part uses)
numbersOf : CE -> Pair (List String) (List String) -> List String
numbersOf ce (MkPair ts ls) =
  List.append
    (List.map
       (\t ->
          "#define "
          ^ tagName t
          ^ " "
          ^ show (fromMaybe 0 (Map.lookup compareString t ce.tags)))
       (List.filter (\t -> not (elemS t knownTags)) (sortedOnce ts)))
    (List.map
       (\l ->
          "#define "
          ^ lblName l
          ^ " "
          ^ show (fromMaybe 0 (Map.lookup compareString l ce.lbls)))
       (sortedOnce ls))

-- (a function's worker, declared: by its signature)
workerDecl : String -> Maybe Repr.Sig -> List String
workerDecl k (Just sg) =
  Cons
    (cType sg.result
     ^ " "
     ^ calleeName k True
     ^ "("
     ^ (if List.null sg.params then "void"
        else joinWith ", " (List.map cType sg.params))
     ^ ");")
    Nil
workerDecl k Nothing = Nil

-- (a definition, declared to a part that uses it: a function's code,
-- its worker's, entry and closure, a value's getter -- by its arity and
-- its worker's signature, not by its parameters' names, so that a part
-- changes only when what it uses does)
declOf : CE -> String -> List String
declOf ce k = case Map.lookup compareString k ce.facts.arity of
  Just n ->
    List.append
      (workerDecl k (Repr.sigIn ce.facts.workers k))
      [ "V "
      ^ cGlobal k
      ^ "("
      ^ (if n == 0 then "void" else joinWith ", " (List.replicate n "V"))
      ^ ");"
      , "V " ^ cGlobal k ^ "_entry(V self, V *a);"
      , "extern Clo " ^ cGlobal k ^ "_clo;"
      ]
  Nothing -> ["V " ^ cGlobal k ^ "_get(void);"]

-- (what was made for each definition -- its strings, its lambdas --
-- by the definition it was made for)
byOwner : List (Pair String String) -> Map.Map String (List String)
byOwner ps =
  List.foldl
    (\m p ->
       Map.insert
         compareString
         (fst p)
         (Cons (snd p) (fromMaybe Nil (Map.lookup compareString (fst p) m)))
         m)
    Map.empty
    ps

linesOf : Map.Map String (List String) -> String -> List String
linesOf m o = fromMaybe Nil (Map.lookup compareString o m)

-- (a definition, as its part has it)
ownLines : CS
         -> Map.Map String (List String)
         -> Map.Map String (List String)
         -> Map.Map String (List String)
         -> Pair IR.Def Emitted1
         -> List String
ownLines s strs protos lams (MkPair d e) =
  List.append
    (linesOf strs (cGlobal d.key))
    (List.append
       (List.map pubLine (linesOf protos (cGlobal d.key)))
       (List.append
          (List.map
             (\l -> strSlice l 7 (strLength l))
             (List.filter isCloDef e.protos))
          (List.append
             (List.map pubLine e.code)
             (List.map pubLine (linesOf lams (cGlobal d.key))))))

pairKey : Pair IR.Def Emitted1 -> String
pairKey (MkPair d _) = d.key

-- (the definitions, by module, each module's in order)
byModule : List (Pair IR.Def Emitted1)
         -> Map.Map String (List (Pair IR.Def Emitted1))
byModule ps =
  List.foldl
    (\m p ->
       Map.insert
         compareString
         (moduleOfKey (pairKey p))
         (Cons
            p
            (fromMaybe
               Nil
               (Map.lookup compareString (moduleOfKey (pairKey p)) m)))
         m)
    Map.empty
    (List.reverse ps)

zipDE : List IR.Def -> List Emitted1 -> List (Pair IR.Def Emitted1)
zipDE (Cons d ds) (Cons e es) = Cons (MkPair d e) (zipDE ds es)
zipDE _ _ = Nil

-- (what a definition uses: the definitions it calls or mentions, and
-- itself)
usesOf : Pair IR.Def Emitted1 -> List String
usesOf (MkPair d _) = Cons d.key (IR.globalsIn d.body)

-- (what the owners of a part use, each once: shapes, primitives)
usedBy : Map.Map String (List String)
       -> List (Pair IR.Def Emitted1)
       -> List String
usedBy m ps =
  sortedOnce (List.concatMap (\p -> linesOf m (cGlobal (pairKey p))) ps)

-- (a module's part: heff.h, then what it uses declared -- the shapes and
-- primitives its definitions use, and the definitions -- then its own)
modulePart : List String
           -> CE
           -> CS
           -> Map.Map String (List String)
           -> Map.Map String (List String)
           -> Map.Map String (List String)
           -> Map.Map String (List String)
           -> Map.Map String (List String)
           -> Pair String (List (Pair IR.Def Emitted1))
           -> Pair String String
modulePart head ce s shapes prims strs protos lams (MkPair m ps) =
  MkPair
    (m ^ ".c")
    (joinWith
       "\n"
       (List.append
          head
          (List.append
             (numbersOf
                ce
                (namesIn
                   tagsLbls
                   (List.map (\(p : Pair IR.Def Emitted1) -> (fst p).body) ps)))
             (List.append
                (List.map shapeDef (usedBy shapes ps))
                (List.append
                   (List.concatMap primCloDef (usedBy prims ps))
                   (List.append
                      (List.concatMap
                         (declOf ce)
                         (sortedOnce (List.concatMap usesOf ps)))
                      (List.concatMap (ownLines s strs protos lams) ps)))))))

-- Parts bounded in size (#38): a module's definitions are put in as many
-- parts as keep each to about `partBytes` of C -- a power of two of them,
-- so that one more splits each in two -- and a definition in the part its
-- key hashes to, so that an edit leaves every other definition where it
-- was, and only the parts holding what changed are compiled again.

partBytes : Int
partBytes = 160000

partsMost : Int
partsMost = 64

keyHashGo : String -> Int -> Int -> Int
keyHashGo k i h =
  if i >= strLength k then h
  else keyHashGo k (i + 1) ((h * 31 + byteAt k i) % 1000000007)

-- | >>> keyHash "list.map" == keyHash "list.map"
-- | True
keyHash : String -> Int
keyHash k = keyHashGo k 0 7

-- | how many parts `bytes` of C take, from `b`, doubling
-- | >>> List.map (\n -> partCount n 1) [0, 160000, 160001, 1338607]
-- | [1, 1, 2, 16]
partCount : Int -> Int -> Int
partCount bytes b =
  if b >= partsMost || bytes <= b * partBytes then b
  else partCount bytes (b * 2)

linesBytes : List String -> Int
linesBytes ls = List.foldl (\n l -> n + strLength l + 1) 0 ls

inPart : Int -> Int -> Pair IR.Def Emitted1 -> Bool
inPart b k p = keyHash (pairKey p) % b == k

consPart : {a : Type}
         -> String
         -> List a
         -> List (Pair String (List a))
         -> List (Pair String (List a))
consPart n Nil rest = rest
consPart n qs rest = Cons (MkPair n qs) rest

partsFrom : String
          -> Int
          -> List (Pair IR.Def Emitted1)
          -> Int
          -> List (Pair String (List (Pair IR.Def Emitted1)))
partsFrom m b ps k =
  if k >= b then Nil
  else consPart
      (m ^ "." ^ show k)
      (List.filter (inPart b k) ps)
      (partsFrom m b ps (k + 1))

partsOfCount : String
             -> List (Pair IR.Def Emitted1)
             -> Int
             -> List (Pair String (List (Pair IR.Def Emitted1)))
partsOfCount m ps b =
  if b == 1 then Cons (MkPair m ps) Nil else partsFrom m b ps 0

-- (a module's definitions, as its parts: one, named as the module, where
-- it is small; else `MODULE.K`, K the part a definition's key hashes to)
moduleParts : (Pair IR.Def Emitted1 -> Int)
            -> Pair String (List (Pair IR.Def Emitted1))
            -> List (Pair String (List (Pair IR.Def Emitted1)))
moduleParts size (MkPair m ps) =
  partsOfCount m ps (partCount (List.foldl (\n p -> n + size p) 0 ps) 1)

-- | the part with the program's `main`, its worlds' providers and its
-- | algebra: named, as `run$entry.c` is, as no module's part is -- a
-- | module `main` has its own, `main.c`
entryPart : String
entryPart = "run$main.c"

-- (every module's parts, each bounded in size)
modulesParts : CE
             -> CS
             -> Map.Map String (List String)
             -> Map.Map String (List String)
             -> Map.Map String (List String)
             -> List IR.Def
             -> List Emitted1
             -> List (Pair String String)
modulesParts ce s strs protos lams defs ems =
  List.map
    (modulePart
       [ "// Generated from Hippogriff; do not edit."
       , "#define HEFF_PART"
       , "#include \"heff.h\""
       ]
       ce
       s
       (byOwner s.shapes)
       (byOwner s.prims)
       strs
       protos
       lams)
    (List.concatMap
       (moduleParts
          (\(p : Pair IR.Def Emitted1) ->
             linesBytes (ownLines s strs protos lams p)))
       (Map.toList (byModule (zipDE defs ems))))

partsWith : String
          -> List Emit.Provider
          -> Ending
          -> List IR.Def
          -> CE
          -> Pair (List Emitted1) CS
          -> List (Pair String String)
partsWith runtime provs ending defs ce (MkPair ems s) =
  Cons
    (MkPair "heff.h" (joinWith "\n" (partHead runtime ending)))
    (Cons
       (MkPair
          entryPart
          (joinWith
             "\n"
             (Cons
                "#include \"heff.h\""
                (List.append
                   (numbersOf
                      ce
                      (MkPair
                         (List.concatMap
                            (\(p : Emit.Provider) ->
                               namesInGo "TAG_" p.text 0 Nil)
                            provs)
                         (List.concatMap
                            (\(p : Emit.Provider) ->
                               namesInGo "LBL_" p.text 0 Nil)
                            provs)))
                   (List.append
                      (declOf ce Lower.entryKey)
                      (List.append
                         (List.map (\(p : Emit.Provider) -> p.text) provs)
                         (List.map pubLine (ending.end ce))))))))
       (modulesParts
          ce
          s
          (byOwner s.strs)
          (byOwner s.protos)
          (byOwner s.lams)
          defs
          ems))

-- The backend's cache: a definition's C as it keeps it
--------------------------------------------------------------------------------

-- A definition's C depends on the definition alone -- as it is lowered,
-- its variables named again from 0 (`defOwn`) -- and on what is known
-- of itself and of the globals it mentions: whether each is a function
-- and of how many parameters, whether its calls may give back a bounce,
-- which of its parameters are lent, its worker's signature.  The cache
-- (heff.build.backcache) keeps it by a hash of those (`emitVer`), with
-- what was made for it on the way: its strings and lambdas, the shapes
-- and primitives it uses, each in the order made.

-- | a definition's C, as the cache keeps it
type EmitKept =
  { ver : String
  , protos : List String
  , code : List String
  , strs : List String
  , lprotos : List String
  , lams : List String
  , shapes : List String
  , prims : List String
  }

-- (what is known of a global)
globalH : CE -> String -> List IRText.HItem -> List IRText.HItem
globalH ce g rest =
  Cons
    (HS g)
    (Cons
       (HN (fromMaybe (0 - 1) (Map.lookup compareString g ce.facts.arity)))
       (Cons
          (HN (if Map.member compareString g ce.facts.bounce then 1 else 0))
          (Cons
             (HS
                (joinWith
                   ","
                   (List.map show (Borrow.borOf ce.facts.lent g))))
             (Cons
                (HS (maybe "" Repr.sigName (Repr.sigIn ce.facts.workers g)))
                rest))))

-- (what is known of a tag: its fields that may be flat, #64, and those
-- that are)
tagH : CE -> String -> List IRText.HItem -> List IRText.HItem
tagH ce t rest =
  Cons
    (HS t)
    (Cons
       (HS
          (joinWith
             ","
             (List.map
                show
                (fromMaybe Nil (Map.lookup compareString t ce.facts.flat)))))
       (Cons
          (HS
             (joinWith
                ","
                (List.map
                   show
                   (fromMaybe Nil (Map.lookup compareString t ce.facts.sure)))))
          rest))

-- (the shapes of the records the worklist reads a field of, onto `acc`)
projShapesW : List String -> List IR.Expr -> List String
projShapesW acc Nil = acc
projShapesW acc (Cons (EProj e _ sh _) rest) =
  projShapesW (Cons (Repr.shapeKey sh) acc) (Cons e rest)
projShapesW acc (Cons (ELam _ b) rest) = projShapesW acc (Cons b rest)
projShapesW acc (Cons (EApp f as) rest) =
  projShapesW acc (Cons f (IR.appendI as rest))
projShapesW acc (Cons (ELet _ a b) rest) =
  projShapesW acc (Cons a (Cons b rest))
projShapesW acc (Cons (ERecord fs _) rest) =
  projShapesW acc (IR.pushFields fs rest)
projShapesW acc (Cons (ETag _ as _) rest) = projShapesW acc (IR.appendI as rest)
projShapesW acc (Cons (EMatch s arms) rest) =
  projShapesW acc (Cons s (IR.pushArms arms rest))
projShapesW acc (Cons (EPrimCall _ as) rest) =
  projShapesW acc (IR.appendI as rest)
projShapesW acc (Cons (ECall _ as) rest) = projShapesW acc (IR.appendI as rest)
projShapesW acc (Cons _ rest) = projShapesW acc rest

-- (what is known of a record's shape: its fields that are flat)
shapeH : CE -> String -> List IRText.HItem -> List IRText.HItem
shapeH ce sh rest =
  Cons
    (HS sh)
    (Cons
       (HS
          (joinWith
             ","
             (List.map
                show
                (fromMaybe
                   Nil
                   (Map.lookup compareString sh ce.facts.sureRecs)))))
       rest)

-- | what a definition's C is made of, hashed: its key, its body (named
-- | again from 0), and what is known of itself, of what it mentions, of
-- | the tags it matches and of the records it reads
emitVer : CE -> String -> IR.Expr -> String
emitVer ce key b =
  IRText.hashOf
    (Cons
       (HS key)
       (Cons
          (HE b)
          (List.foldr
             (globalH ce)
             (List.foldr
                (tagH ce)
                (List.foldr (shapeH ce) Nil (sortedOnce (projShapesW Nil [b])))
                (List.filter
                   (\t -> Map.member compareString t ce.facts.flat)
                   (sortedOnce (fst (tagsLbls b)))))
             (sortedOnce (Cons key (IR.globalsIn b))))))

-- (what a definition made on its own: the C state it was emitted from
-- held nothing else)
ownStart : String -> CS
ownStart o =
  { owner = o
  , nlam = 0
  , lams = Nil
  , protos = Nil
  , nstr = 0
  , strs = Nil
  , shapes = Nil
  , prims = Nil
  }

madeLines : List (Pair String String) -> List String
madeLines ps = List.reverse (List.map snd ps)

keptOf : String -> Emitted1 -> CS -> EmitKept
keptOf v e s =
  { ver = v
  , protos = e.protos
  , code = e.code
  , strs = madeLines s.strs
  , lprotos = madeLines s.protos
  , lams = madeLines s.lams
  , shapes = madeLines s.shapes
  , prims = madeLines s.prims
  }

pushOwn : String
        -> List String
        -> List (Pair String String)
        -> List (Pair String String)
pushOwn o Nil acc = acc
pushOwn o (Cons l ls) acc = pushOwn o ls (Cons (MkPair o l) acc)

-- (what the definition `o` made, as if made after what `s` holds)
mergeKept : String -> EmitKept -> CS -> CS
mergeKept o k s =
  { owner = s.owner
  , nlam = s.nlam
  , lams = pushOwn o k.lams s.lams
  , protos = pushOwn o k.lprotos s.protos
  , nstr = s.nstr
  , strs = pushOwn o k.strs s.strs
  , shapes = pushOwn o k.shapes s.shapes
  , prims = pushOwn o k.prims s.prims
  }

type EmitAcc =
  { ems : List Emitted1, s : CS, fresh : List (Pair String EmitKept) }

keptHit : EmitAcc -> String -> EmitKept -> EmitAcc
keptHit acc key k =
  { ems = Cons { protos = k.protos, code = k.code } acc.ems
  , s = mergeKept (cGlobal key) k acc.s
  , fresh = acc.fresh
  }

freshEmitted : EmitAcc -> String -> String -> Pair Emitted1 CS -> EmitAcc
freshEmitted acc key v (MkPair e s1) =
  { ems = Cons e acc.ems
  , s = mergeKept (cGlobal key) (keptOf v e s1) acc.s
  , fresh = Cons (MkPair key (keptOf v e s1)) acc.fresh
  }

keptAtVer : String -> Maybe EmitKept -> Maybe EmitKept
keptAtVer v (Just k) = if strEq k.ver v then Just k else Nothing
keptAtVer v Nothing = Nothing

emitAt : CE
       -> Map.Map String EmitKept
       -> EmitAcc
       -> IR.Def
       -> Pair IR.Expr Int
       -> String
       -> EmitAcc
emitAt ce kept acc d own v = case keptAtVer
    v
    (Map.lookup compareString d.key kept) of
  Just k -> keptHit acc d.key k
  Nothing ->
    freshEmitted
      acc
      d.key
      v
      (defC (Lower.cDef ce.facts d own) (ownStart (cGlobal d.key)))

emitWith : CE
         -> Map.Map String EmitKept
         -> EmitAcc
         -> IR.Def
         -> Pair IR.Expr Int
         -> EmitAcc
emitWith ce kept acc d own =
  emitAt ce kept acc d own (emitVer ce d.key (fst own))

emitOne : CE -> Map.Map String EmitKept -> EmitAcc -> IR.Def -> EmitAcc
emitOne ce kept acc d = emitWith ce kept acc d (IR.freshen 0 d.body)

-- | each definition emitted as `defsC` does -- as the cache keeps it,
-- | where it keeps it at its version -- and those emitted here
defsKept : CE -> Map.Map String EmitKept -> List IR.Def -> EmitAcc
defsKept ce kept defs =
  List.foldl (emitOne ce kept) { ems = Nil, s = emptyCS, fresh = Nil } defs

partsCE : String
        -> List Emit.Provider
        -> Ending
        -> List IR.Def
        -> CE
        -> List (Pair String String)
partsCE runtime provs ending defs ce =
  partsWith runtime provs ending defs ce (defsC ce defs emptyCS)

-- | the program as parts, each by its file's name: heff.h, run$main.c
-- | (`entryPart`), then a part for each module
programParts : String
             -> List Emit.Provider
             -> Ending
             -> Facts.Facts
             -> List IR.Def
             -> List (Pair String String)
programParts runtime provs ending facts defs =
  partsCE
    runtime
    provs
    ending
    defs
    (ceOf
       provs
       facts
       (namesIn tagsLbls (List.map (\(d : IR.Def) -> d.body) defs)))

-- | the program, its runtime and its providers before it
programC : String
         -> List Emit.Provider
         -> Ending
         -> Facts.Facts
         -> List IR.Def
         -> String
programC runtime provs ending facts defs =
  programWith
    runtime
    provs
    ending
    facts
    defs
    (namesIn tagsLbls (List.map (\(d : IR.Def) -> d.body) defs))

outputOf : String
         -> List Emit.Provider
         -> Ending
         -> Lower.Lowered
         -> Emit.Output
outputOf runtime provs ending l =
  { source = programC runtime provs ending l.facts l.defs, errors = l.errors }

checkOut : String -> List (Pair String String) -> Lower.Lowered -> Emit.Output
checkOut runtime exports l =
  { source =
      programC
        runtime
        Nil
        { prefix = Cons "#define HEFF_CHECK" Nil
        , end = checkEnd exports l.defs
        }
        l.facts
        l.defs
  , errors = l.errors
  }

-- (what comes before the runtime: `#define HEFF_THREADS 1` where a
-- provider says it, which runs the program in threads of its own, so
-- that the runtime is built for them (lib/c/runtime.c, "Threads"))
threadsLine : String
threadsLine = "#define HEFF_THREADS 1"

saysThreads : Emit.Provider -> Bool
saysThreads p =
  List.any (\l -> startsWith "#define HEFF_THREADS" l) (lines p.text)

runPrefix : List Emit.Provider -> List String
runPrefix provs = if List.any saysThreads provs then [threadsLine] else Nil

-- | one C file that runs the computation `key` of the effect `eff`: the
-- | runtime (lib/c/runtime.c), each world's provider, and the program
compileProgramC : String
                -> List Emit.Provider
                -> Globals.Globals
                -> String
                -> Effect.Effect
                -> Emit.Output
compileProgramC runtime provs g key eff =
  outputOf
    runtime
    provs
    { prefix = runPrefix provs, end = runEnd eff }
    (Lower.lowerProgramC g key)

partsOf : String
        -> List Emit.Provider
        -> Effect.Effect
        -> Lower.Lowered
        -> Pair (List (Pair String String)) (List String)
partsOf runtime provs eff l =
  MkPair
    (programParts
       runtime
       provs
       { prefix = runPrefix provs, end = runEnd eff }
       l.facts
       l.defs)
    l.errors

-- | the program `compileProgramC` makes, as parts (`programParts`), and
-- | what is wrong with it
compileProgramParts : String
                    -> List Emit.Provider
                    -> Globals.Globals
                    -> String
                    -> Effect.Effect
                    -> Pair (List (Pair String String)) (List String)
compileProgramParts runtime provs g key eff =
  partsOf runtime provs eff (Lower.lowerProgramC g key)

-- | the program as parts, made through the backend's cache: what is
-- | wrong with it, and what the cache is to keep anew -- definitions of
-- | the core simplified, copies, definitions' C
type PartsKept =
  { parts : List (Pair String String)
  , errors : List String
  , groups : List Lower.GroupOut
  , copies : List Simplify.CopyDone
  , emits : List (Pair String EmitKept)
  }

keptPartsAcc : String
             -> List Emit.Provider
             -> Ending
             -> Lower.LoweredKept
             -> CE
             -> EmitAcc
             -> PartsKept
keptPartsAcc runtime provs ending lk ce acc =
  { parts =
      partsWith
        runtime
        provs
        ending
        lk.lowered.defs
        ce
        (MkPair (List.reverse acc.ems) acc.s)
  , errors = lk.lowered.errors
  , groups = lk.groups
  , copies = lk.copies
  , emits = acc.fresh
  }

keptPartsCE : String
            -> List Emit.Provider
            -> Ending
            -> Map.Map String EmitKept
            -> Lower.LoweredKept
            -> CE
            -> PartsKept
keptPartsCE runtime provs ending kept lk ce =
  keptPartsAcc runtime provs ending lk ce (defsKept ce kept lk.lowered.defs)

keptParts : String
          -> List Emit.Provider
          -> Effect.Effect
          -> Map.Map String EmitKept
          -> Lower.LoweredKept
          -> PartsKept
keptParts runtime provs eff kept lk =
  keptPartsCE
    runtime
    provs
    { prefix = Nil, end = runEnd eff }
    kept
    lk
    (ceOf
       provs
       lk.lowered.facts
       (namesIn tagsLbls (List.map (\(d : IR.Def) -> d.body) lk.lowered.defs)))

-- | the parts `compileProgramParts` makes, made through the backend's
-- | cache (heff.build.backcache): each definition of the core taken as
-- | it keeps it at its version (`vers`, `ks`, heff.compile.lower), each
-- | definition's C as it keeps it at what it is made of (`kept`)
compileProgramPartsKept : String
                        -> List Emit.Provider
                        -> Globals.Globals
                        -> String
                        -> Effect.Effect
                        -> Map.Map String String
                        -> Lower.Keeps
                        -> Map.Map String EmitKept
                        -> PartsKept
compileProgramPartsKept runtime provs g key eff vers ks kept =
  keptParts
    runtime
    provs
    eff
    kept
    (Lower.cKeptOf (Lower.lowerProgramKept g key vers ks))

-- | one C file that shows the definitions it is asked for, of those
-- | given (each by its name and key), as test/load-js.mjs shows
-- | JavaScript's: what the tests hold the backend to
compileCheckC : String
              -> Globals.Globals
              -> List (Pair String String)
              -> Emit.Output
compileCheckC runtime g exports =
  checkOut runtime exports (Lower.lowerC g (List.map snd exports))

catMaybesC : {a : Type} -> List (Maybe a) -> List a
catMaybesC Nil = Nil
catMaybesC (Cons (Just x) rest) = Cons x (catMaybesC rest)
catMaybesC (Cons Nothing rest) = catMaybesC rest

-- | the effects a C provider provides: its `heff_provider_X` definitions
-- | >>> providedNames "static V heff_provider_stdio(V p, V k) {"
-- | ["stdio"]
providedNames : String -> List String
providedNames text =
  catMaybesC
    (List.map
       (\l ->
          if startsWith "static V heff_provider_" l then Just (identAt l 23 23)
          else Nothing)
       (lines text))
