-- Reference counts, and what the C backend does with them (#40): the
-- imperative form (heff.compile.imperative) made `Rc`, each decision written in
-- it, which heff.compile.emitc prints as C.
--
-- Perceus: a variable holds a reference to its value, which the code
-- holding the variable consumes or drops, exactly once on each path.
--
-- - Each use of a variable consumes a reference: the last use on its
--   path gives its own away; a use before that takes one more
--   (`RDup`).  A use is last where the variable is not wanted after it:
--   by the operands after it, or by what comes after the step (`live`).
--   What uses its operands consumes them: a call, a tag or a record
--   built, a closure made, a primitive, a field taken.
-- - Where a path starts -- a function's or a lambda's body, a match's
--   arm, what follows a binding -- a variable held and not wanted on it
--   is dropped (`CDrop`).
-- - A match only looks at what it matches: an arm takes a reference to
--   each field it wants, and the matched value is dropped there if the
--   arm does not want it.
-- - A definition's value is the definition's, never dropped: a use of it
--   takes a reference.  A lambda's closure holds what it mentions: its
--   body takes what it holds, and gives the closure up.
-- - A drop is specialised where what is dropped is known (`Known`): a tag
--   of no fields is a word, nothing to give back; a tag of `n` fields --
--   in an arm matching it, or bound to one built -- is given back as one,
--   not looked at; a cell kept and not built in is freed; so are a record
--   and a closure of known size.
--
-- And besides: a function's parameter lent, not given (heff.compile.borrow,
-- `lent`); a tag built in the cell of the one a match took apart, where
-- that was its last reference (`RTagIn`); a record built of the same shape
-- as one it reads fields of, in that one's cell (`RRecIn`); a field taken
-- out of its record (`RTakeField`); and how each call last is made -- the
-- loop again, a jump, an unknown function's arguments where a lambda's
-- were.  A function with a worker (heff.compile.worker) is made its
-- worker, known calls of it calling that with numbers unboxed, and its
-- wrapper (`Wrapper`), which a closure's entry calls.

import heff.compile.borrow as Borrow
import heff.compile.facts as Facts
import heff.elab.fixed as Fixed
import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.compile.repr as Repr
import map as Map

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

-- The form
--------------------------------------------------------------------------------

-- Types are defined one after another, as heff.compile.imperative's are: what
-- holds a lambda's body is parametric in it (`b`), and `Code` closes the
-- knot.

-- | what a variable is known to be where it is dropped (#26): a tag of
-- | `n` fields -- the arm it is in matching it, or built where it is
-- | bound -- or the cell kept for a tag of `n` fields (`reusing`); a
-- | record of `n` fields -- built where it is bound, or read a field of
-- | at its shape -- or a closure holding `n`, built where it is bound
-- | (#34)
data Known = KnownTag Int | KnownCell Int | KnownRec Int | KnownClo Int

-- | a drop of a variable, as what it is known to be (if anything)
data Drop = MkDrop String (Maybe Known)

-- | a call's operand (`e` a value): given; given unboxed, of the repr (a
-- | worker's, #39); a variable lent, dropped after the call where nothing
-- | wants it after (its drops); a value lent, computed before the call
-- | and dropped after it
data Arg e
  = Given e
  | GivenU Repr.Repr e
  | LentVar String (List Drop)
  | LentValue e

-- | a condition, tested where it is (`e` a value): a comparison of
-- | operands, consumed (`CondRel`), or of unboxed ones (`CondRelU`, #39);
-- | a `Bool` looked at; not; a test of tests; a name bound in it, its
-- | drops where it is decided.  Of more than a comparison, its operands
-- | are lent: what it holds it holds after it on every path, however far
-- | it was looked at (see `condTest`)
data Cond e
  = CondTrue
  | CondFalse
  | CondRel String (List e)
  | CondRelU String (List e)
  | CondBool e
  | CondNot (Cond e)
  | CondIf (Cond e) (Cond e) (Cond e)
  | CondLet String e (Cond e) (List Drop)

-- | a value, made: each operand consumed (`RLocal`, a variable's
-- | reference given; `RDup`, one more taken)
data Exp b
  = RLocal String
  | RDup String
  -- | a function, as a closure (static)
  | RClo String
  -- | a definition's value, a reference taken (`RGet`), or looked at
  -- | (`RGetRaw`)
  | RGet String
  | RGetRaw String
  | RInt Int
  | RFloat Float64
  | RStr String
  -- | `Bytes`, a literal's: a static object, as a string's is
  | RBytes String
  | RFixed Fixed.Fixed Int
  | RF32 Float64
  -- | a tag of no fields: a word
  | RNTag String
  -- | a tag: the bits of its flat fields (#64, `Repr.flatBits`), its
  -- | fields (a flat one's bits, `RWord`)
  | RTag String Int (List (Exp b))
  -- | ... built in the cell kept for it
  | RTagIn (Exp b) String Int (List (Exp b))
  -- | a record of its labels, the bits of its flat fields (#39,
  -- | `Repr.flatBits`), its fields (a flat one's bits, `RWord`)
  | RRec (List String) Int (List (Exp b))
  -- | a record built in the cell of `x`, of `n` fields, the bits of
  -- | those kept, the bits of its flat fields kept as they are
  -- | (`Repr.keptBits`) and of those stored flat: its labels, the others
  -- | each at its place
  | RRecIn String Int Int Int Int (List String) (List (Pair Int (Exp b)))
  -- | field `i` of a record, not counted
  | RField (Exp b) Int
  | RDupE (Exp b)
  -- | field `i` of a record, counted, a `V`: boxed, if it is flat
  | RFieldV (Exp b) Int
  -- | field `i` of a record of `n` fields, the record consumed
  | RGetN (Exp b) Int Int
  -- | field `i` of a record, a number of the repr, flat or not: the
  -- | record lent (`RFieldU`), or of `n` fields and consumed (`RGetNU`)
  | RFieldU Repr.Repr (Exp b) Int
  | RGetNU Repr.Repr (Exp b) Int Int
  -- | an unboxed value, the bits of a flat field
  | RWord Repr.Repr (Exp b)
  -- | field `i` taken out of the record `x`
  | RTakeField String Int
  -- | a field looked for by its label
  | RGetLabel (Exp b) String
  | RPrimFn String
  | RPrim String (List (Exp b))
  -- | a lambda's closure: its parameters, what it holds (the names in
  -- | its body, the values given), its body (its parameters not wanted
  -- | dropped first)
  | RLam (List String) (List String) (List (Exp b)) b
  -- | a known definition called: through any bounces (`tr`); its worker,
  -- | which gives the repr, or the function itself (`Nothing`, a `V`);
  -- | each operand given or lent
  | RCall String Bool (Maybe Repr.Repr) (List (Arg (Exp b)))
  | RApply (Exp b) (List (Exp b))
  -- | the `Bool` a condition is
  | RBool (Cond (Exp b))
  | RAbandon
  -- | unboxed values (#39, heff.compile.repr): one made a `V`; a `V` made
  -- | one, consumed (`RUnbox`) or looked at (`RPeek`); a primitive done
  -- | on unboxed operands (as `Repr.primShape` says); a literal
  | RBox Repr.Repr (Exp b)
  | RUnbox Repr.Repr (Exp b)
  | RPeek Repr.Repr (Exp b)
  | RPrimU String (List (Exp b))
  | RFixU Fixed.Fixed Int
  | RF32U Float64
  | RF64U Float64

-- | what is known of a tag's fields that are not kept, where it is given
-- | up: none flat; some may be (#64); all flat, nothing to drop
data Flatness = FlatNone | FlatSome | FlatAll

-- | what a match's arm does with what it matched, given up: nothing (it
-- | wants it, or it is lent); given up at once, the fields of the mask
-- | kept; its cell kept for a tag of its size, `ru` -- each knowing
-- | which of the others may be flat
data Take = TakeNone | TakeN Flatness Int Int | TakeKeep Flatness String Int Int

-- | a field that may be flat (#64), as an arm reads it: its variable,
-- | its place, the repr it is read as
type FlatRead = Pair String (Pair Int Repr.Repr)

-- | an arm: its tag, the fields it wants (each its place), those of them
-- | that may be flat (#64), each read as the repr (a number, or a `V`
-- | counted, boxed if it is flat), the places of those that are flat in
-- | every tag of it (read as they are, `Facts.sure`), whether the others
-- | are taken over or lent (not counted), what it does with what it
-- | matched, its body, and whether it leaves the `switch`
data Arm a
  = MkCArm String (List (Pair String Int)) (List FlatRead) (List
                                                              Int) Bool Take a Bool

-- | a statement, or what is last
data Stmt b
  = CDrop Drop
  | CLet String (Exp b)
  | CDecl String
  | CSet String (Exp b)
  -- | a name set to nothing it can be: not reached
  | CAbandon
  -- | `if` the condition, then, else
  | CIf (Cond (Exp b)) (List (Stmt b)) (List (Stmt b))
  -- | a `switch` on what is looked at: its arms, and whether one not
  -- | there returns (else it is a statement)
  | CSwitch (Exp b) (List (Arm (List (Stmt b)))) Bool
  | CReturn (Exp b)
  -- | an unknown function called last: its arguments where a lambda's
  -- | were; in `heff_room`; given, counted
  | CInPlace (Exp b) (List (Exp b))
  | CRoomed (Exp b) (List (Exp b))
  | CTail (Exp b) (List (Exp b))
  -- | the loop again: its parameters, the arguments
  | CLoop (List String) (List (Exp b))
  -- | a known definition of the same parameters called last: a jump, to
  -- | its worker or to the function itself
  | CJump String Bool (List (Exp b))

-- | a body: what a function or a lambda does
data Code = MkCode (List (Stmt Code))

type Value = Exp Code

type Statement = Stmt Code

type Operand = Arg Value

type Test = Cond Value

type CaseArm = Arm (List Statement)

type Statements = List Statement

-- | a function's wrapper (#39): its parameters, `V`s, and what it does --
-- | unbox those its worker takes unboxed, call it, box what it gives
data Wrapper = MkWrapper (List String) Statements

-- | a function: its key, its parameters, those lent, what it does where
-- | it is entered -- each parameter kept unboxed unboxed, the loop going
-- | on after it -- its body (its parameters not wanted dropped first),
-- | its variables kept unboxed (heff.compile.repr), what it gives; and,
-- | if it has a worker, its wrapper (the function is then the worker, a
-- | parameter it takes unboxed one of the variables kept so)
type Fun =
  { key : String
  , params : List String
  , lent : List Int
  , entry : Statements
  , body : Statements
  , reprs : Repr.Reprs
  , ret : Repr.Repr
  , wrapper : Maybe Wrapper
  }

-- | a definition: a function; a value, its body and its variables kept
-- | unboxed
data Def = DFun Fun | DVal String Statements Repr.Reprs

-- What is known where
--------------------------------------------------------------------------------

-- | a definition being made that calls itself last: its key and
-- | parameters (the loop's)
type Self = { key : String, params : List String }

-- (`owned`: the variables this code holds a reference to, to consume or
-- drop; `after`: those wanted after what is being made, by what comes
-- after it; `known`: what some of them are known to be; `lam`: in a
-- lambda's body, how many parameters it takes, else 0 -- see `CInPlace`;
-- `takes`: the fields, by their records and labels, that the operands
-- being made take out of their records -- see `takesFor`; `sigs`: the
-- workers; `flat`: the tags' fields that may be flat (#64), `sure`: those
-- that are (heff.compile.facts); `ret`: what
-- the code being made returns, as its worker gives it, a `V` in a lambda)
type CE =
  { funs : Map.Map String Int
  , bounce : Map.Map String Unit
  , self : Maybe Self
  , lam : Int
  , owned : List String
  , after : List String
  , borrowed : List String
  , bor : Map.Map String (List Int)
  , known : Map.Map String Known
  , takes : List (Pair String String)
  , reprs : Repr.Reprs
  , sigs : Repr.Sigs
  , flat : Repr.FlatTags
  , sure : Repr.FlatTags
  , ret : Repr.Repr
  }

-- (what the code of a definition (`s`) or of a lambda returns)
retOf : Repr.Sigs -> Maybe Self -> Repr.Repr
retOf sg (Just s) = Repr.resultIn sg s.key
retOf sg Nothing = RepV

-- (the code of a definition (`s`) or of a lambda of `n` parameters)
withFrame : Maybe Self -> Int -> CE -> CE
withFrame s n ce =
  { funs = ce.funs
  , bounce = ce.bounce
  , self = s
  , lam = n
  , owned = ce.owned
  , after = ce.after
  , borrowed = ce.borrowed
  , bor = ce.bor
  , known = ce.known
  , takes = Nil
  , reprs = ce.reprs
  , sigs = ce.sigs
  , flat = ce.flat
  , sure = ce.sure
  , ret = retOf ce.sigs s
  }

withPath : List String -> List String -> CE -> CE
withPath owned after ce =
  { funs = ce.funs
  , bounce = ce.bounce
  , self = ce.self
  , lam = ce.lam
  , owned = owned
  , after = after
  , borrowed = ce.borrowed
  , bor = ce.bor
  , known = ce.known
  , takes = ce.takes
  , reprs = ce.reprs
  , sigs = ce.sigs
  , flat = ce.flat
  , sure = ce.sure
  , ret = ce.ret
  }

-- (the variables lent to this code: it holds no reference to them)
withBorrowed : List String -> CE -> CE
withBorrowed bs ce =
  { funs = ce.funs
  , bounce = ce.bounce
  , self = ce.self
  , lam = ce.lam
  , owned = ce.owned
  , after = ce.after
  , borrowed = bs
  , bor = ce.bor
  , known = ce.known
  , takes = ce.takes
  , reprs = ce.reprs
  , sigs = ce.sigs
  , flat = ce.flat
  , sure = ce.sure
  , ret = ce.ret
  }

withKnown : String -> Known -> CE -> CE
withKnown x k ce =
  { funs = ce.funs
  , bounce = ce.bounce
  , self = ce.self
  , lam = ce.lam
  , owned = ce.owned
  , after = ce.after
  , borrowed = ce.borrowed
  , bor = ce.bor
  , known = Map.insert compareString x k ce.known
  , takes = ce.takes
  , reprs = ce.reprs
  , sigs = ce.sigs
  , flat = ce.flat
  , sure = ce.sure
  , ret = ce.ret
  }

withTakes : List (Pair String String) -> CE -> CE
withTakes ts ce =
  { funs = ce.funs
  , bounce = ce.bounce
  , self = ce.self
  , lam = ce.lam
  , owned = ce.owned
  , after = ce.after
  , borrowed = ce.borrowed
  , bor = ce.bor
  , known = ce.known
  , takes = ts
  , reprs = ce.reprs
  , sigs = ce.sigs
  , flat = ce.flat
  , sure = ce.sure
  , ret = ce.ret
  }

-- | what is known of the program, where a definition starts, and how
-- | its variables are kept
ceOfFacts : Facts.Facts -> Repr.Reprs -> CE
ceOfFacts facts reprs =
  { funs = facts.arity
  , bounce = facts.bounce
  , self = Nothing
  , lam = 0
  , owned = Nil
  , after = Nil
  , borrowed = Nil
  , bor = facts.lent
  , known = Map.empty
  , takes = Nil
  , reprs = reprs
  , sigs = facts.workers
  , flat = facts.flat
  , sure = facts.sure
  , ret = RepV
  }

-- Free variables
--------------------------------------------------------------------------------

-- | a part of the imperative form (heff.compile.imperative), in a walk
data Item
  = IVal Imperative.Val
  | IOp Imperative.Comp
  | ICond Imperative.Cond
  | ISts (List Imperative.St)
  | ITl Imperative.Tl

pushVals : List Imperative.Val -> List Item -> List Item
pushVals vs rest = List.foldr (\v r -> Cons (IVal v) r) rest vs

armVarsOf : {a : Type} -> List (Imperative.Arm a) -> List String
armVarsOf arms =
  List.concatMap
    (\arm -> case arm of
     MkArm _ vs _ -> vs)
    arms

pushStArms : List (Imperative.Arm (List Imperative.St))
           -> List Item
           -> List Item
pushStArms arms rest =
  List.foldr
    (\arm r -> case arm of
     MkArm _ _ ss -> Cons (ISts ss) r)
    rest
    arms

pushTlArms : List (Imperative.Arm Imperative.Tl) -> List Item -> List Item
pushTlArms arms rest =
  List.foldr
    (\arm r -> case arm of
     MkArm _ _ t -> Cons (ITl t) r)
    rest
    arms

-- (the variables a worklist binds, `bs`, and mentions, `ms`, last first:
-- names being unique, what it mentions and does not bind is free --
-- both gathered in one walk; a variable set, `x = ...`, is not one
-- mentioned)
fvW : List String
    -> List String
    -> List Item
    -> Pair (List String) (List String)
fvW bs ms Nil = MkPair bs ms
fvW bs ms (Cons (IVal (SVar x)) rest) = fvW bs (Cons x ms) rest
fvW bs ms (Cons (IVal (SLam xs (MkBlock t))) rest) =
  fvW (List.append xs bs) ms (Cons (ITl t) rest)
fvW bs ms (Cons (IVal (STag _ as _)) rest) = fvW bs ms (pushVals as rest)
fvW bs ms (Cons (IVal (SRec fs _)) rest) =
  fvW bs ms (pushVals (List.map snd fs) rest)
fvW bs ms (Cons (IVal (SProj v _ _ _)) rest) = fvW bs ms (Cons (IVal v) rest)
fvW bs ms (Cons (IVal (SPrim _ as)) rest) = fvW bs ms (pushVals as rest)
fvW bs ms (Cons (IVal _) rest) = fvW bs ms rest
fvW bs ms (Cons (IOp (OSimple v)) rest) = fvW bs ms (Cons (IVal v) rest)
fvW bs ms (Cons (IOp (OCall _ as)) rest) = fvW bs ms (pushVals as rest)
fvW bs ms (Cons (IOp (OApply f as)) rest) =
  fvW bs ms (pushVals (Cons f as) rest)
fvW bs ms (Cons (IOp (OPrim _ as)) rest) = fvW bs ms (pushVals as rest)
fvW bs ms (Cons (IOp (OBool c)) rest) = fvW bs ms (Cons (ICond c) rest)
fvW bs ms (Cons (IOp _) rest) = fvW bs ms rest
fvW bs ms (Cons (ICond (PRel _ a b)) rest) =
  fvW bs ms (Cons (IVal a) (Cons (IVal b) rest))
fvW bs ms (Cons (ICond (PBool v)) rest) = fvW bs ms (Cons (IVal v) rest)
fvW bs ms (Cons (ICond (PNot c)) rest) = fvW bs ms (Cons (ICond c) rest)
fvW bs ms (Cons (ICond (PIf a b c)) rest) =
  fvW bs ms (Cons (ICond a) (Cons (ICond b) (Cons (ICond c) rest)))
fvW bs ms (Cons (ICond (PLet x o c)) rest) =
  fvW (Cons x bs) ms (Cons (IOp o) (Cons (ICond c) rest))
fvW bs ms (Cons (ICond _) rest) = fvW bs ms rest
fvW bs ms (Cons (ISts Nil) rest) = fvW bs ms rest
fvW bs ms (Cons (ISts (Cons (SLet x o) ss)) rest) =
  fvW (Cons x bs) ms (Cons (IOp o) (Cons (ISts ss) rest))
fvW bs ms (Cons (ISts (Cons (SDecl x) ss)) rest) =
  fvW (Cons x bs) ms (Cons (ISts ss) rest)
fvW bs ms (Cons (ISts (Cons (SSet x o) ss)) rest) =
  fvW bs ms (Cons (IOp o) (Cons (ISts ss) rest))
fvW bs ms (Cons (ISts (Cons (SIf c ts fs) ss)) rest) =
  fvW
    bs
    ms
    (Cons (ICond c) (Cons (ISts ts) (Cons (ISts fs) (Cons (ISts ss) rest))))
fvW bs ms (Cons (ISts (Cons (SCase v arms) ss)) rest) =
  fvW
    (List.append (armVarsOf arms) bs)
    ms
    (Cons (IVal v) (pushStArms arms (Cons (ISts ss) rest)))
fvW bs ms (Cons (ITl (TSeq ss t)) rest) =
  fvW bs ms (Cons (ISts ss) (Cons (ITl t) rest))
fvW bs ms (Cons (ITl (TReturn o)) rest) = fvW bs ms (Cons (IOp o) rest)
fvW bs ms (Cons (ITl (TLoop vs)) rest) = fvW bs ms (pushVals vs rest)
fvW bs ms (Cons (ITl (TIf c t e)) rest) =
  fvW bs ms (Cons (ICond c) (Cons (ITl t) (Cons (ITl e) rest)))
fvW bs ms (Cons (ITl (TCase v arms)) rest) =
  fvW
    (List.append (armVarsOf arms) bs)
    ms
    (Cons (IVal v) (pushTlArms arms rest))

-- (those mentioned not bound: `bs` reckoned once, not for each)
setOf : List String -> Map.Map String Unit
setOf xs =
  List.foldl (\m x -> Map.insert compareString x (MkUnit : Unit) m) Map.empty xs

-- (those of `ms` not in `bs` nor before, in order)
freeGo : Map.Map String Unit
       -> Map.Map String Unit
       -> List String
       -> List String
       -> List String
freeGo bs seen Nil acc = List.reverse acc
freeGo bs seen (Cons v vs) acc =
  if Map.member compareString v bs || Map.member compareString v seen
    then freeGo bs seen vs acc
  else freeGo
      bs
      (Map.insert compareString v (MkUnit : Unit) seen)
      vs
      (Cons v acc)

freeAmong : List String -> List String -> List String
freeAmong bs ms = freeGo (setOf bs) Map.empty ms Nil

freeFrom : List String -> Pair (List String) (List String) -> List String
freeFrom xs (MkPair bs ms) = freeAmong (List.append xs bs) (List.reverse ms)

-- | the variables the items mention and do not bind (nor `xs`), in the
-- | order first mentioned
freeIn : List String -> List Item -> List String
freeIn xs items = freeFrom xs (fvW Nil Nil items)

-- | ... a lambda's body, its parameters `xs`
freeOf : List String -> Imperative.Tl -> List String
freeOf xs t = freeIn xs (Cons (ITl t) Nil)

-- (a variable read a field of at a known shape: a record of its size)
shapedVar : Imperative.Val
          -> List String
          -> List (Pair String Known)
          -> List (Pair String Known)
shapedVar (SVar x) sh acc =
  if List.null sh then acc else Cons (MkPair x (KnownRec (List.length sh))) acc
shapedVar v sh acc = acc

-- | a definition's code, knowing the records it reads fields of at their
-- | shapes -- in its lambdas too, its variables named once in it all
knowingShapes : Imperative.Tl -> CE -> CE
knowingShapes t ce =
  List.foldl
    (\c p -> withKnown (fst p) (snd p) c)
    ce
    (List.foldl
       (\acc p -> case p of
        PartVal (SProj v _ sh _) -> shapedVar v sh acc
        _ -> acc)
       Nil
       (Imperative.tailParts t))

-- Reference counts
--------------------------------------------------------------------------------

unionS : List String -> List String -> List String
unionS xs ys = List.append xs ys

-- | the variables it mentions and does not bind
fvVal : Imperative.Val -> List String
fvVal v = freeIn Nil (Cons (IVal v) Nil)

fvList : List Imperative.Val -> List String
fvList vs = List.concatMap fvVal vs

fvOp : Imperative.Comp -> List String
fvOp o = freeIn Nil (Cons (IOp o) Nil)

fvTl : Imperative.Tl -> List String
fvTl t = freeIn Nil (Cons (ITl t) Nil)

fvSts : List Imperative.St -> List String
fvSts ss = freeIn Nil (Cons (ISts ss) Nil)

-- (of statements and what follows them)
fvRest : List Imperative.St -> Maybe Imperative.Tl -> List String
fvRest ss (Just t) = freeIn Nil (Cons (ISts ss) (Cons (ITl t) Nil))
fvRest ss Nothing = fvSts ss

-- | whether a variable is kept unboxed: no reference, nothing counted
unboxedVar : CE -> String -> Bool
unboxedVar ce x = Repr.unboxedIn ce.reprs x

-- | those of `xs` that are `V`s: what is held of them
boxedOnly : CE -> List String -> List String
boxedOnly ce xs = List.filter (\x -> not (unboxedVar ce x)) xs

-- (a use of `x`: its reference, or one more if it is wanted after or
-- lent; kept unboxed, its value)
varUse : CE -> List String -> String -> Value
varUse ce live x =
  if unboxedVar ce x then RLocal x
  else if elemS x live || elemS x ce.borrowed then RDup x
  else RLocal x

-- (whether a drop gives anything back: a tag of no fields is a word, a
-- closure holding nothing static)
givesBack : Maybe Known -> Bool
givesBack (Just (KnownTag n)) = n > 0
givesBack (Just (KnownClo n)) = n > 0
givesBack _ = True

dropOf : String -> Maybe Known -> List Drop
dropOf x k = if givesBack k then Cons (MkDrop x k) Nil else Nil

-- | the drops of `xs`, each specialised where what it is is known (none
-- | of one kept unboxed)
dropsOf : CE -> List String -> List Drop
dropsOf ce xs =
  List.concatMap
    (\x -> dropOf x (Map.lookup compareString x ce.known))
    (boxedOnly ce xs)

dropsIn : CE -> List String -> List Statement
dropsIn ce xs = List.map (\d -> (CDrop d : Statement)) (dropsOf ce xs)

-- (the drops of `xs`, as nothing is known of them)
plainDrops : List String -> List Statement
plainDrops xs = List.map (\x -> (CDrop (MkDrop x Nothing) : Statement)) xs

-- | what is held and not wanted: given back where a path starts
deadIn : List String -> List String -> List String
deadIn owned wanted = List.filter (\v -> not (elemS v wanted)) owned

-- | what is held and wanted, of what is held
deadKept : List String -> List String -> List String
deadKept owned wanted = List.filter (\v -> elemS v wanted) owned

-- Values
--------------------------------------------------------------------------------

-- | the judgments, knotted: a value (an operand, consumed, `live` what
-- | is wanted after it), as a `V` or as the repr wanted; a step not last
-- | (the same), as the repr wanted; statements (`CE.owned` and
-- | `CE.after` saying what is held and wanted after; then what is last,
-- | if they are followed by it), what is last
type RcK =
  { val : CE -> List String -> Imperative.Val -> Value
  , valAs : CE -> List String -> Repr.Repr -> Imperative.Val -> Value
  , comp : CE -> List String -> Repr.Repr -> Imperative.Comp -> Value
  , stmts : CE -> List Imperative.St -> Maybe Imperative.Tl -> List Statement
  , tail : CE -> Imperative.Tl -> List Statement
  }

varOfV : Imperative.Val -> Maybe String
varOfV (SVar x) = Just x
varOfV _ = Nothing

globalOfV : Imperative.Val -> Maybe String
globalOfV (SGlobal g) = Just g
globalOfV _ = Nothing

-- | operands, left to right: each consumed, wanted after it what the
-- | ones after it want, and `live`
operandsF : RcK -> CE -> List String -> List Imperative.Val -> List Value
operandsF r ce live Nil = Nil
operandsF r ce live (Cons e es) =
  Cons (r.val ce (unionS (fvList es) live) e) (operandsF r ce live es)

-- | ... each as its repr says
operandsAs : RcK
           -> CE
           -> List String
           -> List Repr.Repr
           -> List Imperative.Val
           -> List Value
operandsAs r ce live (Cons rp rps) (Cons e es) =
  Cons (r.valAs ce (unionS (fvList es) live) rp e) (operandsAs r ce live rps es)
operandsAs r ce live _ _ = Nil

elemI : Int -> List Int -> Bool
elemI i Nil = False
elemI i (Cons j js) = i == j || elemI i js

-- (a call's operand at a borrowed parameter, a variable: lent, not
-- given -- held and wanted after by none, dropped after the call)
lentVar : CE -> List String -> String -> Operand
lentVar ce live x =
  if elemS x live || elemS x ce.borrowed then Given (RLocal x)
  else LentVar x (dropsOf ce (Cons x Nil))

-- (a label's place among a shape's labels)
indexIn : String -> Int -> List String -> Maybe Int
indexIn l i Nil = Nothing
indexIn l i (Cons k ks) = if strEq l k then Just i else indexIn l (i + 1) ks

fieldLent : CE -> List String -> String -> Maybe Int -> Maybe Value
fieldLent ce after x (Just i) =
  if elemS x after || elemS x ce.borrowed then Just (RField (RLocal x) i)
  else Nothing
fieldLent ce after x Nothing = Nothing

fieldLentOf : CE -> List String -> Maybe String -> Maybe Int -> Maybe Value
fieldLentOf ce after (Just x) i = fieldLent ce after x i
fieldLentOf ce after Nothing i = Nothing

-- (at a borrowed parameter, a field of a record that outlives the call
-- -- wanted after it (`after`), or lent to this code -- lent on where it
-- is: not counted, up or down.  Not one that may be flat, not a `V`)
lentField : CE -> List String -> Imperative.Val -> Maybe Value
lentField ce after (SProj e l sh t) =
  if Repr.mayBeFlat t then Nothing
  else fieldLentOf ce after (varOfV e) (indexIn l 0 sh)
lentField ce after _ = Nothing

-- (a variable held: a `V`, not one kept unboxed -- which is boxed where
-- it is an operand, a value)
heldOfV : CE -> Imperative.Val -> Maybe String
heldOfV ce (SVar x) = if unboxedVar ce x then Nothing else Just x
heldOfV ce _ = Nothing

-- (a variable lent is wanted through the whole call: lent where it is
-- lent again later (`lent`, held and dropped after the call by the last
-- that lends it), and counted where it is given too, before or after
-- (`live`) -- the callee may take apart in place what it is given, and
-- read what it is lent)
lentVarOr : RcK
          -> CE
          -> List String
          -> List String
          -> List Int
          -> Int
          -> Imperative.Val
          -> Maybe String
          -> Operand
lentVarOr r ce lent live bi i e (Just x) =
  if elemI i bi then lentVar ce lent x else Given (r.val ce live e)
lentVarOr r ce lent live bi i e Nothing =
  if elemI i bi then LentValue (r.val ce live e) else Given (r.val ce live e)

lentOr : RcK
       -> CE
       -> List String
       -> List String
       -> List Int
       -> Int
       -> Imperative.Val
       -> Maybe Value
       -> Operand
lentOr r ce lent live bi i e (Just a) = Given a
lentOr r ce lent live bi i e Nothing =
  lentVarOr r ce lent live bi i e (heldOfV ce e)

lentOne : RcK
        -> CE
        -> List String
        -> List String
        -> List String
        -> List Int
        -> Int
        -> Imperative.Val
        -> Operand
lentOne r ce after lent live bi i e =
  lentOr
    r
    ce
    lent
    live
    bi
    i
    e
    (if elemI i bi then lentField ce after e else Nothing)

consHeld : Maybe String -> List String -> List String
consHeld (Just x) xs = Cons x xs
consHeld Nothing xs = xs

-- | the variables a call lends, at its borrowed parameters from the
-- | `i`th on
lentIn : CE -> List Int -> Int -> List Imperative.Val -> List String
lentIn ce bi i Nil = Nil
lentIn ce bi i (Cons e es) =
  if elemI i bi then consHeld (heldOfV ce e) (lentIn ce bi (i + 1) es)
  else lentIn ce bi (i + 1) es

-- (the variables lent so far, and the `i`th's if it is)
lentThen : CE -> List Int -> Int -> Imperative.Val -> List String -> List String
lentThen ce bi i e before =
  if elemI i bi then consHeld (heldOfV ce e) before else before

-- (the `i`th operand, `before` lent before it: wanted after it, lent
-- after it, and given)
lentAt : RcK
       -> CE
       -> List String
       -> List String
       -> List Int
       -> Int
       -> Imperative.Val
       -> List Imperative.Val
       -> Operand
lentAt r ce live before bi i e es =
  lentOne
    r
    ce
    live
    (unionS (lentIn ce bi (i + 1) es) live)
    (unionS before (unionS (fvList es) live))
    bi
    i
    e

-- (an operand of a known call, of a parameter its worker takes as `rp`
-- (#39): unboxed, given so; else given or lent, as `lentOne` has it)
sigOne : RcK
       -> CE
       -> List String
       -> List String
       -> List Int
       -> Int
       -> Repr.Repr
       -> Imperative.Val
       -> List Imperative.Val
       -> Operand
sigOne r ce live before bi i RepV e es = lentAt r ce live before bi i e es
sigOne r ce live before bi i rp e es =
  GivenU rp (r.valAs ce (unionS before (unionS (fvList es) live)) rp e)

sigOperands : RcK
            -> CE
            -> List String
            -> List String
            -> List Int
            -> Int
            -> List Repr.Repr
            -> List Imperative.Val
            -> List Operand
sigOperands r ce live before bi i (Cons rp rps) (Cons e es) =
  Cons
    (sigOne r ce live before bi i rp e es)
    (sigOperands r ce live (lentThen ce bi i e before) bi (i + 1) rps es)
sigOperands r ce live before bi i _ _ = Nil

-- | the operands of a known call of `g`: as its worker takes them, if it
-- | has one, each else given or lent
callOperands : RcK
             -> CE
             -> List String
             -> String
             -> List Imperative.Val
             -> List Operand
callOperands r ce live g as =
  sigOperands
    r
    ce
    live
    Nil
    (Borrow.borOf ce.bor g)
    0
    (Repr.paramReprsIn ce.sigs g as)
    as

-- | the worker a known call of `g` calls, by what it gives (`Nothing`:
-- | none, the function itself)
workerOf : CE -> String -> Maybe Repr.Repr
workerOf ce g =
  maybe Nothing (\(sg : Repr.Sig) -> Just sg.result) (Repr.sigIn ce.sigs g)

toWorker : Maybe Repr.Repr -> Bool
toWorker (Just _) = True
toWorker Nothing = False

-- | whether each operand is given, none lent
plainArg : Operand -> Bool
plainArg (Given _) = True
plainArg (GivenU _ _) = True
plainArg (LentVar _ Nil) = True
plainArg _ = False

lentPlain : List Operand -> Bool
lentPlain ls = List.all plainArg ls

-- | an operand's value, as the call is given it
argExp : Operand -> Value
argExp (Given e) = e
argExp (GivenU _ e) = e
argExp (LentVar x _) = RLocal x
argExp (LentValue e) = e

lamBody : RcK
        -> CE
        -> List String
        -> Imperative.Tl
        -> List String
        -> List Statement
lamBody r ce xs t fv =
  r.tail
    (withPath
       (boxedOnly ce (deadKept (List.append xs fv) (fvTl t)))
       Nil
       (withBorrowed Nil (withFrame Nothing (List.length xs) ce)))
    t

-- Unboxed where a body starts (#39): a parameter kept unboxed -- of a
-- function, of a lambda, or what a lambda's closure holds -- is given as
-- a `V`, named `box$x`, and unboxed first: consumed, or, lent, looked at.

boxName : String -> String
boxName x = "box$" ^ x

-- | a parameter's name, as the body is given it
givenName : CE -> String -> String
givenName ce x = if unboxedVar ce x then boxName x else x

unboxAs : Bool -> Repr.Repr -> Value -> Value
unboxAs True rp v = RPeek rp v
unboxAs False rp v = RUnbox rp v

-- | where a body starts: a parameter kept unboxed unboxed (`lent`: looked
-- | at)
unboxParam : CE -> Bool -> String -> List Statement
unboxParam ce lent x =
  if unboxedVar ce x
    then Cons
        (CLet x (unboxAs lent (Repr.reprOf ce.reprs x) (RLocal (boxName x))))
        Nil
  else Nil

lamWith : RcK
        -> CE
        -> List String
        -> List String
        -> Imperative.Tl
        -> List String
        -> Value
lamWith r ce live xs t fv =
  RLam
    (List.map (givenName ce) xs)
    (List.map (givenName ce) fv)
    (List.map (\x -> r.val ce live (SVar x)) fv)
    (MkCode
       (List.append
          (List.concatMap (unboxParam ce False) (List.append xs fv))
          (List.append
             (plainDrops (boxedOnly ce (deadIn xs (fvTl t))))
             (lamBody r ce xs t fv))))

-- | a lambda's closure: what it mentions held, each a use of it here
lamVal : RcK -> CE -> List String -> List String -> Imperative.Tl -> Value
lamVal r ce live xs t = lamWith r ce live xs t (freeOf xs t)

-- (the primitive a tag built in a kept cell is, while it is made: see
-- `reusing`)
reusePrim : String
reusePrim = "$reuse"

-- (field `i` of a record, counted, the record not touched: one that may
-- be flat (#39) boxed if it is)
fieldDup : Bool -> Value -> Int -> Value
fieldDup True e i = RFieldV e i
fieldDup False e i = RDupE (RField e i)

-- (field `i` of a record of `n` fields, read where it is: of a variable
-- wanted after or lent, or of a definition's value, the field counted and
-- the record not touched; otherwise the record consumed, the field taken
-- over where it was the last reference.  `may`: it may be flat)
fieldIn : RcK
        -> CE
        -> List String
        -> Imperative.Val
        -> Int
        -> Int
        -> Bool
        -> Maybe String
        -> Maybe String
        -> Value
fieldIn r ce live e i n may (Just x) g =
  if elemS x live || elemS x ce.borrowed then fieldDup may (RLocal x) i
  else RGetN (RLocal x) i n
fieldIn r ce live e i n may Nothing (Just g) = fieldDup may (RGetRaw g) i
fieldIn r ce live e i n may Nothing Nothing = RGetN (r.val ce live e) i n

fieldAt : RcK
        -> CE
        -> List String
        -> Imperative.Val
        -> Int
        -> Int
        -> Bool
        -> Value
fieldAt r ce live e i n may =
  fieldIn r ce live e i n may (varOfV e) (globalOfV e)

-- (... a number of the repr `rp`, flat or not: see `fieldIn`)
fieldNum : RcK
         -> CE
         -> List String
         -> Imperative.Val
         -> Repr.Repr
         -> Int
         -> Int
         -> Maybe String
         -> Maybe String
         -> Value
fieldNum r ce live e rp i n (Just x) g =
  if elemS x live || elemS x ce.borrowed then RFieldU rp (RLocal x) i
  else RGetNU rp (RLocal x) i n
fieldNum r ce live e rp i n Nothing (Just g) = RFieldU rp (RGetRaw g) i
fieldNum r ce live e rp i n Nothing Nothing = RGetNU rp (r.val ce live e) i n

-- (the field taken out of its record, if this operand takes it and the
-- record is wanted after it: see `takesFor`)
takeVarIn : List (Pair String String)
          -> List String
          -> Maybe String
          -> String
          -> Int
          -> Maybe Value
takeVarIn ts live (Just x) l i =
  if elemS x live && List.any (\p -> strEq (fst p) x && strEq (snd p) l) ts
    then Just (RTakeField x i)
  else Nothing
takeVarIn ts live Nothing l i = Nothing

takeIn : List (Pair String String)
       -> List String
       -> Imperative.Val
       -> String
       -> Int
       -> Maybe Value
takeIn ts live e l i = takeVarIn ts live (varOfV e) l i

fieldOr : RcK
        -> CE
        -> List String
        -> Imperative.Val
        -> Int
        -> Int
        -> Bool
        -> Maybe Value
        -> Value
fieldOr r ce live e i n may (Just t) = t
fieldOr r ce live e i n may Nothing = fieldAt r ce live e i n may

-- | a field, a `V`: at its place, where the record's shape is known; else
-- | looked for by its label
projAt : RcK
       -> CE
       -> List String
       -> Imperative.Val
       -> String
       -> IR.FieldTy
       -> Int
       -> Maybe Int
       -> Value
projAt r ce live e l t n (Just i) =
  fieldOr r ce live e i n (Repr.mayBeFlat t) (takeIn ce.takes live e l i)
projAt r ce live e l t n Nothing = RGetLabel (r.val ce live e) l

-- Records updated: a record built of the same shape as one it reads
-- fields of at their own places, `{ a = x, b = r.b, c = r.c }`, the one
-- read (`r`) held and given up there, is built in `r`'s cell where that
-- is `r`'s last reference: the fields kept where they are, the others
-- computed first -- `r` wanted by them still -- and stored in it.

sameS : List String -> List String -> Bool
sameS Nil Nil = True
sameS (Cons x xs) (Cons y ys) = strEq x y && sameS xs ys
sameS _ _ = False

-- (a field read from a record's at its own place, that record's shape
-- `ls`, the one being built: the record read)
keptFrom : List String -> Pair String Imperative.Val -> Maybe String
keptFrom ls (MkPair l (SProj e l2 sh _)) =
  if strEq l l2 && sameS ls sh then varOfV e else Nothing
keptFrom ls _ = Nothing

isJustOf : String -> Maybe String -> Bool
isJustOf x (Just y) = strEq x y
isJustOf x Nothing = False

isKeptFrom : List String -> String -> Pair String Imperative.Val -> Bool
isKeptFrom ls x f = isJustOf x (keptFrom ls f)

justsOf : List (Maybe String) -> List String
justsOf Nil = Nil
justsOf (Cons (Just x) rest) = Cons x (justsOf rest)
justsOf (Cons Nothing rest) = justsOf rest

-- (the first record a field is kept from that this code holds and gives
-- up here: wanted by nothing after, nor lent)
updatedIn : CE
          -> List String
          -> List String
          -> List (Pair String Imperative.Val)
          -> Maybe String
updatedIn ce live ls fs =
  if List.length fs > 62 then Nothing
  else List.head
      (List.filter
         (\x ->
            elemS x ce.owned && not (elemS x live) && not (elemS x ce.borrowed))
         (justsOf (List.map (keptFrom ls) fs)))

-- (a bit for each field kept, the first the lowest)
keepBits : List Bool -> Int
keepBits Nil = 0
keepBits (Cons b bs) = (if b then 1 else 0) + 2 * keepBits bs

-- (the fields not kept from `x`, each with its place)
changedOf : List String
          -> String
          -> List (Pair String Imperative.Val)
          -> List (Pair Int Imperative.Val)
changedOf ls x fs =
  List.map
    (\p -> MkPair (snd p) (snd (fst p)))
    (List.filter
       (\p -> not (isKeptFrom ls x (fst p)))
       (List.zipWith
          (\f i -> MkPair f i)
          fs
          (List.range 0 (List.length fs - 1))))

-- Flat fields (#39): a field is stored as `Repr.slotRepr` says of its
-- type, flat (its bits, `RWord`) or a `V`, and the record built says
-- which are flat; one updated keeps the bits of the fields kept.

-- (field `i`'s type, of a record's)
tyAt : Int -> List IR.FieldTy -> IR.FieldTy
tyAt i Nil = FtOther
tyAt i (Cons t ts) = if i <= 0 then t else tyAt (i - 1) ts

slotAt : List IR.FieldTy -> Int -> Repr.Repr
slotAt ts i = Repr.slotRepr i (tyAt i ts)

-- (a field's value, as it is stored: its bits, if flat)
wordOf : Repr.Repr -> Value -> Value
wordOf RepV v = v
wordOf rp v = RWord rp v

-- (the fields' values, as they are stored, each of the repr given)
storedAs : RcK
         -> CE
         -> List String
         -> List Repr.Repr
         -> List Imperative.Val
         -> List Value
storedAs r ce live rps vs =
  List.zipWith wordOf rps (operandsAs r ce live rps vs)

-- (the bits a tag's flat fields are said by, of how they are stored)
slotBits : List Repr.Repr -> Int
slotBits rps = Repr.flatBits (List.zip (List.range 0 (List.length rps - 1)) rps)

-- | a tag built, each field stored as `Repr.tagSlots` says of its type
-- | (#64)
tagVal : RcK
       -> CE
       -> List String
       -> String
       -> List Imperative.Val
       -> List IR.FieldTy
       -> Value
tagVal r ce live t as ts =
  RTag
    t
    (slotBits (Repr.tagSlots ts (List.length as)))
    (storedAs r ce live (Repr.tagSlots ts (List.length as)) as)

-- | ... in the cell `ru` kept for it
reuseVal : RcK -> CE -> List String -> List Imperative.Val -> Value
reuseVal r ce live (Cons ru (Cons (STag t as ts) Nil)) =
  RTagIn
    (r.val ce (unionS (fvList as) live) ru)
    t
    (slotBits (Repr.tagSlots ts (List.length as)))
    (storedAs r ce live (Repr.tagSlots ts (List.length as)) as)
reuseVal r ce live _ = RInt 0

-- | a record built from `x`'s
updateVal : RcK
          -> CE
          -> List String
          -> List (Pair String Imperative.Val)
          -> List IR.FieldTy
          -> String
          -> List (Pair Int Imperative.Val)
          -> Value
updateVal r ce live fs ts x changed =
  RRecIn
    x
    (keepBits (List.map (isKeptFrom (List.map fst fs) x) fs))
    (Repr.keptBits
       (List.filter
          (\i -> not (List.any (\p -> fst p == i) changed))
          (List.range 0 (List.length fs - 1))))
    (Repr.flatBits
       (List.map (\p -> MkPair (fst p) (slotAt ts (fst p))) changed))
    (List.length fs)
    (List.map fst fs)
    (List.zipWith
       (\p v -> MkPair (fst p) v)
       changed
       (storedAs
          r
          ce
          (Cons x live)
          (List.map (\p -> slotAt ts (fst p)) changed)
          (List.map snd changed)))

-- | a record built: in the cell of the one it is updated from, if any
recordVal : RcK
          -> CE
          -> List String
          -> List (Pair String Imperative.Val)
          -> List IR.FieldTy
          -> Maybe String
          -> Value
recordVal r ce live fs ts (Just x) =
  updateVal r ce live fs ts x (changedOf (List.map fst fs) x fs)
recordVal r ce live fs ts Nothing =
  RRec
    (List.map fst fs)
    (Repr.flatBits
       (List.map
          (\i -> MkPair i (slotAt ts i))
          (List.range 0 (List.length fs - 1))))
    (storedAs
       r
       ce
       live
       (List.map (slotAt ts) (List.range 0 (List.length fs - 1)))
       (List.map snd fs))

valF : RcK -> CE -> List String -> Imperative.Val -> Value
valF r ce live (SVar x) = varUse ce live x
valF r ce live (SGlobal g) =
  if Map.member compareString g ce.funs then RClo g else RGet g
valF r ce live (SInt n) = RInt n
valF r ce live (SFloat x) = RFloat x
valF r ce live (SStr s) = RStr s
valF r ce live (SBytes s) = RBytes s
valF r ce live (SFixed w n) = RFixed w n
valF r ce live (SFloat32 x) = RF32 x
valF r ce live (STag t as ts) =
  if List.null as then RNTag t else tagVal r ce live t as ts
valF r ce live (SRec fs ts) =
  recordVal r ce live fs ts (updatedIn ce live (List.map fst fs) fs)
valF r ce live (SProj e l sh t) =
  projAt r ce live e l t (List.length sh) (indexIn l 0 sh)
valF r ce live (SPrimFn p) = RPrimFn p
valF r ce live (SPrim p as) =
  if strEq p reusePrim then reuseVal r ce live as
  else RPrim p (operandsF r ce live as)
valF r ce live (SLam xs (MkBlock t)) = lamVal r ce live xs t

-- Boxes (#39): a value is made as it comes -- a variable as it is kept,
-- a primitive done unboxed (`Repr.primShape`) as it gives, anything else
-- a `V` -- and boxed or unboxed where another repr is wanted; a literal
-- is made as it is wanted.

-- (unboxed, a `V` consumed; one whose reference was taken just to be
-- given up, looked at instead)
unboxOf : Repr.Repr -> Value -> Value
unboxOf rp (RDup x) = RPeek rp (RLocal x)
unboxOf rp (RDupE e) = RPeek rp e
unboxOf rp (RGet g) = RPeek rp (RGetRaw g)
unboxOf rp v = RUnbox rp v

-- | a value of the repr `from`, as one of `to`
coerce : Repr.Repr -> Repr.Repr -> Value -> Value
coerce from to v =
  if Repr.reprEq from to then v
  else if Repr.isBoxed to then RBox from v
  else if Repr.isBoxed from then unboxOf to v
  else unboxOf to (RBox from v)

-- (the repr a value comes as)
naturalOf : CE -> Imperative.Val -> Repr.Repr
naturalOf ce (SVar x) = Repr.reprOf ce.reprs x
naturalOf ce (SPrim p _) = Repr.resultRepr p
naturalOf ce v = RepV

isRepFix : Fixed.Fixed -> Repr.Repr -> Bool
isRepFix w rp = Repr.reprEq (RepFix w) rp

primAs : RcK
       -> CE
       -> List String
       -> Repr.Repr
       -> String
       -> List Imperative.Val
       -> Maybe Repr.Shape
       -> Value
primAs r ce live want p as (Just sh) =
  coerce sh.result want (RPrimU p (operandsAs r ce live sh.args as))
primAs r ce live want p as Nothing =
  coerce RepV want (valF r ce live (SPrim p as))

-- | a field `v` of `e`, as the repr `want`: a number kept as `rp` (where
-- | it may be flat, `Repr.readRepr`) read as one, where one is wanted;
-- | otherwise a `V`
projAs : RcK
       -> CE
       -> List String
       -> Repr.Repr
       -> Imperative.Val
       -> Imperative.Val
       -> Int
       -> Maybe Int
       -> Repr.Repr
       -> Value
projAs r ce live want v e n (Just i) rp =
  if Repr.isBoxed rp || Repr.isBoxed want
    then coerce RepV want (valF r ce live v)
  else coerce rp want (fieldNum r ce live e rp i n (varOfV e) (globalOfV e))
projAs r ce live want v e n Nothing rp = coerce RepV want (valF r ce live v)

-- | a value, as the repr `want`
valAsF : RcK -> CE -> List String -> Repr.Repr -> Imperative.Val -> Value
valAsF r ce live want (SFixed w n) =
  if isRepFix w want then RFixU w n else coerce RepV want (RFixed w n)
valAsF r ce live want (SFloat x) =
  if Repr.reprEq RepF64 want then RF64U x else coerce RepV want (RFloat x)
valAsF r ce live want (SFloat32 x) =
  if isRepFix F32 want then RF32U x else coerce RepV want (RF32 x)
valAsF r ce live want (SPrim p as) =
  primAs r ce live want p as (Repr.primShape p)
valAsF r ce live want (SProj e l sh t) =
  projAs
    r
    ce
    live
    want
    (SProj e l sh t)
    e
    (List.length sh)
    (indexIn l 0 sh)
    (Repr.readRepr (indexIn l 0 sh) t)
valAsF r ce live want v = coerce (naturalOf ce v) want (valF r ce live v)

-- (a condition's code: what is held lent to it -- see `Cond`)
lentTo : CE -> CE
lentTo ce = withTakes Nil (withBorrowed (List.append ce.owned ce.borrowed) ce)

relWith : RcK
        -> CE
        -> List String
        -> String
        -> List Imperative.Val
        -> Maybe Repr.Shape
        -> Test
relWith r ce live p args (Just sh) =
  CondRelU p (operandsAs r ce live sh.args args)
relWith r ce live p args Nothing = CondRel p (operandsF r ce live args)

-- | a comparison: of unboxed operands, where it is done so
relTest : RcK -> CE -> List String -> String -> List Imperative.Val -> Test
relTest r ce live p args = relWith r ce live p args (Repr.primShape p)

-- | a condition, its operands lent (`ce` as `lentTo` makes it); a name
-- | bound in it lent to what follows in it, dropped after
condF : RcK -> CE -> Imperative.Cond -> Test
condF r ce PTrue = CondTrue
condF r ce PFalse = CondFalse
condF r ce (PRel p a b) = relTest r ce Nil p [a, b]
condF r ce (PBool v) = CondBool (r.val ce Nil v)
condF r ce (PNot c) = CondNot (condF r ce c)
condF r ce (PIf a b c) = CondIf (condF r ce a) (condF r ce b) (condF r ce c)
condF r ce (PLet x o c) =
  CondLet
    x
    (r.comp ce Nil (Repr.reprOf ce.reprs x) o)
    (condF r (withBorrowed (Cons x ce.borrowed) ce) c)
    (List.map (\y -> MkDrop y Nothing) (boxedOnly ce (Cons x Nil)))

-- (a step not last, as a `V`)
compV : RcK -> CE -> List String -> Imperative.Comp -> Value
compV r ce live (OApply f as) = case operandsF r ce live (Cons f as) of
  Cons fv vs -> RApply fv vs
  Nil -> RAbandon
compV r ce live (OCall g as) =
  RCall
    g
    (Map.member compareString g ce.bounce)
    (workerOf ce g)
    (callOperands r ce live g as)
compV r ce live (OPrim p as) = RPrim p (operandsF r ce live as)
compV r ce live (OSimple v) = r.val ce live v
compV r ce live OAbandon = RAbandon
compV r ce live (OBool c) = RBool (condF r (lentTo ce) c)

-- | a step not last: its value, through any bounces, as the repr wanted
compF : RcK -> CE -> List String -> Repr.Repr -> Imperative.Comp -> Value
compF r ce live want (OSimple v) = r.valAs ce live want v
compF r ce live want (OCall g as) =
  coerce (Repr.resultIn ce.sigs g) want (compV r ce live (OCall g as))
compF r ce live want o = coerce RepV want (compV r ce live o)

-- Statements and what is last
--------------------------------------------------------------------------------

-- | an arm's body: what is last, or statements (that set a name; the
-- | arm then leaves the `switch`)
data ArmBody = ATail Imperative.Tl | ASts (List Imperative.St)

fvArm : ArmBody -> List String
fvArm (ATail t) = fvTl t
fvArm (ASts ss) = fvSts ss

armLeaves : ArmBody -> Bool
armLeaves (ATail _) = False
armLeaves (ASts _) = True

armBodyF : RcK -> CE -> ArmBody -> List Statement
armBodyF r ce (ATail t) = r.tail ce t
armBodyF r ce (ASts ss) = r.stmts ce ss Nothing

isSelfCall : CE -> String -> List Imperative.Val -> Bool
isSelfCall { self = Just s } g as =
  strEq s.key g && List.length s.params == List.length as
isSelfCall { self = Nothing } g as = False

-- (the loop again: its parameters given the arguments)
again : CE -> List Value -> List Statement
again { self = Just s } vs = Cons (CLoop s.params vs) Nil
again { self = Nothing } vs = Nil

arityIs : Int -> Maybe Int -> Bool
arityIs n (Just m) = n == m
arityIs n Nothing = False

agreesWith : Maybe Self -> Maybe Int -> Int -> Bool
agreesWith (Just s) m n = List.length s.params == n && arityIs n m
agreesWith Nothing m n = False

-- (whether two functions' workers, if any, are of one signature)
sameSigs : Maybe Repr.Sig -> Maybe Repr.Sig -> Bool
sameSigs (Just a) (Just b) = Repr.sigEq a b
sameSigs Nothing Nothing = True
sameSigs a b = False

sameAs : CE -> Maybe Self -> String -> Bool
sameAs ce (Just s) g =
  sameSigs (Repr.sigIn ce.sigs s.key) (Repr.sigIn ce.sigs g)
sameAs ce Nothing g = False

-- (a call last of `g`, from a definition taking as many parameters as
-- `g` does, and taking and giving them as `g` does (#39,
-- heff.compile.worker): their C functions' types the same, the call a
-- jump)
agrees : CE -> String -> List Imperative.Val -> Bool
agrees ce g as =
  agreesWith ce.self (Map.lookup compareString g ce.funs) (List.length as)
  && sameAs ce ce.self g

-- | how many arguments a lambda's call last may put in `heff_room`
-- | (lib/c/runtime.c's `HEFF_ROOM`)
roomFor : Int
roomFor = 4

-- (a call last of an unknown function, from a lambda: taking at least as
-- many arguments, they are put where the lambda's were (`CInPlace`);
-- fewer, of no more than fit in `heff_room`, put there (`CRoomed`).
-- Anything else, as any call last of an unknown function: `CTail`)
applyLast : CE -> Int -> List Value -> List Statement
applyLast ce n (Cons f vs) =
  Cons
    (if 0 < n && n <= ce.lam then CInPlace f vs
     else if 0 < ce.lam && n <= roomFor then CRoomed f vs
     else CTail f vs)
    Nil
applyLast ce n Nil = Cons (CReturn RAbandon) Nil

-- (the scrutinee, a variable held, given up on an arm that does not want
-- it and has fields: `fb` what the arm wants)
takenFv : CE -> Maybe String -> List String -> List String -> Maybe String
takenFv ce Nothing vs fb = Nothing
takenFv ce (Just x) vs fb =
  if not (List.null vs)
  && List.length vs <= 60
  && not (elemS x fb)
  && not (elemS x ce.after)
    then Just x
  else Nothing

maybeList : Maybe String -> List String
maybeList Nothing = Nil
maybeList (Just x) = Cons x Nil

isJustS : Maybe String -> Bool
isJustS (Just _) = True
isJustS Nothing = False

-- (the fields an arm holds a reference to: those it wants, unless lent)
fieldsHeld : Bool -> List String -> List String -> List String
fieldsHeld True vs fb = Nil
fieldsHeld False vs fb = List.filter (\v -> elemS v fb) vs

-- (the fields an arm wants, each with its place)
fieldsWanted : List String -> List String -> List (Pair String Int)
fieldsWanted vs fb =
  List.filter
    (\p -> elemS (fst p) fb)
    (List.zipWith (\v i -> MkPair v i) vs (List.range 0 (List.length vs - 1)))

pow2 : Int -> Int
pow2 0 = 1
pow2 n = 2 * pow2 (n - 1)

fieldMask : List String -> Int -> List String -> Int
fieldMask used i Nil = 0
fieldMask used i (Cons v vs) =
  (if elemS v used then pow2 i else 0) + fieldMask used (i + 1) vs

-- Fields that may be flat (#64): a field of a tag that any tag of it is
-- built with flat (`ce.flat`) is read as the tag holds it, as its
-- variable is kept (heff.compile.repr leaves it unpinned): a number, or a
-- `V` of its own -- counted, a box if it is flat -- held by the arm, not
-- lent nor kept in the tag's mask (whose drop skips a flat field).

-- (those of `xs` not in `ys`)
minusS : List String -> List String -> List String
minusS xs Nil = xs
minusS xs ys = List.filter (\x -> not (elemS x ys)) xs

-- | how an arm reads the fields it wants: those that may not be flat, as
-- | ever; those that may (each read as the repr), their names, those of
-- | them read as `V`s of their own; whether the tag may have flat fields
type Reads =
  { plain : List (Pair String Int)
  , flats : List FlatRead
  , names : List String
  , counted : List String
  , flat : Bool
  , sure : List Int
  }

-- (those of the wanted `ws` that may be flat, of the places `ps`)
flatOnes : CE -> List Int -> List (Pair String Int) -> List FlatRead
flatOnes ce ps ws =
  List.map
    (\p -> MkPair (fst p) (MkPair (snd p) (Repr.reprOf ce.reprs (fst p))))
    (List.filter (\p -> elemI (snd p) ps) ws)

readsFrom : List Int -> List (Pair String Int) -> List FlatRead -> Reads
readsFrom su ws fs =
  { plain =
      List.filter (\p -> not (List.any (\q -> strEq (fst q) (fst p)) fs)) ws
  , flats = fs
  , names = List.map fst fs
  , counted = List.map fst (List.filter (\q -> Repr.isBoxed (snd (snd q))) fs)
  , flat = True
  , sure = su
  }

readsWith : CE
          -> List Int
          -> List (Pair String Int)
          -> Maybe (List Int)
          -> Reads
readsWith ce su ws (Just ps) = readsFrom su ws (flatOnes ce ps ws)
readsWith ce su ws Nothing =
  { plain = ws
  , flats = Nil
  , names = Nil
  , counted = Nil
  , flat = False
  , sure = Nil
  }

-- | how an arm of the tag `t` reads the fields it wants
readsOf : CE -> String -> List (Pair String Int) -> Reads
readsOf ce t ws =
  readsWith
    ce
    (fromMaybe Nil (Map.lookup compareString t ce.sure))
    ws
    (Map.lookup compareString t ce.flat)

-- (the fields an arm holds a reference to: those it wants, unless lent;
-- those of them read counted, always)
heldOf : Bool -> List String -> List String -> List String -> List String
heldOf True vs fb counted = counted
heldOf False vs fb counted = fieldsHeld False vs fb

-- (whether place `i` is in the mask)
inMask : Int -> Int -> Bool
inMask mask i = (mask / pow2 i) % 2 == 1

-- (what is known of the fields not in the mask, of `n`: whether the tag
-- may have flat fields, the places of those it surely has)
flatnessOf : Bool -> List Int -> Int -> Int -> Flatness
flatnessOf False su mask n = FlatNone
flatnessOf True su mask n =
  if List.all
    (\i -> inMask mask i || List.any (\j -> j == i) su)
    (List.range 0 (n - 1))
    then FlatAll
  else FlatSome

-- (what an arm does with the scrutinee it gives up (`taken`): its cell
-- kept (`ru`), or given up at once; the fields it wants kept)
takeOf : Bool
       -> List Int
       -> Maybe String
       -> Maybe String
       -> List String
       -> List String
       -> Take
takeOf fl su (Just ru) taken vs used =
  TakeKeep
    (flatnessOf fl su (fieldMask used 0 vs) (List.length vs))
    ru
    (fieldMask used 0 vs)
    (List.length vs)
takeOf fl su Nothing (Just _) vs used =
  TakeN
    (flatnessOf fl su (fieldMask used 0 vs) (List.length vs))
    (fieldMask used 0 vs)
    (List.length vs)
takeOf fl su Nothing Nothing vs used = TakeNone

-- Cells kept
--------------------------------------------------------------------------------

-- An arm whose scrutinee is given up keeps its cell where the arm builds
-- a tag of its size: the first such tag built on each path (in a binding
-- before what follows it, an operand of a call or of a tag before the
-- operands after it, each arm of a match), not in a lambda, is built in
-- the cell (`$reuse`, `reuseVal`).

argDone : List Imperative.Val
        -> Pair Bool Imperative.Val
        -> Pair Bool (List Imperative.Val)
argDone done (MkPair b e) = MkPair b (List.append done (Cons e Nil))

-- | the tag a kept cell is wanted for: of `n` fields, and its own tag
-- | (`tag`), or any (`""`)
type Want = { n : Int, tag : String }

-- (a tag built that may be built in the kept cell)
fits : Want -> String -> List Imperative.Val -> Bool
fits w t as = List.length as == w.n && (strEq w.tag "" || strEq w.tag t)

-- (operands, the first that builds a tag of `n` fields in the kept cell)
reuseArgs : (Imperative.Val -> Pair Bool Imperative.Val)
          -> List Imperative.Val
          -> Pair Bool (List Imperative.Val)
reuseArgs go vs =
  List.foldl
    (\acc v ->
       if fst acc then MkPair True (List.append (snd acc) (Cons v Nil))
       else argDone (snd acc) (go v))
    (MkPair False Nil)
    vs

withTag : String
        -> List IR.FieldTy
        -> Pair Bool (List Imperative.Val)
        -> Pair Bool Imperative.Val
withTag t ts (MkPair b as) = MkPair b (STag t as ts)

-- (a tag of `n` fields, built in the cell; or one of its operands)
reuseV : String -> Want -> Imperative.Val -> Pair Bool Imperative.Val
reuseV ru n (STag t as ts) =
  if fits n t as
    then MkPair
        True
        (SPrim reusePrim (Cons (SVar ru) (Cons (STag t as ts) Nil)))
  else withTag t ts (reuseArgs (\v -> reuseV ru n v) as)
reuseV ru n v = MkPair False v

reuseVals : String
          -> Want
          -> List Imperative.Val
          -> Pair Bool (List Imperative.Val)
reuseVals ru n vs = reuseArgs (\v -> reuseV ru n v) vs

reuseOp : String -> Want -> Imperative.Comp -> Pair Bool Imperative.Comp
reuseOp ru n (OSimple v) = case reuseV ru n v of
  MkPair b v2 -> MkPair b (OSimple v2)
reuseOp ru n (OCall g as) = case reuseVals ru n as of
  MkPair b as2 -> MkPair b (OCall g as2)
reuseOp ru n o = MkPair False o

-- | the walk, knotted: statements (each path's first, then what follows
-- | where none was), what is last
type ReuseK =
  { sts : String -> Want -> List Imperative.St -> Pair Bool (List Imperative.St)
  , tl : String -> Want -> Imperative.Tl -> Pair Bool Imperative.Tl
  }

consSt : Imperative.St
       -> Pair Bool (List Imperative.St)
       -> Pair Bool (List Imperative.St)
consSt st (MkPair b ss) = MkPair b (Cons st ss)

-- (each arm, apart)
stArms : ReuseK
       -> String
       -> Want
       -> List (Imperative.Arm (List Imperative.St))
       -> Pair Bool (List (Imperative.Arm (List Imperative.St)))
stArms r ru n arms =
  MkPair
    (List.any
       (\arm -> case arm of
        MkArm _ _ ss -> fst (r.sts ru n ss))
       arms)
    (List.map
       (\arm -> case arm of
        MkArm t vs ss -> MkArm t vs (snd (r.sts ru n ss)))
       arms)

tlArms : ReuseK
       -> String
       -> Want
       -> List (Imperative.Arm Imperative.Tl)
       -> Pair Bool (List (Imperative.Arm Imperative.Tl))
tlArms r ru n arms =
  MkPair
    (List.any
       (\arm -> case arm of
        MkArm _ _ t -> fst (r.tl ru n t))
       arms)
    (List.map
       (\arm -> case arm of
        MkArm t vs b -> MkArm t vs (snd (r.tl ru n b)))
       arms)

-- (a statement that builds one, and what follows it unsearched; else the
-- statement and what follows searched)
stThen : ReuseK
       -> String
       -> Want
       -> List Imperative.St
       -> Pair Bool Imperative.St
       -> Pair Bool (List Imperative.St)
stThen r ru n rest (MkPair True st) = MkPair True (Cons st rest)
stThen r ru n rest (MkPair False st) = consSt st (r.sts ru n rest)

reuseSts : ReuseK
         -> String
         -> Want
         -> List Imperative.St
         -> Pair Bool (List Imperative.St)
reuseSts r ru n Nil = MkPair False Nil
reuseSts r ru n (Cons (SLet x o) rest) =
  stThen r ru n rest (case reuseOp ru n o of
  MkPair b o2 -> MkPair b (SLet x o2))
reuseSts r ru n (Cons (SSet x o) rest) =
  stThen r ru n rest (case reuseOp ru n o of
  MkPair b o2 -> MkPair b (SSet x o2))
reuseSts r ru n (Cons (SCase v arms) rest) =
  stThen r ru n rest (case stArms r ru n arms of
  MkPair b as2 -> MkPair b (SCase v as2))
reuseSts r ru n (Cons (SIf c ts fs) rest) =
  stThen r ru n rest (case r.sts ru n ts of
  MkPair bt ts2 -> case r.sts ru n fs of
    MkPair bf fs2 -> MkPair (bt || bf) (SIf c ts2 fs2))
reuseSts r ru n (Cons st rest) = consSt st (r.sts ru n rest)

reuseTl : ReuseK -> String -> Want -> Imperative.Tl -> Pair Bool Imperative.Tl
reuseTl r ru n (TSeq ss t) = case r.sts ru n ss of
  MkPair True ss2 -> MkPair True (TSeq ss2 t)
  MkPair False _ -> case r.tl ru n t of
    MkPair b t2 -> MkPair b (TSeq ss t2)
reuseTl r ru n (TReturn o) = case reuseOp ru n o of
  MkPair b o2 -> MkPair b (TReturn o2)
reuseTl r ru n (TLoop vs) = case reuseVals ru n vs of
  MkPair b vs2 -> MkPair b (TLoop vs2)
reuseTl r ru n (TIf c t e) = case r.tl ru n t of
  MkPair bt t2 -> case r.tl ru n e of
    MkPair be e2 -> MkPair (bt || be) (TIf c t2 e2)
reuseTl r ru n (TCase v arms) = case tlArms r ru n arms of
  MkPair b as2 -> MkPair b (TCase v as2)

reuseK : ReuseK
reuseK =
  { sts = \ru n ss -> reuseSts reuseK ru n ss
  , tl = \ru n t -> reuseTl reuseK ru n t
  }

reuseArm : String -> Want -> ArmBody -> Pair Bool ArmBody
reuseArm ru n (ATail t) = case reuseK.tl ru n t of
  MkPair b t2 -> MkPair b (ATail t2)
reuseArm ru n (ASts ss) = case reuseK.sts ru n ss of
  MkPair b ss2 -> MkPair b (ASts ss2)

-- (... else where it builds any tag of its size)
reusedAny : String
          -> Int
          -> ArmBody
          -> Pair Bool ArmBody
          -> Pair (Maybe String) ArmBody
reusedAny ru n b (MkPair True b1) = MkPair (Just ru) b1
reusedAny ru n b (MkPair False _) = case reuseArm ru { n = n, tag = "" } b of
  MkPair True b2 -> MkPair (Just ru) b2
  MkPair False _ -> MkPair Nothing b

-- (an arm whose scrutinee is given up: its cell kept, `ru`, where the
-- arm builds a tag of its own tag -- a list's cell for the cell it
-- rebuilds, not for another tag of its size built before it, in a
-- match whose arms each rebuild their own -- else, if it builds none, of
-- its size: the body, so built)
reusing : Maybe String
        -> String
        -> List String
        -> ArmBody
        -> Pair (Maybe String) ArmBody
reusing Nothing t vs b = MkPair Nothing b
reusing (Just x) t vs b =
  reusedAny
    ("ru$" ^ x ^ "$" ^ t)
    (List.length vs)
    b
    (reuseArm ("ru$" ^ x ^ "$" ^ t) { n = List.length vs, tag = t } b)

-- Matches
--------------------------------------------------------------------------------

-- (in an arm, the scrutinee held: known to be a tag of the arm's size)
knowing : Maybe String -> Int -> CE -> CE
knowing Nothing n ce = ce
knowing (Just x) n ce = withKnown x (KnownTag n) ce

-- (in an arm, the cell kept: known to be one for a tag of its size)
knowCell : Maybe String -> Int -> CE -> CE
knowCell Nothing n ce = ce
knowCell (Just ru) n ce = withKnown ru (KnownCell n) ce

-- (an arm, reading the fields it wants as `rd` says)
armRead : RcK
        -> CE
        -> Maybe String
        -> Bool
        -> String
        -> List String
        -> List String
        -> Bool
        -> Reads
        -> Pair (Maybe String) ArmBody
        -> CaseArm
armRead r ce taken lent t vs fb leaves rd (MkPair ru b2) =
  MkCArm
    t
    rd.plain
    rd.flats
    rd.sure
    (lent || isJustS taken)
    (takeOf rd.flat rd.sure ru taken vs (minusS fb rd.names))
    (List.append
       (dropsIn
          ce
          (List.filter
             (\v -> not (elemS v (maybeList taken)))
             (deadIn
                (List.append ce.owned (heldOf lent vs fb rd.counted))
                (unionS fb ce.after))))
       (armBodyF
          r
          (withPath
             (deadKept
                (List.append
                   ce.owned
                   (List.append (heldOf lent vs fb rd.counted) (maybeList ru)))
                (unionS (List.append fb (maybeList ru)) ce.after))
             ce.after
             (withBorrowed
                (if lent then List.append (minusS vs rd.counted) ce.borrowed
                 else ce.borrowed)
                (knowCell ru (List.length vs) ce)))
          b2))
    leaves

-- (an arm: the fields it wants, a reference to each; what is held and
-- not wanted on it, dropped.  The scrutinee held and not wanted on it is
-- given up at once: its last reference, its shell freed and the fields
-- not wanted dropped -- no field counted up and then down)
armKept : RcK
        -> CE
        -> Maybe String
        -> Bool
        -> String
        -> List String
        -> List String
        -> Bool
        -> Pair (Maybe String) ArmBody
        -> CaseArm
armKept r ce taken lent t vs fb leaves p =
  armRead r ce taken lent t vs fb leaves (readsOf ce t (fieldsWanted vs fb)) p

armTaken : RcK
         -> CE
         -> Bool
         -> String
         -> List String
         -> ArmBody
         -> List String
         -> Maybe String
         -> CaseArm
armTaken r ce lent t vs b fb taken =
  armKept r ce taken lent t vs fb (armLeaves b) (reusing taken t vs b)

armFb : RcK
      -> CE
      -> Maybe String
      -> Bool
      -> String
      -> List String
      -> ArmBody
      -> List String
      -> CaseArm
armFb r ce held lent t vs b fb =
  armTaken r ce lent t vs b fb (takenFv ce held vs fb)

armOf : RcK
      -> CE
      -> Maybe String
      -> Bool
      -> String
      -> List String
      -> ArmBody
      -> CaseArm
armOf r ce0 held lent t vs b =
  armFb r (knowing held (List.length vs) ce0) held lent t vs b (fvArm b)

-- (the variable a match looks at, if it holds a reference to it)
heldVar : CE -> Imperative.Val -> Maybe String
heldVar ce (SVar x) = if elemS x ce.owned then Just x else Nothing
heldVar ce _ = Nothing

-- (whether a match looks at a variable lent)
lentScrut : CE -> Imperative.Val -> Bool
lentScrut ce (SVar x) = elemS x ce.borrowed
lentScrut ce _ = False

-- (what a match looks at: looked at, not consumed)
scrutF : RcK -> CE -> Imperative.Val -> Value
scrutF r ce (SVar x) = RLocal x
scrutF r ce (SGlobal g) =
  if Map.member compareString g ce.funs then RClo g else RGetRaw g
scrutF r ce v = r.val ce Nil v

-- | a match: a `switch` on the tag, each arm (`returns`: what is last)
matchOf : RcK
        -> CE
        -> Bool
        -> Imperative.Val
        -> List (Pair (Pair String (List String)) ArmBody)
        -> Statement
matchOf r ce returns v arms =
  CSwitch
    (scrutF r ce v)
    (List.map
       (\p -> case p of
        MkPair (MkPair t vs) b ->
          armOf r ce (heldVar ce v) (lentScrut ce v) t vs b)
       arms)
    returns

tlArmsOf : List (Imperative.Arm Imperative.Tl)
         -> List (Pair (Pair String (List String)) ArmBody)
tlArmsOf arms =
  List.map
    (\arm -> case arm of
     MkArm t vs b -> MkPair (MkPair t vs) (ATail b))
    arms

stArmsOf : List (Imperative.Arm (List Imperative.St))
         -> List (Pair (Pair String (List String)) ArmBody)
stArmsOf arms =
  List.map
    (\arm -> case arm of
     MkArm t vs ss -> MkPair (MkPair t vs) (ASts ss))
    arms

-- (what a binding builds: a tag, known by its size)
reusedOf : List Imperative.Val -> Maybe Known
reusedOf (Cons _ (Cons (STag _ as _) Nil)) = Just (KnownTag (List.length as))
reusedOf _ = Nothing

builtOf : Imperative.Comp -> Maybe Known
builtOf (OSimple (STag _ as _)) = Just (KnownTag (List.length as))
builtOf (OSimple (SRec fs _)) = Just (KnownRec (List.length fs))
builtOf (OSimple (SLam xs (MkBlock t))) =
  Just (KnownClo (List.length (freeOf xs t)))
builtOf (OSimple (SPrim p as)) =
  if strEq p reusePrim then reusedOf as else Nothing
builtOf _ = Nothing

knownLet : String -> Maybe Known -> CE -> CE
knownLet x Nothing ce = ce
knownLet x (Just k) ce = withKnown x k ce

-- Conditions
--------------------------------------------------------------------------------

-- A comparison whose Bool is only looked at -- `if`, `&&`, `||` and an
-- equation matching a Bool, a test whose condition (heff.compile.imperative's
-- `Pred`) is the comparison -- is tested where it is (`CIf`): no Bool
-- made, nor taken apart again.

-- (an arm of a condition: what is held and wanted neither by it nor
-- after it dropped first, as a match's arm drops it)
condArm : RcK -> CE -> ArmBody -> List Statement
condArm r ce b =
  List.append
    (dropsIn ce (deadIn ce.owned (unionS (fvArm b) ce.after)))
    (armBodyF
       r
       (withPath (deadKept ce.owned (unionS (fvArm b) ce.after)) ce.after ce)
       b)

-- (`fa` what the comparison wants, `wb` what its arms and what comes
-- after want: the comparison's operands, then the test, then each arm)
condWith : RcK
         -> CE
         -> String
         -> List Imperative.Val
         -> ArmBody
         -> ArmBody
         -> List String
         -> List String
         -> List Statement
condWith r ce p args yes no fa wb =
  List.append
    (dropsIn ce (deadIn ce.owned (unionS fa wb)))
    (Cons
       (CIf
          (relTest
             r
             (withPath (deadKept ce.owned (unionS fa wb)) wb ce)
             wb
             p
             args)
          (condArm r (withPath (deadKept ce.owned wb) ce.after ce) yes)
          (condArm r (withPath (deadKept ce.owned wb) ce.after ce) no))
       Nil)

condOf : RcK
       -> CE
       -> String
       -> List Imperative.Val
       -> ArmBody
       -> ArmBody
       -> List Statement
condOf r ce p args yes no =
  condWith
    r
    ce
    p
    args
    yes
    no
    (fvList args)
    (unionS (List.append (fvArm yes) (fvArm no)) ce.after)

-- (a condition of more than a comparison: its operands lent, what it
-- wants still held on each arm, dropped there if the arm does not want
-- it)
condTestWith : RcK
             -> CE
             -> Imperative.Cond
             -> ArmBody
             -> ArmBody
             -> List String
             -> List Statement
condTestWith r ce c yes no wanted =
  List.append
    (dropsIn ce (deadIn ce.owned wanted))
    (Cons
       (CIf
          (condF r (lentTo (withPath (deadKept ce.owned wanted) wanted ce)) c)
          (condArm r (withPath (deadKept ce.owned wanted) ce.after ce) yes)
          (condArm r (withPath (deadKept ce.owned wanted) ce.after ce) no))
       Nil)

condTest : RcK -> CE -> Imperative.Cond -> ArmBody -> ArmBody -> List Statement
condTest r ce c yes no =
  condTestWith
    r
    ce
    c
    yes
    no
    (unionS
       (freeIn Nil (Cons (ICond c) Nil))
       (unionS (List.append (fvArm yes) (fvArm no)) ce.after))

-- (after a `Bool` made of a condition: what it was lent, held and not
-- wanted after, dropped)
boolDone : CE -> Imperative.Comp -> List Statement
boolDone ce (OBool _) = dropsIn ce (deadIn ce.owned ce.after)
boolDone ce o = Nil

-- Fields taken: `let y = f r.a .. in b`, `r` held and wanted by nothing
-- after the binding, and -- in what the binding computes besides, and in
-- `b` -- only read other fields of, outside any lambda: `r.a` is taken
-- out of `r` (`RTakeField`) where that is `r`'s last reference -- moved,
-- not counted, a hole left in `r` that drops as nothing.  `r` is not
-- looked at whole again, nor its `a` read: it is read other fields of,
-- then updated with another `a` or dropped.  So the field's value is held
-- once, not by `y` and by `r` both, and may be built in in turn: a
-- scheduler's queue taken out of its state, put to, and the state updated
-- with it, each in its own cell.

varIs : String -> Imperative.Val -> Bool
varIs x (SVar y) = strEq x y
varIs x _ = False

-- (whether `x`, in the worklist, is only read fields of, none of them
-- `l`, and outside any lambda)
othersW : String -> String -> List Item -> Bool
othersW x l Nil = True
othersW x l (Cons (IVal (SVar y)) rest) = not (strEq x y) && othersW x l rest
othersW x l (Cons (IVal (SProj e l2 _ _)) rest) =
  if varIs x e then not (strEq l l2) && othersW x l rest
  else othersW x l (Cons (IVal e) rest)
othersW x l (Cons (IVal (SLam _ (MkBlock t))) rest) =
  Imperative.timesIn x (Imperative.tailParts t) == 0 && othersW x l rest
othersW x l (Cons (IVal (STag _ as _)) rest) = othersW x l (pushVals as rest)
othersW x l (Cons (IVal (SRec fs _)) rest) =
  othersW x l (pushVals (List.map snd fs) rest)
othersW x l (Cons (IVal (SPrim _ as)) rest) = othersW x l (pushVals as rest)
othersW x l (Cons (IVal _) rest) = othersW x l rest
othersW x l (Cons (IOp (OSimple v)) rest) = othersW x l (Cons (IVal v) rest)
othersW x l (Cons (IOp (OCall _ as)) rest) = othersW x l (pushVals as rest)
othersW x l (Cons (IOp (OApply f as)) rest) =
  othersW x l (pushVals (Cons f as) rest)
othersW x l (Cons (IOp (OPrim _ as)) rest) = othersW x l (pushVals as rest)
othersW x l (Cons (IOp (OBool c)) rest) = othersW x l (Cons (ICond c) rest)
othersW x l (Cons (IOp _) rest) = othersW x l rest
othersW x l (Cons (ICond (PRel _ a b)) rest) =
  othersW x l (Cons (IVal a) (Cons (IVal b) rest))
othersW x l (Cons (ICond (PBool v)) rest) = othersW x l (Cons (IVal v) rest)
othersW x l (Cons (ICond (PNot c)) rest) = othersW x l (Cons (ICond c) rest)
othersW x l (Cons (ICond (PIf a b c)) rest) =
  othersW x l (Cons (ICond a) (Cons (ICond b) (Cons (ICond c) rest)))
othersW x l (Cons (ICond (PLet _ o c)) rest) =
  othersW x l (Cons (IOp o) (Cons (ICond c) rest))
othersW x l (Cons (ICond _) rest) = othersW x l rest
othersW x l (Cons (ISts Nil) rest) = othersW x l rest
othersW x l (Cons (ISts (Cons (SLet _ o) ss)) rest) =
  othersW x l (Cons (IOp o) (Cons (ISts ss) rest))
othersW x l (Cons (ISts (Cons (SDecl _) ss)) rest) =
  othersW x l (Cons (ISts ss) rest)
othersW x l (Cons (ISts (Cons (SSet _ o) ss)) rest) =
  othersW x l (Cons (IOp o) (Cons (ISts ss) rest))
othersW x l (Cons (ISts (Cons (SIf c ts fs) ss)) rest) =
  othersW
    x
    l
    (Cons (ICond c) (Cons (ISts ts) (Cons (ISts fs) (Cons (ISts ss) rest))))
othersW x l (Cons (ISts (Cons (SCase v arms) ss)) rest) =
  othersW x l (Cons (IVal v) (pushStArms arms (Cons (ISts ss) rest)))
othersW x l (Cons (ITl (TSeq ss t)) rest) =
  othersW x l (Cons (ISts ss) (Cons (ITl t) rest))
othersW x l (Cons (ITl (TReturn o)) rest) = othersW x l (Cons (IOp o) rest)
othersW x l (Cons (ITl (TLoop vs)) rest) = othersW x l (pushVals vs rest)
othersW x l (Cons (ITl (TIf c t e)) rest) =
  othersW x l (Cons (ICond c) (Cons (ITl t) (Cons (ITl e) rest)))
othersW x l (Cons (ITl (TCase v arms)) rest) =
  othersW x l (Cons (IVal v) (pushTlArms arms rest))

-- (the operands of what a binding computes, as they are made)
operandsOf : Imperative.Comp -> List Imperative.Val
operandsOf (OApply f as) = Cons f as
operandsOf (OCall _ as) = as
operandsOf (OSimple (STag _ as _)) = as
operandsOf (OSimple (SRec fs _)) = List.map snd fs
operandsOf (OSimple (SPrim _ as)) = as
operandsOf (OPrim _ as) = as
operandsOf (OSimple (SProj e l sh t)) = Cons (SProj e l sh t) Nil
operandsOf _ = Nil

-- (an operand that takes its field, `rest` all that may look at its
-- record after it)
takeVar : CE
        -> List Item
        -> Maybe String
        -> String
        -> List String
        -> List (Pair String String)
takeVar ce rest (Just x) l sh =
  if not (List.null sh)
  && elemS x ce.owned
  && not (elemS x ce.borrowed)
  && not (elemS x ce.after)
  && othersW x l rest
    then Cons (MkPair x l) Nil
  else Nil
takeVar ce rest Nothing l sh = Nil

takeOne : CE -> List Item -> Imperative.Val -> List (Pair String String)
takeOne ce rest (SProj e l sh t) =
  if Repr.mayBeFlat t then Nil else takeVar ce rest (varOfV e) l sh
takeOne ce rest e = Nil

takesAt : CE
        -> List Imperative.Val
        -> List Item
        -> List Imperative.Val
        -> List (Pair String String)
takesAt ce before after Nil = Nil
takesAt ce before after (Cons e es) =
  List.append
    (takeOne ce (pushVals before (pushVals es after)) e)
    (takesAt ce (List.append before (Cons e Nil)) after es)

-- | the fields the operands of `o`, bound before what follows, take out
-- | of their records
takesFor : CE -> Imperative.Comp -> List Item -> List (Pair String String)
takesFor ce o after = takesAt ce Nil after (operandsOf o)

-- (what follows a statement, as items)
restItems : List Imperative.St -> Maybe Imperative.Tl -> List Item
restItems ss (Just t) = Cons (ISts ss) (Cons (ITl t) Nil)
restItems ss Nothing = Cons (ISts ss) Nil

-- Statements
--------------------------------------------------------------------------------

bindWith : RcK
         -> CE
         -> String
         -> List String
         -> (CE -> List Statement)
         -> Maybe Known
         -> List (Pair String String)
         -> List Imperative.St
         -> Maybe Imperative.Tl
         -> List String
         -> List Statement
bindWith r ce x fa binding known takes rest after wb =
  List.append
    (dropsIn ce (deadIn ce.owned (unionS fa wb)))
    (List.append
       (binding
          (withTakes takes (withPath (deadKept ce.owned (unionS fa wb)) wb ce)))
       (List.append
          (if elemS x wb then Nil
           else dropsIn (knownLet x known ce) (Cons x Nil))
          (r.stmts
             (withPath
                (List.append
                   (deadKept ce.owned wb)
                   (if elemS x wb then boxedOnly ce (Cons x Nil) else Nil))
                ce.after
                (withTakes Nil (knownLet x known ce)))
             rest
             after)))

-- (`let x = a` and what follows: what is held and wanted neither by `a`
-- nor after it dropped first; then `a`, wanted after it what follows and
-- what comes after want; then `x`, dropped if nothing wants it --
-- `binding` its statements, given the code's state for it; `known`, what
-- `x` is known to be)
bindThen : RcK
         -> CE
         -> String
         -> List String
         -> (CE -> List Statement)
         -> Maybe Known
         -> List (Pair String String)
         -> List Imperative.St
         -> Maybe Imperative.Tl
         -> List Statement
bindThen r ce x fa binding known takes rest after =
  bindWith
    r
    ce
    x
    fa
    binding
    known
    takes
    rest
    after
    (unionS (fvRest rest after) ce.after)

-- (a statement that sets `x`: a match, a condition)
setting : RcK -> CE -> Imperative.St -> List Statement
setting r ce (SCase v arms) = Cons (matchOf r ce False v (stArmsOf arms)) Nil
setting r ce (SIf (PRel p a b) ts fs) = condOf r ce p [a, b] (ASts ts) (ASts fs)
setting r ce (SIf c ts fs) = condTest r ce c (ASts ts) (ASts fs)
setting r ce st = Cons CAbandon Nil

stmtsF : RcK
       -> CE
       -> List Imperative.St
       -> Maybe Imperative.Tl
       -> List Statement
stmtsF r ce Nil (Just t) = r.tail ce t
stmtsF r ce Nil Nothing = Nil
stmtsF r ce (Cons (SLet x o) rest) after =
  bindThen
    r
    ce
    x
    (fvOp o)
    (\ce2 ->
       Cons
         (CLet x (r.comp ce2 ce2.after (Repr.reprOf ce.reprs x) o))
         (boolDone ce2 o))
    (builtOf o)
    (takesFor ce o (restItems rest after))
    rest
    after
stmtsF r ce (Cons (SDecl x) (Cons st rest)) after =
  bindThen
    r
    ce
    x
    (fvSts (Cons st Nil))
    (\ce2 -> Cons (CDecl x) (setting r ce2 st))
    Nothing
    Nil
    rest
    after
stmtsF r ce (Cons (SSet x o) rest) after =
  Cons
    (CSet x (r.comp ce ce.after (Repr.reprOf ce.reprs x) o))
    (List.append (boolDone ce o) (r.stmts ce rest after))
-- (a match, a condition, setting a name declared before: in an arm
-- that sets it, last)
stmtsF r ce (Cons st rest) after =
  List.append (setting r ce st) (r.stmts ce rest after)

-- (a known definition called last: itself, the loop again; one of the
-- same parameters, a jump; else called, its bounce given back)
-- (`loop`: the operands as the loop's next round is given them, each
-- parameter kept unboxed given its value so)
callAs : CE
       -> String
       -> List Imperative.Val
       -> List Operand
       -> List Operand
       -> List Statement
callAs ce g as loop ls =
  if isSelfCall ce g as && lentPlain loop then again ce (List.map argExp loop)
  else if agrees ce g as && lentPlain ls
    then Cons (CJump g (toWorker (workerOf ce g)) (List.map argExp ls)) Nil
  else Cons
      (CReturn
         (coerce
            (Repr.resultIn ce.sigs g)
            ce.ret
            (RCall g False (workerOf ce g) ls)))
      Nil

-- (the loop's next round's operands: a parameter kept unboxed given its
-- value so, the others as a call's)
loopOperands : RcK
             -> CE
             -> List String
             -> List String
             -> List Int
             -> Int
             -> List String
             -> List Imperative.Val
             -> List Operand
loopOperands r ce live before bi i (Cons p ps) (Cons e es) =
  Cons
    (if unboxedVar ce p
       then Given
           (r.valAs
              ce
              (unionS before (unionS (fvList es) live))
              (Repr.reprOf ce.reprs p)
              e)
     else lentAt r ce live before bi i e es)
    (loopOperands r ce live (lentThen ce bi i e before) bi (i + 1) ps es)
loopOperands r ce live before bi i _ _ = Nil

selfParams : CE -> List String
selfParams { self = Just s } = s.params
selfParams { self = Nothing } = Nil

callLast : RcK -> CE -> String -> List Imperative.Val -> List Statement
callLast r ce g as =
  callAs
    ce
    g
    as
    (loopOperands r ce Nil Nil (Borrow.borOf ce.bor g) 0 (selfParams ce) as)
    (callOperands r ce Nil g as)

-- (the name a `Bool` returned is bound to, its condition's operands
-- dropped before it is: one no other name is, each given a `$` and a
-- number)
boolName : String
boolName = "ret$bool"

-- | what is last
tailF : RcK -> CE -> Imperative.Tl -> List Statement
tailF r ce (TSeq ss t) = r.stmts ce ss (Just t)
tailF r ce (TReturn (OApply f as)) =
  if Repr.isBoxed ce.ret
    then applyLast ce (List.length as) (operandsF r ce Nil (Cons f as))
  else Cons (CReturn (r.comp ce Nil ce.ret (OApply f as))) Nil
tailF r ce (TReturn (OCall g as)) = callLast r ce g as
tailF r ce (TReturn (OBool c)) =
  Cons
    (CLet boolName (r.comp ce Nil RepV (OBool c)))
    (List.append
       (dropsIn ce ce.owned)
       (Cons (CReturn (coerce RepV ce.ret (RLocal boolName))) Nil))
tailF r ce (TReturn o) = Cons (CReturn (r.comp ce Nil ce.ret o)) Nil
tailF r ce (TLoop as) = case ce.self of
  Just s -> callLast r ce s.key as
  Nothing -> Cons (CReturn RAbandon) Nil
tailF r ce (TIf (PRel p a b) t e) = condOf r ce p [a, b] (ATail t) (ATail e)
tailF r ce (TIf c t e) = condTest r ce c (ATail t) (ATail e)
tailF r ce (TCase v arms) = Cons (matchOf r ce True v (tlArmsOf arms)) Nil

rcK : RcK
rcK =
  { val = \ce live e -> valAsF rcK ce live RepV e
  , valAs = \ce live want e -> valAsF rcK ce live want e
  , comp = \ce live want o -> compF rcK ce live want o
  , stmts = \ce ss after -> stmtsF rcK ce ss after
  , tail = \ce t -> tailF rcK ce t
  }

-- Definitions
--------------------------------------------------------------------------------

-- (a parameter given a `V`, kept unboxed, unboxed where the function is
-- entered -- one lent looked at; one its worker takes unboxed (`rp`,
-- #39) is given so)
unboxGiven : CE -> Bool -> Repr.Repr -> String -> List Statement
unboxGiven ce lent RepV x = unboxParam ce lent x
unboxGiven ce lent rp x = Nil

-- (each parameter's place)
placesOf : {a : Type} -> List a -> List Int
placesOf xs = List.range 0 (List.length xs - 1)

unboxParams : CE -> List Int -> List Repr.Repr -> List String -> List Statement
unboxParams ce bi rps xs =
  List.concatMap
    (\ss -> ss)
    (List.zipWith
       (\p i -> unboxGiven ce (elemI i bi) (snd p) (fst p))
       (List.zip xs rps)
       (placesOf xs))

-- (a parameter's name, as the function is given it: its worker's taken
-- unboxed as it is, any other a `V`)
paramName : CE -> Repr.Repr -> String -> String
paramName ce RepV x = givenName ce x
paramName ce rp x = x

-- Wrappers (#39): a function with a worker (heff.compile.worker) is, to
-- a closure's entry and any other caller of `V`s, its wrapper -- which
-- unboxes what its worker takes unboxed (looked at, if lent: the caller
-- drops it), calls it, and boxes what it gives -- and the worker is the
-- function's code itself.

wrapParam : CE -> Repr.Repr -> String -> String
wrapParam ce RepV x = givenName ce x
wrapParam ce rp x = boxName x

wrapUnbox : Bool -> Repr.Repr -> String -> List Statement
wrapUnbox lent RepV x = Nil
wrapUnbox lent rp x = Cons (CLet x (unboxAs lent rp (RLocal (boxName x)))) Nil

wrapArg : CE -> Repr.Repr -> String -> Operand
wrapArg ce RepV x = Given (RLocal (givenName ce x))
wrapArg ce rp x = GivenU rp (RLocal x)

wrapperOf : CE -> String -> List Int -> Repr.Sig -> List String -> Wrapper
wrapperOf ce key bi sg xs =
  MkWrapper
    (List.zipWith (wrapParam ce) sg.params xs)
    (List.append
       (List.concatMap
          (\ss -> ss)
          (List.zipWith
             (\p i -> wrapUnbox (elemI i bi) (fst p) (snd p))
             (List.zip sg.params xs)
             (placesOf xs)))
       (Cons
          (CReturn
             (coerce
                sg.result
                RepV
                (RCall
                   key
                   False
                   (Just sg.result)
                   (List.zipWith (wrapArg ce) sg.params xs))))
          Nil))

funWith : CE
        -> String
        -> List String
        -> Imperative.Tl
        -> List Int
        -> List Repr.Repr
        -> Maybe Repr.Sig
        -> Def
funWith ce key xs b bi rps sg =
  DFun
    { key = key
    , params = List.zipWith (paramName ce) rps xs
    , lent = bi
    , entry = unboxParams ce bi rps xs
    , body =
        List.append
          (plainDrops
             (boxedOnly ce (deadIn (Borrow.paramsAt False bi xs) (fvTl b))))
          (rcK.tail
             (withPath
                (boxedOnly ce (deadKept (Borrow.paramsAt False bi xs) (fvTl b)))
                Nil
                (withBorrowed
                   (Borrow.paramsAt True bi xs)
                   (withFrame
                      (Just { key = key, params = xs })
                      0
                      (knowingShapes b ce))))
             b)
    , reprs = ce.reprs
    , ret = Repr.resultIn ce.sigs key
    , wrapper =
        maybe Nothing (\(s : Repr.Sig) -> Just (wrapperOf ce key bi s xs)) sg
    }

funRc : CE -> String -> List String -> Imperative.Tl -> Def
funRc ce key xs b =
  funWith
    ce
    key
    xs
    b
    (Borrow.borOf ce.bor key)
    (Repr.paramReprsIn ce.sigs key xs)
    (Repr.sigIn ce.sigs key)

valRc : CE -> String -> Imperative.Tl -> Def
valRc ce key t =
  DVal
    key
    (rcK.tail (withPath Nil Nil (withFrame Nothing 0 (knowingShapes t ce))) t)
    ce.reprs

-- | a definition of the imperative form, its references counted, what
-- | is known of the program (`facts`) known, its variables kept as
-- | `reprs` says (heff.compile.repr)
rcDef : Facts.Facts -> Repr.Reprs -> Imperative.Def -> Def
rcDef facts reprs (MkDef key _ (DefFun xs (MkBlock t))) =
  funRc (ceOfFacts facts reprs) key xs t
rcDef facts reprs (MkDef key _ (DefVal (MkBlock t))) =
  valRc (ceOfFacts facts reprs) key t
