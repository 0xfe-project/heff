-- Workers and wrappers, for the C backend (#39): which functions have a
-- worker, and its signature (`Repr.Sig`).  A worker is the function's
-- C function taking some of its parameters, and giving its result,
-- unboxed -- a fixed-width number as its C integer type, a `Float64` as
-- a `double` -- which a known call calls with them so: nothing boxed to
-- be given, nor unboxed where it is taken.  Its wrapper, a function of
-- `V`s as any other, unboxes them, calls it, and boxes what it gives:
-- what a closure's entry calls (heff.compile.refcount makes both).
--
-- The form has no types, so what a parameter is is told by what its body
-- does with it, as heff.compile.repr tells a variable's: a parameter, or
-- the result, is unboxed where its class would be were the function given
-- `V`s and its caller wanting a `V` (`Repr.proposeSig`) -- used as a
-- number, so that no call of the worker costs more than a call of the
-- function did.  What a body does with a known call's operands and
-- result is told by the workers there are, so this is a fixpoint on the
-- calls: from no workers, each function weighed again where one it calls
-- has a new one, a parameter once unboxed staying so, until none changes
-- (each round in the order of the keys, against the workers at its
-- start: what it comes to is the same whatever order the program is in);
-- then what it could not see, functions round a cycle of calls giving
-- one another their numbers, from hopes that fall where they must ("Hopes
-- on cycles of calls").  It is worked out a component of the program at
-- a time, as the backend's cache keeps it ("Workers, a component at a
-- time").
--
-- Only what a body says is evidence, never what a caller gives: a
-- function called with an `Int64` at one call and a `Float64` at another
-- is generic, and is called through its wrapper from a closure with
-- anything.
--
-- A function calling another of as many parameters last jumps to it
-- (`HEFF_LAST`), which C allows only between functions of one type: the
-- functions that jump to one another round a cycle, which may go round
-- any number of times, are given one signature, unboxed only where all of
-- theirs are (`meetCycles`); a call last out of a cycle, of another type,
-- is a call.  A function a call of which may give back a bounce gives a
-- `V`.

module heff.compile.worker

import heff.compile.facts as Facts
import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.elab.primitive
import heff.compile.ranges as Ranges
import heff.compile.repr as Repr
import std.ordmap as OrdMap

-- What may have a worker
--------------------------------------------------------------------------------

-- (what a body is weighed knowing: the workers `sg`, the tags' fields
-- that may be flat)
knowIn : Facts.Facts -> Repr.Sigs -> Repr.Know
knowIn facts sg = { sigs = sg, flat = facts.flat }

-- (a field's type, kept flat where it is read: see `Repr.flatOf`)
flatTy : IR.FieldTy -> Bool
flatTy FtFloat = True
flatTy (FtFixed _) = True
flatTy t = False

shaped : Maybe Repr.Shape -> Bool
shaped (Just _) = True
shaped Nothing = False

-- (a primitive done unboxed: not one on words (heff.compile.ranges, #79),
-- which no worker is given unboxed, its parameters' words being known
-- where the function is entered)
numericPrim : Prim -> Bool
numericPrim p = shaped (Repr.primShape p) && not (Ranges.isWordPrim p)

-- (whether the worklist has evidence of a number: a literal, a primitive
-- done unboxed, a field kept flat)
numericW : List IR.Expr -> Bool
numericW [] = False
numericW (EFixed _ _ :: _) = True
numericW (EFloat _ :: _) = True
numericW (EFloat32 _ :: _) = True
numericW (EPrimCall p args :: rest) =
  numericPrim p || numericW (IR.appendI args rest)
numericW (EProj e _ _ t :: rest) = flatTy t || numericW (e :: rest)
numericW (EBool c :: rest) =
  List.any numericPrim (IR.condRels c) || numericW (IR.condOnto c rest)
numericW (e :: rest) = numericW (IR.partsOnto e rest)

-- | whether a function's body has evidence of a number of its own: those
-- | that have none have a worker only where one they call has
numeric : IR.Def -> Bool
numeric d = numericW [d.body]

isFunction : IR.Def -> Bool
isFunction { body = ELam _ _ } = True
isFunction d = False

-- (each function, by the definitions that mention it: those weighed
-- again where it has a new worker)
callersOne : OrdMap.OrdMap String (List String)
           -> IR.Def
           -> OrdMap.OrdMap String (List String)
callersOne m d =
  List.foldl
    (\acc g ->
       OrdMap.insert
         acc
         g
         (d.key :: fromMaybe Nil (OrdMap.lookup acc g)))
    m
    (IR.globalsIn d.body)

callersOf : List IR.Def -> OrdMap.OrdMap String (List String)
callersOf defs = List.foldl callersOne OrdMap.empty defs

-- (each once, in order)
sortedOnce : List String -> List String
sortedOnce xs =
  List.map
    fst
    (OrdMap.toList
       (List.foldl
          (\m x -> OrdMap.insert m x (MkUnit : Unit))
          OrdMap.empty
          xs))

-- The fixpoint
--------------------------------------------------------------------------------

-- | what the rounds go on with: the workers so far, and the functions'
-- | imperative forms made so far (each made once, when first weighed)
type Round = { sigs : Repr.Sigs, imps : OrdMap.OrdMap String Imperative.Def }

-- (a function's imperative form, its names drawn afresh, as the C
-- backend makes it: heff.compile.lower's `cDef`)
impOf : IR.Def -> Imperative.Def
impOf d = case IR.freshen 0 d.body of
  MkPair b n -> Imperative.impDef True n (IR.mkDef d.key d.name b)

-- (the one made before, if it was: made only if it was not)
impFrom : IR.Def -> Maybe Imperative.Def -> Imperative.Def
impFrom d (Just md) = md
impFrom d Nothing = impOf d

impIn : OrdMap.OrdMap String Imperative.Def -> IR.Def -> Imperative.Def
impIn imps d = impFrom d (OrdMap.lookup imps d.key)

plainSig : Int -> Repr.Sig
plainSig n = { params = List.replicate n RepV, result = RepV }

-- (as it was, unboxed where it was, else as proposed)
grownRepr : Repr.Repr -> Repr.Repr -> Repr.Repr
grownRepr RepV r = r
grownRepr old r = old

grown : Repr.Sig -> Repr.Sig -> Repr.Sig
grown old new =
  { params = List.zipWith grownRepr old.params new.params
  , result = grownRepr old.result new.result
  }

sigOr : Repr.Sigs -> String -> Int -> Repr.Sig
sigOr sg k n = fromMaybe (plainSig n) (Repr.sigIn sg k)

-- | a round's work so far: the changed workers, and the forms made
type Weighed =
  { changed : List (Pair String Repr.Sig)
  , imps : OrdMap.OrdMap String Imperative.Def
  }

weighedWith : Weighed
            -> String
            -> Imperative.Def
            -> Repr.Sig
            -> Repr.Sig
            -> Weighed
weighedWith acc k md old new =
  { changed =
      if Repr.sigEq old new then acc.changed
      else MkPair k new :: acc.changed
  , imps = OrdMap.insert acc.imps k md
  }

-- (a function weighed against the workers `sg`, its form `md`)
weighImp : Facts.Facts
         -> Repr.Sigs
         -> Weighed
         -> String
         -> Imperative.Def
         -> Weighed
weighImp facts sg acc k md@(MkDef _ _ (DefFun xs (MkBlock t))) =
  weighedWith
    acc
    k
    md
    (sigOr sg k (List.length xs))
    (grown
       (sigOr sg k (List.length xs))
       (Repr.proposeSig
          (knowIn facts sg)
          (OrdMap.member facts.bounce k)
          xs
          t))
weighImp facts sg acc k md = acc

weighOne : Facts.Facts
         -> OrdMap.OrdMap String IR.Def
         -> Repr.Sigs
         -> Weighed
         -> String
         -> Weighed
weighOne facts defs sg acc k = case OrdMap.lookup defs k of
  Just d ->
    if isFunction d then weighImp facts sg acc k (impIn acc.imps d) else acc
  Nothing -> acc

withChanges : Repr.Sigs -> List (Pair String Repr.Sig) -> Repr.Sigs
withChanges sg cs = List.foldl (\m p -> OrdMap.insert m (fst p) (snd p)) sg cs

-- Cycles of jumps
--------------------------------------------------------------------------------

-- (the call a way out makes: its callee, and how many operands)
tailCalls : IR.Expr -> List (Pair String Int)
tailCalls (ECall g args) = [MkPair g (List.length args)]
tailCalls e = Nil

-- (a call last of another function, of as many parameters as `n`, with
-- as many: a jump, heff.compile.refcount's `agrees`)
jumpTo : OrdMap.OrdMap String Int -> String -> Int -> Pair String Int -> Bool
jumpTo ar k n (MkPair g m) =
  not (strEq g k) && m == n && Facts.arityIs n (OrdMap.lookup ar g)

-- | whom a function jumps to
jumpsOf : OrdMap.OrdMap String Int -> IR.Def -> List String
jumpsOf ar d@{ body = ELam xs b } =
  List.map
    fst
    (List.keepIf
       (jumpTo ar d.key (List.length xs))
       (List.concatMap tailCalls (IR.waysList b)))
jumpsOf ar d = Nil

jumpsAll : OrdMap.OrdMap String Int
         -> List IR.Def
         -> OrdMap.OrdMap String (List String)
jumpsAll ar defs =
  List.foldl
    (\m (d : IR.Def) -> OrdMap.insert m d.key (jumpsOf ar d))
    OrdMap.empty
    defs

-- (what the worklist reaches by jumps, `seen` so far)
reachGo : OrdMap.OrdMap String (List String)
        -> OrdMap.OrdMap String Unit
        -> List String
        -> OrdMap.OrdMap String Unit
reachGo js seen [] = seen
reachGo js seen (k :: rest) =
  if OrdMap.member seen k then reachGo js seen rest
  else reachGo
      js
      (OrdMap.insert seen k MkUnit)
      (List.append (fromMaybe Nil (OrdMap.lookup js k)) rest)

-- | what a function's jumps reach, and theirs, and so on
reach : OrdMap.OrdMap String (List String)
      -> String
      -> OrdMap.OrdMap String Unit
reach js k = reachGo js OrdMap.empty (fromMaybe Nil (OrdMap.lookup js k))

-- | the functions on a cycle of jumps with `k`, itself among them if it
-- | is on one
cycleOf : OrdMap.OrdMap String (List String) -> String -> List String
cycleOf js k =
  List.keepIf
    (\h -> OrdMap.member (reach js h) k)
    (List.map fst (OrdMap.toList (reach js k)))

-- (unboxed where both are, as the same)
meetRepr : Repr.Repr -> Repr.Repr -> Repr.Repr
meetRepr a b = if Repr.reprEq a b then a else RepV

meetSig : Repr.Sig -> Repr.Sig -> Repr.Sig
meetSig a b =
  { params = List.zipWith meetRepr a.params b.params
  , result = meetRepr a.result b.result
  }

-- (a function given the signature: a worker, if it has one)
withSig : Repr.Sigs -> String -> Repr.Sig -> Repr.Sigs
withSig sg k s =
  if Repr.hasWorker s then OrdMap.insert sg k s
  else OrdMap.delete sg k

-- (the functions on a cycle of jumps given one signature: unboxed where
-- all of theirs are)
meetIn : Repr.Sigs -> Repr.Sig -> List String -> Repr.Sigs
meetIn sg s ks =
  List.foldl
    (\m k ->
       withSig
         m
         k
         (List.foldl
            meetSig
            s
            (List.map (\h -> sigOr sg h (List.length s.params)) ks)))
    sg
    ks

meetAt : OrdMap.OrdMap String (List String)
       -> Repr.Sigs
       -> Pair String Repr.Sig
       -> Repr.Sigs
meetAt js sg (MkPair k s) =
  if List.length (cycleOf js k) >= 2 then meetIn sg s (cycleOf js k) else sg

-- | each cycle of jumps with a worker on it given one signature
meetCycles : OrdMap.OrdMap String (List String) -> Repr.Sigs -> Repr.Sigs
meetCycles js sg = List.foldl (meetAt js) sg (OrdMap.toList sg)

-- Hopes on cycles of calls
--------------------------------------------------------------------------------

-- The rounds start from no workers and only unboxing, so functions
-- calling one another round a cycle, each giving back what the other
-- gives (an accumulator), keep
-- it a `V`: each sees the other give a `V`.  So the functions weighed
-- are given each its hope (`Repr.hopeSig`: unboxed where its body's
-- evidence says one type, whatever that costs), and weighed again
-- against the hopes, each kept only where its body, given them, still
-- says so (`Repr.proposeSig`), until none falls -- each never below what
-- the rounds gave it.  What is left of a hope is a type its body says,
-- as a worker's always is, so a worker is never wrong of what it takes.

-- (whether a call of it may give back a bounce)
bouncesIn : Facts.Facts -> String -> Bool
bouncesIn facts k = OrdMap.member facts.bounce k

-- (a hope, where it is more than it has)
hopedTo : Repr.Sigs -> String -> Repr.Sig -> Repr.Sig -> Repr.Sigs
hopedTo acc k old new =
  if Repr.sigEq old new then acc else OrdMap.insert acc k new

hopeOne : Facts.Facts
        -> Repr.Sigs
        -> Repr.Sigs
        -> Pair String Imperative.Def
        -> Repr.Sigs
hopeOne facts sg acc (MkPair k (MkDef _ _ (DefFun xs (MkBlock t)))) =
  hopedTo
    acc
    k
    (sigOr sg k (List.length xs))
    (grown
       (sigOr sg k (List.length xs))
       (Repr.hopeSig (knowIn facts sg) (bouncesIn facts k) xs t))
hopeOne facts sg acc p = acc

-- | the functions weighed, each its hope where that is more than the
-- | rounds gave it
hopesOf : Facts.Facts -> Round -> Repr.Sigs
hopesOf facts r =
  List.foldl (hopeOne facts r.sigs) OrdMap.empty (OrdMap.toList r.imps)

-- (a new signature, where it changed)
fellTo : List (Pair String Repr.Sig)
       -> String
       -> Repr.Sig
       -> Repr.Sig
       -> List (Pair String Repr.Sig)
fellTo acc k old new = if Repr.sigEq old new then acc else MkPair k new :: acc

-- (a hope weighed against the signatures `sg`: kept where the body,
-- given them, says so too, never below what the rounds gave it, `base`)
fallImp : Facts.Facts
        -> Repr.Sigs
        -> Repr.Sigs
        -> List (Pair String Repr.Sig)
        -> String
        -> Imperative.Def
        -> List (Pair String Repr.Sig)
fallImp facts base sg acc k (MkDef _ _ (DefFun xs (MkBlock t))) =
  fellTo
    acc
    k
    (sigOr sg k (List.length xs))
    (grown
       (sigOr base k (List.length xs))
       (meetSig
          (sigOr sg k (List.length xs))
          (Repr.proposeSig (knowIn facts sg) (bouncesIn facts k) xs t)))
fallImp facts base sg acc k md = acc

fallOne : Facts.Facts
        -> Repr.Sigs
        -> OrdMap.OrdMap String Imperative.Def
        -> Repr.Sigs
        -> List (Pair String Repr.Sig)
        -> String
        -> List (Pair String Repr.Sig)
fallOne facts base imps sg acc k = case OrdMap.lookup imps k of
  Just md -> fallImp facts base sg acc k md
  Nothing -> acc

-- (only those with a worker)
workersOnly : Repr.Sigs -> Repr.Sigs
workersOnly sg =
  List.foldl (\m p -> withSig m (fst p) (snd p)) sg (OrdMap.toList sg)

-- Workers, a component at a time
--------------------------------------------------------------------------------

-- The fixpoint is the whole program's: rounds from no workers, the first
-- weighing the functions with evidence of a number of their own, each
-- after it those changed and those that mention one changed, each
-- against the workers at its start, 64 at most; the functions weighed
-- given their hopes, which fall step by step as the rounds go, 64 steps
-- at most; the rounds again, from the workers among what fell, of those
-- hoped for and those that mention one; then each cycle of jumps one
-- signature.  What a function comes to at each step depends on its body
-- and on what each global it mentions was at the step before, never on
-- the rest of the program.  So it is worked out a component of the
-- definitions at a time (those mentioning one another round a cycle),
-- the components each mentions first, each given what was done with
-- those step by step (a `Track`): each function is weighed at the very
-- steps the whole program would weigh it, against the very workers, so
-- it comes to what it would -- the caps and all.

byKey : List IR.Def -> OrdMap.OrdMap String IR.Def
byKey defs =
  List.foldl
    (\m (d : IR.Def) -> OrdMap.insert m d.key d)
    OrdMap.empty
    defs

-- | what the fixpoint did with a function: its worker after each round
-- | that changed it, of the rounds (`first`), of the falls of the hopes
-- | (`falls`) and of the rounds after them (`again`), and its hope, if
-- | it was hoped for
type Track =
  { first : List (Pair Int Repr.Sig)
  , hope : Maybe Repr.Sig
  , falls : List (Pair Int Repr.Sig)
  , again : List (Pair Int Repr.Sig)
  }

withMaybe : Repr.Sigs -> String -> Maybe Repr.Sig -> Repr.Sigs
withMaybe sg k (Just s) = OrdMap.insert sg k s
withMaybe sg k Nothing = sg

isSig : Maybe Repr.Sig -> Bool
isSig (Just _) = True
isSig Nothing = False

hoped : Pair String Track -> Bool
hoped p = isSig (snd p).hope

-- | the changes made round by round: in order of the rounds, each
-- | round's
type Events = List (Pair Int (List (Pair String Repr.Sig)))

eventOne : OrdMap.OrdMap Int (List (Pair String Repr.Sig))
         -> String
         -> Pair Int Repr.Sig
         -> OrdMap.OrdMap Int (List (Pair String Repr.Sig))
eventOne m k (MkPair i s) =
  OrdMap.insert m i (MkPair k s :: fromMaybe Nil (OrdMap.lookup m i))

-- (the changes `part` says of the tracks, by round)
eventsOf : (Track -> List (Pair Int Repr.Sig))
         -> List (Pair String Track)
         -> Events
eventsOf part ts =
  OrdMap.toList
    (List.foldl
       (\m (p : Pair String Track) ->
          List.foldl (\m2 c -> eventOne m2 (fst p) c) m (part (snd p)))
       OrdMap.empty
       ts)

-- | a component: what is known, its definitions by key, each global by
-- | those of them that mention it
type Comp =
  { facts : Facts.Facts
  , defs : OrdMap.OrdMap String IR.Def
  , callers : OrdMap.OrdMap String (List String)
  }

-- (of its definitions, those changed and those that mention one changed)
touched : Comp -> List String -> List String
touched c ks =
  List.keepIf
    (\k -> OrdMap.member c.defs k)
    (sortedOnce
       (List.concatMap
          (\k -> k :: fromMaybe Nil (OrdMap.lookup c.callers k))
          ks))

-- | the rounds so far: the workers, of the component and of what it
-- | mentions, the forms made, each change of the component's with its
-- | round (the last first)
type Sim =
  { sigs : Repr.Sigs
  , imps : OrdMap.OrdMap String Imperative.Def
  , log : List (Pair String (Pair Int Repr.Sig))
  }

-- (the changes of what it mentions, made)
simWith : Sim -> List (Pair String Repr.Sig) -> Sim
simWith s cs = { sigs = withChanges s.sigs cs, imps = s.imps, log = s.log }

-- (the round `i`'s changes, the component's `own` and those of what it
-- mentions, made)
simAt : Sim
      -> Int
      -> OrdMap.OrdMap String Imperative.Def
      -> List (Pair String Repr.Sig)
      -> List (Pair String Repr.Sig)
      -> Sim
simAt s i imps own cs =
  { sigs = withChanges (withChanges s.sigs own) cs
  , imps = imps
  , log =
      List.foldl
        (\acc (p : Pair String Repr.Sig) ->
           MkPair (fst p) (MkPair i (snd p)) :: acc)
        s.log
        own
  }

-- (the round `i`'s changes of what it mentions, and the later ones)
eventsAt : Int -> Events -> Pair (List (Pair String Repr.Sig)) Events
eventsAt i (MkPair j cs :: rest) =
  if i == j then MkPair cs rest else MkPair Nil (MkPair j cs :: rest)
eventsAt i [] = MkPair Nil Nil

-- | how a phase goes on: from the round, the changes of what the
-- | component mentions from it on, those it weighs in it
type Go c = c -> Int -> Events -> List String -> Sim -> Sim

roundsStep : Comp
           -> Go Comp
           -> Int
           -> Sim
           -> Weighed
           -> Pair (List (Pair String Repr.Sig)) Events
           -> Sim
roundsStep c go i s w (MkPair cs rest) =
  go
    c
    (i + 1)
    rest
    (touched c (List.append (List.map fst w.changed) (List.map fst cs)))
    (simAt s i w.imps w.changed cs)

-- (none of it weighed: on to the next round that changes what it
-- mentions)
roundsIdle : Comp -> Go Comp -> Events -> Sim -> Sim
roundsIdle c go [] s = s
roundsIdle c go (MkPair j cs :: rest) s =
  go c (j + 1) rest (touched c (List.map fst cs)) (simWith s cs)

-- (the rounds from the `i`th on, `dirty` weighed in it, to the 64th)
roundsIn : Comp -> Int -> Events -> List String -> Sim -> Sim
roundsIn c i evs dirty s =
  if i > 64 then simWith s (List.concatMap snd evs)
  else if List.null dirty then roundsIdle c roundsIn evs s
  else roundsStep
      c
      roundsIn
      i
      s
      (List.foldl
         (weighOne c.facts c.defs s.sigs)
         { changed = Nil, imps = s.imps }
         dirty)
      (eventsAt i evs)

-- | the falls of a component: it, the rounds' workers, its hopes
type FallC = { comp : Comp, base : Repr.Sigs, hoped : Repr.Sigs }

hopedIn : FallC -> List String -> List String
hopedIn fc ks = List.keepIf (\k -> OrdMap.member fc.hoped k) ks

fallsStep : FallC
          -> Go FallC
          -> Int
          -> Sim
          -> List (Pair String Repr.Sig)
          -> Pair (List (Pair String Repr.Sig)) Events
          -> Sim
fallsStep fc go j s own (MkPair cs rest) =
  go
    fc
    (j + 1)
    rest
    (hopedIn
       fc
       (touched fc.comp (List.append (List.map fst own) (List.map fst cs))))
    (simAt s j s.imps own cs)

fallsIdle : FallC -> Go FallC -> Events -> Sim -> Sim
fallsIdle fc go [] s = s
fallsIdle fc go (MkPair j cs :: rest) s =
  go
    fc
    (j + 1)
    rest
    (hopedIn fc (touched fc.comp (List.map fst cs)))
    (simWith s cs)

-- (the falls from the `j`th on, `dirty` weighed in it: the 0th to the
-- 63rd, the 0th weighing all those hoped for)
fallsIn : FallC -> Int -> Events -> List String -> Sim -> Sim
fallsIn fc j evs dirty s =
  if j > 63 then simWith s (List.concatMap snd evs)
  else if List.null dirty then fallsIdle fc fallsIn evs s
  else fallsStep
      fc
      fallsIn
      j
      s
      (List.foldl (fallOne fc.comp.facts fc.base s.imps s.sigs) Nil dirty)
      (eventsAt j evs)

-- (each change of the log, by function, in order)
logged : List (Pair String (Pair Int Repr.Sig))
       -> OrdMap.OrdMap String (List (Pair Int Repr.Sig))
logged log =
  List.foldl
    (\m (p : Pair String (Pair Int Repr.Sig)) ->
       OrdMap.insert
         m
         (fst p)
         (snd p :: fromMaybe Nil (OrdMap.lookup m (fst p))))
    OrdMap.empty
    log

loggedOf : OrdMap.OrdMap String (List (Pair Int Repr.Sig))
         -> String
         -> List (Pair Int Repr.Sig)
loggedOf m k = fromMaybe Nil (OrdMap.lookup m k)

-- | what is worked out of a component: each function's track, and the
-- | workers
type Worked = { tracks : List (Pair String Track), sigs : Repr.Sigs }

-- (only the component's)
ownSigs : List IR.Def -> Repr.Sigs -> Repr.Sigs
ownSigs defs sg =
  List.foldl
    (\m (d : IR.Def) -> withMaybe m d.key (Repr.sigIn sg d.key))
    OrdMap.empty
    defs

trackOf : OrdMap.OrdMap String (List (Pair Int Repr.Sig))
        -> Repr.Sigs
        -> OrdMap.OrdMap String (List (Pair Int Repr.Sig))
        -> OrdMap.OrdMap String (List (Pair Int Repr.Sig))
        -> String
        -> Track
trackOf l1 hs l2 l3 k =
  { first = loggedOf l1 k
  , hope = Repr.sigIn hs k
  , falls = loggedOf l2 k
  , again = loggedOf l3 k
  }

-- (... after the rounds again, `s3`: each cycle of jumps one signature)
workedAgain : Comp -> List IR.Def -> Repr.Sigs -> Sim -> Sim -> Sim -> Worked
workedAgain c defs hs s1 s2 s3 =
  { tracks =
      List.map
        (\(d : IR.Def) ->
           MkPair
             d.key
             (trackOf (logged s1.log) hs (logged s2.log) (logged s3.log) d.key))
        defs
  , sigs = meetCycles (jumpsAll c.facts.arity defs) (ownSigs defs s3.sigs)
  }

-- (... after the falls, `s2`: the rounds again, from the workers among
-- what fell, of those hoped for and those that mention one)
workedFallen : Comp
             -> List IR.Def
             -> List (Pair String Track)
             -> Repr.Sigs
             -> Sim
             -> Sim
             -> Worked
workedFallen c defs known hs s1 s2 =
  workedAgain
    c
    defs
    hs
    s1
    s2
    (roundsIn
       c
       1
       (eventsOf (\(tr : Track) -> tr.again) known)
       (touched
          c
          (List.append
             (List.map fst (OrdMap.toList hs))
             (List.map fst (List.keepIf hoped known))))
       { sigs = workersOnly s2.sigs, imps = s2.imps, log = Nil })

-- (the falls' start: the rounds' workers, the hopes over them)
hopedSigs : Repr.Sigs -> Repr.Sigs -> List (Pair String Track) -> Repr.Sigs
hopedSigs base hs known =
  List.foldl
    (\m (p : Pair String Track) -> withMaybe m (fst p) (snd p).hope)
    (withChanges base (OrdMap.toList hs))
    known

-- (... after the rounds, `s1`: its functions hoped for (`hs`), fallen)
workedHoped : Comp
            -> List IR.Def
            -> List (Pair String Track)
            -> Sim
            -> Repr.Sigs
            -> Worked
workedHoped c defs known s1 hs =
  workedFallen
    c
    defs
    known
    hs
    s1
    (fallsIn
       { comp = c, base = s1.sigs, hoped = hs }
       0
       (eventsOf (\(tr : Track) -> tr.falls) known)
       (List.map fst (OrdMap.toList hs))
       { sigs = hopedSigs s1.sigs hs known, imps = s1.imps, log = Nil })

workedFrom : Comp -> List IR.Def -> List (Pair String Track) -> Sim -> Worked
workedFrom c defs known s1 =
  workedHoped
    c
    defs
    known
    s1
    (hopesOf c.facts { sigs = s1.sigs, imps = s1.imps })

compOf : Facts.Facts -> List IR.Def -> Comp
compOf facts defs =
  { facts = facts, defs = byKey defs, callers = callersOf defs }

-- | the workers of a component's definitions `defs`, given the tracks of
-- | those they mention outside it (`known`): each function's track, and
-- | the workers -- as the whole program's, the rounds, the hopes and
-- | their falls, the rounds again, then each cycle of jumps one signature
-- | >>> OrdMap.size (componentWorkers (Facts.factsOf Nil) Nil Nil).sigs
-- | 0
componentWorkers : Facts.Facts
                 -> List (Pair String Track)
                 -> List IR.Def
                 -> Worked
componentWorkers facts known defs =
  workedFrom
    (compOf facts defs)
    defs
    known
    (roundsIn
       (compOf facts defs)
       1
       (eventsOf (\(tr : Track) -> tr.first) known)
       (sortedOnce
          (List.map
             (\(d : IR.Def) -> d.key)
             (List.keepIf (\(d : IR.Def) -> isFunction d && numeric d) defs)))
       { sigs = OrdMap.empty, imps = OrdMap.empty, log = Nil })
