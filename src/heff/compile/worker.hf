-- Workers and wrappers, for the C backend (#39): which functions have a
-- worker, and its signature (`Repr.Sig`).  A worker is the function's
-- C function taking some of its parameters, and giving its result,
-- unboxed -- a fixed-width number as its C integer type, a `Float64` as
-- a `double` -- which a known call calls with them so: nothing boxed to
-- be given, nor unboxed where it is taken.  Its wrapper, a function of
-- `V`s as any other, unboxes them, calls it, and boxes what it gives:
-- what a closure's entry calls (heff.compile.refcount makes both).
--
-- The form has no types, so what a parameter is is told by what its body
-- does with it, as heff.compile.repr tells a variable's: a parameter, or
-- the result, is unboxed where its class would be were the function given
-- `V`s and its caller wanting a `V` (`Repr.proposeSig`) -- used as a
-- number, so that no call of the worker costs more than a call of the
-- function did.  What a body does with a known call's operands and
-- result is told by the workers there are, so this is a fixpoint on the
-- calls: from no workers, each function weighed again where one it calls
-- has a new one, a parameter once unboxed staying so, until none changes
-- (each round in the order of the keys, against the workers at its
-- start: what it comes to is the same whatever order the program is in);
-- then what it could not see, functions round a cycle of calls giving
-- one another their numbers, from hopes that fall where they must ("Hopes
-- on cycles of calls").
--
-- Only what a body says is evidence, never what a caller gives: a
-- function called with an `Int64` at one call and a `Float64` at another
-- is generic, and is called through its wrapper from a closure with
-- anything.
--
-- A function calling another of as many parameters last jumps to it
-- (`HEFF_LAST`), which C allows only between functions of one type: the
-- functions that jump to one another round a cycle, which may go round
-- any number of times, are given one signature, unboxed only where all of
-- theirs are (`meetCycles`); a call last out of a cycle, of another type,
-- is a call.  A function a call of which may give back a bounce gives a
-- `V`.

module heff.compile.worker

import heff.compile.facts as Facts
import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.compile.ranges as Ranges
import heff.compile.repr as Repr
import std.map as Map

-- What may have a worker
--------------------------------------------------------------------------------

-- (what a body is weighed knowing: the workers `sg`, the tags' fields
-- that may be flat)
knowIn : Facts.Facts -> Repr.Sigs -> Repr.Know
knowIn facts sg = { sigs = sg, flat = facts.flat }

-- (a field's type, kept flat where it is read: see `Repr.flatOf`)
flatTy : IR.FieldTy -> Bool
flatTy FtFloat = True
flatTy (FtFixed _) = True
flatTy t = False

shaped : Maybe Repr.Shape -> Bool
shaped (Just _) = True
shaped Nothing = False

-- (a primitive done unboxed: not one on words (heff.compile.ranges, #79),
-- which no worker is given unboxed, its parameters' words being known
-- where the function is entered)
numericPrim : String -> Bool
numericPrim p = shaped (Repr.primShape p) && not (Ranges.isWordPrim p)

-- (whether the worklist has evidence of a number: a literal, a primitive
-- done unboxed, a field kept flat)
numericW : List IR.Expr -> Bool
numericW Nil = False
numericW (Cons (EFixed _ _) _) = True
numericW (Cons (EFloat _) _) = True
numericW (Cons (EFloat32 _) _) = True
numericW (Cons (EPrimCall p args) rest) =
  numericPrim p || numericW (IR.appendI args rest)
numericW (Cons (EProj e _ _ t) rest) = flatTy t || numericW (Cons e rest)
numericW (Cons (ELam _ b) rest) = numericW (Cons b rest)
numericW (Cons (EApp f args) rest) = numericW (Cons f (IR.appendI args rest))
numericW (Cons (ELet _ a b) rest) = numericW (Cons a (Cons b rest))
numericW (Cons (ERecord fs _) rest) = numericW (IR.pushFields fs rest)
numericW (Cons (ETag _ args _) rest) = numericW (IR.appendI args rest)
numericW (Cons (EMatch s arms) rest) = numericW (Cons s (IR.pushArms arms rest))
numericW (Cons (ECall _ args) rest) = numericW (IR.appendI args rest)
numericW (Cons _ rest) = numericW rest

-- | whether a function's body has evidence of a number of its own: those
-- | that have none have a worker only where one they call has
numeric : IR.Def -> Bool
numeric d = numericW (Cons d.body Nil)

isFunction : IR.Def -> Bool
isFunction { body = ELam _ _ } = True
isFunction d = False

-- (each function, by the definitions that mention it: those weighed
-- again where it has a new worker)
callersOne : Map.Map String (List String)
           -> IR.Def
           -> Map.Map String (List String)
callersOne m d =
  List.foldl
    (\acc g ->
       Map.insert
         acc
         g
         (Cons d.key (fromMaybe Nil (Map.lookup acc g))))
    m
    (IR.globalsIn d.body)

callersOf : List IR.Def -> Map.Map String (List String)
callersOf defs = List.foldl callersOne Map.empty defs

-- (each once, in order)
sortedOnce : List String -> List String
sortedOnce xs =
  List.map
    fst
    (Map.toList
       (List.foldl
          (\m x -> Map.insert m x (MkUnit : Unit))
          Map.empty
          xs))

-- The fixpoint
--------------------------------------------------------------------------------

-- | what the rounds go on with: the workers so far, and the functions'
-- | imperative forms made so far (each made once, when first weighed)
type Round = { sigs : Repr.Sigs, imps : Map.Map String Imperative.Def }

-- (a function's imperative form, its names drawn afresh, as the C
-- backend makes it: heff.compile.lower's `cDef`)
impOf : IR.Def -> Imperative.Def
impOf d = case IR.freshen 0 d.body of
  MkPair b n -> Imperative.impDef True n (IR.mkDef d.key d.name b)

-- (the one made before, if it was: made only if it was not)
impFrom : IR.Def -> Maybe Imperative.Def -> Imperative.Def
impFrom d (Just md) = md
impFrom d Nothing = impOf d

impIn : Map.Map String Imperative.Def -> IR.Def -> Imperative.Def
impIn imps d = impFrom d (Map.lookup imps d.key)

plainSig : Int -> Repr.Sig
plainSig n = { params = List.replicate n RepV, result = RepV }

-- (as it was, unboxed where it was, else as proposed)
grownRepr : Repr.Repr -> Repr.Repr -> Repr.Repr
grownRepr RepV r = r
grownRepr old r = old

grown : Repr.Sig -> Repr.Sig -> Repr.Sig
grown old new =
  { params = List.zipWith grownRepr old.params new.params
  , result = grownRepr old.result new.result
  }

sigOr : Repr.Sigs -> String -> Int -> Repr.Sig
sigOr sg k n = fromMaybe (plainSig n) (Repr.sigIn sg k)

-- | a round's work so far: the changed workers, and the forms made
type Weighed =
  { changed : List (Pair String Repr.Sig)
  , imps : Map.Map String Imperative.Def
  }

weighedWith : Weighed
            -> String
            -> Imperative.Def
            -> Repr.Sig
            -> Repr.Sig
            -> Weighed
weighedWith acc k md old new =
  { changed =
      if Repr.sigEq old new then acc.changed
      else Cons (MkPair k new) acc.changed
  , imps = Map.insert acc.imps k md
  }

-- (a function weighed against the workers `sg`, its form `md`)
weighImp : Facts.Facts
         -> Repr.Sigs
         -> Weighed
         -> String
         -> Imperative.Def
         -> Weighed
weighImp facts sg acc k md@(MkDef _ _ (DefFun xs (MkBlock t))) =
  weighedWith
    acc
    k
    md
    (sigOr sg k (List.length xs))
    (grown
       (sigOr sg k (List.length xs))
       (Repr.proposeSig
          (knowIn facts sg)
          (Map.member facts.bounce k)
          xs
          t))
weighImp facts sg acc k md = acc

weighOne : Facts.Facts
         -> Map.Map String IR.Def
         -> Repr.Sigs
         -> Weighed
         -> String
         -> Weighed
weighOne facts defs sg acc k = case Map.lookup defs k of
  Just d ->
    if isFunction d then weighImp facts sg acc k (impIn acc.imps d) else acc
  Nothing -> acc

withChanges : Repr.Sigs -> List (Pair String Repr.Sig) -> Repr.Sigs
withChanges sg cs = List.foldl (\m p -> Map.insert m (fst p) (snd p)) sg cs

-- | what the next round weighs: the workers so far, and those whose
-- | callees' workers changed (and those changed themselves)
type Next = { round : Round, dirty : List String }

nextOf : Map.Map String (List String) -> Round -> Weighed -> Next
nextOf callers r w =
  { round = { sigs = withChanges r.sigs w.changed, imps = w.imps }
  , dirty =
      sortedOnce
        (List.concatMap
           (\p ->
              Cons
                (fst p)
                (fromMaybe Nil (Map.lookup callers (fst p))))
           w.changed)
  }

-- (the rounds, `n` more at most, until no worker changes)
rounds : Facts.Facts
       -> Map.Map String IR.Def
       -> Map.Map String (List String)
       -> Int
       -> Next
       -> Round
rounds facts defs callers n nx =
  if n <= 0 || List.null nx.dirty then nx.round
  else rounds
      facts
      defs
      callers
      (n - 1)
      (nextOf
         callers
         nx.round
         (List.foldl
            (weighOne facts defs nx.round.sigs)
            { changed = Nil, imps = nx.round.imps }
            nx.dirty))

-- Cycles of jumps
--------------------------------------------------------------------------------

-- (the calls last of a body: each callee, and how many operands)
tailCalls : IR.Expr -> List (Pair String Int)
tailCalls (ELet _ _ b) = tailCalls b
tailCalls (EMatch _ arms) = List.concatMap (\a -> tailCalls (IR.armBody a)) arms
tailCalls (ECall g args) = Cons (MkPair g (List.length args)) Nil
tailCalls e = Nil

arityIs : Int -> Maybe Int -> Bool
arityIs n (Just m) = n == m
arityIs n Nothing = False

-- (a call last of another function, of as many parameters as `n`, with
-- as many: a jump, heff.compile.refcount's `agrees`)
jumpTo : Map.Map String Int -> String -> Int -> Pair String Int -> Bool
jumpTo ar k n (MkPair g m) =
  not (strEq g k) && m == n && arityIs n (Map.lookup ar g)

-- | whom a function jumps to
jumpsOf : Map.Map String Int -> IR.Def -> List String
jumpsOf ar d@{ body = ELam xs b } =
  List.map fst (List.filter (jumpTo ar d.key (List.length xs)) (tailCalls b))
jumpsOf ar d = Nil

jumpsAll : Map.Map String Int -> List IR.Def -> Map.Map String (List String)
jumpsAll ar defs =
  List.foldl
    (\m (d : IR.Def) -> Map.insert m d.key (jumpsOf ar d))
    Map.empty
    defs

-- (what the worklist reaches by jumps, `seen` so far)
reachGo : Map.Map String (List String)
        -> Map.Map String Unit
        -> List String
        -> Map.Map String Unit
reachGo js seen Nil = seen
reachGo js seen (Cons k rest) =
  if Map.member seen k then reachGo js seen rest
  else reachGo
      js
      (Map.insert seen k MkUnit)
      (List.append (fromMaybe Nil (Map.lookup js k)) rest)

-- | what a function's jumps reach, and theirs, and so on
reach : Map.Map String (List String) -> String -> Map.Map String Unit
reach js k = reachGo js Map.empty (fromMaybe Nil (Map.lookup js k))

-- | the functions on a cycle of jumps with `k`, itself among them if it
-- | is on one
cycleOf : Map.Map String (List String) -> String -> List String
cycleOf js k =
  List.filter
    (\h -> Map.member (reach js h) k)
    (List.map fst (Map.toList (reach js k)))

-- (unboxed where both are, as the same)
meetRepr : Repr.Repr -> Repr.Repr -> Repr.Repr
meetRepr a b = if Repr.reprEq a b then a else RepV

meetSig : Repr.Sig -> Repr.Sig -> Repr.Sig
meetSig a b =
  { params = List.zipWith meetRepr a.params b.params
  , result = meetRepr a.result b.result
  }

-- (a function given the signature: a worker, if it has one)
withSig : Repr.Sigs -> String -> Repr.Sig -> Repr.Sigs
withSig sg k s =
  if Repr.hasWorker s then Map.insert sg k s
  else Map.delete sg k

-- (the functions on a cycle of jumps given one signature: unboxed where
-- all of theirs are)
meetIn : Repr.Sigs -> Repr.Sig -> List String -> Repr.Sigs
meetIn sg s ks =
  List.foldl
    (\m k ->
       withSig
         m
         k
         (List.foldl
            meetSig
            s
            (List.map (\h -> sigOr sg h (List.length s.params)) ks)))
    sg
    ks

meetAt : Map.Map String (List String)
       -> Repr.Sigs
       -> Pair String Repr.Sig
       -> Repr.Sigs
meetAt js sg (MkPair k s) =
  if List.length (cycleOf js k) >= 2 then meetIn sg s (cycleOf js k) else sg

-- | each cycle of jumps with a worker on it given one signature
meetCycles : Map.Map String (List String) -> Repr.Sigs -> Repr.Sigs
meetCycles js sg = List.foldl (meetAt js) sg (Map.toList sg)

-- Hopes on cycles of calls
--------------------------------------------------------------------------------

-- The rounds above start from no workers and only unboxing, so functions
-- calling one another round a cycle, each giving back what the other
-- gives (an accumulator), keep
-- it a `V`: each sees the other give a `V`.  So the functions weighed
-- are given each its hope (`Repr.hopeSig`: unboxed where its body's
-- evidence says one type, whatever that costs), and weighed again
-- against the hopes, each kept only where its body, given them, still
-- says so (`Repr.proposeSig`), until none falls -- each never below what
-- the rounds gave it.  What is left of a hope is a type its body says,
-- as a worker's always is, so a worker is never wrong of what it takes.

-- (whether a call of it may give back a bounce)
bouncesIn : Facts.Facts -> String -> Bool
bouncesIn facts k = Map.member facts.bounce k

-- (a hope, where it is more than it has)
hopedTo : Repr.Sigs -> String -> Repr.Sig -> Repr.Sig -> Repr.Sigs
hopedTo acc k old new = if Repr.sigEq old new then acc else Map.insert acc k new

hopeOne : Facts.Facts
        -> Repr.Sigs
        -> Repr.Sigs
        -> Pair String Imperative.Def
        -> Repr.Sigs
hopeOne facts sg acc (MkPair k (MkDef _ _ (DefFun xs (MkBlock t)))) =
  hopedTo
    acc
    k
    (sigOr sg k (List.length xs))
    (grown
       (sigOr sg k (List.length xs))
       (Repr.hopeSig (knowIn facts sg) (bouncesIn facts k) xs t))
hopeOne facts sg acc p = acc

-- | the functions weighed, each its hope where that is more than the
-- | rounds gave it
hopesOf : Facts.Facts -> Round -> Repr.Sigs
hopesOf facts r =
  List.foldl (hopeOne facts r.sigs) Map.empty (Map.toList r.imps)

-- (a new signature, where it changed)
fellTo : List (Pair String Repr.Sig)
       -> String
       -> Repr.Sig
       -> Repr.Sig
       -> List (Pair String Repr.Sig)
fellTo acc k old new =
  if Repr.sigEq old new then acc else Cons (MkPair k new) acc

-- (a hope weighed against the signatures `sg`: kept where the body,
-- given them, says so too, never below what the rounds gave it, `base`)
fallImp : Facts.Facts
        -> Repr.Sigs
        -> Repr.Sigs
        -> List (Pair String Repr.Sig)
        -> String
        -> Imperative.Def
        -> List (Pair String Repr.Sig)
fallImp facts base sg acc k (MkDef _ _ (DefFun xs (MkBlock t))) =
  fellTo
    acc
    k
    (sigOr sg k (List.length xs))
    (grown
       (sigOr base k (List.length xs))
       (meetSig
          (sigOr sg k (List.length xs))
          (Repr.proposeSig (knowIn facts sg) (bouncesIn facts k) xs t)))
fallImp facts base sg acc k md = acc

fallOne : Facts.Facts
        -> Repr.Sigs
        -> Map.Map String Imperative.Def
        -> Repr.Sigs
        -> List (Pair String Repr.Sig)
        -> String
        -> List (Pair String Repr.Sig)
fallOne facts base imps sg acc k = case Map.lookup imps k of
  Just md -> fallImp facts base sg acc k md
  Nothing -> acc

-- | what the falls go on with: the rounds' workers, their forms, the
-- | functions hoped for and those that mention each
type Fall =
  { facts : Facts.Facts
  , base : Repr.Sigs
  , imps : Map.Map String Imperative.Def
  , hoped : Repr.Sigs
  , callers : Map.Map String (List String)
  }

-- (those hoped for whose callees changed, and those changed themselves)
fallDirty : Fall -> List (Pair String Repr.Sig) -> List String
fallDirty fl cs =
  List.filter
    (\k -> Map.member fl.hoped k)
    (sortedOnce
       (List.concatMap
          (\p ->
             Cons
               (fst p)
               (fromMaybe Nil (Map.lookup fl.callers (fst p))))
          cs))

-- (the hopes of `dirty` weighed against `sg`: those that fell)
fallStep : Fall -> Repr.Sigs -> List String -> List (Pair String Repr.Sig)
fallStep fl sg dirty =
  List.foldl (fallOne fl.facts fl.base fl.imps sg) Nil dirty

-- (the falls `cs`, then `n` more at most, until no signature falls)
falls : Fall -> Int -> Repr.Sigs -> List (Pair String Repr.Sig) -> Repr.Sigs
falls fl n sg cs =
  if n <= 0 || List.null cs then sg
  else falls
      fl
      (n - 1)
      (withChanges sg cs)
      (fallStep fl (withChanges sg cs) (fallDirty fl cs))

-- (those that mention any hoped for, and those hoped for)
fallDirtyAll : Fall -> List String
fallDirtyAll fl =
  sortedOnce
    (List.concatMap
       (\p ->
          Cons
            (fst p)
            (fromMaybe Nil (Map.lookup fl.callers (fst p))))
       (Map.toList fl.hoped))

roundSigs : Round -> Repr.Sigs
roundSigs r = r.sigs

-- (only those with a worker)
workersOnly : Repr.Sigs -> Repr.Sigs
workersOnly sg =
  List.foldl (\m p -> withSig m (fst p) (snd p)) sg (Map.toList sg)

-- (the hopes, fallen as far as they fall)
fallen : Fall -> Repr.Sigs
fallen fl =
  falls
    fl
    64
    (withChanges fl.base (Map.toList fl.hoped))
    (fallStep
       fl
       (withChanges fl.base (Map.toList fl.hoped))
       (List.map fst (Map.toList fl.hoped)))

hopingWith : Facts.Facts -> Map.Map String IR.Def -> Fall -> Repr.Sigs
hopingWith facts defs fl =
  if Map.size fl.hoped == 0 then fl.base
  else roundSigs
      (rounds
         facts
         defs
         fl.callers
         64
         { round = { sigs = workersOnly (fallen fl), imps = fl.imps }
         , dirty = fallDirtyAll fl
         })

-- | the rounds' workers, hoped for on cycles of calls: those hoped for
-- | weighed against the hopes until none falls, then the rounds again
-- | for what calls them
hoping : Facts.Facts
       -> Map.Map String IR.Def
       -> Map.Map String (List String)
       -> Round
       -> Repr.Sigs
hoping facts defs callers r =
  hopingWith
    facts
    defs
    { facts = facts
    , base = r.sigs
    , imps = r.imps
    , hoped = hopesOf facts r
    , callers = callers
    }

-- Workers
--------------------------------------------------------------------------------

byKey : List IR.Def -> Map.Map String IR.Def
byKey defs =
  List.foldl
    (\m (d : IR.Def) -> Map.insert m d.key d)
    Map.empty
    defs

-- | the functions with a worker, of the program's definitions as the C
-- | backend lowers them (in monadic form), what is known of them `facts`
-- | >>> Map.size (workers (Facts.factsOf Nil) Nil)
-- | 0
workers : Facts.Facts -> List IR.Def -> Repr.Sigs
workers facts defs =
  meetCycles
    (jumpsAll facts.arity defs)
    (hoping
       facts
       (byKey defs)
       (callersOf defs)
       (rounds
          facts
          (byKey defs)
          (callersOf defs)
          64
          { round = { sigs = Map.empty, imps = Map.empty }
          , dirty =
              sortedOnce
                (List.map
                   (\(d : IR.Def) -> d.key)
                   (List.filter
                      (\(d : IR.Def) -> isFunction d && numeric d)
                      defs))
          }))
