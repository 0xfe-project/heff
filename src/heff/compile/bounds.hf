-- Indices checked once (#102), for the C backend: a function going
-- round a loop (`CLoop`) that reads or sets arrays at an index, where a
-- test has found it below an array's length, checks each read and set
-- against its own array's length again -- a way out of the loop that C
-- cannot rule out, so that it makes no vector operations of it.  But
-- where the index is a word that only grows (given itself, or itself
-- and a step of at least 0, each round, and set nowhere else) and the
-- arrays keep their lengths (given themselves, or themselves set, each
-- round), what the test finds holds of every array at least as long as
-- the one tested, on every round, once the index is at least 0 where
-- the loop is entered.
--
-- So the function checks that, once, where it is entered -- the index
-- at least 0, each array read or set at it at least as long as the one
-- tested -- and if so goes round a copy of its loop of its own, whose
-- reads and sets there are not checked (`arrayIndexIn`,
-- `arraySetOwnedIn`); if not, round the loop as it was, so an index out
-- of range fails as it did.
--
-- And an array of a fixed-width number (`Int64`, `UInt8`, ...) may keep
-- its elements flat or as `V`s, so a read of one in range looks at how
-- it keeps them, each round.  But an array that keeps its length round
-- the loop keeps them as it did where the loop was entered (a `set`
-- writes an element as the array keeps them, a copy keeps them as the
-- array it is of).  So the check also has each array read so keep the
-- number flat (`arrayKeeps`) -- those read in range here, and those
-- read where their index was tested (`arrayIndexInAny`,
-- heff.compile.tested) -- and the copy's reads of them do not look.  An
-- array held alone where the function is entered (heff.compile.owned,
-- `arrayOwn` of the number) is flat there already: its reads look
-- nowhere, in the loop as it was too, with no check.

module heff.compile.bounds

import heff.compile.owned as Owned
import heff.elab.primitive
import heff.compile.refcount as RefCount
import heff.compile.repr as Repr
import heff.elab.fixed as Fixed

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

-- The loop
--------------------------------------------------------------------------------

-- | what goes round the loop again gives each parameter
type Again = List (Pair String RefCount.Value)

-- (each loop again, in front of `acc`, not in a lambda's body)
againSt : (List Again -> List RefCount.Statement -> List Again)
        -> List Again
        -> RefCount.Statement
        -> List Again
againSt go acc (CLoop ps es) = Cons (List.zip ps es) acc
againSt go acc (CIf _ a b) = go (go acc a) b
againSt go acc (CSwitch _ arms _) =
  List.foldl (\a arm -> go a (RefCount.caseArmBody arm)) acc arms
againSt go acc s = acc

agains : List Again -> List RefCount.Statement -> List Again
agains acc ss = List.foldl (againSt agains) acc ss

-- (whether a statement goes to a label: a loop to an arm)
labelledSt : (Bool -> List RefCount.Statement -> Bool)
           -> Bool
           -> RefCount.Statement
           -> Bool
labelledSt go acc (CLoopTo _ _ _) = True
labelledSt go acc (CLabel _) = True
labelledSt go acc (CIf _ a b) = go (go acc a) b
labelledSt go acc (CSwitch _ arms _) =
  List.foldl (\a arm -> go a (RefCount.caseArmBody arm)) acc arms
labelledSt go acc s = acc

labelled : Bool -> List RefCount.Statement -> Bool
labelled acc ss = List.foldl (labelledSt labelled) acc ss

-- | the loop's parameters (a worker's own variables, where it is given
-- | them boxed)
loopParams : List Again -> List String
loopParams (Cons ag _) = List.map fst ag
loopParams Nil = Nil

-- (what the loop gives the parameter `x`)
givenTo : String -> Again -> Maybe RefCount.Value
givenTo x Nil = Nothing
givenTo x (Cons (MkPair y e) rest) =
  if strEq x y then Just e else givenTo x rest

-- (the variable a value is)
varOf : RefCount.Value -> Maybe String
varOf (RLocal x) = Just x
varOf (RDup x) = Just x
varOf e = Nothing

isVar : String -> Maybe String -> Bool
isVar x (Just y) = strEq x y
isVar x Nothing = False

-- The index
--------------------------------------------------------------------------------

-- (`x` and a literal of at least 0)
stepSum : String -> List RefCount.Value -> Bool
stepSum x (Cons (RFixU _ k) (Cons e Nil)) = k >= 0 && isVar x (varOf e)
stepSum x (Cons e (Cons (RFixU _ k) Nil)) = k >= 0 && isVar x (varOf e)
stepSum x es = False

-- | a step of the index `x`: itself, or itself and at least 0
stepOf : String -> RefCount.Value -> Bool
stepOf x (RPrimU p es) = eqPrim p WordAdd && stepSum x es
stepOf x e = isVar x (varOf e)

-- (set nowhere but by the loop)
unset : List (Pair String RefCount.Value) -> String -> Bool
unset ds x = List.null (Owned.valuesOf x ds)

-- | the function's indices: its words that only grow
indices : RefCount.Fun
        -> List (Pair String RefCount.Value)
        -> List Again
        -> List String
indices f ds ags =
  List.keepIf
    (\x ->
       Repr.reprEq RepInt (Repr.reprOf f.reprs x)
       && unset ds x
       && List.all (\ag -> maybe False (stepOf x) (givenTo x ag)) ags)
    (loopParams ags)

-- The arrays
--------------------------------------------------------------------------------

isSet : Prim -> Bool
isSet ArraySet = True
isSet ArraySetOwned = True
isSet ArraySetOwnedIn = True
isSet _ = False

-- | whether a value is the array `b`, or it set, through the variables
-- | bound only to such (not those `seen`, looked through already)
sameAs : List (Pair String RefCount.Value)
       -> List String
       -> String
       -> RefCount.Value
       -> Bool
sameAs ds seen b (RLocal y) =
  strEq y b
  || (not (elemS y seen)
      && not (List.null (Owned.valuesOf y ds))
      && List.all (sameAs ds (Cons y seen) b) (Owned.valuesOf y ds))
sameAs ds seen b (RDup y) = sameAs ds seen b (RLocal y)
sameAs ds seen b (RPrim p es) =
  isSet p && maybe False (sameAs ds seen b) (List.head es)
sameAs ds seen b (RPrimAt p _ es) =
  isSet p && maybe False (sameAs ds seen b) (List.head es)
sameAs ds seen b e = False

-- | the function's parameters that keep their lengths round the loop
-- | (those not arrays never read so)
kept : RefCount.Fun
     -> List (Pair String RefCount.Value)
     -> List Again
     -> List String
kept f ds ags =
  List.keepIf
    (\b ->
       unset ds b
       && List.all (\ag -> maybe False (sameAs ds Nil b) (givenTo b ag)) ags)
    (loopParams ags)

-- | what is known of a function: its indices, the arrays that keep their
-- | lengths, and what its variables are bound or set to
type Info =
  { indices : List String
  , arrays : List String
  , defs : List (Pair String RefCount.Value)
  }

-- (the array of `arrays` that the variable is, if one is)
baseOf : Info -> String -> Maybe String
baseOf info y =
  List.head
    (List.keepIf (\b -> sameAs info.defs Nil b (RLocal y)) info.arrays)

-- Tests
--------------------------------------------------------------------------------

-- | an index found below the length of an array (one of `arrays`)
type Range = { index : String, array : String }

-- (the array a length is of)
lengthArray : RefCount.Value -> Maybe String
lengthArray (RPrim p (Cons e Nil)) =
  if eqPrim p ArrayLength then varOf e else Nothing
lengthArray e = Nothing

-- (a length, as a word)
lengthOf : RefCount.Value -> Maybe String
lengthOf (RUnbox RepInt e) = lengthArray e
lengthOf (RPeek RepInt e) = lengthArray e
lengthOf e = Nothing

rangeOf : Info -> Maybe String -> Maybe String -> Maybe Range
rangeOf info (Just i) (Just a) =
  if elemS i info.indices
  then maybe Nothing (\b -> Just { index = i, array = b }) (baseOf info a)
  else Nothing
rangeOf info i a = Nothing

-- (a range, and whether it holds where the test does, or where it does
-- not)
type Found = Pair Range Bool

foundOf : Bool -> Maybe Range -> Maybe Found
foundOf yes (Just r) = Just (MkPair r yes)
foundOf yes Nothing = Nothing

relFound : Info -> Prim -> RefCount.Value -> RefCount.Value -> Maybe Found
relFound info WordLt a b = foundOf True (rangeOf info (varOf a) (lengthOf b))
relFound info WordLe a b = foundOf False (rangeOf info (varOf b) (lengthOf a))
relFound info p a b = Nothing

relTest : Info -> Prim -> List RefCount.Value -> Maybe Found
relTest info p (Cons a (Cons b Nil)) = relFound info p a b
relTest info p es = Nothing

flipped : Maybe Found -> Maybe Found
flipped (Just (MkPair r yes)) = Just (MkPair r (not yes))
flipped Nothing = Nothing

-- | a test of an index against an array's length: `i < length a`, or
-- | `length a <= i`, or either not
rangeTest : Info -> RefCount.Test -> Maybe Found
rangeTest info (CondRelU p es) = relTest info p es
rangeTest info (CondNot c) = flipped (rangeTest info c)
rangeTest info c = Nothing

-- (the ranges holding where a test does, and where it does not)
splitOn : List Range -> Maybe Found -> Pair (List Range) (List Range)
splitOn env (Just (MkPair r True)) = MkPair (Cons r env) env
splitOn env (Just (MkPair r False)) = MkPair env (Cons r env)
splitOn env Nothing = MkPair env env

split : Info -> List Range -> RefCount.Test -> Pair (List Range) (List Range)
split info env c = splitOn env (rangeTest info c)

-- Reads and sets in range
--------------------------------------------------------------------------------

-- | a read or set known in range: its index, the array tested, the
-- | array read or set, and the number it is read as from where the
-- | array keeps it flat, if it is a fixed-width one's (an array of such
-- | may keep `V`s, so it is read so only where it is checked flat)
type Need =
  { index : String, tested : String, read : String, flat : Maybe Repr.Repr }

-- (the primitives read or set unchecked where they are known in range)
uncheckedOf : Prim -> Maybe Prim
uncheckedOf ArrayIndex = Just ArrayIndexIn
uncheckedOf ArraySetOwned = Just ArraySetOwnedIn
uncheckedOf ArrayPeek = Just ArrayPeekIn
uncheckedOf p = Nothing

-- (the index, a word boxed or a variable)
indexOf : RefCount.Value -> Maybe String
indexOf (RBox _ e) = varOf e
indexOf e = varOf e

rangeArray : Range -> Maybe String
rangeArray r = Just r.array

isIndex : String -> Range -> Bool
isIndex i r = strEq r.index i

testedFor : String -> List Range -> Maybe String
testedFor i env =
  maybe Nothing rangeArray (List.head (List.keepIf (isIndex i) env))

needOf : Info
       -> List Range
       -> Maybe Repr.Repr
       -> Maybe String
       -> Maybe String
       -> Maybe Need
needOf info env fl (Just y) (Just i) =
  maybe
    Nothing
    (\a ->
       maybe
         Nothing
         (\b -> Just { index = i, tested = a, read = b, flat = fl })
         (baseOf info y))
    (testedFor i env)
needOf info env fl y i = Nothing

needIn : Info
       -> List Range
       -> Maybe Repr.Repr
       -> List RefCount.Value
       -> Maybe Need
needIn info env fl (Cons a (Cons i _)) =
  needOf info env fl (varOf a) (indexOf i)
needIn info env fl es = Nothing

-- | a primitive's read or set, known in range where the ranges `env`
-- | hold
needAt : Info
       -> List Range
       -> Prim
       -> Maybe Repr.Repr
       -> List RefCount.Value
       -> Maybe Need
needAt info env p fl es =
  maybe Nothing (\_ -> needIn info env fl es) (uncheckedOf p)

-- (a read of a fixed-width number: the number)
flatRead : Prim -> Repr.Repr -> Maybe Repr.Repr
flatRead p (RepFix w) = if eqPrim p ArrayIndex then Just (RepFix w) else Nothing
flatRead p r = Nothing

-- (a value's own read or set, not its operands')
ownNeed : Info -> List Range -> RefCount.Value -> Maybe Need
ownNeed info env (RPrim p es) = needAt info env p Nothing es
ownNeed info env (RPrimAt p r es) = needAt info env p (flatRead p r) es
ownNeed info env e = Nothing

-- | the reads and sets known in range in a value (not in a lambda's body)
needsIn : Info -> List Range -> RefCount.Value -> List Need
needsIn info env e =
  List.append
    (maybe Nil (\n -> Cons n Nil) (ownNeed info env e))
    (List.concatMap (needsIn info env) (Owned.kids e))

-- (the values of a statement, each with the ranges holding there)
type Scoped = Pair (List Range) RefCount.Value

scopedAll : List Range -> List RefCount.Value -> List Scoped
scopedAll env es = List.map (\e -> MkPair env e) es

scopedSt : (List Range -> List RefCount.Statement -> List Scoped)
         -> Info
         -> List Range
         -> RefCount.Statement
         -> List Scoped
scopedSt go info env (CLet _ e) = scopedAll env (Cons e Nil)
scopedSt go info env (CSet _ e) = scopedAll env (Cons e Nil)
scopedSt go info env (CReturn e) = scopedAll env (Cons e Nil)
scopedSt go info env (CIf c a b) =
  List.append
    (scopedAll env (Owned.condKids c))
    (List.append
       (go (fst (split info env c)) a)
       (go (snd (split info env c)) b))
scopedSt go info env (CSwitch e arms _) =
  Cons
    (MkPair env e)
    (List.concatMap (\arm -> go env (RefCount.caseArmBody arm)) arms)
scopedSt go info env (CInPlace f es) = scopedAll env (Cons f es)
scopedSt go info env (CRoomed f es) = scopedAll env (Cons f es)
scopedSt go info env (CTail f es) = scopedAll env (Cons f es)
scopedSt go info env (CLoop _ es) = scopedAll env es
scopedSt go info env (CJump _ _ es) = scopedAll env es
scopedSt go info env s = Nil

scoped : Info -> List Range -> List RefCount.Statement -> List Scoped
scoped info env ss = List.concatMap (scopedSt (scoped info) info env) ss

-- Flat reads
--------------------------------------------------------------------------------

-- | a read of an array that may keep its elements flat: the array (one
-- | of `arrays`), the number read
type Read = Pair String Repr.Repr

sameRead : Read -> Read -> Bool
sameRead (MkPair a r) (MkPair b s) = strEq a b && Repr.reprEq r s

isRead : List Read -> Read -> Bool
isRead rs r = List.any (sameRead r) rs

nubReads : List Read -> List Read -> List Read
nubReads seen Nil = Nil
nubReads seen (Cons r rs) =
  if isRead seen r then nubReads seen rs
  else Cons r (nubReads (Cons r seen) rs)

baseOfVar : Info -> Maybe String -> Maybe String
baseOfVar info (Just y) = baseOf info y
baseOfVar info Nothing = Nothing

-- (a read of a fixed-width number where its index was tested, of one of
-- `arrays`)
anyRead : Info -> RefCount.Value -> List Read
anyRead info (RPrimAt p r (Cons a _)) =
  if eqPrim p ArrayIndexInAny
  then maybe Nil (\b -> Cons (MkPair b r) Nil) (baseOfVar info (varOf a))
  else Nil
anyRead info e = Nil

-- | such reads in a value (not in a lambda's body)
readsIn : Info -> RefCount.Value -> List Read
readsIn info e =
  List.append (anyRead info e) (List.concatMap (readsIn info) (Owned.kids e))

needRead : Need -> List Read
needRead n = maybe Nil (\r -> Cons (MkPair n.read r) Nil) n.flat

-- | the arrays held alone where the function is entered, each kept flat
-- | as the number (heff.compile.owned)
ownedSt : RefCount.Statement -> List Read
ownedSt (CSet x (RPrimAt p r (Cons (RLocal y) Nil))) =
  if eqPrim p ArrayOwn && strEq x y then Cons (MkPair x r) Nil else Nil
ownedSt s = Nil

-- Unchecked
--------------------------------------------------------------------------------

-- | a value, made bottom up by `f` (not in a lambda's body)
mapExp : (RefCount.Value -> RefCount.Value) -> RefCount.Value -> RefCount.Value
mapExp f (RTag t b es) = f (RTag t b (List.map (mapExp f) es))
mapExp f (RTagIn e t b es) =
  f (RTagIn (mapExp f e) t b (List.map (mapExp f) es))
mapExp f (RRec ls b es) = f (RRec ls b (List.map (mapExp f) es))
mapExp f (RRecIn x n k g s ls fs sure) =
  f
    (RRecIn
       x
       n
       k
       g
       s
       ls
       (List.map (\p -> MkPair (fst p) (mapExp f (snd p))) fs)
       sure)
mapExp f (RField e i) = f (RField (mapExp f e) i)
mapExp f (RDupE e) = f (RDupE (mapExp f e))
mapExp f (RFieldV e i) = f (RFieldV (mapExp f e) i)
mapExp f (RGetN e i n) = f (RGetN (mapExp f e) i n)
mapExp f (RFieldU r s e i) = f (RFieldU r s (mapExp f e) i)
mapExp f (RGetNU r s e i n) = f (RGetNU r s (mapExp f e) i n)
mapExp f (RWord r e) = f (RWord r (mapExp f e))
mapExp f (RGetLabel e l) = f (RGetLabel (mapExp f e) l)
mapExp f (RPrim p es) = f (RPrim p (List.map (mapExp f) es))
mapExp f (RPrimAt p r es) = f (RPrimAt p r (List.map (mapExp f) es))
mapExp f (RLam xs fv held body) = f (RLam xs fv (List.map (mapExp f) held) body)
mapExp f (RCall g tr w args) =
  f (RCall g tr w (List.map (Owned.mapArg (mapExp f)) args))
mapExp f (RApply g es) = f (RApply (mapExp f g) (List.map (mapExp f) es))
mapExp f (RBool c) = f (RBool (Owned.mapCond (mapExp f) c))
mapExp f (RBox r e) = f (RBox r (mapExp f e))
mapExp f (RUnbox r e) = f (RUnbox r (mapExp f e))
mapExp f (RPeek r e) = f (RPeek r (mapExp f e))
mapExp f (RPrimU p es) = f (RPrimU p (List.map (mapExp f) es))
mapExp f e = f e

-- (a primitive's name, unchecked if it is known in range)
renamed : Info -> List Range -> Prim -> List RefCount.Value -> Prim
renamed info env p es =
  maybe p (\_ -> fromMaybe p (uncheckedOf p)) (needAt info env p Nothing es)

-- (a read of an array known flat, one of `flat`, not looking how it
-- keeps its elements)
flatName : Info -> List Read -> Repr.Repr -> List RefCount.Value -> Prim
flatName info flat r (Cons a _) =
  if maybe False (\b -> isRead flat (MkPair b r)) (baseOfVar info (varOf a))
  then ArrayIndexIn
  else ArrayIndexInAny
flatName info flat r es = ArrayIndexInAny

-- (a read or set made unchecked, where it is known in range, and a read
-- of an array known flat not looking)
unchecked : Info -> List Read -> List Range -> RefCount.Value -> RefCount.Value
unchecked info flat env (RPrim p es) = RPrim (renamed info env p es) es
unchecked info flat env (RPrimAt p r es) =
  if eqPrim p ArrayIndexInAny then RPrimAt (flatName info flat r es) r es
  else RPrimAt (renamed info env p es) r es
unchecked info flat env e = e

fixExp : Info -> List Read -> List Range -> RefCount.Value -> RefCount.Value
fixExp info flat env e = mapExp (unchecked info flat env) e

-- (what is known with no index: no read or set in range)
noIndices : Info -> Info
noIndices info = { indices = Nil, arrays = info.arrays, defs = info.defs }

-- | where the copy of the loop starts
label : String
label = "InRange"

fixArm : (List RefCount.Statement -> List RefCount.Statement)
       -> RefCount.CaseArm
       -> RefCount.CaseArm
fixArm go (MkCArm t fs fl su pl tk body lv) =
  MkCArm t fs fl su pl tk (go body) lv

-- (the loop again: round the copy, `toCopy`, or as it was)
again : Bool -> List String -> List RefCount.Value -> RefCount.Statement
again True ps es = CLoopTo label ps es
again False ps es = CLoop ps es

-- | a statement: its reads and sets known in range unchecked, its reads
-- | of arrays known flat (`flat`) not looking, going round the copy
-- | again where `toCopy`
fixSt : (List Range -> List RefCount.Statement -> List RefCount.Statement)
      -> Info
      -> List Read
      -> Bool
      -> List Range
      -> RefCount.Statement
      -> RefCount.Statement
fixSt go info flat toCopy env (CLet x e) = CLet x (fixExp info flat env e)
fixSt go info flat toCopy env (CSet x e) = CSet x (fixExp info flat env e)
fixSt go info flat toCopy env (CReturn e) = CReturn (fixExp info flat env e)
fixSt go info flat toCopy env (CIf c a b) =
  CIf
    (Owned.mapCond (fixExp info flat env) c)
    (go (fst (split info env c)) a)
    (go (snd (split info env c)) b)
fixSt go info flat toCopy env (CSwitch e arms r) =
  CSwitch (fixExp info flat env e) (List.map (fixArm (go env)) arms) r
fixSt go info flat toCopy env (CInPlace f es) =
  CInPlace (fixExp info flat env f) (List.map (fixExp info flat env) es)
fixSt go info flat toCopy env (CRoomed f es) =
  CRoomed (fixExp info flat env f) (List.map (fixExp info flat env) es)
fixSt go info flat toCopy env (CTail f es) =
  CTail (fixExp info flat env f) (List.map (fixExp info flat env) es)
fixSt go info flat toCopy env (CLoop ps es) =
  again toCopy ps (List.map (fixExp info flat env) es)
fixSt go info flat toCopy env (CJump g w es) =
  CJump g w (List.map (fixExp info flat env) es)
fixSt go info flat toCopy env s = s

fixStmts : Info
         -> List Read
         -> Bool
         -> List Range
         -> List RefCount.Statement
         -> List RefCount.Statement
fixStmts info flat toCopy env ss =
  List.map (fixSt (fixStmts info flat toCopy) info flat toCopy env) ss

-- The check
--------------------------------------------------------------------------------

lengthWord : String -> RefCount.Value
lengthWord a = RUnbox RepInt (RPrim ArrayLength (Cons (RDup a) Nil))

-- (the index at least 0)
atLeast0 : String -> RefCount.Test
atLeast0 i = CondRelU WordLe [RFixU I64 0, RLocal i]

-- (the array read at least as long as the one tested)
longEnough : Need -> List RefCount.Test
longEnough n =
  if strEq n.tested n.read then Nil
  else Cons (CondRelU WordLe [lengthWord n.tested, lengthWord n.read]) Nil

-- (the array read kept flat, of the number it is read as)
keepsFlat : Read -> RefCount.Test
keepsFlat (MkPair b r) = CondBool (RPrimAt ArrayKeeps r (Cons (RDup b) Nil))

needIndex : Need -> String
needIndex n = n.index

-- (each once)
nubS : List String -> List String -> List String
nubS acc Nil = List.reverse acc
nubS acc (Cons x xs) = if elemS x acc then nubS acc xs else nubS (Cons x acc) xs

pairKey : Need -> String
pairKey n = n.tested ^ " " ^ n.read

nubNeeds : List String -> List Need -> List Need
nubNeeds seen Nil = Nil
nubNeeds seen (Cons n ns) =
  if elemS (pairKey n) seen then nubNeeds seen ns
  else Cons n (nubNeeds (Cons (pairKey n) seen) ns)

allOf : List RefCount.Test -> RefCount.Test
allOf Nil = CondTrue
allOf (Cons c Nil) = c
allOf (Cons c cs) = CondIf c (allOf cs) CondFalse

-- | the check, where the function is entered, that every read and set
-- | known in range is: each index at least 0, each array read at least
-- | as long as the one tested -- and each array read as a fixed-width
-- | number, `rs`, kept flat
checkOf : List Need -> List Read -> RefCount.Test
checkOf ns rs =
  allOf
    (List.append
       (List.map atLeast0 (nubS Nil (List.map needIndex ns)))
       (List.append
          (List.concatMap longEnough (nubNeeds Nil ns))
          (List.map keepsFlat rs)))

-- The function
--------------------------------------------------------------------------------

-- (where the function is entered: a copy of its loop, where `ns` and
-- `checked`, if any, are -- its reads and sets in range unchecked, its
-- reads of `owned` and `checked` not looking)
entryWith : RefCount.Fun
          -> Info
          -> List Read
          -> List Need
          -> List Read
          -> List RefCount.Statement
entryWith f info owned Nil Nil = f.entry
entryWith f info owned ns checked =
  List.append
    f.entry
    (Cons
       (CIf
          (checkOf ns checked)
          (Cons
             (CLabel label)
             (fixStmts info (List.append owned checked) True Nil f.body))
          Nil)
       Nil)

-- (the function, its reads of `owned` not looking, and a copy of its
-- loop where `ns` and `checked` are)
checkedWith : RefCount.Fun
            -> Info
            -> List Read
            -> List Need
            -> List Read
            -> RefCount.Fun
checkedWith f info owned ns checked =
  { key = f.key
  , params = f.params
  , lent = f.lent
  , entry = entryWith f info owned ns checked
  , body = fixStmts (noIndices info) owned False Nil f.body
  , reprs = f.reprs
  , ret = f.ret
  , wrapper = f.wrapper
  }

boundsWith : RefCount.Fun
           -> List (Pair String RefCount.Value)
           -> List Again
           -> RefCount.Fun
boundsWith f ds ags =
  let info : Info =
    { indices = indices f ds ags, arrays = kept f ds ags, defs = ds }
  in let sc = scoped info Nil f.body
  in let ns = List.concatMap (\p -> needsIn info (fst p) (snd p)) sc
  in let owned = List.concatMap ownedSt f.entry
  in let rs =
    nubReads
      Nil
      (List.append
         (List.concatMap needRead ns)
         (List.concatMap (\p -> readsIn info (snd p)) sc))
  in checkedWith f info owned ns (List.keepIf (\r -> not (isRead owned r)) rs)

-- | a function going round a loop, its reads and sets in range checked
-- | once where it is entered, and its arrays read flat, where they may be
boundsFun : RefCount.Fun -> RefCount.Fun
boundsFun f =
  let ags = agains Nil f.body
  in if List.null ags || labelled False f.body then f
  else boundsWith f (Owned.defsOf Nil f.body) ags

-- | a definition of the C backend's, its loops' reads and sets in range,
-- | and arrays read flat, checked once where they may be
boundsDef : RefCount.Def -> RefCount.Def
boundsDef (DFun f) = DFun (boundsFun f)
boundsDef d = d
