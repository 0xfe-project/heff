-- Computations drawing fresh names, as the passes over the IR make
-- them: a counter, threaded through, so that each name a pass makes is
-- one no other has.  A pass imports this as it is, not under a name of
-- its own: `do` takes the `bind` and `pure` in scope by name.

module heff.compile.supply

-- | a computation drawing fresh names
type S a = Int -> Pair a Int

bindTake : {a b : Type} -> (a -> S b) -> Pair a Int -> Pair b Int
bindTake f (MkPair x n) = f x n

-- `do` is this
bind : {a b : Type} -> S a -> (a -> S b) -> S b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> S a
pure x = \n -> MkPair x n

instance instanceMonadS : Monad S
instanceMonadS = { pure = pure, bind = bind }

traverseS : {a b : Type} -> (a -> S b) -> List a -> S (List b)
traverseS = traverse (mo := instanceMonadS)

-- | a name no other has, of the base given (what it was called in the
-- | source): the base, `$`, the counter
-- | >>> freshS "x" 3
-- | MkPair "x$3" 4
freshS : String -> S String
freshS base = \n -> MkPair (base ^ "$" ^ debug n) (n + 1)
