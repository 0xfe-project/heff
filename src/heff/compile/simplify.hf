-- Computing at compile time what is known then: β-reduction, the definitions that are not
-- recursive inlined (when that makes the code no bigger than a little),
-- a field of a known record, the arm of a match on a known tag.
--
-- Hippogriff's programs are pure, but for `abandon` and divergence, and
-- they are call-by-value: what is computed is computed, in order, even
-- if no one uses it.  So only what cannot fail (`pure`: a value, of
-- globals that cannot) is dropped where no one uses it, or moved to
-- where it is used; what could fail stays where it was.

module heff.compile.simplify

import heff.compile.ir as IR
import heff.compile.irtext as IRText
import heff.compile.prims as Prims
import heff.compile.spec as Spec
import std.map as Map

-- | how much bigger than what it replaces an inlined definition may
-- | make the code
budget : Int
budget = 24

-- | what a known definition, given all its arguments and none it can
-- | compute with, came to: those arguments as its parameters, or not
-- | inlined
data Plain = Inlined (List String) IR.Expr | NotInlined

-- | specialisation: every definition so far small enough to be copied
-- | (those calling themselves too), those that are functions or records
-- | (whatever their size); the copies asked for, each as it is known
-- | (by its name), how deep in copies of copies each is, those made,
-- | and how many were asked for; and whether no copy is asked for now
type Specs =
  { all : Map.Map String IR.Expr
  , kinds : Map.Map String Unit
  , recipes : Map.Map String IR.Expr
  , depths : Map.Map String Int
  , made : Map.Map String Unit
  , count : Int
  , off : Bool
  }

-- | a copy made, as the backend's cache keeps it (heff.build.backcache):
-- | what it was made to (read when it is wanted), and the copies asked
-- | for as it was made, each by its name and version
type KeptMade =
  { body : Unit -> Maybe IR.Expr, touched : List (Pair String String) }

-- | a copy asked for, as the cache keeps it: its version (`copyVer`),
-- | what it is known by (`knowing`, read when it is wanted), how deep in
-- | copies of copies it is, whether it is safe (`markCopySafe`) -- and
-- | what it was made to, if it was
type KeptCopy =
  { ver : String
  , recipe : Unit -> Maybe IR.Expr
  , depth : Int
  , safe : Bool
  , made : Maybe KeptMade
  }

-- | what the simplifier knows of the cache, and tells it: each global's
-- | version, where it has one (what it is made of, hashed: a
-- | definition's is given, a copy's found as it is asked for); the
-- | copies kept; the copies asked for by what is being simplified, the
-- | last first; and the copies asked for, and those made, here and not
-- | as the cache keeps them (those made with the copies they asked for)
type Keep =
  { vers : Map.Map String String
  , kept : Map.Map String KeptCopy
  , touched : List String
  , fresh : Map.Map String Unit
  , madeFresh : Map.Map String (List String)
  }

-- | knowing nothing of a cache
noKeep : Keep
noKeep =
  { vers = Map.empty
  , kept = Map.empty
  , touched = Nil
  , fresh = Map.empty
  , madeFresh = Map.empty
  }

-- (`safe`: the globals that cannot fail when used -- `safeGlobals`'s,
-- then each definition and copy found so once simplified; `base`: the
-- same but for the definitions simplified -- see `markCopySafe`)
type St =
  { supply : Int
  , fuel : Int
  , defs : Map.Map String IR.Expr
  , safe : Map.Map String Unit
  , base : Map.Map String Unit
  , total : Map.Map String Int
  , plain : Map.Map String Plain
  , sp : Specs
  , kp : Keep
  }

withSp : Specs -> St -> St
withSp p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = p
  , kp = s.kp
  }

withSupply : Int -> St -> St
withSupply n s =
  { supply = n
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withFuel : Int -> St -> St
withFuel f s =
  { supply = s.supply
  , fuel = f
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withSafe : String -> St -> St
withSafe k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = Map.insert s.safe k MkUnit
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withBase : String -> St -> St
withBase k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = Map.insert s.base k MkUnit
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withPlain : String -> Plain -> St -> St
withPlain k p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = Map.insert s.plain k p
  , sp = s.sp
  , kp = s.kp
  }

withDefs : Map.Map String IR.Expr -> St -> St
withDefs d s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = d
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withKp : Keep -> St -> St
withKp k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = k
  }

type M a = St -> Pair a St

bindTake : {a b : Type} -> (a -> M b) -> Pair a St -> Pair b St
bindTake f (MkPair x s) = f x s

bind : {a b : Type} -> M a -> (a -> M b) -> M b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> M a
pure x = \s -> MkPair x s

get : M St
get = \s -> MkPair s s

put : St -> M Unit
put s' = \s -> MkPair MkUnit s'

instance instanceMonadM : Monad M
instanceMonadM = { pure = pure, bind = bind }

traverseS : {a b : Type} -> (a -> M b) -> List a -> M (List b)
traverseS = traverse (mo := instanceMonadM)

fieldsS : (IR.Expr -> M IR.Expr)
        -> List (Pair String IR.Expr)
        -> M (List (Pair String IR.Expr))
fieldsS f fs =
  traverseS
    (\p -> case p of
     MkPair l e -> do
       e' <- f e
       pure (MkPair l e'))
    fs

-- (each expression of a condition, by `f`)
condS : (IR.Expr -> M IR.Expr) -> IR.Cond -> M IR.Cond
condS f c = IR.condTraverse (mo := instanceMonadM) f c

armsS : (IR.Expr -> M IR.Expr) -> List IR.Arm -> M (List IR.Arm)
armsS f arms =
  traverseS
    (\a -> case a of
     MkArm t vs b -> do
       b' <- f b
       pure (MkArm t vs b'))
    arms

appendL : {a : Type} -> List a -> List a -> List a
appendL Nil ys = ys
appendL (Cons x xs) ys = Cons x (appendL xs ys)

elemStr : String -> List String -> Bool
elemStr x Nil = False
elemStr x (Cons y ys) = strEq x y || elemStr x ys

zipL : {a b : Type} -> List a -> List b -> List (Pair a b)
zipL (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipL xs ys)
zipL _ _ = Nil

takeL : {a : Type} -> Int -> List a -> List a
takeL n Nil = Nil
takeL n (Cons x xs) = if n <= 0 then Nil else Cons x (takeL (n - 1) xs)

dropL : {a : Type} -> Int -> List a -> List a
dropL n Nil = Nil
dropL n (Cons x xs) = if n <= 0 then Cons x xs else dropL (n - 1) xs

minI : Int -> Int -> Int
minI a b = if a <= b then a else b

-- | the bindings, each around the next, around the body
letsOf : List (Pair String IR.Expr) -> IR.Expr -> IR.Expr
letsOf Nil body = body
letsOf (Cons (MkPair x a) rest) body = ELet x a (letsOf rest body)

-- (an attempt undone: the names drawn and the fuel burnt kept, and
-- what was learnt of the copies asked for in it)
restore : St -> St -> St
restore saved st =
  { supply = st.supply
  , fuel = st.fuel
  , defs = saved.defs
  , safe = st.safe
  , base = st.base
  , total = saved.total
  , plain = st.plain
  , sp = st.sp
  , kp = st.kp
  }

copyTake : St -> Pair IR.Expr Int -> Pair IR.Expr St
copyTake s (MkPair e' n) = MkPair e' (withSupply n s)

copy : IR.Expr -> M IR.Expr
copy e = \s -> copyTake s (IR.freshen s.supply e)

-- (a body to inline: a copy of it, if the fuel lasts)
fueled : Maybe IR.Expr -> M (Maybe IR.Expr)
fueled (Just b) = do
  s <- get
  if s.fuel > 0
  then do
    u <- put (withFuel (s.fuel - 1) s)
    e <- copy b
    pure (Just e)
  else pure Nothing
fueled Nothing = pure Nothing

-- | a definition's body, to inline (a copy), if it may be
known : String -> M (Maybe IR.Expr)
known g = do
  s <- get
  fueled (Map.lookup s.defs g)

-- | try an inlining: keep it if it is small enough (a copy asked for
-- | in it is only named: it is made after the definition, if what it
-- | comes to calls it)
attemptBy : Int -> IR.Expr -> M IR.Expr -> M IR.Expr
attemptBy more orig m = do
  saved <- get
  e <- m
  if not (IR.sizeAbove (IR.size orig + more) e) then pure e
  else do
    -- (the names drawn stay drawn: no name is ever given out twice.
    -- And the fuel burnt stays burnt: a speculation that did not pay
    -- is not free to try again inside every caller -- refunding it
    -- made the simplifier exponential on a file of record-tied
    -- definitions)
    st <- get
    u <- put (restore saved st)
    pure orig

attempt : IR.Expr -> M IR.Expr -> M IR.Expr
attempt orig m = attemptBy budget orig m

type SG = { safe : Map.Map String Unit, total : Map.Map String Int }

-- | what cannot fail: evaluating it gives a value, at once.  A
-- | projection is of a record, always there; an application of a
-- | `total` function up to its arity builds a closure or its pure body
-- | the primitives that may fail (abandon, or a shift beyond memory), or
-- | call what may: no fixed-width type's operation is among them (a
-- | division by zero is 0, the floor of what is not finite 0).  And
-- | bench's `keep`, taken as one that may: so that no pass drops it, its
-- | result unused, nor moves it, nor what is made of it, out of where
-- | it is -- what a benchmark's work is kept by
failing : List String
failing = ["intShl", "intShr", "arrayIndex", "arrayGenerate", "perform", "keep"]

-- | whether a primitive may fail
primFails : String -> Bool
primFails p = elemStr p failing

pureIn : Map.Map String Unit -> Map.Map String Int -> IR.Expr -> Bool
pureIn safe total (EVar _) = True
pureIn safe total (EGlobal g) = Map.member safe g
pureIn safe total (ELam _ _) = True
pureIn safe total (ERecord fs _) =
  IR.allI
    (List.map
       (\p -> case p of
        MkPair _ e2 -> pureIn safe total e2)
       fs)
pureIn safe total (ETag _ argv _) =
  IR.allI (List.map (\a -> pureIn safe total a) argv)
pureIn safe total (EProj e2 _ _ _) = pureIn safe total e2
pureIn safe total (EApp (EGlobal g) argv) = case Map.lookup
    total
    g of
  Just ar ->
    List.length argv <= ar
    && IR.allI (List.map (\a -> pureIn safe total a) argv)
  Nothing -> False
pureIn safe total (ECall g argv) = case Map.lookup total g of
  Just ar ->
    List.length argv <= ar
    && IR.allI (List.map (\a -> pureIn safe total a) argv)
  Nothing -> False
pureIn safe total (EPrimCall p argv) =
  not (primFails p) && IR.allI (List.map (\a -> pureIn safe total a) argv)
-- (a match has an arm of every tag its scrutinee may have: the
-- elaborator asks for one)
pureIn safe total (EMatch sc arms) =
  pureIn safe total sc
  && not (List.null arms)
  && IR.allI (List.map (\b -> pureIn safe total (IR.armBody b)) arms)
pureIn safe total (EBool c) =
  IR.allI (List.map (\a -> pureIn safe total a) (IR.condParts c))
pureIn safe total (ESet _ a b) = pureIn safe total a && pureIn safe total b
pureIn safe total (EValues es) =
  IR.allI (List.map (\a -> pureIn safe total a) es)
pureIn safe total (EPrim _) = True
pureIn safe total (EInt _) = True
pureIn safe total (EFloat _) = True
pureIn safe total (EStr _) = True
pureIn safe total (EBytes _) = True
pureIn safe total (EFixed _ _) = True
pureIn safe total (EFloat32 _) = True
pureIn safe total e = False

flatCons : List String
         -> Pair (List String) IR.Expr
         -> Pair (List String) IR.Expr
flatCons xs (MkPair ys b) = MkPair (appendL xs ys) b

-- (lambdas in lambdas, one parameter list)
flat : IR.Expr -> Pair (List String) IR.Expr
flat (ELam xs b) = flatCons xs (flat b)
flat b = MkPair Nil b

sgFlat : SG -> String -> Pair (List String) IR.Expr -> SG
sgFlat acc key (MkPair xs b) =
  if List.length xs > 0
  then if pureIn acc.safe acc.total b && not (elemStr key (IR.globalsIn b))
    then { safe = Map.insert acc.safe key MkUnit
         , total = Map.insert acc.total key (List.length xs)
         }
    else { safe = Map.insert acc.safe key MkUnit
         , total = acc.total
         }
  else if pureIn acc.safe acc.total b && not (elemStr key (IR.globalsIn b))
  then { safe = Map.insert acc.safe key MkUnit
       , total = acc.total
       }
  else acc

-- | the globals that cannot fail when used: functions, and values of
-- | such globals (each definition after those it uses; one using itself
-- | is not).  `total`: the functions whose application cannot fail
-- | either -- their body is pure under the lambdas (erased statics,
-- | record builders such as co.hf's `<+>`) -- with their arity
safeGlobals : List IR.Def -> SG
safeGlobals defs =
  List.foldl
    (\acc (d : IR.Def) -> sgFlat acc d.key (flat d.body))
    { safe = Map.empty, total = Map.empty }
    defs

-- | a known function given fewer arguments than it takes (each pure):
-- | it only builds a closure
partialOf : St -> List IR.Expr -> Maybe IR.Expr -> Bool
partialOf s argv (Just (ELam xs _)) =
  List.length argv < List.length xs
  && IR.allI (List.map (pureIn s.safe s.total) argv)
partialOf s argv _ = False

partialHead : St -> List IR.Expr -> IR.Expr -> Bool
partialHead s argv (EGlobal g) = partialOf s argv (Map.lookup s.sp.all g)
partialHead s argv _ = False

partialIn : St -> IR.Expr -> Bool
partialIn s (EApp f argv) = partialHead s argv f
partialIn s _ = False

-- (... or a match, a binding or a tag of such: `if c then tell x else
-- pure MkUnit`, an operation's copy given the operation; `Catch c h` of
-- it)
pureOrPartial : St -> IR.Expr -> Bool
pureOrPartial s (EMatch sc arms) =
  pureIn s.safe s.total sc
  && not (List.null arms)
  && IR.allI (List.map (\b -> pureOrPartial s (IR.armBody b)) arms)
pureOrPartial s (ELet _ a b) = pureOrPartial s a && pureOrPartial s b
pureOrPartial s (ETag _ argv _) = IR.allI (List.map (pureOrPartial s) argv)
pureOrPartial s e = pureIn s.safe s.total e || partialIn s e

isPure : IR.Expr -> M Bool
isPure e = \s -> MkPair (pureOrPartial s e) s

atomic : IR.Expr -> Bool
atomic (EVar _) = True
atomic (EGlobal _) = True
atomic (EInt _) = True
atomic (EFloat _) = True
atomic (EStr _) = True
atomic (EBytes _) = True
atomic (EFixed _ _) = True
atomic (EFloat32 _) = True
atomic (EPrim _) = True
atomic e = False

-- Constant folding
--------------------------------------------------------------------------------

boolE : Bool -> IR.Expr
boolE b = ETag (if b then "True" else "False") Nil Nil

-- | a primitive of two integers, computed (those that cannot fail)
intOp : String -> Int -> Int -> Maybe IR.Expr
intOp p a b =
  if strEq p "intAdd" then Just (EInt (a + b))
  else if strEq p "intSub" then Just (EInt (a - b))
  else if strEq p "intMul" then Just (EInt (a * b))
  else if strEq p "intEq" then Just (boolE (a == b))
  else if strEq p "intLt" then Just (boolE (a < b))
  else if strEq p "intLe" then Just (boolE (a <= b))
  else Nothing

-- | ... of two strings
strOp : String -> String -> String -> Maybe IR.Expr
strOp p a b =
  if strEq p "strAppend" then Just (EStr (a ^ b))
  else if strEq p "strEq" then Just (boolE (strEq a b))
  else Nothing

-- | ... of one (a string's length its bytes, as every backend's is)
-- | >>> unOp "strLength" (EStr "\u{e9}\u{1F600}")
-- | Just (EInt 6)
unOp : String -> IR.Expr -> Maybe IR.Expr
unOp p (EInt a) = if strEq p "intShow" then Just (EStr (show a)) else Nothing
unOp p (EStr a) =
  if strEq p "strLength" then Just (EInt (strLength a)) else Nothing
unOp p _ = Nothing

binOp : String -> IR.Expr -> IR.Expr -> Maybe IR.Expr
binOp p (EInt a) (EInt b) = intOp p a b
binOp p (EStr a) (EStr b) = strOp p a b
binOp p _ _ = Nothing

foldArgs : String -> List IR.Expr -> Maybe IR.Expr
foldArgs p (Cons a Nil) = unOp p a
foldArgs p (Cons a (Cons b Nil)) = binOp p a b
foldArgs p _ = Nothing

-- | a primitive's call: its value, if its arguments are literals; a
-- | comparison, a condition
foldPrim : String -> List IR.Expr -> IR.Expr
foldPrim p argv = case foldArgs p argv of
  Just v -> v
  Nothing -> case argv of
    Cons a (Cons b Nil) ->
      if IR.isRel p then EBool (CRel p a b) else EPrimCall p argv
    _ -> EPrimCall p argv

-- | a condition made again of its parts, simplified: a comparison of
-- | literals computed, each `Bool` looked at that is a condition taken
-- | in, each `if` of them made as `IR.condIf` makes it
foldCond : IR.Cond -> IR.Cond
foldCond (CRel p a b) = IR.condOf (foldPrim p [a, b])
foldCond (CTest e) = IR.condOf e
foldCond (CNot c) = IR.notOf (foldCond c)
foldCond (CIf a b c) = IR.condIf (foldCond a) (foldCond b) (foldCond c)
foldCond c = c

-- | a primitive given its arguments: a call of it, once they are all
-- | there (what the other judgments know a primitive's computation by;
-- | `heff.compile.arity` does the same for the definitions, whose parameters are
-- | not known until the simplifier is done)
primAppN : String -> List IR.Expr -> Maybe Int -> IR.Expr
primAppN p argv (Just n) =
  if List.length argv == n then foldPrim p argv
  else if List.length argv > n
  then EApp (foldPrim p (takeL n argv)) (dropL n argv)
  else EApp (EPrim p) argv
primAppN p argv Nothing = EApp (EPrim p) argv

primApp : String -> List IR.Expr -> IR.Expr
primApp p argv = primAppN p argv (Prims.primArity p)

-- | an application, in the form the simplifier keeps every one in:
-- | its head not an application (`(f a) b` is `f a b`), and a primitive
-- | given all its arguments a call of it.  Every application the
-- | simplifier makes is made by this, so no judgment need look for
-- | another form (a primitive applied, not called: `cheap` would not
-- | know it)
-- | >>> mkApp (EApp (EPrim "intAdd") [EVar "n"]) [EInt 0]
-- | EPrimCall "intAdd" [EVar "n", EInt 0]
mkApp : IR.Expr -> List IR.Expr -> IR.Expr
mkApp f Nil = f
mkApp (EApp g bs) argv = mkApp g (appendL bs argv)
mkApp (EPrim p) argv = primApp p argv
mkApp f argv = EApp f argv

-- | `x` replaced by `a`, a copy of it for each occurrence
substCopies : String -> IR.Expr -> IR.Expr -> M IR.Expr
substCopies x a (EVar y) = if strEq y x then copy a else pure (EVar y)
substCopies x a (ELam xs b) = do
  b' <- substCopies x a b
  pure (ELam xs b')
substCopies x a (EApp f argv) = do
  f' <- substCopies x a f
  argv' <- traverseS (\q -> substCopies x a q) argv
  pure (mkApp f' argv')
substCopies x a (ELet y e2 b) = do
  e2' <- substCopies x a e2
  b' <- substCopies x a b
  pure (ELet y e2' b')
substCopies x a (ERecord fs ts) = do
  fs' <- fieldsS (\q -> substCopies x a q) fs
  pure (ERecord fs' ts)
substCopies x a (EProj e2 l sh t) = do
  e2' <- substCopies x a e2
  pure (EProj e2' l sh t)
substCopies x a (ETag t argv ts) = do
  argv' <- traverseS (\q -> substCopies x a q) argv
  pure (ETag t argv' ts)
substCopies x a (EMatch s arms) = do
  s' <- substCopies x a s
  arms' <- armsS (\q -> substCopies x a q) arms
  pure (EMatch s' arms')
substCopies x a (EPrimCall p argv) = do
  argv' <- traverseS (\q -> substCopies x a q) argv
  pure (EPrimCall p argv')
substCopies x a (ECall g argv) = do
  argv' <- traverseS (\q -> substCopies x a q) argv
  pure (ECall g argv')
substCopies x a (EBool c) = do
  c' <- condS (\q -> substCopies x a q) c
  pure (EBool c')
substCopies x a (ESet ys e2 b) = do
  e2' <- substCopies x a e2
  b' <- substCopies x a b
  pure (ESet ys e2' b')
substCopies x a (EValues es) = do
  es' <- traverseS (\q -> substCopies x a q) es
  pure (EValues es')
substCopies x a e = pure e

-- | (lambdas in lambdas are one lambda)
lam : List String -> IR.Expr -> IR.Expr
lam xs (ELam ys b) = ELam (appendL xs ys) b
lam xs e = ELam xs e

-- | the judgments, knotted
type SK =
  { simp : IR.Expr -> M IR.Expr
  , applyTo : IR.Expr -> List IR.Expr -> M IR.Expr
  , project : String -> List String -> IR.FieldTy -> IR.Expr -> M IR.Expr
  , match : IR.Expr -> List IR.Arm -> M IR.Expr
  }

occCountOf : String -> IR.Expr -> Int
occCountOf x b = (IR.occurrences x b).count

singletonM : String -> IR.Expr -> Map.Map String IR.Expr
singletonM x a = Map.insert Map.empty x a

-- A match's value bound and taken apart at once, every way out of the
-- match building the tag taken apart: `let p = (if c then MkPair a1 b1
-- else MkPair a2 b2) in case p of MkPair x y -> ...` -- what `run do`'s
-- `if` and `case` of statements give their variables back as
-- (heff.syntax.presyntax), and any code of that shape.  Where what
-- follows is too big to be given to each way out (`sumTakenApart`), the
-- names are set by each way out instead, `ESet [x, y]`, its ways the
-- values they give (`EValues`): no tag built, no join point.  A last
-- field taken apart at once again is the same, more names set (`MkPair
-- a (MkPair b c)`, three variables).  Decided by the shape alone: no tag
-- is special, but a `Lazy`'s box and a worker's tuple, never taken apart
-- so.

-- | what a match takes apart: each tag, level by level (each one's last
-- | field the next one's), and how many fields it has; the names bound,
-- | but those taken apart again; and what follows
type Apart =
  { tags : List (Pair String Int), names : List String, body : IR.Expr }

initL : {a : Type} -> List a -> List a
initL Nil = Nil
initL (Cons x Nil) = Nil
initL (Cons x xs) = Cons x (initL xs)

apartMore : String -> List String -> IR.Expr -> Maybe Apart -> Apart
apartMore t vs b (Just ap) =
  { tags = Cons (MkPair t (List.length vs)) ap.tags
  , names = appendL (initL vs) ap.names
  , body = ap.body
  }
apartMore t vs b Nothing =
  { tags = [MkPair t (List.length vs)], names = vs, body = b }

-- (a tag a value of which may be taken for its fields)
apartTag : String -> Bool
apartTag t = not (strEq t "MkLazy") && not (IR.isTupleTag t)

-- (how `b` takes `x` apart at once, if it does, `x` named nowhere else)
apartOf : String -> IR.Expr -> Maybe Apart
apartOf x (EMatch (EVar z) (Cons (MkArm t vs b) Nil)) =
  if strEq x z
     && not (strEq x "_")
     && not (List.null vs)
     && apartTag t
     && occCountOf x b == 0
  then Just
      (apartMore t vs b (maybe Nothing (\w -> apartOf w b) (List.last vs)))
  else Nothing
apartOf x e = Nothing

allJust : {a : Type} -> List (Maybe a) -> Maybe (List a)
allJust Nil = Just Nil
allJust (Cons (Just x) rest) =
  maybe Nothing (\xs -> Just (Cons x xs)) (allJust rest)
allJust (Cons Nothing rest) = Nothing

appendValues : List IR.Expr -> Maybe (List IR.Expr) -> Maybe (List IR.Expr)
appendValues vs (Just ws) = Just (appendL vs ws)
appendValues vs Nothing = Nothing

-- (the values a way out gives: of the tags, level by level, as many
-- fields each)
valuesOf : List (Pair String Int) -> IR.Expr -> Maybe (List IR.Expr)
valuesOf (Cons (MkPair t n) Nil) (ETag u args _) =
  if strEq t u && List.length args == n then Just args else Nothing
valuesOf (Cons (MkPair t n) rest) (ETag u args _) =
  if strEq t u && List.length args == n
  then appendValues
      (initL args)
      (valuesOf rest (fromMaybe EAbandon (List.last args)))
  else Nothing
valuesOf tags e = Nothing

-- (each way out the values it gives, if each builds the tags; one
-- abandoned gives none)
toValues : List (Pair String Int) -> IR.Expr -> Maybe IR.Expr
toValues ts (ELet y v b) =
  maybe Nothing (\b2 -> Just (ELet y v b2)) (toValues ts b)
toValues ts (ESet ys v b) =
  maybe Nothing (\b2 -> Just (ESet ys v b2)) (toValues ts b)
toValues ts (EMatch s arms) =
  maybe
    Nothing
    (\bs ->
       Just
         (EMatch
            s
            (List.zipWith
               (\a b2 -> MkArm (IR.armTag a) (IR.armVars a) b2)
               arms
               bs)))
    (allJust (List.map (\a -> toValues ts (IR.armBody a)) arms))
toValues ts EAbandon = Just EAbandon
toValues ts e = maybe Nothing (\vs -> Just (EValues vs)) (valuesOf ts e)

-- (the names set: a field bound to none, `_`, a name of its own, of
-- `x`'s, which is the program's alone)
setNames : String -> List String -> List String
setNames x ys =
  List.zipWith
    (\y i -> if strEq y "_" then x ^ "$_" ^ show i else y)
    ys
    (List.range 0 (List.length ys - 1))

-- | `let x = a in b`, `b` taking `x` apart at once, each way out of `a`
-- | building what it takes apart: the names set by each way, then what
-- | follows
givenSet : String -> IR.Expr -> IR.Expr -> Maybe IR.Expr
givenSet x a b = case apartOf x b of
  Just ap ->
    maybe
      Nothing
      (\a2 -> Just (ESet (setNames x ap.names) a2 ap.body))
      (toValues ap.tags a)
  Nothing -> Nothing

-- (a binding, `b` simplified: the names set, where it is one of those)
bindOrSet : String -> IR.Expr -> IR.Expr -> IR.Expr
bindOrSet x a b = fromMaybe (ELet x a b) (givenSet x a b)

isJustS : {a : Type} -> Maybe a -> Bool
isJustS (Just _) = True
isJustS Nothing = False

-- (the names set by `a`'s ways out, then what follows, simplified)
setGiven : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
setGiven r x a b = case givenSet x a b of
  Just (ESet ys a2 body) -> do
    body2 <- r.simp body
    pure (ESet ys a2 body2)
  _ -> do
    b2 <- r.simp b
    pure (ELet x a b2)

-- | the most a known argument -- a closed lambda or record, one a copy
-- | may be made for -- may be
specArgSize : Int
specArgSize = 60

-- | a closed lambda or record, no bigger than a copy may be made for.
-- | A record whose fields compute is not one: the copy would compute
-- | them where they are used, and a copy made for `{ x = q.x % 1000 }`
-- | of a copy made for `q` asks for one made for `x` computed again,
-- | without end
closedKnown : IR.Expr -> Bool
closedKnown (ELam xs b) =
  not (IR.sizeAbove specArgSize (ELam xs b)) && Spec.closedIn Nil (ELam xs b)
closedKnown (ERecord fs ts) =
  IR.isValue (ERecord fs ts)
  && not (IR.sizeAbove specArgSize (ERecord fs ts))
  && Spec.closedIn Nil (ERecord fs ts)
closedKnown _ = False

-- (every field a lambda)
lamField : Pair String IR.Expr -> Bool
lamField (MkPair _ (ELam _ _)) = True
lamField _ = False

-- | a record of functions -- a handler, an effect's signature -- no
-- | bigger than a copy may be made for, whatever it captures: the copy
-- | is given what it captures (`Spec.shapeOf`).  (A handler made for a
-- | literal, `ask`'s answer, is one, the literal a variable in it)
handlerLike : IR.Expr -> Bool
handlerLike (ERecord fs ts) =
  not (List.null fs)
  && IR.allI (List.map lamField fs)
  && not (IR.sizeAbove specArgSize (ERecord fs ts))
handlerLike _ = False

-- (a function whose body is a record of functions, taking `n`
-- parameters -- not one that builds itself again in them, a knot of
-- judgments, `substOf idxs`)
builds : String -> Int -> Maybe IR.Expr -> Bool
builds g n (Just (ELam xs (ERecord fs ts))) =
  List.length xs == n
  && not (List.null fs)
  && IR.allI (List.map lamField fs)
  && not (elemStr g (IR.globalsIn (ERecord fs ts)))
builds g n _ = False

-- | a handler built by a global, `feeding m`: a function whose body is a
-- | record of functions, given all its parameters, each a variable or a
-- | literal.  Whatever its size, it is known as a global handler is: a
-- | copy may be made for it, given the variables and literals
-- | (`Spec.shapeOf`), a field of it taken is that field (`projectF`).
-- | Building it computes nothing and cannot fail
builtBy : Map.Map String IR.Expr -> IR.Expr -> Bool
builtBy all (EApp (EGlobal g) argv) =
  IR.allI (List.map atomic argv)
  && builds g (List.length argv) (Map.lookup all g)
builtBy all _ = False

-- (the field, if it is a closed function)
closedField : IR.Expr -> Maybe IR.Expr -> IR.Expr
closedField e (Just v) = if closedKnown v then v else e
closedField e Nothing = e

isVar : String -> IR.Expr -> Bool
isVar x (EVar y) = strEq x y
isVar x _ = False

-- (an argument that is a handler, or an effect's signature: a global
-- record, or a record of functions)
handlerArg : Map.Map String Unit -> IR.Expr -> Bool
handlerArg kinds (EGlobal g) = Map.member kinds g
handlerArg kinds e = handlerLike e

-- (how many calls of `x` in the worklist are given a handler)
handedW : String -> Map.Map String Unit -> Int -> List IR.Expr -> Int
handedW x kinds n Nil = n
handedW x kinds n (Cons (EApp f argv) rest) =
  handedW
    x
    kinds
    (if isVar x f && List.any (handlerArg kinds) argv then n + 1 else n)
    (Cons f (IR.appendI argv rest))
handedW x kinds n (Cons (EMatch sc arms) rest) =
  handedW x kinds n (Cons sc (IR.pushArms arms rest))
handedW x kinds n (Cons (EProj e _ _ _) rest) = handedW x kinds n (Cons e rest)
handedW x kinds n (Cons (ELam _ b) rest) = handedW x kinds n (Cons b rest)
handedW x kinds n (Cons (ELet _ a b) rest) =
  handedW x kinds n (Cons a (Cons b rest))
handedW x kinds n (Cons (ERecord fs _) rest) =
  handedW x kinds n (IR.pushFields fs rest)
handedW x kinds n (Cons (ETag _ argv _) rest) =
  handedW x kinds n (IR.appendI argv rest)
handedW x kinds n (Cons (EPrimCall _ argv) rest) =
  handedW x kinds n (IR.appendI argv rest)
handedW x kinds n (Cons (ECall _ argv) rest) =
  handedW x kinds n (IR.appendI argv rest)
handedW x kinds n (Cons (EBool c) rest) = handedW x kinds n (IR.condOnto c rest)
handedW x kinds n (Cons (ESet _ a b) rest) =
  handedW x kinds n (Cons a (Cons b rest))
handedW x kinds n (Cons (EValues es) rest) =
  handedW x kinds n (IR.appendI es rest)
handedW x kinds n (Cons _ rest) = handedW x kinds n rest

-- | how big a function bound may be that is put where it is called, a
-- | copy each time, each call given a handler
handedSize : Int
handedSize = 160

-- | a function bound and called twice, each time given a handler: what
-- | comes after a choice of operations, `if c then tell x else pure
-- | MkUnit` -- each way given it, and so the handler, which a variable
-- | would hide from it
handedOn : Map.Map String Unit -> String -> IR.Expr -> IR.Expr -> Int -> Bool
handedOn kinds x (ELam ys body) b o =
  o <= 2
  && not (IR.sizeAbove handedSize (ELam ys body))
  && handedW x kinds 0 (Cons b Nil) == o
handedOn kinds x a b o = False

-- | how many uses of a closed value bound may each be given a copy of it
closedUses : Int
closedUses = 4

-- | ... of a record of functions (a handler, `hd.bind (hd.malg p)` and
-- | `hd.ret` in an operation's arguments)
handlerUses : Int
handlerUses = 8

-- (a value bound and used more than once is put where it is used, a
-- copy each time, if it is small -- or, used a few times, if it is
-- closed and a copy may be made for it: a handler, `{ ret = ..., bind =
-- ..., malg = ... }`, bound once and handed to two calls -- Co's `bind`
-- hands its `hd` on twice -- is known to both, which a variable would
-- hide from them.  So is a record of functions, whatever it captures,
-- and a function called twice, each time given a handler)
letPure : SK -> String -> IR.Expr -> IR.Expr -> Int -> M IR.Expr
letPure r x a b o = do
  s <- get
  if o == 0 then r.simp b
  else if atomic a || o == 1 then r.simp (IR.subst (singletonM x a) b)
  else if IR.isValue a
          && (not (IR.sizeAbove 12 a)
              || (o <= closedUses && closedKnown a)
              || (o <= handlerUses && handlerLike a)
              || handedOn s.sp.kinds x a b o)
  then do
    b' <- substCopies x a b
    r.simp b'
  else do
    b' <- r.simp b
    pure (bindOrSet x a b')

-- (a name of its own)
freshName : String -> M String
freshName base = \s -> case IR.fresh base s.supply of
  MkPair x n -> MkPair x (withSupply n s)

-- | arguments, those that compute bound to names of their own, in order
type Split = { binds : List (Pair String IR.Expr), args : List IR.Expr }

splitCons : Maybe (Pair String IR.Expr) -> IR.Expr -> Split -> Split
splitCons (Just bd) a rest =
  { binds = Cons bd rest.binds, args = Cons a rest.args }
splitCons Nothing a rest = { binds = rest.binds, args = Cons a rest.args }

splitOne : Bool -> IR.Expr -> M (Pair (Maybe (Pair String IR.Expr)) IR.Expr)
splitOne True a = pure (MkPair Nothing a)
splitOne False a = do
  t <- freshName "t"
  pure (MkPair (Just (MkPair t a)) (EVar t))

splitArgs : List IR.Expr -> M Split
splitArgs Nil = pure { binds = Nil, args = Nil }
splitArgs (Cons a argv) = do
  p <- isPure a
  one <- splitOne p a
  rest <- splitArgs argv
  pure (splitCons (fst one) (snd one) rest)

type Bound = Pair (List (Pair String IR.Expr)) (List IR.Expr)

consBound : Pair (Maybe (Pair String IR.Expr)) IR.Expr -> Bound -> Bound
consBound (MkPair (Just bd) a) (MkPair bds argv) =
  MkPair (Cons bd bds) (Cons a argv)
consBound (MkPair Nothing a) (MkPair bds argv) = MkPair bds (Cons a argv)

-- (the arguments that are not atomic bound to names of their own, in
-- order)
bindArgs : List IR.Expr -> M Bound
bindArgs Nil = pure (MkPair Nil Nil)
bindArgs (Cons a argv) = do
  one <- splitOne (atomic a) a
  rest <- bindArgs argv
  pure (consBound one rest)

-- (fewer arguments than the function takes)
fewerThan : List IR.Expr -> Maybe IR.Expr -> Bool
fewerThan argv (Just (ELam xs _)) = List.length argv < List.length xs
fewerThan argv _ = False

-- (a known function given fewer arguments than it takes)
partialApp : St -> IR.Expr -> Bool
partialApp s (EApp (EGlobal g) argv) = fewerThan argv (Map.lookup s.sp.all g)
partialApp s _ = False

-- (a partial application, its arguments that compute bound before it)
letSplit : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
letSplit r x (EApp f argv) b = do
  sp <- splitArgs argv
  e <- letPure r x (EApp f sp.args) b (occCountOf x b)
  pure (letsOf sp.binds e)
letSplit r x a b = do
  b' <- r.simp b
  pure (ELet x a b')

-- Sums built to be taken apart: `let e = (if c then Left y else Right f)
-- in ... case e of ...` -- a tag chosen by a match, then only matched on
-- -- is what follows given each tag where it is built, `if c then (...
-- case Left y of ...) else (... case Right f of ...)`: each match then
-- chooses at once, and no tag is built.  What follows is copied into
-- each way out, so only when that is small -- but where what follows
-- is the match itself, each arm goes to the ways out that choose its
-- tag, and where each tag is chosen by one way out nothing is copied,
-- however big the arms: an iteration's step, `Just (MkPair a rest)` or
-- `Nothing`, with the loop's body and what follows the loop as the arms.

-- | how big what is copied may be, times the copies
sumBudget : Int
sumBudget = 100

-- | the ways out of an expression: the tags it comes to, through its
-- | bindings and the arms of its matches (an arm abandoned none), and
-- | how many come to anything else
type Ways = Pair (List String) Int

bothWays : Ways -> Ways -> Ways
bothWays (MkPair ts n) (MkPair us m) = MkPair (appendL ts us) (n + m)

waysOut : IR.Expr -> Ways
waysOut (ETag t _ _) = MkPair (Cons t Nil) 0
waysOut (ELet _ _ b) = waysOut b
waysOut (ESet _ _ b) = waysOut b
waysOut (EMatch _ arms) =
  List.foldl (\w a -> bothWays w (waysOut (IR.armBody a))) (MkPair Nil 0) arms
waysOut EAbandon = MkPair Nil 0
waysOut e = MkPair Nil 1

waysCount : Ways -> Int
waysCount (MkPair ts n) = List.length ts + n

-- (whether any way out comes to a tag)
anyTag : Ways -> Bool
anyTag (MkPair ts n) = List.length ts > 0

countTag : String -> List String -> Int
countTag t ts = List.length (List.keepIf (\u -> strEq u t) ts)

-- | an arm of a match on what comes out those ways is copied to every
-- | way out that comes to its tag, and to every one that comes to no
-- | tag (given the whole match), but the first: whether that is more
-- | than the budget allows
armOver : Int -> Ways -> IR.Arm -> Bool
armOver budget (MkPair ts n) (MkArm t _ b) =
  countTag t ts + n > 1 && IR.sizeAbove (budget / (countTag t ts + n - 1)) b

-- | the arms of a match on what comes out of `a` may be given to the
-- | ways out of `a`: some come to a tag, and no arm is copied more than
-- | the budget allows -- none is where each tag is come to once
armsPushable : Int -> IR.Expr -> List IR.Arm -> Bool
armsPushable budget a arms =
  anyTag (waysOut a) && not (List.any (armOver budget (waysOut a)) arms)

-- (how many times a condition looks at the `Bool` `x`: a match on it)
testsOf : String -> IR.Cond -> Int
testsOf x (CTest (EVar y)) = if strEq x y then 1 else 0
testsOf x (CNot c) = testsOf x c
testsOf x (CIf a b c) = testsOf x a + testsOf x b + testsOf x c
testsOf x c = 0

-- (how many matches on `x` there are in the worklist)
scrutW : String -> Int -> List IR.Expr -> Int
scrutW x n Nil = n
scrutW x n (Cons (EMatch sc arms) rest) =
  scrutW x (if isVar x sc then n + 1 else n) (Cons sc (IR.pushArms arms rest))
scrutW x n (Cons (EApp f argv) rest) =
  scrutW x n (Cons f (IR.appendI argv rest))
scrutW x n (Cons (EProj e _ _ _) rest) = scrutW x n (Cons e rest)
scrutW x n (Cons (ELam _ b) rest) = scrutW x n (Cons b rest)
scrutW x n (Cons (ELet _ a b) rest) = scrutW x n (Cons a (Cons b rest))
scrutW x n (Cons (ERecord fs _) rest) = scrutW x n (IR.pushFields fs rest)
scrutW x n (Cons (ETag _ argv _) rest) = scrutW x n (IR.appendI argv rest)
scrutW x n (Cons (EPrimCall _ argv) rest) = scrutW x n (IR.appendI argv rest)
scrutW x n (Cons (ECall _ argv) rest) = scrutW x n (IR.appendI argv rest)
scrutW x n (Cons (EBool c) rest) =
  scrutW x (n + testsOf x c) (IR.condOnto c rest)
scrutW x n (Cons (ESet _ a b) rest) = scrutW x n (Cons a (Cons b rest))
scrutW x n (Cons (EValues es) rest) = scrutW x n (IR.appendI es rest)
scrutW x n (Cons _ rest) = scrutW x n rest

-- (what follows, copied whole to every way out but the first: more
-- than the budget allows)
followOver : IR.Expr -> IR.Expr -> Bool
followOver a b =
  waysCount (waysOut a) > 1
  && IR.sizeAbove (sumBudget / (waysCount (waysOut a) - 1)) b

-- (... or, the match on `x` itself, its arms each to the ways out that
-- choose it)
sumOver : String -> IR.Expr -> IR.Expr -> Bool
sumOver x a (EMatch (EVar y) arms) =
  if strEq x y then not (armsPushable sumBudget a arms)
  else followOver a (EMatch (EVar y) arms)
sumOver x a b = followOver a b

-- | `x`, bound to a match coming to tags, is only matched on in `b`,
-- | which may be given to each way out
sumTakenApart : String -> IR.Expr -> IR.Expr -> Bool
sumTakenApart x (EMatch s arms) b =
  anyTag (waysOut (EMatch s arms))
  && scrutW x 0 (Cons b Nil) > 0
  && scrutW x 0 (Cons b Nil) == occCountOf x b
  && not (sumOver x (EMatch s arms) b)
sumTakenApart x a b = False

-- (each way out of `a` given what follows, `x` bound to its tag there:
-- the tag's fields bound first, so that it is a value put where it is
-- matched on -- or, a way out that comes to no tag, bound to that)
sumPushed : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
sumPushed r x b (ETag t es ts) = do
  bound <- bindArgs es
  b2 <- copy b
  e <- r.simp (ELet x (ETag t (snd bound) ts) b2)
  pure (letsOf (fst bound) e)
sumPushed r x b (ELet y a c) = do
  c2 <- sumPushed r x b c
  pure (ELet y a c2)
sumPushed r x b (ESet ys a c) = do
  c2 <- sumPushed r x b c
  pure (ESet ys a c2)
sumPushed r x b (EMatch s arms) = do
  arms2 <- armsS (\a -> sumPushed r x b a) arms
  pure (EMatch s arms2)
sumPushed r x b EAbandon = pure EAbandon
sumPushed r x b e = do
  b2 <- copy b
  r.simp (ELet x e b2)

-- Tags taken apart, their fields computing: `let p = InR (InR (Catch
-- (nt c) h)) in case p of ...` (an operation, its evidence applied,
-- given a handler's `malg`) -- the fields that compute bound first, in
-- order, and the tags in it kept: the tag is a value then, put where it
-- is matched on, which chooses at once.

type Fielded = Pair (List (Pair String IR.Expr)) IR.Expr

consFielded : Fielded
            -> Pair (List (Pair String IR.Expr)) (List IR.Expr)
            -> Pair (List (Pair String IR.Expr)) (List IR.Expr)
consFielded (MkPair bs e) (MkPair rest es) =
  MkPair (appendL bs rest) (Cons e es)

-- (a field: a value as it is; a tag, its fields so; a binding, bound
-- first; anything else bound to a name of its own)
fieldBound : (IR.Expr -> M Fielded) -> IR.Expr -> M Fielded
fieldBound tag (ETag t argv ts) = tag (ETag t argv ts)
fieldBound tag (ELet y e c) = do
  rest <- fieldBound tag c
  pure (MkPair (Cons (MkPair y e) (fst rest)) (snd rest))
fieldBound tag a =
  if IR.isValue a then pure (MkPair Nil a)
  else do
    t <- freshName "t"
    pure (MkPair (Cons (MkPair t a) Nil) (EVar t))

fieldsBound : (IR.Expr -> M Fielded)
            -> List IR.Expr
            -> M (Pair (List (Pair String IR.Expr)) (List IR.Expr))
fieldsBound tag Nil = pure (MkPair Nil Nil)
fieldsBound tag (Cons a argv) = do
  one <- fieldBound tag a
  rest <- fieldsBound tag argv
  pure (consFielded one rest)

tagBound : IR.Expr -> M Fielded
tagBound (ETag t argv ts) = do
  fs <- fieldsBound tagBound argv
  pure (MkPair (fst fs) (ETag t (snd fs) ts))
tagBound e = pure (MkPair Nil e)

-- (a tag not a value, matched on)
tagApart : String -> IR.Expr -> IR.Expr -> Bool
tagApart x (ETag t argv ts) b =
  not (IR.isValue (ETag t argv ts)) && scrutW x 0 (Cons b Nil) > 0
tagApart x a b = False

-- Records built to be taken apart: `let r = { rune = strRuneAt s i, width
-- = strRuneWidth s i } in ... r.rune ... r.width` -- a record whose
-- fields compute, then only projected -- has its fields bound first, in
-- order, and the record of them is a value put where each field is
-- taken: `r.rune` is the field's variable, and no record is built.

-- (how many fields of `x` are taken in the worklist)
projW : String -> Int -> List IR.Expr -> Int
projW x n Nil = n
projW x n (Cons (EProj e _ _ _) rest) =
  if isVar x e then projW x (n + 1) rest else projW x n (Cons e rest)
projW x n (Cons (EMatch sc arms) rest) =
  projW x n (Cons sc (IR.pushArms arms rest))
projW x n (Cons (EApp f argv) rest) = projW x n (Cons f (IR.appendI argv rest))
projW x n (Cons (ELam _ b) rest) = projW x n (Cons b rest)
projW x n (Cons (ELet _ a b) rest) = projW x n (Cons a (Cons b rest))
projW x n (Cons (ERecord fs _) rest) = projW x n (IR.pushFields fs rest)
projW x n (Cons (ETag _ argv _) rest) = projW x n (IR.appendI argv rest)
projW x n (Cons (EPrimCall _ argv) rest) = projW x n (IR.appendI argv rest)
projW x n (Cons (ECall _ argv) rest) = projW x n (IR.appendI argv rest)
projW x n (Cons (EBool c) rest) = projW x n (IR.condOnto c rest)
projW x n (Cons (ESet _ a b) rest) = projW x n (Cons a (Cons b rest))
projW x n (Cons (EValues es) rest) = projW x n (IR.appendI es rest)
projW x n (Cons _ rest) = projW x n rest

-- | `x`, bound to a record some of whose fields compute, is used more
-- | than once in `b`, each time a field of it taken
recordTakenApart : String -> IR.Expr -> IR.Expr -> Bool
recordTakenApart x (ERecord fs ts) b =
  not (IR.isValue (ERecord fs ts))
  && occCountOf x b >= 2
  && projW x 0 (Cons b Nil) == occCountOf x b
recordTakenApart x a b = False

-- (the record's fields bound to names of their own, in order, and `x`
-- bound to the record of them, a value)
recordSplit : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
recordSplit r x (ERecord fs ts) b = do
  bound <- bindArgs (List.map (\(f : Pair String IR.Expr) -> snd f) fs)
  e <-
    r.simp
      (ELet
         x
         (ERecord
            (List.zipWith
               (\(f : Pair String IR.Expr) a -> MkPair (fst f) a)
               fs
               (snd bound))
            ts)
         b)
  pure (letsOf (fst bound) e)
recordSplit r x a b = do
  b' <- r.simp b
  pure (ELet x a b')

-- | a binding, its value simplified: what could fail is computed where
-- | it was, used or not.  A known function given fewer arguments than it
-- | takes, some computing (`c = lPing (intOr 100000 rest)`), has those
-- | bound first, in order: what is left is the closure, built of
-- | values, pure -- put where it is used, and called whole there (with
-- | a handler, for one: `c hd r k`, a call of a copy for it)
letIn : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
letIn r x a b = do
  p <- isPure a
  s <- get
  if IR.keepsValue a && occCountOf x b > 0
  then do
    b' <- r.simp b
    pure (ELet x a b')
  else if sumTakenApart x a b then sumPushed r x b a
  else if isJustS (givenSet x a b) then setGiven r x a b
  else if tagApart x a b
  then do
    bound <- tagBound a
    e <- letIn r x (snd bound) b
    pure (letsOf (fst bound) e)
  else if recordTakenApart x a b then recordSplit r x a b
  -- (a handler built by a global, bound and used a few times: put where
  -- it is used, known to each use, as a record of functions is)
  else if builtBy s.sp.all a && occCountOf x b <= handlerUses
  then do
    b' <- substCopies x a b
    r.simp b'
  else if p then letPure r x a b (occCountOf x b)
  else if partialApp s a then letSplit r x a b
  else do
    b' <- r.simp b
    pure (bindOrSet x a b')

-- | `g` is a function known to take more than `n` arguments: given
-- | `n`, it only builds a closure
takesMore : St -> String -> Int -> Bool
takesMore s g n = case Map.lookup s.defs g of
  Just (ELam xs _) -> List.length xs > n
  _ -> False

-- (the arguments are the parameters, in order)
paramsAre : List String -> List IR.Expr -> Bool
paramsAre Nil Nil = True
paramsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && paramsAre xs es
paramsAre _ _ = False

-- (a function that is a value already, and none of the parameters: a
-- variable, or a definition made already -- not the one being made,
-- `f x = f x`, which as `f = f` would be a value defined by itself)
etaHead : Map.Map String Unit -> List String -> IR.Expr -> Bool
etaHead kinds xs (EVar y) = not (elemStr y xs)
etaHead kinds xs (EGlobal g) = Map.member kinds g
etaHead kinds xs _ = False

-- | `\x y -> f x y` is `f`, where `f` is a value: a variable or a
-- | definition (the language is pure, and `f` computes nothing)
eta : Map.Map String Unit -> IR.Expr -> IR.Expr
eta kinds (ELam xs (EApp f argv)) =
  if paramsAre xs argv && etaHead kinds xs f then f else ELam xs (EApp f argv)
eta kinds e = e

-- | a binding of a binding, `x = (let y = a in b)`, is `y = a`, then
-- | `x = b`: computed in the same order (names are the program's own,
-- | so `y` is seen by nothing else) -- and `b` judged by itself, a
-- | lambda put where it is used (`hd.malg p` of a known handler, its
-- | operation computed first: `p = ...`, then `\k -> perform p k`)
letFloat : SK -> String -> IR.Expr -> IR.Expr -> M IR.Expr
letFloat r x (ELet y a1 a2) b = do
  rest <- letFloat r x a2 b
  pure (ELet y a1 rest)
letFloat r x (ESet ys a1 a2) b = do
  rest <- letFloat r x a2 b
  pure (ESet ys a1 rest)
letFloat r x a b = letIn r x a b

-- | a number a word holds, which a global may be put where it is used
-- | as: a float, a fixed-width number, an integer of no more than 62
-- | bits (one beyond them is built where it is written)
-- | >>> List.map wordLiteral [EFloat 3.14, EInt 4611686018427387904, EStr "x"]
-- | [True, False, False]
wordLiteral : IR.Expr -> Bool
wordLiteral (EFloat _) = True
wordLiteral (EFloat32 _) = True
wordLiteral (EFixed _ _) = True
wordLiteral (EInt i) = i < 4611686018427387904 && i >= 0 - 4611686018427387904
wordLiteral e = False

-- (a global that is such a number, the number: a loop's bound, `pi`,
-- read where it is used, not asked of the global each round.  And one
-- that is another name for a global, that global: `W3 = state Int
-- <+> exception Int`, a copy of `<+>` for them, a record a copy may be
-- made for)
globalLiteral : String -> Maybe IR.Expr -> IR.Expr
globalLiteral g (Just (EGlobal h)) = EGlobal h
globalLiteral g (Just b) = if wordLiteral b then b else EGlobal g
globalLiteral g Nothing = EGlobal g

simpF : SK -> IR.Expr -> M IR.Expr
simpF r (ELam xs b) = do
  b' <- r.simp b
  s <- get
  pure (eta s.sp.kinds (lam xs b'))
-- (a call given its arguments a few at a time, `(g a) b`, is `g a b`
-- where `g a` only builds a closure: the same computed in the same
-- order, and the call seen whole)
simpF r (EApp (EApp (EGlobal g) bs) argv) = do
  s <- get
  if takesMore s g (List.length bs)
  then r.simp (EApp (EGlobal g) (appendL bs argv))
  else do
    f' <- r.simp (EApp (EGlobal g) bs)
    argv' <- traverseS (\a -> r.simp a) argv
    r.applyTo f' argv'
-- (a global called is no number: not looked for among them)
simpF r (EApp (EGlobal g) argv) = do
  argv' <- traverseS (\a -> r.simp a) argv
  r.applyTo (EGlobal g) argv'
simpF r (EApp f argv) = do
  f' <- r.simp f
  argv' <- traverseS (\a -> r.simp a) argv
  r.applyTo f' argv'
simpF r (ELet x a b) = do
  a' <- r.simp a
  letFloat r x a' b
simpF r (ERecord fs ts) = do
  fs' <- fieldsS (\a -> r.simp a) fs
  pure (ERecord fs' ts)
simpF r (EProj e2 l sh t) = do
  e2' <- r.simp e2
  r.project l sh t e2'
simpF r (ETag t argv ts) = do
  argv' <- traverseS (\a -> r.simp a) argv
  pure (ETag t argv' ts)
simpF r (EMatch s arms) = do
  s' <- r.simp s
  arms' <- armsS (\a -> r.simp a) arms
  r.match s' arms'
simpF r (EPrimCall p argv) = do
  argv' <- traverseS (\a -> r.simp a) argv
  pure (foldPrim p argv')
simpF r (EBool c) = do
  c' <- condS (\a -> r.simp a) c
  pure (IR.boolOf (foldCond c'))
-- (the values set, where there is but one way: each bound)
simpF r (ESet xs a b) = do
  a' <- r.simp a
  case a' of
    EValues es -> r.simp (letsOf (zipL xs es) b)
    _ -> do
      b' <- r.simp b
      pure (ESet xs a' b')
simpF r (EValues es) = do
  es' <- traverseS (\a -> r.simp a) es
  pure (EValues es')
simpF r (EGlobal g) = do
  s <- get
  pure (globalLiteral g (Map.lookup s.defs g))
simpF r e = pure e

-- | an argument that tells a body nothing to compute with
opaque : IR.Expr -> Bool
opaque (EVar _) = True
opaque (EInt _) = True
opaque (EFloat _) = True
opaque (EStr _) = True
opaque (EBytes _) = True
opaque (EFixed _ _) = True
opaque (EFloat32 _) = True
opaque e = False

allOpaque : List IR.Expr -> Bool
allOpaque argv = IR.allI (List.map (\a -> opaque a) argv)

-- | the most a definition's body may be for an inlining to be tried:
-- | copying and simplifying a bigger one, to find it too big, was most of
-- | what the simplifier did
inlineMax : Int
inlineMax = 50

tooBig : String -> St -> Bool
tooBig g s = case Map.lookup s.defs g of
  Just b -> IR.sizeAbove inlineMax b
  Nothing -> False

-- (a tag, an operation)
tagged : IR.Expr -> Bool
tagged (ETag _ _ _) = True
tagged _ = False

-- (a copy given, past its parameters, a handler: what it comes to is a
-- computation, `\hd k -> ...`, run by that handler at once -- an
-- operation's copy that computes before it is given it, `handle hd c`)
handedPast : Map.Map String Unit -> IR.Expr -> List IR.Expr -> Bool
handedPast kinds (ELam xs _) argv =
  List.length argv > List.length xs
  && List.any (handlerArg kinds) (dropL (List.length xs) argv)
handedPast kinds b argv = False

-- (how big such a copy may be)
copyMax : Map.Map String Unit -> IR.Expr -> List IR.Expr -> Int
copyMax kinds b argv = if handedPast kinds b argv then handedSize else inlineMax

-- (how much bigger a handler's clause, given an operation, may make the
-- code: the clause chosen is all that is left of it)
clauseBudget : List IR.Expr -> Int
clauseBudget argv = if List.any tagged argv then handedSize else budget

-- (how much bigger inlining it may make the code)
copyBudget : Map.Map String Unit -> Maybe IR.Expr -> List IR.Expr -> Int
copyBudget kinds (Just b) argv =
  if handedPast kinds b argv then handedSize else budget
copyBudget kinds Nothing argv = budget

-- (the arm of the tag)
findArm : String -> List IR.Arm -> Maybe IR.Arm
findArm t Nil = Nothing
findArm t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t then Just (MkArm t2 vs b) else findArm t rest

-- (the parameters given a tag, each known by it)
tagsGiven : List String
          -> List IR.Expr
          -> Map.Map String IR.Expr
          -> Map.Map String IR.Expr
tagsGiven (Cons x xs) (Cons a argv) m =
  tagsGiven xs argv (if tagged a then Map.insert m x a else m)
tagsGiven _ _ m = m

-- (what a match is on, if it is a tag known)
tagKnown : Map.Map String IR.Expr -> IR.Expr -> Maybe IR.Expr
tagKnown known (EVar x) = Map.lookup known x
tagKnown known _ = Nothing

-- (the arm a tag known chooses, what it holds known by the arm's names)
armChosen : Map.Map String IR.Expr
          -> List IR.Arm
          -> Maybe IR.Expr
          -> Maybe (Pair IR.Expr (Map.Map String IR.Expr))
armChosen known arms (Just (ETag t argv _)) = case findArm t arms of
  Just (MkArm _ vs b) -> Just (MkPair b (tagsGiven vs argv known))
  Nothing -> Nothing
armChosen known arms _ = Nothing

-- (a match on a tag known: the arm it chooses)
matchChosen : Map.Map String IR.Expr
            -> IR.Expr
            -> Maybe (Pair IR.Expr (Map.Map String IR.Expr))
matchChosen known (EMatch sc arms) = armChosen known arms (tagKnown known sc)
matchChosen known _ = Nothing

-- (as `IR.sizeAbove`'s count, a match on a tag known counting the arm
-- it chooses alone)
prunedB : Int -> Map.Map String IR.Expr -> Int -> List IR.Expr -> Int
prunedB lim known n Nil = n
prunedB lim known n (Cons e rest) =
  if n > lim then n
  else case matchChosen known e of
    Just (MkPair b known2) -> prunedB lim known2 (n + 1) (Cons b rest)
    Nothing -> prunedB lim known (n + 1) (IR.partsOnto e rest)

-- (an arm of a match on a tag known: the arm it chooses, pruned in turn;
-- any other, nothing)
prunedArm : (Map.Map String IR.Expr -> IR.Expr -> IR.Expr)
          -> Map.Map String IR.Expr
          -> Maybe IR.Expr
          -> IR.Arm
          -> IR.Arm
prunedArm go known (Just (ETag t argv _)) (MkArm t2 vs b) =
  if strEq t t2 then MkArm t2 vs (go (tagsGiven vs argv known) b)
  else MkArm t2 vs EAbandon
prunedArm go known _ (MkArm t2 vs b) = MkArm t2 vs (go known b)

-- (an expression, a match on a tag known in it left the arm it chooses)
prunedFor : Map.Map String IR.Expr -> IR.Expr -> IR.Expr
prunedFor known (ELam xs b) = ELam xs (prunedFor known b)
prunedFor known (ELet x a b) = ELet x (prunedFor known a) (prunedFor known b)
prunedFor known (ESet xs a b) = ESet xs (prunedFor known a) (prunedFor known b)
prunedFor known (EApp f argv) =
  EApp (prunedFor known f) (List.map (\a -> prunedFor known a) argv)
prunedFor known (EMatch sc arms) =
  EMatch
    sc
    (List.map (\a -> prunedArm prunedFor known (tagKnown known sc) a) arms)
prunedFor known e = e

-- | a copy where it is called: a match on a parameter given a tag left
-- | the arm that tag chooses, and so on into what the tag holds (`op`,
-- | made for a handler of two effects and given `InL (Get k)`, is a
-- | match on the operation, each arm a match on what it holds: one arm
-- | of each is all that inlining it leaves).  The other arms are not
-- | copied to be thrown away
prunedCopy : IR.Expr -> List IR.Expr -> IR.Expr
prunedCopy (ELam xs b) argv =
  if List.any tagged argv
  then prunedFor (tagsGiven xs argv Map.empty) (ELam xs b)
  else ELam xs b
prunedCopy b argv = b

-- (whether a copy is bigger than `lim` where it is called, counting the
-- arms a tag given chooses alone)
prunedAbove : Int -> IR.Expr -> List IR.Expr -> Bool
prunedAbove lim (ELam xs b) argv =
  prunedB lim (tagsGiven xs argv Map.empty) 0 (Cons (ELam xs b) Nil) > lim
prunedAbove lim b argv = True

-- (how big such a copy may be: as a copy may, and no bigger than the call
-- with what inlining may add to it, which `attemptBy` holds it to -- a
-- copy of the arms chosen bigger than that seldom comes to less)
prunedMax : Map.Map String Unit -> String -> IR.Expr -> List IR.Expr -> Int
prunedMax kinds g b argv =
  min
    (copyMax kinds b argv)
    (IR.size (EApp (EGlobal g) argv) + copyBudget kinds (Just b) argv)

-- | a copy (Specialisation, below), to inline: what it is known by --
-- | simplified with what it was made for, a handler's `bind` and `malg`
-- | known -- if it does not call itself and is no bigger than a
-- | definition inlined may be, as it is or where it is called
-- | (`prunedCopy`).  (`op`, made for a handler, comes to a match on the
-- | operation, each arm a few lines of the handler's `malg`.)
knownCopy : St -> String -> List IR.Expr -> Maybe IR.Expr
knownCopy s g argv =
  if Map.member s.sp.recipes g
  then case Map.lookup s.sp.all g of
    Just b ->
      if (not (IR.sizeAbove (copyMax s.sp.kinds b argv) b)
          || not (prunedAbove (prunedMax s.sp.kinds g b argv) b argv))
         && not (elemStr g (IR.globalsIn b))
      then Just (prunedCopy b argv)
      else Nothing
    Nothing -> Nothing
  else Nothing

-- | a known definition, inlined if it may be, and the result simplified
inlineCall : SK -> IR.Expr -> String -> List IR.Expr -> M IR.Expr
inlineCall r f g argv = do
  s <- get
  if tooBig g s then pure (mkApp f argv)
  else do
    mb <- known g
    case mb of
      Just b -> attempt (mkApp f argv) (r.applyTo b argv)
      Nothing -> pure (mkApp f argv)

paramsTo : List String -> List IR.Expr -> Map.Map String IR.Expr
paramsTo xs argv =
  List.foldl
    (\m p -> Map.insert m (fst p) (snd p))
    Map.empty
    (zipL xs argv)

freshParam : String -> Pair (List String) Int -> Pair (List String) Int
freshParam base (MkPair xs n) = case IR.fresh base n of
  MkPair x n2 -> MkPair (Cons x xs) n2

freshParams : Int -> M (List String)
freshParams k = \s -> case List.foldl
    (\acc i -> freshParam "p" acc)
    (MkPair Nil s.supply)
    (List.range 1 k) of
  MkPair xs n -> MkPair xs (withSupply n s)

plainKey : String -> List IR.Expr -> String
plainKey g argv = g ^ "/" ^ show (List.length argv)

-- | (taken from what was found, so long as the fuel lasted it out)
remember : String -> Plain -> M Unit
remember k p = \s -> MkPair MkUnit (if s.fuel > 0 then withPlain k p s else s)

-- | a known definition given all its arguments, none of which it can
-- | compute with: what the call comes to is the same whatever they are,
-- | so it is found once -- for parameters of its own -- and kept, the
-- | arguments put in for them where it is used again.  (Each such call
-- | copied and simplified the body again, and most were thrown away.)
plainCall : SK -> IR.Expr -> String -> List IR.Expr -> M IR.Expr
plainCall r f g argv = do
  s <- get
  case Map.lookup s.plain (plainKey g argv) of
    Just NotInlined -> pure (mkApp f argv)
    Just (Inlined ps e) ->
      if s.fuel > 0
      then do
        u <- put (withFuel (s.fuel - 1) s)
        e2 <- copy e
        pure (IR.subst (paramsTo ps argv) e2)
      else pure (mkApp f argv)
    Nothing -> do
      ps <- freshParams (List.length argv)
      mb <- known g
      case mb of
        Just b -> do
          e <- r.applyTo b (List.map (\x -> EVar x) ps)
          if not (IR.sizeAbove (IR.size (mkApp f argv) + budget) e)
          then do
            u <- remember (plainKey g argv) (Inlined ps e)
            pure (IR.subst (paramsTo ps argv) e)
          else do
            st <- get
            u <- put (restore s st)
            u2 <- remember (plainKey g argv) NotInlined
            pure (mkApp f argv)
        Nothing -> pure (mkApp f argv)

-- | an argument a body can compute with, more than with a variable: a
-- | tag (an operation, `Catch c h`), a record.  (Not a lambda: a
-- | continuation, in a `do`, had the simplifier simplify again what it
-- | was given inside each copy inlined, the compiler compiling itself
-- | 50% slower; nor a definition that is a record, a handler or an
-- | effect's signature: 8% slower, for a handler of four effects at
-- | once alone.)
telling : IR.Expr -> Bool
telling (ETag _ _ _) = True
telling (ERecord _ _) = True
telling _ = False

-- (whether the variable is taken apart in the worklist: matched on,
-- called, a field of it taken)
apartW : String -> List IR.Expr -> Bool
apartW x Nil = False
apartW x (Cons (EMatch sc arms) rest) =
  isVar x sc || apartW x (Cons sc (IR.pushArms arms rest))
apartW x (Cons (EApp f argv) rest) =
  isVar x f || apartW x (Cons f (IR.appendI argv rest))
apartW x (Cons (EProj e _ _ _) rest) = isVar x e || apartW x (Cons e rest)
apartW x (Cons (ELam _ b) rest) = apartW x (Cons b rest)
apartW x (Cons (ELet _ a b) rest) = apartW x (Cons a (Cons b rest))
apartW x (Cons (ERecord fs _) rest) = apartW x (IR.pushFields fs rest)
apartW x (Cons (ETag _ argv _) rest) = apartW x (IR.appendI argv rest)
apartW x (Cons (EPrimCall _ argv) rest) = apartW x (IR.appendI argv rest)
apartW x (Cons (ECall _ argv) rest) = apartW x (IR.appendI argv rest)
apartW x (Cons (EBool c) rest) =
  testsOf x c > 0 || apartW x (IR.condOnto c rest)
apartW x (Cons (ESet _ a b) rest) = apartW x (Cons a (Cons b rest))
apartW x (Cons (EValues es) rest) = apartW x (IR.appendI es rest)
apartW x (Cons _ rest) = apartW x rest

-- (an argument that tells, its parameter taken apart in the body)
toldTo : IR.Expr -> List String -> List IR.Expr -> Bool
toldTo b (Cons x xs) (Cons a argv) =
  (telling a && apartW x (Cons b Nil)) || toldTo b xs argv
toldTo b _ _ = False

-- | a copy is inlined where it is given something to compute with: an
-- | argument that tells, for a parameter it takes apart (`op`, made for
-- | a handler, given `Catch c h`, matches on it)
worthIt : Map.Map String Unit -> List IR.Expr -> Maybe IR.Expr -> Maybe IR.Expr
worthIt kinds argv (Just (ELam xs b)) =
  if toldTo b xs argv || handedPast kinds (ELam xs b) argv then Just (ELam xs b)
  else Nothing
worthIt kinds argv _ = Nothing

-- (a copy called, its body inlined if it may be)
copyInlined : SK -> Int -> IR.Expr -> List IR.Expr -> Maybe IR.Expr -> M IR.Expr
copyInlined r more f argv (Just b) =
  attemptBy more (mkApp f argv) (r.applyTo b argv)
copyInlined r more f argv Nothing = pure (mkApp f argv)

-- | a copy called, given something to compute with: inlined, if it
-- | may be (`knownCopy`) and that makes the code no bigger than a little
copyCall : SK -> IR.Expr -> String -> List IR.Expr -> M IR.Expr
copyCall r f g argv = do
  s <- get
  mb <- fueled (worthIt s.sp.kinds argv (knownCopy s g argv))
  copyInlined r (copyBudget s.sp.kinds mb argv) f argv mb

-- | a known definition called: inlined if it may be -- or a copy
callOf : SK -> IR.Expr -> String -> List IR.Expr -> Maybe IR.Expr -> M IR.Expr
callOf r f g argv (Just (ELam xs _)) =
  if allOpaque argv && List.length xs == List.length argv
  then plainCall r f g argv
  else inlineCall r f g argv
callOf r f g argv Nothing = copyCall r f g argv
callOf r f g argv _ = inlineCall r f g argv

-- | a lambda applied: its parameters bound to the arguments (not
-- | simplified yet: `simp` does it once all are bound), and what is left
-- | applied to the rest
applyLam : SK -> List String -> IR.Expr -> List IR.Expr -> M IR.Expr
applyLam r xs b argv = do
  red <-
    r.simp
      (letsOf
         (zipL
            (takeL (minI (List.length xs) (List.length argv)) xs)
            (takeL (minI (List.length xs) (List.length argv)) argv))
         (if List.length xs > minI (List.length xs) (List.length argv)
          then ELam (dropL (minI (List.length xs) (List.length argv)) xs) b
          else b))
  r.applyTo red (dropL (minI (List.length xs) (List.length argv)) argv)

-- (the expressions are the variables, in order)
varsAre : List String -> List IR.Expr -> Bool
varsAre Nil Nil = True
varsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && varsAre xs es
varsAre _ _ = False

-- | a function that is another name for a tag, `\x y -> C x y`: the tag
tagOfLam : List String -> IR.Expr -> Maybe String
tagOfLam xs (ETag t es _) = if varsAre xs es then Just t else Nothing
tagOfLam xs _ = Nothing

-- Specialisation
--------------------------------------------------------------------------------

-- A known definition that is not inlined -- it calls itself, or is too
-- big -- given arguments known where it is called (a definition that is
-- a function or a record, a closed lambda or record; to a loop, a small
-- lambda that calls nothing, whatever it captures) is called as a copy
-- of it made for them: their parameters gone, the arguments in their
-- place, the copy simplified with them (`e.hmap`, `hd.bind`, `r.simp`
-- known now: inlined, or calls of known definitions in turn).  For a
-- definition that calls itself, only the parameters every call of
-- itself hands on unchanged (`Spec.statics`): its calls are of the copy
-- then.
--
-- A copy is the same whoever asks for it, and wherever: it is named by
-- what it is made for (`Spec.copyName`, of its key, the known arguments
-- shaped: `Spec.shapeOf`), and asked for by that name, which is all a
-- call of it needs.  What is known of it (`knowing`) is what it is as
-- asked for, simplified with no copy asked for in it: the same whoever
-- asks.  (What making it comes to would be known, or not, by who asked
-- first -- and not at all by a copy asked for while it is made.)  Each
-- is made once in the program, after the definition that first calls
-- it, as a definition is: with fuel of its own, the copies it calls for
-- made in turn, each before what calls it.

-- | the most that is made: the size of a definition copied, copies
-- | asked for by one definition (or copy) as it is simplified, copies of
-- | copies one inside another
specBodySize : Int
specBodySize = 1200

specLimit : Int
specLimit = 50000

specDepth : Int
specDepth = 16

-- | an argument a copy may be made for
knownArg : Map.Map String Unit -> IR.Expr -> Bool
knownArg kinds (EGlobal g) = Map.member kinds g
knownArg kinds e = closedKnown e || handlerLike e

-- | ... and, given to a loop (a definition calling itself, `loops`), a
-- | lambda capturing variables that calls nothing (`Sp.callsNothing`):
-- | the copy is given those in its place (`Sp.shapeOf`), and computes
-- | it where it is called, at each round, no closure built
capturing : IR.Expr -> Bool
capturing (ELam xs b) =
  not (IR.sizeAbove specArgSize (ELam xs b)) && Spec.callsNothing (ELam xs b)
capturing _ = False

loops : String -> IR.Expr -> Bool
loops g b = elemStr g (IR.globalsIn b)

-- Continuations back into a loop: `loop i acc = do r <- step i; loop
-- (i + 1) (acc + r)` hands `step` a continuation calling `loop`, through
-- which alone `loop` calls itself, so that what `loop` hands on
-- unchanged -- a handler, given it as an argument -- is not seen to be
-- (`Spec.statics`).  `step`'s copy made for that continuation calls
-- `loop` itself, given what the continuation captures: the two are one
-- loop then, and a copy of `loop` for a handler a copy of `step` for it,
-- which calls that copy of `loop` again -- each layer of handlers, peeled
-- off by a copy of its own, an argument of that loop.

-- (a global whose known body calls `g`, or a copy of what `g` is a copy
-- of)
callsBack : Map.Map String IR.Expr -> String -> String -> Bool
callsBack all g h = case Map.lookup all h of
  Just b ->
    List.any
      (\k -> strEq (Spec.rootOf k) (Spec.rootOf g))
      (IR.globalsIn b)
  Nothing -> False

-- | a continuation given to `g` that calls back into a loop calling `g`:
-- | a lambda that is a call of such a global, its arguments computing
-- | without calling anything
loopBack : Map.Map String IR.Expr -> String -> IR.Expr -> Bool
loopBack all g (ELam xs (EApp (EGlobal h) argv)) =
  IR.allI (List.map Spec.callsNothing argv)
  && not (IR.sizeAbove specArgSize (ELam xs (EApp (EGlobal h) argv)))
  && callsBack all g h
loopBack all g _ = False

-- (... where `g` is given a handler too: a copy for both)
backFor : St -> List IR.Expr -> String -> IR.Expr -> Bool
backFor s argv g =
  if List.any (handlerArg s.sp.kinds) argv then loopBack s.sp.all g
  else \e -> False

knownIn : Bool -> Map.Map String Unit -> (IR.Expr -> Bool) -> IR.Expr -> Bool
knownIn loop kinds back e = knownArg kinds e || (loop && capturing e) || back e

nthE : Int -> List IR.Expr -> Maybe IR.Expr
nthE i Nil = Nothing
nthE i (Cons x xs) = if i == 0 then Just x else nthE (i - 1) xs

markGo : Bool
       -> Map.Map String Unit
       -> (IR.Expr -> Bool)
       -> List IR.Expr
       -> List Bool
       -> Int
       -> List Bool
markGo loop all back argv Nil i = Nil
markGo loop all back argv (Cons st rest) i =
  Cons
    (st && maybe False (\a -> knownIn loop all back a) (nthE i argv))
    (markGo loop all back argv rest (i + 1))

marksIn : Bool
        -> Map.Map String Unit
        -> (IR.Expr -> Bool)
        -> String
        -> List String
        -> IR.Expr
        -> List IR.Expr
        -> List Bool
marksIn loop all back g xs b argv =
  markGo
    loop
    all
    back
    argv
    (if loop then Spec.statics g xs b else List.map (\x -> True) xs)
    0

-- | the parameters a copy is made for: known there, and handed on as
-- | they are if `g` calls itself
marksOf : Map.Map String Unit
        -> (IR.Expr -> Bool)
        -> String
        -> List String
        -> IR.Expr
        -> List IR.Expr
        -> List Bool
marksOf all back g xs b argv = marksIn (loops g b) all back g xs b argv

-- | whether a copy may be made for any of the arguments
anyKnown : Map.Map String Unit
         -> (IR.Expr -> Bool)
         -> String
         -> IR.Expr
         -> List IR.Expr
         -> Bool
anyKnown kinds back g b argv =
  List.any (\a -> knownArg kinds a || back a) argv
  || (List.any capturing argv && loops g b)

specKey : String -> List Bool -> List String -> List IR.Expr -> String
specKey g marks vars argv =
  g
  ^ "("
  ^ joinWith
    ","
    (List.zipWith
       (\m a -> if m then Spec.keyIn vars a else "_")
       marks
       (takeL (List.length marks) argv))
  ^ ")"

keepParams : List Bool -> List String -> List String
keepParams Nil xs = xs
keepParams (Cons m ms) Nil = Nil
keepParams (Cons m ms) (Cons x xs) =
  if m then keepParams ms xs else Cons x (keepParams ms xs)

-- | each marked parameter replaced by its argument, a copy each time
substMarked : List Bool -> List String -> List IR.Expr -> IR.Expr -> M IR.Expr
substMarked (Cons m ms) (Cons x xs) (Cons a argv) e =
  if m
  then do
    e2 <- substCopies x a e
    substMarked ms xs argv e2
  else substMarked ms xs argv e
substMarked _ _ _ e = pure e

-- | the arguments a copy is asked for with: the marked ones shaped, the
-- | literals taken out of them (`vars`, given `holes` where it is
-- | called), each in order
type Shapes = { args : List IR.Expr, vars : List String, holes : List IR.Expr }

shapeCons : IR.Expr -> List String -> List IR.Expr -> Shapes -> Shapes
shapeCons a vs hs rest =
  { args = Cons a rest.args
  , vars = appendL vs rest.vars
  , holes = appendL hs rest.holes
  }

shapedTo : Spec.Shaped -> St -> Pair Spec.Shaped St
shapedTo x s = MkPair x (withSupply x.n s)

shapeOne : Bool -> IR.Expr -> M Spec.Shaped
shapeOne m a = \s ->
    if m then shapedTo (Spec.shapeOf s.supply a) s
    else MkPair { e = a, vars = Nil, holes = Nil, n = s.supply } s

shapesOf : List Bool -> List IR.Expr -> M Shapes
shapesOf (Cons m ms) (Cons a argv) = do
  x <- shapeOne m a
  rest <- shapesOf ms argv
  pure (shapeCons x.e x.vars x.holes rest)
shapesOf _ argv = pure { args = argv, vars = Nil, holes = Nil }

isKind : IR.Expr -> Bool
isKind (ELam _ _) = True
isKind (ERecord _ _) = True
isKind _ = False

-- | a definition simplified that is a function, or a value computing
-- | nothing, is safe to use anywhere
markSafe : String -> IR.Expr -> M Unit
markSafe h b = \s ->
    MkPair
      MkUnit
      (if IR.isValue b || pureIn s.safe s.total b then withSafe h s else s)

-- | ... and so is such a copy, as the definitions it was made from were
-- | (`safeGlobals`): judged by what was known of the definitions before
-- | any was simplified, and of the copies (`base`) -- so that it is the
-- | same whoever asks for the copy first.  (A definition that is safe
-- | only once simplified is not yet while it asks, and is when a later
-- | one asks.)
markCopySafe : String -> IR.Expr -> M Unit
markCopySafe h b = \s ->
    MkPair
      MkUnit
      (if IR.isValue b || pureIn s.base s.total b then withSafe h (withBase h s)
       else s)

-- | a copy asked for, as it is (`b0`, its parameters put in): what is
-- | known of it, and how deep in copies of copies it is
askedFor : String -> IR.Expr -> Int -> M Unit
askedFor h b0 d = \s ->
    MkPair
      MkUnit
      (withSp
         { all =
             if not (IR.sizeAbove specBodySize b0)
             then Map.insert s.sp.all h b0
             else s.sp.all
         , kinds =
             if isKind b0 then Map.insert s.sp.kinds h MkUnit
             else s.sp.kinds
         , recipes = Map.insert s.sp.recipes h b0
         , depths = Map.insert s.sp.depths h d
         , made = s.sp.made
         , count = s.sp.count + 1
         , off = s.sp.off
         }
         s)

-- | the copy's body: its literals and the parameters left, the calls of
-- | itself of it
specBody : String -> String -> List Bool -> Shapes -> IR.Expr -> M IR.Expr
specBody g h marks sh (ELam xs1 b1) = do
  b2 <-
    substMarked
      marks
      xs1
      sh.args
      (Spec.selfTo g h (List.map (\v -> EVar v) sh.vars) marks b1)
  pure
      (if List.null (appendL sh.vars (keepParams marks xs1)) then b2
       else ELam (appendL sh.vars (keepParams marks xs1)) b2)
specBody g h marks sh lam1 = pure lam1

-- Arity
--------------------------------------------------------------------------------

-- A function whose every way out is a lambda, `\n -> if n <= 0 then (\hd
-- k -> a) else (\hd k -> b)` -- a computation (`Co`), made of a few
-- arguments -- takes those lambdas' parameters as its own: `\n hd k ->
-- if n <= 0 then a else b`.  A call given them all is one call, and a
-- copy may be made for them (the handler: `hd.bind`, known).  Only what
-- is cheap is crossed -- a value bound, a test of what is at hand: it is
-- computed again each time the function is given its first arguments
-- and applied -- and nothing that may fail.

-- A way out may also be a known function given fewer arguments than it
-- takes, `\n -> if n <= 0 then get else (\hd k -> b)` (`get` a copy
-- for the evidence, taking `hd k`): it only builds a closure, and
-- given the parameters it is a call.  And a match of what is at hand
-- whose every arm is cheap is cheap too (an arm of every tag is there:
-- the elaborator asks for one), `let c = if ... then op (Throw e) else
-- (\hd k -> ...)` crossed as a binding.

-- | how many parameters a known definition takes (0: not known)
arityIn : Map.Map String IR.Expr -> String -> Int
arityIn all g = case Map.lookup all g of
  Just (ELam xs _) -> List.length xs
  _ -> 0

-- | how many more arguments than `as` the known function `g` takes
moreThan : Map.Map String IR.Expr -> String -> List IR.Expr -> Int
moreThan all g argv =
  if arityIn all g > List.length argv then arityIn all g - List.length argv
  else 0

-- | computing it is little, and cannot fail (`all`: the known
-- | definitions, `Specs.all`)
cheap : Map.Map String Unit -> Map.Map String IR.Expr -> IR.Expr -> Bool
cheap safe all (EVar _) = True
cheap safe all (EGlobal g) = Map.member safe g
cheap safe all (ELam _ _) = True
cheap safe all (EPrim _) = True
cheap safe all (EInt _) = True
cheap safe all (EFloat _) = True
cheap safe all (EStr _) = True
cheap safe all (EBytes _) = True
cheap safe all (EFixed _ _) = True
cheap safe all (EFloat32 _) = True
-- (a `Lazy`'s box is no such: a lambda raised past it would make it
-- again at each call, and compute its value again)
cheap safe all (ETag t argv ts) =
  not (IR.keepsValue (ETag t argv ts))
  && IR.allI (List.map (cheap safe all) argv)
cheap safe all (ERecord fs _) =
  IR.allI (List.map (cheap safe all) (List.map snd fs))
cheap safe all (EProj e _ _ _) = cheap safe all e
cheap safe all (ELet _ a b) = cheap safe all a && cheap safe all b
cheap safe all (EPrimCall p argv) =
  not (primFails p) && IR.allI (List.map (cheap safe all) argv)
cheap safe all (EApp (EGlobal g) argv) =
  moreThan all g argv > 0 && IR.allI (List.map (cheap safe all) argv)
cheap safe all (EMatch sc arms) =
  cheap safe all sc
  && not (List.null arms)
  && IR.allI (List.map (cheap safe all) (List.map IR.armBody arms))
cheap safe all (EBool c) = IR.allI (List.map (cheap safe all) (IR.condParts c))
cheap safe all (ESet _ a b) = cheap safe all a && cheap safe all b
cheap safe all (EValues es) = IR.allI (List.map (cheap safe all) es)
cheap safe all _ = False

minL : List Int -> Int
minL Nil = 0
minL (Cons x xs) = List.foldl (\m y -> minI m y) x xs

-- (a known function given fewer arguments than it takes, each cheap:
-- how many more it takes)
partialMore : Map.Map String Unit
            -> Map.Map String IR.Expr
            -> String
            -> List IR.Expr
            -> Int
partialMore safe all g argv =
  if IR.allI (List.map (cheap safe all) argv) then moreThan all g argv else 0

-- | how many parameters every way out of it takes
lamsOut : Map.Map String Unit -> Map.Map String IR.Expr -> IR.Expr -> Int
lamsOut safe all (ELam ys _) = List.length ys
lamsOut safe all (ELet _ a b) =
  if cheap safe all a then lamsOut safe all b else 0
lamsOut safe all (ESet _ a b) =
  if cheap safe all a then lamsOut safe all b else 0
lamsOut safe all (EMatch sc arms) =
  if cheap safe all sc && not (List.null arms)
  then minL (List.map (lamsOut safe all) (List.map IR.armBody arms))
  else 0
lamsOut safe all (EApp (EGlobal g) argv) = partialMore safe all g argv
lamsOut safe all _ = 0

-- | each way out without its first lambdas, their parameters `zs`
stripArm : (IR.Expr -> IR.Expr) -> IR.Arm -> IR.Arm
stripArm go (MkArm t vs b) = MkArm t vs (go b)

stripLams : List String -> IR.Expr -> IR.Expr
stripLams zs (ELam ys b) =
  IR.subst
    (paramsTo ys (List.map (\z -> EVar z) zs))
    (if List.length ys > List.length zs then ELam (dropL (List.length zs) ys) b
     else b)
stripLams zs (ELet x a b) = ELet x a (stripLams zs b)
stripLams zs (ESet xs a b) = ESet xs a (stripLams zs b)
stripLams zs (EMatch sc arms) =
  EMatch sc (List.map (stripArm (stripLams zs)) arms)
-- (a known function given fewer arguments: given the parameters too)
stripLams zs (EApp (EGlobal g) argv) =
  EApp (EGlobal g) (appendL argv (List.map (\z -> EVar z) zs))
stripLams zs e = e

raiseWith : List String -> IR.Expr -> List String -> IR.Expr
raiseWith xs b zs = ELam (appendL xs zs) (stripLams zs b)

-- | a function, taking the parameters every way out of it does.  A
-- | definition that is not a function but whose every way out is a
-- | lambda past what is cheap -- a computation, `peek = let c = ... in
-- | \hd k -> ...` -- becomes one: what it computed once it computes at
-- | each call, which is little and cannot fail, and its handler is a
-- | parameter a copy can be made for
raise : IR.Expr -> M IR.Expr
raise (ELam xs b) = do
  s <- get
  if lamsOut s.safe s.sp.all b == 0 then pure (ELam xs b)
  else do
    zs <- freshParams (lamsOut s.safe s.sp.all b)
    pure (raiseWith xs b zs)
raise e = do
  s <- get
  if lamsOut s.safe s.sp.all e == 0 then pure e
  else do
    zs <- freshParams (lamsOut s.safe s.sp.all e)
    pure (ELam zs (stripLams zs e))

-- (the arguments a copy is made for)
markedOf : List Bool -> List IR.Expr -> List IR.Expr
markedOf (Cons m ms) (Cons a argv) =
  if m then Cons a (markedOf ms argv) else markedOf ms argv
markedOf _ _ = Nil

maxI : Int -> Int -> Int
maxI a b = if a >= b then a else b

-- | how deep in copies of copies a copy of `g` for `args` is: one more
-- | than the deepest copy among them
depthOf : Map.Map String Int -> String -> List IR.Expr -> Int
depthOf ds g args =
  1
  + List.foldl
    (\d n -> maxI d (fromMaybe 0 (Map.lookup ds n)))
    0
    (Cons g (List.concatMap IR.globalsIn args))

-- What a definition is simplified with is its own: its fuel, the calls
-- found plain (`plain`) and how many copies it may ask for are made anew
-- for each definition and each copy -- so that what it comes to depends
-- on what it uses, not on what was simplified before it.

-- (a definition's own: fuel, no call found plain for another, and no
-- copy asked for yet)
ownSt : M Unit
ownSt = \s ->
    MkPair
      MkUnit
      { supply = s.supply
      , fuel = 4000
      , defs = s.defs
      , safe = s.safe
      , base = s.base
      , total = s.total
      , plain = Map.empty
      , sp =
          { all = s.sp.all
          , kinds = s.sp.kinds
          , recipes = s.sp.recipes
          , depths = s.sp.depths
          , made = s.sp.made
          , count = 0
          , off = s.sp.off
          }
      , kp = s.kp
      }

-- (asking for copies off, or on again)
setOff : Bool -> M Unit
setOff o = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , recipes = s.sp.recipes
         , depths = s.sp.depths
         , made = s.sp.made
         , count = s.sp.count
         , off = o
         }
         s)

-- (back to what `saved` was simplifying: its fuel, the calls it found
-- plain, how many copies it asked for and whether it asks for more --
-- the rest learnt kept)
backTo : St -> M Unit
backTo saved = \s ->
    MkPair
      MkUnit
      { supply = s.supply
      , fuel = saved.fuel
      , defs = s.defs
      , safe = s.safe
      , base = s.base
      , total = s.total
      , plain = saved.plain
      , sp =
          { all = s.sp.all
          , kinds = s.sp.kinds
          , recipes = s.sp.recipes
          , depths = s.sp.depths
          , made = s.sp.made
          , count = saved.sp.count
          , off = saved.sp.off
          }
      , kp = s.kp
      }

-- The cache
--------------------------------------------------------------------------------

-- What a definition or a copy is simplified to depends on what it is
-- made of alone (see `ownSt`), so the backend's cache keeps it, by its
-- version (heff.build.backcache): a definition's is given, what it is
-- made of in the core, hashed; a copy's (`copyVer`) is its name and the
-- versions of the definition copied and of the globals in the arguments
-- it is made for.  A copy is asked for as the cache keeps it, if it
-- keeps it at that version -- what it is known by not found again --
-- and made as the cache keeps it, if it keeps that too, the copies it
-- asked for as it was made asked for.

-- (the cache's knowledge, changed by `f`)
keepWith : (Keep -> Keep) -> M Unit
keepWith f = \s -> MkPair MkUnit (withKp (f s.kp) s)

touchedTo : List String -> Keep -> Keep
touchedTo t k =
  { vers = k.vers
  , kept = k.kept
  , touched = t
  , fresh = k.fresh
  , madeFresh = k.madeFresh
  }

verTo : String -> String -> Keep -> Keep
verTo h v k =
  { vers = Map.insert k.vers h v
  , kept = k.kept
  , touched = k.touched
  , fresh = k.fresh
  , madeFresh = k.madeFresh
  }

freshTo : String -> Keep -> Keep
freshTo h k =
  { vers = k.vers
  , kept = k.kept
  , touched = k.touched
  , fresh = Map.insert k.fresh h MkUnit
  , madeFresh = k.madeFresh
  }

madeFreshTo : String -> List String -> Keep -> Keep
madeFreshTo h t k =
  { vers = k.vers
  , kept = k.kept
  , touched = k.touched
  , fresh = k.fresh
  , madeFresh = Map.insert k.madeFresh h t
  }

getTouched : M (List String)
getTouched = \s -> MkPair s.kp.touched s

-- | the copy `h`, of version `v`, asked for by what is being simplified
touch : String -> String -> M Unit
touch h v = keepWith (\k -> touchedTo (Cons h k.touched) (verTo h v k))

consVer : String -> Maybe (List String) -> Maybe (List String)
consVer v (Just vs) = Just (Cons v vs)
consVer v Nothing = Nothing

-- (each version, if every one is known)
versAll : List (Maybe String) -> Maybe (List String)
versAll Nil = Just Nil
versAll (Cons (Just v) rest) =
  if strEq v "" then Nothing else consVer v (versAll rest)
versAll (Cons Nothing rest) = Nothing

verFrom : String -> Maybe (List String) -> String
verFrom h (Just vs) = IRText.hashOf (Cons (HS h) (List.map (\v -> HS v) vs))
verFrom h Nothing = ""

-- | the version of the copy `h` of `g` made for `args`: none (`""`)
-- | if any of them has none
copyVer : Map.Map String String -> String -> String -> List IR.Expr -> String
copyVer vers h g args =
  verFrom
    h
    (versAll
       (List.map
          (\k -> Map.lookup vers k)
          (Cons g (List.concatMap IR.globalsIn args))))

keptIf : String -> Maybe KeptCopy -> Maybe KeptCopy
keptIf v (Just kc) =
  if strEq kc.ver v && not (strEq v "") then Just kc else Nothing
keptIf v Nothing = Nothing

-- | the copy `h` as the cache keeps it, if it keeps it at the version
-- | it has here
keptAt : St -> String -> Maybe KeptCopy
keptAt s h = case Map.lookup s.kp.vers h of
  Just v -> keptIf v (Map.lookup s.kp.kept h)
  Nothing -> Nothing

markSafeAs : Bool -> String -> M Unit
markSafeAs True h = \s -> MkPair MkUnit (withSafe h (withBase h s))
markSafeAs False h = pure MkUnit

askKept : String -> KeptCopy -> Maybe IR.Expr -> M Bool
askKept h kc (Just b) = do
  b1 <- copy b
  u <- askedFor h b1 kc.depth
  u2 <- markSafeAs kc.safe h
  pure True
askKept h kc Nothing = pure False

-- | the copy `h` asked for as the cache keeps it, if it does
fromKept : String -> M Bool
fromKept h = do
  s <- get
  case keptAt s h of
    Just kc -> askKept h kc (kc.recipe MkUnit)
    Nothing -> pure False

-- | the copy `h`, of version `v`, asked for if it is not yet: as the
-- | cache keeps it (`False`: it does not)
keptAsk : String -> String -> M Bool
keptAsk h v = do
  s <- get
  if Map.member s.sp.recipes h then pure True
  else do
    u <- keepWith (verTo h v)
    fromKept h

-- | ... each
allAsked : List (Pair String String) -> M Bool
allAsked Nil = pure True
allAsked (Cons (MkPair h v) rest) = do
  ok <- keptAsk h v
  if ok then allAsked rest else pure False

madeKept : KeptMade -> Maybe IR.Expr -> M (Maybe IR.Expr)
madeKept km (Just b) = do
  ok <- allAsked km.touched
  if ok
  then do
    b1 <- copy b
    pure (Just b1)
  else pure Nothing
madeKept km Nothing = pure Nothing

keptMadeOf : Maybe KeptCopy -> M (Maybe IR.Expr)
keptMadeOf (Just kc) = case kc.made of
  Just km -> madeKept km (km.body MkUnit)
  Nothing -> pure Nothing
keptMadeOf Nothing = pure Nothing

-- | the copy `h` made, as the cache keeps it, if it does: the copies it
-- | asked for as it was made asked for
keptMade : String -> M (Maybe IR.Expr)
keptMade h = do
  s <- get
  keptMadeOf (keptAt s h)

-- | what a copy asked for is known by: what it is as asked for (`b0`),
-- | simplified as a definition is but with no copy asked for in it --
-- | its calls of itself, the definitions it is made with inlined, seen
-- | -- so that it is the same whoever asks for it, and whatever was
-- | made before
knowing : SK -> IR.Expr -> M IR.Expr
knowing r b0 = do
  saved <- get
  u <- ownSt
  u1 <- setOff True
  b1 <- r.simp b0
  b2 <- r.simp b1
  b3 <- raise b2
  u2 <- backTo saved
  pure b3

-- | the copy named `h` asked for: if it was not before, what it is
-- | known by kept (to make it from, too) -- as the cache keeps it, if it
-- | does
ask : SK
    -> String
    -> List String
    -> IR.Expr
    -> List Bool
    -> Shapes
    -> String
    -> Int
    -> M Unit
ask r g xs b marks sh h d = do
  s <- get
  u0 <- touch h (copyVer s.kp.vers h g (markedOf marks sh.args))
  if Map.member s.sp.recipes h then pure MkUnit
  else do
    hit <- fromKept h
    if hit then pure MkUnit
    else do
      lam1 <- copy (ELam xs b)
      b0 <- specBody g h marks sh lam1
      b1 <- knowing r b0
      u <- askedFor h b1 d
      u2 <- keepWith (freshTo h)
      markCopySafe h b1

-- (... named `h`, `d` deep in copies of copies)
specNamed : SK
          -> String
          -> List String
          -> IR.Expr
          -> List IR.Expr
          -> List Bool
          -> Shapes
          -> String
          -> Int
          -> M IR.Expr
specNamed r g xs b argv marks sh h d =
  if d > specDepth then pure (mkApp (EGlobal g) argv)
  else do
    u <- ask r g xs b marks sh h d
    -- (the copy called, and a copy of it asked for if it may be, for
    -- what it takes now)
    r.applyTo (EGlobal h) (appendL sh.holes (Spec.dropAt marks argv))

-- (a copy that would take nothing but the literals of what it is made
-- for is not made: what it computes, once, would be computed at each
-- call)
specShaped : SK
           -> String
           -> List String
           -> IR.Expr
           -> List IR.Expr
           -> List Bool
           -> Shapes
           -> M IR.Expr
specShaped r g xs b argv marks sh = \s ->
    if List.null (keepParams marks xs) && not (List.null sh.vars)
    then MkPair (mkApp (EGlobal g) argv) s
    else specNamed
        r
        g
        xs
        b
        argv
        marks
        sh
        (Spec.copyName g (specKey g marks sh.vars sh.args))
        (depthOf s.sp.depths g (markedOf marks sh.args))
        s

specMarked : SK
           -> String
           -> List String
           -> IR.Expr
           -> List IR.Expr
           -> List Bool
           -> M IR.Expr
specMarked r g xs b argv marks =
  if not (List.any (\m -> m) marks)
     -- (a copy taking nothing is a value: calling itself, only where that
     -- is under a lambda -- a knot of judgments, `uk w ms uf` -- not one
     -- computed by itself)
     || (List.null (keepParams marks xs)
         && elemStr g (IR.globalsIn b)
         && not (IR.isValue b))
  then pure (mkApp (EGlobal g) argv)
  else do
    sh <- shapesOf marks argv
    specShaped r g xs b argv marks sh

-- (the marks, and those of the arguments made lambdas, as many as the
-- marks)
orMarks : List Bool -> List Bool -> List Bool
orMarks (Cons m ms) (Cons n ns) = Cons (m || n) (orMarks ms ns)
orMarks ms _ = ms

-- (an argument known besides `knownArg`'s: a continuation back into a
-- loop (`backFor`), a handler built by a global (`builtBy`))
knownMore : St -> List IR.Expr -> String -> IR.Expr -> Bool
knownMore s argv g e = builtBy s.sp.all e || backFor s argv g e

-- (... the arguments `made` lambdas of partial applications known too)
specKnown : SK
          -> String
          -> List String
          -> IR.Expr
          -> List IR.Expr
          -> List Bool
          -> M IR.Expr
specKnown r g xs b argv made = do
  s <- get
  if not
       (anyKnown s.sp.kinds (knownMore s argv g) g b argv
        || List.any (\m -> m) made)
  then pure (mkApp (EGlobal g) argv)
  else specMarked
      r
      g
      xs
      b
      argv
      (orMarks (marksOf s.sp.kinds (knownMore s argv g) g xs b argv) made)

-- Partial applications given to a loop: a known function given fewer
-- arguments than it takes, `scale f`, handed to a loop at a parameter it
-- hands on unchanged, `List.map (scale (factor p)) ss`, is the lambda it
-- comes to, `\x -> scale t x` with `scale` inlined, its arguments that
-- compute bound first (`t = factor p`): a lambda capturing `t` that the
-- loop may be given a copy for (`capturing`), which computes it at each
-- round, no closure called.  Only where every argument before those
-- bound first cannot fail, so that what is bound first is computed as it
-- was.

-- | how many more arguments than it is given a known function takes,
-- | where it is one not inlined because it is given too few
missingOf : St -> IR.Expr -> Int
missingOf s (EApp (EGlobal h) bs) = moreThan s.defs h bs
missingOf s e = 0

type Eta = Maybe (Pair (List (Pair String IR.Expr)) IR.Expr)

-- | a lambda a partial application comes to that a copy may be made
-- | for: one that calls nothing (`capturing`), or the function once
-- | (`\x -> scale t x`, `Spec.callsOnce`), which costs what calling the
-- | closure of the partial application would, the call made at once
etaCapturing : IR.Expr -> Bool
etaCapturing (ELam xs b) =
  capturing (ELam xs b)
  || (not (IR.sizeAbove specArgSize (ELam xs b)) && Spec.callsOnce (ELam xs b))
etaCapturing _ = False

-- (... kept if it comes to a lambda a copy may be made for)
etaKept : St -> Bound -> IR.Expr -> M Eta
etaKept saved (MkPair bds _) lam1 = do
  st <- get
  if etaCapturing lam1 then pure (Just (MkPair bds lam1))
  else do
    u <- put (restore saved st)
    pure Nothing

-- (a partial application, missing `k` arguments, as the lambda it comes
-- to)
etaOne : SK -> IR.Expr -> Int -> M Eta
etaOne r (EApp h bs) k = do
  saved <- get
  bound <- bindArgs bs
  ys <- freshParams k
  body <- r.applyTo h (appendL (snd bound) (List.map (\y -> EVar y) ys))
  etaKept saved bound (ELam ys body)
etaOne r e k = pure Nothing

etaCons : IR.Expr -> Eta -> Bound -> Bound
etaCons a (Just (MkPair bds lam1)) (MkPair rest argv) =
  MkPair (appendL bds rest) (Cons lam1 argv)
etaCons a Nothing (MkPair rest argv) = MkPair rest (Cons a argv)

etaAt : SK -> Bool -> IR.Expr -> Int -> M Eta
etaAt r True a k = if k > 0 then etaOne r a k else pure Nothing
etaAt r False a k = pure Nothing

-- (each argument at a parameter handed on unchanged that is a partial
-- application, made a lambda if it may be)
-- (an argument's bindings, `let t = factor p in \x -> ...` as the
-- inliner leaves a partial application it inlined: bound first, and what
-- is left)
consLet : String
        -> IR.Expr
        -> Pair (List (Pair String IR.Expr)) IR.Expr
        -> Pair (List (Pair String IR.Expr)) IR.Expr
consLet x a (MkPair bds e) = MkPair (Cons (MkPair x a) bds) e

letsOut : IR.Expr -> Pair (List (Pair String IR.Expr)) IR.Expr
letsOut (ELet x a e) = consLet x a (letsOut e)
letsOut e = MkPair Nil e

withLets : List (Pair String IR.Expr) -> Bound -> Bound
withLets bds (MkPair rest argv) = MkPair (appendL bds rest) argv

etaArg : SK -> Bool -> IR.Expr -> Bound -> M Bound
etaArg r st a rest = do
  s <- get
  e <- etaAt r st a (missingOf s a)
  pure (etaCons a e rest)

etaLets : SK
        -> Bool
        -> Pair (List (Pair String IR.Expr)) IR.Expr
        -> Bound
        -> M Bound
etaLets r True (MkPair bds a) rest = do
  e <- etaArg r True a rest
  pure (withLets bds e)
etaLets r False (MkPair bds a) rest =
  pure (MkPair (fst rest) (Cons (letsOf bds a) (snd rest)))

etaArgs : SK -> List Bool -> List IR.Expr -> M Bound
etaArgs r (Cons st sts) (Cons a argv) = do
  rest <- etaArgs r sts argv
  etaLets r st (letsOut a) rest
etaArgs r _ argv = pure (MkPair Nil argv)

-- (an argument that cannot fail, its bindings too)
argPure : IR.Expr -> M Bool
argPure (ELet x a e) = do
  p <- isPure a
  if p then argPure e else pure False
argPure a = isPure a

allPure : List IR.Expr -> M Bool
allPure Nil = pure True
allPure (Cons a argv) = do
  p <- argPure a
  if p then allPure argv else pure False

-- (a partial application, or a lambda a copy may be made for under
-- bindings, `let t = ... in \x -> ...`: what is made a lambda, its
-- bindings first)
etaWanted : St -> IR.Expr -> Bool
etaWanted s (ELet x a e) =
  capturing (snd (letsOut e)) || missingOf s (snd (letsOut e)) > 0
etaWanted s a = missingOf s a > 0

-- (... where `g` is a loop, every argument cannot fail)
etaLoop : SK
        -> String
        -> List String
        -> IR.Expr
        -> List IR.Expr
        -> Bool
        -> M Bound
etaLoop r g xs b argv True =
  if loops g b then etaArgs r (Spec.statics g xs b) argv
  else pure (MkPair Nil argv)
etaLoop r g xs b argv False = pure (MkPair Nil argv)

-- (an argument whose bindings may be computed first)
movesFirst : St -> IR.Expr -> Bool
movesFirst s (ELet _ _ _) = True
movesFirst s a = etaWanted s a

-- (the arguments before the last whose bindings may be computed first:
-- those they are put before)
beforeMoved : St -> List IR.Expr -> List IR.Expr
beforeMoved s Nil = Nil
beforeMoved s (Cons a argv) =
  if List.any (movesFirst s) argv then Cons a (beforeMoved s argv) else Nil

etaFor : SK -> String -> List String -> IR.Expr -> List IR.Expr -> M Bound
etaFor r g xs b argv = do
  s <- get
  if List.any (etaWanted s) argv
  then do
    p <- allPure (beforeMoved s argv)
    etaLoop r g xs b argv p
  else pure (MkPair Nil argv)

isLambda : IR.Expr -> Bool
isLambda (ELam _ _) = True
isLambda _ = False

-- (an argument made a lambda (`etaFor`): it was not one, under its
-- bindings)
etaMade : IR.Expr -> IR.Expr -> Bool
etaMade a (ELam _ _) = not (isLambda (snd (letsOut a)))
etaMade a e = False

specBound : SK
          -> String
          -> List String
          -> IR.Expr
          -> List IR.Expr
          -> Bound
          -> M IR.Expr
specBound r g xs b as0 (MkPair bds argv) = do
  e <- specKnown r g xs b argv (List.zipWith etaMade as0 argv)
  pure (letsOf bds e)

specLam : SK -> String -> List String -> IR.Expr -> List IR.Expr -> M IR.Expr
specLam r g xs b argv = do
  s <- get
  if s.sp.off || s.sp.count >= specLimit then pure (mkApp (EGlobal g) argv)
  else do
    bound <- etaFor r g xs b argv
    specBound r g xs b argv bound

-- | a call of a definition not inlined: of a copy of it, if one may be
-- | made
trySpec : SK -> String -> List IR.Expr -> M IR.Expr
trySpec r g argv = do
  s <- get
  case Map.lookup s.sp.all g of
    Just (ELam xs b) -> specLam r g xs b argv
    _ -> pure (mkApp (EGlobal g) argv)

-- | whether it is still the call of `g` it was
stillCall : String -> IR.Expr -> Bool
stillCall g (EApp (EGlobal h) _) = strEq g h
stillCall g _ = False

specAfter : SK -> String -> List IR.Expr -> IR.Expr -> M IR.Expr
specAfter r g argv e = if stillCall g e then trySpec r g argv else pure e

fieldIn : String -> List (Pair String IR.Expr) -> Maybe IR.Expr
fieldIn l Nil = Nothing
fieldIn l (Cons (MkPair k v) rest) =
  if strEq k l then Just v else fieldIn l rest

-- | a field of a record that is a definition calling itself (one of
-- | knotted judgments, `sk.simp`): a copy of it, if it is a value
knownField : String -> String -> M (Maybe IR.Expr)
knownField g l = do
  s <- get
  case Map.lookup s.sp.all g of
    Just (ERecord fs _) -> case fieldIn l fs of
      Just v ->
        if IR.isValue v && s.fuel > 0
        then do
          u <- put (withFuel (s.fuel - 1) s)
          e <- copy v
          pure (Just e)
        else pure Nothing
      Nothing -> pure Nothing
    _ -> pure Nothing

-- (an argument that may go into every arm of a match it is given to)
pushable : IR.Expr -> Bool
pushable a = atomic a || (IR.isValue a && (closedKnown a || handlerLike a))

-- | how big the copies the arms of a match are given may be, all told
pushBudget : Int
pushBudget = 120

-- (the size of what is not atomic among them)
copiedSize : List IR.Expr -> Int
copiedSize argv =
  List.foldl (\n a -> if atomic a then n else n + IR.size a) 0 argv

-- (the arguments may go into every arm: atomic, or closed values whose
-- copies, one for each arm but the first, are not too big)
pushInto : List IR.Arm -> List IR.Expr -> Bool
pushInto arms argv =
  IR.allI (List.map pushable argv)
  && copiedSize argv * (List.length arms - 1) <= pushBudget

-- (an arm given the arguments: a copy of each that is not atomic)
applyArm : SK -> IR.Expr -> List IR.Expr -> M IR.Expr
applyArm r b argv = do
  as2 <- traverseS (\a -> if atomic a then pure a else copy a) argv
  r.applyTo b as2

-- (a handler among values given to a match -- an operation or `pure`,
-- `if c then tell x else pure MkUnit`, given its handler and what
-- follows -- that may go into every arm, the others bound first)
handlerPushed : List IR.Arm -> List IR.Expr -> Bool
handlerPushed arms argv =
  IR.allI (List.map IR.isValue argv)
  && List.any handlerLike argv
  && pushInto arms (List.keepIf pushable argv)

bindPushable : List IR.Expr -> M Bound
bindPushable Nil = pure (MkPair Nil Nil)
bindPushable (Cons a argv) = do
  one <- splitOne (pushable a) a
  rest <- bindPushable argv
  pure (consBound one rest)

-- (... the values that may not go into every arm bound before it: values,
-- so computed as they were)
pushBound : SK -> IR.Expr -> List IR.Arm -> List IR.Expr -> M IR.Expr
pushBound r s arms argv = do
  bound <- bindPushable argv
  arms' <- armsS (\b -> applyArm r b (snd bound)) arms
  pure (letsOf (fst bound) (EMatch s arms'))

-- What follows a choice of computations: `if c then tell x else pure
-- MkUnit`, then more, given a known handler -- the match given the
-- handler and what follows, `\x -> ...`, a function no arm may have a
-- copy of.  Each arm is given the handler and a name for what follows,
-- `k`; where each way out then comes to `k` called with as many values,
-- and `k` is nowhere else, those values are set, and what follows is
-- called once after the match, with them.  No function is bound for the
-- arms to call.  Otherwise the application is as it was.

-- (each way out a call of `k` given `n` values: those values)
valuesCalled : String -> Int -> IR.Expr -> Maybe IR.Expr
valuesCalled k n (ELet y v b) =
  maybe Nothing (\b2 -> Just (ELet y v b2)) (valuesCalled k n b)
valuesCalled k n (ESet ys v b) =
  maybe Nothing (\b2 -> Just (ESet ys v b2)) (valuesCalled k n b)
valuesCalled k n (EMatch s arms) =
  maybe
    Nothing
    (\bs ->
       Just
         (EMatch
            s
            (List.zipWith
               (\a b2 -> MkArm (IR.armTag a) (IR.armVars a) b2)
               arms
               bs)))
    (allJust (List.map (\a -> valuesCalled k n (IR.armBody a)) arms))
valuesCalled k n EAbandon = Just EAbandon
valuesCalled k n (EApp (EVar k2) argv) =
  if strEq k k2 && List.length argv == n then Just (EValues argv) else Nothing
valuesCalled k n e = Nothing

-- (how many values the first way out gives `k`)
firstCalled : String -> IR.Expr -> Int
firstCalled k (ELet _ _ b) = firstCalled k b
firstCalled k (ESet _ _ b) = firstCalled k b
firstCalled k (EMatch _ (Cons a _)) = firstCalled k (IR.armBody a)
firstCalled k (EApp (EVar k2) argv) = if strEq k k2 then List.length argv else 0
firstCalled k e = 0

consFollowed : IR.Expr
             -> Maybe (Pair (List IR.Expr) IR.Expr)
             -> Maybe (Pair (List IR.Expr) IR.Expr)
consFollowed a (Just (MkPair argv f)) = Just (MkPair (Cons a argv) f)
consFollowed a Nothing = Nothing

-- (the arguments, what follows among them -- the one that may not go
-- into every arm, a function -- named `k`; and what follows)
followerNamed : String
              -> List IR.Expr
              -> Maybe (Pair (List IR.Expr) IR.Expr)
followerNamed k Nil = Nothing
followerNamed k (Cons (ELam xs b) rest) =
  if pushable (ELam xs b) then consFollowed (ELam xs b) (followerNamed k rest)
  else if IR.allI (List.map pushable rest)
  then Just (MkPair (Cons (EVar k) rest) (ELam xs b))
  else Nothing
followerNamed k (Cons a rest) =
  if pushable a then consFollowed a (followerNamed k rest) else Nothing

freshNames : String -> Int -> M (List String)
freshNames base n =
  if n <= 0 then pure Nil
  else do
    x <- freshName base
    xs <- freshNames base (n - 1)
    pure (Cons x xs)

-- (... where they do not all come to `k` -- a way that goes on no more,
-- `stop`'s, among those that do -- what follows put where `k` is, a
-- copy each time, if the code grows by no more than a function bound
-- and handed a handler may: each copy is given what its way gives it,
-- a tag known.  Otherwise `orig`)
followerCopied : SK
               -> St
               -> IR.Expr
               -> String
               -> IR.Expr
               -> IR.Expr
               -> M IR.Expr
followerCopied r saved orig k f m = do
  m2 <- substCopies k f m
  e <- r.simp m2
  if not (IR.sizeAbove (IR.size orig + handedSize) e) then pure e
  else do
    st <- get
    u <- put (restore saved st)
    pure orig

-- (the arms given the handler and `k`: the values set, then what
-- follows -- or, where they do not all come to `k`, what follows copied)
followerSet : SK
            -> IR.Expr
            -> String
            -> IR.Expr
            -> IR.Expr
            -> List IR.Arm
            -> List IR.Expr
            -> M IR.Expr
followerSet r orig k f s arms argv = do
  saved <- get
  arms2 <- armsS (\b -> applyArm r b argv) arms
  let m : IR.Expr = EMatch s arms2
  let n : Int = firstCalled k m
  case valuesCalled k n m of
    Just m2 ->
      if n > 0 && occCountOf k m2 == 0
      then do
        xs <- freshNames "v" n
        body <- r.applyTo f (List.map (\x -> EVar x) xs)
        pure (ESet xs m2 body)
      else followerCopied r saved orig k f m
    Nothing -> followerCopied r saved orig k f m

-- | A match given a handler -- a global, the next layer's -- and
-- | values among which one computes (a layer's state, `s + v`): a
-- | choice of computations, `if i < n then step i else pure acc`, run
-- | by that layer.  What computes is bound first, if it cannot fail, and
-- | the rest goes into every arm, so that each way out is a call given
-- | the handler: a call of a copy that loops, which is made again for
-- | that handler (`specKnown`).  Otherwise `orig`
boundPushed : SK
            -> IR.Expr
            -> IR.Expr
            -> List IR.Arm
            -> List IR.Expr
            -> M IR.Expr
boundPushed r orig s arms argv = do
  st <- get
  if List.any (handlerArg st.sp.kinds) argv
     && pushInto arms (List.keepIf pushable argv)
  then do
    p <- allPure argv
    if p then pushBound r s arms argv else pure orig
  else pure orig

-- (a match given a known handler and what follows)
followerPushed : SK -> IR.Expr -> List IR.Arm -> List IR.Expr -> M IR.Expr
followerPushed r s arms argv = do
  st <- get
  k <- freshName "k"
  let orig : IR.Expr = mkApp (EMatch s arms) argv
  case followerNamed k argv of
    Just (MkPair argv2 f) ->
      if List.any (handlerArg st.sp.kinds) argv2
         && pushInto arms (List.keepIf (\a -> not (isVar k a)) argv2)
      then followerSet r orig k f s arms argv2
      else pure orig
    Nothing -> boundPushed r orig s arms argv

-- (a field of a copy that is a record -- a handler made for its algebra,
-- `passing writer W3 alg` -- handed on with a handler: `handle hd c`'s
-- `hd.ret`, a closed function a copy may be made for)
handedField : St -> IR.Expr -> M IR.Expr
handedField s (EProj (EGlobal g) l sh t) =
  if Map.member s.defs g then pure (EProj (EGlobal g) l sh t)
  else do
    mv <- knownField g l
    pure (closedField (EProj (EGlobal g) l sh t) mv)
handedField s a = pure a

copyField : IR.Expr -> Bool
copyField (EProj (EGlobal _) _ _ _) = True
copyField _ = False

handedFields : St -> List IR.Expr -> M (List IR.Expr)
handedFields s argv =
  if List.any copyField argv && List.any (handlerArg s.sp.kinds) argv
  then traverseS (handedField s) argv
  else pure argv

-- (that field of what `g` is, its parameters given the arguments)
builtFieldOf : String -> List IR.Expr -> Maybe IR.Expr -> Maybe IR.Expr
builtFieldOf l argv (Just (ELam xs (ERecord fs _))) =
  maybe Nothing (\v -> Just (letsOf (zipL xs argv) v)) (fieldIn l fs)
builtFieldOf l argv _ = Nothing

-- | a field of a handler built by a global (`builtBy`), `(g as).l`: that
-- | field of a copy of `g`'s body, its parameters given `as` (variables
-- | or literals: nothing computed twice).  The other fields are
-- | functions, built for nothing
builtField : String -> IR.Expr -> M (Maybe IR.Expr)
builtField l (EApp (EGlobal g) argv) = do
  s <- get
  mb <- fueled (Map.lookup s.sp.all g)
  pure (builtFieldOf l argv mb)
builtField l e = pure Nothing

-- (... simplified, or `orig`)
builtProj : SK -> IR.Expr -> String -> IR.Expr -> M IR.Expr
builtProj r orig l e = do
  mv <- builtField l e
  case mv of
    Just v -> r.simp v
    Nothing -> pure orig

-- (... applied: judged by what the application comes to, as a known
-- global handler's field is)
builtApplied : SK -> IR.Expr -> String -> IR.Expr -> List IR.Expr -> M IR.Expr
builtApplied r f l e argv = do
  mv <- builtField l e
  case mv of
    Just v -> do
      h <- r.simp v
      r.applyTo (prunedCopy h argv) argv
    Nothing -> pure (mkApp f argv)

-- | an application of simplified parts
applyToF : SK -> IR.Expr -> List IR.Expr -> M IR.Expr
applyToF r f argv =
  if List.length argv == 0 then pure f
  else case f of
    EPrim p -> pure (mkApp f argv)
    EApp g bs -> r.applyTo g (appendL bs argv)
    -- (another name for a tag, given all its arguments: the tag given
    -- them, with no bindings between -- the tag computes its fields in
    -- order, as the bindings would, and a call in a field stays where
    -- a loop can build the value)
    ELam xs (ETag t es ts) ->
      if List.length xs == List.length argv && varsAre xs es
      then pure (ETag t argv ts)
      else applyLam r xs (ETag t es ts) argv
    ELam xs b -> applyLam r xs b argv
    ELet x a b -> do
      b' <- r.applyTo b argv
      pure (ELet x a b')
    ESet xs a b -> do
      b' <- r.applyTo b argv
      pure (ESet xs a b')
    -- (the arguments go into every arm: only when that copies nothing
    -- but what a copy may be made for, a closed value -- a handler,
    -- which every arm is then made with)
    EMatch s arms ->
      if pushInto arms argv
      then do
        arms' <- armsS (\b -> applyArm r b argv) arms
        pure (EMatch s arms')
      else if handlerPushed arms argv
      then pushBound r s arms argv
      else followerPushed r s arms argv
    EGlobal g -> do
      s <- get
      as1 <- handedFields s argv
      e1 <- callOf r f g as1 (Map.lookup s.defs g)
      specAfter r g as1 e1
    -- (a field of a known record, applied: judged by what the
    -- application comes to, not by the size of the field -- a handler's
    -- clause given an operation by the arm it chooses, as a copy's is)
    EProj (EGlobal g) l sh t -> do
      mb <- known g
      case mb of
        Just b ->
          attemptBy (clauseBudget argv) (mkApp f argv) (do
          h <- r.project l sh t b
          r.applyTo (prunedCopy h argv) argv)
        Nothing -> do
          mv <- knownField g l
          case mv of
            Just v ->
              attemptBy (clauseBudget argv) (mkApp f argv) (r.applyTo v argv)
            Nothing -> pure (mkApp f argv)
    -- (... and of a handler built by a global, the same way)
    EProj (EApp (EGlobal g) bs) l sh t -> do
      s <- get
      if builtBy s.sp.all (EApp (EGlobal g) bs)
      then attemptBy
          (clauseBudget argv)
          (mkApp f argv)
          (builtApplied r f l (EApp (EGlobal g) bs) argv)
      else pure (mkApp f argv)
    _ -> pure (mkApp f argv)

findField : String -> List (Pair String IR.Expr) -> Maybe IR.Expr
findField l Nil = Nothing
findField l (Cons (MkPair k v) rest) =
  if strEq k l then Just v else findField l rest

-- (the other fields are computed too: dropped only if they cannot fail)
othersPure : String -> List (Pair String IR.Expr) -> M Bool
othersPure l Nil = pure True
othersPure l (Cons (MkPair k f) rest) =
  if strEq k l then othersPure l rest
  else do
    p <- isPure f
    if p then othersPure l rest else pure False

projectF : SK -> String -> List String -> IR.FieldTy -> IR.Expr -> M IR.Expr
projectF r l sh t (ERecord fs ts) = case findField l fs of
  Just v -> do
    others <- othersPure l fs
    pure (if others then v else EProj (ERecord fs ts) l sh t)
  Nothing -> pure (EProj (ERecord fs ts) l sh t)
projectF r l sh t (ELet x a b) = do
  b' <- r.project l sh t b
  pure (ELet x a b')
projectF r l sh t (ESet xs a b) = do
  b' <- r.project l sh t b
  pure (ESet xs a b')
projectF r l sh t e@(EGlobal g) = do
  mb <- known g
  case mb of
    Just b -> attempt (EProj e l sh t) (r.project l sh t b)
    Nothing -> pure (EProj e l sh t)
projectF r l sh t e@(EApp (EGlobal g) argv) = do
  s <- get
  if builtBy s.sp.all e
  then attempt (EProj e l sh t) (builtProj r (EProj e l sh t) l e)
  else pure (EProj e l sh t)
projectF r l sh t e = pure (EProj e l sh t)

-- Case of case
--------------------------------------------------------------------------------

-- A match on a match, `case (case a of True -> b; False -> False) of ...`
-- (`&&`, inlined), is the inner match with the outer one in each arm:
-- where an arm is a tag, the outer match chooses at once.  An outer
-- arm goes to the inner ways out that choose its tag: copied where
-- more than one does, so only when it is small; moved where one does.

-- | how big the outer arms copied may be, times the copies
caseBudget : Int
caseBudget = 40

armsOf : IR.Expr -> List IR.Arm
armsOf (EMatch _ arms) = arms
armsOf _ = Nil

-- (an inner arm, a copy of the outer match in it)
pushArm : SK -> List IR.Arm -> IR.Arm -> M IR.Arm
pushArm r arms (MkArm t vs b) = do
  outer <- copy (EMatch EAbandon arms)
  b' <- r.match b (armsOf outer)
  pure (MkArm t vs b')

-- | a match on a match, `case (if c then Just x else Nothing) of ...`
-- | (a loop's step): the outer match given to the ways out of the
-- | inner, where each chooses at once and no tag is built -- where its
-- | arms are copied no more than the budget allows, which is not at all
-- | where each tag is chosen by one way out (`armsPushable`)
caseOfCase : SK -> IR.Expr -> List IR.Arm -> List IR.Arm -> M IR.Expr
caseOfCase r s2 arms2 arms =
  if armsPushable caseBudget (EMatch s2 arms2) arms
  then do
    arms2' <- traverseS (pushArm r arms) arms2
    pure (EMatch s2 arms2')
  else do
    g <- freshName "given"
    pure
        (fromMaybe
           (EMatch (EMatch s2 arms2) arms)
           (givenSet g (EMatch s2 arms2) (EMatch (EVar g) arms)))

-- (a match not an `if` on a condition)
matchOn : SK -> IR.Expr -> List IR.Arm -> M IR.Expr
matchOn r (EMatch s2 arms2) arms = caseOfCase r s2 arms2 arms
matchOn r s@(ETag t argv _) arms = case findArm t arms of
  Just (MkArm _ vs b) -> r.simp (letsOf (zipL vs argv) b)
  Nothing -> pure (EMatch s arms)
matchOn r (ELet x a b) arms = do
  b' <- r.match b arms
  pure (ELet x a b')
matchOn r (ESet xs a b) arms = do
  b' <- r.match b arms
  pure (ESet xs a b')
matchOn r s@(EGlobal g) arms = do
  mb <- known g
  case mb of
    Just (ETag t2 as2 ts2) ->
      if IR.keepsValue (ETag t2 as2 ts2) then pure (EMatch s arms)
      else r.match (ETag t2 as2 ts2) arms
    _ -> pure (EMatch s arms)
matchOn r s arms = pure (EMatch s arms)

-- (whether a field is given back as the arm bound it)
sameField : Pair String IR.Expr -> Bool
sameField (MkPair v (EVar y)) = strEq v y && not (strEq v "_")
sameField p = False

-- (whether an arm gives back what it matched: its tag built again of its
-- fields as they are, or the scrutinee itself)
givesItBack : IR.Expr -> IR.Arm -> Bool
givesItBack s (MkArm t vs (ETag t2 argv _)) =
  strEq t t2
  && List.length vs == List.length argv
  && List.all sameField (zipL vs argv)
givesItBack (EVar x) (MkArm _ _ (EVar y)) = strEq x y
givesItBack s a = False

-- | a match each arm of which gives back what it matched -- an `hmap`
-- | of a known effect, each operation built again as it was -- is its
-- | scrutinee (every match is of every tag, E0317)
-- | >>> isIdentity (EVar "p") [MkArm "Get" ["k"] (ETag "Get" [EVar "k"] [FtAny]), MkArm "Put" ["s", "x"] (ETag "Put" [EVar "s", EVar "x"] [FtAny, FtAny])]
-- | True
-- | >>> isIdentity (EVar "p") [MkArm "Get" ["k"] (ETag "Put" [EVar "k"] [FtAny])]
-- | False
isIdentity : IR.Expr -> List IR.Arm -> Bool
isIdentity s arms = not (List.null arms) && List.all (givesItBack s) arms

-- | a match: one giving back what it matched is its scrutinee; an `if`
-- | whose arms are `Bool`s a condition is made of is a condition (`&&`,
-- | `||`, `not`); any other `if` is on its scrutinee as a condition (a
-- | comparison computes no `Bool` to be matched on)
matchF : SK -> IR.Expr -> List IR.Arm -> M IR.Expr
matchF r s arms =
  if isIdentity s arms then pure s
  else case IR.boolArms arms of
    Just (MkPair t f) ->
      if IR.boolShaped t f
      then pure
          (IR.boolOf
             (foldCond (IR.condIf (IR.condOf s) (IR.condOf t) (IR.condOf f))))
      else matchOn r (IR.boolOf (foldCond (IR.condOf s))) arms
    Nothing -> matchOn r s arms

sk : SK
sk =
  { simp = \e -> simpF sk e
  , applyTo = \f argv -> applyToF sk f argv
  , project = \l sh t e -> projectF sk l sh t e
  , match = \s arms -> matchF sk s arms
  }

recordAll : String -> IR.Expr -> St -> St
recordAll key b s =
  withSp
    { all =
        if not (IR.sizeAbove specBodySize b)
        then Map.insert s.sp.all key b
        else s.sp.all
    , kinds =
        if isKind b then Map.insert s.sp.kinds key MkUnit
        else s.sp.kinds
    , recipes = s.sp.recipes
    , depths = s.sp.depths
    , made = s.sp.made
    , count = s.sp.count
    , off = s.sp.off
    }
    s

recordDef : String -> IR.Expr -> M Unit
recordDef key b = \s ->
    -- a definition calling itself is never inlined
    MkPair
      MkUnit
      (recordAll
         key
         b
         (if elemStr key (IR.globalsIn b) then s
          else withDefs (Map.insert s.defs key b) s))

-- | the copy named `h` taken as made
madeOne : String -> M Unit
madeOne h = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , recipes = s.sp.recipes
         , depths = s.sp.depths
         , made = Map.insert s.sp.made h MkUnit
         , count = s.sp.count
         , off = s.sp.off
         }
         s)

-- (the copy named `h`, as asked for, if it is not made yet)
pendingOf : St -> String -> Maybe IR.Expr
pendingOf s h =
  if Map.member s.sp.made h then Nothing
  else Map.lookup s.sp.recipes h

-- (a copy made here: simplified as a definition is, from `b0`, what it
-- is known by -- the copies asked for as it is, kept for the cache)
makeFresh : String -> IR.Expr -> M IR.Expr
makeFresh h b0 = do
  outer <- getTouched
  u0 <- keepWith (touchedTo Nil)
  u2 <- ownSt
  b1 <- sk.simp b0
  b2 <- sk.simp b1
  b3 <- raise b2
  t <- getTouched
  u3 <- keepWith (\k -> madeFreshTo h t (touchedTo outer k))
  pure b3

madeBody : String -> IR.Expr -> Maybe IR.Expr -> M IR.Expr
madeBody h b0 (Just b) = pure b
madeBody h b0 Nothing = makeFresh h b0

-- Settling: a copy is known by what it is as asked for (`knowing`, no
-- copy asked for in it), and made with the copies it asks for -- so it
-- may be made to take more than it was known to: `loop`'s copy for an
-- operation's evidence, `\i acc -> ... (\hd k -> ...)` as known, `\i acc
-- hd k -> ...` as made, the evidence's copy of `step` then a function
-- of `hd k` too.  A caller that gives it all of them (`handle hd (loop 0
-- 0)`) only sees that once it is made: so the made copy is what it is
-- known by from then on, and what calls it is simplified again, which
-- may make a copy for what it is given now (the handler).

-- | how many more rounds of that a definition or a copy is given
settleRounds : Int
settleRounds = 5

-- (the arity each global is known by)
aritiesOf : St -> List String -> List Int
aritiesOf s hs = List.map (arityIn s.sp.all) hs

-- (a copy among them now known to take more than it was)
grew : List Int -> List Int -> Bool
grew (Cons a argv) (Cons b bs) = b > a || grew argv bs
grew _ _ = False

-- (a global `b` calls known to take more in `s1` than in `s0`)
grewIn : St -> St -> IR.Expr -> Bool
grewIn s0 s1 b =
  s1.supply /= s0.supply
  && grew (aritiesOf s0 (IR.globalsIn b)) (aritiesOf s1 (IR.globalsIn b))

-- | the copy `h` made to `b`: what it is known by, if that takes more
-- | arguments than what it was known by
knownMade : String -> IR.Expr -> M Unit
knownMade h b = \s ->
    MkPair
      MkUnit
      (if arityIn s.sp.all h < arityIn (singletonM h b) h
          && not (IR.sizeAbove specBodySize b)
       then recordAll h b s
       else s)

-- (a copy made here, simplified again: the copies it asks for so kept
-- with those it asked for before)
makeAgain : String -> IR.Expr -> M IR.Expr
makeAgain h b = do
  outer <- getTouched
  s <- get
  u0 <-
    keepWith
      (touchedTo (fromMaybe Nil (Map.lookup s.kp.madeFresh h)))
  u2 <- ownSt
  b1 <- sk.simp b
  b2 <- raise b1
  t <- getTouched
  u3 <- keepWith (\k -> madeFreshTo h t (touchedTo outer k))
  pure b2

-- (a copy made here, the copies it calls for made, `n` rounds left:
-- simplified again while a copy it calls was made to take more)
settleCopy : (List String -> M (List IR.Def))
           -> Int
           -> String
           -> IR.Expr
           -> M (Pair IR.Expr (List IR.Def))
settleCopy more n h b = do
  s0 <- get
  deps <- more (IR.globalsIn b)
  s1 <- get
  if n > 0 && grewIn s0 s1 b
  then do
    b2 <- makeAgain h b
    rest <- settleCopy more (n - 1) h b2
    pure (MkPair (fst rest) (appendL deps (snd rest)))
  else pure (MkPair b deps)

-- (the copies among `hs` asked for, in front of `t`)
copiesIn : St -> List String -> List String -> List String
copiesIn s hs t =
  List.foldl
    (\acc h -> if Map.member s.sp.recipes h then Cons h acc else acc)
    t
    hs

-- | the copies a definition's body calls, as asked for by it: a body
-- | settled calls copies of what it inlined, which the cache asks for
-- | where it keeps it
refsTouched : IR.Expr -> M Unit
refsTouched b = \s ->
    MkPair
      MkUnit
      (withKp (touchedTo (copiesIn s (IR.globalsIn b) s.kp.touched) s.kp) s)

-- | ... and a copy's made here
refsMade : Maybe IR.Expr -> String -> IR.Expr -> M Unit
refsMade (Just _) h b = pure MkUnit
refsMade Nothing h b = \s ->
    MkPair
      MkUnit
      (withKp
         (madeFreshTo
            h
            (copiesIn
               s
               (IR.globalsIn b)
               (fromMaybe Nil (Map.lookup s.kp.madeFresh h)))
            s.kp)
         s)

-- | ... and again, a copy made here that `h` was put in (Tying the
-- | knot): the copies `h` calls it calls now, which the cache asks for
-- | where it keeps it
refsRetied : String -> IR.Expr -> M Unit
refsRetied k b = \s ->
    MkPair
      MkUnit (case Map.lookup s.kp.madeFresh k of
    Just t -> withKp (madeFreshTo k (copiesIn s (IR.globalsIn b) t) s.kp) s
    Nothing -> s)

-- (as the cache keeps it: made as it was)
settleKept : (List String -> M (List IR.Def))
           -> Maybe IR.Expr
           -> String
           -> IR.Expr
           -> M (Pair IR.Expr (List IR.Def))
settleKept more (Just _) h b = do
  deps <- more (IR.globalsIn b)
  pure (MkPair b deps)
settleKept more Nothing h b = settleCopy more settleRounds h b

-- Tying the knot: a loop's copy for a continuation back into it
-- (Continuations back into a loop) is the loop's copy and a copy of what
-- it calls, each calling the other last -- `loop'` deciding whether to go
-- on, `step'` a round of it.  Two functions calling each other last are
-- made one function, a loop going from one's body to the other's
-- (heff.compile.cycles): so the small one, made, is put where the other
-- calls it, which then calls itself, a loop of one body.

-- (a lambda's body, its parameters bound to the arguments)
unLam : IR.Expr -> List IR.Expr -> IR.Expr
unLam (ELam ys b) argv = letsOf (zipL ys argv) b
unLam e argv = mkApp e argv

-- (a call of `h`, `\xs -> b`: a copy of `b`, the arguments bound to its
-- parameters)
inlinedCall : String -> IR.Expr -> List IR.Expr -> M IR.Expr
inlinedCall h (ELam xs b) argv =
  if List.length argv == List.length xs
  then do
    e <- copy (ELam xs b)
    pure (unLam e argv)
  else pure (EApp (EGlobal h) argv)
inlinedCall h lam1 argv = pure (EApp (EGlobal h) argv)

tieGo : String -> IR.Expr -> IR.Expr -> M IR.Expr
tieGo h lam1 (EApp (EGlobal g) argv) = do
  as2 <- traverseS (tieGo h lam1) argv
  if strEq g h then inlinedCall h lam1 as2 else pure (EApp (EGlobal g) as2)
tieGo h lam1 (EApp f argv) = do
  f2 <- tieGo h lam1 f
  as2 <- traverseS (tieGo h lam1) argv
  pure (EApp f2 as2)
tieGo h lam1 (ELam xs b) = do
  b2 <- tieGo h lam1 b
  pure (ELam xs b2)
tieGo h lam1 (ELet x a b) = do
  a2 <- tieGo h lam1 a
  b2 <- tieGo h lam1 b
  pure (ELet x a2 b2)
tieGo h lam1 (ERecord fs ts) = do
  fs2 <- fieldsS (tieGo h lam1) fs
  pure (ERecord fs2 ts)
tieGo h lam1 (EProj e l sh t) = do
  e2 <- tieGo h lam1 e
  pure (EProj e2 l sh t)
tieGo h lam1 (ETag t argv ts) = do
  as2 <- traverseS (tieGo h lam1) argv
  pure (ETag t as2 ts)
tieGo h lam1 (EMatch sc arms) = do
  sc2 <- tieGo h lam1 sc
  arms2 <- armsS (tieGo h lam1) arms
  pure (EMatch sc2 arms2)
tieGo h lam1 (EPrimCall p argv) = do
  as2 <- traverseS (tieGo h lam1) argv
  pure (EPrimCall p as2)
tieGo h lam1 (ECall g argv) = do
  as2 <- traverseS (tieGo h lam1) argv
  pure (ECall g as2)
tieGo h lam1 (EBool c) = do
  c2 <- condS (tieGo h lam1) c
  pure (EBool c2)
tieGo h lam1 (ESet xs a b) = do
  a2 <- tieGo h lam1 a
  b2 <- tieGo h lam1 b
  pure (ESet xs a2 b2)
tieGo h lam1 (EValues es) = do
  es2 <- traverseS (tieGo h lam1) es
  pure (EValues es2)
tieGo h lam1 e = pure e

-- (the copy `h`, made to `hb`, small and not calling itself, put where a
-- copy it calls calls it back)
tieOne : String -> List String -> IR.Expr -> IR.Def -> M IR.Def
tieOne h calls hb d =
  if elemStr d.key calls && elemStr h (IR.globalsIn d.body)
  then do
    b2 <- tieGo h hb d.body
    u <- refsRetied d.key b2
    pure (IR.mkDef d.key d.name b2)
  else pure d

tieDeps : String -> IR.Expr -> List IR.Def -> M (List IR.Def)
tieDeps h (ELam xs b) deps =
  if not (List.null deps)
     && not (IR.sizeAbove inlineMax (ELam xs b))
     && not (elemStr h (IR.globalsIn b))
  then traverseS (tieOne h (IR.globalsIn b) (ELam xs b)) deps
  else pure deps
tieDeps h hb deps = pure deps

-- | a copy made -- as the cache keeps it, or here -- then the copies it
-- | calls for (`more`), before it
makeOne : (List String -> M (List IR.Def))
        -> String
        -> IR.Expr
        -> M (List IR.Def)
makeOne more h b0 = do
  u <- madeOne h
  kb <- keptMade h
  b3 <- madeBody h b0 kb
  done <- settleKept more kb h b3
  u1 <- refsMade kb h (fst done)
  u2 <- knownMade h (fst done)
  deps <- tieDeps h (fst done) (snd done)
  pure (appendL deps (Cons (IR.mkDef h h (fst done)) Nil))

makeIf : (List String -> M (List IR.Def))
       -> String
       -> Maybe IR.Expr
       -> M (List IR.Def)
makeIf more h (Just b0) = makeOne more h b0
makeIf more h Nothing = pure Nil

-- | the copies among `names` not made yet, made, each once in the
-- | program, and each after those it calls for
makeEach : List String -> M (List IR.Def)
makeEach Nil = pure Nil
makeEach (Cons h rest) = do
  s <- get
  here <- makeIf makeEach h (pendingOf s h)
  others <- makeEach rest
  pure (appendL here others)

-- | a definition simplified here, as the cache is to keep it: what it
-- | came to, whether it is safe, and the copies it asked for, each by
-- | its name and version
type Done =
  { key : String
  , body : IR.Expr
  , safe : Bool
  , touched : List (Pair String String)
  }

-- (each once, the first kept)
onceEach : Map.Map String Unit -> List String -> List String
onceEach seen Nil = Nil
onceEach seen (Cons x xs) =
  if Map.member seen x then onceEach seen xs
  else Cons x (onceEach (Map.insert seen x MkUnit) xs)

-- (the copies asked for, the last first: each once, in order, with its
-- version)
touchedVers : Map.Map String String -> List String -> List (Pair String String)
touchedVers vers t =
  List.map
    (\h -> MkPair h (fromMaybe "" (Map.lookup vers h)))
    (onceEach Map.empty (List.reverse t))

doneOf : St -> IR.Def -> IR.Expr -> List String -> Done
doneOf s d b t =
  { key = d.key
  , body = b
  , safe = Map.member s.safe d.key
  , touched = touchedVers s.kp.vers t
  }

-- | a definition simplified, after the copies it calls for; and what the
-- | cache is to keep of it
-- In order: a definition settled made copies as it was in each round,
-- some of them for what it no longer comes to.  Where the cache keeps it,
-- its copies are made from what it came to alone, each after the copies
-- it calls (`makeEach`): so the copies made here are put in that order,
-- and those it does not reach are taken as not made -- known by what they
-- were asked for as, to be made again where something reaches them --
-- that the program be the same through the cache, byte for byte.

type Canon =
  { pool : Map.Map String IR.Def
  , placed : Map.Map String Unit
  , out : List IR.Def
  }

withOut : IR.Def -> Canon -> Canon
withOut d c = { pool = c.pool, placed = c.placed, out = Cons d c.out }

-- (the copy `h`, if it was made here, after those it calls)
canonVisit : Canon -> String -> Canon
canonVisit c h = case Map.lookup c.pool h of
  Just d ->
    if Map.member c.placed h then c
    else withOut
        d
        (List.foldl
           canonVisit
           { pool = c.pool
           , placed = Map.insert c.placed h MkUnit
           , out = c.out
           }
           (IR.globalsIn d.body))
  Nothing -> c

-- | the copy `h` not made after all: known by what it was asked for as
unmade : String -> M Unit
unmade h = \s ->
    MkPair
      MkUnit
      (withSp
         { all = case Map.lookup s.sp.recipes h of
             Just r ->
               if IR.sizeAbove specBodySize r
               then Map.delete s.sp.all h
               else Map.insert s.sp.all h r
             Nothing -> s.sp.all
         , kinds = s.sp.kinds
         , recipes = s.sp.recipes
         , depths = s.sp.depths
         , made = Map.delete s.sp.made h
         , count = s.sp.count
         , off = s.sp.off
         }
         s)

-- | the copies made for a body, as `makeEach` makes them from it: those
-- | it reaches, in order; the others not made
inOrder : IR.Expr -> List IR.Def -> M (List IR.Def)
inOrder b made = do
  c <-
    pure
      (List.foldl
         canonVisit
         { pool =
             List.foldl
               (\m (d : IR.Def) -> Map.insert m d.key d)
               Map.empty
               made
         , placed = Map.empty
         , out = Nil
         }
         (IR.globalsIn b))
  u <-
    traverseS
      (\(d : IR.Def) ->
         if Map.member c.placed d.key then pure MkUnit
         else unmade d.key)
      made
  pure (List.reverse c.out)

-- (a definition simplified, recorded, and the copies it calls for made,
-- `n` rounds left: simplified again while a copy it calls was made to
-- take more -- see Settling)
settleDef : Int -> String -> IR.Expr -> M (Pair IR.Expr (List IR.Def))
settleDef n key b = do
  u2 <- recordDef key b
  u3 <- markSafe key b
  s0 <- get
  made <- makeEach (IR.globalsIn b)
  s1 <- get
  if n > 0 && grewIn s0 s1 b
  then do
    u <- ownSt
    b1 <- sk.simp b
    b2 <- raise b1
    rest <- settleDef (n - 1) key b2
    pure (MkPair (fst rest) (appendL made (snd rest)))
  else pure (MkPair b made)

oneDef : IR.Def -> M (Pair (List IR.Def) (List Done))
oneDef d = do
  u <- ownSt
  u0 <- keepWith (touchedTo Nil)
  -- (twice: what the first pass exposes, the second reduces)
  b1 <- sk.simp d.body
  b2 <- sk.simp b1
  b3 <- raise b2
  done <- settleDef settleRounds d.key b3
  u1 <- refsTouched (fst done)
  made <- inOrder (fst done) (snd done)
  t <- getTouched
  s <- get
  pure
      (MkPair
         (appendL made (Cons (IR.mkDef d.key d.name (fst done)) Nil))
         (Cons (doneOf s d (fst done) t) Nil))

-- | a definition as the cache keeps it, simplified: what it came to
-- | (read when wanted), whether it is safe, the copies it asked for (by
-- | name and version) -- and, before it was, whether it was safe and how
-- | many arguments its application takes and cannot fail with
-- | (`safeGlobals`; -1: none)
type KeptDef =
  { key : String
  , name : String
  , body : Unit -> Maybe IR.Expr
  , safe : Bool
  , touched : List (Pair String String)
  , sgSafe : Bool
  , sgTotal : Int
  }

-- | what is to be simplified: a definition, or one the cache keeps --
-- | with how to have the definition (erased, from where names are drawn
-- | on), should the cache not do (a copy it asked for not kept)
data Item = Fresh IR.Def | Kept KeptDef (Int -> Pair (Maybe IR.Def) Int)

safeAs : Bool -> String -> M Unit
safeAs True k = \s -> MkPair MkUnit (withSafe k s)
safeAs False k = pure MkUnit

replayBody : KeptDef -> IR.Expr -> M (List IR.Def)
replayBody k b0 = do
  b <- copy b0
  u <- recordDef k.key b
  u2 <- safeAs k.safe k.key
  made0 <- makeEach (IR.globalsIn b)
  made <- inOrder b made0
  pure (appendL made (Cons (IR.mkDef k.key k.name b) Nil))

replayed : KeptDef -> Maybe IR.Expr -> M (Maybe (List IR.Def))
replayed k (Just b0) = do
  ok <- allAsked k.touched
  if ok
  then do
    ds <- replayBody k b0
    pure (Just ds)
  else pure Nothing
replayed k Nothing = pure Nothing

supplyTo : Int -> M Unit
supplyTo n = \s -> MkPair MkUnit (withSupply n s)

afresh : Pair (Maybe IR.Def) Int -> M (Pair (List IR.Def) (List Done))
afresh (MkPair (Just d) n) = do
  u <- supplyTo n
  oneDef d
afresh (MkPair Nothing n) = pure (MkPair Nil Nil)

orAfresh : St
         -> (Int -> Pair (Maybe IR.Def) Int)
         -> Maybe (List IR.Def)
         -> M (Pair (List IR.Def) (List Done))
orAfresh saved redo (Just ds) = pure (MkPair ds Nil)
orAfresh saved redo Nothing = do
  u <- put saved
  afresh (redo saved.supply)

-- | a definition the cache keeps, taken as it keeps it -- the copies it
-- | asked for asked for, what it came to recorded, the copies it calls
-- | for made -- or simplified afresh, if the cache does not keep a copy
-- | it asked for
oneKept : KeptDef
        -> (Int -> Pair (Maybe IR.Def) Int)
        -> M (Pair (List IR.Def) (List Done))
oneKept k redo = do
  saved <- get
  r <- replayed k (k.body MkUnit)
  orAfresh saved redo r

oneItem : Item -> M (Pair (List IR.Def) (List Done))
oneItem (Fresh d) = oneDef d
oneItem (Kept k redo) = oneKept k redo

-- | a copy asked for or made here, as the cache is to keep it: its
-- | version, what it is known by, how deep, whether safe, and what it was
-- | made to, with the copies it asked for as it was, if it was made here
type CopyDone =
  { name : String
  , ver : String
  , recipe : IR.Expr
  , depth : Int
  , safe : Bool
  , made : Maybe (Pair IR.Expr (List (Pair String String)))
  }

type Simplified =
  { defs : List IR.Def, supply : Int, done : List Done, copies : List CopyDone }

concatDefs : {a : Type} -> List (List a) -> List a
concatDefs Nil = Nil
concatDefs (Cons ds rest) = appendL ds (concatDefs rest)

allVersKnown : List (Pair String String) -> Bool
allVersKnown ps = List.all (\p -> not (strEq (snd p) "")) ps

madeWith : List (Pair String String)
         -> Maybe IR.Expr
         -> Maybe (Pair IR.Expr (List (Pair String String)))
madeWith tv (Just b) = if allVersKnown tv then Just (MkPair b tv) else Nothing
madeWith tv Nothing = Nothing

-- (what a copy made here was made to, with what it asked for, if every
-- one of those has a version)
madeOf : St
       -> Map.Map String IR.Expr
       -> String
       -> Maybe (Pair IR.Expr (List (Pair String String)))
madeOf st bodies h = case Map.lookup st.kp.madeFresh h of
  Just t -> madeWith (touchedVers st.kp.vers t) (Map.lookup bodies h)
  Nothing -> Nothing

copyWith : St
         -> Map.Map String IR.Expr
         -> String
         -> String
         -> IR.Expr
         -> Maybe CopyDone
copyWith st bodies h v r =
  if strEq v "" then Nothing
  else Just
      { name = h
      , ver = v
      , recipe = r
      , depth = fromMaybe 0 (Map.lookup st.sp.depths h)
      , safe = Map.member st.base h
      , made = madeOf st bodies h
      }

copyDone : St -> Map.Map String IR.Expr -> String -> Maybe CopyDone
copyDone st bodies h = case Map.lookup st.sp.recipes h of
  Just r ->
    copyWith
      st
      bodies
      h
      (fromMaybe "" (Map.lookup st.kp.vers h))
      r
  Nothing -> Nothing

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) rest) = Cons x (catMaybesS rest)
catMaybesS (Cons Nothing rest) = catMaybesS rest

bodiesMap : List IR.Def -> Map.Map String IR.Expr
bodiesMap defs =
  List.foldl
    (\m (d : IR.Def) -> Map.insert m d.key d.body)
    Map.empty
    defs

-- (the copies asked for or made here)
copiesDone : St -> List IR.Def -> List CopyDone
copiesDone st defs =
  catMaybesS
    (List.map
       (copyDone st (bodiesMap defs))
       (onceEach
          Map.empty
          (List.append
             (List.map fst (Map.toList st.kp.fresh))
             (List.map fst (Map.toList st.kp.madeFresh)))))

simplifyDone : Pair (List (Pair (List IR.Def) (List Done))) St -> Simplified
simplifyDone (MkPair out st) =
  { defs = concatDefs (List.map fst out)
  , supply = st.supply
  , done = concatDefs (List.map snd out)
  , copies = copiesDone st (concatDefs (List.map fst out))
  }

initSt : Int -> SG -> Keep -> St
initSt n0 sg kp =
  { supply = n0
  , fuel = 0
  , defs = Map.empty
  , safe = sg.safe
  , base = sg.safe
  , total = sg.total
  , plain = Map.empty
  , sp =
      { all = Map.empty
      , kinds = Map.empty
      , recipes = Map.empty
      , depths = Map.empty
      , made = Map.empty
      , count = 0
      , off = False
      }
  , kp = kp
  }

-- | each definition, in order, simplified; what is inlined is taken
-- | simplified already
-- | >>> List.map (\(d : IR.Def) -> d.body) (simplifyProgram 0 [IR.mkDef "f" "f" (EApp (ELam ["x"] (EVar "x")) [EInt 1])]).defs
-- | [EInt 1]
-- | >>> List.map (\(d : IR.Def) -> d.body) (simplifyProgram 0 [IR.mkDef "g" "g" (EMatch (ETag "Just" [EInt 5] [FtAny]) [MkArm "Just" ["x"] (EVar "x"), MkArm "Nothing" [] (EInt 0)])]).defs
-- | [EInt 5]
-- |
-- | another name for a tag, given a call: the tag given it, no binding
-- | between, so a loop can build the value
-- | >>> List.map (\(d : IR.Def) -> d.body) (simplifyProgram 0 [IR.mkDef "c" "c" (ELam ["x", "y"] (ETag "Cons" [EVar "x", EVar "y"] [FtAny, FtOther])), IR.mkDef "f" "f" (ELam ["z"] (EApp (EApp (EGlobal "c") [EPrimCall "add" [EVar "z"]]) [EApp (EGlobal "f") [EVar "z"]]))]).defs
-- | [ELam ["x", "y"] (ETag "Cons" [EVar "x", EVar "y"] [FtAny, FtOther]), ELam ["z"] (ETag "Cons" [EPrimCall "add" [EVar "z"], EApp (EGlobal "f") [EVar "z"]] [FtAny, FtOther])]
-- |
-- | two arguments alike but for a number in them: one copy, the number
-- | given it where it is called
-- | >>> List.length (List.keepIf (\(d : IR.Def) -> strEq (Spec.rootOf d.key) "m" && not (strEq d.key "m")) (simplifyProgram 0 [IR.mkDef "m" "m" (ELam ["f", "xs"] (EMatch (EVar "xs") [MkArm "Nil" [] (ETag "Nil" [] []), MkArm "Cons" ["x", "r"] (ETag "Cons" [EApp (EVar "f") [EVar "x"], EApp (EGlobal "m") [EVar "f", EVar "r"]] [FtAny, FtOther])])), IR.mkDef "a" "a" (ELam ["us"] (EApp (EGlobal "m") [ELam ["u"] (EPrimCall "intAdd" [EVar "u", EInt 1]), EVar "us"])), IR.mkDef "b" "b" (ELam ["vs"] (EApp (EGlobal "m") [ELam ["v"] (EPrimCall "intAdd" [EVar "v", EInt 2]), EVar "vs"]))]).defs)
-- | 1
simplifyProgram : Int -> List IR.Def -> Simplified
simplifyProgram n0 defs =
  simplifyDone
    (traverseS (\d -> oneDef d) defs (initSt n0 (safeGlobals defs) noKeep))

sgItem : SG -> Item -> SG
sgItem acc (Fresh d) = sgFlat acc d.key (flat d.body)
sgItem acc (Kept k _) =
  { safe =
      if k.sgSafe then Map.insert acc.safe k.key MkUnit
      else acc.safe
  , total =
      if k.sgTotal >= 0 then Map.insert acc.total k.key k.sgTotal
      else acc.total
  }

-- | `safeGlobals`, of what is to be simplified
safeItems : List Item -> SG
safeItems items =
  List.foldl sgItem { safe = Map.empty, total = Map.empty } items

-- | each definition, in order, simplified as `simplifyProgram` does --
-- | or, one the cache keeps, as it keeps it.  `sg`: what `safeItems`
-- | says of them; `vers`: each definition's version; `kept`: the copies
-- | the cache keeps
simplifyItems : Int
              -> SG
              -> Map.Map String String
              -> Map.Map String KeptCopy
              -> List Item
              -> Simplified
simplifyItems n0 sg vers kept items =
  simplifyDone
    (traverseS
       oneItem
       items
       (initSt
          n0
          sg
          { vers = vers
          , kept = kept
          , touched = Nil
          , fresh = Map.empty
          , madeFresh = Map.empty
          }))
