-- Computing at compile time what is known then: β-reduction, the definitions that are not
-- recursive inlined (when that makes the code no bigger than a little),
-- a field of a known record, the arm of a match on a known tag.
--
-- Hippogriff's programs are pure, but for `abandon` and divergence, and
-- they are call-by-value: what is computed is computed, in order, even
-- if no one uses it.  So only what cannot fail (`pure`: a value, of
-- globals that cannot) is dropped where no one uses it, or moved to
-- where it is used; what could fail stays where it was.

import heff.compile.ir as I
import heff.compile.irtext as Ir
import heff.compile.prims as Pr
import heff.compile.spec as Sp
import map as M

-- | how much bigger than what it replaces an inlined definition may
-- | make the code
budget : Int
budget = 24

-- | what a known definition, given all its arguments and none it can
-- | compute with, came to: those arguments as its parameters, or not
-- | inlined
data Plain = Inlined (List String) I.Expr | NotInlined

-- | specialisation: every definition so far small enough to be copied
-- | (those calling themselves too), those that are functions or records
-- | (whatever their size); the copies asked for, each as it is known
-- | (by its name), how deep in copies of copies each is, those made,
-- | and how many were asked for; and whether no copy is asked for now
type Specs =
  { all : M.Map String I.Expr
  , kinds : M.Map String Unit
  , recipes : M.Map String I.Expr
  , depths : M.Map String Int
  , made : M.Map String Unit
  , count : Int
  , off : Bool
  }

-- | a copy made, as the backend's cache keeps it (heff.build.backcache):
-- | what it was made to (read when it is wanted), and the copies asked
-- | for as it was made, each by its name and version
type KeptMade =
  { body : Unit -> Maybe I.Expr, touched : List (Pair String String) }

-- | a copy asked for, as the cache keeps it: its version (`copyVer`),
-- | what it is known by (`knowing`, read when it is wanted), how deep in
-- | copies of copies it is, whether it is safe (`markCopySafe`) -- and
-- | what it was made to, if it was
type KeptCopy =
  { ver : String
  , recipe : Unit -> Maybe I.Expr
  , depth : Int
  , safe : Bool
  , made : Maybe KeptMade
  }

-- | what the simplifier knows of the cache, and tells it: each global's
-- | version, where it has one (what it is made of, hashed: a
-- | definition's is given, a copy's found as it is asked for); the
-- | copies kept; the copies asked for by what is being simplified, the
-- | last first; and the copies asked for, and those made, here and not
-- | as the cache keeps them (those made with the copies they asked for)
type Keep =
  { vers : M.Map String String
  , kept : M.Map String KeptCopy
  , touched : List String
  , fresh : M.Map String Unit
  , madeFresh : M.Map String (List String)
  }

-- | knowing nothing of a cache
noKeep : Keep
noKeep =
  { vers = M.empty
  , kept = M.empty
  , touched = Nil
  , fresh = M.empty
  , madeFresh = M.empty
  }

-- (`safe`: the globals that cannot fail when used -- `safeGlobals`'s,
-- then each definition and copy found so once simplified; `base`: the
-- same but for the definitions simplified -- see `markCopySafe`)
type St =
  { supply : Int
  , fuel : Int
  , defs : M.Map String I.Expr
  , safe : M.Map String Unit
  , base : M.Map String Unit
  , total : M.Map String Int
  , plain : M.Map String Plain
  , sp : Specs
  , kp : Keep
  }

withSp : Specs -> St -> St
withSp p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = p
  , kp = s.kp
  }

withSupply : Int -> St -> St
withSupply n s =
  { supply = n
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withFuel : Int -> St -> St
withFuel f s =
  { supply = s.supply
  , fuel = f
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withSafe : String -> St -> St
withSafe k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = M.insert compareString k MkUnit s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withBase : String -> St -> St
withBase k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = M.insert compareString k MkUnit s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withPlain : String -> Plain -> St -> St
withPlain k p s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = M.insert compareString k p s.plain
  , sp = s.sp
  , kp = s.kp
  }

withDefs : M.Map String I.Expr -> St -> St
withDefs d s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = d
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = s.kp
  }

withKp : Keep -> St -> St
withKp k s =
  { supply = s.supply
  , fuel = s.fuel
  , defs = s.defs
  , safe = s.safe
  , base = s.base
  , total = s.total
  , plain = s.plain
  , sp = s.sp
  , kp = k
  }

type M a = St -> Pair a St

bindTake : {a b : Type} -> (a -> M b) -> Pair a St -> Pair b St
bindTake f (MkPair x s) = f x s

bind : {a b : Type} -> M a -> (a -> M b) -> M b
bind m f = \s -> bindTake f (m s)

pure : {a : Type} -> a -> M a
pure x = \s -> MkPair x s

get : M St
get = \s -> MkPair s s

put : St -> M Unit
put s' = \s -> MkPair MkUnit s'

traverseS : {a b : Type} -> (a -> M b) -> List a -> M (List b)
traverseS f Nil = pure Nil
traverseS f (Cons x xs) = do
  y <- f x
  ys <- traverseS f xs
  pure (Cons y ys)

fieldsS : (I.Expr -> M I.Expr)
        -> List (Pair String I.Expr)
        -> M (List (Pair String I.Expr))
fieldsS f fs =
  traverseS
    (\p -> case p of
     MkPair l e -> do
       e' <- f e
       pure (MkPair l e'))
    fs

armsS : (I.Expr -> M I.Expr) -> List I.Arm -> M (List I.Arm)
armsS f arms =
  traverseS
    (\a -> case a of
     MkArm t vs b -> do
       b' <- f b
       pure (MkArm t vs b'))
    arms

appendL : {a : Type} -> List a -> List a -> List a
appendL Nil ys = ys
appendL (Cons x xs) ys = Cons x (appendL xs ys)

elemStr : String -> List String -> Bool
elemStr x Nil = False
elemStr x (Cons y ys) = strEq x y || elemStr x ys

zipL : {a b : Type} -> List a -> List b -> List (Pair a b)
zipL (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipL xs ys)
zipL _ _ = Nil

takeL : {a : Type} -> Int -> List a -> List a
takeL n Nil = Nil
takeL n (Cons x xs) = if n <= 0 then Nil else Cons x (takeL (n - 1) xs)

dropL : {a : Type} -> Int -> List a -> List a
dropL n Nil = Nil
dropL n (Cons x xs) = if n <= 0 then Cons x xs else dropL (n - 1) xs

minI : Int -> Int -> Int
minI a b = if a <= b then a else b

-- | the bindings, each around the next, around the body
letsOf : List (Pair String I.Expr) -> I.Expr -> I.Expr
letsOf Nil body = body
letsOf (Cons (MkPair x a) rest) body = ELet x a (letsOf rest body)

-- (an attempt undone: the names drawn and the fuel burnt kept, and
-- what was learnt of the copies asked for in it)
restore : St -> St -> St
restore saved st =
  { supply = st.supply
  , fuel = st.fuel
  , defs = saved.defs
  , safe = st.safe
  , base = st.base
  , total = saved.total
  , plain = st.plain
  , sp = st.sp
  , kp = st.kp
  }

copyTake : St -> Pair I.Expr Int -> Pair I.Expr St
copyTake s (MkPair e' n) = MkPair e' (withSupply n s)

copy : I.Expr -> M I.Expr
copy e = \s -> copyTake s (I.freshen s.supply e)

-- | a definition's body, to inline (a copy), if it may be
known : String -> M (Maybe I.Expr)
known g = do
  s <- get
  case M.lookup compareString g s.defs of
    Just b ->
      if s.fuel > 0
        then do
          u <- put (withFuel (s.fuel - 1) s)
          e <- copy b
          pure (Just e)
      else pure Nothing
    Nothing -> pure Nothing

-- | try an inlining: keep it if it is small enough (a copy asked for
-- | in it is only named: it is made after the definition, if what it
-- | comes to calls it)
attempt : I.Expr -> M I.Expr -> M I.Expr
attempt orig m = do
  saved <- get
  e <- m
  if not (I.sizeAbove (I.size orig + budget) e) then pure e
    else do
      -- (the names drawn stay drawn: no name is ever given out twice.
      -- And the fuel burnt stays burnt: a speculation that did not pay
      -- is not free to try again inside every caller -- refunding it
      -- made the simplifier exponential on a file of record-tied
      -- definitions)
      st <- get
      u <- put (restore saved st)
      pure orig

type SG = { safe : M.Map String Unit, total : M.Map String Int }

-- | what cannot fail: evaluating it gives a value, at once.  A
-- | projection is of a record, always there; an application of a
-- | `total` function up to its arity builds a closure or its pure body
-- | the primitives that may fail (abandon, or a shift beyond memory), or
-- | call what may: no fixed-width type's operation is among them (a
-- | division by zero is 0, the floor of what is not finite 0)
failing : List String
failing = ["intShl", "intShr", "arrayIndex", "arrayGenerate", "perform"]

-- | whether a primitive may fail
primFails : String -> Bool
primFails p = elemStr p failing

pureIn : M.Map String Unit -> M.Map String Int -> I.Expr -> Bool
pureIn safe total (EVar _) = True
pureIn safe total (EGlobal g) = M.member compareString g safe
pureIn safe total (ELam _ _) = True
pureIn safe total (ERecord fs) =
  I.allI
    (List.map
       (\p -> case p of
        MkPair _ e2 -> pureIn safe total e2)
       fs)
pureIn safe total (ETag _ as) = I.allI (List.map (\a -> pureIn safe total a) as)
pureIn safe total (EProj e2 _ _) = pureIn safe total e2
pureIn safe total (EApp (EGlobal g) as) = case M.lookup compareString g total of
  Just ar ->
    List.length as <= ar && I.allI (List.map (\a -> pureIn safe total a) as)
  Nothing -> False
pureIn safe total (ECall g as) = case M.lookup compareString g total of
  Just ar ->
    List.length as <= ar && I.allI (List.map (\a -> pureIn safe total a) as)
  Nothing -> False
pureIn safe total (EPrimCall p as) =
  not (primFails p) && I.allI (List.map (\a -> pureIn safe total a) as)
pureIn safe total (EPrim _) = True
pureIn safe total (EInt _) = True
pureIn safe total (EFloat _) = True
pureIn safe total (EStr _) = True
pureIn safe total (EFixed _ _) = True
pureIn safe total (EFloat32 _) = True
pureIn safe total e = False

flatCons : List String -> Pair (List String) I.Expr -> Pair (List String) I.Expr
flatCons xs (MkPair ys b) = MkPair (appendL xs ys) b

-- (lambdas in lambdas, one parameter list)
flat : I.Expr -> Pair (List String) I.Expr
flat (ELam xs b) = flatCons xs (flat b)
flat b = MkPair Nil b

sgFlat : SG -> String -> Pair (List String) I.Expr -> SG
sgFlat acc key (MkPair xs b) =
  if List.length xs > 0
    then if pureIn acc.safe acc.total b && not (elemStr key (I.globalsIn b))
        then { safe = M.insert compareString key MkUnit acc.safe
             , total = M.insert compareString key (List.length xs) acc.total
             }
      else { safe = M.insert compareString key MkUnit acc.safe
           , total = acc.total
           }
  else if pureIn acc.safe acc.total b && not (elemStr key (I.globalsIn b))
    then { safe = M.insert compareString key MkUnit acc.safe
         , total = acc.total
         }
  else acc

-- | the globals that cannot fail when used: functions, and values of
-- | such globals (each definition after those it uses; one using itself
-- | is not).  `total`: the functions whose application cannot fail
-- | either -- their body is pure under the lambdas (erased statics,
-- | record builders such as co.hf's `plus`) -- with their arity
safeGlobals : List I.Def -> SG
safeGlobals defs =
  List.foldl
    (\acc (d : I.Def) -> sgFlat acc d.key (flat d.body))
    { safe = M.empty, total = M.empty }
    defs

-- | a known function given fewer arguments than it takes (each pure):
-- | it only builds a closure
partialOf : St -> List I.Expr -> Maybe I.Expr -> Bool
partialOf s as (Just (ELam xs _)) =
  List.length as < List.length xs
  && I.allI (List.map (pureIn s.safe s.total) as)
partialOf s as _ = False

partialHead : St -> List I.Expr -> I.Expr -> Bool
partialHead s as (EGlobal g) =
  partialOf s as (M.lookup compareString g s.sp.all)
partialHead s as _ = False

partialIn : St -> I.Expr -> Bool
partialIn s (EApp f as) = partialHead s as f
partialIn s _ = False

isPure : I.Expr -> M Bool
isPure e = \s -> MkPair (pureIn s.safe s.total e || partialIn s e) s

atomic : I.Expr -> Bool
atomic (EVar _) = True
atomic (EGlobal _) = True
atomic (EInt _) = True
atomic (EFloat _) = True
atomic (EStr _) = True
atomic (EFixed _ _) = True
atomic (EFloat32 _) = True
atomic (EPrim _) = True
atomic e = False

-- Constant folding
--------------------------------------------------------------------------------

boolE : Bool -> I.Expr
boolE b = ETag (if b then "True" else "False") Nil

-- | a primitive of two integers, computed (those that cannot fail)
intOp : String -> Int -> Int -> Maybe I.Expr
intOp p a b =
  if strEq p "intAdd" then Just (EInt (a + b))
  else if strEq p "intSub" then Just (EInt (a - b))
  else if strEq p "intMul" then Just (EInt (a * b))
  else if strEq p "intEq" then Just (boolE (a == b))
  else if strEq p "intLt" then Just (boolE (a < b))
  else if strEq p "intLe" then Just (boolE (a <= b))
  else Nothing

-- | ... of two strings
strOp : String -> String -> String -> Maybe I.Expr
strOp p a b =
  if strEq p "strAppend" then Just (EStr (a ^ b))
  else if strEq p "strEq" then Just (boolE (strEq a b))
  else Nothing

-- | ... of one (a string's length its bytes, as every backend's is)
-- | >>> unOp "strLength" (EStr "\u{e9}\u{1F600}")
-- | Just (EInt 6)
unOp : String -> I.Expr -> Maybe I.Expr
unOp p (EInt a) = if strEq p "intShow" then Just (EStr (showInt a)) else Nothing
unOp p (EStr a) =
  if strEq p "strLength" then Just (EInt (strLength a)) else Nothing
unOp p _ = Nothing

binOp : String -> I.Expr -> I.Expr -> Maybe I.Expr
binOp p (EInt a) (EInt b) = intOp p a b
binOp p (EStr a) (EStr b) = strOp p a b
binOp p _ _ = Nothing

foldArgs : String -> List I.Expr -> Maybe I.Expr
foldArgs p (Cons a Nil) = unOp p a
foldArgs p (Cons a (Cons b Nil)) = binOp p a b
foldArgs p _ = Nothing

-- | a primitive's call: its value, if its arguments are literals
foldPrim : String -> List I.Expr -> I.Expr
foldPrim p as = fromMaybe (EPrimCall p as) (foldArgs p as)

-- | a primitive given its arguments: a call of it, once they are all
-- | there (what the other judgments know a primitive's computation by;
-- | `heff.compile.arity` does the same for the definitions, whose parameters are
-- | not known until the simplifier is done)
primAppN : String -> List I.Expr -> Maybe Int -> I.Expr
primAppN p as (Just n) =
  if List.length as == n then foldPrim p as
  else if List.length as > n then EApp (foldPrim p (takeL n as)) (dropL n as)
  else EApp (EPrim p) as
primAppN p as Nothing = EApp (EPrim p) as

primApp : String -> List I.Expr -> I.Expr
primApp p as = primAppN p as (Pr.primArity p)

-- | an application, in the form the simplifier keeps every one in:
-- | its head not an application (`(f a) b` is `f a b`), and a primitive
-- | given all its arguments a call of it.  Every application the
-- | simplifier makes is made by this, so no judgment need look for
-- | another form (a primitive applied, not called: `cheap` would not
-- | know it)
-- | >>> mkApp (EApp (EPrim "intLe") [EVar "n"]) [EInt 0]
-- | EPrimCall "intLe" [EVar "n", EInt 0]
mkApp : I.Expr -> List I.Expr -> I.Expr
mkApp f Nil = f
mkApp (EApp g bs) as = mkApp g (appendL bs as)
mkApp (EPrim p) as = primApp p as
mkApp f as = EApp f as

-- | `x` replaced by `a`, a copy of it for each occurrence
substCopies : String -> I.Expr -> I.Expr -> M I.Expr
substCopies x a (EVar y) = if strEq y x then copy a else pure (EVar y)
substCopies x a (ELam xs b) = do
  b' <- substCopies x a b
  pure (ELam xs b')
substCopies x a (EApp f as) = do
  f' <- substCopies x a f
  as' <- traverseS (\q -> substCopies x a q) as
  pure (mkApp f' as')
substCopies x a (ELet y e2 b) = do
  e2' <- substCopies x a e2
  b' <- substCopies x a b
  pure (ELet y e2' b')
substCopies x a (ERecord fs) = do
  fs' <- fieldsS (\q -> substCopies x a q) fs
  pure (ERecord fs')
substCopies x a (EProj e2 l sh) = do
  e2' <- substCopies x a e2
  pure (EProj e2' l sh)
substCopies x a (ETag t as) = do
  as' <- traverseS (\q -> substCopies x a q) as
  pure (ETag t as')
substCopies x a (EMatch s arms) = do
  s' <- substCopies x a s
  arms' <- armsS (\q -> substCopies x a q) arms
  pure (EMatch s' arms')
substCopies x a (EPrimCall p as) = do
  as' <- traverseS (\q -> substCopies x a q) as
  pure (EPrimCall p as')
substCopies x a (ECall g as) = do
  as' <- traverseS (\q -> substCopies x a q) as
  pure (ECall g as')
substCopies x a e = pure e

-- | (lambdas in lambdas are one lambda)
lam : List String -> I.Expr -> I.Expr
lam xs (ELam ys b) = ELam (appendL xs ys) b
lam xs e = ELam xs e

-- | the judgments, knotted
type SK =
  { simp : I.Expr -> M I.Expr
  , applyTo : I.Expr -> List I.Expr -> M I.Expr
  , project : String -> List String -> I.Expr -> M I.Expr
  , match : I.Expr -> List I.Arm -> M I.Expr
  }

occCountOf : String -> I.Expr -> Int
occCountOf x b = (I.occurrences x b).count

singletonM : String -> I.Expr -> M.Map String I.Expr
singletonM x a = M.insert compareString x a M.empty

-- | the most a known argument -- a closed lambda or record, one a copy
-- | may be made for -- may be
specArgSize : Int
specArgSize = 60

-- | a closed lambda or record, no bigger than a copy may be made for
closedKnown : I.Expr -> Bool
closedKnown (ELam xs b) =
  not (I.sizeAbove specArgSize (ELam xs b)) && Sp.closedIn Nil (ELam xs b)
closedKnown (ERecord fs) =
  not (I.sizeAbove specArgSize (ERecord fs)) && Sp.closedIn Nil (ERecord fs)
closedKnown _ = False

-- | how many uses of a closed value bound may each be given a copy of it
closedUses : Int
closedUses = 4

-- (a value bound and used more than once is put where it is used, a
-- copy each time, if it is small -- or, used a few times, if it is
-- closed and a copy may be made for it: a handler, `{ ret = ..., bind =
-- ..., malg = ... }`, bound once and handed to two calls -- Co's `bind`
-- hands its `hd` on twice -- is known to both, which a variable would
-- hide from them)
letPure : SK -> String -> I.Expr -> I.Expr -> Int -> M I.Expr
letPure r x a b o =
  if o == 0 then r.simp b
  else if atomic a || o == 1 then r.simp (I.subst (singletonM x a) b)
  else if I.isValue a
  && (not (I.sizeAbove 12 a) || (o <= closedUses && closedKnown a))
    then do
      b' <- substCopies x a b
      r.simp b'
  else do
    b' <- r.simp b
    pure (ELet x a b')

-- (a name of its own)
freshName : String -> M String
freshName base = \s -> case I.fresh base s.supply of
  MkPair x n -> MkPair x (withSupply n s)

-- | arguments, those that compute bound to names of their own, in order
type Split = { binds : List (Pair String I.Expr), args : List I.Expr }

splitCons : Maybe (Pair String I.Expr) -> I.Expr -> Split -> Split
splitCons (Just bd) a rest =
  { binds = Cons bd rest.binds, args = Cons a rest.args }
splitCons Nothing a rest = { binds = rest.binds, args = Cons a rest.args }

splitOne : Bool -> I.Expr -> M (Pair (Maybe (Pair String I.Expr)) I.Expr)
splitOne True a = pure (MkPair Nothing a)
splitOne False a = do
  t <- freshName "t"
  pure (MkPair (Just (MkPair t a)) (EVar t))

splitArgs : List I.Expr -> M Split
splitArgs Nil = pure { binds = Nil, args = Nil }
splitArgs (Cons a as) = do
  p <- isPure a
  one <- splitOne p a
  rest <- splitArgs as
  pure (splitCons (fst one) (snd one) rest)

-- (fewer arguments than the function takes)
fewerThan : List I.Expr -> Maybe I.Expr -> Bool
fewerThan as (Just (ELam xs _)) = List.length as < List.length xs
fewerThan as _ = False

-- (a known function given fewer arguments than it takes)
partialApp : St -> I.Expr -> Bool
partialApp s (EApp (EGlobal g) as) =
  fewerThan as (M.lookup compareString g s.sp.all)
partialApp s _ = False

-- (a partial application, its arguments that compute bound before it)
letSplit : SK -> String -> I.Expr -> I.Expr -> M I.Expr
letSplit r x (EApp f as) b = do
  sp <- splitArgs as
  e <- letPure r x (EApp f sp.args) b (occCountOf x b)
  pure (letsOf sp.binds e)
letSplit r x a b = do
  b' <- r.simp b
  pure (ELet x a b')

-- | a binding, its value simplified: what could fail is computed where
-- | it was, used or not.  A known function given fewer arguments than it
-- | takes, some computing (`c = lPing (intOr 100000 rest)`), has those
-- | bound first, in order: what is left is the closure, built of
-- | values, pure -- put where it is used, and called whole there (with
-- | a handler, for one: `c hd r k`, a call of a copy for it)
letIn : SK -> String -> I.Expr -> I.Expr -> M I.Expr
letIn r x a b = do
  p <- isPure a
  s <- get
  if p then letPure r x a b (occCountOf x b)
    else if partialApp s a then letSplit r x a b
    else do
      b' <- r.simp b
      pure (ELet x a b')

-- | `g` is a function known to take more than `n` arguments: given
-- | `n`, it only builds a closure
takesMore : St -> String -> Int -> Bool
takesMore s g n = case M.lookup compareString g s.defs of
  Just (ELam xs _) -> List.length xs > n
  _ -> False

-- (the arguments are the parameters, in order)
paramsAre : List String -> List I.Expr -> Bool
paramsAre Nil Nil = True
paramsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && paramsAre xs es
paramsAre _ _ = False

-- (a function that is a value already, and none of the parameters: a
-- variable, or a definition made already -- not the one being made,
-- `f x = f x`, which as `f = f` would be a value defined by itself)
etaHead : M.Map String Unit -> List String -> I.Expr -> Bool
etaHead kinds xs (EVar y) = not (elemStr y xs)
etaHead kinds xs (EGlobal g) = M.member compareString g kinds
etaHead kinds xs _ = False

-- | `\x y -> f x y` is `f`, where `f` is a value: a variable or a
-- | definition (the language is pure, and `f` computes nothing)
eta : M.Map String Unit -> I.Expr -> I.Expr
eta kinds (ELam xs (EApp f as)) =
  if paramsAre xs as && etaHead kinds xs f then f else ELam xs (EApp f as)
eta kinds e = e

-- | a binding of a binding, `x = (let y = a in b)`, is `y = a`, then
-- | `x = b`: computed in the same order (names are the program's own,
-- | so `y` is seen by nothing else) -- and `b` judged by itself, a
-- | lambda put where it is used (`hd.malg p` of a known handler, its
-- | operation computed first: `p = ...`, then `\k -> perform p k`)
letFloat : SK -> String -> I.Expr -> I.Expr -> M I.Expr
letFloat r x (ELet y a1 a2) b = do
  rest <- letFloat r x a2 b
  pure (ELet y a1 rest)
letFloat r x a b = letIn r x a b

simpF : SK -> I.Expr -> M I.Expr
simpF r (ELam xs b) = do
  b' <- r.simp b
  s <- get
  pure (eta s.sp.kinds (lam xs b'))
-- (a call given its arguments a few at a time, `(g a) b`, is `g a b`
-- where `g a` only builds a closure: the same computed in the same
-- order, and the call seen whole)
simpF r (EApp (EApp (EGlobal g) bs) as) = do
  s <- get
  if takesMore s g (List.length bs)
      then r.simp (EApp (EGlobal g) (appendL bs as))
    else do
      f' <- r.simp (EApp (EGlobal g) bs)
      as' <- traverseS (\a -> r.simp a) as
      r.applyTo f' as'
simpF r (EApp f as) = do
  f' <- r.simp f
  as' <- traverseS (\a -> r.simp a) as
  r.applyTo f' as'
simpF r (ELet x a b) = do
  a' <- r.simp a
  letFloat r x a' b
simpF r (ERecord fs) = do
  fs' <- fieldsS (\a -> r.simp a) fs
  pure (ERecord fs')
simpF r (EProj e2 l sh) = do
  e2' <- r.simp e2
  r.project l sh e2'
simpF r (ETag t as) = do
  as' <- traverseS (\a -> r.simp a) as
  pure (ETag t as')
simpF r (EMatch s arms) = do
  s' <- r.simp s
  arms' <- armsS (\a -> r.simp a) arms
  r.match s' arms'
simpF r (EPrimCall p as) = do
  as' <- traverseS (\a -> r.simp a) as
  pure (foldPrim p as')
simpF r e = pure e

-- | an argument that tells a body nothing to compute with
opaque : I.Expr -> Bool
opaque (EVar _) = True
opaque (EInt _) = True
opaque (EFloat _) = True
opaque (EStr _) = True
opaque (EFixed _ _) = True
opaque (EFloat32 _) = True
opaque e = False

allOpaque : List I.Expr -> Bool
allOpaque as = I.allI (List.map (\a -> opaque a) as)

-- | the most a definition's body may be for an inlining to be tried:
-- | copying and simplifying a bigger one, to find it too big, was most of
-- | what the simplifier did
inlineMax : Int
inlineMax = 50

tooBig : String -> St -> Bool
tooBig g s = case M.lookup compareString g s.defs of
  Just b -> I.sizeAbove inlineMax b
  Nothing -> False

-- | a known definition, inlined if it may be, and the result simplified
inlineCall : SK -> I.Expr -> String -> List I.Expr -> M I.Expr
inlineCall r f g as = do
  s <- get
  if tooBig g s then pure (mkApp f as)
    else do
      mb <- known g
      case mb of
        Just b -> attempt (mkApp f as) (r.applyTo b as)
        Nothing -> pure (mkApp f as)

paramsTo : List String -> List I.Expr -> M.Map String I.Expr
paramsTo xs as =
  List.foldl
    (\m p -> M.insert compareString (fst p) (snd p) m)
    M.empty
    (zipL xs as)

freshParam : String -> Pair (List String) Int -> Pair (List String) Int
freshParam base (MkPair xs n) = case I.fresh base n of
  MkPair x n2 -> MkPair (Cons x xs) n2

freshParams : Int -> M (List String)
freshParams k = \s -> case List.foldl
    (\acc i -> freshParam "p" acc)
    (MkPair Nil s.supply)
    (List.range 1 k) of
  MkPair xs n -> MkPair xs (withSupply n s)

plainKey : String -> List I.Expr -> String
plainKey g as = g ^ "/" ^ showInt (List.length as)

-- | (taken from what was found, so long as the fuel lasted it out)
remember : String -> Plain -> M Unit
remember k p = \s -> MkPair MkUnit (if s.fuel > 0 then withPlain k p s else s)

-- | a known definition given all its arguments, none of which it can
-- | compute with: what the call comes to is the same whatever they are,
-- | so it is found once -- for parameters of its own -- and kept, the
-- | arguments put in for them where it is used again.  (Each such call
-- | copied and simplified the body again, and most were thrown away.)
plainCall : SK -> I.Expr -> String -> List I.Expr -> M I.Expr
plainCall r f g as = do
  s <- get
  case M.lookup compareString (plainKey g as) s.plain of
    Just NotInlined -> pure (mkApp f as)
    Just (Inlined ps e) ->
      if s.fuel > 0
        then do
          u <- put (withFuel (s.fuel - 1) s)
          e2 <- copy e
          pure (I.subst (paramsTo ps as) e2)
      else pure (mkApp f as)
    Nothing -> do
      ps <- freshParams (List.length as)
      mb <- known g
      case mb of
        Just b -> do
          e <- r.applyTo b (List.map (\x -> EVar x) ps)
          if not (I.sizeAbove (I.size (mkApp f as) + budget) e)
              then do
                u <- remember (plainKey g as) (Inlined ps e)
                pure (I.subst (paramsTo ps as) e)
            else do
              st <- get
              u <- put (restore s st)
              u2 <- remember (plainKey g as) NotInlined
              pure (mkApp f as)
        Nothing -> pure (mkApp f as)

-- | a known definition called: inlined if it may be
callOf : SK -> I.Expr -> String -> List I.Expr -> Maybe I.Expr -> M I.Expr
callOf r f g as (Just (ELam xs _)) =
  if allOpaque as && List.length xs == List.length as then plainCall r f g as
  else inlineCall r f g as
callOf r f g as _ = inlineCall r f g as

-- | a lambda applied: its parameters bound to the arguments (not
-- | simplified yet: `simp` does it once all are bound), and what is left
-- | applied to the rest
applyLam : SK -> List String -> I.Expr -> List I.Expr -> M I.Expr
applyLam r xs b as = do
  red <-
    r.simp
      (letsOf
         (zipL
            (takeL (minI (List.length xs) (List.length as)) xs)
            (takeL (minI (List.length xs) (List.length as)) as))
         (if List.length xs > minI (List.length xs) (List.length as)
            then ELam (dropL (minI (List.length xs) (List.length as)) xs) b
          else b))
  r.applyTo red (dropL (minI (List.length xs) (List.length as)) as)

-- (the expressions are the variables, in order)
varsAre : List String -> List I.Expr -> Bool
varsAre Nil Nil = True
varsAre (Cons x xs) (Cons (EVar y) es) = strEq x y && varsAre xs es
varsAre _ _ = False

-- | a function that is another name for a tag, `\x y -> C x y`: the tag
tagOfLam : List String -> I.Expr -> Maybe String
tagOfLam xs (ETag t es) = if varsAre xs es then Just t else Nothing
tagOfLam xs _ = Nothing

-- Specialisation
--------------------------------------------------------------------------------

-- A known definition that is not inlined -- it calls itself, or is too
-- big -- given arguments known where it is called (a definition that is
-- a function or a record, a closed lambda or record) is called as a copy
-- of it made for them: their parameters gone, the arguments in their
-- place, the copy simplified with them (`e.hmap`, `hd.bind`, `r.simp`
-- known now: inlined, or calls of known definitions in turn).  For a
-- definition that calls itself, only the parameters every call of
-- itself hands on unchanged (`Sp.statics`): its calls are of the copy
-- then.
--
-- A copy is the same whoever asks for it, and wherever: it is named by
-- what it is made for (`Sp.copyName`, of its key, the known arguments
-- shaped: `Sp.shapeOf`), and asked for by that name, which is all a
-- call of it needs.  What is known of it (`knowing`) is what it is as
-- asked for, simplified with no copy asked for in it: the same whoever
-- asks.  (What making it comes to would be known, or not, by who asked
-- first -- and not at all by a copy asked for while it is made.)  Each
-- is made once in the program, after the definition that first calls
-- it, as a definition is: with fuel of its own, the copies it calls for
-- made in turn, each before what calls it.

-- | the most that is made: the size of a definition copied, copies
-- | asked for by one definition (or copy) as it is simplified, copies of
-- | copies one inside another
specBodySize : Int
specBodySize = 1200

specLimit : Int
specLimit = 50000

specDepth : Int
specDepth = 16

-- | an argument a copy may be made for
knownArg : M.Map String Unit -> I.Expr -> Bool
knownArg kinds (EGlobal g) = M.member compareString g kinds
knownArg kinds e = closedKnown e

nthE : Int -> List I.Expr -> Maybe I.Expr
nthE i Nil = Nothing
nthE i (Cons x xs) = if i == 0 then Just x else nthE (i - 1) xs

markGo : M.Map String Unit -> List I.Expr -> List Bool -> Int -> List Bool
markGo all as Nil i = Nil
markGo all as (Cons st rest) i =
  Cons
    (st && maybe False (\a -> knownArg all a) (nthE i as))
    (markGo all as rest (i + 1))

-- | the parameters a copy is made for: known there, and handed on as
-- | they are if `g` calls itself
marksOf : M.Map String Unit
        -> String
        -> List String
        -> I.Expr
        -> List I.Expr
        -> List Bool
marksOf all g xs b as =
  markGo
    all
    as
    (if elemStr g (I.globalsIn b) then Sp.statics g xs b
     else List.map (\x -> True) xs)
    0

specKey : String -> List Bool -> List I.Expr -> String
specKey g marks as =
  g
  ^ "("
  ^ joinWith
    ","
    (List.zipWith
       (\m a -> if m then Sp.key a else "_")
       marks
       (takeL (List.length marks) as))
  ^ ")"

keepParams : List Bool -> List String -> List String
keepParams Nil xs = xs
keepParams (Cons m ms) Nil = Nil
keepParams (Cons m ms) (Cons x xs) =
  if m then keepParams ms xs else Cons x (keepParams ms xs)

-- | each marked parameter replaced by its argument, a copy each time
substMarked : List Bool -> List String -> List I.Expr -> I.Expr -> M I.Expr
substMarked (Cons m ms) (Cons x xs) (Cons a as) e =
  if m
    then do
      e2 <- substCopies x a e
      substMarked ms xs as e2
  else substMarked ms xs as e
substMarked _ _ _ e = pure e

-- | the arguments a copy is asked for with: the marked ones shaped, the
-- | literals taken out of them (`vars`, given `holes` where it is
-- | called), each in order
type Shapes = { args : List I.Expr, vars : List String, holes : List I.Expr }

shapeCons : I.Expr -> List String -> List I.Expr -> Shapes -> Shapes
shapeCons a vs hs rest =
  { args = Cons a rest.args
  , vars = appendL vs rest.vars
  , holes = appendL hs rest.holes
  }

shapedTo : Sp.Shaped -> St -> Pair Sp.Shaped St
shapedTo x s = MkPair x (withSupply x.n s)

shapeOne : Bool -> I.Expr -> M Sp.Shaped
shapeOne m a = \s ->
    if m then shapedTo (Sp.shapeOf s.supply a) s
    else MkPair { e = a, vars = Nil, holes = Nil, n = s.supply } s

shapesOf : List Bool -> List I.Expr -> M Shapes
shapesOf (Cons m ms) (Cons a as) = do
  x <- shapeOne m a
  rest <- shapesOf ms as
  pure (shapeCons x.e x.vars x.holes rest)
shapesOf _ as = pure { args = as, vars = Nil, holes = Nil }

isKind : I.Expr -> Bool
isKind (ELam _ _) = True
isKind (ERecord _) = True
isKind _ = False

-- | a definition simplified that is a function, or a value computing
-- | nothing, is safe to use anywhere
markSafe : String -> I.Expr -> M Unit
markSafe h b = \s ->
    MkPair
      MkUnit
      (if I.isValue b || pureIn s.safe s.total b then withSafe h s else s)

-- | ... and so is such a copy, as the definitions it was made from were
-- | (`safeGlobals`): judged by what was known of the definitions before
-- | any was simplified, and of the copies (`base`) -- so that it is the
-- | same whoever asks for the copy first.  (A definition that is safe
-- | only once simplified is not yet while it asks, and is when a later
-- | one asks.)
markCopySafe : String -> I.Expr -> M Unit
markCopySafe h b = \s ->
    MkPair
      MkUnit
      (if I.isValue b || pureIn s.base s.total b then withSafe h (withBase h s)
       else s)

-- | a copy asked for, as it is (`b0`, its parameters put in): what is
-- | known of it, and how deep in copies of copies it is
askedFor : String -> I.Expr -> Int -> M Unit
askedFor h b0 d = \s ->
    MkPair
      MkUnit
      (withSp
         { all =
             if not (I.sizeAbove specBodySize b0)
               then M.insert compareString h b0 s.sp.all
             else s.sp.all
         , kinds =
             if isKind b0 then M.insert compareString h MkUnit s.sp.kinds
             else s.sp.kinds
         , recipes = M.insert compareString h b0 s.sp.recipes
         , depths = M.insert compareString h d s.sp.depths
         , made = s.sp.made
         , count = s.sp.count + 1
         , off = s.sp.off
         }
         s)

-- | the copy's body: its literals and the parameters left, the calls of
-- | itself of it
specBody : String -> String -> List Bool -> Shapes -> I.Expr -> M I.Expr
specBody g h marks sh (ELam xs1 b1) = do
  b2 <-
    substMarked
      marks
      xs1
      sh.args
      (Sp.selfTo g h (List.map (\v -> EVar v) sh.vars) marks b1)
  pure
      (if List.null (appendL sh.vars (keepParams marks xs1)) then b2
       else ELam (appendL sh.vars (keepParams marks xs1)) b2)
specBody g h marks sh lam1 = pure lam1

-- Arity
--------------------------------------------------------------------------------

-- A function whose every way out is a lambda, `\n -> if n <= 0 then (\hd
-- k -> a) else (\hd k -> b)` -- a computation (`Co`), made of a few
-- arguments -- takes those lambdas' parameters as its own: `\n hd k ->
-- if n <= 0 then a else b`.  A call given them all is one call, and a
-- copy may be made for them (the handler: `hd.bind`, known).  Only what
-- is cheap is crossed -- a value bound, a test of what is at hand: it is
-- computed again each time the function is given its first arguments
-- and applied -- and nothing that may fail.

-- | computing it is little, and cannot fail
cheap : M.Map String Unit -> I.Expr -> Bool
cheap safe (EVar _) = True
cheap safe (EGlobal g) = M.member compareString g safe
cheap safe (ELam _ _) = True
cheap safe (EPrim _) = True
cheap safe (EInt _) = True
cheap safe (EFloat _) = True
cheap safe (EStr _) = True
cheap safe (EFixed _ _) = True
cheap safe (EFloat32 _) = True
cheap safe (ETag _ as) = I.allI (List.map (cheap safe) as)
cheap safe (ERecord fs) = I.allI (List.map (cheap safe) (List.map snd fs))
cheap safe (EProj e _ _) = cheap safe e
cheap safe (ELet _ a b) = cheap safe a && cheap safe b
cheap safe (EPrimCall p as) =
  not (primFails p) && I.allI (List.map (cheap safe) as)
cheap safe _ = False

minL : List Int -> Int
minL Nil = 0
minL (Cons x xs) = List.foldl (\m y -> minI m y) x xs

-- | how many parameters every way out of it takes
lamsOut : M.Map String Unit -> I.Expr -> Int
lamsOut safe (ELam ys _) = List.length ys
lamsOut safe (ELet _ a b) = if cheap safe a then lamsOut safe b else 0
lamsOut safe (EMatch sc arms) =
  if cheap safe sc && not (List.null arms)
    then minL (List.map (lamsOut safe) (List.map I.armBody arms))
  else 0
lamsOut safe _ = 0

-- | each way out without its first lambdas, their parameters `zs`
stripArm : (I.Expr -> I.Expr) -> I.Arm -> I.Arm
stripArm go (MkArm t vs b) = MkArm t vs (go b)

stripLams : List String -> I.Expr -> I.Expr
stripLams zs (ELam ys b) =
  I.subst
    (paramsTo ys (List.map (\z -> EVar z) zs))
    (if List.length ys > List.length zs then ELam (dropL (List.length zs) ys) b
     else b)
stripLams zs (ELet x a b) = ELet x a (stripLams zs b)
stripLams zs (EMatch sc arms) =
  EMatch sc (List.map (stripArm (stripLams zs)) arms)
stripLams zs e = e

raiseWith : List String -> I.Expr -> List String -> I.Expr
raiseWith xs b zs = ELam (appendL xs zs) (stripLams zs b)

-- | a function, taking the parameters every way out of it does.  A
-- | definition that is not a function but whose every way out is a
-- | lambda past what is cheap -- a computation, `peek = let c = ... in
-- | \hd k -> ...` -- becomes one: what it computed once it computes at
-- | each call, which is little and cannot fail, and its handler is a
-- | parameter a copy can be made for
raise : I.Expr -> M I.Expr
raise (ELam xs b) = do
  s <- get
  if lamsOut s.safe b == 0 then pure (ELam xs b)
    else do
      zs <- freshParams (lamsOut s.safe b)
      pure (raiseWith xs b zs)
raise e = do
  s <- get
  if lamsOut s.safe e == 0 then pure e
    else do
      zs <- freshParams (lamsOut s.safe e)
      pure (ELam zs (stripLams zs e))

-- (the arguments a copy is made for)
markedOf : List Bool -> List I.Expr -> List I.Expr
markedOf (Cons m ms) (Cons a as) =
  if m then Cons a (markedOf ms as) else markedOf ms as
markedOf _ _ = Nil

maxI : Int -> Int -> Int
maxI a b = if a >= b then a else b

-- | how deep in copies of copies a copy of `g` for `args` is: one more
-- | than the deepest copy among them
depthOf : M.Map String Int -> String -> List I.Expr -> Int
depthOf ds g args =
  1
  + List.foldl
    (\d n -> maxI d (fromMaybe 0 (M.lookup compareString n ds)))
    0
    (Cons g (List.concatMap I.globalsIn args))

-- What a definition is simplified with is its own: its fuel, the calls
-- found plain (`plain`) and how many copies it may ask for are made anew
-- for each definition and each copy -- so that what it comes to depends
-- on what it uses, not on what was simplified before it.

-- (a definition's own: fuel, no call found plain for another, and no
-- copy asked for yet)
ownSt : M Unit
ownSt = \s ->
    MkPair
      MkUnit
      { supply = s.supply
      , fuel = 4000
      , defs = s.defs
      , safe = s.safe
      , base = s.base
      , total = s.total
      , plain = M.empty
      , sp =
          { all = s.sp.all
          , kinds = s.sp.kinds
          , recipes = s.sp.recipes
          , depths = s.sp.depths
          , made = s.sp.made
          , count = 0
          , off = s.sp.off
          }
      , kp = s.kp
      }

-- (asking for copies off, or on again)
setOff : Bool -> M Unit
setOff o = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , recipes = s.sp.recipes
         , depths = s.sp.depths
         , made = s.sp.made
         , count = s.sp.count
         , off = o
         }
         s)

-- (back to what `saved` was simplifying: its fuel, the calls it found
-- plain, how many copies it asked for and whether it asks for more --
-- the rest learnt kept)
backTo : St -> M Unit
backTo saved = \s ->
    MkPair
      MkUnit
      { supply = s.supply
      , fuel = saved.fuel
      , defs = s.defs
      , safe = s.safe
      , base = s.base
      , total = s.total
      , plain = saved.plain
      , sp =
          { all = s.sp.all
          , kinds = s.sp.kinds
          , recipes = s.sp.recipes
          , depths = s.sp.depths
          , made = s.sp.made
          , count = saved.sp.count
          , off = saved.sp.off
          }
      , kp = s.kp
      }

-- The cache
--------------------------------------------------------------------------------

-- What a definition or a copy is simplified to depends on what it is
-- made of alone (see `ownSt`), so the backend's cache keeps it, by its
-- version (heff.build.backcache): a definition's is given, what it is
-- made of in the core, hashed; a copy's (`copyVer`) is its name and the
-- versions of the definition copied and of the globals in the arguments
-- it is made for.  A copy is asked for as the cache keeps it, if it
-- keeps it at that version -- what it is known by not found again --
-- and made as the cache keeps it, if it keeps that too, the copies it
-- asked for as it was made asked for.

-- (the cache's knowledge, changed by `f`)
keepWith : (Keep -> Keep) -> M Unit
keepWith f = \s -> MkPair MkUnit (withKp (f s.kp) s)

touchedTo : List String -> Keep -> Keep
touchedTo t k =
  { vers = k.vers
  , kept = k.kept
  , touched = t
  , fresh = k.fresh
  , madeFresh = k.madeFresh
  }

verTo : String -> String -> Keep -> Keep
verTo h v k =
  { vers = M.insert compareString h v k.vers
  , kept = k.kept
  , touched = k.touched
  , fresh = k.fresh
  , madeFresh = k.madeFresh
  }

freshTo : String -> Keep -> Keep
freshTo h k =
  { vers = k.vers
  , kept = k.kept
  , touched = k.touched
  , fresh = M.insert compareString h MkUnit k.fresh
  , madeFresh = k.madeFresh
  }

madeFreshTo : String -> List String -> Keep -> Keep
madeFreshTo h t k =
  { vers = k.vers
  , kept = k.kept
  , touched = k.touched
  , fresh = k.fresh
  , madeFresh = M.insert compareString h t k.madeFresh
  }

getTouched : M (List String)
getTouched = \s -> MkPair s.kp.touched s

-- | the copy `h`, of version `v`, asked for by what is being simplified
touch : String -> String -> M Unit
touch h v = keepWith (\k -> touchedTo (Cons h k.touched) (verTo h v k))

consVer : String -> Maybe (List String) -> Maybe (List String)
consVer v (Just vs) = Just (Cons v vs)
consVer v Nothing = Nothing

-- (each version, if every one is known)
versAll : List (Maybe String) -> Maybe (List String)
versAll Nil = Just Nil
versAll (Cons (Just v) rest) =
  if strEq v "" then Nothing else consVer v (versAll rest)
versAll (Cons Nothing rest) = Nothing

verFrom : String -> Maybe (List String) -> String
verFrom h (Just vs) = Ir.hashOf (Cons (HS h) (List.map (\v -> HS v) vs))
verFrom h Nothing = ""

-- | the version of the copy `h` of `g` made for `args`: none (`""`)
-- | if any of them has none
copyVer : M.Map String String -> String -> String -> List I.Expr -> String
copyVer vers h g args =
  verFrom
    h
    (versAll
       (List.map
          (\k -> M.lookup compareString k vers)
          (Cons g (List.concatMap I.globalsIn args))))

keptIf : String -> Maybe KeptCopy -> Maybe KeptCopy
keptIf v (Just kc) =
  if strEq kc.ver v && not (strEq v "") then Just kc else Nothing
keptIf v Nothing = Nothing

-- | the copy `h` as the cache keeps it, if it keeps it at the version
-- | it has here
keptAt : St -> String -> Maybe KeptCopy
keptAt s h = case M.lookup compareString h s.kp.vers of
  Just v -> keptIf v (M.lookup compareString h s.kp.kept)
  Nothing -> Nothing

markSafeAs : Bool -> String -> M Unit
markSafeAs True h = \s -> MkPair MkUnit (withSafe h (withBase h s))
markSafeAs False h = pure MkUnit

askKept : String -> KeptCopy -> Maybe I.Expr -> M Bool
askKept h kc (Just b) = do
  b1 <- copy b
  u <- askedFor h b1 kc.depth
  u2 <- markSafeAs kc.safe h
  pure True
askKept h kc Nothing = pure False

-- | the copy `h` asked for as the cache keeps it, if it does
fromKept : String -> M Bool
fromKept h = do
  s <- get
  case keptAt s h of
    Just kc -> askKept h kc (kc.recipe MkUnit)
    Nothing -> pure False

-- | the copy `h`, of version `v`, asked for if it is not yet: as the
-- | cache keeps it (`False`: it does not)
keptAsk : String -> String -> M Bool
keptAsk h v = do
  s <- get
  if M.member compareString h s.sp.recipes then pure True
    else do
      u <- keepWith (verTo h v)
      fromKept h

-- | ... each
allAsked : List (Pair String String) -> M Bool
allAsked Nil = pure True
allAsked (Cons (MkPair h v) rest) = do
  ok <- keptAsk h v
  if ok then allAsked rest else pure False

madeKept : KeptMade -> Maybe I.Expr -> M (Maybe I.Expr)
madeKept km (Just b) = do
  ok <- allAsked km.touched
  if ok
      then do
        b1 <- copy b
        pure (Just b1)
    else pure Nothing
madeKept km Nothing = pure Nothing

keptMadeOf : Maybe KeptCopy -> M (Maybe I.Expr)
keptMadeOf (Just kc) = case kc.made of
  Just km -> madeKept km (km.body MkUnit)
  Nothing -> pure Nothing
keptMadeOf Nothing = pure Nothing

-- | the copy `h` made, as the cache keeps it, if it does: the copies it
-- | asked for as it was made asked for
keptMade : String -> M (Maybe I.Expr)
keptMade h = do
  s <- get
  keptMadeOf (keptAt s h)

-- | what a copy asked for is known by: what it is as asked for (`b0`),
-- | simplified as a definition is but with no copy asked for in it --
-- | its calls of itself, the definitions it is made with inlined, seen
-- | -- so that it is the same whoever asks for it, and whatever was
-- | made before
knowing : SK -> I.Expr -> M I.Expr
knowing r b0 = do
  saved <- get
  u <- ownSt
  u1 <- setOff True
  b1 <- r.simp b0
  b2 <- r.simp b1
  b3 <- raise b2
  u2 <- backTo saved
  pure b3

-- | the copy named `h` asked for: if it was not before, what it is
-- | known by kept (to make it from, too) -- as the cache keeps it, if it
-- | does
ask : SK
    -> String
    -> List String
    -> I.Expr
    -> List Bool
    -> Shapes
    -> String
    -> Int
    -> M Unit
ask r g xs b marks sh h d = do
  s <- get
  u0 <- touch h (copyVer s.kp.vers h g (markedOf marks sh.args))
  if M.member compareString h s.sp.recipes then pure MkUnit
    else do
      hit <- fromKept h
      if hit then pure MkUnit
        else do
          lam1 <- copy (ELam xs b)
          b0 <- specBody g h marks sh lam1
          b1 <- knowing r b0
          u <- askedFor h b1 d
          u2 <- keepWith (freshTo h)
          markCopySafe h b1

-- (... named `h`, `d` deep in copies of copies)
specNamed : SK
          -> String
          -> List String
          -> I.Expr
          -> List I.Expr
          -> List Bool
          -> Shapes
          -> String
          -> Int
          -> M I.Expr
specNamed r g xs b as marks sh h d =
  if d > specDepth then pure (mkApp (EGlobal g) as)
  else do
    u <- ask r g xs b marks sh h d
    -- (the copy called, and a copy of it asked for if it may be, for
    -- what it takes now)
    r.applyTo (EGlobal h) (appendL sh.holes (Sp.dropAt marks as))

-- (a copy that would take nothing but the literals of what it is made
-- for is not made: what it computes, once, would be computed at each
-- call)
specShaped : SK
           -> String
           -> List String
           -> I.Expr
           -> List I.Expr
           -> List Bool
           -> Shapes
           -> M I.Expr
specShaped r g xs b as marks sh = \s ->
    if List.null (keepParams marks xs) && not (List.null sh.vars)
      then MkPair (mkApp (EGlobal g) as) s
    else specNamed
        r
        g
        xs
        b
        as
        marks
        sh
        (Sp.copyName g (specKey g marks sh.args))
        (depthOf s.sp.depths g (markedOf marks sh.args))
        s

specMarked : SK
           -> String
           -> List String
           -> I.Expr
           -> List I.Expr
           -> List Bool
           -> M I.Expr
specMarked r g xs b as marks =
  if not (List.any (\m -> m) marks)
  -- (a copy taking nothing is a value: calling itself, only where that
  -- is under a lambda -- a knot of judgments, `uk w ms uf` -- not one
  -- computed by itself)
  || (List.null (keepParams marks xs)
      && elemStr g (I.globalsIn b)
      && not (I.isValue b))
    then pure (mkApp (EGlobal g) as)
  else do
    sh <- shapesOf marks as
    specShaped r g xs b as marks sh

specLam : SK -> String -> List String -> I.Expr -> List I.Expr -> M I.Expr
specLam r g xs b as = do
  s <- get
  if s.sp.off
    || s.sp.count >= specLimit
    || not (List.any (\a -> knownArg s.sp.kinds a) as)
      then pure (mkApp (EGlobal g) as)
    else specMarked r g xs b as (marksOf s.sp.kinds g xs b as)

-- | a call of a definition not inlined: of a copy of it, if one may be
-- | made
trySpec : SK -> String -> List I.Expr -> M I.Expr
trySpec r g as = do
  s <- get
  case M.lookup compareString g s.sp.all of
    Just (ELam xs b) -> specLam r g xs b as
    _ -> pure (mkApp (EGlobal g) as)

-- | whether it is still the call of `g` it was
stillCall : String -> I.Expr -> Bool
stillCall g (EApp (EGlobal h) _) = strEq g h
stillCall g _ = False

specAfter : SK -> String -> List I.Expr -> I.Expr -> M I.Expr
specAfter r g as e = if stillCall g e then trySpec r g as else pure e

fieldIn : String -> List (Pair String I.Expr) -> Maybe I.Expr
fieldIn l Nil = Nothing
fieldIn l (Cons (MkPair k v) rest) =
  if strEq k l then Just v else fieldIn l rest

-- | a field of a record that is a definition calling itself (one of
-- | knotted judgments, `sk.simp`): a copy of it, if it is a value
knownField : String -> String -> M (Maybe I.Expr)
knownField g l = do
  s <- get
  case M.lookup compareString g s.sp.all of
    Just (ERecord fs) -> case fieldIn l fs of
      Just v ->
        if I.isValue v && s.fuel > 0
          then do
            u <- put (withFuel (s.fuel - 1) s)
            e <- copy v
            pure (Just e)
        else pure Nothing
      Nothing -> pure Nothing
    _ -> pure Nothing

-- (an argument that may go into every arm of a match it is given to)
pushable : I.Expr -> Bool
pushable a = atomic a || (I.isValue a && closedKnown a)

-- | how big the copies the arms of a match are given may be, all told
pushBudget : Int
pushBudget = 120

-- (the size of what is not atomic among them)
copiedSize : List I.Expr -> Int
copiedSize as = List.foldl (\n a -> if atomic a then n else n + I.size a) 0 as

-- (the arguments may go into every arm: atomic, or closed values whose
-- copies, one for each arm but the first, are not too big)
pushInto : List I.Arm -> List I.Expr -> Bool
pushInto arms as =
  I.allI (List.map pushable as)
  && copiedSize as * (List.length arms - 1) <= pushBudget

-- (an arm given the arguments: a copy of each that is not atomic)
applyArm : SK -> I.Expr -> List I.Expr -> M I.Expr
applyArm r b as = do
  as2 <- traverseS (\a -> if atomic a then pure a else copy a) as
  r.applyTo b as2

-- | an application of simplified parts
applyToF : SK -> I.Expr -> List I.Expr -> M I.Expr
applyToF r f as =
  if List.length as == 0 then pure f
  else case f of
    EPrim p -> pure (mkApp f as)
    EApp g bs -> r.applyTo g (appendL bs as)
    -- (another name for a tag, given all its arguments: the tag given
    -- them, with no bindings between -- the tag computes its fields in
    -- order, as the bindings would, and a call in a field stays where
    -- a loop can build the value)
    ELam xs (ETag t es) ->
      if List.length xs == List.length as && varsAre xs es then pure (ETag t as)
      else applyLam r xs (ETag t es) as
    ELam xs b -> applyLam r xs b as
    ELet x a b -> do
      b' <- r.applyTo b as
      pure (ELet x a b')
    -- (the arguments go into every arm: only when that copies nothing
    -- but what a copy may be made for, a closed value -- a handler,
    -- which every arm is then made with)
    EMatch s arms ->
      if pushInto arms as
        then do
          arms' <- armsS (\b -> applyArm r b as) arms
          pure (EMatch s arms')
      else pure (mkApp (EMatch s arms) as)
    EGlobal g -> do
      s <- get
      e1 <- callOf r f g as (M.lookup compareString g s.defs)
      specAfter r g as e1
    -- (a field of a known record, applied: judged by what the
    -- application comes to, not by the size of the field)
    EProj (EGlobal g) l sh -> do
      mb <- known g
      case mb of
        Just b ->
          attempt (mkApp f as) (do
          h <- r.project l sh b
          r.applyTo h as)
        Nothing -> do
          mv <- knownField g l
          case mv of
            Just v -> attempt (mkApp f as) (r.applyTo v as)
            Nothing -> pure (mkApp f as)
    _ -> pure (mkApp f as)

findField : String -> List (Pair String I.Expr) -> Maybe I.Expr
findField l Nil = Nothing
findField l (Cons (MkPair k v) rest) =
  if strEq k l then Just v else findField l rest

-- (the other fields are computed too: dropped only if they cannot fail)
othersPure : String -> List (Pair String I.Expr) -> M Bool
othersPure l Nil = pure True
othersPure l (Cons (MkPair k f) rest) =
  if strEq k l then othersPure l rest
  else do
    p <- isPure f
    if p then othersPure l rest else pure False

projectF : SK -> String -> List String -> I.Expr -> M I.Expr
projectF r l sh (ERecord fs) = case findField l fs of
  Just v -> do
    others <- othersPure l fs
    pure (if others then v else EProj (ERecord fs) l sh)
  Nothing -> pure (EProj (ERecord fs) l sh)
projectF r l sh (ELet x a b) = do
  b' <- r.project l sh b
  pure (ELet x a b')
projectF r l sh e@(EGlobal g) = do
  mb <- known g
  case mb of
    Just b -> attempt (EProj e l sh) (r.project l sh b)
    Nothing -> pure (EProj e l sh)
projectF r l sh e = pure (EProj e l sh)

findArm : String -> List I.Arm -> Maybe I.Arm
findArm t Nil = Nothing
findArm t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t then Just (MkArm t2 vs b) else findArm t rest

-- Case of case
--------------------------------------------------------------------------------

-- A match on a match, `case (case a of True -> b; False -> False) of ...`
-- (`&&`, inlined), is the inner match with the outer one in each arm:
-- where an arm is a tag, the outer match chooses at once.  The outer
-- arms are copied into each inner one, so only when they are small.

-- | how big the outer arms may be, times the inner arms but one
caseBudget : Int
caseBudget = 40

tagBody : I.Arm -> Bool
tagBody (MkArm _ _ (ETag _ _)) = True
tagBody _ = False

armsOf : I.Expr -> List I.Arm
armsOf (EMatch _ arms) = arms
armsOf _ = Nil

-- (an inner arm, a copy of the outer match in it)
pushArm : SK -> List I.Arm -> I.Arm -> M I.Arm
pushArm r arms (MkArm t vs b) = do
  outer <- copy (EMatch EAbandon arms)
  b' <- r.match b (armsOf outer)
  pure (MkArm t vs b')

caseOfCase : SK -> I.Expr -> List I.Arm -> List I.Arm -> M I.Expr
caseOfCase r s2 arms2 arms =
  if List.any tagBody arms2
  && I.size (EMatch EAbandon arms) * (List.length arms2 - 1) <= caseBudget
    then do
      arms2' <- traverseS (pushArm r arms) arms2
      pure (EMatch s2 arms2')
  else pure (EMatch (EMatch s2 arms2) arms)

matchF : SK -> I.Expr -> List I.Arm -> M I.Expr
matchF r (EMatch s2 arms2) arms = caseOfCase r s2 arms2 arms
matchF r s@(ETag t as) arms = case findArm t arms of
  Just (MkArm _ vs b) -> r.simp (letsOf (zipL vs as) b)
  Nothing -> pure (EMatch s arms)
matchF r (ELet x a b) arms = do
  b' <- r.match b arms
  pure (ELet x a b')
matchF r s@(EGlobal g) arms = do
  mb <- known g
  case mb of
    Just (ETag t2 as2) -> r.match (ETag t2 as2) arms
    _ -> pure (EMatch s arms)
matchF r s arms = pure (EMatch s arms)

sk : SK
sk =
  { simp = \e -> simpF sk e
  , applyTo = \f as -> applyToF sk f as
  , project = \l sh e -> projectF sk l sh e
  , match = \s arms -> matchF sk s arms
  }

recordAll : String -> I.Expr -> St -> St
recordAll key b s =
  withSp
    { all =
        if not (I.sizeAbove specBodySize b)
          then M.insert compareString key b s.sp.all
        else s.sp.all
    , kinds =
        if isKind b then M.insert compareString key MkUnit s.sp.kinds
        else s.sp.kinds
    , recipes = s.sp.recipes
    , depths = s.sp.depths
    , made = s.sp.made
    , count = s.sp.count
    , off = s.sp.off
    }
    s

recordDef : String -> I.Expr -> M Unit
recordDef key b = \s ->
    -- a definition calling itself is never inlined
    MkPair
      MkUnit
      (recordAll
         key
         b
         (if elemStr key (I.globalsIn b) then s
          else withDefs (M.insert compareString key b s.defs) s))

-- | the copy named `h` taken as made
madeOne : String -> M Unit
madeOne h = \s ->
    MkPair
      MkUnit
      (withSp
         { all = s.sp.all
         , kinds = s.sp.kinds
         , recipes = s.sp.recipes
         , depths = s.sp.depths
         , made = M.insert compareString h MkUnit s.sp.made
         , count = s.sp.count
         , off = s.sp.off
         }
         s)

-- (the copy named `h`, as asked for, if it is not made yet)
pendingOf : St -> String -> Maybe I.Expr
pendingOf s h =
  if M.member compareString h s.sp.made then Nothing
  else M.lookup compareString h s.sp.recipes

-- (a copy made here: simplified as a definition is, from `b0`, what it
-- is known by -- the copies asked for as it is, kept for the cache)
makeFresh : String -> I.Expr -> M I.Expr
makeFresh h b0 = do
  outer <- getTouched
  u0 <- keepWith (touchedTo Nil)
  u2 <- ownSt
  b1 <- sk.simp b0
  b2 <- sk.simp b1
  b3 <- raise b2
  t <- getTouched
  u3 <- keepWith (\k -> madeFreshTo h t (touchedTo outer k))
  pure b3

madeBody : String -> I.Expr -> Maybe I.Expr -> M I.Expr
madeBody h b0 (Just b) = pure b
madeBody h b0 Nothing = makeFresh h b0

-- | a copy made -- as the cache keeps it, or here -- then the copies it
-- | calls for (`more`), before it
makeOne : (List String -> M (List I.Def)) -> String -> I.Expr -> M (List I.Def)
makeOne more h b0 = do
  u <- madeOne h
  kb <- keptMade h
  b3 <- madeBody h b0 kb
  deps <- more (I.globalsIn b3)
  pure (appendL deps (Cons (I.mkDef h h b3) Nil))

makeIf : (List String -> M (List I.Def))
       -> String
       -> Maybe I.Expr
       -> M (List I.Def)
makeIf more h (Just b0) = makeOne more h b0
makeIf more h Nothing = pure Nil

-- | the copies among `names` not made yet, made, each once in the
-- | program, and each after those it calls for
makeEach : List String -> M (List I.Def)
makeEach Nil = pure Nil
makeEach (Cons h rest) = do
  s <- get
  here <- makeIf makeEach h (pendingOf s h)
  others <- makeEach rest
  pure (appendL here others)

-- | a definition simplified here, as the cache is to keep it: what it
-- | came to, whether it is safe, and the copies it asked for, each by
-- | its name and version
type Done =
  { key : String
  , body : I.Expr
  , safe : Bool
  , touched : List (Pair String String)
  }

-- (each once, the first kept)
onceEach : M.Map String Unit -> List String -> List String
onceEach seen Nil = Nil
onceEach seen (Cons x xs) =
  if M.member compareString x seen then onceEach seen xs
  else Cons x (onceEach (M.insert compareString x MkUnit seen) xs)

-- (the copies asked for, the last first: each once, in order, with its
-- version)
touchedVers : M.Map String String -> List String -> List (Pair String String)
touchedVers vers t =
  List.map
    (\h -> MkPair h (fromMaybe "" (M.lookup compareString h vers)))
    (onceEach M.empty (List.reverse t))

doneOf : St -> I.Def -> I.Expr -> List String -> Done
doneOf s d b t =
  { key = d.key
  , body = b
  , safe = M.member compareString d.key s.safe
  , touched = touchedVers s.kp.vers t
  }

-- | a definition simplified, after the copies it calls for; and what the
-- | cache is to keep of it
oneDef : I.Def -> M (Pair (List I.Def) (List Done))
oneDef d = do
  u <- ownSt
  u0 <- keepWith (touchedTo Nil)
  -- (twice: what the first pass exposes, the second reduces)
  b1 <- sk.simp d.body
  b2 <- sk.simp b1
  b <- raise b2
  t <- getTouched
  u2 <- recordDef d.key b
  u3 <- markSafe d.key b
  s <- get
  made <- makeEach (I.globalsIn b)
  pure
      (MkPair
         (appendL made (Cons (I.mkDef d.key d.name b) Nil))
         (Cons (doneOf s d b t) Nil))

-- | a definition as the cache keeps it, simplified: what it came to
-- | (read when wanted), whether it is safe, the copies it asked for (by
-- | name and version) -- and, before it was, whether it was safe and how
-- | many arguments its application takes and cannot fail with
-- | (`safeGlobals`; -1: none)
type KeptDef =
  { key : String
  , name : String
  , body : Unit -> Maybe I.Expr
  , safe : Bool
  , touched : List (Pair String String)
  , sgSafe : Bool
  , sgTotal : Int
  }

-- | what is to be simplified: a definition, or one the cache keeps --
-- | with how to have the definition (erased, from where names are drawn
-- | on), should the cache not do (a copy it asked for not kept)
data Item = Fresh I.Def | Kept KeptDef (Int -> Pair (Maybe I.Def) Int)

safeAs : Bool -> String -> M Unit
safeAs True k = \s -> MkPair MkUnit (withSafe k s)
safeAs False k = pure MkUnit

replayBody : KeptDef -> I.Expr -> M (List I.Def)
replayBody k b0 = do
  b <- copy b0
  u <- recordDef k.key b
  u2 <- safeAs k.safe k.key
  made <- makeEach (I.globalsIn b)
  pure (appendL made (Cons (I.mkDef k.key k.name b) Nil))

replayed : KeptDef -> Maybe I.Expr -> M (Maybe (List I.Def))
replayed k (Just b0) = do
  ok <- allAsked k.touched
  if ok
      then do
        ds <- replayBody k b0
        pure (Just ds)
    else pure Nothing
replayed k Nothing = pure Nothing

supplyTo : Int -> M Unit
supplyTo n = \s -> MkPair MkUnit (withSupply n s)

afresh : Pair (Maybe I.Def) Int -> M (Pair (List I.Def) (List Done))
afresh (MkPair (Just d) n) = do
  u <- supplyTo n
  oneDef d
afresh (MkPair Nothing n) = pure (MkPair Nil Nil)

orAfresh : St
         -> (Int -> Pair (Maybe I.Def) Int)
         -> Maybe (List I.Def)
         -> M (Pair (List I.Def) (List Done))
orAfresh saved redo (Just ds) = pure (MkPair ds Nil)
orAfresh saved redo Nothing = do
  u <- put saved
  afresh (redo saved.supply)

-- | a definition the cache keeps, taken as it keeps it -- the copies it
-- | asked for asked for, what it came to recorded, the copies it calls
-- | for made -- or simplified afresh, if the cache does not keep a copy
-- | it asked for
oneKept : KeptDef
        -> (Int -> Pair (Maybe I.Def) Int)
        -> M (Pair (List I.Def) (List Done))
oneKept k redo = do
  saved <- get
  r <- replayed k (k.body MkUnit)
  orAfresh saved redo r

oneItem : Item -> M (Pair (List I.Def) (List Done))
oneItem (Fresh d) = oneDef d
oneItem (Kept k redo) = oneKept k redo

-- | a copy asked for or made here, as the cache is to keep it: its
-- | version, what it is known by, how deep, whether safe, and what it was
-- | made to, with the copies it asked for as it was, if it was made here
type CopyDone =
  { name : String
  , ver : String
  , recipe : I.Expr
  , depth : Int
  , safe : Bool
  , made : Maybe (Pair I.Expr (List (Pair String String)))
  }

type Simplified =
  { defs : List I.Def, supply : Int, done : List Done, copies : List CopyDone }

concatDefs : {a : Type} -> List (List a) -> List a
concatDefs Nil = Nil
concatDefs (Cons ds rest) = appendL ds (concatDefs rest)

allVersKnown : List (Pair String String) -> Bool
allVersKnown ps = List.all (\p -> not (strEq (snd p) "")) ps

madeWith : List (Pair String String)
         -> Maybe I.Expr
         -> Maybe (Pair I.Expr (List (Pair String String)))
madeWith tv (Just b) = if allVersKnown tv then Just (MkPair b tv) else Nothing
madeWith tv Nothing = Nothing

-- (what a copy made here was made to, with what it asked for, if every
-- one of those has a version)
madeOf : St
       -> M.Map String I.Expr
       -> String
       -> Maybe (Pair I.Expr (List (Pair String String)))
madeOf st bodies h = case M.lookup compareString h st.kp.madeFresh of
  Just t ->
    madeWith (touchedVers st.kp.vers t) (M.lookup compareString h bodies)
  Nothing -> Nothing

copyWith : St
         -> M.Map String I.Expr
         -> String
         -> String
         -> I.Expr
         -> Maybe CopyDone
copyWith st bodies h v r =
  if strEq v "" then Nothing
  else Just
      { name = h
      , ver = v
      , recipe = r
      , depth = fromMaybe 0 (M.lookup compareString h st.sp.depths)
      , safe = M.member compareString h st.base
      , made = madeOf st bodies h
      }

copyDone : St -> M.Map String I.Expr -> String -> Maybe CopyDone
copyDone st bodies h = case M.lookup compareString h st.sp.recipes of
  Just r ->
    copyWith st bodies h (fromMaybe "" (M.lookup compareString h st.kp.vers)) r
  Nothing -> Nothing

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) rest) = Cons x (catMaybesS rest)
catMaybesS (Cons Nothing rest) = catMaybesS rest

bodiesMap : List I.Def -> M.Map String I.Expr
bodiesMap defs =
  List.foldl
    (\m (d : I.Def) -> M.insert compareString d.key d.body m)
    M.empty
    defs

-- (the copies asked for or made here)
copiesDone : St -> List I.Def -> List CopyDone
copiesDone st defs =
  catMaybesS
    (List.map
       (copyDone st (bodiesMap defs))
       (onceEach
          M.empty
          (List.append
             (List.map fst (M.toList st.kp.fresh))
             (List.map fst (M.toList st.kp.madeFresh)))))

simplifyDone : Pair (List (Pair (List I.Def) (List Done))) St -> Simplified
simplifyDone (MkPair out st) =
  { defs = concatDefs (List.map fst out)
  , supply = st.supply
  , done = concatDefs (List.map snd out)
  , copies = copiesDone st (concatDefs (List.map fst out))
  }

initSt : Int -> SG -> Keep -> St
initSt n0 sg kp =
  { supply = n0
  , fuel = 0
  , defs = M.empty
  , safe = sg.safe
  , base = sg.safe
  , total = sg.total
  , plain = M.empty
  , sp =
      { all = M.empty
      , kinds = M.empty
      , recipes = M.empty
      , depths = M.empty
      , made = M.empty
      , count = 0
      , off = False
      }
  , kp = kp
  }

-- | each definition, in order, simplified; what is inlined is taken
-- | simplified already
-- | >>> List.map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "f" "f" (EApp (ELam ["x"] (EVar "x")) [EInt 1])]).defs
-- | [EInt 1]
-- | >>> List.map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "g" "g" (EMatch (ETag "Just" [EInt 5]) [MkArm "Just" ["x"] (EVar "x"), MkArm "Nothing" [] (EInt 0)])]).defs
-- | [EInt 5]
-- |
-- | another name for a tag, given a call: the tag given it, no binding
-- | between, so a loop can build the value
-- | >>> List.map (\(d : I.Def) -> d.body) (simplifyProgram 0 [I.mkDef "c" "c" (ELam ["x", "y"] (ETag "Cons" [EVar "x", EVar "y"])), I.mkDef "f" "f" (ELam ["z"] (EApp (EApp (EGlobal "c") [EPrimCall "add" [EVar "z"]]) [EApp (EGlobal "f") [EVar "z"]]))]).defs
-- | [ELam ["x", "y"] (ETag "Cons" [EVar "x", EVar "y"]), ELam ["z"] (ETag "Cons" [EPrimCall "add" [EVar "z"], EApp (EGlobal "f") [EVar "z"]])]
-- |
-- | two arguments alike but for a number in them: one copy, the number
-- | given it where it is called
-- | >>> List.length (List.filter (\(d : I.Def) -> strEq (Sp.rootOf d.key) "m" && not (strEq d.key "m")) (simplifyProgram 0 [I.mkDef "m" "m" (ELam ["f", "xs"] (EMatch (EVar "xs") [MkArm "Nil" [] (ETag "Nil" []), MkArm "Cons" ["x", "r"] (ETag "Cons" [EApp (EVar "f") [EVar "x"], EApp (EGlobal "m") [EVar "f", EVar "r"]])])), I.mkDef "a" "a" (ELam ["us"] (EApp (EGlobal "m") [ELam ["u"] (EPrimCall "intAdd" [EVar "u", EInt 1]), EVar "us"])), I.mkDef "b" "b" (ELam ["vs"] (EApp (EGlobal "m") [ELam ["v"] (EPrimCall "intAdd" [EVar "v", EInt 2]), EVar "vs"]))]).defs)
-- | 1
simplifyProgram : Int -> List I.Def -> Simplified
simplifyProgram n0 defs =
  simplifyDone
    (traverseS (\d -> oneDef d) defs (initSt n0 (safeGlobals defs) noKeep))

sgItem : SG -> Item -> SG
sgItem acc (Fresh d) = sgFlat acc d.key (flat d.body)
sgItem acc (Kept k _) =
  { safe =
      if k.sgSafe then M.insert compareString k.key MkUnit acc.safe
      else acc.safe
  , total =
      if k.sgTotal >= 0 then M.insert compareString k.key k.sgTotal acc.total
      else acc.total
  }

-- | `safeGlobals`, of what is to be simplified
safeItems : List Item -> SG
safeItems items = List.foldl sgItem { safe = M.empty, total = M.empty } items

-- | each definition, in order, simplified as `simplifyProgram` does --
-- | or, one the cache keeps, as it keeps it.  `sg`: what `safeItems`
-- | says of them; `vers`: each definition's version; `kept`: the copies
-- | the cache keeps
simplifyItems : Int
              -> SG
              -> M.Map String String
              -> M.Map String KeptCopy
              -> List Item
              -> Simplified
simplifyItems n0 sg vers kept items =
  simplifyDone
    (traverseS
       oneItem
       items
       (initSt
          n0
          sg
          { vers = vers
          , kept = kept
          , touched = Nil
          , fresh = M.empty
          , madeFresh = M.empty
          }))
