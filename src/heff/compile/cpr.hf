-- Constructed results (#80, GHC's "constructed product result"): a
-- function that gives back a tag or a record it builds where it ends --
-- nbody's `pull`, `MkPair b rest`; a `Just x` -- is given a worker
-- (`f$cpr`) that gives back the fields instead, unbuilt: a tuple
-- (`Repr.tupleTag`), the tag's number first where it may give back more
-- than one tag, then the fields, each in a place of its kind (a `V`, or a
-- number's bits: `Repr.flatOf`), the places shared by the tags -- so a
-- `Maybe Float64` is two words, an `Either Int64 Float64` three.  The
-- function itself is its wrapper, which calls the worker and builds the
-- tag of what it gives back: what a closure, or a call whose value goes
-- on as it is, calls.
--
-- A call taking what it gives apart at once -- `case f x of MkPair a b
-- -> ...`, or a binding of it only matched on, or only read fields of --
-- calls the worker and is given the fields: no tag is built.  A match on
-- it chooses its arm by the tuple's number.  heff.compile.emitc gives a
-- tuple back as a struct of words, in registers; the JavaScript backend
-- builds it as any tag.
--
-- A function has a worker only where every way out of it builds the tag
-- (or the record) there, abandons, or calls last a function with a
-- worker: what it gives back is seen by nothing before.  Such a call is a
-- call last of the other's worker, so a call of itself is still the loop
-- it was.  The functions calling one another last are given one layout,
-- of at most `maxWords` words and `maxTags` tags, and only where some
-- call takes what one of them gives apart (else the wrapper would only
-- cost a call more).
--
-- This runs on what is lowered (heff.compile.lower), each call at its
-- arity, for both backends, after heff.compile.trmc (a cell built to be
-- filled is not given back).

module heff.compile.cpr

import heff.compile.ir as IR
import heff.elab.primitive
import heff.compile.repr as Repr
import heff.compile.supply
import heff.elab.fixed as Fixed
import std.ordmap as OrdMap

sameLabels : List String -> List String -> Bool
sameLabels Nil Nil = True
sameLabels (Cons a args) (Cons b bs) = strEq a b && sameLabels args bs
sameLabels _ _ = False

isVar : String -> IR.Expr -> Bool
isVar x (EVar y) = strEq x y
isVar x _ = False

-- | how many words a tuple may be
maxWords : Int
maxWords = 4

-- | how many tags a function with a worker may give back
maxTags : Int
maxTags = 4

-- | a function's worker
workerKey : String -> String
workerKey g = g ^ "$cpr"

-- Ways out
--------------------------------------------------------------------------------

-- | a way out of a function: a tag built, of its fields' types; a
-- | record built, of its labels and their types; a call last; anything
-- | else (`abandon` is none)
data Out
  = OutTag String (List IR.FieldTy)
  | OutRecord (List String) (List IR.FieldTy)
  | OutCall String
  | OutOther

-- (each field's type, as many as there are fields)
tysOf : List IR.Expr -> List IR.FieldTy -> List IR.FieldTy
tysOf args ts =
  List.map (\i -> Repr.tyIn i ts) (List.range 0 (List.length args - 1))

-- (a way out, onto `acc`)
outOnto : List Out -> IR.Expr -> List Out
outOnto acc (ETag t args ts) = Cons (OutTag t (tysOf args ts)) acc
outOnto acc (ERecord fs ts) =
  Cons (OutRecord (List.map fst fs) (tysOf (List.map snd fs) ts)) acc
outOnto acc (ECall g _) = Cons (OutCall g) acc
outOnto acc EAbandon = acc
outOnto acc _ = Cons OutOther acc

isOther : Out -> Bool
isOther OutOther = True
isOther o = False

calleeOf : Out -> List String
calleeOf (OutCall g) = Cons g Nil
calleeOf o = Nil

-- (a function whose ways out are all tags, records and calls, by its
-- key, with them)
candWith : OrdMap.OrdMap String (List Out)
         -> String
         -> List Out
         -> OrdMap.OrdMap String (List Out)
candWith m k os = if List.any isOther os then m else OrdMap.insert m k os

candOne : OrdMap.OrdMap String (List Out)
        -> IR.Def
        -> OrdMap.OrdMap String (List Out)
candOne m d@{ body = ELam _ b } =
  candWith m d.key (List.foldl outOnto Nil (IR.waysList b))
candOne m d = m

-- (those whose calls last are each of one of them)
dropCalling : OrdMap.OrdMap String (List Out) -> OrdMap.OrdMap String (List Out)
dropCalling m =
  OrdMap.fromList
    (List.keepIf
       (\p ->
          List.all
            (\g -> OrdMap.member m g)
            (List.concatMap calleeOf (snd p)))
       (OrdMap.toList m))

-- (... until none is dropped: `m2`, `m` with those dropped)
keptGo : OrdMap.OrdMap String (List Out)
       -> OrdMap.OrdMap String (List Out)
       -> OrdMap.OrdMap String (List Out)
keptGo m m2 =
  if OrdMap.size m2 == OrdMap.size m then m else keptGo m2 (dropCalling m2)

keptFrom : OrdMap.OrdMap String (List Out) -> OrdMap.OrdMap String (List Out)
keptFrom m = keptGo m (dropCalling m)

-- | the functions that may have a worker: those whose ways out are all
-- | tags, records and calls of such functions
candidates : List IR.Def -> OrdMap.OrdMap String (List Out)
candidates defs = keptFrom (List.foldl candOne OrdMap.empty defs)

-- (the functions calling one another last, a class each: by
-- `Repr.rootOf`)
classesOf : OrdMap.OrdMap String (List Out) -> OrdMap.OrdMap String String
classesOf m =
  List.foldl
    (\acc p ->
       List.foldl
         (\a g -> Repr.unite a (fst p) g)
         acc
         (List.concatMap calleeOf (snd p)))
    OrdMap.empty
    (OrdMap.toList m)

-- What a class gives back
--------------------------------------------------------------------------------

-- | what the ways out of a class build: nothing yet; records of the
-- | labels; tags, each with its fields' types; things of more than one
-- | shape
data Shape
  = NoShape
  | RecordShape (List String) (List IR.FieldTy)
  | TagShape (OrdMap.OrdMap String (List IR.FieldTy))
  | BadShape

-- (two types of a field, one way out's and another's, as one: the same,
-- else of any other type)
mergeTy : IR.FieldTy -> IR.FieldTy -> IR.FieldTy
mergeTy a b = if strEq (IR.fieldTyName a) (IR.fieldTyName b) then a else FtOther

mergeTys : List IR.FieldTy -> List IR.FieldTy -> List IR.FieldTy
mergeTys args bs = List.zipWith mergeTy args bs

-- (a tag's fields' types, with those of it seen before)
taggedWith : OrdMap.OrdMap String (List IR.FieldTy)
           -> String
           -> List IR.FieldTy
           -> Maybe (List IR.FieldTy)
           -> Shape
taggedWith m t ts (Just ts0) =
  if List.length ts0 == List.length ts
  then TagShape (OrdMap.insert m t (mergeTys ts0 ts))
  else BadShape
taggedWith m t ts Nothing = TagShape (OrdMap.insert m t ts)

recordWith : List String
           -> List IR.FieldTy
           -> List String
           -> List IR.FieldTy
           -> Shape
recordWith ls ts ls2 ts2 =
  if sameLabels ls ls2 then RecordShape ls (mergeTys ts ts2) else BadShape

addOut : Shape -> Out -> Shape
addOut s (OutCall _) = s
addOut NoShape (OutTag t ts) = TagShape (OrdMap.insert OrdMap.empty t ts)
addOut NoShape (OutRecord ls ts) = RecordShape ls ts
addOut (TagShape m) (OutTag t ts) = taggedWith m t ts (OrdMap.lookup m t)
addOut (RecordShape ls ts) (OutRecord ls2 ts2) = recordWith ls ts ls2 ts2
addOut s o = BadShape

shapeAt : OrdMap.OrdMap String Shape
        -> String
        -> List Out
        -> OrdMap.OrdMap String Shape
shapeAt acc root os =
  OrdMap.insert
    acc
    root
    (List.foldl
       addOut
       (fromMaybe NoShape (OrdMap.lookup acc root))
       os)

-- | what each class's ways out build, by its root
shapesOf : OrdMap.OrdMap String String
         -> OrdMap.OrdMap String (List Out)
         -> OrdMap.OrdMap String Shape
shapesOf parent m =
  List.foldl
    (\acc p -> shapeAt acc (Repr.rootOf parent (fst p)) (snd p))
    OrdMap.empty
    (OrdMap.toList m)

-- Layouts
--------------------------------------------------------------------------------

-- | a tag a tuple may hold the fields of: its name (a record's: ""), its
-- | number, its fields' types, and each field's place among the
-- | tuple's (after its number)
type Con =
  { tag : String, index : Int, tys : List IR.FieldTy, places : List Int }

-- | how a worker gives back what its function built: the tuple's tag (a
-- | tuple of these is one kind of value); whether its first value is the
-- | tag's number; how each place after it is kept; whether it is of a
-- | record, and its labels; its tags (a record: one, of no name); the
-- | class it is of
type Layout =
  { tuple : String
  , numbered : Bool
  , kinds : List Repr.Repr
  , record : Bool
  , labels : List String
  , cons : List Con
  , group : String
  }

-- (the tuple's values' reprs: the number's, then the places')
tupleReprsOf : Layout -> List Repr.Repr
tupleReprsOf lay =
  if lay.numbered then Cons (RepFix I64) lay.kinds else lay.kinds

-- | how many words a tuple of the layout is
wordsOf : Layout -> Int
wordsOf lay = List.length (tupleReprsOf lay)

-- (a place's kind, as a field's type: what the tuple's tag says of it)
kindTy : Repr.Repr -> IR.FieldTy
kindTy RepF64 = FtFloat
kindTy (RepFix w) = FtFixed w
kindTy RepV = FtOther
kindTy RepInt = FtOther

tupleTys : Layout -> List IR.FieldTy
tupleTys lay = List.map kindTy (tupleReprsOf lay)

-- (the first place of the kind no field of the tag before is in)
freeAt : Repr.Repr -> List Int -> Int -> List Repr.Repr -> Maybe Int
freeAt k used i Nil = Nothing
freeAt k used i (Cons k2 ks) =
  if Repr.reprEq k k2 && not (List.any (\j -> j == i) used) then Just i
  else freeAt k used (i + 1) ks

-- (the places so far, and those of a tag's fields)
type Placed = { kinds : List Repr.Repr, places : List Int }

placedAt : Placed -> Repr.Repr -> Maybe Int -> Placed
placedAt p k (Just i) =
  { kinds = p.kinds, places = List.append p.places (Cons i Nil) }
placedAt p k Nothing =
  { kinds = List.append p.kinds (Cons k Nil)
  , places = List.append p.places (Cons (List.length p.kinds) Nil)
  }

placeOne : Placed -> IR.FieldTy -> Placed
placeOne p t =
  placedAt p (Repr.flatOf t) (freeAt (Repr.flatOf t) p.places 0 p.kinds)

-- (the places so far, and the tags placed)
type Laid = { kinds : List Repr.Repr, cons : List Con }

laidWith : Laid -> String -> List IR.FieldTy -> Placed -> Laid
laidWith acc t ts p =
  { kinds = p.kinds
  , cons =
      List.append
        acc.cons
        (Cons
           { tag = t
           , index = List.length acc.cons
           , tys = ts
           , places = p.places
           }
           Nil)
  }

-- (a tag's fields placed, each in the first place of its kind free)
layTag : Laid -> Pair String (List IR.FieldTy) -> Laid
layTag acc (MkPair t ts) =
  laidWith acc t ts (List.foldl placeOne { kinds = acc.kinds, places = Nil } ts)

-- (a layout, where it is worth a worker -- some field is built -- and
-- small enough)
fitting : Layout -> Maybe Layout
fitting lay =
  if List.length lay.cons <= maxTags
     && wordsOf lay <= maxWords
     && not (List.null lay.kinds)
  then Just lay
  else Nothing

tagLayout : String -> Bool -> Laid -> Maybe Layout
tagLayout root numbered l =
  fitting
    { tuple =
        Repr.tupleTag (if numbered then Cons (RepFix I64) l.kinds else l.kinds)
    , numbered = numbered
    , kinds = l.kinds
    , record = False
    , labels = Nil
    , cons = l.cons
    , group = root
    }

recordLayout : String -> List String -> List IR.FieldTy -> Maybe Layout
recordLayout root ls ts =
  fitting
    { tuple = Repr.tupleTag (List.map Repr.flatOf ts)
    , numbered = False
    , kinds = List.map Repr.flatOf ts
    , record = True
    , labels = ls
    , cons =
        Cons
          { tag = ""
          , index = 0
          , tys = ts
          , places = List.range 0 (List.length ts - 1)
          }
          Nil
    , group = root
    }

-- | a class's layout, of what its ways out build (`root` its root)
layoutOf : String -> Shape -> Maybe Layout
layoutOf root (TagShape m) =
  tagLayout
    root
    (OrdMap.size m > 1)
    (List.foldl layTag { kinds = Nil, cons = Nil } (OrdMap.toList m))
layoutOf root (RecordShape ls ts) = recordLayout root ls ts
layoutOf root s = Nothing

-- | the functions with a worker, each its layout
type Know = OrdMap.OrdMap String Layout

layoutInto : OrdMap.OrdMap String Layout
           -> String
           -> Maybe Layout
           -> OrdMap.OrdMap String Layout
layoutInto acc k (Just lay) = OrdMap.insert acc k lay
layoutInto acc k Nothing = acc

-- (each class's layout, by its root, where it has one)
layoutsOf : OrdMap.OrdMap String Shape -> OrdMap.OrdMap String Layout
layoutsOf shapes =
  List.foldl
    (\acc p -> layoutInto acc (fst p) (layoutOf (fst p) (snd p)))
    OrdMap.empty
    (OrdMap.toList shapes)

-- (each candidate, the layout of its class, where it has one)
layoutsAt : OrdMap.OrdMap String String
          -> OrdMap.OrdMap String Layout
          -> OrdMap.OrdMap String (List Out)
          -> Know
layoutsAt parent ls m =
  List.foldl
    (\acc p ->
       layoutInto
         acc
         (fst p)
         (OrdMap.lookup ls (Repr.rootOf parent (fst p))))
    OrdMap.empty
    (OrdMap.toList m)

laid : OrdMap.OrdMap String (List Out) -> Know
laid m = layoutsAt (classesOf m) (layoutsOf (shapesOf (classesOf m) m)) m

-- What is taken apart
--------------------------------------------------------------------------------

-- (a tag's arm, if there is one: its own, else the default)
armOf : String -> List IR.Arm -> Maybe IR.Arm
armOf t arms = IR.armFor t arms

hasArm : Maybe IR.Arm -> Bool
hasArm (Just _) = True
hasArm Nothing = False

-- | whether a match's arms take apart what a function of the layout
-- | gives back: an arm for each tag it may give
covers : Layout -> List IR.Arm -> Bool
covers lay arms =
  not lay.record
  && List.all (\(c : Con) -> hasArm (armOf c.tag arms)) lay.cons

-- (how many times the worklist takes `x` apart -- a match on it that
-- covers, a field of it read -- onto `n`)
apartW : Layout -> String -> Int -> List IR.Expr -> Int
apartW lay x n Nil = n
apartW lay x n (Cons (EMatch s arms) rest) =
  apartW
    lay
    x
    (if isVar x s && covers lay arms then n + 1 else n)
    (Cons s (IR.pushArms arms rest))
apartW lay x n (Cons (EProj e _ _ _) rest) =
  apartW lay x (if isVar x e && lay.record then n + 1 else n) (Cons e rest)
apartW lay x n (Cons e rest) = apartW lay x n (IR.partsOnto e rest)

-- | `x`, bound to what a function of the layout gives back, is only
-- | taken apart in `b`
takenApart : Layout -> String -> IR.Expr -> Bool
takenApart lay x b =
  apartW lay x 0 (Cons b Nil) > 0
  && apartW lay x 0 (Cons b Nil) == IR.countW x 0 (Cons b Nil)

-- (the class of `g`, if a binding of its call is taken apart)
siteLetIn : List String -> String -> IR.Expr -> Maybe Layout -> List String
siteLetIn acc x b (Just lay) =
  if takenApart lay x b then Cons lay.group acc else acc
siteLetIn acc x b Nothing = acc

siteLet : Know -> List String -> String -> IR.Expr -> IR.Expr -> List String
siteLet k acc x (ECall g _) b = siteLetIn acc x b (OrdMap.lookup k g)
siteLet k acc x a b = acc

siteMatchIn : List String -> List IR.Arm -> Maybe Layout -> List String
siteMatchIn acc arms (Just lay) =
  if covers lay arms then Cons lay.group acc else acc
siteMatchIn acc arms Nothing = acc

siteMatch : Know -> List String -> IR.Expr -> List IR.Arm -> List String
siteMatch k acc (ECall g _) arms = siteMatchIn acc arms (OrdMap.lookup k g)
siteMatch k acc s arms = acc

-- (the classes of what the worklist takes apart, onto `acc`)
sitesW : Know -> List String -> List IR.Expr -> List String
sitesW k acc Nil = acc
sitesW k acc (Cons (ELet x a b) rest) =
  sitesW k (siteLet k acc x a b) (Cons a (Cons b rest))
sitesW k acc (Cons (EMatch s arms) rest) =
  sitesW k (siteMatch k acc s arms) (Cons s (IR.pushArms arms rest))
sitesW k acc (Cons e rest) = sitesW k acc (IR.partsOnto e rest)

sitedIn : OrdMap.OrdMap String Unit -> Know -> Know
sitedIn groups k =
  OrdMap.fromList
    (List.keepIf
       (\(p : Pair String Layout) -> OrdMap.member groups (snd p).group)
       (OrdMap.toList k))

-- | ... those of a class of which something is taken apart
sited : List IR.Def -> Know -> Know
sited defs k =
  sitedIn
    (List.foldl
       (\m g -> OrdMap.insert m g MkUnit)
       OrdMap.empty
       (sitesW k Nil (List.map (\(d : IR.Def) -> d.body) defs)))
    k

-- Taken apart
--------------------------------------------------------------------------------

-- (the variable of a place of the tuple, its values' `vs`)
placeVar : Layout -> List String -> Int -> String
placeVar lay vs i =
  fromMaybe "" (List.head (List.drop (if lay.numbered then i + 1 else i) vs))

-- (a label's place)
labelAt : String -> Int -> List String -> Int
labelAt l i Nil = 0
labelAt l i (Cons k ks) = if strEq l k then i else labelAt l (i + 1) ks

-- (an arm's body, its variables bound to those of its tag's fields'
-- places: its own, not the places' -- a place is of another tag's field
-- on another way, or nothing, and what one way knows of a variable, a
-- record read at its shape, heff.compile.refcount knows of it on all)
armBodyAs : Layout -> List String -> Con -> Maybe IR.Arm -> IR.Expr
armBodyAs lay vs c (Just (MkArm _ ws b)) =
  List.foldr
    (\p acc -> ELet (fst p) (EVar (placeVar lay vs (snd p))) acc)
    b
    (List.zip ws c.places)
armBodyAs lay vs c Nothing = EAbandon

-- (whether the tuple's number is the tag's)
numberIs : List String -> Con -> IR.Expr -> IR.Expr -> IR.Expr
numberIs vs c yes no =
  EMatch
    (EBool
       (CRel
          (OfFixed I64 OpEq)
          (EVar (fromMaybe "" (List.head vs)))
          (EFixed I64 c.index)))
    (IR.ifArms yes no)

-- | a way for each tag, chosen by the tuple's number: each tag's in turn,
-- | the last's not tested
chosen : List String -> (Con -> IR.Expr) -> List Con -> IR.Expr
chosen vs way Nil = EAbandon
chosen vs way (Cons c Nil) = way c
chosen vs way (Cons c cs) = numberIs vs c (way c) (chosen vs way cs)

-- (a match's arms on what a worker gave back, `vs`: chosen by its number)
dispatch : Layout -> List String -> List IR.Arm -> IR.Expr
dispatch lay vs arms =
  chosen vs (\c -> armBodyAs lay vs c (armOf c.tag arms)) lay.cons

-- | `x`, what a worker gave back (`vs`), taken apart in what follows: a
-- | match on it chooses by the tuple's number, a field of it read is the
-- | variable of its place
apart : Layout -> String -> List String -> IR.Expr -> IR.Expr
apart lay x vs (EMatch s arms) =
  if isVar x s
  then dispatch lay vs (List.map (IR.mapArm (\_ b -> apart lay x vs b)) arms)
  else IR.mapParts (\_ p -> apart lay x vs p) (EMatch s arms)
apart lay x vs (EProj e l sh t) =
  if isVar x e then EVar (placeVar lay vs (labelAt l 0 lay.labels))
  else EProj (apart lay x vs e) l sh t
apart lay x vs e = IR.mapParts (\_ p -> apart lay x vs p) e

-- Calls of workers
--------------------------------------------------------------------------------

-- (fresh names for a tuple's values)
tupleVars : Layout -> S (List String)
tupleVars lay =
  traverseS
    (\i -> freshS (if lay.numbered && i == 0 then "tag" else "field"))
    (List.range 0 (wordsOf lay - 1))

-- (a call of `g`'s worker, its values bound, given to `k`)
calledApart : Layout
            -> String
            -> List IR.Expr
            -> (List String -> IR.Expr)
            -> S IR.Expr
calledApart lay g args k = do
  vs <- tupleVars lay
  pure
      (EMatch (ECall (workerKey g) args) (Cons (MkArm lay.tuple vs (k vs)) Nil))

letCallIn : String
          -> String
          -> List IR.Expr
          -> IR.Expr
          -> Maybe Layout
          -> S IR.Expr
letCallIn x g args b (Just lay) =
  if takenApart lay x b then calledApart lay g args (\vs -> apart lay x vs b)
  else pure (ELet x (ECall g args) b)
letCallIn x g args b Nothing = pure (ELet x (ECall g args) b)

-- (a binding: of a call taken apart, of its worker)
letRw : Know -> String -> IR.Expr -> IR.Expr -> S IR.Expr
letRw k x (ECall g args) b = letCallIn x g args b (OrdMap.lookup k g)
letRw k x a b = pure (ELet x a b)

matchCallIn : String -> List IR.Expr -> List IR.Arm -> Maybe Layout -> S IR.Expr
matchCallIn g args arms (Just lay) =
  if covers lay arms then calledApart lay g args (\vs -> dispatch lay vs arms)
  else pure (EMatch (ECall g args) arms)
matchCallIn g args arms Nothing = pure (EMatch (ECall g args) arms)

-- (a match: on a call that covers, of its worker)
matchRw : Know -> IR.Expr -> List IR.Arm -> S IR.Expr
matchRw k (ECall g args) arms = matchCallIn g args arms (OrdMap.lookup k g)
matchRw k s arms = pure (EMatch s arms)

-- (a node, its parts rewritten: a binding of a call, a match on one)
rwNode : Know -> IR.Expr -> S IR.Expr
rwNode k (ELet x a b) = letRw k x a b
rwNode k (EMatch s arms) = matchRw k s arms
rwNode k e = pure e

-- | an expression, each call whose value is taken apart at once calling
-- | the worker
rw : Know -> IR.Expr -> S IR.Expr
rw k e = bind (IR.traverseParts (\_ p -> rw k p) e) (rwNode k)

-- Workers and wrappers
--------------------------------------------------------------------------------

-- (nothing, of a place's kind: what a tag without a field there leaves
-- in it)
noneOf : Repr.Repr -> IR.Expr
noneOf RepF64 = EFloat 0.0
noneOf (RepFix w) = EFixed w 0
noneOf RepV = EInt 0
noneOf RepInt = EInt 0

-- (the field in place `i`, of the tag's fields `es`)
fieldAt : Int -> List Int -> List IR.Expr -> Maybe IR.Expr
fieldAt i (Cons p ps) (Cons e es) = if p == i then Just e else fieldAt i ps es
fieldAt i ps es = Nothing

-- | the tuple of a tag's fields, `es`: its number, if the layout has
-- | one, then each place's field, or nothing
tupleOfCon : Layout -> Con -> List IR.Expr -> IR.Expr
tupleOfCon lay c es =
  ETag
    lay.tuple
    (List.append
       (if lay.numbered then Cons (EFixed I64 c.index) Nil else Nil)
       (List.zipWith
          (\i k -> fromMaybe (noneOf k) (fieldAt i c.places es))
          (List.range 0 (List.length lay.kinds - 1))
          lay.kinds))
    (tupleTys lay)

-- (the fields, each that is not a value bound first, in order: so they
-- are computed in their order, whatever their places)
type Bound = { lets : List (Pair String IR.Expr), vals : List IR.Expr }

boundOne : Bound -> IR.Expr -> S Bound
boundOne b e =
  if IR.isValue e
  then pure { lets = b.lets, vals = List.append b.vals (Cons e Nil) }
  else do
    x <- freshS "f"
    pure
        { lets = List.append b.lets (Cons (MkPair x e) Nil)
        , vals = List.append b.vals (Cons (EVar x) Nil)
        }

boundAll : Bound -> List IR.Expr -> S Bound
boundAll b Nil = pure b
boundAll b (Cons e es) = do
  b2 <- boundOne b e
  boundAll b2 es

letsAround : List (Pair String IR.Expr) -> IR.Expr -> IR.Expr
letsAround ls e = List.foldr (\p acc -> ELet (fst p) (snd p) acc) e ls

conOf : Layout -> String -> Con
conOf lay t =
  fromMaybe
    { tag = t, index = 0, tys = Nil, places = Nil }
    (List.find (\(c : Con) -> strEq c.tag t) lay.cons)

-- (a tag or a record built at a way out, of `es`: its tuple)
builtOut : Layout -> Con -> List IR.Expr -> S IR.Expr
builtOut lay c es = do
  b <- boundAll { lets = Nil, vals = Nil } es
  pure (letsAround b.lets (tupleOfCon lay c b.vals))

-- | a worker's way out: a tag or a record built, its tuple; a call last,
-- | of the other's worker
outRw : Layout -> IR.Expr -> S IR.Expr
outRw lay (ETag t args _) = builtOut lay (conOf lay t) args
outRw lay (ERecord fs _) = builtOut lay (conOf lay "") (List.map snd fs)
outRw lay (ECall g args) = pure (ECall (workerKey g) args)
outRw lay e = pure e

-- (a tag, or a record, of the fields in its places)
builtOf : Layout -> List String -> Con -> IR.Expr
builtOf lay vs c =
  if lay.record
  then ERecord
      (List.zipWith
         (\l i -> MkPair l (EVar (placeVar lay vs i)))
         lay.labels
         c.places)
      c.tys
  else ETag c.tag (List.map (\i -> EVar (placeVar lay vs i)) c.places) c.tys

-- | a function with a worker: the wrapper, which calls the worker and
-- | builds the tag of what it gives back
wrapperOf : Layout -> IR.Def -> List String -> S IR.Def
wrapperOf lay d xs = do
  ys <- traverseS (\x -> freshS (IR.baseOf x)) xs
  vs <- tupleVars lay
  pure
      (IR.mkDef
         d.key
         d.name
         (ELam
            ys
            (EMatch
               (ECall (workerKey d.key) (List.map (\y -> EVar y) ys))
               (Cons
                  (MkArm lay.tuple vs (chosen vs (builtOf lay vs) lay.cons))
                  Nil))))

mentions : Know -> IR.Expr -> Bool
mentions k e = List.any (\g -> OrdMap.member k g) (IR.globalsIn e)

-- (a definition: given a worker, the worker and its wrapper; else its
-- calls taken apart calling workers)
defWith : Know -> IR.Def -> Maybe Layout -> S (List IR.Def)
defWith k d@{ body = ELam xs b } (Just lay) = do
  b2 <- rw k b
  b3 <- IR.waysM (mo := instanceMonadS) (outRw lay) b2
  w <- wrapperOf lay d xs
  pure (Cons (IR.mkDef (workerKey d.key) d.name (ELam xs b3)) (Cons w Nil))
defWith k d m =
  if mentions k d.body
  then do
    b2 <- rw k d.body
    pure (Cons (IR.mkDef d.key d.name b2) Nil)
  else pure (Cons d Nil)

defRw : Know -> IR.Def -> S (List IR.Def)
defRw k d = defWith k d (OrdMap.lookup k d.key)

-- | a program given its workers: its definitions, where fresh names go
-- | on from, and the workers that give back a tuple, each by how many
-- | values (heff.compile.facts's `tuples`)
type Cprd =
  { defs : List IR.Def, supply : Int, tuples : OrdMap.OrdMap String Int }

cprWith : Int -> List IR.Def -> Know -> Cprd
cprWith supply defs k =
  if OrdMap.size k == 0
  then { defs = defs, supply = supply, tuples = OrdMap.empty }
  else case traverseS (defRw k) defs supply of
    MkPair dss n ->
      { defs = List.concatMap (\ds -> ds) dss
      , supply = n
      , tuples =
          OrdMap.fromList
            (List.map
               (\p -> MkPair (workerKey (fst p)) (wordsOf (snd p)))
               (OrdMap.toList k))
      }

-- | the program's functions that give back what they build given
-- | workers, and the calls that take it apart at once calling them;
-- | fresh names from `supply` on
-- | >>> OrdMap.toList (cprProgram 0 [IR.mkDef "f" "f" (ELam ["x"] (ETag "MkPair" [EVar "x", EVar "x"] [FtOther, FtOther])), IR.mkDef "g" "g" (ELam ["y"] (EMatch (ECall "f" [EVar "y"]) [MkArm "MkPair" ["a", "b"] (EVar "a")]))]).tuples
-- | [MkPair "f$cpr" 2]
cprProgram : Int -> List IR.Def -> Cprd
cprProgram supply defs =
  cprWith supply defs (sited defs (laid (candidates defs)))
