-- Monadic form (Bowman, "A Low-Level Look at A-Normal Form", OOPSLA
-- 2024): what a computation's parts compute is computed first, each
-- bound to a name, and the computation is given the names.  An
-- operand that computes -- a call, a primitive that may fail, a match,
-- a binding -- is bound by a `let` before what it is an operand of;
-- one that is a value (a name, a literal, a lambda, a tag or record of
-- names, a field of a name, a primitive that cannot fail given names)
-- stays where it is: computing it there or before is the same, as it
-- can neither fail nor do anything.  The operands are bound left to
-- right, as they were computed (the language is call by value), and
-- nothing is bound out of a lambda or an arm.  What a match looks at is
-- bound unless it is a name or a literal.
--
-- It is not A-normal form: a binding of a binding is put in order (`let
-- x = (let y = a in b) in c` is `let y = a in let x = b in c`), but a
-- binding of a match stays one (`let x = case .. in c`), not made a
-- match with `c` in each arm -- which would copy `c`, or need a join
-- point.  That is done where it is cheap and safe, in the imperative
-- form the backends print (`set x` in each arm).

module heff.compile.monadic

import heff.compile.ir as IR
import heff.compile.simplify as Simplify
import heff.compile.supply

-- (a name of the operands it binds)
fresh : S String
fresh = freshS "t"

-- | a name or a literal
atom : IR.Expr -> Bool
atom (EVar _) = True
atom (EGlobal _) = True
atom (EInt _) = True
atom (EFloat _) = True
atom (EStr _) = True
atom (EBytes _) = True
atom (EFixed _ _) = True
atom (EFloat32 _) = True
atom (EPrim _) = True
atom _ = False

-- | ... or a lambda
value : IR.Expr -> Bool
value (ELam _ _) = True
value e = atom e

-- | an operand that may stay where it is
inPlace : IR.Expr -> Bool
inPlace (ELam _ _) = True
inPlace (ETag _ args _) = List.all value args
inPlace (ERecord fs _) = List.all value (List.map snd fs)
inPlace (EProj e _ _ _) = atom e
inPlace (EPrimCall p args) = not (Simplify.primFails p) && List.all atom args
inPlace e = atom e

-- | an operand, normal (by `go`), given to `k`: bound first unless it may
-- | stay (`stays`); the bindings it made on the way bound before it
bindAs : (IR.Expr -> Bool) -> IR.Expr -> (IR.Expr -> S IR.Expr) -> S IR.Expr
bindAs stays (ELet y c d) k = do
  r <- bindAs stays d k
  pure (ELet y c r)
bindAs stays (ESet ys c d) k = do
  r <- bindAs stays d k
  pure (ESet ys c r)
bindAs stays e k =
  if stays e then k e
  else do
    t <- fresh
    body <- k (EVar t)
    pure (ELet t e body)

-- | ... bound unless it is a name or a literal: what a match looks at
-- | (its arms then see what it looked at by a name, and the C backend's
-- | reference counts know it)
bindAtom : IR.Expr -> (IR.Expr -> S IR.Expr) -> S IR.Expr
bindAtom (ELet y c d) k = do
  r <- bindAtom d k
  pure (ELet y c r)
bindAtom (ESet ys c d) k = do
  r <- bindAtom d k
  pure (ESet ys c r)
bindAtom e k =
  if atom e then k e
  else do
    t <- fresh
    body <- k (EVar t)
    pure (ELet t e body)

operandWith : (IR.Expr -> Bool)
            -> (IR.Expr -> S IR.Expr)
            -> IR.Expr
            -> (IR.Expr -> S IR.Expr)
            -> S IR.Expr
operandWith stays go e k = do
  e' <- go e
  bindAs stays e' k

operandsWith : (IR.Expr -> Bool)
             -> (IR.Expr -> S IR.Expr)
             -> List IR.Expr
             -> (List IR.Expr -> S IR.Expr)
             -> S IR.Expr
operandsWith stays go Nil k = k Nil
operandsWith stays go (Cons a rest) k =
  operandWith
    stays
    go
    a
    (\a' -> operandsWith stays go rest (\rest' -> k (Cons a' rest')))

-- (a binding of a binding: the inner first, names being unique)
flatLet : String -> IR.Expr -> IR.Expr -> IR.Expr
flatLet x (ELet y c d) b = ELet y c (flatLet x d b)
flatLet x (ESet ys c d) b = ESet ys c (flatLet x d b)
flatLet x a b = ELet x a b

fieldN : (IR.Expr -> Bool)
       -> (IR.Expr -> S IR.Expr)
       -> List (Pair String IR.Expr)
       -> List IR.FieldTy
       -> S IR.Expr
fieldN stays go fs ts =
  operandsWith
    stays
    go
    (List.map snd fs)
    (\vs -> pure (ERecord (List.zipWith (\p v -> MkPair (fst p) v) fs vs) ts))

-- | ... what a match looks at, a condition kept where it is (an `if`
-- | on it builds no `Bool`)
bindScrut : IR.Expr -> (IR.Expr -> S IR.Expr) -> S IR.Expr
bindScrut (ELet y c d) k = do
  r <- bindScrut d k
  pure (ELet y c r)
bindScrut (ESet ys c d) k = do
  r <- bindScrut d k
  pure (ESet ys c r)
bindScrut (EBool c) k = k (EBool c)
bindScrut e k = bindAtom e k

-- | a condition, in monadic form, given to `k`: what it computes whenever
-- | it is computed bound before it as an operand is; what an arm of a
-- | `CIf` computes, computed only where it is chosen, in monadic form in
-- | its place
condN : (IR.Expr -> Bool)
      -> (IR.Expr -> S IR.Expr)
      -> IR.Cond
      -> (IR.Cond -> S IR.Expr)
      -> S IR.Expr
condN stays go (CRel p a b) k =
  operandsWith stays go [a, b] (\vs -> case vs of
    Cons a2 (Cons b2 Nil) -> k (CRel p a2 b2)
    _ -> k (CRel p a b))
condN stays go (CTest e) k = operandWith stays go e (\e2 -> k (CTest e2))
condN stays go (CNot c) k = condN stays go c (\c2 -> k (CNot c2))
condN stays go (CIf a b c) k =
  condN
    stays
    go
    a (\a2 -> do
      b2 <- IR.condTraverse (mo := instanceMonadS) go b
      c2 <- IR.condTraverse (mo := instanceMonadS) go c
      k (CIf a2 b2 c2))
condN stays go c k = k c

-- | an expression in monadic form, the operands that may stay where they
-- | are as `stays` says
normWith : (IR.Expr -> Bool) -> IR.Expr -> S IR.Expr
normWith stays (EApp f args) =
  operandWith
    stays
    (normWith stays)
    f
    (\f' ->
       operandsWith
         stays
         (normWith stays)
         args
         (\args' -> pure (EApp f' args')))
normWith stays (ECall g args) =
  operandsWith stays (normWith stays) args (\args' -> pure (ECall g args'))
normWith stays (EPrimCall p args) =
  operandsWith
    stays
    (normWith stays)
    args
    (\args' -> pure (EPrimCall p args'))
normWith stays (ETag t args ts) =
  operandsWith
    stays
    (normWith stays)
    args
    (\args' -> pure (ETag t args' ts))
normWith stays (ERecord fs ts) = fieldN stays (normWith stays) fs ts
normWith stays (EProj e l sh t) =
  operandWith stays (normWith stays) e (\e' -> pure (EProj e' l sh t))
normWith stays (ELet x a b) = do
  a' <- normWith stays a
  b' <- normWith stays b
  pure (flatLet x a' b')
normWith stays (EMatch s arms) = do
  s0 <- normWith stays s
  bindScrut s0 (\s' -> do
    arms' <-
      traverseS
        (IR.traverseArmM (mo := instanceMonadS) (\_ b -> normWith stays b))
        arms
    pure (EMatch s' arms'))
normWith stays (EBool c) =
  condN stays (normWith stays) c (\c2 -> pure (EBool c2))
normWith stays (EValues es) =
  operandsWith stays (normWith stays) es (\es' -> pure (EValues es'))
normWith stays e = IR.traverseParts (\_ p -> normWith stays p) e

defWith : (IR.Expr -> Bool) -> IR.Def -> S IR.Def
defWith stays d = do
  b <- normWith stays d.body
  pure (IR.mkDef d.key d.name b)

-- | the definitions in monadic form, names drawn from `supply` on
-- | >>> monadicProgram 0 [IR.mkDef "f" "f" (ELam ["x"] (ECall "g" [ECall "h" [EVar "x"], EInt 1]))]
-- | [IR.mkDef "f" "f" (ELam ["x"] (ELet "t$0" (ECall "h" [EVar "x"]) (ECall "g" [EVar "t$0", EInt 1])))]
monadicProgram : Int -> List IR.Def -> List IR.Def
monadicProgram supply defs = fst (traverseS (defWith inPlace) defs supply)

-- | ... and where fresh names go on from
monadicFrom : Int -> List IR.Def -> Pair (List IR.Def) Int
monadicFrom supply defs = traverseS (defWith inPlace) defs supply

-- | an operand that computes nothing that could be seen where it is: a
-- | value, a tag or record of such, a field of one, a primitive that
-- | cannot fail given such -- so that it may stay where it is, or be
-- | computed before or after what is bound, the same
quiet : IR.Expr -> Bool
quiet (ETag _ args _) = List.all quiet args
quiet (ERecord fs _) = List.all (\p -> quiet (snd p)) fs
quiet (EProj e _ _ _) = quiet e
quiet (EPrimCall p args) = not (Simplify.primFails p) && List.all quiet args
quiet (EBool c) = List.all quiet (IR.condParts c)
quiet e = value e

-- | ... each operand that computes what could be seen bound (a call, a
-- | match, a primitive that may fail), in the order it is computed, the
-- | others left where they are: for the passes on what both backends are
-- | given, which look at what a tag or a call is built of
-- | >>> fst (operandsBound 0 [IR.mkDef "f" "f" (ELam ["x"] (ETag "P" [ECall "h" [EVar "x"], ETag "P" [EPrimCall IntAdd [EVar "x", EInt 1], ETag "Nil" [] []] [FtAny, FtAny]] [FtAny, FtAny]))])
-- | [IR.mkDef "f" "f" (ELam ["x"] (ELet "t$0" (ECall "h" [EVar "x"]) (ETag "P" [EVar "t$0", ETag "P" [EPrimCall IntAdd [EVar "x", EInt 1], ETag "Nil" [] []] [FtAny, FtAny]] [FtAny, FtAny])))]
operandsBound : Int -> List IR.Def -> Pair (List IR.Def) Int
operandsBound supply defs = traverseS (defWith quiet) defs supply
