-- Monadic form (Bowman, "A Low-Level Look at A-Normal Form", OOPSLA
-- 2024): what a computation's parts compute is computed first, each
-- bound to a name, and the computation is given the names.  An
-- operand that computes -- a call, a primitive that may fail, a match,
-- a binding -- is bound by a `let` before what it is an operand of;
-- one that is a value (a name, a literal, a lambda, a tag or record of
-- names, a field of a name, a primitive that cannot fail given names)
-- stays where it is: computing it there or before is the same, as it
-- can neither fail nor do anything.  The operands are bound left to
-- right, as they were computed (the language is call by value), and
-- nothing is bound out of a lambda or an arm.  What a match looks at is
-- bound unless it is a name or a literal.
--
-- It is not A-normal form: a binding of a binding is put in order (`let
-- x = (let y = a in b) in c` is `let y = a in let x = b in c`), but a
-- binding of a match stays one (`let x = case .. in c`), not made a
-- match with `c` in each arm -- which would copy `c`, or need a join
-- point.  That is done where it is cheap and safe, in the imperative
-- form the backends print (`set x` in each arm).

module heff.compile.monadic

import heff.compile.ir as IR
import heff.compile.simplify as Simplify

-- | computations drawing fresh names
type N a = Int -> Pair a Int

bindTake : {a b : Type} -> (a -> N b) -> Pair a Int -> Pair b Int
bindTake f (MkPair x n) = f x n

-- `do` is this
bind : {a b : Type} -> N a -> (a -> N b) -> N b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> N a
pure x = \n -> MkPair x n

fresh : N String
fresh = \n -> MkPair ("t$" ^ show n) (n + 1)

instance instanceMonadN : Monad N
instanceMonadN = { pure = pure, bind = bind }

traverseN : {a b : Type} -> (a -> N b) -> List a -> N (List b)
traverseN = traverse (mo := instanceMonadN)

allA : {a : Type} -> (a -> Bool) -> List a -> Bool
allA p Nil = True
allA p (Cons x xs) = p x && allA p xs

-- | a name or a literal
atom : IR.Expr -> Bool
atom (EVar _) = True
atom (EGlobal _) = True
atom (EInt _) = True
atom (EFloat _) = True
atom (EStr _) = True
atom (EBytes _) = True
atom (EFixed _ _) = True
atom (EFloat32 _) = True
atom (EPrim _) = True
atom _ = False

-- | ... or a lambda
value : IR.Expr -> Bool
value (ELam _ _) = True
value e = atom e

-- | an operand that may stay where it is
inPlace : IR.Expr -> Bool
inPlace (ELam _ _) = True
inPlace (ETag _ args _) = allA value args
inPlace (ERecord fs _) = allA value (List.map snd fs)
inPlace (EProj e _ _ _) = atom e
inPlace (EPrimCall p args) = not (Simplify.primFails p) && allA atom args
inPlace e = atom e

-- | an operand, normal (by `go`), given to `k`: bound first unless it may
-- | stay; the bindings it made on the way bound before it
bindAs : IR.Expr -> (IR.Expr -> N IR.Expr) -> N IR.Expr
bindAs (ELet y c d) k = do
  r <- bindAs d k
  pure (ELet y c r)
bindAs e k =
  if inPlace e then k e
  else do
    t <- fresh
    body <- k (EVar t)
    pure (ELet t e body)

-- | ... bound unless it is a name or a literal: what a match looks at
-- | (its arms then see what it looked at by a name, and the C backend's
-- | reference counts know it)
bindAtom : IR.Expr -> (IR.Expr -> N IR.Expr) -> N IR.Expr
bindAtom (ELet y c d) k = do
  r <- bindAtom d k
  pure (ELet y c r)
bindAtom e k =
  if atom e then k e
  else do
    t <- fresh
    body <- k (EVar t)
    pure (ELet t e body)

operandWith : (IR.Expr -> N IR.Expr)
            -> IR.Expr
            -> (IR.Expr -> N IR.Expr)
            -> N IR.Expr
operandWith go e k = do
  e' <- go e
  bindAs e' k

operandsWith : (IR.Expr -> N IR.Expr)
             -> List IR.Expr
             -> (List IR.Expr -> N IR.Expr)
             -> N IR.Expr
operandsWith go Nil k = k Nil
operandsWith go (Cons a rest) k =
  operandWith go a (\a' -> operandsWith go rest (\rest' -> k (Cons a' rest')))

-- (a binding of a binding: the inner first, names being unique)
flatLet : String -> IR.Expr -> IR.Expr -> IR.Expr
flatLet x (ELet y c d) b = ELet y c (flatLet x d b)
flatLet x a b = ELet x a b

fieldN : (IR.Expr -> N IR.Expr)
       -> List (Pair String IR.Expr)
       -> List IR.FieldTy
       -> N IR.Expr
fieldN go fs ts =
  operandsWith
    go
    (List.map snd fs)
    (\vs -> pure (ERecord (List.zipWith (\p v -> MkPair (fst p) v) fs vs) ts))

-- | ... what a match looks at, a condition kept where it is (an `if`
-- | on it builds no `Bool`)
bindScrut : IR.Expr -> (IR.Expr -> N IR.Expr) -> N IR.Expr
bindScrut (ELet y c d) k = do
  r <- bindScrut d k
  pure (ELet y c r)
bindScrut (EBool c) k = k (EBool c)
bindScrut e k = bindAtom e k

-- | a condition, in monadic form, given to `k`: what it computes whenever
-- | it is computed bound before it as an operand is; what an arm of a
-- | `CIf` computes, computed only where it is chosen, in monadic form in
-- | its place
condN : (IR.Expr -> N IR.Expr)
      -> IR.Cond
      -> (IR.Cond -> N IR.Expr)
      -> N IR.Expr
condN go (CRel p a b) k =
  operandsWith go [a, b] (\vs -> case vs of
  Cons a2 (Cons b2 Nil) -> k (CRel p a2 b2)
  _ -> k (CRel p a b))
condN go (CTest e) k = operandWith go e (\e2 -> k (CTest e2))
condN go (CNot c) k = condN go c (\c2 -> k (CNot c2))
condN go (CIf a b c) k =
  condN
    go
    a (\a2 -> do
  b2 <- IR.condTraverse (mo := instanceMonadN) go b
  c2 <- IR.condTraverse (mo := instanceMonadN) go c
  k (CIf a2 b2 c2))
condN go c k = k c

armN : (IR.Expr -> N IR.Expr) -> IR.Arm -> N IR.Arm
armN go (MkArm t vs b) = do
  b' <- go b
  pure (MkArm t vs b')

-- | an expression in monadic form
norm : IR.Expr -> N IR.Expr
norm (ELam xs b) = do
  b' <- norm b
  pure (ELam xs b')
norm (EApp f args) =
  operandWith
    norm
    f
    (\f' -> operandsWith norm args (\args' -> pure (EApp f' args')))
norm (ECall g args) = operandsWith norm args (\args' -> pure (ECall g args'))
norm (EPrimCall p args) =
  operandsWith norm args (\args' -> pure (EPrimCall p args'))
norm (ETag t args ts) =
  operandsWith norm args (\args' -> pure (ETag t args' ts))
norm (ERecord fs ts) = fieldN norm fs ts
norm (EProj e l sh t) = operandWith norm e (\e' -> pure (EProj e' l sh t))
norm (ELet x a b) = do
  a' <- norm a
  b' <- norm b
  pure (flatLet x a' b')
norm (EMatch s arms) = do
  s0 <- norm s
  bindScrut s0 (\s' -> do
    arms' <- traverseN (armN norm) arms
    pure (EMatch s' arms'))
norm (EBool c) = condN norm c (\c2 -> pure (EBool c2))
norm e = pure e

defN : IR.Def -> N IR.Def
defN d = do
  b <- norm d.body
  pure (IR.mkDef d.key d.name b)

-- | the definitions in monadic form, names drawn from `supply` on
-- | >>> monadicProgram 0 [IR.mkDef "f" "f" (ELam ["x"] (ECall "g" [ECall "h" [EVar "x"], EInt 1]))]
-- | [IR.mkDef "f" "f" (ELam ["x"] (ELet "t$0" (ECall "h" [EVar "x"]) (ECall "g" [EVar "t$0", EInt 1])))]
monadicProgram : Int -> List IR.Def -> List IR.Def
monadicProgram supply defs = fst (traverseN defN defs supply)

-- | ... and where fresh names go on from
monadicFrom : Int -> List IR.Def -> Pair (List IR.Def) Int
monadicFrom supply defs = traverseN defN defs supply
