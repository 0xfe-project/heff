-- Core to the untyped IR.  What is a type is erased -- gone, with the
-- parameter that took it and the argument given for it.  Which is which
-- is read off the types, so the core is checked again, with the NbE.  The three judgments are one knot
-- record, `ek`; this module's `bind` is its supply-and-failure monad's.

module heff.compile.erase

import array as Array
import heff.util.dict as Dict
import heff.elab.eval as Eval
import heff.elab.globals as Globals
import heff.compile.ir as IR
import heff.elab.params as Params
import heff.elab.rules as Rules
import heff.elab.syntax as Syntax
import heff.elab.value as Value

type M a = Int -> Either String (Pair a Int)

bindTake : {a b : Type}
         -> (a -> M b)
         -> Either String (Pair a Int)
         -> Either String (Pair b Int)
bindTake f (Left e) = Left e
bindTake f (Right (MkPair x n)) = f x n

bind : {a b : Type} -> M a -> (a -> M b) -> M b
bind m f = \n -> bindTake f (m n)

pure : {a : Type} -> a -> M a
pure x = \n -> Right (MkPair x n)

failWith : {a : Type} -> String -> M a
failWith msg = \n -> Left msg

tryTake : {a : Type}
        -> Int
        -> Either String (Pair a Int)
        -> Either String (Pair (Maybe a) Int)
tryTake n (Left _) = Right (MkPair Nothing n)
tryTake n (Right (MkPair x n')) = Right (MkPair (Just x) n')

-- | the computation, or `Nothing` if it fails (the supply advances only
-- | when it succeeds)
tryM : {a : Type} -> M a -> M (Maybe a)
tryM m = \n -> tryTake n (m n)

freshName : String -> M String
freshName x = \n ->
    Right (IR.fresh (if strEq x "" || strEq x "_" then "x" else x) n)

-- | a local: what it is in the IR (nothing, if it was a type), its type
type Local = { ir : Maybe IR.Expr, ty : Value.Ty }

mkLocal : Maybe IR.Expr -> Value.Ty -> Local
mkLocal ir ty = { ir = ir, ty = ty }

type Ctx =
  { locals : List Local
  , env : Value.Locals Value.V
  , len : Int
  , globals : Globals.Globals
  }

extend : Ctx -> Maybe IR.Expr -> Value.Ty -> Ctx
extend c ir ty =
  { locals = Cons (mkLocal ir ty) c.locals
  , env = Value.snocL c.env (Value.local c.len ty)
  , len = c.len + 1
  , globals = c.globals
  }

evalIn : Ctx -> Syntax.Tm -> Value.V
evalIn c t = Value.nom (Eval.eval c.globals N t c.env)

-- | does a type classify types (possibly type families): a universe, or
-- | a function into one
isType : Int -> Value.Ty -> Bool
isType lvl t = case Value.behavior t of
  LikeU _ -> True
  LikeFunction level dom cod implicit ->
    isType (lvl + 1) (Value.nom (Value.appClo cod (\u -> Value.local lvl dom)))
  _ -> False

-- | The type of field `l`: through the value's fields `fs` where they are
-- | in hand (expanded once for a record's fields, not once each); else
-- | each field before it a local of its own, if the type depends on none
-- | of them
projTyInWith : Int
             -> Value.Ty
             -> Maybe (Dict.Dict (Value.Ev Value.V))
             -> String
             -> M Value.Ty
projTyInWith len t fs l = case Value.projTyWith t fs l of
  Just ty -> pure ty
  Nothing -> case Value.behavior t of
    LikeRecord level capture fieldTypes -> case Rules.fieldTyApart
        len
        level
        capture
        fieldTypes
        l of
      Just ty -> pure ty
      Nothing ->
        failWith ("the type of `." ^ l ^ "` depends on fields not in hand here")
    _ -> failWith "projecting from something that is not of a record type"

-- | as `projTyInWith`, the value given
projTyIn : Int -> Value.Ty -> Value.V -> String -> M Value.Ty
projTyIn len t v l = projTyInWith len t (Value.coerceToFieldsMaybe v) l

-- (a field of the value, its fields given if they are in hand)
projWith : Maybe (Dict.Dict (Value.Ev Value.V))
         -> Value.V
         -> String
         -> Value.Ev Value.V
projWith (Just fs) v l = Dict.elemAt fs l
projWith Nothing v l = Value.proj v l

-- (field `k`'s type, of a record whose fields are not in hand: each field
-- before it a local of its own)
apartIn : Int -> String -> Value.TB -> Maybe Value.Ty
apartIn len k (LikeRecord level capture fieldTypes) =
  Rules.fieldTyApart len level capture fieldTypes k
apartIn len k _ = Nothing

fieldTyOr : Int -> Value.Ty -> String -> Maybe Value.Ty -> Maybe Value.Ty
fieldTyOr len t k (Just ty) = Just ty
fieldTyOr len t k Nothing = apartIn len k (Value.behavior t)

-- (of the fields, by their types, those a record has where the program
-- runs, in order: those that are not types, as a record built is erased;
-- none said where a field's type is not known)
keptOf : Int
       -> List String
       -> List (Pair String (Maybe Value.Ty))
       -> List String
keptOf len acc Nil = List.reverse acc
keptOf len acc (Cons (MkPair k (Just ty)) rest) =
  keptOf len (if isType len ty then acc else Cons k acc) rest
keptOf len acc (Cons (MkPair k Nothing) rest) = Nil

keysIn : Value.TB -> List String
keysIn (LikeRecord level capture fieldTypes) = Array.toList fieldTypes.keys
keysIn _ = Nil

shapeWith : Int
          -> Value.Ty
          -> Maybe (Dict.Dict (Value.Ev Value.V))
          -> List String
shapeWith len t fs =
  keptOf
    len
    Nil
    (List.map
       (\k -> MkPair k (fieldTyOr len t k (Value.projTyWith t fs k)))
       (keysIn (Value.behavior t)))

-- | the labels of the fields a record of type `t`, the value `v`, has
-- | where the program runs, in order: its shape, which a backend reads a
-- | field at (`EProj`)
shapeOfTy : Int -> Value.Ty -> Value.V -> List String
shapeOfTy len t v = shapeWith len t (Value.coerceToFieldsMaybe v)

-- | a field's type, as a backend may lay the record out (#39): a type
-- | with no rules here -- a variable's, one not known -- is any
fieldTyOfB : Value.TB -> IR.FieldTy
fieldTyOfB LikeFloat = FtFloat
fieldTyOfB (LikeFixed w) = FtFixed w
fieldTyOfB NoRules = FtAny
fieldTyOfB _ = FtOther

fieldTyOf : Value.Ty -> IR.FieldTy
fieldTyOf t = fieldTyOfB (Value.behavior t)

matchVariants : Value.Ty -> M (Params.Variants (Params.Th Value.Ty))
matchVariants sty = case Value.behavior sty of
  LikeSum vs -> pure vs
  _ -> failWith "matching on something that is not of a sum type"

argTysOf : Params.Variants (Params.Th Value.Ty) -> String -> List Value.Ty
argTysOf vs tag = case Dict.lookup vs tag of
  Just ts -> List.map (\t -> Params.forceTh t) (Array.toList ts)
  Nothing -> Nil

type Bound = { c : Ctx, vars : List String }

zipE : {a b : Type} -> List a -> List b -> List (Pair a b)
zipE (Cons x xs) (Cons y ys) = Cons (MkPair x y) (zipE xs ys)
zipE _ _ = Nil

armBindGo : Bound -> List (Pair String Value.Ty) -> M Bound
armBindGo acc Nil = pure { c = acc.c, vars = List.reverse acc.vars }
armBindGo acc (Cons (MkPair x aty) rest) =
  if isType acc.c.len aty
  then armBindGo { c = extend acc.c Nothing aty, vars = acc.vars } rest
  else do
    v <- freshName x
    armBindGo
        { c = extend acc.c (Just (EVar v)) aty, vars = Cons v acc.vars }
        rest

-- (an alternative's context: its pattern's variables bound, the type
-- arguments erased)
armBind : Ctx
        -> Params.Variants (Params.Th Value.Ty)
        -> String
        -> List String
        -> M Bound
armBind c vs tag xs =
  armBindGo { c = c, vars = Nil } (zipE xs (argTysOf vs tag))

-- | the judgments, knotted
type EK =
  { chkD : Ctx -> Syntax.Tm -> Value.Ty -> Value.V -> M IR.Expr
  , chk : Ctx -> Syntax.Tm -> Value.Ty -> M IR.Expr
  , syn : Ctx -> Syntax.Tm -> M (Pair IR.Expr Value.Ty)
  }

armOf : EK
      -> Ctx
      -> Params.Variants (Params.Th Value.Ty)
      -> Value.Ty
      -> Pair String (Pair (Array String) Syntax.Tm)
      -> M IR.Arm
armOf r c vs ty (MkPair tag (MkPair xs body)) = do
  b0 <- armBind c vs tag (Array.toList xs)
  b <- r.chk b0.c body ty
  pure (MkArm tag b0.vars b)

-- (the type of a match nothing expects: the first alternative's that
-- can say it)
armsTy : EK
       -> Ctx
       -> Params.Variants (Params.Th Value.Ty)
       -> List (Pair String (Pair (Array String) Syntax.Tm))
       -> M Value.Ty
armsTy r c vs Nil = failWith "this needs an expected type"
armsTy r c vs (Cons (MkPair tag (MkPair xs body)) tail) = do
  b0 <- armBind c vs tag (Array.toList xs)
  m <- tryM (r.syn b0.c body)
  case m of
    Just (MkPair _ ty) -> pure ty
    Nothing -> armsTy r c vs tail

nthLocal : List Local -> Int -> Maybe Local
nthLocal Nil i = Nothing
nthLocal (Cons l rest) i =
  if i == 0 then Just l else if i < 0 then Nothing else nthLocal rest (i - 1)

instance instanceMonadM : Monad M
instanceMonadM = { pure = pure, bind = bind }

traverseM : {a b : Type} -> (a -> M b) -> List a -> M (List b)
traverseM = traverse (mo := instanceMonadM)

catMaybesE : {a : Type} -> List (Maybe a) -> List a
catMaybesE Nil = Nil
catMaybesE (Cons (Just x) xs) = Cons x (catMaybesE xs)
catMaybesE (Cons Nothing xs) = catMaybesE xs

lamParts : Syntax.Abs Syntax.Tm -> Pair (Pair String Bool) Syntax.Tm
lamParts (MkAbs n b) = MkPair (MkPair n True) b
lamParts (AbsConst b) = MkPair (MkPair "_" False) b

synF : EK -> Ctx -> Syntax.Tm -> M (Pair IR.Expr Value.Ty)
synF r c (SLocal i) = case nthLocal c.locals i of
  Just l -> case l.ir of
    Just x -> pure (MkPair x l.ty)
    Nothing -> failWith "a type used as a value"
  Nothing -> failWith "an unbound local"
synF r c (SGlobal x) = case Globals.lookupEntry c.globals x of
  Just e ->
    if isType 0 e.type_ then failWith ("the type " ^ x ^ " used as a value")
    else pure (MkPair (EGlobal x) e.type_)
  Nothing -> failWith ("no global " ^ x)
synF r c (SApp f a) = do
  pf <- r.syn c f
  case pf of
    MkPair f' fty -> case Value.behavior fty of
      LikeFunction level dom cod implicit ->
        if isType c.len dom
        then pure
            (MkPair f' (Value.nom (Value.appClo cod (\u -> evalIn c a))))
        else do
          a' <- r.chk c a dom
          pure
              (MkPair
                 (EApp f' (Cons a' Nil))
                 (Value.nom (Value.appClo cod (\u -> evalIn c a))))
      _ -> failWith "applying something that is not a function"
synF r c (SProj e l) = do
  pe <- r.syn c e
  case pe of
    MkPair e' ety -> do
      fty <- projTyIn c.len ety (evalIn c e) l
      pure
          (MkPair
             (EProj e' l (shapeOfTy c.len ety (evalIn c e)) (fieldTyOf fty))
             fty)
-- a lambda says its type
synF r c (SLam ty abs) = do
  t' <- r.chk c (SLam ty abs) (Value.nom (Eval.evalTy c.globals N ty c.env))
  pure (MkPair t' (Value.nom (Eval.evalTy c.globals N ty c.env)))
synF r c (SIs t2) = r.syn c t2
synF r c (SRec t2) = r.syn c t2
-- a local definition says its type
synF r c (SFix ty abs) = do
  t' <- r.chk c (SFix ty abs) (Value.nom (Eval.evalTy c.globals N ty c.env))
  pure (MkPair t' (Value.nom (Eval.evalTy c.globals N ty c.env)))
synF r c (SImplicit _ t2) = r.syn c t2
synF r c (SLitInt i) = pure (MkPair (EInt i) VPrimInt)
synF r c (SLitFloat x) = pure (MkPair (EFloat x) VPrimFloat)
synF r c (SLitString s) = pure (MkPair (EStr s) VPrimString)
-- (bytes are of the prelude's `Bytes`, as a literal is elaborated)
synF r c (SLitBytes s) =
  pure
    (MkPair
       (EBytes s)
       (Value.nom
          (Eval.evalTy c.globals N (SDecode (SGlobal "prelude.Bytes")) c.env)))
-- (a rune is, where it runs, the `Int32` of its code point)
synF r c (SLitRune n) = pure (MkPair (EFixed I32 n) VPrimRune)
synF r c (SLitFixed w n) = pure (MkPair (EFixed w n) (VFixed w))
synF r c (SLitFloat32 x) = pure (MkPair (EFloat32 x) (VFixed F32))
-- a match where a value is expected and no type given: its type is
-- the first alternative's that says it
synF r c (SMatch scrut cases) = do
  ps <- r.syn c scrut
  case ps of
    MkPair s' sty -> do
      vs <- matchVariants sty
      ty <- armsTy r c vs (Dict.toList cases)
      arms <- traverseM (\p -> armOf r c vs ty p) (Dict.toList cases)
      pure (MkPair (EMatch s' arms) ty)
synF r c t = failWith "this needs an expected type"

chkLam : EK -> Ctx -> Syntax.Abs Syntax.Tm -> Value.Ty -> M IR.Expr
chkLam r c abs ty = case Value.behavior ty of
  LikeFunction level dom cod implicit -> case lamParts abs of
    MkPair (MkPair hint bound) body ->
      if isType c.len dom
      then r.chk
          (if bound then extend c Nothing dom else c)
          body
          (Value.nom (Value.appClo cod (\u -> Value.local c.len dom)))
      else do
        v <- freshName hint
        b <-
          r.chk
            (if bound then extend c (Just (EVar v)) dom else c)
            body
            (Value.nom (Value.appClo cod (\u -> Value.local c.len dom)))
        pure (ELam (Cons v Nil) b)
  _ -> failWith "a function checked against a non-function type"

-- (a tag's argument, and its type as a backend may lay the tag out
-- (#64); a type, none)
chkTagArg : EK
          -> Ctx
          -> Pair Syntax.Tm Value.Ty
          -> M (Maybe (Pair IR.Expr IR.FieldTy))
chkTagArg r c (MkPair a aty) =
  if isType c.len aty then pure Nothing
  else do
    a' <- r.chk c a aty
    pure (Just (MkPair a' (fieldTyOf aty)))

type RecAcc =
  { vs : List Value.V, out : List (Pair String IR.Expr), tys : List IR.FieldTy }

chkFieldsGo : EK
            -> Ctx
            -> Value.Locals Value.V
            -> Dict.Dict (Value.Locals Value.V -> Value.Field)
            -> RecAcc
            -> List (Pair String Syntax.Tm)
            -> M IR.Expr
chkFieldsGo r c capture fieldTypes acc Nil =
  pure (ERecord (List.reverse acc.out) (List.reverse acc.tys))
chkFieldsGo r c capture fieldTypes acc (Cons (MkPair l fe) tail) = case Value.typeForProjection
    capture
    fieldTypes
    l
    { keys = fieldTypes.keys
    , byName = fieldTypes.byName
    , values = Array.fromList (List.reverse acc.vs)
    } of
  MkField fty fvalue ->
    -- a type field is static only
    if isType c.len fty
    then chkFieldsGo
        r
        c
        capture
        fieldTypes
        { vs = Cons (evalIn c fe) acc.vs, out = acc.out, tys = acc.tys }
        tail
    else do
      fe' <- r.chk c fe fty
      chkFieldsGo
          r
          c
          capture
          fieldTypes
          { vs = Cons (evalIn c fe) acc.vs
          , out = Cons (MkPair l fe') acc.out
          , tys = Cons (fieldTyOf fty) acc.tys
          }
          tail

chkF : EK -> Ctx -> Syntax.Tm -> Value.Ty -> M IR.Expr
chkF r c (SIs t') ty = r.chk c t' ty
chkF r c (SRec t') ty = r.chk c t' ty
-- (the definition itself, bound in its body: `EFix`, lifted to a
-- global of its own by `heff.compile.lift`)
chkF r c (SFix _ (MkAbs x body)) ty = do
  v <- freshName x
  b <- r.chk (extend c (Just (EVar v)) ty) body ty
  pure (EFix v b)
chkF r c (SFix _ (AbsConst body)) ty = r.chk c body ty
chkF r c (SImplicit _ t') ty = r.chk c t' ty
chkF r c (SLam _ abs) ty = chkLam r c abs ty
chkF r c (SPrim x) ty = pure (EPrim x)
chkF r c (STag x args) ty = case Value.behavior ty of
  LikeSum vs -> case Dict.lookup vs x of
    Just ts -> do
      out <-
        traverseM
          (\p -> chkTagArg r c p)
          (zipE
             (Array.toList args)
             (List.map (\t2 -> Params.forceTh t2) (Array.toList ts)))
      pure
          (ETag
             x
             (List.map fst (catMaybesE out))
             (List.map snd (catMaybesE out)))
    Nothing -> failWith ("no tag " ^ x)
  _ -> failWith "a tag checked against a non-sum type"
chkF r c (SCons d) ty = case Value.behavior ty of
  LikeRecord level capture fieldTypes ->
    chkFieldsGo
      r
      c
      capture
      fieldTypes
      { vs = Nil, out = Nil, tys = Nil }
      (Dict.toList d)
  _ -> failWith "a record checked against a non-record type"
chkF r c (SMatch scrut cases) ty = do
  ps <- r.syn c scrut
  case ps of
    MkPair s' sty -> do
      vs <- matchVariants sty
      arms <- traverseM (\p -> armOf r c vs ty p) (Dict.toList cases)
      pure (EMatch s' arms)
chkF r c SAbandon ty = pure EAbandon
chkF r c SOpaque ty = failWith "an opaque term"
chkF r c (SCode _) ty = failWith "a type in a value position"
chkF r c t ty = do
  pt <- r.syn c t
  case pt of
    MkPair t' _ -> pure t'

chkDField : EK
          -> Ctx
          -> Value.Ty
          -> Value.V
          -> Maybe (Dict.Dict (Value.Ev Value.V))
          -> Pair String Syntax.Tm
          -> M (Maybe (Pair (Pair String IR.Expr) IR.FieldTy))
chkDField r c ty v fs (MkPair l fe) = do
  fty <- projTyInWith c.len ty fs l
  if isType c.len fty then pure Nothing
    else do
      e <- r.chkD c fe fty (Value.nom (projWith fs v l))
      pure (Just (MkPair (MkPair l e) (fieldTyOf fty)))

-- (a record's fields, its value's fields expanded once for them all)
chkDFields : EK
           -> Ctx
           -> Value.Ty
           -> Value.V
           -> List (Pair String Syntax.Tm)
           -> Maybe (Dict.Dict (Value.Ev Value.V))
           -> M IR.Expr
chkDFields r c ty v ps fs = do
  fields <- traverseM (\p -> chkDField r c ty v fs p) ps
  pure
      (ERecord
         (List.map fst (catMaybesE fields))
         (List.map snd (catMaybesE fields)))

-- | a definition's own syntax, whose value `v` is known: under its
-- | lambdas and through its record's fields the value is followed along
chkDF : EK -> Ctx -> Syntax.Tm -> Value.Ty -> Value.V -> M IR.Expr
chkDF r c t@(SLam _ abs) ty v = case Value.behavior ty of
  LikeFunction level dom cod implicit -> case lamParts abs of
    MkPair (MkPair hint bound) body ->
      if isType c.len dom
      then r.chkD
          (if bound then extend c Nothing dom else c)
          body
          (Value.nom (Value.appClo cod (\u -> Value.local c.len dom)))
          (Value.nom (Value.app v (\u -> Value.local c.len dom)))
      else do
        n <- freshName hint
        b <-
          r.chkD
            (if bound then extend c (Just (EVar n)) dom else c)
            body
            (Value.nom (Value.appClo cod (\u -> Value.local c.len dom)))
            (Value.nom (Value.app v (\u -> Value.local c.len dom)))
        pure (ELam (Cons n Nil) b)
  _ -> r.chk c t ty
chkDF r c t@(SCons d) ty v = case Value.behavior ty of
  LikeRecord level capture fieldTypes ->
    chkDFields r c ty v (Dict.toList d) (Value.coerceToFieldsMaybe v)
  _ -> r.chk c t ty
chkDF r c t ty v = r.chk c t ty

ek : EK
ek =
  { chkD = \c t ty v -> chkDF ek c t ty v
  , chk = \c t ty -> chkF ek c t ty
  , syn = \c t -> synF ek c t
  }

-- | (the definition itself is local 0)
definition : Globals.Globals -> String -> Globals.Entry -> M IR.Expr
definition g key e =
  ek.chkD
    { locals = Cons (mkLocal (Just (EGlobal key)) e.type_) Nil
    , env = Value.snocL LNil e.value
    , len = 1
    , globals = g
    }
    e.syntax
    e.type_
    e.value

type Erased = { defs : List IR.Def, errors : List String, supply : Int }

eraseOne : Globals.Globals -> Erased -> Pair String Globals.Entry -> Erased
eraseOne g acc (MkPair key e) =
  if isType 0 e.type_ then acc
  else case definition g key e acc.supply of
    Right (MkPair body n) ->
      { defs = Cons (IR.mkDef key key body) acc.defs
      , errors = acc.errors
      , supply = n
      }
    Left err ->
      { defs = acc.defs
      , errors = Cons (key ^ ": " ^ err) acc.errors
      , supply = acc.supply
      }

eraseDone : Erased -> Erased
eraseDone acc =
  { defs = List.reverse acc.defs
  , errors = List.reverse acc.errors
  , supply = acc.supply
  }

-- | a program's definitions, in order; the types among them are gone.
-- | What cannot be lowered is said, by key.
-- | >>> List.length (eraseProgram Globals.emptyGlobals).defs
-- | 0
eraseProgram : Globals.Globals -> Erased
eraseProgram g =
  eraseDone
    (List.foldl
       (\acc p -> eraseOne g acc p)
       { defs = Nil, errors = Nil, supply = 0 }
       (Globals.globalsList g))
