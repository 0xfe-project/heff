-- A tag matched again where its arms part (#117).  An arm that takes a
-- tag apart and then looks at one of its fields, where some of the arms
-- of that look want the tag whole and others do not:
--
--   case t of                          case t of
--     Node c l k v r -> case c of        Node c l k v r -> case c of
--       Red -> f l k v r                   Red -> case t of Node c2 l2 k2 v2 r2 -> f l2 k2 v2 r2
--       Black -> g t                       Black -> g t
--
-- reads only the field it looks at, and each arm of the look that wants
-- another field, or not the tag whole, takes the tag apart again there.
-- Perceus decides what an arm does with what it matched for the arm as
-- a whole (heff.compile.refcount): the tag wanted whole on some way
-- through, each field was counted where the arm starts and given back
-- where the tag was given up, its cell freed and a fresh one built; now,
-- where it is given up, its fields are taken over and its cell kept for
-- the tag built there (Koka's drop specialisation), and where it is
-- wanted whole nothing is counted.  The tag is known there: matching it
-- again cannot fail.
--
-- Only the C backend counts references: this runs on what it is given
-- (heff.compile.lower), before the monadic form.

module heff.compile.rematch

import heff.compile.ir as IR
import heff.compile.supply
import std.ordmap as OrdMap

-- (whether `x` occurs in `e`)
mentions : String -> IR.Expr -> Bool
mentions x e = (IR.occurrences x e).count > 0

-- (a variable of an arm, named afresh: but `_`)
freshVar : String -> S String
freshVar v = if strEq v "_" then pure "_" else freshS (IR.baseOf v)

-- (whether the arm `c`, of a look at the field `f` of `x` taken apart
-- of `vs`, wants `x` whole and no field of it but `f`)
keepsWhole : String -> List String -> String -> IR.Expr -> Bool
keepsWhole x vs f c =
  mentions x c
  && not
    (List.any (\v -> not (strEq v f) && not (strEq v "_") && mentions v c) vs)

-- (... that arm, where it gives `x` up or wants a field but `f`: `x`,
-- of the tag `t`, taken apart again there, its fields named afresh)
again : String -> String -> List String -> String -> IR.Arm -> S IR.Arm
again x t vs f (MkArm t2 ws c) =
  if keepsWhole x vs f c then pure (MkArm t2 ws c)
  else do
    vs2 <- traverseS freshVar vs
    pure
        (MkArm
           t2
           ws
           (EMatch
              (EVar x)
              [ MkArm
                t
                vs2
                (IR.subst
                   (OrdMap.fromList
                      (List.zipWith (\v w -> MkPair v (EVar w)) vs vs2))
                   c)
              ]))

-- (whether the look's arms part: some want `x` whole, some do not)
parts : String -> List IR.Arm -> Bool
parts x inner =
  List.any (\a -> mentions x (IR.armBody a)) inner
  && List.any (\a -> not (mentions x (IR.armBody a))) inner

-- (an arm of a match of `x`, its body gone through already)
armOf : String -> IR.Arm -> S IR.Arm
armOf x (MkArm t vs (EMatch (EVar f) inner)) =
  if List.elem f vs && parts x inner
  then do
    inner2 <- traverseS (again x t vs f) inner
    pure (MkArm t vs (EMatch (EVar f) inner2))
  else pure (MkArm t vs (EMatch (EVar f) inner))
armOf x a = pure a

-- (a match of a variable, its arms gone through already)
matchOf : IR.Expr -> S IR.Expr
matchOf (EMatch (EVar x) arms) = do
  arms2 <- traverseS (armOf x) arms
  pure (EMatch (EVar x) arms2)
matchOf e = pure e

-- | an expression, each arm of a match of a variable that looks at a
-- | field so made, inner ones first
go : IR.Expr -> S IR.Expr
go e = bind (IR.traverseParts (\_ p -> go p) e) matchOf

-- (a definition gone through)
defOf : IR.Def -> S IR.Def
defOf d = do
  b <- go d.body
  pure (IR.mkDef d.key d.name b)

-- | the program, each definition gone through; where fresh names go on
-- | from
rematchProgram : IR.Supply -> List IR.Def -> Pair (List IR.Def) IR.Supply
rematchProgram n defs = traverseS defOf defs n
