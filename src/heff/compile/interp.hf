-- An untyped evaluator for elaborated syntax.  Types evaluate to
-- `VErased`.
--
-- Evaluation is by value, as the compiled code runs: an argument, a
-- constructor's field and a record's field are evaluated before they
-- are passed or put, in order, used or not.  A global is evaluated when
-- first used.  `abandon` is a value, `Abn`, threaded through every
-- step -- so a watch that abandons reports `<abandoned>` instead of
-- ending the run.  Evaluation that goes deeper than `deepest` is said
-- to diverge, `Div`: every function and every thunk is given the depth
-- it is forced at.  What type checking rules out -- a value of the wrong
-- shape, a name not in scope -- is a bug of the compiler, `Bug`, said
-- (`<compiler bug: ...>`) and never taken for a value.

import array as Array
import float32 as Float32
import heff.util.dict as Dict
import heff.elab.fixed as Fixed
import heff.elab.globals as Globals
import heff.util.rune as RuneUtil
import heff.elab.syntax as Syntax
import map as Map
import rune as Rune
import std.math as Math
import uint8 as UInt8

-- | a computation forced at a depth
type Th a = Int -> a

data Res a = Ok a | Abn | Div | Bug String

data Val
  = VFun (Int -> Th (Res Val) -> Res Val)
  | VCons (Dict.Dict Val)
  | VTag String (List Val)
  | VInt Int
  | VFloat Float64
  | VFloat32 Float32
  | VStr String
  -- | a `Rune`: its code point
  | VRune Int
  | VArr (Array Val)
  -- | `Bytes`: kept as a string of them
  | VBytes String
  | VErased

type RVal = Res Val

rbind : RVal -> (Val -> RVal) -> RVal
rbind (Ok v) f = f v
rbind Abn f = Abn
rbind Div f = Div
rbind (Bug what) f = Bug what

okTh : Val -> Th RVal
okTh v = \d -> Ok v

-- | how deep evaluation goes before it is said to diverge: deeper than a
-- | program that ends needs
deepest : Int
deepest = 1000000

-- | a function applied, by evaluation at depth `d`
app : Int -> Val -> Th RVal -> RVal
app d (VFun f) v = f d v
app d VErased _ = Ok VErased
app d _ _ = Bug "applied what is not a function"

projV : Val -> String -> RVal
projV (VCons fs) x = Ok (Dict.elemAt fs x)
projV VErased _ = Ok VErased
projV _ x = Bug ("`." ^ x ^ "` of what is not a record")

-- Primitives (the interpreter's side of `heff.compile.prims`): answers are
-- builtin's Bool, the tags True/False
--------------------------------------------------------------------------------

boolV : Bool -> Val
boolV b = VTag (if b then "True" else "False") Nil

-- (a primitive given a value of the wrong shape, a bug of the compiler:
-- each said once, not at every primitive that takes such a value)
notAnInt : RVal
notAnInt = Bug "a primitive given what is not an `Int`"

notAFloat64 : RVal
notAFloat64 = Bug "a primitive given what is not a `Float64`"

notAString : RVal
notAString = Bug "a primitive given what is not a `String`"

notARune : RVal
notARune = Bug "a primitive given what is not a `Rune`"

notAnArray : RVal
notAnArray = Bug "a primitive given what is not an array"

notBytes : RVal
notBytes = Bug "a primitive given what is not `Bytes`"

notAFloat32 : RVal
notAFloat32 = Bug "a primitive given what is not a `Float32`"

intTake2 : (Int -> Int -> RVal) -> Val -> Val -> RVal
intTake2 f (VInt a) (VInt b) = f a b
intTake2 f _ _ = notAnInt

int2 : (Int -> Int -> RVal) -> Val
int2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> intTake2 f av bv)))))

floatTake1 : (Float64 -> RVal) -> Val -> RVal
floatTake1 f (VFloat a) = f a
floatTake1 f _ = notAFloat64

float1 : (Float64 -> RVal) -> Val
float1 f = VFun (\d a -> rbind (a d) (\av -> floatTake1 f av))

floatTake2 : (Float64 -> Float64 -> RVal) -> Val -> Val -> RVal
floatTake2 f (VFloat a) (VFloat b) = f a b
floatTake2 f _ _ = notAFloat64

float2 : (Float64 -> Float64 -> RVal) -> Val
float2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> floatTake2 f av bv)))))

strTake1 : (String -> RVal) -> Val -> RVal
strTake1 f (VStr a) = f a
strTake1 f _ = notAString

str1 : (String -> RVal) -> Val
str1 f = VFun (\d a -> rbind (a d) (\av -> strTake1 f av))

strTake2 : (String -> String -> RVal) -> Val -> Val -> RVal
strTake2 f (VStr a) (VStr b) = f a b
strTake2 f _ _ = notAString

str2 : (String -> String -> RVal) -> Val
str2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> strTake2 f av bv)))))

runeTake1 : (Int -> RVal) -> Val -> RVal
runeTake1 f (VRune a) = f a
runeTake1 f _ = notARune

rune1 : (Int -> RVal) -> Val
rune1 f = VFun (\d a -> rbind (a d) (\av -> runeTake1 f av))

runeTake2 : (Int -> Int -> RVal) -> Val -> Val -> RVal
runeTake2 f (VRune a) (VRune b) = f a b
runeTake2 f _ _ = notARune

rune2 : (Int -> Int -> RVal) -> Val
rune2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> runeTake2 f av bv)))))

bytesTake1 : (String -> RVal) -> Val -> RVal
bytesTake1 f (VBytes a) = f a
bytesTake1 f _ = notBytes

bytes1 : (String -> RVal) -> Val
bytes1 f = VFun (\d a -> rbind (a d) (\av -> bytesTake1 f av))

bytesTake2 : (String -> String -> RVal) -> Val -> Val -> RVal
bytesTake2 f (VBytes a) (VBytes b) = f a b
bytesTake2 f _ _ = notBytes

bytes2 : (String -> String -> RVal) -> Val
bytes2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> bytesTake2 f av bv)))))

-- (a list's bytes, each a `UInt8`, as a string of them; what is no byte,
-- none)
byteString : List Val -> String -> String
byteString Nil acc = acc
byteString (Cons (VInt c) rest) acc =
  byteString rest (acc ^ fromByte (UInt8.fromInt c))
byteString (Cons _ rest) acc = byteString rest acc

-- (a list's `Bytes`, one after another; what is no `Bytes`, a bug)
bytesJoined : List Val -> String -> RVal
bytesJoined Nil acc = Ok (VBytes acc)
bytesJoined (Cons (VBytes b) rest) acc = bytesJoined rest (acc ^ b)
bytesJoined (Cons _ rest) acc = notBytes

-- (a binary's segments', as lib/c/runtime.c's `heff_bytesIntAt` and
-- `heff_bytesOfInt`: 2 to the `k`)
twoTo : Int -> Int
twoTo k = if k <= 0 then 1 else 2 * twoTo (k - 1)

-- (the bytes of `s`, the last first)
reversedBytes : String -> Int -> String -> String
reversedBytes s i acc =
  if i >= strLength s then acc
  else reversedBytes s (i + 1) (strSlice s i (i + 1) ^ acc)

-- (the `n` bits of `s` from bit `i`, the most significant first, after
-- `acc`)
bitsRead : String -> Int -> Int -> Int -> Int
bitsRead s i n acc =
  if n <= 0 then acc
  else bitsRead
      s
      (i + 1)
      (n - 1)
      (acc * 2 + byteAt s (i / 8) / twoTo (7 - i % 8) % 2)

-- (`u`, of `n` bits, as a signed integer where `signed` is)
signedOf : Bool -> Int -> Int -> Int
signedOf signed n u =
  if signed && n > 0 && u >= twoTo (n - 1) then u - twoTo n else u

-- (the integer of `n` bits at bit `o` of `s`, the flags `f` 1 for
-- little-endian, 2 for signed; out of them, abandoned)
bytesIntAtV : String -> Int -> Int -> Int -> RVal
bytesIntAtV s o n f =
  if o < 0 || n < 0 || n > 64 || o + n > strLength s * 8 then Abn
  else if f % 2 == 1 && o % 8 == 0 && n % 8 == 0
    then Ok
        (VInt
           (signedOf
              (f / 2 % 2 == 1)
              n
              (bitsRead
                 (reversedBytes (strSlice s (o / 8) ((o + n) / 8)) 0 "")
                 0
                 n
                 0)))
  else Ok (VInt (signedOf (f / 2 % 2 == 1) n (bitsRead s o n 0)))

-- (the `k` bytes of `u`, not negative, the most significant first,
-- after `acc`)
bytesOfNat : Int -> Int -> String -> String
bytesOfNat k u acc =
  if k <= 0 then acc
  else bytesOfNat (k - 1) (u / 256) (fromByte (UInt8.fromInt (u % 256)) ^ acc)

-- (the bytes `b`, the last first where the flags `f` have 1)
littleIf : Int -> String -> String
littleIf f b = if f % 2 == 1 then reversedBytes b 0 "" else b

-- (the integer `v`, its low `n` bits, a multiple of 8, as bytes: the
-- least first where `f` has 1)
bytesOfIntV : Int -> Int -> Int -> RVal
bytesOfIntV n f v =
  if n < 0 || n > 64 || not (n % 8 == 0) then Abn
  else Ok
      (VBytes
         (littleIf f (bytesOfNat (n / 8) ((v % twoTo n + twoTo n) % twoTo n) "")))

-- (a list's runes, their code points; of what is no list of runes, none)
runeCodes : List Val -> List Int
runeCodes Nil = Nil
runeCodes (Cons (VRune c) rest) = Cons c (runeCodes rest)
runeCodes (Cons _ rest) = runeCodes rest

intTake1 : (Int -> RVal) -> Val -> RVal
intTake1 f (VInt a) = f a
intTake1 f _ = notAnInt

int1 : (Int -> RVal) -> Val
int1 f = VFun (\d a -> rbind (a d) (\av -> intTake1 f av))

-- (an array's element type is given first, erased)
tyThen : Val -> Val
tyThen k = VFun (\d u -> Ok k)

arrTake1 : (Array Val -> RVal) -> Val -> RVal
arrTake1 f (VArr xs) = f xs
arrTake1 f _ = notAnArray

arr1 : (Array Val -> RVal) -> Val
arr1 f = VFun (\d a -> rbind (a d) (\av -> arrTake1 f av))

isFiniteF : Float64 -> Bool
isFiniteF x = x - x == 0.0

setAt : List Val -> Int -> Val -> List Val
setAt Nil i x = Nil
setAt (Cons y ys) i x =
  if i == 0 then Cons x ys else Cons y (setAt ys (i - 1) x)

genGo : Int -> Int -> Int -> Val -> (List Val -> RVal) -> RVal
genGo d j n f k =
  if j >= n then k Nil
  else rbind
      (app d f (okTh (VInt j)))
      (\v -> genGo d (j + 1) n f (\vs -> k (Cons v vs)))

-- (a list's cells, builtin's `Cons`/`Nil`)
fromListV : Val -> List Val -> List Val
fromListV (VTag "Cons" (Cons x (Cons rest Nil))) acc =
  fromListV rest (Cons x acc)
fromListV _ acc = List.reverse acc

toListV : List Val -> Val
toListV Nil = VTag "Nil" Nil
toListV (Cons x xs) = VTag "Cons" (Cons x (Cons (toListV xs) Nil))

nthV : List Val -> Int -> Maybe Val
nthV Nil i = Nothing
nthV (Cons x xs) i = if i == 0 then Just x else nthV xs (i - 1)

-- An integer's bits, as two's complement has them, its sign extended for
-- ever: `f` of two integers' each pair of bits, the last pair (both
-- integers 0 or -1, of nothing but their sign) standing for every one
-- after it
intBits : (Int -> Int -> Int) -> Int -> Int -> Int
intBits f a b =
  if (a == 0 || a == -1) && (b == 0 || b == -1) then 0 - f (a % 2) (b % 2)
  else f (a % 2) (b % 2) + 2 * intBits f (a / 2) (b / 2)

-- (a shift by `f`, of a power of 2; by a negative count, one the other
-- way, by `back`)
intShift : (Int -> Int -> Int) -> (Int -> Int -> Int) -> Int -> Int -> RVal
intShift f back a b =
  if b < 0 then Ok (VInt (back a (Fixed.twoTo (0 - b))))
  else Ok (VInt (f a (Fixed.twoTo b)))

-- The fixed-width integers (heff.elab.fixed): each an integer of its type's
-- range, computed with as one and wrapped around to the type

-- (whether two integers' signs differ)
signsDiffer : Int -> Int -> Bool
signsDiffer a b = if a < 0 then b >= 0 else b < 0

-- (as C divides: rounding toward zero)
truncDiv : Int -> Int -> Int
truncDiv a b = if a % b /= 0 && signsDiffer a b then a / b + 1 else a / b

-- (the bits of two integers from 0 to 2^n - 1, each pair to one by `f`)
bitwise : (Int -> Int -> Int) -> Int -> Int -> Int -> Int
bitwise f n a b =
  if n == 0 then 0
  else f (a % 2) (b % 2) + 2 * bitwise f (n - 1) (a / 2) (b / 2)

-- (an integer type's operation of two values, as its bits: those of the
-- values from 0 to 2^bits - 1)
bitsOf : Fixed.Fixed -> (Int -> Int -> Int) -> Int -> Int -> RVal
bitsOf w f a b =
  Ok
    (VInt
       (Fixed.wrapFixed
          w
          (bitwise
             f
             (Fixed.fixedBits w)
             (a % Fixed.twoTo (Fixed.fixedBits w))
             (b % Fixed.twoTo (Fixed.fixedBits w)))))

wrapV : Fixed.Fixed -> Int -> RVal
wrapV w n = Ok (VInt (Fixed.wrapFixed w n))

-- (a shift's amount, of a count from 0: modulo the bits)
shiftOf : Fixed.Fixed -> Int -> Int
shiftOf w b = Fixed.twoTo (b % Fixed.fixedBits w)

fixedInt2 : Fixed.Fixed -> Fixed.FixedOp -> Int -> Int -> RVal
fixedInt2 w OpAdd a b = wrapV w (a + b)
fixedInt2 w OpSub a b = wrapV w (a - b)
fixedInt2 w OpMul a b = wrapV w (a * b)
fixedInt2 w OpDiv a b = if b == 0 then wrapV w 0 else wrapV w (truncDiv a b)
fixedInt2 w OpRem a b =
  if b == 0 then wrapV w a else wrapV w (a - b * truncDiv a b)
fixedInt2 w OpEq a b = Ok (boolV (a == b))
fixedInt2 w OpLt a b = Ok (boolV (a < b))
fixedInt2 w OpLe a b = Ok (boolV (a <= b))
fixedInt2 w OpAnd a b = bitsOf w (\x y -> x * y) a b
fixedInt2 w OpOr a b = bitsOf w (\x y -> if x + y > 0 then 1 else 0) a b
fixedInt2 w OpXor a b = bitsOf w (\x y -> (x + y) % 2) a b
-- (by a negative count, of a signed type, a shift the other way by its
-- size; right, rounding down: arithmetic, of a negative value)
fixedInt2 w OpShl a b =
  if b < 0 then Ok (VInt (a / shiftOf w (0 - b))) else wrapV w (a * shiftOf w b)
fixedInt2 w OpShr a b =
  if b < 0 then wrapV w (a * shiftOf w (0 - b)) else Ok (VInt (a / shiftOf w b))
fixedInt2 w op a b =
  Bug ("no primitive " ^ Fixed.fixedPrimName (Fixed.mkFixedPrim w op))

fixedInt1 : Fixed.Fixed -> Fixed.FixedOp -> Int -> RVal
fixedInt1 w OpShow a = Ok (VStr (show a))
fixedInt1 w OpFromInt a = wrapV w a
fixedInt1 w OpToInt a = Ok (VInt a)
fixedInt1 w op a =
  Bug ("no primitive " ^ Fixed.fixedPrimName (Fixed.mkFixedPrim w op))

-- `Float32`: the host's (lib/float32.hf)

f32Take1 : (Float32 -> RVal) -> Val -> RVal
f32Take1 f (VFloat32 a) = f a
f32Take1 f _ = notAFloat32

f32V1 : (Float32 -> RVal) -> Val
f32V1 f = VFun (\d a -> rbind (a d) (\av -> f32Take1 f av))

f32Take2 : (Float32 -> Float32 -> RVal) -> Val -> Val -> RVal
f32Take2 f (VFloat32 a) (VFloat32 b) = f a b
f32Take2 f _ _ = notAFloat32

f32V2 : (Float32 -> Float32 -> RVal) -> Val
f32V2 f =
  VFun
    (\d a ->
       Ok
         (VFun
            (\d b ->
               rbind (a d) (\av -> rbind (b d) (\bv -> f32Take2 f av bv)))))

f32Ok : Float32 -> RVal
f32Ok x = Ok (VFloat32 x)

-- (of what is not finite, 0)
f32Floor : Float32 -> RVal
f32Floor a =
  if isFiniteF (Float32.toFloat a) then Ok (VInt (Float32.floor a))
  else Ok (VInt 0)

float32V : Fixed.FixedOp -> Val
float32V OpAdd = f32V2 (\a b -> f32Ok (Float32.add a b))
float32V OpSub = f32V2 (\a b -> f32Ok (Float32.sub a b))
float32V OpMul = f32V2 (\a b -> f32Ok (Float32.mul a b))
float32V OpDiv = f32V2 (\a b -> f32Ok (Float32.div a b))
float32V OpEq = f32V2 (\a b -> Ok (boolV (Float32.eq a b)))
float32V OpLt = f32V2 (\a b -> Ok (boolV (Float32.lt a b)))
float32V OpLe = f32V2 (\a b -> Ok (boolV (Float32.le a b)))
float32V OpSqrt = f32V1 (\a -> f32Ok (Float32.sqrt a))
float32V OpShow = f32V1 (\a -> Ok (VStr (show a)))
float32V OpFromFloat = float1 (\a -> f32Ok (Float32.fromFloat a))
float32V OpToFloat = f32V1 (\a -> Ok (VFloat (Float32.toFloat a)))
float32V OpFromInt = int1 (\a -> f32Ok (Float32.fromInt a))
float32V OpFloor = f32V1 f32Floor
float32V op = VFun (\d a -> Bug ("no primitive float32" ^ Fixed.opName op))

fixedPrimV : Fixed.FixedPrim -> Val
fixedPrimV p =
  if Fixed.isFloat32 p.fixed then float32V p.op
  else if Fixed.opArity p.op == 2 then int2 (fixedInt2 p.fixed p.op)
  else int1 (fixedInt1 p.fixed p.op)

prim : String -> Val
prim p =
  if strEq p "intAdd" then int2 (\a b -> Ok (VInt (a + b)))
  else if strEq p "intSub" then int2 (\a b -> Ok (VInt (a - b)))
  else if strEq p "intMul" then int2 (\a b -> Ok (VInt (a * b)))
  -- (by zero, 0, and the remainder the dividend: a division is total)
  else if strEq p "intDiv"
    then int2 (\a b -> if b == 0 then Ok (VInt 0) else Ok (VInt (a / b)))
  else if strEq p "intMod"
    then int2 (\a b -> if b == 0 then Ok (VInt a) else Ok (VInt (a % b)))
  else if strEq p "intEq" then int2 (\a b -> Ok (boolV (a == b)))
  else if strEq p "intLt" then int2 (\a b -> Ok (boolV (a < b)))
  else if strEq p "intLe" then int2 (\a b -> Ok (boolV (a <= b)))
  else if strEq p "intShow" then int1 (\a -> Ok (VStr (show a)))
  else if strEq p "intAnd"
    then int2 (\a b -> Ok (VInt (intBits (\x y -> x * y) a b)))
  else if strEq p "intOr"
    then int2
        (\a b -> Ok (VInt (intBits (\x y -> if x + y > 0 then 1 else 0) a b)))
  else if strEq p "intXor"
    then int2 (\a b -> Ok (VInt (intBits (\x y -> (x + y) % 2) a b)))
  else if strEq p "intShl" then int2 (intShift (\a k -> a * k) (\a k -> a / k))
  else if strEq p "intShr" then int2 (intShift (\a k -> a / k) (\a k -> a * k))
  else if strEq p "floatAdd" then float2 (\a b -> Ok (VFloat (a + b)))
  else if strEq p "floatSub" then float2 (\a b -> Ok (VFloat (a - b)))
  else if strEq p "floatMul" then float2 (\a b -> Ok (VFloat (a * b)))
  else if strEq p "floatDiv" then float2 (\a b -> Ok (VFloat (a /. b)))
  else if strEq p "floatEq" then float2 (\a b -> Ok (boolV (a == b)))
  else if strEq p "floatLt" then float2 (\a b -> Ok (boolV (a < b)))
  else if strEq p "floatLe" then float2 (\a b -> Ok (boolV (a <= b)))
  else if strEq p "floatShow" then float1 (\a -> Ok (VStr (show a)))
  else if strEq p "floatFromInt" then int1 (\a -> Ok (VFloat (toFloat a)))
  else if strEq p "floatSqrt" then float1 (\a -> Ok (VFloat (sqrt a)))
  -- (of what is not finite, 0)
  else if strEq p "floatFloor"
    then float1 (\a -> if isFiniteF a then Ok (VInt (floor a)) else Ok (VInt 0))
  else if strEq p "floatSin" then float1 (\a -> Ok (VFloat (Math.sin a)))
  else if strEq p "floatCos" then float1 (\a -> Ok (VFloat (Math.cos a)))
  else if strEq p "floatTan" then float1 (\a -> Ok (VFloat (Math.tan a)))
  else if strEq p "floatAsin" then float1 (\a -> Ok (VFloat (Math.asin a)))
  else if strEq p "floatAcos" then float1 (\a -> Ok (VFloat (Math.acos a)))
  else if strEq p "floatAtan" then float1 (\a -> Ok (VFloat (Math.atan a)))
  else if strEq p "floatAtan2"
    then float2 (\a b -> Ok (VFloat (Math.atan2 a b)))
  else if strEq p "floatExp" then float1 (\a -> Ok (VFloat (Math.exp a)))
  else if strEq p "floatLog" then float1 (\a -> Ok (VFloat (Math.log a)))
  else if strEq p "floatPow" then float2 (\a b -> Ok (VFloat (Math.pow a b)))
  else if strEq p "arrayLength"
    then tyThen (arr1 (\xs -> Ok (VInt (List.length (Array.toList xs)))))
  else if strEq p "arrayIndex"
    then tyThen
        (arr1
           (\xs ->
              Ok
                (int1
                   (\i ->
                      if 0 <= i && i < List.length (Array.toList xs)
                        then (case nthV (Array.toList xs) i of
                              Just v -> Ok v
                              Nothing -> Bug "an index in range, of no element")
                      else Abn))))
  else if strEq p "arraySet"
    then tyThen
        (arr1
           (\xs ->
              Ok
                (int1
                   (\i ->
                      Ok
                        (VFun
                           (\d x ->
                              rbind
                                (x d)
                                (\xv ->
                                   if 0 <= i
                                   && i < List.length (Array.toList xs)
                                     then Ok
                                         (VArr
                                            (Array.fromList
                                               (setAt (Array.toList xs) i xv)))
                                   else Ok (VArr xs))))))))
  else if strEq p "arrayGenerate"
    then tyThen
        (int1
           (\n ->
              Ok
                (VFun
                   (\d f ->
                      rbind
                        (f d)
                        (\fv ->
                           genGo
                             d
                             0
                             n
                             fv
                             (\vs -> Ok (VArr (Array.fromList vs))))))))
  else if strEq p "arrayFromList"
    then tyThen
        (VFun
           (\d l ->
              rbind
                (l d)
                (\lv -> Ok (VArr (Array.fromList (fromListV lv Nil))))))
  else if strEq p "arrayToList"
    then tyThen (arr1 (\xs -> Ok (toListV (Array.toList xs))))
  else if strEq p "strAppend" then str2 (\a b -> Ok (VStr (a ^ b)))
  else if strEq p "strLength" then str1 (\a -> Ok (VInt (strLength a)))
  else if strEq p "strSlice"
    then str1
        (\a -> Ok (int1 (\i -> Ok (int1 (\j -> Ok (VStr (strSlice a i j)))))))
  else if strEq p "strEq" then str2 (\a b -> Ok (boolV (strEq a b)))
  else if strEq p "strLt" then str2 (\a b -> Ok (boolV (strLt a b)))
  -- (a string as bytes: the host's strings, UTF-8 bytes as the
  -- interpreted program's are; a byte, a `UInt8`, an integer from 0 to
  -- 255)
  else if strEq p "strByteAt"
    then str1 (\a -> Ok (int1 (\i -> Ok (VInt (byteAt a i)))))
  else if strEq p "strFromByte"
    then int1 (\c -> Ok (VStr (fromByte (UInt8.fromInt c))))
  else if strEq p "strRuneAt"
    then str1
        (\a -> Ok (int1 (\i -> Ok (VRune (Rune.toInt (runeAt a i).rune)))))
  else if strEq p "strRuneWidth"
    then str1 (\a -> Ok (int1 (\i -> Ok (VInt (runeAt a i).width))))
  else if strEq p "strRuneCount" then str1 (\a -> Ok (VInt (Rune.count a)))
  else if strEq p "strToJS" then str1 (\a -> Ok (VStr (ofRunes (runes a))))
  else if strEq p "strFromJS" then str1 (\a -> Ok (VStr a))
  -- (`Bytes`, a string of them: a byte a `UInt8`, an integer from 0 to
  -- 255; made text as `rune`'s `toValid` makes a string)
  else if strEq p "bytesLength" then bytes1 (\a -> Ok (VInt (strLength a)))
  else if strEq p "bytesAt"
    then bytes1
        (\a ->
           Ok
             (int1
                (\i ->
                   if 0 <= i && i < strLength a then Ok (VInt (byteAt a i))
                   else Abn)))
  else if strEq p "bytesSlice"
    then bytes1
        (\a -> Ok (int1 (\i -> Ok (int1 (\j -> Ok (VBytes (strSlice a i j)))))))
  else if strEq p "bytesAppend" then bytes2 (\a b -> Ok (VBytes (a ^ b)))
  else if strEq p "bytesConcat"
    then VFun (\d l -> rbind (l d) (\lv -> bytesJoined (fromListV lv Nil) ""))
  else if strEq p "bytesEq" then bytes2 (\a b -> Ok (boolV (strEq a b)))
  else if strEq p "bytesFromList"
    then VFun
        (\d l ->
           rbind (l d) (\lv -> Ok (VBytes (byteString (fromListV lv Nil) ""))))
  else if strEq p "bytesToList"
    then bytes1
        (\a ->
           Ok
             (toListV
                (List.map
                   (\i -> VInt (byteAt a i))
                   (List.range 0 (strLength a - 1)))))
  else if strEq p "bytesFromString" then str1 (\a -> Ok (VBytes a))
  else if strEq p "bytesToString" then bytes1 (\a -> Ok (VStr (Rune.toValid a)))
  else if strEq p "bytesIntAt"
    then bytes1
        (\a ->
           Ok (int1 (\o -> Ok (int1 (\n -> Ok (int1 (\f -> bytesIntAtV a o n f)))))))
  else if strEq p "bytesOfInt"
    then int1
        (\n -> Ok (int1 (\f -> Ok (int1 (\v -> bytesOfIntV n f v)))))
  else if strEq p "bytesHasAt"
    then bytes1
        (\a ->
           Ok
             (int1
                (\o ->
                   Ok
                     (bytes1
                        (\b ->
                           Ok
                             (boolV
                                (0 <= o
                                 && o + strLength b <= strLength a
                                 && strEq (strSlice a o (o + strLength b)) b)))))))
  else if strEq p "runeEq" then rune2 (\a b -> Ok (boolV (a == b)))
  else if strEq p "runeLt" then rune2 (\a b -> Ok (boolV (a < b)))
  else if strEq p "runeLe" then rune2 (\a b -> Ok (boolV (a <= b)))
  else if strEq p "runeToInt" then rune1 (\a -> Ok (VInt a))
  -- (wrapped around to 32 bits, as an `Int32` is)
  else if strEq p "runeFromInt"
    then int1 (\a -> Ok (VRune (Fixed.wrapFixed I32 a)))
  -- (the host's: its strings' runes, UTF-8, read and written)
  else if strEq p "strRunes"
    then str1
        (\a -> Ok (toListV (List.map (\r -> VRune (Rune.toInt r)) (runes a))))
  else if strEq p "strOfRunes"
    then VFun
        (\d l ->
           rbind
             (l d)
             (\lv ->
                Ok
                  (VStr
                     (ofRunes
                        (List.map
                           Rune.fromInt
                           (runeCodes (fromListV lv Nil)))))))
  else case Fixed.fixedPrimOf p of
    Just fp -> fixedPrimV fp
    Nothing -> VFun (\d a -> Bug ("no primitive " ^ p))

type Env = { local : List (Th RVal), global : Map.Map String (Th RVal) }

bindLocal : Env -> Th RVal -> Env
bindLocal e v = { local = Cons v e.local, global = e.global }

bindVals : Env -> List Val -> Env
bindVals e vs = List.foldl (\e2 v -> bindLocal e2 (okTh v)) e vs

nthTh : List (Th RVal) -> Int -> Maybe (Th RVal)
nthTh Nil i = Nothing
nthTh (Cons x xs) i =
  if i == 0 then Just x else if i < 0 then Nothing else nthTh xs (i - 1)

-- (evaluated fields and arguments, in order; the first abandon wins)
evalEach : (Syntax.Tm -> RVal) -> List Syntax.Tm -> (List Val -> RVal) -> RVal
evalEach ev Nil k = k Nil
evalEach ev (Cons t rest) k =
  rbind (ev t) (\v -> evalEach ev rest (\vs -> k (Cons v vs)))

evalFields : (Syntax.Tm -> RVal)
           -> List (Pair String Syntax.Tm)
           -> (List (Pair String Val) -> RVal)
           -> RVal
evalFields ev Nil k = k Nil
evalFields ev (Cons (MkPair l t) rest) k =
  rbind (ev t) (\v -> evalFields ev rest (\vs -> k (Cons (MkPair l v) vs)))

evalIn : Int -> Env -> Syntax.Tm -> RVal
evalIn d e t =
  if d > deepest then Div
  else case t of
    SLocal i -> case nthTh e.local i of
      Just v -> v d
      Nothing -> Bug ("local " ^ show i ^ " is not in scope")
    SGlobal x -> case Map.lookup compareString x e.global of
      Just v -> v d
      Nothing -> Bug (x ^ " is not in scope")
    SLam _ (MkAbs _ body) ->
      Ok (VFun (\dc v -> evalIn (dc + 1) (bindLocal e v) body))
    SLam _ (AbsConst body) -> Ok (VFun (\dc u -> evalIn (dc + 1) e body))
    SApp t1 t2 ->
      rbind
        (evalIn (d + 1) e t1)
        (\f -> rbind (evalIn (d + 1) e t2) (\a -> app d f (okTh a)))
    SCons fs ->
      evalFields
        (\t2 -> evalIn (d + 1) e t2)
        (Dict.toList fs)
        (\vs -> Ok (VCons (Dict.fromList vs)))
    SProj t2 x -> rbind (evalIn (d + 1) e t2) (\v -> projV v x)
    STag x ts ->
      evalEach
        (\t2 -> evalIn (d + 1) e t2)
        (Array.toList ts)
        (\vs -> Ok (VTag x vs))
    SMatch scrut cases ->
      rbind (evalIn (d + 1) e scrut) (\v -> case v of
      VTag x vs ->
        (case Dict.lookup cases x of
         Just (MkPair _ body) -> evalIn (d + 1) (bindVals e vs) body
         Nothing -> Bug ("no case for " ^ x))
      VErased -> Ok VErased
      _ -> Bug "a case of what is not a tag")
    SCode _ -> Ok VErased
    SIs t2 -> evalIn (d + 1) e t2
    SAbandon -> Abn
    SRec t2 -> evalIn (d + 1) e t2
    -- (the definition itself is its own body, evaluated again whenever it
    -- is called for)
    SFix ty (MkAbs x body) ->
      evalIn
        (d + 1)
        (bindLocal e (\dc -> evalIn dc e (SFix ty (MkAbs x body))))
        body
    SFix _ (AbsConst body) -> evalIn (d + 1) e body
    SPrim x -> Ok (prim x)
    SLitInt i -> Ok (VInt i)
    SLitFloat x -> Ok (VFloat x)
    SLitString s -> Ok (VStr s)
    SLitBytes s -> Ok (VBytes s)
    SLitRune c -> Ok (VRune c)
    -- (a fixed-width integer is an integer, of its type's range)
    SLitFixed _ i -> Ok (VInt i)
    SLitFloat32 x -> Ok (VFloat32 (Float32.fromFloat x))
    SImplicit _ t2 -> evalIn (d + 1) e t2
    SSpecialize _ _ _ -> Ok VErased
    _ -> Bug "a term that is not evaluated"

-- Results, as the tools show them
--------------------------------------------------------------------------------

data EvalResult = RSucceeded Val | RAbandoned | RDiverged | RBug String

scalarV : Val -> String
scalarV (VFun _) = "#fun"
scalarV (VInt i) = show i
scalarV (VFloat x) = show x
scalarV (VFloat32 x) = show x
scalarV (VStr s) = RuneUtil.quoteString s
scalarV (VRune c) = RuneUtil.quote c
scalarV (VBytes s) = RuneUtil.quoteBytes s
scalarV VErased = "#erased"
scalarV _ = "#value"

-- | a list's items, `Cons a (Cons b Nil)` as `[a, b]` writes them; not
-- | one, a chain that does not end in `Nil`
listValsGo : Val -> List Val -> Maybe (List Val)
listValsGo (VTag "Nil" Nil) acc = Just (List.reverse acc)
listValsGo (VTag "Cons" (Cons x (Cons rest Nil))) acc =
  listValsGo rest (Cons x acc)
listValsGo _ acc = Nothing

-- | a value as the tools show it: a list as `[a, b]`, and a tag with
-- | arguments parenthesized where it is an argument, so what is shown
-- | reads back as the same value
showValGo : Bool -> Val -> String
showValGo inArg (VTag x vs) = case listValsGo (VTag x vs) Nil of
  Just items ->
    "[" ^ joinWith ", " (List.map (\a -> showValGo False a) items) ^ "]"
  Nothing ->
    if List.null vs then x
    else if inArg
      then "("
        ^ x
        ^ joinWith "" (List.map (\a -> " " ^ showValGo True a) vs)
        ^ ")"
    else x ^ joinWith "" (List.map (\a -> " " ^ showValGo True a) vs)
showValGo inArg (VCons fs) =
  "{ "
  ^ joinWith
    ", "
    (List.map
       (\(p : Pair String Val) -> fst p ^ " = " ^ showValGo False (snd p))
       (Dict.toList fs))
  ^ " }"
showValGo inArg (VArr xs) =
  "["
  ^ joinWith ", " (List.map (\a -> showValGo False a) (Array.toList xs))
  ^ "]"
-- (a negative number, an argument: `Just (-7)`)
showValGo inArg v =
  if inArg && startsWith "-" (scalarV v) then "(" ^ scalarV v ^ ")"
  else scalarV v

-- | >>> showVal (VTag "Just" [toListV [VInt 1, VInt (-2)]])
-- | "Just [1, -2]"
-- | >>> showVal (VTag "Cons" [VTag "Nil" [], VTag "Nil" []])
-- | "[[]]"
-- | >>> showVal (VTag "Cons" [VInt 1, VTag "Just" [VInt 2]])
-- | "Cons 1 (Just 2)"
showVal : Val -> String
showVal v = showValGo False v

showResult : EvalResult -> String
showResult (RSucceeded v) = showVal v
showResult RAbandoned = "<abandoned>"
showResult RDiverged = "<diverged>"
showResult (RBug what) = "<compiler bug: " ^ what ^ ">"

-- Globals
--------------------------------------------------------------------------------

type GlobalEnv = Map.Map String (Th RVal)

-- (the definition itself is local 0: forcing it ties the knot)
fixThunk : GlobalEnv -> Syntax.Tm -> Th RVal
fixThunk g t = \d ->
    evalIn (d + 1) { local = Cons (fixThunk g t) Nil, global = g } t

-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = Map.empty } (SApp (SApp (SPrim "intAdd") (SLitInt 2)) (SLitInt 3))))
-- | "5"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = Map.empty } (SApp (SApp (SPrim "intDiv") (SLitInt 2)) (SLitInt 0))))
-- | "0"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = Map.empty } (SApp (SApp (SPrim "intShl") (SLitInt 2)) (SLitInt -1))))
-- | "1"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = Map.empty } SAbandon))
-- | "<abandoned>"
-- | >>> showResult (resultOf (evalIn 0 { local = Nil, global = Map.empty } (SApp (SLitInt 1) (SLitInt 2))))
-- | "<compiler bug: applied what is not a function>"
resultOf : RVal -> EvalResult
resultOf (Ok v) = RSucceeded v
resultOf Abn = RAbandoned
resultOf Div = RDiverged
resultOf (Bug what) = RBug what

-- | a value given `n` arguments that are types first -- erased where it
-- | is compiled, so given as nothing -- as it is shown: `[]` of
-- | `{a : Type} -> List a`, as the compiled code has it
applyErased : Int -> EvalResult -> EvalResult
applyErased n (RSucceeded (VFun f)) =
  if n <= 0 then RSucceeded (VFun f)
  else applyErased (n - 1) (resultOf (f 0 (okTh VErased)))
applyErased n r = r

withR : {a : Type} -> RVal -> (RVal -> a) -> a
withR r f = f r

evalGlobalsGo : (String -> Bool)
              -> GlobalEnv
              -> List (Pair String Globals.Entry)
              -> List (Pair String EvalResult)
              -> List (Pair String EvalResult)
evalGlobalsGo wanted ge Nil acc = List.reverse acc
evalGlobalsGo wanted ge (Cons (MkPair x entry) rest) acc =
  withR
    (fixThunk ge entry.syntax 0)
    (\r ->
       evalGlobalsGo
         wanted
         (Map.insert compareString x (\d -> r) ge)
         rest
         (if wanted x then Cons (MkPair x (resultOf r)) acc else acc))

-- | every global is evaluated once, in declaration order, its value
-- | shared by every later reference (sharing is the eager walk itself
-- | -- sound, because an `abandon` is a value, `Abn`, not the end of
-- | the run, and a module's definitions only ever see the ones before
-- | them)
evalGlobalsWhere : (String -> Bool)
                 -> Globals.Globals
                 -> List (Pair String EvalResult)
evalGlobalsWhere wanted gs =
  evalGlobalsGo wanted Map.empty (Globals.globalsList gs) Nil

globalEnvGo : GlobalEnv -> List (Pair String Globals.Entry) -> GlobalEnv
globalEnvGo ge Nil = ge
globalEnvGo ge (Cons (MkPair x entry) rest) =
  withR
    (fixThunk ge entry.syntax 0)
    (\r -> globalEnvGo (Map.insert compareString x (\d -> r) ge) rest)

-- | every global evaluated once, as `evalGlobalsWhere` evaluates them:
-- | what entries that are no globals (watches) are evaluated in, each
-- | without evaluating the globals again
globalEnv : Globals.Globals -> GlobalEnv
globalEnv gs = globalEnvGo Map.empty (Globals.globalsList gs)

-- | an entry evaluated in the globals evaluated, as it would be the last
-- | of them
evalEntryIn : GlobalEnv -> Globals.Entry -> EvalResult
evalEntryIn ge entry = resultOf (fixThunk ge entry.syntax 0)
