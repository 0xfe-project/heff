-- The untyped intermediate language between the core and the backends.
-- Every bound variable has a name of its own in a whole program, so
-- substitution never captures.

module heff.compile.ir

import heff.compile.supply
import heff.elab.fixed
import std.ordmap as OrdMap

-- | an alternative of a match: `vars` bind the tag's arguments, in order
data ArmOf e = MkArm String (List String) e

-- | a record's field, of its type, as a backend may lay it out (#39): a
-- | `Float64`; a fixed-width number; of any other type; or of a type not
-- | known where it is built or read (a variable's, `{ v : a }`), so of
-- | any of them -- one record may be built where its type is known and
-- | read where it is not, or the other way round
data FieldTy = FtFloat | FtFixed Fixed | FtOther | FtAny

-- | its name, as a key or the backend's cache has it
fieldTyName : FieldTy -> String
fieldTyName FtFloat = "Float64"
fieldTyName (FtFixed w) = fixedName w
fieldTyName FtOther = "_"
fieldTyName FtAny = "?"

-- | the one a name names
-- | >>> fieldTyOfName (fieldTyName (FtFixed U64))
-- | Just (FtFixed U64)
fieldTyOfName : String -> Maybe FieldTy
fieldTyOfName "Float64" = Just FtFloat
fieldTyOfName "_" = Just FtOther
fieldTyOfName "?" = Just FtAny
fieldTyOfName x = maybe Nothing (\w -> Just (FtFixed w)) (fixedOfName x)

-- | whether a tag is a tuple's (heff.compile.cpr): the values a worker
-- | gives back at once, never a value of the program -- its name, `#`
-- | then how each value is kept, says how they are laid out
-- | >>> isTupleTag "#Int64,_" && not (isTupleTag "Just")
-- | True
isTupleTag : String -> Bool
isTupleTag t = strLength t > 0 && byteAt t 0 == 35

-- | as many fields' types as there are of `as`, none of them known: of
-- | a tag built where its type is not at hand
anyTys : {a : Type} -> List a -> List FieldTy
anyTys args = List.map (\_ -> FtAny) args

-- | a condition: the booleans' language of their own, so that a test is
-- | never a `Bool` built to be matched on.  `CRel`, a comparison, a
-- | primitive of two operands; `CTest`, a `Bool` computed, looked at;
-- | `CIf a b c`, `b` where `a` holds, else `c` (`&&` and `||`): `b` and
-- | `c` computed only where they are chosen
data CondOf e
  = CTrue
  | CFalse
  | CRel String e e
  | CTest e
  | CNot (CondOf e)
  | CIf (CondOf e) (CondOf e) (CondOf e)

-- | each expression of a condition, by `f`
condMap : {a b : Type} -> (a -> b) -> CondOf a -> CondOf b
condMap f CTrue = CTrue
condMap f CFalse = CFalse
condMap f (CRel p x y) = CRel p (f x) (f y)
condMap f (CTest x) = CTest (f x)
condMap f (CNot c) = CNot (condMap f c)
condMap f (CIf a b c) = CIf (condMap f a) (condMap f b) (condMap f c)

-- | ... each a computation, in the order they are written
condTraverse : {m : Type -> Type}
             -> {{mo : Monad m}}
             -> {a b : Type}
             -> (a -> m b)
             -> CondOf a
             -> m (CondOf b)
condTraverse f CTrue = mo.pure CTrue
condTraverse f CFalse = mo.pure CFalse
condTraverse f (CRel p x y) =
  mo.bind (f x) (\x2 -> mo.bind (f y) (\y2 -> mo.pure (CRel p x2 y2)))
condTraverse f (CTest x) = mo.bind (f x) (\x2 -> mo.pure (CTest x2))
condTraverse f (CNot c) =
  mo.bind (condTraverse (mo := mo) f c) (\c2 -> mo.pure (CNot c2))
condTraverse f (CIf a b c) =
  mo.bind
    (condTraverse (mo := mo) f a)
    (\a2 ->
       mo.bind
         (condTraverse (mo := mo) f b)
         (\b2 ->
            mo.bind
              (condTraverse (mo := mo) f c)
              (\c2 -> mo.pure (CIf a2 b2 c2))))

-- | the expressions of a condition, in the order they are written, onto
-- | `rest`
condOnto : {a : Type} -> CondOf a -> List a -> List a
condOnto CTrue rest = rest
condOnto CFalse rest = rest
condOnto (CRel _ x y) rest = Cons x (Cons y rest)
condOnto (CTest x) rest = Cons x rest
condOnto (CNot c) rest = condOnto c rest
condOnto (CIf a b c) rest = condOnto a (condOnto b (condOnto c rest))

-- | ... alone
condParts : {a : Type} -> CondOf a -> List a
condParts c = condOnto c Nil

fillWith : {b : Type}
         -> Pair (Maybe (CondOf b)) (List b)
         -> (CondOf b -> List b -> Pair (Maybe (CondOf b)) (List b))
         -> Pair (Maybe (CondOf b)) (List b)
fillWith (MkPair (Just c) es) k = k c es
fillWith (MkPair Nothing es) k = MkPair Nothing es

-- (a condition's expressions given again, in the order `condOnto` has
-- them, and those left)
condFillGo : {a b : Type}
           -> CondOf a
           -> List b
           -> Pair (Maybe (CondOf b)) (List b)
condFillGo CTrue es = MkPair (Just CTrue) es
condFillGo CFalse es = MkPair (Just CFalse) es
condFillGo (CRel p _ _) (Cons x (Cons y es)) = MkPair (Just (CRel p x y)) es
condFillGo (CTest _) (Cons x es) = MkPair (Just (CTest x)) es
condFillGo (CNot c) es =
  fillWith (condFillGo c es) (\c2 es2 -> MkPair (Just (CNot c2)) es2)
condFillGo (CIf a b c) es =
  fillWith
    (condFillGo a es)
    (\a2 es1 ->
       fillWith
         (condFillGo b es1)
         (\b2 es2 ->
            fillWith
              (condFillGo c es2)
              (\c2 es3 -> MkPair (Just (CIf a2 b2 c2)) es3)))
condFillGo c es = MkPair Nothing es

-- | a condition of the same form, its expressions `es` (as many as
-- | `condParts` gives, in that order)
-- | >>> condFill (CIf (CTest 1) (CRel "intLt" 2 3) CFalse) ["a", "b", "c"]
-- | CIf (CTest "a") (CRel "intLt" "b" "c") CFalse
condFill : {a b : Type} -> CondOf a -> List b -> CondOf b
condFill c es = case condFillGo c es of
  MkPair (Just c2) _ -> c2
  MkPair Nothing _ -> CFalse

-- | the comparisons' primitives of a condition
condRels : {a : Type} -> CondOf a -> List String
condRels (CRel p _ _) = Cons p Nil
condRels (CNot c) = condRels c
condRels (CIf a b c) =
  List.append (condRels a) (List.append (condRels b) (condRels c))
condRels _ = Nil

data Expr
  = EVar String
  | EGlobal String
  | ELam (List String) Expr
  | EApp Expr (List Expr)
  | ELet String Expr Expr
  -- | a record: its fields, and each one's type (as many)
  | ERecord (List (Pair String Expr)) (List FieldTy)
  -- | a field, by its label, of a record whose fields where the program
  -- | runs are those labelled, in order (none: they are not known), and
  -- | the field's type
  | EProj Expr String (List String) FieldTy
  -- | a tag: its arguments, and each one's type, as a backend may lay
  -- | the tag out (as many; `FtAny` where it is not known)
  | ETag String (List Expr) (List FieldTy)
  | EMatch Expr (List (ArmOf Expr))
  -- | a primitive, as a (curried) function
  | EPrim String
  -- | a primitive, given all its arguments
  | EPrimCall String (List Expr)
  -- | a global of that arity, given all its arguments at once
  | ECall String (List Expr)
  | EInt Int
  | EFloat Float64
  | EStr String
  -- | `Bytes`, a literal's: its bytes, kept as a string of them
  | EBytes String
  -- | a fixed-width integer, in its type's range
  | EFixed Fixed Int
  -- | a `Float32`: the float, rounded to one where it is computed
  | EFloat32 Float64
  | EAbandon
  -- | a `Bool`, a condition's (`CondOf`): a match on it is an `if`, which
  -- | builds no `Bool`; one is built only where it is a value
  | EBool (CondOf Expr)
  -- | `xs` set by the way out of the first part chosen -- each way an
  -- | `EValues` of as many, or abandoned -- then the second: what follows
  -- | an `if` or a `case` of `run do`'s statements, given the variables
  -- | as they are in its arms (no tag built, no join point)
  | ESet (List String) Expr Expr
  -- | the values a way out of an `ESet`'s first part gives: only there
  | EValues (List Expr)
  -- | a local definition (`where`), the name bound in its body to itself:
  -- | only between erasure and `heff.compile.lift`, which makes it a global
  | EFix String Expr

type Arm = ArmOf Expr

type Cond = CondOf Expr

armTag : Arm -> String
armTag (MkArm t _ _) = t

armVars : Arm -> List String
armVars (MkArm _ vs _) = vs

armBody : Arm -> Expr
armBody (MkArm _ _ b) = b

-- | a definition: its key, the name it is known by, and its body
type Def = { key : String, name : String, body : Expr }

mkDef : String -> String -> Expr -> Def
mkDef key name body = { key = key, name = name, body = body }

-- | where fresh names come from (a counter)
type Supply = Int

fresh : String -> Supply -> Pair String Supply
fresh base n = freshS base n

baseGo : String -> Int -> String
baseGo x i =
  if i >= strLength x then x
  else if byteAt x i == 36 then strSlice x 0 i
  else baseGo x (i + 1)

-- | the base of a variable's name (what it was called in the source)
baseOf : String -> String
baseOf x = baseGo x 0

appendI : {a : Type} -> List a -> List a -> List a
appendI Nil ys = ys
appendI (Cons x xs) ys = Cons x (appendI xs ys)

concatMapI : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapI f Nil = Nil
concatMapI f (Cons x xs) = appendI (f x) (concatMapI f xs)

nubI : List String -> List String
nubI Nil = Nil
nubI (Cons x xs) = Cons x (nubI (List.keepIf (\y -> not (strEq y x)) xs))

-- One level
--------------------------------------------------------------------------------

-- A pass walks an expression by these: it writes an equation for each
-- node it changes or looks into, and leaves the others to `mapParts`
-- (`traverseParts`, drawing fresh names) with its own walk, or, folding,
-- to `partsOnto` -- so a node `Expr` gains is walked by every pass that
-- does not ask for it.  Each part is given with the names the node binds
-- around it: a lambda's parameters for its body, a binding's name for
-- what follows it, an arm's variables for its body, an `ESet`'s for what
-- follows it, an `EFix`'s name for its body; none for any other: a pass
-- that keeps something of a variable forgets it there.
--
-- The walks after these -- freshening, substitution, occurrences, size
-- -- are written out in full: the simplifier runs them for each copy it
-- weighs, and through these, a closure called at each node and no cell
-- of the worklist used again, the compiler compiling itself took a
-- twentieth more instructions.

pairSndI : Pair String Expr -> Expr
pairSndI (MkPair _ e2) = e2

-- (worklists: an expression's parts before the rest -- a walk that
-- needs no list of its own for each node)
pushArms : List Arm -> List Expr -> List Expr
pushArms Nil rest = rest
pushArms (Cons a args) rest = Cons (armBody a) (pushArms args rest)

pushFields : List (Pair String Expr) -> List Expr -> List Expr
pushFields Nil rest = rest
pushFields (Cons p fs) rest = Cons (pairSndI p) (pushFields fs rest)

-- | an expression's parts onto the worklist, before the rest, in the
-- | order they are written: what a fold walks below a node
-- | >>> partsOnto (ELet "x" (EInt 1) (EVar "x")) [EInt 2]
-- | [EInt 1, EVar "x", EInt 2]
partsOnto : Expr -> List Expr -> List Expr
partsOnto (ELam _ b) rest = Cons b rest
partsOnto (EApp f args) rest = Cons f (appendI args rest)
partsOnto (ELet _ a b) rest = Cons a (Cons b rest)
partsOnto (ERecord fs _) rest = pushFields fs rest
partsOnto (EProj e _ _ _) rest = Cons e rest
partsOnto (ETag _ args _) rest = appendI args rest
partsOnto (EMatch s arms) rest = Cons s (pushArms arms rest)
partsOnto (EPrimCall _ args) rest = appendI args rest
partsOnto (ECall _ args) rest = appendI args rest
partsOnto (EBool c) rest = condOnto c rest
partsOnto (ESet _ a b) rest = Cons a (Cons b rest)
partsOnto (EValues es) rest = appendI es rest
partsOnto (EFix _ b) rest = Cons b rest
partsOnto _ rest = rest

-- | what a pass does to a part of a node: given the names the node binds
-- | around it
type Part r = List String -> Expr -> r

mapArm : Part Expr -> Arm -> Arm
mapArm f (MkArm t vs b) = MkArm t vs (f vs b)

mapField : Part Expr -> Pair String Expr -> Pair String Expr
mapField f (MkPair l e) = MkPair l (f Nil e)

-- | each part of a node by `f` (a pass's own walk): one level, the node
-- | kept
-- | >>> mapParts (\xs e -> if List.null xs then EInt 0 else e) (ELet "x" (EVar "y") (EVar "x"))
-- | ELet "x" (EInt 0) (EVar "x")
mapParts : Part Expr -> Expr -> Expr
mapParts f (ELam xs b) = ELam xs (f xs b)
mapParts f (EApp g args) = EApp (f Nil g) (List.map (f Nil) args)
mapParts f (ELet x a b) = ELet x (f Nil a) (f (Cons x Nil) b)
mapParts f (ERecord fs ts) = ERecord (List.map (mapField f) fs) ts
mapParts f (EProj e l sh t) = EProj (f Nil e) l sh t
mapParts f (ETag t args ts) = ETag t (List.map (f Nil) args) ts
mapParts f (EMatch s arms) = EMatch (f Nil s) (List.map (mapArm f) arms)
mapParts f (EPrimCall p args) = EPrimCall p (List.map (f Nil) args)
mapParts f (ECall g args) = ECall g (List.map (f Nil) args)
mapParts f (EBool c) = EBool (condMap (f Nil) c)
mapParts f (ESet xs a b) = ESet xs (f Nil a) (f xs b)
mapParts f (EValues es) = EValues (List.map (f Nil) es)
mapParts f (EFix x b) = EFix x (f (Cons x Nil) b)
mapParts f e = e

traverseArm : Part (S Expr) -> Arm -> S Arm
traverseArm f (MkArm t vs b) = do
  b2 <- f vs b
  pure (MkArm t vs b2)

traverseField : Part (S Expr) -> Pair String Expr -> S (Pair String Expr)
traverseField f (MkPair l e) = do
  e2 <- f Nil e
  pure (MkPair l e2)

-- | ... drawing fresh names: the parts in the order they are written
traverseParts : Part (S Expr) -> Expr -> S Expr
traverseParts f (ELam xs b) = do
  b2 <- f xs b
  pure (ELam xs b2)
traverseParts f (EApp g args) = do
  g2 <- f Nil g
  args2 <- traverseS (f Nil) args
  pure (EApp g2 args2)
traverseParts f (ELet x a b) = do
  a2 <- f Nil a
  b2 <- f (Cons x Nil) b
  pure (ELet x a2 b2)
traverseParts f (ERecord fs ts) = do
  fs2 <- traverseS (traverseField f) fs
  pure (ERecord fs2 ts)
traverseParts f (EProj e l sh t) = do
  e2 <- f Nil e
  pure (EProj e2 l sh t)
traverseParts f (ETag t args ts) = do
  args2 <- traverseS (f Nil) args
  pure (ETag t args2 ts)
traverseParts f (EMatch s arms) = do
  s2 <- f Nil s
  arms2 <- traverseS (traverseArm f) arms
  pure (EMatch s2 arms2)
traverseParts f (EPrimCall p args) = do
  args2 <- traverseS (f Nil) args
  pure (EPrimCall p args2)
traverseParts f (ECall g args) = do
  args2 <- traverseS (f Nil) args
  pure (ECall g args2)
traverseParts f (EBool c) = do
  c2 <- condTraverse (mo := instanceMonadS) (f Nil) c
  pure (EBool c2)
traverseParts f (ESet xs a b) = do
  a2 <- f Nil a
  b2 <- f xs b
  pure (ESet xs a2 b2)
traverseParts f (EValues es) = do
  es2 <- traverseS (f Nil) es
  pure (EValues es2)
traverseParts f (EFix x b) = do
  b2 <- f (Cons x Nil) b
  pure (EFix x b2)
traverseParts f e = pure e

-- In any monad: a pass whose computations are not `S` gives its own
-- instance (`IR.traversePartsM (mo := instanceMonadM)`), and a copy is
-- made for it, calling the instance's `bind` and `pure` themselves.

traverseArmM : {m : Type -> Type}
             -> {{mo : Monad m}}
             -> Part (m Expr)
             -> Arm
             -> m Arm
traverseArmM f (MkArm t vs b) =
  mo.bind (f vs b) (\b2 -> mo.pure (MkArm t vs b2))

traverseFieldM : {m : Type -> Type}
               -> {{mo : Monad m}}
               -> Part (m Expr)
               -> Pair String Expr
               -> m (Pair String Expr)
traverseFieldM f (MkPair l e) = mo.bind (f Nil e) (\e2 -> mo.pure (MkPair l e2))

-- (each part of a list, then what is built of them)
partsThen : {m : Type -> Type}
          -> {{mo : Monad m}}
          -> Part (m Expr)
          -> List Expr
          -> (List Expr -> Expr)
          -> m Expr
partsThen f es k =
  mo.bind (traverse (mo := mo) (f Nil) es) (\es2 -> mo.pure (k es2))

-- (a part not bound around, then another, `xs` bound around it)
twoThen : {m : Type -> Type}
        -> {{mo : Monad m}}
        -> Part (m Expr)
        -> Expr
        -> List String
        -> Expr
        -> (Expr -> Expr -> Expr)
        -> m Expr
twoThen f a xs b k =
  mo.bind (f Nil a) (\a2 -> mo.bind (f xs b) (\b2 -> mo.pure (k a2 b2)))

-- | `traverseParts` in the monad `mo`
-- | >>> traversePartsM (mo := instanceMonadMaybe) (\_ e -> Just (EInt 0)) (EApp (EVar "f") [EVar "x"])
-- | Just (EApp (EInt 0) (Cons (EInt 0) Nil))
traversePartsM : {m : Type -> Type}
               -> {{mo : Monad m}}
               -> Part (m Expr)
               -> Expr
               -> m Expr
traversePartsM f (ELam xs b) = mo.bind (f xs b) (\b2 -> mo.pure (ELam xs b2))
traversePartsM f (EApp g args) =
  mo.bind
    (f Nil g)
    (\g2 -> partsThen (mo := mo) f args (\args2 -> EApp g2 args2))
traversePartsM f (ELet x a b) =
  twoThen (mo := mo) f a (Cons x Nil) b (\a2 b2 -> ELet x a2 b2)
traversePartsM f (ERecord fs ts) =
  mo.bind
    (traverse (mo := mo) (traverseFieldM (mo := mo) f) fs)
    (\fs2 -> mo.pure (ERecord fs2 ts))
traversePartsM f (EProj e l sh t) =
  mo.bind (f Nil e) (\e2 -> mo.pure (EProj e2 l sh t))
traversePartsM f (ETag t args ts) =
  partsThen (mo := mo) f args (\args2 -> ETag t args2 ts)
traversePartsM f (EMatch s arms) =
  mo.bind
    (f Nil s)
    (\s2 ->
       mo.bind
         (traverse (mo := mo) (traverseArmM (mo := mo) f) arms)
         (\arms2 -> mo.pure (EMatch s2 arms2)))
traversePartsM f (EPrimCall p args) =
  partsThen (mo := mo) f args (\args2 -> EPrimCall p args2)
traversePartsM f (ECall g args) =
  partsThen (mo := mo) f args (\args2 -> ECall g args2)
traversePartsM f (EBool c) =
  mo.bind (condTraverse (mo := mo) (f Nil) c) (\c2 -> mo.pure (EBool c2))
traversePartsM f (ESet xs a b) =
  twoThen (mo := mo) f a xs b (\a2 b2 -> ESet xs a2 b2)
traversePartsM f (EValues es) = partsThen (mo := mo) f es (\es2 -> EValues es2)
traversePartsM f (EFix x b) =
  mo.bind (f (Cons x Nil) b) (\b2 -> mo.pure (EFix x b2))
traversePartsM f e = mo.pure e

-- Folding, the names bound around each part given

foldList : {r : Type} -> Part (r -> r) -> List Expr -> r -> r
foldList f Nil acc = acc
foldList f (Cons e es) acc = foldList f es (f Nil e acc)

foldArms : {r : Type} -> Part (r -> r) -> List Arm -> r -> r
foldArms f Nil acc = acc
foldArms f (Cons (MkArm _ vs b) arms) acc = foldArms f arms (f vs b acc)

foldFields : {r : Type} -> Part (r -> r) -> List (Pair String Expr) -> r -> r
foldFields f Nil acc = acc
foldFields f (Cons (MkPair _ e) fs) acc = foldFields f fs (f Nil e acc)

-- | each part of a node into `acc`, in the order they are written, each
-- | given the names the node binds around it (as `mapParts` gives them)
-- | >>> foldParts (\xs e n -> n + List.length xs) (ELet "x" (EInt 1) (EVar "x")) 0
-- | 1
foldParts : {r : Type} -> Part (r -> r) -> Expr -> r -> r
foldParts f (ELam xs b) acc = f xs b acc
foldParts f (EApp g args) acc = foldList f args (f Nil g acc)
foldParts f (ELet x a b) acc = f (Cons x Nil) b (f Nil a acc)
foldParts f (ERecord fs _) acc = foldFields f fs acc
foldParts f (EProj e _ _ _) acc = f Nil e acc
foldParts f (ETag _ args _) acc = foldList f args acc
foldParts f (EMatch s arms) acc = foldArms f arms (f Nil s acc)
foldParts f (EPrimCall _ args) acc = foldList f args acc
foldParts f (ECall _ args) acc = foldList f args acc
foldParts f (EBool c) acc = foldList f (condParts c) acc
foldParts f (ESet xs a b) acc = f xs b (f Nil a acc)
foldParts f (EValues es) acc = foldList f es acc
foldParts f (EFix x b) acc = f (Cons x Nil) b acc
foldParts f _ acc = acc

allList : Part Bool -> List Expr -> Bool
allList f Nil = True
allList f (Cons e es) = f Nil e && allList f es

allArms : Part Bool -> List Arm -> Bool
allArms f Nil = True
allArms f (Cons (MkArm _ vs b) arms) = f vs b && allArms f arms

allFields : Part Bool -> List (Pair String Expr) -> Bool
allFields f Nil = True
allFields f (Cons (MkPair _ e) fs) = f Nil e && allFields f fs

-- | whether `f` holds of every part of a node, given the names bound
-- | around it: looked at in order, until one does not
-- | >>> allParts (\xs e -> not (List.null xs)) (ELet "x" (EInt 1) (EVar "x"))
-- | False
allParts : Part Bool -> Expr -> Bool
allParts f (ELam xs b) = f xs b
allParts f (EApp g args) = f Nil g && allList f args
allParts f (ELet x a b) = f Nil a && f (Cons x Nil) b
allParts f (ERecord fs _) = allFields f fs
allParts f (EProj e _ _ _) = f Nil e
allParts f (ETag _ args _) = allList f args
allParts f (EMatch s arms) = f Nil s && allArms f arms
allParts f (EPrimCall _ args) = allList f args
allParts f (ECall _ args) = allList f args
allParts f (EBool c) = allList f (condParts c)
allParts f (ESet xs a b) = f Nil a && f xs b
allParts f (EValues es) = allList f es
allParts f (EFix x b) = f (Cons x Nil) b
allParts f _ = True

-- Ways out
--------------------------------------------------------------------------------

-- Where the value of an expression comes from: through its bindings and
-- the arms of its matches, to what is none of these.  A match on that
-- value given to each way out chooses there (case of case), and a way
-- out that builds a tag gives its fields there, building none.

-- | the ways out of an expression: the tags it comes to (an arm
-- | abandoned none), and how many come to anything else
type Ways = Pair (List String) Int

bothWays : Ways -> Ways -> Ways
bothWays (MkPair ts n) (MkPair us m) = MkPair (List.append ts us) (n + m)

waysOut : Expr -> Ways
waysOut (ETag t _ _) = MkPair (Cons t Nil) 0
waysOut (ELet _ _ b) = waysOut b
waysOut (ESet _ _ b) = waysOut b
waysOut (EMatch _ arms) =
  List.foldl (\w a -> bothWays w (waysOut (armBody a))) (MkPair Nil 0) arms
waysOut EAbandon = MkPair Nil 0
waysOut e = MkPair Nil 1

-- | each way out of an expression by `f`, its bindings and matches kept
-- | >>> waysMap (\_ -> EInt 0) (ELet "x" (EInt 1) (EVar "x"))
-- | ELet "x" (EInt 1) (EInt 0)
waysMap : (Expr -> Expr) -> Expr -> Expr
waysMap f (ELet x a b) = ELet x a (waysMap f b)
waysMap f (ESet xs a b) = ESet xs a (waysMap f b)
waysMap f (EMatch s arms) =
  EMatch s (List.map (mapArm (\_ b -> waysMap f b)) arms)
waysMap f e = f e

-- | ... in the monad `mo`, the ways in the order they are written
-- | >>> waysM (mo := instanceMonadMaybe) (\e -> Nothing) (ELet "x" (EInt 1) (EVar "x"))
-- | Nothing
waysM : {m : Type -> Type}
      -> {{mo : Monad m}}
      -> (Expr -> m Expr)
      -> Expr
      -> m Expr
waysM f (ELet x a b) =
  mo.bind (waysM (mo := mo) f b) (\b2 -> mo.pure (ELet x a b2))
waysM f (ESet xs a b) =
  mo.bind (waysM (mo := mo) f b) (\b2 -> mo.pure (ESet xs a b2))
waysM f (EMatch s arms) =
  mo.bind
    (traverse
       (mo := mo)
       (traverseArmM (mo := mo) (\_ b -> waysM (mo := mo) f b))
       arms)
    (\arms2 -> mo.pure (EMatch s arms2))
waysM f e = f e

-- (... onto `rest`)
waysOnto : Expr -> List Expr -> List Expr
waysOnto (ELet _ _ b) rest = waysOnto b rest
waysOnto (ESet _ _ b) rest = waysOnto b rest
waysOnto (EMatch _ arms) rest =
  List.foldr (\a r -> waysOnto (armBody a) r) rest arms
waysOnto e rest = Cons e rest

-- | each way out of an expression, in the order they are written
-- | >>> waysList (EMatch (EVar "c") [MkArm "A" [] (EInt 0), MkArm "B" [] (ELet "x" (EInt 1) (EVar "x"))])
-- | Cons (EInt 0) (Cons (EVar "x") Nil)
waysList : Expr -> List Expr
waysList e = waysOnto e Nil

-- Freshening (a copy with every binder renamed afresh)
--------------------------------------------------------------------------------

type Ren = OrdMap.OrdMap String String

renOf : Ren -> String -> String
renOf m x = case OrdMap.lookup m x of
  Just y -> y
  Nothing -> x

type FreshSt = { m : Ren, n : Supply, xs : List String }

freshBindOne : FreshSt -> String -> FreshSt
freshBindOne acc x = case fresh (baseOf x) acc.n of
  MkPair x' k -> { m = OrdMap.insert acc.m x x', n = k, xs = Cons x' acc.xs }

freshBinders : Ren -> Supply -> List String -> FreshSt
freshBinders m n xs = List.foldl freshBindOne { m = m, n = n, xs = Nil } xs

type FK = { go : Ren -> Supply -> Expr -> Pair Expr Supply }

withFS : {a : Type} -> FreshSt -> (FreshSt -> a) -> a
withFS v k = k v

consPES : Expr -> Pair (List Expr) Supply -> Pair (List Expr) Supply
consPES e (MkPair es n) = MkPair (Cons e es) n

consPFS : Pair String Expr
        -> Pair (List (Pair String Expr)) Supply
        -> Pair (List (Pair String Expr)) Supply
consPFS f (MkPair fs n) = MkPair (Cons f fs) n

consPAS : Arm -> Pair (List Arm) Supply -> Pair (List Arm) Supply
consPAS a (MkPair args n) = MkPair (Cons a args) n

freshMany : FK -> Ren -> Supply -> List Expr -> Pair (List Expr) Supply
freshMany r m n Nil = MkPair Nil n
freshMany r m n (Cons e rest) = case r.go m n e of
  MkPair e' n1 -> consPES e' (freshMany r m n1 rest)

freshArms : FK -> Ren -> Supply -> List Arm -> Pair (List Arm) Supply
freshArms r m n Nil = MkPair Nil n
freshArms r m n (Cons (MkArm tag vars body) rest) =
  withFS (freshBinders m n vars) (\bs -> case r.go bs.m bs.n body of
  MkPair b' n1 ->
    consPAS (MkArm tag (List.reverse bs.xs) b') (freshArms r m n1 rest))

freshFields : FK
            -> Ren
            -> Supply
            -> List (Pair String Expr)
            -> Pair (List (Pair String Expr)) Supply
freshFields r m n Nil = MkPair Nil n
freshFields r m n (Cons (MkPair l e) rest) = case r.go m n e of
  MkPair e' n1 -> consPFS (MkPair l e') (freshFields r m n1 rest)

-- (a condition binds nothing)
withFC : {a : Type}
       -> Pair (CondOf Expr) Supply
       -> (CondOf Expr -> Supply -> a)
       -> a
withFC (MkPair c n) k = k c n

freshCond : FK -> Ren -> Supply -> CondOf Expr -> Pair (CondOf Expr) Supply
freshCond r m n CTrue = MkPair CTrue n
freshCond r m n CFalse = MkPair CFalse n
freshCond r m n (CRel p x y) = case r.go m n x of
  MkPair x' n1 -> case r.go m n1 y of
    MkPair y' n2 -> MkPair (CRel p x' y') n2
freshCond r m n (CTest x) = case r.go m n x of
  MkPair x' n1 -> MkPair (CTest x') n1
freshCond r m n (CNot c) =
  withFC (freshCond r m n c) (\c' n1 -> MkPair (CNot c') n1)
freshCond r m n (CIf a b c) =
  withFC
    (freshCond r m n a)
    (\a' n1 ->
       withFC
         (freshCond r m n1 b)
         (\b' n2 ->
            withFC (freshCond r m n2 c) (\c' n3 -> MkPair (CIf a' b' c') n3)))

freshGo : FK -> Ren -> Supply -> Expr -> Pair Expr Supply
freshGo r m n (EVar x) = MkPair (EVar (renOf m x)) n
freshGo r m n (ELam xs b) =
  withFS (freshBinders m n xs) (\bs -> case r.go bs.m bs.n b of
  MkPair b' n' -> MkPair (ELam (List.reverse bs.xs) b') n')
freshGo r m n (ELet x a b) = case r.go m n a of
  MkPair a' n1 -> case fresh (baseOf x) n1 of
    MkPair x' n2 -> case r.go (OrdMap.insert m x x') n2 b of
      MkPair b' n3 -> MkPair (ELet x' a' b') n3
freshGo r m n (EApp f args) = case r.go m n f of
  MkPair f' n1 -> case freshMany r m n1 args of
    MkPair args' n2 -> MkPair (EApp f' args') n2
freshGo r m n (ERecord fs ts) = case freshFields r m n fs of
  MkPair fs' n1 -> MkPair (ERecord fs' ts) n1
freshGo r m n (EProj e2 l sh t) = case r.go m n e2 of
  MkPair e' n1 -> MkPair (EProj e' l sh t) n1
freshGo r m n (ETag t args ts) = case freshMany r m n args of
  MkPair args' n1 -> MkPair (ETag t args' ts) n1
freshGo r m n (EMatch s arms) = case r.go m n s of
  MkPair s' n1 -> case freshArms r m n1 arms of
    MkPair arms' n2 -> MkPair (EMatch s' arms') n2
freshGo r m n (EPrimCall p args) = case freshMany r m n args of
  MkPair args' n1 -> MkPair (EPrimCall p args') n1
freshGo r m n (ECall g args) = case freshMany r m n args of
  MkPair args' n1 -> MkPair (ECall g args') n1
freshGo r m n (EBool c) = case freshCond r m n c of
  MkPair c' n1 -> MkPair (EBool c') n1
freshGo r m n (ESet xs a b) = case r.go m n a of
  MkPair a' n1 ->
    withFS (freshBinders m n1 xs) (\bs -> case r.go bs.m bs.n b of
    MkPair b' n2 -> MkPair (ESet (List.reverse bs.xs) a' b') n2)
freshGo r m n (EValues es) = case freshMany r m n es of
  MkPair es' n1 -> MkPair (EValues es') n1
freshGo r m n e = MkPair e n

fk : FK
fk = { go = \m n e -> freshGo fk m n e }

freshen : Supply -> Expr -> Pair Expr Supply
freshen n e = fk.go OrdMap.empty n e

-- Substitution (names are unique, so nothing is captured)
--------------------------------------------------------------------------------

substGo : OrdMap.OrdMap String Expr -> Expr -> Expr
substGo m (EVar x) = case OrdMap.lookup m x of
  Just e2 -> e2
  Nothing -> EVar x
substGo m (ELam xs b) = ELam xs (substGo m b)
substGo m (EApp f args) = EApp (substGo m f) (List.map (\a -> substGo m a) args)
substGo m (ELet x a b) = ELet x (substGo m a) (substGo m b)
substGo m (ERecord fs ts) =
  ERecord
    (List.map
       (\p -> case p of
        MkPair l e2 -> MkPair l (substGo m e2))
       fs)
    ts
substGo m (EProj e2 l sh t) = EProj (substGo m e2) l sh t
substGo m (ETag t args ts) = ETag t (List.map (\a -> substGo m a) args) ts
substGo m (EMatch s arms) =
  EMatch
    (substGo m s)
    (List.map
       (\a -> case a of
        MkArm t vs b -> MkArm t vs (substGo m b))
       arms)
substGo m (EPrimCall p args) = EPrimCall p (List.map (\a -> substGo m a) args)
substGo m (ECall g args) = ECall g (List.map (\a -> substGo m a) args)
substGo m (EBool c) = EBool (condMap (\a -> substGo m a) c)
substGo m (ESet xs a b) = ESet xs (substGo m a) (substGo m b)
substGo m (EValues es) = EValues (List.map (\a -> substGo m a) es)
substGo m e = e

subst : OrdMap.OrdMap String Expr -> Expr -> Expr
subst m e = if OrdMap.size m == 0 then e else substGo m e

-- Occurrences, size, globals, values
--------------------------------------------------------------------------------

type Occ = { count : Int, underLam : Bool }

-- (how often `x` occurs in the worklist, `n` counted so far)
countW : String -> Int -> List Expr -> Int
countW x n Nil = n
countW x n (Cons (EVar y) rest) = countW x (if strEq y x then n + 1 else n) rest
countW x n (Cons (ELam _ b) rest) = countW x n (Cons b rest)
countW x n (Cons (EApp f args) rest) = countW x n (Cons f (appendI args rest))
countW x n (Cons (ELet _ a b) rest) = countW x n (Cons a (Cons b rest))
countW x n (Cons (ERecord fs _) rest) = countW x n (pushFields fs rest)
countW x n (Cons (EProj e _ _ _) rest) = countW x n (Cons e rest)
countW x n (Cons (ETag _ args _) rest) = countW x n (appendI args rest)
countW x n (Cons (EMatch s arms) rest) =
  countW x n (Cons s (pushArms arms rest))
countW x n (Cons (EPrimCall _ args) rest) = countW x n (appendI args rest)
countW x n (Cons (ECall _ args) rest) = countW x n (appendI args rest)
countW x n (Cons (EBool c) rest) = countW x n (condOnto c rest)
countW x n (Cons (ESet _ a b) rest) = countW x n (Cons a (Cons b rest))
countW x n (Cons (EValues es) rest) = countW x n (appendI es rest)
countW x n (Cons _ rest) = countW x n rest

-- (whether `x` occurs under a lambda in the worklist: a lambda's body
-- counted, not walked again)
lamW : String -> List Expr -> Bool
lamW x Nil = False
lamW x (Cons (ELam _ b) rest) = countW x 0 (Cons b Nil) > 0 || lamW x rest
lamW x (Cons (EApp f args) rest) = lamW x (Cons f (appendI args rest))
lamW x (Cons (ELet _ a b) rest) = lamW x (Cons a (Cons b rest))
lamW x (Cons (ERecord fs _) rest) = lamW x (pushFields fs rest)
lamW x (Cons (EProj e _ _ _) rest) = lamW x (Cons e rest)
lamW x (Cons (ETag _ args _) rest) = lamW x (appendI args rest)
lamW x (Cons (EMatch s arms) rest) = lamW x (Cons s (pushArms arms rest))
lamW x (Cons (EPrimCall _ args) rest) = lamW x (appendI args rest)
lamW x (Cons (ECall _ args) rest) = lamW x (appendI args rest)
lamW x (Cons (EBool c) rest) = lamW x (condOnto c rest)
lamW x (Cons (ESet _ a b) rest) = lamW x (Cons a (Cons b rest))
lamW x (Cons (EValues es) rest) = lamW x (appendI es rest)
lamW x (Cons _ rest) = lamW x rest

-- | how often a variable occurs, and whether any occurrence is under a
-- | lambda (where it may be evaluated any number of times)
-- | >>> (occurrences "x" (ELam ["y"] (EVar "x"))).underLam
-- | True
occurrences : String -> Expr -> Occ
occurrences x e =
  { count = countW x 0 (Cons e Nil), underLam = lamW x (Cons e Nil) }

-- (the nodes in the worklist, `n` counted so far)
sizeW : Int -> List Expr -> Int
sizeW n Nil = n
sizeW n (Cons (ELam _ b) rest) = sizeW (n + 1) (Cons b rest)
sizeW n (Cons (EApp f args) rest) = sizeW (n + 1) (Cons f (appendI args rest))
sizeW n (Cons (ELet _ a b) rest) = sizeW (n + 1) (Cons a (Cons b rest))
sizeW n (Cons (ERecord fs _) rest) = sizeW (n + 1) (pushFields fs rest)
sizeW n (Cons (EProj e _ _ _) rest) = sizeW (n + 1) (Cons e rest)
sizeW n (Cons (ETag _ args _) rest) = sizeW (n + 1) (appendI args rest)
sizeW n (Cons (EMatch s arms) rest) =
  sizeW (n + 1) (Cons s (pushArms arms rest))
sizeW n (Cons (EPrimCall _ args) rest) = sizeW (n + 1) (appendI args rest)
sizeW n (Cons (ECall _ args) rest) = sizeW (n + 1) (appendI args rest)
sizeW n (Cons (EBool c) rest) = sizeW (n + 1) (condOnto c rest)
sizeW n (Cons (ESet _ a b) rest) = sizeW (n + 1) (Cons a (Cons b rest))
sizeW n (Cons (EValues es) rest) = sizeW (n + 1) (appendI es rest)
sizeW n (Cons _ rest) = sizeW (n + 1) rest

-- | >>> size (ELam ["x"] (EApp (EVar "x") [EInt 1]))
-- | 4
size : Expr -> Int
size e = sizeW 0 (Cons e Nil)

-- (as sizeW, stopping once past `lim`)
sizeB : Int -> Int -> List Expr -> Int
sizeB lim n Nil = n
sizeB lim n (Cons e rest) =
  if n > lim then n
  else case e of
    ELam _ b -> sizeB lim (n + 1) (Cons b rest)
    EApp f args -> sizeB lim (n + 1) (Cons f (appendI args rest))
    ELet _ a b -> sizeB lim (n + 1) (Cons a (Cons b rest))
    ERecord fs _ -> sizeB lim (n + 1) (pushFields fs rest)
    EProj e2 _ _ _ -> sizeB lim (n + 1) (Cons e2 rest)
    ETag _ args _ -> sizeB lim (n + 1) (appendI args rest)
    EMatch sc arms -> sizeB lim (n + 1) (Cons sc (pushArms arms rest))
    EPrimCall _ args -> sizeB lim (n + 1) (appendI args rest)
    ECall _ args -> sizeB lim (n + 1) (appendI args rest)
    EBool c -> sizeB lim (n + 1) (condOnto c rest)
    ESet _ a b -> sizeB lim (n + 1) (Cons a (Cons b rest))
    EValues es -> sizeB lim (n + 1) (appendI es rest)
    _ -> sizeB lim (n + 1) rest

-- | whether the expression is bigger than `lim`: walked no further than
-- | that
sizeAbove : Int -> Expr -> Bool
sizeAbove lim e = sizeB lim 0 (Cons e Nil) > lim

globalsGo : Expr -> List String
-- globalsGo e = case e of
globalsGo (EGlobal g) = Cons g Nil
globalsGo (ELam _ b) = globalsGo b
globalsGo (EApp f args) =
  appendI (globalsGo f) (concatMapI (\a -> globalsGo a) args)
globalsGo (ELet _ a b) = appendI (globalsGo a) (globalsGo b)
globalsGo (ERecord fs _) =
  concatMapI
    (\p -> case p of
     MkPair _ e2 -> globalsGo e2)
    fs
globalsGo (EProj e2 _ _ _) = globalsGo e2
globalsGo (ETag _ args _) = concatMapI (\a -> globalsGo a) args
globalsGo (EMatch s arms) =
  appendI (globalsGo s) (concatMapI (\a -> globalsGo (armBody a)) arms)
globalsGo (EPrimCall _ args) = concatMapI (\a -> globalsGo a) args
globalsGo (ECall g args) = Cons g (concatMapI (\a -> globalsGo a) args)
globalsGo (EBool c) = concatMapI (\a -> globalsGo a) (condParts c)
globalsGo (ESet _ a b) = appendI (globalsGo a) (globalsGo b)
globalsGo (EValues es) = concatMapI (\a -> globalsGo a) es
globalsGo _ = Nil

globalsIn : Expr -> List String
globalsIn e = nubI (globalsGo e)

allI : List Bool -> Bool
allI Nil = True
allI (Cons b bs) = b && allI bs

-- | evaluating it does nothing but build a value: it can be dropped,
-- | moved, or duplicated (when it is small)
isValue : Expr -> Bool
isValue (EVar _) = True
isValue (EGlobal _) = True
isValue (ELam _ _) = True
isValue (ERecord fs _) =
  allI
    (List.map
       (\p -> case p of
        MkPair _ e2 -> isValue e2)
       fs)
isValue (ETag _ args _) = allI (List.map (\a -> isValue a) args)
isValue (EPrim _) = True
isValue (EInt _) = True
isValue (EFloat _) = True
isValue (EStr _) = True
isValue (EBytes _) = True
isValue (EFixed _ _) = True
isValue (EFloat32 _) = True
isValue (EBool c) = allI (List.map (\a -> isValue a) (condParts c))
isValue _ = False

-- | a `Lazy`'s box, `MkLazy` of its thunk: the box keeps the value the
-- | thunk comes to, once forced, so a copy of it would compute that
-- | again -- it is bound where it is made, neither copied nor moved
-- | there, and not taken apart where it is only named
-- | >>> List.map keepsValue [ETag "MkLazy" [ELam ["u"] (EInt 1)] [FtAny], ETag "Just" [EInt 1] [FtAny]]
-- | [True, False]
keepsValue : Expr -> Bool
keepsValue (ETag t _ _) = strEq t "MkLazy"
keepsValue _ = False

-- | an application's head and all its arguments, the nested ones
-- | flattened
spineApp : List Expr -> Pair Expr (List Expr) -> Pair Expr (List Expr)
spineApp args (MkPair h bs) = MkPair h (appendI bs args)

spine : Expr -> Pair Expr (List Expr)
spine (EApp f args) = spineApp args (spine f)
spine e = MkPair e Nil

-- Conditions
--------------------------------------------------------------------------------

-- | the comparisons a condition is made of (each backend has them as an
-- | operator, or a test of its own): of integers, floats, strings,
-- | runes, a fixed-width type's, and words (heff.compile.ranges)
relPrims : List String
relPrims =
  [ "intEq"
  , "intLt"
  , "intLe"
  , "floatEq"
  , "floatLt"
  , "floatLe"
  , "strEq"
  , "strLt"
  , "runeEq"
  , "runeLt"
  , "runeLe"
  , "wordEq"
  , "wordLt"
  , "wordLe"
  ]

-- (a fixed-width type's comparison)
fixedRel : FixedPrim -> Bool
fixedRel { op = OpEq } = True
fixedRel { op = OpLt } = True
fixedRel { op = OpLe } = True
fixedRel p = False

-- | whether a primitive of two operands is a comparison
-- | >>> List.map isRel ["intLt", "intAdd", "wordLe"]
-- | [True, False, True]
isRel : String -> Bool
isRel p =
  List.any (\q -> strEq p q) relPrims || maybe False fixedRel (fixedPrimOf p)

-- (an arm of no fields, of the tag)
armNamed : String -> List Arm -> Maybe Expr
armNamed t Nil = Nothing
armNamed t (Cons (MkArm t2 vs b) rest) =
  if strEq t2 t && List.null vs then Just b else armNamed t rest

-- | a match's arms, if it is an `if`: one for `True`, one for `False`
boolArms : List Arm -> Maybe (Pair Expr Expr)
boolArms (Cons a (Cons b Nil)) = case armNamed "True" [a, b] of
  Just t -> case armNamed "False" [a, b] of
    Just f -> Just (MkPair t f)
    Nothing -> Nothing
  Nothing -> Nothing
boolArms arms = Nothing

-- | the arms of an `if`
ifArms : Expr -> Expr -> List Arm
ifArms t f = [MkArm "True" Nil t, MkArm "False" Nil f]

-- | whether a condition is a constant
isConstant : CondOf Expr -> Bool
isConstant CTrue = True
isConstant CFalse = True
isConstant c = False

-- | `not c`: a constant turned, a `CNot` taken off
notOf : CondOf Expr -> CondOf Expr
notOf CTrue = CFalse
notOf CFalse = CTrue
notOf (CNot c) = c
notOf c = CNot c

-- | `if c then t else e` of conditions: a constant's arm; the arms
-- | turned for a `not`; a test of a test whose arms are constants taken
-- | apart (case of case, where that copies only constants); the test
-- | itself, where the arms are `True` and `False`
condIf : CondOf Expr -> CondOf Expr -> CondOf Expr -> CondOf Expr
condIf CTrue t e = t
condIf CFalse t e = e
condIf (CNot c) t e = condIf c e t
condIf (CIf a b c) t e =
  if isConstant t && isConstant e then condIf a (condIf b t e) (condIf c t e)
  else CIf (CIf a b c) t e
condIf c CTrue CFalse = c
condIf c CFalse CTrue = notOf c
condIf c t e = CIf c t e

-- | whether an arm of an `if` may be made part of a condition, computing
-- | nothing it would not: a constant, a name, a comparison, a condition,
-- | an `if` of them
condShaped : Expr -> Bool
condShaped (ETag t Nil _) = strEq t "True" || strEq t "False"
condShaped (EVar _) = True
condShaped (EBool _) = True
condShaped (EPrimCall p (Cons _ (Cons _ Nil))) = isRel p
condShaped (EMatch s arms) = case boolArms arms of
  Just (MkPair t f) -> condShaped t && condShaped f
  Nothing -> False
condShaped e = False

-- | whether it is a `Bool`, by what it is (a name may be of any type)
surelyBool : Expr -> Bool
surelyBool (ETag t Nil _) = strEq t "True" || strEq t "False"
surelyBool (EBool _) = True
surelyBool (EPrimCall p (Cons _ (Cons _ Nil))) = isRel p
surelyBool (EMatch s arms) = case boolArms arms of
  Just (MkPair t f) -> surelyBool t || surelyBool f
  Nothing -> False
surelyBool e = False

-- | whether the arms of an `if` are `Bool`s it may be a condition of
boolShaped : Expr -> Expr -> Bool
boolShaped t f = condShaped t && condShaped f && (surelyBool t || surelyBool f)

-- | a `Bool` as a condition: a constant, a comparison, an `if` of
-- | conditions; else the `Bool` looked at
-- | >>> condOf (EPrimCall "intLt" [EVar "i", EVar "n"])
-- | CRel "intLt" (EVar "i") (EVar "n")
condOf : Expr -> CondOf Expr
condOf (ETag t Nil ts) =
  if strEq t "True" then CTrue
  else if strEq t "False" then CFalse
  else CTest (ETag t Nil ts)
condOf (EBool c) = c
condOf (EPrimCall p (Cons a (Cons b Nil))) =
  if isRel p then CRel p a b else CTest (EPrimCall p [a, b])
condOf (EMatch s arms) = case boolArms arms of
  Just (MkPair t f) ->
    if boolShaped t f
    then condIf (condOf s) (condOf t) (condOf f)
    else CTest (EMatch s arms)
  Nothing -> CTest (EMatch s arms)
condOf e = CTest e

-- | a condition as a `Bool`: a constant's tag, the `Bool` looked at,
-- | else the condition's
boolOf : CondOf Expr -> Expr
boolOf CTrue = ETag "True" Nil Nil
boolOf CFalse = ETag "False" Nil Nil
boolOf (CTest e) = e
boolOf c = EBool c

-- | `case s of True -> t; False -> f`, as conditions have it: a `Bool`
-- | of a condition, where its arms are of them; else a match on the
-- | condition
-- | >>> ifOf (EVar "c") (EVar "d") (ETag "False" [] [])
-- | EBool (CIf (CTest (EVar "c")) (CTest (EVar "d")) CFalse)
ifOf : Expr -> Expr -> Expr -> Expr
ifOf s t f =
  if boolShaped t f
  then boolOf (condIf (condOf s) (condOf t) (condOf f))
  else EMatch (boolOf (condOf s)) (ifArms t f)

-- | a condition as the matches on `Bool`s and the comparisons it is made
-- | of, as they were before it was one
condExpr : CondOf Expr -> Expr
condExpr CTrue = ETag "True" Nil Nil
condExpr CFalse = ETag "False" Nil Nil
condExpr (CRel p a b) = EPrimCall p [a, b]
condExpr (CTest e) = e
condExpr (CNot c) =
  EMatch (condExpr c) (ifArms (ETag "False" Nil Nil) (ETag "True" Nil Nil))
condExpr (CIf a b c) = EMatch (condExpr a) (ifArms (condExpr b) (condExpr c))
