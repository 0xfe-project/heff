-- Representations, for the C backend (#39): which of a definition's
-- variables are kept unboxed -- a fixed-width number as its C integer
-- type (`int64_t`, `uint8_t`, ...), a `Float32` as a `float`, a
-- `Float64` as a `double` -- and which as a `V`, the runtime's uniform
-- word, worked out on the imperative form (heff.compile.imperative) of each
-- definition apart, and read by heff.compile.refcount, which boxes and unboxes
-- where a value crosses from one to the other.
--
-- The form has no types, but the program was checked, so what a
-- variable is is told by what gives it its value and what uses it:
--
-- - a primitive of a fixed-width type or of `Float64` takes and gives
--   its numbers unboxed (`primShape`), and a literal is one;
-- - a variable copied to another (`let y = x`, `x = y`, the loop's
--   next round giving a parameter its value) is kept as that one is:
--   they are one class, and so is a loop's parameter with what it is
--   given;
-- - a known call of a function with a worker (heff.compile.worker)
--   gives what it gives, and wants its operands, as the worker does;
--   the worker's own parameters are kept as it takes them (`Kept`), and
--   what it returns wanted as it gives it;
-- - anything else -- a call, a field, a parameter where the function is
--   entered -- gives a `V`, and anything else -- a call's operand, a
--   tag's, a record's, a closure's, what is returned -- wants one.
--
-- A class all of whose evidence is of one type is unboxed where that
-- costs no more than keeping it a `V` (`decide`): a box made where a
-- `V` is wanted (an allocation, for a `Float64` or a 64-bit integer
-- beyond 62 bits), against an unbox where a `V` comes in.  What is done
-- where the loop's next round may be reached is done on each round, and
-- weighs `loopWeight` times what is done once, on the way in or out: a
-- loop's accumulator handed to a closure when it is done is unboxed in
-- the loop and boxed once, as it leaves.  A field a match binds stays a
-- `V` (`Pinned`), and is unboxed where it is used.
--
-- An `Int` known to fit a word (heff.compile.ranges, #79) is kept as its
-- `int64_t` (`RepInt`): its evidence is an operation on words, a
-- literal, a parameter every call gives a word (`BoxedWord`); a class
-- given any other `V` (`Boxed`, which may be a big integer) is never one.
--
-- A record's field is told by its type (heff.compile.erase's
-- `IR.FieldTy`): one whose `V` would be allocated -- a `Float64`, an
-- `Int64`, a `UInt64` -- is kept flat in the record, its bits, where the
-- record is built knowing the type (`slotRepr`), and read as its number
-- where it is read knowing it.  What is built where the type is not known
-- (`{ v : a }`) is a `V`, so a read checks, as the record says:
-- a record is one `V`, whoever built it.

module heff.compile.repr

import heff.compile.imperative as Imperative
import heff.compile.ir as IR
import heff.compile.ranges as Ranges
import heff.elab.fixed as Fixed
import std.ordmap as OrdMap

-- | how a variable is kept: as a `V`; as a fixed-width type's C type;
-- | as a `double`; an `Int` known to fit a word, as an `int64_t`
data Repr = RepV | RepFix Fixed.Fixed | RepF64 | RepInt

reprEq : Repr -> Repr -> Bool
reprEq RepV RepV = True
reprEq RepF64 RepF64 = True
reprEq RepInt RepInt = True
reprEq (RepFix a) (RepFix b) = Fixed.eqFixed a b
reprEq a b = False

isBoxed : Repr -> Bool
isBoxed RepV = True
isBoxed r = False

-- | each definition's unboxed variables, by name (the others are `V`s)
type Reprs = OrdMap.OrdMap String Repr

-- | how a variable is kept
reprOf : Reprs -> String -> Repr
reprOf rs x = fromMaybe RepV (OrdMap.lookup rs x)

-- | whether a variable is kept unboxed
unboxedIn : Reprs -> String -> Bool
unboxedIn rs x = OrdMap.member rs x

-- Workers (#39)
--------------------------------------------------------------------------------

-- | how a function's worker takes its parameters and gives its result
-- | (heff.compile.worker): a function with one of them unboxed has a
-- | worker, which a known call calls with them so
type Sig = { params : List Repr, result : Repr }

-- | the functions with a worker, by key
type Sigs = OrdMap.OrdMap String Sig

reprName : Repr -> String
reprName RepV = "_"
reprName RepF64 = "Float64"
reprName RepInt = "Int"
reprName (RepFix w) = Fixed.fixedName w

-- | a signature, as a key or the backend's cache has it
-- | >>> sigName { params = [RepFix U64, RepV], result = RepF64 }
-- | "UInt64,_->Float64"
sigName : Sig -> String
sigName s = joinWith "," (List.map reprName s.params) ^ "->" ^ reprName s.result

reprsEq : List Repr -> List Repr -> Bool
reprsEq Nil Nil = True
reprsEq (Cons a argv) (Cons b bs) = reprEq a b && reprsEq argv bs
reprsEq argv bs = False

sigEq : Sig -> Sig -> Bool
sigEq a b = reprsEq a.params b.params && reprEq a.result b.result

-- | whether a signature has a worker: anything unboxed
hasWorker : Sig -> Bool
hasWorker s =
  not (isBoxed s.result) || List.any (\r -> not (isBoxed r)) s.params

-- | a function's worker's signature, if it has one
sigIn : Sigs -> String -> Maybe Sig
sigIn ss g = OrdMap.lookup ss g

paramsOr : {a : Type} -> List a -> Maybe Sig -> List Repr
paramsOr argv (Just s) = s.params
paramsOr argv Nothing = List.map (\_ -> RepV) argv

-- | how a known call of `g` gives each operand (`as`)
paramReprsIn : {a : Type} -> Sigs -> String -> List a -> List Repr
paramReprsIn ss g argv = paramsOr argv (sigIn ss g)

resultOr : Maybe Sig -> Repr
resultOr (Just s) = s.result
resultOr Nothing = RepV

-- | what a known call of `g` gives
resultIn : Sigs -> String -> Repr
resultIn ss g = resultOr (sigIn ss g)

-- Primitives
--------------------------------------------------------------------------------

-- | what a primitive done unboxed takes, operand by operand, and gives
type Shape = { args : List Repr, result : Repr }

binaryOf : Repr -> Maybe Shape
binaryOf r = Just { args = [r, r], result = r }

unaryOf : Repr -> Maybe Shape
unaryOf r = Just { args = [r], result = r }

-- (a comparison: a `Bool`)
relationOf : Repr -> Maybe Shape
relationOf r = Just { args = [r, r], result = RepV }

fromTo : Repr -> Repr -> Maybe Shape
fromTo a b = Just { args = [a], result = b }

-- (a fixed-width type's primitive: all but `show`, whose string is made
-- of the `V`)
opShape : Repr -> Fixed.FixedOp -> Maybe Shape
opShape r OpAdd = binaryOf r
opShape r OpSub = binaryOf r
opShape r OpMul = binaryOf r
opShape r OpDiv = binaryOf r
opShape r OpRem = binaryOf r
opShape r OpAnd = binaryOf r
opShape r OpOr = binaryOf r
opShape r OpXor = binaryOf r
opShape r OpShl = binaryOf r
opShape r OpShr = binaryOf r
opShape r OpEq = relationOf r
opShape r OpLt = relationOf r
opShape r OpLe = relationOf r
opShape r OpSqrt = unaryOf r
opShape r OpFromInt = fromTo RepV r
opShape r OpToInt = fromTo r RepV
opShape r OpFromFloat = fromTo RepF64 r
opShape r OpToFloat = fromTo r RepF64
opShape r OpFloor = fromTo r RepV
opShape r OpShow = Nothing

elemS : String -> List String -> Bool
elemS x Nil = False
elemS x (Cons y ys) = strEq x y || elemS x ys

-- | `Float64`'s primitives done on `double`s: of two, of one
float2Prims : List String
float2Prims =
  ["floatAdd", "floatSub", "floatMul", "floatDiv", "floatAtan2", "floatPow"]

float1Prims : List String
float1Prims =
  [ "floatSqrt"
  , "floatSin"
  , "floatCos"
  , "floatTan"
  , "floatAsin"
  , "floatAcos"
  , "floatAtan"
  , "floatExp"
  , "floatLog"
  ]

floatRelPrims : List String
floatRelPrims = ["floatEq", "floatLt", "floatLe"]

floatShape : String -> Maybe Shape
floatShape p =
  if elemS p float2Prims then binaryOf RepF64
  else if elemS p float1Prims then unaryOf RepF64
  else if elemS p floatRelPrims then relationOf RepF64
  else if strEq p "floatFromInt" then fromTo RepV RepF64
  else if strEq p "floatFloor" then fromTo RepF64 RepV
  else Nothing

shapeOf : String -> Maybe Fixed.FixedPrim -> Maybe Shape
shapeOf p (Just fp) = opShape (RepFix fp.fixed) fp.op
shapeOf p Nothing = floatShape p

-- (an operation on words, heff.compile.ranges's: of two, a comparison,
-- a `Float64` made)
wordShape : String -> Maybe Shape
wordShape p =
  if Ranges.isWordRel p then relationOf RepInt
  else if strEq p "wordToFloat" then fromTo RepInt RepF64
  else binaryOf RepInt

-- | how a primitive is done unboxed, if it is
-- | >>> maybe False (\(s : Shape) -> isBoxed s.result) (primShape "int64Lt")
-- | True
-- | >>> maybe 0 (\(s : Shape) -> List.length s.args) (primShape "int64Show")
-- | 0
-- | >>> maybe "" (\(s : Shape) -> reprName s.result) (primShape "wordAdd")
-- | "Int"
primShape : String -> Maybe Shape
primShape p =
  if Ranges.isWordPrim p then wordShape p
  else shapeOf p (Fixed.fixedPrimOf p)

argsOf : {a : Type} -> Maybe Shape -> List a -> List Repr
argsOf (Just s) argv = s.args
argsOf Nothing argv = List.map (\_ -> RepV) argv

resultOf : Maybe Shape -> Repr
resultOf (Just s) = s.result
resultOf Nothing = RepV

-- | what each operand of a primitive is wanted as
argReprs : {a : Type} -> String -> List a -> List Repr
argReprs p argv = argsOf (primShape p) argv

-- | what a primitive gives
resultRepr : String -> Repr
resultRepr p = resultOf (primShape p)

-- Arrays' elements (#61)
--------------------------------------------------------------------------------

-- An array's element is read and given as it comes, a number or a `V`:
-- `arrayIndex` gives none of its own repr, so its variable is kept as
-- its uses want it (as a field that may be flat is, above), and is read
-- so (`heff_arrayIndex_u8`); `arraySet` and
-- `arrayReplicate` take their element as its variable is kept, unboxed
-- where it is, and the array is built flat, or set, so.

-- | the operand of an array's primitive that is an element, taken as it
-- | comes
-- | >>> elementAt "arraySet"
-- | Just 2
elementAt : String -> Maybe Int
elementAt "arraySet" = Just 2
elementAt "arrayReplicate" = Just 1
elementAt p = Nothing

-- | whether a primitive gives an element of an array, as it comes
readsElement : String -> Bool
readsElement p = strEq p "arrayIndex"

-- An index is taken as it comes too: a `V` it is given, but an `Int`
-- kept as a word is boxed for it at no cost, the runtime taking the box
-- apart where it is inlined -- so a loop's index used to read and set
-- stays a word, as its comparison and its step want it.

-- | the operand of an array's primitive that is an index
-- | >>> indexAt "arraySet"
-- | Just 1
indexAt : String -> Maybe Int
indexAt "arrayIndex" = Just 1
indexAt "arraySet" = Just 1
indexAt p = Nothing

-- (the place, if there is one)
placeIn : Maybe Int -> List Int
placeIn (Just i) = Cons i Nil
placeIn Nothing = Nil

-- | the operands of a primitive taken as they come: its element, its
-- | index
asTheyCome : String -> List Int
asTheyCome p = List.append (placeIn (elementAt p)) (placeIn (indexAt p))

-- Records' fields
--------------------------------------------------------------------------------

-- | how many of a record's first fields may be flat (the runtime's
-- | `HEFF_FLAT_FIELDS`)
flatFields : Int
flatFields = 16

-- | how a field of the type is kept, flat (a number's bits) or a `V`:
-- | flat where a `V` of it would be allocated for
-- | >>> reprEq RepF64 (flatOf FtFloat) && isBoxed (flatOf (FtFixed I32))
-- | True
flatOf : IR.FieldTy -> Repr
flatOf FtFloat = RepF64
flatOf (FtFixed w) = if Fixed.fixedBits w == 64 then RepFix w else RepV
flatOf t = RepV

-- | how field `i` of the type is kept where it is known (the others: as
-- | a `V`)
slotRepr : Int -> IR.FieldTy -> Repr
slotRepr i t = if i < flatFields then flatOf t else RepV

-- | how a record's fields are kept, built knowing their types
slotReprs : List IR.FieldTy -> List Repr
slotReprs ts = List.zipWith slotRepr (List.range 0 (List.length ts - 1)) ts

-- | whether a field of the type may be flat, built where the type was
-- | known: one of a type not known here too
mayBeFlat : IR.FieldTy -> Bool
mayBeFlat FtAny = True
mayBeFlat t = not (isBoxed (flatOf t))

-- | a record's shape, its labels in order, as a key
-- | >>> shapeKey ["x", "y"]
-- | "x,y"
shapeKey : List String -> String
shapeKey ls = joinWith "," ls

-- | how a field is read, where its record's shape is known: as it may be
-- | kept (`Nothing`: not known, a `V`)
readRepr : Maybe Int -> IR.FieldTy -> Repr
readRepr (Just i) t = slotRepr i t
readRepr Nothing t = RepV

-- | a flat field's kind, as a record says it (the runtime's
-- | `HEFF_FLAT_F64` and the others; 0, a `V`)
flatCode : Repr -> Int
flatCode RepF64 = 1
flatCode (RepFix I64) = 2
flatCode (RepFix U64) = 3
flatCode r = 0

-- (4 to the `i`th)
fourTo : Int -> Int
fourTo i = if i <= 0 then 1 else 4 * fourTo (i - 1)

-- | the bits a record's header has of its flat fields, each at its place
-- | >>> flatBits [MkPair 0 RepF64, MkPair 2 (RepFix U64), MkPair 3 RepV]
-- | 49
flatBits : List (Pair Int Repr) -> Int
flatBits ps = List.foldl (\n p -> n + flatCode (snd p) * fourTo (fst p)) 0 ps

-- | the bits of the fields at those places that may be flat, all set: kept
keptBits : List Int -> Int
keptBits is =
  List.foldl (\n i -> if i < flatFields then n + 3 * fourTo i else n) 0 is

-- Tuples (#80)
--------------------------------------------------------------------------------

-- A worker giving back a tag or a record taken apart (heff.compile.cpr)
-- gives back a tuple: a tag named `#` and how each of its values is kept
-- (`tupleTag`), which a backend need not build -- C gives it back as a
-- struct of words, each a `V` or a flat number's bits.

-- (the repr a name names)
reprOfName : String -> Repr
reprOfName "_" = RepV
reprOfName "Float64" = RepF64
reprOfName x = maybe RepV (\w -> RepFix w) (Fixed.fixedOfName x)

-- | a tuple's tag, of how its values are kept
-- | >>> tupleTag [RepFix I64, RepV, RepF64]
-- | "#Int64,_,Float64"
tupleTag : List Repr -> String
tupleTag rs = "#" ^ joinWith "," (List.map reprName rs)

-- | how a tuple's values are kept, as its tag says
-- | >>> List.map reprName (tupleReprs "#Int64,_,Float64")
-- | ["Int64", "_", "Float64"]
tupleReprs : String -> List Repr
tupleReprs t = List.map reprOfName (split "," (strSlice t 1 (strLength t)))

-- Tags' fields (#64)
--------------------------------------------------------------------------------

-- A tag's field is kept as a record's is: flat where the tag is built
-- knowing its type (heff.compile.erase's `IR.FieldTy`), and the tag says
-- which.  Where a match reads one, the
-- type is not at hand, but it is known of the program which fields of a
-- tag any of its tags is built with flat (heff.compile.facts's `flat`):
-- such a field's variable is not pinned a `V` but kept as its class is,
-- and read so, as a number or a `V`, whichever the tag holds.

-- (field `i`'s type, of those given: past them, not known)
tyIn : Int -> List IR.FieldTy -> IR.FieldTy
tyIn i Nil = FtAny
tyIn i (Cons t ts) = if i <= 0 then t else tyIn (i - 1) ts

-- | how a tag's `n` fields are kept, built knowing their types
-- | >>> List.map reprName (tagSlots [FtFloat, FtOther] 3)
-- | ["Float64", "_", "_"]
tagSlots : List IR.FieldTy -> Int -> List Repr
tagSlots ts n = List.map (\i -> slotRepr i (tyIn i ts)) (List.range 0 (n - 1))

-- | of each tag, the fields any of its tags may be built with flat
type FlatTags = OrdMap.OrdMap String (List Int)

-- | what a definition's walk knows of the program: the workers, and the
-- | tags' fields that may be flat
type Know = { sigs : Sigs, flat : FlatTags }

noKnow : Know
noKnow = { sigs = OrdMap.empty, flat = OrdMap.empty }

-- What gives and what uses
--------------------------------------------------------------------------------

-- | what is seen of a variable: two kept alike; given a `V`; given a
-- | `V` known a word (#79); given an array's element, as it comes, which
-- | may be a big integer; given an unboxed value; given a literal;
-- | used where the repr is wanted (a `V` by a uniform use); bound; a
-- | field a match binds; kept as the repr, whatever else is seen (a
-- | worker's parameter, given so); seen on each round of the loop
data Event
  = Merge String String
  | Boxed String
  | BoxedWord String
  | Element String
  | Unboxed String Repr
  | Literal String Repr
  | Wants String Repr
  | Binds String
  | Pinned String
  | Kept String Repr
  | Often Event

-- | how many times what is seen on each round of a loop weighs what is
-- | seen once, on the way in or out
loopWeight : Int
loopWeight = 8

-- (seen on each round of the loop, if `lp`)
atRound : Bool -> Event -> Event
atRound True e = Often e
atRound False e = e

-- | what a function's body does with what it returns: wants it as the
-- | repr (its worker's result, or a `V`); or gives it to `retName`, a
-- | class of its own (heff.compile.worker's, the result's repr worked out)
data Ret = RetAs Repr | RetClass

-- | the class of what a function returns (no variable's name: none
-- | starts with `$`)
retName : String
retName = "$ret"

-- | what is walked: a value where a repr is wanted; one taken as it
-- | comes (an array's element, `elementAt`); a name bound or set
-- | to what is computed; a step returned; a condition; statements; what
-- | is last (the loop's parameters, if it is a function's body, and
-- | what is done with what it returns)
data Item
  = IVal Repr Imperative.Val
  | IAny Imperative.Val
  | IBind String Imperative.Comp
  | IOp Imperative.Comp
  | ICond Imperative.Cond
  | ISts (List Imperative.St)
  | ITl (List String) Ret Imperative.Tl

pushVals : Repr -> List Imperative.Val -> List Item -> List Item
pushVals r vs rest = List.foldr (\v acc -> Cons (IVal r v) acc) rest vs

pushArgs : List Repr -> List Imperative.Val -> List Item -> List Item
pushArgs rs vs rest =
  List.foldr (\p acc -> Cons (IVal (fst p) (snd p)) acc) rest (List.zip rs vs)

-- (an operand: one of those at `ks`, taken as it comes)
operandItem : List Int -> Pair Repr Imperative.Val -> Int -> Item
operandItem ks (MkPair r v) i =
  if List.any (\k -> k == i) ks then IAny v else IVal r v

-- (a primitive's operands, as it wants each)
pushPrim : String -> List Imperative.Val -> List Item -> List Item
pushPrim p vs rest =
  List.append
    (List.zipWith
       (operandItem (asTheyCome p))
       (List.zip (argReprs p vs) vs)
       (List.range 0 (List.length vs - 1)))
    rest

-- (a name given what a step not simple computes: a `V`, but an array's
-- element, as it comes)
stepGives : Bool -> String -> Imperative.Comp -> List Event -> List Event
stepGives lp x (OPrim p _) acc =
  if readsElement p then Cons (atRound lp (Element x)) acc
  else Cons (atRound lp (Boxed x)) acc
stepGives lp x o acc = Cons (atRound lp (Boxed x)) acc

-- (a label's place among a shape's labels)
indexOfL : String -> Int -> List String -> Maybe Int
indexOfL l i Nil = Nothing
indexOfL l i (Cons k ks) = if strEq l k then Just i else indexOfL l (i + 1) ks

-- (a name given a value of the repr)
givenAs : String -> Repr -> Event
givenAs x RepV = Boxed x
givenAs x r = Unboxed x r

-- (a name given a value, not a variable: what it is)
sourceOf : String -> Imperative.Val -> Event
sourceOf x (SFixed w _) = Literal x (RepFix w)
sourceOf x (SInt n) =
  if Ranges.isWord (Ranges.point n) then Literal x RepInt else Boxed x
sourceOf x (SFloat _) = Literal x RepF64
sourceOf x (SFloat32 _) = Literal x (RepFix F32)
sourceOf x (SPrim p _) =
  if isBoxed (resultRepr p) then Boxed x else Unboxed x (resultRepr p)
sourceOf x (SProj _ l sh t) = givenAs x (readRepr (indexOfL l 0 sh) t)
sourceOf x v = Boxed x

-- (an arm's field: pinned a `V`, unless it may be flat, of the places
-- `ps`)
pinField : List Int -> List Event -> Pair String Int -> List Event
pinField ps acc (MkPair x i) =
  if List.any (\j -> j == i) ps then Cons (Binds x) acc
  else Cons (Pinned x) (Cons (Binds x) acc)

pinFields : List Int -> List Event -> List String -> List Event
pinFields Nil acc vs =
  List.foldl (\a x -> Cons (Pinned x) (Cons (Binds x) a)) acc vs
pinFields ps acc vs =
  List.foldl (pinField ps) acc (List.zip vs (List.range 0 (List.length vs - 1)))

pinArm : {a : Type} -> FlatTags -> List Event -> Imperative.Arm a -> List Event
pinArm fl acc (MkArm t vs _) =
  pinFields (fromMaybe Nil (OrdMap.lookup fl t)) acc vs

pinArms : {a : Type}
        -> FlatTags
        -> List (Imperative.Arm a)
        -> List Event
        -> List Event
pinArms fl arms acc = List.foldl (pinArm fl) acc arms

-- (the names mentioned, and bound)
mentionedBy : Event -> List String
mentionedBy (Wants x _) = Cons x Nil
mentionedBy (Merge _ y) = Cons y Nil
mentionedBy (Often e) = mentionedBy e
mentionedBy e = Nil

mentioned : List Event -> List String
mentioned evs = List.concatMap mentionedBy evs

bindsOne : OrdMap.OrdMap String Unit -> Event -> OrdMap.OrdMap String Unit
bindsOne m (Binds x) = OrdMap.insert m x MkUnit
bindsOne m e = m

boundBy : List Event -> OrdMap.OrdMap String Unit
boundBy evs = List.foldl bindsOne OrdMap.empty evs

-- (those of `xs` not in `bs` nor before, in order)
freeGo : OrdMap.OrdMap String Unit -> List String -> List String -> List String
freeGo bs Nil acc = List.reverse acc
freeGo bs (Cons x xs) acc =
  if OrdMap.member bs x then freeGo bs xs acc
  else freeGo (OrdMap.insert bs x MkUnit) xs (Cons x acc)

-- | a lambda: its parameters given `V`s; what its body mentions and does
-- | not bind (its closure's) wanted as a `V` where it is made (on each
-- | round of the loop, if `lp`) and given as one where its body starts;
-- | its body's own events (`evs`)
lamEvents : Bool -> List String -> List Event -> List Event -> List Event
lamEvents lp xs evs acc =
  List.foldl
    (\a y -> Cons (atRound lp (Wants y RepV)) (Cons (Boxed y) a))
    (List.foldl
       (\a x -> Cons (Boxed x) (Cons (Binds x) a))
       (List.append evs acc)
       xs)
    (freeGo
       (List.foldl
          (\m x -> OrdMap.insert m x MkUnit)
          (boundBy evs)
          xs)
       (mentioned evs)
       Nil)

armsSts : List (Imperative.Arm (List Imperative.St)) -> List Item -> List Item
armsSts arms rest =
  List.foldr
    (\arm acc -> case arm of
     MkArm _ _ ss -> Cons (ISts ss) acc)
    rest
    arms

armsTl : List String
       -> Ret
       -> List (Imperative.Arm Imperative.Tl)
       -> List Item
       -> List Item
armsTl ps rt arms rest =
  List.foldr
    (\arm acc -> case arm of
     MkArm _ _ t -> Cons (ITl ps rt t) acc)
    rest
    arms

-- (each parameter given what the loop's next round gives it)
loopBinds : List String -> List Imperative.Val -> List Item -> List Item
loopBinds ps vs rest =
  List.foldr
    (\p acc -> Cons (IBind (fst p) (OSimple (snd p))) acc)
    rest
    (List.zip ps vs)

-- (what is returned: wanted as the repr, or given to `retName`)
returned : Ret -> Imperative.Comp -> List Item -> List Item
returned (RetAs r) (OSimple v) rest = Cons (IVal r v) rest
returned (RetAs r) o rest = Cons (IOp o) rest
returned RetClass o rest = Cons (IBind retName o) rest

-- | whether the loop's next round may be reached from here
loops : Imperative.Tl -> Bool
loops (TSeq _ t) = loops t
loops (TReturn _) = False
loops (TLoop _) = True
loops (TIf _ t e) = loops t || loops e
loops (TCase _ arms) =
  List.any
    (\arm -> case arm of
     MkArm _ _ t -> loops t)
    arms

-- | the events of the worklist, last first: what is seen where the loop's
-- | next round may be reached (`lp`, as each tail says) seen on each
-- | round
walk : Know -> Bool -> List Event -> List Item -> List Event
walk sg lp acc Nil = acc
walk sg lp acc (Cons (IVal r (SVar x)) rest) =
  walk sg lp (Cons (atRound lp (Wants x r)) acc) rest
walk sg lp acc (Cons (IVal r (SPrim p argv)) rest) =
  walk sg lp acc (pushPrim p argv rest)
walk sg lp acc (Cons (IVal r (STag _ argv ts)) rest) =
  walk sg lp acc (pushArgs (tagSlots ts (List.length argv)) argv rest)
walk sg lp acc (Cons (IVal r (SRec fs ts)) rest) =
  walk sg lp acc (pushArgs (slotReprs ts) (List.map snd fs) rest)
walk sg lp acc (Cons (IVal r (SProj v _ _ _)) rest) =
  walk sg lp acc (Cons (IVal RepV v) rest)
walk sg lp acc (Cons (IVal r (SLam xs (MkBlock t))) rest) =
  walk
    sg
    lp
    (lamEvents
       lp
       xs
       (walk sg False Nil (Cons (ITl Nil (RetAs RepV) t) Nil))
       acc)
    rest
walk sg lp acc (Cons (IVal r _) rest) = walk sg lp acc rest
walk sg lp acc (Cons (IAny (SVar _)) rest) = walk sg lp acc rest
walk sg lp acc (Cons (IAny v) rest) = walk sg lp acc (Cons (IVal RepV v) rest)
walk sg lp acc (Cons (IBind x (OSimple (SVar y))) rest) =
  walk sg lp (Cons (Merge x y) acc) rest
walk sg lp acc (Cons (IBind x (OSimple v)) rest) =
  walk sg lp (Cons (atRound lp (sourceOf x v)) acc) (Cons (IVal RepV v) rest)
walk sg lp acc (Cons (IBind x OAbandon) rest) = walk sg lp acc rest
walk sg lp acc (Cons (IBind x (OCall g argv)) rest) =
  walk
    sg
    lp
    (Cons (atRound lp (givenAs x (resultIn sg.sigs g))) acc)
    (Cons (IOp (OCall g argv)) rest)
walk sg lp acc (Cons (IBind x o) rest) =
  walk sg lp (stepGives lp x o acc) (Cons (IOp o) rest)
walk sg lp acc (Cons (IOp (OSimple v)) rest) =
  walk sg lp acc (Cons (IVal RepV v) rest)
walk sg lp acc (Cons (IOp (OCall g argv)) rest) =
  walk sg lp acc (pushArgs (paramReprsIn sg.sigs g argv) argv rest)
walk sg lp acc (Cons (IOp (OApply f argv)) rest) =
  walk sg lp acc (pushVals RepV (Cons f argv) rest)
walk sg lp acc (Cons (IOp (OPrim _ argv)) rest) =
  walk sg lp acc (pushVals RepV argv rest)
walk sg lp acc (Cons (IOp (OBool c)) rest) =
  walk sg lp acc (Cons (ICond c) rest)
walk sg lp acc (Cons (IOp _) rest) = walk sg lp acc rest
walk sg lp acc (Cons (ICond (PRel p a b)) rest) =
  walk sg lp acc (pushArgs (argReprs p [a, b]) [a, b] rest)
walk sg lp acc (Cons (ICond (PBool v)) rest) =
  walk sg lp acc (Cons (IVal RepV v) rest)
walk sg lp acc (Cons (ICond (PNot c)) rest) =
  walk sg lp acc (Cons (ICond c) rest)
walk sg lp acc (Cons (ICond (PIf a b c)) rest) =
  walk sg lp acc (Cons (ICond a) (Cons (ICond b) (Cons (ICond c) rest)))
walk sg lp acc (Cons (ICond (PLet x o c)) rest) =
  walk sg lp (Cons (Binds x) acc) (Cons (IBind x o) (Cons (ICond c) rest))
walk sg lp acc (Cons (ICond _) rest) = walk sg lp acc rest
walk sg lp acc (Cons (ISts Nil) rest) = walk sg lp acc rest
walk sg lp acc (Cons (ISts (Cons (SLet x o) ss)) rest) =
  walk sg lp (Cons (Binds x) acc) (Cons (IBind x o) (Cons (ISts ss) rest))
walk sg lp acc (Cons (ISts (Cons (SDecl x) ss)) rest) =
  walk sg lp (Cons (Binds x) acc) (Cons (ISts ss) rest)
walk sg lp acc (Cons (ISts (Cons (SSet x o) ss)) rest) =
  walk sg lp acc (Cons (IBind x o) (Cons (ISts ss) rest))
walk sg lp acc (Cons (ISts (Cons (SIf c ts fs) ss)) rest) =
  walk
    sg
    lp
    acc
    (Cons (ICond c) (Cons (ISts ts) (Cons (ISts fs) (Cons (ISts ss) rest))))
walk sg lp acc (Cons (ISts (Cons (SCase v arms) ss)) rest) =
  walk
    sg
    lp
    (pinArms sg.flat arms acc)
    (Cons (IVal RepV v) (armsSts arms (Cons (ISts ss) rest)))
walk sg lp acc (Cons (ITl ps rt (TSeq ss t)) rest) =
  walk sg (loops t) acc (Cons (ISts ss) (Cons (ITl ps rt t) rest))
walk sg lp acc (Cons (ITl ps rt (TReturn o)) rest) =
  walk sg False acc (returned rt o rest)
walk sg lp acc (Cons (ITl ps rt (TLoop vs)) rest) =
  walk sg True acc (loopBinds ps vs rest)
walk sg lp acc (Cons (ITl ps rt (TIf c t e)) rest) =
  walk
    sg
    (loops t || loops e)
    acc
    (Cons (ICond c) (Cons (ITl ps rt t) (Cons (ITl ps rt e) rest)))
walk sg lp acc (Cons (ITl ps rt (TCase v arms)) rest) =
  walk
    sg
    (loops (TCase v arms))
    (pinArms sg.flat arms acc)
    (Cons (IVal RepV v) (armsTl ps rt arms rest))

-- (a parameter where the function is entered: given unboxed, as its
-- worker takes it, and kept so; else given a `V`)
entered : List Event -> Pair String Repr -> List Event
entered acc (MkPair x RepV) = Cons (Boxed x) (Cons (Binds x) acc)
entered acc (MkPair x r) = Cons (Kept x r) (Cons (Binds x) acc)

-- | the events of a definition: its parameters given as its worker
-- | takes them, if it has one (`sg`), else `V`s, where it is entered, and
-- | the loop's next round giving them their values; what it returns
-- | wanted as its worker gives it
defEvents : Know -> Imperative.Def -> List Event
defEvents sg (MkDef key _ (DefFun xs (MkBlock t))) =
  walk
    sg
    False
    (List.foldl entered Nil (List.zip xs (paramReprsIn sg.sigs key xs)))
    (Cons (ITl xs (RetAs (resultIn sg.sigs key)) t) Nil)
defEvents sg (MkDef _ _ (DefVal (MkBlock t))) =
  walk sg False Nil (Cons (ITl Nil (RetAs RepV) t) Nil)

-- (a `V` given a parameter every call gives a word, `ws`: known one)
asWord : OrdMap.OrdMap String Unit -> Event -> Event
asWord ws (Boxed x) = if OrdMap.member ws x then BoxedWord x else Boxed x
asWord ws (Often e) = Often (asWord ws e)
asWord ws e = e

-- (the parameters at the places `is`, by name)
wordParams : List Int -> Imperative.Def -> OrdMap.OrdMap String Unit
wordParams is (MkDef _ _ (DefFun xs _)) =
  List.foldl
    (\m p ->
       if List.any (\i -> i == snd p) is
       then OrdMap.insert m (fst p) MkUnit
       else m)
    OrdMap.empty
    (List.zip xs (List.range 0 (List.length xs - 1)))
wordParams is d = OrdMap.empty

-- | the events of a definition (`defEvents`), the parameters at the
-- | places `is` given words by every call (heff.compile.ranges): what
-- | they are given, which is all they are, known words
wordEvents : Know -> List Int -> Imperative.Def -> List Event
wordEvents sg Nil d = defEvents sg d
wordEvents sg is d = List.map (asWord (wordParams is d)) (defEvents sg d)

-- | the events of a function's body as heff.compile.worker weighs its
-- | worker: its parameters given `V`s, as a call of it today gives them;
-- | what it returns given to `retName`, which its caller wants a `V` of
proposalEvents : Know -> List String -> Imperative.Tl -> List Event
proposalEvents sg xs t =
  Cons
    (Wants retName RepV)
    (walk
       sg
       False
       (List.foldl entered Nil (List.map (\x -> MkPair x RepV) xs))
       (Cons (ITl xs RetClass t) Nil))

-- Classes
--------------------------------------------------------------------------------

-- (the class a name is in, by the name it is known by)
rootFrom : OrdMap.OrdMap String String -> String -> Maybe String -> String
rootFrom parent x (Just y) =
  if strEq x y then x else rootFrom parent y (OrdMap.lookup parent y)
rootFrom parent x Nothing = x

rootOf : OrdMap.OrdMap String String -> String -> String
rootOf parent x = rootFrom parent x (OrdMap.lookup parent x)

unite : OrdMap.OrdMap String String
      -> String
      -> String
      -> OrdMap.OrdMap String String
unite parent a b =
  if strEq (rootOf parent a) (rootOf parent b) then parent
  else OrdMap.insert parent (rootOf parent a) (rootOf parent b)

pinsOne : OrdMap.OrdMap String Unit -> Event -> OrdMap.OrdMap String Unit
pinsOne m (Pinned x) = OrdMap.insert m x MkUnit
pinsOne m e = m

pinnedIn : List Event -> OrdMap.OrdMap String Unit
pinnedIn evs = List.foldl pinsOne OrdMap.empty evs

-- (a copy to or from a field a match binds -- which stays a `V` -- a
-- `V` given and one wanted)
unpinOne : OrdMap.OrdMap String Unit -> Event -> List Event
unpinOne pins (Merge x y) =
  if OrdMap.member pins x || OrdMap.member pins y
  then [Boxed x, Wants y RepV]
  else Cons (Merge x y) Nil
unpinOne pins e = Cons e Nil

unpinned : OrdMap.OrdMap String Unit -> List Event -> List Event
unpinned pins evs = List.concatMap (unpinOne pins) evs

classOne : OrdMap.OrdMap String String -> Event -> OrdMap.OrdMap String String
classOne m (Merge x y) = unite m x y
classOne m e = m

classesOf : List Event -> OrdMap.OrdMap String String
classesOf evs = List.foldl classOne OrdMap.empty evs

-- | what is seen of a class: the reprs its evidence says, how many `V`s
-- | and unboxed values it is given, how many uses want a `V` and how many
-- | an unboxed value, whether it holds a field a match binds, whether it
-- | is given a `V` that may be a big integer (`Boxed`, not `BoxedWord`)
type Stats =
  { reprs : List Repr
  , boxedIn : Int
  , unboxedIn : Int
  , boxedOut : Int
  , unboxedOut : Int
  , pinned : Bool
  , kept : Maybe Repr
  , big : Bool
  }

noStats : Stats
noStats =
  { reprs = Nil
  , boxedIn = 0
  , unboxedIn = 0
  , boxedOut = 0
  , unboxedOut = 0
  , pinned = False
  , kept = Nothing
  , big = False
  }

withRepr : Repr -> List Repr -> List Repr
withRepr RepV rs = rs
withRepr r rs = if List.any (reprEq r) rs then rs else Cons r rs

-- (`bi`, `ui`, `bo`, `uo` added; `r` evidence)
statsWith : Repr -> Int -> Int -> Int -> Int -> Bool -> Stats -> Stats
statsWith r bi ui bo uo pin s =
  { reprs = withRepr r s.reprs
  , boxedIn = s.boxedIn + bi
  , unboxedIn = s.unboxedIn + ui
  , boxedOut = s.boxedOut + bo
  , unboxedOut = s.unboxedOut + uo
  , pinned = s.pinned || pin
  , kept = s.kept
  , big = s.big
  }

-- (kept as `r`, whatever else is seen)
keptTo : Repr -> Stats -> Stats
keptTo r s =
  { reprs = withRepr r s.reprs
  , boxedIn = s.boxedIn
  , unboxedIn = s.unboxedIn
  , boxedOut = s.boxedOut
  , unboxedOut = s.unboxedOut
  , pinned = s.pinned
  , kept = Just r
  , big = s.big
  }

-- (given a `V` that may be a big integer)
bigTo : Stats -> Stats
bigTo s =
  { reprs = s.reprs
  , boxedIn = s.boxedIn
  , unboxedIn = s.unboxedIn
  , boxedOut = s.boxedOut
  , unboxedOut = s.unboxedOut
  , pinned = s.pinned
  , kept = s.kept
  , big = True
  }

seen : Event -> Stats -> Stats
seen (Boxed _) s = bigTo (statsWith RepV 1 0 0 0 False s)
seen (BoxedWord _) s = statsWith RepInt 1 0 0 0 False s
seen (Element _) s = bigTo s
seen (Unboxed _ r) s = statsWith r 0 1 0 0 False s
seen (Literal _ r) s = statsWith r 0 0 0 0 False s
seen (Wants _ RepV) s = statsWith RepV 0 0 1 0 False s
seen (Wants _ r) s = statsWith r 0 0 0 1 False s
seen (Pinned _) s = statsWith RepV 0 0 0 0 True s
seen (Kept _ r) s = keptTo r s
seen (Often e) s = List.foldl (\acc _ -> seen e acc) s (List.range 1 loopWeight)
seen e s = s

eventName : Event -> String
eventName (Boxed x) = x
eventName (BoxedWord x) = x
eventName (Element x) = x
eventName (Unboxed x _) = x
eventName (Literal x _) = x
eventName (Wants x _) = x
eventName (Pinned x) = x
eventName (Binds x) = x
eventName (Merge x _) = x
eventName (Kept x _) = x
eventName (Often e) = eventName e

-- (an event of the class `root`)
seenIn : OrdMap.OrdMap String Stats
       -> Event
       -> String
       -> OrdMap.OrdMap String Stats
seenIn m e root =
  OrdMap.insert
    m
    root
    (seen e (fromMaybe noStats (OrdMap.lookup m root)))

statsOf : OrdMap.OrdMap String String
        -> List Event
        -> OrdMap.OrdMap String Stats
statsOf parent evs =
  List.foldl (\m e -> seenIn m e (rootOf parent (eventName e))) OrdMap.empty evs

-- (what a box costs, and an unbox: a `Float64`'s box is an allocation,
-- its unbox of a `V` held gives it up; a 64-bit integer's, a test and,
-- beyond 62 bits, the same; a narrower one's, a shift)
boxCost : Repr -> Int
boxCost RepF64 = 3
boxCost (RepFix w) = if Fixed.fixedBits w == 64 then 2 else 1
boxCost RepInt = 1
boxCost RepV = 0

unboxCost : Repr -> Int
unboxCost RepF64 = 2
unboxCost r = 1

-- | how a class is kept: unboxed, where all its evidence says one type,
-- | and keeping it so costs no more than keeping it a `V` -- the `V`s
-- | it is given unboxed and the uses wanting a `V` boxed, against the
-- | unboxed values it is given boxed and the uses wanting one unboxed
decideOf : Stats -> List Repr -> Repr
decideOf s (Cons r Nil) =
  if s.boxedIn * unboxCost r + s.boxedOut * boxCost r
     <= s.unboxedIn * boxCost r + s.unboxedOut * unboxCost r
  then r
  else RepV
decideOf s rs = RepV

-- (an `Int` kept as a word only where no `V` it is given may be a big
-- one)
wordSafe : Stats -> Repr -> Repr
wordSafe s RepInt = if s.big then RepV else RepInt
wordSafe s r = r

decideAs : Stats -> Maybe Repr -> Repr
decideAs s (Just r) = r
decideAs s Nothing = if s.pinned then RepV else wordSafe s (decideOf s s.reprs)

-- | ... and a class with a worker's parameter in it, as the worker takes
-- | that
decide : Stats -> Repr
decide s = decideAs s s.kept

-- | how a class is hoped to be kept, whatever it costs: unboxed where all
-- | its evidence says one type (heff.compile.worker's optimistic start on
-- | a cycle of calls, which `decide` then weighs)
hopeOf : List Repr -> Repr
hopeOf (Cons r Nil) = r
hopeOf rs = RepV

hopeAs : Stats -> Maybe Repr -> Repr
hopeAs s (Just r) = r
hopeAs s Nothing = if s.pinned then RepV else wordSafe s (hopeOf s.reprs)

hope : Stats -> Repr
hope s = hopeAs s s.kept

-- (a name, kept as its class is, if unboxed)
keptAs : Reprs -> String -> Repr -> Reprs
keptAs m x RepV = m
keptAs m x r = OrdMap.insert m x r

keptOne : OrdMap.OrdMap String String
        -> OrdMap.OrdMap String Stats
        -> Reprs
        -> Event
        -> Reprs
keptOne parent stats m (Binds x) =
  keptAs
    m
    x
    (decide
       (fromMaybe noStats (OrdMap.lookup stats (rootOf parent x))))
keptOne parent stats m e = m

reprsIn : OrdMap.OrdMap String String -> List Event -> Reprs
reprsIn parent evs =
  List.foldl (keptOne parent (statsOf parent evs)) OrdMap.empty evs

reprsFrom : List Event -> Reprs
reprsFrom evs = reprsIn (classesOf evs) evs

eventsOf : List Event -> List Event
eventsOf evs = unpinned (pinnedIn evs) evs

-- | a definition's unboxed variables, the workers being `sg`
-- | >>> OrdMap.toList (reprsWith noKnow (MkDef "f" "f" (DefFun ["x"] (MkBlock (TReturn (OSimple (SPrim "int64Add" [SVar "x", SVar "x"])))))))
-- | [MkPair "x" (RepFix I64)]
-- | >>> OrdMap.toList (reprsWith noKnow (MkDef "f" "f" (DefFun ["t"] (MkBlock (TIf (PRel "floatLt" (SVar "t") (SFloat 9.0)) (TLoop [SPrim "floatAdd" [SVar "t", SFloat 1.0]]) (TReturn (OSimple (SLam ["k"] (MkBlock (TReturn (OApply (SVar "k") [SVar "t"])))))))))))
-- | [MkPair "t" RepF64]
reprsWith : Know -> Imperative.Def -> Reprs
reprsWith sg d = reprsFrom (eventsOf (defEvents sg d))

-- | ... the parameters at the places `is` given words by every call
-- | (heff.compile.ranges)
-- | >>> OrdMap.toList (reprsWords noKnow [0] (MkDef "f" "f" (DefFun ["i"] (MkBlock (TIf (PRel "wordLt" (SVar "i") (SInt 9)) (TLoop [SPrim "wordAdd" [SVar "i", SInt 1]]) (TReturn (OSimple (SVar "i"))))))))
-- | [MkPair "i" RepInt]
-- | >>> OrdMap.toList (reprsWith noKnow (MkDef "f" "f" (DefFun ["i"] (MkBlock (TIf (PRel "wordLt" (SVar "i") (SInt 9)) (TLoop [SPrim "wordAdd" [SVar "i", SInt 1]]) (TReturn (OSimple (SVar "i"))))))))
-- | []
reprsWords : Know -> List Int -> Imperative.Def -> Reprs
reprsWords sg is d = reprsFrom (eventsOf (wordEvents sg is d))

-- What a worker is proposed to be (heff.compile.worker)
--------------------------------------------------------------------------------

-- (how the class of `x` is kept)
decidedIn : OrdMap.OrdMap String String
          -> OrdMap.OrdMap String Stats
          -> String
          -> Repr
decidedIn parent stats x =
  decide (fromMaybe noStats (OrdMap.lookup stats (rootOf parent x)))

-- (how the class of `x` is hoped to be kept)
hopedIn : OrdMap.OrdMap String String
        -> OrdMap.OrdMap String Stats
        -> String
        -> Repr
hopedIn parent stats x =
  hope (fromMaybe noStats (OrdMap.lookup stats (rootOf parent x)))

-- (each parameter, and the result, as `kept` says its class is kept)
proposalIn : (OrdMap.OrdMap String String
              -> OrdMap.OrdMap String Stats
              -> String
              -> Repr)
           -> OrdMap.OrdMap String String
           -> List Event
           -> Bool
           -> List String
           -> Sig
proposalIn kept parent evs bounces xs =
  { params = List.map (kept parent (statsOf parent evs)) xs
  , result = if bounces then RepV else kept parent (statsOf parent evs) retName
  }

proposalFrom : List Event -> Bool -> List String -> Sig
proposalFrom evs bounces xs =
  proposalIn decidedIn (classesOf evs) evs bounces xs

-- | the worker a function's body says it may have, the workers being
-- | `sg`: each parameter, and its result, unboxed where its class would
-- | be were the function given `V`s and its caller wanting a `V` (so
-- | that no call costs more than it did) -- a function a call of which
-- | may give back a bounce giving a `V`
-- | >>> sigName (proposeSig noKnow False ["x"] (TReturn (OSimple (SPrim "int64Add" [SVar "x", SVar "x"]))))
-- | "Int64->Int64"
proposeSig : Know -> Bool -> List String -> Imperative.Tl -> Sig
proposeSig sg bounces xs t =
  proposalFrom (eventsOf (proposalEvents sg xs t)) bounces xs

hopeFrom : List Event -> Bool -> List String -> Sig
hopeFrom evs bounces xs = proposalIn hopedIn (classesOf evs) evs bounces xs

-- | the worker a function's body says it may have at best, the workers
-- | being `sg`: each parameter, and its result, unboxed where all the
-- | evidence of its class says one type, whatever that costs (what
-- | heff.compile.worker starts a cycle of calls from)
-- | >>> sigName (hopeSig noKnow False ["x", "y"] (TReturn (OSimple (SPrim "int64Add" [SVar "x", SVar "x"]))))
-- | "Int64,_->Int64"
hopeSig : Know -> Bool -> List String -> Imperative.Tl -> Sig
hopeSig sg bounces xs t =
  hopeFrom (eventsOf (proposalEvents sg xs t)) bounces xs
