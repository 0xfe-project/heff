-- Local definitions lifted: an `EFix f e` -- a `where` definition, its
-- body `e` mentioning itself as `f` -- becomes a global of its own, which
-- takes the variables `e` mentions and does not bind (those of what it
-- is defined in) as its first arguments.  Where the definition stood,
-- and where `e` mentions `f`, is that global given them; a loop of the
-- local definition is a loop of the global, and a call of it a call of
-- the global.

module heff.compile.lift

import heff.compile.ir as IR

-- The variables an expression mentions and does not bind
--------------------------------------------------------------------------------

-- (in the order they are first met)
addFree : List String -> String -> List String -> List String
addFree bound x acc =
  if List.elemBy strEq x bound || List.elemBy strEq x acc then acc else x :: acc

freeGo : List String -> IR.Expr -> List String -> List String
freeGo bound (EVar x) acc = addFree bound x acc
freeGo bound (ELam xs b) acc = freeGo (IR.appendI xs bound) b acc
freeGo bound (ELet x a b) acc = freeGo (x :: bound) b (freeGo bound a acc)
freeGo bound (EMatch x arms) acc =
  List.foldl
    (\a arm -> freeGo (IR.appendI (IR.armVars arm) bound) (IR.armBody arm) a)
    (freeGo bound x acc)
    arms
freeGo bound (EFix f b) acc = freeGo (f :: bound) b acc
freeGo bound (ESet xs a b) acc =
  freeGo (IR.appendI xs bound) b (freeGo bound a acc)
freeGo bound e acc =
  List.foldl (\a x -> freeGo bound x a) acc (IR.partsOnto e Nil)

-- | the variables `e` mentions and does not bind, but `bound`
freeVars : List String -> IR.Expr -> List String
freeVars bound e = List.reverse (freeGo bound e Nil)

-- A variable replaced (the names in a program are its own: nothing is
-- captured)
--------------------------------------------------------------------------------

replaceGo : String -> IR.Expr -> IR.Expr -> IR.Expr
replaceGo x r e@(EVar y) = if strEq y x then r else e
replaceGo x r e = IR.mapParts (\_ p -> replaceGo x r p) e

-- Lifting
--------------------------------------------------------------------------------

-- | the globals made so far (the last first), and how many
type Acc = { out : List IR.Def, n : Int }

type LiftK = { go : IR.Def -> Acc -> IR.Expr -> Pair IR.Expr Acc }

consLifted : IR.Expr -> Pair (List IR.Expr) Acc -> Pair (List IR.Expr) Acc
consLifted x (MkPair xs acc) = MkPair (x :: xs) acc

-- (each of a list, in order)
liftMany : LiftK -> IR.Def -> Acc -> List IR.Expr -> Pair (List IR.Expr) Acc
liftMany k d acc Nil = MkPair Nil acc
liftMany k d acc (x :: xs) = case k.go d acc x of
  MkPair x2 acc2 -> consLifted x2 (liftMany k d acc2 xs)

liftFields : LiftK
           -> IR.Def
           -> Acc
           -> List (Pair String IR.Expr)
           -> Pair (List (Pair String IR.Expr)) Acc
liftFields k d acc fs = case liftMany k d acc (List.map snd fs) of
  MkPair es acc2 -> MkPair (List.zipWith (\f x -> MkPair (fst f) x) fs es) acc2

liftArms : LiftK -> IR.Def -> Acc -> List IR.Arm -> Pair (List IR.Arm) Acc
liftArms k d acc arms = case liftMany k d acc (List.map IR.armBody arms) of
  MkPair bs acc2 ->
    MkPair
      (List.zipWith
         (\arm b -> MkArm (IR.armTag arm) (IR.armVars arm) b)
         arms
         bs)
      acc2

-- | the global a local definition is, given the variables it takes
calledAs : String -> List String -> IR.Expr
calledAs key Nil = EGlobal key
calledAs key fvs = EApp (EGlobal key) (List.map (\x -> EVar x) fvs)

-- | its body, taking those variables first
withParams : List String -> IR.Expr -> IR.Expr
withParams Nil b = b
withParams fvs (ELam xs b) = ELam (IR.appendI fvs xs) b
withParams fvs b = ELam fvs b

-- | the global of a local definition `f`, of the definition `d`
liftedDef : IR.Def -> Int -> String -> List String -> IR.Expr -> IR.Def
liftedDef d n f fvs body =
  IR.mkDef
    (d.key ^ "." ^ IR.baseOf f ^ "$" ^ show n)
    (d.name ^ "." ^ IR.baseOf f)
    (withParams
       fvs
       (replaceGo
          f
          (calledAs (d.key ^ "." ^ IR.baseOf f ^ "$" ^ show n) fvs)
          body))

-- (the local definition's global, its own local definitions lifted too)
liftFixDef : LiftK -> Acc -> List String -> IR.Def -> Pair IR.Expr Acc
liftFixDef k acc fvs ld = case k.go
    ld
    { out = acc.out, n = acc.n + 1 }
    ld.body of
  MkPair b2 acc2 ->
    MkPair
      (calledAs ld.key fvs)
      { out = IR.mkDef ld.key ld.name b2 :: acc2.out, n = acc2.n }

liftFix : LiftK -> IR.Def -> Acc -> String -> IR.Expr -> Pair IR.Expr Acc
liftFix k d acc f body =
  liftFixDef
    k
    acc
    (freeVars (f :: Nil) body)
    (liftedDef d acc.n f (freeVars (f :: Nil) body) body)

fixOf : IR.Expr -> Maybe (Pair String IR.Expr)
fixOf (EFix f b) = Just (MkPair f b)
fixOf e = Nothing

-- (`\x -> b`, of one parameter)
oneParam : IR.Expr -> Maybe (Pair String IR.Expr)
oneParam (ELam xs b) = case xs of
  x :: Nil -> Just (MkPair x b)
  _ -> Nothing
oneParam e = Nothing

liftArgs : LiftK -> IR.Def -> Acc -> IR.Expr -> List IR.Expr -> Pair IR.Expr Acc
liftArgs k d acc f args = case liftMany k d acc (f :: args) of
  MkPair (f2 :: as2) acc2 -> MkPair (EApp f2 as2) acc2
  MkPair Nil acc2 -> MkPair (EApp f args) acc2

-- (a local definition bound by a beta-redex, as elaboration binds it: its
-- name is its global, given the variables, wherever it is used -- so that
-- what is defined after it takes those variables, not it)
liftRedex : LiftK
          -> IR.Def
          -> Acc
          -> String
          -> IR.Expr
          -> IR.Expr
          -> Pair IR.Expr Acc
liftRedex k d acc x b a = case fixOf a of
  Just (MkPair f fb) -> case liftFix k d acc f fb of
    MkPair call acc2 -> k.go d acc2 (replaceGo x call b)
  Nothing -> liftArgs k d acc (ELam [x] b) [a]

liftApp : LiftK -> IR.Def -> Acc -> IR.Expr -> List IR.Expr -> Pair IR.Expr Acc
liftApp k d acc f args = case oneParam f of
  Just (MkPair x b) -> case args of
    a :: Nil -> liftRedex k d acc x b a
    _ -> liftArgs k d acc f args
  Nothing -> liftArgs k d acc f args

liftGo : LiftK -> IR.Def -> Acc -> IR.Expr -> Pair IR.Expr Acc
liftGo k d acc (EFix f b) = liftFix k d acc f b
liftGo k d acc (ELam xs b) = case k.go d acc b of
  MkPair b2 acc2 -> MkPair (ELam xs b2) acc2
liftGo k d acc (EApp f args) = liftApp k d acc f args
liftGo k d acc e@(ELet x a b) = case liftMany k d acc [a, b] of
  MkPair (a2 :: b2 :: Nil) acc2 -> MkPair (ELet x a2 b2) acc2
  MkPair _ acc2 -> MkPair e acc2
liftGo k d acc (ERecord fs ts) = case liftFields k d acc fs of
  MkPair fs2 acc2 -> MkPair (ERecord fs2 ts) acc2
liftGo k d acc (EProj x l sh t) = case k.go d acc x of
  MkPair x2 acc2 -> MkPair (EProj x2 l sh t) acc2
liftGo k d acc (ETag t es ts) = case liftMany k d acc es of
  MkPair es2 acc2 -> MkPair (ETag t es2 ts) acc2
liftGo k d acc (EMatch x arms) = case k.go d acc x of
  MkPair x2 acc2 -> case liftArms k d acc2 arms of
    MkPair arms2 acc3 -> MkPair (EMatch x2 arms2) acc3
liftGo k d acc (EPrimCall p es) = case liftMany k d acc es of
  MkPair es2 acc2 -> MkPair (EPrimCall p es2) acc2
liftGo k d acc (ECall c es) = case liftMany k d acc es of
  MkPair es2 acc2 -> MkPair (ECall c es2) acc2
liftGo k d acc e@(ESet xs a b) = case liftMany k d acc [a, b] of
  MkPair (a2 :: b2 :: Nil) acc2 -> MkPair (ESet xs a2 b2) acc2
  MkPair _ acc2 -> MkPair e acc2
liftGo k d acc (EValues es) = case liftMany k d acc es of
  MkPair es2 acc2 -> MkPair (EValues es2) acc2
liftGo k d acc (EBool c) = case liftMany k d acc (IR.condParts c) of
  MkPair es2 acc2 -> MkPair (EBool (IR.condFill c es2)) acc2
liftGo k d acc e = MkPair e acc

lk : LiftK
lk = { go = \d acc e -> liftGo lk d acc e }

-- Which come first
--------------------------------------------------------------------------------

-- A definition is simplified knowing those before it.  A local loop --
-- one calling itself, `for`'s and `while`'s -- comes before the
-- definition it is of, with what it calls of the others: so that where
-- it is called it is known, and a copy of it made for what it is given
-- there (`for`'s `next`, the step of what it goes through), the step
-- then put in it.  The others come after, as they were.

-- (whether one of `keys` is called in it)
callsAny : List String -> IR.Def -> Bool
callsAny keys ld =
  List.any (\g -> List.elemBy strEq g keys) (IR.globalsIn ld.body)

-- (the keys of the local definitions that come first: a loop, and those
-- one calls; each is after what it calls, so the last first)
earlyGo : List String -> List IR.Def -> List String
earlyGo keys Nil = keys
earlyGo keys (ld :: rest) =
  if List.elemBy strEq ld.key keys || callsAny [ld.key] ld
  then earlyGo (ld.key :: IR.appendI (IR.globalsIn ld.body) keys) rest
  else earlyGo keys rest

isEarly : List String -> IR.Def -> Bool
isEarly keys ld = List.elemBy strEq ld.key keys

-- | the local definitions (the last first) and the definition, in the
-- | order they are simplified: the loops and what they call, the
-- | definition, the others
-- | >>> List.map (\(d : IR.Def) -> d.key) (ordered [IR.mkDef "f.go$1" "go" (EApp (EGlobal "f.go$1") Nil), IR.mkDef "f.h$0" "h" (EInt 1)] (IR.mkDef "f" "f" (EInt 0)))
-- | ["f.go$1", "f", "f.h$0"]
ordered : List IR.Def -> IR.Def -> List IR.Def
ordered out d =
  IR.appendI
    (List.reverse (List.keepIf (isEarly (earlyGo Nil out)) out))
    (d
     :: List.reverse
       (List.keepIf (\ld -> not (isEarly (earlyGo Nil out) ld)) out))

-- | a definition, and the globals of its local definitions, in the order
-- | they are simplified (`ordered`)
liftDef : IR.Def -> List IR.Def
liftDef d = case lk.go d { out = Nil, n = 0 } d.body of
  MkPair b acc -> ordered acc.out (IR.mkDef d.key d.name b)

-- | every local definition of the program a global of its own
-- | >>> List.map (\(d : IR.Def) -> d.body) (liftProgram [IR.mkDef "m.f" "f" (ELam ["n"] (ELet "go" (EFix "go" (ELam ["i"] (EApp (EVar "go") [EVar "n"]))) (EApp (EVar "go") [EInt 0])))])
-- | Cons (ELam (Cons "n" (Cons "i" Nil)) (EApp (EApp (EGlobal "m.f.go$0") (Cons (EVar "n") Nil)) (Cons (EVar "n") Nil))) (Cons (ELam (Cons "n" Nil) (ELet "go" (EApp (EGlobal "m.f.go$0") (Cons (EVar "n") Nil)) (EApp (EVar "go") (Cons (EInt 0) Nil)))) Nil)
liftProgram : List IR.Def -> List IR.Def
liftProgram defs = List.concatMap liftDef defs
