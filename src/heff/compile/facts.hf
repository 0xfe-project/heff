-- What is known of a program's definitions, as both backends are given
-- them (heff.compile.lower): worked out once, here, and read by each
-- emitter, which works out none of it itself (#40).
--
-- - `arity`: how many parameters each function takes at once.
-- - `bounce`: the definitions a call of which may give back a bounce --
--   that apply a function not known last, or call such a definition
--   last (a call of an unknown function last counts itself, and every so
--   often lets the stack go: heff.compile.emit's "Tail calls").
-- - `lazy`: the definitions that are not functions and are computed
--   when first used: all but a value that mentions only definitions
--   before it computed at once (one that cannot fail).
-- - `lent`: each function's parameters lent to it, not given -- the C
--   backend's (heff.compile.borrow), none until it is told.
-- - `workers`: the functions with a worker, which takes some of their
--   parameters, or gives their result, unboxed, and how -- the C
--   backend's (heff.compile.worker), none until it is told.
-- - `flat`: of each tag, the fields any of its tags is built with flat
--   (a `Float64`'s or a 64-bit integer's bits, #64): those a match reads
--   as the tag says -- the C backend's, none until it is told.
-- - `sure`: of each tag, the fields every tag of it is built with flat:
--   those a match reads as they are, nothing looked at -- the C
--   backend's, none until it is told.
-- - `sureRecs`: of each record's shape (`Repr.shapeKey`), the fields every
--   record of it is built with flat: those read as they are -- the C
--   backend's, none until it is told.
-- - `tuples`: the workers that give back a tuple (heff.compile.cpr), each
--   by how many values -- none until it is told.
-- - `words`: of each function, the parameters (by index) every call
--   gives an `Int` that fits a word (heff.compile.ranges, #79) -- the C
--   backend's, none until it is told.
-- - `tokens`: the functions given the cell of a tag to build in (#117,
--   heff.compile.tokens): of each function, the sizes of the cells its
--   copies are given; of each copy, its cell's -- the C backend's, none
--   until it is told.

module heff.compile.facts

import heff.compile.ir as IR
import heff.compile.repr as Repr
import std.map as Map

-- | the copy of the function `g` given, first, the cell of a tag of `n`
-- | fields to build in
tokKey : String -> Int -> String
tokKey g n = g ^ "$tok" ^ show n

-- | the functions given a cell: of each function, the sizes of its
-- | copies' cells; of each copy, its cell's size
type Tokens = { byFun : Map.Map String (List Int), cells : Map.Map String Int }

noTokens : Tokens
noTokens = { byFun = Map.empty, cells = Map.empty }

type Facts =
  { arity : Map.Map String Int
  , bounce : Map.Map String Unit
  , lazy : Map.Map String Unit
  , lent : Map.Map String (List Int)
  , workers : Repr.Sigs
  , flat : Repr.FlatTags
  , sure : Repr.FlatTags
  , sureRecs : Repr.FlatTags
  , tuples : Map.Map String Int
  , words : Map.Map String (List Int)
  , tokens : Tokens
  }

-- Arities
--------------------------------------------------------------------------------

arityOfBody : IR.Expr -> Int
arityOfBody (ELam xs _) = List.length xs
arityOfBody b = 0

-- (a function's: a definition that is no function has none)
arityOne : Map.Map String Int -> IR.Def -> Map.Map String Int
arityOne m d@{ body = ELam xs _ } = Map.insert m d.key (List.length xs)
arityOne m d = m

-- Bounces
--------------------------------------------------------------------------------

-- | whether it applies an unknown function last
tailApp : IR.Expr -> Bool
tailApp (ELet _ _ b) = tailApp b
tailApp (ESet _ _ b) = tailApp b
tailApp (EMatch _ arms) = List.any (\a -> tailApp (IR.armBody a)) arms
tailApp (EApp _ _) = True
tailApp e = False

-- | the definitions it calls last
tailGlobals : IR.Expr -> List String
tailGlobals (ELet _ _ b) = tailGlobals b
tailGlobals (ESet _ _ b) = tailGlobals b
tailGlobals (EMatch _ arms) =
  List.concatMap (\a -> tailGlobals (IR.armBody a)) arms
tailGlobals (ECall g _) = Cons g Nil
tailGlobals e = Nil

bodyBounces : Map.Map String Unit -> IR.Def -> Bool
bodyBounces set d@{ body = ELam _ b } =
  tailApp b
  || List.any
    (\g -> not (strEq g d.key) && Map.member set g)
    (tailGlobals b)
bodyBounces set d = False

bounceStep : List IR.Def -> Map.Map String Unit -> Map.Map String Unit
bounceStep defs set =
  List.foldl
    (\m (d : IR.Def) ->
       if bodyBounces set d then Map.insert m d.key MkUnit else m)
    set
    defs

bounceGo : List IR.Def -> Map.Map String Unit -> Map.Map String Unit
bounceGo defs set =
  if Map.size (bounceStep defs set) == Map.size set then set
  else bounceGo defs (bounceStep defs set)

-- | the definitions that may give back a bounce
bouncing : List IR.Def -> Map.Map String Unit
bouncing defs = bounceGo defs Map.empty

-- Laziness
--------------------------------------------------------------------------------

-- (each definition before, by whether it is lazy)
type Seen = Map.Map String Bool

eagerSeen : Seen -> String -> Bool
eagerSeen seen k = case Map.lookup seen k of
  Just lz -> not lz
  Nothing -> False

-- | whether a definition is computed when first used: not when it is a
-- | value that mentions only definitions before it computed at once
lazyOf : Seen -> String -> IR.Expr -> Bool
lazyOf seen key b =
  arityOfBody b == 0
  && not
    (IR.isValue b
     && List.all (\k -> not (strEq k key) && eagerSeen seen k) (IR.globalsIn b))

lazySeen : List IR.Def -> Seen
lazySeen defs =
  List.foldl
    (\m (d : IR.Def) -> Map.insert m d.key (lazyOf m d.key d.body))
    Map.empty
    defs

lazies : List IR.Def -> Map.Map String Unit
lazies defs =
  List.foldl
    (\m p -> if snd p then Map.insert m (fst p) MkUnit else m)
    Map.empty
    (Map.toList (lazySeen defs))

-- Flat fields of tags (#64)
--------------------------------------------------------------------------------

-- (the places of the fields kept flat, of those of a tag built so)
flatPlaces : List Repr.Repr -> List Int
flatPlaces rs =
  List.map
    fst
    (List.keepIf
       (\p -> not (Repr.isBoxed (snd p)))
       (List.zip (List.range 0 (List.length rs - 1)) rs))

-- (each place once)
unionI : List Int -> List Int -> List Int
unionI xs ys =
  List.append xs (List.keepIf (\y -> not (List.any (\x -> x == y) xs)) ys)

flatInto : Repr.FlatTags -> String -> List Int -> Repr.FlatTags
flatInto m t Nil = m
flatInto m t is =
  Map.insert
    m
    t
    (unionI (fromMaybe Nil (Map.lookup m t)) is)

flatW : Repr.FlatTags -> List IR.Expr -> Repr.FlatTags
flatW m Nil = m
flatW m (Cons (ETag t args ts) rest) =
  flatW
    (flatInto m t (flatPlaces (Repr.tagSlots ts (List.length args))))
    (IR.appendI args rest)
flatW m (Cons (ELam _ b) rest) = flatW m (Cons b rest)
flatW m (Cons (EApp f args) rest) = flatW m (Cons f (IR.appendI args rest))
flatW m (Cons (ELet _ a b) rest) = flatW m (Cons a (Cons b rest))
flatW m (Cons (ERecord fs _) rest) = flatW m (IR.pushFields fs rest)
flatW m (Cons (EProj e _ _ _) rest) = flatW m (Cons e rest)
flatW m (Cons (EMatch s arms) rest) = flatW m (Cons s (IR.pushArms arms rest))
flatW m (Cons (EPrimCall _ args) rest) = flatW m (IR.appendI args rest)
flatW m (Cons (ECall _ args) rest) = flatW m (IR.appendI args rest)
flatW m (Cons (EFix _ b) rest) = flatW m (Cons b rest)
flatW m (Cons (EBool c) rest) = flatW m (IR.condOnto c rest)
flatW m (Cons (ESet _ a b) rest) = flatW m (Cons a (Cons b rest))
flatW m (Cons (EValues es) rest) = flatW m (IR.appendI es rest)
flatW m (Cons _ rest) = flatW m rest

-- | of each tag, the fields its tags are built with flat anywhere in the
-- | program (`Repr.tagSlots`)
-- | >>> Map.toList (flatTags [IR.mkDef "f" "f" (ELam ["x"] (ETag "Just" [EVar "x"] [FtFloat])), IR.mkDef "g" "g" (ETag "Just" [EInt 1] [FtAny])])
-- | [MkPair "Just" [0]]
flatTags : List IR.Def -> Repr.FlatTags
flatTags defs =
  List.foldl (\m (d : IR.Def) -> flatW m (Cons d.body Nil)) Map.empty defs

-- (the places at which each tag is built flat: of a tag built so, those
-- of its fields, of any other, none)
sureMeet : Map.Map String (List Int)
         -> String
         -> List Int
         -> Map.Map String (List Int)
sureMeet m t is = case Map.lookup m t of
  Just js ->
    Map.insert
      m
      t
      (List.keepIf (\j -> List.any (\i -> i == j) is) js)
  Nothing -> Map.insert m t is

sureW : Map.Map String (List Int) -> List IR.Expr -> Map.Map String (List Int)
sureW m Nil = m
sureW m (Cons (ETag t args ts) rest) =
  sureW
    (sureMeet m t (flatPlaces (Repr.tagSlots ts (List.length args))))
    (IR.appendI args rest)
sureW m (Cons (ELam _ b) rest) = sureW m (Cons b rest)
sureW m (Cons (EApp f args) rest) = sureW m (Cons f (IR.appendI args rest))
sureW m (Cons (ELet _ a b) rest) = sureW m (Cons a (Cons b rest))
sureW m (Cons (ERecord fs _) rest) = sureW m (IR.pushFields fs rest)
sureW m (Cons (EProj e _ _ _) rest) = sureW m (Cons e rest)
sureW m (Cons (EMatch s arms) rest) = sureW m (Cons s (IR.pushArms arms rest))
sureW m (Cons (EPrimCall _ args) rest) = sureW m (IR.appendI args rest)
sureW m (Cons (ECall _ args) rest) = sureW m (IR.appendI args rest)
sureW m (Cons (EFix _ b) rest) = sureW m (Cons b rest)
sureW m (Cons (EBool c) rest) = sureW m (IR.condOnto c rest)
sureW m (Cons (ESet _ a b) rest) = sureW m (Cons a (Cons b rest))
sureW m (Cons (EValues es) rest) = sureW m (IR.appendI es rest)
sureW m (Cons _ rest) = sureW m rest

-- | of each tag, the fields every tag of it in the program is built with
-- | flat: read as they are, where only the program builds the tag (a
-- | backend knows what else does: its runtime, a provider)
-- | >>> Map.toList (sureTags [IR.mkDef "f" "f" (ELam ["x"] (ETag "Circle" [EVar "x"] [FtFloat])), IR.mkDef "g" "g" (ELam ["y"] (ETag "Just" [EVar "y"] [FtFloat])), IR.mkDef "h" "h" (ETag "Just" [EInt 1] [FtAny])])
-- | [MkPair "Circle" [0]]
sureTags : List IR.Def -> Repr.FlatTags
sureTags defs =
  Map.fromList
    (List.keepIf
       (\p -> not (List.null (snd p)))
       (Map.toList
          (List.foldl
             (\m (d : IR.Def) -> sureW m (Cons d.body Nil))
             Map.empty
             defs)))

-- (... and each record of a shape, as `sureW` each tag)
sureRecW : Map.Map String (List Int)
         -> List IR.Expr
         -> Map.Map String (List Int)
sureRecW m Nil = m
sureRecW m (Cons (ERecord fs ts) rest) =
  sureRecW
    (sureMeet
       m
       (Repr.shapeKey (List.map fst fs))
       (flatPlaces (Repr.tagSlots ts (List.length fs))))
    (IR.pushFields fs rest)
sureRecW m (Cons (ETag _ args _) rest) = sureRecW m (IR.appendI args rest)
sureRecW m (Cons (ELam _ b) rest) = sureRecW m (Cons b rest)
sureRecW m (Cons (EApp f args) rest) =
  sureRecW m (Cons f (IR.appendI args rest))
sureRecW m (Cons (ELet _ a b) rest) = sureRecW m (Cons a (Cons b rest))
sureRecW m (Cons (EProj e _ _ _) rest) = sureRecW m (Cons e rest)
sureRecW m (Cons (EMatch s arms) rest) =
  sureRecW m (Cons s (IR.pushArms arms rest))
sureRecW m (Cons (EPrimCall _ args) rest) = sureRecW m (IR.appendI args rest)
sureRecW m (Cons (ECall _ args) rest) = sureRecW m (IR.appendI args rest)
sureRecW m (Cons (EFix _ b) rest) = sureRecW m (Cons b rest)
sureRecW m (Cons (EBool c) rest) = sureRecW m (IR.condOnto c rest)
sureRecW m (Cons (ESet _ a b) rest) = sureRecW m (Cons a (Cons b rest))
sureRecW m (Cons (EValues es) rest) = sureRecW m (IR.appendI es rest)
sureRecW m (Cons _ rest) = sureRecW m rest

-- | of each record's shape, the fields every record of it in the program
-- | is built with flat: read as they are, where only the program builds
-- | such a record (a backend knows what else does: a provider)
-- | >>> Map.toList (sureRecords [IR.mkDef "f" "f" (ELam ["x"] (ERecord [MkPair "a" (EVar "x"), MkPair "b" (EVar "x")] [FtFloat, FtFloat])), IR.mkDef "g" "g" (ERecord [MkPair "a" (EInt 1), MkPair "b" (EFloat 1.0)] [FtAny, FtFloat])])
-- | [MkPair "a,b" [1]]
sureRecords : List IR.Def -> Repr.FlatTags
sureRecords defs =
  Map.fromList
    (List.keepIf
       (\p -> not (List.null (snd p)))
       (Map.toList
          (List.foldl
             (\m (d : IR.Def) -> sureRecW m (Cons d.body Nil))
             Map.empty
             defs)))

-- Facts
--------------------------------------------------------------------------------

-- | what is known of the definitions (none lent, no workers)
-- | >>> Map.toList (factsOf [IR.mkDef "f" "f" (ELam ["x"] (EApp (EVar "x") [EInt 1])), IR.mkDef "n" "n" (EInt 1)]).arity
-- | [MkPair "f" 1]
factsOf : List IR.Def -> Facts
factsOf defs =
  { arity = List.foldl arityOne Map.empty defs
  , bounce = bouncing defs
  , lazy = lazies defs
  , lent = Map.empty
  , workers = Map.empty
  , flat = Map.empty
  , sure = Map.empty
  , sureRecs = Map.empty
  , tuples = Map.empty
  , words = Map.empty
  , tokens = noTokens
  }

-- | ... and the parameters lent
withLent : Map.Map String (List Int) -> Facts -> Facts
withLent lent f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the workers
withWorkers : Repr.Sigs -> Facts -> Facts
withWorkers ws f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = ws
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the tags' fields that may be flat, and those that are
withFlat : Repr.FlatTags -> Repr.FlatTags -> Facts -> Facts
withFlat fl su f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = fl
  , sure = su
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the records' fields that are flat, by shape
withSureRecs : Repr.FlatTags -> Facts -> Facts
withSureRecs su f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = su
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the functions giving back a tuple (heff.compile.cpr)
withTuples : Map.Map String Int -> Facts -> Facts
withTuples ts f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = ts
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the parameters every call gives a word
withWords : Map.Map String (List Int) -> Facts -> Facts
withWords ws f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = ws
  , tokens = f.tokens
  }

-- | ... and the functions given a cell
withTokens : Tokens -> Facts -> Facts
withTokens tk f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = tk
  }

-- | what the walk knows of the program (heff.compile.repr)
knowOf : Facts -> Repr.Know
knowOf f = { sigs = f.workers, flat = f.flat }

-- | the parameters of `key` every call gives a word
wordsOf : Facts -> String -> List Int
wordsOf f key = fromMaybe Nil (Map.lookup f.words key)
