-- What is known of a program's definitions, as both backends are given
-- them (heff.compile.lower): worked out once, here, and read by each
-- emitter, which works out none of it itself (#40).
--
-- - `arity`: how many parameters each function takes at once.
-- - `bounce`: the definitions a call of which may give back a bounce --
--   that apply a function not known last, or call such a definition
--   last (a call of an unknown function last counts itself, and every so
--   often lets the stack go: heff.compile.emit's "Tail calls").
-- - `lazy`: the definitions that are not functions and are computed
--   when first used: all but a value that mentions only definitions
--   before it computed at once (one that cannot fail).
-- - `lent`: each function's parameters lent to it, not given -- the C
--   backend's (heff.compile.borrow), none until it is told.
-- - `workers`: the functions with a worker, which takes some of their
--   parameters, or gives their result, unboxed, and how -- the C
--   backend's (heff.compile.worker), none until it is told.
-- - `flat`: of each tag, the fields any of its tags is built with flat
--   (a `Float64`'s or a 64-bit integer's bits, #64): those a match reads
--   as the tag says -- the C backend's, none until it is told.
-- - `sure`: of each tag, the fields every tag of it is built with flat:
--   those a match reads as they are, nothing looked at -- the C
--   backend's, none until it is told.
-- - `sureRecs`: of each record's shape (`Repr.shapeKey`), the fields every
--   record of it is built with flat: those read as they are -- the C
--   backend's, none until it is told.
-- - `tuples`: the workers that give back a tuple (heff.compile.cpr), each
--   by how many values -- none until it is told.
-- - `words`: of each function, the parameters (by index) every call
--   gives an `Int` that fits a word (heff.compile.ranges, #79) -- the C
--   backend's, none until it is told.
-- - `tokens`: the functions given the cell of a tag to build in (#117,
--   heff.compile.tokens): of each function, the sizes of the cells its
--   copies are given; of each copy, its cell's -- the C backend's, none
--   until it is told.

module heff.compile.facts

import heff.compile.callarity as CallArity
import heff.compile.ir as IR
import heff.compile.repr as Repr
import std.ordmap as OrdMap

-- | the copy of the function `g` given, first, the cell of a tag of `n`
-- | fields to build in
tokKey : String -> Int -> String
tokKey g n = g ^ "$tok" ^ debug n

-- | the functions given a cell: of each function, the sizes of its
-- | copies' cells; of each copy, its cell's size
type Tokens =
  { byFun : OrdMap.OrdMap String (List Int), cells : OrdMap.OrdMap String Int }

noTokens : Tokens
noTokens = { byFun = OrdMap.empty, cells = OrdMap.empty }

type Facts =
  { arity : OrdMap.OrdMap String Int
  , bounce : OrdMap.OrdMap String Unit
  , lazy : OrdMap.OrdMap String Unit
  , lent : OrdMap.OrdMap String (List Int)
  , workers : Repr.Sigs
  , flat : Repr.FlatTags
  , sure : Repr.FlatTags
  , sureRecs : Repr.FlatTags
  , tuples : OrdMap.OrdMap String Int
  , words : OrdMap.OrdMap String (List Int)
  , tokens : Tokens
  }

-- Arities
--------------------------------------------------------------------------------

arityOfBody : IR.Expr -> Int
arityOfBody (ELam xs _) = List.length xs
arityOfBody b = 0

-- | whether a function's arity, if it has one, is `n`
arityIs : Int -> Maybe Int -> Bool
arityIs n (Just m) = n == m
arityIs n Nothing = False

-- Bounces
--------------------------------------------------------------------------------

-- | whether a way out applies an unknown function
tailApp : IR.Expr -> Bool
tailApp (EApp _ _) = True
tailApp e = False

-- | the definition a way out calls
tailGlobals : IR.Expr -> List String
tailGlobals (ECall g _) = [g]
tailGlobals e = Nil

bodyBounces : OrdMap.OrdMap String Unit -> IR.Def -> Bool
bodyBounces set d@{ body = ELam _ b } =
  List.any tailApp (IR.waysList b)
  || List.any
    (\g -> not (strEq g d.key) && OrdMap.member set g)
    (List.concatMap tailGlobals (IR.waysList b))
bodyBounces set d = False

bounceStep : List IR.Def
           -> OrdMap.OrdMap String Unit
           -> OrdMap.OrdMap String Unit
bounceStep defs set =
  List.foldl
    (\m (d : IR.Def) ->
       if bodyBounces set d then OrdMap.insert m d.key MkUnit else m)
    set
    defs

bounceGo : List IR.Def -> OrdMap.OrdMap String Unit -> OrdMap.OrdMap String Unit
bounceGo defs set =
  if OrdMap.size (bounceStep defs set) == OrdMap.size set then set
  else bounceGo defs (bounceStep defs set)

-- | the definitions that may give back a bounce
bouncing : List IR.Def -> OrdMap.OrdMap String Unit
bouncing defs = bounceGo defs OrdMap.empty

-- Laziness
--------------------------------------------------------------------------------

-- (each definition before, by whether it is lazy)
type Seen = OrdMap.OrdMap String Bool

eagerSeen : Seen -> String -> Bool
eagerSeen seen k = case OrdMap.lookup seen k of
  Just lz -> not lz
  Nothing -> False

-- | whether a definition is computed when first used: not when it is a
-- | value that mentions only definitions before it computed at once
lazyOf : Seen -> String -> IR.Expr -> Bool
lazyOf seen key b =
  arityOfBody b == 0
  && not
    (IR.isValue b
     && List.all (\k -> not (strEq k key) && eagerSeen seen k) (IR.globalsIn b))

lazySeen : List IR.Def -> Seen
lazySeen defs =
  List.foldl
    (\m (d : IR.Def) -> OrdMap.insert m d.key (lazyOf m d.key d.body))
    OrdMap.empty
    defs

lazies : List IR.Def -> OrdMap.OrdMap String Unit
lazies defs =
  List.foldl
    (\m p -> if snd p then OrdMap.insert m (fst p) MkUnit else m)
    OrdMap.empty
    (OrdMap.toList (lazySeen defs))

-- Flat fields of tags (#64)
--------------------------------------------------------------------------------

-- (the places of the fields kept flat, of those of a tag built so)
flatPlaces : List Repr.Repr -> List Int
flatPlaces rs =
  List.map
    fst
    (List.keepIf
       (\p -> not (Repr.isBoxed (snd p)))
       (List.zip (List.range 0 (List.length rs - 1)) rs))

-- (each place once)
unionI : List Int -> List Int -> List Int
unionI xs ys =
  List.append xs (List.keepIf (\y -> not (List.any (\x -> x == y) xs)) ys)

flatInto : Repr.FlatTags -> String -> List Int -> Repr.FlatTags
flatInto m t [] = m
flatInto m t is =
  OrdMap.insert
    m
    t
    (unionI (fromMaybe Nil (OrdMap.lookup m t)) is)

flatW : Repr.FlatTags -> List IR.Expr -> Repr.FlatTags
flatW m [] = m
flatW m (ETag t args ts :: rest) =
  flatW
    (flatInto m t (flatPlaces (Repr.tagSlots ts (List.length args))))
    (IR.appendI args rest)
flatW m (e :: rest) = flatW m (IR.partsOnto e rest)

-- | of each tag, the fields its tags are built with flat anywhere in the
-- | program (`Repr.tagSlots`)
-- | >>> OrdMap.toList (flatTags [IR.mkDef "f" "f" (ELam ["x"] (ETag "Just" [EVar "x"] [FtFloat])), IR.mkDef "g" "g" (ETag "Just" [EInt 1] [FtAny])])
-- | [MkPair "Just" [0]]
flatTags : List IR.Def -> Repr.FlatTags
flatTags defs =
  List.foldl (\m (d : IR.Def) -> flatW m [d.body]) OrdMap.empty defs

-- (the places at which each tag is built flat: of a tag built so, those
-- of its fields, of any other, none)
sureMeet : OrdMap.OrdMap String (List Int)
         -> String
         -> List Int
         -> OrdMap.OrdMap String (List Int)
sureMeet m t is = case OrdMap.lookup m t of
  Just js ->
    OrdMap.insert
      m
      t
      (List.keepIf (\j -> List.any (\i -> i == j) is) js)
  Nothing -> OrdMap.insert m t is

sureW : OrdMap.OrdMap String (List Int)
      -> List IR.Expr
      -> OrdMap.OrdMap String (List Int)
sureW m [] = m
sureW m (ETag t args ts :: rest) =
  sureW
    (sureMeet m t (flatPlaces (Repr.tagSlots ts (List.length args))))
    (IR.appendI args rest)
sureW m (e :: rest) = sureW m (IR.partsOnto e rest)

-- | of each tag, the fields every tag of it in the program is built with
-- | flat: read as they are, where only the program builds the tag (a
-- | backend knows what else does: its runtime, a provider)
-- | >>> OrdMap.toList (sureTags [IR.mkDef "f" "f" (ELam ["x"] (ETag "Circle" [EVar "x"] [FtFloat])), IR.mkDef "g" "g" (ELam ["y"] (ETag "Just" [EVar "y"] [FtFloat])), IR.mkDef "h" "h" (ETag "Just" [EInt 1] [FtAny])])
-- | [MkPair "Circle" [0]]
sureTags : List IR.Def -> Repr.FlatTags
sureTags defs =
  OrdMap.fromList
    (List.keepIf
       (\p -> not (List.null (snd p)))
       (OrdMap.toList
          (List.foldl
             (\m (d : IR.Def) -> sureW m [d.body])
             OrdMap.empty
             defs)))

-- (... and each record of a shape, as `sureW` each tag)
sureRecW : OrdMap.OrdMap String (List Int)
         -> List IR.Expr
         -> OrdMap.OrdMap String (List Int)
sureRecW m [] = m
sureRecW m (ERecord fs ts :: rest) =
  sureRecW
    (sureMeet
       m
       (Repr.shapeKey (List.map fst fs))
       (flatPlaces (Repr.tagSlots ts (List.length fs))))
    (IR.pushFields fs rest)
sureRecW m (e :: rest) = sureRecW m (IR.partsOnto e rest)

-- | of each record's shape, the fields every record of it in the program
-- | is built with flat: read as they are, where only the program builds
-- | such a record (a backend knows what else does: a provider)
-- | >>> OrdMap.toList (sureRecords [IR.mkDef "f" "f" (ELam ["x"] (ERecord [MkPair "a" (EVar "x"), MkPair "b" (EVar "x")] [FtFloat, FtFloat])), IR.mkDef "g" "g" (ERecord [MkPair "a" (EInt 1), MkPair "b" (EFloat 1.0)] [FtAny, FtFloat])])
-- | [MkPair "a,b" [1]]
sureRecords : List IR.Def -> Repr.FlatTags
sureRecords defs =
  OrdMap.fromList
    (List.keepIf
       (\p -> not (List.null (snd p)))
       (OrdMap.toList
          (List.foldl
             (\m (d : IR.Def) -> sureRecW m [d.body])
             OrdMap.empty
             defs)))

-- Facts
--------------------------------------------------------------------------------

-- | what is known of the definitions (none lent, no workers)
-- | >>> OrdMap.toList (factsOf [IR.mkDef "f" "f" (ELam ["x"] (EApp (EVar "x") [EInt 1])), IR.mkDef "n" "n" (EInt 1)]).arity
-- | [MkPair "f" 1]
factsOf : List IR.Def -> Facts
factsOf defs =
  { arity = CallArity.arities defs
  , bounce = bouncing defs
  , lazy = lazies defs
  , lent = OrdMap.empty
  , workers = OrdMap.empty
  , flat = OrdMap.empty
  , sure = OrdMap.empty
  , sureRecs = OrdMap.empty
  , tuples = OrdMap.empty
  , words = OrdMap.empty
  , tokens = noTokens
  }

-- | ... and the parameters lent
withLent : OrdMap.OrdMap String (List Int) -> Facts -> Facts
withLent lent f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the workers
withWorkers : Repr.Sigs -> Facts -> Facts
withWorkers ws f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = ws
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the tags' fields that may be flat, and those that are
withFlat : Repr.FlatTags -> Repr.FlatTags -> Facts -> Facts
withFlat fl su f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = fl
  , sure = su
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the records' fields that are flat, by shape
withSureRecs : Repr.FlatTags -> Facts -> Facts
withSureRecs su f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = su
  , tuples = f.tuples
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the functions giving back a tuple (heff.compile.cpr)
withTuples : OrdMap.OrdMap String Int -> Facts -> Facts
withTuples ts f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = ts
  , words = f.words
  , tokens = f.tokens
  }

-- | ... and the parameters every call gives a word
withWords : OrdMap.OrdMap String (List Int) -> Facts -> Facts
withWords ws f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = ws
  , tokens = f.tokens
  }

-- | ... and the functions given a cell
withTokens : Tokens -> Facts -> Facts
withTokens tk f =
  { arity = f.arity
  , bounce = f.bounce
  , lazy = f.lazy
  , lent = f.lent
  , workers = f.workers
  , flat = f.flat
  , sure = f.sure
  , sureRecs = f.sureRecs
  , tuples = f.tuples
  , words = f.words
  , tokens = tk
  }

-- (the tags' fields flat in every tag of them the program builds, of the
-- tags not `others`)
tagsOnlyHere : List String -> Repr.FlatTags -> Repr.FlatTags
tagsOnlyHere others sure =
  OrdMap.fromList
    (List.keepIf
       (\p -> not (List.elem (fst p) others))
       (OrdMap.toList sure))

-- (the shapes' fields flat in every record of them the program builds,
-- of the shapes no label of `lbls` is of)
shapesOnlyHere : List String -> Repr.FlatTags -> Repr.FlatTags
shapesOnlyHere lbls sure =
  OrdMap.fromList
    (List.keepIf
       (\p ->
          not
            (List.any
               (\l -> contains ("," ^ l ^ ",") ("," ^ fst p ^ ","))
               lbls))
       (OrdMap.toList sure))

-- | the fields flat in every value the program builds (`sure`,
-- | `sureRecs`) where code not the program's builds values too: of the
-- | tags not `tags` and the shapes no label of `lbls` is of -- what the
-- | runtime or a provider names, it may build, its fields `V`s
sureOnlyHere : List String -> List String -> Facts -> Facts
sureOnlyHere tags lbls f =
  withSureRecs
    (shapesOnlyHere lbls f.sureRecs)
    (withFlat f.flat (tagsOnlyHere tags f.sure) f)

-- | what the walk knows of the program (heff.compile.repr)
knowOf : Facts -> Repr.Know
knowOf f = { sigs = f.workers, flat = f.flat }

-- | the parameters of `key` every call gives a word
wordsOf : Facts -> String -> List Int
wordsOf f key = fromMaybe Nil (OrdMap.lookup f.words key)
