-- The compiler, run: a Node.js program (`heff compile src/heff/main.hf
-- OUT.mjs --name main --backend=node`), `heff` itself -- compiled by itself, from the seed
-- boot/heff.mjs (scripts/build.mjs).  Besides the commands of
-- `usage`, `dump-core FILE...` reads the files given in dependency
-- order, elaborates them, and prints every definition's stored core, and
-- `dump-eval FILE` prints what each definition of FILE evaluates to (the
-- interpreter's values, which the tests hold the backend to).

import co
import heff.diagnostic as Dg
import heff.driver as Dr
import heff.effect as Ef
import heff.emit as Em
import heff.fixity as F
import heff.format as Fm
import heff.load as L
import heff.project as Pr
import heff.lsp as Lsp
import heff.query as Q
import heff.report as Rp
import heff.rpc as Rpc
import heff.session as Se
import heff.toplevel as T
import fs
import path as P
import prelude
import process
import stdio

world : HFunctor
world = stdio <+> process <+> fs <+> Rp.report <+> Rpc.rpc

-- the program asks for its worlds' evidence: every computation of it is
-- a `Heff`, whose operations find the evidence in scope -- given once,
-- by `main`, below
type Heff a =
  {{io : stdio <: world}}
  -> {{sys : process <: world}}
  -> {{disk : fs <: world}}
  -> {{rep : Rp.report <: world}}
  -> {{wire : Rpc.rpc <: world}}
  -> Co world a

-- | the style of the paths of the platform heff runs on
styleNow : Heff P.Style
styleNow = do
  p <- platform
  pure (P.styleOf p)

-- | where the standard library is: `HEFF_LIB`, else the `lib/` of the
-- | repository the compiler is built in (it is `output/heff.mjs` or
-- | `boot/heff.mjs` there)
libDir : Heff String
libDir = do
  v <- getEnv "HEFF_LIB"
  case v of
    Just lib -> pure lib
    Nothing -> do
      st <- styleNow
      self <- programPath
      pure (P.join st (P.dirname st (P.dirname st self)) "lib")

-- | where packages are fetched to: `HEFF_MODCACHE`, else
-- | `~/.cache/heff/mod`
modDir : Heff String
modDir = do
  v <- getEnv "HEFF_MODCACHE"
  home <- getEnv "HOME"
  profile <- getEnv "USERPROFILE"
  st <- styleNow
  pure (case v of
    Just d -> d
    Nothing ->
      P.join
        st
        (P.join st (fromMaybe (fromMaybe "." profile) home) ".cache")
        (P.join st "heff" "mod"))

-- | the library, the packages fetched, and the style of the platform's
-- | paths
hostNow : Heff L.Host
hostNow = do
  lib <- libDir
  mod <- modDir
  st <- styleNow
  pure { lib = lib, mod = mod, style = st }

-- | the version of heff running: its package.json's, beside `output/`
-- | (npm writes `"version": "a.b.c"`)
ownVersion : Heff (Maybe String)
ownVersion = do
  st <- styleNow
  self <- programPath
  json <- readFile (P.join st (P.dirname st (P.dirname st self)) "package.json")
  pure (case json of
    Just text -> case split "\"version\"" text of
      Cons _ (Cons rest _) -> case split "\"" rest of
        Cons colon (Cons v _) ->
          if strEq (trim colon) ":" then Just v else Nothing
        _ -> Nothing
      _ -> Nothing
    Nothing -> Nothing)

-- | what is wrong with the heff a project is for, if anything: this heff
-- | is `running`
-- | what is wrong with the heff `who` is for, `wanted`, if anything:
-- | this heff is `running`
heffVersions : String
             -> String
             -> String
             -> Maybe (List Int)
             -> Maybe (List Int)
             -> Maybe String
heffVersions who wanted running (Just w) (Just r) =
  if Pr.compatible w r then Nothing
  else Just
      (who
       ++ " is for heff "
       ++ wanted
       ++ (if strEq (strSlice wanted 0 2) "0." then " (the same 0.x)" else "")
       ++ ", and this heff is "
       ++ running)
heffVersions who wanted running _ _ = Nothing

heffFor : Maybe String -> String -> String -> Maybe String
heffFor (Just running) who wanted =
  heffVersions who wanted running (Pr.version wanted) (Pr.version running)
heffFor Nothing who wanted = Nothing

-- (a package, as said where it is wrong)
whoOf : L.Pkg -> String
whoOf k =
  if strEq k.own "" then "package.hf: the project" else "the package " ++ k.path

-- (what is wrong with the heff each package is for: the project, then
-- those it requires)
heffErrors : Maybe String -> List L.Pkg -> List String
heffErrors running Nil = Nil
heffErrors running (Cons project deps) =
  concatMap
    (\(k : L.Pkg) -> case heffFor running (whoOf k) k.heff of
     Just why -> [why]
     Nothing -> Nil)
    (if strEq project.heff "" then deps else Cons project deps)

withError : L.Loaded -> String -> L.Loaded
withError l e =
  { sources = l.sources
  , errors = Cons e l.errors
  , paths = l.paths
  , package = l.package
  , packages = l.packages
  }

-- | FILE and its import closure, loaded from FILE's project, which must
-- | be for this heff
load : String -> Heff L.Loaded
load file = do
  h <- hostNow
  l <- L.loadProgram h file
  running <- ownVersion
  pure (foldl withError l (heffErrors running l.packages))

readAll : List String -> Heff (List Dr.Source)
readAll Nil = pure Nil
readAll (Cons path rest) = do
  mSrc <- readFile path
  case mSrc of
    Nothing -> do
      printErr ("cannot read " ++ path)
      exit 1
      pure Nil
    Just src -> do
      st <- styleNow
      more <- readAll rest
      pure
          (Cons
             { module = L.moduleOf (L.here st) path
             , path = path
             , source = src
             , renames = Nil
             }
             more)

printLines : List String -> Heff Unit
printLines Nil = pure MkUnit
printLines (Cons l rest) = do
  print l
  printLines rest

printDefs : Dr.Checked -> List String -> Heff Unit
printDefs c Nil = pure MkUnit
printDefs c (Cons k rest) = do
  printLines (Dr.dumpLines c k)
  printDefs c rest

printErrs : String -> List String -> Int -> Heff Int
printErrs m Nil n = pure n
printErrs m (Cons l rest) n = do
  printErr (m ++ ": " ++ l)
  printErrs m rest (n + 1)

printAll : List Dr.Checked -> Int -> Heff Int
printAll Nil bad = pure bad
printAll (Cons c rest) bad = do
  printDefs c (Dr.moduleKeys c)
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  printAll rest (bad + n)

-- | check every file given, each after what it imports, and print the
-- | stored core of every definition
selfcheck : List String -> Heff Unit
selfcheck paths = do
  sources <- readAll paths
  bad <- printAll (Dr.checkProgram sources) 0
  if bad == 0 then pure MkUnit else exit 1

-- (the errors said, the count comes back)
diagCount : List Dr.Checked -> Heff Int
diagCount Nil = pure 0
diagCount (Cons c rest) = do
  n <- printErrs (Dr.moduleName c) (Dr.diagLines c) 0
  m <- diagCount rest
  pure (n + m)

elemStrM : String -> List String -> Bool
elemStrM x Nil = False
elemStrM x (Cons y rest) = if strEq x y then True else elemStrM x rest

nubStrGo : List String -> List String -> List String
nubStrGo seen Nil = Nil
nubStrGo seen (Cons x rest) =
  if elemStrM x seen then nubStrGo seen rest
  else Cons x (nubStrGo (Cons x seen) rest)

nubStrM : List String -> List String
nubStrM xs = nubStrGo Nil xs

-- the provider of a module, M.provider.js beside the M.hf it was loaded
-- from
pathOfModule : List Dr.Source -> String -> Maybe String
pathOfModule Nil m = Nothing
pathOfModule (Cons s rest) m =
  if strEq s.module m then Just s.path else pathOfModule rest m

readProviderAt : List Dr.Source -> String -> Heff (Maybe Em.Provider)
readProviderAt sources m = case pathOfModule sources m of
  Nothing -> pure Nothing
  Just path -> do
    text <- readFile (L.dropHf path ++ ".provider.js")
    pure (case text of
      Just t -> Just { module = m, text = t }
      Nothing -> Nothing)

readProviders : List Dr.Source -> List String -> Heff (List Em.Provider)
readProviders sources Nil = pure Nil
readProviders sources (Cons m rest) = do
  p <- readProviderAt sources m
  ps <- readProviders sources rest
  pure (case p of
    Just pr -> Cons pr ps
    Nothing -> ps)

-- (a provider without `$host` lives anywhere; `--backend=node`'s is "node")
forHost : String -> Em.Provider -> Bool
forHost host p = case Em.hostOf p.text of
  Nothing -> True
  Just h -> strEq h host

providesLeaf : List Em.Provider -> String -> Bool
providesLeaf Nil k = False
providesLeaf (Cons p rest) k =
  if strEq p.module (Ef.moduleOfKey k)
  && elemStrM (Ef.nameOfKey k) (Em.exportedNames p.text)
    then True
  else providesLeaf rest k

emitErrs : List String -> Heff Unit
emitErrs Nil = pure MkUnit
emitErrs (Cons e rest) = do
  printErr ("heff: not compiled: " ++ e)
  emitErrs rest

putFileDiags : List Dr.Checked -> Heff Unit
putFileDiags Nil = pure MkUnit
putFileDiags (Cons c rest) = do
  if null c.diags then pure MkUnit
    else writeErr (Dg.renderFileDiags c.path c.source c.diags)
  putFileDiags rest

anyErrors : List Dr.Checked -> Bool
anyErrors cs = any (\(c : Dr.Checked) -> not (null (Dr.errorsIn c))) cs

-- (`done`: what follows the written program)
writeOut : String -> Co world Unit -> Em.Output -> Heff Unit
writeOut outPath done o = do
  emitErrs o.errors
  if null o.errors
      then do
        ok <- writeFile outPath o.source
        if ok then done
          else do
            printErr ("cannot write " ++ outPath)
            exit 1
    else exit 1

compileFound : String
             -> String
             -> Maybe String
             -> String
             -> Co world Unit
             -> Dr.Checked
             -> List Em.Provider
             -> Heff Unit
compileFound host file name outPath done c available = case Dr.findRunnable
    (filter (\k -> providesLeaf available k) (Dr.candidateLeaves c))
    c
    name of
  Left why -> do
    printErr ("heff: " ++ file ++ ": " ++ why)
    exit 1
  Right r ->
    writeOut
      outPath
      done
      (Em.compileProgram host available c.top.globals r.key r.effect)

-- (a computation whose effects all have providers for this host: each
-- world's algebra is bundled in from its module's M.provider.js)
compileLast : List Dr.Source
            -> String
            -> String
            -> Maybe String
            -> String
            -> Co world Unit
            -> List Dr.Checked
            -> Heff Unit
compileLast sources host file name outPath done cs = case Dr.lastChecked cs of
  Nothing -> do
    printErr "no files given"
    exit 1
  Just c -> do
    found <-
      readProviders
        sources
        (nubStrM (map (\k -> Ef.moduleOfKey k) (Dr.candidateLeaves c)))
    compileFound
        host
        file
        name
        outPath
        done
        c
        (filter (\p -> forHost host p) found)

compileDiags : List Dr.Source
             -> String
             -> String
             -> Maybe String
             -> String
             -> Co world Unit
             -> Bool
             -> List Dr.Checked
             -> Heff Unit
compileDiags sources host file name outPath done badL cs = do
  putFileDiags cs
  if badL || anyErrors cs then exit 1
    else compileLast sources host file name outPath done cs

-- | compile the computation `name` of FILE to a program of `host`:
-- | FILE's import closure loaded with the compiler's own loader
compileCmd : String -> Maybe String -> String -> String -> String -> Heff Unit
compileCmd host name outPath how file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  compileDiags
      l.sources
      host
      file
      name
      outPath
      (print ("wrote " ++ outPath ++ ": " ++ how))
      (badL > 0)
      cs

nodeCmd : Maybe String -> String -> String -> Heff Unit
nodeCmd name outPath file =
  compileCmd
    "node"
    name
    outPath
    ("run it with `node " ++ outPath ++ " ARGS...`")
    file

appCmd : Maybe String -> String -> String -> Heff Unit
appCmd name outPath file =
  compileCmd
    "page"
    name
    outPath
    "load it in a page with <script src=\"...\"> (it imports nothing: it opens from file:// too)"
    file

runDir : L.Paths -> String
runDir paths = L.under paths paths.root ".heff/run"

-- (FILE's path, its separators underscores)
runPath : L.Paths -> String -> String
runPath paths file =
  L.under
    paths
    (runDir paths)
    (joinWith "_" (P.components paths.style file) ++ ".mjs")

-- | run FILE's `main` with ARGS: compiled for Node.js to `.heff/run/`,
-- | which runs in heff's place
runCmd : String -> List String -> Heff Unit
runCmd file progArgs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  ok <- mkDir (runDir l.paths)
  compileDiags
      l.sources
      "node"
      file
      (Just "main")
      (runPath l.paths file)
      (exec "node" (runPath l.paths file :: progArgs))
      (badL > 0)
      cs

ownExport : Dr.Own -> Em.Export
ownExport o = Em.mkExport o.name o.key

compileJsOut : String -> Bool -> Em.Output -> Heff Unit
compileJsOut outPath bad o = do
  ok <- writeFile outPath o.source
  emitErrs o.errors
  if ok && not bad && null o.errors then pure MkUnit else exit 1

compileJsDiags : String -> String -> Bool -> List Dr.Checked -> Heff Unit
compileJsDiags file outPath badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      compileJsOut
        outPath
        (badL || anyErrors cs)
        (Em.compileJs c.top.globals (map (\o -> ownExport o) c.own))

-- | an ES module of FILE and what it imports
compileJsCmd : String -> String -> Heff Unit
compileJsCmd file outPath = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  compileJsDiags file outPath (badL > 0) cs

-- | how `heff compile` was called: FILE, OUT, `--name`, `--backend`
type CompileOpts =
  { file : String, outPath : String, name : Maybe String, backend : String }

-- (the words given, the files read backwards; a flag's value after `=`
-- or as the next word)
compileOpts : List String
            -> Maybe String
            -> Maybe String
            -> List String
            -> Either String CompileOpts
compileOpts files name backend Nil = case backend of
  Nothing -> Left "which backend? --backend=esm, page or node"
  Just b -> case reverse files of
    file :: outPath :: Nil ->
      Right { file = file, outPath = outPath, name = name, backend = b }
    _ -> Left "FILE OUT [--name NAME] --backend=MODE"
compileOpts files name backend ("--name" :: n :: rest) =
  compileOpts files (Just n) backend rest
compileOpts files name backend ("--backend" :: b :: rest) =
  compileOpts files name (Just b) rest
compileOpts files name backend (w :: rest) =
  if startsWith "--name=" w
    then compileOpts files (Just (strSlice w 7 (strLength w))) backend rest
  else if startsWith "--backend=" w
    then compileOpts files name (Just (strSlice w 10 (strLength w))) rest
  else if startsWith "--" w then Left ("no such flag: " ++ w)
  else compileOpts (w :: files) name backend rest

-- | `heff compile`, by its backend
compileTo : CompileOpts -> Heff Unit
compileTo o =
  if strEq o.backend "node" then nodeCmd o.name o.outPath o.file
  else if strEq o.backend "page" then appCmd o.name o.outPath o.file
  else if strEq o.backend "esm"
    then case o.name of
      Nothing -> compileJsCmd o.file o.outPath
      Just n -> do
        printErr
            "heff compile: an ES module runs nothing: no --name with --backend=esm"
        exit 1
  else do
    printErr ("heff compile: no backend " ++ o.backend ++ ": esm, page or node")
    exit 1

printEvals : List Dr.Evaluated -> Heff Unit
printEvals Nil = pure MkUnit
printEvals (Cons d rest) = do
  print (d.name ++ " = " ++ d.value)
  printEvals rest

evalDiags : Bool -> List Dr.Checked -> Heff Unit
evalDiags badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      printEvals (Dr.evaluate c)
      if badL || anyErrors cs then exit 1 else pure MkUnit

-- | print what each definition of FILE evaluates to
evalCmd : String -> Heff Unit
evalCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  evalDiags (badL > 0) cs

promoteDiags : String -> Bool -> List Dr.Checked -> Heff Unit
promoteDiags file badL cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      if badL || anyErrors cs then exit 1
      else do
        ok <- writeFile file (Dr.promote c)
        if ok then pure MkUnit else exit 1

-- | write each watch's value under it as its expectation
promoteCmd : String -> Heff Unit
promoteCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  promoteDiags file (badL > 0) cs

type TestRes = { total : Int, failed : Int, ok : Bool }

failLine : String -> Dr.TestReport -> Rp.Mismatch -> String
failLine f r m =
  "FAIL "
  ++ f
  ++ (case r.owner of
      Just n -> " (" ++ n ++ ")"
      Nothing -> "")
  ++ ": "
  ++ r.watch.expr
  ++ "\n  expected "
  ++ m.expected
  ++ "\n  but got  "
  ++ m.got
  ++ "\n  diff     "
  ++ m.diff

-- (each expectation that does not hold, and what differs, in colour on
-- a terminal)
printFails : String -> Bool -> List Dr.TestReport -> Heff Unit
printFails f color Nil = pure MkUnit
printFails f color (Cons r rest) = do
  m <- Rp.mismatch color (fromMaybe "" r.watch.expected) r.watch.value
  print (failLine f r m)
  printFails f color rest

badReports : List Dr.TestReport -> List Dr.TestReport
badReports rs = filter (\(r : Dr.TestReport) -> not r.watch.holds) rs

testReport : String -> Int -> List Dr.TestReport -> Heff TestRes
testReport f bad ts = do
  color <- Rp.useColor
  printFails f color (badReports ts)
  print
      ((if null (badReports ts) && bad == 0 then "ok    " else "FAIL  ")
       ++ f
       ++ "  "
       ++ showInt (length ts - length (badReports ts))
       ++ "/"
       ++ showInt (length ts))
  pure { total = length ts, failed = length (badReports ts), ok = bad == 0 }

testOneC : String -> Int -> List Dr.Checked -> Heff TestRes
testOneC f bad0 cs = do
  bad <- diagCount cs
  case Dr.lastChecked cs of
    Nothing -> do
      print ("FAIL  " ++ f ++ "  0/0")
      pure { total = 0, failed = 0, ok = False }
    Just c -> testReport f (bad0 + bad) (Dr.testFile c)

testOneF : String -> Heff TestRes
testOneF f = do
  l <- load f
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  testOneC f badL cs

-- | check the watches' expectations of every file given
testCmd : List String -> Int -> Int -> Bool -> Heff Unit
testCmd Nil total failed anyBad = do
  print
      (showInt (total - failed) ++ "/" ++ showInt total ++ " expectations hold")
  if failed > 0 || anyBad then exit 1 else pure MkUnit
testCmd (Cons f rest) total failed anyBad = do
  r <- testOneF f
  testCmd rest (total + r.total) (failed + r.failed) (anyBad || not r.ok)

checkLast : Bool -> List Dr.Checked -> Heff Unit
checkLast badLoad cs = do
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> do
      write (Dr.interface c)
      if badLoad || anyErrors cs then exit 1 else pure MkUnit

-- | elaborate FILE and what it imports; print its interface
checkCmd : String -> Heff Unit
checkCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  checkLast (badL > 0) cs

-- | what the name at each OFFSET of FILE resolved to, and its type: a
-- | line each, FILE checked once
typeAtCmd : String -> List String -> Heff Unit
typeAtCmd file offs = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c ->
      printLines
        (map
           (\off ->
              fromMaybe "nothing there" (case parseInt off of
              Just o -> Q.typeAt c o
              Nothing -> Nothing))
           offs)

-- | the elaboration trace of FILE, one line per event
explainCmd : String -> Heff Unit
explainCmd file = do
  l <- load file
  badL <- printErrs "heff" l.errors 0
  cs <- Se.cachedProgram l
  putFileDiags cs
  case Dr.lastChecked cs of
    Nothing -> exit 1
    Just c -> printLines (Q.explain c)

-- | a flag of a command, what it does, and its value (`Nothing`: it
-- | takes none; `Just Nil`: any word; else one of those)
type Flag = { flag : String, doc : String, value : Maybe (List String) }

-- | a command: how it is called, what it does, and what its words
-- | complete to (`files`: the files' suffix; `words`: the words it takes;
-- | `flags`)
type Command =
  { name : String
  , args : String
  , doc : String
  , files : String
  , words : List String
  , flags : List Flag
  }

cmd : String -> String -> String -> String -> Command
cmd name a doc files =
  { name = name, args = a, doc = doc, files = files, words = Nil, flags = Nil }

shells : List String
shells = ["fish", "bash", "zsh"]

commands : List Command
commands =
  [ cmd
    "check"
    "FILE"
    "elaborate FILE and what it imports; print its interface"
    ".hf"
  , cmd
    "run"
    "FILE [ARGS...]"
    "run FILE's main with ARGS, compiled for Node.js"
    ".hf"
  , cmd
    "test"
    "FILE..."
    "check the watches' expectations (the `-- ...` lines under them)"
    ".hf"
  , cmd
    "promote"
    "FILE"
    "write each watch's value under it as its expectation"
    ".hf"
  , { name = "compile"
    , args = "FILE OUT --backend=MODE [--name NAME]"
    , doc =
        "FILE as JavaScript, by MODE: esm (an ES module), page (a script running the app NAME in a page), node (a Node.js program running NAME)"
    , files = ".hf"
    , words = Nil
    , flags =
        [ { flag = "backend"
          , doc = "esm, page or node"
          , value = Just ["esm", "page", "node"]
          }
        , { flag = "name"
          , doc = "the computation run (page, node)"
          , value = Just Nil
          }
        ]
    }
  , cmd "explain" "FILE" "the elaboration trace" ".hf"
  , cmd
    "type-at"
    "FILE OFFSET..."
    "what the name at each OFFSET resolved to, and its type, a line each"
    ".hf"
  , { name = "fmt"
    , args = "[--check] FILE..."
    , doc = "format FILEs in place (--check: only say which are not formatted)"
    , files = ".hf"
    , words = Nil
    , flags =
        [ { flag = "check"
          , doc = "only say which are not formatted"
          , value = Nothing
          }
        ]
    }
  , cmd "init" "[DIR]" "a new project in DIR (here, without it)" ""
  , cmd
    "publish"
    "VERSION"
    "check the project, then tag it vVERSION and push the tag"
    ""
  , cmd
    "get"
    "[PATH[@VERSION]]"
    "fetch what the project requires, writing heff.sum; with PATH, require it (at VERSION, else its newest) first"
    ""
  , cmd "lsp" "" "a language server, on stdin/stdout" ""
  , { name = "completions"
    , args = "SHELL"
    , doc = "a completion script for SHELL: fish, bash or zsh"
    , files = ""
    , words = shells
    , flags = Nil
    }
  ]

spaces : Int -> String
spaces n = joinWith "" (replicate n " ")

commandHead : Command -> String
commandHead c = c.name ++ (if strEq c.args "" then "" else " " ++ c.args)

-- (the head, padded to 24 columns -- a space at least -- and its doc)
usageLine : Command -> String
usageLine c =
  "  "
  ++ commandHead c
  ++ spaces (max 1 (24 - strLength (commandHead c)))
  ++ c.doc

usage : String
usage =
  joinWith
    "\n"
    (Cons "usage: heff COMMAND FILE ..." (Cons "" (map usageLine commands)))

-- (a fish string: quoted, its quotes escaped)
fishQuote : String -> String
fishQuote x = "'" ++ joinWith "\\'" (split "'" x) ++ "'"

seenFrom : String -> String
seenFrom name =
  "complete -c heff -n '__fish_seen_subcommand_from " ++ name ++ "'"

fishFlag : Command -> Flag -> String
fishFlag c f =
  seenFrom c.name
  ++ " -l "
  ++ f.flag
  ++ (case f.value of
      Nothing -> ""
      Just Nil -> " -x"
      Just vs -> " -xa " ++ fishQuote (unwords vs))
  ++ " -d "
  ++ fishQuote f.doc

fishLines : Command -> List String
fishLines c =
  concatList
    (Cons
       ("complete -c heff -n __fish_use_subcommand -a "
        ++ c.name
        ++ " -d "
        ++ fishQuote c.doc)
       (if strEq c.files "" then Nil
        else [ seenFrom c.name
             ++ " -a '(__fish_complete_suffix "
             ++ c.files
             ++ ")'"
             ]))
    (concatList
       (if null c.words then Nil
        else [seenFrom c.name ++ " -a " ++ fishQuote (unwords c.words)])
       (map (\(f : Flag) -> fishFlag c f) c.flags))

fishCompletions : String
fishCompletions =
  joinWith
    "\n"
    (concatList
       [ "# heff: written by `heff completions fish`"
       , "complete -c heff -e"
       , "complete -c heff -f"
       ]
       (concatMap fishLines commands))
  ++ "\n"

-- (a POSIX shell's string: single-quoted, each quote closed, escaped and
-- opened again)
shQuote : String -> String
shQuote x = "'" ++ joinWith "'\\''" (split "'" x) ++ "'"

flagWords : Command -> List String
flagWords c = map (\(f : Flag) -> "--" ++ f.flag) c.flags

-- (after a flag that takes a value: its values, or nothing)
bashValueArm : Command -> Flag -> List String
bashValueArm c f = case f.value of
  Nothing -> Nil
  Just vs ->
    [ "    "
    ++ shQuote (c.name ++ " --" ++ f.flag)
    ++ ") COMPREPLY=($(compgen -W "
    ++ shQuote (unwords vs)
    ++ " -- \"$cur\")); return;;"
    ]

bashArm : Command -> String
bashArm c =
  "    "
  ++ c.name
  ++ ") COMPREPLY=($(compgen -W "
  ++ shQuote (unwords (concatList c.words (flagWords c)))
  ++ " -- \"$cur\"))"
  ++ (if strEq c.files "" then ""
      else "; COMPREPLY+=($(compgen -d -- \"$cur\") $(compgen -f -X "
        ++ shQuote ("!*" ++ c.files)
        ++ " -- \"$cur\"))")
  ++ ";;"

bashCompletions : String
bashCompletions =
  joinWith
    "\n"
    (concatList
       [ "# heff: written by `heff completions bash`"
       , "_heff() {"
       , "  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}"
       , "  if [ \"$COMP_CWORD\" -eq 1 ]; then"
       , "    COMPREPLY=($(compgen -W "
       ++ shQuote (unwords (map (\(c : Command) -> c.name) commands))
       ++ " -- \"$cur\"))"
       , "    return"
       , "  fi"
       , "  case \"${COMP_WORDS[1]} $prev\" in"
       ]
       (concatList
          (concatMap
             (\(c : Command) ->
                concatMap (\(f : Flag) -> bashValueArm c f) c.flags)
             commands)
          (concatList
             (Cons "  esac" (Cons "  case \"${COMP_WORDS[1]}\" in" Nil))
             (concatList
                (map bashArm commands)
                ["  esac", "}", "complete -o filenames -F _heff heff"]))))
  ++ "\n"

zshFlag : Flag -> String
zshFlag f =
  shQuote
    ("--"
     ++ f.flag
     ++ (case f.value of
         Nothing -> "[" ++ f.doc ++ "]"
         Just Nil -> "=[" ++ f.doc ++ "]:value: "
         Just vs -> "=[" ++ f.doc ++ "]:value:(" ++ unwords vs ++ ")"))

zshArm : Command -> String
zshArm c =
  "    "
  ++ c.name
  ++ ") _arguments"
  ++ joinWith "" (map (\(f : Flag) -> " " ++ zshFlag f) c.flags)
  ++ (if null c.words then ""
      else " " ++ shQuote ("1:value:(" ++ unwords c.words ++ ")"))
  ++ (if strEq c.files "" then ""
      else " " ++ shQuote ("*:file:_files -g \"*" ++ c.files ++ "\""))
  ++ " ;;"

zshCompletions : String
zshCompletions =
  joinWith
    "\n"
    (concatList
       [ "#compdef heff"
       , "# heff: written by `heff completions zsh`"
       , "_heff() {"
       , "  local -a commands"
       , "  commands=("
       ]
       (concatList
          (map
             (\(c : Command) -> "    " ++ shQuote (c.name ++ ":" ++ c.doc))
             commands)
          (concatList
             [ "  )"
             , "  if (( CURRENT == 2 )); then"
             , "    _describe command commands"
             , "    return"
             , "  fi"
             , "  shift words"
             , "  (( CURRENT-- ))"
             , "  case $words[1] in"
             ]
             (concatList
                (map zshArm commands)
                [ "  esac"
                , "}"
                , "if [ \"$funcstack[1]\" = _heff ]; then _heff \"$@\"; else compdef _heff heff; fi"
                ]))))
  ++ "\n"

fmtSrc : Bool -> String -> String -> F.Fixities -> Heff Int
fmtSrc checkOnly f src fix = case Fm.formatIn fix src of
  Left why -> do
    printErr ("heff: " ++ f ++ " not formatted: " ++ why)
    pure 1
  Right out ->
    if strEq out src then pure 0
    else if checkOnly
      then do
        print f
        pure 1
    else do
      ok <- writeFile f out
      pure 0

-- | 1 if the file is not formatted (with `--check`) or cannot be; its
-- | operators cut as the fixities of what it imports say
fmtOne : Bool -> String -> Heff Int
fmtOne checkOnly f = do
  mSrc <- readFile f
  case mSrc of
    Nothing -> do
      printErr ("heff: cannot read " ++ f)
      pure 1
    Just src -> do
      l <- load f
      fmtSrc checkOnly f src (Dr.fixitiesIn l.sources)

fmtAll : Bool -> List String -> Int -> Heff Int
fmtAll checkOnly Nil bad = pure bad
fmtAll checkOnly (Cons f rest) bad = do
  n <- fmtOne checkOnly f
  fmtAll checkOnly rest (bad + n)

-- | format FILEs in place; `--check`: only say which are not formatted
fmtCmd : List String -> Heff Unit
fmtCmd as = do
  bad <- case as of
    "--check" :: files -> fmtAll True files 0
    _ -> fmtAll False as 0
  if bad > 0 then exit 1 else pure MkUnit

-- (the `.hf` files under the paths, the directories walked; a name
-- starting with `.` passed over)
hfFilesGo : List String -> List String -> Heff (List String)
hfFilesGo Nil acc = pure (reverse acc)
hfFilesGo (Cons p rest) acc = do
  names <- readDir p
  case names of
    Just ns -> do
      st <- styleNow
      hfFilesGo
          (concatList
             (map
                (\n -> P.join st p n)
                (filter (\n -> not (startsWith "." n)) ns))
             rest)
          acc
    Nothing ->
      if endsWith ".hf" p then hfFilesGo rest (Cons p acc)
      else hfFilesGo rest acc

-- (the watches of the files, checked: how many hold, of how many, and
-- whether every file checked)
testAll : List String -> TestRes -> Heff TestRes
testAll Nil acc = pure acc
testAll (Cons f rest) acc = do
  r <- testOneF f
  testAll
      rest
      { total = acc.total + r.total
      , failed = acc.failed + r.failed
      , ok = acc.ok && r.ok
      }

publishFails : String -> Heff Unit
publishFails why = do
  printErr ("heff publish: " ++ why)
  exit 1

ranStatus : Ran -> Int
ranStatus r = r.status

ranOut : Ran -> String
ranOut r = r.out

ranErr : Ran -> String
ranErr r = r.err

-- (git, run: what is wrong if it fails)
gitOk : String -> List String -> Heff (Maybe String)
gitOk what as = do
  r <- run "git" as
  pure
      (if ranStatus r == 0 then Nothing
       else Just
           (what ++ ": git " ++ joinWith " " as ++ ": " ++ trim (ranErr r)))

publishTag : String -> Pr.Package -> Heff Unit
publishTag v pk = do
  tagged <- gitOk "not tagged" ["tag", "-a", "v" ++ v, "-m", "v" ++ v]
  case tagged of
    Just why -> publishFails why
    Nothing -> do
      pushed <- gitOk "tagged, not pushed" ["push", "origin", "v" ++ v]
      case pushed of
        Just why -> publishFails why
        Nothing ->
          print ("heff publish: " ++ pk.module ++ " " ++ v ++ ", tag v" ++ v)

publishTested : String -> Pr.Package -> TestRes -> Heff Unit
publishTested v pk r =
  if r.failed > 0 || not r.ok
    then publishFails
        (showInt r.failed
         ++ " of "
         ++ showInt r.total
         ++ " expectations do not hold, or a file does not check")
  else publishTag v pk

publishGit : String -> Pr.Package -> String -> Heff Unit
publishGit v pk src = do
  status <- run "git" ["status", "--porcelain"]
  tag <- run "git" ["rev-parse", "-q", "--verify", "refs/tags/v" ++ v]
  if not (ranStatus status == 0)
      then publishFails ("not in a git repository: " ++ trim (ranErr status))
    else if not (strEq (trim (ranOut status)) "")
      then publishFails "what is published is what is committed: commit first"
    else if ranStatus tag == 0
      then publishFails ("v" ++ v ++ " is tagged already")
    else do
      files <- hfFilesGo [src] Nil
      r <- testAll files { total = 0, failed = 0, ok = True }
      publishTested v pk r

publishChecked : String -> L.Loaded -> Pr.Package -> Heff Unit
publishChecked v l pk = case Pr.majorMismatch pk.module v of
  Just why -> publishFails (pk.module ++ ": " ++ why)
  Nothing -> do
    own <- L.ownDir l.paths (L.under l.paths l.paths.root "src")
    case own of
      Left why -> publishFails why
      Right _ -> publishGit v pk (L.under l.paths l.paths.root "src")

-- | publish the project, at the working directory, as version V: its
-- | package.hf a Package (lib/manifest.hf), its path's `/vN` its major,
-- | its src/ one directory, every file of it checked and its watches
-- | holding, all of it committed -- then tagged `vV`, the tag pushed
publishCmd : String -> Heff Unit
publishCmd v = case Pr.version v of
  Nothing -> publishFails ("`" ++ v ++ "` is no version: a.b.c")
  Just _ -> do
    here <- readFile "package.hf"
    case here of
      Nothing ->
        publishFails "no package.hf here: publish at the project's root"
      Just _ -> do
        l <- load "package.hf"
        badL <- printErrs "heff" l.errors 0
        cs <- Se.cachedProgram l
        putFileDiags cs
        case l.package of
          Nothing -> publishFails "package.hf does not read"
          Just pk ->
            if badL > 0 || anyErrors cs
              then publishFails "package.hf is no Package (lib/manifest.hf)"
            else publishChecked v l pk

-- | the project's name: DIR's, or (DIR being `.`) the working directory's
projectName : P.Style -> String -> Maybe String -> String
projectName st "." (Just pwd) = P.basename st pwd
projectName st dir _ = P.basename st dir

-- | the files of a new project NAME, for heff VERSION: what each is, and
-- | its text
projectFiles : String -> String -> List (Pair String String)
projectFiles name v =
  [ MkPair
    "package.hf"
    (joinWith
       "\n"
       [ "import manifest"
       , ""
       , "package : Package"
       , "package ="
       , "  { module = \"" ++ name ++ "\""
       , "  , heff = \"" ++ v ++ "\""
       , "  , require = []"
       , "  , replace = []"
       , "  }"
       , ""
       ])
  , MkPair ".gitignore" (joinWith "\n" [".heff/", ""])
  , MkPair
    ("src/" ++ name ++ "/main.hf")
    (joinWith
       "\n"
       [ "-- `heff test src/"
       ++ name
       ++ "/main.hf` checks the watches; `heff run src/"
       ++ name
       ++ "/main.hf` runs `main`."
       , ""
       , "import co"
       , "import prelude"
       , "import stdio"
       , ""
       , "greeting : String -> String"
       , "greeting name = \"Hello, \" ++ name ++ \"!\""
       , ""
       , "-- >>> greeting \"heff\""
       , "-- \"Hello, heff!\""
       , ""
       , "program : {{io : stdio <: stdio}} -> Co stdio Unit"
       , "program = print (greeting \"world\")"
       , ""
       , "main : Co stdio Unit"
       , "main = program (io := here stdio)"
       , ""
       ])
  ]

-- | the files of `projectFiles` that are there already in DIR
existing : String -> List (Pair String String) -> Heff (List String)
existing dir Nil = pure Nil
existing dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  there <- readFile (P.join st dir f)
  others <- existing dir rest
  case there of
    Just _ -> pure (Cons f others)
    Nothing -> pure others

-- (a `.hf` file as the formatter lays it out)
laidOut : String -> String -> String
laidOut f text =
  if endsWith ".hf" f
    then (case Fm.format text of
          Right out -> out
          Left _ -> text)
  else text

writeAll : String -> List (Pair String String) -> Heff Bool
writeAll dir Nil = pure True
writeAll dir (Cons (MkPair f text) rest) = do
  st <- styleNow
  made <- mkDir (P.dirname st (P.join st dir f))
  ok <- writeFile (P.join st dir f) (laidOut f text)
  if made && ok then writeAll dir rest
    else do
      printErr ("heff: cannot write " ++ P.join st dir f)
      pure False

-- | a new project in DIR: its package.hf, a .gitignore, and a module of
-- | its package, `src/NAME/main.hf`, NAME being DIR's; nothing is
-- | written over
initCmd : String -> Heff Unit
initCmd dir = do
  pwd <- getEnv "PWD"
  v <- ownVersion
  st <- styleNow
  name <- pure (projectName st dir pwd)
  files <- pure (projectFiles name (fromMaybe "0.1.0" v))
  there <- existing dir files
  if not (Pr.isName name)
      then do
        printErr
            ("heff: `"
             ++ name
             ++ "` cannot name a package: a lowercase letter, then letters, digits and `_`")
        exit 1
    else case there of
      Cons _ _ -> do
        printErr
            ("heff: "
             ++ dir
             ++ " has "
             ++ joinWith ", " there
             ++ " already; nothing written")
        exit 1
      Nil -> do
        ok <- writeAll dir files
        if ok
            then print
                ("heff: a new project in "
                 ++ dir
                 ++ "; `heff test src/"
                 ++ name
                 ++ "/main.hf` checks it")
          else exit 1

-- Fetching
--------------------------------------------------------------------------------

getFails : String -> Heff Unit
getFails why = do
  printErr ("heff get: " ++ why)
  exit 1

-- | where the package at `path` is fetched from
urlOf : String -> String
urlOf path = "https://" ++ Pr.repoOf path

-- | version `v` of the package at `path`, in the cache: fetched there
-- | (its tag cloned, its .git removed, made read-only, then the tree
-- | its tag is of written beside it) unless it is there already; the
-- | tree, or what is wrong
fetched : L.Paths -> String -> String -> Heff (Either String String)
fetched ps path v = do
  dir <- pure (L.cachedDir ps path v)
  hash <- readFile (dir ++ ".hash")
  case hash of
    Just h -> pure (Right (trim h))
    Nothing -> do
      _ <- remove dir
      _ <- mkDir (P.dirname ps.style dir)
      cloned <-
        run
          "git"
          [ "-c"
          , "advice.detachedHead=false"
          , "clone"
          , "--quiet"
          , "--depth"
          , "1"
          , "--branch"
          , "v" ++ v
          , urlOf path
          , dir
          ]
      if not (ranStatus cloned == 0)
          then do
            _ <- remove dir
            pure
                (Left
                   ("cannot fetch "
                    ++ path
                    ++ " "
                    ++ v
                    ++ " (tag v"
                    ++ v
                    ++ " of "
                    ++ urlOf path
                    ++ "): "
                    ++ trim (ranErr cloned)))
        else do
          tree <- run "git" ["-C", dir, "rev-parse", "HEAD^{tree}"]
          _ <- remove (P.join ps.style dir ".git")
          sealed <- readOnly dir
          h <- pure ("tree:" ++ trim (ranOut tree))
          ok <- writeFile (dir ++ ".hash") (h ++ "\n")
          if ranStatus tree == 0 && sealed && ok
              then do
                print ("heff get: fetched " ++ path ++ " " ++ v)
                pure (Right h)
            else pure
                (Left ("cannot keep " ++ path ++ " " ++ v ++ " in " ++ dir))

-- | the package.hf of version `v` of `path`, required by `by`, fetched
-- | (unless the project replaces it); its tree must be what heff.sum
-- | said, if it said one
fetchedPkg : L.Paths
           -> Pr.Package
           -> List Pr.Sum
           -> String
           -> String
           -> String
           -> Heff (Either String Pr.Package)
fetchedPkg ps root sums by path v = case L.replacedDir root path of
  Just d -> L.readPkgAt ps (L.under ps ps.root d) path
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why ->
        pure (Left (by ++ " requires " ++ path ++ " " ++ v ++ ": " ++ why))
      Right h -> case Pr.sumOf sums path v of
        Just want ->
          if strEq h want then L.readPkgAt ps (L.cachedDir ps path v) path
          else pure
              (Left
                 (path
                  ++ " "
                  ++ v
                  ++ " is "
                  ++ h
                  ++ ", and heff.sum says "
                  ++ want
                  ++ ": its tag has been moved"))
        Nothing -> L.readPkgAt ps (L.cachedDir ps path v) path

-- (the trees of the versions fetched, as heff.sum's lines)
sumsOf : L.Paths -> Pr.Package -> List L.Visit -> Heff (List Pr.Sum)
sumsOf ps root Nil = pure Nil
sumsOf ps root (Cons x rest) = do
  others <- sumsOf ps root rest
  h <- readFile (L.cachedDir ps x.path x.version ++ ".hash")
  pure (case L.replacedDir root x.path of
    Just _ -> others
    Nothing -> case h of
      Just t ->
        Cons { path = x.path, version = x.version, hash = trim t } others
      Nothing -> others)

-- | the newest version tagged in the repository of `path` that it is
-- | the path of (its major), or what is wrong
newestTag : String -> Heff (Either String String)
newestTag path = do
  r <- run "git" ["ls-remote", "--tags", "--refs", urlOf path]
  pure
      (if not (ranStatus r == 0)
         then Left
             ("cannot list the tags of "
              ++ urlOf path
              ++ ": "
              ++ trim (ranErr r))
       else case foldl
           (\(best : Maybe String) (line : String) -> case split
              "refs/tags/v"
              line of
            Cons _ (Cons v Nil) -> case Pr.version (trim v) of
              Just _ -> case Pr.majorMismatch path (trim v) of
                Nothing -> case best of
                  Just b -> if Pr.newer (trim v) b then Just (trim v) else best
                  Nothing -> Just (trim v)
                Just _ -> best
              Nothing -> best
            _ -> best)
           Nothing
           (lines (ranOut r)) of
         Just v -> Right v
         Nothing ->
           Left
             ("no tag of "
              ++ urlOf path
              ++ " is a version of "
              ++ path
              ++ " (vA.B.C, its major "
              ++ (if Pr.isMajorPart (Pr.lastPart path)
                    then "that of /" ++ Pr.lastPart path
                  else "0 or 1")
              ++ ")"))

-- | PATH@VERSION, PATH: the path, and the version (Nothing: the newest)
specOf : String -> Pair String (Maybe String)
specOf spec = case split "@" spec of
  Cons path (Cons v Nil) -> MkPair path (Just v)
  _ -> MkPair spec Nothing

-- (`r`, of version `v` if it is of `path`)
retarget : String -> String -> Pr.Require -> Pr.Require
retarget path v r =
  if strEq r.path path then { name = r.name, path = path, version = v } else r

-- | the project `pk`, requiring version `v` of `path`: in place of the
-- | version it required, else by the name the package's src/ gives it
requiring : Pr.Package -> String -> String -> String -> Pr.Package
requiring pk name path v =
  { module = pk.module
  , heff = pk.heff
  , require =
      if any (\(r : Pr.Require) -> strEq r.path path) pk.require
        then map (retarget path v) pk.require
      else concatList pk.require [{ name = name, path = path, version = v }]
  , replace = pk.replace
  }

-- | write the project's package.hf, requiring version `v` of `path`
-- | (fetched, to know its name)
getRequire : L.Paths -> String -> Pr.Package -> String -> String -> Heff Bool
getRequire ps text pk path v = case Pr.majorMismatch path v of
  Just why -> do
    getFails (path ++ ": " ++ why)
    pure False
  Nothing -> do
    got <- fetched ps path v
    case got of
      Left why -> do
        getFails why
        pure False
      Right _ -> do
        own <- L.ownDir ps (P.join ps.style (L.cachedDir ps path v) "src")
        case own of
          Left why -> do
            getFails why
            pure False
          Right name ->
            if not (any (\(r : Pr.Require) -> strEq r.path path) pk.require)
            && any (\(r : Pr.Require) -> strEq r.name name) pk.require
              then do
                getFails
                    ("`"
                     ++ name
                     ++ "` is required already: add "
                     ++ path
                     ++ " to package.hf by another name")
                pure False
            else do
              ok <-
                writeFile
                  "package.hf"
                  (laidOut
                     "package.hf"
                     (Pr.withPackage text (requiring pk name path v)))
              if ok
                  then do
                    print ("heff get: package.hf requires " ++ path ++ " " ++ v)
                    pure True
                else do
                  getFails "cannot write package.hf"
                  pure False

-- | fetch every version the project's package.hf reaches, then write
-- | heff.sum, and load the project's packages, as a program would
getAll : Heff Unit
getAll = do
  h <- hostNow
  ps <- L.pathsFor h "package.hf"
  text <- readFile "package.hf"
  case Pr.readPackage (fromMaybe "" text) of
    Right root -> do
      old <- L.readSumAt ps
      case old of
        Left why -> getFails why
        Right sums -> do
          reached <-
            L.versionsOf (\by path v -> fetchedPkg ps root sums by path v) root
          news <- sumsOf ps root (fst reached)
          wrote <-
            if strEq (Pr.showSum news) "" then pure True
            else writeFile "heff.sum" (Pr.showSum news)
          bad <- printErrs "heff get" (snd reached) 0
          if bad > 0 then exit 1
            else if not wrote then getFails "cannot write heff.sum"
            else do
              l <- load "package.hf"
              badL <- printErrs "heff get" l.errors 0
              if badL > 0 then exit 1
                else print
                    ("heff get: "
                     ++ showInt (length (L.selected (fst reached)))
                     ++ " packages, heff.sum written")
    _ -> getFails "package.hf does not read: get at the project's root"

-- | fetch what the project requires, writing heff.sum; with PATH, first
-- | require it, at VERSION, else its newest
getCmd : Maybe String -> Heff Unit
getCmd spec = do
  text <- readFile "package.hf"
  case text of
    Nothing -> getFails "no package.hf here: get at the project's root"
    Just t -> case Pr.readPackage t of
      Left _ -> getFails "package.hf does not read"
      Right pk -> case spec of
        Nothing -> getAll
        Just s -> do
          h <- hostNow
          ps <- L.pathsFor h "package.hf"
          v <- case snd (specOf s) of
            Just v -> pure (Right v)
            Nothing -> newestTag (fst (specOf s))
          case v of
            Left why -> getFails why
            Right ver -> case Pr.version ver of
              Nothing -> getFails ("`" ++ ver ++ "` is no version: a.b.c")
              Just _ -> do
                ok <- getRequire ps t pk (fst (specOf s)) ver
                if ok then getAll else pure MkUnit

-- | the compiler's door: the commands of `usage`, and `dump-core
-- | FILE...`, which checks the files given (in dependency order) and
-- | prints their stored core, and `dump-eval FILE`
program : Heff Unit
program = do
  as <- args
  case as of
    "compile" :: flags -> case compileOpts Nil Nothing Nothing flags of
      Left why -> do
        printErr ("heff compile: " ++ why)
        exit 1
      Right o -> compileTo o
    "check" :: file :: Nil -> checkCmd file
    "run" :: file :: progArgs -> runCmd file progArgs
    "dump-eval" :: file :: Nil -> evalCmd file
    "promote" :: file :: Nil -> promoteCmd file
    "type-at" :: file :: off :: offs -> typeAtCmd file (off :: offs)
    "explain" :: file :: Nil -> explainCmd file
    "test" :: f :: files -> testCmd (f :: files) 0 0 False
    "fmt" :: f :: files -> fmtCmd (f :: files)
    "completions" :: "fish" :: Nil -> write fishCompletions
    "completions" :: "bash" :: Nil -> write bashCompletions
    "completions" :: "zsh" :: Nil -> write zshCompletions
    "dump-core" :: files -> selfcheck files
    "init" :: Nil -> initCmd "."
    "publish" :: v :: Nil -> publishCmd v
    "get" :: Nil -> getCmd Nothing
    "get" :: spec :: Nil -> getCmd (Just spec)
    "init" :: dir :: Nil -> initCmd dir
    -- (clients add flags, `--stdio` say: stdin/stdout is all there is)
    "lsp" :: flags ->
      if all (\x -> startsWith "--" x) flags
        then do
          h <- hostNow
          Lsp.serve h
      else do
        printErr usage
        exit 1
    Nil -> print usage
    "help" :: Nil -> print usage
    -- (on stderr: what reads the output, a shell's completion, say, does
    -- not take it for an answer)
    _ -> do
      printErr usage
      exit 1

-- | where the world is: each sub-effect's evidence, given
main : Co world Unit
main =
  program
    (io := \p -> InL (InL (InL (InL p))))
    (sys := \p -> InL (InL (InL (InR p))))
    (disk := \p -> InL (InL (InR p)))
    (rep := \p -> InL (InR p))
    (wire := \p -> InR p)
