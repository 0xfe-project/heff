-- Reading the stream of tokens `heff.serial` writes, each token followed
-- by one space: a decoder reads from a position on, and says what it
-- read and where it ended, or `Nothing` where what is there is not what
-- it reads.  Decoders are put in sequence by `do` (`bind` is theirs),
-- each reading from where the one before ended, and the first that does
-- not read gives the whole reading up.

import heff.surface as Su

-- | what a decoder read, and where it ended
type Got a = Pair a Int

-- | a decoder: from a stream and a position in it
type Dec a = String -> Int -> Maybe (Got a)

-- | `x` read, the stream not looked at
pure : {a : Type} -> a -> Dec a
pure x = \s i -> Just (MkPair x i)

-- | the reading given up
fail : {a : Type} -> Dec a
fail = \s i -> Nothing

-- (what was read, given to what reads after it, from where it ended)
next : {a b : Type} -> (a -> Dec b) -> String -> Maybe (Got a) -> Maybe (Got b)
next f s (Just (MkPair x j)) = f x s j
next f s Nothing = Nothing

-- `do` is this: what `m` reads, then what `f` of it reads
bind : {a b : Type} -> Dec a -> (a -> Dec b) -> Dec b
bind m f = \s i -> next f s (m s i)

-- | the reading given up where the condition does not hold
guard : Bool -> Dec Unit
guard True = pure MkUnit
guard False = fail

-- | what there is, or the reading given up where there is nothing
found : {a : Type} -> Maybe a -> Dec a
found (Just x) = pure x
found Nothing = fail

-- | the stream's end
atEnd : Dec Unit
atEnd = \s i -> if i >= strLength s then Just (MkPair MkUnit i) else Nothing

-- | what `d` reads, the stream ending with it
whole : {a : Type} -> Dec a -> Dec a
whole d = do
  x <- d
  atEnd
  pure x

valueOf : {a : Type} -> Maybe (Got a) -> Maybe a
valueOf (Just (MkPair x _)) = Just x
valueOf Nothing = Nothing

-- | what `d` reads from the start of a stream
run : {a : Type} -> Dec a -> String -> Maybe a
run d s = valueOf (d s 0)

-- Tokens
--------------------------------------------------------------------------------

-- (after a token, one space is skipped, or the stream ends)
pastSep : String -> Int -> Int
pastSep s i = if i < strLength s && charCode s i == 32 then i + 1 else i

wordEnd : String -> Int -> Int
wordEnd s i =
  if i >= strLength s || charCode s i == 32 then i else wordEnd s (i + 1)

-- | a token as it is, up to the next space
word : Dec String
word = \s i ->
    if i >= strLength s then Nothing
    else Just (MkPair (strSlice s i (wordEnd s i)) (pastSep s (wordEnd s i)))

colonAt : String -> Int -> Int
colonAt s i =
  if i >= strLength s || charCode s i == 58 then i else colonAt s (i + 1)

strAt : String -> Int -> Int -> Maybe (Got String)
strAt s j n =
  if j + n > strLength s then Nothing
  else Just (MkPair (strSlice s j (j + n)) (pastSep s (j + n)))

-- | a length-prefixed string (`3:abc`): nothing in it is looked at
str : Dec String
str = \s i ->
    if colonAt s i >= strLength s || colonAt s i == i then Nothing
    else strAt s (colonAt s i + 1) (Su.intOfText (strSlice s i (colonAt s i)))

int : Dec Int
int = do
  w <- word
  pure (Su.intOfText w)

boolOf : String -> Dec Bool
boolOf "t" = pure True
boolOf "f" = pure False
boolOf _ = fail

bool : Dec Bool
bool = bind word boolOf

-- | a string, which must be `x`
expect : String -> Dec Unit
expect x = do
  y <- str
  guard (strEq y x)

-- (`n` of what `d` reads)
times : {a : Type} -> Dec a -> Int -> Dec (List a)
times d n =
  if n <= 0 then pure Nil
  else do
    x <- d
    xs <- times d (n - 1)
    pure (Cons x xs)

-- | a count, then that many of what `d` reads
many : {a : Type} -> Dec a -> Dec (List a)
many d = bind int (times d)
