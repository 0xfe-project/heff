-- Notation: what the parser reads text into and the elaborator takes, a
-- tree of juxtapositions, infixes and blocks; and the diagnostics.
-- After the fnotation Haskell library (MPL-2.0).

import heff.params as P
import prelude

data Severity = SError | SWarning | SDebug

-- | a diagnostic: `code` is already offset into its family (lexer 0,
-- | reader 100, parser 200, elaborator 300); its message is plain text
type Diag =
  { code : Int
  , severity : Severity
  , msg : String
  , span : P.Span
  , note : Maybe String
  }

-- | what a block's items are: statements (`do`), the alternatives of a
-- | match, a record's settings (`struct`) or its type's fields (`sig`),
-- | a sum's alternatives, equations (`where`), local definitions
data Block = BDo | BLet | BLocal | BMatch | BSig | BStruct | BSum | BWhere

-- | what a declaration declares: a definition, a theory, a primitive, a
-- | test, a watch (`-- >>> e`)
data DeclKind = DefK | TheoryK | PrimK | TestK | WatchK

-- | the syntax's own words: `:`, `=>`, `:=`, `->`, `<-`, `~`, and the
-- | built-in types and `abandon`
data Kw
  = KAnn
  | KMaps
  | KSet
  | KArrow
  | KBind
  | KSpec
  | KType
  | KAbandon
  | KInt
  | KFloat
  | KString
  | KArray

data NtnF
  = Juxt (P.Spanned NtnF) (P.Spanned NtnF)
  | Infix (P.Spanned NtnF) (P.Spanned NtnF) (P.Spanned NtnF)
  | NBlock Block (Maybe (P.Spanned NtnF)) (List (P.Spanned NtnF))
  | MDecl DeclKind (P.Spanned NtnF)
  | NTuple (List (P.Spanned NtnF))
  -- | extension: `{ e }`, for implicit arguments
  | NBrace (P.Spanned NtnF)
  -- | `{{x : T}}`, an instance binder
  | NBracket (P.Spanned NtnF)
  | Ident String
  | Keyword Kw
  | NField String
  | NTag String
  | NInt Int
  | NFloat Float
  | NString String
  | NError

-- | notation, where it is written
type Ntn = P.Spanned NtnF

ntnSpan : Ntn -> P.Span
ntnSpan n = P.spanOf n

startPos : Ntn -> Int
startPos n = (ntnSpan n).start

endPos : Ntn -> Int
endPos n = (ntnSpan n).end

-- | from the start of one to the end of the other
spanning : Ntn -> Ntn -> P.Span
spanning a b = { start = startPos a, end = endPos b }

juxt : Ntn -> Ntn -> Ntn
juxt f x = At (Juxt f x) (spanning f x)

infixOp : Ntn -> Ntn -> Ntn -> Ntn
infixOp l op r = At (Infix l op r) (spanning l r)

-- | `x = p`, a field of a record pattern: `p`
fieldPatOf : Ntn -> Ntn
fieldPatOf (At (Infix _ _ p) _) = p
fieldPatOf n = n

-- | a juxtaposition, read as head and arguments
type Group = { head : Ntn, args : List Ntn }

group : Ntn -> List Ntn -> Ntn
group h args = foldl (\f x -> juxt f x) h args

groupGo : List Ntn -> Ntn -> Group
groupGo acc (At (Juxt f x) _) = groupGo (Cons x acc) f
groupGo acc f = { head = f, args = acc }

getGroup : Ntn -> Group
getGroup n = groupGo Nil n

-- >>> (getGroup (group (At (Ident "f") P.noSpan) [At (Ident "x") P.noSpan, At (Ident "y") P.noSpan])).args
-- [At (Ident "x") { start = 0, end = 0 }, At (Ident "y") { start = 0, end = 0 }]

-- | a definition by equations, `f : T` and the equations (the parser's
-- | `def`, at the top level or in a `where`): its name, where its name
-- | is, its type and its equations
type DefEqns = { name : String, span : P.Span, ty : Ntn, eqs : List Ntn }

-- | how a keyword is written
kwText : Kw -> String
kwText KAnn = ":"
kwText KMaps = "=>"
kwText KSet = ":="
kwText KArrow = "->"
kwText KBind = "<-"
kwText KSpec = "~"
kwText KType = "Type"
kwText KAbandon = "abandon"
kwText KInt = "Int"
kwText KFloat = "Float"
kwText KString = "String"
kwText KArray = "Array"

kwEq : Kw -> Kw -> Bool
kwEq a b = strEq (kwText a) (kwText b)

blockText : Block -> String
blockText BDo = "do"
blockText BLet = "let"
blockText BLocal = "local"
blockText BMatch = "match"
blockText BSig = "sig"
blockText BStruct = "struct"
blockText BSum = "sum"
blockText BWhere = "where"

declText : DeclKind -> String
declText DefK = "def"
declText TheoryK = "theory"
declText PrimK = "primitive"
declText TestK = "test"
declText WatchK = ">"

isKeyword : Kw -> Ntn -> Bool
isKeyword x n = case P.nodeOf n of
  Keyword y -> kwEq x y
  _ -> False

-- (one level at a time: what does not match is `Nothing`, once)
defWhere : String -> P.Span -> Ntn -> Ntn -> Maybe DefEqns
defWhere f fsp ty w = case P.nodeOf w of
  NBlock BWhere m eqs -> case m of
    Nothing -> Just { name = f, span = fsp, ty = ty, eqs = eqs }
    Just _ -> Nothing
  _ -> Nothing

defTyped : String -> P.Span -> Ntn -> Maybe DefEqns
defTyped f fsp r = case P.nodeOf r of
  Juxt ty w -> defWhere f fsp ty w
  _ -> Nothing

defSig : Ntn -> Maybe DefEqns
defSig b = case P.nodeOf b of
  Infix l op r -> case P.nodeOf l of
    Ident f -> if isKeyword KAnn op then defTyped f (P.spanOf l) r else Nothing
    _ -> Nothing
  _ -> Nothing

defEqnsOf : Ntn -> Maybe DefEqns
defEqnsOf n = case P.nodeOf n of
  MDecl DefK b -> defSig b
  _ -> Nothing
