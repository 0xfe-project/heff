-- Notation: what the parser reads text into and the elaborator takes, a
-- tree of juxtapositions, infixes and blocks; and the diagnostics.
-- After the fnotation Haskell library (MPL-2.0).

import heff.params as P
import prelude

data Severity = SError | SWarning | SDebug

-- | a diagnostic: `code` is already offset into its family (lexer 0,
-- | reader 100, parser 200, elaborator 300); its message is plain text
type Diag =
  { code : Int
  , severity : Severity
  , msg : String
  , span : P.Span
  , note : Maybe String
  }

data NtnF
  = Juxt (P.Spanned NtnF) (P.Spanned NtnF)
  | Infix (P.Spanned NtnF) (P.Spanned NtnF) (P.Spanned NtnF)
  | NBlock String (Maybe (P.Spanned NtnF)) (List (P.Spanned NtnF))
  | MDecl (List String) String (P.Spanned NtnF)
  | NTuple (List (P.Spanned NtnF))
  -- | extension: `{ e }`, for implicit arguments
  | NBrace (P.Spanned NtnF)
  -- | `{{x : T}}`, an instance binder
  | NBracket (P.Spanned NtnF)
  | Ident String
  | Keyword String
  | NField String
  | NTag String
  | NInt Int
  | NFloat Float
  | NString String
  | NError

-- | notation, where it is written
type Ntn = P.Spanned NtnF

ntnSpan : Ntn -> P.Span
ntnSpan n = P.spanOf n

startPos : Ntn -> Int
startPos n = (ntnSpan n).start

endPos : Ntn -> Int
endPos n = (ntnSpan n).end

-- | from the start of one to the end of the other
spanning : Ntn -> Ntn -> P.Span
spanning a b = { start = startPos a, end = endPos b }

juxt : Ntn -> Ntn -> Ntn
juxt f x = At (Juxt f x) (spanning f x)

infixOp : Ntn -> Ntn -> Ntn -> Ntn
infixOp l op r = At (Infix l op r) (spanning l r)

-- | a juxtaposition, read as head and arguments
type Group = { head : Ntn, args : List Ntn }

group : Ntn -> List Ntn -> Ntn
group h args = foldl (\f x -> juxt f x) h args

groupGo : List Ntn -> Ntn -> Group
groupGo acc (At (Juxt f x) _) = groupGo (Cons x acc) f
groupGo acc f = { head = f, args = acc }

getGroup : Ntn -> Group
getGroup n = groupGo Nil n

-- >>> (getGroup (group (At (Ident "f") P.noSpan) [At (Ident "x") P.noSpan, At (Ident "y") P.noSpan])).args
-- [At (Ident "x") { start = 0, end = 0 }, At (Ident "y") { start = 0, end = 0 }]
