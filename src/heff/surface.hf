-- The reader: text into notation.  The text is read once, by `heff.cst`
-- (the concrete syntax the formatter lays out too); here what it reads
-- is lowered into the notation the elaborator takes -- which names are
-- in scope (a capitalised one is a tag unless it is), how operators bind
-- (the fixities), the sugar taken apart, and signatures met with their
-- equations.  `P` is the lowering's monad -- state threaded, a diagnostic
-- thrown -- and this module's `bind` is its; the lowering's functions
-- call one another, so they are the fields of one record, `lw`.

import array as A
import heff.cst as C
import heff.fixity as F
import heff.fmt.lex as L
import heff.fmt.toks as Tk
import heff.notation
import heff.params as Pm
import prelude

type Binders = { f : String, names : List String, implicits : List String }

mkBinders : String -> List String -> List String -> Binders
mkBinders f names implicits = { f = f, names = names, implicits = implicits }

-- | `toks`: the tokens read (the lowering looks one past a parenthesis);
-- | `scope`: the names bound where the lowering is; `binders`: the names
-- | each signature binds; `patVars`: those of the equation being lowered;
-- | `fix`: the fixities in scope; `lenient`: unrelated operators bind as
-- | one left-associative group (the formatter's reading)
type St =
  { toks : Array C.T
  , scope : List String
  , known : String -> Bool
  , binders : List Binders
  , patVars : List String
  , fix : F.Fixities
  , lenient : Bool
  }

type P a = St -> Pair (Either Diag a) St

bindStep : {a b : Type}
         -> Pair (Either Diag a) St
         -> (a -> P b)
         -> Pair (Either Diag b) St
bindStep (MkPair (Left e) st) f = MkPair (Left e) st
bindStep (MkPair (Right x) st) f = f x st

bind : {a b : Type} -> P a -> (a -> P b) -> P b
bind m f = \st -> bindStep (m st) f

pure : {a : Type} -> a -> P a
pure x = \st -> MkPair (Right x) st

pGets : {a : Type} -> (St -> a) -> P a
pGets f = \st -> MkPair (Right (f st)) st

pModify : (St -> St) -> P Unit
pModify f = \st -> MkPair (Right MkUnit) (f st)

throwP : {a : Type} -> Diag -> P a
throwP d = \st -> MkPair (Left d) st

diag : Pm.Span -> String -> Diag
diag span msg =
  { code = 150, severity = SError, msg = msg, span = span, note = Nothing }

mkSt : Array C.T
     -> List String
     -> (String -> Bool)
     -> List Binders
     -> List String
     -> F.Fixities
     -> Bool
     -> St
mkSt toks scope known binders patVars fix lenient =
  { toks = toks
  , scope = scope
  , known = known
  , binders = binders
  , patVars = patVars
  , fix = fix
  , lenient = lenient
  }

setScope : List String -> St -> St
setScope sc s = mkSt s.toks sc s.known s.binders s.patVars s.fix s.lenient

setBinders : List Binders -> St -> St
setBinders b s = mkSt s.toks s.scope s.known b s.patVars s.fix s.lenient

setPatVars : List String -> St -> St
setPatVars pv s = mkSt s.toks s.scope s.known s.binders pv s.fix s.lenient

-- Tokens and spans
--------------------------------------------------------------------------------

-- | `:` annotates (`::` is an operator: the prelude's cons)
isAnnText : String -> Bool
isAnnText x = strEq x ":"

-- (a token as the lexer gives it: the fixities are read from those)
spanOf : L.Tok -> Pm.Span
spanOf t = { start = t.start, end = t.end }

spanT : C.T -> Pm.Span
spanT t = { start = t.start, end = t.end }

spanTT : C.T -> C.T -> Pm.Span
spanTT a b = { start = a.start, end = b.end }

spanTE : C.T -> Int -> Pm.Span
spanTE a e = { start = a.start, end = e }

mkSpan : Int -> Int -> Pm.Span
mkSpan a b = { start = a, end = b }

appendS : {a : Type} -> List a -> List a -> List a
appendS Nil ys = ys
appendS (Cons x xs) ys = Cons x (appendS xs ys)

withScope : {a : Type} -> List String -> P a -> P a
withScope xs p = do
  saved <- pGets (\s -> s.scope)
  pModify (\s -> setScope (appendS xs s.scope) s)
  x <- p
  pModify (\s -> setScope saved s)
  pure x

traverseS : {a b : Type} -> (a -> P b) -> List a -> P (List b)
traverseS f Nil = pure Nil
traverseS f (Cons x xs) = do
  y <- f x
  ys <- traverseS f xs
  pure (Cons y ys)

-- | the items of a block, lowered: what one binds is in scope in those
-- | after it, not after the block
block : {a b : Type} -> (a -> P b) -> List a -> P (List b)
block f xs = do
  saved <- pGets (\s -> s.scope)
  ys <- traverseS f xs
  pModify (\s -> setScope saved s)
  pure ys

-- Number literals
--------------------------------------------------------------------------------

digitsVal : String -> Int -> Int -> Int -> Int
digitsVal s i stop n =
  if i >= stop then n
  else digitsVal s (i + 1) stop (n * 10 + (charCode s i - 48))

intOfText : String -> Int
intOfText s =
  if startsWith "-" s then 0 - digitsVal s 1 (strLength s) 0
  else if startsWith "+" s then digitsVal s 1 (strLength s) 0
  else digitsVal s 0 (strLength s) 0

ipow10 : Int -> Int
ipow10 k = if k <= 0 then 1 else 10 * ipow10 (k - 1)

expOf : String -> Int
expOf ex =
  if startsWith "-" ex then 0 - intOfText (strSlice ex 1 (strLength ex))
  else if startsWith "+" ex then intOfText (strSlice ex 1 (strLength ex))
  else intOfText ex

dotAt : String -> Int -> Int
dotAt s i =
  if i >= strLength s then strLength s
  else if charCode s i == 46 then i
  else dotAt s (i + 1)

-- (the digits with the dot taken out: an exact integer mantissa, and
-- how many digits were after the dot)
mantScale : String -> Int -> Int
mantScale m d = if d >= strLength m then 0 else strLength m - d - 1

mantInt : String -> Int -> Int
mantInt m d =
  if d >= strLength m then intOfText m
  else intOfText (strSlice m 0 d ++ strSlice m (d + 1) (strLength m))

splitExp : String -> Int -> Int
splitExp s i =
  if i >= strLength s then strLength s
  else if charCode s i == 101 || charCode s i == 69 then i
  else splitExp s (i + 1)

-- (one conversion, not a float computation per digit: `M * 10^p` is an
-- exact integer when `p >= 0`, and one division otherwise -- so the
-- value is the literal's, as JavaScript reads it)
floatAt : Int -> Int -> Float
floatAt m p =
  if p >= 0 then toFloat (m * ipow10 p)
  else toFloat m /. toFloat (ipow10 (0 - p))

floatSplit : String -> Int -> Float
floatSplit s eAt =
  floatAt
    (mantInt (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))
    ((if eAt >= strLength s then 0
      else expOf (strSlice s (eAt + 1) (strLength s)))
     - mantScale (strSlice s 0 eAt) (dotAt (strSlice s 0 eAt) 0))

-- | `a.b`, with an optional sign and an optional `e`/`E` exponent, as
-- | the lexer writes floats
floatOfText : String -> Float
floatOfText s =
  if startsWith "-" s
    then 0.0
      -. floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else if startsWith "+" s
    then floatSplit
        (strSlice s 1 (strLength s))
        (splitExp (strSlice s 1 (strLength s)) 0)
  else floatSplit s (splitExp s 0)

type Operand = { op : C.T, e : Ntn }

mkOperand : C.T -> Ntn -> Operand
mkOperand t e = { op = t, e = e }

binderNames : Ntn -> List String
binderNames (At (Infix (At (Ident x) _) (At (Keyword KAnn) _) _) _) = Cons x Nil
binderNames (At (NBrace n) _) = binderNames n
binderNames (At (NBracket n) _) = binderNames n
binderNames _ = Nil

-- | the names a (function) type binds: `(x : A) -> ...`, `{x : A} -> ...`
piBinders : Ntn -> List String
piBinders (At (Infix b (At (Keyword KArrow) _) rest) _) =
  appendS (binderNames b) (piBinders rest)
piBinders _ = Nil

-- | the names of the implicit parameters, `{x : A} -> ...`
piImplicits : Ntn -> List String
piImplicits (At (Infix (At (NBrace b) bsp) (At (Keyword KArrow) _) rest) _) =
  appendS (binderNames (At (NBrace b) bsp)) (piImplicits rest)
piImplicits (At (Infix (At (NBracket b) bsp) (At (Keyword KArrow) _) rest) _) =
  appendS (binderNames (At (NBracket b) bsp)) (piImplicits rest)
piImplicits (At (Infix _ (At (Keyword KArrow) _) rest) _) = piImplicits rest
piImplicits _ = Nil

concatMapS : {a b : Type} -> (a -> List b) -> List a -> List b
concatMapS f Nil = Nil
concatMapS f (Cons x xs) = appendS (f x) (concatMapS f xs)

-- | the names a pattern binds (`_` binds nothing; a tag is no
-- | variable; nor is a capitalised name, unless `pv`, the parameters the
-- | signature names, has it)
boundBy : List String -> C.Pat -> List String
boundBy pv (PAtom t) =
  if strEq t.kind "var" && not (strEq t.text "_") then Cons t.text Nil
  else if strEq t.kind "con" && elemBy strEq t.text pv then Cons t.text Nil
  else Nil
boundBy pv (PCon c args) = concatMapS (\q -> boundBy pv q) args
boundBy pv (PParen o q c) = boundBy pv q
boundBy pv (PList o ps commas c) = concatMapS (\q -> boundBy pv q) ps
boundBy pv (POp l op q) = appendS (boundBy pv l) (boundBy pv q)
boundBy pv (PRec o fs commas c) = concatMapS (\q -> boundBy pv q) fs
boundBy pv (PField x eq q) = boundBy pv q

isIdentN : Ntn -> Bool
isIdentN (At (Ident _) _) = True
isIdentN _ = False

-- (a capitalised name, not a tag: `'x` is written one longer than `x`)
isNameN : Ntn -> Bool
isNameN (At (Ident _) _) = True
isNameN (At (NTag x) sp) = sp.end - sp.start == strLength x
isNameN _ = False

asNameN : Ntn -> Ntn
asNameN (At (NTag x) sp) = At (Ident x) sp
asNameN n = n

catMaybesS : {a : Type} -> List (Maybe a) -> List a
catMaybesS Nil = Nil
catMaybesS (Cons (Just x) xs) = Cons x (catMaybesS xs)
catMaybesS (Cons Nothing xs) = catMaybesS xs

identOf : Ntn -> Maybe String
identOf (At (Ident x) _) = Just x
identOf (At (NTag x) _) = Just x
identOf _ = Nothing

identsOfG : Ntn -> List String
identsOfG g =
  catMaybesS (map identOf (Cons (getGroup g).head (getGroup g).args))

asBinderOn : Ntn -> P Ntn
asBinderOn e = case e of
  At (Infix g (At (Keyword KAnn) _) _) _ -> do
    pModify (\s -> setScope (appendS (identsOfG g) s.scope) s)
    pure e
  _ -> pure e

allS : {a : Type} -> (a -> Bool) -> List a -> Bool
allS p Nil = True
allS p (Cons x xs) = p x && allS p xs

nameBinder : Ntn -> Ntn
nameBinder (At (Infix g (At (Keyword KAnn) ksp) t) _) =
  if allS isNameN (Cons (getGroup g).head (getGroup g).args)
    then infixOp
        (group (asNameN (getGroup g).head) (map asNameN (getGroup g).args))
        (At (Keyword KAnn) ksp)
        t
  else infixOp g (At (Keyword KAnn) ksp) t
nameBinder e0 = e0

-- | `A : T` as a binder: what is left of `:` is names (in scope after)
asBinder : Ntn -> P Ntn
asBinder e0 = asBinderOn (nameBinder e0)

foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

wrapB : Bool -> Ntn -> Pm.Span -> Ntn
wrapB True n sp = At (NBrace n) sp
wrapB False n sp = n

arrowNames : Pm.Span
           -> Ntn
           -> Ntn
           -> Ntn
           -> Pm.Span
           -> Ntn
           -> Bool
           -> Ntn
           -> Ntn
arrowNames sp lhs rhs g ksp ty braced orig =
  if allS isIdentN (Cons (getGroup g).head (getGroup g).args)
  && length (getGroup g).args > 0
    then foldr
        (\x b ->
           infixOp
             (wrapB
                braced
                (infixOp x (At (Keyword KAnn) ksp) ty)
                (ntnSpan orig))
             (At (Keyword KArrow) sp)
             b)
        rhs
        (Cons (getGroup g).head (getGroup g).args)
  else infixOp orig (At (Keyword KArrow) sp) rhs

-- `{a : T} -> B`: braces with one declaration, left of an arrow, bind
-- an implicit argument
arrowBinop : Pm.Span -> Ntn -> Ntn -> Ntn
arrowBinop sp lhs rhs = case lhs of
  At (Infix g (At (Keyword KAnn) ksp) ty) _ ->
    arrowNames sp lhs rhs g ksp ty False lhs
  At (NBrace (At (Infix g (At (Keyword KAnn) ksp) ty) _)) bsp ->
    arrowNames sp lhs rhs g ksp ty True lhs
  _ -> infixOp lhs (At (Keyword KArrow) sp) rhs

specOne : Pm.Span -> Ntn -> Ntn -> Ntn
specOne sp acc (At (Infix (At (Ident x) xsp) k v) _) =
  infixOp
    acc
    (At (Keyword KSpec) sp)
    (At
       (NTuple (Cons (infixOp (At (NField x) xsp) k v) Nil))
       (ntnSpan (infixOp (At (Ident x) xsp) k v)))
specOne sp acc _ = acc

-- The shunting yard
--------------------------------------------------------------------------------

type Shunt = { ops : List C.T, out : List Ntn }

maxI : Int -> Int -> Int
maxI a b = if a < b then b else a

boolAnn : Pm.Span -> Ntn -> Ntn
boolAnn osp n = infixOp n (At (Keyword KAnn) osp) (At (Ident "Bool") osp)

-- (the sides are annotated with the `Bool` in scope)
shortcut : C.T -> Ntn -> Ntn -> Ntn -> Ntn
shortcut op c a b =
  boolAnn
    (spanT op)
    (At
       (NBlock
          BMatch
          (Just (boolAnn (spanT op) c))
          (Cons
             (infixOp
                (At (NTag "True") (spanT op))
                (At (Keyword KMaps) (spanT op))
                a)
             (Cons
                (infixOp
                   (At (NTag "False") (spanT op))
                   (At (Keyword KMaps) (spanT op))
                   b)
                Nil)))
       (mkSpan (ntnSpan c).start (maxI (ntnSpan a).end (ntnSpan b).end)))

-- | `&&` and `||` are `if`: the right side is computed only if needed
applyOp : C.T -> Ntn -> Ntn -> Ntn
applyOp op l r =
  if strEq op.text "&&" then shortcut op l r (At (NTag "False") (spanT op))
  else if strEq op.text "||" then shortcut op l (At (NTag "True") (spanT op)) r
  else juxt (juxt (At (Ident op.text) (spanT op)) l) r

-- | in a pattern, an operator is applied as a tag is: its operands are
-- | its arguments
applyPatOp : C.T -> Ntn -> Ntn -> Ntn
applyPatOp op l r = group (At (Ident op.text) (spanT op)) (Cons l (Cons r Nil))

-- (stacks newest first: push is `Cons`)
reduceS : (C.T -> Ntn -> Ntn -> Ntn) -> Shunt -> Shunt
reduceS apply st = case st.ops of
  Cons o os -> case st.out of
    Cons r (Cons l rest) -> { ops = os, out = Cons (apply o l r) rest }
    _ -> st
  Nil -> st

-- | `before` is on the stack, `op` comes: does `before` reduce first?
firstS : F.Fixities -> Bool -> C.T -> C.T -> P Bool
firstS fix lenient before op = case F.relate fix before.text op.text of
  Tighter -> pure True
  Looser -> pure False
  Same AssocLeft -> pure True
  Same AssocRight -> pure False
  Same AssocNone ->
    throwP
      (diag
         (spanT op)
         (if strEq before.text op.text
            then "`" ++ op.text ++ "` does not associate: add parentheses"
          else "`"
            ++ before.text
            ++ "` and `"
            ++ op.text
            ++ "` do not associate: add parentheses"))
  Unrelated ->
    if lenient then pure True
    else throwP
        (diag
           (spanT op)
           ("`"
            ++ before.text
            ++ "` and `"
            ++ op.text
            ++ "` are not related: add parentheses, or declare which binds tighter (`above`, `below`)"))
  Undeclared x ->
    if lenient then pure True
    else throwP
        (diag
           (spanT (if strEq x op.text then op else before))
           ("`"
            ++ x
            ++ "` has no fixity: declare it (`infixl "
            ++ x
            ++ "`), or import the module that does"))

pushS : (C.T -> Ntn -> Ntn -> Ntn)
      -> F.Fixities
      -> Bool
      -> Shunt
      -> Operand
      -> P Shunt
pushS apply fix lenient st r = case st.ops of
  Nil -> pure { ops = Cons r.op st.ops, out = Cons r.e st.out }
  Cons before os -> do
    done <- firstS fix lenient before r.op
    if done then pushS apply fix lenient (reduceS apply st) r
      else pure { ops = Cons r.op st.ops, out = Cons r.e st.out }

pushAll : (C.T -> Ntn -> Ntn -> Ntn)
        -> F.Fixities
        -> Bool
        -> Shunt
        -> List Operand
        -> P Shunt
pushAll apply fix lenient st Nil = pure st
pushAll apply fix lenient st (Cons r rest) = do
  st' <- pushS apply fix lenient st r
  pushAll apply fix lenient st' rest

checkFixOf : F.Fixities -> Bool -> List Operand -> P Unit
checkFixOf fix lenient Nil = pure MkUnit
checkFixOf fix lenient (Cons r rest) = case F.groupOf fix r.op.text of
  Just _ -> checkFixOf fix lenient rest
  Nothing ->
    if lenient then checkFixOf fix lenient rest
    else throwP
        (diag
           (spanT r.op)
           ("`"
            ++ r.op.text
            ++ "` has no fixity: declare it (`infixl "
            ++ r.op.text
            ++ "`), or import the module that does"))

reduceAll : (C.T -> Ntn -> Ntn -> Ntn) -> Shunt -> Shunt
reduceAll apply st = case st.ops of
  Nil -> st
  Cons o os -> reduceAll apply (reduceS apply st)

headOr : {a : Type} -> a -> List a -> a
headOr z Nil = z
headOr z (Cons x xs) = x

-- | operators and operands into a tree, refusing operators that do not
-- | go together
resolve : (C.T -> Ntn -> Ntn -> Ntn) -> Ntn -> List Operand -> P Ntn
resolve apply e0 rest = do
  fix <- pGets (\s -> s.fix)
  lenient <- pGets (\s -> s.lenient)
  checkFixOf fix lenient rest
  st <- pushAll apply fix lenient { ops = Nil, out = Cons e0 Nil } rest
  pure (headOr e0 (reduceAll apply st).out)

-- Declarations
--------------------------------------------------------------------------------

-- | what a top-level declaration is, before signatures meet equations:
-- | a signature (the name, where it is written, the type, where the
-- | signature is), an equation, or a declaration whole
data Item = Sig String Pm.Span Ntn Pm.Span | Eqn String Ntn Pm.Span | Decl Ntn

-- Signatures meet their equations
--------------------------------------------------------------------------------

defOf : String -> Pm.Span -> Ntn -> Pm.Span -> List Ntn -> Ntn
defOf f fsp ty sp eqs =
  At
    (MDecl
       DefK
       (infixOp
          (At (Ident f) fsp)
          (At (Keyword KAnn) sp)
          (juxt ty (At (NBlock BWhere Nothing eqs) sp))))
    sp

eqnsOf : String -> List Item -> List Ntn
eqnsOf f Nil = Nil
eqnsOf f (Cons (Eqn g e esp) rest) =
  if strEq g f then Cons e (eqnsOf f rest) else eqnsOf f rest
eqnsOf f (Cons _ rest) = eqnsOf f rest

eqnEnd : String -> List Item -> Int -> Int
eqnEnd f Nil e = e
eqnEnd f (Cons (Eqn g _ esp) rest) e =
  if strEq g f then eqnEnd f rest (maxI e esp.end) else eqnEnd f rest e
eqnEnd f (Cons _ rest) e = eqnEnd f rest e

assembleOne : List String -> List Item -> Item -> Maybe Ntn
assembleOne broken items (Decl n) = Just n
assembleOne broken items (Sig f fsp ty sp) =
  if elemBy strEq f broken
    then Just
        (defOf
           f
           fsp
           ty
           sp
           (Cons
              (infixOp
                 (At (Ident f) fsp)
                 (At (Keyword KSet) sp)
                 (At (Keyword KAbandon) sp))
              Nil))
  else if length (eqnsOf f items) == 0 then Nothing
  else Just
      (defOf
         f
         fsp
         ty
         (mkSpan sp.start (eqnEnd f items sp.end))
         (eqnsOf f items))
assembleOne broken items (Eqn _ _ _) = Nothing

assemble : List String -> List Item -> List Ntn
assemble broken items =
  catMaybesS (map (\it -> assembleOne broken items it) items)

sigNames : List Item -> List String
sigNames Nil = Nil
sigNames (Cons (Sig f _ _ _) rest) = Cons f (sigNames rest)
sigNames (Cons _ rest) = sigNames rest

eqnNames : List Item -> List String
eqnNames Nil = Nil
eqnNames (Cons (Eqn f _ _) rest) = Cons f (eqnNames rest)
eqnNames (Cons _ rest) = eqnNames rest

assembleDiagOne : List String
                -> List String
                -> List String
                -> Item
                -> Maybe Diag
assembleDiagOne broken sigs eqns (Sig f _ _ sp) =
  if not (elemBy strEq f eqns) && not (elemBy strEq f broken)
    then Just (diag sp ("`" ++ f ++ "` has a type but no definition"))
  else Nothing
assembleDiagOne broken sigs eqns (Eqn f _ sp) =
  if not (elemBy strEq f sigs) && not (elemBy strEq f broken)
    then Just (diag sp ("`" ++ f ++ "` needs a type: `" ++ f ++ " : ...`"))
  else Nothing
assembleDiagOne broken sigs eqns (Decl _) = Nothing

assembleDiags : List String -> List Item -> List Diag
assembleDiags broken items =
  catMaybesS
    (map (assembleDiagOne broken (sigNames items) (eqnNames items)) items)

-- The lowering, knotted through `lw`
--------------------------------------------------------------------------------

-- (a function over `E` or `Ntn` matches through one of these, its body
-- written once: a default equation is compiled into every other arm)

atomOf : C.E -> Maybe C.T
atomOf (Atom t) = Just t
atomOf _ = Nothing

symAtom : C.E -> Maybe C.T
symAtom (Atom t) = if strEq t.kind "sym" then Just t else Nothing
symAtom _ = Nothing

-- | an operator's right side, as written: the operator, and its operand
opRhsOf : C.E -> Pair C.T C.E
opRhsOf (OpRhs op e) = MkPair op e
opRhsOf e = MkPair (C.firstE e) e

-- | `{x : A}`: braces around one declaration (not a record's field)
bracedOne : C.E -> Maybe C.E
bracedOne (Braces o (Cons f Nil) commas c) = case f of
  EFSet x eq e -> Nothing
  _ -> Just f
bracedOne _ = Nothing

-- | `{ x = e, ... }` or `{}`: a record's settings
settingsOf : C.E -> Maybe (List C.E)
settingsOf (Braces o fs commas c) = case fs of
  Nil -> Just Nil
  Cons (EFSet x eq e) rest -> Just fs
  _ -> Nothing
settingsOf _ = Nothing

isColon : Ntn -> Bool
isColon (At (Keyword KAnn) _) = True
isColon _ = False

-- | `a : T`
isAnnN : Ntn -> Bool
isAnnN (At (Infix l k t) _) = isColon k
isAnnN _ = False

type Lw =
  { e : C.E -> P Ntn, pat : C.Pat -> P Ntn, decl : C.D -> P (List Item) }

-- | a keyword written as a word: a built-in type, or `abandon` (where
-- | the text becomes the keyword it is, once)
wordKw : String -> Kw
wordKw "Int" = KInt
wordKw "Float" = KFloat
wordKw "String" = KString
wordKw "Array" = KArray
wordKw "abandon" = KAbandon
wordKw _ = KType

-- | a literal, a keyword, a name or a tag, as the token says
atomTok : C.T -> Ntn
atomTok t =
  if strEq t.kind "var" then At (Ident t.text) (spanT t)
  else if strEq t.kind "tag" then At (NTag t.text) (spanT t)
  else if strEq t.kind "int" then At (NInt (intOfText t.text)) (spanT t)
  else if strEq t.kind "float" then At (NFloat (floatOfText t.text)) (spanT t)
  else if strEq t.kind "str" then At (NString t.text) (spanT t)
  else if strEq t.kind "sym" then At (Ident t.text) (spanT t)
  else At (Keyword (wordKw t.text)) (spanT t)

withFields : Ntn -> List C.T -> Ntn
withFields n fs =
  foldl (\m (f : C.T) -> juxt m (At (NField f.text) (spanT f))) n fs

-- | a capitalised name: a variable or a definition in scope, or a tag;
-- | `M.x`, a definition of the module imported as `M`, unless `M` is a
-- | variable here
conAtom : C.T -> List C.T -> P Ntn
conAtom t fs = do
  local <- pGets (\s -> elemBy strEq t.text s.scope)
  qualified <-
    pGets (\s -> case fs of
    Cons f rest -> s.known (t.text ++ "." ++ f.text)
    Nil -> False)
  inScope <- pGets (\s -> local || s.known t.text)
  pure
      (if qualified && not local
         then case fs of
           Cons f rest ->
             withFields (At (Ident (t.text ++ "." ++ f.text)) (spanTT t f)) rest
           Nil -> At (NTag t.text) (spanT t)
       else if inScope then withFields (At (Ident t.text) (spanT t)) fs
       else withFields (At (NTag t.text) (spanT t)) fs)

-- | `e.x.y`: what is projected, and the fields
data Fields = MkFields C.E (List C.T)

fieldsOf : C.E -> List C.T -> Fields
fieldsOf (EField e f) acc = fieldsOf e (Cons f acc)
fieldsOf e acc = MkFields e acc

-- | the token after `t` is `->`: what is in the parentheses `t` closes
-- | binds names
arrowAfter : St -> C.T -> Bool
arrowAfter s t =
  t.ix + 1 < A.length s.toks
  && strEq (A.index s.toks (t.ix + 1)).kind "sym"
  && strEq (A.index s.toks (t.ix + 1)).text "->"

-- | `[a, b, c]`, `Cons a (Cons b (Cons c Nil))`, and `[]`, `Nil`
listN : Pm.Span -> List Ntn -> Ntn
listN sp xs =
  foldr
    (\x rest -> group (At (NTag "Cons") sp) (Cons x (Cons rest Nil)))
    (At (NTag "Nil") sp)
    xs

-- | `x : T` in a binder's braces, and nothing else
declarationL : Lw -> C.E -> P Ntn
declarationL r e = do
  e0 <- r.e e
  d <- asBinder e0
  if isAnnN d then pure d
    else throwP (diag (ntnSpan d) "a field is `name : Type`")

settingL : Lw -> C.E -> P Ntn
settingL r (EFSet x eq e) = do
  e' <- r.e e
  pure (infixOp (At (Ident x.text) (spanT x)) (At (Keyword KSet) (spanT x)) e')
settingL r e = r.e e

isSetting : C.E -> Bool
isSetting (EFSet x eq e) = True
isSetting e = False

bracesL : Lw -> C.T -> List C.E -> C.T -> P Ntn
bracesL r o fs c = case fs of
  Nil -> pure (At (NBlock BStruct Nothing Nil) (spanTT o c))
  Cons f rest ->
    if isSetting f
      then do
        fs' <- traverseS (\m -> settingL r m) fs
        pure (At (NBlock BStruct Nothing fs') (spanTT o c))
    else do
      fs' <- traverseS (\m -> declarationL r m) fs
      pure (At (NBlock BSig Nothing fs') (spanTT o c))

conAltL : Lw -> C.E -> P Ntn
conAltL r (ECon c args) = do
  args' <- traverseS r.e args
  pure (group (At (NTag c.text) (spanT c)) args')
conAltL r e = r.e e

lamBinderL : Lw -> C.E -> P Ntn
lamBinderL r (BVar x) = pure (At (Ident x.text) (spanT x))
lamBinderL r (BImp o x c) =
  pure (At (NBrace (At (Ident x.text) (spanT x))) (spanTT o c))
lamBinderL r (BAnn o x cc ty c) = do
  ty' <- r.e ty
  pure
      (infixOp (At (Ident x.text) (spanT x)) (At (Keyword KAnn) (spanT cc)) ty')
lamBinderL r e = r.e e

lamBound : Ntn -> List String
lamBound (At (Ident x) _) = Cons x Nil
lamBound (At (NBrace (At (Ident x) _)) _) = Cons x Nil
lamBound (At (Infix (At (Ident x) _) (At (Keyword KAnn) _) _) _) = Cons x Nil
lamBound _ = Nil

-- | `\x {y} _ -> e`
lambdaL : Lw -> List C.E -> C.E -> P Ntn
lambdaL r binders body = do
  bs <- traverseS (\b -> lamBinderL r b) binders
  withScope (concatMapS lamBound bs) (do
    body' <- r.e body
    pure
        (foldr (\b e -> infixOp b (At (Keyword KMaps) (ntnSpan b)) e) body' bs))

-- | `C x y -> e`: `x` and `y` are bound in `e`
altL : Lw -> C.E -> P Ntn
altL r (EAlt p arrow e) = do
  p' <- r.pat p
  withScope (boundBy Nil p) (do
    e' <- r.e e
    pure (infixOp p' (At (Keyword KMaps) (spanT arrow)) e'))
altL r e = r.e e

-- | `if c then a else b`, a `case` on `True` and `False`
ifN : Pm.Span -> Ntn -> Ntn -> Ntn -> Ntn
ifN sp c a b =
  At
    (NBlock
       BMatch
       (Just c)
       (Cons
          (infixOp (At (NTag "True") sp) (At (Keyword KMaps) sp) a)
          (Cons
             (infixOp (At (NTag "False") sp) (At (Keyword KMaps) sp) b)
             Nil)))
    sp

-- | `p = e`, or `p : T = e`, after `let`: the pattern, and what it is
-- | bound to (annotated, `(e : T)`)
letHeadL : Lw -> C.Pat -> Maybe (Pair C.T C.E) -> C.E -> P (Pair Ntn Ntn)
letHeadL r p ann e = do
  p' <- r.pat p
  case ann of
    Just (MkPair cc ty) -> do
      ty' <- r.e ty
      e' <- r.e e
      pure
          (MkPair
             p'
             (At
                (Infix e' (At (Keyword KAnn) (spanT cc)) ty')
                (mkSpan (startPos ty') (endPos e'))))
    Nothing -> do
      e' <- r.e e
      pure (MkPair p' e')

-- | `in e` after `let p = e'`: `p`'s variables are bound in `e`
letBodyL : Lw -> C.T -> Pair Ntn Ntn -> List String -> C.T -> C.E -> P Ntn
letBodyL r kw (MkPair p rhs) names i body =
  withScope names (do
  body' <- r.e body
  pure
      (At
         (NBlock
            BLet
            (Just rhs)
            (Cons (infixOp p (At (Keyword KMaps) (spanT i)) body') Nil))
         (spanTE kw (C.lastE body).end)))

-- | `let p = e in e'`; in a `do` block, `let p = e`, `p`'s variables
-- | bound in the statements after it
letL : Lw -> C.E -> P Ntn
letL r (ELet kw p ann eq e body) = do
  h <- letHeadL r p ann e
  case body of
    Just (MkPair i b) -> letBodyL r kw h (boundBy Nil p) i b
    Nothing -> do
      pModify (\s -> setScope (appendS (boundBy Nil p) s.scope) s)
      pure
          (At
             (NBlock BLet (Just (snd h)) (Cons (fst h) Nil))
             (spanTE kw (C.lastE e).end))
letL r e = r.e e

-- | a statement of a `do` block: `x <- e` (`x` bound in the statements
-- | after it), `let p = e`, or `e`
stmtL : Lw -> C.E -> P Ntn
stmtL r (ESBind x arrow e) = do
  e' <- r.e e
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure
      (infixOp
         (At (Ident x.text) (spanT x))
         (At (Keyword KBind) (spanT arrow))
         e')
stmtL r (ELet kw p ann eq e body) = letL r (ELet kw p ann eq e body)
stmtL r e = r.e e

-- | an operator's operands, as written
operandL : Lw -> C.E -> P Operand
operandL r m = case opRhsOf m of
  MkPair op e -> do
    e' <- r.e e
    pure (mkOperand op e')

parenL : Lw -> C.T -> C.E -> C.T -> P Ntn
parenL r o e c = case symAtom e of
  Just t -> pure (At (Ident t.text) (spanT t))
  Nothing -> do
    e' <- r.e e
    after <- pGets (\s -> arrowAfter s c)
    if after then asBinder e' else pure e'

-- | `x -> y`, with `(a b : T) -> B` for `(a : T) -> (b : T) -> B`, and
-- | `{a : T} -> B` binding an implicit argument; `T ~ { f = v }`, a
-- | specialisation (the syntax's operators are these two)
opL : Lw -> C.E -> C.T -> C.E -> P Ntn
opL r a op b =
  if strEq op.text "->"
    then do
      a' <- case bracedOne a of
        Just f -> do
          d <- declarationL r f
          pure (At (NBrace d) (spanTT (C.firstE a) (C.lastE a)))
        Nothing -> r.e a
      b' <- r.e b
      pure (arrowBinop (spanT op) a' b')
  else do
    a' <- r.e a
    case settingsOf b of
      Just fs -> do
        fs' <- traverseS (\m -> settingL r m) fs
        pure (foldl (\acc f -> specOne (spanT op) acc f) a' fs')
      Nothing -> do
        b' <- r.e b
        pure (infixOp a' (At (Keyword KSpec) (spanT op)) b')

-- | an expression
exprL : Lw -> C.E -> P Ntn
exprL r e0 = case e0 of
  Atom t -> if strEq t.kind "con" then conAtom t Nil else pure (atomTok t)
  EField e f -> case fieldsOf (EField e f) Nil of
    MkFields (Atom t) fs ->
      if strEq t.kind "con" then conAtom t fs
      else pure (withFields (atomTok t) fs)
    MkFields b fs -> do
      b' <- r.e b
      pure (withFields b' fs)
  EParen o e c -> parenL r o e c
  Named o x k e c -> do
    e' <- r.e e
    pure
        (At
           (NBrace
              (infixOp
                 (At (Ident x.text) (spanT x))
                 (At (Keyword KSet) (spanT k))
                 e'))
           (spanTT o c))
  Tup o es commas c -> do
    es' <- traverseS r.e es
    pure
        (if strEq o.text "[" then listN (spanTT o c) es'
         else At (NTuple es') (spanTT o c))
  Braces o fs commas c -> bracesL r o fs c
  InstB o o2 d c1 c -> do
    d' <- declarationL r d
    pure (At (NBracket d') (spanTT o c))
  Sum kw o alts bars c -> do
    alts' <- traverseS (\a -> conAltL r a) alts
    pure (At (NBlock BSum Nothing alts') (spanTT kw c))
  ECon c args -> conAltL r (ECon c args)
  App h args -> do
    h' <- r.e h
    args' <- traverseS r.e args
    pure (group h' args')
  Op a op b -> opL r a op b
  Ops a rest -> do
    a' <- r.e a
    rest' <- traverseS (\m -> operandL r m) rest
    resolve applyOp a' rest'
  Ann e cc ty -> do
    e' <- r.e e
    ty' <- r.e ty
    pure (infixOp e' (At (Keyword KAnn) (spanT cc)) ty')
  Lam bs binders arrow body -> lambdaL r binders body
  Case kw scrut o alts -> do
    scrut' <- r.e scrut
    alts' <- block (\a -> altL r a) alts
    pure (At (NBlock BMatch (Just scrut') alts') (spanTE kw (C.lastE e0).end))
  If kw c th a el b -> do
    c' <- r.e c
    a' <- r.e a
    b' <- r.e b
    pure (ifN (spanTE kw (C.lastE b).end) c' a' b')
  Do kw stmts -> do
    stmts' <- block (\m -> stmtL r m) stmts
    pure (At (NBlock BDo Nothing stmts') (spanTE kw (C.lastE e0).end))
  ELet kw p ann eq e body -> letL r e0
  _ ->
    throwP
      (diag (spanT (C.firstE e0)) ("unexpected `" ++ (C.firstE e0).text ++ "`"))

-- Patterns

-- | `p op q op' r`: the first, and each operator with what follows it
data PChain = MkPChain C.Pat (List (Pair C.T C.Pat))

pchainCons : C.Pat -> C.T -> PChain -> PChain
pchainCons l op (MkPChain rh rest) = MkPChain l (Cons (MkPair op rh) rest)

pchainOf : C.Pat -> PChain
pchainOf (POp l op r) = pchainCons l op (pchainOf r)
pchainOf p = MkPChain p Nil

patOperandL : Lw -> Pair C.T C.Pat -> P Operand
patOperandL r (MkPair op p) = do
  p' <- r.pat p
  pure (mkOperand op p')

fieldPatL : Lw -> C.Pat -> P Ntn
fieldPatL r (PField x eq p) = do
  p' <- r.pat p
  pure (infixOp (At (Ident x.text) (spanT x)) (At (Keyword KSet) (spanT eq)) p')
fieldPatL r p = r.pat p

-- | a pattern: an operator in it is another name for a tag (elaboration
-- | finds which), its operands as the fixities say
patL : Lw -> C.Pat -> P Ntn
patL r p0 = case p0 of
  PAtom t ->
    if strEq t.kind "con"
      then do
        -- (a capitalised parameter of the signature is a variable)
        isVar <- pGets (\s -> elemBy strEq t.text s.patVars)
        pure
            (if isVar then At (Ident t.text) (spanT t)
             else At (NTag t.text) (spanT t))
    else pure (atomTok t)
  PCon c args -> do
    args' <- traverseS r.pat args
    pure (group (At (NTag c.text) (spanT c)) args')
  PParen o p c -> r.pat p
  PList o ps commas c -> do
    ps' <- traverseS r.pat ps
    pure (listN (spanTT o c) ps')
  PRec o fs commas c -> do
    fs' <- traverseS (\f -> fieldPatL r f) fs
    pure (At (NBlock BStruct Nothing fs') (spanTT o c))
  POp l op q -> case pchainOf (POp l op q) of
    MkPChain h rest -> do
      h' <- r.pat h
      rest' <- traverseS (\m -> patOperandL r m) rest
      resolve applyPatOp h' rest'
  PField x eq p -> fieldPatL r (PField x eq p)

-- Declarations

-- | what a signature or an equation defines: `f`, `C`, or `(+)`
type DeclName = { name : String, span : Pm.Span }

declNameOf : List C.T -> DeclName
declNameOf (Cons t (Cons op (Cons c Nil))) = { name = op.text, span = spanT op }
declNameOf (Cons t rest) = { name = t.text, span = spanT t }
declNameOf Nil = { name = "", span = mkSpan 0 0 }

firstStart : List C.T -> Int
firstStart (Cons t _) = t.start
firstStart Nil = 0

bindersFor : St -> String -> List Binders
bindersFor s f = filter (\(b : Binders) -> strEq b.f f) s.binders

sigL : Lw -> List C.T -> C.E -> P (List Item)
sigL r names ty = do
  ty' <- r.e ty
  pModify
      (\s ->
         setBinders
           (Cons
              (mkBinders
                 (declNameOf names).name
                 (piBinders ty')
                 (piImplicits ty'))
              s.binders)
           s)
  pure
      (Cons
         (Sig
            (declNameOf names).name
            (declNameOf names).span
            ty'
            (mkSpan (firstStart names) (C.lastE ty).end))
         Nil)

lastDEnd : List C.D -> Int -> Int
lastDEnd ds e = case last ds of
  Just d -> (C.lastD d).end
  Nothing -> e

-- | `e where` and the local definitions, signatures and equations, as at
-- | the top level
whereL : Lw -> C.T -> List C.D -> Ntn -> P Ntn
whereL r kw ds rhs = do
  saved <- pGets (\s -> s.binders)
  items <- block r.decl ds
  pModify (\s -> setBinders saved s)
  case assembleDiags Nil (concatMapS (\x -> x) items) of
    Cons d _ -> throwP d
    Nil ->
      pure
        (At
           (NBlock
              BLocal
              (Just rhs)
              (assemble Nil (concatMapS (\x -> x) items)))
           (mkSpan (startPos rhs) (lastDEnd ds kw.end)))

-- | `f p ... = e`, perhaps followed by `where`
eqnL : Lw
     -> List C.T
     -> List C.Pat
     -> C.E
     -> Maybe (Pair C.T (List C.D))
     -> P (List Item)
eqnL r names pats rhs w = do
  sig <- pGets (\s -> bindersFor s (declNameOf names).name)
  pModify (\s -> setPatVars (concatMapS (\(b : Binders) -> b.names) sig) s)
  pats' <- traverseS r.pat pats
  pModify (\s -> setPatVars Nil s)
  -- (an implicit parameter is not written, but bound all the same, by
  -- the name the signature gives it)
  withScope
      (appendS
         (concatMapS
            (boundBy (concatMapS (\(b : Binders) -> b.names) sig))
            pats)
         (concatMapS (\(b : Binders) -> b.implicits) sig)) (do
    rhs0 <- r.e rhs
    rhs' <- case w of
      Just (MkPair kw ds) -> whereL r kw ds rhs0
      Nothing -> pure rhs0
    pure
        (Cons
           (Eqn
              (declNameOf names).name
              (infixOp
                 (group
                    (At (Ident (declNameOf names).name) (declNameOf names).span)
                    pats')
                 (At
                    (Keyword KSet)
                    (mkSpan (firstStart names) (ntnSpan rhs').end))
                 rhs')
              (mkSpan (firstStart names) (ntnSpan rhs').end))
           Nil))

-- | `x : T`, `x` a name
nameAnn : Ntn -> Maybe Ntn
nameAnn (At (Infix l k t) _) =
  if isIdentN l && isColon k then Just (infixOp l k t) else Nothing
nameAnn _ = Nothing

paramOf : Ntn -> Maybe Ntn -> P Ntn
paramOf p (Just q) = pure q
paramOf p Nothing =
  throwP (diag (ntnSpan p) "a parameter is `a`, `(x : T)` or `{x : T}`")

-- | `(x : T)` or `{x : T}`, a parameter of a type
dataParamOf : Lw -> C.E -> P Ntn
dataParamOf r e = case bracedOne e of
  Just f -> do
    d <- declarationL r f
    case nameAnn d of
      Just q -> pure (At (NBrace q) (spanTT (C.firstE e) (C.lastE e)))
      Nothing -> paramOf d Nothing
  Nothing -> do
    p0 <- r.e e
    p <- if strEq (C.firstE e).text "(" then asBinder p0 else pure p0
    paramOf p (nameAnn p)

-- | a parameter of a type: `a` (a type), `(x : T)` or `{x : T}`
dataParamL : Lw -> C.E -> P Ntn
dataParamL r e = case atomOf e of
  Just x ->
    pure
      (infixOp
         (At (Ident x.text) (spanT x))
         (At (Keyword KAnn) (spanT x))
         (At (Keyword KType) (spanT x)))
  Nothing -> dataParamOf r e

-- | the head of a type's definition: its name applied to its parameters
headN : C.T -> List Ntn -> Ntn
headN name params = group (At (Ident name.text) (spanT name)) params

defN : Pm.Span -> Ntn -> Ntn -> Ntn -> Ntn
defN sp h ty body =
  At
    (MDecl
       DefK
       (infixOp
          (infixOp h (At (Keyword KAnn) sp) ty)
          (At (Keyword KSet) sp)
          body))
    sp

-- | `data T a = C x y | D`, and `data T : U = ...`
dataL : Lw
      -> C.D
      -> C.T
      -> C.T
      -> List C.E
      -> Maybe (Pair C.T C.E)
      -> Maybe C.DAlts
      -> P (List Item)
dataL r d kw name params universe alts = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (concatMapS binderNames params') (do
    universe' <- case universe of
      Just (MkPair cc u) -> r.e u
      Nothing -> pure (At (Keyword KType) (spanT name))
    alts' <- traverseS (\a -> conAltL r a) (C.altsOf alts)
    pure
        (Cons
           (Decl
              (defN
                 (spanTE kw (C.lastD d).end)
                 (headN name params')
                 universe'
                 (At (NBlock BSum Nothing alts') (spanTE kw (C.lastD d).end))))
           Nil))

-- | `type T a = ...`
typeL : Lw -> C.T -> C.T -> List C.E -> C.E -> P (List Item)
typeL r kw name params body = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (concatMapS binderNames params') (do
    body' <- r.e body
    pure
        (Cons
           (Decl
              (defN
                 (spanTE kw (C.lastE body).end)
                 (headN name params')
                 (At (Keyword KType) (spanTE kw (C.lastE body).end))
                 body'))
           Nil))

-- | a field of a theory: in scope in the fields after it
theoryFieldL : Lw -> C.TF -> P Ntn
theoryFieldL r (MkTF x cc ty) = do
  ty' <- r.e ty
  pModify (\s -> setScope (Cons x.text s.scope) s)
  pure (infixOp (At (Ident x.text) (spanT x)) (At (Keyword KAnn) (spanT x)) ty')

-- | `theory T a where` and its fields
theoryL : Lw -> C.D -> C.T -> C.T -> List C.E -> List C.TF -> P (List Item)
theoryL r d kw name params fields = do
  params' <- traverseS (\m -> dataParamL r m) params
  withScope (concatMapS binderNames params') (do
    fields' <- block (\f -> theoryFieldL r f) fields
    pure
        (Cons
           (Decl
              (At
                 (MDecl
                    TheoryK
                    (infixOp
                       (headN name params')
                       (At (Keyword KSet) (spanTE kw (C.lastD d).end))
                       (At
                          (NBlock BSig Nothing fields')
                          (spanTE kw (C.lastD d).end))))
                 (spanTE kw (C.lastD d).end)))
           Nil))

-- | a declaration, lowered: what it is before signatures meet equations
declL : Lw -> C.D -> P (List Item)
declL r d = case d of
  DImport t -> pure Nil
  -- (read before the rest, by `fixityDecls`)
  DFixity kw ts -> pure Nil
  DSig names cc ty -> sigL r names ty
  DEqn names pats eq rhs w -> eqnL r names pats rhs w
  DData kw name params universe alts -> dataL r d kw name params universe alts
  DType kw name params eq body -> typeL r kw name params body
  DTheory kw name params w fields -> theoryL r d kw name params fields
  DForeign kw im x cc ty -> do
    ty' <- r.e ty
    pure
        (Cons
           (Decl
              (At
                 (MDecl
                    PrimK
                    (infixOp
                       (At (Ident x.text) (spanT x))
                       (At (Keyword KAnn) (spanTE kw (C.lastE ty).end))
                       ty'))
                 (spanTE kw (C.lastE ty).end)))
           Nil)
  DTest kw x ->
    pure
      (Cons
         (Decl (At (MDecl TestK (At (Ident x.text) (spanT x))) (spanTT kw x)))
         Nil)
  DWatch w e -> do
    e' <- r.e e
    pure (Cons (Decl (At (MDecl WatchK e') (spanTE w (C.lastE e).end))) Nil)

lw : Lw
lw =
  { e = \e st -> exprL lw e st
  , pat = \p st -> patL lw p st
  , decl = \d st -> declL lw d st
  }

-- The program
--------------------------------------------------------------------------------

-- | the names a file defines (so that a capitalised one is not a tag)
prescanGo : Array L.Tok -> Int -> List String -> List String
prescanGo ts k acc =
  if k >= A.length ts then reverse acc
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && strEq (A.index ts k).kind "kw"
  && elemBy strEq (A.index ts k).text ["data", "type", "theory"]
  && k + 1 < A.length ts
    then prescanGo ts (k + 1) (Cons (A.index ts (k + 1)).text acc)
  else if (A.index ts k).first
  && (A.index ts k).col == 0
  && (strEq (A.index ts k).kind "var" || strEq (A.index ts k).kind "con")
  && k + 1 < A.length ts
  && strEq (A.index ts (k + 1)).kind "sym"
  && isAnnText (A.index ts (k + 1)).text
    then prescanGo ts (k + 1) (Cons (A.index ts k).text acc)
  else prescanGo ts (k + 1) acc

prescan : Array L.Tok -> List String
prescan ts = prescanGo ts 0 Nil

-- Fixity declarations, read before the rest
--------------------------------------------------------------------------------

type FixDecl =
  { assoc : F.Assoc
  , ops : List L.Tok
  , above : List L.Tok
  , below : List L.Tok
  , errors : List Diag
  , span : Pm.Span
  }

restOfDecl : Array L.Tok -> Int -> List L.Tok -> List L.Tok
restOfDecl ts j acc =
  if j >= A.length ts then reverse acc
  else if strEq (A.index ts j).kind "eof"
  || ((A.index ts j).first && (A.index ts j).col == 0)
    then reverse acc
  else restOfDecl ts (j + 1) (Cons (A.index ts j) acc)

takeSyms : List L.Tok -> List L.Tok
takeSyms Nil = Nil
takeSyms (Cons u rest) =
  if strEq u.kind "sym" then Cons u (takeSyms rest) else Nil

dropN : {a : Type} -> Int -> List a -> List a
dropN n Nil = Nil
dropN n (Cons x rest) = if n <= 0 then Cons x rest else dropN (n - 1) rest

type AB = { above : List L.Tok, below : List L.Tok, errors : List Diag }

abGo : AB -> List L.Tok -> AB
abGo acc Nil = acc
abGo acc (Cons w tail) =
  if strEq w.kind "var" && strEq w.text "above"
    then abGo
        { above = appendS acc.above (takeSyms tail)
        , below = acc.below
        , errors = acc.errors
        }
        (dropN (length (takeSyms tail)) tail)
  else if strEq w.kind "var" && strEq w.text "below"
    then abGo
        { above = acc.above
        , below = appendS acc.below (takeSyms tail)
        , errors = acc.errors
        }
        (dropN (length (takeSyms tail)) tail)
  else { above = acc.above
       , below = acc.below
       , errors =
           Cons
             (diag
                (spanOf w)
                ("expected `above` or `below` and operators, not `"
                 ++ w.text
                 ++ "`"))
             acc.errors
       }

assocOf : String -> F.Assoc
assocOf "infixl" = AssocLeft
assocOf "infixr" = AssocRight
assocOf s = AssocNone

lastEnd : L.Tok -> List L.Tok -> Int
lastEnd t Nil = t.end
lastEnd t (Cons u Nil) = u.end
lastEnd t (Cons u rest) = lastEnd t rest

fixDeclDone : L.Tok -> List L.Tok -> List L.Tok -> AB -> FixDecl
fixDeclDone t rest ops r =
  { assoc = assocOf t.text
  , ops = ops
  , above = r.above
  , below = r.below
  , errors = reverse r.errors
  , span = mkSpan t.start (lastEnd t rest)
  }

fixDeclParts : L.Tok -> List L.Tok -> FixDecl
fixDeclParts t rest =
  fixDeclDone
    t
    rest
    (takeSyms rest)
    (abGo
       { above = Nil, below = Nil, errors = Nil }
       (dropN (length (takeSyms rest)) rest))

fixDeclOf : Array L.Tok -> Int -> L.Tok -> FixDecl
fixDeclOf ts k t = fixDeclParts t (restOfDecl ts (k + 1) Nil)

fixDeclAt : Array L.Tok -> Int -> L.Tok -> Maybe FixDecl
fixDeclAt ts k t =
  if t.first
  && t.col == 0
  && strEq t.kind "kw"
  && elemBy strEq t.text ["infixl", "infixr", "infix"]
    then Just (fixDeclOf ts k t)
  else Nothing

fixDecls : Array L.Tok -> Int -> List FixDecl -> List FixDecl
fixDecls ts k acc =
  if k >= A.length ts then reverse acc
  else case fixDeclAt ts k (A.index ts k) of
    Just d -> fixDecls ts (k + 1) (Cons d acc)
    Nothing -> fixDecls ts (k + 1) acc

groupOfDecl : FixDecl -> Maybe F.Group
groupOfDecl d = case d.ops of
  Nil -> Nothing
  Cons op rest ->
    Just
      { id = op.text
      , assoc = d.assoc
      , ops = map (\(u : L.Tok) -> u.text) d.ops
      }

mapMaybeG : {a : Type} -> (F.Group -> a) -> Maybe F.Group -> Maybe a
mapMaybeG f Nothing = Nothing
mapMaybeG f (Just g) = Just (f g)

mkEdge : String -> String -> F.Edge
mkEdge t l = { tighter = t, looser = l }

edgesOf : F.Fixities -> FixDecl -> List F.Edge
edgesOf scope d = case d.ops of
  Nil -> Nil
  Cons op rest ->
    appendS
      (catMaybesS
         (map
            (\(r : L.Tok) ->
               mapMaybeG (\g -> mkEdge op.text g.id) (F.groupOf scope r.text))
            d.above))
      (catMaybesS
         (map
            (\(r : L.Tok) ->
               mapMaybeG (\g -> mkEdge g.id op.text) (F.groupOf scope r.text))
            d.below))

anyS : {a : Type} -> (a -> Bool) -> List a -> Bool
anyS p Nil = False
anyS p (Cons x xs) = p x || anyS p xs

anyGroupHas : F.Fixities -> L.Tok -> L.Tok -> Bool
anyGroupHas all g u =
  anyS
    (\(h : F.Group) -> not (strEq h.id g.text) && elemBy strEq u.text h.ops)
    all.groups

cycleDiag : F.Fixities -> FixDecl -> List Diag
cycleDiag all d = case d.ops of
  Nil -> Nil
  Cons g rest ->
    appendS
      (map
         (\(u : L.Tok) ->
            diag
              (spanOf u)
              ("the fixity of `" ++ u.text ++ "` is declared twice"))
         (filter (\(u : L.Tok) -> anyGroupHas all g u) d.ops))
      (if F.bindsTighter all g.text g.text
         then Cons
             (diag
                d.span
                ("these fixities go round: `"
                 ++ g.text
                 ++ "` ends up above itself"))
             Nil
       else Nil)

noGroup : F.Fixities -> L.Tok -> Bool
noGroup scope u = case F.groupOf scope u.text of
  Just _ -> False
  Nothing -> True

fixDiagsOf : F.Fixities -> F.Fixities -> FixDecl -> List Diag
fixDiagsOf scope all d =
  appendS
    (map
       (\(u : L.Tok) ->
          diag (spanOf u) ("`" ++ u.text ++ "` is syntax, not an operator"))
       (filter (\(u : L.Tok) -> elemBy strEq u.text F.reserved) d.ops))
    (appendS
       (map
          (\(u : L.Tok) ->
             diag
               (spanOf u)
               ("`"
                ++ u.text
                ++ "` has no fixity to be above or below: declare it first"))
          (filter (\(u : L.Tok) -> noGroup scope u) (appendS d.above d.below)))
       (appendS
          (if length d.ops == 0
             then Cons
                 (diag
                    d.span
                    "a fixity declaration names its operators: `infixl + -`")
                 Nil
           else Nil)
          (appendS d.errors (cycleDiag all d))))

type FixRead = { fixities : F.Fixities, diags : List Diag }

fixityOut : F.Fixities -> List FixDecl -> List F.Group -> List F.Edge -> FixRead
fixityOut imported decls groups edges =
  { fixities = { groups = groups, above = edges }
  , diags =
      concatMapS
        (fixDiagsOf
           (F.union imported { groups = groups, above = Nil })
           (F.union imported { groups = groups, above = edges }))
        decls
  }

fixityDone : F.Fixities -> List FixDecl -> List F.Group -> FixRead
fixityDone imported decls groups =
  fixityOut
    imported
    decls
    groups
    (concatMapS
       (edgesOf (F.union imported { groups = groups, above = Nil }))
       decls)

fixityFrom : F.Fixities -> List FixDecl -> FixRead
fixityFrom imported decls =
  fixityDone
    imported
    decls
    (catMaybesS
       (map
          groupOfDecl
          (filter (\(d : FixDecl) -> not (length d.ops == 0)) decls)))

-- | the fixity declarations of a file, read before the rest
fixityDecls : F.Fixities -> Array L.Tok -> FixRead
fixityDecls imported ts = fixityFrom imported (fixDecls ts 0 Nil)

-- | a text's own fixities, read without the rest of it
fixitiesOfText : F.Fixities -> String -> F.Fixities
fixitiesOfText imported src =
  (fixityDecls imported (A.fromList (L.lex src).tokens)).fixities

-- The program loop
--------------------------------------------------------------------------------

type ProgRes = { items : List Item, diags : List Diag, broken : List String }

appendRev : {a : Type} -> List a -> List a -> List a
appendRev Nil acc = acc
appendRev (Cons x xs) acc = appendRev xs (Cons x acc)

brokenPlus : Maybe String -> List String -> List String
brokenPlus Nothing broken = broken
brokenPlus (Just x) broken = Cons x broken

mkProgRes : List Item -> List Diag -> List String -> ProgRes
mkProgRes items diags broken = { items = items, diags = diags, broken = broken }

-- | a declaration, lowered where nothing local is in scope
lowerDecl : C.D -> St -> Pair (Either Diag (List Item)) St
lowerDecl d s = lw.decl d (setScope Nil s)

-- | each declaration read (`cs`), then lowered (`s`); one that is wrong
-- | is passed over, the name it would define broken
progGo : C.St -> St -> List Item -> List Diag -> List String -> ProgRes
progGo cs s items diags broken =
  if C.textDone cs
    then mkProgRes (reverse items) (reverse diags) (reverse broken)
  else case C.declStep cs of
    MkPair (Left d) cs2 ->
      progGo
        (C.skipDecl cs2)
        s
        items
        (Cons d diags)
        (brokenPlus (C.declaredAt cs2) broken)
    MkPair (Right dc) cs2 -> case lowerDecl dc s of
      MkPair (Left d) s2 ->
        progGo
          (C.skipDecl cs2)
          s2
          items
          (Cons d diags)
          (brokenPlus (C.declaredAt cs2) broken)
      MkPair (Right ds) s2 ->
        if strEq (C.cur cs2).kind "eof"
          then progGo cs2 s2 (appendRev ds items) diags broken
        else progGo
            (C.skipDecl cs2)
            s2
            (appendRev ds items)
            (Cons
               (diag
                  (spanT (C.cur cs2))
                  ("unexpected `" ++ (C.cur cs2).text ++ "`"))
               diags)
            broken

-- Entry points
--------------------------------------------------------------------------------

type Options = { known : String -> Bool, fixities : F.Fixities, lenient : Bool }

type Read =
  { ntns : List Ntn
  , diags : List Diag
  , fixities : F.Fixities
  , broken : List String
  }

lexDiagOf : L.Err -> Diag
lexDiagOf e =
  { code = 150
  , severity = SError
  , msg = e.msg
  , span = { start = e.start, end = e.end }
  , note = Nothing
  }

initialSt : Options -> Array C.T -> List String -> F.Fixities -> St
initialSt o toks declared own =
  mkSt
    toks
    Nil
    (\x -> o.known x || elemBy strEq x declared)
    Nil
    Nil
    (F.union o.fixities own)
    o.lenient

readOut : List Diag -> FixRead -> ProgRes -> Read
readOut lexDiags own r =
  { ntns = assemble r.broken r.items
  , diags =
      appendS
        lexDiags
        (appendS own.diags (appendS r.diags (assembleDiags r.broken r.items)))
  , fixities = own.fixities
  , broken = r.broken
  }

readRun : Options -> Array C.T -> List Diag -> List String -> FixRead -> Read
readRun o toks lexDiags declared own =
  readOut
    lexDiags
    own
    (progGo
       (C.initialSt toks)
       (initialSt o toks declared own.fixities)
       Nil
       Nil
       Nil)

readToks : Options -> Array L.Tok -> Array C.T -> List Diag -> Read
readToks o ltoks toks lexDiags =
  readRun o toks lexDiags (prescan ltoks) (fixityDecls o.fixities ltoks)

readLexed : Options -> L.Lexed -> Read
readLexed o l =
  readToks o (A.fromList l.tokens) (Tk.plain l.tokens) (map lexDiagOf l.errors)

-- | `fixities`: those of what the file imports; the result's, the file's
-- | own.  `broken`: the declarations that do not parse.
readProgramWith : Options -> String -> Read
readProgramWith o src = readLexed o (L.lex src)

-- | the program, as declarations the elaborator takes
readProgram : (String -> Bool) -> String -> Read
readProgram known src =
  readProgramWith
    { known = known, fixities = F.emptyFixities, lenient = False }
    src

noKnown : String -> Bool
noKnown x = False

-- >>> length (readProgram noKnown "idInt : Int -> Int\nidInt x = x\n").ntns
-- 1

-- >>> length (readProgram noKnown "data Color = Red | Green\n\nnext : Color -> Color\nnext c = case c of\n  Red -> Green\n  Green -> Red\n").ntns
-- 2

-- >>> length (readProgram noKnown "x : Int\nx = ) oops\n").diags
-- 1
