-- The locals of a file, as written: each binder, and the names that
-- refer to it.  Read from the notation --
-- before the equations are compiled to matches, which merges the
-- variables of different equations into one -- by the scoping the
-- elaborator follows: a name refers to the nearest binder of it around
-- it, else to a global.
--
-- What binds: a lambda's parameters and a `case` alternative's, an
-- equation's patterns, `let p = e in e'`, `x <- e` and `let p = e` in a
-- `do` block (for the statements after it), a local definition of a
-- `where` (for itself, those after it and the equation's body), a named
-- argument of a function type (for what follows it), a definition's or a
-- theory's parameters (for what follows them); and
-- a signature's implicit arguments, which its equations are under.  A
-- record type's field is in scope for the fields after it: a use of one
-- is the field's (`fields`), not a local's.

import heff.notation
import heff.params as Pm
import prelude

-- | a local: its name, where its binder is, where it is used
type Local = { name : String, binder : Pm.Span, uses : List Pm.Span }

-- | a use of a record type's field among the fields after it (`t` of
-- | `m : t -> t`), and where the field is declared
type FieldUse = { name : String, field : Pm.Span, use : Pm.Span }

type Binder = { name : String, span : Pm.Span, field : Bool }

type Use = { binder : Binder, use : Pm.Span }

type Found = { binders : List Binder, uses : List Use }

type Locals = { locals : List Local, fields : List FieldUse }

none : Found
none = { binders = Nil, uses = Nil }

both : Found -> Found -> Found
both a b =
  { binders = concatList a.binders b.binders, uses = concatList a.uses b.uses }

bound : List Binder -> Found
bound bs = { binders = bs, uses = Nil }

binder : String -> Pm.Span -> Binder
binder name span = { name = name, span = span, field = False }

sameSpan : Pm.Span -> Pm.Span -> Bool
sameSpan a b = a.start == b.start && a.end == b.end

-- | binders in scope, the innermost first
scope : List Binder -> List Binder -> List Binder
scope bs env = foldl (\e b -> Cons b e) env bs

findBinder : String -> List Binder -> Maybe Binder
findBinder x Nil = Nothing
findBinder x (Cons b rest) =
  if strEq b.name x then Just b else findBinder x rest

-- | the variables a pattern binds (`_` binds nothing; a tag is no
-- | variable)
patternBinders : Ntn -> List Binder
patternBinders (At (Ident x) sp) = if strEq x "_" then Nil else [binder x sp]
patternBinders (At (NBrace p) _) = patternBinders p
patternBinders (At (NTuple ps) _) = concatMap patternBinders ps
patternBinders (At (NBlock "struct" _ fs) _) =
  concatMap patternBinders (map fieldPatOf fs)
patternBinders (At (Juxt a b) _) =
  concatList (patternBinders a) (patternBinders b)
patternBinders _ = Nil

isAlt : Ntn -> Bool
isAlt (At (Infix _ (At (Keyword "=>") _) _) _) = True
isAlt _ = False

isIdent : Ntn -> Bool
isIdent (At (Ident _) _) = True
isIdent _ = False

-- | a signature's implicit arguments, which its equations are under
implicitsOf : Ntn -> List Binder
implicitsOf (At (Infix (At (NBrace (At (Infix (At (Ident x) sp) (At (Keyword ":") _) _) _)) _) (At (Keyword "->") _) r) _) =
  Cons (binder x sp) (implicitsOf r)
implicitsOf _ = Nil

-- | the walk: a name's use, or what binds around what
type Walk =
  { walk : List Binder -> Ntn -> Found
  , doBlock : List Binder -> List Ntn -> Found
  , sigBlock : List Binder -> List Ntn -> Found
  }

walkAll : Walk -> List Binder -> List Ntn -> Found
walkAll w env ns = foldl (\acc x -> both acc (w.walk env x)) none ns

walkMaybe : Walk -> List Binder -> Maybe Ntn -> Found
walkMaybe w env (Just h) = w.walk env h
walkMaybe w env Nothing = none

under : Walk -> List Binder -> List Binder -> Ntn -> Found
under w env bs r = both (bound bs) (w.walk (scope bs env) r)

-- (a field's name, set or declared, is no use of anything)
fieldSetting : Walk -> List Binder -> Ntn -> Found
fieldSetting w env (At (Infix (At (Ident _) _) (At (Keyword ":=") _) e) _) =
  w.walk env e
fieldSetting w env f = w.walk env f

-- | the name a local definition (`where`) binds
localBinders : Ntn -> List Binder
localBinders n = case defEqnsOf n of
  Just d -> [binder d.name d.span]
  Nothing -> Nil

-- (an equation's head, the definition's name: a use of it)
headUse : List Binder -> Ntn -> Found
headUse env eq = case Pm.nodeOf eq of
  Infix l op _ ->
    if isKeyword ":=" op
      then (case Pm.nodeOf (getGroup l).head of
            Ident f -> case findBinder f env of
              Just b ->
                { binders = Nil
                , uses = [{ binder = b, use = Pm.spanOf (getGroup l).head }]
                }
              Nothing -> none
            _ -> none)
    else none
  _ -> none

-- | a local definition: its signature, then its equations under the
-- | signature's implicit arguments
localDefF : Walk -> List Binder -> Ntn -> Found
localDefF w env n = case defEqnsOf n of
  Just d ->
    both
      (w.walk env d.ty)
      (foldl
         (\acc eq ->
            both
              acc
              (both
                 (headUse env eq)
                 (w.walk (scope (implicitsOf d.ty) env) eq)))
         none
         d.eqs)
  Nothing -> w.walk env n

-- | an equation's `where`: each local definition in scope in itself,
-- | those after it and the equation's body
localsF : Walk -> List Binder -> List Ntn -> Maybe Ntn -> Found
localsF w env Nil body = walkMaybe w env body
localsF w env (d :: ds) body =
  both
    (bound (localBinders d))
    (both
       (localDefF w (scope (localBinders d) env) d)
       (localsF w (scope (localBinders d) env) ds body))

walkF : Walk -> List Binder -> Ntn -> Found
walkF w env n = case n of
  At (Ident x) sp -> case findBinder x env of
    Just b -> { binders = Nil, uses = [{ binder = b, use = sp }] }
    Nothing -> none
  -- a lambda with its binder annotated, `\(x : T) -> e`: `T` is outside
  At (Infix (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _) (At (Keyword "=>") _) r) _ ->
    both (w.walk env a) (under w env [binder x sp] r)
  -- a lambda, a `case` alternative
  At (Infix l (At (Keyword "=>") _) r) _ -> under w env (patternBinders l) r
  -- an equation: its head is the definition's name, its arguments
  -- patterns; a named argument of a function type
  At (Infix l (At (Keyword ":=") _) r) _ ->
    if isIdent (getGroup l).head
      then under w env (concatMap patternBinders (getGroup l).args) r
    else both (w.walk env l) (w.walk env r)
  At (Infix (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _) (At (Keyword "->") _) r) _ ->
    both (w.walk env a) (under w env [binder x sp] r)
  At (Infix (At (NBrace (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _)) _) (At (Keyword "->") _) r) _ ->
    both (w.walk env a) (under w env [binder x sp] r)
  At (NBlock "do" h stmts) _ -> both (walkMaybe w env h) (w.doBlock env stmts)
  At (NBlock "local" body defs) _ -> localsF w env defs body
  At (NBlock "struct" h fs) _ ->
    both
      (walkMaybe w env h)
      (foldl (\acc f -> both acc (fieldSetting w env f)) none fs)
  At (NBlock "sig" h fs) _ -> both (walkMaybe w env h) (w.sigBlock env fs)
  At (Infix l op r) _ ->
    both (w.walk env l) (both (w.walk env op) (w.walk env r))
  At (Juxt a b) _ -> both (w.walk env a) (w.walk env b)
  At (NBlock _ h ns) _ -> both (walkMaybe w env h) (walkAll w env ns)
  At (MDecl _ _ x) _ -> w.walk env x
  At (NTuple ns) _ -> walkAll w env ns
  At (NBrace x) _ -> w.walk env x
  _ -> none

-- | `x <- e`: `x` is bound for the statements after it
doBlockF : Walk -> List Binder -> List Ntn -> Found
doBlockF w env Nil = none
doBlockF w env (Cons (At (Infix (At (Ident x) sp) (At (Keyword "<-") _) e) _) rest) =
  both
    (w.walk env e)
    (both (bound [binder x sp]) (w.doBlock (Cons (binder x sp) env) rest))
-- (`let p = e`: `p`'s variables, for the statements after it)
doBlockF w env (Cons (At (NBlock "let" (Just e) (Cons p Nil)) lsp) rest) =
  if isAlt p
    then both
        (w.walk env (At (NBlock "let" (Just e) (Cons p Nil)) lsp))
        (w.doBlock env rest)
  else both
      (w.walk env e)
      (both
         (bound (patternBinders p))
         (w.doBlock (scope (patternBinders p) env) rest))
doBlockF w env (Cons s rest) = both (w.walk env s) (w.doBlock env rest)

-- | a record type's fields: each in scope for those after it
sigBlockF : Walk -> List Binder -> List Ntn -> Found
sigBlockF w env Nil = none
sigBlockF w env (Cons (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _) rest) =
  both
    (w.walk env a)
    (both
       (bound [{ name = x, span = sp, field = True }])
       (w.sigBlock (Cons { name = x, span = sp, field = True } env) rest))
sigBlockF w env (Cons f rest) = both (w.walk env f) (w.sigBlock env rest)

walker : Walk
walker =
  { walk = \env n -> walkF walker env n
  , doBlock = \env ns -> doBlockF walker env ns
  , sigBlock = \env ns -> sigBlockF walker env ns
  }

-- | a definition's or theory's argument, as written: a name, perhaps
-- | annotated
type Argument = { binder : Binder, ty : Maybe Ntn }

namedArg : Ntn -> Maybe Argument
namedArg (At (Ident x) sp) = Just { binder = binder x sp, ty = Nothing }
namedArg (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _) =
  Just { binder = binder x sp, ty = Just a }
namedArg (At (NBrace (At (Infix (At (Ident x) sp) (At (Keyword ":") _) a) _)) _) =
  Just { binder = binder x sp, ty = Just a }
namedArg _ = Nothing

-- | each argument in scope for those after it, then what follows them
arguments : List Binder -> List Ntn -> List Ntn -> Found
arguments env Nil rest = walkAll walker env rest
arguments env (Cons a tl) rest = case namedArg a of
  -- (an argument's type is in the scope of those before it)
  Just arg ->
    both
      (walkMaybe walker env arg.ty)
      (both (bound [arg.binder]) (arguments (Cons arg.binder env) tl rest))
  Nothing -> both (walker.walk env a) (arguments env tl rest)

-- | a declaration: its signature, then its equations under the
-- | signature's implicit arguments
declaration : Ntn -> Found
declaration n = case n of
  At (MDecl _ "def" (At (Infix (At (Ident _) _) (At (Keyword ":") _) (At (Juxt ty (At (NBlock "where" Nothing eqs) _)) _)) _)) _ ->
    -- (the implicit arguments are bound in the signature, which walks
    -- them)
    both
      (walker.walk Nil ty)
      (foldl
         (\acc eq -> both acc (walker.walk (scope (implicitsOf ty) Nil) eq))
         none
         eqs)
  -- a definition with named arguments (`data Pair a b = ...`): each in
  -- scope for those after it, the type, and the body
  At (MDecl _ "def" (At (Infix (At (Infix h (At (Keyword ":") _) ty) _) (At (Keyword ":=") _) body) _)) _ ->
    if isIdent (getGroup h).head then arguments Nil (getGroup h).args [ty, body]
    else walker.walk Nil n
  -- a theory's parameters (`theory SET a`)
  At (MDecl _ "theory" (At (Infix h (At (Keyword ":=") _) body) _)) _ ->
    if isIdent (getGroup h).head then arguments Nil (getGroup h).args [body]
    else walker.walk Nil n
  At (MDecl _ _ x) _ -> walker.walk Nil x
  _ -> walker.walk Nil n

usesOf : List Use -> Binder -> List Pm.Span
usesOf us b =
  map
    (\(u : Use) -> u.use)
    (filter (\(u : Use) -> sameSpan u.binder.span b.span) us)

mkLocal : List Use -> Binder -> Local
mkLocal us b = { name = b.name, binder = b.span, uses = usesOf us b }

mkFieldUse : Use -> FieldUse
mkFieldUse u = { name = u.binder.name, field = u.binder.span, use = u.use }

localsOf : Found -> Locals
localsOf found =
  { locals =
      map
        (\b -> mkLocal found.uses b)
        (filter (\(b : Binder) -> not b.field) found.binders)
  , fields =
      map
        (\u -> mkFieldUse u)
        (filter (\(u : Use) -> u.binder.field) found.uses)
  }

-- | the locals of a file, and the uses of record fields among the
-- | fields after them
locals : List Ntn -> Locals
locals ntns = localsOf (foldl (\acc n -> both acc (declaration n)) none ntns)
