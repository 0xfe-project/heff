-- The presyntax: what the elaborator reads, as the lowering
-- (`heff.surface`) gives it -- which names are variables and which are
-- tags, operators bound as the fixities say, the sugar taken apart,
-- signatures met with their equations.  Each node is `P.Spanned`: where
-- it is written.
--
-- Types are defined one after another, so what an expression holds is
-- parametric in the expression (`e`), and `ExprF` closes the knot.  Some
-- constructors are notation that has no reading where it is (`ETuple`,
-- `EBrace`, `EBracket`, `ENamed` outside an application, the `Bad...`
-- ones): elaboration says so, where it is.

import heff.params as P
import prelude

-- | the syntax's own words, written where a name could be: the built-in
-- | types and `abandon`
data SyntaxWord
  = TypeWord
  | IntWord
  | FloatWord
  | StringWord
  | ArrayWord
  | AbandonWord

-- Patterns
--------------------------------------------------------------------------------

-- | `x = p`, a field of a record pattern
data FieldPat p = MkFieldPat String p

-- | `PatTag`'s and `PatOp`'s span is the tag's or the operator's;
-- | `PatOp`, an operator applied, is the tag it is another name for once
-- | elaboration knows which
data PatF
  = PatVar String
  | PatTag String P.Span (List (P.Spanned PatF))
  | PatOp String P.Span (List (P.Spanned PatF))
  | PatInt Int
  | PatFloat Float
  | PatString String
  | PatRecord (List (FieldPat (P.Spanned PatF)))
  | PatWord SyntaxWord

type Pat = P.Spanned PatF

-- What an expression holds
--------------------------------------------------------------------------------

-- | a lambda's binder, `x`, `{x}` or `(x : T)`: the name, where it is
data LamBinder e
  = LamName String P.Span
  | LamImplicit String P.Span
  | LamAnn String P.Span e

-- | a function type's binder, `(x : A)`, `{x : A}`, `{{x : A}}`, or a
-- | type alone: the name, where it is, where the braces are, its type
data PiBinder e
  = PiNamed String P.Span e
  | PiImplicit String P.Span P.Span e
  | PiInstance String P.Span P.Span e
  | PiAnon e

-- | `p -> e`
data Alt e = MkAlt Pat e

-- | a statement of a `do` block: `x <- e`, `let p = e`, `e`
data Stmt e = StmtBind String P.Span e | StmtLet Pat e | StmtExpr e

-- | `x : A` in a record type
data FieldDecl e = DeclareField String P.Span e | BadFieldDecl e

-- | `x = e` in a record
data FieldSet e = SetField String P.Span e | BadFieldSet e

-- | `C A B`, an alternative of a sum type: the tag, where it is, the
-- | types of its arguments
data Variant e = TagVariant String P.Span (List e) | BadVariant e

-- | a parameter of a type or a theory, `a`, `(x : T)` or `{x : T}`
data Param e = ExplicitParam String P.Span e | ImplicitParam String P.Span e

-- | `f p ... = e`: the name, where it is, the patterns, the body
data Equation e = MkEquation String P.Span (List Pat) e

-- | a declaration: a definition by equations (its name, where it is, its
-- | type, its equations); a `data` or `type` (its parameters, its
-- | universe, its body); a `theory` (its parameters, its fields, a
-- | `ESig`); a primitive; a test; a watch
data DeclF e
  = DeclEquations String P.Span e (List (P.Spanned (Equation e)))
  | DeclDefine String P.Span (List (P.Spanned (Param e))) e e
  | DeclTheory String P.Span (List (P.Spanned (Param e))) e
  | DeclPrimitive String P.Span e
  | DeclTest String P.Span
  | DeclWatch e

-- Expressions
--------------------------------------------------------------------------------

-- | `EApp`'s arguments are its spine, `e.x` (`EProject`) and `(x := e)`
-- | (`ENamed`) among them; `ESpec`, `e ~ { x = v }` (the field, where its
-- | setting is, the value), `ESpecOther`, `e ~ e'`; `ELetIn`, `let p = e
-- | in e'`; `ELocal`, an equation's body and its local definitions
data ExprF
  = EVar String
  | ETag String
  | EInt Int
  | EFloat Float
  | EString String
  | EWord SyntaxWord
  | EApp (P.Spanned ExprF) (List (P.Spanned ExprF))
  | EProject String
  | ENamed String (P.Spanned ExprF)
  | EPi (PiBinder (P.Spanned ExprF)) (P.Spanned ExprF)
  | ELam (LamBinder (P.Spanned ExprF)) (P.Spanned ExprF)
  | EAnn (P.Spanned ExprF) (P.Spanned ExprF)
  | ESpec (P.Spanned ExprF) String P.Span (P.Spanned ExprF)
  | ESpecOther (P.Spanned ExprF) (P.Spanned ExprF)
  | ESig (List (P.Spanned (FieldDecl (P.Spanned ExprF))))
  | ESum (List (P.Spanned (Variant (P.Spanned ExprF))))
  | EStruct (List (P.Spanned (FieldSet (P.Spanned ExprF))))
  | EMatch (P.Spanned ExprF) (List (P.Spanned (Alt (P.Spanned ExprF))))
  | ELetIn (P.Spanned ExprF) (P.Spanned (Alt (P.Spanned ExprF)))
  | EDo (List (P.Spanned (Stmt (P.Spanned ExprF))))
  | ELocal (P.Spanned ExprF) (List (P.Spanned (DeclF (P.Spanned ExprF))))
  | ETuple (List (P.Spanned ExprF))
  | EBrace (P.Spanned ExprF)
  | EBracket (P.Spanned ExprF)

type Expr = P.Spanned ExprF

type Decl = P.Spanned (DeclF Expr)

-- Building
--------------------------------------------------------------------------------

-- | from the start of one to the end of the other
spanning : P.Span -> P.Span -> P.Span
spanning a b = { start = a.start, end = b.end }

-- (the last of `xs`, or `z` if there is none)
lastOr : {a : Type} -> a -> List a -> a
lastOr z Nil = z
lastOr z (Cons x Nil) = x
lastOr z (Cons x xs) = lastOr z xs

-- | `f` applied to `args`: an application's spine is one, however it is
-- | written (`(f x) y` is `f x y`)
app : Expr -> List Expr -> Expr
app f Nil = f
app (At (EApp h xs) sp) args =
  At (EApp h (concatList xs args)) (spanning sp (P.spanOf (lastOr h args)))
app f args = At (EApp f args) (spanning (P.spanOf f) (P.spanOf (lastOr f args)))

-- | an expression as a head applied to a spine (no spine, if it is no
-- | application)
type Spine = { head : Expr, args : List Expr }

spineOf : Expr -> Spine
spineOf (At (EApp h xs) _) = { head = h, args = xs }
spineOf e = { head = e, args = Nil }

-- | a pattern as a head applied to its arguments
type PatSpine = { head : Pat, args : List Pat }

-- (a tag applied, or an operator: the head keeps the tag's or the
-- operator's span)
patSpineOf : Pat -> PatSpine
patSpineOf (At (PatTag t tsp ps) _) =
  { head = At (PatTag t tsp Nil) tsp, args = ps }
patSpineOf (At (PatOp x xsp ps) _) = { head = At (PatVar x) xsp, args = ps }
patSpineOf p = { head = p, args = Nil }

-- | `C ps`, its span from the tag to the last pattern
patTag : String -> P.Span -> List Pat -> Pat
patTag t tsp ps =
  At (PatTag t tsp ps) (spanning tsp (P.spanOf (lastOr (At (PatVar t) tsp) ps)))

-- | `op ps`, its span from the operator to the last pattern
patOp : String -> P.Span -> List Pat -> Pat
patOp x xsp ps =
  At (PatOp x xsp ps) (spanning xsp (P.spanOf (lastOr (At (PatVar x) xsp) ps)))

-- | `p -> e`, from the pattern to the body
alt : Pat -> Expr -> P.Spanned (Alt Expr)
alt p e = At (MkAlt p e) (spanning (P.spanOf p) (P.spanOf e))

-- | `\x -> e`, from the binder to the body
lamName : String -> P.Span -> Expr -> Expr
lamName x xsp e = At (ELam (LamName x xsp) e) (spanning xsp (P.spanOf e))

-- | `e : T`, from the one to the other
ann : Expr -> Expr -> Expr
ann e t = At (EAnn e t) (spanning (P.spanOf e) (P.spanOf t))

-- | the name a declaration defines (a watch defines none)
declName : Decl -> Maybe String
declName d = case P.nodeOf d of
  DeclEquations f _ _ _ -> Just f
  DeclDefine x _ _ _ _ -> Just x
  DeclTheory x _ _ _ -> Just x
  DeclPrimitive x _ _ -> Just x
  DeclTest x _ -> Just x
  DeclWatch _ -> Nothing

-- >>> (spineOf (app (app (At (EVar "f") P.noSpan) [At (EVar "x") P.noSpan]) [At (EVar "y") P.noSpan])).args
-- [At (EVar "x") { start = 0, end = 0 }, At (EVar "y") { start = 0, end = 0 }]
