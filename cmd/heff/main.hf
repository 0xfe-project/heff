-- The compiler, run: a Node.js program (`heff compile cmd/heff/main.hf
-- OUT.mjs --name main --backend=node`), `heff` itself -- compiled by itself, from the seed
-- boot/heff.mjs (scripts/build.mjs).  Its command line is read by
-- std.cli (`commands`, below), and each command's work is the package's
-- (`heff.commands`).  Besides the commands the usage
-- shows, `dump-core FILE...` reads the files given in dependency
-- order, elaborates them, and prints every definition's stored core, and
-- `dump-eval FILE` prints what each definition of FILE evaluates to (the
-- interpreter's values, which the tests hold the backend to).

import co
import heff.commands
import heff.lsp as Lsp
import heff.report as Rp
import heff.rpc as Rpc
import prelude
import std.cli as Cli
import std.filesystem
import std.io
import std.process

world : HFunctor
world = stdio <+> process <+> fs <+> Rp.report <+> Rpc.rpc

-- each computation of the program asks for the effects it has, in any
-- world they are in; their evidence is given once, by `main`, below

-- The command line
--------------------------------------------------------------------------------

-- | `heff compile FILE OUT --backend=MODE [--name NAME]`
compileWith : {e : HFunctor}
            -> {{io : stdio <: e}}
            -> {{sys : process <: e}}
            -> {{disk : fs <: e}}
            -> String
            -> String
            -> Maybe String
            -> String
            -> Co e Unit
compileWith file outPath name backend =
  compileTo { file = file, outPath = outPath, name = name, backend = backend }

-- | the language server, on stdin/stdout (the flags clients add,
-- | `--stdio` say, are passed over: it is all there is)
lspCmd : {e : HFunctor}
       -> {{sys : process <: e}}
       -> {{disk : fs <: e}}
       -> {{wire : Rpc.rpc <: e}}
       -> List String
       -> Co e Unit
lspCmd flags = do
  h <- hostNow
  Lsp.serve h

-- heff's commands, as types: what each takes, for any result `r` -- the
-- program is one handler of them, the watches below another.  They are
-- in groups by what they are given to run: only the tools talk to an
-- editor.

-- | building and checking files
type Build (r : Type) =
  { check : String -> r
  , run : String -> List String -> r
  , tests : Maybe String -> List String -> r
  , promote : String -> r
  , compile : String -> String -> Maybe String -> String -> r
  , explain : String -> r
  , typeAt : String -> List String -> r
  , fmt : Bool -> List String -> r
  }

-- | the project, and its packages
type Project (r : Type) =
  { init : Maybe String -> r, get : Maybe String -> r, publish : String -> r }

-- | the language server, and the compiler's own doors
type Tool (r : Type) =
  { lsp : List String -> r
  , dumpCore : List String -> r
  , dumpEval : String -> r
  }

type Commands (r : Type) =
  { build : Build r, project : Project r, tool : Tool r }

hf : Cli.Complete
hf = 'files ".hf"

buildCommands : {r : Type} -> Build r -> List (Cli.Command r)
buildCommands c =
  [ Cli.command
    "check"
    "elaborate FILE and what it imports; print its interface"
    (\s -> Cli.with1 s c.check (Cli.arg s "FILE" hf))
  , Cli.command
    "run"
    "run FILE's main with ARGS, compiled for Node.js"
    (\s -> Cli.with2 s c.run (Cli.arg s "FILE" hf) (Cli.rest s "ARGS"))
  , Cli.command
    "test"
    "check the watches' expectations (the `-- ...` lines under them), and run the tests (the definitions of type `Test`, lib/check.hf)"
    (\s ->
       Cli.with2
         s
         c.tests
         (Cli.option
            s
            "seed"
            "s"
            "N"
            "the seed the properties draw from (the same seed, the same runs)")
         (Cli.some s "FILE" hf))
  , Cli.command
    "promote"
    "write each watch's value under it as its expectation"
    (\s -> Cli.with1 s c.promote (Cli.arg s "FILE" hf))
  , Cli.command
    "compile"
    "FILE as JavaScript, by MODE: esm (an ES module), page (a script running the app NAME in a page), node (a Node.js program running NAME)"
    (\s ->
       Cli.with4
         s
         c.compile
         (Cli.arg s "FILE" hf)
         (Cli.arg s "OUT" 'none)
         (Cli.option s "name" "n" "NAME" "the computation run (page, node)")
         (Cli.choose
            s
            "backend"
            "b"
            "MODE"
            "what it is compiled to"
            ["esm", "page", "node"]))
  , Cli.command
    "explain"
    "the elaboration trace"
    (\s -> Cli.with1 s c.explain (Cli.arg s "FILE" hf))
  , Cli.command
    "type-at"
    "what the name at each OFFSET resolved to, and its type, a line each"
    (\s ->
       Cli.with2 s c.typeAt (Cli.arg s "FILE" hf) (Cli.some s "OFFSET" 'none))
  , Cli.command
    "fmt"
    "format FILEs in place"
    (\s ->
       Cli.with2
         s
         c.fmt
         (Cli.switch s "check" "c" "only say which are not formatted")
         (Cli.some s "FILE" hf))
  ]

projectCommands : {r : Type} -> Project r -> List (Cli.Command r)
projectCommands c =
  [ Cli.command
    "init"
    "a new project in DIR (here, without it)"
    (\s -> Cli.with1 s c.init (Cli.optional s "DIR" 'dirs))
  , Cli.command
    "get"
    "fetch what the project requires, writing heff.sum; with PATH, require it (at VERSION, else its newest) first"
    (\s -> Cli.with1 s c.get (Cli.optional s "PATH[@VERSION]" 'none))
  , Cli.command
    "publish"
    "check the project, then tag it vVERSION and push the tag"
    (\s -> Cli.with1 s c.publish (Cli.arg s "VERSION" 'none))
  ]

toolCommands : {r : Type} -> Tool r -> List (Cli.Command r)
toolCommands c =
  [ Cli.command
    "lsp"
    "a language server, on stdin/stdout"
    (\s -> Cli.with1 s c.lsp (Cli.rest s "FLAGS"))
  , Cli.hidden "dump-core" (\s -> Cli.with1 s c.dumpCore (Cli.many s "FILE" hf))
  , Cli.hidden "dump-eval" (\s -> Cli.with1 s c.dumpEval (Cli.arg s "FILE" hf))
  ]

commands : {r : Type} -> Commands r -> List (Cli.Command r)
commands c =
  concatList
    (buildCommands c.build)
    (concatList (projectCommands c.project) (toolCommands c.tool))

build : {e : HFunctor}
      -> {{io : stdio <: e}}
      -> {{sys : process <: e}}
      -> {{disk : fs <: e}}
      -> {{rep : Rp.report <: e}}
      -> Build (Co e Unit)
build =
  { check = checkCmd
  , run = runCmd
  , tests = \seed files ->
      testCmd
        (seedOf seed)
        files
        { total = 0, failed = 0, ok = True, tests = 0, testsFailed = 0 }
  , promote = promoteCmd
  , compile = compileWith
  , explain = explainCmd
  , typeAt = typeAtCmd
  , fmt = fmtCmd
  }

project : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> Project (Co e Unit)
project =
  { init = \dir -> initCmd (fromMaybe "." dir)
  , get = getCmd
  , publish = publishCmd
  }

tool : {e : HFunctor}
     -> {{io : stdio <: e}}
     -> {{sys : process <: e}}
     -> {{disk : fs <: e}}
     -> {{wire : Rpc.rpc <: e}}
     -> Tool (Co e Unit)
tool = { lsp = lspCmd, dumpCore = selfcheck, dumpEval = evalCmd }

-- (what a command line is read as, said: for the watches)
said : Commands String
said =
  { build =
      { check = \f -> "check " ++ f
      , run = \f as -> "run " ++ f ++ " [" ++ joinWith "," as ++ "]"
      , tests = \sd fs -> "test " ++ fromMaybe "-" sd ++ " " ++ joinWith "," fs
      , promote = \f -> "promote " ++ f
      , compile = \f o n b ->
            "compile " ++ f ++ " " ++ o ++ " " ++ fromMaybe "-" n ++ " " ++ b
      , explain = \f -> "explain " ++ f
      , typeAt = \f os -> "type-at " ++ f ++ " " ++ joinWith "," os
      , fmt = \c fs ->
            "fmt " ++ (if c then "--check " else "") ++ joinWith "," fs
      }
  , project =
      { init = \d -> "init " ++ fromMaybe "." d
      , get = \p -> "get " ++ fromMaybe "-" p
      , publish = \v -> "publish " ++ v
      }
  , tool =
      { lsp = \fs -> "lsp " ++ joinWith "," fs
      , dumpCore = \fs -> "dump-core " ++ joinWith "," fs
      , dumpEval = \f -> "dump-eval " ++ f
      }
  }

-- >>> Cli.readLine "heff" (commands said) ["compile", "a.hf", "-bnode", "a.mjs"]
-- 'run "compile a.hf a.mjs - node"

-- >>> Cli.readLine "heff" (commands said) ["run", "main.hf", "--verbose", "x"]
-- 'run "run main.hf [--verbose,x]"

-- >>> Cli.readLine "heff" (commands said) ["fmt", "src", "-c", "test"]
-- 'run "fmt --check src,test"

-- >>> Cli.readLine "heff" (commands said) ["init"]
-- 'run "init ."

-- >>> Cli.readLine "heff" (commands said) ["lsp", "--stdio"]
-- 'run "lsp --stdio"

-- >>> Cli.readLine "heff" (commands said) ["type-at", "a.hf", "3", "17"]
-- 'run "type-at a.hf 3,17"

-- | heff: its commands, given what they are to run with
program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{disk : fs <: e}}
        -> {{rep : Rp.report <: e}}
        -> {{wire : Rpc.rpc <: e}}
        -> Co e Unit
program = do
  as <- args
  case Cli.readLine
      "heff"
      (commands { build = build, project = project, tool = tool })
      as of
    'run act -> act
    'out text -> write text
    'fail text -> do
      writeErr text
      exit 1

-- | where the world is: each sub-effect's evidence, given
main : Co world Unit
main =
  program
    (io := \p -> InL (InL (InL (InL p))))
    (sys := \p -> InL (InL (InL (InR p))))
    (disk := \p -> InL (InL (InR p)))
    (rep := \p -> InL (InR p))
    (wire := \p -> InR p)
