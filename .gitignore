# dependencies
node_modules

# the documentation's site: what `npm run build` makes, astro's cache
docs/dist/
docs/.astro/

# all heff makes: the compiler built (.heff/out/), its cache (.heff/vN/),
# the programs `heff build` makes (.heff/bin/, their C in .heff/build/),
# the tests' work directories (.heff/ref/), and zig's own cache of the
# parts it builds (.heff/zig-cache/); and the projects within this one (examples/NAME/,
# test/modules/) each their own, in their .heff/
.heff/

# zig's: the build's cache (.zig-cache/), and where `zig build`
# would install (zig-out/)
.zig-cache/
zig-out/

# what `nix build` links to: heff built by the flake
result
result-*
