# dependencies
node_modules

# all heff makes: the compiler built (.heff/out/), its cache (.heff/vN/),
# the programs `heff build` makes (.heff/bin/, their C in .heff/build/),
# the example apps (.heff/examples/), and the tests' work directories
# (.heff/ref/); and the projects within this one (examples/NAME/,
# test/modules/) each their own, in their .heff/
.heff/
