# dependencies
node_modules

# all heff makes: the compiler built (.heff/out/), its cache (.heff/vN/),
# the programs `heff build` makes (.heff/bin/, their C in .heff/build/),
# the example apps (.heff/examples/), the tests' work directories
# (.heff/ref/), and zig's own cache of the parts it builds
# (.heff/zig-cache/); and the projects within this one (examples/NAME/,
# test/modules/) each their own, in their .heff/
.heff/

# zig's: the build's cache, with scripts/bootstrap.zig built
# (.zig-cache/), and where `zig build` would install (zig-out/)
.zig-cache/
zig-out/
