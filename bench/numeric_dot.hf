-- The dot product of two flat arrays of ten million `Float64`s, as tail
-- recursion over the index, repeated: two loads, a multiplication and an
-- addition each round.

module bench.numeric_dot

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 100

dotFrom : Array Float64 -> Array Float64 -> Int -> Float64 -> Float64
dotFrom xs ys i acc =
  if i < Array.length xs
  then dotFrom
      xs
      ys
      (i + 1)
      (acc + Array.arrayIndex xs i * Array.arrayIndex ys i)
  else acc

repeat : Array Float64 -> Array Float64 -> Int -> Float64 -> Float64
repeat xs ys r acc =
  if r <= 0 then acc else repeat xs ys (r - 1) (dotFrom xs ys 0 acc)

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  ys <- pure (Array.generate size (\i -> toFloat (i % 7) * 0.5))
  print (ev := _) (show (repeat xs ys rounds 0.0))
