-- Behaviours, by boc, the runtime's effect: a tree of them, each on a
-- cown of its own, spawning eight more to a depth of six -- 262144
-- leaves, each a behaviour on one cown they share, which counts them.
-- The leaves come from paths with no order between them, so they
-- contend for the one cown as they are ready.

module bench.boc_tree

import boc as BOC
import co
import std.io

-- | `k` nodes of depth `d`: leaves counted on the shared cown, or
-- | behaviours on a cown of their own, each spawning eight of depth
-- | one less
nodes : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> BOC.Cown Int -> Int -> Int -> Co e Unit
nodes shared d k =
  if k <= 0 then pure ()
  else do
    if d <= 0 then BOC.when shared (\n -> pure (n + 1))
    else do
      own <- BOC.newCown d
      BOC.when own (\x -> do
        nodes shared (d - 1) 8
        pure x)
    nodes shared d (k - 1)

main : Co (BOC.boc <+> stdio) Unit
main = do
  shared <- BOC.newCown 0
  nodes shared 6 1
  print "tree"
