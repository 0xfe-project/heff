-- A loop of state operations, handled in the language: the handler's
-- monad is a pure state, `Int -> Pair a Int`; and a thousand of them as a
-- benchmark of its own, which `heff bench` runs.

module bench.state

import bench as Bench
import co
import state
import std.io

-- | `n` rounds of get and put.
loop : {e : HFunctor} -> {{ct : state Int <: e}} -> Int -> Co e Unit
loop n =
  if n <= 0 then pure MkUnit
  else do
    x <- get
    put (x + 1)
    loop (n - 1)

counting : Handler (state Int)
counting =
  { M = \a -> Int -> Pair a Int
  , ret = \x s -> MkPair x s
  , bind = \m k s -> case m s of
      MkPair x s2 -> k x s2
  , malg = \p s -> case p of
      Get k -> MkPair (k s) s
      Put s2 x -> MkPair x s2
  }

-- | a thousand rounds of get and put, handled
states : Bench.Bench
states =
  Bench.bench
    "a thousand gets and puts"
    (\n ->
       Bench.times
         n
         (\i ->
            handle
              counting
              (loop (ct := here (state Int)) (Bench.keep 1000))
              0))

main : Co stdio Unit
main = case handle counting (loop (ct := here (state Int)) 1000000) 0 of
  MkPair u n -> print (ev := here stdio) (show n)
