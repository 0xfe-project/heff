-- A sum of `Int64`s over a flat array of ten million, as tail recursion
-- over the index, repeated: fixed-width integers, wrapping around, no
-- check for overflow -- the integer loop a C compiler can vectorise.

module bench.numeric_sum_int64

import co
import std.io
import array as Array
import int64 as Int64

size : Int
size = 10000000

rounds : Int
rounds = 100

sumFrom : Array Int64 -> Int -> Int64 -> Int64
sumFrom xs i acc =
  if i < Array.length xs then sumFrom xs (i + 1) (acc + Array.arrayIndex xs i)
  else acc

repeat : Array Int64 -> Int -> Int64 -> Int64
repeat xs r acc = if r <= 0 then acc else repeat xs (r - 1) (sumFrom xs 0 acc)

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> Int64.fromInt (i % 1000)))
  print (ev := here stdio) (show (repeat xs rounds 0))
