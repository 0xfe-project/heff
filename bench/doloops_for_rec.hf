-- `doloops_for`'s `sumEvens` written by hand, as plain tail recursion
-- over the list and over the array's index: the baseline the desugared
-- loops are measured against.

module bench.doloops_for_rec

import co
import std.io
import array

sumEvensList : {e : HFunctor}
             -> {{io : stdio <: e}}
             -> Int
             -> List Int
             -> Co e Int
sumEvensList total Nil = do
  print ("total " ^ show total)
  pure total
sumEvensList total (Cons x xs) =
  if x % 2 /= 0 then sumEvensList total xs
  else if x > 1000000000
  then do
    print ("total " ^ show total)
    pure total
  else if x < 0 then pure (0 - 1)
  else sumEvensList (total + x) xs

sumEvensArray : {e : HFunctor}
              -> {{io : stdio <: e}}
              -> Int
              -> Int
              -> Array Int
              -> Co e Int
sumEvensArray total i arr =
  if i >= arrayLength arr
  then do
    print ("total " ^ show total)
    pure total
  else let x = arrayIndex arr i
       in if x % 2 /= 0 then sumEvensArray total (i + 1) arr
       else if x > 1000000000
       then do
         print ("total " ^ show total)
         pure total
       else if x < 0 then pure (0 - 1)
       else sumEvensArray (total + x) (i + 1) arr

numbers : Int -> List Int -> List Int
numbers n acc = if n <= 0 then acc else numbers (n - 1) (Cons n acc)

main : Co stdio Unit
main = do
  xs <- pure (numbers 10000000 Nil)
  a <- sumEvensList (io := here stdio) 0 xs
  b <- sumEvensArray (io := here stdio) 0 0 (arrayFromList xs)
  print (ev := here stdio) (show (a == b))
