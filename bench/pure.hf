-- A loop with no effect at all, for the others to be measured against;
-- and the loop as a benchmark of its own, which `heff bench` runs.

module bench.pure

import bench as Bench
import co
import std.io

count : Int -> Int -> Int
count acc n = if n <= 0 then acc else count (acc + 1) (n - 1)

-- | a thousand rounds of the loop, each counted (`keep`: its bound not
-- | known to the compiler, which would count it once)
counting : Bench.Bench
counting =
  Bench.bench
    "count to a thousand"
    (\n -> Bench.times n (\i -> count 0 (Bench.keep 1000)))

main : Co stdio Unit
main = print (ev := here stdio) (show (count 0 1000000))
