-- `doloops_for`'s `sumEvens` written with `do`'s statements (#86): a
-- `let mut`, `for` over the prelude's `Iterate` (a list's, an array's),
-- `continue`, `break` and an early `return`.  What the desugaring gives
-- is measured against `doloops_for_join` (the same, desugared by hand)
-- and `doloops_for_rec` (plain recursion).

import co
import std.io
import array

sumEvensList : {e : HFunctor} -> {{io : stdio <: e}} -> List Int -> Co e Int
sumEvensList xs = do
  let mut total = 0
  for x in xs do
    if x % 2 /= 0 then continue
    if x > 1000000000 then break
    if x < 0 then return (0 - 1)
    total := total + x
  print ("total " ^ show total)
  return total

sumEvensArray : {e : HFunctor} -> {{io : stdio <: e}} -> Array Int -> Co e Int
sumEvensArray xs = do
  let mut total = 0
  for x in xs do
    if x % 2 /= 0 then continue
    if x > 1000000000 then break
    if x < 0 then return (0 - 1)
    total := total + x
  print ("total " ^ show total)
  return total

numbers : Int -> List Int -> List Int
numbers n acc = if n <= 0 then acc else numbers (n - 1) (Cons n acc)

main : Co stdio Unit
main = do
  xs <- pure (numbers 10000000 Nil)
  a <- sumEvensList (io := here stdio) xs
  b <- sumEvensArray (io := here stdio) (arrayFromList xs)
  print (ev := here stdio) (show (a == b))
