-- `doloops_float_do`'s sum written by hand, as plain tail recursion over
-- the array's index: the baseline the desugared loop is measured
-- against.

module bench.doloops_float_rec

import co
import std.io
import array

sumFrom : Int -> Float64 -> Array Float64 -> Float64
sumFrom i acc xs =
  if i >= arrayLength xs then acc
  else sumFrom (i + 1) (acc + arrayIndex xs i) xs

sumFloats : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Array Float64
          -> Co e Float64
sumFloats xs = pure (sumFrom 0 0.0 xs)

-- (the array added up `n` times)
rounds : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> Int
       -> Float64
       -> Array Float64
       -> Co e Float64
rounds n acc xs =
  if n <= 0 then pure acc
  else do
    t <- sumFloats xs
    rounds (n - 1) (acc + t) xs

main : Co stdio Unit
main = do
  xs <- pure (arrayGenerate 1000000 (\i -> floatFromInt (i % 1000) * 0.5))
  t <- rounds (io := _) 100 0.0 xs
  print (ev := _) (debug t)
