-- The loop of `doloops_while` with no effect in it: what it counts, then
-- one print.  What the `Co` loops are measured against.

module bench.doloops_while_pure

import co
import std.io

count : Int -> Int -> Pair Int Int
count hits i =
  if i <= 0 then MkPair hits i
  else count (if i % 100000 == 0 then hits + 1 else hits) (i - 1)

main : Co stdio Unit
main = case count 0 10000000 of
  MkPair hits i -> print (ev := here stdio) (show hits ^ " " ^ show i)
