-- Behaviours, by boc, the runtime's effect: four producers, each a
-- behaviour on no cown, send ten million messages in all to four
-- consumers, a message a behaviour on the consumer's cown, which counts
-- it.  Each producer, done, adds itself to a count of those done, and
-- the fourth to do so spawns a last behaviour on the four consumers,
-- which prints what they counted: in the paper's causality, that one
-- comes after every message, as each producer's last messages are
-- known to the behaviour counting it done, and so to the ones after it
-- on that cown.

module bench.boc_producer_consumer

import boc as BOC
import co
import std.io

-- | a message to the consumer `c`: one more counted
sent : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> BOC.Cown Int -> Co e Unit
sent c = BOC.when c (\n -> pure (n + 1))

-- | `n` rounds of a message to each consumer
produce : {e : HFunctor}
        -> {{bc : BOC.boc <: e}}
        -> BOC.Cown Int
        -> BOC.Cown Int
        -> BOC.Cown Int
        -> BOC.Cown Int
        -> Int
        -> Co e Unit
produce c0 c1 c2 c3 n =
  if n <= 0 then pure ()
  else do
    sent c0
    sent c1
    sent c2
    sent c3
    produce c0 c1 c2 c3 (n - 1)

-- | a producer: its rounds, then counted done; the fourth done prints
-- | what the consumers counted
producer : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{io : stdio <: e}}
         -> BOC.Cown Int
         -> BOC.Cown Int
         -> BOC.Cown Int
         -> BOC.Cown Int
         -> BOC.Cown Int
         -> Int
         -> Co e Unit
producer c0 c1 c2 c3 done rounds =
  BOC.task (do
    produce c0 c1 c2 c3 rounds
    with d := done do
      let k = d + 1
      d := k
      if k == 4
      then BOC.when (c0, c1, c2, c3) (\(a, b, c, dd) -> do
        print (debug (a + b + c + dd))
        pure (a, b, c, dd))
      else pure ())

main : Co (BOC.boc <+> stdio) Unit
main = do
  c0 <- BOC.newCown 0
  c1 <- BOC.newCown 0
  c2 <- BOC.newCown 0
  c3 <- BOC.newCown 0
  done <- BOC.newCown 0
  producer c0 c1 c2 c3 done 625000
  producer c0 c1 c2 c3 done 625000
  producer c0 c1 c2 c3 done 625000
  producer c0 c1 c2 c3 done 625000
