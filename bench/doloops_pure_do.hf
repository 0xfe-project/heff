-- `doloops_pure`'s `firstNegative` written with `do`'s statements
-- (#86): `run do` over the identity monad, a `for` over an array and an
-- early `return`.  Measured against `doloops_pure`'s `firstJoin`
-- (desugared by hand) and `firstRec` (plain recursion).

import co
import std.io
import array

firstNegative : Array Int -> Maybe Int
firstNegative a = run do
  for x in a do
    if x < 0 then return (Just x)
  return Nothing

size : Int
size = 10000000

-- | each `rounds` times over an array of `size`
rounds : Int
rounds = 10

times : Int -> (Unit -> Maybe Int) -> Int -> Int
times n f acc =
  if n <= 0 then acc
  else times (n - 1) f (case f MkUnit of
    Just x -> acc + x
    Nothing -> acc)

main : Co stdio Unit
main = do
  a <- pure (arrayGenerate size (\i -> if i == size - 1 then 0 - 1 else i))
  print (ev := here stdio) (show (times rounds (\u -> firstNegative a) 0))
