-- A loop of operations the world does: a cell's read and write, each
-- performed by its provider.

module bench.reference

import co
import std.io
import std.reference

world : HFunctor
world = reference Int <+> stdio

loop : {e : HFunctor}
     -> {{cell : reference Int <: e}}
     -> Reference Int
     -> Int
     -> Co e Unit
loop r n =
  if n <= 0 then pure MkUnit
  else do
    x <- readReference r
    writeReference r (x + 1)
    loop r (n - 1)

prog : {e : HFunctor}
     -> {{cell : reference Int <: e}}
     -> {{io : stdio <: e}}
     -> Co e Unit
prog = do
  r <- newReference 0
  loop r 1000000
  x <- readReference r
  print (show x)

main : Co world Unit
main =
  prog (cell := inl (reference Int) stdio) (io := inr (reference Int) stdio)
