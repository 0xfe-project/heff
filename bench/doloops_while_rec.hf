-- The loop of `doloops_while`, written as plain tail recursion in `Co`:
-- the baseline its desugaring is measured against.

import co
import std.io

loop : {e : HFunctor} -> {{ev : stdio <: e}} -> Int -> Co e Unit
loop i =
  if i <= 0 then print (show i)
  else do
    if i % 100000 == 0 then print (show i) else pure MkUnit
    loop (i - 1)

main : Co stdio Unit
main = loop (ev := here stdio) 10000000
