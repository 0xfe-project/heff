-- `doloops_for`'s `sumEvens`, desugared the other way: no step built
-- and matched, but `continue`, `break` and `return` each the call it
-- leads to where it is written -- the next turn, what follows the loop,
-- or `pure` of the answer -- so a turn's arms are the loop's.

import co
import std.io
import array

theory Iterate (c : Type) (a : Type) where
  Cursor : Type
  start : c -> Cursor
  next : Cursor -> Maybe (Pair a Cursor)

instance instanceIterateList : {a : Type} -> Iterate (List a) a
instanceIterateList = { Cursor = List a, start = begin, next = step }
  where
  begin : List a -> List a
  begin xs = xs
  step : List a -> Maybe (Pair a (List a))
  step Nil = Nothing
  step (Cons x xs) = Just (MkPair x xs)

-- | An array's cursor is its index (with the array).
instance instanceIterateArray : {a : Type} -> Iterate (Array a) a
instanceIterateArray = { Cursor = Pair (Array a) Int, start = begin, next = step }
  where
  begin : Array a -> Pair (Array a) Int
  begin arr = MkPair arr 0
  step : Pair (Array a) Int -> Maybe (Pair a (Pair (Array a) Int))
  step (MkPair arr i) =
    if i < arrayLength arr then Just (MkPair (arrayIndex arr i) (MkPair arr (i + 1)))
    else Nothing

sumEvensList : {e : HFunctor} -> {{io : stdio <: e}} -> List Int -> Co e Int
sumEvensList xs = loop (it.start xs) 0
  where
  it : Iterate (List Int) Int
  it = instanceIterateList
  after : Int -> Co e Int
  after total = bind (print ("total " ^ show total)) (\u -> pure total)
  loop : it.Cursor -> Int -> Co e Int
  loop cur total = case it.next cur of
    Nothing -> after total
    Just (MkPair x rest) ->
      if x % 2 /= 0 then loop rest total
      else if x > 1000000000 then after total
      else if x < 0 then pure (0 - 1)
      else loop rest (total + x)

sumEvensArray : {e : HFunctor} -> {{io : stdio <: e}} -> Array Int -> Co e Int
sumEvensArray xs = loop (it.start xs) 0
  where
  it : Iterate (Array Int) Int
  it = instanceIterateArray
  after : Int -> Co e Int
  after total = bind (print ("total " ^ show total)) (\u -> pure total)
  loop : it.Cursor -> Int -> Co e Int
  loop cur total = case it.next cur of
    Nothing -> after total
    Just (MkPair x rest) ->
      if x % 2 /= 0 then loop rest total
      else if x > 1000000000 then after total
      else if x < 0 then pure (0 - 1)
      else loop rest (total + x)

numbers : Int -> List Int -> List Int
numbers n acc = if n <= 0 then acc else numbers (n - 1) (Cons n acc)

main : Co stdio Unit
main = do
  xs <- pure (numbers 10000000 Nil)
  a <- sumEvensList (io := here stdio) xs
  b <- sumEvensArray (io := here stdio) (arrayFromList xs)
  print (ev := here stdio) (show (a == b))
