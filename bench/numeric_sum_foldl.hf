-- A sum of `Float64`s over a flat array of ten million, by the array
-- library's left fold with an addition, repeated: the fold's function
-- called each round, against the same sum as plain tail recursion.

module bench.numeric_sum_foldl

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 100

repeat : Array Float64 -> Int -> Float64 -> Float64
repeat xs r acc =
  if r <= 0 then acc
  else repeat xs (r - 1) (Array.foldl (\s x -> s + x) acc xs)

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  print (ev := here stdio) (show (repeat xs rounds 0.0))
