-- A map over a flat array of ten million `Float64`s, `x * 0.5 + 1.0`, by
-- the array library's `map` (an array made anew by `generate`), repeated
-- on its own result, then summed: a fresh array each round, its function
-- called for each element.

module bench.numeric_map

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 20

repeat : Int -> Array Float64 -> Array Float64
repeat r xs =
  if r <= 0 then xs else repeat (r - 1) (Array.map (\x -> x * 0.5 + 1.0) xs)

sumFrom : Array Float64 -> Int -> Float64 -> Float64
sumFrom xs i acc =
  if i < Array.length xs then sumFrom xs (i + 1) (acc + Array.arrayIndex xs i)
  else acc

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  print (ev := _) (debug (sumFrom (repeat rounds xs) 0 0.0))
