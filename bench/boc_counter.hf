-- Behaviours, by boc, the runtime's effect: a million on one cown,
-- spawned by `main` one after another, each adding 1, and a last one
-- that prints the count -- which comes after all of them, spawned after
-- them by the same `main`.

module bench.boc_counter

import boc as BOC
import co
import std.io

-- | `n` behaviours on `c`, each adding 1
adding : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> BOC.Cown Int -> Int -> Co e Unit
adding c n =
  if n <= 0 then pure ()
  else do
    BOC.when c (\x -> pure (x + 1))
    adding c (n - 1)

main : Co (BOC.boc <+> stdio) Unit
main = do
  c <- BOC.newCown 0
  adding c 1000000
  BOC.when c (\x -> do
    print (debug x)
    pure x)
