-- String workloads, for `heff bench`: a string's tail taken again and
-- again (a parser's loop), slices short and long, splitting it into
-- lines and words, joining and concatenating, a map over strings, and
-- short strings made, compared and sorted.  A program too: its tails
-- and lines, counted.

import bench as Bench
import co
import std.io

-- (a text of `n` lines, of 40 bytes or so each)
textOf : Int -> String
textOf n =
  unlines
    (List.map
       (\i -> "line " ^ show i ^ " of the text, and a few words")
       (List.range 1 n))

-- (the tails of `s`, `k` bytes dropped at each, until none: how many)
tails : Int -> String -> Int -> Int
tails k s acc =
  if strLength s == 0 then acc
  else tails k (strSlice s k (strLength s)) (acc + 1)

-- (the lines of `s`, each its first line, then the rest: how many)
linesByRest : String -> Int -> Int
linesByRest s acc =
  let j = strFind "\n" s 0
  in if j < 0 then acc + 1
  else linesByRest (strSlice s (j + 1) (strLength s)) (acc + 1)

-- (the bytes of `s` from `i`, `w` at a time: the sum of the slices' first bytes)
pieces : String -> Int -> Int -> Int -> Int
pieces s w i acc =
  if i + w > strLength s then acc
  else pieces s w (i + w) (acc + strByteAt (strSlice s i (i + w)) 0)

-- (`n` pieces, each appended to the one before)
appended : Int -> String -> String
appended n acc = if n <= 0 then acc else appended (n - 1) (acc ^ "piece, ")

text4k : String
text4k = textOf 100

text64k : String
text64k = textOf 1600

tailing : Bench.Bench
tailing =
  Bench.group
    "tail"
    [ Bench.bench
      "4KiB by 1"
      (\n -> Bench.times n (\i -> tails 1 (Bench.keep text4k) 0))
    , Bench.bench
      "64KiB by 64"
      (\n -> Bench.times n (\i -> tails 64 (Bench.keep text64k) 0))
    , Bench.bench
      "64KiB by line"
      (\n -> Bench.times n (\i -> linesByRest (Bench.keep text64k) 0))
    ]

slicing : Bench.Bench
slicing =
  Bench.group
    "slice"
    [ Bench.bench
      "8B of 64KiB"
      (\n -> Bench.times n (\i -> pieces (Bench.keep text64k) 8 0 0))
    , Bench.bench
      "1KiB of 64KiB"
      (\n -> Bench.times n (\i -> pieces (Bench.keep text64k) 1024 0 0))
    , Bench.bench
      "startsWith"
      (\n ->
         Bench.times
           n
           (\i ->
              List.length
                (List.filter
                   (\l -> startsWith "line 1" l)
                   (lines (Bench.keep text4k)))))
    ]

splitting : Bench.Bench
splitting =
  Bench.group
    "split"
    [ Bench.bench
      "lines 64KiB"
      (\n -> Bench.times n (\i -> List.length (lines (Bench.keep text64k))))
    , Bench.bench
      "words 4KiB"
      (\n -> Bench.times n (\i -> List.length (words (Bench.keep text4k))))
    , Bench.bench
      "trim"
      (\n ->
         Bench.times
           n
           (\i ->
              List.sum
                (List.map
                   (\l -> strLength (trim ("  " ^ l ^ " ")))
                   (lines (Bench.keep text4k)))))
    ]

concatenating : Bench.Bench
concatenating =
  Bench.group
    "concat"
    [ Bench.bench
      "append 1000"
      (\n -> Bench.times n (\i -> strLength (appended (Bench.keep 1000) "")))
    , Bench.bench
      "unlines 4KiB"
      (\n -> Bench.times n (\i -> strLength (textOf (Bench.keep 100))))
    , Bench.bench
      "join lines"
      (\n ->
         Bench.times
           n
           (\i -> strLength (joinWith ", " (lines (Bench.keep text4k)))))
    ]

mapping : Bench.Bench
mapping =
  Bench.group
    "map"
    [ Bench.bench
      "suffix"
      (\n ->
         Bench.times
           n
           (\i ->
              List.length
                (List.map (\l -> l ^ "!") (lines (Bench.keep text4k)))))
    , Bench.bench
      "length"
      (\n ->
         Bench.times
           n
           (\i -> List.sum (List.map strLength (lines (Bench.keep text4k)))))
    ]

shortStrings : Bench.Bench
shortStrings =
  Bench.group
    "short"
    [ Bench.bench
      "show"
      (\n ->
         Bench.times
           n
           (\i ->
              List.sum
                (List.map
                   (\k -> strLength (show k))
                   (List.range 1 (Bench.keep 1000)))))
    , Bench.bench
      "equal"
      (\n ->
         Bench.times
           n
           (\i ->
              List.length
                (List.filter
                   (\w -> strEq w "text,")
                   (words (Bench.keep text4k)))))
    , Bench.bench
      "sort"
      (\n ->
         Bench.times
           n
           (\i -> List.length (List.sort (words (Bench.keep text4k)))))
    , Bench.bench
      "bytes"
      (\n ->
         Bench.times
           n
           (\i ->
              List.sum
                (List.map (\w -> strByteAt w 0) (words (Bench.keep text4k)))))
    ]

main : Co stdio Unit
main =
  print
    (ev := here stdio)
    (show (tails 1 (textOf 400) 0 + linesByRest (textOf 4000) 0))
