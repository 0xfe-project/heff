-- A loop of operations the world does: a cell's read and write, each
-- performed by its provider (bench/run.mjs).

import co
import std.io
import std.ref

world : HFunctor
world = ref Int <+> stdio

loop : {e : HFunctor} -> {{cell : ref Int <: e}} -> Ref Int -> Int -> Co e Unit
loop r n =
  if n <= 0 then pure MkUnit
  else do
    x <- readRef r
    writeRef r (x + 1)
    loop r (n - 1)

prog : {e : HFunctor}
     -> {{cell : ref Int <: e}}
     -> {{io : stdio <: e}}
     -> Co e Unit
prog = do
  r <- newRef 0
  loop r 1000000
  x <- readRef r
  print (show x)

main : Co world Unit
main = prog (cell := inl (ref Int) stdio) (io := inr (ref Int) stdio)
