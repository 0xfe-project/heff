-- saxpy, `y := a * x + y`, over flat arrays of ten million `Float64`s,
-- in place by the array library's `set` (the array held once, so
-- changed where it is), repeated, then summed: each round a uniqueness
-- check, the array perhaps moved, so far.

module bench.numeric_saxpy

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 100

saxpyFrom : Float64 -> Array Float64 -> Int -> Array Float64 -> Array Float64
saxpyFrom a xs i ys =
  if i < Array.length xs
  then saxpyFrom
      a
      xs
      (i + 1)
      (Array.set ys i (a * Array.arrayIndex xs i + Array.arrayIndex ys i))
  else ys

repeat : Float64 -> Array Float64 -> Int -> Array Float64 -> Array Float64
repeat a xs r ys =
  if r <= 0 then ys else repeat a xs (r - 1) (saxpyFrom a xs 0 ys)

sumFrom : Array Float64 -> Int -> Float64 -> Float64
sumFrom xs i acc =
  if i < Array.length xs then sumFrom xs (i + 1) (acc + Array.arrayIndex xs i)
  else acc

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  ys <- pure (Array.generate size (\i -> toFloat (i % 7) * 0.5))
  print (ev := _) (show (sumFrom (repeat 0.5 xs rounds ys) 0 0.0))
