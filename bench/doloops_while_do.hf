-- `doloops_while`'s loop written with `do`'s statements (#86): a `let
-- mut` and a `while` in `Co`, printing every 100000th turn.  Measured
-- against `doloops_while` (desugared by hand) and `doloops_while_rec`.

module bench.doloops_while_do

import co
import std.io

prog : {e : HFunctor} -> {{ev : stdio <: e}} -> Int -> Co e Unit
prog n = do
  let mut i = n
  while i > 0 do
    if i % 100000 == 0 then print (debug i)
    i := i - 1
  print (debug i)

main : Co stdio Unit
main = prog (ev := _) 10000000
