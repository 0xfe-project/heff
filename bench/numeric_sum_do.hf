-- A sum of `Float64`s over a flat array of ten million, written with
-- `do`'s statements, a `let mut` total and `for` over the array,
-- repeated: what the desugared loop costs against the same sum as plain
-- tail recursion (the total kept in a box each round, so far).

module bench.numeric_sum_do

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 50

sumDo : {e : HFunctor} -> Array Float64 -> Float64 -> Co e Float64
sumDo xs start = do
  let mut total = start
  for x in xs do
    total := total + x
  return total

repeat : {e : HFunctor} -> Array Float64 -> Int -> Float64 -> Co e Float64
repeat xs r acc =
  if r <= 0 then pure acc
  else do
    s <- sumDo xs acc
    repeat xs (r - 1) s

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  total <- repeat xs rounds 0.0
  print (ev := _) (debug total)
