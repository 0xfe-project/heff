-- A `do` block's `for` adding up an array's `Float64`s, its total
-- handed on to what the block does after the loop: the total is kept a
-- `double` on each round, boxed once, as it leaves the loop.  Measured
-- against `doloops_float_rec` (the same, by plain tail recursion).

module bench.doloops_float_do

import co
import std.io
import array

sumFloats : {e : HFunctor}
          -> {{io : stdio <: e}}
          -> Array Float64
          -> Co e Float64
sumFloats xs = do
  let mut total = 0.0
  for x in xs do
    total := total + x
  return total

-- (the array added up `n` times)
rounds : {e : HFunctor}
       -> {{io : stdio <: e}}
       -> Int
       -> Float64
       -> Array Float64
       -> Co e Float64
rounds n acc xs =
  if n <= 0 then pure acc
  else do
    t <- sumFloats xs
    rounds (n - 1) (acc + t) xs

main : Co stdio Unit
main = do
  xs <- pure (arrayGenerate 1000000 (\i -> floatFromInt (i % 1000) * 0.5))
  t <- rounds (io := _) 100 0.0 xs
  print (ev := _) (debug t)
