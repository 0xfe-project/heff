-- Pure code's `run do` (#86): `firstNegative` over the identity monad,
-- desugared by hand -- as `doloops_for`, with a step (`firstStep`), and
-- as `doloops_for_join`, with `return` the call it leads to
-- (`firstJoin`) -- and written by hand as plain tail recursion
-- (`firstRec`), over an array whose one negative is its last.
--
--   firstNegative a = run do
--     for x in a do
--       if x < 0 then return (Just x)
--     return Nothing

import co
import std.io
import array

-- | The identity monad: a value is its computation.
type Id a = a

run : {a : Type} -> Id a -> a
run x = x

idPure : {a : Type} -> a -> Id a
idPure x = x

idBind : {a b : Type} -> Id a -> (a -> Id b) -> Id b
idBind x f = f x

theory Iterate (c : Type) (a : Type) where
  Cursor : Type
  start : c -> Cursor
  next : Cursor -> Maybe (Pair a Cursor)

-- | An array's cursor is its index (with the array).
instance instanceIterateArray : {a : Type} -> Iterate (Array a) a
instanceIterateArray =
  { Cursor = Pair (Array a) Int, start = begin, next = step }
  where
  begin : Array a -> Pair (Array a) Int
  begin arr = MkPair arr 0
  step : Pair (Array a) Int -> Maybe (Pair a (Pair (Array a) Int))
  step (MkPair arr i) =
    if i < arrayLength arr
    then Just (MkPair (arrayIndex arr i) (MkPair arr (i + 1)))
    else Nothing

data Step v r = Continue v | Break v | Return r

firstStep : Array Int -> Maybe Int
firstStep a = run (loop (it.start a))
  where
  it : Iterate (Array Int) Int
  it = instanceIterateArray
  loop : it.Cursor -> Id (Maybe Int)
  loop cur = case it.next cur of
    Nothing -> idPure Nothing
    Just (MkPair x rest) ->
      idBind
        (if x < 0 then idPure (Return (Just x))
         else idPure (Continue MkUnit) :
             Id (Step Unit (Maybe Int))) (\s -> case s of
      Continue u -> loop rest
      Break u -> idPure Nothing
      Return r -> idPure r)

firstJoin : Array Int -> Maybe Int
firstJoin a = run (loop (it.start a))
  where
  it : Iterate (Array Int) Int
  it = instanceIterateArray
  loop : it.Cursor -> Id (Maybe Int)
  loop cur = case it.next cur of
    Nothing -> idPure Nothing
    Just (MkPair x rest) -> if x < 0 then idPure (Just x) else loop rest

firstRec : Int -> Array Int -> Maybe Int
firstRec i a =
  if i >= arrayLength a then Nothing
  else if arrayIndex a i < 0 then Just (arrayIndex a i)
  else firstRec (i + 1) a

size : Int
size = 10000000

-- | each `rounds` times over an array of `size`
rounds : Int
rounds = 10

times : Int -> (Unit -> Maybe Int) -> Int -> Int
times n f acc =
  if n <= 0 then acc
  else times (n - 1) f (case f MkUnit of
    Just x -> acc + x
    Nothing -> acc)

main : Co stdio Unit
main = do
  a <- pure (arrayGenerate size (\i -> if i == size - 1 then 0 - 1 else i))
  print (ev := here stdio) (show (times rounds (\u -> firstStep a) 0))
  print (ev := here stdio) (show (times rounds (\u -> firstJoin a) 0))
  print (ev := here stdio) (show (times rounds (\u -> firstRec 0 a) 0))
