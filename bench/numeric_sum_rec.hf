-- A sum of `Float64`s over a flat array of ten million, as plain tail
-- recursion over the index, repeated: the loop a C compiler can
-- vectorise, the baseline the other ways of writing a sum are measured
-- against.

module bench.numeric_sum_rec

import co
import std.io
import array as Array

size : Int
size = 10000000

rounds : Int
rounds = 100

sumFrom : Array Float64 -> Int -> Float64 -> Float64
sumFrom xs i acc =
  if i < Array.length xs then sumFrom xs (i + 1) (acc + Array.arrayIndex xs i)
  else acc

repeat : Array Float64 -> Int -> Float64 -> Float64
repeat xs r acc = if r <= 0 then acc else repeat xs (r - 1) (sumFrom xs 0 acc)

main : Co stdio Unit
main = do
  xs <- pure (Array.generate size (\i -> toFloat (i % 1000) * 0.001))
  print (ev := _) (debug (repeat xs rounds 0.0))
