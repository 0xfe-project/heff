-- Behaviours, by boc, the runtime's effect: 900 thousand, each on a
-- cown of its own made just before it, spawned by `main` one after
-- another, each adding 1 to what its cown holds.

module bench.boc_spawn

import boc as BOC
import co
import std.io

-- | `n` behaviours, each on a new cown
spawned : {e : HFunctor} -> {{bc : BOC.boc <: e}} -> Int -> Co e Unit
spawned n =
  if n <= 0 then pure ()
  else do
    c <- BOC.newCown n
    BOC.when c (\x -> pure (x + 1))
    spawned (n - 1)

main : Co (BOC.boc <+> stdio) Unit
main = do
  spawned 900000
  print "spawned"
