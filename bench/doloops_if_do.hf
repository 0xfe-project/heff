-- A `run do` loop whose body has an `if` statement, both arms setting
-- variables, and more statements after it than the simplifier copies
-- into the arms: what the `if` gives back is the variables set in each
-- arm, no join point calling the loop (which made one `$cycle` of them,
-- its numbers boxed).

module bench.doloops_if_do

import co
import std.io

work : Int -> Int
work n = run do
  let mut i = 0
  let mut a = 0
  let mut b = 0
  let mut c = 0
  let mut d = 0
  while i < n do
    i := i + 1
    if i % 4 == 0
    then do
      a := (a + 3) % 1024
      b := (b + 5) % 4096
    else do
      c := (c + 7) % 2048
      d := (d + 1) % 512
    a := (a + i) % 1024
    b := (b + i) % 4096
    c := (c + i) % 2048
    d := (d + i) % 512
    a := (a * 3 + 1) % 1024
    b := (b * 5 + 1) % 4096
    c := (c * 3 + 2) % 2048
    d := (d * 5 + 3) % 512
  return a + b + c + d

main : Co stdio Unit
main = print (ev := _) (show (work 100000000))
