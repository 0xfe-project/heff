-- A `while` in `Co`, desugared by hand as #86 decides: the loop a local
-- tail-recursive function through `bind`, each `let mut` a parameter,
-- and what follows the loop a continuation of the variables.
--
--   prog n = do
--     let mut i = n
--     while i > 0 do
--       if i % 100000 == 0 then print (show i)
--       i := i - 1
--     print (show i)

module bench.doloops_while

import co
import std.io

prog : {e : HFunctor} -> {{ev : stdio <: e}} -> Int -> Co e Unit
prog n = loop n
  where
  after : Int -> Co e Unit
  after i = print (show i)
  loop : Int -> Co e Unit
  loop i =
    if i > 0
    then bind
        (if i % 100000 == 0 then print (show i) else pure MkUnit)
        (\u -> loop (i - 1))
    else after i

main : Co stdio Unit
main = prog (ev := _) 10000000
