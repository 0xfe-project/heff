-- A GPU as an effect: a device held by a `with`, buffers on it held by
-- `with`s of their own, written and read, a kernel loaded from its
-- code, and a kernel dispatched over a grid of workgroups with buffers
-- bound.  Each operation's answer goes to its continuation, as
-- std.filesystem's do, since a GPU finishes later: a dispatch's
-- continuation is called when the GPU is done with it.  Import it by a
-- name, `import browser.gpu as Gpu`.
--
-- The first provider is WebGPU's (a page's): a kernel is WGSL, its
-- buffers bound at `@group(0)`, the first at `@binding(0)`, the next at
-- `@binding(1)`.  Native ones (Vulkan, Metal, CUDA's driver API) are to
-- come with the C backend.
--
-- A device, a buffer and a pipeline are the host's own things, foreign
-- values.  The device is had by `withDevice`, at the top of a program
-- (it lives as long as the program draws), a buffer by `withBuffer`
-- inside it, each a `With` in a region of its own, so that neither
-- leaves the body that has it: the device is closed, the buffer let go
-- of, when its body ends.  A pipeline is the device's: `load` gives it
-- as a value, there is nothing to let go of (WebGPU frees it with its
-- device), and it is dispatched anywhere in the device's body -- given
-- to a device that is closed, the host refuses it.  The buffers bound
-- to a dispatch are each in a region of their own, so a dispatch takes
-- them one by one, `dispatch1` to `dispatch3`, as browser.gpu.kernel's kernels
-- are of one to three.  An operation that fails gives a value, an
-- `Either GpuError a`, with what the host says of it: a buffer too
-- large, a kernel's code that does not compile (its messages, each with
-- its line).  A device not opened, a buffer not made, is no answer of
-- the body its `with` runs, so it is thrown, over the `exception`
-- effect: no GPU here, say -- a browser without WebGPU throws its
-- `GpuError` at `withDevice`.
--
-- browser.gpu.canvas shows a buffer on a `<canvas>`; browser.gpu.kernel
-- writes a kernel in heff, not as WGSL text, browser.gpu.wgsl prints it,
-- and browser.gpu.run runs it with typed buffers.  heff's pages examples
-- have `vecadd`, adding two vectors on the GPU, and `pixels`, drawing a
-- gradient.

module browser.gpu
  ( Device
  , Buffer
  , Pipeline
  , GpuError
  , GpuF(..)
  , gpu
  , withDevice
  , withBuffer
  , writeBuffer
  , readBuffer
  , load
  , dispatch1
  , dispatch2
  , dispatch3
  , showError
  )

import co
import exception
import resource

-- | A GPU opened: the host's own, had as a `With s Device` by
-- | `withDevice`'s body.
data Device

-- | A buffer of bytes on a GPU, a kernel's storage: the host's own, had
-- | as a `With s Buffer` by `withBuffer`'s body.
data Buffer

-- | A kernel loaded on a GPU, ready to be dispatched: the device's, as
-- | long as the device is.
data Pipeline

-- | Why an operation failed, as the host says it.
type GpuError = { message : String }

data GpuF (m : Type -> Type) x
  = Open (Either GpuError Device -> x)
  | Close Device (Either GpuError Unit -> x)
  | NewBuffer Device Int (Either GpuError Buffer -> x)
  | FreeBuffer Buffer (Either GpuError Unit -> x)
  | WriteBuffer Device Buffer Int Bytes (Either GpuError Unit -> x)
  | ReadBuffer Device Buffer Int Int (Either GpuError Bytes -> x)
  | Load Device String String (Either GpuError Pipeline -> x)
  | Dispatch Device Pipeline (List Buffer) Int Int Int (Either GpuError Unit
                                                        -> x)

-- | A GPU as an effect.
gpu : HFunctor
gpu =
  { f = GpuF
  , hfmap = \m g p -> case p of
      Open k -> Open (\r -> g (k r))
      Close d k -> Close d (\r -> g (k r))
      NewBuffer d n k -> NewBuffer d n (\r -> g (k r))
      FreeBuffer b k -> FreeBuffer b (\r -> g (k r))
      WriteBuffer d b at bs k -> WriteBuffer d b at bs (\r -> g (k r))
      ReadBuffer d b at n k -> ReadBuffer d b at n (\r -> g (k r))
      Load d code entry k -> Load d code entry (\r -> g (k r))
      Dispatch d pl bs x y z k -> Dispatch d pl bs x y z (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      Open k -> Open k
      Close d k -> Close d k
      NewBuffer d size k -> NewBuffer d size k
      FreeBuffer b k -> FreeBuffer b k
      WriteBuffer d b at bs k -> WriteBuffer d b at bs k
      ReadBuffer d b at size k -> ReadBuffer d b at size k
      Load d code entry k -> Load d code entry k
      Dispatch d pl bs x y z k -> Dispatch d pl bs x y z k
  }

-- (the GPU opened, the host's own, or why there is none)
opened : {e : HFunctor} -> {{ev : gpu <: e}} -> Co e (Either GpuError Device)
opened = op (ev (Open (\r -> r))) val

-- (a device closed: what was on it is gone)
closed : {e : HFunctor}
       -> {{ev : gpu <: e}}
       -> Device
       -> Co e (Either GpuError Unit)
closed d = op (ev (Close d (\r -> r))) val

-- | The GPU opened, held by `body` in a region of its own, and closed
-- | when `body` ends: what it came to; where there is no GPU here, why
-- | is thrown, a `GpuError`.  A program opens its device once, at the
-- | top, and draws inside.
withDevice : {e : HFunctor}
           -> {a : Type}
           -> {{ev : gpu <: e}}
           -> {{ex : exception GpuError <: e}}
           -> ({s : Type} -> With s Device -> Co e a)
           -> Co e a
withDevice body = scoped opened closed body

-- (a buffer of `n` bytes on the device, 0 each, the host's own)
made : {e : HFunctor}
     -> {{ev : gpu <: e}}
     -> Device
     -> Int
     -> Co e (Either GpuError Buffer)
made d n = op (ev (NewBuffer d n (\r -> r))) val

-- (a buffer let go of)
freed : {e : HFunctor}
      -> {{ev : gpu <: e}}
      -> Buffer
      -> Co e (Either GpuError Unit)
freed b = op (ev (FreeBuffer b (\r -> r))) val

-- | A buffer of `n` bytes on the device, 0 each, which a kernel reads
-- | and writes and which is written and read from the program: held by
-- | `body` in a region of its own, and let go of when `body` ends; a
-- | buffer not made (too large, say) is thrown, a `GpuError`.
withBuffer : {e : HFunctor}
           -> {s a : Type}
           -> {{ev : gpu <: e}}
           -> {{ex : exception GpuError <: e}}
           -> With s Device
           -> Int
           -> ({t : Type} -> With t Buffer -> Co e a)
           -> Co e a
withBuffer d n body = scoped (made (inside d) n) freed body

-- | The bytes written into the buffer from its byte `at` (a multiple of
-- | 4, as their length is).
writeBuffer : {e : HFunctor}
            -> {s t : Type}
            -> {{ev : gpu <: e}}
            -> With s Device
            -> With t Buffer
            -> Int
            -> Bytes
            -> Co e (Either GpuError Unit)
writeBuffer d b at bs =
  op (ev (WriteBuffer (inside d) (inside b) at bs (\r -> r))) val

-- | The buffer's `n` bytes from its byte `at` (multiples of 4), read
-- | once what the GPU was given to do before is done.
readBuffer : {e : HFunctor}
           -> {s t : Type}
           -> {{ev : gpu <: e}}
           -> With s Device
           -> With t Buffer
           -> Int
           -> Int
           -> Co e (Either GpuError Bytes)
readBuffer d b at n =
  op (ev (ReadBuffer (inside d) (inside b) at n (\r -> r))) val

-- | A kernel loaded from its code (WGSL, for WebGPU) and the name of
-- | its entry point, or what the compiler said of the code.  The
-- | pipeline is the device's: dispatched as long as the device is open.
load : {e : HFunctor}
     -> {s : Type}
     -> {{ev : gpu <: e}}
     -> With s Device
     -> String
     -> String
     -> Co e (Either GpuError Pipeline)
load d code entry = op (ev (Load (inside d) code entry (\r -> r))) val

-- (the kernel run over `x` by `y` by `z` workgroups, these buffers
-- bound in order)
dispatched : {e : HFunctor}
           -> {s : Type}
           -> {{ev : gpu <: e}}
           -> With s Device
           -> Pipeline
           -> List Buffer
           -> Int
           -> Int
           -> Int
           -> Co e (Either GpuError Unit)
dispatched d pl bs x y z =
  op (ev (Dispatch (inside d) pl bs x y z (\r -> r))) val

-- | The kernel run over `x` by `y` by `z` workgroups, its one buffer
-- | bound at `@binding(0)`: done when the GPU is.
dispatch1 : {e : HFunctor}
          -> {s t : Type}
          -> {{ev : gpu <: e}}
          -> With s Device
          -> Pipeline
          -> With t Buffer
          -> Int
          -> Int
          -> Int
          -> Co e (Either GpuError Unit)
dispatch1 d pl a x y z = dispatched d pl [inside a] x y z

-- | ... its two buffers bound in order (the first at `@binding(0)`).
dispatch2 : {e : HFunctor}
          -> {s t u : Type}
          -> {{ev : gpu <: e}}
          -> With s Device
          -> Pipeline
          -> With t Buffer
          -> With u Buffer
          -> Int
          -> Int
          -> Int
          -> Co e (Either GpuError Unit)
dispatch2 d pl a b x y z = dispatched d pl [inside a, inside b] x y z

-- | ... its three buffers bound in order.
dispatch3 : {e : HFunctor}
          -> {s t u v : Type}
          -> {{ev : gpu <: e}}
          -> With s Device
          -> Pipeline
          -> With t Buffer
          -> With u Buffer
          -> With v Buffer
          -> Int
          -> Int
          -> Int
          -> Co e (Either GpuError Unit)
dispatch3 d pl a b c x y z =
  dispatched d pl [inside a, inside b, inside c] x y z

-- | As the host says it.
-- | >>> showError { message = "WebGPU is not here" }
-- | "gpu: WebGPU is not here"
showError : GpuError -> String
showError err = "gpu: " ^ err.message
