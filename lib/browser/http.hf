-- An HTTP client for a page, as an effect: a request sent by the
-- browser's `fetch`, its body and its response's bytes, and the
-- response, or why none came.  JavaScript's alone, a page's; a C
-- program's is std.http, whose shapes these are (`send`, `get`, `text`),
-- but for what curl has and `fetch` does not.  Import it by a name,
-- `import browser.http as Http`.  (browser.dom's `fetchText` is a `GET`
-- of text; browser.remote is an API's client over this.)
--
-- A response is whatever the server answered, a 404 or a 500 too; an
-- error is that none came -- the network, a request refused by the
-- browser (another origin's, without CORS), the time up -- with what
-- the browser says of it.

module browser.http

import bytes as Bytes
import co

-- | A request: where it goes (relative to the page, as `fetch` has
-- | it), its method, its headers (a name and a value each), its body
-- | (sent where it is not empty: a `GET` or a `HEAD` has none), and how
-- | long it may take in all in milliseconds (0: as long as it takes).
type Request =
  { url : String
  , method : String = "GET"
  , headers : List (Pair String String) = Nil
  , body : Bytes = Bytes.empty
  , timeout : Int = 0
  }

-- | A response: its status, its headers (a name and a value each, the
-- | names in lower case, as `fetch` gives them), and its body.
type Response =
  { status : Int, headers : List (Pair String String), body : Bytes }

-- | Why no response came, as the browser says it.
type HttpError = { message : String }

data HttpF (m : Type -> Type) x = Send Request (Either HttpError Response -> x)

-- | An HTTP client as an effect.
http : HFunctor
http =
  { f = HttpF
  , hfmap = \m g p -> case p of
      Send rq k -> Send rq (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      Send rq k -> Send rq k
  }

-- | The request sent: its response, or why none came.
send : {e : HFunctor}
     -> {{ev : http <: e}}
     -> Request
     -> Co e (Either HttpError Response)
send rq = op (ev (Send rq (\r -> r))) val

-- | A `GET` of the URL.
get : {e : HFunctor}
    -> {{ev : http <: e}}
    -> String
    -> Co e (Either HttpError Response)
get u = send { url = u }

-- | The body as text: UTF-8, what is not UTF-8 U+FFFD.
-- | >>> text { status = 200, headers = Nil, body = Bytes.fromList [104, 105, 255] }
-- | "hi\u{FFFD}"
text : Response -> String
text r = toString r.body

-- | As the browser says it.
-- | >>> showError { message = "Failed to fetch" }
-- | "fetch: Failed to fetch"
showError : HttpError -> String
showError err = "fetch: " ^ err.message
