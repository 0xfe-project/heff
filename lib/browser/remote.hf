-- An API over HTTP, a page's side: a client's
-- transport by the browser's `fetch` (browser.http), each call a `POST`
-- of its frame to the server, std.remote's (C), the answer the
-- response's body.  Import it by a name beside remote's,
-- `import browser.remote as RemoteHTTP` (as std.remote is, in C).

module browser.remote

import co
import remote as Remote
import browser.http as HTTP

-- | What a frame is sent as, its `Content-Type` (std.remote's).
contentType : String
contentType = "application/x-heff-wire"

-- (what came back from the URL: the answer's frame, or why none did)
exchanged : String
          -> Either HTTP.HttpError HTTP.Response
          -> Either Remote.RemoteError Bytes
exchanged url (Left err) = Left (Unreachable (show err))
exchanged url (Right res) =
  if res.status == 200 then Right res.body
  else Left
      (Unreachable
         (url ^ ": status " ^ debug res.status ^ ": " ^ show res.body))

-- | A client's transport: each frame a `POST` to the URL (`"/api"`, the
-- | page's server's), by `fetch`, the answer the response's body; where
-- | no response came, or one of a status that is no 200, `Unreachable`
-- | (a `timeout`, in milliseconds, 0 for none).
posted : {e : HFunctor}
       -> {{web : HTTP.http <: e}}
       -> {timeout : Int := 0}
       -> String
       -> Remote.Transport e
posted url =
  { exchange = \frame ->
        bind
          (HTTP.send
             { url = url
             , method = "POST"
             , headers = [MkPair "Content-Type" contentType]
             , body = frame
             , timeout = timeout
             })
          (\r -> pure (exchanged url r))
  }
