-- The DOM world as an effect: its operations, each taking the evidence
-- that the DOM is in the program's effect (as state's `get` does).
-- `heff compile --backend=page` compiles a computation of this world --
-- `Co dom Unit`, or a sum of worlds -- to a script for a page, each
-- world's algebra from its provider.
--
-- ```haskell
-- import co
-- import browser.dom
--
-- greeting : String -> String
-- greeting name = if name == "" then "Hello, whoever you are." else "Hello, " ^ name ^ "!"
--
-- -- | the paragraph greets whatever is typed into the input
-- greeter : {e : HFunctor} -> {{page : dom <: e}} -> Co e Unit
-- greeter = do
--   with withDocument as doc do
--     out <- xpath doc "//p[@id='greeting']"
--     name <- select doc "#name"
--     found out (\o -> do
--       text o (greeting "")
--       found name (\n -> on n "input" (\v -> text o (greeting v))))
-- ```
--
-- The page's document is had by `withDocument`, at the top of the
-- program, as a `With s Document`: what finds and makes elements
-- (`select`, `xpath`, `create`) takes it.  An element is the host's
-- own, a foreign value, passed by value: to the operations on it here
-- (`text`, `attr`, `append`, `on`), and to another effect's -- a
-- `<canvas>` found here, drawn on by a GPU's effect inside the same
-- `with`.  The page owns its elements, so there is nothing to let go
-- of: an element the program drops is the collector's.  An app only
-- gets elements from the operations -- it makes them, or finds them on
-- the page: where one goes on the page is the app's to say.

module browser.dom
  ( Document
  , Element
  , DomF(..)
  , dom
  , withDocument
  , create
  , text
  , attr
  , append
  , clear
  , value
  , on
  , same
  , select
  , xpath
  , found
  , sleep
  , fetchText
  , textIn
  )

import co
import resource

-- | The page's document: the host's own, had as a `With s Document` by
-- | `withDocument`'s body.
data Document

-- | An element of the page: the host's own, passed by value.
data Element

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`); `On` takes a computation, run at each event
data DomF (m : Type -> Type) x
  = Open (Document -> x)
  | Create Document String (Element -> x)
  | Text Element String x
  | Attr Element String String x
  | Append Element Element x
  | Clear Element x
  | Value Element (String -> x)
  | On Element String (String -> m Unit) x
  | Same Element Element (Bool -> x)
  | Select Document String (Maybe Element -> x)
  | XPath Document String (Maybe Element -> x)
  | Sleep Int x
  | Fetch String (String -> x)

-- | The DOM as an effect.
dom : HFunctor
dom =
  { f = DomF
  , hfmap = \m g p -> case p of
      Open k -> Open (\d -> g (k d))
      Create d t k -> Create d t (\n -> g (k n))
      Text n str x -> Text n str (g x)
      Attr n a v x -> Attr n a v (g x)
      Append p c x -> Append p c (g x)
      Clear n x -> Clear n (g x)
      Value n k -> Value n (\v -> g (k v))
      On n e h x -> On n e h (g x)
      Same n o k -> Same n o (\b -> g (k b))
      Select d q k -> Select d q (\n -> g (k n))
      XPath d q k -> XPath d q (\n -> g (k n))
      Sleep ms x -> Sleep ms (g x)
      Fetch url k -> Fetch url (\t -> g (k t))
  , hmap = \m n nt p -> case p of
      Open k -> Open k
      Create d t k -> Create d t k
      Text n str x -> Text n str x
      Attr n a v x -> Attr n a v x
      Append p c x -> Append p c x
      Clear n x -> Clear n x
      Value n k -> Value n k
      On n e h x -> On n e (\v -> nt (h v)) x
      Same n o k -> Same n o k
      Select d q k -> Select d q k
      XPath d q k -> XPath d q k
      Sleep ms x -> Sleep ms x
      Fetch url k -> Fetch url k
  }

-- (the page's document)
opened : {e : HFunctor} -> {{ev : dom <: e}} -> Co e Document
opened = op (ev (Open (\d -> d))) val

-- (a document is the page's: nothing to let go of)
kept : {e : HFunctor} -> Document -> Co e Unit
kept d = pure MkUnit

-- | The page's document, held by `body` in a region of its own: what it
-- | came to.  A page always has its document, so nothing is thrown.  A
-- | program has its page once, at the top, and finds and makes its
-- | elements inside.
withDocument : {e : HFunctor}
             -> {a : Type}
             -> {{ev : dom <: e}}
             -> ({s : Type} -> With s Document -> Co e a)
             -> Co e a
withDocument body = held opened kept body

-- | An element made, of the tag: on no page until it is appended.
create : {e : HFunctor}
       -> {s : Type}
       -> {{ev : dom <: e}}
       -> With s Document
       -> String
       -> Co e Element
create doc tag = op (ev (Create (inside doc) tag (\n -> n))) val

-- | The element's text set: all it holds, as text.
text : {e : HFunctor} -> {{ev : dom <: e}} -> Element -> String -> Co e Unit
text n str = op (ev (Text n str MkUnit)) val

-- | The element's attribute `a` set to `v`.
attr : {e : HFunctor}
     -> {{ev : dom <: e}}
     -> Element
     -> String
     -> String
     -> Co e Unit
attr n a v = op (ev (Attr n a v MkUnit)) val

-- | The child appended to the parent, as its last.
append : {e : HFunctor}
       -> {{ev : dom <: e}}
       -> Element
       -> Element
       -> Co e Unit
append parent child = op (ev (Append parent child MkUnit)) val

-- | The element's children, all removed.
clear : {e : HFunctor} -> {{ev : dom <: e}} -> Element -> Co e Unit
clear n = op (ev (Clear n MkUnit)) val

-- | An input's value, as it is now.
value : {e : HFunctor} -> {{ev : dom <: e}} -> Element -> Co e String
value n = op (ev (Value n (\v -> v))) val

-- | The handler run at each of the element's events of the name
-- | (`"input"`, `"click"`), given the value of what it happened to (`""`
-- | where that has none).
on : {e : HFunctor}
   -> {{ev : dom <: e}}
   -> Element
   -> String
   -> (String -> Co e Unit)
   -> Co e Unit
on n event h = op (ev (On n event h MkUnit)) val

-- | Whether two elements are one: the same element of the page, found
-- | twice, say.
same : {e : HFunctor} -> {{ev : dom <: e}} -> Element -> Element -> Co e Bool
same n o = op (ev (Same n o (\b -> b))) val

-- | The first element of the page a CSS selector matches (`#out`,
-- | `ul > li.done`), if one does.
select : {e : HFunctor}
       -> {s : Type}
       -> {{ev : dom <: e}}
       -> With s Document
       -> String
       -> Co e (Maybe Element)
select doc q = op (ev (Select (inside doc) q (\n -> n))) val

-- | The first element of the page an XPath matches
-- | (`//button[text()='Go']`), if one does.
xpath : {e : HFunctor}
      -> {s : Type}
      -> {{ev : dom <: e}}
      -> With s Document
      -> String
      -> Co e (Maybe Element)
xpath doc q = op (ev (XPath (inside doc) q (\n -> n))) val

-- | Go on with an element, if it was found.
found : {e : HFunctor} -> Maybe Element -> (Element -> Co e Unit) -> Co e Unit
found Nothing _ = pure MkUnit
found (Just n) k = k n

-- | Wait: in the page, the rest runs when the time has passed.
sleep : {e : HFunctor} -> {{ev : dom <: e}} -> Int -> Co e Unit
sleep ms = op (ev (Sleep ms MkUnit)) val

-- | A URL's text, fetched (a `GET`); where that fails, what the browser
-- | says of it.
fetchText : {e : HFunctor} -> {{ev : dom <: e}} -> String -> Co e String
fetchText url = op (ev (Fetch url (\t -> t))) val

-- | An element with some text in it, put in a parent.
textIn : {e : HFunctor}
       -> {s : Type}
       -> {{ev : dom <: e}}
       -> With s Document
       -> Element
       -> String
       -> String
       -> Co e Element
textIn doc parent tag str = do
  n <- create doc tag
  text n str
  append parent n
  pure n
