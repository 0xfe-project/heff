-- The DOM world as an effect (lib/co.hg): its operations, and handlers --
-- the JavaScript one of `hg app`, or one written here, for tests.  `s` is
-- the state of the app; nodes are named by numbers, 0 being the root.

import co

data Unit = MkUnit

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`); `On` takes a computation, run at each event
data DomF s (m :: Type -> Type) x
  = Create String (Int -> x)
  | Text Int String x
  | Attr Int String String x
  | Append Int Int x
  | Clear Int x
  | Value Int (String -> x)
  | On Int String (String -> m Unit) x
  | Root (Int -> x)
  | Get (s -> x)
  | Put s x
  | Sleep Int x
  | Fetch String (String -> x)

-- | The DOM as an effect, with an app's state of type `s`.  An app is a
-- | computation with it: `Co (dom s) Unit`.
dom :: (s :: Type) -> HFunctor
dom s = { f = DomF s, hmap = \nt p -> case p of
    Create t k -> Create t k
    Text n str x -> Text n str x
    Attr n a v x -> Attr n a v x
    Append p c x -> Append p c x
    Clear n x -> Clear n x
    Value n k -> Value n k
    On n e h x -> On n e (\v -> nt (h v)) x
    Root k -> Root k
    Get k -> Get k
    Put st x -> Put st x
    Sleep ms x -> Sleep ms x
    Fetch url k -> Fetch url k }

create :: {s :: Type} -> String -> Co (dom s) Int
create tag = op (Create tag (\n -> n)) val

text :: {s :: Type} -> Int -> String -> Co (dom s) Unit
text n str = op (Text n str MkUnit) val

attr :: {s :: Type} -> Int -> String -> String -> Co (dom s) Unit
attr n a v = op (Attr n a v MkUnit) val

append :: {s :: Type} -> Int -> Int -> Co (dom s) Unit
append parent child = op (Append parent child MkUnit) val

clear :: {s :: Type} -> Int -> Co (dom s) Unit
clear n = op (Clear n MkUnit) val

value :: {s :: Type} -> Int -> Co (dom s) String
value n = op (Value n (\v -> v)) val

on :: {s :: Type} -> Int -> String -> (String -> Co (dom s) Unit) -> Co (dom s) Unit
on n event h = op (On n event h MkUnit) val

root :: {s :: Type} -> Co (dom s) Int
root = op (Root (\n -> n)) val

get :: {s :: Type} -> Co (dom s) s
get = op (Get (\st -> st)) val

put :: {s :: Type} -> s -> Co (dom s) Unit
put st = op (Put st MkUnit) val

-- (asynchronous, in the page: the rest runs when it is done)
-- | Wait: in the page, the rest runs when the time has passed.
sleep :: {s :: Type} -> Int -> Co (dom s) Unit
sleep ms = op (Sleep ms MkUnit) val

fetchText :: {s :: Type} -> String -> Co (dom s) String
fetchText url = op (Fetch url (\t -> t)) val

-- an element with some text in it, put in a parent
textIn :: {s :: Type} -> Int -> String -> String -> Co (dom s) Int
textIn parent tag str = do
  n <- create tag
  text n str
  append parent n
  pure n
