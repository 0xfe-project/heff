-- The DOM world as an effect (lib/co.hg): its operations, and handlers --
-- the JavaScript one of `hg app`, or one written here, for tests.  Nodes are
-- named by numbers, 0 being the root.  An app is a computation with the
-- DOM's effect and a state's (lib/state.hg), as one:
-- `Co (plus dom (state s)) Unit`.

import co
import prelude
import state

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`); `On` takes a computation, run at each event
data DomF (m :: Type -> Type) x
  = Create String (Int -> x)
  | Text Int String x
  | Attr Int String String x
  | Append Int Int x
  | Clear Int x
  | Value Int (String -> x)
  | On Int String (String -> m Unit) x
  | Root (Int -> x)
  | Select String (Maybe Int -> x)
  | XPath String (Maybe Int -> x)
  | Sleep Int x
  | Fetch String (String -> x)

-- | The DOM as an effect.
dom :: HFunctor
dom =
  { f = DomF
  , hmap = \nt p -> case p of
      Create t k -> Create t k
      Text n str x -> Text n str x
      Attr n a v x -> Attr n a v x
      Append p c x -> Append p c x
      Clear n x -> Clear n x
      Value n k -> Value n k
      On n e h x -> On n e (\v -> nt (h v)) x
      Root k -> Root k
      Select q k -> Select q k
      XPath q k -> XPath q k
      Sleep ms x -> Sleep ms x
      Fetch url k -> Fetch url k
  }

create :: {s :: Type} -> String -> Co (plus dom (state s)) Int
create tag = op (InL (Create tag (\n -> n))) val

text :: {s :: Type} -> Int -> String -> Co (plus dom (state s)) Unit
text n str = op (InL (Text n str MkUnit)) val

attr :: {s :: Type} -> Int -> String -> String -> Co (plus dom (state s)) Unit
attr n a v = op (InL (Attr n a v MkUnit)) val

append :: {s :: Type} -> Int -> Int -> Co (plus dom (state s)) Unit
append parent child = op (InL (Append parent child MkUnit)) val

clear :: {s :: Type} -> Int -> Co (plus dom (state s)) Unit
clear n = op (InL (Clear n MkUnit)) val

value :: {s :: Type} -> Int -> Co (plus dom (state s)) String
value n = op (InL (Value n (\v -> v))) val

on :: {s :: Type}
   -> Int
   -> String
   -> (String -> Co (plus dom (state s)) Unit)
   -> Co (plus dom (state s)) Unit
on n event h = op (InL (On n event h MkUnit)) val

root :: {s :: Type} -> Co (plus dom (state s)) Int
root = op (InL (Root (\n -> n))) val

-- | The first element of the page a CSS selector matches (`#out`,
-- | `ul > li.done`), if one does.
select :: {s :: Type} -> String -> Co (plus dom (state s)) (Maybe Int)
select q = op (InL (Select q (\n -> n))) val

-- | The first element of the page an XPath matches
-- | (`//button[text()='Go']`), if one does.
xpath :: {s :: Type} -> String -> Co (plus dom (state s)) (Maybe Int)
xpath q = op (InL (XPath q (\n -> n))) val

get :: {s :: Type} -> Co (plus dom (state s)) s
get = op (InR (Get (\st -> st))) val

put :: {s :: Type} -> s -> Co (plus dom (state s)) Unit
put st = op (InR (Put st MkUnit)) val

-- (asynchronous, in the page: the rest runs when it is done)
-- | Wait: in the page, the rest runs when the time has passed.
sleep :: {s :: Type} -> Int -> Co (plus dom (state s)) Unit
sleep ms = op (InL (Sleep ms MkUnit)) val

fetchText :: {s :: Type} -> String -> Co (plus dom (state s)) String
fetchText url = op (InL (Fetch url (\t -> t))) val

-- an element with some text in it, put in a parent
textIn :: {s :: Type} -> Int -> String -> String -> Co (plus dom (state s)) Int
textIn parent tag str = do
  n <- create tag
  text n str
  append parent n
  pure n
