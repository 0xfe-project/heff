-- Failure as an effect (lib/co.hf): `throw` abandons the rest of the
-- computation with a word of why, and `catch` hears it.  `Catch` holds
-- computations, so it is made where it is, not lifted (par.hf says the
-- same): both operations take the evidence `exn <: e`.  What happens to
-- the world a throw abandons -- kept, or rolled back -- is nowhere in
-- here: it is each handler's to say, and test/surface/exn.hf says it
-- both ways.

import co
import prelude

data ExnF (m : Type -> Type) x = Throw String | Catch (m x) (String -> m x)

-- | Failure as an effect.
exn : HFunctor
exn =
  { f = ExnF
  , hfmap = \fm g p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (fm g c) (\s -> fm g (h s))
  , hmap = \nt p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (nt c) (\s -> nt (h s))
  }

-- | Abandon the rest, with a word of why.
throw : {e : HFunctor} -> {a : Type} -> (exn <: e) -> String -> Co e a
throw = \{e} {a} ev s -> op (ev ((Throw s : ExnF (Co e) a))) val

-- | `catch ev c h` is `c`; if `c` throws, it is `h` of the word thrown.
catch : {e : HFunctor}
      -> {a : Type}
      -> (exn <: e)
      -> Co e a
      -> (String -> Co e a)
      -> Co e a
catch = \{e} {a} ev c h -> op (ev ((Catch c h : ExnF (Co e) a))) val
