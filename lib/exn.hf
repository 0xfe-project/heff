-- Failure as an effect (lib/co.hf): `throw` abandons the rest of the
-- computation with a word of why (an `err`: a message, a diagnostic),
-- and `catch` hears it.  `Catch` holds
-- computations, so it is made where it is, not lifted (parallel.hf says the
-- same): both operations take the evidence `exn <: e`.  What happens to
-- the world a throw abandons -- kept, or rolled back -- is nowhere in
-- here: it is each handler's to say, and test/surface/exn.hf says it
-- both ways.

import co

data ExnF err (m : Type -> Type) x = Throw err | Catch (m x) (err -> m x)

-- | Failure as an effect, with an `err` of why (a message, a
-- | diagnostic).
exn : (err : Type) -> HFunctor
exn err =
  { f = ExnF err
  , hfmap = \m g p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (m.fmap g c) (\s -> m.fmap g (h s))
  , hmap = \m n nt p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (nt c) (\s -> nt (h s))
  }

-- | Abandon the rest, with a word of why.
throw : {err : Type}
      -> {e : HFunctor}
      -> {a : Type}
      -> {{ev : exn err <: e}}
      -> err
      -> Co e a
throw = \{err} {e} {a} s -> op (ev ((Throw s : ExnF err (Co e) a))) val

-- | `catch c h` is `c`; if `c` throws, it is `h` of what was thrown.
-- | (Which `err` that is is found from `h`'s type: a handler that does
-- | not look at it says it, `(h : String -> Co e a)`, there being no
-- | search for evidence.)
catch : {err : Type}
      -> {e : HFunctor}
      -> {a : Type}
      -> {{ev : exn err <: e}}
      -> Co e a
      -> (err -> Co e a)
      -> Co e a
catch = \{err} {e} {a} c h -> op (ev ((Catch c h : ExnF err (Co e) a))) val

-- Division that throws
--------------------------------------------------------------------------------

-- | What `exnDiv` and `exnMod` throw: the divisor was zero.
data DivByZero = MkDivByZero

-- | `x / y`, but by zero a throw, not 0 (the prelude's division is
-- | total): for a caller that would hear of it.  Whether the divisor is
-- | zero is the type's to say (`IsZero`).
exnDiv : {a : Type}
       -> {e : HFunctor}
       -> {{div : Division a}}
       -> {{z : IsZero a}}
       -> {{ev : exn DivByZero <: e}}
       -> a
       -> a
       -> Co e a
exnDiv x y =
  if z.isZero y then throw (MkDivByZero : DivByZero) else pure (div.div x y)

-- | `x % y`, but by zero a throw, not `x`.
exnMod : {a : Type}
       -> {e : HFunctor}
       -> {{mod : Remainder a}}
       -> {{z : IsZero a}}
       -> {{ev : exn DivByZero <: e}}
       -> a
       -> a
       -> Co e a
exnMod x y =
  if z.isZero y then throw (MkDivByZero : DivByZero) else pure (mod.mod x y)
