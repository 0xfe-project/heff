-- Tests: unit tests, properties and models, run by `heff test`.
--
-- A test is a top-level definition of type `Test`: `heff test FILE`
-- runs each one of the file's own, after its watches, but one another
-- of them uses (directly or through the file's other definitions),
-- which runs under that one, by its groups' names.  It is found by
-- its type, not by its name; a watch stays an example in a definition's
-- documentation, a test is what is checked of it, and both are counted
-- by the same runner.
--
--   import check
--   import co
--   import generator as Generator
--
--   arithmetic : Test
--   arithmetic = group "arithmetic"
--     [ unit "one and one" (assertEqual (1 + 1) 2)
--     , property "reversed twice" (do
--         xs <- forAll (Generator.list 0 20 (Generator.int 0 99))
--         label (if null xs then "empty" else "not empty")
--         assertEqual (reverse (reverse xs)) xs)
--     ]
--
-- A test is a computation with effects, and its type says
-- which: a unit test only checks (`check`), a property also draws random
-- values (`random`).  Neither can do anything else.  The runner handles
-- both, and gives the randomness from a seed, so that a run is replayed
-- by its seed.  It handles them in a generator's monad, so
-- a property is itself a generator, of runs: a run that fails shrinks
-- as all of its draws do, each made again from the shrinks of those
-- before it, with no shrinking written for it.
--
-- An integration test (`integration`) also has the world outside: the
-- process (commands run, std.process) and the filesystem.  `heff test`
-- cannot run it in itself; it builds the file's tests into a program
-- through C (`integrationMain`), and runs each integration test in it,
-- in a new directory of its own, killed at its time limit (`within`).
-- A unit test or an integration test may keep golden texts (`golden`),
-- held to the files kept beside the test's, or written there by `heff
-- test --update`.
--
-- What a value is shown as, for a counterexample or for what differs, is
-- its type's `Show` (the prelude's: as the source writes it, a string
-- quoted, not its `ToString` text), an instance argument: a type of the
-- test's own is given one by an instance (`instance instanceShowColor :
-- Show Color`).  A generator is given by hand.  Two values are equal
-- for `assertEqual` when they are shown the same, as a watch holds when
-- its value is shown as its expectation is.
--
-- A model-based test (`agree`) runs a program of commands on a system
-- and on a model of it, and holds when they observe the same after each
-- command; a property draws the programs, which shrink to a short one
-- that tells the two apart (std.map against a
-- list).

import co
import generator as Generator
import json as Json
import regex as Regex
import std.filesystem as Filesystem
import std.map as Map
import std.process as Process

-- Effects
--------------------------------------------------------------------------------

-- | Randomness: a value drawn from a generator.
data RandomF (m : Type -> Type) x = Draw (Generator.Generator x)

-- | Randomness as an effect: what a property is given, and a unit test
-- | is not.
random : HFunctor
random =
  { f = RandomF
  , hfmap = \m g p -> case p of
      Draw d -> Draw (Generator.map g d)
  , hmap = \m n nt p -> case p of
      Draw d -> Draw d
  }

-- | Why a test failed: said in words, or two values (shown) that are not
-- | the same, what was expected first.
data Failure = Because String | Differ String String

-- | Checking: a failure, a run given up on (its assumptions do not hold),
-- | a label of the run (counted over the runs), a note (shown if the
-- | run fails; made only then), a golden text (a name, and the text,
-- | held by `heff test` to the one kept under that name), and a subtest
-- | (its name, and what it does), and a test skipped (why: what it
-- | needs is not there).
data CheckF (m : Type -> Type) x
  = Fail Failure
  | Discard
  | Skip String
  | Label String x
  | Note (Unit -> String) x
  | Golden String String x
  | Sub String (m Unit) x

-- | Checking as an effect.
check : HFunctor
check =
  { f = CheckF
  , hfmap = \m g p -> case p of
      Fail f -> Fail f
      Discard -> Discard
      Skip why -> Skip why
      Label l x -> Label l (g x)
      Note s x -> Note s (g x)
      Golden n t x -> Golden n t (g x)
      Sub s c x -> Sub s c (g x)
  , hmap = \m n nt p -> case p of
      Fail f -> Fail f
      Discard -> Discard
      Skip why -> Skip why
      Label l x -> Label l x
      Note s x -> Note s x
      Golden n t x -> Golden n t x
      Sub s c x -> Sub s (nt c) x
  }

-- | The effects a test is run in.
world : HFunctor
world = random <+> check

-- Checking
--------------------------------------------------------------------------------

-- | A value of `g`, shown (`show`) if the run fails.
forAll : {a : Type}
       -> {e : HFunctor}
       -> {{rnd : random <: e}}
       -> {{chk : check <: e}}
       -> {{shows : Show a}}
       -> Generator.Generator a
       -> Co e a
forAll g = do
  x <- op (rnd (Draw g)) val
  op (chk (Note (\u -> show x) (MkUnit : Unit))) val
  pure x

-- | The test fails, for this reason.
failure : {a : Type}
        -> {e : HFunctor}
        -> {{chk : check <: e}}
        -> String
        -> Co e a
failure why = op (chk (Fail (Because why))) val

-- | The test fails unless `b` holds; `what` says what should have.
assert : {e : HFunctor} -> {{chk : check <: e}} -> String -> Bool -> Co e Unit
assert what b = if b then pure MkUnit else failure what

-- | The test fails unless what was got (first) and what was expected are
-- | the same when shown (`show`); then it says what differs.
assertEqual : {a : Type}
            -> {e : HFunctor}
            -> {{chk : check <: e}}
            -> {{shows : Show a}}
            -> a
            -> a
            -> Co e Unit
assertEqual got expected =
  if strEq (show got) (show expected) then pure MkUnit
  else op (chk (Fail (Differ (show expected) (show got)))) val

-- | The run is given up on unless `b` holds: a property's assumption.
-- | Runs given up on are not counted as runs, and too many fail it.
assume : {e : HFunctor} -> {{chk : check <: e}} -> Bool -> Co e Unit
assume b = if b then pure MkUnit else op (chk Discard) val

-- | The test is skipped, for this reason: what it needs is not there (a
-- | tool not installed, a system it is not of).  `heff test` says it is,
-- | and why, and counts it apart, neither held nor failed.
skip : {a : Type} -> {e : HFunctor} -> {{chk : check <: e}} -> String -> Co e a
skip why = op (chk (Skip why)) val

-- | The run is counted under `l`: the runner says what part of the runs
-- | each label had, so that a property that held only of trivial values
-- | shows.
label : {e : HFunctor} -> {{chk : check <: e}} -> String -> Co e Unit
label l = op (chk (Label l MkUnit)) val

-- | Shown with the counterexample, if the run fails.
note : {e : HFunctor} -> {{chk : check <: e}} -> String -> Co e Unit
note s = op (chk (Note (\u -> s) MkUnit)) val

-- | The text, held to the golden one kept under `name`: `heff test`
-- | keeps it in a file beside the test's own, in the directory named as
-- | the file without its `.hf` and with `.golden` (`NAME` in
-- | `parser.golden/`, of `parser.hf`), and fails the test where the two
-- | differ; `heff test --update` writes the text there instead.  The
-- | name is a file's: letters, digits, `-`, `_` and `.`, not first.  A
-- | unit test or an integration test keeps goldens, not a property.
golden : {e : HFunctor} -> {{chk : check <: e}} -> String -> String -> Co e Unit
golden name text = op (chk (Golden name text MkUnit)) val

-- | A test of its own within an integration test, as Go's `t.Run`: it
-- | is said on a line of its own, `test / name`, holds or fails by
-- | itself and keeps its own golden texts, and `--run` selects it at its
-- | level.  `heff test` runs it in a program of its own, as many at once
-- | as its jobs: the test's program, asked for the subtest by its names,
-- | does the test again, doing only the subtests on the way to it.  So a
-- | test does the same each time up to its subtests, and names each once
-- | (no `/` in a name).  What the test does after a subtest is done as
-- | if the subtest held.
-- |
-- |   each : List String -> Co e Unit
-- |   each Nil = pure MkUnit
-- |   each (Cons n rest) = do
-- |     subtest n (do ...)
-- |     each rest
subtest : {e : HFunctor}
        -> {{chk : check <: e}}
        -> String
        -> Co e Unit
        -> Co e Unit
subtest name body = op (chk (Sub name body MkUnit)) val

-- Running
--------------------------------------------------------------------------------

-- | What a run has said so far, backwards: its notes, labels, golden
-- | texts and the subtests it named.
type Trace =
  { notes : List (Unit -> String)
  , labels : List String
  , goldens : List (Pair String String)
  , subtests : List String
  }

noTrace : Trace
noTrace = { notes = Nil, labels = Nil, goldens = Nil, subtests = Nil }

-- (one trace, then another)
andThen : Trace -> Trace -> Trace
andThen a b =
  { notes = List.append b.notes a.notes
  , labels = List.append b.labels a.labels
  , goldens = List.append b.goldens a.goldens
  , subtests = List.append b.subtests a.subtests
  }

-- | A run of a test, so far: going on, failed, given up on, or come to
-- | the subtest it was run for, and what came of that.
data Run a
  = Going Trace a
  | Failed Trace Failure
  | Discarded
  | Skipped Trace String
  | Reached (Run Unit)

-- (the rest of a run, after a run of `t`)
after : {a : Type} -> Trace -> Run a -> Run a
after t (Going t2 x) = Going (andThen t t2) x
after t (Failed t2 f) = Failed (andThen t t2) f
after t Discarded = Discarded
after t (Skipped t2 why) = Skipped (andThen t t2) why
after t (Reached r) = Reached r

-- (a run, then what comes of its value)
proceed : {a b : Type}
        -> (a -> Generator.Generator (Run b))
        -> Run a
        -> Generator.Generator (Run b)
proceed k (Going t x) = Generator.map (\r -> after t r) (k x)
proceed k (Failed t f) = Generator.constant (Failed t f)
proceed k Discarded = Generator.constant Discarded
proceed k (Skipped t why) = Generator.constant (Skipped t why)
proceed k (Reached r) = Generator.constant (Reached r)

drawAlg : {m : Type -> Type}
        -> {a : Type}
        -> RandomF m a
        -> Generator.Generator (Run a)
drawAlg (Draw g) = Generator.map (\x -> Going noTrace x) g

-- (what an operation of checking makes of a run)
checkRun : {m : Type -> Type} -> {a : Type} -> CheckF m a -> Run a
checkRun (Fail f) = Failed noTrace f
checkRun Discard = Discarded
checkRun (Skip why) = Skipped noTrace why
checkRun (Label l x) =
  Going { notes = Nil, labels = [l], goldens = Nil, subtests = Nil } x
checkRun (Note s x) =
  Going { notes = [s], labels = Nil, goldens = Nil, subtests = Nil } x
checkRun (Golden n t x) =
  Going { notes = Nil, labels = Nil, goldens = [MkPair n t], subtests = Nil } x
checkRun (Sub n c x) =
  Failed noTrace (Because "a subtest is an integration test's")

checkAlg : {m : Type -> Type}
         -> {a : Type}
         -> CheckF m a
         -> Generator.Generator (Run a)
checkAlg c = Generator.constant (checkRun c)

-- | The runner's handler: a test is a generator of runs, so a draw is a
-- | generator's value, and a run's draws shrink together.
runner : Handler world
runner =
  { M = \a -> Generator.Generator (Run a)
  , ret = \x -> Generator.constant (Going noTrace x)
  , bind = \m k -> Generator.bind m (\r -> proceed k r)
  , malg = \p -> case p of
      InL d -> drawAlg d
      InR c -> checkAlg c
  }

-- Tests
--------------------------------------------------------------------------------

-- | How a property is run: how many runs, how many may be given up on,
-- | and how many shrinks are tried at most.
type Config = { runs : Int, discards : Int, shrinks : Int }

defaults : Config
defaults = { runs = 100, discards = 1000, shrinks = 1000 }

-- | The world outside the program: the process (commands run) and the
-- | filesystem.
outside : HFunctor
outside = Process.process <+> Filesystem.filesystem

-- | The effects an integration test is run in: checking, and the world
-- | outside.
integrated : HFunctor
integrated = check <+> outside

-- | How long an integration test is given, unless `within` says: a
-- | minute.
defaultLimit : Int
defaultLimit = 60000

-- | A test: a unit test, a property, an integration test (its time
-- | limit, in milliseconds), or tests under a name.  (Each is kept in
-- | the runner's world, its effects given.)
data Test
  = UnitTest String (Co world Unit)
  | PropTest String Config (Co world Unit)
  | IntegrationTest String Int (Co integrated Unit)
  | Group String (List Test)

-- | A unit test: it only checks.
unit : String -> ({e : HFunctor} -> {{chk : check <: e}} -> Co e Unit) -> Test
unit name body = UnitTest name (body (chk := inr random check))

-- | A property: it draws random values and checks them, run 100 times
-- | (`runs` says otherwise).
property : String
         -> ({e : HFunctor}
             -> {{rnd : random <: e}}
             -> {{chk : check <: e}}
             -> Co e Unit)
         -> Test
property name body =
  PropTest
    name
    defaults
    (body (rnd := inl random check) (chk := inr random check))

-- | An integration test: it checks, runs commands and reads and writes
-- | files.  `heff test` runs it in a program of its own, built through
-- | C, in a new directory of its own as its working directory (removed
-- | after it), and kills it at its time limit (a minute; `within` says
-- | otherwise).
integration : String
            -> ({e : HFunctor}
                -> {{chk : check <: e}}
                -> {{sys : Process.process <: e}}
                -> {{disk : Filesystem.filesystem <: e}}
                -> Co e Unit)
            -> Test
integration name body =
  IntegrationTest
    name
    defaultLimit
    (body
       (chk := \p -> InL p)
       (sys := \p -> InR (InL p))
       (disk := \p -> InR (InR p)))

-- | Tests under a name.
group : String -> List Test -> Test
group name ts = Group name ts

-- | The property run `n` times (each property of the group).
runs : Int -> Test -> Test
runs n (UnitTest name c) = UnitTest name c
runs n (PropTest name cfg c) =
  PropTest name { runs = n, discards = cfg.discards, shrinks = cfg.shrinks } c
runs n (IntegrationTest name limit c) = IntegrationTest name limit c
runs n (Group name ts) = Group name (List.map (\t -> runs n t) ts)

-- | The integration test given `ms` milliseconds, not a minute (each
-- | integration test of the group).
within : Int -> Test -> Test
within ms (UnitTest name c) = UnitTest name c
within ms (PropTest name cfg c) = PropTest name cfg c
within ms (IntegrationTest name limit c) = IntegrationTest name ms c
within ms (Group name ts) = Group name (List.map (\t -> within ms t) ts)

-- Models
--------------------------------------------------------------------------------

-- | A system and a model of it, each run a command at a time, each
-- | saying what it observes of the command: they agree when they observe
-- | the same.  `valid` is what the system must always be.
type Machine c s m o =
  { system : s
  , model : m
  , step : c -> s -> Pair s o
  , stepModel : c -> m -> Pair m o
  , valid : s -> Bool
  }

-- (the commands from the `i`th, run on both)
agreeFrom : {c s m o : Type}
          -> {e : HFunctor}
          -> {{chk : check <: e}}
          -> {{showsC : Show c}}
          -> {{showsO : Show o}}
          -> Machine c s m o
          -> Int
          -> s
          -> m
          -> List c
          -> Co e Unit
agreeFrom mc i s md Nil = pure MkUnit
agreeFrom mc i s md (Cons cmd rest) = case mc.step cmd s of
  MkPair s2 o -> case mc.stepModel cmd md of
    MkPair md2 mo ->
      if strEq (show o) (show mo) && mc.valid s2
      then agreeFrom mc (i + 1) s2 md2 rest
      else do
        note ("at command " ^ show i ^ ", " ^ show cmd)
        assert "the system is valid" (mc.valid s2)
        assertEqual o mo

-- | The commands run on the system and on the model, in order: after
-- | each, both observe the same, and the system is valid.  (Drawn by a
-- | property, the commands shrink to a short program that tells them
-- | apart.)  Each is shown, a command and what is observed, as its type's
-- | `Show` writes it.
agree : {c s m o : Type}
      -> {e : HFunctor}
      -> {{chk : check <: e}}
      -> {{showsC : Show c}}
      -> {{showsO : Show o}}
      -> Machine c s m o
      -> List c
      -> Co e Unit
agree mc cmds = agreeFrom mc 0 mc.system mc.model cmds

-- Outcomes
--------------------------------------------------------------------------------

-- | What came of a test: its name (under its groups'), whether it held,
-- | how many runs held and how many were given up on, how many shrinks
-- | made the counterexample, how many runs had each label, the
-- | counterexample's notes (what was drawn, in order), why it failed,
-- | the seed it was run from, the golden texts it kept (each a name
-- | and a text, in order), for `heff test` to hold to theirs, the
-- | subtests it named, in order, for `heff test` to run, and why it was
-- | skipped, if it was (it holds, then, having checked nothing).
type Outcome =
  { name : String
  , ok : Bool
  , skipped : Maybe String
  , property : Bool
  , runs : Int
  , discarded : Int
  , shrinks : Int
  , labels : List (Pair String Int)
  , notes : List String
  , failure : Maybe Failure
  , seed : Int
  , goldens : List (Pair String String)
  , subtests : List String
  }

-- (a number from a name, so that each test has a seed of its own, which
-- adding another test does not change)
hashName : String -> Int
hashName s =
  List.foldl
    (\h i -> (h * 31 + byteAt s i) % Generator.modulus)
    7
    (List.range 0 (strLength s - 1))

-- (each label of a run once)
nubLabels : List String -> List String
nubLabels Nil = Nil
nubLabels (Cons l rest) =
  Cons l (nubLabels (List.filter (\x -> not (strEq x l)) rest))

countLabels : Map.Map String Int -> List String -> Map.Map String Int
countLabels m ls =
  List.foldl
    (\acc l ->
       Map.insert
         acc
         l
         (1 + fromMaybe 0 (Map.lookup acc l)))
    m
    (nubLabels ls)

type Tally = { runs : Int, discarded : Int, labels : Map.Map String Int }

noTally : Tally
noTally = { runs = 0, discarded = 0, labels = Map.empty }

passed : String -> Bool -> Int -> Tally -> List (Pair String String) -> Outcome
passed name prop seed t goldens =
  { name = name
  , ok = True
  , skipped = Nothing
  , property = prop
  , runs = t.runs
  , discarded = t.discarded
  , shrinks = 0
  , labels = Map.toList t.labels
  , notes = Nil
  , failure = Nothing
  , seed = seed
  , goldens = goldens
  , subtests = Nil
  }

failedWith : String
           -> Bool
           -> Int
           -> Tally
           -> Int
           -> Trace
           -> Failure
           -> Outcome
failedWith name prop seed t n tr f =
  { name = name
  , ok = False
  , skipped = Nothing
  , property = prop
  , runs = t.runs
  , discarded = t.discarded
  , shrinks = n
  , labels = Map.toList t.labels
  , notes = List.reverse (List.map (\(s : Unit -> String) -> s MkUnit) tr.notes)
  , failure = Just f
  , seed = seed
  , goldens = Nil
  , subtests = List.reverse tr.subtests
  }

-- (a test skipped, why, after what its run said)
skippedWith : String -> Bool -> Int -> Trace -> String -> Outcome
skippedWith name prop seed tr why =
  { passed name prop seed noTally Nil
  | skipped = Just why
  , subtests = List.reverse tr.subtests
  }

isFailed : {a : Type} -> Run a -> Bool
isFailed (Failed _ _) = True
isFailed _ = False

-- (the first of these shrinks that fails too)
firstFailing : List (Unit -> Generator.Tree (Run Unit))
             -> Maybe (Generator.Tree (Run Unit))
firstFailing Nil = Nothing
firstFailing (Cons c rest) = keepIfFailed (c MkUnit) (firstFailing rest)
  where
  keepIfFailed : Generator.Tree (Run Unit)
               -> Maybe (Generator.Tree (Run Unit))
               -> Maybe (Generator.Tree (Run Unit))
  keepIfFailed t later = if isFailed (Generator.root t) then Just t else later

type Shrunk = { tree : Generator.Tree (Run Unit), shrinks : Int }

-- | A failing run made smaller: its first shrink that fails too, then
-- | that one's, as long as there is one (and `limit` is not reached).
shrink : Int -> Int -> Generator.Tree (Run Unit) -> Shrunk
shrink limit n t =
  if n >= limit then { tree = t, shrinks = n }
  else case firstFailing (Generator.children t) of
    Just t2 -> shrink limit (n + 1) t2
    Nothing -> { tree = t, shrinks = n }

-- (a failing run, shrunk, as an outcome)
failedRun : String -> Bool -> Int -> Tally -> Shrunk -> Outcome
failedRun name prop seed t sh = case Generator.root sh.tree of
  Failed tr f -> failedWith name prop seed t sh.shrinks tr f
  _ ->
    failedWith name prop seed t sh.shrinks noTrace (Because "lost the failure")

-- | After a run: the tally with it, or the outcome it made.
data Next = Again Tally | Done Outcome

judge : String -> Config -> Int -> Tally -> Generator.Tree (Run Unit) -> Next
judge name cfg seed t tree = case Generator.root tree of
  Going tr _ ->
    if List.null tr.goldens
    then Again
        { runs = t.runs + 1
        , discarded = t.discarded
        , labels = countLabels t.labels tr.labels
        }
    else Done
        (failedWith
           name
           True
           seed
           t
           0
           tr
           (Because "a property keeps no golden text: a unit test does"))
  Discarded ->
    Again { runs = t.runs, discarded = t.discarded + 1, labels = t.labels }
  Skipped tr why -> Done (skippedWith name True seed tr why)
  Failed _ _ -> Done (failedRun name True seed t (shrink cfg.shrinks 0 tree))
  Reached _ -> Done (failedRun name True seed t (shrink cfg.shrinks 0 tree))

-- | The property's runs: each from a seed of its own, at a size growing
-- | to 100.
loop : String
     -> Config
     -> Int
     -> Generator.Generator (Run Unit)
     -> Generator.Seed
     -> Tally
     -> Outcome
loop name cfg seed g s t =
  if t.runs >= cfg.runs then passed name True seed t Nil
  else if t.discarded > cfg.discards
  then failedWith
      name
      True
      seed
      t
      0
      noTrace
      (Because ("gave up after " ^ show t.discarded ^ " runs given up on"))
  else case Generator.split s of
    MkPair s1 s2 -> case judge
        name
        cfg
        seed
        t
        (Generator.run g s1 (t.runs * 100 / cfg.runs)) of
      Again t2 -> loop name cfg seed g s2 t2
      Done o -> o

-- (a unit test: one run)
runUnit : String -> Int -> Co world Unit -> Outcome
runUnit name seed c = case Generator.root
    (Generator.run (handle runner c) (Generator.seed seed) 0) of
  Going tr _ ->
    passed
      name
      False
      seed
      { runs = 1, discarded = 0, labels = Map.empty }
      (List.reverse tr.goldens)
  Failed tr f -> failedWith name False seed noTally 0 tr f
  Skipped tr why -> skippedWith name False seed tr why
  _ ->
    failedWith
      name
      False
      seed
      noTally
      0
      noTrace
      (Because "a unit test gave itself up")

-- (a test's name, its groups' and its own: `group / name`)
nameOf : List String -> String
nameOf path = joinWith " / " path

-- | Whether a test of these names, its groups' and then its own, is
-- | selected by the levels of a pattern (`heff test --run`): each name
-- | matched by the level of its depth, those deeper than the pattern by
-- | any, as Go's `-run A/B` selects.
selectedBy : List Regex.Regex -> List String -> Bool
selectedBy Nil names = True
selectedBy (Cons r rs) Nil = True
selectedBy (Cons r rs) (Cons n ns) = Regex.matches r n && selectedBy rs ns

-- (the tests under these groups, those selected, run; an integration
-- test is run outside)
runUnder : Int -> List Regex.Regex -> List String -> Test -> List Outcome
runUnder seed sel path (UnitTest name c) =
  if selectedBy sel (List.append path [name])
  then [runUnit (nameOf (List.append path [name])) seed c]
  else Nil
runUnder seed sel path (PropTest name cfg c) =
  if selectedBy sel (List.append path [name])
  then [ loop
         (nameOf (List.append path [name]))
         cfg
         seed
         (handle runner c)
         (Generator.seed (seed + hashName (nameOf (List.append path [name]))))
         noTally
       ]
  else Nil
runUnder seed sel path (IntegrationTest name limit c) = Nil
runUnder seed sel path (Group name ts) =
  if selectedBy sel (List.append path [name])
  then List.concatMap
      (\t -> runUnder seed sel (List.append path [name]) t)
      ts
  else Nil

-- | Each test, run from the seed: its unit tests and properties (`--seed
-- | N` gives the seed; the same seed runs the same).
runTest : Int -> Test -> List Outcome
runTest seed t = runUnder seed Nil Nil t

-- | Each test the pattern selects (`selectedBy`), run from the seed: what
-- | `heff test` runs in itself of each test it finds.  A pattern that
-- | is not read selects none (`heff test` reads it first).
runSelected : String -> Int -> Test -> List Outcome
runSelected pattern seed t = case Regex.compileLevels pattern of
  Left why -> Nil
  Right sel -> runUnder seed sel Nil t

-- Integration tests
--------------------------------------------------------------------------------

-- (the integration tests under these groups, those selected: each name
-- and time limit)
integrationsUnder : List Regex.Regex
                  -> List String
                  -> Test
                  -> List (Pair String Int)
integrationsUnder sel path (UnitTest name c) = Nil
integrationsUnder sel path (PropTest name cfg c) = Nil
integrationsUnder sel path (IntegrationTest name limit c) =
  if selectedBy sel (List.append path [name])
  then [MkPair (nameOf (List.append path [name])) limit]
  else Nil
integrationsUnder sel path (Group name ts) =
  if selectedBy sel (List.append path [name])
  then List.concatMap
      (\t -> integrationsUnder sel (List.append path [name]) t)
      ts
  else Nil

-- | The integration tests the pattern selects, each name and time limit:
-- | what `heff test` runs outside itself, a program each.
integrationsSelected : String -> Test -> List (Pair String Int)
integrationsSelected pattern t = case Regex.compileLevels pattern of
  Left why -> Nil
  Right sel -> integrationsUnder sel Nil t

-- (each integration test under these groups, by its name)
integrationsIn : List String -> Test -> List (Pair String (Co integrated Unit))
integrationsIn path (UnitTest name c) = Nil
integrationsIn path (PropTest name cfg c) = Nil
integrationsIn path (IntegrationTest name limit c) =
  [MkPair (nameOf (List.append path [name])) c]
integrationsIn path (Group name ts) =
  List.concatMap (\t -> integrationsIn (List.append path [name]) t) ts

mapRun : {a b : Type} -> (a -> b) -> Run a -> Run b
mapRun g (Going t x) = Going t (g x)
mapRun g (Failed t f) = Failed t f
mapRun g Discarded = Discarded
mapRun g (Skipped t why) = Skipped t why
mapRun g (Reached r) = Reached r

-- | A run outside: given the names of the subtest it is run for, those
-- | not yet come to (none: the test itself).
type Outside a = List String -> Co outside (Run a)

-- (a run outside, as a functor)
runOutside : RawFunctor
runOutside =
  { f = \x -> Outside x
  , fmap = \g m path -> bind (m path) (\r -> val (mapRun g r))
  }

-- (what an operation outside holds of a run: never a run, as the
-- process's and the filesystem's operations hold no computation)
valueOfRun : {a : Type} -> Run a -> Co outside a
valueOfRun (Going t x) = val x
valueOfRun _ = abandon

-- (a run outside, then what comes of its value)
continueOutside : {a b : Type}
                -> (a -> Co outside (Run b))
                -> Run a
                -> Co outside (Run b)
continueOutside k (Going t x) = bind (k x) (\r -> val (after t r))
continueOutside k (Failed t f) = val (Failed t f)
continueOutside k Discarded = val Discarded
continueOutside k (Skipped t why) = val (Skipped t why)
continueOutside k (Reached r) = val (Reached r)

-- (a subtest's run, done for the names after its own: come to, if it is
-- the one run for, or one under it is; else the test goes on)
cameTo : {a : Type} -> List String -> a -> Run Unit -> Run a
cameTo Nil x r = Reached r
cameTo path x (Reached r) = Reached r
cameTo path x r = Going noTrace x

-- | A subtest come to, run for these names: the test itself names it
-- | (none left), and does no more of it; on the way to the one run for,
-- | it is done, the names after its own given it; else passed over.
subtestRun : {a : Type}
           -> String
           -> Outside Unit
           -> a
           -> List String
           -> Co outside (Run a)
subtestRun name c x Nil =
  val (Going { notes = Nil, labels = Nil, goldens = Nil, subtests = [name] } x)
subtestRun name c x (Cons n rest) =
  if strEq n name then bind (c rest) (\r -> val (cameTo rest x r))
  else val (Going noTrace x)

-- (an operation of checking, run outside)
checkOutside : {a : Type} -> CheckF Outside a -> Outside a
checkOutside (Sub name c x) path = subtestRun name c x path
checkOutside c path = val (checkRun c)

-- | The runner of an integration test: checking handled, the world
-- | outside's operations done as they are.
outsideRunner : Handler integrated
outsideRunner =
  { M = \a -> Outside a
  , ret = \x path -> val (Going noTrace x)
  , bind = \m k path -> bind (m path) (\r -> continueOutside (\x -> k x path) r)
  , malg = \p path -> case p of
      InL c -> checkOutside c path
      InR q ->
        op
          (outside.hmap
             runOutside
             (coFunctor outside)
             (\m -> bind (m path) valueOfRun)
             q)
          (\x -> val (Going noTrace x))
  }

-- (what came of an integration test's run)
integrationOutcome : String -> Run Unit -> Outcome
integrationOutcome name (Going tr _) =
  { passed
      name
      False
      0
      { runs = 1, discarded = 0, labels = Map.empty }
      (List.reverse tr.goldens)
  | subtests = List.reverse tr.subtests
  }
integrationOutcome name (Failed tr f) = failedWith name False 0 noTally 0 tr f
integrationOutcome name (Skipped tr why) = skippedWith name False 0 tr why
integrationOutcome name Discarded =
  failedWith name False 0 noTally 0 noTrace (Because "a test gave itself up")
integrationOutcome name (Reached r) = integrationOutcome name r

-- (each name once, else the first named twice)
twice : List String -> Maybe String
twice Nil = Nothing
twice (Cons n rest) =
  if List.any (\m -> strEq m n) rest then Just n else twice rest

-- (a name a subtest cannot have)
badName : String -> Bool
badName n =
  strEq n ""
  || List.any (\i -> byteAt n i == 47) (List.range 0 (strLength n - 1))

-- | what came of a test, its subtests' names held to being names: each
-- | once, and none with a `/`, which `--run` takes for a level's end
namesHeld : Outcome -> Outcome
namesHeld o = case twice o.subtests of
  Just n ->
    failedWith
      o.name
      False
      0
      noTally
      0
      noTrace
      (Because ("two subtests are named " ^ show n))
  Nothing -> case List.find badName o.subtests of
    Just n ->
      failedWith
        o.name
        False
        0
        noTally
        0
        noTrace
        (Because ("a subtest's name has a `/` or is empty: " ^ show n))
    Nothing -> o

-- (what came of the subtest run for, the names after the test's own: if
-- the test went on to its end without coming to it, there is none of
-- that name; one failed or skipped on the way says so)
subtestOutcome : String -> List String -> Run Unit -> Outcome
subtestOutcome name Nil r = namesHeld (integrationOutcome name r)
subtestOutcome name path (Going tr x) =
  failedWith
    name
    False
    0
    noTally
    0
    noTrace
    (Because ("no subtest " ^ joinWith " / " path))
subtestOutcome name path r = namesHeld (integrationOutcome name r)

-- (the integration test of this name run, or its subtest of these names,
-- what came of it)
integrationRun : String
               -> List String
               -> Maybe (Pair String (Co integrated Unit))
               -> Co outside Outcome
integrationRun name path Nothing =
  val
    (failedWith
       name
       False
       0
       noTally
       0
       noTrace
       (Because ("no integration test " ^ name)))
integrationRun name path (Just t) =
  bind
    (handle outsideRunner (snd t) path)
    (\r -> val (subtestOutcome name path r))

failureJson : Maybe Failure -> Json.Json
failureJson Nothing = JNull
failureJson (Just (Because why)) = Json.obj [Json.kv "because" (Json.jstr why)]
failureJson (Just (Differ expected got)) =
  Json.obj
    [Json.kv "differ" (JArray [Json.jstr expected, Json.jstr got])]

-- | An outcome of an integration test as its program writes it, JSON:
-- | whether it held, its notes, why it failed, its golden texts, its
-- | subtests' names, why it was skipped.
outcomeJson : Outcome -> Json.Json
outcomeJson o =
  Json.obj
    [ Json.kv "ok" (JBool o.ok)
    , Json.kv "notes" (JArray (List.map Json.jstr o.notes))
    , Json.kv "failure" (failureJson o.failure)
    , Json.kv
      "goldens"
      (JArray
         (List.map
            (\(g : Pair String String) ->
               JArray [Json.jstr (fst g), Json.jstr (snd g)])
            o.goldens))
    , Json.kv "subtests" (JArray (List.map Json.jstr o.subtests))
    , Json.kv
          "skipped" (case o.skipped of
        Just why -> Json.jstr why
        Nothing -> JNull)
    ]

-- | What an integration test's program writes before its outcome, on a
-- | line of its own, where it is run by hand (not by `heff test`, which
-- | names a file for it, `outcomeVariable`).
outcomeMarker : String
outcomeMarker = "-- heff test: the outcome --"

-- | The environment variable by which `heff test` names the file an
-- | integration test's program writes its outcome to: a file of its
-- | own, not its output, which what the test runs may write to too.
outcomeVariable : String
outcomeVariable = "HEFF_TEST_OUTCOME"

-- (the outcome written where it is asked for: to the file named, else
-- to the output, after `outcomeMarker`)
outcomeWritten : Maybe String -> Outcome -> Co outside Unit
outcomeWritten (Just path) o = do
  written <-
    Filesystem.writeFile
      (ev := \p -> InR p)
      path
      (Json.stringify (outcomeJson o) ^ "\n")
  pure MkUnit
outcomeWritten Nothing o = do
  out <- Filesystem.stdout (ev := \p -> InR p)
  written <-
    Filesystem.writeString
      (ev := \p -> InR p)
      out
      ("\n" ^ outcomeMarker ^ "\n" ^ Json.stringify (outcomeJson o) ^ "\n")
  pure MkUnit

-- | What a file's integration tests are run by: `integrationMain`'s.
type Integrations = Co outside Unit

-- | The program `heff test` builds of a file's tests: it runs the
-- | integration test its first argument names (its subtest, the
-- | arguments after it naming it a level each), where it is run (in the
-- | directory `heff test` gives it), and writes what came of it to the
-- | file `outcomeVariable` names (else to its output, after
-- | `outcomeMarker`).
integrationMain : List Test -> Integrations
integrationMain ts = do
  as <- Process.args (ev := \p -> InL p)
  o <-
    integrationRun
      (fromMaybe "" (List.head as))
      (List.drop 1 as)
      (List.find
         (\(t : Pair String (Co integrated Unit)) ->
            strEq (fst t) (fromMaybe "" (List.head as)))
         (List.concatMap (\t -> integrationsIn Nil t) ts))
  dest <- Process.getEnv (ev := \p -> InL p) outcomeVariable
  outcomeWritten dest o

instance instanceShowFailure : Show Failure
instanceShowFailure = { show = written }
  where
  written : Failure -> String
  written (Because why) = "Because " ^ show why
  written (Differ expected got) = "Differ " ^ show expected ^ " " ^ show got

-- | An outcome, as the record it is (for a test of tests).
instance instanceShowOutcome : Show Outcome
instanceShowOutcome = { show = written }
  where
  written : Outcome -> String
  written o =
    "{ name = "
    ^ show o.name
    ^ ", ok = "
    ^ show o.ok
    ^ ", skipped = "
    ^ show o.skipped
    ^ ", property = "
    ^ show o.property
    ^ ", runs = "
    ^ show o.runs
    ^ ", discarded = "
    ^ show o.discarded
    ^ ", shrinks = "
    ^ show o.shrinks
    ^ ", labels = "
    ^ show o.labels
    ^ ", notes = "
    ^ show o.notes
    ^ ", failure = "
    ^ show o.failure
    ^ ", seed = "
    ^ show o.seed
    ^ ", goldens = "
    ^ show o.goldens
    ^ ", subtests = "
    ^ show o.subtests
    ^ " }"
