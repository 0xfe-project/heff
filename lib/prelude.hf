-- The basic types and what is done with them: Nat, Empty, pairs, Maybe,
-- Either; Bool, Unit and lists (lib/builtin.hf has them), lists' `::`
-- and `++` (their other operations are `List`'s, lib/list.hf); numbers
-- and strings, by the primitives, with their operators.

-- | The natural numbers.
data Nat = Zero | Succ Nat

data Empty

data Pair a b = MkPair a b

data Maybe a = Nothing | Just a

data Either a b = Left a | Right b

-- | `x :: xs` is `Cons x xs`; a pattern too, as it only names the tag
(::) : {a : Type} -> a -> List a -> List a
(::) x xs = Cons x xs

-- Functions
--------------------------------------------------------------------------------

id : {a : Type} -> a -> a
id x = x

const : {a b : Type} -> a -> b -> a
const x _ = x

flip : {a b c : Type} -> (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose : {a b c : Type} -> (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

-- The operators: `||` loosest, then `&&`, the comparisons, then `+ -`,
-- `^` and `++` (unrelated: `a + b ^ c` is refused), then `* / %`; `$`
-- below all.
-- A float's are the same, with a `.`: `+.`, `<.`
--------------------------------------------------------------------------------

infixr ||
infixr && above ||
infix == /= < <= > >= above &&
infixl + - above == /= < <= > >=
infixl * / % above + -
infixr ++ above == /= < <= > >=
infixr ^ above == /= < <= > >=
infixr :: above == /= < <= > >= below + - * / % ++ ^
infix ==. <. <=. >. >=. above &&
infixl +. -. above ==. <. <=. >. >=.
infixl *. /. above +. -.
infixr $ below ||

-- | Application, loosest: `f $ g $ x` is `f (g x)`.
($) : {a b : Type} -> (a -> b) -> a -> b
($) f x = f x

-- Bool
--------------------------------------------------------------------------------

not : Bool -> Bool
not True = False
not False = True

(&&) : Bool -> Bool -> Bool
(&&) True b = b
(&&) False _ = False

(||) : Bool -> Bool -> Bool
(||) True _ = True
(||) False b = b

-- Numbers (integers, unbounded)
--------------------------------------------------------------------------------

foreign import intAdd : Int -> Int -> Int
foreign import intSub : Int -> Int -> Int
foreign import intMul : Int -> Int -> Int
foreign import intDiv : Int -> Int -> Int
foreign import intMod : Int -> Int -> Int
foreign import intEq : Int -> Int -> Bool
foreign import intLt : Int -> Int -> Bool
foreign import intLe : Int -> Int -> Bool
foreign import intShow : Int -> String

(+) : Int -> Int -> Int
(+) = intAdd

(-) : Int -> Int -> Int
(-) = intSub

(*) : Int -> Int -> Int
(*) = intMul

-- | Division rounding down; by 0, `abandon`.
(/) : Int -> Int -> Int
(/) = intDiv

-- | The remainder of `/`, of the sign of the divisor.
(%) : Int -> Int -> Int
(%) = intMod

(==) : Int -> Int -> Bool
(==) = intEq

(/=) : Int -> Int -> Bool
(/=) a b = not (intEq a b)

(<) : Int -> Int -> Bool
(<) = intLt

(<=) : Int -> Int -> Bool
(<=) = intLe

(>) : Int -> Int -> Bool
(>) a b = intLt b a

(>=) : Int -> Int -> Bool
(>=) a b = intLe b a

min : Int -> Int -> Int
min a b = if a <= b then a else b

max : Int -> Int -> Int
max a b = if a <= b then b else a

showInt : Int -> String
showInt = intShow

-- Orders
--------------------------------------------------------------------------------

-- | How one value is to another: less, equal, or greater.
data Ordering = LT | EQ | GT

compareInt : Int -> Int -> Ordering
compareInt a b = if a < b then LT else if a == b then EQ else GT

-- Floats (JavaScript's numbers: 64-bit floating point)
--------------------------------------------------------------------------------

foreign import floatAdd : Float -> Float -> Float
foreign import floatSub : Float -> Float -> Float
foreign import floatMul : Float -> Float -> Float
foreign import floatDiv : Float -> Float -> Float
foreign import floatEq : Float -> Float -> Bool
foreign import floatLt : Float -> Float -> Bool
foreign import floatLe : Float -> Float -> Bool
foreign import floatShow : Float -> String
foreign import floatFromInt : Int -> Float
foreign import floatSqrt : Float -> Float
foreign import floatFloor : Float -> Int

(+.) : Float -> Float -> Float
(+.) = floatAdd

(-.) : Float -> Float -> Float
(-.) = floatSub

(*.) : Float -> Float -> Float
(*.) = floatMul

-- | Division; by 0, an infinity (or not a number, of 0 by 0).
(/.) : Float -> Float -> Float
(/.) = floatDiv

(==.) : Float -> Float -> Bool
(==.) = floatEq

(<.) : Float -> Float -> Bool
(<.) = floatLt

(<=.) : Float -> Float -> Bool
(<=.) = floatLe

(>.) : Float -> Float -> Bool
(>.) a b = floatLt b a

(>=.) : Float -> Float -> Bool
(>=.) a b = floatLe b a

toFloat : Int -> Float
toFloat = floatFromInt

-- | The greatest integer not above; of an infinity, or what is not a
-- | number, `abandon`.
floor : Float -> Int
floor = floatFloor

sqrt : Float -> Float
sqrt = floatSqrt

showFloat : Float -> String
showFloat = floatShow

compareFloat : Float -> Float -> Ordering
compareFloat a b = if a <. b then LT else if a ==. b then EQ else GT

-- Strings
--------------------------------------------------------------------------------

foreign import strAppend : String -> String -> String
foreign import strLength : String -> Int
foreign import strSlice : String -> Int -> Int -> String
foreign import strEq : String -> String -> Bool
foreign import strLt : String -> String -> Bool

-- | `a ^ b`: the string `a`, then `b`.
(^) : String -> String -> String
(^) = strAppend

-- Pairs, Maybe, Either
--------------------------------------------------------------------------------

fst : {a b : Type} -> Pair a b -> a
fst (MkPair x y) = x

snd : {a b : Type} -> Pair a b -> b
snd (MkPair x y) = y

maybe : {a b : Type} -> b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

fromMaybe : {a : Type} -> a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

either : {a b c : Type} -> (a -> c) -> (b -> c) -> Either a b -> c
either f g (Left x) = f x
either f g (Right y) = g y

-- Lists (their operations are `List`'s, lib/list.hf)
--------------------------------------------------------------------------------

-- | `xs ++ ys`: the elements of `xs`, then those of `ys`.
(++) : {a : Type} -> List a -> List a -> List a
(++) Nil ys = ys
(++) (Cons x xs) ys = Cons x (xs ++ ys)

-- Text
--------------------------------------------------------------------------------

foreign import strCharCode : String -> Int -> Int
foreign import strFromCharCode : Int -> String

-- | The code (UTF-16) at `i`; out of range, `-1`.
charCode : String -> Int -> Int
charCode = strCharCode

fromCharCode : Int -> String
fromCharCode = strFromCharCode

compareString : String -> String -> Ordering
compareString a b = if strLt a b then LT else if strEq a b then EQ else GT

-- | Where `needle` is first in `s`, from `i` on, if it is.
indexFrom : String -> String -> Int -> Maybe Int
indexFrom needle s i =
  if i + strLength needle > strLength s then Nothing
  else if strEq (strSlice s i (i + strLength needle)) needle then Just i
  else indexFrom needle s (i + 1)

indexOf : String -> String -> Maybe Int
indexOf needle s = indexFrom needle s 0

contains : String -> String -> Bool
contains needle s = maybe False (\_ -> True) (indexOf needle s)

startsWith : (prefix : String) -> String -> Bool
startsWith prefix s = strEq (strSlice s 0 (strLength prefix)) prefix

endsWith : String -> String -> Bool
endsWith suffix s =
  strEq (strSlice s (strLength s - strLength suffix) (strLength s)) suffix

-- (the pieces of `s` from `i` on, split at each `sep`, into `acc`, last
-- first)
splitFrom : String -> String -> Int -> List String -> List String
splitFrom sep s i acc = case indexFrom sep s i of
  Nothing -> backwards (Cons (strSlice s i (strLength s)) acc) Nil
  Just j -> splitFrom sep s (j + strLength sep) (Cons (strSlice s i j) acc)
  where
    backwards : List String -> List String -> List String
    backwards Nil out = out
    backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between the `sep`s (not empty: `split "," "a,,b"` is
-- | `["a", "", "b"]`).
split : String -> String -> List String
split sep s = if strLength sep == 0 then [s] else splitFrom sep s 0 Nil

-- | The strings, with `sep` between each two.
joinWith : String -> List String -> String
joinWith sep Nil = ""
joinWith sep (Cons x xs) = after x xs
  where
    after : String -> List String -> String
    after acc Nil = acc
    after acc (Cons y ys) = after (acc ^ sep ^ y) ys

lines : String -> List String
lines s = split "\n" s

unlines : List String -> String
unlines xs = joinWith "\n" xs

isSpaceCode : Int -> Bool
isSpaceCode c = c == 32 || c == 9 || c == 10 || c == 13

-- (the words of `s` from `i` on, the one being read starting at `start`,
-- into `acc`, last first)
wordsFrom : String -> Int -> Int -> List String -> List String
wordsFrom s start i acc =
  if i >= strLength s
    then backwards
        (if start < i then Cons (strSlice s start i) acc else acc)
        Nil
  else if isSpaceCode (strCharCode s i)
    then wordsFrom
        s
        (i + 1)
        (i + 1)
        (if start < i then Cons (strSlice s start i) acc else acc)
  else wordsFrom s start (i + 1) acc
  where
    backwards : List String -> List String -> List String
    backwards Nil out = out
    backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between its spaces, tabs and line breaks.
words : String -> List String
words s = wordsFrom s 0 0 Nil

unwords : List String -> String
unwords xs = joinWith " " xs

-- (from `i`, the first index whose code is not a space, going by `step`)
skipSpaces : String -> Int -> Int -> Int
skipSpaces s i step =
  if 0 <= i && i < strLength s && isSpaceCode (strCharCode s i)
    then skipSpaces s (i + step) step
  else i

-- | Without the spaces at either end.
trim : String -> String
trim s =
  strSlice s (skipSpaces s 0 1) (skipSpaces s (strLength s - 1) (0 - 1) + 1)

-- (the digits of `s` from `i` on, after `n` so far)
digitsFrom : String -> Int -> Int -> Maybe Int
digitsFrom s i n =
  if i >= strLength s then Just n
  else if 48 <= strCharCode s i && strCharCode s i <= 57
    then digitsFrom s (i + 1) (n * 10 + (strCharCode s i - 48))
  else Nothing

-- | A decimal integer (`42`, `-7`), if `s` is one, whole.
parseInt : String -> Maybe Int
parseInt s =
  if strLength s == 0 then Nothing
  else if startsWith "-" s
    then (if strLength s == 1 then Nothing
          else maybe Nothing (\n -> Just (0 - n)) (digitsFrom s 1 0))
  else digitsFrom s 0 0

-- Nat
--------------------------------------------------------------------------------

-- | Recursion on `Nat`, non-dependent.
natrec : {c : Type} -> c -> (Nat -> c -> c) -> Nat -> c
natrec z s Zero = z
natrec z s (Succ n) = s n (natrec z s n)

-- >>> natrec (c := Nat) Zero (\_ n -> Succ (Succ n)) (Succ (Succ Zero))
-- Succ (Succ (Succ (Succ Zero)))

-- >>> 1 + 2 * 3 - 4 / 2
-- 5

-- >>> "count: " ^ showInt (7 % 3)
-- "count: 1"

-- >>> "he" ^ "ff" ^ "!"
-- "heff!"

-- >>> 1 < 2 && 2 <= 2 || False
-- True

-- >>> [1, 2] ++ [3]
-- Cons 1 (Cons 2 (Cons 3 Nil))

-- >>> fromMaybe 0 (Just 4)
-- 4
