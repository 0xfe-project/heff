-- The basic types and what is done with them: Nat, Empty, pairs, Maybe,
-- Either, Bytes (bytes has its operations); Bool, Unit and lists
-- (builtin has them), lists' `::` and `++` (their other
-- operations are `List`'s); numbers and strings, by the
-- primitives, with their operators.

module prelude

-- | The natural numbers.
data Nat = Zero | Succ Nat

data Empty

data Pair a b = MkPair a b

data Maybe a = Nothing | Just a

data Either a b = Left a | Right b

-- | Bytes, not changed once made: a type of its own beside `String`,
-- | written `b[...]`, whose operations are `bytes`'s (`import bytes as
-- | Bytes`), but its equality, `instanceEqualityBytes`, its `Show`,
-- | `instanceShowBytes`, and its `ToString`, `instanceToStringBytes`
data Bytes

-- | Bits, a bitstring of any length, not changed once made: a type of
-- | its own beside `Bytes` (which are whole bytes), written `b[...]`
-- | where its segments are not whole bytes (`b[5::3]`), whose operations
-- | are `bits`'s (`import bits as Bits`), but its equality,
-- | `instanceEqualityBits`, its `Show`, `instanceShowBits`, and its
-- | `ToString`, `instanceToStringBits`
data Bits

-- | `x :: xs` is `Cons x xs`; a pattern too, as it only names the tag
(::) : {a : Type} -> a -> List a -> List a
(::) x xs = Cons x xs

-- Functions
--------------------------------------------------------------------------------

id : {a : Type} -> a -> a
id x = x

const : {a b : Type} -> a -> b -> a
const x _ = x

flip : {a b c : Type} -> (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose : {a b c : Type} -> (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

-- The operators: `||` loosest, then `&&`, the comparisons, then `+ -`,
-- `^` and `++` (unrelated: `a + b ^ c` is refused), then `* / %` and a
-- float's division, `/.`; a monad's `>>=` below `||`; and `$` below
-- all, any module's too (`below` alone).
--------------------------------------------------------------------------------

infixr ||
infixr && above ||
infix == /= < <= > >= above &&
infixl + - above == /= < <= > >=
infixl * / % /. above + -
infixr ++ above == /= < <= > >=
infixl ^ above == /= < <= > >=
infixr :: above == /= < <= > >= below + - * / % ++ ^
infixl >>= below ||
infixr $ below

-- | Application, loosest: `f $ g $ x` is `f (g x)`.
($) : {a b : Type} -> (a -> b) -> a -> b
($) f x = f x

-- Bool
--------------------------------------------------------------------------------

not : Bool -> Bool
not True = False
not False = True

(&&) : Bool -> Bool -> Bool
(&&) True b = b
(&&) False _ = False

(||) : Bool -> Bool -> Bool
(||) True _ = True
(||) False b = b

-- | How one value is to another: less, equal, or greater.
data Ordering = LT | EQ | GT

-- The operators' theories
--------------------------------------------------------------------------------

-- An operator is an operation of a theory, of the instance found for the
-- type it is used at: `x + y` is the `add` of an `Addition` of their type
-- -- an `Int`'s, the prelude's; a fixed-width type's, its module's; a
-- generic function's, the instance argument it asks for, `{{add :
-- Addition a}}`.  Each operation is a theory of its own, as Lean's are,
-- so a type has those it has: an integer `/` and `%`, a float neither
-- (but `/.`, a `FloatDivision`'s).  Where the instance is known the
-- operation is what is compiled: `n + 1` at `Int` is `intAdd n 1`, as if
-- written so.  A theory is named by a whole noun, `Addition`, not `Add`:
-- the short names are left to a program's own types and tags (`data Op =
-- Add | Sub | Mul | Div`).

-- | A type's equality: a function that compares values of a type it does
-- | not know asks for it, `{{eq : Equality a}}`, and is given the instance in
-- | scope of the type it is used at -- the prelude's of `Int`, `Float64`,
-- | `String`, `Rune`, `Bool`, `Unit` and `Ordering`, and of a `List`, a
-- | `Maybe`, a `Pair` and an `Either` of types that have one, found by
-- | finding theirs; a fixed-width type's module's of its own.
theory Equality (a : Type) where
  equal : a -> a -> Bool

(==) : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
(==) = eq.equal

(/=) : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
(/=) x y = not (eq.equal x y)

-- | A type's order: its equality (`eq`), how two values are (`compare`),
-- | and whether one is less than the other, or not greater (`lt`, `le`:
-- | what `<` and `<=` are, as fast as the type has them) -- the prelude's
-- | of `Int`,
-- | `Float64`, `String`, `Rune`, `Bool`, `Unit` and `Ordering`, and of a
-- | `List`, a `Maybe` and a `Pair` of types that have one; a fixed-width
-- | type's module's of its own.
theory Order (a : Type) where
  eq : Equality a
  compare : a -> a -> Ordering
  lt : a -> a -> Bool
  le : a -> a -> Bool

compare : {a : Type} -> {{ord : Order a}} -> a -> a -> Ordering
compare = ord.compare

(<) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(<) = ord.lt

(<=) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(<=) = ord.le

(>) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(>) x y = ord.lt y x

(>=) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(>=) x y = ord.le y x

-- | The lesser of the two (the first, of two as great).
min : {a : Type} -> {{ord : Order a}} -> a -> a -> a
min x y = if ord.le x y then x else y

-- | The greater of the two (the second, of two as great).
max : {a : Type} -> {{ord : Order a}} -> a -> a -> a
max x y = if ord.le x y then y else x

theory Addition (a : Type) where
  add : a -> a -> a

(+) : {a : Type} -> {{add : Addition a}} -> a -> a -> a
(+) = add.add

theory Subtraction (a : Type) where
  sub : a -> a -> a

(-) : {a : Type} -> {{sub : Subtraction a}} -> a -> a -> a
(-) = sub.sub

theory Multiplication (a : Type) where
  mul : a -> a -> a

(*) : {a : Type} -> {{mul : Multiplication a}} -> a -> a -> a
(*) = mul.mul

-- | A type's division, total: by zero, zero, as Lean's and Coq's are --
-- | no division abandons, and `x / 0` is 0 (`exception`'s `divOrThrow`
-- | throws instead).  Not a float's: `/.` is a float's, IEEE's.
theory Division (a : Type) where
  div : a -> a -> a

(/) : {a : Type} -> {{div : Division a}} -> a -> a -> a
(/) = div.div

-- | The remainder of a type's division, total: by zero, the dividend, so
-- | that `(x / y) * y + x % y` is `x` whatever `y` is.
theory Remainder (a : Type) where
  mod : a -> a -> a

(%) : {a : Type} -> {{mod : Remainder a}} -> a -> a -> a
(%) = mod.mod

-- | A type's negation: what `-x` is, the `neg` in scope applied to `x`.
theory Negation (a : Type) where
  neg : a -> a

neg : {a : Type} -> {{n : Negation a}} -> a -> a
neg = n.neg

-- | A float type's division, IEEE's: by 0, an infinity (or not a number,
-- | of 0 by 0) -- what `/.` is, the prelude's of `Float64`, `float32`'s of
-- | `Float32`.  An integer type has none: its division is `/`, total.
theory FloatDivision (a : Type) where
  divide : a -> a -> a

(/.) : {a : Type} -> {{divide : FloatDivision a}} -> a -> a -> a
(/.) = divide.divide

-- | Whether a value is its type's zero: what `exception`'s `divOrThrow` and
-- | `modOrThrow` ask of the divisor -- the prelude's of `Int`, a fixed-width
-- | integer type's module's of its own.
theory IsZero (a : Type) where
  isZero : a -> Bool

-- | An integer type's bits, as two's complement has them: the and, or and
-- | xor of two, every bit flipped, and shifts -- an `Int`'s in `int`'s
-- | module, a fixed-width type's in its own.
theory Bitwise (a : Type) where
  and : a -> a -> a
  or : a -> a -> a
  xor : a -> a -> a
  complement : a -> a
  shiftL : a -> a -> a
  shiftR : a -> a -> a

-- | The bits set in both.
and : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
and = bits.and

-- | The bits set in either.
or : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
or = bits.or

-- | The bits set in one of the two.
xor : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
xor = bits.xor

-- | Every bit flipped.
complement : {a : Type} -> {{bits : Bitwise a}} -> a -> a
complement = bits.complement

-- | Shifted left by the second, as the type shifts.
shiftL : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
shiftL = bits.shiftL

-- | Shifted right by the second, as the type shifts.
shiftR : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
shiftR = bits.shiftR

-- Numbers (integers, unbounded)
--------------------------------------------------------------------------------

primitive intAdd : Int -> Int -> Int
primitive intSub : Int -> Int -> Int
primitive intMul : Int -> Int -> Int
primitive intDiv : Int -> Int -> Int
primitive intMod : Int -> Int -> Int
primitive intEq : Int -> Int -> Bool
primitive intLt : Int -> Int -> Bool
primitive intLe : Int -> Int -> Bool
primitive intShow : Int -> String

instance instanceEqualityInt : Equality Int
instanceEqualityInt = { equal = intEq }

compareInt : Int -> Int -> Ordering
compareInt a b = if intLt a b then LT else if intEq a b then EQ else GT

-- | >>> 1 < 2 && 2 <= 2 || False
-- | True
-- | >>> ([max 2 (-3), min 2 (-3)] : List Int)
-- | Cons 2 (Cons (-3) Nil)
instance instanceOrderInt : Order Int
instanceOrderInt =
  { eq = instanceEqualityInt, compare = compareInt, lt = intLt, le = intLe }

instance instanceAdditionInt : Addition Int
instanceAdditionInt = { add = intAdd }

instance instanceSubtractionInt : Subtraction Int
instanceSubtractionInt = { sub = intSub }

instance instanceMultiplicationInt : Multiplication Int
instanceMultiplicationInt = { mul = intMul }

-- | Division rounding down; by 0, 0.
instance instanceDivisionInt : Division Int
instanceDivisionInt = { div = intDiv }

-- | The remainder of `/`, of the sign of the divisor; by 0, the dividend.
-- | >>> 1 + 2 * 3 - 4 / 2
-- | 5
-- | >>> ([7 / 2, -7 / 2, 7 % 2, -7 % 2, 7 % -2] : List Int)
-- | Cons 3 (Cons (-4) (Cons 1 (Cons 1 (Cons (-1) Nil))))
-- | >>> ([7 / 0, 7 % 0, (7 / 0) * 0 + 7 % 0] : List Int)
-- | Cons 0 (Cons 7 (Cons 7 Nil))
instance instanceRemainderInt : Remainder Int
instanceRemainderInt = { mod = intMod }

-- | The integer of the other sign, `0 - x`: what `-x` is.
-- | >>> ([neg 5, -(3 - 10)] : List Int)
-- | Cons (-5) (Cons 7 Nil)
instance instanceNegationInt : Negation Int
instanceNegationInt = { neg = \x -> intSub 0 x }

-- | >>> ([instanceIsZeroInt.isZero 0, instanceIsZeroInt.isZero (-3)] : List Bool)
-- | Cons True (Cons False Nil)
instance instanceIsZeroInt : IsZero Int
instanceIsZeroInt = { isZero = \x -> intEq x 0 }

-- Floats (JavaScript's numbers: 64-bit floating point)
--------------------------------------------------------------------------------

primitive floatAdd : Float64 -> Float64 -> Float64
primitive floatSub : Float64 -> Float64 -> Float64
primitive floatMul : Float64 -> Float64 -> Float64
primitive floatDiv : Float64 -> Float64 -> Float64
primitive floatEq : Float64 -> Float64 -> Bool
primitive floatLt : Float64 -> Float64 -> Bool
primitive floatLe : Float64 -> Float64 -> Bool
primitive floatShow : Float64 -> String
primitive floatFromInt : Int -> Float64
primitive floatSqrt : Float64 -> Float64
primitive floatFloor : Float64 -> Int

-- (IEEE's: NaN is no float's equal, its own neither)
instance instanceEqualityFloat64 : Equality Float64
instanceEqualityFloat64 = { equal = floatEq }

compareFloat : Float64 -> Float64 -> Ordering
compareFloat a b = if floatLt a b then LT else if floatEq a b then EQ else GT

instance instanceOrderFloat64 : Order Float64
instanceOrderFloat64 =
  { eq = instanceEqualityFloat64
  , compare = compareFloat
  , lt = floatLt
  , le = floatLe
  }

instance instanceAdditionFloat64 : Addition Float64
instanceAdditionFloat64 = { add = floatAdd }

instance instanceSubtractionFloat64 : Subtraction Float64
instanceSubtractionFloat64 = { sub = floatSub }

instance instanceMultiplicationFloat64 : Multiplication Float64
instanceMultiplicationFloat64 = { mul = floatMul }

-- | The float of the other sign, 0.0's too: what `-x` is.
instance instanceNegationFloat64 : Negation Float64
instanceNegationFloat64 = { neg = \x -> floatMul (-1.0) x }

-- | Division; by 0, an infinity (or not a number, of 0 by 0): a float has
-- | no `/`, whose division by 0 is 0.
-- | >>> ([neg 2.5, -(1.0 - 3.5), 1.0 /. neg 0.0, 2.5 * 2.0 + 1.0] : List Float64)
-- | [-2.5, 2.5, -Infinity, 6.0]
instance instanceFloatDivisionFloat64 : FloatDivision Float64
instanceFloatDivisionFloat64 = { divide = floatDiv }

-- | `x` without its sign: the greater of `x` and `-x`.
-- | >>> abs (-3)
-- | 3
-- | >>> abs 7
-- | 7
-- | >>> abs (-2.5)
-- | 2.5
abs : {a : Type} -> {{ord : Order a}} -> {{n : Negation a}} -> a -> a
abs x = max x (n.neg x)

toFloat : Int -> Float64
toFloat = floatFromInt

-- | The greatest integer not above; of an infinity, or what is not a
-- | number, 0.
-- | >>> ([floor 2.5, floor (-2.5), floor (1.0 /. 0.0), floor (-1.0 /. 0.0), floor (0.0 /. 0.0)] : List Int)
-- | Cons 2 (Cons (-3) (Cons 0 (Cons 0 (Cons 0 Nil))))
floor : Float64 -> Int
floor = floatFloor

sqrt : Float64 -> Float64
sqrt = floatSqrt

-- Strings: bytes, UTF-8 as a literal has them (`"é"` is two), though
-- any bytes may be in one, as Go's: its length, an index, a slice are of
-- bytes, its order the bytes' (of UTF-8 its runes' order), and `runes`
-- reads its runes.
--------------------------------------------------------------------------------

primitive strAppend : String -> String -> String
primitive strLength : String -> Int
primitive strSlice : String -> Int -> Int -> String
primitive strEq : String -> String -> Bool
primitive strLt : String -> String -> Bool
primitive strCompare : String -> String -> Int
primitive strFind : String -> String -> Int -> Int

-- | `a ^ b`: the string `a`, then `b`.
-- | >>> "count: " ^ intShow (7 % 3)
-- | "count: 1"
-- | >>> "he" ^ "ff" ^ "!"
-- | "heff!"
(^) : String -> String -> String
(^) = strAppend

-- Equality
--------------------------------------------------------------------------------

instance instanceEqualityString : Equality String
instanceEqualityString = { equal = strEq }

primitive bytesEq : Bytes -> Bytes -> Bool

-- (what a binary, `b[...]`, is made and taken apart by -- `bytes` has
-- them by other names: their length, a slice, many put together; an
-- integer of `n` bits at bit `o`, the flags `f` 1 for little-endian, 2
-- for signed; one written as bytes; whether some are at `o`)
primitive bytesLength : Bytes -> Int
primitive bytesSlice : Bytes -> Int -> Int -> Bytes
primitive bytesConcat : List Bytes -> Bytes
primitive bytesIntAt : Bytes -> Int -> Int -> Int -> Int
primitive bytesOfInt : Int -> Int -> Int -> Bytes
primitive bytesHasAt : Bytes -> Int -> Bytes -> Bool

-- | The first `n` bytes of `b`, as a segment `x::binary-size(n)` of a
-- | binary writes them: of fewer, abandoned.
bytesSized : Int -> Bytes -> Bytes
bytesSized n b =
  if 0 <= n && n <= bytesLength b then bytesSlice b 0 n else abandon

-- | `Bytes`' (their other operations are `bytes`'s): the same bytes.
-- | >>> b["hi", 255] == b[104, "i", 0xFF]
-- | True
instance instanceEqualityBytes : Equality Bytes
instanceEqualityBytes = { equal = bytesEq }

instance instanceEqualityRune : Equality Rune
instanceEqualityRune = { equal = runeEq }

instance instanceEqualityBool : Equality Bool
instanceEqualityBool = { equal = \a b -> if a then b else not b }

instance instanceEqualityUnit : Equality Unit
instanceEqualityUnit = { equal = \a b -> True }

instance instanceEqualityOrdering : Equality Ordering
instanceEqualityOrdering = { equal = sameOrder }
  where
  sameOrder : Ordering -> Ordering -> Bool
  sameOrder LT LT = True
  sameOrder EQ EQ = True
  sameOrder GT GT = True
  sameOrder _ _ = False

-- | Whether the two are equal, as the instance of their type says.
-- | >>> equal 3 3
-- | True
-- | >>> equal "heff" "help"
-- | False
-- | >>> equal 0.5 0.5 && not (equal 'a' 'b') && equal (1 < 2) True
-- | True
-- | >>> equal (compareInt 1 2) LT
-- | True
equal : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
equal x y = eq.equal x y

-- | Lists are equal where they are as long, and equal element by element.
-- | >>> equal ([1, 2] : List Int) [1, 2]
-- | True
-- | >>> equal ([[1, 2], [3]] : List (List Int)) [[1, 2], []]
-- | False
instance instanceEqualityList : {a : Type}
                              -> {{eq : Equality a}}
                              -> Equality (List a)
instanceEqualityList = { equal = sameElements }
  where
  sameElements : List a -> List a -> Bool
  sameElements Nil Nil = True
  sameElements (Cons x xs) (Cons y ys) = equal x y && sameElements xs ys
  sameElements _ _ = False

-- | >>> equal (Just 'h' : Maybe Rune) (Just 'h')
-- | True
-- | >>> equal (Just [1] : Maybe (List Int)) Nothing
-- | False
instance instanceEqualityMaybe : {a : Type}
                               -> {{eq : Equality a}}
                               -> Equality (Maybe a)
instanceEqualityMaybe = { equal = bothOrNeither }
  where
  bothOrNeither : Maybe a -> Maybe a -> Bool
  bothOrNeither Nothing Nothing = True
  bothOrNeither (Just x) (Just y) = equal x y
  bothOrNeither _ _ = False

-- | >>> equal (MkPair 1 "one" : Pair Int String) (MkPair 1 "one")
-- | True
instance instanceEqualityPair : {a b : Type}
                              -> {{eqA : Equality a}}
                              -> {{eqB : Equality b}}
                              -> Equality (Pair a b)
instanceEqualityPair = { equal = sameSides }
  where
  sameSides : Pair a b -> Pair a b -> Bool
  sameSides (MkPair x1 y1) (MkPair x2 y2) = equal x1 x2 && equal y1 y2

-- | >>> equal (Left 1 : Either Int String) (Right "1")
-- | False
instance instanceEqualityEither : {a b : Type}
                                -> {{eqA : Equality a}}
                                -> {{eqB : Equality b}}
                                -> Equality (Either a b)
instanceEqualityEither = { equal = sameSide }
  where
  sameSide : Either a b -> Either a b -> Bool
  sameSide (Left x) (Left y) = equal x y
  sameSide (Right x) (Right y) = equal x y
  sameSide _ _ = False

-- Pairs, Maybe, Either
--------------------------------------------------------------------------------

fst : {a b : Type} -> Pair a b -> a
fst (MkPair x y) = x

snd : {a b : Type} -> Pair a b -> b
snd (MkPair x y) = y

maybe : {a b : Type} -> b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

-- | >>> fromMaybe 0 (Just 4)
-- | 4
fromMaybe : {a : Type} -> a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

either : {a b c : Type} -> (a -> c) -> (b -> c) -> Either a b -> c
either f g (Left x) = f x
either f g (Right y) = g y

-- Monads
--------------------------------------------------------------------------------

-- | A monad, no laws asked: a value as a computation (`pure`), and a
-- | computation and what comes after it as one (`bind`).  `do` is not
-- | this: it takes the `bind` in scope by name, so a monad's module keeps
-- | its own `bind` and `pure`, and builds its instance of them -- the
-- | prelude's of `Maybe` and `Either e`, `co`'s of `Co h`, `generator`'s
-- | of `Generator`.  What is written once for every monad asks for one,
-- | `{{mo : Monad m}}`, and a module using it at its own monad gives its
-- | instance once: `traverseS = traverse (mo := instanceMonadS)`.
theory Monad (m : Type -> Type) where
  pure : {a : Type} -> a -> m a
  bind : {a b : Type} -> m a -> (a -> m b) -> m b

-- | A monad's `bind`, written between: `c >>= f` is `f` of what `c`
-- | gives, as `do` writes `x <- c` then `f x`.
(>>=) : {m : Type -> Type}
      -> {{mo : Monad m}}
      -> {a b : Type}
      -> m a
      -> (a -> m b)
      -> m b
(>>=) = mo.bind

-- | `Maybe`'s monad: a computation that may give nothing, and then the
-- | rest gives nothing too.
instance instanceMonadMaybe : Monad Maybe
instanceMonadMaybe = { pure = given, bind = bound }
  where
  given : {a : Type} -> a -> Maybe a
  given x = Just x
  bound : {a b : Type} -> Maybe a -> (a -> Maybe b) -> Maybe b
  bound Nothing f = Nothing
  bound (Just x) f = f x

-- | `Either e`'s monad: a computation that may fail with an `e`
-- | (`Left`), and then the rest fails with it too.
instance instanceMonadEither : {e : Type} -> Monad (Either e)
instanceMonadEither = { pure = given, bind = bound }
  where
  given : {a : Type} -> a -> Either e a
  given x = Right x
  bound : {a b : Type} -> Either e a -> (a -> Either e b) -> Either e b
  bound (Left err) f = Left err
  bound (Right x) f = f x

-- | `f` of each element, in order, and the list of what they gave.
-- | >>> traverse (mo := instanceMonadMaybe) (\x -> if x > 0 then Just (x * 2) else Nothing) [1, 2, 3]
-- | Just [2, 4, 6]
-- | >>> traverse (mo := instanceMonadMaybe) (\x -> if x > 0 then Just x else Nothing) [1, -2, 3]
-- | Nothing
traverse : {m : Type -> Type}
         -> {{mo : Monad m}}
         -> {a b : Type}
         -> (a -> m b)
         -> List a
         -> m (List b)
traverse f Nil = mo.pure Nil
traverse f (Cons x xs) =
  mo.bind
    (f x)
    (\y -> mo.bind (traverse (mo := mo) f xs) (\ys -> mo.pure (Cons y ys)))

-- | A left fold, each step a computation: `f z x1`, then `f` of what it
-- | gave and `x2`, and so on.
-- | >>> foldM (mo := instanceMonadMaybe) (\acc x -> if x > 0 then Just (acc + x) else Nothing) 0 [1, 2, 3]
-- | Just 6
foldM : {m : Type -> Type}
      -> {{mo : Monad m}}
      -> {a b : Type}
      -> (b -> a -> m b)
      -> b
      -> List a
      -> m b
foldM f z Nil = mo.pure z
foldM f z (Cons x xs) = mo.bind (f z x) (\z2 -> foldM (mo := mo) f z2 xs)

-- | `c` if `b`, else nothing done.
-- | >>> when (mo := instanceMonadMaybe) False Nothing
-- | Just MkUnit
when : {m : Type -> Type} -> {{mo : Monad m}} -> Bool -> m Unit -> m Unit
when b c = if b then c else mo.pure MkUnit

-- | `c` unless `b`: if `b`, nothing done.
-- | >>> unless (mo := instanceMonadMaybe) False Nothing
-- | Nothing
unless : {m : Type -> Type} -> {{mo : Monad m}} -> Bool -> m Unit -> m Unit
unless b c = if b then mo.pure MkUnit else c

-- | `c`, `n` times (none, for `n` not above 0), and the list of what it
-- | gave each time.
-- | >>> replicateM (mo := instanceMonadEither) 3 (Right 'x' : Either String Rune)
-- | Right ['x', 'x', 'x']
replicateM : {m : Type -> Type}
           -> {{mo : Monad m}}
           -> {a : Type}
           -> Int
           -> m a
           -> m (List a)
replicateM n c = if intLe n 0 then mo.pure Nil else mo.bind c more
  where
  more : a -> m (List a)
  more x =
    mo.bind (replicateM (mo := mo) (intSub n 1) c) (\xs -> mo.pure (Cons x xs))

-- | The identity monad: a value is its own computation.  Pure code
-- | written as statements is `run do ...`, whose `do` is taken apart by
-- | this monad's `idBind` and `idPure`: their calls simplified away, each
-- | of its loops a function calling only itself, giving its variables back.
type Id a = a

-- | the value of a computation of the identity monad: `run do ...`
run : {a : Type} -> Id a -> a
run x = x

idPure : {a : Type} -> a -> Id a
idPure x = x

idBind : {a b : Type} -> Id a -> (a -> Id b) -> Id b
idBind x f = f x

-- | the type of `x`: what a `do` block's loop takes its variable `x` as,
-- | and what `x := e` checks `e` against
typeOf : {a : Type} -> a -> Type
typeOf x = a

-- | a type its uses decide, the implicit argument left to be solved:
-- | what a `do` block's loop gives, and what `let mut x = e` checks `e`
-- | against
inferred : {a : Type} -> Unit -> Type
inferred u = a

-- | What a scope's answer says to do once it is left, done: a `do`
-- | block's `try` and `with` go on so, to what follows them or further
-- | out.
leaveScope : {a : Type} -> (Unit -> a) -> a
leaveScope k = k MkUnit

-- Lists (their operations are `List`'s)
--------------------------------------------------------------------------------

-- | `xs ++ ys`: the elements of `xs`, then those of `ys`.
-- | >>> [1, 2] ++ [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
(++) : {a : Type} -> List a -> List a -> List a
(++) Nil ys = ys
(++) (Cons x xs) ys = Cons x (xs ++ ys)

-- Iteration
--------------------------------------------------------------------------------

-- | What `for x in c do ...` goes through: a cursor over `c`'s elements
-- | (each an `Elem`), from where it starts, each step the next element
-- | and the cursor after it, or nothing at the end.  A list's cursor is
-- | the list, an array's its index, a range's what is left of it.
theory Iterate (c : Type) where
  Elem : Type
  Cursor : Type
  start : c -> Cursor
  next : Cursor -> Maybe (Pair Elem Cursor)

-- | the instance of `Iterate` found for `x`'s type: what a `for` over
-- | `x` goes through it by
iterateOf : {c : Type} -> {{it : Iterate c}} -> c -> Iterate c
iterateOf x = it

-- | A list, from its first element.
instance instanceIterateList : {a : Type} -> Iterate (List a)
instanceIterateList = { Elem = a, Cursor = List a, start = begin, next = step }
  where
  begin : List a -> List a
  begin xs = xs
  step : List a -> Maybe (Pair a (List a))
  step Nil = Nothing
  step (Cons x xs) = Just (MkPair x xs)

-- | The integers from one to another, both of them in, as `for` goes
-- | through them (none, if the second is less than the first).
data Range = MkRange Int Int

range : Int -> Int -> Range
range a b = MkRange a b

-- | A range, from its first integer up.
instance instanceIterateRange : Iterate Range
instanceIterateRange =
  { Elem = Int, Cursor = Range, start = begin, next = step }
  where
  begin : Range -> Range
  begin r = r
  step : Range -> Maybe (Pair Int Range)
  step (MkRange a b) =
    if intLe a b then Just (MkPair a (MkRange (intAdd a 1) b)) else Nothing

-- Text
--------------------------------------------------------------------------------

primitive strByteAt : String -> Int -> Int
primitive strFromByte : UInt8 -> String

-- | The byte at `i`, 0 to 255; out of range, `-1`.
-- | >>> byteAt "a\u{e9}" 1
-- | 195
-- | >>> byteAt "a\u{e9}" 3
-- | -1
byteAt : String -> Int -> Int
byteAt = strByteAt

-- | The string of one byte: a byte of no rune too, which no literal but
-- | a `\xNN` escape has.  An `Int` is made a byte by `uint8`'s `fromInt`,
-- | wrapping around (`fromByte (U8.fromInt n)`).
-- | >>> fromByte 104 ^ fromByte 105
-- | "hi"
-- | >>> fromByte 255 == "\xff" && byteAt (fromByte 0) 0 == 0
-- | True
fromByte : UInt8 -> String
fromByte = strFromByte

primitive strRunes : String -> List Rune
primitive strOfRunes : List Rune -> String
primitive strRuneAt : String -> Int -> Rune
primitive strRuneWidth : String -> Int -> Int
primitive runeToInt : Rune -> Int
primitive uint8FromInt : Int -> UInt8

-- | The runes of `s`, its code points, UTF-8 read: `runes "a😀"` is
-- | `['a', '😀']`; what is not UTF-8 is U+FFFD, one for each longest
-- | start of a rune's bytes (or a byte that starts none), as
-- | `TextDecoder` reads it.  Their operations are rune's.
runes : String -> List Rune
runes = strRunes

-- | The string of runes, UTF-8 (one that is no Unicode scalar value,
-- | U+FFFD): `ofRunes (runes s)` is `s`, where `s` is UTF-8.
ofRunes : List Rune -> String
ofRunes = strOfRunes

-- | A rune of a string, and how many bytes of it it takes.
type RuneAt = { rune : Rune, width : Int }

-- | The rune whose bytes start at `i`, and how many they are (Go's
-- | `utf8.DecodeRuneInString`): where they are not UTF-8, U+FFFD, as
-- | `runes` reads it; out of range, U+FFFD of none.
-- | >>> (runeAt "a\u{e9}b" 1).width
-- | 2
-- | >>> (runeAt "a\u{e9}b" 2).width
-- | 1
runeAt : String -> Int -> RuneAt
runeAt s i = { rune = strRuneAt s i, width = strRuneWidth s i }

-- | A string, rune by rune, as `runes` reads it: its cursor is the
-- | string and the byte its next rune starts at.
instance instanceIterateString : Iterate String
instanceIterateString =
  { Elem = Rune, Cursor = Pair String Int, start = begin, next = step }
  where
  begin : String -> Pair String Int
  begin s = MkPair s 0
  step : Pair String Int -> Maybe (Pair Rune (Pair String Int))
  step (MkPair s i) =
    if intLt i (strLength s)
    then Just (MkPair (strRuneAt s i) (MkPair s (intAdd i (strRuneWidth s i))))
    else Nothing

-- | The order of two strings, their bytes' (of UTF-8, their runes'),
-- | by one comparison of them.
-- | >>> (MkPair (compareString "pear" "apple") (compareString "pear" "pears") : Pair Ordering Ordering)
-- | MkPair GT LT
-- | >>> compareString "z" "\u{e9}"
-- | LT
compareString : String -> String -> Ordering
compareString a b = compareInt (strCompare a b) 0

-- Order
--------------------------------------------------------------------------------

-- | The `Order` of a comparison and the type's equality: `lt` and `le`
-- | are by the comparison.
orderByCompare : {a : Type}
               -> {{eq : Equality a}}
               -> (a -> a -> Ordering)
               -> Order a
orderByCompare cmp =
  { eq = eq
  , compare = cmp
  , lt = \x y -> below (cmp x y)
  , le = \x y -> notAbove (cmp x y)
  }
  where
  below : Ordering -> Bool
  below LT = True
  below _ = False

  notAbove : Ordering -> Bool
  notAbove GT = False
  notAbove _ = True

-- | Strings' order, their bytes' (`compareString`'s).
-- | >>> "apple" < "pear" && not ("pear" <= "pea")
-- | True
instance instanceOrderString : Order String
instanceOrderString = orderByCompare compareString

-- | `False` before `True`.
-- | >>> compare (False : Bool) True
-- | LT
instance instanceOrderBool : Order Bool
instanceOrderBool = orderByCompare ordered
  where
  ordered : Bool -> Bool -> Ordering
  ordered False True = LT
  ordered True False = GT
  ordered _ _ = EQ

instance instanceOrderUnit : Order Unit
instanceOrderUnit = orderByCompare (\x y -> EQ)

-- | `LT` before `EQ` before `GT`.
instance instanceOrderOrdering : Order Ordering
instanceOrderOrdering = orderByCompare (\x y -> compareInt (rank x) (rank y))
  where
  rank : Ordering -> Int
  rank LT = 0
  rank EQ = 1
  rank GT = 2

-- | Lists by their elements, the first that differ (a list before a
-- | longer one it begins).
-- | >>> (MkPair (compare ([1, 2] : List Int) [1, 3]) (compare ([1, 2] : List Int) [1]) : Pair Ordering Ordering)
-- | MkPair LT GT
-- | >>> (instanceOrderList : Order (List Int)).eq.equal [1, 2] [1, 2]
-- | True
instance instanceOrderList : {a : Type} -> {{ord : Order a}} -> Order (List a)
instanceOrderList =
  orderByCompare (eq := instanceEqualityList (eq := ord.eq)) lexically
  where
  lexically : List a -> List a -> Ordering
  lexically Nil Nil = EQ
  lexically Nil _ = LT
  lexically _ Nil = GT
  lexically (Cons x xs) (Cons y ys) = case compare x y of
    EQ -> lexically xs ys
    o -> o

-- | `Nothing` before any `Just`, and those by what they hold.
instance instanceOrderMaybe : {a : Type} -> {{ord : Order a}} -> Order (Maybe a)
instanceOrderMaybe =
  orderByCompare (eq := instanceEqualityMaybe (eq := ord.eq)) ordered
  where
  ordered : Maybe a -> Maybe a -> Ordering
  ordered Nothing Nothing = EQ
  ordered Nothing _ = LT
  ordered _ Nothing = GT
  ordered (Just x) (Just y) = compare x y

-- | Pairs by their first, then their second.
-- | >>> compare (MkPair 1 "b" : Pair Int String) (MkPair 1 "a")
-- | GT
instance instanceOrderPair : {a b : Type}
                           -> {{ordA : Order a}}
                           -> {{ordB : Order b}}
                           -> Order (Pair a b)
instanceOrderPair =
  orderByCompare
    (eq := instanceEqualityPair (eqA := ordA.eq) (eqB := ordB.eq))
    ordered
  where
  ordered : Pair a b -> Pair a b -> Ordering
  ordered (MkPair x1 y1) (MkPair x2 y2) = case compare x1 x2 of
    EQ -> compare y1 y2
    o -> o

-- (an index found, if it is one: -1 is none)
foundAt : Int -> Maybe Int
foundAt j = if j < 0 then Nothing else Just j

-- | Where `needle` is first in `s`, from `i` on (from 0, an `i` below
-- | it), if it is.
-- | >>> indexFrom "lo" "hello, world: lo" 4
-- | Just 14
-- | >>> indexFrom "" "ab" 2
-- | Just 2
-- | >>> indexFrom "" "ab" 3
-- | Nothing
indexFrom : String -> String -> Int -> Maybe Int
indexFrom needle s i = foundAt (strFind needle s i)

indexOf : String -> String -> Maybe Int
indexOf needle s = indexFrom needle s 0

-- | >>> contains "ell" "hello" && not (contains "elo" "hello")
-- | True
contains : String -> String -> Bool
contains needle s = strFind needle s 0 >= 0

startsWith : (prefix : String) -> String -> Bool
startsWith prefix s = strEq (strSlice s 0 (strLength prefix)) prefix

endsWith : String -> String -> Bool
endsWith suffix s =
  strEq (strSlice s (strLength s - strLength suffix) (strLength s)) suffix

-- (the pieces of `s` from `i` on, the next `sep` at `j` (-1: none), split
-- at each `sep`, into `acc`, last first)
splitFrom : String -> String -> Int -> Int -> List String -> List String
splitFrom sep s i j acc =
  if j < 0 then backwards (Cons (strSlice s i (strLength s)) acc) Nil
  else splitFrom
      sep
      s
      (j + strLength sep)
      (strFind sep s (j + strLength sep))
      (Cons (strSlice s i j) acc)
  where
  backwards : List String -> List String -> List String
  backwards Nil out = out
  backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between the `sep`s (not empty: `split "," "a,,b"` is
-- | `["a", "", "b"]`).
-- | >>> split ", " "a, b, , c"
-- | Cons "a" (Cons "b" (Cons "" (Cons "c" Nil)))
split : String -> String -> List String
split sep s =
  if strLength sep == 0 then [s] else splitFrom sep s 0 (strFind sep s 0) Nil

-- | The strings, with `sep` between each two.
joinWith : String -> List String -> String
joinWith sep Nil = ""
joinWith sep (Cons x xs) = after x xs
  where
  after : String -> List String -> String
  after acc Nil = acc
  after acc (Cons y ys) = after (acc ^ sep ^ y) ys

-- | The pieces of `s` between its line breaks (`"\n"`).
-- | >>> lines "one\ntwo\n"
-- | Cons "one" (Cons "two" (Cons "" Nil))
lines : String -> List String
lines s = split "\n" s

unlines : List String -> String
unlines xs = joinWith "\n" xs

isSpaceCode : Int -> Bool
isSpaceCode c = c == 32 || c == 9 || c == 10 || c == 13

-- (the words of `s` from `i` on, the one being read starting at `start`,
-- into `acc`, last first)
wordsFrom : String -> Int -> Int -> List String -> List String
wordsFrom s start i acc =
  if i >= strLength s
  then backwards
      (if start < i then Cons (strSlice s start i) acc else acc)
      Nil
  else if isSpaceCode (strByteAt s i)
  then wordsFrom
      s
      (i + 1)
      (i + 1)
      (if start < i then Cons (strSlice s start i) acc else acc)
  else wordsFrom s start (i + 1) acc
  where
  backwards : List String -> List String -> List String
  backwards Nil out = out
  backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between its spaces, tabs and line breaks.
words : String -> List String
words s = wordsFrom s 0 0 Nil

unwords : List String -> String
unwords xs = joinWith " " xs

-- (from `i`, the first index whose code is not a space, going by `step`)
skipSpaces : String -> Int -> Int -> Int
skipSpaces s i step =
  if 0 <= i && i < strLength s && isSpaceCode (strByteAt s i)
  then skipSpaces s (i + step) step
  else i

-- | Without the spaces at either end.
trim : String -> String
trim s =
  strSlice s (skipSpaces s 0 1) (skipSpaces s (strLength s - 1) (0 - 1) + 1)

-- (the digits of `s` from `i` on, after `n` so far)
digitsFrom : String -> Int -> Int -> Maybe Int
digitsFrom s i n =
  if i >= strLength s then Just n
  else if 48 <= strByteAt s i && strByteAt s i <= 57
  then digitsFrom s (i + 1) (n * 10 + (strByteAt s i - 48))
  else Nothing

-- | A decimal integer (`42`, `-7`), if `s` is one, whole.
parseInt : String -> Maybe Int
parseInt s =
  if strLength s == 0 then Nothing
  else if startsWith "-" s
  then (if strLength s == 1 then Nothing
        else maybe Nothing (\n -> Just (0 - n)) (digitsFrom s 1 0))
  else digitsFrom s 0 0

-- (from byte `i` on, each into `acc`)
foldBytesFrom : {a : Type} -> (a -> Int -> a) -> String -> Int -> a -> a
foldBytesFrom f s i acc =
  if i >= strLength s then acc
  else foldBytesFrom f s (i + 1) (f acc (strByteAt s i))

-- | The bytes, each 0 to 255, from the first, into `z`; no list of them
-- | made, as `runes` would make one (`rune`'s `foldl` goes through the
-- | runes so).
-- | >>> foldBytes (\n b -> n * 2 + b % 2) 0 "ab\xff"
-- | 5
foldBytes : {a : Type} -> (a -> Int -> a) -> a -> String -> a
foldBytes f z s = foldBytesFrom f s 0 z

-- (the string of one byte, `b` wrapped around to 0 to 255)
byteString : Int -> String
byteString b = strFromByte (uint8FromInt b)

-- (from byte `i` on, each `f` of it, after `acc`)
mapBytesFrom : (Int -> Int) -> String -> Int -> String -> String
mapBytesFrom f s i acc =
  if i >= strLength s then acc
  else mapBytesFrom f s (i + 1) (acc ^ byteString (f (strByteAt s i)))

-- | Each byte `f` of it, given 0 to 255 (and what it gives wrapped
-- | around to that, as `uint8`'s `fromInt` wraps): as long a string, no
-- | list of its bytes made, but the string itself grown, in place, as
-- | `^` grows one.
-- | >>> mapBytes (\b -> if 97 <= b && b <= 122 then b - 32 else b) "heff, \u{e9}!"
-- | "HEFF, \u{e9}!"
-- | >>> mapBytes (\b -> b + 1) "\xff\x00a"
-- | "\x00\x01b"
mapBytes : (Int -> Int) -> String -> String
mapBytes f s = mapBytesFrom f s 0 ""

-- (a code point's UTF-8 bytes, after `acc`: one that is no Unicode
-- scalar value U+FFFD's, as `ofRunes` writes it)
withCodePoint : String -> Int -> String
withCodePoint acc r =
  if 0 <= r && r < 128 then acc ^ byteString r
  else if 128 <= r && r < 2048
  then acc ^ byteString (192 + r / 64) ^ byteString (128 + r % 64)
  else if 2048 <= r && r < 65536 && not (55296 <= r && r < 57344)
  then acc
    ^ byteString (224 + r / 4096)
    ^ byteString (128 + r / 64 % 64)
    ^ byteString (128 + r % 64)
  else if 65536 <= r && r < 1114112
  then acc
    ^ byteString (240 + r / 262144)
    ^ byteString (128 + r / 4096 % 64)
    ^ byteString (128 + r / 64 % 64)
    ^ byteString (128 + r % 64)
  else acc ^ "\u{FFFD}"

-- (from byte `i` on, each rune `f` of it, after `acc`)
mapRunesFrom : (Rune -> Rune) -> String -> Int -> String -> String
mapRunesFrom f s i acc =
  if i >= strLength s then acc
  else mapRunesFrom
      f
      s
      (i + (runeAt s i).width)
      (withCodePoint acc (runeToInt (f (runeAt s i).rune)))

-- | Each rune `f` of it, the runes read as `runes` reads them (what is
-- | not UTF-8, U+FFFD) and written as `ofRunes` writes them:
-- | `ofRunes (List.map f (runes s))`, but no list made, the string grown,
-- | in place, as `^` grows one.
-- | >>> mapRunes (\c -> if c == 'a' then '\u{3bb}' else c) "a\xffb\u{e9}"
-- | "\u{3bb}\u{FFFD}b\u{e9}"
-- | >>> mapRunes (\c -> c) "\xe9\x80" == ofRunes (runes "\xe9\x80")
-- | True
mapRunes : (Rune -> Rune) -> String -> String
mapRunes f s = mapRunesFrom f s 0 ""

-- Values as strings
--------------------------------------------------------------------------------

-- | A type's values as the source writes them -- a string quoted, `show
-- | "hi"` is `"\"hi\""`, a rune `show 'a'` is `"'a'"`, bytes a literal --
-- | so that two values that differ are not written the same: what a test
-- | shows a value as and compares two by (check's `assertEqual`,
-- | `forAll`), as Rust's `Debug` and Python's `repr` are.  The prelude's
-- | instances are of `Int`, `Float64`, `String`, `Rune`, `Bytes`, `Bool`,
-- | `Unit` and `Ordering`, and of a `List`, a `Maybe`, a `Pair` and an
-- | `Either` of types that have one; a fixed-width type's is its
-- | module's.
theory Show (a : Type) where
  show : a -> String

-- | The value written as its type's instance writes it.
show : {a : Type} -> {{shows : Show a}} -> a -> String
show = shows.show

-- | An `Int` as a literal writes it, `Int`'s `show`.
-- | >>> showInt 42 ^ " " ^ showInt (-7)
-- | "42 -7"
showInt : Int -> String
showInt = intShow

-- | A `Float64` as a literal writes it, `Float64`'s `show`: the fewest
-- | digits that read back as it, a point among them, an exponent beyond
-- | 1e21 and below 1e-6, and -0.0 with its sign -- read as a literal, the
-- | very float.  What no literal is, as it is: `NaN`, `Infinity`,
-- | `-Infinity`.
-- | >>> showFloat 2.5
-- | "2.5"
-- | >>> showFloat (neg 0.0) ^ " " ^ showFloat 1.0e23 ^ " " ^ showFloat 5.0e-324
-- | "-0.0 1.0e23 5.0e-324"
-- | >>> showFloat 100.0 ^ " " ^ showFloat 1.0e-7
-- | "100.0 1.0e-7"
showFloat : Float64 -> String
showFloat = floatShow

instance instanceShowInt : Show Int
instanceShowInt = { show = showInt }

-- | >>> show 42 ^ " " ^ show (-7) ^ " " ^ show 2.5
-- | "42 -7 2.5"
instance instanceShowFloat64 : Show Float64
instanceShowFloat64 = { show = showFloat }

-- | Quoted, its `"`, `\` and line feeds escaped.
-- | >>> show "say \"hi\"\n"
-- | "\"say \\\"hi\\\"\\n\""
-- | >>> show "hi"
-- | "\"hi\""
instance instanceShowString : Show String
instanceShowString = { show = \s -> "\"" ^ escapedFrom s 0 "" ^ "\"" }
  where
  escapeAt : String -> Int -> String
  escapeAt s i =
    if byteAt s i == 34 then "\\\""
    else if byteAt s i == 92 then "\\\\"
    else if byteAt s i == 10 then "\\n"
    else strSlice s i (i + 1)

  -- (the bytes from `i` on, after those escaped so far)
  escapedFrom : String -> Int -> String -> String
  escapedFrom s i acc =
    if i >= strLength s then acc
    else escapedFrom s (i + 1) (acc ^ escapeAt s i)

-- | Runes by their code points.
-- | >>> 'a' < 'b' && compare 'z' 'a' == GT
-- | True
instance instanceOrderRune : Order Rune
instanceOrderRune =
  orderByCompare (\x y -> compareInt (runeToInt x) (runeToInt y))

-- | A rune as a literal writes it, quoted: a control character an
-- | escape, one that is no scalar value as U+FFFD (as Go's `%q`).
-- | >>> show 'a' ^ " " ^ show '\'' ^ " " ^ show '\n' ^ " " ^ show '\u{1b}'
-- | "'a' '\\'' '\\n' '\\u{1b}'"
instance instanceShowRune : Show Rune
instanceShowRune = { show = \c -> "'" ^ quoted c ^ "'" }
  where
  hexDigit : Int -> String
  hexDigit d = strSlice "0123456789abcdef" d (d + 1)

  hex : Int -> String
  hex n = if n < 16 then hexDigit n else hex (n / 16) ^ hexDigit (n % 16)

  -- (C0's, DEL and C1's)
  isControl : Int -> Bool
  isControl n = 0 <= n && n <= 31 || 127 <= n && n <= 159

  -- (between the quotes; a rune that is no scalar value U+FFFD, as
  -- `ofRunes` makes it)
  quoted : Rune -> String
  quoted '\'' = "\\'"
  quoted '\\' = "\\\\"
  quoted '\n' = "\\n"
  quoted '\t' = "\\t"
  quoted '\r' = "\\r"
  quoted c =
    if isControl (runeToInt c) then "\\u{" ^ hex (runeToInt c) ^ "}"
    else ofRunes [c]

primitive bytesToList : Bytes -> List UInt8
primitive uint8ToInt : UInt8 -> Int

-- | Bytes as a binary writes them, `b[...]`: each run of printable
-- | ASCII, a byte from 32 up to 126, a string (`"` and `\` escaped), and
-- | any other byte its number.
-- | >>> show b[10, "GET \"\\", 195, 169]
-- | "b[10, \"GET \\\"\\\\\", 195, 169]"
-- | >>> show b[]
-- | "b[]"
instance instanceShowBytes : Show Bytes
instanceShowBytes =
  { show = \b -> "b[" ^ writtenFrom (bytesToList b) "" "" ^ "]" }
  where
  -- (a piece after those written, `acc`)
  piece : String -> String -> String
  piece acc p = if strEq acc "" then p else acc ^ ", " ^ p

  -- (the printable bytes not yet written, `run`, written)
  flush : String -> String -> String
  flush acc run = if strEq run "" then acc else piece acc ("\"" ^ run ^ "\"")

  -- (a printable byte `c`, whose value is `n`, in a string)
  escaped : UInt8 -> Int -> String
  escaped c 34 = "\\\""
  escaped c 92 = "\\\\"
  escaped c n = fromByte c

  -- (the bytes, after those written, `acc`, and those printable not yet,
  -- `run`)
  writtenFrom : List UInt8 -> String -> String -> String
  writtenFrom Nil run acc = flush acc run
  writtenFrom (Cons c cs) run acc =
    if 32 <= uint8ToInt c && uint8ToInt c < 127
    then writtenFrom cs (run ^ escaped c (uint8ToInt c)) acc
    else writtenFrom cs "" (piece (flush acc run) (intShow (uint8ToInt c)))

instance instanceShowBool : Show Bool
instanceShowBool = { show = written }
  where
  written : Bool -> String
  written True = "True"
  written False = "False"

instance instanceShowUnit : Show Unit
instanceShowUnit = { show = \u -> "MkUnit" }

-- | >>> show (True : Bool) ^ " " ^ show (MkUnit : Unit) ^ " " ^ show (GT : Ordering)
-- | "True MkUnit GT"
instance instanceShowOrdering : Show Ordering
instanceShowOrdering = { show = written }
  where
  written : Ordering -> String
  written LT = "LT"
  written EQ = "EQ"
  written GT = "GT"

-- | >>> show ([1, 2] : List Int)
-- | "[1, 2]"
-- | >>> show ([["a"], []] : List (List String))
-- | "[[\"a\"], []]"
instance instanceShowList : {a : Type} -> {{shows : Show a}} -> Show (List a)
instanceShowList = { show = \xs -> "[" ^ joinWith ", " (written xs) ^ "]" }
  where
  written : List a -> List String
  written Nil = Nil
  written (Cons x xs) = Cons (show x) (written xs)

-- | >>> show (Just [1] : Maybe (List Int)) ^ " " ^ show (Nothing : Maybe Int)
-- | "Just ([1]) Nothing"
instance instanceShowMaybe : {a : Type} -> {{shows : Show a}} -> Show (Maybe a)
instanceShowMaybe = { show = written }
  where
  written : Maybe a -> String
  written Nothing = "Nothing"
  written (Just x) = "Just (" ^ show x ^ ")"

-- | >>> show (MkPair 1 "one" : Pair Int String)
-- | "MkPair (1) (\"one\")"
instance instanceShowPair : {a b : Type}
                          -> {{showsA : Show a}}
                          -> {{showsB : Show b}}
                          -> Show (Pair a b)
instanceShowPair = { show = written }
  where
  written : Pair a b -> String
  written (MkPair x y) = "MkPair (" ^ show x ^ ") (" ^ show y ^ ")"

-- | >>> show (Left 1 : Either Int String) ^ " " ^ show (Right "1" : Either Int String)
-- | "Left (1) Right (\"1\")"
instance instanceShowEither : {a b : Type}
                            -> {{showsA : Show a}}
                            -> {{showsB : Show b}}
                            -> Show (Either a b)
instanceShowEither = { show = written }
  where
  written : Either a b -> String
  written (Left x) = "Left (" ^ show x ^ ")"
  written (Right y) = "Right (" ^ show y ^ ")"

-- | A type's values as text, for a reader rather than for the source --
-- | a string itself, a rune its one-rune string, bytes the text they are
-- | -- as Rust's `Display` and Python's `str` are, beside `Show`'s
-- | `Debug` and `repr`.  The prelude's instances are of `String`, `Rune`
-- | and `Bytes`, and of `Int`, `Float64`, `Bool`, `Unit` and `Ordering`,
-- | written as `show` writes them; a fixed-width type's is its module's,
-- | as `show` writes it too.  A `List`, a `Maybe`, a `Pair` and an
-- | `Either` have none: there is no one text of them.
theory ToString (a : Type) where
  toString : a -> String

-- | The value as its type's instance makes it text.
toString : {a : Type} -> {{text : ToString a}} -> a -> String
toString = text.toString

-- | Itself.
-- | >>> toString "hi"
-- | "hi"
instance instanceToStringString : ToString String
instanceToStringString = { toString = \s -> s }

-- | The string of it alone, `ofRunes [c]` (Go's `string(c)`).
-- | >>> toString 'a'
-- | "a"
instance instanceToStringRune : ToString Rune
instanceToStringRune = { toString = \c -> ofRunes [c] }

primitive bytesToString : Bytes -> String

-- | The text of them, UTF-8, what is not UTF-8 U+FFFD, as `rune`'s
-- | `toValid` makes it (and `TextDecoder` reads it).
-- | >>> toString b["h", 0xc3, 0xa9, 0xff, "i"]
-- | "hé\u{FFFD}i"
instance instanceToStringBytes : ToString Bytes
instanceToStringBytes = { toString = bytesToString }

instance instanceToStringInt : ToString Int
instanceToStringInt = { toString = intShow }

-- | >>> toString 42 ^ " " ^ toString (-7) ^ " " ^ toString 2.5
-- | "42 -7 2.5"
instance instanceToStringFloat64 : ToString Float64
instanceToStringFloat64 = { toString = floatShow }

instance instanceToStringBool : ToString Bool
instanceToStringBool = { toString = show }

instance instanceToStringUnit : ToString Unit
instanceToStringUnit = { toString = show }

-- | >>> toString (True : Bool) ^ " " ^ toString (MkUnit : Unit) ^ " " ^ toString (GT : Ordering)
-- | "True MkUnit GT"
instance instanceToStringOrdering : ToString Ordering
instanceToStringOrdering = { toString = show }

-- The host
--------------------------------------------------------------------------------

-- | Whether the program runs on Windows: as the system it is built for
-- | says -- a C program, the target zig builds it for; in JavaScript,
-- | Node.js's `process.platform` (`False` in a page).  The same all
-- | through a run, so a function of no effect; std.path reads a path in
-- | the style it says.
primitive onWindows : Unit -> Bool

-- Coercions
--------------------------------------------------------------------------------

-- | A value of one type taken as one of another, without saying so:
-- | where an expression of type `from` is given and a `to` is expected,
-- | and the two do not unify, heff puts in `coe`, by the one instance
-- | of `Coe from to` in scope (as any instance argument is found).  Both
-- | types must be known whole there; one coercion is put in, never two
-- | in a row.  The prelude has one, `instanceCoeLazy`: a module that has
-- | a type made from another declares its own, as std.path does
-- | `Coe String Path`.
theory Coe (from : Type) (to : Type) where
  coe : from -> to

-- | The value taken as a `to`, as its instance takes it: what heff puts
-- | in where a coercion is wanted.
coe : {from to : Type} -> {{coerces : Coe from to}} -> from -> to
coe = coerces.coe

-- | A `Lazy a`, `~a`, where an `a` is expected: forced.
instance instanceCoeLazy : {a : Type} -> Coe (Lazy a) a
instanceCoeLazy = { coe = force }

-- Binaries
--------------------------------------------------------------------------------

-- What a binary, `b[...]`, is made and taken apart by, beside the
-- bytes' above: `Bits`' primitives -- their length, an integer of `n`
-- bits at bit `o` (the flags `f` 1 for little-endian, 2 for signed), one
-- written as bits, many put together, the `n` from bit `o`, bytes as
-- bits and bits that are whole bytes as bytes (others, abandoned) -- a
-- float's IEEE bits (of 64 or 32) and the float of them, and a segment's
-- `utf8`, `utf16` and `utf32`, read and written.

primitive bitsEq : Bits -> Bits -> Bool
primitive bitsLength : Bits -> Int
primitive bitsIntAt : Bits -> Int -> Int -> Int -> Int
primitive bitsOfInt : Int -> Int -> Int -> Bits
primitive bitsConcat : List Bits -> Bits
primitive bitsSlice : Bits -> Int -> Int -> Bits
primitive bitsOfBytes : Bytes -> Bits
primitive bitsBytes : Bits -> Bytes
primitive floatBits : Int -> Float64 -> Int
primitive floatOfBits : Int -> Int -> Float64
primitive runeFromInt : Int -> Rune

-- | The first `n` bits of `b`, as a segment `x::bits-size(n)` writes
-- | them: of fewer, abandoned.
bitsSized : Int -> Bits -> Bits
bitsSized n b = if 0 <= n && n <= bitsLength b then bitsSlice b 0 n else abandon

-- | Whether the bytes `s` are those of `b` at bit `o`.
-- | >>> bitsHasBytesAt (bitsConcat [bitsOfInt 4 0 1, bitsOfBytes b["hi"]]) 4 b["hi"]
-- | True
bitsHasBytesAt : Bits -> Int -> Bytes -> Bool
bitsHasBytesAt b o s =
  if 0 <= o && o + 8 * bytesLength s <= bitsLength b
  then bitsEq (bitsSlice b o (8 * bytesLength s)) (bitsOfBytes s)
  else False

-- | What a segment of `utf8`, `utf16` or `utf32` writes: a code point,
-- | an `Int`'s or a `Rune`'s.
theory CodePoint (a : Type) where
  codePoint : a -> Int

instance instanceCodePointInt : CodePoint Int
instanceCodePointInt = { codePoint = \n -> n }

instance instanceCodePointRune : CodePoint Rune
instanceCodePointRune = { codePoint = runeToInt }

-- | The code point of a value of `CodePoint`.
codePointOf : {a : Type} -> {{point : CodePoint a}} -> a -> Int
codePointOf = point.codePoint

-- | Whether `c` is a Unicode scalar value: from 0 up to U+10FFFF, but
-- | the surrogates.
isScalarValue : Int -> Bool
isScalarValue c = 0 <= c && c <= 1114111 && not (55296 <= c && c <= 57343)

-- | The code point `c` as UTF-8, as a segment `c::utf8` writes it: what
-- | is no scalar value, abandoned.
-- | >>> bytesToList (bytesConcat [utf8Bytes 65, utf8Bytes 233, utf8Bytes 8364, utf8Bytes 128512])
-- | [65, 195, 169, 226, 130, 172, 240, 159, 152, 128]
utf8Bytes : Int -> Bytes
utf8Bytes c =
  if not (isScalarValue c) then abandon
  else if c < 128 then bytesOfInt 8 0 c
  else if c < 2048 then bytesOfInt 16 0 ((192 + c / 64) * 256 + 128 + c % 64)
  else if c < 65536
  then bytesOfInt
      24
      0
      (((224 + c / 4096) * 256 + 128 + c / 64 % 64) * 256 + 128 + c % 64)
  else bytesOfInt
      32
      0
      ((((240 + c / 262144) * 256 + 128 + c / 4096 % 64) * 256
        + 128
        + c / 64 % 64)
       * 256
       + 128
       + c % 64)

-- | The code point `c` as UTF-16, as a segment `c::utf16` writes it,
-- | its units as the flags `f` say (1 little-endian): what is no scalar
-- | value, abandoned.
utf16Bytes : Int -> Int -> Bytes
utf16Bytes f c =
  if not (isScalarValue c) then abandon
  else if c < 65536 then bytesOfInt 16 f c
  else bytesConcat
      [ bytesOfInt 16 f (55296 + (c - 65536) / 1024)
      , bytesOfInt 16 f (56320 + (c - 65536) % 1024)
      ]

-- | The code point `c` as UTF-32: what is no scalar value, abandoned.
utf32Bytes : Int -> Int -> Bytes
utf32Bytes f c = if isScalarValue c then bytesOfInt 32 f c else abandon

-- (how many bytes UTF-8 whose first byte is `c` has: of no first byte,
-- 0)
utf8Count : Int -> Int
utf8Count c =
  if c < 0 then 0
  else if c < 128 then 1
  else if c < 194 then 0
  else if c < 224 then 2
  else if c < 240 then 3
  else if c < 245 then 4
  else 0

-- (what the first byte of `w` has above its code point's bits)
utf8Lead : Int -> Int
utf8Lead 2 = 192
utf8Lead 3 = 224
utf8Lead 4 = 240
utf8Lead _ = 0

-- (the least code point of `w` bytes: one of fewer is overlong)
utf8Least : Int -> Int
utf8Least 2 = 128
utf8Least 3 = 2048
utf8Least 4 = 65536
utf8Least _ = 0

-- (the code point of the bytes `byte` reads, the `i`th on, `w` of them,
-- after `acc`: of a byte that is no continuation, -1)
utf8Rest : (Int -> Int) -> Int -> Int -> Int -> Int
utf8Rest byte w i acc =
  if i >= w then acc
  else if 128 <= byte i && byte i < 192
  then utf8Rest byte w (i + 1) (acc * 64 + byte i - 128)
  else 0 - 1

-- (the code point of the UTF-8 whose bytes `byte` reads (the `i`th, -1
-- past them), of `w` bytes)
utf8CodeBy : (Int -> Int) -> Int -> Int
utf8CodeBy byte w = utf8Rest byte w 1 (byte 0 - utf8Lead w)

-- (its width in bits: of what is no code point, or one written longer
-- than it is, 0)
utf8WidthOf : Int -> Int -> Int
utf8WidthOf w c =
  if w > 0 && isScalarValue c && utf8Least w <= c then 8 * w else 0

utf8WidthBy : (Int -> Int) -> Int
utf8WidthBy byte =
  utf8WidthOf (utf8Count (byte 0)) (utf8CodeBy byte (utf8Count (byte 0)))

-- (the `i`th byte at bit `o`: of none, -1)
bytesByteAt : Bytes -> Int -> Int -> Int
bytesByteAt b o i =
  if o + 8 * i + 8 <= 8 * bytesLength b then bytesIntAt b (o + 8 * i) 8 0
  else 0 - 1

bitsByteAt : Bits -> Int -> Int -> Int
bitsByteAt b o i =
  if o + 8 * i + 8 <= bitsLength b then bitsIntAt b (o + 8 * i) 8 0
  else 0 - 1

-- | How many bits the UTF-8 code point at bit `o` of `b` is, as a
-- | segment `c::utf8` reads it: where there is none (a byte that is no
-- | continuation, too few, a surrogate, one written longer than it is),
-- | 0.
-- | >>> ([bytesUtf8Width b["a", 0xc3, 0xa9] 0, bytesUtf8Width b["a", 0xc3, 0xa9] 8, bytesUtf8Width b[0xc3, 0x28] 0, bytesUtf8Width b[0xed, 0xa0, 0x80] 0, bytesUtf8Width b[0xc0, 0x80] 0, bytesUtf8Width b[0xc3] 0] : List Int)
-- | [8, 16, 0, 0, 0, 0]
bytesUtf8Width : Bytes -> Int -> Int
bytesUtf8Width b o = utf8WidthBy (bytesByteAt b o)

bitsUtf8Width : Bits -> Int -> Int
bitsUtf8Width b o = utf8WidthBy (bitsByteAt b o)

-- | The UTF-8 code point at bit `o` of `b`, there.
bytesUtf8At : Bytes -> Int -> Rune
bytesUtf8At b o =
  runeFromInt (utf8CodeBy (bytesByteAt b o) (utf8Count (bytesByteAt b o 0)))

bitsUtf8At : Bits -> Int -> Rune
bitsUtf8At b o =
  runeFromInt (utf8CodeBy (bitsByteAt b o) (utf8Count (bitsByteAt b o 0)))

-- (the UTF-16 whose units `unit` reads (the `i`th, -1 past them): how
-- many bits, of none 0, and its code point)
utf16WidthBy : (Int -> Int) -> Int
utf16WidthBy unit =
  if unit 0 < 0 then 0
  else if 55296 <= unit 0 && unit 0 < 56320
  then (if 56320 <= unit 1 && unit 1 < 57344 then 32 else 0)
  else if 56320 <= unit 0 && unit 0 < 57344 then 0
  else 16

utf16CodeBy : (Int -> Int) -> Int
utf16CodeBy unit =
  if 55296 <= unit 0 && unit 0 < 56320
  then 65536 + (unit 0 - 55296) * 1024 + unit 1 - 56320
  else unit 0

-- (the `i`th unit of 16 bits at bit `o`, as the flags `f` say: of none,
-- -1)
bytesUnitAt : Bytes -> Int -> Int -> Int -> Int
bytesUnitAt b o f i =
  if o + 16 * i + 16 <= 8 * bytesLength b
  then bytesIntAt b (o + 16 * i) 16 f
  else 0 - 1

bitsUnitAt : Bits -> Int -> Int -> Int -> Int
bitsUnitAt b o f i =
  if o + 16 * i + 16 <= bitsLength b then bitsIntAt b (o + 16 * i) 16 f
  else 0 - 1

-- | How many bits the UTF-16 code point at bit `o` of `b` is, its units
-- | as the flags `f` say: where there is none, 0.
bytesUtf16Width : Bytes -> Int -> Int -> Int
bytesUtf16Width b o f = utf16WidthBy (bytesUnitAt b o f)

bitsUtf16Width : Bits -> Int -> Int -> Int
bitsUtf16Width b o f = utf16WidthBy (bitsUnitAt b o f)

-- | The UTF-16 code point at bit `o` of `b`, there.
bytesUtf16At : Bytes -> Int -> Int -> Rune
bytesUtf16At b o f = runeFromInt (utf16CodeBy (bytesUnitAt b o f))

bitsUtf16At : Bits -> Int -> Int -> Rune
bitsUtf16At b o f = runeFromInt (utf16CodeBy (bitsUnitAt b o f))

-- | `Bits`' (their other operations are `bits`'s): the same bits.
-- | >>> bitsOfInt 3 0 5 == bitsConcat [bitsOfInt 1 0 1, bitsOfInt 2 0 1]
-- | True
-- | >>> bitsOfBytes b[1, 2] == bitsOfInt 16 0 258
-- | True
instance instanceEqualityBits : Equality Bits
instanceEqualityBits = { equal = bitsEq }

-- | Bits as a binary writes them: their whole bytes as bytes are
-- | (`instanceShowBytes`), then the bits left, `v::k` -- or, none left,
-- | `b[]::bits`, so that what is written is `Bits` again.
-- | >>> show (bitsConcat [bitsOfBytes b["GET"], bitsOfInt 3 0 5])
-- | "b[\"GET\", 5::3]"
-- | >>> show (bitsOfBytes b[1, 2]) ^ " " ^ show (bitsOfBytes b[]) ^ " " ^ show (bitsOfInt 1 0 1)
-- | "b[1, 2, b[]::bits] b[b[]::bits] b[1::1]"
instance instanceShowBits : Show Bits
instanceShowBits = { show = written }
  where
  -- (the bits left, after the whole bytes, `k` of them)
  tail : Bits -> Int -> String
  tail b 0 = "b[]::bits"
  tail b k = intShow (bitsIntAt b (bitsLength b - k) k 0) ^ "::" ^ intShow k

  -- (a binary written, its `]` left off)
  unclosed : String -> String
  unclosed s = strSlice s 0 (strLength s - 1)

  written : Bits -> String
  written b =
    unclosed
      (instanceShowBytes.show
         (bitsBytes (bitsSlice b 0 (bitsLength b / 8 * 8))))
    ^ (if bitsLength b < 8 then "" else ", ")
    ^ tail b (bitsLength b % 8)
    ^ "]"

-- | Their bits, each `0` or `1`.
-- | >>> toString (bitsOfInt 5 0 21)
-- | "10101"
instance instanceToStringBits : ToString Bits
instanceToStringBits = { toString = \b -> digits b 0 "" }
  where
  digits : Bits -> Int -> String -> String
  digits b i acc =
    if i >= bitsLength b then acc
    else digits b (i + 1) (acc ^ intShow (bitsIntAt b i 1 0))

-- Nat
--------------------------------------------------------------------------------

-- | Recursion on `Nat`, non-dependent.
-- | >>> natrec (c := Nat) Zero (\_ n -> Succ (Succ n)) (Succ (Succ Zero))
-- | Succ (Succ (Succ (Succ Zero)))
natrec : {c : Type} -> c -> (Nat -> c -> c) -> Nat -> c
natrec z s Zero = z
natrec z s (Succ n) = s n (natrec z s n)
