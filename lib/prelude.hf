-- The basic types and what is done with them: Nat, Empty, pairs, Maybe,
-- Either, Bytes (lib/bytes.hf has its operations); Bool, Unit and lists
-- (lib/builtin.hf has them), lists' `::` and `++` (their other
-- operations are `List`'s, lib/list.hf); numbers and strings, by the
-- primitives, with their operators.

-- | The natural numbers.
data Nat = Zero | Succ Nat

data Empty

data Pair a b = MkPair a b

data Maybe a = Nothing | Just a

data Either a b = Left a | Right b

-- | Bytes, not changed once made: a type of its own beside `String`,
-- | written `b[...]`, whose operations are `bytes`'s (`import bytes as
-- | Bytes`), but its equality, `instanceEqualityBytes`, its `Show`,
-- | `instanceShowBytes`, and its `ToString`, `instanceToStringBytes`
data Bytes

-- | `x :: xs` is `Cons x xs`; a pattern too, as it only names the tag
(::) : {a : Type} -> a -> List a -> List a
(::) x xs = Cons x xs

-- Functions
--------------------------------------------------------------------------------

id : {a : Type} -> a -> a
id x = x

const : {a b : Type} -> a -> b -> a
const x _ = x

flip : {a b c : Type} -> (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose : {a b c : Type} -> (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

-- The operators: `||` loosest, then `&&`, the comparisons, then `+ -`,
-- `^` and `++` (unrelated: `a + b ^ c` is refused), then `* / %` and a
-- float's division, `/.`; and `$` below all, any module's too (`below`
-- alone).
--------------------------------------------------------------------------------

infixr ||
infixr && above ||
infix == /= < <= > >= above &&
infixl + - above == /= < <= > >=
infixl * / % /. above + -
infixr ++ above == /= < <= > >=
infixr ^ above == /= < <= > >=
infixr :: above == /= < <= > >= below + - * / % ++ ^
infixr $ below

-- | Application, loosest: `f $ g $ x` is `f (g x)`.
($) : {a b : Type} -> (a -> b) -> a -> b
($) f x = f x

-- Bool
--------------------------------------------------------------------------------

not : Bool -> Bool
not True = False
not False = True

(&&) : Bool -> Bool -> Bool
(&&) True b = b
(&&) False _ = False

(||) : Bool -> Bool -> Bool
(||) True _ = True
(||) False b = b

-- | How one value is to another: less, equal, or greater.
data Ordering = LT | EQ | GT

-- The operators' theories
--------------------------------------------------------------------------------

-- An operator is an operation of a theory, of the instance found for the
-- type it is used at: `x + y` is the `add` of an `Addition` of their type
-- -- an `Int`'s, the prelude's; a fixed-width type's, its module's; a
-- generic function's, the instance argument it asks for, `{{add :
-- Addition a}}`.  Each operation is a theory of its own, as Lean's are,
-- so a type has those it has: an integer `/` and `%`, a float neither
-- (but `/.`, a `FloatDivision`'s).  Where the instance is known the
-- operation is what is compiled: `n + 1` at `Int` is `intAdd n 1`, as if
-- written so.  A theory is named by a whole noun, `Addition`, not `Add`:
-- the short names are left to a program's own types and tags (`data Op =
-- Add | Sub | Mul | Div`).

-- | A type's equality: a function that compares values of a type it does
-- | not know asks for it, `{{eq : Equality a}}`, and is given the instance in
-- | scope of the type it is used at -- the prelude's of `Int`, `Float64`,
-- | `String`, `Rune`, `Bool`, `Unit` and `Ordering`, and of a `List`, a
-- | `Maybe`, a `Pair` and an `Either` of types that have one, found by
-- | finding theirs; a fixed-width type's module's of its own.
theory Equality (a : Type) where
  equal : a -> a -> Bool

(==) : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
(==) = eq.equal

(/=) : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
(/=) x y = not (eq.equal x y)

-- | A type's order: how two values are (`compare`), and whether one is
-- | less than the other, or not greater (`lt`, `le`: what `<` and `<=`
-- | are, as fast as the type has them) -- the prelude's of `Int` and
-- | `Float64`, a fixed-width type's module's of its own.
theory Order (a : Type) where
  compare : a -> a -> Ordering
  lt : a -> a -> Bool
  le : a -> a -> Bool

compare : {a : Type} -> {{ord : Order a}} -> a -> a -> Ordering
compare = ord.compare

(<) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(<) = ord.lt

(<=) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(<=) = ord.le

(>) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(>) x y = ord.lt y x

(>=) : {a : Type} -> {{ord : Order a}} -> a -> a -> Bool
(>=) x y = ord.le y x

-- | The lesser of the two (the first, of two as great).
min : {a : Type} -> {{ord : Order a}} -> a -> a -> a
min x y = if ord.le x y then x else y

-- | The greater of the two (the second, of two as great).
max : {a : Type} -> {{ord : Order a}} -> a -> a -> a
max x y = if ord.le x y then y else x

theory Addition (a : Type) where
  add : a -> a -> a

(+) : {a : Type} -> {{add : Addition a}} -> a -> a -> a
(+) = add.add

theory Subtraction (a : Type) where
  sub : a -> a -> a

(-) : {a : Type} -> {{sub : Subtraction a}} -> a -> a -> a
(-) = sub.sub

theory Multiplication (a : Type) where
  mul : a -> a -> a

(*) : {a : Type} -> {{mul : Multiplication a}} -> a -> a -> a
(*) = mul.mul

-- | A type's division, total: by zero, zero, as Lean's and Coq's are --
-- | no division abandons, and `x / 0` is 0 (`exn`'s `exnDiv` throws
-- | instead).  Not a float's: `/.` is a float's, IEEE's.
theory Division (a : Type) where
  div : a -> a -> a

(/) : {a : Type} -> {{div : Division a}} -> a -> a -> a
(/) = div.div

-- | The remainder of a type's division, total: by zero, the dividend, so
-- | that `(x / y) * y + x % y` is `x` whatever `y` is.
theory Remainder (a : Type) where
  mod : a -> a -> a

(%) : {a : Type} -> {{mod : Remainder a}} -> a -> a -> a
(%) = mod.mod

-- | A type's negation: what `-x` is, the `neg` in scope applied to `x`.
theory Negation (a : Type) where
  neg : a -> a

neg : {a : Type} -> {{n : Negation a}} -> a -> a
neg = n.neg

-- | A float type's division, IEEE's: by 0, an infinity (or not a number,
-- | of 0 by 0) -- what `/.` is, the prelude's of `Float64`, `float32`'s of
-- | `Float32`.  An integer type has none: its division is `/`, total.
theory FloatDivision (a : Type) where
  divide : a -> a -> a

(/.) : {a : Type} -> {{divide : FloatDivision a}} -> a -> a -> a
(/.) = divide.divide

-- | Whether a value is its type's zero: what `exn`'s `exnDiv` and
-- | `exnMod` ask of the divisor -- the prelude's of `Int`, a fixed-width
-- | integer type's module's of its own.
theory IsZero (a : Type) where
  isZero : a -> Bool

-- | An integer type's bits, as two's complement has them: the and, or and
-- | xor of two, every bit flipped, and shifts -- an `Int`'s in `int`'s
-- | module (lib/int.hf), a fixed-width type's in its own.
theory Bitwise (a : Type) where
  and : a -> a -> a
  or : a -> a -> a
  xor : a -> a -> a
  complement : a -> a
  shiftL : a -> a -> a
  shiftR : a -> a -> a

-- | The bits set in both.
and : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
and = bits.and

-- | The bits set in either.
or : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
or = bits.or

-- | The bits set in one of the two.
xor : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
xor = bits.xor

-- | Every bit flipped.
complement : {a : Type} -> {{bits : Bitwise a}} -> a -> a
complement = bits.complement

-- | Shifted left by the second, as the type shifts.
shiftL : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
shiftL = bits.shiftL

-- | Shifted right by the second, as the type shifts.
shiftR : {a : Type} -> {{bits : Bitwise a}} -> a -> a -> a
shiftR = bits.shiftR

-- Numbers (integers, unbounded)
--------------------------------------------------------------------------------

primitive intAdd : Int -> Int -> Int
primitive intSub : Int -> Int -> Int
primitive intMul : Int -> Int -> Int
primitive intDiv : Int -> Int -> Int
primitive intMod : Int -> Int -> Int
primitive intEq : Int -> Int -> Bool
primitive intLt : Int -> Int -> Bool
primitive intLe : Int -> Int -> Bool
primitive intShow : Int -> String

instance instanceEqualityInt : Equality Int
instanceEqualityInt = { equal = intEq }

compareInt : Int -> Int -> Ordering
compareInt a b = if intLt a b then LT else if intEq a b then EQ else GT

-- | >>> 1 < 2 && 2 <= 2 || False
-- | True
-- | >>> ([max 2 (-3), min 2 (-3)] : List Int)
-- | Cons 2 (Cons (-3) Nil)
instance instanceOrderInt : Order Int
instanceOrderInt = { compare = compareInt, lt = intLt, le = intLe }

instance instanceAdditionInt : Addition Int
instanceAdditionInt = { add = intAdd }

instance instanceSubtractionInt : Subtraction Int
instanceSubtractionInt = { sub = intSub }

instance instanceMultiplicationInt : Multiplication Int
instanceMultiplicationInt = { mul = intMul }

-- | Division rounding down; by 0, 0.
instance instanceDivisionInt : Division Int
instanceDivisionInt = { div = intDiv }

-- | The remainder of `/`, of the sign of the divisor; by 0, the dividend.
-- | >>> 1 + 2 * 3 - 4 / 2
-- | 5
-- | >>> ([7 / 2, -7 / 2, 7 % 2, -7 % 2, 7 % -2] : List Int)
-- | Cons 3 (Cons (-4) (Cons 1 (Cons 1 (Cons (-1) Nil))))
-- | >>> ([7 / 0, 7 % 0, (7 / 0) * 0 + 7 % 0] : List Int)
-- | Cons 0 (Cons 7 (Cons 7 Nil))
instance instanceRemainderInt : Remainder Int
instanceRemainderInt = { mod = intMod }

-- | The integer of the other sign, `0 - x`: what `-x` is.
-- | >>> ([neg 5, -(3 - 10)] : List Int)
-- | Cons (-5) (Cons 7 Nil)
instance instanceNegationInt : Negation Int
instanceNegationInt = { neg = \x -> intSub 0 x }

-- | >>> ([instanceIsZeroInt.isZero 0, instanceIsZeroInt.isZero (-3)] : List Bool)
-- | Cons True (Cons False Nil)
instance instanceIsZeroInt : IsZero Int
instanceIsZeroInt = { isZero = \x -> intEq x 0 }

-- Floats (JavaScript's numbers: 64-bit floating point)
--------------------------------------------------------------------------------

primitive floatAdd : Float64 -> Float64 -> Float64
primitive floatSub : Float64 -> Float64 -> Float64
primitive floatMul : Float64 -> Float64 -> Float64
primitive floatDiv : Float64 -> Float64 -> Float64
primitive floatEq : Float64 -> Float64 -> Bool
primitive floatLt : Float64 -> Float64 -> Bool
primitive floatLe : Float64 -> Float64 -> Bool
primitive floatShow : Float64 -> String
primitive floatFromInt : Int -> Float64
primitive floatSqrt : Float64 -> Float64
primitive floatFloor : Float64 -> Int

-- (IEEE's: NaN is no float's equal, its own neither)
instance instanceEqualityFloat64 : Equality Float64
instanceEqualityFloat64 = { equal = floatEq }

compareFloat : Float64 -> Float64 -> Ordering
compareFloat a b = if floatLt a b then LT else if floatEq a b then EQ else GT

instance instanceOrderFloat64 : Order Float64
instanceOrderFloat64 = { compare = compareFloat, lt = floatLt, le = floatLe }

instance instanceAdditionFloat64 : Addition Float64
instanceAdditionFloat64 = { add = floatAdd }

instance instanceSubtractionFloat64 : Subtraction Float64
instanceSubtractionFloat64 = { sub = floatSub }

instance instanceMultiplicationFloat64 : Multiplication Float64
instanceMultiplicationFloat64 = { mul = floatMul }

-- | The float of the other sign, 0.0's too: what `-x` is.
instance instanceNegationFloat64 : Negation Float64
instanceNegationFloat64 = { neg = \x -> floatMul (-1.0) x }

-- | Division; by 0, an infinity (or not a number, of 0 by 0): a float has
-- | no `/`, whose division by 0 is 0.
-- | >>> ([neg 2.5, -(1.0 - 3.5), 1.0 /. neg 0.0, 2.5 * 2.0 + 1.0] : List Float64)
-- | [-2.5, 2.5, -Infinity, 6.0]
instance instanceFloatDivisionFloat64 : FloatDivision Float64
instanceFloatDivisionFloat64 = { divide = floatDiv }

toFloat : Int -> Float64
toFloat = floatFromInt

-- | The greatest integer not above; of an infinity, or what is not a
-- | number, 0.
-- | >>> ([floor 2.5, floor (-2.5), floor (1.0 /. 0.0), floor (-1.0 /. 0.0), floor (0.0 /. 0.0)] : List Int)
-- | Cons 2 (Cons (-3) (Cons 0 (Cons 0 (Cons 0 Nil))))
floor : Float64 -> Int
floor = floatFloor

sqrt : Float64 -> Float64
sqrt = floatSqrt

-- Strings: bytes, UTF-8 as a literal has them (`"é"` is two), though
-- any bytes may be in one, as Go's: its length, an index, a slice are of
-- bytes, its order the bytes' (of UTF-8 its runes' order), and `runes`
-- reads its runes.
--------------------------------------------------------------------------------

primitive strAppend : String -> String -> String
primitive strLength : String -> Int
primitive strSlice : String -> Int -> Int -> String
primitive strEq : String -> String -> Bool
primitive strLt : String -> String -> Bool

-- | `a ^ b`: the string `a`, then `b`.
-- | >>> "count: " ^ intShow (7 % 3)
-- | "count: 1"
-- | >>> "he" ^ "ff" ^ "!"
-- | "heff!"
(^) : String -> String -> String
(^) = strAppend

-- Equality
--------------------------------------------------------------------------------

instance instanceEqualityString : Equality String
instanceEqualityString = { equal = strEq }

primitive bytesEq : Bytes -> Bytes -> Bool

-- (what a binary, `b[...]`, is made and taken apart by -- `bytes` has
-- them by other names: their length, a slice, many put together; an
-- integer of `n` bits at bit `o`, the flags `f` 1 for little-endian, 2
-- for signed; one written as bytes; whether some are at `o`)
primitive bytesLength : Bytes -> Int
primitive bytesSlice : Bytes -> Int -> Int -> Bytes
primitive bytesConcat : List Bytes -> Bytes
primitive bytesIntAt : Bytes -> Int -> Int -> Int -> Int
primitive bytesOfInt : Int -> Int -> Int -> Bytes
primitive bytesHasAt : Bytes -> Int -> Bytes -> Bool

-- | The first `n` bytes of `b`, as a segment `x::binary-size(n)` of a
-- | binary writes them: of fewer, abandoned.
bytesSized : Int -> Bytes -> Bytes
bytesSized n b =
  if 0 <= n && n <= bytesLength b then bytesSlice b 0 n else abandon

-- | `Bytes`' (their other operations are `bytes`'s): the same bytes.
-- | >>> b["hi", 255] == b[104, "i", 0xFF]
-- | True
instance instanceEqualityBytes : Equality Bytes
instanceEqualityBytes = { equal = bytesEq }

instance instanceEqualityRune : Equality Rune
instanceEqualityRune = { equal = runeEq }

instance instanceEqualityBool : Equality Bool
instanceEqualityBool = { equal = \a b -> if a then b else not b }

instance instanceEqualityUnit : Equality Unit
instanceEqualityUnit = { equal = \a b -> True }

instance instanceEqualityOrdering : Equality Ordering
instanceEqualityOrdering = { equal = sameOrder }
  where
  sameOrder : Ordering -> Ordering -> Bool
  sameOrder LT LT = True
  sameOrder EQ EQ = True
  sameOrder GT GT = True
  sameOrder _ _ = False

-- | Whether the two are equal, as the instance of their type says.
-- | >>> equal 3 3
-- | True
-- | >>> equal "heff" "help"
-- | False
-- | >>> equal 0.5 0.5 && not (equal 'a' 'b') && equal (1 < 2) True
-- | True
-- | >>> equal (compareInt 1 2) LT
-- | True
equal : {a : Type} -> {{eq : Equality a}} -> a -> a -> Bool
equal x y = eq.equal x y

-- | Lists are equal where they are as long, and equal element by element.
-- | >>> equal ([1, 2] : List Int) [1, 2]
-- | True
-- | >>> equal ([[1, 2], [3]] : List (List Int)) [[1, 2], []]
-- | False
instance instanceEqualityList : {a : Type}
                              -> {{eq : Equality a}}
                              -> Equality (List a)
instanceEqualityList = { equal = sameElements }
  where
  sameElements : List a -> List a -> Bool
  sameElements Nil Nil = True
  sameElements (Cons x xs) (Cons y ys) = equal x y && sameElements xs ys
  sameElements _ _ = False

-- | >>> equal (Just 'h' : Maybe Rune) (Just 'h')
-- | True
-- | >>> equal (Just [1] : Maybe (List Int)) Nothing
-- | False
instance instanceEqualityMaybe : {a : Type}
                               -> {{eq : Equality a}}
                               -> Equality (Maybe a)
instanceEqualityMaybe = { equal = bothOrNeither }
  where
  bothOrNeither : Maybe a -> Maybe a -> Bool
  bothOrNeither Nothing Nothing = True
  bothOrNeither (Just x) (Just y) = equal x y
  bothOrNeither _ _ = False

-- | >>> equal (MkPair 1 "one" : Pair Int String) (MkPair 1 "one")
-- | True
instance instanceEqualityPair : {a b : Type}
                              -> {{eqA : Equality a}}
                              -> {{eqB : Equality b}}
                              -> Equality (Pair a b)
instanceEqualityPair = { equal = sameSides }
  where
  sameSides : Pair a b -> Pair a b -> Bool
  sameSides (MkPair x1 y1) (MkPair x2 y2) = equal x1 x2 && equal y1 y2

-- | >>> equal (Left 1 : Either Int String) (Right "1")
-- | False
instance instanceEqualityEither : {a b : Type}
                                -> {{eqA : Equality a}}
                                -> {{eqB : Equality b}}
                                -> Equality (Either a b)
instanceEqualityEither = { equal = sameSide }
  where
  sameSide : Either a b -> Either a b -> Bool
  sameSide (Left x) (Left y) = equal x y
  sameSide (Right x) (Right y) = equal x y
  sameSide _ _ = False

-- Pairs, Maybe, Either
--------------------------------------------------------------------------------

fst : {a b : Type} -> Pair a b -> a
fst (MkPair x y) = x

snd : {a b : Type} -> Pair a b -> b
snd (MkPair x y) = y

maybe : {a b : Type} -> b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

-- | >>> fromMaybe 0 (Just 4)
-- | 4
fromMaybe : {a : Type} -> a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

either : {a b c : Type} -> (a -> c) -> (b -> c) -> Either a b -> c
either f g (Left x) = f x
either f g (Right y) = g y

-- Lists (their operations are `List`'s, lib/list.hf)
--------------------------------------------------------------------------------

-- | `xs ++ ys`: the elements of `xs`, then those of `ys`.
-- | >>> [1, 2] ++ [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
(++) : {a : Type} -> List a -> List a -> List a
(++) Nil ys = ys
(++) (Cons x xs) ys = Cons x (xs ++ ys)

-- Text
--------------------------------------------------------------------------------

primitive strByteAt : String -> Int -> Int
primitive strFromByte : UInt8 -> String

-- | The byte at `i`, 0 to 255; out of range, `-1`.
-- | >>> byteAt "a\u{e9}" 1
-- | 195
-- | >>> byteAt "a\u{e9}" 3
-- | -1
byteAt : String -> Int -> Int
byteAt = strByteAt

-- | The string of one byte: a byte of no rune too, which no literal but
-- | a `\xNN` escape has.  An `Int` is made a byte by `uint8`'s `fromInt`,
-- | wrapping around (`fromByte (U8.fromInt n)`).
-- | >>> fromByte 104 ^ fromByte 105
-- | "hi"
-- | >>> fromByte 255 == "\xff" && byteAt (fromByte 0) 0 == 0
-- | True
fromByte : UInt8 -> String
fromByte = strFromByte

primitive strRunes : String -> List Rune
primitive strOfRunes : List Rune -> String
primitive strRuneAt : String -> Int -> Rune
primitive strRuneWidth : String -> Int -> Int

-- | The runes of `s`, its code points, UTF-8 read: `runes "a😀"` is
-- | `['a', '😀']`; what is not UTF-8 is U+FFFD, one for each longest
-- | start of a rune's bytes (or a byte that starts none), as
-- | `TextDecoder` reads it.  Their operations are lib/rune.hf's.
runes : String -> List Rune
runes = strRunes

-- | The string of runes, UTF-8 (one that is no Unicode scalar value,
-- | U+FFFD): `ofRunes (runes s)` is `s`, where `s` is UTF-8.
ofRunes : List Rune -> String
ofRunes = strOfRunes

-- | A rune of a string, and how many bytes of it it takes.
type RuneAt = { rune : Rune, width : Int }

-- | The rune whose bytes start at `i`, and how many they are (Go's
-- | `utf8.DecodeRuneInString`): where they are not UTF-8, U+FFFD, as
-- | `runes` reads it; out of range, U+FFFD of none.
-- | >>> (runeAt "a\u{e9}b" 1).width
-- | 2
-- | >>> (runeAt "a\u{e9}b" 2).width
-- | 1
runeAt : String -> Int -> RuneAt
runeAt s i = { rune = strRuneAt s i, width = strRuneWidth s i }

compareString : String -> String -> Ordering
compareString a b = if strLt a b then LT else if strEq a b then EQ else GT

-- | Where `needle` is first in `s`, from `i` on, if it is.
indexFrom : String -> String -> Int -> Maybe Int
indexFrom needle s i =
  if i + strLength needle > strLength s then Nothing
  else if strEq (strSlice s i (i + strLength needle)) needle then Just i
  else indexFrom needle s (i + 1)

indexOf : String -> String -> Maybe Int
indexOf needle s = indexFrom needle s 0

contains : String -> String -> Bool
contains needle s = maybe False (\_ -> True) (indexOf needle s)

startsWith : (prefix : String) -> String -> Bool
startsWith prefix s = strEq (strSlice s 0 (strLength prefix)) prefix

endsWith : String -> String -> Bool
endsWith suffix s =
  strEq (strSlice s (strLength s - strLength suffix) (strLength s)) suffix

-- (the pieces of `s` from `i` on, split at each `sep`, into `acc`, last
-- first)
splitFrom : String -> String -> Int -> List String -> List String
splitFrom sep s i acc = case indexFrom sep s i of
  Nothing -> backwards (Cons (strSlice s i (strLength s)) acc) Nil
  Just j -> splitFrom sep s (j + strLength sep) (Cons (strSlice s i j) acc)
  where
  backwards : List String -> List String -> List String
  backwards Nil out = out
  backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between the `sep`s (not empty: `split "," "a,,b"` is
-- | `["a", "", "b"]`).
split : String -> String -> List String
split sep s = if strLength sep == 0 then [s] else splitFrom sep s 0 Nil

-- | The strings, with `sep` between each two.
joinWith : String -> List String -> String
joinWith sep Nil = ""
joinWith sep (Cons x xs) = after x xs
  where
  after : String -> List String -> String
  after acc Nil = acc
  after acc (Cons y ys) = after (acc ^ sep ^ y) ys

lines : String -> List String
lines s = split "\n" s

unlines : List String -> String
unlines xs = joinWith "\n" xs

isSpaceCode : Int -> Bool
isSpaceCode c = c == 32 || c == 9 || c == 10 || c == 13

-- (the words of `s` from `i` on, the one being read starting at `start`,
-- into `acc`, last first)
wordsFrom : String -> Int -> Int -> List String -> List String
wordsFrom s start i acc =
  if i >= strLength s
    then backwards
        (if start < i then Cons (strSlice s start i) acc else acc)
        Nil
  else if isSpaceCode (strByteAt s i)
    then wordsFrom
        s
        (i + 1)
        (i + 1)
        (if start < i then Cons (strSlice s start i) acc else acc)
  else wordsFrom s start (i + 1) acc
  where
  backwards : List String -> List String -> List String
  backwards Nil out = out
  backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between its spaces, tabs and line breaks.
words : String -> List String
words s = wordsFrom s 0 0 Nil

unwords : List String -> String
unwords xs = joinWith " " xs

-- (from `i`, the first index whose code is not a space, going by `step`)
skipSpaces : String -> Int -> Int -> Int
skipSpaces s i step =
  if 0 <= i && i < strLength s && isSpaceCode (strByteAt s i)
    then skipSpaces s (i + step) step
  else i

-- | Without the spaces at either end.
trim : String -> String
trim s =
  strSlice s (skipSpaces s 0 1) (skipSpaces s (strLength s - 1) (0 - 1) + 1)

-- (the digits of `s` from `i` on, after `n` so far)
digitsFrom : String -> Int -> Int -> Maybe Int
digitsFrom s i n =
  if i >= strLength s then Just n
  else if 48 <= strByteAt s i && strByteAt s i <= 57
    then digitsFrom s (i + 1) (n * 10 + (strByteAt s i - 48))
  else Nothing

-- | A decimal integer (`42`, `-7`), if `s` is one, whole.
parseInt : String -> Maybe Int
parseInt s =
  if strLength s == 0 then Nothing
  else if startsWith "-" s
    then (if strLength s == 1 then Nothing
          else maybe Nothing (\n -> Just (0 - n)) (digitsFrom s 1 0))
  else digitsFrom s 0 0

-- Values as strings
--------------------------------------------------------------------------------

-- | A type's values as the source writes them -- a string quoted, `show
-- | "hi"` is `"\"hi\""`, a rune `show 'a'` is `"'a'"`, bytes a literal --
-- | so that two values that differ are not written the same: what a test
-- | shows a value as and compares two by (lib/check.hf's `assertEqual`,
-- | `forAll`), as Rust's `Debug` and Python's `repr` are.  The prelude's
-- | instances are of `Int`, `Float64`, `String`, `Rune`, `Bytes`, `Bool`,
-- | `Unit` and `Ordering`, and of a `List`, a `Maybe`, a `Pair` and an
-- | `Either` of types that have one; a fixed-width type's is its
-- | module's.
theory Show (a : Type) where
  show : a -> String

-- | The value written as its type's instance writes it.
show : {a : Type} -> {{shows : Show a}} -> a -> String
show = shows.show

-- | An `Int` as a literal writes it, `Int`'s `show`.
-- | >>> showInt 42 ^ " " ^ showInt (-7)
-- | "42 -7"
showInt : Int -> String
showInt = intShow

-- | A `Float64` as a literal writes it, `Float64`'s `show`.
-- | >>> showFloat 2.5
-- | "2.5"
showFloat : Float64 -> String
showFloat = floatShow

instance instanceShowInt : Show Int
instanceShowInt = { show = showInt }

-- | >>> show 42 ^ " " ^ show (-7) ^ " " ^ show 2.5
-- | "42 -7 2.5"
instance instanceShowFloat64 : Show Float64
instanceShowFloat64 = { show = showFloat }

-- | Quoted, its `"`, `\` and line feeds escaped.
-- | >>> show "say \"hi\"\n"
-- | "\"say \\\"hi\\\"\\n\""
-- | >>> show "hi"
-- | "\"hi\""
instance instanceShowString : Show String
instanceShowString = { show = \s -> "\"" ^ escapedFrom s 0 "" ^ "\"" }
  where
  escapeAt : String -> Int -> String
  escapeAt s i =
    if byteAt s i == 34 then "\\\""
    else if byteAt s i == 92 then "\\\\"
    else if byteAt s i == 10 then "\\n"
    else strSlice s i (i + 1)

  -- (the bytes from `i` on, after those escaped so far)
  escapedFrom : String -> Int -> String -> String
  escapedFrom s i acc =
    if i >= strLength s then acc
    else escapedFrom s (i + 1) (acc ^ escapeAt s i)

primitive runeToInt : Rune -> Int

-- | A rune as a literal writes it, quoted: a control character an
-- | escape, one that is no scalar value as U+FFFD (as Go's `%q`).
-- | >>> show 'a' ^ " " ^ show '\'' ^ " " ^ show '\n' ^ " " ^ show '\u{1b}'
-- | "'a' '\\'' '\\n' '\\u{1b}'"
instance instanceShowRune : Show Rune
instanceShowRune = { show = \c -> "'" ^ quoted c ^ "'" }
  where
  hexDigit : Int -> String
  hexDigit d = strSlice "0123456789abcdef" d (d + 1)

  hex : Int -> String
  hex n = if n < 16 then hexDigit n else hex (n / 16) ^ hexDigit (n % 16)

  -- (C0's, DEL and C1's)
  isControl : Int -> Bool
  isControl n = 0 <= n && n <= 31 || 127 <= n && n <= 159

  -- (between the quotes; a rune that is no scalar value U+FFFD, as
  -- `ofRunes` makes it)
  quoted : Rune -> String
  quoted '\'' = "\\'"
  quoted '\\' = "\\\\"
  quoted '\n' = "\\n"
  quoted '\t' = "\\t"
  quoted '\r' = "\\r"
  quoted c =
    if isControl (runeToInt c) then "\\u{" ^ hex (runeToInt c) ^ "}"
    else ofRunes [c]

primitive bytesToList : Bytes -> List UInt8
primitive uint8ToInt : UInt8 -> Int

-- | Bytes as a binary writes them, `b[...]`: each run of printable
-- | ASCII, a byte from 32 up to 126, a string (`"` and `\` escaped), and
-- | any other byte its number.
-- | >>> show b[10, "GET \"\\", 195, 169]
-- | "b[10, \"GET \\\"\\\\\", 195, 169]"
-- | >>> show b[]
-- | "b[]"
instance instanceShowBytes : Show Bytes
instanceShowBytes =
  { show = \b -> "b[" ^ writtenFrom (bytesToList b) "" "" ^ "]" }
  where
  -- (a piece after those written, `acc`)
  piece : String -> String -> String
  piece acc p = if strEq acc "" then p else acc ^ ", " ^ p

  -- (the printable bytes not yet written, `run`, written)
  flush : String -> String -> String
  flush acc run = if strEq run "" then acc else piece acc ("\"" ^ run ^ "\"")

  -- (a printable byte `c`, whose value is `n`, in a string)
  escaped : UInt8 -> Int -> String
  escaped c 34 = "\\\""
  escaped c 92 = "\\\\"
  escaped c n = fromByte c

  -- (the bytes, after those written, `acc`, and those printable not yet,
  -- `run`)
  writtenFrom : List UInt8 -> String -> String -> String
  writtenFrom Nil run acc = flush acc run
  writtenFrom (Cons c cs) run acc =
    if 32 <= uint8ToInt c && uint8ToInt c < 127
      then writtenFrom cs (run ^ escaped c (uint8ToInt c)) acc
    else writtenFrom cs "" (piece (flush acc run) (intShow (uint8ToInt c)))

instance instanceShowBool : Show Bool
instanceShowBool = { show = written }
  where
  written : Bool -> String
  written True = "True"
  written False = "False"

instance instanceShowUnit : Show Unit
instanceShowUnit = { show = \u -> "MkUnit" }

-- | >>> show (True : Bool) ^ " " ^ show (MkUnit : Unit) ^ " " ^ show (GT : Ordering)
-- | "True MkUnit GT"
instance instanceShowOrdering : Show Ordering
instanceShowOrdering = { show = written }
  where
  written : Ordering -> String
  written LT = "LT"
  written EQ = "EQ"
  written GT = "GT"

-- | >>> show ([1, 2] : List Int)
-- | "[1, 2]"
-- | >>> show ([["a"], []] : List (List String))
-- | "[[\"a\"], []]"
instance instanceShowList : {a : Type} -> {{shows : Show a}} -> Show (List a)
instanceShowList = { show = \xs -> "[" ^ joinWith ", " (written xs) ^ "]" }
  where
  written : List a -> List String
  written Nil = Nil
  written (Cons x xs) = Cons (show x) (written xs)

-- | >>> show (Just [1] : Maybe (List Int)) ^ " " ^ show (Nothing : Maybe Int)
-- | "Just ([1]) Nothing"
instance instanceShowMaybe : {a : Type} -> {{shows : Show a}} -> Show (Maybe a)
instanceShowMaybe = { show = written }
  where
  written : Maybe a -> String
  written Nothing = "Nothing"
  written (Just x) = "Just (" ^ show x ^ ")"

-- | >>> show (MkPair 1 "one" : Pair Int String)
-- | "MkPair (1) (\"one\")"
instance instanceShowPair : {a b : Type}
                          -> {{showsA : Show a}}
                          -> {{showsB : Show b}}
                          -> Show (Pair a b)
instanceShowPair = { show = written }
  where
  written : Pair a b -> String
  written (MkPair x y) = "MkPair (" ^ show x ^ ") (" ^ show y ^ ")"

-- | >>> show (Left 1 : Either Int String) ^ " " ^ show (Right "1" : Either Int String)
-- | "Left (1) Right (\"1\")"
instance instanceShowEither : {a b : Type}
                            -> {{showsA : Show a}}
                            -> {{showsB : Show b}}
                            -> Show (Either a b)
instanceShowEither = { show = written }
  where
  written : Either a b -> String
  written (Left x) = "Left (" ^ show x ^ ")"
  written (Right y) = "Right (" ^ show y ^ ")"

-- | A type's values as text, for a reader rather than for the source --
-- | a string itself, a rune its one-rune string, bytes the text they are
-- | -- as Rust's `Display` and Python's `str` are, beside `Show`'s
-- | `Debug` and `repr`.  The prelude's instances are of `String`, `Rune`
-- | and `Bytes`, and of `Int`, `Float64`, `Bool`, `Unit` and `Ordering`,
-- | written as `show` writes them; a fixed-width type's is its module's,
-- | as `show` writes it too.  A `List`, a `Maybe`, a `Pair` and an
-- | `Either` have none: there is no one text of them.
theory ToString (a : Type) where
  toString : a -> String

-- | The value as its type's instance makes it text.
toString : {a : Type} -> {{text : ToString a}} -> a -> String
toString = text.toString

-- | Itself.
-- | >>> toString "hi"
-- | "hi"
instance instanceToStringString : ToString String
instanceToStringString = { toString = \s -> s }

-- | The string of it alone, `ofRunes [c]` (Go's `string(c)`).
-- | >>> toString 'a'
-- | "a"
instance instanceToStringRune : ToString Rune
instanceToStringRune = { toString = \c -> ofRunes [c] }

primitive bytesToString : Bytes -> String

-- | The text of them, UTF-8, what is not UTF-8 U+FFFD, as `rune`'s
-- | `toValid` makes it (and `TextDecoder` reads it).
-- | >>> toString b["h", 0xc3, 0xa9, 0xff, "i"]
-- | "hé\u{FFFD}i"
instance instanceToStringBytes : ToString Bytes
instanceToStringBytes = { toString = bytesToString }

instance instanceToStringInt : ToString Int
instanceToStringInt = { toString = intShow }

-- | >>> toString 42 ^ " " ^ toString (-7) ^ " " ^ toString 2.5
-- | "42 -7 2.5"
instance instanceToStringFloat64 : ToString Float64
instanceToStringFloat64 = { toString = floatShow }

instance instanceToStringBool : ToString Bool
instanceToStringBool = { toString = show }

instance instanceToStringUnit : ToString Unit
instanceToStringUnit = { toString = show }

-- | >>> toString (True : Bool) ^ " " ^ toString (MkUnit : Unit) ^ " " ^ toString (GT : Ordering)
-- | "True MkUnit GT"
instance instanceToStringOrdering : ToString Ordering
instanceToStringOrdering = { toString = show }

-- Nat
--------------------------------------------------------------------------------

-- | Recursion on `Nat`, non-dependent.
-- | >>> natrec (c := Nat) Zero (\_ n -> Succ (Succ n)) (Succ (Succ Zero))
-- | Succ (Succ (Succ (Succ Zero)))
natrec : {c : Type} -> c -> (Nat -> c -> c) -> Nat -> c
natrec z s Zero = z
natrec z s (Succ n) = s n (natrec z s n)
