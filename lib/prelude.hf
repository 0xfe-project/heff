-- The basic types and what is done with them: Nat, Empty, pairs, Maybe,
-- Either; Bool, Unit and lists (lib/builtin.hf has them), lists' `::`
-- and `++` (their other operations are `List`'s, lib/list.hf); numbers
-- and strings, by the primitives, with their operators.

-- | The natural numbers.
data Nat = Zero | Succ Nat

data Empty

data Pair a b = MkPair a b

data Maybe a = Nothing | Just a

data Either a b = Left a | Right b

-- | `x :: xs` is `Cons x xs`; a pattern too, as it only names the tag
(::) : {a : Type} -> a -> List a -> List a
(::) x xs = Cons x xs

-- Functions
--------------------------------------------------------------------------------

id : {a : Type} -> a -> a
id x = x

const : {a b : Type} -> a -> b -> a
const x _ = x

flip : {a b c : Type} -> (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose : {a b c : Type} -> (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

-- The operators: `||` loosest, then `&&`, the comparisons, then `+ -`,
-- `^` and `++` (unrelated: `a + b ^ c` is refused), then `* / %` and a
-- float's division, `/.`; and `$` below all, any module's too (`below`
-- alone).
--------------------------------------------------------------------------------

infixr ||
infixr && above ||
infix == /= < <= > >= above &&
infixl + - above == /= < <= > >=
infixl * / % /. above + -
infixr ++ above == /= < <= > >=
infixr ^ above == /= < <= > >=
infixr :: above == /= < <= > >= below + - * / % ++ ^
infixr $ below

-- | Application, loosest: `f $ g $ x` is `f (g x)`.
($) : {a b : Type} -> (a -> b) -> a -> b
($) f x = f x

-- Bool
--------------------------------------------------------------------------------

not : Bool -> Bool
not True = False
not False = True

(&&) : Bool -> Bool -> Bool
(&&) True b = b
(&&) False _ = False

(||) : Bool -> Bool -> Bool
(||) True _ = True
(||) False b = b

-- | How one value is to another: less, equal, or greater.
data Ordering = LT | EQ | GT

-- The operators' theories
--------------------------------------------------------------------------------

-- An operator is an operation of a theory, of the instance found for the
-- type it is used at: `x + y` is the `add` of an `Add` of their type --
-- an `Int`'s, the prelude's; a fixed-width type's, its module's; a
-- generic function's, the instance argument it asks for, `{{add : Add
-- a}}`.  Each operation is a theory of its own, as Lean's are, so a
-- type has those it has: an integer `/` and `%`, a float neither (but
-- `/.`, a `Float64`'s).  Where the instance is known the operation is
-- what is compiled: `n + 1` at `Int` is `intAdd n 1`, as if written so.

-- | A type's equality: a function that compares values of a type it does
-- | not know asks for it, `{{eq : Eq a}}`, and is given the instance in
-- | scope of the type it is used at -- the prelude's of `Int`, `Float64`,
-- | `String`, `Rune`, `Bool`, `Unit` and `Ordering`, and of a `List`, a
-- | `Maybe`, a `Pair` and an `Either` of types that have one, found by
-- | finding theirs; a fixed-width type's module's of its own.
theory Eq (a : Type) where
  equal : a -> a -> Bool

(==) : {a : Type} -> {{eq : Eq a}} -> a -> a -> Bool
(==) = eq.equal

(/=) : {a : Type} -> {{eq : Eq a}} -> a -> a -> Bool
(/=) x y = not (eq.equal x y)

-- | A type's order: how two values are (`compare`), and whether one is
-- | less than the other, or not greater (`lt`, `le`: what `<` and `<=`
-- | are, as fast as the type has them) -- the prelude's of `Int` and
-- | `Float64`, a fixed-width type's module's of its own.
theory Ord (a : Type) where
  compare : a -> a -> Ordering
  lt : a -> a -> Bool
  le : a -> a -> Bool

compare : {a : Type} -> {{ord : Ord a}} -> a -> a -> Ordering
compare = ord.compare

(<) : {a : Type} -> {{ord : Ord a}} -> a -> a -> Bool
(<) = ord.lt

(<=) : {a : Type} -> {{ord : Ord a}} -> a -> a -> Bool
(<=) = ord.le

(>) : {a : Type} -> {{ord : Ord a}} -> a -> a -> Bool
(>) x y = ord.lt y x

(>=) : {a : Type} -> {{ord : Ord a}} -> a -> a -> Bool
(>=) x y = ord.le y x

-- | The lesser of the two (the first, of two as great).
min : {a : Type} -> {{ord : Ord a}} -> a -> a -> a
min x y = if ord.le x y then x else y

-- | The greater of the two (the second, of two as great).
max : {a : Type} -> {{ord : Ord a}} -> a -> a -> a
max x y = if ord.le x y then y else x

theory Add (a : Type) where
  add : a -> a -> a

(+) : {a : Type} -> {{add : Add a}} -> a -> a -> a
(+) = add.add

theory Sub (a : Type) where
  sub : a -> a -> a

(-) : {a : Type} -> {{sub : Sub a}} -> a -> a -> a
(-) = sub.sub

theory Mul (a : Type) where
  mul : a -> a -> a

(*) : {a : Type} -> {{mul : Mul a}} -> a -> a -> a
(*) = mul.mul

-- | A type's division, total: by zero, zero, as Lean's and Coq's are --
-- | no division abandons, and `x / 0` is 0 (`exn`'s `exnDiv` throws
-- | instead).  Not a float's: `/.` is a `Float64`'s, IEEE's.
theory Div (a : Type) where
  div : a -> a -> a

(/) : {a : Type} -> {{div : Div a}} -> a -> a -> a
(/) = div.div

-- | The remainder of a type's division, total: by zero, the dividend, so
-- | that `(x / y) * y + x % y` is `x` whatever `y` is.
theory Mod (a : Type) where
  mod : a -> a -> a

(%) : {a : Type} -> {{mod : Mod a}} -> a -> a -> a
(%) = mod.mod

-- | A type's negation: what `-x` is, the `neg` in scope applied to `x`.
theory Neg (a : Type) where
  neg : a -> a

neg : {a : Type} -> {{n : Neg a}} -> a -> a
neg = n.neg

-- | A type's zero (a theory of the name `Zero` would take the name of
-- | `Nat`'s tag).
theory HasZero (a : Type) where
  zero : a

zero : {a : Type} -> {{z : HasZero a}} -> a
zero = z.zero

-- | An integer type's bits, as two's complement has them: the and, or and
-- | xor of two, every bit flipped, and shifts -- an `Int`'s in `int`'s
-- | module (lib/int.hf), a fixed-width type's in its own.
theory Bits (a : Type) where
  and : a -> a -> a
  or : a -> a -> a
  xor : a -> a -> a
  complement : a -> a
  shiftL : a -> a -> a
  shiftR : a -> a -> a

-- | The bits set in both.
and : {a : Type} -> {{bits : Bits a}} -> a -> a -> a
and = bits.and

-- | The bits set in either.
or : {a : Type} -> {{bits : Bits a}} -> a -> a -> a
or = bits.or

-- | The bits set in one of the two.
xor : {a : Type} -> {{bits : Bits a}} -> a -> a -> a
xor = bits.xor

-- | Every bit flipped.
complement : {a : Type} -> {{bits : Bits a}} -> a -> a
complement = bits.complement

-- | Shifted left by the second, as the type shifts.
shiftL : {a : Type} -> {{bits : Bits a}} -> a -> a -> a
shiftL = bits.shiftL

-- | Shifted right by the second, as the type shifts.
shiftR : {a : Type} -> {{bits : Bits a}} -> a -> a -> a
shiftR = bits.shiftR

-- Numbers (integers, unbounded)
--------------------------------------------------------------------------------

primitive intAdd : Int -> Int -> Int
primitive intSub : Int -> Int -> Int
primitive intMul : Int -> Int -> Int
primitive intDiv : Int -> Int -> Int
primitive intMod : Int -> Int -> Int
primitive intEq : Int -> Int -> Bool
primitive intLt : Int -> Int -> Bool
primitive intLe : Int -> Int -> Bool
primitive intShow : Int -> String

instance eqInt : Eq Int
eqInt = { equal = intEq }

compareInt : Int -> Int -> Ordering
compareInt a b = if intLt a b then LT else if intEq a b then EQ else GT

-- | >>> 1 < 2 && 2 <= 2 || False
-- | True
-- | >>> ([max 2 (-3), min 2 (-3)] : List Int)
-- | Cons 2 (Cons (-3) Nil)
instance ordInt : Ord Int
ordInt = { compare = compareInt, lt = intLt, le = intLe }

instance addInt : Add Int
addInt = { add = intAdd }

instance subInt : Sub Int
subInt = { sub = intSub }

instance mulInt : Mul Int
mulInt = { mul = intMul }

-- | Division rounding down; by 0, 0.
instance divInt : Div Int
divInt = { div = intDiv }

-- | The remainder of `/`, of the sign of the divisor; by 0, the dividend.
-- | >>> 1 + 2 * 3 - 4 / 2
-- | 5
-- | >>> ([7 / 2, -7 / 2, 7 % 2, -7 % 2, 7 % -2] : List Int)
-- | Cons 3 (Cons (-4) (Cons 1 (Cons 1 (Cons (-1) Nil))))
-- | >>> ([7 / 0, 7 % 0, (7 / 0) * 0 + 7 % 0] : List Int)
-- | Cons 0 (Cons 7 (Cons 7 Nil))
instance modInt : Mod Int
modInt = { mod = intMod }

-- | The integer of the other sign, `0 - x`: what `-x` is.
-- | >>> ([neg 5, -(3 - 10)] : List Int)
-- | Cons (-5) (Cons 7 Nil)
instance negInt : Neg Int
negInt = { neg = \x -> intSub 0 x }

instance zeroInt : HasZero Int
zeroInt = { zero = 0 }

showInt : Int -> String
showInt = intShow

-- Floats (JavaScript's numbers: 64-bit floating point)
--------------------------------------------------------------------------------

primitive floatAdd : Float64 -> Float64 -> Float64
primitive floatSub : Float64 -> Float64 -> Float64
primitive floatMul : Float64 -> Float64 -> Float64
primitive floatDiv : Float64 -> Float64 -> Float64
primitive floatEq : Float64 -> Float64 -> Bool
primitive floatLt : Float64 -> Float64 -> Bool
primitive floatLe : Float64 -> Float64 -> Bool
primitive floatShow : Float64 -> String
primitive floatFromInt : Int -> Float64
primitive floatSqrt : Float64 -> Float64
primitive floatFloor : Float64 -> Int

-- (IEEE's: NaN is no float's equal, its own neither)
instance eqFloat : Eq Float64
eqFloat = { equal = floatEq }

compareFloat : Float64 -> Float64 -> Ordering
compareFloat a b = if floatLt a b then LT else if floatEq a b then EQ else GT

instance ordFloat : Ord Float64
ordFloat = { compare = compareFloat, lt = floatLt, le = floatLe }

instance addFloat : Add Float64
addFloat = { add = floatAdd }

instance subFloat : Sub Float64
subFloat = { sub = floatSub }

instance mulFloat : Mul Float64
mulFloat = { mul = floatMul }

-- | The float of the other sign, 0.0's too: what `-x` is.
instance negFloat : Neg Float64
negFloat = { neg = \x -> floatMul (-1.0) x }

instance zeroFloat : HasZero Float64
zeroFloat = { zero = 0.0 }

-- | Division; by 0, an infinity (or not a number, of 0 by 0): a float has
-- | no `/`, whose division by 0 is 0.
-- | >>> ([neg 2.5, -(1.0 - 3.5), 1.0 /. neg 0.0, 2.5 * 2.0 + 1.0] : List Float64)
-- | [-2.5, 2.5, -Infinity, 6.0]
(/.) : Float64 -> Float64 -> Float64
(/.) = floatDiv

toFloat : Int -> Float64
toFloat = floatFromInt

-- | The greatest integer not above; of an infinity, or what is not a
-- | number, `abandon`.
floor : Float64 -> Int
floor = floatFloor

sqrt : Float64 -> Float64
sqrt = floatSqrt

showFloat : Float64 -> String
showFloat = floatShow

-- Strings: bytes, UTF-8 as a literal has them (`"é"` is two), though
-- any bytes may be in one, as Go's: its length, an index, a slice are of
-- bytes, its order the bytes' (of UTF-8 its runes' order), and `runes`
-- reads its runes.
--------------------------------------------------------------------------------

primitive strAppend : String -> String -> String
primitive strLength : String -> Int
primitive strSlice : String -> Int -> Int -> String
primitive strEq : String -> String -> Bool
primitive strLt : String -> String -> Bool

-- | `a ^ b`: the string `a`, then `b`.
-- | >>> "count: " ^ showInt (7 % 3)
-- | "count: 1"
-- | >>> "he" ^ "ff" ^ "!"
-- | "heff!"
(^) : String -> String -> String
(^) = strAppend

-- Equality
--------------------------------------------------------------------------------

instance eqString : Eq String
eqString = { equal = strEq }

instance eqRune : Eq Rune
eqRune = { equal = runeEq }

instance eqBool : Eq Bool
eqBool = { equal = \a b -> if a then b else not b }

instance eqUnit : Eq Unit
eqUnit = { equal = \a b -> True }

instance eqOrdering : Eq Ordering
eqOrdering = { equal = sameOrder }
  where
    sameOrder : Ordering -> Ordering -> Bool
    sameOrder LT LT = True
    sameOrder EQ EQ = True
    sameOrder GT GT = True
    sameOrder _ _ = False

-- | Whether the two are equal, as the instance of their type says.
-- | >>> equal 3 3
-- | True
-- | >>> equal "heff" "help"
-- | False
-- | >>> equal 0.5 0.5 && not (equal 'a' 'b') && equal (1 < 2) True
-- | True
-- | >>> equal (compareInt 1 2) LT
-- | True
equal : {a : Type} -> {{eq : Eq a}} -> a -> a -> Bool
equal x y = eq.equal x y

-- | Lists are equal where they are as long, and equal element by element.
-- | >>> equal ([1, 2] : List Int) [1, 2]
-- | True
-- | >>> equal ([[1, 2], [3]] : List (List Int)) [[1, 2], []]
-- | False
instance eqList : {a : Type} -> {{eq : Eq a}} -> Eq (List a)
eqList = { equal = sameElements }
  where
    sameElements : List a -> List a -> Bool
    sameElements Nil Nil = True
    sameElements (Cons x xs) (Cons y ys) = equal x y && sameElements xs ys
    sameElements _ _ = False

-- | >>> equal (Just 'h' : Maybe Rune) (Just 'h')
-- | True
-- | >>> equal (Just [1] : Maybe (List Int)) Nothing
-- | False
instance eqMaybe : {a : Type} -> {{eq : Eq a}} -> Eq (Maybe a)
eqMaybe = { equal = bothOrNeither }
  where
    bothOrNeither : Maybe a -> Maybe a -> Bool
    bothOrNeither Nothing Nothing = True
    bothOrNeither (Just x) (Just y) = equal x y
    bothOrNeither _ _ = False

-- | >>> equal (MkPair 1 "one" : Pair Int String) (MkPair 1 "one")
-- | True
instance eqPair : {a b : Type}
                -> {{eqA : Eq a}}
                -> {{eqB : Eq b}}
                -> Eq (Pair a b)
eqPair = { equal = sameSides }
  where
    sameSides : Pair a b -> Pair a b -> Bool
    sameSides (MkPair x1 y1) (MkPair x2 y2) = equal x1 x2 && equal y1 y2

-- | >>> equal (Left 1 : Either Int String) (Right "1")
-- | False
instance eqEither : {a b : Type}
                  -> {{eqA : Eq a}}
                  -> {{eqB : Eq b}}
                  -> Eq (Either a b)
eqEither = { equal = sameSide }
  where
    sameSide : Either a b -> Either a b -> Bool
    sameSide (Left x) (Left y) = equal x y
    sameSide (Right x) (Right y) = equal x y
    sameSide _ _ = False

-- Pairs, Maybe, Either
--------------------------------------------------------------------------------

fst : {a b : Type} -> Pair a b -> a
fst (MkPair x y) = x

snd : {a b : Type} -> Pair a b -> b
snd (MkPair x y) = y

maybe : {a b : Type} -> b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

-- | >>> fromMaybe 0 (Just 4)
-- | 4
fromMaybe : {a : Type} -> a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

either : {a b c : Type} -> (a -> c) -> (b -> c) -> Either a b -> c
either f g (Left x) = f x
either f g (Right y) = g y

-- Lists (their operations are `List`'s, lib/list.hf)
--------------------------------------------------------------------------------

-- | `xs ++ ys`: the elements of `xs`, then those of `ys`.
-- | >>> [1, 2] ++ [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
(++) : {a : Type} -> List a -> List a -> List a
(++) Nil ys = ys
(++) (Cons x xs) ys = Cons x (xs ++ ys)

-- Text
--------------------------------------------------------------------------------

primitive strByteAt : String -> Int -> Int
primitive strFromByte : Int -> String

-- | The byte at `i`, 0 to 255; out of range, `-1`.
-- | >>> byteAt "a\u{e9}" 1
-- | 195
-- | >>> byteAt "a\u{e9}" 3
-- | -1
byteAt : String -> Int -> Int
byteAt = strByteAt

-- | The string of one byte, 0 to 255 (any other abandons): a byte of
-- | no rune too, which no literal but a `\xNN` escape has.
-- | >>> fromByte 104 ^ fromByte 105
-- | "hi"
fromByte : Int -> String
fromByte = strFromByte

primitive strRunes : String -> List Rune
primitive strOfRunes : List Rune -> String
primitive strRuneAt : String -> Int -> Rune
primitive strRuneWidth : String -> Int -> Int

-- | The runes of `s`, its code points, UTF-8 read: `runes "a😀"` is
-- | `['a', '😀']`; what is not UTF-8 is U+FFFD, one for each longest
-- | start of a rune's bytes (or a byte that starts none), as
-- | `TextDecoder` reads it.  Their operations are lib/rune.hf's.
runes : String -> List Rune
runes = strRunes

-- | The string of runes, UTF-8 (one that is no Unicode scalar value,
-- | U+FFFD): `ofRunes (runes s)` is `s`, where `s` is UTF-8.
ofRunes : List Rune -> String
ofRunes = strOfRunes

-- | A rune of a string, and how many bytes of it it takes.
type RuneAt = { rune : Rune, width : Int }

-- | The rune whose bytes start at `i`, and how many they are (Go's
-- | `utf8.DecodeRuneInString`): where they are not UTF-8, U+FFFD, as
-- | `runes` reads it; out of range, U+FFFD of none.
-- | >>> (runeAt "a\u{e9}b" 1).width
-- | 2
-- | >>> (runeAt "a\u{e9}b" 2).width
-- | 1
runeAt : String -> Int -> RuneAt
runeAt s i = { rune = strRuneAt s i, width = strRuneWidth s i }

compareString : String -> String -> Ordering
compareString a b = if strLt a b then LT else if strEq a b then EQ else GT

-- | Where `needle` is first in `s`, from `i` on, if it is.
indexFrom : String -> String -> Int -> Maybe Int
indexFrom needle s i =
  if i + strLength needle > strLength s then Nothing
  else if strEq (strSlice s i (i + strLength needle)) needle then Just i
  else indexFrom needle s (i + 1)

indexOf : String -> String -> Maybe Int
indexOf needle s = indexFrom needle s 0

contains : String -> String -> Bool
contains needle s = maybe False (\_ -> True) (indexOf needle s)

startsWith : (prefix : String) -> String -> Bool
startsWith prefix s = strEq (strSlice s 0 (strLength prefix)) prefix

endsWith : String -> String -> Bool
endsWith suffix s =
  strEq (strSlice s (strLength s - strLength suffix) (strLength s)) suffix

-- (the pieces of `s` from `i` on, split at each `sep`, into `acc`, last
-- first)
splitFrom : String -> String -> Int -> List String -> List String
splitFrom sep s i acc = case indexFrom sep s i of
  Nothing -> backwards (Cons (strSlice s i (strLength s)) acc) Nil
  Just j -> splitFrom sep s (j + strLength sep) (Cons (strSlice s i j) acc)
  where
    backwards : List String -> List String -> List String
    backwards Nil out = out
    backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between the `sep`s (not empty: `split "," "a,,b"` is
-- | `["a", "", "b"]`).
split : String -> String -> List String
split sep s = if strLength sep == 0 then [s] else splitFrom sep s 0 Nil

-- | The strings, with `sep` between each two.
joinWith : String -> List String -> String
joinWith sep Nil = ""
joinWith sep (Cons x xs) = after x xs
  where
    after : String -> List String -> String
    after acc Nil = acc
    after acc (Cons y ys) = after (acc ^ sep ^ y) ys

lines : String -> List String
lines s = split "\n" s

unlines : List String -> String
unlines xs = joinWith "\n" xs

isSpaceCode : Int -> Bool
isSpaceCode c = c == 32 || c == 9 || c == 10 || c == 13

-- (the words of `s` from `i` on, the one being read starting at `start`,
-- into `acc`, last first)
wordsFrom : String -> Int -> Int -> List String -> List String
wordsFrom s start i acc =
  if i >= strLength s
    then backwards
        (if start < i then Cons (strSlice s start i) acc else acc)
        Nil
  else if isSpaceCode (strByteAt s i)
    then wordsFrom
        s
        (i + 1)
        (i + 1)
        (if start < i then Cons (strSlice s start i) acc else acc)
  else wordsFrom s start (i + 1) acc
  where
    backwards : List String -> List String -> List String
    backwards Nil out = out
    backwards (Cons x xs) out = backwards xs (Cons x out)

-- | The pieces of `s` between its spaces, tabs and line breaks.
words : String -> List String
words s = wordsFrom s 0 0 Nil

unwords : List String -> String
unwords xs = joinWith " " xs

-- (from `i`, the first index whose code is not a space, going by `step`)
skipSpaces : String -> Int -> Int -> Int
skipSpaces s i step =
  if 0 <= i && i < strLength s && isSpaceCode (strByteAt s i)
    then skipSpaces s (i + step) step
  else i

-- | Without the spaces at either end.
trim : String -> String
trim s =
  strSlice s (skipSpaces s 0 1) (skipSpaces s (strLength s - 1) (0 - 1) + 1)

-- (the digits of `s` from `i` on, after `n` so far)
digitsFrom : String -> Int -> Int -> Maybe Int
digitsFrom s i n =
  if i >= strLength s then Just n
  else if 48 <= strByteAt s i && strByteAt s i <= 57
    then digitsFrom s (i + 1) (n * 10 + (strByteAt s i - 48))
  else Nothing

-- | A decimal integer (`42`, `-7`), if `s` is one, whole.
parseInt : String -> Maybe Int
parseInt s =
  if strLength s == 0 then Nothing
  else if startsWith "-" s
    then (if strLength s == 1 then Nothing
          else maybe Nothing (\n -> Just (0 - n)) (digitsFrom s 1 0))
  else digitsFrom s 0 0

-- Nat
--------------------------------------------------------------------------------

-- | Recursion on `Nat`, non-dependent.
-- | >>> natrec (c := Nat) Zero (\_ n -> Succ (Succ n)) (Succ (Succ Zero))
-- | Succ (Succ (Succ (Succ Zero)))
natrec : {c : Type} -> c -> (Nat -> c -> c) -> Nat -> c
natrec z s Zero = z
natrec z s (Succ n) = s n (natrec z s n)
