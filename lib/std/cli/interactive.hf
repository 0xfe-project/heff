-- A program's commands, as std.cli says them, learned by using them: a
-- list of the commands with what each does, filtered by what is typed;
-- a command picked is a form of its positionals and its flags -- each
-- with what it is, its values, whether it is wanted -- and the command
-- line the form makes, shown as it is filled in, with what is wrong with
-- it yet.  Done, it is the words of that command line, for the program
-- to run as if they had been given it (`CLI.readLine`).  An app of
-- std.terminal.widget's, pure: std.terminal runs it on the terminal
-- (`Terminal.interact (Interactive.app "heff" (Interactive.entries
-- cs))`); `heff` with no words runs heff's own.  A command line that
-- lacks only what its command wants (`heff run`, no file) opens on the
-- command's form alone, filled in with what it has (`lacking`,
-- `prompt`).  Import it by a name, `import std.cli.interactive as
-- Interactive`.
--
-- Keys: on the list, up and down (or `j` and `k`, Ctrl-N and Ctrl-P) to
-- move, a page, Home and End; anything typed filters it by the
-- commands' names (`/` first to type a `j`, `k` or `q`); Enter or Tab
-- opens the command; Esc clears the filter, or ends, as `q` does.  On a
-- form, Tab and down to the next field, Shift-Tab and up to the one
-- before; a field of words is typed in as a shell's line is -- in a
-- field of paths, the names its last word completes to shown under it,
-- and Tab completing it as far as they all go (`listed` lists them) --
-- a choice turned by left and right (or space); Enter ends, with the command
-- line, once nothing is wrong with it; Esc goes back to the list (and
-- `q`, on a choice), or, on a form alone, ends.

module std.cli.interactive
  ( Entry
  , entries
  , Part(..)
  , Input(..)
  , Slot
  , Form
  , formOf
  , formWords
  , formProblem
  , lacking
  , quoted
  , commandLine
  , Listing
  , pathsFor
  , Model
  , start
  , matching
  , picked
  , Result
  , step
  , view
  , app
  , prompt
  , listed
  )
import co
import exception
import rune as Rune
import std.cli as CLI
import std.filesystem
import std.path as Path
import std.terminal.widget as Widget

-- The commands
--------------------------------------------------------------------------------

-- | A command, as the list and its form show it: its name, what it
-- | does, and the words it takes.
type Entry = { name : String, doc : String, shape : CLI.Shape }

entryOf : {r : Type} -> CLI.Command r -> Entry
entryOf k = { name = k.name, doc = k.doc, shape = CLI.shapeOfCommand k }

-- | The commands the usage shows, as entries.
entries : {r : Type} -> List (CLI.Command r) -> List Entry
entries cs = List.map entryOf (List.keepIf (\(k : CLI.Command r) -> k.shown) cs)

-- The form
--------------------------------------------------------------------------------

-- | What a field of a form is for: a positional, or a flag.
data Part = Positional CLI.Pos | Flagged CLI.Flag

-- | What a field holds: words typed, or a value chosen.
data Input = Typed Widget.Field | Picked Widget.Choice

-- | A field of a form.
type Slot = { part : Part, input : Input }

-- (a switch's values)
switchOptions : List String
switchOptions = ["off", "on"]

posSlot : CLI.Pos -> Slot
posSlot p = { part = Positional p, input = Typed (Widget.field "") }

-- (a flag's field: a switch, off or on; one of its values, none first
-- where it may be left out; else words typed)
flagSlot : CLI.Flag -> Slot
flagSlot f =
  { part = Flagged f
  , input =
      if strEq f.meta "" then Picked (Widget.choice switchOptions)
      else if List.null f.values then Typed (Widget.field "")
      else if f.required then Picked (Widget.choice f.values)
      else Picked (Widget.choice ("" :: f.values))
  }

-- | A command's form: the command, its fields -- its positionals, then
-- | its flags -- and the one being filled in.
type Form = { entry : Entry, slots : List Slot, at : Int }

-- | The command's form, empty.
formOf : Entry -> Form
formOf e =
  { entry = e
  , slots =
      List.append
        (List.map posSlot e.shape.pos)
        (List.map flagSlot e.shape.flags)
  , at = 0
  }

-- (a positional's words, by how many it takes: one, as typed, or none
-- where nothing is; else the words typed, split at spaces)
posWords : CLI.Arity -> String -> List String
posWords One t = if strEq (trim t) "" then Nil else [trim t]
posWords Optional t = if strEq (trim t) "" then Nil else [trim t]
posWords a t = words t

-- (a flag's words: a switch's name where it is on; `--long=value` where
-- a value is given)
flagWord : CLI.Flag -> String -> List String
flagWord f v =
  if strEq f.meta "" then (if strEq v "on" then ["--" ^ f.long] else Nil)
  else if strEq v "" then Nil
  else ["--" ^ f.long ^ "=" ^ v]

-- (what a field puts on the command line)
partWords : Part -> Input -> List String
partWords (Positional p) (Typed t) = posWords p.arity (Widget.fieldText t)
partWords (Positional p) (Picked c) = posWords p.arity (Widget.chosen c)
partWords (Flagged f) (Typed t) = flagWord f (trim (Widget.fieldText t))
partWords (Flagged f) (Picked c) = flagWord f (Widget.chosen c)

slotWords : Slot -> List String
slotWords s = partWords s.part s.input

isPositional : Slot -> Bool
isPositional { part = Positional _ } = True
isPositional s = False

-- (a word that would be read as a flag)
flagLike : String -> Bool
flagLike w = strLength w >= 2 && byteAt w 0 == 45

isRest : CLI.Pos -> Bool
isRest { arity = Rest } = True
isRest p = False

hasRest : CLI.Shape -> Bool
hasRest sh = List.any isRest sh.pos

-- (the positionals' words and the flags', put together: the positionals
-- first, as a usage writes them -- but the flags first where a rest
-- would take them as its words, or where a positional's word would be
-- read as a flag, and `--` before the positionals then)
arranged : Bool -> List String -> List String -> List String
arranged rest ps fs =
  if List.any flagLike ps then List.append fs ("--" :: ps)
  else if rest then List.append fs ps
  else List.append ps fs

-- | The words of the command line the form makes, after the command's
-- | name.
formWords : Form -> List String
formWords fm =
  arranged
    (hasRest fm.entry.shape)
    (List.concatMap slotWords (List.keepIf isPositional fm.slots))
    (List.concatMap
       slotWords
       (List.keepIf (\s -> not (isPositional s)) fm.slots))

-- | What is wrong with the command line the form makes, if anything.
formProblem : Form -> Maybe CLI.Problem
formProblem fm = CLI.problemOf fm.entry.shape (formWords fm)

-- The form of what a command line lacks
--------------------------------------------------------------------------------

-- (the words each positional is given, as far as there are words: the
-- positionals that take one, one each, the one that takes many the rest)
posGiven : List CLI.Pos -> List String -> List (List String)
posGiven [] ws = Nil
posGiven ({ arity = One } :: ps) ws =
  List.take 1 ws :: posGiven ps (List.drop 1 ws)
posGiven ({ arity = Optional } :: ps) ws =
  List.take 1 ws :: posGiven ps (List.drop 1 ws)
posGiven (p :: ps) ws = ws :: posGiven ps Nil

-- (the values a flag was given, in order)
flagGiven : List (Pair String String) -> CLI.Flag -> List String
flagGiven fs f =
  List.map
    snd
    (List.keepIf (\(p : Pair String String) -> strEq (fst p) f.long) fs)

-- (a positional's field, its words typed in)
posFilled : CLI.Pos -> List String -> Slot
posFilled p ws =
  { part = Positional p, input = Typed (Widget.field (unwords ws)) }

-- (a choice turned to the value, where it is one of its values)
turnedTo : String -> Widget.Choice -> Widget.Choice
turnedTo v c = { c | at = fromMaybe c.at (List.indexWhere (strEq v) c.options) }

-- (a flag's field, its last value given put in: a switch on, a value
-- chosen, words typed)
flagFilled : List (Pair String String) -> CLI.Flag -> Slot
flagFilled fs f = case List.last (flagGiven fs f) of
  Nothing -> flagSlot f
  Just v -> case (flagSlot f).input of
    Picked c ->
      { part = Flagged f
      , input = Picked (turnedTo (if strEq f.meta "" then "on" else v) c)
      }
    Typed t -> { part = Flagged f, input = Typed (Widget.field v) }

-- (a positional must be given a word)
wanted : CLI.Arity -> Bool
wanted One = True
wanted Some = True
wanted a = False

-- (a field is lacking: a positional that is wanted, nothing typed in it;
-- a flag that is wanted, not given)
lacks : List (Pair String String) -> Slot -> Bool
lacks fs { part = Positional p, input = Typed t } =
  wanted p.arity && strEq (trim (Widget.fieldText t)) ""
lacks fs { part = Flagged f } = f.required && List.null (flagGiven fs f)
lacks fs s = False

-- (the command's form, filled in with the words split, the first field
-- lacking being filled in)
formFilled : Entry -> CLI.Split -> Form
formFilled e sp =
  { entry = e
  , slots = slots
  , at = fromMaybe 0 (List.indexWhere (lacks sp.flags) slots)
  }
  where
  slots : List Slot
  slots =
    List.append
      (List.zipWith posFilled e.shape.pos (posGiven e.shape.pos sp.pos))
      (List.map (flagFilled sp.flags) e.shape.flags)

-- (each value a flag was given is one of its values, where it has them)
valuesAllowed : CLI.Shape -> CLI.Split -> Bool
valuesAllowed sh sp =
  List.all
    (\(f : CLI.Flag) ->
       List.null f.values
       || List.all (\v -> List.elem v f.values) (flagGiven sp.flags f))
    sh.flags

-- (no positional is given a word too many)
noneExtra : Either CLI.Problem (List (List String)) -> Bool
noneExtra (Left (Extra _)) = False
noneExtra gs = True

-- (the words, split, if what is wrong with them is what they lack alone)
lackingOnly : CLI.Shape -> List String -> Maybe CLI.Split
lackingOnly sh ws = case CLI.problemOf sh ws of
  Just (Missing _) -> fitting
  Just (MissingFlag _) -> fitting
  _ -> Nothing
  where
  fitting : Maybe CLI.Split
  fitting = case CLI.splitWords sh ws of
    Right sp ->
      if valuesAllowed sh sp && noneExtra (CLI.groupsGo sh.pos sp.pos)
      then Just sp
      else Nothing
    Left p -> Nothing

-- | The form of the command the words call, filled in with them, where
-- | all that is wrong with them is a positional or a flag wanted
-- | (`Missing`, `MissingFlag`): the first field still wanted is the one
-- | being filled in.
-- | >>> maybe Nil formWords (lacking (entries CLI.commandsEx) ["compile", "a.hf", "-bc"])
-- | ["a.hf", "--backend=c"]
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["compile", "a.hf", "-bc"])
-- | 1
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["compile", "a.hf", "a.mjs"])
-- | 3
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["compile", "a.hf", "a.mjs", "b", "-bc"])
-- | -1
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["compile", "a.hf", "-b", "wasm"])
-- | -1
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["compile", "-h"])
-- | -1
-- | >>> maybe (0 - 1) (\(fm : Form) -> fm.at) (lacking (entries CLI.commandsEx) ["run"])
-- | 0
lacking : List Entry -> List String -> Maybe Form
lacking es [] = Nothing
lacking es (name :: ws) = case List.find
    (\(e : Entry) -> strEq e.name name)
    es of
  Just e -> case lackingOnly e.shape ws of
    Just sp -> Just (formFilled e sp)
    Nothing -> Nothing
  Nothing -> Nothing

-- (a byte a shell takes as it is)
plainByte : Int -> Bool
plainByte b =
  (b >= 48 && b <= 57)
  || (b >= 65 && b <= 90)
  || (b >= 97 && b <= 122)
  || List.elem b [45, 95, 46, 47, 61, 58, 44, 64, 37, 43]

-- | A word as a shell is to be given it: as it is, or in single quotes.
-- | >>> List.map quoted ["a.hf", "two words", "it's", ""]
-- | ["a.hf", "'two words'", "'it'\\''s'", "''"]
quoted : String -> String
quoted w =
  if not (strEq w "") && plainFrom 0 then w
  else "'" ^ joinWith "'\\''" (split "'" w) ^ "'"
  where
  plainFrom : Int -> Bool
  plainFrom i =
    if i >= strLength w then True
    else plainByte (byteAt w i) && plainFrom (i + 1)

-- | The command line: the program, the command, its words, as a shell
-- | is to be given them.
commandLine : String -> String -> List String -> String
commandLine prog name ws = unwords (prog :: name :: List.map quoted ws)

-- Paths completed
--------------------------------------------------------------------------------

-- | A directory, as a path typed in a field is completed in it: the
-- | directory as typed (`""`, the working one), and each name in it, a
-- | directory's with a `/` after it.
type Listing = { dir : String, names : List String }

-- (where the last `/` of the word is, from `i` down; -1 where there is
-- none)
slashFrom : String -> Int -> Int
slashFrom w i =
  if i < 0 then i else if byteAt w i == 47 then i else slashFrom w (i - 1)

-- (the word's directory, as typed: up to its last `/`)
dirOf : String -> String
dirOf w = strSlice w 0 (slashFrom w (strLength w - 1) + 1)

-- (the last word of a field's text: the one completed)
lastWord : String -> String
lastWord t = fromMaybe "" (List.last (split " " t))

-- (what a field's words complete to)
partComplete : Part -> CLI.Complete
partComplete (Positional p) = p.complete
partComplete (Flagged f) = f.complete

-- (a field's words are paths: files, or directories)
completesPaths : CLI.Complete -> Bool
completesPaths (Files _) = True
completesPaths Dirs = True
completesPaths c = False

-- (a name a path of the kind may be: a directory, or a file with the
-- suffix)
nameTaken : CLI.Complete -> String -> Bool
nameTaken (Files sfx) n = endsWith "/" n || endsWith sfx n
nameTaken Dirs n = endsWith "/" n
nameTaken c n = False

-- | What a path being typed completes to, of the kind: the names listed
-- | in its directory that start as the rest of it does and that the kind
-- | takes -- one that starts with `.` only where the rest does.
-- | >>> pathsFor (Files ".hf") { dir = "src/", names = ["a.hf", "ab/", "b.hf", "c.txt", ".x/"] } "src/a"
-- | ["src/a.hf", "src/ab/"]
-- | >>> pathsFor Dirs { dir = "", names = ["a.hf", "ab/", ".x/"] } ""
-- | ["ab/"]
-- | >>> pathsFor Dirs { dir = "", names = ["ab/", ".x/"] } "."
-- | [".x/"]
-- | >>> pathsFor (Files ".hf") { dir = "", names = ["a.hf"] } "src/"
-- | []
pathsFor : CLI.Complete -> Listing -> String -> List String
pathsFor c l w =
  if strEq l.dir (dirOf w)
  then List.map (\n -> dirOf w ^ n) (List.keepIf taken l.names)
  else Nil
  where
  rest : String
  rest = strSlice w (strLength (dirOf w)) (strLength w)
  taken : String -> Bool
  taken n =
    nameTaken c n
    && startsWith (prefix := rest) n
    && (startsWith (prefix := ".") rest || not (startsWith (prefix := ".") n))

-- (back to where a rune starts)
runeStart : String -> Int -> Int
runeStart a i =
  if i > 0 && i < strLength a && byteAt a i >= 128 && byteAt a i < 192
  then runeStart a (i - 1)
  else i

-- (how far two strings are the same, from `i`: not into a rune's
-- continuation bytes)
sameUpTo : String -> String -> Int -> Int
sameUpTo a b i =
  if i < strLength a && i < strLength b && byteAt a i == byteAt b i
  then sameUpTo a b (i + 1)
  else runeStart a i

-- (what the words all start with)
commonStart : List String -> String
commonStart [] = ""
commonStart (x :: xs) =
  List.foldl (\(a : String) (b : String) -> strSlice a 0 (sameUpTo a b 0)) x xs

-- The app
--------------------------------------------------------------------------------

-- | Where the app is: the program's name, its commands, the filter
-- | typed and whether it is being typed (`j`, `k` and `q` are then
-- | letters of it), which of the commands it lets through is picked,
-- | the form open, if one is, whether the form is all there is (no
-- | list to go back to: `prompt`), and the directory listed for the
-- | path being typed in it, if one is (`listed`).
type Model =
  { prog : String
  , entries : List Entry
  , filter : Widget.Field
  , typing : Bool
  , menu : Widget.Menu
  , form : Maybe Form
  , alone : Bool
  , listing : Maybe Listing
  }

-- | The list of the commands, nothing typed.
start : String -> List Entry -> Model
start prog es =
  { prog = prog
  , entries = es
  , filter = Widget.field ""
  , typing = False
  , menu = Widget.menu
  , form = Nothing
  , alone = False
  , listing = Nothing
  }

-- | The commands the filter lets through: those whose names have it.
matching : Model -> List Entry
matching m =
  List.keepIf
    (\(e : Entry) -> contains (Widget.fieldText m.filter) e.name)
    m.entries

-- | The command picked, if the filter lets any through.
picked : Model -> Maybe Entry
picked m = List.head (List.drop m.menu.at (matching m))

type Result = Maybe (List String)

-- (the filter after an edit: being typed if anything is in it, the first
-- of what it lets through picked)
refiltered : Model -> Widget.Field -> Widget.Step Model Result
refiltered m f =
  Continue
    { m
    | filter = f
    , typing = m.typing || not (List.null f.text)
    , menu = Widget.menu
    }

-- (the filter edited by a key)
edited : Widget.Key -> Model -> Widget.Step Model Result
edited k m = refiltered m (Widget.fieldKey k m.filter)

-- (the selection moved by a key)
moved : Widget.Key -> Model -> Widget.Step Model Result
moved k m =
  Continue
    { m | menu = Widget.menuKey (List.length (matching m)) k m.menu }

-- (the form of the command picked opened, if one is)
opened : Model -> Maybe Entry -> Widget.Step Model Result
opened m (Just e) = Continue { m | form = Just (formOf e) }
opened m Nothing = Continue m

-- (a rune typed on the list: `j`, `k`, `q` and `/` keys where the filter
-- is not being typed, else a letter of it)
typedOnList : Rune -> Model -> Widget.Step Model Result
typedOnList c m =
  if m.typing then edited (Char c) m
  else if c == 'q' then Done Nothing
  else if c == 'j' then moved ArrowDown m
  else if c == 'k' then moved ArrowUp m
  else if c == '/' then Continue { m | typing = True }
  else edited (Char c) m

-- (a control key on the list: Ctrl-N and Ctrl-P move, the others edit
-- the filter)
controlOnList : Rune -> Model -> Widget.Step Model Result
controlOnList c m =
  if c == 'n' || c == 'p' then moved (Control c) m
  else edited (Control c) m

-- (Esc on the list: the filter cleared, or the end)
escapedList : Model -> Widget.Step Model Result
escapedList m =
  if m.typing then refiltered { m | typing = False } (Widget.field "")
  else Done Nothing

-- (a key on the list)
listStep : Widget.Key -> Model -> Widget.Step Model Result
listStep Escape m = escapedList m
listStep Enter m = opened m (picked m)
listStep Tab m = opened m (picked m)
listStep (Char c) m = typedOnList c m
listStep (Control c) m = controlOnList c m
listStep Backspace m = edited Backspace m
listStep Delete m = edited Delete m
listStep ArrowLeft m = edited ArrowLeft m
listStep ArrowRight m = edited ArrowRight m
listStep k m = moved k m

-- (the `i`th of the list changed by `g`)
updateAt : {a : Type} -> Int -> (a -> a) -> List a -> List a
updateAt i g [] = Nil
updateAt i g (x :: xs) =
  if i == 0 then g x :: xs else x :: updateAt (i - 1) g xs

-- (a field's input after a key)
inputKey : Widget.Key -> Input -> Input
inputKey k (Typed f) = Typed (Widget.fieldKey k f)
inputKey k (Picked c) = Picked (Widget.choiceKey k c)

slotKey : Widget.Key -> Slot -> Slot
slotKey k s = { s | input = inputKey k s.input }

-- (the field being filled in)
focused : Form -> Maybe Slot
focused fm = List.head (List.drop fm.at fm.slots)

-- (the field is a choice)
isPicked : Maybe Slot -> Bool
isPicked (Just { input = Picked _ }) = True
isPicked s = False

-- (the form, the next field, or the one before, filled in)
nextSlot : Int -> Form -> Form
nextSlot d fm =
  { fm
  | at =
      if List.null fm.slots then 0
      else (fm.at + d + List.length fm.slots) % List.length fm.slots
  }

-- (the form left: back to the list, or, where there is none, the end)
leftForm : Model -> Widget.Step Model Result
leftForm m = if m.alone then Done Nothing else Continue { m | form = Nothing }

-- (the model with its form)
withForm : Model -> Form -> Widget.Step Model Result
withForm m fm = Continue { m | form = Just fm }

-- (Enter on a form: its words, the command's name first, once nothing is
-- wrong with them)
entered : Model -> Form -> Maybe CLI.Problem -> Widget.Step Model Result
entered m fm Nothing = Done (Just (fm.entry.name :: formWords fm))
entered m fm (Just p) = Continue m

-- (a key given the field being filled in -- but on a choice, `q` goes
-- back and `j` and `k` move, as nothing is typed there)
slotStep : Widget.Key -> Model -> Form -> Widget.Step Model Result
slotStep (Char c) m fm =
  if isPicked (focused fm) && c == 'q' then leftForm m
  else if isPicked (focused fm) && c == 'j' then withForm m (nextSlot 1 fm)
  else if isPicked (focused fm) && c == 'k'
  then withForm m (nextSlot (0 - 1) fm)
  else withForm m { fm | slots = updateAt fm.at (slotKey (Char c)) fm.slots }
slotStep (Control c) m fm =
  if c == 'n' then withForm m (nextSlot 1 fm)
  else if c == 'p' then withForm m (nextSlot (0 - 1) fm)
  else withForm m { fm | slots = updateAt fm.at (slotKey (Control c)) fm.slots }
slotStep k m fm =
  withForm m { fm | slots = updateAt fm.at (slotKey k) fm.slots }

-- (the paths the field being filled in completes to, as listed)
offered : Maybe Listing -> Form -> List String
offered (Just l) fm = case focused fm of
  Just { part = p, input = Typed t } ->
    if completesPaths (partComplete p)
    then pathsFor (partComplete p) l (lastWord (Widget.fieldText t))
    else Nil
  s -> Nil
offered Nothing fm = Nil

-- (the text, its last word completed as far as the paths it completes
-- to all go, if they go further)
completedText : String -> List String -> Maybe String
completedText t ps =
  if strLength (commonStart ps) > strLength (lastWord t)
  then Just
      (strSlice t 0 (strLength t - strLength (lastWord t)) ^ commonStart ps)
  else Nothing

-- (the field being filled in, its path completed, if it goes further)
completedForm : Maybe Listing -> Form -> Maybe Form
completedForm l fm = case focused fm of
  Just { input = Typed t } -> case completedText
      (Widget.fieldText t)
      (offered l fm) of
    Just text ->
      Just
        { fm
        | slots =
            updateAt
              fm.at
              (\(s : Slot) -> { s | input = Typed (Widget.field text) })
              fm.slots
        }
    Nothing -> Nothing
  s -> Nothing

-- (a key on a form)
formStep : Widget.Key -> Model -> Form -> Widget.Step Model Result
formStep Escape m fm = leftForm m
formStep Enter m fm = entered m fm (formProblem fm)
formStep Tab m fm = case completedForm m.listing fm of
  Just done -> withForm m done
  Nothing -> withForm m (nextSlot 1 fm)
formStep ArrowDown m fm = withForm m (nextSlot 1 fm)
formStep BackTab m fm = withForm m (nextSlot (0 - 1) fm)
formStep ArrowUp m fm = withForm m (nextSlot (0 - 1) fm)
formStep k m fm = slotStep k m fm

-- | What a key makes of the app: on the list, or on the form open.
step : Widget.Key -> Model -> Widget.Step Model Result
step k m@{ form = Just fm } = formStep k m fm
step k m = listStep k m

-- Shown
--------------------------------------------------------------------------------

-- (a command's row on the list: its name, in a column as wide as the
-- longest, and what it does)
entryRow : Int -> Entry -> Widget.Row
entryRow w e =
  [Widget.bold (Widget.pad w e.name), Widget.plain "  ", Widget.dim e.doc]

-- (how the picked command is called, or why none is)
calledAs : Model -> Maybe Entry -> String
calledAs m (Just e) =
  m.prog
  ^ " "
  ^ e.name
  ^ (if List.null e.shape.pos && List.null e.shape.flags then ""
     else " " ^ CLI.synopsis e.shape)
calledAs m Nothing =
  "no command's name has `" ^ Widget.fieldText m.filter ^ "` in it"

-- (the filter's row, and the cursor in it, where it is being typed)
filterRow : Model -> Widget.Row
filterRow m =
  if m.typing
  then [Widget.plain "filter: ", Widget.plain (Widget.fieldText m.filter)]
  else [ Widget.dim
         "type to filter, ↑ ↓ or j k to move, Enter to fill one in, q to quit"
       ]

filterCursor : Model -> Maybe (Pair Int Int)
filterCursor m =
  if m.typing then Just (MkPair (8 + Widget.fieldCursor m.filter) 1)
  else Nothing

-- (the list of the commands, on a terminal of the size)
listView : Widget.Size -> Model -> Widget.Frame
listView size m =
  { rows =
      List.append
        (Widget.fill
           (size.rows - 1)
           ([Widget.bold m.prog, Widget.plain ": its commands"]
            :: filterRow m
            :: Nil
            :: Widget.menuRows
              (size.rows - 4)
              m.menu
              (List.map
                 (entryRow
                    (List.foldl
                       (\n (e : Entry) -> max n (Widget.width e.name))
                       0
                       (matching m)))
                 (matching m))))
        [Widget.status size.columns (calledAs m (picked m))]
  , cursor = filterCursor m
  }

-- (a field's label: a positional as a usage writes it, a flag its names
-- and the value it takes)
partLabel : Part -> String
partLabel (Positional p) = CLI.posWord p
partLabel (Flagged f) =
  (if strEq f.short "" then "" else "-" ^ f.short ^ ", ")
  ^ "--"
  ^ f.long
  ^ (if strEq f.meta "" then "" else "=" ^ f.meta)

-- (a value of a choice as shown: none, where it is left out)
optionShown : String -> String
optionShown v = if strEq v "" then "(none)" else v

-- (what a field takes, as its usage names it)
partHint : Part -> String
partHint (Positional p) = p.meta
partHint (Flagged f) = f.meta

-- (a field's input, as shown; an empty one not being filled in, what it
-- takes, dim)
inputRow : Bool -> Part -> Input -> Widget.Row
inputRow on part (Picked c) = Widget.choiceRow on optionShown c
inputRow on part (Typed t) =
  if not on && List.null t.text then [Widget.dim (partHint part)]
  else [Widget.plain (Widget.fieldText t)]

-- (a field's row: marked where it is being filled in)
slotRow : Int -> Bool -> Slot -> Widget.Row
slotRow w on s =
  (if on then Widget.bold "> " else Widget.plain "  ")
  :: Widget.plain (Widget.pad w (partLabel s.part))
  :: Widget.plain "  "
  :: inputRow on s.part s.input

slotRows : Int -> Int -> Int -> List Slot -> List Widget.Row
slotRows w at i [] = Nil
slotRows w at i (s :: ss) = slotRow w (i == at) s :: slotRows w at (i + 1) ss

-- (what a file or a word completes to, said)
completeSaid : CLI.Complete -> String
completeSaid (Files sfx) =
  if strEq sfx "" then "; a file" else "; a " ^ sfx ^ " file"
completeSaid Dirs = "; a directory"
completeSaid (Among ws) = "; one of " ^ joinWith ", " ws
completeSaid None = ""

-- (how many words a positional takes, said)
aritySaid : CLI.Arity -> String
aritySaid One = "one word, wanted"
aritySaid Optional = "one word, or none: the command's default"
aritySaid Many = "any number of words, split at spaces"
aritySaid Some = "one word or more, split at spaces"
aritySaid Rest = "the rest of the words, as they are, split at spaces"

-- (what a field takes, said)
partSaid : Part -> String
partSaid (Positional p) =
  p.meta ^ ": " ^ aritySaid p.arity ^ completeSaid p.complete
partSaid (Flagged f) =
  "--"
  ^ f.long
  ^ ": "
  ^ (if strEq f.doc "" then "" else f.doc ^ "; ")
  ^ (if strEq f.meta "" then "a switch, off or on (← → or space)"
     else if List.null f.values then "a value, typed; left empty, not given"
     else "one of " ^ joinWith ", " f.values ^ " (← → or space)")
  ^ (if f.required then "; wanted" else "")

-- (what the field being filled in takes, on lines of the width)
helpRows : Int -> Maybe Slot -> List Widget.Row
helpRows w (Just s) =
  List.map (\l -> [Widget.dim l]) (Widget.wrap w (partSaid s.part))
helpRows w Nothing = Nil

-- (the paths the field completes to, by their names, side by side on
-- lines of the width -- at most three -- and how many there are)
offeredRows : Int -> List String -> List Widget.Row
offeredRows w [] = Nil
offeredRows w ps =
  List.map
    (\l -> [Widget.plain l])
    (List.take
       3
       (Widget.wrap
          w
          (joinWith "  " (List.map nameOf ps)
           ^ "  (Tab: "
           ^ debug (List.length ps)
           ^ (if List.length ps == 1 then " path)" else " paths)"))))
  where
  nameOf : String -> String
  nameOf q =
    if endsWith "/" q then nameOf (strSlice q 0 (strLength q - 1)) ^ "/"
    else strSlice q (strLength (dirOf q)) (strLength q)

-- (what Esc does on a form: goes back, or leaves where the form is all
-- there is)
escSaid : Bool -> String
escSaid alone = if alone then "leave" else "back"

-- (what the form's status line says: what is wrong yet, or the keys)
formStatus : Bool -> Maybe CLI.Problem -> String
formStatus alone (Just p) =
  "not yet: " ^ CLI.problemSaid p ^ "  (Esc: " ^ escSaid alone ^ ")"
formStatus alone Nothing =
  "Enter: run it  ·  Tab ↑ ↓: another field  ·  Esc: " ^ escSaid alone

-- (where the cursor is shown: in the field being filled in, if words are
-- typed there)
formCursor : Int -> Int -> Form -> Maybe Slot -> Maybe (Pair Int Int)
formCursor top w fm (Just { input = Typed t }) =
  Just (MkPair (2 + w + 2 + Widget.fieldCursor t) (top + fm.at))
formCursor top w fm s = Nothing

-- (how wide the form's labels are: as its widest)
formLabels : Form -> Int
formLabels f =
  List.foldl
    (\n (s : Slot) -> max n (Widget.width (partLabel s.part)))
    0
    f.slots

-- (a form, on a terminal of the size)
formView : Widget.Size -> Model -> Form -> Widget.Frame
formView size m fm =
  { rows =
      List.append
        (Widget.fill
           (size.rows - 1)
           (List.append
              ([Widget.bold (m.prog ^ " " ^ fm.entry.name)]
               :: List.map
                 (\l -> [Widget.plain l])
                 (Widget.wrap size.columns fm.entry.doc))
              (Nil
               :: List.append
                 (slotRows (formLabels fm) fm.at 0 fm.slots)
                 (Nil
                  :: List.append
                    (helpRows size.columns (focused fm))
                    (List.append
                       (offeredRows size.columns (offered m.listing fm))
                       [ Nil
                       , [ Widget.plain "$ "
                         , Widget.bold
                           (commandLine m.prog fm.entry.name (formWords fm))
                         ]
                       ])))))
        [Widget.status size.columns (formStatus m.alone (formProblem fm))]
  , cursor =
      formCursor
        (List.length (Widget.wrap size.columns fm.entry.doc) + 2)
        (formLabels fm)
        fm
        (focused fm)
  }

-- | How the app is shown on a terminal of the size: the list, or the
-- | form open.
view : Widget.Size -> Model -> Widget.Frame
view size m@{ form = Just fm } = formView size m fm
view size m = listView size m

-- | The app: the commands of the program `prog`, to pick one of and fill
-- | in; what it comes to is the words of the command line made (the
-- | command's name first), or nothing, where it was left.
app : String -> List Entry -> Widget.App Model Result
app prog es = { start = start prog es, step = step, view = view }

-- | The app opened on the form, for what a command line lacks: as the
-- | app, but where it would go back to the list (Esc, `q` on a choice)
-- | it ends, with nothing.
prompt : String -> List Entry -> Form -> Widget.App Model Result
prompt prog es fm =
  { start = { start prog es | form = Just fm, alone = True }
  , step = step
  , view = view
  }

-- (the directory the path being typed in the form's field is in, where
-- the field is one of paths)
wantedDir : Model -> Maybe String
wantedDir { form = Just fm } = case focused fm of
  Just { part = p, input = Typed t } ->
    if completesPaths (partComplete p)
    then Just (dirOf (lastWord (Widget.fieldText t)))
    else Nothing
  s -> Nothing
wantedDir m = Nothing

-- (a directory's names, a directory's with a `/` after it; none where
-- it cannot be read)
namesIn : {e : HFunctor}
        -> {{disk : filesystem <: e}}
        -> String
        -> Co e (List String)
namesIn d = do
  read <-
    attempt
      FileError
      (readDirectory
         (ev := _)
         (ex := _)
         (Path.parse (if strEq d "" then "." else d)))
  case read of
    Left err -> pure Nil
    Right ps -> named ps
  where
  named : List Path.Path -> Co e (List String)
  named [] = pure Nil
  named (q :: qs) = do
    dir <- isDirectory q
    rest <- named qs
    pure ((Path.basename q ^ (if dir then "/" else "")) :: rest)

-- (it is listed already)
listedAs : String -> Maybe Listing -> Bool
listedAs d (Just l) = strEq l.dir d
listedAs d Nothing = False

-- | The app's state with the directory listed that the path being typed
-- | in the form's field is in (what Tab completes it to, and what is
-- | shown under it), where it is not yet: for `Terminal.interactWith`
-- | to give each state the app comes to.
listed : {e : HFunctor} -> {{disk : filesystem <: e}} -> Model -> Co e Model
listed m = case wantedDir m of
  Just d ->
    if listedAs d m.listing then pure m
    else do
      names <- namesIn d
      pure { m | listing = Just { dir = d, names = names } }
  Nothing -> pure m
