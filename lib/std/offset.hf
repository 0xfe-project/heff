-- Offsets from UTC: how far a clock on the wall is ahead of UTC, or
-- behind it, fixed -- +08:00 in Taipei all year round, -05:00 in New
-- York in winter -- in whole seconds, within 18 hours either way.
-- NodaTime's `Offset` is the model.  An offset is no time zone: a zone
-- has rules for which offset it is at when, and an offset has none.  A
-- std.localdatetime at an offset is an instant, a std.offsetdatetime.
-- Import it by a name, `import std.offset as Offset`, as its names are
-- short.
--
-- ```haskell
-- import std.offset as Offset
--
-- -- | the offset of India
-- -- | >>> maybe "" toString india
-- -- | "+05:30"
-- india : Maybe Offset.Offset
-- india = Offset.fromHoursAndMinutes 5 30
-- ```

module std.offset
  ( Offset
  , utc
  , fromSeconds
  , fromHours
  , fromHoursAndMinutes
  , totalSeconds
  , toDuration
  , parse
  , instanceEqualityOffset
  , instanceOrderOffset
  , instanceShowOffset
  , instanceToStringOffset
  )

import std.duration as Duration

-- | An offset: its seconds ahead of UTC, -64800 to 64800, fewer than
-- | none for one behind it.
data Offset = MkOffset Int

-- | UTC's own: none.
utc : Offset
utc = MkOffset 0

-- | The offset `n` seconds ahead of UTC, behind it for fewer than none,
-- | if it is within 18 hours (64800 seconds) either way; nothing if not.
-- | >>> List.map fromSeconds [0, 64800, -64800, 64801, -64801]
-- | [Just (MkOffset 0), Just (MkOffset 64800), Just (MkOffset (-64800)), Nothing, Nothing]
fromSeconds : Int -> Maybe Offset
fromSeconds n = if n < -64800 || n > 64800 then Nothing else Just (MkOffset n)

-- | The offset `n` hours ahead of UTC, behind it for fewer than none,
-- | if it is within 18 either way; nothing if not.
-- | >>> List.map fromHours [8, -5, 18, -18, 19]
-- | [Just (MkOffset 28800), Just (MkOffset (-18000)), Just (MkOffset 64800), Just (MkOffset (-64800)), Nothing]
fromHours : Int -> Maybe Offset
fromHours n = fromSeconds (n * 3600)

-- | The offset the hours and minutes ahead of UTC, the minutes 0 to 59
-- | taking the hours' sign: `fromHoursAndMinutes (-3) 30` is -03:30, 3
-- | hours and 30 minutes behind.  Of the minutes, their size is taken
-- | and their own sign is not, but where the hours are 0: so
-- | `fromHoursAndMinutes (-3) (-30)` is -03:30 too, as NodaTime has it,
-- | `fromHoursAndMinutes 3 (-30)` is +03:30, and
-- | `fromHoursAndMinutes 0 (-30)` is -00:30.  Nothing for minutes beyond
-- | 59 either way, or an offset beyond 18 hours.
-- | >>> List.map (\p -> fromHoursAndMinutes (fst p) (snd p)) [(5, 30), (-3, 30), (-3, -30), (3, -30), (0, -30), (0, 45)]
-- | [Just (MkOffset 19800), Just (MkOffset (-12600)), Just (MkOffset (-12600)), Just (MkOffset 12600), Just (MkOffset (-1800)), Just (MkOffset 2700)]
-- | >>> List.map (\p -> fromHoursAndMinutes (fst p) (snd p)) [(18, 0), (-18, 0), (18, 1), (-17, 60), (1, -60)]
-- | [Just (MkOffset 64800), Just (MkOffset (-64800)), Nothing, Nothing, Nothing]
fromHoursAndMinutes : Int -> Int -> Maybe Offset
fromHoursAndMinutes h m =
  if abs m > 59 then Nothing
  else if h < 0 || h == 0 && m < 0
  then fromSeconds (0 - (abs h * 3600 + abs m * 60))
  else fromSeconds (h * 3600 + abs m * 60)

-- | Its seconds ahead of UTC, fewer than none for one behind it.
totalSeconds : Offset -> Int
totalSeconds (MkOffset n) = n

-- | How far ahead of UTC it is, as a duration.
-- | >>> maybe "" (\o -> toString (toDuration o)) (fromHoursAndMinutes (-9) 30)
-- | "-9h30m0s"
toDuration : Offset -> Duration.Duration
toDuration (MkOffset n) = Duration.seconds n

-- Instances: the prelude's operators and functions at `Offset`
--------------------------------------------------------------------------------

-- | The same offset.
instance instanceEqualityOffset : Equality Offset
instanceEqualityOffset = { equal = \x y -> totalSeconds x == totalSeconds y }

-- | The one farther behind UTC first, as NodaTime orders them: -05:00
-- | before Z before +08:00.
-- | >>> fromHours (-5) < Just utc && Just utc < fromHours 8
-- | True
instance instanceOrderOffset : Order Offset
instanceOrderOffset =
  orderByCompare (\x y -> compare (totalSeconds x) (totalSeconds y))

-- (the offset as ISO 8601 writes it: `Z`, or its sign, hours and
-- minutes, and its seconds only where it has some)
isoText : Offset -> String
isoText (MkOffset n) =
  if n == 0 then "Z"
  else (if n < 0 then "-" else "+")
    ^ padded 2 (abs n / 3600)
    ^ ":"
    ^ padded 2 (abs n / 60 % 60)
    ^ (if abs n % 60 == 0 then "" else ":" ^ padded 2 (abs n % 60))
  where
  -- (`k`, at least 0, in decimal, with `0`s before it to `width` digits)
  padded : Int -> Int -> String
  padded width k =
    joinWith "" (List.replicate (width - strLength (showInt k)) "0") ^ showInt k

-- | As `toString` writes it, `+08:00`.
-- | >>> show utc
-- | "Z"
instance instanceShowOffset : Show Offset
instanceShowOffset = { show = isoText }

-- | As ISO 8601 writes it: `Z` for none, else its sign, hours and
-- | minutes, `+08:00`, `-09:30`, and the seconds of one that is not
-- | whole minutes after them, `+05:30:15`.
-- | >>> List.map (\n -> maybe "" toString (fromSeconds n)) [0, 28800, -34200, 19815, -64800, -1]
-- | ["Z", "+08:00", "-09:30", "+05:30:15", "-18:00", "-00:00:01"]
instance instanceToStringOffset : ToString Offset
instanceToStringOffset = { toString = isoText }

-- | The offset RFC 3339 writes as `s`: `Z` (or `z`) for UTC, or a sign,
-- | the hours 00 to 18 and the minutes 00 to 59, `+08:00`, `-09:30`,
-- | within 18 hours either way; `-00:00` is UTC.  Nothing if it writes
-- | none, or one beyond 18 hours.
-- | >>> List.map (\s -> maybe "" toString (parse s)) ["Z", "z", "+08:00", "-09:30", "+18:00", "-18:00", "-00:00"]
-- | ["Z", "Z", "+08:00", "-09:30", "+18:00", "-18:00", "Z"]
-- | >>> (List.map (\s -> maybe True (\_ -> False) (parse s)) ["+18:01", "-19:00", "+08:60", "+0800", "08:00", "+8:00", "+08:00:00", "UTC", ""] : List Bool)
-- | [True, True, True, True, True, True, True, True, True]
-- | >>> List.all (\n -> maybe False (\o -> parse (toString o) == Just o) (fromSeconds n)) [0, 28800, -34200, 64800, -64800]
-- | True
parse : String -> Maybe Offset
parse s =
  if strEq s "Z" || strEq s "z" then Just utc
  else if strLength s /= 6 || not (strEq (strSlice s 3 4) ":")
  then Nothing
  else (case (digitsIn 1 3, digitsIn 4 6) of
        (Just h, Just m) ->
          if m > 59 then Nothing
          else if strEq (strSlice s 0 1) "+"
          then fromSeconds (h * 3600 + m * 60)
          else if strEq (strSlice s 0 1) "-"
          then fromSeconds (0 - (h * 3600 + m * 60))
          else Nothing
        _ -> Nothing)
  where
  -- (the decimal the bytes of `s` from `from` to `to` are, if they are
  -- all digits)
  digitsIn : Int -> Int -> Maybe Int
  digitsIn from to =
    if foldBytes (\ok c -> ok && 48 <= c && c <= 57) True (strSlice s from to)
    then parseInt (strSlice s from to)
    else Nothing
