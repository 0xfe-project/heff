-- The DOM world as an effect (lib/co.hf): its operations, each taking
-- the evidence that the DOM is in the program's effect (as
-- lib/state.hf's `get` does).  `heff compile --backend=page` compiles a
-- computation of this world -- `Co dom Unit`, or a sum of worlds -- to a
-- script for a page, each world's algebra from its provider (dom.provider.js).

import co
import std.handle

-- | What an element of the page is, as the kind of a handle
-- | (`Handle Element`, std.handle): no value has it.
data Element

-- | An element of the page: the world's handle of it, which another
-- | effect's provider can take -- a `<canvas>` found here, drawn on by a
-- | GPU's.  (An app only gets nodes from the operations -- it makes
-- | them, or finds them on the page, `select` and `xpath`: where it goes
-- | on the page is the app's to say.)
type Node = Handle Element

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`); `On` takes a computation, run at each event
data DomF (m : Type -> Type) x
  = Create String (Node -> x)
  | Text Node String x
  | Attr Node String String x
  | Append Node Node x
  | Clear Node x
  | Value Node (String -> x)
  | On Node String (String -> m Unit) x
  | Select String (Maybe Node -> x)
  | XPath String (Maybe Node -> x)
  | Sleep Int x
  | Fetch String (String -> x)

-- | The DOM as an effect.
dom : HFunctor
dom =
  { f = DomF
  , hfmap = \fm g p -> case p of
      Create t k -> Create t (\n -> g (k n))
      Text n str x -> Text n str (g x)
      Attr n a v x -> Attr n a v (g x)
      Append p c x -> Append p c (g x)
      Clear n x -> Clear n (g x)
      Value n k -> Value n (\v -> g (k v))
      On n e h x -> On n e h (g x)
      Select q k -> Select q (\n -> g (k n))
      XPath q k -> XPath q (\n -> g (k n))
      Sleep ms x -> Sleep ms (g x)
      Fetch url k -> Fetch url (\t -> g (k t))
  , hmap = \nt p -> case p of
      Create t k -> Create t k
      Text n str x -> Text n str x
      Attr n a v x -> Attr n a v x
      Append p c x -> Append p c x
      Clear n x -> Clear n x
      Value n k -> Value n k
      On n e h x -> On n e (\v -> nt (h v)) x
      Select q k -> Select q k
      XPath q k -> XPath q k
      Sleep ms x -> Sleep ms x
      Fetch url k -> Fetch url k
  }

create : {e : HFunctor} -> {{ev : dom <: e}} -> String -> Co e Node
create tag = op (ev (Create tag (\n -> n))) val

text : {e : HFunctor} -> {{ev : dom <: e}} -> Node -> String -> Co e Unit
text n str = op (ev (Text n str MkUnit)) val

attr : {e : HFunctor}
     -> {{ev : dom <: e}}
     -> Node
     -> String
     -> String
     -> Co e Unit
attr n a v = op (ev (Attr n a v MkUnit)) val

append : {e : HFunctor} -> {{ev : dom <: e}} -> Node -> Node -> Co e Unit
append parent child = op (ev (Append parent child MkUnit)) val

clear : {e : HFunctor} -> {{ev : dom <: e}} -> Node -> Co e Unit
clear n = op (ev (Clear n MkUnit)) val

value : {e : HFunctor} -> {{ev : dom <: e}} -> Node -> Co e String
value n = op (ev (Value n (\v -> v))) val

on : {e : HFunctor}
   -> {{ev : dom <: e}}
   -> Node
   -> String
   -> (String -> Co e Unit)
   -> Co e Unit
on n event h = op (ev (On n event h MkUnit)) val

-- | The first element of the page a CSS selector matches (`#out`,
-- | `ul > li.done`), if one does.
select : {e : HFunctor} -> {{ev : dom <: e}} -> String -> Co e (Maybe Node)
select q = op (ev (Select q (\n -> n))) val

-- | The first element of the page an XPath matches
-- | (`//button[text()='Go']`), if one does.
xpath : {e : HFunctor} -> {{ev : dom <: e}} -> String -> Co e (Maybe Node)
xpath q = op (ev (XPath q (\n -> n))) val

-- | Go on with an element, if it was found.
found : {e : HFunctor} -> Maybe Node -> (Node -> Co e Unit) -> Co e Unit
found Nothing _ = pure MkUnit
found (Just n) k = k n

-- | Wait: in the page, the rest runs when the time has passed.
sleep : {e : HFunctor} -> {{ev : dom <: e}} -> Int -> Co e Unit
sleep ms = op (ev (Sleep ms MkUnit)) val

fetchText : {e : HFunctor} -> {{ev : dom <: e}} -> String -> Co e String
fetchText url = op (ev (Fetch url (\t -> t))) val

-- an element with some text in it, put in a parent
textIn : {e : HFunctor}
       -> {{ev : dom <: e}}
       -> Node
       -> String
       -> String
       -> Co e Node
textIn parent tag str = do
  n <- create tag
  text n str
  append parent n
  pure n
