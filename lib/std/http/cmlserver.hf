-- An HTTP/1.1 server of many connections at once, on cml's threads: a
-- listener's connections each served by a thread of its own, by
-- std.http.server's `serveConnection`, the others served meanwhile.
-- Run under cml's `threadsWithReactor`, each thread waits on its
-- socket apart, in its domain's reactor; under `scheduled`, a thread
-- that waits holds its domain until it is done.  It is the C backend's
-- alone, as std.net is.  Import it by a name, `import
-- std.http.cmlserver as CmlServer`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import cml as CML
-- import co
-- import std.domain as Domain
-- import std.http as HTTP
-- import std.http.cmlserver as CmlServer
-- import std.http.server as Server
-- import std.net as Net
-- import std.reactor as Reactor
-- import std.signal as Signal
-- import resource
--
-- hello : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
-- hello r = pure (Server.plain 200 ("hello, " ^ r.target ^ "\n"))
--
-- -- | `hello` served on the listener, each connection a thread of its
-- -- | own, until one cannot be accepted, or until SIGTERM or Ctrl-C
-- served : {e w : HFunctor}
--        -> {s : Type}
--        -> {{cm : CML.cml w <: e}}
--        -> {{nt : Net.net <: w}}
--        -> {{sg : Signal.signals <: e}}
--        -> With s Net.TcpListener
--        -> Co e Unit
-- served l =
--   CML.choose
--     [ CmlServer.serve Empty l hello
--     , bind (Signal.wait [Terminate, Interrupt]) (\s -> pure ())
--     ]
--
-- -- | on port 8080, the threads run on the program's world itself, each
-- -- | waiting on the world through its domain's reactor
-- main : Co (Net.net <+> Reactor.reactor <+> Domain.domain <+> Signal.signals) Unit
-- main = do
--   r <-
--     Net.withListener
--         { host = "127.0.0.1", port = 8080 }
--         128
--         (\l -> CML.scheduledWithReactor (served l))
--   pure ()
-- ```
--
-- One thread accepts, in a loop: each connection accepted is given a
-- thread of its own, which serves it and closes it as it ends, and the
-- loop goes on to accept the next.  A connection's thread is of cml's
-- world, `cml w <+> custodian <+> w`, as every thread is, so the
-- handler is too, with what it may throw, an `err` (`Empty` where it throws nothing): a throw
-- no `recover` of the handler's hears closes that connection at once,
-- unanswered, what was thrown let go of -- a handler that is to say why
-- catches it itself -- and the others are served on.  A connection whose
-- client sends nothing for `idle` milliseconds -- 30 seconds unless
-- another is given, by name, `CmlServer.serve (idle := 5000) l
-- handle`; 0 for no limit -- is closed, its thread done.  Where a
-- connection cannot be accepted (the program out of descriptors,
-- `EMFILE`; the listener closed, `EBADF`) the server stops: `serve`
-- comes back, the connections being served going on, the listener left
-- as it is.  `serve` comes back at a base event of cml's, so it is
-- stopped otherwise by a `choose`: beside std.signal's `wait`, as
-- above, at the signal -- the listener closed as its `with` ends, and
-- the connections being served dropped with the other threads as main
-- ends.

module std.http.cmlserver (serve)
import cml as CML
import co
import custodian as Custodian
import exception
import std.http as HTTP
import std.http.server as Server
import std.net as Net
import resource

-- (a connection served, then closed: the handler's throws heard here,
-- each a thread's own -- where it throws, the connection is closed at
-- once, what it threw let go of)
servedOn : {w : HFunctor}
         -> {s : Type}
         -> {err : Type}
         -> {{nt : Net.net <: w}}
         -> Int
         -> (Server.Request
             -> Co
               (exception err <+> (CML.cml w <+> Custodian.custodian <+> w))
               HTTP.Response)
         -> With s Net.TcpStream
         -> Co (CML.cml w <+> Custodian.custodian <+> w) Unit
servedOn idle handle c = do
  _ <-
    attempt
      err
      (Server.serveConnection
         (idle := idle)
         (\r -> False)
         handle
         c)
  _ <- Net.close c
  pure ()

-- (the listener's connections accepted, one after another, each served
-- by a thread of its own; where accepting failed, `stop`)
acceptor : {w : HFunctor}
         -> {s : Type}
         -> {err : Type}
         -> {{nt : Net.net <: w}}
         -> Co (CML.cml w <+> Custodian.custodian <+> w) Unit
         -> Int
         -> With s Net.TcpListener
         -> (Server.Request
             -> Co
               (exception err <+> (CML.cml w <+> Custodian.custodian <+> w))
               HTTP.Response)
         -> Co (CML.cml w <+> Custodian.custodian <+> w) Unit
acceptor stop idle l handle = do
  r <- Net.accepted l
  case r of
    Left why -> stop
    Right c -> do
      CML.spawn (servedOn idle handle c)
      acceptor stop idle l handle

-- | The listener's connections served at once, each by a cml thread of
-- | its own (`Server.serveConnection`), spawned by one thread accepting
-- | them in a loop, and closed as it is served.  Until one fails to be
-- | accepted: the listener left as it is, the connections being served
-- | going on.  A connection whose client sends nothing for `idle`
-- | milliseconds is closed, its thread done.  The handler runs in its
-- | connection's thread, in the scheduler's world, and may throw an
-- | `err` (`Empty` for one that throws nothing): that connection is
-- | closed at once, unanswered, and what was thrown let go of; the
-- | others go on.
serve : {e w : HFunctor}
      -> {s : Type}
      -> {idle : Int := 30000}
      -> (err : Type)
      -> {{cm : CML.cml w <: e}}
      -> {{nt : Net.net <: w}}
      -> With s Net.TcpListener
      -> (Server.Request
          -> Co
            (exception err <+> (CML.cml w <+> Custodian.custodian <+> w))
            HTTP.Response)
      -> Co e Unit
serve err l handle = do
  stopped <- CML.newIVar
  CML.spawn (acceptor (CML.putIVar stopped ()) idle l handle)
  CML.readIVar stopped
