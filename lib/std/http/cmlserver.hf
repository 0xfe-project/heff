-- An HTTP/1.1 server of many connections at once, on cml's threads: a
-- listener's connections each served by a thread of its own, by
-- std.http.server's `serveConnection`, the others served meanwhile.
-- Run under cml's `threadsWithReactor`, each thread waits on its
-- socket apart, in its domain's reactor; under `scheduled`, a thread
-- that waits holds its domain until it is done.  It is the C backend's
-- alone, as std.net is.  Import it by a name, `import
-- std.http.cmlserver as CmlServer`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import cml as CML
-- import co
-- import exception
-- import std.domain as Domain
-- import std.http as HTTP
-- import std.http.cmlserver as CmlServer
-- import std.http.server as Server
-- import std.net as Net
-- import std.reactor as Reactor
-- import std.signal as Signal
--
-- hello : {e : HFunctor} -> Server.Request -> Co e HTTP.Response
-- hello r = pure (Server.plain 200 ("hello, " ^ r.target ^ "\n"))
--
-- -- | `hello` served on the port, each connection a thread of its own,
-- -- | until one cannot be accepted, or until SIGTERM or Ctrl-C
-- helloAt : {e w : HFunctor}
--         -> {{cm : CML.cml w <: e}}
--         -> {{nt : Net.net <: e}}
--         -> {{sg : Signal.signals <: e}}
--         -> {{ex : exception Net.NetError <: e}}
--         -> Int
--         -> Co e Unit
-- helloAt port =
--   Net.withListener
--       { host = "127.0.0.1", port = port }
--       128
--       (\l -> CML.choose
--          [ CmlServer.serve l hello
--          , bind (Signal.wait [Terminate, Interrupt]) (\s -> pure ())
--          ])
--
-- -- | the threads run, each waiting on the world through its domain's
-- -- | reactor
-- main : Co (Net.net <+> Reactor.reactor <+> Domain.domain <+> Signal.signals) Unit
-- main = do
--   with _ := CML.threadsWithReactor do
--     attempt
--       Net.NetError
--       (helloAt
--          (w := Net.net <+> Reactor.reactor <+> Domain.domain <+> Signal.signals)
--          8080)
--   pure ()
-- ```
--
-- A connection is had by `Net.accept`'s body in its thread, and closed
-- as that thread ends; the body first spawns the thread that accepts
-- the next, so one is always waiting to accept.  A connection whose
-- client sends nothing for `idle` milliseconds -- 30 seconds unless
-- another is given, by name, `CmlServer.serve (idle := 5000) l
-- handle`; 0 for no limit -- is closed, its thread done.  Where a
-- connection cannot be accepted (the program out of descriptors,
-- `EMFILE`; the listener closed, `EBADF`) the server stops: `serve`
-- comes back, the connections being served going on, the listener left
-- as it is.  `serve` comes back at a base event of cml's, so it is
-- stopped otherwise by a `choose`: beside std.signal's `wait`, as
-- above, at the signal -- the listener closed as its `with` ends, and
-- the connections being served dropped with the other threads as main
-- ends.

module std.http.cmlserver (serve)
import cml as CML
import co
import exception
import std.http as HTTP
import std.http.server as Server
import std.net as Net
import resource

-- (a thread spawned from where `Net.NetError` is thrown: spawned in
-- `e`, with a handler of its own for what it throws, which lets it go
-- -- not under a handler of the spawning thread's, which the thread
-- after it would be under too, and so on, each connection's thread
-- under one more)
spawnedApart : {e w : HFunctor}
             -> {{cm : CML.cml w <: e}}
             -> Co (exception Net.NetError <+> e) Unit
             -> Co (exception Net.NetError <+> e) Unit
spawnedApart c =
  lift
    (h := e)
    (inj := _)
    (CML.spawn (bind (attempt Net.NetError c) (\r -> pure ())))

-- (a thread accepting the listener's next connection: a thread spawned
-- by `apart` to accept the one after it, then the connection served,
-- and closed as the thread ends; where accepting failed, `stop`.  The
-- throw is heard in this thread, by a `recover` of its own -- not by a
-- `try` of the scheduler's caller, which would run the body alone, its
-- spawn dropped)
acceptor : {e : HFunctor}
         -> {s : Type}
         -> {{nt : Net.net <: e}}
         -> {{ex : exception Net.NetError <: e}}
         -> (Co e Unit -> Co e Unit)
         -> Co e Unit
         -> Int
         -> With s Net.TcpListener
         -> (Server.Request -> Co e HTTP.Response)
         -> Co e Unit
acceptor apart stop idle l handle =
  recover
    (Net.accept l (\c -> do
     apart (acceptor apart stop idle l handle)
     _ <- Server.serveConnection (idle := idle) (\r -> False) handle c
     pure ()))
    (\(err : Net.NetError) -> stop)

-- | The listener's connections served at once, each by a cml thread of
-- | its own (`Server.serveConnection`): the connection is had by
-- | `Net.accept`'s body in that thread, closed as it ends, and the body
-- | spawns the thread accepting the next, so that one is always waiting
-- | to accept.  Until one fails to be accepted: the listener left as it
-- | is, the connections being served going on.  A connection whose
-- | client sends nothing for `idle` milliseconds is closed, its thread
-- | done.
serve : {e w : HFunctor}
      -> {s : Type}
      -> {idle : Int := 30000}
      -> {{cm : CML.cml w <: e}}
      -> {{nt : Net.net <: e}}
      -> With s Net.TcpListener
      -> (Server.Request -> Co e HTTP.Response)
      -> Co e Unit
serve l handle = do
  stopped <- CML.newIVar
  CML.spawn
      (bind
         (attempt
            Net.NetError
            (acceptor
               (e := exception Net.NetError <+> e)
               (nt := _)
               (ex := _)
               (spawnedApart (e := e) (cm := cm))
               (lift (h := e) (inj := _) (CML.putIVar stopped ()))
               idle
               l
               (\r -> lift (inj := _) (handle r))))
         (\r -> pure ()))
  CML.readIVar stopped
