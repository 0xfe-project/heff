-- For an HTTP/1.1 server on boc's behaviours: a listener's connections
-- served at once, as many as come, each step of each a behaviour, and
-- every wait (an accept, a read, a write) an act awaited (`BOC.await`),
-- so no thread and no cown is held while a client is slow.  Each act
-- waits in the reactor of a thread of the program's pool of boc's, and
-- the connections are served in parallel on as many threads as the
-- machine has cores.  It is the C backend's alone, as std.net is.
-- Import it by a name, `import std.http.bocserver as BocServer`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import boc as BOC
-- import co
-- import exception
-- import std.http as HTTP
-- import std.http.bocserver as BocServer
-- import std.net as Net
-- import std.signal as Signal
-- import std.time as Time
-- import resource
--
-- -- | each request answered at once
-- hello : {e : HFunctor}
--       -> {{bc : BOC.boc <: e}}
--       -> HTTP.ServerRequest
--       -> BocServer.Responder e Empty
--       -> Co (exception Empty <+> e) Unit
-- hello r respond = respond (Whole (HTTP.plain 200 ("hello, " ^ r.target ^ "\n")))
--
-- -- | the listener served until SIGTERM or Ctrl-C: then closed, the
-- -- | requests in hand answered, and every connection closed
-- served : {e : HFunctor}
--        -> {s : Type}
--        -> {{bc : BOC.boc <: e}}
--        -> {{nt : Net.net <: e}}
--        -> {{clock : Time.time <: e}}
--        -> {{sg : Signal.signals <: e}}
--        -> With s Net.TcpListener
--        -> Co e Unit
-- served l = do
--   BocServer.serve Empty l (hello (e := e))
--   with _ := BOC.await (Signal.wait [Terminate, Interrupt]) do
--     _ <- Net.closeListener l
--     pure ()
--
-- -- | served on port 8080, done once its behaviours are
-- helloServed : Co (BOC.boc <+> Net.net <+> Time.time <+> Signal.signals) Unit
-- helloServed = do
--   r <-
--     Net.withListener
--         { host = "127.0.0.1", port = 8080 }
--         128
--         served
--   pure ()
-- ```
--
-- `serve err l handle` comes back at once, the server running in its
-- behaviours: the listener, held by its `with`, is let go of by the
-- last of the server's acts to hold it, once the server is done; the
-- program ends then, if nothing else is pending.  A connection is had by
-- std.net's `accepted`, in the listener's region, and closed by the
-- server: when its client ends it or fails, when a request asks
-- (HTTP/1.0, `Connection: close`), or when the server stops.
--
-- A connection is an inbox, the side that reads, and an outbox, the
-- side that writes, two cowns; and each request, from its first byte
-- read until its answer is written to its end, an exchange, a cown of
-- its own.  Where the connection is, is which behaviour comes next on
-- it.  A read awaited comes back as a behaviour on the inbox, which
-- takes the bytes as far as they go and awaits the next read, until the
-- request is all read; then it hands it to the handler, with a
-- responder.  The responder answers by a behaviour on the exchange and
-- the outbox at once, from whichever world it is called in: there and
-- then, or later, from another behaviour -- after acts of the handler's
-- own awaited, a request of std.http, a query -- the connection
-- meanwhile read no further.  An act the handler awaits is of its
-- world, its `with`'s (boc's `await`), an `attempt`'s around it too.
-- Its first answer is taken; one after it is not.  A handler that never
-- responds leaves its connection open until the program lets go of it.
--
-- The outbox holds bytes to write, and what is to be done once those
-- before it are written, in order; its writer, a behaviour of the
-- server's world, waits there (`once`) for something to write.  It
-- writes what the socket takes at once, there; the rest by a write it
-- awaits, whose behaviour, once it is done, does what was to be done
-- after it.  One write is awaited at a time, for the behaviours after
-- writes awaited come in the order the writes are done; what is put in
-- the outbox meanwhile waits for it, but for more than the most, which
-- closes the connection at once.  What comes after an answer written --
-- the next request read, on the inbox -- is the server's, not the
-- handler's, so the handler's `attempt`, around its behaviours, is not
-- around the next request's.
--
-- An answer is one of three.  A response, whole (`Whole`).  A stream
-- (`Streamed`): a status and headers, written at once -- in chunks to
-- HTTP/1.1, `Transfer-Encoding: chunked`; to HTTP/1.0, no length, the
-- connection closed at the end; to a `HEAD`, or of a status with no body,
-- the head alone -- then a body sent a piece at a time by a sender.  Or
-- the connection taken for WebSocket (`Upgraded`): the request checked
-- as std.http.websocket's `handshake` checks it, answered by its refusal
-- where it is refused, else by `101 Switching Protocols`, then messages
-- both ways.  A stream's or a socket's handler is given its sender in
-- `opened`, once the head is written: a value -- no region in its type
-- -- kept anywhere, in a cown of the handler's beside others, and sent
-- by from any behaviour (`send`), each piece a behaviour on its exchange
-- and the outbox, written after the ones before it, never waited for by
-- the sender.  `finish` ends a stream: its last chunk written, the
-- connection is read on for the next request; the sender, its
-- exchange's, sends nothing after.  A socket's sender sends messages,
-- each written as a frame; its `finish` closes it, `1000`.
--
-- ```haskell
-- import boc as BOC
-- import bytes as Bytes
-- import co
-- import exception
-- import std.http as HTTP
-- import std.http.bocserver as BocServer
-- import std.http.sse as SSE
-- import std.http.websocket as WebSocket
-- import std.ordmap as OrdMap
--
-- -- | the senders of the event streams open, by their numbers
-- type Hub = BOC.Cown (OrdMap.OrdMap Int (BocServer.Sender Bytes))
--
-- -- | an event sent on each of them
-- told : {f : HFunctor}
--      -> {{bc : BOC.boc <: f}}
--      -> Bytes
--      -> List (Pair Int (BocServer.Sender Bytes))
--      -> Co f Unit
-- told b [] = pure ()
-- told b (MkPair n out :: rest) = do
--   BocServer.send out b
--   told b rest
--
-- -- | a stream kept in the hub
-- joined : {f : HFunctor} -> {{bc : BOC.boc <: f}} -> Hub -> BocServer.Sender Bytes -> Co f Unit
-- joined hub out = do
--   with h := hub do
--     h := OrdMap.insert h (BocServer.senderNumber out) out
--
-- -- | a stream gone, taken out of the hub
-- left : {f : HFunctor} -> {{bc : BOC.boc <: f}} -> Hub -> BocServer.Sender Bytes -> Co f Unit
-- left hub out = do
--   with h := hub do
--     h := OrdMap.delete h (BocServer.senderNumber out)
--
-- -- | `/events`, a stream of events, kept in the hub until it is gone;
-- -- | `/say`, its body an event to every stream there; `/echo`, a
-- -- | socket, each message sent back
-- chat : {e : HFunctor}
--      -> {{bc : BOC.boc <: e}}
--      -> Hub
--      -> HTTP.ServerRequest
--      -> BocServer.Responder e Empty
--      -> Co (exception Empty <+> e) Unit
-- chat hub r respond =
--   if r.target == "/events"
--   then respond
--       (Streamed
--          { status = 200, headers = SSE.headers }
--          { opened = joined hub, gone = left hub })
--   else if r.target == "/say"
--   then do
--     with h := hub do
--       told (SSE.event [Data (Bytes.asString r.body)]) (OrdMap.toList h)
--     respond (Whole (HTTP.plain 200 "said\n"))
--   else if r.target == "/echo"
--   then respond
--       (Upgraded
--          { opened = \out -> pure ()
--          , received = \out m -> BocServer.send out m
--          , gone = \out -> pure ()
--          })
--   else respond (Whole (HTTP.plain 404 "no such page\n"))
-- ```
--
-- Once the client is gone -- a write failed, its end read, its
-- socket closed -- the connection is closed, a sender's `send` does
-- nothing, and the handler's `gone` is called, once, on its exchange:
-- so a hub of senders takes it out.  A stream's `gone` is not called
-- once it is finished; a socket's is, at its end, whyever it ends.  What
-- is sent and not yet written, on a connection, is `pending` bytes at
-- most -- a mebibyte unless another is given, by name, `BocServer.serve
-- (pending := 65536) err l handle`; 0 for no limit -- past which the
-- connection is closed, its client too slow, and `gone` called: a sender
-- is never made to wait.  A stream's connection is read while it goes
-- on, a piece at a time: where the client closes it, it is gone at once,
-- not at the next write.  What the client sends then is the next
-- request's, kept for after the stream, the connection read no further;
-- else the read waiting when the stream is finished is the next
-- request's.
--
-- A stream of server-sent events (its `Content-Type`
-- `text/event-stream`, std.http.sse's `headers`) is sent a comment, `:`,
-- after every `heartbeat` milliseconds of the client's silence where
-- nothing else was sent since the last -- 15 seconds unless another is
-- given, by name; 0 for none -- which keeps it from being taken for a
-- dead one by what is between, and tells the server soon after the
-- client has gone, as its write fails.
--
-- A socket's frames are read an act at a time, each read's bytes given
-- to std.http.websocket's `feed`: each message of text or of bytes the
-- client sends is given to the handler's `received` with the sender, in
-- the order sent, by the behaviour that read it.  A ping is answered by
-- a pong; a close by a close, the same code, then the connection closed
-- once it is written; a frame that breaks the protocol by a close of the
-- code `feed` says, then the same.  A socket is not held to `idle`:
-- where its client is silent for `ping` milliseconds -- 30 seconds
-- unless another is given, by name; 0 for none -- it is sent a ping,
-- and, silent for as long again, closed.  A close sent by the handler
-- (`finish`, or a `CloseMessage` sent) is answered by the client's, and
-- the connection closed then, or after `ping` milliseconds.  `opened`,
-- `received` and `gone` run in the server's world, as the handler does:
-- one that throws an `err` closes its connection.
--
-- Requests are read as std.http reads them, by its `requestIn`, a piece
-- at a time, each piece an act: a body by `Content-Length`, or sent in
-- chunks, each piece read undone as it comes, a `100 Continue` written
-- where the client waits for one, a request refused as std.http refuses
-- it (`400`, `413`, `431`, `501`, `505`), what the client still sends
-- then read, up to a mebibyte, and let go of before its connection is
-- closed.  Requests sent one after another on a connection without
-- waiting (pipelined) are answered in turn.  A connection whose client
-- sends nothing for `idle` milliseconds -- 30 seconds unless another is
-- given, by name, `BocServer.serve (idle := 5000) l handle`; 0 for no
-- limit -- is closed, within a request or between two; a response not
-- taken in that time too, a piece of a stream or a frame of a socket
-- too.  A client sending a request's head a little at a time is held to
-- `headerWithin` milliseconds for the whole head -- 30 seconds unless
-- another is given, by name; 0 for no limit -- counted from the
-- connection's accept, or from the response before it: past that, the
-- connection is closed, unanswered.  The time is std.time's monotonic
-- clock, so the server's world has `time`.  A head's end is looked for
-- in each piece only as it is read, with the three bytes before it, and
-- the head is parsed once, when all of it is read.
--
-- The server stops where a connection cannot be accepted: the listener
-- closed (`Net.closeListener`, as above on a signal), or the program
-- out of descriptors (`EMFILE`).  Then each connection with no exchange
-- -- waiting for a request -- is closed at once; a stream is ended (its
-- last chunk), a socket closed (`1001`), each once what was sent on it
-- is written, `gone` called; the others are closed once the request in
-- hand is answered.  Once the last is closed, nothing of the server is
-- pending, and the program ends, if nothing else is.  The handler runs
-- in a behaviour, of the server's world, and may throw an `err` (`Empty`
-- where it throws nothing): a throw no `recover` of the handler's hears
-- closes that connection at once, unanswered, what was thrown let go of
-- -- a handler that is to say why catches it itself -- and the others
-- are served on.  A handler that abandons fails its behaviour, as boc
-- says of a body that abandons: its request is not answered, and its
-- connection, read no further, is closed where the program lets go of
-- it, at the run's end.  One that panics ends the program, every
-- connection closed with it.

module std.http.bocserver
  ( serve
  , Responder
  , Answer(..)
  , Streaming
  , Socket
  , Sender
  , send
  , finish
  , senderNumber
  )
import boc as BOC
import bytes as Bytes
import co
import exception
import std.duration as Duration
import std.http as HTTP
import std.http.sse as SSE
import std.http.websocket as WebSocket
import std.net as Net
import std.ordmap as OrdMap
import std.time as Time
import resource

-- Senders
--------------------------------------------------------------------------------

-- | What a handler sends its client by, on an answer that goes on: a
-- | stream's pieces (`Bytes`), or a socket's messages
-- | (`WebSocket.Message`).  A value, its answer's cowns within it -- no
-- | region in its type -- so kept anywhere, a cown of the handler's
-- | among others, and sent by from any behaviour.
data Sender a
  = MkSender Int ({f : HFunctor}
                  -> {{bc : BOC.boc <: f}}
                  -> Maybe a
                  -> Co f Unit)

-- | `x` sent: put in its connection's outbox, by a behaviour, to be
-- | written after what was sent before it, by the server; the write not
-- | waited for.  A stream's piece is written as a chunk, a socket's
-- | message as a frame (a `CloseMessage` closes the socket).  Once the
-- | connection is gone, or the sender finished, nothing is done.
send : {f : HFunctor}
     -> {a : Type}
     -> {{bc : BOC.boc <: f}}
     -> Sender a
     -> a
     -> Co f Unit
send (MkSender n go) x = go (Just x)

-- | The sender done with, after what was sent before: a stream's last
-- | chunk written, its connection read on for the next request (closed
-- | after an HTTP/1.0 one's); a socket closed, `1000`.  Once the
-- | connection is gone, or the sender finished, nothing is done.
finish : {f : HFunctor}
       -> {a : Type}
       -> {{bc : BOC.boc <: f}}
       -> Sender a
       -> Co f Unit
finish (MkSender n go) = go Nothing

-- | The sender's number: its connection's, among the server's -- for a
-- | handler to keep its senders by, no two connections open at once
-- | numbered the same.
senderNumber : {a : Type} -> Sender a -> Int
senderNumber (MkSender n go) = n

-- Answers
--------------------------------------------------------------------------------

-- | What a handler does with a stream, by its sender: `opened`, once
-- | its head is written, before any piece; `gone`, once its connection
-- | is gone before it is finished -- its client gone, or too slow, or the
-- | server stopped.  Each is run in a behaviour of the server's world: a
-- | throw closes the connection.
type Streaming (e : HFunctor) (err : Type) =
  { opened : Sender Bytes -> Co (exception err <+> e) Unit
  , gone : Sender Bytes -> Co (exception err <+> e) Unit
  }

-- | What a handler does with a socket, by its sender: `opened`, once
-- | the `101` is written; `received`, each message of text or of bytes
-- | the client sends, in order; `gone`, once its connection is closed,
-- | whyever.  Each is run in a behaviour of the server's world: a throw
-- | closes the connection.
type Socket (e : HFunctor) (err : Type) =
  { opened : Sender WebSocket.Message -> Co (exception err <+> e) Unit
  , received :
        Sender WebSocket.Message
        -> WebSocket.Message
        -> Co (exception err <+> e) Unit
  , gone : Sender WebSocket.Message -> Co (exception err <+> e) Unit
  }

-- | What a handler answers its request with: a response, whole
-- | (`Whole`); a head (std.http's, a status and headers), then a body
-- | sent a piece at a time (`Streamed`); or the connection taken for
-- | WebSocket, where the request is a handshake (`Upgraded`).  A
-- | stream's headers give no length, `Transfer-Encoding` or `Connection`
-- | of their own -- the server writes those -- but `Connection: close`,
-- | which closes the connection after the stream.
data Answer (e : HFunctor) (err : Type)
  = Whole HTTP.Response
  | Streamed HTTP.Head (Streaming e err)
  | Upgraded (Socket e err)

-- | How a handler answers its request: in whichever world has boc's
-- | behaviours, its own or a later behaviour's.
type Responder (e : HFunctor) (err : Type) =
  {f : HFunctor} -> {{bc : BOC.boc <: f}} -> Answer e err -> Co f Unit

-- The cowns
--------------------------------------------------------------------------------

-- (what the outbox has: bytes to write; or what is to be done once
-- those before it are written)
data Out (e : HFunctor) = Piece Bytes | Then (Co e Unit)

-- (a connection's outbox: what it has, the last first; how many bytes
-- are in it or being written; whether a write is awaited; whether more
-- than the most was sent, for the connection to be closed at once; and
-- whether the connection is closed)
type Outbox (e : HFunctor) =
  { queue : List (Out e)
  , pending : Int
  , busy : Bool
  , over : Bool
  , closed : Bool
  }

-- (a request's exchange: whether it is answered; whether the server
-- has stopped; whether its sender may send; what is sent to end it,
-- where the server stops while it goes on; whether nothing was sent
-- since its stream's last heartbeat; and its handler's `gone`, called
-- where the connection closes while it goes on)
type Exchange (e : HFunctor) =
  { answered : Bool
  , stopping : Bool
  , going : Bool
  , halt : Maybe Bytes
  , quiet : Bool
  , gone : Co e Unit
  }

-- (a connection's inbox: whether the connection is closed; whether the
-- server has stopped; the exchange of the request in hand, where one is;
-- and what a stream's read kept of the next request)
type Inbox (e : HFunctor) =
  { closed : Bool
  , stopping : Bool
  , exchange : Maybe (BOC.Cown (Exchange e))
  , kept : Bytes
  }

-- (the server's cown: how each connection open is stopped, by its
-- number; and the next number)
type Served (e : HFunctor) =
  { open : OrdMap.OrdMap Int (Co e Unit), next : Int }

-- (what every behaviour of the server knows: the time limits, a
-- silence's and a head's, the most bytes a connection may have pending,
-- a heartbeat's and a ping's time, the server's cown, and the handler,
-- of the server's world, which may throw an `err`)
type Serving (e : HFunctor) (err : Type) =
  { idle : Int
  , headerWithin : Int
  , most : Int
  , heartbeat : Int
  , ping : Int
  , served : BOC.Cown (Served e)
  , handler :
        HTTP.ServerRequest
        -> Responder e err
        -> Co (exception err <+> e) Unit
  }

-- (a connection: the server's, its socket, its number among the
-- server's, where its other side is, and its two cowns)
type Connection (e : HFunctor) (rg : Type) (err : Type) =
  { server : Serving e err
  , socket : With rg Net.TcpStream
  , number : Int
  , peer : Net.Address
  , inbox : BOC.Cown (Inbox e)
  , outbox : BOC.Cown (Outbox e)
  }

-- (a request's exchange, as its first byte is read)
exchangeBegun : {e : HFunctor} -> Exchange e
exchangeBegun =
  { answered = False
  , stopping = False
  , going = False
  , halt = Nothing
  , quiet = True
  , gone = pure ()
  }

-- What is written
--------------------------------------------------------------------------------

-- (bytes put in the outbox, counted, where it is open)
piece : {e : HFunctor} -> Bytes -> Outbox e -> Outbox e
piece b o =
  if o.closed || Bytes.length b == 0 then o
  else { o | queue = Piece b :: o.queue, pending = o.pending + Bytes.length b }

-- (`k` to be done once what is in the outbox is written)
thenDo : {e : HFunctor} -> Co e Unit -> Outbox e -> Outbox e
thenDo k o = if o.closed then o else { o | queue = Then k :: o.queue }

-- (an exchange and the outbox changed by `f`, in a behaviour on both, of
-- whichever world)
exchanged : {f e : HFunctor}
          -> {{bc : BOC.boc <: f}}
          -> BOC.Cown (Exchange e)
          -> BOC.Cown (Outbox e)
          -> ((Exchange e, Outbox e) -> (Exchange e, Outbox e))
          -> Co f Unit
exchanged ex outbox change = do
  with p := (ex, outbox) do
    p := change p

-- (bytes its sender sent, where it may send: past `most` in all, 0 none,
-- the connection to be closed instead)
sent : {e : HFunctor}
     -> Int
     -> Bytes
     -> (Exchange e, Outbox e)
     -> (Exchange e, Outbox e)
sent most b (x, o) =
  if not x.going || o.closed || Bytes.length b == 0 then (x, o)
  else if most > 0 && o.pending + Bytes.length b > most
  then (x, { o | over = True })
  else ({ x | quiet = False }, piece b o)

-- (the answer ended: its last bytes, then `k`; its sender sends nothing
-- after)
ended : {e : HFunctor}
      -> Bytes
      -> Co e Unit
      -> (Exchange e, Outbox e)
      -> (Exchange e, Outbox e)
ended b k (x, o) = ({ x | going = False, halt = Nothing }, thenDo k (piece b o))

-- (how a stream is written: in chunks or not, and its heartbeat as
-- written, none where empty)
type Way = { chunked : Bool, beat : Bytes }

-- (what a stream's sender is given: a piece, a chunk where it is
-- chunked; or its end, `done` after it, and `gone` not called)
streamStep : {e : HFunctor}
           -> Int
           -> Way
           -> Co e Unit
           -> Maybe Bytes
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
streamStep most way done (Just b) p =
  if Bytes.length b == 0 then p
  else sent most (if way.chunked then HTTP.chunk b else b) p
streamStep most way done Nothing (x, o) =
  if x.going
  then ended
      (if way.chunked then b["0\r\n\r\n"] else Bytes.empty)
      done
      ({ x | gone = pure () }, o)
  else (x, o)

-- (a message as it is written: a frame)
frameBytes : WebSocket.Message -> Bytes
frameBytes m = WebSocket.encodeFrame (WebSocket.frameOf m)

-- (whether a message is a close)
isClose : WebSocket.Message -> Bool
isClose (CloseMessage code why) = True
isClose _ = False

-- (what a socket's sender is given: a message, a close the last, after
-- which, where the server stops, the connection is closed; or its end,
-- a close, `1000`)
socketStep : {e : HFunctor}
           -> Int
           -> Maybe WebSocket.Message
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
socketStep most (Just m) (x, o) =
  let q = sent most (frameBytes m) (x, o)
  in if isClose m && x.going
  then let y = fst q
       in ({ y | going = False, halt = Just Bytes.empty }, snd q)
  else q
socketStep most Nothing p = socketStep most (Just (CloseMessage 1000 "")) p

-- (a socket's close, or a close for the client's breaking the protocol,
-- `m`, answered: the same, unless one was sent, then `close` once it is
-- written)
closedBack : {e : HFunctor}
           -> WebSocket.Message
           -> Co e Unit
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
closedBack m close (x, o) =
  if x.going then ended (frameBytes m) close (x, o)
  else ({ x | halt = Nothing }, thenDo close o)

-- (a socket's client silent for a ping's time: a ping sent; or, a
-- close sent already, `close`)
silent : {e : HFunctor}
       -> Int
       -> Co e Unit
       -> (Exchange e, Outbox e)
       -> (Exchange e, Outbox e)
silent most close (x, o) =
  if x.going then sent most (frameBytes (PingMessage Bytes.empty)) (x, o)
  else ({ x | halt = Nothing }, thenDo close o)

-- (a heartbeat's time begun again)
quieted : {e : HFunctor} -> (Exchange e, Outbox e) -> (Exchange e, Outbox e)
quieted (x, o) = ({ x | quiet = True }, o)

-- (a heartbeat's time passed on a stream: its heartbeat sent, where
-- nothing was since the last)
beaten : {e : HFunctor}
       -> Int
       -> Bytes
       -> (Exchange e, Outbox e)
       -> (Exchange e, Outbox e)
beaten most beat (x, o) =
  if x.quiet then quieted (sent most beat (x, o)) else quieted (x, o)

-- (what ends a stream or a socket, where there is something, then
-- `close`)
haltedBy : {e : HFunctor}
         -> Co e Unit
         -> Maybe Bytes
         -> (Exchange e, Outbox e)
         -> (Exchange e, Outbox e)
haltedBy close (Just b) p = ended b close p
haltedBy close Nothing p = p

-- (the server stopped, for the request in hand: its stream or socket
-- ended, then `close`)
halted : {e : HFunctor}
       -> Co e Unit
       -> (Exchange e, Outbox e)
       -> (Exchange e, Outbox e)
halted close (x, o) = haltedBy close x.halt ({ x | stopping = True }, o)

-- (whether a header says its body is server-sent events)
isEventStream : Pair String String -> Bool
isEventStream (MkPair n v) =
  HTTP.sameName n "Content-Type"
  && HTTP.sameName (strSlice (trim v) 0 17) "text/event-stream"

-- (a stream's heartbeat, of these headers, as written: an empty comment,
-- where they are events' and there is a heartbeat's time; none else)
beatOf : Int -> Bool -> List (Pair String String) -> Bytes
beatOf heartbeat chunked headers =
  if heartbeat > 0 && List.any isEventStream headers
  then (if chunked then HTTP.chunk (SSE.event [Comment ""])
        else SSE.event [Comment ""])
  else Bytes.empty

-- Reading
--------------------------------------------------------------------------------

-- (how far a request is read: its head not yet -- the last bytes looked
-- through for its end, three at most, kept, for an end read in two
-- pieces -- or its head, its body to come, from where that starts; or
-- its head, its body sent in chunks, read so far)
data Part
  = InHead Bytes
  | InBody HTTP.ServerRequest Int
  | InChunks HTTP.ServerRequest HTTP.Chunks

-- (when the head being read is to be read by, on the monotonic clock,
-- in milliseconds: at no time -- a body is read, or there is no limit
-- -- within so many of the next read's start, or by then)
data HeadBy = Whenever | Within Int | By Int

-- (what is read of a request: the last read first, `got` bytes in all,
-- how many in all are wanted before it is read again, how far that is,
-- when its head is to be read by, and whether a `100 Continue` was
-- written for it)
type Progress =
  { parts : List Bytes
  , got : Int
  , want : Int
  , part : Part
  , by : HeadBy
  , continued : Bool
  }

-- (a request of which nothing is read, its head to be read within
-- `within` milliseconds of the next read's start; 0, at no time)
begun : Int -> Progress
begun within =
  { parts = Nil
  , got = 0
  , want = 1
  , part = InHead Bytes.empty
  , by = if within == 0 then Whenever else Within within
  , continued = False
  }

-- (whether nothing of the request is read yet)
unread : Part -> Int -> Bool
unread (InHead tail) got = got == 0
unread _ got = False

-- (how much the next read asks for: what is wanted still, a body's, or
-- `readSize`, whichever is more)
sizeFor : Progress -> Int
sizeFor pg =
  if pg.want - pg.got > HTTP.readSize then pg.want - pg.got else HTTP.readSize

-- (whether a read or a write failed for its time limit)
isTimeout : Net.NetError -> Bool
isTimeout why = strEq why.name "ETIMEDOUT"

-- (bytes kept, the last first, as one)
leftOf : List Bytes -> Bytes
leftOf [b] = b
leftOf parts = Bytes.concat (List.reverse parts)

-- (whether the client waits for `100 Continue` before it sends the body
-- of the request whose head is read)
expectsOf : HTTP.Wanted -> Bool
expectsOf (MoreHead want) = False
expectsOf (MoreBody r want) = HTTP.expects r
expectsOf (MoreChunks r ch) = HTTP.expects r

-- (what is read of a request, the head read, `buf` all that is read of
-- it, the head's blank line at `i`, as what the request still wants
-- says: so many bytes in all, its body from `i + 4` on; or its body's
-- chunks, which hold what is read of them)
wanting : Progress -> Bytes -> Int -> HTTP.Wanted -> Progress
wanting pg buf i (MoreHead want) =
  { pg
  | parts = [buf]
  , got = Bytes.length buf
  , want = want
  , part = InHead Bytes.empty
  , by = Whenever
  }
wanting pg buf i (MoreBody r want) =
  { pg
  | parts = [buf]
  , got = Bytes.length buf
  , want = want
  , part = InBody r (i + 4)
  , by = Whenever
  }
wanting pg buf i (MoreChunks r ch) =
  { pg | parts = Nil, got = 0, want = 0, part = InChunks r ch, by = Whenever }

-- The acts
--------------------------------------------------------------------------------

-- (the next connection accepted, and where its other side is: `Left`
-- where none is accepted; `Nothing` where it was, but closed at once,
-- its other side gone)
acceptedFrom : {e : HFunctor}
             -> {rg : Type}
             -> {{nt : Net.net <: e}}
             -> With rg Net.TcpListener
             -> Co
               e
               (Either
                  Net.NetError
                  (Maybe (With rg Net.TcpStream, Net.Address)))
acceptedFrom l = do
  r <- Net.accepted l
  case r of
    Left err -> pure (Left err)
    Right c -> do
      p <- Net.peer c
      case p of
        Right a -> pure (Right (Just (c, a)))
        Left err -> do
          _ <- Net.close c
          pure (Right Nothing)

-- (what a read came to: its bytes -- none at the connection's end --
-- and when the head is to be read by after it; or nothing, the read
-- failed, or the head's time passed)
data Arrived = Came HeadBy Bytes | Failed

came : HeadBy -> Either Net.NetError Bytes -> Arrived
came by (Right b) = Came by b
came by (Left err) = Failed

-- (the monotonic clock, in milliseconds)
millisecondsNow : {e : HFunctor} -> {{clock : Time.time <: e}} -> Co e Int
millisecondsNow =
  bind Time.monotonic (\d -> pure (Duration.totalNanoseconds d / 1000000))

-- (a read, `now`, of `size` bytes at most, within `idle` milliseconds,
-- and by `until`: where that has passed, none)
readUntil : {e : HFunctor}
          -> {rg : Type}
          -> {{nt : Net.net <: e}}
          -> Int
          -> Int
          -> Int
          -> With rg Net.TcpStream
          -> Int
          -> Co e Arrived
readUntil idle until now c size =
  if now >= until then pure Failed
  else bind
      (Net.read
         (timeout := (if idle > 0 && idle < until - now then idle
                      else until - now))
         c
         size)
      (\r -> pure (came (By until) r))

-- (a read of `size` bytes at most, within `idle` milliseconds, and where
-- a head is read by a time, by then: its time taken at this read's start
-- where it is the head's first)
readBy : {e : HFunctor}
       -> {rg : Type}
       -> {{nt : Net.net <: e}}
       -> {{clock : Time.time <: e}}
       -> Int
       -> HeadBy
       -> With rg Net.TcpStream
       -> Int
       -> Co e Arrived
readBy idle Whenever c size =
  bind (Net.read (timeout := idle) c size) (\r -> pure (came Whenever r))
readBy idle (Within within) c size =
  bind millisecondsNow (\now -> readUntil idle (now + within) now c size)
readBy idle (By until) c size =
  bind millisecondsNow (\now -> readUntil idle until now c size)

-- (what the client still sends read and let go of, `got` bytes of it
-- already, until it ends or there has been `drainMost` of it)
drained : {e : HFunctor}
        -> {rg : Type}
        -> {{nt : Net.net <: e}}
        -> Int
        -> With rg Net.TcpStream
        -> Int
        -> Co e Unit
drained idle c got =
  if got >= HTTP.drainMost then pure ()
  else do
    r <- Net.read (timeout := idle) c HTTP.readSize
    case r of
      Right b ->
        if Bytes.length b == 0 then pure ()
        else drained idle c (got + Bytes.length b)
      Left err -> pure ()

-- (a refusal written, then this side shut down, so that the client reads
-- it to its end, and what the client still sends drained, so that the
-- connection closed with bytes unread -- a reset, which may come before
-- the client has read the refusal -- is not what it is sent)
refused : {e : HFunctor}
        -> {rg : Type}
        -> {{nt : Net.net <: e}}
        -> Int
        -> With rg Net.TcpStream
        -> Int
        -> Co e Unit
refused idle c status = do
  r <-
    Net.write
      (timeout := idle)
      c
      (HTTP.responseBytes
         "close"
         True
         (HTTP.plain status (HTTP.reason status ^ "\n")))
  case r of
    Right u -> do
      _ <- Net.shutdown c
      drained idle c 0
    Left err -> pure ()

-- Closing, and the writer
--------------------------------------------------------------------------------

-- (the connection's socket closed, and the connection taken from the
-- server's)
closing : {e : HFunctor}
        -> {rg err : Type}
        -> {{bc : BOC.boc <: e}}
        -> {{nt : Net.net <: e}}
        -> Connection e rg err
        -> Co e Unit
closing cn = do
  with sv := cn.server.served
       _ := BOC.await (Net.close cn.socket) do
    sv := { sv | open = OrdMap.delete sv.open cn.number }

-- (the handler's `gone` of the exchange in hand, where it goes on)
goneOf : {e : HFunctor}
       -> {{bc : BOC.boc <: e}}
       -> Maybe (BOC.Cown (Exchange e))
       -> Co e Unit
goneOf Nothing = pure ()
goneOf (Just ex) = do
  with x := ex do
    x.gone
    x := { x | gone = pure (), going = False, halt = Nothing }

-- (the connection closed, by a behaviour on both its sides, where it is
-- not yet: what comes back to either after does nothing)
closer : {e : HFunctor}
       -> {rg err : Type}
       -> {{bc : BOC.boc <: e}}
       -> {{nt : Net.net <: e}}
       -> Connection e rg err
       -> Co e Unit
closer cn = do
  with i := cn.inbox
       o := cn.outbox do
    if o.closed then pure ()
    else do
      closing cn
      goneOf i.exchange
      i := { i | closed = True }
      o := { o | queue = Nil, pending = 0, closed = True }

-- (whether the writer has something to do: the connection closed, more
-- than the most sent, or, no write awaited, something in the outbox)
ready : {e : HFunctor} -> Outbox e -> Bool
ready o = o.closed || o.over || (not o.busy && not (List.null o.queue))

-- (what the outbox has, the last first, as the bytes to write and what
-- is to be done once they are written, in order)
gathered : {e : HFunctor}
         -> List (Out e)
         -> List Bytes
         -> List (Co e Unit)
         -> (Bytes, List (Co e Unit))
gathered [] bs ks = (leftOf (List.reverse bs), ks)
gathered (Piece b :: rest) bs ks = gathered rest (b :: bs) ks
gathered (Then k :: rest) bs ks = gathered rest bs (k :: ks)

-- (each of `ks` done, in order)
ranAll : {e : HFunctor} -> List (Co e Unit) -> Co e Unit
ranAll [] = pure ()
ranAll (k :: ks) = bind k (\u -> ranAll ks)

-- (what writing `n` bytes by a write awaited came to: `after` done, the
-- writer free to write what was put in the outbox meanwhile; or, not
-- written, the connection closed)
afterWrite : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> Connection e rg err
           -> Int
           -> List (Co e Unit)
           -> Outbox e
           -> Either Net.NetError Unit
           -> Co e (Outbox e)
afterWrite cn n after o (Right u) =
  if o.closed then pure o
  else do
    ranAll after
    pure { o | busy = False, pending = o.pending - n }
afterWrite cn n after o (Left why) =
  if o.closed then pure o
  else do
    closer cn
    pure o

mutual
  -- (the writer, waiting on the outbox, `once`, until it has something
  -- to do: then it does it, in a behaviour of the server's world)
  writing : {e : HFunctor}
          -> {rg err : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{nt : Net.net <: e}}
          -> Connection e rg err
          -> Co e Unit
  writing cn = do
    with o := cn.outbox once ready o do
      o := (<- wrote cn o)

  -- (the writer's turn come: the connection closed, nothing more done;
  -- past the most, the connection closed; else what is in the outbox
  -- written, and what is to be done after it done)
  wrote : {e : HFunctor}
        -> {rg err : Type}
        -> {{bc : BOC.boc <: e}}
        -> {{nt : Net.net <: e}}
        -> Connection e rg err
        -> Outbox e
        -> Co e (Outbox e)
  wrote cn o =
    if o.closed then pure o
    else if o.over
    then do
      closer cn
      pure o
    else wroteAll cn { o | queue = Nil } (gathered o.queue Nil Nil)

  -- (`bytes` written, as much as the socket takes at once, then `after`
  -- done; the rest by a write awaited, `after` once it is done)
  wroteAll : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> Connection e rg err
           -> Outbox e
           -> (Bytes, List (Co e Unit))
           -> Co e (Outbox e)
  wroteAll cn o (bytes, after) = do
    now <-
      if Bytes.length bytes == 0 then pure (Right 0)
      else Net.writeNow cn.socket bytes
    case now of
      Left why -> do
        closer cn
        pure o
      Right n ->
        if n == Bytes.length bytes
        then do
          ranAll after
          writing cn
          pure { o | pending = o.pending - n }
        else do
          let rest = Bytes.slice bytes n (Bytes.length bytes)
          with p := cn.outbox
               w :=
                   BOC.await
                     (Net.write (timeout := cn.server.idle) cn.socket rest) do
            p := (<- afterWrite cn (Bytes.length rest) after p w)
          writing cn
          pure { o | busy = True, pending = o.pending - n }

-- (a refusal written, what the client still sends drained, then the
-- connection closed)
refusing : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> Connection e rg err
         -> Int
         -> Co e Unit
refusing cn status = do
  with _ := BOC.await (refused cn.server.idle cn.socket status) do
    closer cn

-- A socket's reads
--------------------------------------------------------------------------------

-- (the sender of a socket, its exchange `ex`)
socketSender : {e : HFunctor}
             -> {rg err : Type}
             -> Connection e rg err
             -> BOC.Cown (Exchange e)
             -> Sender WebSocket.Message
socketSender cn ex =
  MkSender
    cn.number
    (\m -> exchanged ex cn.outbox (socketStep cn.server.most m))

-- (a message the client sent on a socket: a ping answered, a close
-- answered, the others the handler's; whether to go on, not where the
-- handler threw, its connection closed)
heardOne : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> Connection e rg err
         -> BOC.Cown (Exchange e)
         -> Socket e err
         -> WebSocket.Message
         -> Co e Bool
heardOne cn ex s (PingMessage p) = do
  exchanged ex cn.outbox (sent cn.server.most (frameBytes (PongMessage p)))
  pure True
heardOne cn ex s (PongMessage p) = pure True
heardOne cn ex s (CloseMessage code why) = do
  exchanged ex cn.outbox (closedBack (CloseMessage code "") (closer cn))
  pure True
heardOne cn ex s m = do
  outcome <- attempt err (s.received (socketSender cn ex) m)
  case outcome of
    Right u -> pure True
    Left thrown -> do
      closer cn
      pure False

-- (the messages the client sent on a socket, in order, until the
-- handler throws: whether it did not)
heard : {e : HFunctor}
      -> {rg err : Type}
      -> {{bc : BOC.boc <: e}}
      -> {{nt : Net.net <: e}}
      -> Connection e rg err
      -> BOC.Cown (Exchange e)
      -> Socket e err
      -> List WebSocket.Message
      -> Co e Bool
heard cn ex s [] = pure True
heard cn ex s (m :: ms) = do
  go <- heardOne cn ex s m
  if go then heard cn ex s ms else pure False

mutual
  -- (a socket read on, `fr` its frames so far, `pinged` whether a ping
  -- is unanswered: what comes in `ping` milliseconds, or that nothing
  -- did, taken in a behaviour on the inbox)
  socketReading : {e : HFunctor}
                -> {rg err : Type}
                -> {{bc : BOC.boc <: e}}
                -> {{nt : Net.net <: e}}
                -> Connection e rg err
                -> BOC.Cown (Exchange e)
                -> Socket e err
                -> WebSocket.Reader
                -> Bool
                -> Co e Unit
  socketReading cn ex s fr pinged = do
    with i := cn.inbox
         got :=
             BOC.await
               (Net.read (timeout := cn.server.ping) cn.socket HTTP.readSize) do
      if i.closed then pure () else socketCame cn ex s fr pinged got

  -- (what a read of a socket came to: its frames' messages heard, and
  -- read on unless a close has come or the client broke the protocol;
  -- nothing for `ping` milliseconds, a ping sent, or, one sent already,
  -- the connection closed; the client gone, the connection closed)
  socketCame : {e : HFunctor}
             -> {rg err : Type}
             -> {{bc : BOC.boc <: e}}
             -> {{nt : Net.net <: e}}
             -> Connection e rg err
             -> BOC.Cown (Exchange e)
             -> Socket e err
             -> WebSocket.Reader
             -> Bool
             -> Either Net.NetError Bytes
             -> Co e Unit
  socketCame cn ex s fr pinged (Right b) =
    if Bytes.length b == 0 then closer cn
    else fedTo cn ex s (WebSocket.feed fr b)
  socketCame cn ex s fr pinged (Left why) =
    if isTimeout why && not pinged
    then do
      exchanged ex cn.outbox (silent cn.server.most (closer cn))
      socketReading cn ex s fr True
    else closer cn

  -- (what the frames read came to: their messages heard, and the
  -- socket read on; or, the client having broken the protocol, closed)
  fedTo : {e : HFunctor}
        -> {rg err : Type}
        -> {{bc : BOC.boc <: e}}
        -> {{nt : Net.net <: e}}
        -> Connection e rg err
        -> BOC.Cown (Exchange e)
        -> Socket e err
        -> WebSocket.Fed
        -> Co e Unit
  fedTo cn ex s (Going ms r) = do
    go <- heard cn ex s ms
    if go && not r.closed then socketReading cn ex s r False else pure ()
  fedTo cn ex s (Failing ms code why) = do
    go <- heard cn ex s ms
    if go
    then exchanged ex cn.outbox (closedBack (CloseMessage code why) (closer cn))
    else pure ()

-- (a socket begun, its `101` written: the handler's `opened` run, then
-- what was read after the request taken as its first frames, else the
-- connection read)
socketOpening : {e : HFunctor}
              -> {rg err : Type}
              -> {{bc : BOC.boc <: e}}
              -> {{nt : Net.net <: e}}
              -> Connection e rg err
              -> BOC.Cown (Exchange e)
              -> Socket e err
              -> Bytes
              -> Co e Unit
socketOpening cn ex s rest = do
  outcome <- attempt err (s.opened (socketSender cn ex))
  case outcome of
    Left thrown -> closer cn
    Right u -> do
      with i := cn.inbox do
        if i.closed then pure ()
        else if Bytes.length rest > 0
        then socketCame cn ex s WebSocket.reader False (Right rest)
        else socketReading cn ex s WebSocket.reader False

-- A request read, and answered
--------------------------------------------------------------------------------

-- (a handler's `gone`, what it throws let go of)
goneWith : {e : HFunctor}
         -> {err a : Type}
         -> (Sender a -> Co (exception err <+> e) Unit)
         -> Sender a
         -> Co e Unit
goneWith gone out = bind (attempt err (gone out)) (\o -> pure ())

mutual
  -- (more of the request read, `size` bytes at most, in `idle`
  -- milliseconds, and where its head is read, by `pg.by`: what it comes
  -- to taken, in a behaviour on the inbox)
  reading : {e : HFunctor}
          -> {rg err : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{nt : Net.net <: e}}
          -> {{clock : Time.time <: e}}
          -> Connection e rg err
          -> Int
          -> Progress
          -> Co e Unit
  reading cn size pg = do
    with i := cn.inbox
         got := BOC.await (readBy cn.server.idle pg.by cn.socket size) do
      i := (<- readCame cn i pg got)

  -- (what a read came to, where the connection is open: at the
  -- request's first bytes, its exchange begun)
  readCame : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> Inbox e
           -> Progress
           -> Arrived
           -> Co e (Inbox e)
  readCame cn i pg (Came after b) =
    if i.closed then pure i
    else if Bytes.length b == 0
    then do
      closer cn
      pure i
    else if unread pg.part pg.got
    then do
      ex <- BOC.newCown exchangeBegun
      took cn { i | exchange = Just ex } { pg | by = after } pg.part b
    else took cn i { pg | by = after } pg.part b
  readCame cn i pg Failed = do
    if i.closed then pure () else closer cn
    pure i

  -- (bytes `b` read, taken as far as they go, where the request is,
  -- `part`)
  took : {e : HFunctor}
       -> {rg err : Type}
       -> {{bc : BOC.boc <: e}}
       -> {{nt : Net.net <: e}}
       -> {{clock : Time.time <: e}}
       -> Connection e rg err
       -> Inbox e
       -> Progress
       -> Part
       -> Bytes
       -> Co e (Inbox e)
  took cn i pg (InHead tail) b = looked cn i pg tail b
  took cn i pg (InBody r at) b =
    advanced cn i { pg | parts = b :: pg.parts, got = pg.got + Bytes.length b }
  took cn i pg (InChunks r ch) b = dechunked cn i pg r (HTTP.feedChunks ch b)

  -- (what a piece of a body sent in chunks came to: the request, all
  -- read, handed to the handler; more read; or the request refused)
  dechunked : {e : HFunctor}
            -> {rg err : Type}
            -> {{bc : BOC.boc <: e}}
            -> {{nt : Net.net <: e}}
            -> {{clock : Time.time <: e}}
            -> Connection e rg err
            -> Inbox e
            -> Progress
            -> HTTP.ServerRequest
            -> HTTP.Dechunked
            -> Co e (Inbox e)
  dechunked cn i pg r (BodyRead body rest) =
    answered cn i (Asked { r | body = body } rest)
  dechunked cn i pg r (ChunksToCome ch) = do
    reading cn HTTP.readSize { pg | part = InChunks r ch }
    pure i
  dechunked cn i pg r (ChunksRefused status) = answered cn i (Refused status)

  -- (bytes `b` read of a head, its end looked for in them alone, and in
  -- `tail`, the last bytes read before them: where it is found, the
  -- head parsed, once; else more read, or, the head too long, refused)
  looked : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> {{clock : Time.time <: e}}
         -> Connection e rg err
         -> Inbox e
         -> Progress
         -> Bytes
         -> Bytes
         -> Co e (Inbox e)
  looked cn i pg tail b = do
    let at = HTTP.blankIn tail b 0
    let read = { pg | parts = b :: pg.parts, got = pg.got + Bytes.length b }
    if at >= 0 then headed cn i read (pg.got - Bytes.length tail + at)
    else if read.got > HTTP.headMost
    then do
      refusing cn 431
      pure i
    else do
      reading
          cn
          HTTP.headPiece
          { read | want = read.got + 1, part = InHead (HTTP.lastThree tail b) }
      pure i

  -- (the head read, its blank line at `at` of what is read: parsed, and
  -- its body read, a `100 Continue` written first where the client
  -- waits for one; or the request handed to the handler, or refused)
  headed : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> {{clock : Time.time <: e}}
         -> Connection e rg err
         -> Inbox e
         -> Progress
         -> Int
         -> Co e (Inbox e)
  headed cn i pg at = do
    let buf = leftOf pg.parts
    case HTTP.requestIn (from := at) cn.peer buf of
      Left wanted -> do
        let more = wanting pg buf at wanted
        if expectsOf wanted && not pg.continued
        then do
          with o := cn.outbox do
            o := piece b["HTTP/1.1 100 Continue\r\n\r\n"] o
          reading cn (sizeFor more) { more | continued = True }
        else reading cn (sizeFor more) more
        pure i
      Right g -> answered cn i g

  -- (what is read of a request's body: more read, where too little is;
  -- else the request handed to the handler)
  advanced : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> Inbox e
           -> Progress
           -> Co e (Inbox e)
  advanced cn i pg =
    if pg.got < pg.want
    then do
      reading cn (sizeFor pg) pg
      pure i
    else bodied cn i pg pg.part

  -- (the request whose head is read, `part`, its body all read: handed
  -- to the handler, what was read after it kept)
  bodied : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> {{clock : Time.time <: e}}
         -> Connection e rg err
         -> Inbox e
         -> Progress
         -> Part
         -> Co e (Inbox e)
  bodied cn i pg (InBody r at) = do
    let buf = leftOf pg.parts
    answered
        cn
        i
        (Asked
           { r | body = Bytes.slice buf at pg.want }
           (Bytes.slice buf pg.want (Bytes.length buf)))
  bodied cn i pg (InHead tail) =
    looked cn i { pg | parts = Nil, got = 0 } Bytes.empty (leftOf pg.parts)
  bodied cn i pg (InChunks r ch) = dechunked cn i pg r (ChunksToCome ch)

  -- (what a request read came to: handed to the handler, or refused, or
  -- the connection's end)
  answered : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> Inbox e
           -> HTTP.Got
           -> Co e (Inbox e)
  answered cn i (Asked r rest) = handed cn i r rest i.exchange
  answered cn i (Refused status) = do
    refusing cn status
    pure i
  answered cn i Ended = do
    closer cn
    pure i

  -- (request `r` handed to the handler, with a responder that answers
  -- on its exchange, `rest` read after it)
  handed : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> {{clock : Time.time <: e}}
         -> Connection e rg err
         -> Inbox e
         -> HTTP.ServerRequest
         -> Bytes
         -> Maybe (BOC.Cown (Exchange e))
         -> Co e (Inbox e)
  handed cn i r rest (Just ex) = do
    outcome <-
      attempt
        err
        (cn.server.handler
           r
           (\a -> exchanged ex cn.outbox (answering cn ex r rest a)))
    case outcome of
      Right u -> pure i
      Left thrown -> do
        closer cn
        pure i
  handed cn i r rest Nothing = do
    closer cn
    pure i

  -- (the handler's answer to `r` taken, where it is its first)
  answering : {e : HFunctor}
            -> {rg err : Type}
            -> {{bc : BOC.boc <: e}}
            -> {{nt : Net.net <: e}}
            -> {{clock : Time.time <: e}}
            -> Connection e rg err
            -> BOC.Cown (Exchange e)
            -> HTTP.ServerRequest
            -> Bytes
            -> Answer e err
            -> (Exchange e, Outbox e)
            -> (Exchange e, Outbox e)
  answering cn ex r rest a (x, o) =
    if x.answered then (x, o)
    else answerOf cn ex r rest a ({ x | answered = True }, o)

  -- (an answer to `r` put in the outbox: a response, the next request
  -- read after it, or the connection closed, where the request or the
  -- response asks or the server stops; a stream begun; a socket's
  -- handshake answered)
  answerOf : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> BOC.Cown (Exchange e)
           -> HTTP.ServerRequest
           -> Bytes
           -> Answer e err
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
  answerOf cn ex r rest (Whole res) (x, o) =
    let close =
      x.stopping
      || not (HTTP.keptAlive r)
      || HTTP.connectionSays "close" res.headers
    in ( x
       , thenDo
         (afterAnswer cn close True rest)
         (piece
            (HTTP.responseBytes
               (HTTP.connectionWord r close)
               (not (strEq r.method "HEAD"))
               res)
            o)
       )
  answerOf cn ex r rest (Streamed h s) (x, o) =
    let chunked = strEq r.version "HTTP/1.1"
    in streamOf
      cn
      ex
      r
      rest
      h
      s
      chunked
      (x.stopping
       || not chunked
       || not (HTTP.keptAlive r)
       || HTTP.connectionSays "close" h.headers)
      (x, o)
  answerOf cn ex r rest (Upgraded s) p =
    upgraded cn ex r rest s (WebSocket.handshake r) p

  -- (a stream, `chunked` whether in chunks, `close` whether its
  -- connection is closed after it: its head; to a `HEAD`, or of a status
  -- with no body, alone, the handler not given it; else the stream begun)
  streamOf : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> BOC.Cown (Exchange e)
           -> HTTP.ServerRequest
           -> Bytes
           -> HTTP.Head
           -> Streaming e err
           -> Bool
           -> Bool
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
  streamOf cn ex r rest h s chunked close (x, o) =
    let head =
      HTTP.streamedHead
        (HTTP.connectionWord r close)
        (chunked && not (HTTP.bodiless h.status))
        h
    in if HTTP.bodiless h.status || strEq r.method "HEAD"
    then (x, thenDo (afterAnswer cn close True rest) (piece head o))
    else streamBegun
        cn
        ex
        rest
        s
        { chunked = chunked
        , beat = beatOf cn.server.heartbeat chunked h.headers
        }
        close
        head
        (x, o)

  -- (a stream begun: its head, then the handler's `opened` once it is
  -- written; its sender, its exchange's, sending what it is given)
  streamBegun : {e : HFunctor}
              -> {rg err : Type}
              -> {{bc : BOC.boc <: e}}
              -> {{nt : Net.net <: e}}
              -> {{clock : Time.time <: e}}
              -> Connection e rg err
              -> BOC.Cown (Exchange e)
              -> Bytes
              -> Streaming e err
              -> Way
              -> Bool
              -> Bytes
              -> (Exchange e, Outbox e)
              -> (Exchange e, Outbox e)
  streamBegun cn ex rest s way close head (x, o) =
    let out : Sender Bytes =
      MkSender
        cn.number
        (\b ->
           exchanged
             ex
             cn.outbox
             (streamStep
                cn.server.most
                way
                (afterAnswer cn close False Bytes.empty)
                b))
    in ( { x
         | going = True
         , halt = Just (if way.chunked then b["0\r\n\r\n"] else Bytes.empty)
         , gone = goneWith s.gone out
         }
       , thenDo (opening cn ex way s out rest) (piece head o)
       )

  -- (a socket's handshake checked: refused, its refusal written; else
  -- its `101` written, then the socket begun)
  upgraded : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> BOC.Cown (Exchange e)
           -> HTTP.ServerRequest
           -> Bytes
           -> Socket e err
           -> WebSocket.Handshake
           -> (Exchange e, Outbox e)
           -> (Exchange e, Outbox e)
  upgraded cn ex r rest s (Refuse res) p = answerOf cn ex r rest (Whole res) p
  upgraded cn ex r rest s (Accept key) (x, o) =
    ( { x
      | going = True
      , halt = Just (frameBytes (CloseMessage 1001 ""))
      , gone = goneWith s.gone (socketSender cn ex)
      }
    , thenDo
      (socketOpening cn ex s rest)
      (piece
         (HTTP.takeoverHead
            { status = 101, headers = WebSocket.upgradeHeaders key })
         o)
    )

  -- (what comes once an answer is written: the connection closed, where
  -- it is to be; else, on the inbox, the request's exchange done with and
  -- the next request read -- from what was read after it, or a stream
  -- kept, where there is some -- or the connection closed where the
  -- server has stopped)
  afterAnswer : {e : HFunctor}
              -> {rg err : Type}
              -> {{bc : BOC.boc <: e}}
              -> {{nt : Net.net <: e}}
              -> {{clock : Time.time <: e}}
              -> Connection e rg err
              -> Bool
              -> Bool
              -> Bytes
              -> Co e Unit
  afterAnswer cn True again rest = closer cn
  afterAnswer cn False again rest = do
    with i := cn.inbox do
      i :=
        (<- nextOf
          cn
          { i | exchange = Nothing, kept = Bytes.empty }
          again
          (Bytes.append i.kept rest))

  -- (the next request read, `rest` read of it already, where there is
  -- some; else by a read, `again`, or, after a stream, by the read it
  -- waits on; or, the server stopped, the connection closed)
  nextOf : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> {{clock : Time.time <: e}}
         -> Connection e rg err
         -> Inbox e
         -> Bool
         -> Bytes
         -> Co e (Inbox e)
  nextOf cn i again rest =
    if i.closed then pure i
    else if i.stopping
    then do
      closer cn
      pure i
    else if Bytes.length rest > 0
    then do
      ex <- BOC.newCown exchangeBegun
      looked
          cn
          { i | exchange = Just ex }
          (begun cn.server.headerWithin)
          Bytes.empty
          rest
    else if again
    then do
      reading cn HTTP.readSize (begun cn.server.headerWithin)
      pure i
    else pure i

  -- (a stream begun, its head written: the handler's `opened` run, then
  -- what was read after its request kept for after it, else its
  -- connection read)
  opening : {e : HFunctor}
          -> {rg err : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{nt : Net.net <: e}}
          -> {{clock : Time.time <: e}}
          -> Connection e rg err
          -> BOC.Cown (Exchange e)
          -> Way
          -> Streaming e err
          -> Sender Bytes
          -> Bytes
          -> Co e Unit
  opening cn ex way s out rest = do
    outcome <- attempt err (s.opened out)
    case outcome of
      Left thrown -> closer cn
      Right u -> do
        with i := cn.inbox do
          if i.closed then pure ()
          else if Bytes.length rest > 0
          then do
            i := { i | kept = rest }
          else listening
              cn
              ex
              (if Bytes.length way.beat > 0 then cn.server.heartbeat
               else cn.server.idle)
              way.beat

  -- (a stream's connection read, a piece at a time, within `ms`
  -- milliseconds: what it comes to taken in a behaviour on the inbox --
  -- while the stream goes on, the stream's; once it is done with, the
  -- next request's)
  listening : {e : HFunctor}
            -> {rg err : Type}
            -> {{bc : BOC.boc <: e}}
            -> {{nt : Net.net <: e}}
            -> {{clock : Time.time <: e}}
            -> Connection e rg err
            -> BOC.Cown (Exchange e)
            -> Int
            -> Bytes
            -> Co e Unit
  listening cn ex ms beat = do
    with i := cn.inbox
         got := BOC.await (Net.read (timeout := ms) cn.socket HTTP.headPiece) do
      i := (<- listened cn ex ms beat i i.exchange got)

  -- (what a read of a stream's connection came to: the stream still in
  -- hand, the client's end closing the connection, bytes the next
  -- request's kept, nothing in its time a heartbeat sent and the
  -- connection read on; the stream done with, the next request's)
  listened : {e : HFunctor}
           -> {rg err : Type}
           -> {{bc : BOC.boc <: e}}
           -> {{nt : Net.net <: e}}
           -> {{clock : Time.time <: e}}
           -> Connection e rg err
           -> BOC.Cown (Exchange e)
           -> Int
           -> Bytes
           -> Inbox e
           -> Maybe (BOC.Cown (Exchange e))
           -> Either Net.NetError Bytes
           -> Co e (Inbox e)
  listened cn ex ms beat i (Just x) (Right b) =
    if i.closed then pure i
    else if Bytes.length b == 0
    then do
      closer cn
      pure i
    else pure { i | kept = b }
  listened cn ex ms beat i (Just x) (Left why) =
    if i.closed then pure i
    else if isTimeout why
    then do
      if Bytes.length beat > 0
      then exchanged ex cn.outbox (beaten cn.server.most beat)
      else pure ()
      listening cn ex ms beat
      pure i
    else do
      closer cn
      pure i
  listened cn ex ms beat i Nothing (Right b) =
    readCame
      cn
      i
      (begun cn.server.headerWithin)
      (Came (begun cn.server.headerWithin).by b)
  listened cn ex ms beat i Nothing (Left why) =
    if i.closed then pure i
    else if isTimeout why
    then do
      reading cn HTTP.readSize (begun cn.server.headerWithin)
      pure i
    else do
      closer cn
      pure i

-- Stopping, and serving
--------------------------------------------------------------------------------

-- (the server stopped, for a connection, on its inbox: closed at once
-- where no request is in hand; else what is in hand ended, a stream or
-- a socket, and the connection closed once its answer is written)
stoppedIn : {e : HFunctor}
          -> {rg err : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{nt : Net.net <: e}}
          -> Connection e rg err
          -> Inbox e
          -> Maybe (BOC.Cown (Exchange e))
          -> Co e (Inbox e)
stoppedIn cn i Nothing = do
  closer cn
  pure { i | closed = True }
stoppedIn cn i (Just ex) = do
  exchanged ex cn.outbox (halted (closer cn))
  pure { i | stopping = True }

-- (... in a behaviour on its inbox)
stopping : {e : HFunctor}
         -> {rg err : Type}
         -> {{bc : BOC.boc <: e}}
         -> {{nt : Net.net <: e}}
         -> Connection e rg err
         -> Co e Unit
stopping cn = do
  with i := cn.inbox do
    if i.closed then pure () else i := (<- stoppedIn cn i i.exchange)

-- (each of the connections open stopped)
stoppedAll : {e : HFunctor} -> List (Pair Int (Co e Unit)) -> Co e Unit
stoppedAll [] = pure ()
stoppedAll (MkPair n stop :: rest) = bind stop (\u -> stoppedAll rest)

-- (the listener's next connection accepted, given its cowns, its writer
-- waiting and its first request read; then the one after it; where none
-- is accepted, the server stopped)
accepting : {e : HFunctor}
          -> {rg err : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{nt : Net.net <: e}}
          -> {{clock : Time.time <: e}}
          -> Serving e err
          -> With rg Net.TcpListener
          -> Co e Unit
accepting sg l = do
  with sv := sg.served
       c := BOC.await (acceptedFrom l) do
    case c of
      Right (Just (sock, peer)) -> do
        inbox <-
          BOC.newCown
            ({ closed = False
             , stopping = False
             , exchange = Nothing
             , kept = Bytes.empty
             } :
               Inbox e)
        outbox <-
          BOC.newCown
            ({ queue = Nil
             , pending = 0
             , busy = False
             , over = False
             , closed = False
             } :
               Outbox e)
        let cn : Connection e rg err =
          { server = sg
          , socket = sock
          , number = sv.next
          , peer = peer
          , inbox = inbox
          , outbox = outbox
          }
        sv :=
          { sv
          | open = OrdMap.insert sv.open sv.next (stopping cn)
          , next = sv.next + 1
          }
        writing cn
        reading cn HTTP.readSize (begun sg.headerWithin)
        accepting sg l
      Right Nothing -> accepting sg l
      Left err -> stoppedAll (OrdMap.toList sv.open)

-- | The listener's connections served, each request given to `handle`
-- | with a responder, every wait an act awaited -- so as many
-- | connections are served at once as come, none holding a thread while
-- | it waits.  Comes back at once, the server running in behaviours of
-- | its own, until a connection cannot be accepted (the listener closed,
-- | `EMFILE`): then the connections waiting for a request are closed,
-- | streams ended and sockets closed, and the others once the request
-- | in hand is answered.  A client that sends nothing for `idle`
-- | milliseconds, or takes nothing written in that time, is closed; so
-- | is one that has not sent all of a request's head within
-- | `headerWithin` milliseconds of the connection's accept, or of the
-- | response before it.  A connection with more than `pending` bytes
-- | sent and not yet written is closed.  A stream of events is sent a
-- | comment after `heartbeat` milliseconds of silence; a socket, a
-- | ping after `ping`.  The handler, of the server's world, may throw
-- | an `err`: that connection is closed at once, unanswered, and what
-- | was thrown let go of.
serve : {e : HFunctor}
      -> {rg : Type}
      -> {idle : Int := 30000}
      -> {headerWithin : Int := 30000}
      -> {pending : Int := 1048576}
      -> {heartbeat : Int := 15000}
      -> {ping : Int := 30000}
      -> (err : Type)
      -> {{bc : BOC.boc <: e}}
      -> {{nt : Net.net <: e}}
      -> {{clock : Time.time <: e}}
      -> With rg Net.TcpListener
      -> (HTTP.ServerRequest
          -> Responder e err
          -> Co (exception err <+> e) Unit)
      -> Co e Unit
serve err l handle = do
  served <- BOC.newCown ({ open = OrdMap.empty, next = 0 } : Served e)
  accepting
      { idle = idle
      , headerWithin = headerWithin
      , most = pending
      , heartbeat = heartbeat
      , ping = ping
      , served = served
      , handler = handle
      }
      l
