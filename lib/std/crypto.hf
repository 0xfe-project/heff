-- Public-key signatures, as JSON Web Signatures have them (RFC 7518):
-- a message signed with a private key, which only its holder can do,
-- and verified with the public key, which anyone can.  Keys are read
-- from PEM -- PKCS#8 and SubjectPublicKeyInfo, and RSA's and EC's own
-- (`BEGIN RSA PRIVATE KEY`) -- or made from a JSON Web Key's fields,
-- each already decoded from base64url (std.base64's `decodeURL`).
--
-- | Algorithm | What signs | The key |
-- |---|---|---|
-- | `RS256` | RSASSA-PKCS1-v1_5, SHA-256 | RSA, 2048 bits or more |
-- | `PS256` | RSASSA-PSS, SHA-256, a salt of 32 bytes | RSA, 2048 bits or more |
-- | `ES256` | ECDSA, SHA-256; `r` and `s`, 32 bytes each | P-256 |
-- | `EdDSA` | Ed25519 | Ed25519 |
--
-- A key is read or made only if one of these signs with it: an RSA key
-- of fewer than `minRsaBits` bits (NIST SP 800-131A's least), or a key
-- of another curve or kind, is refused as it is read, not as it signs.
--
-- An effect, done by the host: OpenSSL's libcrypto, 3.0 or later, in a
-- C program alone (pkg-config's `libcrypto`, linked into every program
-- that imports the module).  A page cannot import it.  A key is the
-- host's, let go of when the program drops it.  A key or a signature
-- that cannot be made is `Left` of why, an `Error`; a signature that is
-- not the key's of the message, or not of the algorithm's shape, or by
-- a key of another kind, is not verified: `False`.
--
-- ```haskell
-- import bytes as Bytes
-- import co
-- import std.base64 as Base64
-- import std.crypto as Crypto
--
-- -- | a JWS's signing input, `header.payload`, signed by RS256 with a
-- -- | key read from PEM: the JWS, its signature after them
-- signed : {e : HFunctor}
--        -> {{c : Crypto.crypto <: e}}
--        -> String
--        -> String
--        -> Co e (Either Crypto.Error String)
-- signed pem input = do
--   key <- Crypto.privateKeyFromPem pem
--   case key of
--     Left why -> pure (Left why)
--     Right k -> do
--       s <- Crypto.sign RS256 k (Bytes.fromString input)
--       pure (case s of
--         Left why -> Left why
--         Right sig -> Right (input ^ "." ^ Base64.encodeURL sig))
-- ```

module std.crypto

import bytes as Bytes
import co
import ffi as FFI

-- | A private key, the host's: no value of the program has it.
data PrivateKey

-- | A public key, the host's.
data PublicKey

-- | What a signature is made by, as JWS names it (its `alg`).
data Algorithm = RS256 | PS256 | ES256 | EdDSA

-- | Why a key, or a signature, was not made:
-- |
-- | - `Unreadable why`, no key could be read of the PEM (its DER), and
-- |   what OpenSSL said of it;
-- | - `Encrypted`, the PEM's key is encrypted, which is not read;
-- | - `Unsupported kind`, the key is of a kind none of the algorithms
-- |   signs with (`"DSA"`; `"EC, secp384r1"`, a curve not P-256);
-- | - `InvalidKey why`, a JWK's fields are no key (a coordinate not of 32
-- |   bytes, a point not on the curve, no modulus, an exponent even or
-- |   less than 3), or a private key's numbers are none (a P-256
-- |   key's scalar 0 or the curve's order or more; an RSA key's modulus
-- |   or prime even, found as it signs);
-- | - `TooShort bits`, an RSA key's modulus of fewer than `minRsaBits`
-- |   bits, its own;
-- | - `WrongKey a`, a key not of the kind the algorithm signs with;
-- | - `Failed why`, OpenSSL failed of itself, where it had no room, and
-- |   said why.
data Error
  = Unreadable String
  | Encrypted
  | Unsupported String
  | InvalidKey String
  | TooShort Int
  | WrongKey Algorithm
  | Failed String

-- | The fewest bits of an RSA key's modulus, NIST SP 800-131A's: a key
-- | of fewer is refused.
minRsaBits : Int
minRsaBits = 2048

-- (what reading or making a key, or signing, came to, the host's: the
-- key or the signature, or why not, each taken of it by an operation;
-- why is the outcome's own, not left where another operation's
-- failure could be found in its place)
data Outcome

data CryptoF (m : Type -> Type) x
  = PrivatePem Bytes Int (Outcome -> x)
  | PublicPem Bytes Int (Outcome -> x)
  | RsaJwk Bytes Bytes Int (Outcome -> x)
  | P256Jwk Bytes Bytes (Outcome -> x)
  | Ed25519Jwk Bytes (Outcome -> x)
  | PublicOf PrivateKey (PublicKey -> x)
  | PublicPemOf PublicKey (String -> x)
  | Sign Int PrivateKey Bytes (Outcome -> x)
  | Verify Int PublicKey Bytes Bytes (Bool -> x)
  | PrivateKeyOf Outcome (Either FFI.Errno PrivateKey -> x)
  | PublicKeyOf Outcome (Either FFI.Errno PublicKey -> x)
  | SignatureOf Outcome (Either FFI.Errno Bytes -> x)
  | KindOf Outcome (Int -> x)
  | BitsOf Outcome (Int -> x)
  | WhyOf Outcome (String -> x)

-- | Signatures: keys read and made, messages signed and verified.
crypto : HFunctor
crypto =
  { f = CryptoF
  , hfmap = \m g p -> case p of
      PrivatePem pem b k -> PrivatePem pem b (\r -> g (k r))
      PublicPem pem b k -> PublicPem pem b (\r -> g (k r))
      RsaJwk n e b k -> RsaJwk n e b (\r -> g (k r))
      P256Jwk x y k -> P256Jwk x y (\r -> g (k r))
      Ed25519Jwk x k -> Ed25519Jwk x (\r -> g (k r))
      PublicOf key k -> PublicOf key (\r -> g (k r))
      PublicPemOf key k -> PublicPemOf key (\r -> g (k r))
      Sign a key msg k -> Sign a key msg (\r -> g (k r))
      Verify a key msg sig k -> Verify a key msg sig (\r -> g (k r))
      PrivateKeyOf o k -> PrivateKeyOf o (\r -> g (k r))
      PublicKeyOf o k -> PublicKeyOf o (\r -> g (k r))
      SignatureOf o k -> SignatureOf o (\r -> g (k r))
      KindOf o k -> KindOf o (\r -> g (k r))
      BitsOf o k -> BitsOf o (\r -> g (k r))
      WhyOf o k -> WhyOf o (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      PrivatePem pem b k -> PrivatePem pem b k
      PublicPem pem b k -> PublicPem pem b k
      RsaJwk n e b k -> RsaJwk n e b k
      P256Jwk x y k -> P256Jwk x y k
      Ed25519Jwk x k -> Ed25519Jwk x k
      PublicOf key k -> PublicOf key k
      PublicPemOf key k -> PublicPemOf key k
      Sign a key msg k -> Sign a key msg k
      Verify a key msg sig k -> Verify a key msg sig k
      PrivateKeyOf o k -> PrivateKeyOf o k
      PublicKeyOf o k -> PublicKeyOf o k
      SignatureOf o k -> SignatureOf o k
      KindOf o k -> KindOf o k
      BitsOf o k -> BitsOf o k
      WhyOf o k -> WhyOf o k
  }

-- (a key, as C has it: an `EVP_PKEY`, `EVP_PKEY_free` letting it go)
key : FFI.CType
key = FFI.pointer "EVP_PKEY" "EVP_PKEY_free"

-- (an outcome, as C has it: the module's C's `CrOutcome`)
outcome : FFI.CType
outcome = FFI.pointer "CrOutcome" "cr_outcome_free"

-- | The operations, each a function of the module's C, on OpenSSL's.
cryptoInC : FFI.Described
cryptoInC =
  FFI.describe
    ["<openssl/evp.h>"]
    [ FFI.operation
      "PrivatePem"
      (FFI.fun "cr_private_pem" [FFI.bytes, FFI.int] (FFI.gives outcome))
    , FFI.operation
      "PublicPem"
      (FFI.fun "cr_public_pem" [FFI.bytes, FFI.int] (FFI.gives outcome))
    , FFI.operation
      "RsaJwk"
      (FFI.fun
         "cr_rsa_jwk"
         [FFI.bytes, FFI.bytes, FFI.int]
         (FFI.gives outcome))
    , FFI.operation
      "P256Jwk"
      (FFI.fun "cr_p256_jwk" [FFI.bytes, FFI.bytes] (FFI.gives outcome))
    , FFI.operation
      "Ed25519Jwk"
      (FFI.fun "cr_ed25519_jwk" [FFI.bytes] (FFI.gives outcome))
    , FFI.operation "PublicOf" (FFI.fun "cr_public_of" [key] (FFI.gives key))
    , FFI.operation
      "PublicPemOf"
      (FFI.fun "cr_public_pem_of" [key] (FFI.gives FFI.ownedString))
    , FFI.operation
      "Sign"
      (FFI.fun
         "cr_sign"
         [FFI.int, key, FFI.bytes]
         (FFI.gives outcome))
    , FFI.operation
      "Verify"
      (FFI.fun
         "cr_verify"
         [FFI.int, key, FFI.bytes, FFI.bytes]
         (FFI.gives FFI.bool))
    , FFI.operation
      "PrivateKeyOf"
      (FFI.fun "cr_outcome_key" [outcome] (FFI.givesOrErrno key))
    , FFI.operation
      "PublicKeyOf"
      (FFI.fun "cr_outcome_key" [outcome] (FFI.givesOrErrno key))
    , FFI.operation
      "SignatureOf"
      (FFI.fun "cr_outcome_signature" [outcome] (FFI.givesOrErrno FFI.bytes))
    , FFI.operation
      "KindOf"
      (FFI.fun "cr_outcome_kind" [outcome] (FFI.gives FFI.int))
    , FFI.operation
      "BitsOf"
      (FFI.fun "cr_outcome_bits" [outcome] (FFI.gives FFI.int))
    , FFI.operation
      "WhyOf"
      (FFI.fun "cr_outcome_why" [outcome] (FFI.gives FFI.string))
    ]

-- | What the module's C is linked with: libcrypto.
cryptoLinks : FFI.Links
cryptoLinks = { pkgConfig = ["libcrypto"] }

-- | The algorithm's name, JWS's `alg`.
-- | >>> name ES256
-- | "ES256"
name : Algorithm -> String
name RS256 = "RS256"
name PS256 = "PS256"
name ES256 = "ES256"
name EdDSA = "EdDSA"

-- | The algorithm JWS names so, if it is one of these.
-- | >>> maybe "none" name (named "EdDSA")
-- | "EdDSA"
-- | >>> maybe "none" name (named "HS256")
-- | "none"
named : String -> Maybe Algorithm
named "RS256" = Just RS256
named "PS256" = Just PS256
named "ES256" = Just ES256
named "EdDSA" = Just EdDSA
named _ = Nothing

-- | As JWS names it.
-- | >>> show (PS256 : Algorithm)
-- | "PS256"
instance instanceShowAlgorithm : Show Algorithm
instanceShowAlgorithm = { show = name }

-- | The same algorithm.
-- | >>> (RS256 : Algorithm) == RS256 && (RS256 : Algorithm) /= PS256
-- | True
instance instanceEqualityAlgorithm : Equality Algorithm
instanceEqualityAlgorithm = { equal = \x y -> strEq (name x) (name y) }

-- | Why, as a line.
-- | >>> show (TooShort 1024 : Error)
-- | "an RSA key of 1024 bits, fewer than 2048"
-- | >>> show (WrongKey ES256 : Error)
-- | "not a key ES256 signs with"
instance instanceShowError : Show Error
instanceShowError = { show = line }
  where
  line : Error -> String
  line (Unreadable why) = "no key in the PEM: " ^ why
  line Encrypted = "an encrypted key"
  line (Unsupported kind) = "a key of a kind no algorithm signs with: " ^ kind
  line (InvalidKey why) = "not a key: " ^ why
  line (TooShort bits) =
    "an RSA key of "
    ^ show bits
    ^ " bits, fewer than "
    ^ show minRsaBits
  line (WrongKey a) = "not a key " ^ name a ^ " signs with"
  line (Failed why) = why

-- (the algorithm, as the module's C numbers it)
codeOf : Algorithm -> Int
codeOf RS256 = 0
codeOf PS256 = 1
codeOf ES256 = 2
codeOf EdDSA = 3

-- (a failure of the kind the module's C numbers so, of an RSA key's bits
-- and why)
failure : Int -> Int -> String -> Error
failure 1 _ why = Unreadable why
failure 2 _ _ = Encrypted
failure 3 _ why = Unsupported why
failure 4 _ why = InvalidKey why
failure 5 bits _ = TooShort bits
failure _ _ why = Failed why

-- (... of signing by the algorithm: a key of another kind)
signFailure : Algorithm -> Int -> Int -> String -> Error
signFailure a 6 _ _ = WrongKey a
signFailure _ kind bits why = failure kind bits why

-- (what was taken of the outcome, or, nothing there, an error of the
-- kind, the bits and why the outcome says)
said : {e : HFunctor}
     -> {a : Type}
     -> {{ev : crypto <: e}}
     -> (Int -> Int -> String -> Error)
     -> Outcome
     -> Either FFI.Errno a
     -> Co e (Either Error a)
said _ _ (Right x) = pure (Right x)
said f o (Left _) = do
  kind <- op (ev (KindOf o (\n -> n))) val
  bits <- op (ev (BitsOf o (\n -> n))) val
  why <- op (ev (WhyOf o (\s -> s))) val
  pure (Left (f kind bits why))

-- (the private key of the outcome, or why not)
privateKeyIn : {e : HFunctor}
             -> {{ev : crypto <: e}}
             -> Outcome
             -> Co e (Either Error PrivateKey)
privateKeyIn o = do
  r <- op (ev (PrivateKeyOf o (\r -> r))) val
  said failure o r

-- (the public key of the outcome, or why not)
publicKeyIn : {e : HFunctor}
            -> {{ev : crypto <: e}}
            -> Outcome
            -> Co e (Either Error PublicKey)
publicKeyIn o = do
  r <- op (ev (PublicKeyOf o (\r -> r))) val
  said failure o r

-- | The private key a PEM holds: PKCS#8 (`BEGIN PRIVATE KEY`), or RSA's
-- | or EC's own (`BEGIN RSA PRIVATE KEY`, `BEGIN EC PRIVATE KEY`); not
-- | one encrypted (`Encrypted`), nor one no algorithm signs with
-- | (`Unsupported`, `TooShort`).
privateKeyFromPem : {e : HFunctor}
                  -> {{ev : crypto <: e}}
                  -> String
                  -> Co e (Either Error PrivateKey)
privateKeyFromPem pem = do
  o <- op (ev (PrivatePem (Bytes.fromString pem) minRsaBits (\o -> o))) val
  privateKeyIn o

-- | The public key a PEM holds: SubjectPublicKeyInfo
-- | (`BEGIN PUBLIC KEY`), or RSA's own (`BEGIN RSA PUBLIC KEY`); not one
-- | no algorithm verifies with (`Unsupported`, `TooShort`).
publicKeyFromPem : {e : HFunctor}
                 -> {{ev : crypto <: e}}
                 -> String
                 -> Co e (Either Error PublicKey)
publicKeyFromPem pem = do
  o <- op (ev (PublicPem (Bytes.fromString pem) minRsaBits (\o -> o))) val
  publicKeyIn o

-- | An RSA public key, of a JWK's `n` and `e`: the modulus, of
-- | `minRsaBits` bits or more (else `TooShort`), and the exponent, odd
-- | and 3 or more (else `InvalidKey`), big-endian.
rsaPublicKey : {e : HFunctor}
             -> {{ev : crypto <: e}}
             -> Bytes
             -> Bytes
             -> Co e (Either Error PublicKey)
rsaPublicKey n x = do
  o <- op (ev (RsaJwk n x minRsaBits (\o -> o))) val
  publicKeyIn o

-- | A P-256 public key, of a JWK's `x` and `y` (its `crv` `P-256`): the
-- | point's coordinates, 32 bytes each, a point of the curve (else
-- | `InvalidKey`).
p256PublicKey : {e : HFunctor}
              -> {{ev : crypto <: e}}
              -> Bytes
              -> Bytes
              -> Co e (Either Error PublicKey)
p256PublicKey x y = do
  o <- op (ev (P256Jwk x y (\o -> o))) val
  publicKeyIn o

-- | An Ed25519 public key, of a JWK's `x` (its `crv` `Ed25519`): 32
-- | bytes (else `InvalidKey`).
ed25519PublicKey : {e : HFunctor}
                 -> {{ev : crypto <: e}}
                 -> Bytes
                 -> Co e (Either Error PublicKey)
ed25519PublicKey x = do
  o <- op (ev (Ed25519Jwk x (\o -> o))) val
  publicKeyIn o

-- | The public key of a private one, a key of its own, nothing private
-- | in it: what verifies what it signs.
publicOf : {e : HFunctor}
         -> {{ev : crypto <: e}}
         -> PrivateKey
         -> Co e PublicKey
publicOf k = op (ev (PublicOf k (\r -> r))) val

-- | The message signed by the algorithm with the key: `WrongKey` where
-- | the key is not of the algorithm's kind.
sign : {e : HFunctor}
     -> {{ev : crypto <: e}}
     -> Algorithm
     -> PrivateKey
     -> Bytes
     -> Co e (Either Error Bytes)
sign a k msg = do
  o <- op (ev (Sign (codeOf a) k msg (\o -> o))) val
  r <- op (ev (SignatureOf o (\r -> r))) val
  said (signFailure a) o r

-- | `verify a key message signature`: whether the signature is the
-- | key's of the message, by the algorithm.
verify : {e : HFunctor}
       -> {{ev : crypto <: e}}
       -> Algorithm
       -> PublicKey
       -> Bytes
       -> Bytes
       -> Co e Bool
verify a k msg sig = op (ev (Verify (codeOf a) k msg sig (\r -> r))) val

-- | The public key as PEM, SubjectPublicKeyInfo (`BEGIN PUBLIC KEY`).
publicKeyToPem : {e : HFunctor}
               -> {{ev : crypto <: e}}
               -> PublicKey
               -> Co e String
publicKeyToPem k = op (ev (PublicPemOf k (\r -> r))) val
