-- The functions of a float: the trigonometric ones (of an angle in
-- radians), the exponential and the logarithm, powers, rounding, and
-- the constants `pi` and `e` (`sqrt` and `floor` are the prelude's).
-- The primitives are JavaScript's `Math` and C's libm, which may differ
-- in the last place of what they compute (`tan 1.0`, by a unit there):
-- a program whose output must be the same on each backend shows fewer
-- places than a float has.

-- (each a `Float`'s, a 64-bit float's; a Float32's would be beside it,
-- `float32Sin` and the like: C's `sinf`, JavaScript's `Math.fround` of
-- `Math.sin`)
primitive floatSin : Float -> Float
primitive floatCos : Float -> Float
primitive floatTan : Float -> Float
primitive floatAsin : Float -> Float
primitive floatAcos : Float -> Float
primitive floatAtan : Float -> Float
primitive floatAtan2 : Float -> Float -> Float
primitive floatExp : Float -> Float
primitive floatLog : Float -> Float
primitive floatPow : Float -> Float -> Float

-- | π, a circle's circumference over its diameter.
pi : Float
pi = 3.141592653589793

-- | e, the base of the natural logarithm.
e : Float
e = 2.718281828459045

-- | The sine of an angle in radians.
-- | >>> sin 0.0
-- | 0.0
sin : Float -> Float
sin = floatSin

-- | The cosine of an angle in radians.
-- | >>> cos pi
-- | -1.0
cos : Float -> Float
cos = floatCos

-- | The tangent of an angle in radians.
-- | >>> tan 0.0
-- | 0.0
tan : Float -> Float
tan = floatTan

-- | The angle whose sine is `x`, from -π/2 to π/2.
-- | >>> asin 1.0
-- | 1.5707963267948966
asin : Float -> Float
asin = floatAsin

-- | The angle whose cosine is `x`, from 0 to π.
-- | >>> acos (-1.0)
-- | 3.141592653589793
acos : Float -> Float
acos = floatAcos

-- | The angle whose tangent is `x`, from -π/2 to π/2.
-- | >>> atan 1.0
-- | 0.7853981633974483
atan : Float -> Float
atan = floatAtan

-- | `atan2 y x`: the angle of the point (x, y), from -π to π.
-- | >>> atan2 1.0 (-1.0)
-- | 2.356194490192345
-- | >>> atan2 0.0 (-1.0)
-- | 3.141592653589793
atan2 : Float -> Float -> Float
atan2 = floatAtan2

-- | e to the power `x`.
-- | >>> exp 1.0
-- | 2.718281828459045
exp : Float -> Float
exp = floatExp

-- | The natural logarithm; of 0, `-Infinity`; below 0, `NaN`.
-- | >>> log e
-- | 1.0
-- | >>> log 0.0
-- | -Infinity
log : Float -> Float
log = floatLog

-- | `pow x y`: `x` to the power `y` (as C's `pow`: 1 to any power is 1,
-- | `NaN` too, and so is -1 to an infinite one).
-- | >>> pow 2.0 10.0
-- | 1024.0
-- | >>> pow 1.0 (0.0 /. 0.0)
-- | 1.0
pow : Float -> Float -> Float
pow = floatPow

-- | `x` without its sign.
-- | >>> abs (-2.5)
-- | 2.5
abs : Float -> Float
abs x = if x <=. 0.0 then 0.0 -. x else x

-- | The lesser of two floats (the prelude's `min` is an `Int`'s).
-- | >>> minFloat 1.5 (-2.0)
-- | -2.0
minFloat : Float -> Float -> Float
minFloat a b = if a <=. b then a else b

-- | The greater of two floats.
-- | >>> maxFloat 1.5 (-2.0)
-- | 1.5
maxFloat : Float -> Float -> Float
maxFloat a b = if a <=. b then b else a

-- | The least whole number not below `x`, as the prelude's `floor` is
-- | the greatest not above it; of what is not finite, `abandon`.
-- | >>> ceil 2.1
-- | 3
-- | >>> ceil (-2.9)
-- | -2
ceil : Float -> Int
ceil x = 0 - floor (0.0 -. x)

-- | The whole number nearest `x`, a half away from 0 (as C's `round`);
-- | of what is not finite, `abandon`.
-- | >>> round 2.5
-- | 3
-- | >>> round (-2.5)
-- | -3
-- | >>> round 0.49999999999999994
-- | 0
round : Float -> Int
round x = if x <. 0.0 then 0 - halfUp (0.0 -. x) else halfUp x
  where
    -- (of a float not below 0, a half up; `y -. floor y` is exact)
    halfUp : Float -> Int
    halfUp y = if y -. toFloat (floor y) >=. 0.5 then floor y + 1 else floor y
