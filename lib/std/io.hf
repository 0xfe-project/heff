-- The standard streams as an effect (lib/co.hf): what a program writes,
-- to its output and to its error stream, and all of its input.  `heff
-- node` has a handler for it; a program of more worlds than this one sums
-- effects, `stdio <+> fs`, and lifts (`lift inl`, lib/co.hf).

import co

data StdioF (m : Type -> Type) x
  = Write String x
  | WriteErr String x
  | ReadStdin (String -> x)

-- | The standard streams as an effect.
stdio : HFunctor
stdio =
  { f = StdioF
  , hfmap = \fm g p -> case p of
      Write str x -> Write str (g x)
      WriteErr str x -> WriteErr str (g x)
      ReadStdin k -> ReadStdin (\s -> g (k s))
  , hmap = \nt p -> case p of
      Write str x -> Write str x
      WriteErr str x -> WriteErr str x
      ReadStdin k -> ReadStdin k
  }

-- | Write to the standard output, as it is: in any effect the standard
-- | streams are in, by the evidence (as lib/state.hf's `get`).
write : {e : HFunctor} -> {{ev : stdio <: e}} -> String -> Co e Unit
write str = op (ev (Write str MkUnit)) val

-- | Write a line to the standard output.
print : {e : HFunctor} -> {{ev : stdio <: e}} -> String -> Co e Unit
print str = write (str ^ "\n")

-- | Write a line to the standard error.
writeErr : {e : HFunctor} -> {{ev : stdio <: e}} -> String -> Co e Unit
writeErr str = op (ev (WriteErr str MkUnit)) val

printErr : {e : HFunctor} -> {{ev : stdio <: e}} -> String -> Co e Unit
printErr str = op (ev (WriteErr (str ^ "\n") MkUnit)) val

-- | All of the standard input, when it has ended.
readStdin : {e : HFunctor} -> {{ev : stdio <: e}} -> Co e String
readStdin = op (ev (ReadStdin (\s -> s))) val
