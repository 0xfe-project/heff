-- Domains as an effect, as OCaml 5's: computations run truly at once,
-- each on a thread of the system of its own, and what synchronises
-- them -- cells every domain reads and writes (`Atomic`), mutexes and
-- conditions.  The base a scheduler is written on, in heff: its workers
-- are domains.  Import it by a name, `import std.domain as Domain`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import co
-- import std.domain as Domain
-- import std.io
--
-- -- | `n` added to the counter, one at a time
-- adding : {e : HFunctor}
--        -> {{dm : Domain.domain <: e}}
--        -> Domain.Atomic Int
--        -> Int
--        -> Co e Unit
-- adding counter 0 = pure ()
-- adding counter n = do
--   _ <- Domain.fetchAdd counter 1
--   adding counter (n - 1)
--
-- counted : {e : HFunctor}
--         -> {{io : stdio <: e}}
--         -> {{dm : Domain.domain <: e}}
--         -> Co e Unit
-- counted = do
--   counter <- Domain.newAtomic 0
--   one <- Domain.spawn (adding counter 1000)
--   two <- Domain.spawn (adding counter 1000)
--   Domain.join one
--   Domain.join two
--   n <- Domain.get counter
--   print (show n)
-- ```
--
-- Operation | What it does
-- --- | ---
-- `spawn c` | `c` run on a domain of its own; this one goes on
-- `join d` | the domain's answer, waiting for it to end
-- `cores` | how many domains the machine runs at once
-- `newAtomic v` | a cell holding `v`, for every domain
-- `get a` / `set a v` | what it holds; ... and it holds `v` now
-- `cas a seen v` | it holds `v` now, where it held `seen`: whether it did
-- `fetchAdd a n` | `n` added to the number it holds: what it held
-- `newMutex` / `lock m` / `unlock m` | a mutex, held by one domain at a time
-- `newCondition` | a condition, for domains to wait on
-- `wait c m` | `m` let go of, until the condition is signalled, then held again
-- `signal c` / `broadcast c` | one domain waiting on `c` woken; ... every one
-- `newQueue` | a queue, for every domain: what is put in it is taken out once
-- `put q v` / `take q` | `v` put at the back, never waiting; the front taken out, waiting while empty
--
-- `cas` compares by identity, as OCaml's `Atomic.compare_and_set`: a
-- number of a word or a constructor without fields is itself, anything
-- else the value that was read, not an equal one built again.  A `wait` may end
-- without a signal: what it waits for is checked again, in a loop.  A
-- domain's failure is its joiner's, as it failed.  What is put in a queue
-- is handed to the one domain that takes it, first in first out: a
-- `take` waits while the queue is empty, a `put` never waits.
--
-- What runs the domains is the backend's runtime, the program the same
-- on each.  A domain, a cell, a mutex and a condition are the
-- runtime's own, held by the program as values of no constructor, and
-- each is freed with the program's last reference to it -- a cell
-- letting go of what it holds, a domain of its answer.  The C
-- backend's (domain.provider.c): a domain is a thread of the system, a
-- cell is changed atomically, a mutex and a condition are the system's.
-- What a domain gives back is shared (`heff_share`), not copied; what a
-- domain is given, and what is put in a queue, is moved where the
-- domain giving it held it alone (`heff_move`: counted by the taker
-- alone from then on), and shared otherwise.  A domain whose last reference goes while
-- it still runs is freed as its thread ends.  The program ends where
-- `main` does, domains not joined with it.
--
-- JavaScript's (domain.provider.js): one domain, as one core runs
-- threads.  The domains take turns, each at its operations of this
-- effect: at each, the others ready go first, so a domain waiting for
-- a cell another changes lets it be changed.  One waiting on a mutex,
-- a condition or a domain's end waits there, the others going on.
-- `cores` is 1.  A program whose domains all wait, for one another,
-- stops there, said by nothing: the page cannot tell it from one
-- waiting for something of the world's.

module std.domain
  ( domain
  , Domain
  , Atomic
  , Mutex
  , Condition
  , Queue
  , spawn
  , join
  , cores
  , newAtomic
  , get
  , set
  , cas
  , fetchAdd
  , newMutex
  , lock
  , unlock
  , newCondition
  , wait
  , signal
  , broadcast
  , newQueue
  , put
  , take
  )

import co

-- | A domain whose answer is an `a`.  (The runtime's own, a foreign
-- | value: no value of the program has it.)
data Domain a

-- | A cell holding an `a`, for every domain.  (The runtime's own, a
-- | foreign value: no value of the program has it.)
data Atomic a

-- | A mutex.  (The runtime's own, a foreign value: no value of the
-- | program has it.)
data Mutex

-- | A condition.  (The runtime's own, a foreign value: no value of the
-- | program has it.)
data Condition

-- | A queue of `a`s, for every domain: what one domain puts in, exactly
-- | one domain takes out, first in first out.  (The runtime's own, a
-- | foreign value: no value of the program has it.)
data Queue a

-- | A value of some type, the type hidden: what an operation of a type
-- | of its own holds (the effect has no parameter for it).
type Some (f : Type -> Type) = (r : Type) -> ((a : Type) -> f a -> r) -> r

-- (what it holds, changed, of whatever type)
someThen : {f g : Type -> Type}
         -> ({a : Type} -> f a -> g a)
         -> Some f
         -> Some g
someThen h s = \r use -> s r (\a v -> use a (h v))

data Spawning (m : Type -> Type) x a = MkSpawning (m a) (Domain a -> x)

data Joining x a = MkJoining (Domain a) (a -> x)

data Making x a = MkMaking a (Atomic a -> x)

data Reading x a = MkReading (Atomic a) (a -> x)

data Writing x a = MkWriting (Atomic a) a x

data Comparing x a = MkComparing (Atomic a) a a (Bool -> x)

data MakingQueue x a = MkMakingQueue (Queue a -> x)

data Putting x a = MkPutting (Queue a) a x

data Taking x a = MkTaking (Queue a) (a -> x)

spawningThen : {m : Type -> Type}
             -> {x y a : Type}
             -> (x -> y)
             -> Spawning m x a
             -> Spawning m y a
spawningThen g (MkSpawning c k) = MkSpawning c (\d -> g (k d))

spawningBy : {m n : Type -> Type}
           -> {x a : Type}
           -> ({t : Type} -> m t -> n t)
           -> Spawning m x a
           -> Spawning n x a
spawningBy nt (MkSpawning c k) = MkSpawning (nt c) k

joiningThen : {x y a : Type} -> (x -> y) -> Joining x a -> Joining y a
joiningThen g (MkJoining d k) = MkJoining d (\v -> g (k v))

makingThen : {x y a : Type} -> (x -> y) -> Making x a -> Making y a
makingThen g (MkMaking v k) = MkMaking v (\at -> g (k at))

readingThen : {x y a : Type} -> (x -> y) -> Reading x a -> Reading y a
readingThen g (MkReading at k) = MkReading at (\v -> g (k v))

writingThen : {x y a : Type} -> (x -> y) -> Writing x a -> Writing y a
writingThen g (MkWriting at v x) = MkWriting at v (g x)

comparingThen : {x y a : Type} -> (x -> y) -> Comparing x a -> Comparing y a
comparingThen g (MkComparing at seen v k) =
  MkComparing at seen v (\b -> g (k b))

makingQueueThen : {x y a : Type}
                -> (x -> y)
                -> MakingQueue x a
                -> MakingQueue y a
makingQueueThen g (MkMakingQueue k) = MkMakingQueue (\q -> g (k q))

puttingThen : {x y a : Type} -> (x -> y) -> Putting x a -> Putting y a
puttingThen g (MkPutting q v x) = MkPutting q v (g x)

takingThen : {x y a : Type} -> (x -> y) -> Taking x a -> Taking y a
takingThen g (MkTaking q k) = MkTaking q (\v -> g (k v))

data DomainF (m : Type -> Type) x
  = Spawn (Some (Spawning m x))
  | Join (Some (Joining x))
  | Cores (Int -> x)
  | NewAtomic (Some (Making x))
  | GetAtomic (Some (Reading x))
  | SetAtomic (Some (Writing x))
  | CasAtomic (Some (Comparing x))
  | FetchAdd (Atomic Int) Int (Int -> x)
  | NewMutex (Mutex -> x)
  | Lock Mutex x
  | Unlock Mutex x
  | NewCondition (Condition -> x)
  | Wait Condition Mutex x
  | Signal Condition x
  | Broadcast Condition x
  | NewQueue (Some (MakingQueue x))
  | PutQueue (Some (Putting x))
  | TakeQueue (Some (Taking x))

-- | Domains as an effect.
domain : HFunctor
domain =
  { f = DomainF
  , hfmap = \m g p -> case p of
      Spawn s -> Spawn (someThen (spawningThen g) s)
      Join s -> Join (someThen (joiningThen g) s)
      Cores k -> Cores (\n -> g (k n))
      NewAtomic s -> NewAtomic (someThen (makingThen g) s)
      GetAtomic s -> GetAtomic (someThen (readingThen g) s)
      SetAtomic s -> SetAtomic (someThen (writingThen g) s)
      CasAtomic s -> CasAtomic (someThen (comparingThen g) s)
      FetchAdd at n k -> FetchAdd at n (\o -> g (k o))
      NewMutex k -> NewMutex (\mu -> g (k mu))
      Lock mu x -> Lock mu (g x)
      Unlock mu x -> Unlock mu (g x)
      NewCondition k -> NewCondition (\cd -> g (k cd))
      Wait cd mu x -> Wait cd mu (g x)
      Signal cd x -> Signal cd (g x)
      Broadcast cd x -> Broadcast cd (g x)
      NewQueue s -> NewQueue (someThen (makingQueueThen g) s)
      PutQueue s -> PutQueue (someThen (puttingThen g) s)
      TakeQueue s -> TakeQueue (someThen (takingThen g) s)
  , hmap = \m n nt p -> case p of
      Spawn s -> Spawn (someThen (spawningBy nt) s)
      Join s -> Join s
      Cores k -> Cores k
      NewAtomic s -> NewAtomic s
      GetAtomic s -> GetAtomic s
      SetAtomic s -> SetAtomic s
      CasAtomic s -> CasAtomic s
      FetchAdd at v k -> FetchAdd at v k
      NewMutex k -> NewMutex k
      Lock mu x -> Lock mu x
      Unlock mu x -> Unlock mu x
      NewCondition k -> NewCondition k
      Wait cd mu x -> Wait cd mu x
      Signal cd x -> Signal cd x
      Broadcast cd x -> Broadcast cd x
      NewQueue s -> NewQueue s
      PutQueue s -> PutQueue s
      TakeQueue s -> TakeQueue s
  }

-- Domains
--------------------------------------------------------------------------------

-- | `c` run on a domain of its own; this one goes on.  `join` waits for
-- | its answer.
spawn : {e : HFunctor}
      -> {a : Type}
      -> {{dm : domain <: e}}
      -> Co e a
      -> Co e (Domain a)
spawn c = op (dm (Spawn (\r use -> use a (MkSpawning c (\d -> d))))) val

-- | The domain's answer, waiting for it to end; where it failed, this
-- | one fails as it did.
join : {e : HFunctor}
     -> {a : Type}
     -> {{dm : domain <: e}}
     -> Domain a
     -> Co e a
join d = op (dm (Join (\r use -> use a (MkJoining d (\v -> v))))) val

-- | How many domains the machine runs at once: its cores, as the system
-- | says (1 where it does not).
cores : {e : HFunctor} -> {{dm : domain <: e}} -> Co e Int
cores = op (dm (Cores (\n -> n))) val

-- Cells
--------------------------------------------------------------------------------

-- | A cell holding `v`, for every domain.
newAtomic : {e : HFunctor}
          -> {a : Type}
          -> {{dm : domain <: e}}
          -> a
          -> Co e (Atomic a)
newAtomic v = op (dm (NewAtomic (\r use -> use a (MkMaking v (\at -> at))))) val

-- | What the cell holds.
get : {e : HFunctor} -> {a : Type} -> {{dm : domain <: e}} -> Atomic a -> Co e a
get at = op (dm (GetAtomic (\r use -> use a (MkReading at (\v -> v))))) val

-- | ... and it holds `v` now.
set : {e : HFunctor}
    -> {a : Type}
    -> {{dm : domain <: e}}
    -> Atomic a
    -> a
    -> Co e Unit
set at v = op (dm (SetAtomic (\r use -> use a (MkWriting at v MkUnit)))) val

-- | The cell holds `v` now, where it held `seen` (compared by identity):
-- | whether it did.
cas : {e : HFunctor}
    -> {a : Type}
    -> {{dm : domain <: e}}
    -> Atomic a
    -> a
    -> a
    -> Co e Bool
cas at seen v =
  op (dm (CasAtomic (\r use -> use a (MkComparing at seen v (\b -> b))))) val

-- | `n` added to the number the cell holds: what it held.
fetchAdd : {e : HFunctor}
         -> {{dm : domain <: e}}
         -> Atomic Int
         -> Int
         -> Co e Int
fetchAdd at n = op (dm (FetchAdd at n (\o -> o))) val

-- Mutexes and conditions
--------------------------------------------------------------------------------

-- | A mutex, held by no domain.
newMutex : {e : HFunctor} -> {{dm : domain <: e}} -> Co e Mutex
newMutex = op (dm (NewMutex (\mu -> mu))) val

-- | The mutex held by this domain, waiting while another holds it.
lock : {e : HFunctor} -> {{dm : domain <: e}} -> Mutex -> Co e Unit
lock mu = op (dm (Lock mu MkUnit)) val

-- | ... let go of: it fails where this domain does not hold it.
unlock : {e : HFunctor} -> {{dm : domain <: e}} -> Mutex -> Co e Unit
unlock mu = op (dm (Unlock mu MkUnit)) val

-- | A condition, for domains to wait on.
newCondition : {e : HFunctor} -> {{dm : domain <: e}} -> Co e Condition
newCondition = op (dm (NewCondition (\cd -> cd))) val

-- | The mutex, held by this domain, let go of until the condition is
-- | signalled, and held again before it goes on.  It may end without a
-- | signal: what it waits for is checked again.
wait : {e : HFunctor} -> {{dm : domain <: e}} -> Condition -> Mutex -> Co e Unit
wait cd mu = op (dm (Wait cd mu MkUnit)) val

-- | One domain waiting on the condition woken, if one is.
signal : {e : HFunctor} -> {{dm : domain <: e}} -> Condition -> Co e Unit
signal cd = op (dm (Signal cd MkUnit)) val

-- | Every domain waiting on the condition woken.
broadcast : {e : HFunctor} -> {{dm : domain <: e}} -> Condition -> Co e Unit
broadcast cd = op (dm (Broadcast cd MkUnit)) val

-- Queues
--------------------------------------------------------------------------------

-- | A queue, for every domain, holding nothing yet.
newQueue : {e : HFunctor}
         -> {a : Type}
         -> {{dm : domain <: e}}
         -> Co e (Queue a)
newQueue = op (dm (NewQueue (\r use -> use a (MkMakingQueue (\q -> q))))) val

-- | `v` put at the back of the queue, for one domain to take; never
-- | waits.
put : {e : HFunctor}
    -> {a : Type}
    -> {{dm : domain <: e}}
    -> Queue a
    -> a
    -> Co e Unit
put q v = op (dm (PutQueue (\r use -> use a (MkPutting q v MkUnit)))) val

-- | The front of the queue taken out, this domain's alone now; waits
-- | while the queue is empty.
take : {e : HFunctor} -> {a : Type} -> {{dm : domain <: e}} -> Queue a -> Co e a
take q = op (dm (TakeQueue (\r use -> use a (MkTaking q (\v -> v))))) val
