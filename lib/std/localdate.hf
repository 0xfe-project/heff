-- Dates of the ISO calendar -- the proleptic Gregorian one, of today,
-- taken back before it was made and on without end -- with no time of
-- day and no zone: a date on a calendar on the wall, the 29th of
-- February 2024, which is no instant, as it begins at a different one
-- in each place.  NodaTime's `LocalDate` is the model.  Any year is a
-- year, the year before 1 the year 0 and the one before it -1, and the
-- days are counted, not gone through (Howard Hinnant's
-- `days_from_civil` and `civil_from_days`).  A date and a time of day
-- (std.localtime) make a std.localdatetime; std.period counts what lies
-- between two dates.  Import it by a name,
-- `import std.localdate as LocalDate`, as its names are short.
--
-- ```haskell
-- import std.localdate as LocalDate
--
-- -- | the last day of the month the date is in
-- -- | >>> maybe "" (\d -> toString (lastOfMonth d)) (LocalDate.parse "2024-02-10")
-- -- | "2024-02-29"
-- lastOfMonth : LocalDate.LocalDate -> LocalDate.LocalDate
-- lastOfMonth d =
--   LocalDate.plusDays
--     d
--     (LocalDate.daysInMonth (LocalDate.year d) (LocalDate.month d)
--      - LocalDate.day d)
-- ```

module std.localdate
  ( DayOfWeek(..)
  , LocalDate
  , make
  , year
  , month
  , day
  , dayOfWeek
  , dayOfYear
  , isLeapYear
  , daysInMonth
  , fromEpochDays
  , epochDays
  , plusDays
  , plusMonths
  , plusYears
  , parse
  , instanceEqualityDayOfWeek
  , instanceShowDayOfWeek
  , instanceToStringDayOfWeek
  , instanceEqualityLocalDate
  , instanceOrderLocalDate
  , instanceShowLocalDate
  , instanceToStringLocalDate
  )

-- | A day of the week, ISO 8601's: Monday first.
data DayOfWeek
  = Monday
  | Tuesday
  | Wednesday
  | Thursday
  | Friday
  | Saturday
  | Sunday

-- | The same day.
instance instanceEqualityDayOfWeek : Equality DayOfWeek
instanceEqualityDayOfWeek = { equal = \x y -> dayNumber x == dayNumber y }
  where
  -- (the day's place in the week, 1 for Monday to 7 for Sunday, as ISO
  -- 8601 numbers them)
  dayNumber : DayOfWeek -> Int
  dayNumber Monday = 1
  dayNumber Tuesday = 2
  dayNumber Wednesday = 3
  dayNumber Thursday = 4
  dayNumber Friday = 5
  dayNumber Saturday = 6
  dayNumber Sunday = 7

-- (the day's name, as its tag is written)
dayName : DayOfWeek -> String
dayName Monday = "Monday"
dayName Tuesday = "Tuesday"
dayName Wednesday = "Wednesday"
dayName Thursday = "Thursday"
dayName Friday = "Friday"
dayName Saturday = "Saturday"
dayName Sunday = "Sunday"

-- | As its tag: `Monday`.
instance instanceShowDayOfWeek : Show DayOfWeek
instanceShowDayOfWeek = { show = dayName }

-- | Its name, in English: `Monday`.
-- | >>> toString (Sunday : DayOfWeek)
-- | "Sunday"
instance instanceToStringDayOfWeek : ToString DayOfWeek
instanceToStringDayOfWeek = { toString = dayName }

-- | A date: its year, its month 1 to 12 and its day 1 to the month's
-- | last, as `make` checks them.
data LocalDate = MkLocalDate Int Int Int

-- | Whether the year has a February 29: one divided by 4, but not by 100
-- | unless by 400.
-- | >>> List.map isLeapYear [2024, 2023, 2000, 1900, 0, -4, -100]
-- | [True, False, True, False, True, True, False]
isLeapYear : Int -> Bool
isLeapYear y = y % 4 == 0 && (y % 100 /= 0 || y % 400 == 0)

-- | How many days the month 1 to 12 of the year has; a month out of 1
-- | to 12, none.
-- | >>> List.map (daysInMonth 2024) [1, 2, 4, 12, 0, 13]
-- | [31, 29, 30, 31, 0, 0]
-- | >>> daysInMonth 2023 2
-- | 28
daysInMonth : Int -> Int -> Int
daysInMonth y m =
  if m < 1 || m > 12 then 0
  else if m == 2
  then (if isLeapYear y then 29 else 28)
  else if m == 4 || m == 6 || m == 9 || m == 11
  then 30
  else 31

-- | The date of the year, month and day, if the month is 1 to 12 and
-- | the day 1 to the month's last; nothing if not.
-- | >>> make 2024 2 29
-- | Just (MkLocalDate 2024 2 29)
-- | >>> (List.map (\m -> maybe False (\_ -> True) (make 2023 m 29)) [2, 13] : List Bool)
-- | [False, False]
-- | >>> (List.map (\d -> maybe True (\_ -> False) d) [make 2024 0 1, make 2024 4 31, make 2024 1 0, make 2100 2 29] : List Bool)
-- | [True, True, True, True]
make : Int -> Int -> Int -> Maybe LocalDate
make y m d =
  if d < 1 || d > daysInMonth y m then Nothing else Just (MkLocalDate y m d)

-- | Its year.
year : LocalDate -> Int
year (MkLocalDate y _ _) = y

-- | Its month, 1 to 12.
month : LocalDate -> Int
month (MkLocalDate _ m _) = m

-- | Its day of the month, 1 to 31.
day : LocalDate -> Int
day (MkLocalDate _ _ d) = d

-- | The days from 1970-01-01 to the date; before it, fewer than none
-- | (Howard Hinnant's `days_from_civil`).
-- | >>> List.map (\d -> maybe 0 epochDays d) [make 1970 1 1, make 2024 2 29, make 1969 12 31, make 0 1 1]
-- | [0, 19782, -1, -719528]
epochDays : LocalDate -> Int
epochDays (MkLocalDate y m d) = era * 146097 + dayOfEra - 719468
  where
  yearFromMarch : Int
  yearFromMarch = if m <= 2 then y - 1 else y

  era : Int
  era = yearFromMarch / 400

  yearOfEra : Int
  yearOfEra = yearFromMarch - era * 400

  dayFromMarch : Int
  dayFromMarch = (153 * (if m > 2 then m - 3 else m + 9) + 2) / 5 + d - 1

  dayOfEra : Int
  dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayFromMarch

-- | The date `n` days after 1970-01-01, before it for fewer than none:
-- | `epochDays`' inverse (Howard Hinnant's `civil_from_days`).
-- | >>> List.map fromEpochDays [0, 19782, -1, -719529]
-- | [MkLocalDate 1970 1 1, MkLocalDate 2024 2 29, MkLocalDate 1969 12 31, MkLocalDate (-1) 12 31]
fromEpochDays : Int -> LocalDate
fromEpochDays n =
  MkLocalDate
    (if m <= 2 then yearFromMarch + 1 else yearFromMarch)
    m
    (dayFromMarch - (153 * monthFromMarch + 2) / 5 + 1)
  where
  daysFromMarch0 : Int
  daysFromMarch0 = n + 719468

  era : Int
  era = daysFromMarch0 / 146097

  dayOfEra : Int
  dayOfEra = daysFromMarch0 - era * 146097

  yearOfEra : Int
  yearOfEra =
    (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365

  yearFromMarch : Int
  yearFromMarch = yearOfEra + era * 400

  dayFromMarch : Int
  dayFromMarch = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)

  monthFromMarch : Int
  monthFromMarch = (5 * dayFromMarch + 2) / 153

  m : Int
  m = if monthFromMarch < 10 then monthFromMarch + 3 else monthFromMarch - 9

-- Instances: the prelude's operators and functions at `LocalDate`
--------------------------------------------------------------------------------

-- | The same date.
instance instanceEqualityLocalDate : Equality LocalDate
instanceEqualityLocalDate =
  { equal = \x y -> year x == year y && month x == month y && day x == day y }

-- | The earlier first.
-- | >>> (MkLocalDate 2024 2 29 : LocalDate) < MkLocalDate 2024 3 1 && (MkLocalDate (-1) 12 31 : LocalDate) < MkLocalDate 0 1 1
-- | True
instance instanceOrderLocalDate : Order LocalDate
instanceOrderLocalDate =
  orderByCompare
    (\x y -> compare (year x, (month x, day x)) (year y, (month y, day y)))

-- (the date as ISO 8601 writes it, a year of at least 4 digits and one
-- before year 0 after a `-`, as Go writes them)
isoText : LocalDate -> String
isoText (MkLocalDate y m d) =
  (if y < 0 then "-" ^ padded 4 (0 - y) else padded 4 y)
  ^ "-"
  ^ padded 2 m
  ^ "-"
  ^ padded 2 d
  where
  -- (`n`, at least 0, in decimal, with `0`s before it to `width` digits)
  padded : Int -> Int -> String
  padded width n =
    joinWith "" (List.replicate (width - strLength (showInt n)) "0") ^ showInt n

-- | As `toString` writes it, `2024-02-29`, as NodaTime's and Rust's
-- | chrono's debug form is.
-- | >>> show (MkLocalDate 2024 2 29 : LocalDate)
-- | "2024-02-29"
instance instanceShowLocalDate : Show LocalDate
instanceShowLocalDate = { show = isoText }

-- | As ISO 8601 writes it, `2024-02-29`: the year in at least 4 digits,
-- | one before year 0 after a `-` (`-0001-12-31`), as Go writes them,
-- | though `parse` reads only the years 0000 to 9999.
-- | >>> List.map toString ([MkLocalDate 2024 2 29, MkLocalDate 33 1 1, MkLocalDate 0 1 1, MkLocalDate (-1) 12 31, MkLocalDate 10000 1 1] : List LocalDate)
-- | ["2024-02-29", "0033-01-01", "0000-01-01", "-0001-12-31", "10000-01-01"]
instance instanceToStringLocalDate : ToString LocalDate
instanceToStringLocalDate = { toString = isoText }

-- | The day of the week of the date.
-- | >>> List.map dayOfWeek [MkLocalDate 1970 1 1, MkLocalDate 2024 2 29, MkLocalDate 2024 10 27, MkLocalDate 2000 1 1, MkLocalDate 0 1 1]
-- | [Thursday, Thursday, Sunday, Saturday, Saturday]
dayOfWeek : LocalDate -> DayOfWeek
dayOfWeek d = case (epochDays d + 3) % 7 of
  0 -> Monday
  1 -> Tuesday
  2 -> Wednesday
  3 -> Thursday
  4 -> Friday
  5 -> Saturday
  _ -> Sunday

-- | The day of the year of the date, 1 to 366.
-- | >>> List.map dayOfYear [MkLocalDate 2024 1 1, MkLocalDate 2024 12 31, MkLocalDate 2023 3 1, MkLocalDate 2024 3 1]
-- | [1, 366, 60, 61]
dayOfYear : LocalDate -> Int
dayOfYear d = epochDays d - epochDays (MkLocalDate (year d) 1 1) + 1

-- | The date `n` days after it, before it for fewer than none.
-- | >>> List.map (\n -> toString (plusDays (MkLocalDate 2024 2 28) n)) [1, 2, -59, 366]
-- | ["2024-02-29", "2024-03-01", "2023-12-31", "2025-02-28"]
plusDays : LocalDate -> Int -> LocalDate
plusDays d n = fromEpochDays (epochDays d + n)

-- | The date `n` months after it, before it for fewer than none: the
-- | same day of that month, or its last if it has fewer days (January
-- | 31 and a month, February 29 in 2024).
-- | >>> List.map (\n -> toString (plusMonths (MkLocalDate 2024 1 31) n)) [1, 2, 3, -2, 13, -25]
-- | ["2024-02-29", "2024-03-31", "2024-04-30", "2023-11-30", "2025-02-28", "2021-12-31"]
plusMonths : LocalDate -> Int -> LocalDate
plusMonths (MkLocalDate y m d) n =
  MkLocalDate
    (monthsFromYear0 / 12)
    (monthsFromYear0 % 12 + 1)
    (min d (daysInMonth (monthsFromYear0 / 12) (monthsFromYear0 % 12 + 1)))
  where
  monthsFromYear0 : Int
  monthsFromYear0 = y * 12 + m - 1 + n

-- | The date `n` years after it, before it for fewer than none: the same
-- | day of the same month, February 29 out of a leap year the 28th.
-- | >>> List.map (\n -> toString (plusYears (MkLocalDate 2024 2 29) n)) [1, 4, -1, -2025]
-- | ["2025-02-28", "2028-02-29", "2023-02-28", "-0001-02-28"]
plusYears : LocalDate -> Int -> LocalDate
plusYears (MkLocalDate y m d) n =
  MkLocalDate (y + n) m (min d (daysInMonth (y + n) m))

-- | The date ISO 8601 writes as `s`, extended: `2024-02-29`, the year in
-- | exactly 4 digits, 0000 to 9999, the month and the day in 2.  Nothing
-- | if it writes none, or a field is out of its range.
-- | >>> List.map (\s -> maybe "" toString (parse s)) ["2024-02-29", "0000-01-01", "9999-12-31"]
-- | ["2024-02-29", "0000-01-01", "9999-12-31"]
-- | >>> (List.map (\s -> maybe True (\_ -> False) (parse s)) ["2023-02-29", "2024-13-01", "2024-00-10", "2024-04-31", "2024-1-01", "24-01-01", "-0001-01-01", "10000-01-01", "2024/01/01", "2024-01-01T", "20240101", ""] : List Bool)
-- | [True, True, True, True, True, True, True, True, True, True, True, True]
-- | >>> List.all (\n -> parse (toString (fromEpochDays n)) == Just (fromEpochDays n)) [-719528, -1, 0, 19782, 2932896]
-- | True
parse : String -> Maybe LocalDate
parse s =
  if strLength s /= 10
     || not (strEq (strSlice s 4 5) "-")
     || not (strEq (strSlice s 7 8) "-")
  then Nothing
  else (case digitsIn s 0 4 of
        Nothing -> Nothing
        Just y ->
          (case digitsIn s 5 7 of
           Nothing -> Nothing
           Just m ->
             (case digitsIn s 8 10 of
              Nothing -> Nothing
              Just d -> make y m d)))
  where
  -- (the decimal the bytes of `s` from `from` to `to` are, if they are
  -- all digits)
  digitsIn : String -> Int -> Int -> Maybe Int
  digitsIn text from to =
    if foldBytes
         (\ok c -> ok && 48 <= c && c <= 57)
         True
         (strSlice text from to)
    then parseInt (strSlice text from to)
    else Nothing
