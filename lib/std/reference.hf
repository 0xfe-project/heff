-- For a cell of the world: made with its first value, read,
-- written.  A page's events are each a run of their own, so what they
-- share lives in the world between them -- a cell, as an element
-- (browser.dom's `Node`) does.  (A state threaded through one
-- computation is state's, handled in the language; a cell is the
-- world's, reference.provider.js.)

module std.reference

import co

-- | A cell holding an `s`.  (A number the provider gives it: a program
-- | only gets one from `newReference`.)
data Reference s = MkReference Int

-- | The operations: each says what it gives back by a function to the
-- | rest (`x`).
data ReferenceF s (m : Type -> Type) x
  = NewReference s (Reference s -> x)
  | ReadReference (Reference s) (s -> x)
  | WriteReference (Reference s) s x

-- | For cells of the world: made with a first value, read and written,
-- | shared by a page's events.
reference : (s : Type) -> HFunctor
reference s =
  { f = ReferenceF s
  , hfmap = \m g p -> case p of
      NewReference st k -> NewReference st (\r -> g (k r))
      ReadReference r k -> ReadReference r (\st -> g (k st))
      WriteReference r st x -> WriteReference r st (g x)
  , hmap = \m n nt p -> case p of
      NewReference st k -> NewReference st k
      ReadReference r k -> ReadReference r k
      WriteReference r st x -> WriteReference r st x
  }

-- | A new cell, holding `st`: in any effect the cells are in, by the
-- | evidence (as state's `get`).
newReference : {s : Type}
             -> {e : HFunctor}
             -> {{ev : reference s <: e}}
             -> s
             -> Co e (Reference s)
newReference st = op (ev (NewReference st (\r -> r))) val

-- | What a cell holds.
readReference : {s : Type}
              -> {e : HFunctor}
              -> {{ev : reference s <: e}}
              -> Reference s
              -> Co e s
readReference r = op (ev (ReadReference r (\st -> st))) val

-- | ... and it holds `st` now.
writeReference : {s : Type}
               -> {e : HFunctor}
               -> {{ev : reference s <: e}}
               -> Reference s
               -> s
               -> Co e Unit
writeReference r st = op (ev (WriteReference r st MkUnit)) val
