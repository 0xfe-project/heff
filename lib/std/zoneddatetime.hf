-- A date and time of day in a time zone: 2024-03-10T03:00:00-04:00 in
-- America/New_York, what the clocks there said, at the offset they were
-- at -- an instant (std.instant), and how it was read there.
-- NodaTime's `ZonedDateTime` is the model: a std.localdatetime, a
-- std.datetimezone, and the zone's offset there, a std.offset.  An
-- instant is one in a zone (`at`).  A date and time on its clocks is
-- one by `resolve`, which the program tells what a date-time the clocks
-- skipped over becomes, and one they went back over (NodaTime's
-- `ZoneLocalMappingResolver`): none is chosen for it.  Two are equal
-- where their date-times, offsets and zones are; they have no order, as
-- std.offsetdatetime's have none -- compare their `instant`s.  Import it
-- by a name, `import std.zoneddatetime as ZonedDateTime`, as its names
-- are short.
--
-- ```haskell
-- import std.datetimezone as DateTimeZone
-- import std.localdatetime as LocalDateTime
-- import std.zoneddatetime as ZonedDateTime
--
-- -- | a meeting at a date and time in New York, said so: a time skipped
-- -- | in spring is moved on by the gap, one repeated in autumn is the
-- -- | first
-- -- | >>> List.map meeting ["2024-03-10T02:30:00", "2024-11-03T01:30:00"]
-- -- | ["2024-03-10T03:30:00-04:00[EST5EDT,M3.2.0,M11.1.0]", "2024-11-03T01:30:00-04:00[EST5EDT,M3.2.0,M11.1.0]"]
-- meeting : String -> String
-- meeting s =
--   case (DateTimeZone.fromPosix "EST5EDT,M3.2.0,M11.1.0", LocalDateTime.parse s) of
--     (Just zone, Just t) ->
--       maybe
--         ""
--         show
--         (ZonedDateTime.resolve
--            { skipped = ShiftForward, ambiguous = Earlier }
--            zone
--            t)
--     _ -> ""
-- ```

module std.zoneddatetime
  ( ZonedDateTime
  , SkippedTime(..)
  , AmbiguousTime(..)
  , Resolver
  , lenient
  , strict
  , at
  , resolve
  , local
  , offset
  , zone
  , instant
  , toOffsetDateTime
  , plus
  , instanceEqualityZonedDateTime
  , instanceDebugZonedDateTime
  , instanceShowZonedDateTime
  )

import std.datetimezone as DateTimeZone
import std.duration as Duration
import std.instant as Instant
import std.localdatetime as LocalDateTime
import std.offset as Offset
import std.offsetdatetime as OffsetDateTime

-- | A date-time in a zone: the date and time of day its clocks say, the
-- | offset they are at, and the zone.
data ZonedDateTime
  = MkZonedDateTime LocalDateTime.LocalDateTime Offset.Offset DateTimeZone.DateTimeZone

-- | What a date-time the zone's clocks skipped over becomes: the last
-- | instant before the gap, at the offset before it (`Earlier`); the
-- | instant the gap ends, at the offset after it (`Later`); the instant
-- | it is at the offset before the gap, so the date-time moved on by the
-- | gap's length (`ShiftForward`), as NodaTime's lenient resolver has it;
-- | or none (`Fail`).
data SkippedTime = Earlier | Later | ShiftForward | Fail

-- | What a date-time the zone's clocks went back over, so twice, becomes:
-- | the earlier of its two instants (`Earlier`), the later (`Later`), or
-- | none (`Fail`).
data AmbiguousTime = Earlier | Later | Fail

-- | What a date-time is resolved by, where it is not one instant in the
-- | zone: one skipped over, one gone back over.
type Resolver = { skipped : SkippedTime, ambiguous : AmbiguousTime }

-- | NodaTime's lenient resolver: a date-time skipped over moved on by
-- | the gap, one gone back over the earlier.
lenient : Resolver
lenient = { skipped = ShiftForward, ambiguous = Earlier }

-- | Neither resolved: none for a date-time skipped over or gone back
-- | over, NodaTime's strict resolver.
strict : Resolver
strict = { skipped = Fail, ambiguous = Fail }

-- | Its date and time of day, as the zone's clocks say it.
local : ZonedDateTime -> LocalDateTime.LocalDateTime
local (MkZonedDateTime t _ _) = t

-- | The offset of the zone's clocks then.
offset : ZonedDateTime -> Offset.Offset
offset (MkZonedDateTime _ o _) = o

-- | Its zone.
zone : ZonedDateTime -> DateTimeZone.DateTimeZone
zone (MkZonedDateTime _ _ z) = z

-- | The date-time at its offset, without the zone.
toOffsetDateTime : ZonedDateTime -> OffsetDateTime.OffsetDateTime
toOffsetDateTime (MkZonedDateTime t o _) = OffsetDateTime.make t o

-- Instances: the prelude's operators and functions at `ZonedDateTime`
--------------------------------------------------------------------------------

-- | The same date-time at the same offset in the same zone, as NodaTime
-- | has it: the same instant in two zones is two values.
instance instanceEqualityZonedDateTime : Equality ZonedDateTime
instanceEqualityZonedDateTime =
  { equal = \x y ->
        local x == local y && offset x == offset y && zone x == zone y
  }

-- (the date-time as RFC 9557 writes it: as RFC 3339 does, then its
-- zone's id in brackets)
zonedText : ZonedDateTime -> String
zonedText t = show (toOffsetDateTime t) ^ "[" ^ DateTimeZone.id (zone t) ^ "]"

-- | As `show` writes it, `2024-03-10T03:00:00-04:00[America/New_York]`.
instance instanceDebugZonedDateTime : Debug ZonedDateTime
instanceDebugZonedDateTime = { debug = zonedText }

-- | As RFC 9557 writes it, as Java's `ZonedDateTime` does: the
-- | date-time at its offset as std.offsetdatetime writes it, then the
-- | zone's id in brackets (`2024-03-10T03:00:00-04:00[America/New_York]`).
instance instanceShowZonedDateTime : Show ZonedDateTime
instanceShowZonedDateTime = { show = zonedText }

-- | The instant in the zone: its date and time there, at the zone's
-- | offset then.
-- | >>> show (at Instant.epoch DateTimeZone.utc)
-- | "1970-01-01T00:00:00Z[UTC]"
-- | >>> at Instant.epoch DateTimeZone.utc == at Instant.epoch DateTimeZone.utc
-- | True
-- | >>> maybe True (\o -> at Instant.epoch DateTimeZone.utc == at Instant.epoch (DateTimeZone.fixed o)) (Offset.fromHours 8)
-- | False
at : Instant.Instant -> DateTimeZone.DateTimeZone -> ZonedDateTime
at t z =
  MkZonedDateTime
    (OffsetDateTime.local (OffsetDateTime.at t (DateTimeZone.offsetAt z t)))
    (DateTimeZone.offsetAt z t)
    z

-- | The instant it is: its date-time less its offset.
instant : ZonedDateTime -> Instant.Instant
instant z = OffsetDateTime.instant (toOffsetDateTime z)

-- | The date-time the duration after it, in its zone: so an hour after
-- | 01:30 on the day the clocks go forward at 02:00 is 03:30.
-- | >>> maybe "" (\o -> show (plus (at Instant.epoch (DateTimeZone.fixed o)) (Duration.hours 1))) (Offset.fromHours 8)
-- | "1970-01-01T09:00:00+08:00[UTC+08:00]"
plus : ZonedDateTime -> Duration.Duration -> ZonedDateTime
plus z d = at (Instant.plus (instant z) d) (zone z)

-- (the instant the date-time is at the offset)
atOffset : LocalDateTime.LocalDateTime -> Offset.Offset -> Instant.Instant
atOffset t o = OffsetDateTime.instant (OffsetDateTime.make t o)

-- (a date-time skipped over, resolved: the gap from the offset `before`
-- to the offset `after`, ending at the instant `end`)
skippedTo : SkippedTime
          -> DateTimeZone.DateTimeZone
          -> LocalDateTime.LocalDateTime
          -> Offset.Offset
          -> Instant.Instant
          -> Maybe ZonedDateTime
skippedTo Earlier z t before end =
  Just (at (Instant.minus end (Duration.nanoseconds 1)) z)
skippedTo Later z t before end = Just (at end z)
skippedTo ShiftForward z t before end = Just (at (atOffset t before) z)
skippedTo Fail z t before end = Nothing

-- (a date-time gone back over, resolved: at the offset `earlier`, of
-- its earlier instant, or `later`)
ambiguousTo : AmbiguousTime
            -> DateTimeZone.DateTimeZone
            -> LocalDateTime.LocalDateTime
            -> Offset.Offset
            -> Offset.Offset
            -> Maybe ZonedDateTime
ambiguousTo Earlier z t earlier later = Just (MkZonedDateTime t earlier z)
ambiguousTo Later z t earlier later = Just (MkZonedDateTime t later z)
ambiguousTo Fail z t earlier later = Nothing

-- (the date-time, as the zone maps it, resolved)
resolved : Resolver
         -> DateTimeZone.DateTimeZone
         -> LocalDateTime.LocalDateTime
         -> DateTimeZone.Mapping
         -> Maybe ZonedDateTime
resolved r z t (Unique o) = Just (MkZonedDateTime t o z)
resolved r z t (Skipped before _ end) = skippedTo r.skipped z t before end
resolved r z t (Ambiguous earlier later) =
  ambiguousTo r.ambiguous z t earlier later

-- | The date and time on the zone's clocks, as one instant there: where
-- | it is one, that; where the clocks skipped over it, or went back over
-- | it, what the resolver says -- none where it says `Fail`
-- | (std.datetimezone's `mapLocal` tells which it was).
-- | >>> List.map (\r -> maybe "" (\z -> maybe "" (\t -> maybe "none" show (resolve r z t)) (LocalDateTime.parse "2024-03-10T02:30:00")) (DateTimeZone.fromPosix "EST5EDT,M3.2.0,M11.1.0")) [{ skipped = Earlier, ambiguous = Fail }, { skipped = Later, ambiguous = Fail }, lenient, strict]
-- | ["2024-03-10T01:59:59.999999999-05:00[EST5EDT,M3.2.0,M11.1.0]", "2024-03-10T03:00:00-04:00[EST5EDT,M3.2.0,M11.1.0]", "2024-03-10T03:30:00-04:00[EST5EDT,M3.2.0,M11.1.0]", "none"]
-- | >>> List.map (\r -> maybe "" (\z -> maybe "" (\t -> maybe "none" show (resolve r z t)) (LocalDateTime.parse "2024-11-03T01:30:00")) (DateTimeZone.fromPosix "EST5EDT,M3.2.0,M11.1.0")) [{ skipped = Fail, ambiguous = Earlier }, { skipped = Fail, ambiguous = Later }, strict]
-- | ["2024-11-03T01:30:00-04:00[EST5EDT,M3.2.0,M11.1.0]", "2024-11-03T01:30:00-05:00[EST5EDT,M3.2.0,M11.1.0]", "none"]
-- | >>> maybe "" (\t -> maybe "none" show (resolve strict DateTimeZone.utc t)) (LocalDateTime.parse "2024-03-10T02:30:00")
-- | "2024-03-10T02:30:00Z[UTC]"
resolve : Resolver
        -> DateTimeZone.DateTimeZone
        -> LocalDateTime.LocalDateTime
        -> Maybe ZonedDateTime
resolve r z t = resolved r z t (DateTimeZone.mapLocal z t)
