-- Heaps, by an order of their elements: a priority queue, its least
-- element always at hand.  A pairing heap, persistent: an insertion and
-- a merge take a step each, and taking the least out takes as many as
-- the log of the size, amortised.  The order is the elements' `Order`,
-- found as an instance argument is, always the same one for a heap.
-- Import it by a name, `import std.heap as Heap`, as the list module has
-- a `null` and a `merge`.  The heap comes first, as a set's does:
-- `Heap.insert h x`.
--
-- ```haskell
-- import std.heap as Heap
--
-- -- | the three least, in order
-- -- | >>> least3 [5, 1, 4, 2, 3]
-- -- | Cons 1 (Cons 2 (Cons 3 Nil))
-- least3 : List Int -> List Int
-- least3 xs = List.take 3 (Heap.toList (Heap.fromList xs))
-- ```

module std.heap
  ( Heap
  , empty
  , singleton
  , null
  , size
  , merge
  , insert
  , findMin
  , deleteMin
  , popMin
  , fromList
  , toList
  )

-- | A heap: none, or its least element at the root, how many it holds
-- | in all, and the heaps of the rest, none of whose elements is less.
data Heap a = Tip | Root Int a (List (Heap a))

-- | The heap of nothing.
empty : {a : Type} -> Heap a
empty = Tip

-- | The heap of `x` alone.
singleton : {a : Type} -> a -> Heap a
singleton x = Root 1 x Nil

-- | Whether it holds nothing.
null : {a : Type} -> Heap a -> Bool
null Tip = True
null (Root _ _ _) = False

-- | How many elements it holds: kept at its root, so a step.
size : {a : Type} -> Heap a -> Int
size Tip = 0
size (Root n _ _) = n

-- | The elements of both: the root with the lesser element over the
-- | other (the first's, of two as small).
merge : {a : Type} -> {{ord : Order a}} -> Heap a -> Heap a -> Heap a
merge Tip h = h
merge h Tip = h
merge (Root m x xs) (Root n y ys) =
  if y < x then Root (m + n) y (Cons (Root m x xs) ys)
  else Root (m + n) x (Cons (Root n y ys) xs)

-- | The heap with `x` in it too.
insert : {a : Type} -> {{ord : Order a}} -> Heap a -> a -> Heap a
insert h x = merge (singleton x) h

-- | Its least element, if it is not empty.
-- | >>> findMin (insert (insert (insert empty 3) 1) 2)
-- | Just 1
-- | >>> findMin (empty : Heap Int)
-- | Nothing
findMin : {a : Type} -> Heap a -> Maybe a
findMin Tip = Nothing
findMin (Root _ x _) = Just x

-- (the heaps under a root, as one: merged two by two, from the first,
-- then those merged from the last -- the pairing heap's two passes,
-- each a loop, so a root with many under it goes no deeper)
mergedAll : {a : Type} -> {{ord : Order a}} -> List (Heap a) -> Heap a
mergedAll hs = List.foldl (\acc h -> merge h acc) Tip (mergedInPairs Nil hs)
  where
  -- (the heaps merged two by two, from the first, onto `acc`: so the last
  -- two merged first in it)
  mergedInPairs : List (Heap a) -> List (Heap a) -> List (Heap a)
  mergedInPairs acc (Cons h (Cons k rest)) =
    mergedInPairs (Cons (merge h k) acc) rest
  mergedInPairs acc (Cons h Nil) = Cons h acc
  mergedInPairs acc Nil = acc

-- | The heap without its least element (of the empty heap, the empty
-- | heap).
-- | >>> findMin (deleteMin (insert (insert (insert empty 3) 1) 2))
-- | Just 2
deleteMin : {a : Type} -> {{ord : Order a}} -> Heap a -> Heap a
deleteMin Tip = Tip
deleteMin (Root _ _ hs) = mergedAll hs

-- | Its least element and the heap without it, if it is not empty.
-- | >>> (maybe Nil (\p -> [fst p, size (snd p)]) (popMin (insert (insert (insert empty 3) 1) 2)) : List Int)
-- | Cons 1 (Cons 2 Nil)
popMin : {a : Type} -> {{ord : Order a}} -> Heap a -> Maybe (Pair a (Heap a))
popMin Tip = Nothing
popMin (Root _ x hs) = Just (MkPair x (mergedAll hs))

-- | The heap of a list's elements.
-- | >>> size (fromList [3, 1, 3])
-- | 3
fromList : {a : Type} -> {{ord : Order a}} -> List a -> Heap a
fromList xs = List.foldl (\h x -> insert h x) Tip xs

-- | The elements, least first (a heapsort).
-- | >>> toList (fromList [3, 1, 4, 1, 5, 9, 2, 6])
-- | Cons 1 (Cons 1 (Cons 2 (Cons 3 (Cons 4 (Cons 5 (Cons 6 (Cons 9 Nil)))))))
-- | >>> toList (merge (fromList ["b", "d"]) (fromList ["c", "a"]))
-- | Cons "a" (Cons "b" (Cons "c" (Cons "d" Nil)))
toList : {a : Type} -> {{ord : Order a}} -> Heap a -> List a
toList h = ascendingOnto Nil h
  where
  -- (the elements of `h`, least first, after those taken out before, `acc`,
  -- the last taken first)
  ascendingOnto : List a -> Heap a -> List a
  ascendingOnto acc Tip = List.reverse acc
  ascendingOnto acc (Root _ x hs) = ascendingOnto (Cons x acc) (mergedAll hs)
