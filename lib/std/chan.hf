-- Typed channels for green threads: a channel of `a`s, any `a`, held by
-- a `with` of its own, `with Chan.channel as ch do`, whose effect, `chan
-- s a`, keeps the channel's values -- of the type they are, written for
-- that `a` -- in its handler's own state.  A program with channels of
-- several types has a `with` for each, one inside another, and the
-- threads scheduled inside them all, by green's `together` (or
-- std.reactor's): every thread's channels are the same ones.  Pure, the
-- same on every backend.  Import it by a name, `import std.chan as
-- Chan`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import co
-- import green
-- import std.chan as Chan
--
-- -- | a pair one way, a list back
-- swapped : {e : HFunctor}
--         -> {s t : Type}
--         -> {{gr : green <: e}}
--         -> {{cp : Chan.chan s (Int, String) <: e}}
--         -> {{cl : Chan.chan t (List Int) <: e}}
--         -> Chan.Chan s (Int, String)
--         -> Chan.Chan t (List Int)
--         -> Co e (List Int)
-- swapped there back = do
--   spawn (do
--     (n, w) <- Chan.recv there
--     Chan.send back [n, strLength w])
--   Chan.send there (1, "two")
--   Chan.recv back
--
-- -- | `Just [1, 3]`
-- run : {e : HFunctor} -> Co e (Maybe (List Int))
-- run = do
--   with Chan.channel as there do
--     with Chan.channel as back do
--       together (swapped (gr := _) (cp := _) (cl := _) there back)
-- ```
--
-- Operation | What it does
-- --- | ---
-- `with channel as ch do` | a channel of its own, for the statements under it
-- `with channels as cs do` | channels made as they are wanted, by `newChan cs`
-- `send ch x` | `x` put on `ch`, to the thread waiting there longest; never waits
-- `recv ch` | the first value on `ch`, waiting for one if there is none
-- `tryRecv ch` | ... `Just` it, or `Nothing` where there is none, never waiting
--
-- The `with`s are outside the scheduler, `together` the body of the
-- innermost: a handler inside it would be copied into each thread it
-- spawns, each with channels of its own.  So the effect of a channel is
-- under green's, `green <+> chan t b <+> chan s a <+> e`, and its handler
-- takes no turns: its operations never wait.  Waiting is green's, in the
-- thread: `recv` takes a value where one is, and where none is, parks
-- the thread on the channel's key (green's `park`), counted among those
-- waiting; `send` hands its value to the first of those, kept for it,
-- and wakes it (`wake`).
--
-- A `with` ends only once every thread that could use its channel has:
-- `together` joins every thread before it comes to main's answer, so no
-- operation on a channel comes after its `with`, and none is dropped.
-- Where every thread left waits, for ever, it comes to `Nothing`, a
-- deadlock.  Each `with` has a region of its own, `s`: a channel cannot
-- leave its statements, as a `With s` cannot -- what they come to is of
-- a type bound outside them -- nor can a thread using it, its type in a
-- world of `chan s a`.  Two channels of the same type are two effects,
-- `chan s Int` and `chan t Int`, each found by its channel's type.  Under
-- std.reactor (`Reactor.together (...)` in the innermost `with`) a
-- thread's channel operations are its outside operations, done at once.

module std.chan
  ( chan
  , Chan
  , Chans
  , channel
  , channels
  , newChan
  , send
  , recv
  , tryRecv
  )

import co
import green as Green
import std.ordmap as OrdMap

-- | One channel's values: those to be taken, those handed to threads
-- | woken to take them (each its own, in the order they were woken),
-- | how many threads wait for one, and the key they park on (-1, none
-- | yet).
type Line a =
  { values : Green.Queue a
  , handed : Green.Queue a
  , waiting : Int
  , key : Int
  }

-- | What a receiver finds: a value; or none, it now waiting, parked on
-- | this key; or none, the channel without a key yet.
data Taken a = Got a | Parked Int | Unkeyed

data ChanF s a (m : Type -> Type) x
  = Put Int a (Maybe Int -> x)
  | Take Int (Taken a -> x)
  | Poll Int (Maybe a -> x)
  | Keyed Int Int x
  | Claim Int (Maybe a -> x)

-- | The channels of `a`s of a `with` of region `s`, as an effect.
chan : Type -> Type -> HFunctor
chan s a =
  { f = ChanF s a
  , hfmap = \m g p -> case p of
      Put n v k -> Put n v (\w -> g (k w))
      Take n k -> Take n (\t -> g (k t))
      Poll n k -> Poll n (\r -> g (k r))
      Keyed n key x -> Keyed n key (g x)
      Claim n k -> Claim n (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      Put c v k -> Put c v k
      Take c k -> Take c k
      Poll c k -> Poll c k
      Keyed c key x -> Keyed c key x
      Claim c k -> Claim c k
  }

-- | A channel of `a`s of the `with` of region `s`.
data Chan s a = MkChan Int

-- | The channels of a `with` of region `s`, made as they are wanted.
data Chans s a = MkChans

-- The handler: the lines in its state
--------------------------------------------------------------------------------

-- (the lines: the `with`'s own channel's, and those made by `newChan`
-- that are not idle)
type Lines a = { own : Line a, others : OrdMap.OrdMap Int (Line a) }

-- (a line with nothing on it, nobody waiting, parking on `key`)
quiet : {a : Type} -> Int -> Line a
quiet key =
  { values = Green.emptyQ, handed = Green.emptyQ, waiting = 0, key = key }

-- (channel `n`'s line: a channel made by `newChan` has its number for
-- its key; the `with`'s own, -1, has none until its first wait)
lineOf : {a : Type} -> Int -> Lines a -> Line a
lineOf n m =
  if n < 0 then m.own else fromMaybe (quiet n) (OrdMap.lookup m.others n)

-- (none yet: the `with`'s own channel's line, without a key)
noLines : {a : Type} -> Lines a
noLines = { own = quiet (0 - 1), others = OrdMap.empty }

-- (an idle line: nothing on it, nothing handed, nobody waiting)
idle : {a : Type} -> Line a -> Bool
idle l = l.waiting == 0 && Green.isEmptyQ l.values && Green.isEmptyQ l.handed

-- (channel `n`'s line is `l` now; an idle one dropped, but for the
-- `with`'s own, which keeps its key)
holding : {a : Type} -> Int -> Line a -> Lines a -> Lines a
holding n l m =
  if n < 0 then { m | own = l }
  else if idle l then { m | others = OrdMap.delete m.others n }
  else { m | others = OrdMap.insert m.others n l }

-- (`v` put on the line: handed to the first waiting, whose key is
-- woken, or among the values)
putOn : {a : Type} -> a -> Line a -> Pair (Maybe Int) (Line a)
putOn v l =
  if l.waiting > 0
  then MkPair
      (Just l.key)
      { l | handed = Green.putQ v l.handed, waiting = l.waiting - 1 }
  else MkPair Nothing { l | values = Green.putQ v l.values }

-- (a receiver at the line: the first value; or it waits, parked on the
-- line's key, where it has one)
takeFrom : {a : Type} -> Line a -> Pair (Taken a) (Line a)
takeFrom l = case Green.takeQ l.values of
  Just (MkPair v q) -> MkPair (Got v) { l | values = q }
  Nothing ->
    if l.key < 0 then MkPair Unkeyed l
    else MkPair (Parked l.key) { l | waiting = l.waiting + 1 }

pollFrom : {a : Type} -> Line a -> Pair (Maybe a) (Line a)
pollFrom l = case Green.takeQ l.values of
  Just (MkPair v q) -> MkPair (Just v) { l | values = q }
  Nothing -> MkPair Nothing l

claimFrom : {a : Type} -> Line a -> Pair (Maybe a) (Line a)
claimFrom l = case Green.takeQ l.handed of
  Just (MkPair v q) -> MkPair (Just v) { l | handed = q }
  Nothing -> MkPair Nothing l

-- (the line, parking on `key` from now on)
keyedBy : {a : Type} -> Int -> Line a -> Line a
keyedBy key l = { l | key = key }

-- (what an operation on channel `n` comes to, and the lines after it)
onLine : {a r : Type}
       -> Int
       -> (Line a -> Pair r (Line a))
       -> Lines a
       -> Pair r (Lines a)
onLine n f m = case f (lineOf n m) of
  MkPair r l -> MkPair r (holding n l m)

-- (the lines as a state: a computation of `e` from them, its answer and
-- the lines it leaves, as a functor)
linesFunctor : (a : Type) -> (e : HFunctor) -> RawFunctor
linesFunctor a e =
  { f = \x -> Lines a -> Co e (Pair x (Lines a))
  , fmap = \g m ls -> bind (m ls) (\r -> val (MkPair (g (fst r)) (snd r)))
  }

-- (an operation on the channels, done on the lines)
chanAlg : {s a x : Type}
        -> {e : HFunctor}
        -> ChanF s a (\y -> Lines a -> Co e (Pair y (Lines a))) x
        -> Lines a
        -> Co e (Pair x (Lines a))
chanAlg (Put n v k) ls = case onLine n (putOn v) ls of
  MkPair w ls2 -> val (MkPair (k w) ls2)
chanAlg (Take n k) ls = case onLine n takeFrom ls of
  MkPair t ls2 -> val (MkPair (k t) ls2)
chanAlg (Poll n k) ls = case onLine n pollFrom ls of
  MkPair r ls2 -> val (MkPair (k r) ls2)
chanAlg (Keyed n key x) ls =
  val (MkPair x (holding n (keyedBy key (lineOf n ls)) ls))
chanAlg (Claim n k) ls = case onLine n claimFrom ls of
  MkPair r ls2 -> val (MkPair (k r) ls2)

-- | The channels of region `s` handled into the rest of the world, `e`:
-- | their lines threaded from each operation to the next.
chanHandler : (s v : Type) -> (e : HFunctor) -> Handler (chan s v <+> e)
chanHandler s v e =
  { M = \x -> Lines v -> Co e (Pair x (Lines v))
  , ret = \x ls -> val (MkPair x ls)
  , bind = \m k ls -> bind (m ls) (\r -> k (fst r) (snd r))
  , malg = \p ls -> case p of
      InL t -> chanAlg t ls
      InR q ->
        op
          (e.hmap
             (linesFunctor v e)
             (coFunctor e)
             (\m -> bind (m ls) (\r -> val (fst r)))
             q)
          (\x -> val (MkPair x ls))
  }

-- The withs
--------------------------------------------------------------------------------

-- | Channels of `a`s, made by `newChan` as they are wanted, for `body`
-- | alone, in a region of its own: what it comes to.  The scheduler of
-- | the threads that share them is inside it.
channels : {e : HFunctor}
         -> {a b : Type}
         -> ({s : Type} -> Chans s a -> Co (chan s a <+> e) b)
         -> Co e b
channels body =
  bind
    (handle (chanHandler Unit a e) (body (s := Unit) MkChans) noLines)
    (\r -> val (fst r))

-- | A channel of `a`s, for `body` alone, in a region of its own: what it
-- | comes to.  The scheduler of the threads that share it is inside it.
channel : {e : HFunctor}
        -> {a b : Type}
        -> ({s : Type} -> Chan s a -> Co (chan s a <+> e) b)
        -> Co e b
channel body =
  bind
    (handle (chanHandler Unit a e) (body (s := Unit) (MkChan (0 - 1))) noLines)
    (\r -> val (fst r))

-- The operations
--------------------------------------------------------------------------------

-- | A new channel of the `with`'s: its number a key of green's, which
-- | its receivers park on.
newChan : {s a : Type}
        -> {e : HFunctor}
        -> {{gr : Green.green <: e}}
        -> Chans s a
        -> Co e (Chan s a)
newChan cs = bind (Green.newKey (ev := gr)) (\n -> val (MkChan n))

-- | `v` put on the channel: the thread waiting there longest takes it,
-- | its turn to come; this one goes on.
send : {s a : Type}
     -> {e : HFunctor}
     -> {{gr : Green.green <: e}}
     -> {{ch : chan s a <: e}}
     -> Chan s a
     -> a
     -> Co e Unit
send (MkChan n) v =
  bind (op (ch (Put n v (\w -> w))) val) (\w -> case w of
  Just key -> Green.wake (ev := gr) key
  Nothing -> val MkUnit)

-- | The first value on the channel, `Just` it, taken; or `Nothing`
-- | where there is none.  Never waits.
tryRecv : {s a : Type}
        -> {e : HFunctor}
        -> {{ch : chan s a <: e}}
        -> Chan s a
        -> Co e (Maybe a)
tryRecv (MkChan n) = op (ch (Poll n (\r -> r))) val

-- | The first value on the channel, waiting for one, the others going
-- | on, if there is none: parked on the channel's key until a value is
-- | handed to it.
recv : {s a : Type}
     -> {e : HFunctor}
     -> {{gr : Green.green <: e}}
     -> {{ch : chan s a <: e}}
     -> Chan s a
     -> Co e a
recv (MkChan n) = do
  t <- op (ch (Take n (\t -> t))) val
  case t of
    Got v -> pure v
    Parked key -> do
      Green.park (ev := gr) key
      r <- op (ch (Claim n (\r -> r))) val
      case r of
        Just v -> pure v
        Nothing -> (recv (MkChan n : Chan s a) : Co e a)
    Unkeyed -> do
      key <- Green.newKey (ev := gr)
      op (ch (Keyed n key ())) val
      (recv (MkChan n : Chan s a) : Co e a)
