-- Time as an effect: waiting, and two clocks.  A C program and a page's
-- script both have a handler for it.  In C, a sleep of a green thread
-- scheduled by std.reactor is pending while the other threads go on;
-- elsewhere the program waits where it is.  (browser.dom has a `sleep`
-- too: import one of them `as`.)
--
-- Both clocks count nanoseconds, as std.filesystem's `Status.modified`
-- does, as precise as the system keeps them: `now`, the time of day,
-- since the epoch (1970-01-01 UTC), which the system may set back or
-- forward; `monotonic`, since some time of the system's own, which only
-- goes forward -- what an elapsed time is measured by.  (The time of
-- day so is an `Int` of a word, within 2^62, until 2116.)
--
-- ```haskell
-- import co
-- import std.io
-- import std.time
--
-- -- | how long a computation took, in milliseconds, said after it
-- timed : {e : HFunctor}
--       -> {a : Type}
--       -> {{clock : time <: e}}
--       -> {{io : stdio <: e}}
--       -> Co e a
--       -> Co e a
-- timed c = do
--   start <- monotonic
--   x <- c
--   end <- monotonic
--   print ("took " ^ show ((end - start) / 1000000) ^ " ms")
--   pure x
-- ```

module std.time

import co

data TimeF (m : Type -> Type) x
  = Sleep Int x
  | Now (Int -> x)
  | Monotonic (Int -> x)

-- | Time as an effect.
time : HFunctor
time =
  { f = TimeF
  , hfmap = \m g p -> case p of
      Sleep ms x -> Sleep ms (g x)
      Now k -> Now (\t -> g (k t))
      Monotonic k -> Monotonic (\t -> g (k t))
  , hmap = \m n nt p -> case p of
      Sleep ms x -> Sleep ms x
      Now k -> Now k
      Monotonic k -> Monotonic k
  }

-- | Wait: the rest runs when the time has passed, in any effect the
-- | time is in, by the evidence.
sleep : {e : HFunctor} -> {{ev : time <: e}} -> Int -> Co e Unit
sleep ms = op (ev (Sleep ms MkUnit)) val

-- | The time of day: nanoseconds since the epoch, 1970-01-01 UTC, as
-- | the system has it (which may be set back or forward).
now : {e : HFunctor} -> {{ev : time <: e}} -> Co e Int
now = op (ev (Now (\t -> t))) val

-- | Nanoseconds since some time of the system's own, never fewer than
-- | the time before: the difference of two is the time between them.
monotonic : {e : HFunctor} -> {{ev : time <: e}} -> Co e Int
monotonic = op (ev (Monotonic (\t -> t))) val
