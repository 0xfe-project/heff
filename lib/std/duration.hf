-- Durations: fixed lengths of time, exact to the nanosecond, of any
-- size, as an `Int` is.  NodaTime's `Duration` is the model: a duration
-- is a length on the time line, the same wherever it is laid -- a day is
-- exactly 24 hours, as no calendar is asked -- and what a calendar
-- counts, a month or a year, is std.period's.  The distance between two
-- instants of std.instant is one, and an instant moves by one.  Its
-- instances are the prelude's operators at `Duration` -- `x + y`,
-- `x - y`, `-x`, `x < y`, `max x y` -- and `show` writes it as Go's
-- `Duration.String` does.  Import it by a name,
-- `import std.duration as Duration`, as its names are short.
--
-- ```haskell
-- import std.duration as Duration
--
-- -- | a lap of a race, in seconds and milliseconds
-- -- | >>> show (lap 83 250)
-- -- | "1m23.25s"
-- lap : Int -> Int -> Duration.Duration
-- lap s ms = Duration.seconds s + Duration.milliseconds ms
-- ```

module std.duration
  ( Duration
  , nanoseconds
  , microseconds
  , milliseconds
  , seconds
  , minutes
  , hours
  , days
  , zero
  , totalNanoseconds
  , times
  , instanceEqualityDuration
  , instanceOrderDuration
  , instanceAdditionDuration
  , instanceSubtractionDuration
  , instanceNegationDuration
  , instanceIsZeroDuration
  , instanceDebugDuration
  , instanceShowDuration
  )

-- | A duration: how many nanoseconds long it is, less than none for one
-- | back in time.
data Duration = MkDuration Int

-- | A duration of `n` nanoseconds.
nanoseconds : Int -> Duration
nanoseconds n = MkDuration n

-- | A duration of `n` microseconds.
microseconds : Int -> Duration
microseconds n = MkDuration (n * 1000)

-- | A duration of `n` milliseconds.
milliseconds : Int -> Duration
milliseconds n = MkDuration (n * 1000000)

-- | A duration of `n` seconds.
seconds : Int -> Duration
seconds n = MkDuration (n * 1000000000)

-- | A duration of `n` minutes.
minutes : Int -> Duration
minutes n = MkDuration (n * 60000000000)

-- | A duration of `n` hours.
hours : Int -> Duration
hours n = MkDuration (n * 3600000000000)

-- | A duration of `n` days, each exactly 24 hours.
days : Int -> Duration
days n = MkDuration (n * 86400000000000)

-- | The duration of no time.
zero : Duration
zero = MkDuration 0

-- | How many nanoseconds long it is.
-- | >>> totalNanoseconds (hours 1) == totalNanoseconds (minutes 60)
-- | True
-- | >>> totalNanoseconds (days (-1))
-- | -86400000000000
totalNanoseconds : Duration -> Int
totalNanoseconds (MkDuration n) = n

-- Instances: the prelude's operators and functions at `Duration`
--------------------------------------------------------------------------------

-- | Equal: as long.
-- | >>> days 1 == hours 24 && seconds 1 /= milliseconds 999
-- | True
instance instanceEqualityDuration : Equality Duration
instanceEqualityDuration =
  { equal = \x y -> totalNanoseconds x == totalNanoseconds y }

-- | Shorter first, one back in time shorter than none.
-- | >>> minutes 1 < seconds 61 && seconds (-1) < zero && max (hours 1) (minutes 61) == minutes 61
-- | True
instance instanceOrderDuration : Order Duration
instanceOrderDuration = orderByCompare compareDuration
  where
  compareDuration : Duration -> Duration -> Ordering
  compareDuration x y = compare (totalNanoseconds x) (totalNanoseconds y)

instance instanceAdditionDuration : Addition Duration
instanceAdditionDuration =
  { add = \x y -> MkDuration (totalNanoseconds x + totalNanoseconds y) }

-- | >>> hours 1 - minutes 1 == minutes 59
-- | True
instance instanceSubtractionDuration : Subtraction Duration
instanceSubtractionDuration =
  { sub = \x y -> MkDuration (totalNanoseconds x - totalNanoseconds y) }

-- | >>> -(seconds 2) == seconds (-2)
-- | True
instance instanceNegationDuration : Negation Duration
instanceNegationDuration = { neg = \x -> MkDuration (0 - totalNanoseconds x) }

-- | >>> instanceIsZeroDuration.isZero zero && not (instanceIsZeroDuration.isZero (nanoseconds 1))
-- | True
instance instanceIsZeroDuration : IsZero Duration
instanceIsZeroDuration = { isZero = \x -> totalNanoseconds x == 0 }

-- | As `nanoseconds` rebuilds it: `nanoseconds 1500`, a negative count
-- | in parentheses.
-- | >>> debug (microseconds 3) ^ " " ^ debug (seconds (-1))
-- | "nanoseconds 3000 nanoseconds (-1000000000)"
instance instanceDebugDuration : Debug Duration
instanceDebugDuration =
  { debug = \x ->
        "nanoseconds "
        ^ (if totalNanoseconds x < 0 then "(" ^ debug (totalNanoseconds x) ^ ")"
           else debug (totalNanoseconds x))
  }

-- | As Go's `Duration.String` writes it: hours, minutes and seconds
-- | (`1h2m3.5s`, `2m0s`), the seconds' fraction without the `0`s it ends
-- | with; under a second, in the unit it has a whole one of (`1.5ms`,
-- | `1.5\u{B5}s`, `7ns`); none `0s`; and one back in time after a `-`.
-- | >>> show (hours 1 + minutes 2 + milliseconds 3500)
-- | "1h2m3.5s"
-- | >>> List.map show [zero, nanoseconds 7, nanoseconds 1500, microseconds 1500, seconds 1, seconds 90, minutes (-2), hours 100 + nanoseconds 1, days 2]
-- | ["0s", "7ns", "1.5\u{B5}s", "1.5ms", "1s", "1m30s", "-2m0s", "100h0m0.000000001s", "48h0m0s"]
instance instanceShowDuration : Show Duration
instanceShowDuration =
  { show = \x ->
        (if totalNanoseconds x == 0 then "0s"
         else if totalNanoseconds x < 0
         then "-" ^ unsignedText (0 - totalNanoseconds x)
         else unsignedText (totalNanoseconds x))
  }
  where
  -- (`n`, at least 0, in decimal, with `0`s before it to `width` digits)
  padded : Int -> Int -> String
  padded width n =
    joinWith "" (List.replicate (width - strLength (showInt n)) "0") ^ showInt n

  -- (`s` without the `0`s it ends with)
  withoutTrailingZeros : String -> String
  withoutTrailingZeros s =
    if strLength s > 0 && strByteAt s (strLength s - 1) == 48
    then withoutTrailingZeros (strSlice s 0 (strLength s - 1))
    else s

  -- (`u`, at least 0, as a decimal of `width` digits after its point:
  -- the whole part, and the fraction after a `.` without the `0`s it
  -- ends with, none for none)
  decimal : Int -> Int -> String
  decimal u width =
    let unit : Int = List.product (List.replicate width 10)
    in showInt (u / unit)
    ^ (if u % unit == 0 then ""
       else "." ^ withoutTrailingZeros (padded width (u % unit)))

  -- (a length of `u` nanoseconds, at least 1, as Go writes it)
  unsignedText : Int -> String
  unsignedText u =
    if u < 1000 then showInt u ^ "ns"
    else if u < 1000000
    then decimal u 3 ^ "\u{B5}s"
    else if u < 1000000000
    then decimal u 6 ^ "ms"
    else if u < 60000000000
    then decimal u 9 ^ "s"
    else if u < 3600000000000
    then showInt (u / 60000000000) ^ "m" ^ decimal (u % 60000000000) 9 ^ "s"
    else showInt (u / 3600000000000)
      ^ "h"
      ^ showInt (u / 60000000000 % 60)
      ^ "m"
      ^ decimal (u % 60000000000) 9
      ^ "s"

-- | It `k` times over: `times d 0` is `zero`, and `times d (-1)` is
-- | `-d`.
-- | >>> times (minutes 20) 3 == hours 1
-- | True
-- | >>> debug (times (milliseconds 5) (-2))
-- | "nanoseconds (-10000000)"
times : Duration -> Int -> Duration
times (MkDuration n) k = MkDuration (n * k)
