-- Files held by a `with`: `withFile path { access = Read } (\f ->
-- body)` opens a file, runs the body with it, a `With s OpenFile` in a
-- region `s` of its own, and closes it when the body ends -- `scoped`,
-- the shared `with`, around the opening and the closing of a file, which
-- are this module's own.  The file is had only by the operations here,
-- in the body.  Its effect is std.filesystem's.

module (withFile, readLineOf, writeStringTo)

import co
import std.filesystem
import with

-- (a file opened as `o` says, the host's own, or why it did not open)
opened : {e : HFunctor}
       -> {{ev : filesystem <: e}}
       -> String
       -> OpenOptions
       -> Co e (Either FileError OpenFile)
opened path o =
  op
    (ev
       (OpenHeld
          path
          (accessCode o.access)
          o.create
          o.truncate
          o.exclusive
          o.mode
          (\r -> r)))
    val

-- (a held file closed, or why it did not close)
closed : {e : HFunctor}
       -> {{ev : filesystem <: e}}
       -> OpenFile
       -> Co e (Either FileError Unit)
closed f = op (ev (ReleaseHeld f (\r -> r))) val

-- | `path` opened as `o` says, held by `body` in a region of its own --
-- | the file is not kept past it -- and closed when `body` ends: what it
-- | came to, or why the file did not open or close.  Should `body` be
-- | left otherwise -- a throw heard outside it, a handler between that
-- | drops the continuation -- the file is closed where the program
-- | drops its last reference to it: at once, in C, as it is counted.
withFile : {e : HFunctor}
         -> {a : Type}
         -> {{ev : filesystem <: e}}
         -> String
         -> OpenOptions
         -> ({s : Type} -> With s OpenFile -> Co e a)
         -> Co e (Either FileError a)
withFile path o body = scoped (opened path o) closed body

-- | The next line of a file held by a `with`, as `readLine`'s; after the
-- | `with` closed it, `EBADF`.
readLineOf : {e : HFunctor}
           -> {s : Type}
           -> {{ev : filesystem <: e}}
           -> With s OpenFile
           -> Co e (Either FileError (Maybe String))
readLineOf f = op (ev (ReadLineHeld (inside f) (\r -> r))) val

-- | A string written to a file held by a `with`, as `writeString`'s.
writeStringTo : {e : HFunctor}
              -> {s : Type}
              -> {{ev : filesystem <: e}}
              -> With s OpenFile
              -> String
              -> Co e (Either FileError Unit)
writeStringTo f str = op (ev (WriteHeld (inside f) str (\r -> r))) val
