-- For OS threads: work run truly at once, on std.domain's domains -- a
-- pool of them mapping a function over a list (`parMap`), a computation
-- run on n of them, each given its index (`spread`), and `Parallel`
-- handled by them, each side a domain (`inThreads`).  A library: no
-- provider of its own.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import co
-- import std.domain as Domain
-- import std.io
-- import std.thread
--
-- -- | the primes below `n`
-- primesBelow : Int -> Int
-- primesBelow n = List.length (List.keepIf isPrime (List.range 2 (n - 1)))
--   where
--   isPrime : Int -> Bool
--   isPrime k = List.all (\d -> k % d /= 0) (List.range 2 (k / 2))
--
-- counted : {e : HFunctor}
--         -> {{io : stdio <: e}}
--         -> {{dm : Domain.domain <: e}}
--         -> Co e Unit
-- counted = do
--   n <- cores
--   counts <- parMap n (\i -> primesBelow (1000 * (i + 1))) (List.range 0 7)
--   print (debug counts)
--   names <- parMap 4 (\s -> s ^ "!") ["a", "b", "c"]
--   print (joinWith " " names)
--   squares <- spread 4 (\i -> pure (i * i))
--   print (debug squares)
-- ```
--
-- Each asks for std.domain's effect, so it runs wherever domains do, in
-- JavaScript's one domain too.
--
-- - A task may take and give values of any type.
-- - `f` and the values are shared with the domains, not copied: a large
--   value every task reads is in memory once.
-- - Updating a shared value copies it while another domain holds it.
-- - If a task fails, the others stop taking more, and the caller fails as
--   the first failed task did, in the list's order: the program fails as
--   it would have, one domain doing all.
--
-- A spread's domains each run the computation it is given, effects and
-- all: what each prints, it prints.
--
-- Safe in threads at once: pure code and the definitions it reads, std.io
-- (each write is whole), and std.reference's cells (locked).  Not safe:
--
-- - `exit` in any thread ends the process.
-- - A provider's own tables are its own to lock.  Among the library's,
--   std.progress locks its own, and the others keep none.
-- - One thread letting go of a host's thing while another uses it is the
--   providers' to prevent.
-- - Windows is not tested.
--
-- A provider that starts threads, as std.domain's does, says so, on a
-- line of its own:
--
-- ```c
-- #define HEFF_THREADS 1
-- ```
--
-- The whole program is then built for threads.  A program none of whose
-- providers says it is built as before, and runs as fast as before.  What
-- such a provider uses, of the C runtime:
--
-- Function | What it does
-- --- | ---
-- `heff_share(v)` | mark `v` shared, before handing it to another thread
-- `heff_try(f, x, &out)` | run `f x`, catching a failure: `NULL`, or why it failed
-- `heff_fail_again(why)` | fail, in the joining thread, as the thread did
-- `heff_thread_start(&t, run, arg)` | start a thread with a large stack
-- `heff_thread_end()` | give the thread's memory back as it ends
-- `heff_freeze(v)` | make `v` immortal: never freed or counted
-- `HEFF_TLS` | declare per-thread state

module std.thread (parMap, cores, threaded, inThreads, spread)

import array as Array
import co
import parallel
import std.domain as Domain

-- The pool ---------------------------------------------------------------------------

-- (what a worker of a pool did: the answers of the tasks it took, each
-- with its place in the list, the last first; or the place of the task
-- it failed in, and why)
data Worked a = Answered (List (Int, a)) | FailedAt Int String

-- (tasks taken, one after another, the next from `next`, until none is
-- left or one fails -- and then no worker takes another: those before
-- it, in the list's order, were all taken)
working : {e : HFunctor}
        -> {b a : Type}
        -> {{dm : Domain.domain <: e}}
        -> Domain.Atomic Int
        -> (b -> a)
        -> Array b
        -> List (Int, a)
        -> Co e (Worked a)
working next f xs done = do
  i <- Domain.fetchAdd next 1
  if i >= Array.length xs then pure (Answered done)
  else do
    r <- Domain.tried (later (\u -> f (Array.arrayIndex xs i)))
    case r of
      Right y -> working next f xs ((i, y) :: done)
      Left why -> do
        _ <- Domain.fetchAdd next (Array.length xs)
        pure (FailedAt i why)

-- (`k` domains of the scope's, each running `c`)
spawnedAll : {e w : HFunctor}
           -> {s a : Type}
           -> {{sp : Domain.scoped w <: e}}
           -> Domain.Scope s w
           -> Co w a
           -> Int
           -> Co e (List (Domain.Domain a))
spawnedAll sc c k =
  if k <= 0 then pure Nil
  else do
    d <- Domain.spawn sc c
    ds <- spawnedAll sc c (k - 1)
    pure (d :: ds)

-- (each domain's answer, in order)
joinedAll : {e : HFunctor}
          -> {a : Type}
          -> {{dm : Domain.domain <: e}}
          -> List (Domain.Domain a)
          -> Co e (List a)
joinedAll Nil = pure Nil
joinedAll (d :: ds) = do
  v <- Domain.join d
  vs <- joinedAll ds
  pure (v :: vs)

-- (the earlier, in the list's order, of a failure seen and a worker's)
earlier : {a : Type} -> Maybe (Int, String) -> Worked a -> Maybe (Int, String)
earlier seen (Answered done) = seen
earlier Nothing (FailedAt i why) = Just (i, why)
earlier (Just p) (FailedAt i why) = if i < fst p then Just (i, why) else Just p

-- (what a worker answered)
answersOf : {a : Type} -> Worked a -> List (Int, a)
answersOf (Answered done) = done
answersOf (FailedAt i why) = Nil

-- (two lists of answers, each by its place, the last first: one so)
mergedDown : {a : Type} -> List (Int, a) -> List (Int, a) -> List (Int, a)
mergedDown Nil ys = ys
mergedDown xs Nil = xs
mergedDown (x :: xs) (y :: ys) =
  if fst x > fst y then x :: mergedDown xs (y :: ys)
  else y :: mergedDown (x :: xs) ys

-- (... each two of them merged)
mergedPairs : {a : Type} -> List (List (Int, a)) -> List (List (Int, a))
mergedPairs (l :: m :: ls) = mergedDown l m :: mergedPairs ls
mergedPairs ls = ls

-- (... all of them, merged two by two)
mergedAll : {a : Type} -> List (List (Int, a)) -> List (Int, a)
mergedAll Nil = Nil
mergedAll (l :: Nil) = l
mergedAll ls = mergedAll (mergedPairs ls)

-- (an answer put before those after it)
placedBefore : {a : Type} -> List a -> (Int, a) -> List a
placedBefore rest p = snd p :: rest

-- (the answers, in the list's order, or the first failure, in that
-- order, the caller's)
settled : {e : HFunctor}
        -> {a : Type}
        -> {{dm : Domain.domain <: e}}
        -> Maybe (Int, String)
        -> List (Worked a)
        -> Co e (List a)
settled (Just p) ws = Domain.fail (snd p)
settled Nothing ws =
  pure (List.foldl placedBefore Nil (mergedAll (List.map answersOf ws)))

-- (`f` of each of `xs` by `w` domains, the caller one of them, in a
-- scope of their own)
pooled : {e : HFunctor}
       -> {b a : Type}
       -> {{dm : Domain.domain <: e}}
       -> Int
       -> (b -> a)
       -> Array b
       -> Co e (List a)
pooled w f xs = do
  next <- Domain.newAtomic 0
  ws <-
    with s := Domain.scope do
      others <- spawnedAll s (working next f xs Nil) (w - 1)
      mine <- working next f xs Nil
      theirs <- joinedAll others
      pure (mine :: theirs)
  settled (List.foldl earlier Nothing ws) ws

-- (... where `w` is more than one: else the caller alone)
pooledBy : {e : HFunctor}
         -> {b a : Type}
         -> {{dm : Domain.domain <: e}}
         -> Int
         -> (b -> a)
         -> List b
         -> Co e (List a)
pooledBy w f xs =
  if w <= 1 then later (\u -> List.map f xs)
  else pooled w f (Array.fromList xs)

-- | `f` of each of `xs`, by `n` domains (the caller one of them), each
-- | taking the next value as it ends one: the answers, in order.  `f` and
-- | each value are shared with the domains, not copied.  A task that
-- | fails stops the others taking more, and the first that failed, in
-- | the list's order, fails the caller.  One domain, or one value, is
-- | the caller alone.
parMap : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> {b a : Type}
       -> Int
       -> (b -> a)
       -> List b
       -> Co e (List a)
parMap n f xs = pooledBy (min n (List.length xs)) f xs

-- | How many threads the machine runs at once: its cores, as the system
-- | says (1 where it does not), as std.domain's `cores`.
cores : {e : HFunctor} -> {{dm : Domain.domain <: e}} -> Co e Int
cores = Domain.cores

-- Parallel, by domains ---------------------------------------------------------------

-- | `Parallel` into `Co e`, each side a domain: the left this one, the
-- | right one of its own, in a scope of their own.  A side's pure work
-- | is done where it is handled, before its domain starts, unless it
-- | comes after an operation or after `later` (`parallelIn` says so):
-- | `parallelIn (later (\u -> fib n)) ...`.  Where both fail, the left's
-- | failure is the caller's, as one domain doing both would have failed.
threaded : {e : HFunctor}
         -> {{dm : Domain.domain <: e}}
         -> {a b x : Type}
         -> ParallelF a b (Co e) x
         -> Co e x
threaded (Parallel l r k) = do
  with s := Domain.scope do
    d <- Domain.spawn s r
    y <- lift l
    z <- Domain.join d
    pure (k y z)

-- | `Parallel` handled by domains, into `Co e`: the rest of the world
-- | left as it is.
inThreads : (a b : Type)
          -> (e : HFunctor)
          -> {{dm : Domain.domain <: e}}
          -> Handler (parallel a b <+> e)
inThreads a b e = through (parallel a b) e (\p -> threaded p)

-- Spreads ---------------------------------------------------------------------------

-- (`c i` run here, its failure caught)
triedAt : {e : HFunctor}
        -> {a : Type}
        -> {{dm : Domain.domain <: e}}
        -> (Int -> Co e a)
        -> Int
        -> Co e (Either String a)
triedAt c i = Domain.tried (bind (later (\u -> c i)) (\m -> m))

-- (a domain of the scope's for each of `c i` to `c (n - 1)`)
spawnedFrom : {e w : HFunctor}
            -> {s a : Type}
            -> {{sp : Domain.scoped w <: e}}
            -> {{dm : Domain.domain <: w}}
            -> Domain.Scope s w
            -> (Int -> Co w a)
            -> Int
            -> Int
            -> Co e (List (Domain.Domain (Either String a)))
spawnedFrom sc c i n =
  if i >= n then pure Nil
  else do
    d <- Domain.spawn sc (triedAt c i)
    ds <- spawnedFrom sc c (i + 1) n
    pure (d :: ds)

-- (the answers, in order, or the first failure, in that order, the
-- caller's)
spreadAnswers : {e : HFunctor}
              -> {a : Type}
              -> {{dm : Domain.domain <: e}}
              -> List (Either String a)
              -> Co e (List a)
spreadAnswers Nil = pure Nil
spreadAnswers (Left why :: rs) = Domain.fail why
spreadAnswers (Right v :: rs) = do
  vs <- spreadAnswers rs
  pure (v :: vs)

-- (... `n` of them, one at least)
spreadOver : {e : HFunctor}
           -> {a : Type}
           -> {{dm : Domain.domain <: e}}
           -> Int
           -> (Int -> Co e a)
           -> Co e (List a)
spreadOver n c = do
  rs <-
    with s := Domain.scope do
      others <- spawnedFrom s c 1 n
      mine <- lift (triedAt c 0)
      theirs <- joinedAll others
      pure (mine :: theirs)
  spreadAnswers rs

-- | `c 0` to `c (n - 1)` at once, each on a domain (`c 0` this one), in a
-- | scope of their own: their answers, in order.  `c` is a computation
-- | of the world here: each domain runs it with the handlers between
-- | here and the program's world, and holds what it is given shared.
-- | Where some fail, the first, in order, fails the caller, once all
-- | have ended.  Fewer than one, none.
spread : {e : HFunctor}
       -> {{dm : Domain.domain <: e}}
       -> {a : Type}
       -> Int
       -> (Int -> Co e a)
       -> Co e (List a)
spread n c = if n <= 0 then pure Nil else spreadOver n c
