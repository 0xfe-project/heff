-- Threads as an effect: work run truly at once, OS threads sharing values,
-- by C alone.  There is no JavaScript side: a program with this effect is
-- compiled for C, `--backend=c`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import co
-- import std.io
-- import std.thread
--
-- -- | the primes below `n`
-- primesBelow : Int -> Int
-- primesBelow n = List.length (List.keepIf isPrime (List.range 2 (n - 1)))
--   where
--   isPrime : Int -> Bool
--   isPrime k = List.all (\d -> k % d /= 0) (List.range 2 (k / 2))
--
-- counted : {e : HFunctor} -> {{io : stdio <: e}} -> {{th : threads <: e}} -> Co e Unit
-- counted = do
--   n <- cores
--   counts <- parFor n 8 (\i -> primesBelow (1000 * (i + 1)))
--   print (show counts)
--   names <- parMap 4 (\s -> s ^ "!") ["a", "b", "c"]
--   print (joinWith " " names)
-- ```
--
-- A pool of workers maps a function over a list or a range (`parMap`,
-- `parFor`); a spread gives the rest of the program to each of n threads,
-- a gather joins them; and `Parallel` is handled by them, each side a
-- thread (`inThreads`).
--
-- - A task may take and give values of any type.
-- - `f` and the values are shared with the threads, not copied: a large
--   value every task reads is in memory once.
-- - A shared value is never updated in place: updating it copies it.
-- - If a task fails, the others stop taking more, and the caller fails as
--   the first failed task did, in the list's order: the program fails as
--   it would have, one thread doing all.
-- - A spread's threads run the rest of the program, effects and all: what
--   one prints, all print.
--
-- Safe in threads at once: pure code and the definitions it reads, std.io
-- (each write is whole), and std.reference's cells (locked).  Not safe:
--
-- - `exit` in any thread ends the process.
-- - A provider's own tables are its own to lock.  Among the library's,
--   std.progress locks its own, and the others keep none.
-- - One thread letting go of a host's thing while another uses it is the
--   providers' to prevent.
-- - Windows is not tested.
--
-- A provider that starts threads, as this module's does, says so, on a
-- line of its own:
--
-- ```c
-- #define HEFF_THREADS 1
-- ```
--
-- The whole program is then built for threads.  A program none of whose
-- providers says it is built as before, and runs as fast as before.  What
-- such a provider uses, of the C runtime:
--
-- Function | What it does
-- --- | ---
-- `heff_share(v)` | mark `v` shared, before handing it to another thread
-- `heff_try(f, x, &out)` | run `f x`, catching a failure: `NULL`, or why it failed
-- `heff_fail_again(why)` | fail, in the joining thread, as the thread did
-- `heff_thread_start(&t, run, arg)` | start a thread with a large stack
-- `heff_thread_end()` | give the thread's memory back as it ends
-- `heff_freeze(v)` | make `v` immortal: never freed or counted
-- `HEFF_TLS` | declare per-thread state

module std.thread

import co
import ffi as FFI
import parallel

-- | Work for a pool: `f` of each of `xs`, their answers given to `k`, in
-- | order.  What a task takes and gives are the work's own types, not
-- | the effect's -- one effect for all the types a program maps -- so
-- | the work is what it does with whatever is done with them.
type Work x =
  (r : Type) -> ((t a : Type) -> (t -> a) -> List t -> (List a -> x) -> r) -> r

-- | A thread's value at a gather, and what is done with all of them.
type Joined x = (r : Type) -> ((a : Type) -> a -> (List a -> x) -> r) -> r

data ThreadsF (m : Type -> Type) x
  = Pool Int (Work x)
  | Spread Int (Int -> x)
  | Gather (Joined x)
  | Cores (Int -> x)

work : {t a x : Type} -> (t -> a) -> List t -> (List a -> x) -> Work x
work f xs k = \r use -> use t a f xs k

joined : {a x : Type} -> a -> (List a -> x) -> Joined x
joined v k = \r use -> use a v k

workThen : {x y : Type} -> (x -> y) -> Work x -> Work y
workThen g w = \r use -> w r (\t a f xs k -> use t a f xs (\l -> g (k l)))

joinedThen : {x y : Type} -> (x -> y) -> Joined x -> Joined y
joinedThen g j = \r use -> j r (\a v k -> use a v (\l -> g (k l)))

-- | Threads as an effect.
threads : HFunctor
threads =
  { f = ThreadsF
  , hfmap = \m g p -> case p of
      Pool n w -> Pool n (workThen g w)
      Spread n k -> Spread n (\i -> g (k i))
      Gather j -> Gather (joinedThen g j)
      Cores k -> Cores (\c -> g (k c))
  , hmap = \m n nt p -> case p of
      Pool n w -> Pool n w
      Spread n k -> Spread n k
      Gather j -> Gather j
      Cores k -> Cores k
  }

-- The pool ---------------------------------------------------------------------------

-- | `f` of each of `xs`, by `n` threads (the caller one of them), each
-- | taking the next value as it ends one: the answers, in order.  `f` and
-- | each value are shared with the threads, not copied;
-- | an answer is handed back as it is.  A task that fails
-- | stops the others taking more, and the first that failed, in the
-- | list's order, fails the caller.
parMap : {e : HFunctor}
       -> {{th : threads <: e}}
       -> {b a : Type}
       -> Int
       -> (b -> a)
       -> List b
       -> Co e (List a)
parMap n f xs = op (th (Pool n (work f xs (\r -> r)))) val

-- | `f 0 .. f (count - 1)`, by `n` threads.
parFor : {e : HFunctor}
       -> {{th : threads <: e}}
       -> {a : Type}
       -> Int
       -> Int
       -> (Int -> a)
       -> Co e (List a)
parFor n count f = parMap n f (List.range 0 (count - 1))

-- | How many threads the machine runs at once: its cores, as the system
-- | says (1 where it does not).
cores : {e : HFunctor} -> {{th : threads <: e}} -> Co e Int
cores = op (th (Cores (\c -> c))) val

-- | What C does of these by a function of the provider's, the compiler
-- | making the glue (ffi): `Cores` is `th_cores()`.
threadsInC : FFI.Described
threadsInC =
  FFI.describe
    Nil
    [FFI.operation "Cores" (FFI.fun "th_cores" Nil (FFI.gives FFI.int64))]

-- Spreads ----------------------------------------------------------------------------

-- | `n` threads from here on, each with the rest of the program, shared:
-- | this one is 0, the others 1 to n-1.
spread : {e : HFunctor} -> {{th : threads <: e}} -> Int -> Co e Int
spread n = op (th (Spread n (\i -> i))) val

-- | The threads of the last spread joined: in thread 0, every one's
-- | value, in order; every other thread ends here.  Outside a spread,
-- | the value alone.
gather : {e : HFunctor}
       -> {{th : threads <: e}}
       -> {a : Type}
       -> a
       -> Co e (List a)
gather v = op (th (Gather (joined v (\r -> r)))) val

-- Parallel, by threads ---------------------------------------------------------------

-- (`k` of thread 0's answer and thread 1's)
bothSides : {a b x : Type} -> (a -> b -> x) -> List (Either a b) -> x
bothSides k (Left y :: Right z :: _) = k y z
bothSides k _ = abandon

-- | `Parallel` into `Co e`, each side a thread of its own: a spread into two,
-- | joined again.  A side's pure work is done where it is handled, before
-- | the spread, unless it comes after an operation or after `later`
-- | (`parallelIn` says so): `parallelIn (later (\u ->
-- | fib n)) ...`.
threaded : {e : HFunctor}
         -> {{th : threads <: e}}
         -> {a b x : Type}
         -> ParallelF a b (Co e) x
         -> Co e x
threaded (Parallel l r k) = do
  i <- spread 2
  y <-
    (if i == 0 then bind l (\v -> val (Left v : Either a b))
     else bind r (\v -> val (Right v : Either a b)))
  ys <- gather y
  pure (bothSides k ys)

-- | `Parallel` handled by threads, into `Co e`: the rest of the world left as
-- | it is.
inThreads : (a b : Type)
          -> (e : HFunctor)
          -> {{th : threads <: e}}
          -> Handler (parallel a b <+> e)
inThreads a b e = through (parallel a b) e (\p -> threaded p)
