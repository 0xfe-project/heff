-- Sets, by an order of their elements: a map whose values are nothing.
-- The order is the elements' `Order`, found as an instance argument is,
-- always the same one for a set.  Import it by a name, `import std.set as
-- Set`.  The set comes first, as a map does: `Set.insert s x`.

module std.set

import std.ordmap as OrdMap

-- | A set: a map of its elements to nothing.
type Set a = OrdMap.OrdMap a Unit

-- | The set of nothing.
empty : {a : Type} -> Set a
empty = OrdMap.empty

-- | The set with `x` in it.
insert : {a : Type} -> {{ord : Order a}} -> Set a -> a -> Set a
insert s x = OrdMap.insert s x MkUnit

-- | Whether `x` is in the set.
member : {a : Type} -> {{ord : Order a}} -> Set a -> a -> Bool
member s x = OrdMap.member s x

-- | The set without `x` (as it was, if `x` was not in it).
delete : {a : Type} -> {{ord : Order a}} -> Set a -> a -> Set a
delete s x = OrdMap.delete s x

-- | The elements, in order.
toList : {a : Type} -> Set a -> List a
toList s = OrdMap.keys s

-- | The set of a list's elements.
-- | >>> toList (fromList [3, 1, 3])
-- | Cons 1 (Cons 3 Nil)
fromList : {a : Type} -> {{ord : Order a}} -> List a -> Set a
fromList xs = List.foldl (\s x -> insert s x) empty xs

-- | The elements `p` holds of.
-- | >>> toList (keepIf (fromList [1, 2, 3]) (\x -> x % 2 == 1))
-- | Cons 1 (Cons 3 Nil)
keepIf : {a : Type} -> {{ord : Order a}} -> Set a -> (a -> Bool) -> Set a
keepIf s p = fromList (List.keepIf p (toList s))

-- | How many elements it has.
size : {a : Type} -> Set a -> Int
size s = OrdMap.size s

-- | The elements of both.
union : {a : Type} -> {{ord : Order a}} -> Set a -> Set a -> Set a
union a b = OrdMap.union a b

-- | The elements of `a` that are in `b` too.
-- | >>> toList (intersection (fromList [1, 2, 3]) (fromList [2, 3, 4]))
-- | Cons 2 (Cons 3 Nil)
intersection : {a : Type} -> {{ord : Order a}} -> Set a -> Set a -> Set a
intersection a b = keepIf a (\x -> member b x)

-- | The elements of `a` that are not in `b`.
-- | >>> toList (difference (fromList [1, 2, 3]) (fromList [2, 4]))
-- | Cons 1 (Cons 3 Nil)
difference : {a : Type} -> {{ord : Order a}} -> Set a -> Set a -> Set a
difference a b = List.foldl (\s x -> delete s x) a (toList b)

-- | Whether every element of `a` is in `b`.
-- | >>> List.map (\s -> isSubset s (fromList [1, 2, 3])) [fromList [1, 3], empty, fromList [0, 1]]
-- | Cons True (Cons True (Cons False Nil))
isSubset : {a : Type} -> {{ord : Order a}} -> Set a -> Set a -> Bool
isSubset a b = List.all (\x -> member b x) (toList a)

-- | Whether it has no elements.
-- | >>> List.map null [empty, fromList [1]]
-- | Cons True (Cons False Nil)
null : {a : Type} -> Set a -> Bool
null s = OrdMap.null s

-- | The least element, if there is one.
-- | >>> findMin (fromList [3, 1, 2])
-- | Just 1
findMin : {a : Type} -> Set a -> Maybe a
findMin s = maybe Nothing (\p -> Just (fst p)) (OrdMap.findMin s)

-- | The greatest element, if there is one.
-- | >>> findMax (fromList [3, 1, 2])
-- | Just 3
findMax : {a : Type} -> Set a -> Maybe a
findMax s = maybe Nothing (\p -> Just (fst p)) (OrdMap.findMax s)

-- | The elements, in order, into `z`.
-- | >>> foldl (\acc x -> acc * 10 + x) 0 (fromList [3, 1, 2])
-- | 123
foldl : {a b : Type} -> (b -> a -> b) -> b -> Set a -> b
foldl f z s = List.foldl f z (toList s)
