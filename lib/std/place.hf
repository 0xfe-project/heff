-- Places as an effect: like Racket's, a place is a thread with a heap of
-- its own that shares nothing, by C alone (its provider, which builds the
-- runtime for threads).  There is no JavaScript side: a program with this
-- effect is compiled for C, `--backend=c`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import std.io
-- import std.place
--
-- -- | the first `n` numbers sent from another place, and their sum
-- summed : {e : HFunctor} -> {{io : stdio <: e}} -> {{pl : places <: e}} -> Int -> Co e Unit
-- summed n = do
--   ch <- newPlaceChannel
--   sender <- spawnPlace (sendPlace ch (List.range 1 n))
--   xs <- recvPlace ch
--   joinPlace sender
--   print (show (List.sum xs))
-- ```
--
-- A place runs a computation of the world given to it (`spawnPlace`), and
-- is joined, once, for its value (`joinPlace`); places talk over place
-- channels (`newPlaceChannel`, `sendPlace`, `recvPlace`).
--
-- - A value sent is copied into the receiver, never shared: nothing of a
--   place's is counted atomically, and no object is held by two places.
--   Strings, bytes and arrays larger than 128 bytes that the sender alone
--   holds are moved instead, without copying.
-- - A channel is typed, `PlaceChannel a`, what crosses it any type,
--   functions and channels too; a place's computation holds whatever it
--   holds, copied as it is given to the place.
-- - A failure in a place is the joiner's when the place is joined, as a
--   thread's is (std.thread).
-- - A place's working directory is its own: it starts in its starter's,
--   and `setWorkingDir` moves only that place.
-- - Receiving blocks the place until something is sent, and joining until
--   the place has ended; in a group of std.reactor's, each is pending, the
--   other green threads of the place going on.
--
-- Copying costs some 15 ns a list cell: a program that sends a lot should
-- send answers rather than inputs, or use std.thread.

module std.place

import co
import ffi as Ffi

-- | A place as the host has it, a thread: a foreign value, had as a
-- | `Place a`.
data Spot

-- | A place started, of whatever it comes to.  Dropped before it is
-- | joined, it is joined where the program drops its last reference to
-- | it, what it came to left unread.
data Place a = MkPlace Spot

-- | A channel as the host has it: a foreign value, had as a
-- | `PlaceChannel a`.  It crosses to a place with the computation given
-- | to it, each place holding it as its own, and is freed, with what
-- | was sent and not received, when no place holds it.
data Channel

-- | A channel between places, carrying values of `a`.
data PlaceChannel a = MkPlaceChannel Channel

-- | A place's computation, and what is done with the place: the type it
-- | comes to the operation's own, erased, so that one effect starts
-- | places of every type.
type Started (m : Type -> Type) x =
  (r : Type) -> ((a : Type) -> m a -> (Place a -> x) -> r) -> r

-- | A value joined or received, and what is done with it, of any type.
type Got x = (r : Type) -> ((a : Type) -> (a -> x) -> r) -> r

-- | A value sent, of any type, and what comes after.
type Sent x = (r : Type) -> ((a : Type) -> a -> x -> r) -> r

data PlacesF (m : Type -> Type) x
  = Spawn (Started m x)
  | Join Spot (Got x)
  | NewChannel (Channel -> x)
  | Send Channel (Sent x)
  | Recv Channel (Got x)

started : {m : Type -> Type}
        -> {a x : Type}
        -> m a
        -> (Place a -> x)
        -> Started m x
started c k = \r use -> use a c k

got : {a x : Type} -> (a -> x) -> Got x
got k = \r use -> use a k

sent : {a x : Type} -> a -> x -> Sent x
sent v x = \r use -> use a v x

gotThen : {x y : Type} -> (x -> y) -> Got x -> Got y
gotThen g j = \r use -> j r (\a k -> use a (\v -> g (k v)))

-- (a channel as C has it: a pointer that crosses places, each holding
-- it once more as it is given it, and letting it go as it drops its
-- last reference)
channel : Ffi.CType
channel = Ffi.sharedPointer "HeffChan" "heff_chan_drop" "heff_chan_hold"

-- | The operations C does at once: a channel made.  (The rest -- a
-- | spawn, a join, a send, a receive -- are the provider's own, a join
-- | and a receive pending in a group of the reactor's.)
placesInC : Ffi.Described
placesInC =
  Ffi.describe
    Nil
    [ Ffi.operation
      "NewChannel"
      (Ffi.fun "heff_chan_new" Nil (Ffi.gives channel))
    ]

-- | Places as an effect.
places : HFunctor
places =
  { f = PlacesF
  , hfmap = \m g p -> case p of
      Spawn s -> Spawn (\r use -> s r (\a c k -> use a c (\pl -> g (k pl))))
      Join i j -> Join i (gotThen g j)
      NewChannel k -> NewChannel (\ch -> g (k ch))
      Send i s -> Send i (\r use -> s r (\a v x -> use a v (g x)))
      Recv i j -> Recv i (gotThen g j)
  , hmap = \m n nt p -> case p of
      Spawn s -> Spawn (\r use -> s r (\a c k -> use a (nt c) k))
      Join i j -> Join i j
      NewChannel k -> NewChannel k
      Send i s -> Send i s
      Recv i j -> Recv i j
  }

-- | `c` run in a place of its own, from now: the place.  What `c` holds
-- | is copied into the place; what it comes to is the joiner's.
spawnPlace : {e : HFunctor}
           -> {{pl : places <: e}}
           -> {a : Type}
           -> Co e a
           -> Co e (Place a)
spawnPlace c = op (pl (Spawn (started c (\p -> p)))) val

-- | The place's value, waited for and copied here; its failure, failing
-- | here.  A place is joined once.
joinPlace : {e : HFunctor}
          -> {{pl : places <: e}}
          -> {a : Type}
          -> Place a
          -> Co e a
joinPlace (MkPlace p) = op (pl (Join p (got (\v -> v)))) val

-- | A channel of its own, for values of `a`.
newPlaceChannel : {e : HFunctor}
                -> {{pl : places <: e}}
                -> {a : Type}
                -> Co e (PlaceChannel a)
newPlaceChannel =
  bind (op (pl (NewChannel (\ch -> ch))) val) (\ch -> pure (MkPlaceChannel ch))

-- | `v` sent on the channel: copied (or moved) into a message the
-- | channel holds until it is received; the sender goes on at once.
sendPlace : {e : HFunctor}
          -> {{pl : places <: e}}
          -> {a : Type}
          -> PlaceChannel a
          -> a
          -> Co e Unit
sendPlace (MkPlaceChannel ch) v = op (pl (Send ch (sent v MkUnit))) val

-- | The next value sent on the channel, waited for, made the receiver's
-- | own.
recvPlace : {e : HFunctor}
          -> {{pl : places <: e}}
          -> {a : Type}
          -> PlaceChannel a
          -> Co e a
recvPlace (MkPlaceChannel ch) = op (pl (Recv ch (got (\v -> v)))) val
