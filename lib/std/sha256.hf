-- SHA-256, the hash of FIPS 180-4: any bytes to 32 bytes, so that bytes
-- that are not the same are, as far as anyone can find, not hashed to the
-- same 32.  Written in heff, a block of 64 bytes at a time.
--
-- ```haskell
-- import bytes as Bytes
-- import std.sha256 as Sha256
--
-- -- | whether a file's content is what its published hash says
-- intact : Bytes -> Bytes -> Bool
-- intact content published = Sha256.digest content == published
-- ```

module std.sha256 (digest)

import array as Array
import bytes as Bytes
import uint32 as UInt32
import uint8 as UInt8

-- | The SHA-256 hash of the bytes, 32 bytes.
-- | >>> digest Bytes.empty == b[0xe3b0c44298fc1c14::64, 0x9afbf4c8996fb924::64, 0x27ae41e4649b934c::64, 0xa495991b7852b855::64]
-- | True
-- | >>> digest (Bytes.fromString "abc") == b[0xba7816bf8f01cfea::64, 0x414140de5dae2223::64, 0xb00361a396177a9c::64, 0xb410ff61f20015ad::64]
-- | True
-- | >>> digest (Bytes.fromString "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == b[0x248d6a61d20638b8::64, 0xe5c026930c3e6039::64, 0xa33ce45964ff2167::64, 0xf6ecedd419db06c1::64]
-- | True
-- | >>> digest (Bytes.fromString "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") == b[0xcf5b16a778af8380::64, 0x036ce59e7b049237::64, 0x0b249b11e8f07a51::64, 0xafac45037afee9d1::64]
-- | True
-- | >>> digest (Bytes.fromList (List.replicate 1000 97)) == b[0x41edece42d63e8d9::64, 0xbf515a9ba6932e1c::64, 0x20cbc9f5a5d13464::64, 0x5adb5db1b9737ea3::64]
-- | True
digest : Bytes -> Bytes
digest m =
  let hs : Array UInt32 =
    blocksFrom
      padded
      0
      (Array.replicate 64 0)
      (Array.fromList
         [ 0x6a09e667
         , 0xbb67ae85
         , 0x3c6ef372
         , 0xa54ff53a
         , 0x510e527f
         , 0x9b05688c
         , 0x1f83d9ab
         , 0x5be0cd19
         ])
  in Bytes.concat (List.map (\x -> b[UInt32.toInt x::32]) (Array.toList hs))
  where
  -- (the bytes padded to whole blocks: a 1 bit, zeros, then their length
  -- in bits, 64 bits big-endian)
  padded : Bytes
  padded =
    let n : Int = Bytes.length m
    in Bytes.concat
      [ m
      , b[0x80]
      , Bytes.fromList (List.replicate ((55 - n) % 64) 0)
      , b[(n * 8)::64]
      ]
  -- (the hash `hs` after the blocks of `m` from `at` on, `w` room for a
  -- block's schedule)
  blocksFrom : Bytes -> Int -> Array UInt32 -> Array UInt32 -> Array UInt32
  blocksFrom m at w hs =
    if at >= Bytes.length m then hs
    else let ws : Array UInt32 = scheduled 0 w
         in blocksFrom
           m
           (at + 64)
           ws
           (rounds
              ws
              0
              (Array.arrayIndex hs 0)
              (Array.arrayIndex hs 1)
              (Array.arrayIndex hs 2)
              (Array.arrayIndex hs 3)
              (Array.arrayIndex hs 4)
              (Array.arrayIndex hs 5)
              (Array.arrayIndex hs 6)
              (Array.arrayIndex hs 7))
    where
    -- (the first 32 bits of the fractional parts of the cube roots of the
    -- first 64 primes, a round's constant each)
    roundConstants : Array UInt32
    roundConstants =
      Array.fromList
        [ 0x428a2f98
        , 0x71374491
        , 0xb5c0fbcf
        , 0xe9b5dba5
        , 0x3956c25b
        , 0x59f111f1
        , 0x923f82a4
        , 0xab1c5ed5
        , 0xd807aa98
        , 0x12835b01
        , 0x243185be
        , 0x550c7dc3
        , 0x72be5d74
        , 0x80deb1fe
        , 0x9bdc06a7
        , 0xc19bf174
        , 0xe49b69c1
        , 0xefbe4786
        , 0x0fc19dc6
        , 0x240ca1cc
        , 0x2de92c6f
        , 0x4a7484aa
        , 0x5cb0a9dc
        , 0x76f988da
        , 0x983e5152
        , 0xa831c66d
        , 0xb00327c8
        , 0xbf597fc7
        , 0xc6e00bf3
        , 0xd5a79147
        , 0x06ca6351
        , 0x14292967
        , 0x27b70a85
        , 0x2e1b2138
        , 0x4d2c6dfc
        , 0x53380d13
        , 0x650a7354
        , 0x766a0abb
        , 0x81c2c92e
        , 0x92722c85
        , 0xa2bfe8a1
        , 0xa81a664b
        , 0xc24b8b70
        , 0xc76c51a3
        , 0xd192e819
        , 0xd6990624
        , 0xf40e3585
        , 0x106aa070
        , 0x19a4c116
        , 0x1e376c08
        , 0x2748774c
        , 0x34b0bcb5
        , 0x391c0cb3
        , 0x4ed8aa4a
        , 0x5b9cca4f
        , 0x682e6ff3
        , 0x748f82ee
        , 0x78a5636f
        , 0x84c87814
        , 0x8cc70208
        , 0x90befffa
        , 0xa4506ceb
        , 0xbef9a3f7
        , 0xc67178f2
        ]
    -- (the big-endian word of the four bytes from `i`)
    wordAt : Int -> UInt32
    wordAt i =
      UInt32.fromInt
        (UInt8.toInt (Bytes.bytesAt m i) * 16777216
         + UInt8.toInt (Bytes.bytesAt m (i + 1)) * 65536
         + UInt8.toInt (Bytes.bytesAt m (i + 2)) * 256
         + UInt8.toInt (Bytes.bytesAt m (i + 3)))
    -- (the message schedule `w` of the block at `at`, its words from `t` on
    -- written)
    scheduled : Int -> Array UInt32 -> Array UInt32
    scheduled t w =
      if t >= 64 then w
      else if t < 16
      then scheduled (t + 1) (Array.set w t (wordAt (at + 4 * t)))
      else let back15 : UInt32 = Array.arrayIndex w (t - 15)
           in let back2 : UInt32 = Array.arrayIndex w (t - 2)
           in let sigma0 : UInt32 =
             xor
               (xor
                  (UInt32.rotateRight back15 7)
                  (UInt32.rotateRight back15 18))
               (shiftR back15 3)
           in let sigma1 : UInt32 =
             xor
               (xor (UInt32.rotateRight back2 17) (UInt32.rotateRight back2 19))
               (shiftR back2 10)
           in let next : UInt32 =
             Array.arrayIndex w (t - 16)
             + sigma0
             + Array.arrayIndex w (t - 7)
             + sigma1
           in scheduled (t + 1) (Array.set w t next)
    -- (the rounds from `t` of the working variables `a` to `h` over the
    -- schedule `w`, then each added to the hash `hs` the block began with)
    rounds : Array UInt32
           -> Int
           -> UInt32
           -> UInt32
           -> UInt32
           -> UInt32
           -> UInt32
           -> UInt32
           -> UInt32
           -> UInt32
           -> Array UInt32
    rounds w t a b c d e f g h =
      if t >= 64
      then Array.fromList
          [ Array.arrayIndex hs 0 + a
          , Array.arrayIndex hs 1 + b
          , Array.arrayIndex hs 2 + c
          , Array.arrayIndex hs 3 + d
          , Array.arrayIndex hs 4 + e
          , Array.arrayIndex hs 5 + f
          , Array.arrayIndex hs 6 + g
          , Array.arrayIndex hs 7 + h
          ]
      else let sum1 : UInt32 =
             xor
               (xor (UInt32.rotateRight e 6) (UInt32.rotateRight e 11))
               (UInt32.rotateRight e 25)
           in let choice : UInt32 = xor (and e f) (and (complement e) g)
           in let first : UInt32 =
             h
             + sum1
             + choice
             + Array.arrayIndex roundConstants t
             + Array.arrayIndex w t
           in let sum0 : UInt32 =
             xor
               (xor (UInt32.rotateRight a 2) (UInt32.rotateRight a 13))
               (UInt32.rotateRight a 22)
           in let majority : UInt32 = xor (xor (and a b) (and a c)) (and b c)
           in rounds w (t + 1) (first + sum0 + majority) a b c (d + first) e f g
