-- Maps from keys to values, by an order of the keys: a balanced (AVL) tree,
-- so a lookup, an insertion or a deletion takes as many steps as the log of
-- the size.  The keys' order is their type's `Order`, found as an instance
-- argument is (the prelude's of `Int`, `String`, `Rune`, ..., or one of
-- your own), and a map must always be given the same one.  Import it by a name, `import std.map as Map`
-- (`Map.insert`), as the prelude has a `map` and a `lookupBy`.

-- | A map, as a tree: each node with its height, a key, its value, and the
-- | smaller keys left, the greater right.
data Map k v = Tip | Bin Int k v (Map k v) (Map k v)

empty : {k v : Type} -> Map k v
empty = Tip

singleton : {k v : Type} -> k -> v -> Map k v
singleton k v = Bin 1 k v Tip Tip

height : {k v : Type} -> Map k v -> Int
height Tip = 0
height (Bin h _ _ _ _) = h

-- (a node over two trees whose heights differ by one at most)
node : {k v : Type} -> k -> v -> Map k v -> Map k v -> Map k v
node k v l r = Bin (1 + max (height l) (height r)) k v l r

-- (a node over two trees whose heights differ by two at most, rotated so
-- that they differ by one at most)
balance : {k v : Type} -> k -> v -> Map k v -> Map k v -> Map k v
balance k v l r =
  if height l > height r + 1
  then (case l of
        Tip -> abandon
        Bin _ lk lv ll lr ->
          if height ll >= height lr then node lk lv ll (node k v lr r)
          else (case lr of
                Tip -> abandon
                Bin _ mk mv ml mr ->
                  node mk mv (node lk lv ll ml) (node k v mr r)))
  else if height r > height l + 1
  then (case r of
        Tip -> abandon
        Bin _ rk rv rl rr ->
          if height rr >= height rl then node rk rv (node k v l rl) rr
          else (case rl of
                Tip -> abandon
                Bin _ mk mv ml mr ->
                  node mk mv (node k v l ml) (node rk rv mr rr)))
  else node k v l r

-- (the height of a node over subtrees `a` and `b` high, if they are
-- balanced, else 0)
heightOver : Int -> Int -> Int
heightOver a b = if a > b + 1 || b > a + 1 then 0 else 1 + max a b

-- (a node over `l` and `r` of height `h`, or, where `h` is 0, rotated by
-- `balance`.  Where a subtree has changed, by one in height at most,
-- `nodeOf (heightOver (height l) (height r)) k v l r` is written out
-- where the node was taken apart (not a function of its own, which is
-- too big to be inlined): so it is built in the cell of the node it
-- replaces, if nothing else holds that, and a path changed down the
-- tree is changed in place)
nodeOf : {k v : Type} -> Int -> k -> v -> Map k v -> Map k v -> Map k v
nodeOf 0 k v l r = balance k v l r
nodeOf h k v l r = Bin h k v l r

-- | `m` with `k` bound to `v` (instead of what it was, if it was).
insert : {k v : Type} -> {{ord : Order k}} -> Map k v -> k -> v -> Map k v
insert Tip key value = singleton key value
insert (Bin h k' v' l r) key value = case compare key k' of
  LT ->
    (let l2 : Map k v = insert l key value
     in nodeOf (heightOver (height l2) (height r)) k' v' l2 r)
  GT ->
    (let r2 : Map k v = insert r key value
     in nodeOf (heightOver (height l) (height r2)) k' v' l r2)
  EQ -> Bin h key value l r

lookup : {k v : Type} -> {{ord : Order k}} -> Map k v -> k -> Maybe v
lookup Tip k = Nothing
lookup (Bin _ k' v' l r) k = case compare k k' of
  LT -> lookup l k
  GT -> lookup r k
  EQ -> Just v'

member : {k v : Type} -> {{ord : Order k}} -> Map k v -> k -> Bool
member m k = maybe False (\_ -> True) (lookup m k)

-- (the least key, and its value, if the map is not empty)
findMin : {k v : Type} -> Map k v -> Maybe (Pair k v)
findMin Tip = Nothing
findMin (Bin _ k v Tip _) = Just (MkPair k v)
findMin (Bin _ _ _ l _) = findMin l

deleteMin : {k v : Type} -> Map k v -> Map k v
deleteMin Tip = Tip
deleteMin (Bin _ _ _ Tip r) = r
deleteMin (Bin _ k v l r) = balance k v (deleteMin l) r

-- (two trees, the keys of the first less than the second's, as one)
glue : {k v : Type} -> Map k v -> Map k v -> Map k v
glue l r = case findMin r of
  Nothing -> l
  Just (MkPair k v) -> balance k v l (deleteMin r)

-- | The map without `k` (as it was, if `k` was not in it).
delete : {k v : Type} -> {{ord : Order k}} -> Map k v -> k -> Map k v
delete Tip key = Tip
delete (Bin _ k' v' l r) key = case compare key k' of
  LT ->
    (let l2 : Map k v = delete l key
     in nodeOf (heightOver (height l2) (height r)) k' v' l2 r)
  GT ->
    (let r2 : Map k v = delete r key
     in nodeOf (heightOver (height l) (height r2)) k' v' l r2)
  EQ -> glue l r

-- (the pairs of `m`, in order, before `acc`)
toListOnto : {k v : Type} -> Map k v -> List (Pair k v) -> List (Pair k v)
toListOnto Tip acc = acc
toListOnto (Bin _ k v l r) acc =
  toListOnto l (Cons (MkPair k v) (toListOnto r acc))

-- | The keys and their values, the keys in order.
toList : {k v : Type} -> Map k v -> List (Pair k v)
toList m = toListOnto m Nil

-- (`m` with each of the pairs inserted, in order)
insertAll : {k v : Type}
          -> {{ord : Order k}}
          -> Map k v
          -> List (Pair k v)
          -> Map k v
insertAll m ps = List.foldl (\acc p -> insert acc (fst p) (snd p)) m ps

fromList : {k v : Type} -> {{ord : Order k}} -> List (Pair k v) -> Map k v
fromList ps = insertAll Tip ps

-- | The map with `k` bound to `v`, or, where it is bound, to `f v old`
-- | (Haskell's `insertWith`): a value changed in one walk down the tree,
-- | where a `lookup` and an `insert` take two.
-- | >>> toList (update (fromList [MkPair "a" 2, MkPair "b" 5]) "a" 1 (\new old -> new + old))
-- | Cons (MkPair "a" 3) (Cons (MkPair "b" 5) Nil)
-- | >>> toList (update empty 7 1 (\new old -> new + old))
-- | Cons (MkPair 7 1) Nil
update : {k v : Type}
       -> {{ord : Order k}}
       -> Map k v
       -> k
       -> v
       -> (v -> v -> v)
       -> Map k v
update Tip key value f = singleton key value
update (Bin h k' v' l r) key value f = case compare key k' of
  LT ->
    (let l2 : Map k v = update l key value f
     in nodeOf (heightOver (height l2) (height r)) k' v' l2 r)
  GT ->
    (let r2 : Map k v = update r key value f
     in nodeOf (heightOver (height l) (height r2)) k' v' l r2)
  EQ -> Bin h k' (f value v') l r

-- (where `f` said a key's new value: the tree with it, or without it)
planted : {k v : Type} -> k -> Maybe v -> Map k v
planted k Nothing = Tip
planted k (Just v) = singleton k v

-- (a node of height `h` over `l` and `r`, its key `k` now bound as `f`
-- said: to its new value, or the node gone)
replanted : {k v : Type} -> Int -> k -> Maybe v -> Map k v -> Map k v -> Map k v
replanted h k Nothing l r = glue l r
replanted h k (Just v) l r = Bin h k v l r

-- | The map with `k` bound as `f` says, given what it is bound to, if it
-- | is: to `f`'s value, or (`Nothing`) to none (Haskell's `alter`).
-- | >>> toList (alter (fromList [MkPair "a" 2]) "a" (\old -> Just (maybe 1 (\n -> n + 1) old)))
-- | Cons (MkPair "a" 3) Nil
-- | >>> toList (alter (fromList [MkPair 1 "one", MkPair 2 "two"]) 1 (\old -> Nothing))
-- | Cons (MkPair 2 "two") Nil
-- | >>> toList (alter (fromList [MkPair 1 "one"]) 3 (\old -> Just "three"))
-- | Cons (MkPair 1 "one") (Cons (MkPair 3 "three") Nil)
alter : {k v : Type}
      -> {{ord : Order k}}
      -> Map k v
      -> k
      -> (Maybe v -> Maybe v)
      -> Map k v
alter Tip key f = planted key (f Nothing)
alter (Bin h k' v' l r) key f = case compare key k' of
  LT ->
    (let l2 : Map k v = alter l key f
     in nodeOf (heightOver (height l2) (height r)) k' v' l2 r)
  GT ->
    (let r2 : Map k v = alter r key f
     in nodeOf (heightOver (height l) (height r2)) k' v' l r2)
  EQ -> replanted h k' (f (Just v')) l r

keys : {k v : Type} -> Map k v -> List k
keys m = List.map (\p -> fst p) (toList m)

values : {k v : Type} -> Map k v -> List v
values m = List.map (\p -> snd p) (toList m)

size : {k v : Type} -> Map k v -> Int
size Tip = 0
size (Bin _ _ _ l r) = size l + 1 + size r

-- | Each value, `f` of it.
mapValues : {k v w : Type} -> (v -> w) -> Map k v -> Map k w
mapValues f Tip = Tip
mapValues f (Bin h k v l r) = Bin h k (f v) (mapValues f l) (mapValues f r)

-- | The keys of both; a key of both with its value in `a`.
union : {k v : Type} -> {{ord : Order k}} -> Map k v -> Map k v -> Map k v
union a b = insertAll b (toList a)

balanced : {k v : Type} -> Map k v -> Bool
balanced Tip = True
balanced (Bin h _ _ l r) =
  List.all
    (\b -> b)
    [ h == 1 + max (height l) (height r)
    , height l <= height r + 1
    , height r <= height l + 1
    , balanced l
    , balanced r
    ]

ascending : {k : Type} -> {{ord : Order k}} -> List k -> Bool
ascending (Cons a (Cons b rest)) =
  (case compare a b of
   LT -> ascending (Cons b rest)
   EQ -> False
   GT -> False)
ascending xs = True

-- | Whether it is balanced and in order: every node's subtrees differ in
-- | height by one at most, its height is right, and its keys go up.
valid : {k v : Type} -> {{ord : Order k}} -> Map k v -> Bool
valid m = balanced m && ascending (keys m)
