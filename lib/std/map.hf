-- Maps of keys to values, whichever they are: a theory of what std.ordmap,
-- std.hashmap and std.hashtable each do, so that a definition written
-- once works on any of them, and a program picks one by its type.
--
-- ```haskell
-- import std.hashmap as HashMap
-- import std.map as Map
--
-- -- | how many times each word appears, in a map of any kind
-- counts : {c : Type} -> {{m : Map.Mapping c @ { Key = String, Value = Int }}} -> List String -> c
-- counts ws = List.foldl (\t w -> m.insert t w (1 + fromMaybe 0 (m.lookup t w))) m.empty ws
-- ```
--
-- Which one to pick:
--
-- - std.hashmap, a trie by the keys' hashes: stable -- its order is the
--   hashes', of what it binds alone -- and a change to a map held
--   elsewhere too (an old version kept) copies one path of it.
-- - std.hashtable, flat arrays: unstable -- its order is of how it came
--   to be -- and a change to a table held elsewhere too copies all of
--   it; but where one owner fills and reads it, the fastest.
-- - std.ordmap, a balanced tree by the keys' `Order`: in the keys' order.
--
-- Import this module for the instances too: an instance is in scope
-- only in a module that imports its own.

module std.map

import std.hashmap as HashMap
import std.hashtable as HashTable
import std.ordmap as OrdMap

-- | A map `c` of keys (`Key`) to values (`Value`): the map of none, a
-- | key bound, looked up and removed (and what it was bound to, if it
-- | was), how many keys are bound, and each key and its value folded,
-- | in the map's order.
theory Mapping (c : Type) where
  Key : Type
  Value : Type
  empty : c
  insert : c -> Key -> Value -> c
  lookup : c -> Key -> Maybe Value
  remove : c -> Key -> Pair (Maybe Value) c
  size : c -> Int
  foldl : {b : Type} -> (b -> Key -> Value -> b) -> b -> c -> b

-- | The map of no keys, of the kind `c`.
empty : {c : Type} -> {{m : Mapping c}} -> c
empty = m.empty

-- | The map with `key` bound to `value`.
insert : {c : Type} -> {{m : Mapping c}} -> c -> m.Key -> m.Value -> c
insert t key value = m.insert t key value

-- | What `key` is bound to, if it is.
lookup : {c : Type} -> {{m : Mapping c}} -> c -> m.Key -> Maybe m.Value
lookup t key = m.lookup t key

-- | What `key` was bound to, if it was, and the map without it.
remove : {c : Type} -> {{m : Mapping c}} -> c -> m.Key -> Pair (Maybe m.Value) c
remove t key = m.remove t key

-- | How many keys are bound.
size : {c : Type} -> {{m : Mapping c}} -> c -> Int
size t = m.size t

-- | Each key and its value, from `z`, in the map's order.
foldl : {c b : Type}
      -> {{m : Mapping c}}
      -> (b -> m.Key -> m.Value -> b)
      -> b
      -> c
      -> b
foldl f z t = m.foldl f z t

-- | A hash map (std.hashmap): stable, its order the keys' hashes'.
instance instanceMappingHashMap : {k v : Type}
                                -> {{hashing : HashMap.Hash k}}
                                -> {{equality : Equality k}}
                                -> Mapping (HashMap.HashMap k v)
instanceMappingHashMap =
  { Key = k
  , Value = v
  , empty = HashMap.empty
  , insert = HashMap.insert
  , lookup = HashMap.lookup
  , remove = HashMap.remove
  , size = HashMap.size
  , foldl = HashMap.foldl
  }

-- | A hash table (std.hashtable): unstable, its order of how it came to
-- | be.
instance instanceMappingHashTable : {k v : Type}
                                  -> {{hashing : HashMap.Hash k}}
                                  -> {{equality : Equality k}}
                                  -> Mapping (HashTable.HashTable k v)
instanceMappingHashTable =
  { Key = k
  , Value = v
  , empty = HashTable.empty
  , insert = HashTable.insert
  , lookup = HashTable.lookup
  , remove = HashTable.remove
  , size = HashTable.size
  , foldl = HashTable.foldl
  }

-- | A map ordered by its keys (std.ordmap): in the keys' order.
instance instanceMappingOrdMap : {k v : Type}
                               -> {{ord : Order k}}
                               -> Mapping (OrdMap.OrdMap k v)
instanceMappingOrdMap =
  { Key = k
  , Value = v
  , empty = OrdMap.empty
  , insert = OrdMap.insert
  , lookup = OrdMap.lookup
  , remove = removed
  , size = OrdMap.size
  , foldl = folded
  }
  where
  removed : OrdMap.OrdMap k v -> k -> Pair (Maybe v) (OrdMap.OrdMap k v)
  removed m key = MkPair (OrdMap.lookup m key) (OrdMap.delete m key)
  folded : {b : Type} -> (b -> k -> v -> b) -> b -> OrdMap.OrdMap k v -> b
  folded f z m =
    List.foldl (\acc p -> f acc (fst p) (snd p)) z (OrdMap.toList m)

-- | How many times each key is in `ks`, in a map of any kind.
-- | >>> HashMap.lookup (tally ["a", "b", "a"] : HashMap.HashMap String Int) "a"
-- | Just 2
-- | >>> HashTable.lookup (tally ["a", "b", "a"] : HashTable.HashTable String Int) "b"
-- | Just 1
-- | >>> OrdMap.toList (tally ["b", "a", "b"] : OrdMap.OrdMap String Int)
-- | Cons (MkPair "a" 1) (Cons (MkPair "b" 2) Nil)
tally : {c : Type}
      -> {{m : Mapping c @ { Value = Int }}}
      -> List m.Key
      -> c
tally ks =
  List.foldl
    (\t key -> m.insert t key (1 + fromMaybe 0 (m.lookup t key)))
    m.empty
    ks
