-- Periods: amounts of time a calendar counts -- a year, a month, a
-- week, a day, an hour -- not fixed lengths: a month after January 31 is
-- 29 days on in 2024 and 28 in 2023, so a period has no length until it
-- is laid on a date, and is no std.duration.  NodaTime's `Period` is the
-- model: a period holds each unit apart, as it was given, and 1 month is
-- not 4 weeks nor 30 days, nor 60 minutes 1 hour, until it is laid on a
-- date or a time (`addToDate`, `addToTime`, `addToDateTime`).  Two dates
-- are a period apart in years, months and days (`between`).  A period is
-- a record, its fields in plain sight; ISO 8601 writes one,
-- `P1Y2M3W4DT5H6M7.5S`.  Import it by a name,
-- `import std.period as Period`, as its names are short.
--
-- ```haskell
-- import std.localdate as LocalDate
-- import std.period as Period
--
-- -- | the day a quarter of a year after the date
-- -- | >>> maybe "" (\d -> toString (nextQuarter d)) (LocalDate.parse "2024-11-30")
-- -- | "2025-02-28"
-- nextQuarter : LocalDate.LocalDate -> LocalDate.LocalDate
-- nextQuarter d = Period.addToDate d (Period.months 3)
-- ```

module std.period
  ( Period
  , years
  , months
  , weeks
  , days
  , hours
  , minutes
  , seconds
  , nanoseconds
  , zero
  , addToDate
  , addToTime
  , addToDateTime
  , between
  , instanceEqualityPeriod
  , instanceAdditionPeriod
  , instanceNegationPeriod
  , instanceShowPeriod
  , instanceToStringPeriod
  )

import std.localdate as LocalDate
import std.localdatetime as LocalDateTime
import std.localtime as LocalTime

-- | A period: how many of each unit, each apart, any of them less than
-- | none for a period back in time.
type Period =
  { years : Int
  , months : Int
  , weeks : Int
  , days : Int
  , hours : Int
  , minutes : Int
  , seconds : Int
  , nanoseconds : Int
  }

-- | The period of nothing: every unit 0.
zero : Period
zero =
  { years = 0
  , months = 0
  , weeks = 0
  , days = 0
  , hours = 0
  , minutes = 0
  , seconds = 0
  , nanoseconds = 0
  }

-- | `n` years.
-- | >>> years 2
-- | { years = 2, months = 0, weeks = 0, days = 0, hours = 0, minutes = 0, seconds = 0, nanoseconds = 0 }
years : Int -> Period
years n = { zero | years = n }

-- | `n` months.
months : Int -> Period
months n = { zero | months = n }

-- | `n` weeks.
weeks : Int -> Period
weeks n = { zero | weeks = n }

-- | `n` days.
days : Int -> Period
days n = { zero | days = n }

-- | `n` hours.
hours : Int -> Period
hours n = { zero | hours = n }

-- | `n` minutes.
minutes : Int -> Period
minutes n = { zero | minutes = n }

-- | `n` seconds.
seconds : Int -> Period
seconds n = { zero | seconds = n }

-- | `n` nanoseconds.
nanoseconds : Int -> Period
nanoseconds n = { zero | nanoseconds = n }

-- Instances: the prelude's operators and functions at `Period`
--------------------------------------------------------------------------------

-- | Equal unit by unit: 1 hour is not 60 minutes, as NodaTime has it.
-- | >>> hours 1 == hours 1 && hours 1 /= minutes 60
-- | True
instance instanceEqualityPeriod : Equality Period
instanceEqualityPeriod =
  { equal = \(x : Period) (y : Period) ->
        x.years == y.years
        && x.months == y.months
        && x.weeks == y.weeks
        && x.days == y.days
        && x.hours == y.hours
        && x.minutes == y.minutes
        && x.seconds == y.seconds
        && x.nanoseconds == y.nanoseconds
  }

-- | Added unit by unit, each kept apart.
-- | >>> years 1 + months 14 + days 3
-- | { years = 1, months = 14, weeks = 0, days = 3, hours = 0, minutes = 0, seconds = 0, nanoseconds = 0 }
instance instanceAdditionPeriod : Addition Period
instanceAdditionPeriod =
  { add = \(x : Period) (y : Period) ->
        { years = x.years + y.years
        , months = x.months + y.months
        , weeks = x.weeks + y.weeks
        , days = x.days + y.days
        , hours = x.hours + y.hours
        , minutes = x.minutes + y.minutes
        , seconds = x.seconds + y.seconds
        , nanoseconds = x.nanoseconds + y.nanoseconds
        }
  }

-- | Every unit negated.
-- | >>> -(months 1 + days (-2)) == months (-1) + days 2
-- | True
instance instanceNegationPeriod : Negation Period
instanceNegationPeriod =
  { neg = \(x : Period) ->
        { years = 0 - x.years
        , months = 0 - x.months
        , weeks = 0 - x.weeks
        , days = 0 - x.days
        , hours = 0 - x.hours
        , minutes = 0 - x.minutes
        , seconds = 0 - x.seconds
        , nanoseconds = 0 - x.nanoseconds
        }
  }

-- | As a record literal writes it, every field.
-- | >>> show (months (-1))
-- | "{ years = 0, months = -1, weeks = 0, days = 0, hours = 0, minutes = 0, seconds = 0, nanoseconds = 0 }"
instance instanceShowPeriod : Show Period
instanceShowPeriod =
  { show = \(x : Period) ->
        "{ years = "
        ^ showInt x.years
        ^ ", months = "
        ^ showInt x.months
        ^ ", weeks = "
        ^ showInt x.weeks
        ^ ", days = "
        ^ showInt x.days
        ^ ", hours = "
        ^ showInt x.hours
        ^ ", minutes = "
        ^ showInt x.minutes
        ^ ", seconds = "
        ^ showInt x.seconds
        ^ ", nanoseconds = "
        ^ showInt x.nanoseconds
        ^ " }"
  }

-- | As ISO 8601 writes it, as NodaTime does: `P`, each date unit that is
-- | not 0 (`1Y2M3W4D`), then, if a time unit is not 0, `T` and each time
-- | unit that is not 0 (`5H6M7.5S`) -- the seconds and the nanoseconds
-- | together as seconds and their fraction, without the `0`s it ends
-- | with.  A unit less than none is written with its own `-`
-- | (`P-1M-1D`), and the period of nothing `P0D`.
-- | >>> toString (years 1 + months 2 + weeks 3 + days 4 + hours 5 + minutes 6 + seconds 7 + nanoseconds 500000000)
-- | "P1Y2M3W4DT5H6M7.5S"
-- | >>> List.map toString [zero, days 1, hours 36, months (-1) + days (-1), seconds 1 + nanoseconds (-1500000000), nanoseconds 1, years 1 + minutes (-1)]
-- | ["P0D", "P1D", "PT36H", "P-1M-1D", "PT-0.5S", "PT0.000000001S", "P1YT-1M"]
instance instanceToStringPeriod : ToString Period
instanceToStringPeriod =
  { toString = \(x : Period) ->
        (if strEq (dateText x ^ timeText x) "" then "P0D"
         else "P" ^ dateText x ^ timeText x)
  }
  where
  -- (`n`, at least 0, in decimal, with `0`s before it to `width` digits)
  padded : Int -> Int -> String
  padded width n =
    joinWith "" (List.replicate (width - strLength (showInt n)) "0") ^ showInt n

  -- (`s` without the `0`s it ends with)
  withoutTrailingZeros : String -> String
  withoutTrailingZeros s =
    if strLength s > 0 && strByteAt s (strLength s - 1) == 48
    then withoutTrailingZeros (strSlice s 0 (strLength s - 1))
    else s

  -- (`n` and the unit's letter after it, or nothing for 0)
  unit : Int -> String -> String
  unit n letter = if n == 0 then "" else showInt n ^ letter

  -- (the date units, each not 0)
  dateText : Period -> String
  dateText x =
    unit x.years "Y" ^ unit x.months "M" ^ unit x.weeks "W" ^ unit x.days "D"

  -- (`n` nanoseconds as seconds and their fraction, its sign before
  -- them, and `S`; nothing for 0)
  secondsText : Int -> String
  secondsText n =
    if n == 0 then ""
    else (if n < 0 then "-" else "")
      ^ showInt (abs n / 1000000000)
      ^ (if abs n % 1000000000 == 0 then ""
         else "." ^ withoutTrailingZeros (padded 9 (abs n % 1000000000)))
      ^ "S"

  -- (`T` and the time units, each not 0; nothing if all are)
  timeText : Period -> String
  timeText x =
    let written : String =
      unit x.hours "H"
      ^ unit x.minutes "M"
      ^ secondsText (x.seconds * 1000000000 + x.nanoseconds)
    in if strEq written "" then "" else "T" ^ written

-- (the nanoseconds of a day of 24 hours)
nanosecondsPerDay : Int
nanosecondsPerDay = 86400000000000

-- (the period's time units together, in nanoseconds)
timeNanoseconds : Period -> Int
timeNanoseconds p =
  ((p.hours * 60 + p.minutes) * 60 + p.seconds) * 1000000000 + p.nanoseconds

-- (the period's date units laid on the date: its years, then its
-- months, each clamped to the month's last day, then its weeks and days)
addDateUnits : LocalDate.LocalDate -> Period -> LocalDate.LocalDate
addDateUnits d p =
  LocalDate.plusDays
    (LocalDate.plusMonths (LocalDate.plusYears d p.years) p.months)
    (p.weeks * 7 + p.days)

-- (the time `n` nanoseconds after midnight, round the clock: `n` taken
-- modulo a day)
timeOfDayAt : Int -> LocalTime.LocalTime
timeOfDayAt n = case LocalTime.fromNanosecondOfDay (n % nanosecondsPerDay) of
  Just t -> t
  Nothing -> abandon

-- | The date the period after it: its years first, then its months,
-- | each as std.localdate's `plusYears` and `plusMonths` lay them, the day
-- | clamped to the month's last (2024-01-31 and a month is 2024-02-29),
-- | then its weeks and days.  A period with any time unit not 0 is
-- | abandoned, as NodaTime throws: a date has no time of day to move.
-- | >>> List.map (\p -> maybe "" (\d -> toString (addToDate d p)) (LocalDate.parse "2024-01-31")) [months 1, years 1 + months 1, weeks 1 + days (-1), months (-11) + days 1, years (-2025)]
-- | ["2024-02-29", "2025-02-28", "2024-02-06", "2023-03-01", "-0001-01-31"]
-- | >>> maybe "" (\d -> toString (addToDate d (years 1 + months 1))) (LocalDate.parse "2024-02-29")
-- | "2025-03-28"
addToDate : LocalDate.LocalDate -> Period -> LocalDate.LocalDate
addToDate d p =
  if p.hours /= 0 || p.minutes /= 0 || p.seconds /= 0 || p.nanoseconds /= 0
  then abandon
  else addDateUnits d p

-- | The time the period's time units after it, round the clock: past
-- | midnight on into the next day, and before it back into the day
-- | before.  A period with any date unit not 0 is abandoned, as NodaTime
-- | throws: a time of day has no date to move.
-- | >>> List.map (\p -> maybe "" (\t -> toString (addToTime t p)) (LocalTime.make 22 30 0)) [hours 1, hours 2, minutes (-1350), hours 24, seconds 1 + nanoseconds (-1), hours 48 + minutes 1]
-- | ["23:30:00", "00:30:00", "00:00:00", "22:30:00", "22:30:00.999999999", "22:31:00"]
addToTime : LocalTime.LocalTime -> Period -> LocalTime.LocalTime
addToTime t p =
  if p.years /= 0 || p.months /= 0 || p.weeks /= 0 || p.days /= 0 then abandon
  else timeOfDayAt (LocalTime.nanosecondOfDay t + timeNanoseconds p)

-- | The date-time the period after it: its date units laid on the date
-- | as `addToDate` lays them, then its time units, as a length of time,
-- | on the time, the days they go past carried into the date.
-- | >>> List.map (\p -> maybe "" (\t -> toString (addToDateTime t p)) (LocalDateTime.parse "2024-01-31T22:30:00")) [months 1 + hours 2, hours (-23), days 1 + minutes 90, hours 8784, nanoseconds (-1)]
-- | ["2024-03-01T00:30:00", "2024-01-30T23:30:00", "2024-02-02T00:00:00", "2025-01-31T22:30:00", "2024-01-31T22:29:59.999999999"]
addToDateTime : LocalDateTime.LocalDateTime
              -> Period
              -> LocalDateTime.LocalDateTime
addToDateTime t p =
  LocalDateTime.make
    (LocalDate.plusDays
       (addDateUnits (LocalDateTime.date t) p)
       (nanosecondOfDay / nanosecondsPerDay))
    (timeOfDayAt nanosecondOfDay)
  where
  -- (the nanoseconds from midnight of the date to the new time, past a
  -- day or before none for one on another day)
  nanosecondOfDay : Int
  nanosecondOfDay =
    LocalTime.nanosecondOfDay (LocalDateTime.time t) + timeNanoseconds p

-- | The period from the first date to the second, in years, months and
-- | days (no weeks), as NodaTime's `Period.Between` with its years,
-- | months and days units: as many whole years as do not go past the
-- | second, then as many whole months, each as `plusYears` and
-- | `plusMonths` lay them, then the days left; all less than none if
-- | the second comes first.  `addToDate a (between a b)` is `b`.
-- | >>> List.map (\p -> maybe "" toString (maybe Nothing (\a -> maybe Nothing (\b -> Just (between a b)) (LocalDate.parse (snd p))) (LocalDate.parse (fst p)))) [("2024-01-31", "2024-03-01"), ("2024-03-01", "2024-01-31"), ("2020-02-29", "2024-02-28"), ("2024-02-29", "2025-02-28"), ("1969-12-31", "2024-02-29"), ("2024-05-05", "2024-05-05"), ("0000-03-01", "0002-02-28")]
-- | ["P1M1D", "P-1M-1D", "P3Y12M", "P1Y", "P54Y2M", "P0D", "P1Y11M27D"]
-- | >>> maybe "" (\a -> toString (between a (LocalDate.fromEpochDays 0)) ^ " " ^ toString (between (LocalDate.fromEpochDays 0) a)) (LocalDate.make (-1) 3 1)
-- | "P1970Y10M P-1970Y-10M"
-- | >>> List.all (\p -> maybe False (\a -> maybe False (\b -> addToDate a (between a b) == b) (LocalDate.parse (snd p))) (LocalDate.parse (fst p))) [("2024-01-31", "2024-03-01"), ("2024-03-01", "2024-01-31"), ("2024-03-31", "2023-02-28"), ("2023-02-28", "2024-03-31"), ("2000-02-29", "1999-02-28"), ("0000-01-01", "9999-12-31")]
-- | True
between : LocalDate.LocalDate -> LocalDate.LocalDate -> Period
between a b =
  { zero
  | years = wholeYears
  , months = wholeMonths
  , days = LocalDate.epochDays b - LocalDate.epochDays afterMonths
  }
  where
  -- (`n` units on from `a`, by `plus`, corrected by one back toward `a`
  -- if they go past `b`)
  notPast : (LocalDate.LocalDate -> Int -> LocalDate.LocalDate)
          -> LocalDate.LocalDate
          -> Int
          -> Int
  notPast plus from n =
    if from <= b && plus from n > b then n - 1
    else if from > b && plus from n < b
    then n + 1
    else n

  wholeYears : Int
  wholeYears =
    notPast LocalDate.plusYears a (LocalDate.year b - LocalDate.year a)

  afterYears : LocalDate.LocalDate
  afterYears = LocalDate.plusYears a wholeYears

  wholeMonths : Int
  wholeMonths =
    notPast
      LocalDate.plusMonths
      afterYears
      (LocalDate.year b * 12
       + LocalDate.month b
       - (LocalDate.year afterYears * 12 + LocalDate.month afterYears))

  afterMonths : LocalDate.LocalDate
  afterMonths = LocalDate.plusMonths afterYears wholeMonths
