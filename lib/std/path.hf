-- Paths, a type of their own: where a file is, read from a string in a
-- style -- `Posix` (`/a/b`) or `Windows` (`C:\a\b`, `\\server\share\a`,
-- either slash read) -- and written back in one.  A path is its drive (on
-- Windows, `C:` or `//server/share`), whether it starts at the root, and
-- its segments; what is done with it is done with those, the same on every
-- platform.  Only this module makes one, so it is always in that shape: no
-- empty segment, no `.`.
--
-- Reading one and writing one take the style as `os`, the system's own
-- (`native`) unless it is given: `parse s` reads `s` as the system the
-- program runs on writes a path, `parse (os := Windows) s` as Windows
-- does.  So a string from the program and one from outside, an argument or
-- a variable, are read the same way.  `native` is not asked at run time: a
-- C program is built for one system, whose style it has.  A string is
-- taken as a path where one is expected (`readFile "src/main.hf"`, `dir /
-- "main.hf"`), read so, by the coercion this module declares.

module std.path
  ( Style(..)
  , Path
  , native
  , styleOf
  , sep
  , lower
  , parse
  , render
  , drive
  , isAbsolute
  , segments
  , current
  , normal
  , components
  , join
  , joinAll
  , dirname
  , basename
  , extension
  , stem
  , relative
  , isUnder
  , instanceCoeStringPath
  , instanceDivisionPath
  , instanceEqualityPath
  , instanceDebugPath
  , instanceShowPath
  )

import uint8 as UInt8

-- | How a system writes a path: `Posix` (`/a/b`) or `Windows`
-- | (`C:\a\b`, `\\server\share\a`, either slash read).
data Style = Posix | Windows

-- | A path: its drive (Windows: `C:` or `//server/share`, with `/`s;
-- | otherwise `""`), whether it starts at the root, and its segments (no
-- | `""`, no `.`; `..` only where `normal` leaves one).  Made only by
-- | this module: by `parse`, from a string where a path is expected, and
-- | by what is done with paths.
data Path = MkPath String Bool (List String)

-- | The style of the system the program runs on: `Windows` there,
-- | `Posix` elsewhere -- in a C program, the system it is built for; in
-- | JavaScript, Node.js's (`Posix` in a page).
native : Style
native = if onWindows MkUnit then Windows else Posix

-- | The style of a platform, named as Node.js names it (`win32`,
-- | `linux`, ...: `process.platform`).
-- | >>> styleOf "darwin"
-- | Posix
styleOf : String -> Style
styleOf "win32" = Windows
styleOf _ = Posix

-- | The separator the style writes.
sep : Style -> String
sep Posix = "/"
sep Windows = "\\"

-- (each separator the style reads, as `/`)
slashes : Style -> String -> String
slashes Posix s = s
slashes Windows s = joinWith "/" (split "\\" s)

-- (the code is a letter's)
isLetter : Int -> Bool
isLetter c = 65 <= c && c <= 90 || 97 <= c && c <= 122

-- | The ASCII letters of `s`, in lower case.
lower : String -> String
lower s = joinWith "" (List.map low (List.range 0 (strLength s)))
  where
  low : Int -> String
  low i =
    if 65 <= byteAt s i && byteAt s i <= 90
    then fromByte (UInt8.fromInt (byteAt s i + 32))
    else strSlice s i (i + 1)

-- (`s`, with `/`s, after its drive: the drive and the rest)
driveOf : Style -> String -> Pair String String
driveOf Posix s = MkPair "" s
driveOf Windows s =
  if startsWith (prefix := "//") s && not (startsWith (prefix := "///") s)
  then unc (split "/" (strSlice s 2 (strLength s)))
  else if strLength s >= 2
          && isLetter (byteAt s 0)
          && strEq (strSlice s 1 2) ":"
  then MkPair (strSlice s 0 2) (strSlice s 2 (strLength s))
  else MkPair "" s
  where
  unc : List String -> Pair String String
  unc (server :: share :: rest) =
    MkPair ("//" ^ server ^ "/" ^ share) ("/" ^ joinWith "/" rest)
  unc _ = MkPair "" s

-- (a segment kept: not `""`, nor `.`)
kept : String -> Bool
kept "" = False
kept "." = False
kept _ = True

-- | The drive (`""` where there is none; on Windows, `C:`, or
-- | `//server/share`, with `/`s).
drive : Path -> String
drive (MkPath d _ _) = d

-- | Whether the path starts at the root (of its drive).
isAbsolute : Path -> Bool
isAbsolute (MkPath _ a _) = a

-- | The segments, in order: no `""`, no `.`.
segments : Path -> List String
segments (MkPath _ _ xs) = xs

-- | `s` read as a path in the style `os` (the system's, `native`,
-- | unless it is given).
-- | >>> segments (parse (os := Posix) "/a//b/./c/")
-- | ["a", "b", "c"]
-- | >>> segments (parse (os := Posix) "C:\\a")
-- | ["C:\\a"]
-- | >>> drive (parse (os := Windows) "c:\\x")
-- | "c:"
-- | >>> segments (parse (os := Windows) "\\\\srv\\share\\x/y")
-- | ["x", "y"]
parse : {os : Style := native} -> String -> Path
parse s = case driveOf os (slashes os s) of
  MkPair d rest ->
    MkPath
      d
      (startsWith (prefix := "/") rest || startsWith (prefix := "//") d)
      (List.keepIf kept (split "/" rest))

-- | `p` written in the style `os` (the system's, `native`, unless it is
-- | given): `.` for nothing.
-- | >>> render (os := Windows) (parse (os := Windows) "//srv/share/a")
-- | "\\\\srv\\share\\a"
-- | >>> render (os := Posix) (parse (os := Windows) "C:\\a\\b")
-- | "C:/a/b"
-- | >>> render (os := Posix) (parse (os := Posix) "")
-- | "."
render : {os : Style := native} -> Path -> String
render (MkPath d a xs) =
  if strEq d "" && not a && List.null xs then "."
  else joinWith
      (sep os)
      (split "/" (d ^ (if a then "/" else "") ^ joinWith "/" xs))

-- | A string where a path is expected: `parse`, in the system's style.
-- | >>> render (os := Posix) ("a//b.hf/" : Path)
-- | "a/b.hf"
-- | >>> segments ("a/../b" : Path)
-- | ["a", "..", "b"]
-- | >>> isAbsolute ("/" : Path)
-- | True
-- | >>> isAbsolute (parse (os := Windows) "C:x")
-- | False
instance instanceCoeStringPath : Coe String Path
instanceCoeStringPath = { coe = \s -> parse s }

-- (the segments are the same, one by one)
sameSegments : List String -> List String -> Bool
sameSegments (x :: xs) (y :: ys) = strEq x y && sameSegments xs ys
sameSegments [] [] = True
sameSegments _ _ = False

-- (both absolute, or neither)
sameRoot : Bool -> Bool -> Bool
sameRoot True b = b
sameRoot False b = not b

-- | The same drive, both absolute or neither, and the same segments, as
-- | they are: case counts, and `..` is not taken away (`normal` both
-- | first, for that).
-- | >>> ("a/b" : Path) == "a//b/"
-- | True
-- | >>> ("a/../b" : Path) == "b"
-- | False
instance instanceEqualityPath : Equality Path
instanceEqualityPath =
  { equal = \p q ->
        strEq (drive p) (drive q)
        && sameRoot (isAbsolute p) (isAbsolute q)
        && sameSegments (segments p) (segments q)
  }

-- (a path as a program writes it: a string, where the system's style
-- reads it back as it is; else as Windows writes it, read so)
shownPath : Path -> String
shownPath p =
  if parse (render p) == p then debug (render p)
  else "parse (os := Windows) " ^ debug (render (os := Windows) p)

-- | As a program writes it: the string, in the system's style, where
-- | that reads back as the path; else as `parse (os := Windows)` reads
-- | it.
-- | >>> debug ("/a/b" : Path)
-- | "\"/a/b\""
-- | >>> debug (parse (os := Windows) "C:/a")
-- | "parse (os := Windows) \"C:\\\\a\""
instance instanceDebugPath : Debug Path
instanceDebugPath = { debug = shownPath }

-- | Written in the system's style, `render`.
-- | >>> show ("a/b" : Path)
-- | "a/b"
instance instanceShowPath : Show Path
instanceShowPath = { show = \p -> render p }

-- | The path of nothing, relative: the directory a path is from.
-- | >>> current
-- | "."
current : Path
current = MkPath "" False Nil

-- (the segments, each `..` taking the one before it away: at the root,
-- `..` is the root; otherwise, those left over stay)
collapse : Bool -> List String -> List String
collapse absolute xs = List.reverse (List.foldl step Nil xs)
  where
  up : List String -> List String
  up [] = if absolute then Nil else [".."]
  up acc@(".." :: _) = ".." :: acc
  up (_ :: rest) = rest
  step : List String -> String -> List String
  step acc ".." = up acc
  step acc x = x :: acc

-- | `p` without its `..`s, where they can go.
-- | >>> normal "/a/./b/../../../c/"
-- | "/c"
-- | >>> normal "a/../../b"
-- | "../b"
-- | >>> render (os := Windows) (normal (parse (os := Windows) "C:/a\\..\\b"))
-- | "C:\\b"
normal : Path -> Path
normal (MkPath d a xs) = MkPath d a (collapse a xs)

-- | The segments of `p`, without the `..`s that can go (not its drive,
-- | nor whether it is absolute).
-- | >>> components (parse (os := Windows) "a\\b/./c\\..\\d")
-- | ["a", "b", "d"]
components : Path -> List String
components p = segments (normal p)

-- (`q` from `p`, before `..`s go)
onto : Path -> Path -> Path
onto (MkPath d a xs) (MkPath e b ys) =
  if not (strEq e "") then MkPath e b ys
  else if b
  then MkPath d True ys
  else MkPath d a (List.append xs ys)

-- | `b` from `a`: `b` itself if it is absolute (on `a`'s drive if it has
-- | none), `a` and `b` one after the other otherwise; its `..`s gone
-- | where they can go.  `a / b` is the same.
-- | >>> join "src" "heff/load.hf"
-- | "src/heff/load.hf"
-- | >>> join "/a/b" "../c"
-- | "/a/c"
-- | >>> join "/a" "/b"
-- | "/b"
-- | >>> render (os := Windows) (join (parse (os := Windows) "C:\\a") (parse (os := Windows) "\\b"))
-- | "C:\\b"
join : Path -> Path -> Path
join a b = normal (onto a b)

-- | `a / b` is `join a b`: `dir / "main.hf"`.
-- | >>> ("src" : Path) / "heff" / "load.hf"
-- | "src/heff/load.hf"
-- | >>> render (os := Windows) (parse (os := Windows) "C:\\a" / "b/c.hf")
-- | "C:\\a\\b\\c.hf"
-- | >>> render (os := Windows) (parse (os := Windows) "C:/work" / "notes.txt")
-- | "C:\\work\\notes.txt"
instance instanceDivisionPath : Division Path
instanceDivisionPath = { div = join }

-- | The paths, each from the one before.
-- | >>> joinAll ["a", "b", "c"]
-- | "a/b/c"
joinAll : List Path -> Path
joinAll [] = current
joinAll (x :: xs) = List.foldl join (normal x) xs

-- | The directory `p` is in (the root's is the root).
-- | >>> dirname "/a/b/c.hf"
-- | "/a/b"
-- | >>> dirname "c.hf"
-- | "."
-- | >>> dirname "/"
-- | "/"
-- | >>> render (os := Windows) (dirname (parse (os := Windows) "C:\\a"))
-- | "C:\\"
dirname : Path -> Path
dirname (MkPath d a xs) =
  MkPath d a (List.reverse (List.drop 1 (List.reverse xs)))

-- | The last segment of `p` (`""` for a root).
-- | >>> basename "/a/b/c.hf/"
-- | "c.hf"
-- | >>> basename (parse (os := Windows) "C:\\a\\b.hf")
-- | "b.hf"
basename : Path -> String
basename p = fromMaybe "" (List.last (segments p))

-- (the last `.` in `s` at or before `i`, not at 0)
lastDot : String -> Int -> Maybe Int
lastDot s i =
  if i <= 0 then Nothing
  else if strEq (strSlice s i (i + 1)) "." then Just i
  else lastDot s (i - 1)

-- (the extension of a name, with its `.`)
extensionOf : String -> String
extensionOf name = case lastDot name (strLength name - 1) of
  Nothing -> ""
  Just i -> strSlice name i (strLength name)

-- | The extension of `p`'s last segment, with its `.` (`""` if none: a
-- | name starting with `.` has none by that `.`).
-- | >>> extension "src/main.hf"
-- | ".hf"
-- | >>> extension "a.tar.gz"
-- | ".gz"
-- | >>> extension ".heff"
-- | ""
-- | >>> extension "Makefile"
-- | ""
extension : Path -> String
extension p = extensionOf (basename p)

-- | `p`'s last segment, without its extension.
-- | >>> stem "src/heff/load.hf"
-- | "load"
stem : Path -> String
stem p =
  strSlice (basename p) 0 (strLength (basename p) - strLength (extension p))

-- (the drives are the same: on Windows, in any case)
sameDrive : Style -> String -> String -> Bool
sameDrive Posix a b = strEq a b
sameDrive Windows a b = strEq (lower a) (lower b)

-- (the segments are the same: on Windows, in any case)
sameSegment : Style -> String -> String -> Bool
sameSegment = sameDrive

-- (`ys` after the segments it shares with `xs`, from the front, with
-- what is left of `xs`)
unshared : Style
         -> List String
         -> List String
         -> Pair (List String) (List String)
unshared st (x :: xs) (y :: ys) =
  if sameSegment st x y then unshared st xs ys else MkPair (x :: xs) (y :: ys)
unshared st xs ys = MkPair xs ys

-- (the way down from the segments of one to another's, if there is one)
descent : Pair (List String) (List String) -> Maybe Path
descent (MkPair up down) =
  if List.elem ".." up then Nothing
  else Just (MkPath "" False (List.append (List.map (\_ -> "..") up) down))

-- (how to get to `q` from `p`, both without the `..`s that can go)
relativeNormal : Style -> Path -> Path -> Maybe Path
relativeNormal st (MkPath d a xs) (MkPath e b ys) =
  if not (sameDrive st d e) || (if a then not b else b) then Nothing
  else descent (unshared st xs ys)

-- | How to get to `to` from `from`, if there is a way: both are absolute
-- | on one drive, or both relative from one place.  The style `os` (the
-- | system's, unless it is given) says whether segments are the same in
-- | any case (on Windows) or not.
-- | >>> relative "/a/b/c" "/a/d"
-- | Just ("../../d")
-- | >>> relative "/a" "/a/b/c.hf"
-- | Just ("b/c.hf")
-- | >>> relative "/a" "/a"
-- | Just (".")
-- | >>> relative "/a" "b"
-- | Nothing
-- | >>> relative (os := Windows) (parse (os := Windows) "C:\\Src\\heff") (parse (os := Windows) "c:\\src\\lib") == Just (parse (os := Windows) "..\\lib")
-- | True
-- | >>> relative (os := Windows) (parse (os := Windows) "C:\\a") (parse (os := Windows) "D:\\a")
-- | Nothing
relative : {os : Style := native} -> Path -> Path -> Maybe Path
relative from to = relativeNormal os (normal from) (normal to)

-- (a way that does not go up)
goesDown : List String -> Bool
goesDown (".." :: _) = False
goesDown _ = True

-- (a way there is, and it does not go up)
downward : Maybe Path -> Bool
downward (Just p) = goesDown (segments p)
downward Nothing = False

-- | `p` is `dir` or under it (in any case on Windows, as `relative`).
-- | >>> isUnder "/a/b" "/a/b/c"
-- | True
-- | >>> isUnder "/a/b" "/a/bc"
-- | False
-- | >>> isUnder "/a/b" "/a/b"
-- | True
-- | >>> isUnder "src" "src/../lib/x.hf"
-- | False
isUnder : {os : Style := native} -> Path -> Path -> Bool
isUnder dir p = downward (relative (os := os) dir p)
