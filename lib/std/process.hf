-- The process as an effect: its arguments, its environment,
-- where its program is and where it runs, the commands it runs -- to
-- their end, or started beside it, spoken to and waited for later -- and
-- how it ends (process.provider.c).

import co
import std.handle

-- | How a command run ended: by itself, with its exit status (0: it
-- | went well); by a signal, its number (never on Windows); killed at
-- | its time limit; or not at all, as it could not be run (not found,
-- | not a program, a NUL in its name or an argument, its directory not
-- | there).
data Ended = Exited Int | Signalled Int | TimedOut | NotRun

-- | What a command's standard input is: none, the null device (not the
-- | program's, nor a closed descriptor, which its next open would take);
-- | a string, written to it and then closed; a pipe the program writes
-- | to as it goes, `writeInput`, until `closeInput`; or the program's
-- | own.
data Input = NoInput | Given String | Piped | Inherited

-- | What a command's output, or its error stream, is: read as it comes
-- | and kept for its `Ran`; a pipe the program reads as it goes,
-- | `readOutput`, `readErrors`, what it has not read its `Ran`'s; or the
-- | program's own, written there as it comes, its `Ran` given none of it.
data Output = Collected | Piped | Inherited

-- | How much a read takes of what a command has written and the program
-- | has not yet read: whatever there is, waiting for some; so many bytes;
-- | or all up to and with the first of a string (`"\n"`: a line;
-- | `"\r\n\r\n"`: HTTP's and LSP's headers).
data Portion = Available | Exactly Int | Through String

-- | What a read was given: bytes; nothing within its time limit, the
-- | bytes there are left for the next read; or nothing, as the stream
-- | has ended (or is not `Piped`).  At the end, a read takes what is
-- | left, fewer bytes than asked or no string, and the next is `Closed`.
data Received = Got Bytes | Timeout | Closed

-- | A command to run: its name (found on the PATH), its arguments, and
-- | how it is run.  Each field but the name has a default, so a record
-- | gives only what it changes:
-- | `{ command = "make", args = ["all"], dir = d, timeout = 60000 }`.
-- |
-- | - `dir`: the directory it runs in (`""`: the program's);
-- | - `env`: environment variables set for it, each a name and a value,
-- |   over the program's own, which it has too;
-- | - `input`: its standard input (`NoInput`: none);
-- | - `output`, `errors`: its output and its error stream (`Collected`);
-- | - `timeout`: how many milliseconds it is given, after which it is
-- |   killed (SIGKILL) and has `TimedOut` (0: as long as it takes);
-- | - `keep`: how many bytes of each of its output and its error stream
-- |   are kept, the first, the rest read and let go (0: all of them).
type Invocation =
  { command : String
  , args : List String = Nil
  , dir : String = ""
  , env : List (Pair String String) = Nil
  , input : Input = NoInput
  , output : Output = Collected
  , errors : Output = Collected
  , timeout : Int = 0
  , keep : Int = 0
  }

-- | a command run to its end: how it ended, and what it wrote to its
-- | output and its error stream (those `Collected`)
type Ran = { ended : Ended, out : String, err : String }

-- (it ended by itself, with the status 0)
endedWell : Ended -> Bool
endedWell (Exited n) = n == 0
endedWell _ = False

-- | It ended by itself, with the status 0.
-- | >>> succeeded { ended = Exited 0, out = "", err = "" }
-- | True
-- | >>> succeeded { ended = Signalled 9, out = "", err = "" }
-- | False
succeeded : Ran -> Bool
succeeded r = endedWell r.ended

-- | (`Handle Started`, std.handle: a command started beside the program,
-- | `start`'s; no value has it.)
data Started

-- | A command started beside the program, running until it is waited
-- | for: `start`'s.
type Subprocess = Handle Started

data ProcessF (m : Type -> Type) x
  = Args (List String -> x)
  | GetEnv String (Maybe String -> x)
  | ProgramPath (String -> x)
  | WorkingDir (String -> x)
  | Platform (String -> x)
  | Processors (Int -> x)
  | Exit Int x
  | Exec String (List String) x
  | Run Invocation (Ran -> x)
  | Start Invocation (Maybe Subprocess -> x)
  | Wait Subprocess (Ran -> x)
  | WaitAny (List Subprocess) (Maybe (Pair Subprocess Ran) -> x)
  | TryWait Subprocess (Maybe Ran -> x)
  | Kill Subprocess x
  | Terminate Subprocess (Ran -> x)
  | WriteInput Subprocess Bytes (Bool -> x)
  | CloseInput Subprocess x
  | ReadOutput Subprocess Portion Int (Received -> x)
  | ReadErrors Subprocess Portion Int (Received -> x)

-- | The process as an effect.
process : HFunctor
process =
  { f = ProcessF
  , hfmap = \m g p -> case p of
      Args k -> Args (\a -> g (k a))
      GetEnv name k -> GetEnv name (\v -> g (k v))
      ProgramPath k -> ProgramPath (\s -> g (k s))
      WorkingDir k -> WorkingDir (\s -> g (k s))
      Platform k -> Platform (\s -> g (k s))
      Processors k -> Processors (\n -> g (k n))
      Exit code x -> Exit code (g x)
      Exec cmd as x -> Exec cmd as (g x)
      Run c k -> Run c (\r -> g (k r))
      Start c k -> Start c (\s -> g (k s))
      Wait s k -> Wait s (\r -> g (k r))
      WaitAny ss k -> WaitAny ss (\r -> g (k r))
      TryWait s k -> TryWait s (\r -> g (k r))
      Kill s x -> Kill s (g x)
      Terminate s k -> Terminate s (\r -> g (k r))
      WriteInput s b k -> WriteInput s b (\r -> g (k r))
      CloseInput s x -> CloseInput s (g x)
      ReadOutput s n ms k -> ReadOutput s n ms (\r -> g (k r))
      ReadErrors s n ms k -> ReadErrors s n ms (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      Args k -> Args k
      GetEnv name k -> GetEnv name k
      ProgramPath k -> ProgramPath k
      WorkingDir k -> WorkingDir k
      Platform k -> Platform k
      Processors k -> Processors k
      Exit code x -> Exit code x
      Exec cmd as x -> Exec cmd as x
      Run c k -> Run c k
      Start c k -> Start c k
      Wait s k -> Wait s k
      WaitAny ss k -> WaitAny ss k
      TryWait s k -> TryWait s k
      Kill s x -> Kill s x
      Terminate s k -> Terminate s k
      WriteInput s b k -> WriteInput s b k
      CloseInput s x -> CloseInput s x
      ReadOutput s n ms k -> ReadOutput s n ms k
      ReadErrors s n ms k -> ReadErrors s n ms k
  }

-- | The program's arguments (not Node's, nor the program's own path):
-- | in any effect the process is in, by the evidence.
args : {e : HFunctor} -> {{ev : process <: e}} -> Co e (List String)
args = op (ev (Args (\a -> a))) val

-- | An environment variable, if it is set.
getEnv : {e : HFunctor}
       -> {{ev : process <: e}}
       -> String
       -> Co e (Maybe String)
getEnv name = op (ev (GetEnv name (\v -> v))) val

-- | The path of the program's own file.
programPath : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
programPath = op (ev (ProgramPath (\s -> s))) val

-- | The directory the program runs in, its working directory: a path
-- | written from it is under it.
workingDir : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
workingDir = op (ev (WorkingDir (\s -> s))) val

-- | The platform the program runs on, as Node.js names it: `linux`,
-- | `darwin`, `win32`, ...
platform : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
platform = op (ev (Platform (\s -> s))) val

-- | How many threads the machine runs at once: its cores, as the system
-- | says (1 where it does not), as std.thread's `cores` -- here for a
-- | program that runs commands, and not threads, to size its work by.
processors : {e : HFunctor} -> {{ev : process <: e}} -> Co e Int
processors = op (ev (Processors (\n -> n))) val

-- | End the program, with a status (0: it went well); nothing after it runs.
exit : {e : HFunctor} -> {{ev : process <: e}} -> Int -> Co e Unit
exit code = op (ev (Exit code MkUnit)) val

-- | End the program, and run the command with the arguments in its place:
-- | its input is the program's, and its status is the program's status.
exec : {e : HFunctor}
     -> {{ev : process <: e}}
     -> String
     -> List String
     -> Co e Unit
exec cmd as = op (ev (Exec cmd as MkUnit)) val

-- | Run the command, to its end, and go on: how it ended, and what it
-- | wrote -- `run { command = "ls", args = ["-l"], dir = "/tmp" }`.
run : {e : HFunctor} -> {{ev : process <: e}} -> Invocation -> Co e Ran
run c = op (ev (Run c (\r -> r))) val

-- | Start the command, as `run` would run it, and go on beside it: the
-- | command, to wait for, or `Nothing` where it could not be run (its
-- | `run` `NotRun`).  What it writes is read, and its time limit kept,
-- | while the program waits for it (`wait`, `waitAny`, `tryWait`); a
-- | command writing more than a pipe holds (64 KiB, most often) waits
-- | until then.  It runs in the program's process group (Ctrl-C ends
-- | both); at the program's end, and where a signal ends it, a command
-- | started and not waited for is terminated.
start : {e : HFunctor}
      -> {{ev : process <: e}}
      -> Invocation
      -> Co e (Maybe Subprocess)
start c = op (ev (Start c (\s -> s))) val

-- | The command waited for, to its end -- its input closed first, where
-- | it is `Piped` -- its `Ran`, and its handle let go of (an operation
-- | given it after that fails the program).
wait : {e : HFunctor} -> {{ev : process <: e}} -> Subprocess -> Co e Ran
wait s = op (ev (Wait s (\r -> r))) val

-- | Whichever of the commands ends first, waited for: it and its `Ran`,
-- | its handle let go of, the others running still (`Nothing`: there
-- | are none).  An input `Piped` is left open: a command that reads it
-- | to its end does not end until it is closed.
waitAny : {e : HFunctor}
        -> {{ev : process <: e}}
        -> List Subprocess
        -> Co e (Maybe (Pair Subprocess Ran))
waitAny ss = op (ev (WaitAny ss (\r -> r))) val

-- | The command's `Ran` if it has ended, its handle let go of, not
-- | waiting; else `Nothing`, and it runs still.
tryWait : {e : HFunctor}
        -> {{ev : process <: e}}
        -> Subprocess
        -> Co e (Maybe Ran)
tryWait s = op (ev (TryWait s (\r -> r))) val

-- | The command killed (SIGKILL; on Windows, TerminateProcess), if it
-- | has not ended, not waited for: its `wait` says `Signalled 9`.
kill : {e : HFunctor} -> {{ev : process <: e}} -> Subprocess -> Co e Unit
kill s = op (ev (Kill s MkUnit)) val

-- | The command ended, if it has not: asked to (SIGTERM), then made to
-- | (SIGKILL) where it has not within two seconds; waited for, its
-- | `Ran`, and its handle let go of.
terminate : {e : HFunctor} -> {{ev : process <: e}} -> Subprocess -> Co e Ran
terminate s = op (ev (Terminate s (\r -> r))) val

-- | The bytes written to the command's input, `Piped`, all of them,
-- | waiting while its pipe is full (what it writes read meanwhile, so
-- | that it never waits on the program): `False` where they could not
-- | be, the input not `Piped`, closed, or no more read.
writeInput : {e : HFunctor}
           -> {{ev : process <: e}}
           -> Subprocess
           -> Bytes
           -> Co e Bool
writeInput s b = op (ev (WriteInput s b (\r -> r))) val

-- | The command's input, `Piped`, closed: it reads its end.
closeInput : {e : HFunctor}
           -> {{ev : process <: e}}
           -> Subprocess
           -> Co e Unit
closeInput s = op (ev (CloseInput s MkUnit)) val

-- | Of what the command has written to its output, `Piped`, and the
-- | program not yet read, the portion, waited for up to `ms`
-- | milliseconds (0: as long as it takes).
readOutput : {e : HFunctor}
           -> {{ev : process <: e}}
           -> Subprocess
           -> Portion
           -> Int
           -> Co e Received
readOutput s n ms = op (ev (ReadOutput s n ms (\r -> r))) val

-- | `readOutput`, of its error stream.
readErrors : {e : HFunctor}
           -> {{ev : process <: e}}
           -> Subprocess
           -> Portion
           -> Int
           -> Co e Received
readErrors s n ms = op (ev (ReadErrors s n ms (\r -> r))) val
