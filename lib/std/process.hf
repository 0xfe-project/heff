-- The process as an effect (lib/co.hf): its arguments, its environment,
-- where its program is and where it runs, the commands it runs -- to
-- their end, or started beside it -- and how it ends
-- (process.provider.c).

import co
import std.handle

-- | a command run to its end: its status, and what it wrote to its
-- | output and its error stream
type Ran = { status : Int, out : String, err : String }

-- | (`Handle Started`, std.handle: a command started beside the program,
-- | `launch`'s; no value has it.)
data Started

-- | A command started beside the program.
type Child = Handle Started

data ProcessF (m : Type -> Type) x
  = Args (List String -> x)
  | GetEnv String (Maybe String -> x)
  | ProgramPath (String -> x)
  | WorkingDir (String -> x)
  | Platform (String -> x)
  | Exit Int x
  | Exec String (List String) x
  | Run String (List String) (Ran -> x)
  | Launch String (List String) (Maybe Child -> x)
  | Exited Child (Maybe Int -> x)
  | Terminate Child (Int -> x)

-- | The process as an effect.
process : HFunctor
process =
  { f = ProcessF
  , hfmap = \m g p -> case p of
      Args k -> Args (\a -> g (k a))
      GetEnv name k -> GetEnv name (\v -> g (k v))
      ProgramPath k -> ProgramPath (\s -> g (k s))
      WorkingDir k -> WorkingDir (\s -> g (k s))
      Platform k -> Platform (\s -> g (k s))
      Exit code x -> Exit code (g x)
      Exec cmd as x -> Exec cmd as (g x)
      Run cmd as k -> Run cmd as (\r -> g (k r))
      Launch cmd as k -> Launch cmd as (\c -> g (k c))
      Exited c k -> Exited c (\s -> g (k s))
      Terminate c k -> Terminate c (\s -> g (k s))
  , hmap = \m n nt p -> case p of
      Args k -> Args k
      GetEnv name k -> GetEnv name k
      ProgramPath k -> ProgramPath k
      WorkingDir k -> WorkingDir k
      Platform k -> Platform k
      Exit code x -> Exit code x
      Exec cmd as x -> Exec cmd as x
      Run cmd as k -> Run cmd as k
      Launch cmd as k -> Launch cmd as k
      Exited c k -> Exited c k
      Terminate c k -> Terminate c k
  }

-- | The program's arguments (not Node's, nor the program's own path):
-- | in any effect the process is in, by the evidence.
args : {e : HFunctor} -> {{ev : process <: e}} -> Co e (List String)
args = op (ev (Args (\a -> a))) val

-- | An environment variable, if it is set.
getEnv : {e : HFunctor}
       -> {{ev : process <: e}}
       -> String
       -> Co e (Maybe String)
getEnv name = op (ev (GetEnv name (\v -> v))) val

-- | The path of the program's own file.
programPath : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
programPath = op (ev (ProgramPath (\s -> s))) val

-- | The directory the program runs in, its working directory: a path
-- | written from it is under it.
workingDir : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
workingDir = op (ev (WorkingDir (\s -> s))) val

-- | The platform the program runs on, as Node.js names it: `linux`,
-- | `darwin`, `win32`, ...
platform : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
platform = op (ev (Platform (\s -> s))) val

-- | End the program, with a status (0: it went well); nothing after it runs.
exit : {e : HFunctor} -> {{ev : process <: e}} -> Int -> Co e Unit
exit code = op (ev (Exit code MkUnit)) val

-- | End the program, and run the command with the arguments in its place:
-- | its input is the program's, and its status is the program's status.
exec : {e : HFunctor}
     -> {{ev : process <: e}}
     -> String
     -> List String
     -> Co e Unit
exec cmd as = op (ev (Exec cmd as MkUnit)) val

-- | Run the command with the arguments, to its end, and go on: what it
-- | wrote, and its status (-1 if it could not be run).
run : {e : HFunctor}
    -> {{ev : process <: e}}
    -> String
    -> List String
    -> Co e Ran
run cmd as = op (ev (Run cmd as (\r -> r))) val

-- | Start the command with the arguments, beside the program, and go on:
-- | its standard streams the program's, in the program's process group
-- | (so that Ctrl-C ends both) -- the command, or `Nothing` where it
-- | could not be started.  At the program's end, a command it started
-- | that has not ended is terminated.
launch : {e : HFunctor}
       -> {{ev : process <: e}}
       -> String
       -> List String
       -> Co e (Maybe Child)
launch cmd as = op (ev (Launch cmd as (\c -> c))) val

-- | Whether the command has ended, not waiting: `Just` its status (128
-- | and the signal, where a signal ended it), else `Nothing`.
exited : {e : HFunctor} -> {{ev : process <: e}} -> Child -> Co e (Maybe Int)
exited c = op (ev (Exited c (\s -> s))) val

-- | The command ended, if it has not: asked to (SIGTERM), then made to
-- | (SIGKILL) where it has not within two seconds; its status, and its
-- | handle let go of (an operation given it after that fails the
-- | program).
terminate : {e : HFunctor} -> {{ev : process <: e}} -> Child -> Co e Int
terminate c = op (ev (Terminate c (\s -> s))) val
