-- For randomness the system gathers: bytes no one can foretell, not
-- even from the bytes it gave before -- what a key, a token or a seed
-- is made of.  A C program and a page's script both have a handler for
-- it: in C, the system's own generator (`getentropy`; `rand_s` on
-- Windows); in a page, `crypto.getRandomValues`.  std.random's
-- `fromEntropy` seeds a generator by it, for draws no two runs share.
--
-- ```haskell
-- import co
-- import std.entropy as Entropy
-- import std.hex as Hex
--
-- -- | a token of 16 bytes, written in hex
-- token : {e : HFunctor} -> {{ev : Entropy.entropy <: e}} -> Co e String
-- token = do
--   b <- Entropy.bytes 16
--   pure (Hex.encode b)
-- ```

module std.entropy

import co

data EntropyF (m : Type -> Type) x = Gather Int (Bytes -> x)

-- | For randomness the system gathers: bytes no one can foretell, not
-- | even from the bytes it gave before.
entropy : HFunctor
entropy =
  { f = EntropyF
  , hfmap = \m g p -> case p of
      Gather n k -> Gather n (\b -> g (k b))
  , hmap = \m n nt p -> case p of
      Gather c k -> Gather c k
  }

-- | `n` bytes of the system's randomness (of none or less, none).
bytes : {e : HFunctor} -> {{ev : entropy <: e}} -> Int -> Co e Bytes
bytes n = op (ev (Gather (if n <= 0 then 0 else n) (\b -> b))) val
