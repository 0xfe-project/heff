-- The network as an effect (lib/co.hf): what is at a URL.  A C program
-- has a handler for it (net.provider.c), and a page's script none: the
-- browser fetches by browser.dom's `fetchText`.

import co

data NetF (m : Type -> Type) x = Fetch String (String -> x)

-- | The network as an effect.
net : HFunctor
net =
  { f = NetF
  , hfmap = \m g p -> case p of
      Fetch url k -> Fetch url (\t -> g (k t))
  , hmap = \m n nt p -> case p of
      Fetch url k -> Fetch url k
  }

-- | What is at a URL, as text (or what went wrong, if nothing is there):
-- | in any effect the network is in, by the evidence.
fetchText : {e : HFunctor} -> {{ev : net <: e}} -> String -> Co e String
fetchText url = op (ev (Fetch url (\t -> t))) val
