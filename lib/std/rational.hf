-- Rationals: exact fractions of integers, as Racket's exact numbers are,
-- of any size, as an `Int` is.  A rational is kept in its lowest terms,
-- its denominator above 0, so two equal ones are the same: `over 2 4`
-- is `over (-1) (-2)`, one half.  Its instances are the prelude's
-- operators at `Rational` -- `x + y`, `x * y`, `-x`, `x < y`, `max x y`,
-- `x / y` (by 0, 0, as the prelude's `/` is) -- and `divide` divides it
-- by what is not 0, `over` makes one and `toFloat` is the float nearest
-- it.  Import it by a name, `import std.rational as Rational`, as
-- `toFloat` is the prelude's of an `Int`.
--
-- ```haskell
-- import std.rational as Rational
--
-- -- | 1 + 1/2 + 1/3 + ... + 1/n
-- -- | >>> show (harmonic 4)
-- -- | "25/12"
-- harmonic : Int -> Rational.Rational
-- harmonic n =
--   List.foldl
--     (\acc k -> acc + fromMaybe (Rational.fromInt 0) (Rational.over 1 k))
--     (Rational.fromInt 0)
--     (List.range 1 n)
-- ```

module std.rational
  ( Rational
  , over
  , fromInt
  , numerator
  , denominator
  , toFloat
  , divide
  , instanceEqualityRational
  , instanceOrderRational
  , instanceAdditionRational
  , instanceSubtractionRational
  , instanceMultiplicationRational
  , instanceDivisionRational
  , instanceNegationRational
  , instanceIsZeroRational
  , instanceDebugRational
  , instanceShowRational
  )

import std.math as Math

-- | A rational: its numerator and its denominator, in its lowest terms
-- | (no integer above 1 divides both) and the denominator above 0 -- as
-- | `over` makes it, which a rational made by the tag must be too.
data Rational = MkRational Int Int

-- (`n` over `d`, `d` not 0, in its lowest terms, its denominator above
-- 0)
lowestTerms : Int -> Int -> Rational
lowestTerms n d =
  let g : Int = Math.gcd n d
  in if d < 0 then MkRational (0 - n / g) (0 - d / g)
  else MkRational (n / g) (d / g)

-- | `n` over `d`, in its lowest terms; over 0, nothing.
-- | >>> over 6 (-4)
-- | Just (MkRational (-3) 2)
-- | >>> over 1 0
-- | Nothing
over : Int -> Int -> Maybe Rational
over n d = if d == 0 then Nothing else Just (lowestTerms n d)

-- | The integer, over 1.
fromInt : Int -> Rational
fromInt n = MkRational n 1

-- | Its numerator, of its lowest terms: of the sign of the rational.
numerator : Rational -> Int
numerator (MkRational n _) = n

-- | Its denominator, of its lowest terms: above 0.
-- | >>> maybe 0 denominator (over 6 (-4))
-- | 2
denominator : Rational -> Int
denominator (MkRational _ d) = d

-- | The float nearest it, correctly rounded: a tie to the even, as
-- | std.math's `fromDecimal` rounds a decimal -- beyond the greatest
-- | float, an infinity, and below half the least, 0.0 (of its sign).
-- | >>> List.map toFloat ([fromInt 3, MkRational 1 3, MkRational (-1) 10] : List Rational)
-- | [3.0, 0.3333333333333333, -0.1]
-- | >>> List.map toFloat ([MkRational 1 (Math.tenTo 400), MkRational (Math.tenTo 400) 1] : List Rational)
-- | [0.0, Infinity]
toFloat : Rational -> Float64
toFloat (MkRational n d) =
  if n == 0 then 0.0
  else if n < 0 then neg (floatOfPositive (0 - n))
  else floatOfPositive n
  where
  -- (`n` over `d`, both above 0, as the float nearest it: correctly
  -- rounded, a tie to the even, by std.math's rounding of a decimal)
  floatOfPositive : Int -> Float64
  floatOfPositive n =
    floatOfBits
      64
      (Math.bitsAt
         Math.binary64
         n
         d
         (max
            (Math.bitLength n
             - Math.bitLength d
             - Math.binary64.precision)
            Math.binary64.least))

-- | The first divided by the second; by 0, nothing.
-- | >>> divide (MkRational 1 2) (MkRational (-3) 4)
-- | Just (MkRational (-2) 3)
-- | >>> divide (MkRational 1 2) (fromInt 0)
-- | Nothing
divide : Rational -> Rational -> Maybe Rational
divide (MkRational a b) (MkRational c d) =
  if c == 0 then Nothing else Just (lowestTerms (a * d) (b * c))

-- Instances: the prelude's operators and functions at `Rational`
--------------------------------------------------------------------------------

-- | Equal as fractions: in their lowest terms, of the same terms.
instance instanceEqualityRational : Equality Rational
instanceEqualityRational =
  { equal = \x y -> numerator x == numerator y && denominator x == denominator y
  }

-- | >>> List.map (\p -> compare (fst p) (snd p)) ([MkPair (MkRational 1 3) (MkRational 1 2), MkPair (MkRational (-1) 2) (MkRational (-2) 3)] : List (Pair Rational Rational))
-- | Cons LT (Cons GT Nil)
instance instanceOrderRational : Order Rational
instanceOrderRational =
  { eq = instanceEqualityRational
  , compare = compareRational
  , lt = \x y -> compareRational x y == LT
  , le = \x y -> compareRational x y /= GT
  }
  where
  -- (`a/b` and `c/d`, `b` and `d` above 0, compared: `a*d` and `c*b`)
  compareRational : Rational -> Rational -> Ordering
  compareRational (MkRational a b) (MkRational c d) = compare (a * d) (c * b)

instance instanceAdditionRational : Addition Rational
instanceAdditionRational =
  { add = \x y ->
        lowestTerms
          (numerator x * denominator y + numerator y * denominator x)
          (denominator x * denominator y)
  }

-- | >>> (MkRational 1 2 + MkRational 1 3 - MkRational 1 6 : Rational)
-- | MkRational 2 3
instance instanceSubtractionRational : Subtraction Rational
instanceSubtractionRational =
  { sub = \x y ->
        lowestTerms
          (numerator x * denominator y - numerator y * denominator x)
          (denominator x * denominator y)
  }

-- | >>> (MkRational 2 3 * MkRational (-9) 4 : Rational)
-- | MkRational (-3) 2
instance instanceMultiplicationRational : Multiplication Rational
instanceMultiplicationRational =
  { mul = \x y ->
        lowestTerms (numerator x * numerator y) (denominator x * denominator y)
  }

-- | Division, total, as the prelude's `/` is: by 0, 0 (`divide` says
-- | nothing instead).
-- | >>> ([MkRational 1 2 / MkRational (-3) 4, MkRational 1 2 / fromInt 0] : List Rational)
-- | Cons (MkRational (-2) 3) (Cons (MkRational 0 1) Nil)
instance instanceDivisionRational : Division Rational
instanceDivisionRational =
  { div = \x y -> fromMaybe (MkRational 0 1) (divide x y) }

-- | >>> (-(MkRational 1 2) : Rational)
-- | MkRational (-1) 2
instance instanceNegationRational : Negation Rational
instanceNegationRational =
  { neg = \x ->
        (case x of
         MkRational a b -> MkRational (0 - a) b)
  }

instance instanceIsZeroRational : IsZero Rational
instanceIsZeroRational = { isZero = \x -> numerator x == 0 }

-- | As its tag rebuilds it: `MkRational 3 4`, a negative numerator in
-- | parentheses.
-- | >>> debug (MkRational (-3) 4 : Rational) ^ " " ^ debug (fromInt 2)
-- | "MkRational (-3) 4 MkRational 2 1"
instance instanceDebugRational : Debug Rational
instanceDebugRational =
  { debug = \x ->
        (case x of
         MkRational n d ->
           "MkRational "
           ^ (if n < 0 then "(" ^ debug n ^ ")" else debug n)
           ^ " "
           ^ debug d)
  }

-- | As a reader writes it, as Racket's: `3/4`, `-3/4`, and an integer
-- | alone, `2`.
-- | >>> show (MkRational (-3) 4 : Rational) ^ " " ^ show (fromInt 2)
-- | "-3/4 2"
instance instanceShowRational : Show Rational
instanceShowRational =
  { show = \x ->
        (case x of
         MkRational n 1 -> debug n
         MkRational n d -> debug n ^ "/" ^ debug d)
  }
