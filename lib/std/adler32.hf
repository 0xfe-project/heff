-- Adler-32, the checksum of RFC 1950 that zlib keeps: two sums of the
-- bytes, each modulo 65521, the largest prime below 65536 -- `a`, 1 and
-- each byte, and `b`, each `a` so far -- as `b` times 65536 and `a`, Go's
-- `adler32.Checksum`.  It is quicker than a CRC-32, and weaker over few
-- bytes; it finds bytes changed by accident, not on purpose.
--
-- ```haskell
-- import bytes as Bytes
-- import std.adler32 as Adler32
--
-- -- | whether a zlib stream's data is what its trailer says it was
-- unchanged : Bytes -> UInt32 -> Bool
-- unchanged content recorded = Adler32.checksum content == recorded
-- ```

module std.adler32 (checksum)

import bytes as Bytes
import uint32 as UInt32
import uint8 as UInt8

-- | The Adler-32 of the bytes: of "Wikipedia", 0x11e60398.
-- | >>> checksum (Bytes.fromString "Wikipedia") == 0x11e60398
-- | True
-- | >>> checksum Bytes.empty
-- | 1
-- | >>> checksum (Bytes.fromString "The quick brown fox jumps over the lazy dog") == 0x5bdc0fda
-- | True
-- | >>> checksum (Bytes.fromList (List.replicate 100000 255)) == 0x149a302c
-- | True
checksum : Bytes -> UInt32
checksum m = summedFrom 0 (min 5552 (Bytes.length m)) 1 0
  where
  -- (the checksum of the bytes of `m` from `i` on, the sums so far `a` and
  -- `b`, taken modulo 65521 when `i` is `end`: 5552 bytes after the last
  -- time, as many as can be added before `b` may overflow 32 bits, as
  -- zlib takes them)
  summedFrom : Int -> Int -> Int -> Int -> UInt32
  summedFrom i end a b =
    if i < end
    then (let next : Int = a + UInt8.toInt (Bytes.bytesAt m i)
          in summedFrom (i + 1) end next (b + next))
    else if i < Bytes.length m
    then summedFrom i (min (i + 5552) (Bytes.length m)) (a % 65521) (b % 65521)
    else UInt32.fromInt (b % 65521 * 65536 + a % 65521)
