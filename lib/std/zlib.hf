-- zlib (RFC 1950), decompressed: DEFLATE data between a header of two
-- bytes and the Adler-32 of what it holds, as Go's `compress/zlib` reads
-- it.  A stream made with a preset dictionary is not read.  Import it by a
-- name, `import std.zlib as Zlib`.
--
-- ```haskell
-- import bytes as Bytes
-- import std.flate as Flate
-- import std.zlib as Zlib
--
-- -- | >>> greeting
-- -- | Right "hello"
-- greeting : Either Flate.CorruptInput String
-- greeting = case Zlib.decompress b["x", 1, 1, 5, 0, 250, 255, "hello", 6, ",", 2, 21] of
--   Right out -> Right (toString out)
--   Left e -> Left e
-- ```

module std.zlib (decompress)

import bytes as Bytes
import std.adler32 as Adler32
import std.flate as Flate
import uint32 as UInt32

-- | The zlib stream the bytes begin with, decompressed, its checksum
-- | checked; any bytes after it are not looked at.  Where it is wrong, the
-- | byte of the input where it went wrong, and what is wrong.
-- | >>> decompress b["x", 156, 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30, 6, 246]
-- | Right b["hello, hello, hello!"]
-- | >>> decompress b["x", 1, 1, 5, 0, 250, 255, "hello", 6, ",", 2, 21]
-- | Right b["hello"]
-- | >>> decompress b["x", 156, 3, 0, 0, 0, 0, 1]
-- | Right b[]
-- | >>> decompress b["x", 156, 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30, 6, 246, "xyz"]
-- | Right b["hello, hello, hello!"]
-- |
-- | (a header not checked by its 5 bits, another method than DEFLATE, a
-- | window over 32 KB, a preset dictionary; DEFLATE data that is wrong; a
-- | checksum not the data's; too few bytes)
-- | >>> decompress b["x", 157, 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30, 6, 246]
-- | Left { offset = 0, message = "incorrect header check" }
-- | >>> decompress b["y", 24, 3, 0, 0, 0, 0, 1]
-- | Left { offset = 0, message = "unknown compression method" }
-- | >>> decompress b[136, 28, 3, 0, 0, 0, 0, 1]
-- | Left { offset = 0, message = "invalid window size" }
-- | >>> decompress b["x ", 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30, 6, 246]
-- | Left { offset = 1, message = "preset dictionary not supported" }
-- | >>> decompress b["x", 156, 7]
-- | Left { offset = 2, message = "invalid block type 3" }
-- | >>> decompress b["x", 156, 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30, 6, 247]
-- | Left { offset = 14, message = "incorrect data check" }
-- | >>> decompress b["x", 156, 203, "H", 205, 201, 201, 215, "Q", 200, "@", 162, 20, 1, "K", 30]
-- | Left { offset = 16, message = "unexpected end of input" }
-- | >>> decompress b["x"]
-- | Left { offset = 1, message = "unexpected end of input" }
decompress : Bytes -> Either Flate.CorruptInput Bytes
decompress input = case input of
  b[header::16, _::binary] ->
    if header % 31 /= 0 then failure 0 "incorrect header check"
    else case input of
      b[window::4, method::4, _::2, dictionary::1, _::5, _::binary] ->
        if method /= 8 then failure 0 "unknown compression method"
        else if window > 7 then failure 0 "invalid window size"
        else if dictionary == 1 then failure 1 "preset dictionary not supported"
        else streamed
      _ -> ended
  _ -> ended
  where
  -- (the input found wrong at byte `offset`, by `message`)
  failure : Int -> String -> Either Flate.CorruptInput Bytes
  failure offset message = Left { offset = offset, message = message }
  -- (the input ended where more was wanted)
  ended : Either Flate.CorruptInput Bytes
  ended = failure (Bytes.length input) "unexpected end of input"
  -- (the DEFLATE data after the header, and the Adler-32 after it)
  streamed : Either Flate.CorruptInput Bytes
  streamed = case Flate.decompressAt input 2 of
    Left e -> Left e
    Right (MkPair out end) -> case Bytes.slice input end (end + 4) of
      b[sum::32] ->
        if UInt32.toInt (Adler32.checksum out) /= sum
        then failure end "incorrect data check"
        else Right out
      _ -> ended
