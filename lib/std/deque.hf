-- Double-ended queues: a sequence pushed onto and popped from at either
-- end, persistent.  Two lists, the front and the back the other way
-- round, each with its length: where one would be left empty while the
-- other has two or more, the other is cut in halves, one turned round
-- for it.  So a push, a pop and a peek at either end take a step each,
-- amortised (where a deque is used once: a pop that cuts the halves,
-- popped again from an older deque, cuts them again), and its size one.
-- Import it by a name, `import std.deque as Deque`, as the list module
-- has a `null`.  The deque comes first, as a set's does:
-- `Deque.pushFront d x`, `Deque.pushBack d x`.
--
-- ```haskell
-- import std.deque as Deque
--
-- -- | the last of a list moved to its front
-- -- | >>> rotated [1, 2, 3]
-- -- | Cons 3 (Cons 1 (Cons 2 Nil))
-- rotated : List Int -> List Int
-- rotated xs =
--   let d : Deque.Deque Int = Deque.fromList xs
--   in Deque.toList
--     (maybe d (\p -> Deque.pushFront (snd p) (fst p)) (Deque.popBack d))
-- ```

module std.deque
  ( Deque
  , empty
  , null
  , size
  , pushFront
  , pushBack
  , popFront
  , popBack
  , peekFront
  , peekBack
  , fromList
  , toList
  )

-- | A deque: how many are at the front and the front, first first, and
-- | how many are at the back and the back, last first.  Each has an
-- | element where there are two or more in all.
data Deque a = MkDeque Int (List a) Int (List a)

-- | The deque of nothing.
empty : {a : Type} -> Deque a
empty = MkDeque 0 Nil 0 Nil

-- | Whether it holds nothing.
null : {a : Type} -> Deque a -> Bool
null (MkDeque m _ n _) = m + n == 0

-- | How many elements it holds: kept with each side, so a step.
size : {a : Type} -> Deque a -> Int
size (MkDeque m _ n _) = m + n

-- (a side of `n` elements, two or more, cut in halves: the half nearer
-- its end kept, and the other turned round for the other side, which was
-- empty -- the kept half, then the other)
halves : {a : Type} -> Int -> List a -> Pair (List a) (List a)
halves n xs = case takenOnto (n / 2) Nil xs of
  MkPair kept rest -> MkPair (List.reverse kept) (List.reverse rest)
  where
  -- (the first `k` of `xs`, the other way round onto `acc`, and the rest)
  takenOnto : Int -> List a -> List a -> Pair (List a) (List a)
  takenOnto k acc (x :: xs) =
    if k <= 0 then MkPair acc (x :: xs) else takenOnto (k - 1) (x :: acc) xs
  takenOnto k acc [] = MkPair acc Nil

-- (the deque of these sides, a side cut in halves where the other is
-- empty and it has two or more)
rebalanced : {a : Type} -> Int -> List a -> Int -> List a -> Deque a
rebalanced 0 [] n back =
  if n >= 2
  then (case halves n back of
        MkPair kept front -> MkDeque (n - n / 2) front (n / 2) kept)
  else MkDeque 0 Nil n back
rebalanced m front 0 [] =
  if m >= 2
  then (case halves m front of
        MkPair kept back -> MkDeque (m / 2) kept (m - m / 2) back)
  else MkDeque m front 0 Nil
rebalanced m front n back = MkDeque m front n back

-- | The deque with `x` at its front.
pushFront : {a : Type} -> Deque a -> a -> Deque a
pushFront (MkDeque m front n back) x = rebalanced (m + 1) (x :: front) n back

-- | The deque with `x` at its back.
pushBack : {a : Type} -> Deque a -> a -> Deque a
pushBack (MkDeque m front n back) x = rebalanced m front (n + 1) (x :: back)

-- | Its first element and the deque without it, if it is not empty.
-- | >>> maybe 0 (\p -> fst p) (popFront (pushBack (pushBack empty 1) 2))
-- | 1
-- | >>> maybe (-1) (\p -> size (snd p)) (popFront (pushFront empty 1))
-- | 0
popFront : {a : Type} -> Deque a -> Maybe (Pair a (Deque a))
popFront (MkDeque m (x :: front) n back) =
  Just (MkPair x (rebalanced (m - 1) front n back))
popFront (MkDeque _ [] _ (x :: _)) = Just (MkPair x empty)
popFront (MkDeque _ [] _ []) = Nothing

-- | Its last element and the deque without it, if it is not empty.
-- | >>> maybe 0 (\p -> fst p) (popBack (pushBack (pushBack empty 1) 2))
-- | 2
popBack : {a : Type} -> Deque a -> Maybe (Pair a (Deque a))
popBack (MkDeque m front n (x :: back)) =
  Just (MkPair x (rebalanced m front (n - 1) back))
popBack (MkDeque _ (x :: _) _ []) = Just (MkPair x empty)
popBack (MkDeque _ [] _ []) = Nothing

-- | Its first element, if it is not empty.
-- | >>> peekFront (pushBack (pushBack empty 1) 2)
-- | Just 1
-- | >>> peekFront (empty : Deque Int)
-- | Nothing
peekFront : {a : Type} -> Deque a -> Maybe a
peekFront (MkDeque _ (x :: _) _ _) = Just x
peekFront (MkDeque _ [] _ (x :: _)) = Just x
peekFront (MkDeque _ [] _ []) = Nothing

-- | Its last element, if it is not empty.
-- | >>> peekBack (pushBack (pushBack empty 1) 2)
-- | Just 2
peekBack : {a : Type} -> Deque a -> Maybe a
peekBack (MkDeque _ _ _ (x :: _)) = Just x
peekBack (MkDeque _ (x :: _) _ []) = Just x
peekBack (MkDeque _ [] _ []) = Nothing

-- | The deque of a list's elements, its first at the front.
-- | >>> peekBack (fromList [1, 2, 3])
-- | Just 3
fromList : {a : Type} -> List a -> Deque a
fromList xs = rebalanced (List.length xs) xs 0 Nil

-- | The elements, the front's first.
-- | >>> toList (pushFront (pushBack (fromList [1, 2, 3]) 4) 0)
-- | Cons 0 (Cons 1 (Cons 2 (Cons 3 (Cons 4 Nil))))
-- | >>> toList (maybe empty (\p -> snd p) (popBack (fromList [1, 2, 3])))
-- | Cons 1 (Cons 2 Nil)
toList : {a : Type} -> Deque a -> List a
toList (MkDeque _ front _ back) =
  List.foldl (\acc x -> x :: acc) (List.reverse back) (List.reverse front)
