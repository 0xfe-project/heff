-- Maps from keys to values by the keys' hashes: a hash array mapped trie
-- (HAMT), as Clojure's, Scala's and Haskell's unordered-containers' maps
-- are.  Import it by a name, `import std.hashmap as HashMap`
-- (`HashMap.insert`), as `map`'s names are its names too.  The map comes
-- first, as in std.ordmap.
--
-- ```haskell
-- import std.hashmap as HashMap
--
-- -- | >>> HashMap.lookup (seen ["x", "y"]) "y"
-- -- | Just (True)
-- seen : List String -> HashMap.HashMap String Bool
-- seen ws = HashMap.fromList (List.map (\w -> MkPair w True) ws)
-- ```
--
-- Each level of the trie takes 5 bits of a key's hash, so a node has up
-- to 32 children, kept in an array as long as how many there are and
-- found by a bitmap of which there are (the bits below a child's, counted,
-- are where it is); 3572 keys are 3 levels deep, a million 4.  A key is
-- compared once, where its hash has led, with the one there.  Where
-- nothing else holds a node, it is changed in place: a value changed
-- (`update`) builds nothing.  The map keeps how many keys it binds, as
-- each walk finds them added or gone, so `size` reads it; `remove` says
-- whether a key it deletes was there.
--
-- The keys' type has a `Hash` (strings, integers, runes, booleans, and
-- pairs, lists and `Maybe`s of them) and an `Equality`, each found as an
-- instance argument is.  The order of `toList` and `foldl` is the trie's,
-- by the hashes: not the keys', but the same on every backend.
--
-- std.hashtable has the same names, in flat arrays: faster and smaller
-- where one owner fills and reads a map, but a change to a table held
-- elsewhere too copies all of it, and its order is of how it came to be.
-- A map whose old versions are kept is this one's.

module std.hashmap
  ( strHash
  , intHash
  , strHashRange
  , strEqRange
  , trieSlot
  , Hash
  , hash
  , instanceHashString
  , instanceHashInt
  , instanceHashRune
  , instanceHashBool
  , combine
  , instanceHashPair
  , instanceHashMaybe
  , instanceHashList
  , KeyView
  , Slice(..)
  , slice
  , instanceKeyViewStringSlice
  , Trie(..)
  , HashMap(..)
  , empty
  , Walked(..)
  , update
  , insert
  , lookup
  , remove
  , delete
  , alter
  , foldl
  , size
  , toList
  , member
  , keys
  , values
  , instanceIterateHashMap
  , fromList
  , updateBy
  , lookupBy
  )
import array as Array
import int as Int

-- (a string's hash and an integer's: as the runtime's:
-- FxHash's step over the bytes 8 at a time and murmur3's finish;
-- a word's integer, from 0 up to 2^62)
primitive strHash : String -> Int
primitive intHash : Int -> Int

-- | The hash of `s`'s bytes from `i` up to `j`, as `strHash (strSlice s i j)`
-- | (the same clamping), the slice never made.
-- | >>> strHashRange "hello, world" 7 12 == strHash "world"
-- | True
primitive strHashRange : String -> Int -> Int -> Int

-- | Whether `t` is `s`'s bytes from `i` up to `j`, as
-- | `strEq t (strSlice s i j)`, the slice never made.
-- | >>> strEqRange "world" "hello, world" 7 12
-- | True
primitive strEqRange : String -> String -> Int -> Int -> Bool

-- (a trie's step: where the child the 5 bits of a hash from a bit on
-- choose is among those a node's bitmap says it has -- the bits set below
-- its, counted at once -- or, where it is not one of them, -1 less that)
primitive trieSlot : Int -> Int -> Int -> Int

-- | A type's hash: two values `equal` have the same one.
theory Hash (a : Type) where
  hash : a -> Int

hash : {a : Type} -> {{hashing : Hash a}} -> a -> Int
hash = hashing.hash

-- | >>> hash "hello, world" == hash ("hello" ^ ", world")
-- | True
-- | >>> hash "a" == hash "b"
-- | False
instance instanceHashString : Hash String
instanceHashString = { hash = strHash }

-- | >>> List.map (\(i : Int) -> hash i == hash (i + 1)) [0, 1180591620717411303424]
-- | Cons False (Cons False Nil)
instance instanceHashInt : Hash Int
instanceHashInt = { hash = intHash }

instance instanceHashRune : Hash Rune
instanceHashRune = { hash = \r -> intHash (runeToInt r) }

instance instanceHashBool : Hash Bool
instanceHashBool = { hash = \b -> if b then intHash 1 else intHash 0 }

-- | the hash of what is hashed `h` so far, then of `x`'s hash: in order,
-- | so that `MkPair a b` and `MkPair b a` differ
combine : Int -> Int -> Int
combine h x = intHash (xor (intHash h) x)

-- | >>> hash (MkPair 1 2 : Pair Int Int) == hash (MkPair 2 1 : Pair Int Int)
-- | False
instance instanceHashPair : {a b : Type}
                          -> {{hashA : Hash a}}
                          -> {{hashB : Hash b}}
                          -> Hash (Pair a b)
instanceHashPair = { hash = \p -> combine (hash (fst p)) (hash (snd p)) }

instance instanceHashMaybe : {a : Type}
                           -> {{hashing : Hash a}}
                           -> Hash (Maybe a)
instanceHashMaybe = { hash = hashed }
  where
  hashed : Maybe a -> Int
  hashed Nothing = intHash 0
  hashed (Just x) = combine 1 (hash x)

-- | >>> hash (["a", "b"] : List String) == hash (["b", "a"] : List String)
-- | False
instance instanceHashList : {a : Type} -> {{hashing : Hash a}} -> Hash (List a)
instanceHashList =
  { hash = \xs -> List.foldl (\h x -> combine h (hash x)) 0 xs }

-- | A view of a key, `q`, that stands for a key of type `k` without
-- | being one: what a map's `updateBy` and `lookupBy` look a key up by,
-- | so that the key is made (`keyOf`) only where it is new to the map.
-- | Its hash is the key's, and it matches the key it stands for and no
-- | other: `hashOf q == hash (keyOf q)`, and `matches k q` where
-- | `equal k (keyOf q)`.
theory KeyView (k : Type) (q : Type) where
  hashOf : q -> Int
  matches : k -> q -> Bool
  keyOf : q -> k

-- | A part of a string: its bytes from one place up to another, as
-- | `strSlice` takes them, the slice not made.
data Slice = MkSlice String Int Int

-- | The part of `s` from `i` up to `j`, as a `Slice` (where its type is
-- | not known, as a view's is not, a tag is not enough).
slice : String -> Int -> Int -> Slice
slice s i j = MkSlice s i j

-- | A string's part stands for the string `strSlice` would make of it,
-- | hashed and compared where it is.
-- | >>> instanceKeyViewStringSlice.hashOf (MkSlice "hello, world" 7 12) == hash "world"
-- | True
-- | >>> instanceKeyViewStringSlice.matches "world" (MkSlice "hello, world" 7 12)
-- | True
instance instanceKeyViewStringSlice : KeyView String Slice
instanceKeyViewStringSlice =
  { hashOf = sliceHash, matches = sliceMatches, keyOf = sliceKey }
  where
  sliceHash : Slice -> Int
  sliceHash (MkSlice s i j) = strHashRange s i j
  sliceMatches : String -> Slice -> Bool
  sliceMatches t (MkSlice s i j) = strEqRange t s i j
  sliceKey : Slice -> String
  sliceKey (MkSlice s i j) = strSlice s i j

-- | A trie: nothing (only the whole map's, never a child); a key, its
-- | hash and its value; keys of one hash, each with its value; or a node
-- | of children, a bitmap of which of the 32 there are.
data Trie k v
  = Vacant
  | Leaf Int k v
  | Collision Int (List (Pair k v))
  | Branch Int (Array (Trie k v))

-- | A map: how many keys it binds, and its trie.
data HashMap k v = MkHashMap Int (Trie k v)

-- | The map of no keys.
empty : {k v : Type} -> HashMap k v
empty = MkHashMap 0 Vacant

-- (the bit of the child the hash `h` is led to at the level `s` bits down)
bitAt : Int -> Int -> Int
bitAt h s = shiftL 1 (and (shiftR h s) 31)

-- (a node's two children, `a` first: an array made at once, no list
-- made for it)
twoChildren : {a : Type} -> a -> a -> Array a
twoChildren a b = arraySet (arrayReplicate 2 a) 1 b

-- (two nodes of hashes `h1` and `h2`, which differ, under one node at
-- the level `s` bits down: further down while their bits there agree)
joined : {k v : Type} -> Int -> Int -> Trie k v -> Int -> Trie k v -> Trie k v
joined s h1 n1 h2 n2 =
  let b1 = bitAt h1 s
  in let b2 = bitAt h2 s
  in if b1 == b2
  then Branch b1 (arrayReplicate 1 (joined (s + 5) h1 n1 h2 n2))
  else if b1 < b2
  then Branch (or b1 b2) (twoChildren n1 n2)
  else Branch (or b1 b2) (twoChildren n2 n1)

-- (`x` put in among a node's children at `i`, their array given room
-- first where it has none, its room doubled: a node filled a child at a
-- time, where nothing else holds it, is grown in place but at each power
-- of 2, not copied at each child)
childAdded : {a : Type} -> Array a -> Int -> a -> Array a
childAdded children i x = Array.insertAt (Array.reserve children 1) i x

-- (pairs of one hash, as a node: none, one a leaf)
collisionOf : {k v : Type} -> Int -> List (Pair k v) -> Trie k v
collisionOf h [] = Vacant
collisionOf h [MkPair k v] = Leaf h k v
collisionOf h ps = Collision h ps

-- A walk down the trie gives back the trie changed and how many keys it
-- gained (1, none, or -1), or the value it took out, so that the map's
-- count is kept in the same walk.  A node's child walked into is taken
-- out of its array first, `Vacant` put there, so that nothing but the
-- walk holds it and it is changed in place: the children so holed are
-- handed down with it, and back, and the child changed is put back in
-- them where the walk gives back, the node built again in its own cell
-- and each step's result taken apart where it is given -- so that a
-- value changed builds nothing.

-- (the pairs of one hash, as a node, `n` of them before)
pairsGrown : {k v : Type}
           -> Int
           -> Int
           -> List (Pair k v)
           -> Pair (Trie k v) Int
pairsGrown h n ps = MkPair (collisionOf h ps) (List.length ps - n)

-- (the pairs of one hash, `key` bound to `value` or to `f value old`)
pairsWith : {k v : Type}
          -> (k -> k -> Bool)
          -> (v -> v -> v)
          -> k
          -> v
          -> List (Pair k v)
          -> List (Pair k v)
pairsWith eq f key value [] = [MkPair key value]
pairsWith eq f key value (MkPair k2 v2 :: rest) =
  if eq key k2 then MkPair k2 (f value v2) :: rest
  else MkPair k2 v2 :: pairsWith eq f key value rest

-- (a node `s` bits down without the bit of `h`, and `key` bound to a
-- value, if to one: a leaf of its own at `i`, or not at all)
budded : {k v : Type}
       -> Int
       -> Int
       -> Int
       -> k
       -> Maybe v
       -> Int
       -> Array (Trie k v)
       -> Pair (Trie k v) Int
budded h s i key Nothing bm children = MkPair (Branch bm children) 0
budded h s i key (Just v) bm children =
  MkPair
    (Branch (or bm (bitAt h s)) (childAdded children i (Leaf h key v)))
    1

-- (what a walk gives back: the node it was given, changed; what it found
-- (how many keys it gained, the value it took out); and the array it was
-- handed, as it was)
data Walked k v a = MkWalked (Trie k v) a (Array (Trie k v))

-- (`update` at a node `s` bits down, `holed` handed down and back: the
-- children of the node above, this node taken out of them, so that they
-- are taken out before the walk goes down, not where it gives back)
insertAt : {k v : Type}
         -> (k -> k -> Bool)
         -> (v -> v -> v)
         -> Int
         -> Int
         -> k
         -> v
         -> Trie k v
         -> Array (Trie k v)
         -> Walked k v Int
insertAt eq f h s key value (Branch bm children) holed =
  let j = trieSlot bm h s
  in if j < 0
  then MkWalked
      (Branch
         (or bm (bitAt h s))
         (childAdded children (-1 - j) (Leaf h key value)))
      1
      holed
  else (let child = arrayIndex children j
        in let walked : Walked k v Int =
          insertAt eq f h (s + 5) key value child (arraySet children j Vacant)
        in (case walked of
            MkWalked changed d rest ->
              MkWalked (Branch bm (arraySet rest j changed)) d holed))
insertAt eq f h s key value node holed = case putAt node of
  MkPair changed d -> MkWalked changed d holed
  where
  -- (`update` at a node `s` bits down, the key's hash `h`, but a branch)
  putAt : Trie k v -> Pair (Trie k v) Int
  putAt Vacant = MkPair (Leaf h key value) 1
  putAt (Leaf h2 k2 v2) =
    if h /= h2 then MkPair (joined s h (Leaf h key value) h2 (Leaf h2 k2 v2)) 1
    else if eq key k2 then MkPair (Leaf h2 k2 (f value v2)) 0
    else MkPair (Collision h2 [MkPair key value, MkPair k2 v2]) 1
  putAt (Collision h2 ps) =
    if h /= h2
    then MkPair (joined s h (Leaf h key value) h2 (Collision h2 ps)) 1
    else pairsGrown h2 (List.length ps) (pairsWith eq f key value ps)
  putAt node = MkPair node 0

-- | The map with `k` bound to `v`, or, where it is bound, to `f v old`
-- | (Haskell's `insertWith`): a value changed in one walk down the trie.
update : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> v
       -> (v -> v -> v)
       -> HashMap k v
update (MkHashMap n t) key value f =
  let walked : Walked k v Int =
    insertAt equal f (hash key) 0 key value t Array.empty
  in (case walked of
      MkWalked changed d _ -> MkHashMap (n + d) changed)

-- | The map with `k` bound to `v` (instead of what it was, if it was).
insert : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> v
       -> HashMap k v
insert (MkHashMap n t) key value =
  let walked : Walked k v Int =
    insertAt equal (\new old -> new) (hash key) 0 key value t Array.empty
  in (case walked of
      MkWalked changed d _ -> MkHashMap (n + d) changed)

-- (the value of `key` among the pairs of one hash)
pairsLookup : {k v : Type}
            -> (k -> k -> Bool)
            -> k
            -> List (Pair k v)
            -> Maybe v
pairsLookup eq key [] = Nothing
pairsLookup eq key (MkPair k2 v2 :: rest) =
  if eq key k2 then Just v2 else pairsLookup eq key rest

-- (a map's trie: a `lookup`'s walk given it as an argument, so that a
-- match on what the walk finds takes it apart where it is given)
trieOf : {k v : Type} -> HashMap k v -> Trie k v
trieOf (MkHashMap n t) = t

-- | What `k` is bound to, if it is.
lookup : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> Maybe v
lookup m key = lookupAt equal (hash key) 0 (trieOf m)
  where
  lookupAt : (k -> k -> Bool) -> Int -> Int -> Trie k v -> Maybe v
  lookupAt eq h s Vacant = Nothing
  lookupAt eq h s (Leaf h2 k2 v2) =
    if h == h2 && eq key k2 then Just v2 else Nothing
  lookupAt eq h s (Collision h2 ps) =
    if h == h2 then pairsLookup eq key ps else Nothing
  lookupAt eq h s (Branch bm children) =
    let i = trieSlot bm h s
    in if i < 0 then Nothing
    else lookupAt eq h (s + 5) (arrayIndex children i)

-- (the one child left of a node, `other`, beside the one at `j` the walk
-- emptied: a leaf or keys of one hash, which may stand for the node, at
-- any level, the children's array let go as it is; or a node, which may
-- not, its bits being of its own level)
lone : {k v : Type}
     -> Trie k v
     -> Int
     -> Int
     -> Array (Trie k v)
     -> Trie k v
lone (Branch b c) bm j children = Branch bm (Array.removeAt children j)
lone other bm j children = other

-- (a node of fewer children, the one at `j` emptied by the walk: none,
-- nothing; one, it if it may stand for the node -- not taken out of
-- the array first, which would be made over only to be let go)
shrunk : {k v : Type} -> Int -> Int -> Array (Trie k v) -> Trie k v
shrunk 0 j children = Vacant
shrunk bm j children =
  if arrayLength children == 2
  then lone (arrayIndex children (1 - j)) bm j children
  else Branch bm (Array.removeAt children j)

-- (whether a node is none: a child the walk emptied)
vacant : {k v : Type} -> Trie k v -> Bool
vacant Vacant = True
vacant node = False

-- (the pairs of one hash, `key`'s gone)
pairsWithout : {k v : Type}
             -> (k -> k -> Bool)
             -> k
             -> List (Pair k v)
             -> List (Pair k v)
pairsWithout eq key [] = Nil
pairsWithout eq key (MkPair k2 v2 :: rest) =
  if eq key k2 then rest else MkPair k2 v2 :: pairsWithout eq key rest

-- | What `k` was bound to, if it was, and the map without it (Rust's
-- | `remove`): a delete that says whether the key was there, in one walk
-- | down the trie.
remove : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> Pair (Maybe v) (HashMap k v)
remove (MkHashMap n t) key =
  let walked : Walked k v (Maybe v) = deleteAt equal (hash key) 0 t Array.empty
  in (case walked of
      MkWalked changed Nothing _ -> MkPair Nothing (MkHashMap n changed)
      MkWalked changed (Just v) _ ->
        MkPair (Just v) (MkHashMap (n - 1) changed))
  where
  -- (`remove` at a node `s` bits down, `holed` handed down and back as
  -- `insertAt`'s: a child emptied is gone from the node, and only then its
  -- bit worked out)
  deleteAt : (k -> k -> Bool)
           -> Int
           -> Int
           -> Trie k v
           -> Array (Trie k v)
           -> Walked k v (Maybe v)
  deleteAt eq h s (Branch bm children) holed =
    let j = trieSlot bm h s
    in if j < 0 then MkWalked (Branch bm children) Nothing holed
    else (let child = arrayIndex children j
          in let walked : Walked k v (Maybe v) =
            deleteAt eq h (s + 5) child (arraySet children j Vacant)
          in (case walked of
              MkWalked changed taken rest ->
                if vacant changed
                then MkWalked
                    (shrunk (xor bm (bitAt h s)) j rest)
                    taken
                    holed
                else MkWalked
                    (Branch bm (arraySet rest j changed))
                    taken
                    holed))
  deleteAt eq h s node holed = case removedFrom node of
    MkPair changed taken -> MkWalked changed taken holed
    where
    -- (`remove` at a node, but a branch: the node without `key`, and what
    -- `key` was bound to there, if it was)
    removedFrom : Trie k v -> Pair (Trie k v) (Maybe v)
    removedFrom (Leaf h2 k2 v2) =
      if h == h2 && eq key k2 then MkPair Vacant (Just v2)
      else MkPair (Leaf h2 k2 v2) Nothing
    removedFrom (Collision h2 ps) =
      if h == h2
      then MkPair
          (collisionOf h2 (pairsWithout eq key ps))
          (pairsLookup eq key ps)
      else MkPair (Collision h2 ps) Nothing
    removedFrom other = MkPair other Nothing

-- | The map without `k` (as it was, if `k` was not in it; `remove` says
-- | which).
delete : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> HashMap k v
delete m key = snd (remove m key)

-- (the pairs of one hash, `key` bound as `f` says, given what it was
-- bound to)
pairsAltered : {k v : Type}
             -> (k -> k -> Bool)
             -> (Maybe v -> Maybe v)
             -> k
             -> List (Pair k v)
             -> List (Pair k v)
pairsAltered eq f key [] = maybe Nil (\v -> [MkPair key v]) (f Nothing)
pairsAltered eq f key (MkPair k2 v2 :: rest) =
  if eq key k2 then maybe rest (\v -> MkPair k2 v :: rest) (f (Just v2))
  else MkPair k2 v2 :: pairsAltered eq f key rest

-- (a node of another hash than `key`'s, `h2`, and `key` bound as `f`
-- said, given nothing: beside it, or not at all)
sprouted : {k v : Type}
         -> Int
         -> Int
         -> k
         -> Maybe v
         -> Int
         -> Trie k v
         -> Pair (Trie k v) Int
sprouted s h key Nothing h2 node = MkPair node 0
sprouted s h key (Just v) h2 node = MkPair (joined s h (Leaf h key v) h2 node) 1

-- | The map with `k` bound as `f` says, given what it is bound to, if it
-- | is: to `f`'s value, or (`Nothing`) to none (Haskell's `alter`), in
-- | one walk down the trie.
alter : {k v : Type}
      -> {{hashing : Hash k}}
      -> {{equality : Equality k}}
      -> HashMap k v
      -> k
      -> (Maybe v -> Maybe v)
      -> HashMap k v
alter (MkHashMap n t) key f =
  let walked : Walked k v Int = alterAt equal (hash key) 0 t Array.empty
  in (case walked of
      MkWalked changed d _ -> MkHashMap (n + d) changed)
  where
  -- (`alter` at a node `s` bits down, `holed` handed down and back as
  -- `insertAt`'s)
  alterAt : (k -> k -> Bool)
          -> Int
          -> Int
          -> Trie k v
          -> Array (Trie k v)
          -> Walked k v Int
  alterAt eq h s (Branch bm children) holed =
    let j = trieSlot bm h s
    in if j < 0
    then (case budded h s (-1 - j) key (f Nothing) bm children of
          MkPair changed d -> MkWalked changed d holed)
    else (let child = arrayIndex children j
          in let walked : Walked k v Int =
            alterAt eq h (s + 5) child (arraySet children j Vacant)
          in (case walked of
              MkWalked changed d rest ->
                if vacant changed
                then MkWalked
                    (shrunk (xor bm (bitAt h s)) j rest)
                    d
                    holed
                else MkWalked (Branch bm (arraySet rest j changed)) d holed))
  alterAt eq h s node holed = case alteredAt node of
    MkPair changed d -> MkWalked changed d holed
    where
    -- (`alter` at a node `s` bits down, but a branch)
    alteredAt : Trie k v -> Pair (Trie k v) Int
    alteredAt Vacant = pairsGrown h 0 (pairsAltered eq f key Nil)
    alteredAt (Leaf h2 k2 v2) =
      if h /= h2 then sprouted s h key (f Nothing) h2 (Leaf h2 k2 v2)
      else pairsGrown h2 1 (pairsAltered eq f key [MkPair k2 v2])
    alteredAt (Collision h2 ps) =
      if h /= h2 then sprouted s h key (f Nothing) h2 (Collision h2 ps)
      else pairsGrown h2 (List.length ps) (pairsAltered eq f key ps)
    alteredAt node = MkPair node 0

-- (each key and its value in a trie, from `z`)
foldlTrie : {k v b : Type} -> (b -> k -> v -> b) -> b -> Trie k v -> b
foldlTrie f z Vacant = z
foldlTrie f z (Leaf h k v) = f z k v
foldlTrie f z (Collision h ps) =
  List.foldl (\acc p -> f acc (fst p) (snd p)) z ps
foldlTrie f z (Branch bm children) =
  Array.foldl (\acc c -> foldlTrie f acc c) z children

-- | Each key and its value, from `z`, in the trie's order (the hashes').
foldl : {k v b : Type} -> (b -> k -> v -> b) -> b -> HashMap k v -> b
foldl f z (MkHashMap n t) = foldlTrie f z t

-- | How many keys are bound: kept as they are bound and deleted, not
-- | counted.
size : {k v : Type} -> HashMap k v -> Int
size (MkHashMap n t) = n

-- | The keys and their values, in the trie's order (the hashes', not the
-- | keys'): sort them for another.
toList : {k v : Type} -> HashMap k v -> List (Pair k v)
toList m = foldl (\acc k v -> MkPair k v :: acc) Nil m

-- | Whether `k` is bound in it.
-- | >>> List.map (member (insert (empty : HashMap String Int) "a" 1)) ["a", "b"]
-- | Cons True (Cons False Nil)
member : {k v : Type}
       -> {{hashing : Hash k}}
       -> {{equality : Equality k}}
       -> HashMap k v
       -> k
       -> Bool
member m k = case lookup m k of
  Just _ -> True
  Nothing -> False

-- | The keys, in `toList`'s order.
-- | >>> keys (insert (empty : HashMap String Int) "a" 1)
-- | Cons "a" Nil
keys : {k v : Type} -> HashMap k v -> List k
keys m = List.map (\(p : Pair k v) -> fst p) (toList m)

-- | The values, in `toList`'s order.
-- | >>> values (insert (empty : HashMap String Int) "a" 1)
-- | Cons 1 Nil
values : {k v : Type} -> HashMap k v -> List v
values m = List.map (\(p : Pair k v) -> snd p) (toList m)

-- | A hash map, each key and its value in the trie's order, as `toList`
-- | has them: `for p in m` goes through that list.
instance instanceIterateHashMap : {k v : Type} -> Iterate (HashMap k v)
instanceIterateHashMap =
  { Elem = Pair k v, Cursor = List (Pair k v), start = toList, next = step }
  where
  step : List (Pair k v) -> Maybe (Pair (Pair k v) (List (Pair k v)))
  step [] = Nothing
  step (p :: ps) = Just (MkPair p ps)

-- | The map of the pairs, a later one's value for a key twice.
-- | >>> lookup (fromList [MkPair "a" 1, MkPair "b" 2]) "b"
-- | Just 2
-- | >>> lookup (fromList [MkPair "a" 1, MkPair "b" 2]) "c"
-- | Nothing
-- | >>> lookup (insert (fromList [MkPair 2 "deux"]) 2 "two") 2
-- | Just "two"
-- | >>> size (fromList [MkPair "a" 1, MkPair "b" 2, MkPair "a" 3])
-- | 2
-- | >>> foldl (\n k v -> n + k * v) 0 (fromList [MkPair 2 3, MkPair 4 5])
-- | 26
-- | >>> List.sortOn (\p -> fst p) (toList (fromList [MkPair "b" 2, MkPair "a" 1]))
-- | Cons (MkPair "a" 1) (Cons (MkPair "b" 2) Nil)
-- | >>> toList (update (fromList [MkPair "a" 2]) "a" 1 (\new old -> new + old))
-- | Cons (MkPair "a" 3) Nil
-- | >>> lookup (update (fromList [MkPair "a" 2]) "b" 5 (\new old -> new + old)) "b"
-- | Just 5
-- | >>> toList (delete (fromList [MkPair "a" 1, MkPair "b" 2]) "a")
-- | Cons (MkPair "b" 2) Nil
-- | >>> size (delete (fromList [MkPair 1 "one"]) 7)
-- | 1
-- | >>> size (delete (fromList [MkPair 1 "one", MkPair 2 "two"]) 1)
-- | 1
-- | >>> fst (remove (fromList [MkPair "a" 1, MkPair "b" 2]) "a")
-- | Just 1
-- | >>> fst (remove (insert (empty : HashMap String Int) "a" 1) "c")
-- | Nothing
-- | >>> toList (snd (remove (fromList [MkPair "a" 1, MkPair "b" 2]) "a"))
-- | Cons (MkPair "b" 2) Nil
-- | >>> size (alter (fromList [MkPair 1 "one"]) 2 (\old -> Just "two"))
-- | 2
-- | >>> toList (alter (fromList [MkPair "a" 2]) "a" (\old -> Just (maybe 1 (\n -> n + 1) old)))
-- | Cons (MkPair "a" 3) Nil
-- | >>> toList (alter (fromList [MkPair 1 "one"]) 1 (\old -> Nothing))
-- | Nil
-- | >>> lookup (alter (fromList [MkPair 1 "one"]) 3 (\old -> Just "three")) 3
-- | Just "three"
fromList : {k v : Type}
         -> {{hashing : Hash k}}
         -> {{equality : Equality k}}
         -> List (Pair k v)
         -> HashMap k v
fromList ps = List.foldl (\m p -> insert m (fst p) (snd p)) empty ps

-- Keys looked up by a view of them (`KeyView`): each walk as `update`'s
-- and `lookup`'s, the view matched against the keys, and the key made of
-- it only where it is new.

-- (the pairs of one hash, the key `query` stands for bound to `value`
-- or to `f value old`)
pairsWithBy : {k v q : Type}
            -> (k -> q -> Bool)
            -> (q -> k)
            -> (v -> v -> v)
            -> q
            -> v
            -> List (Pair k v)
            -> List (Pair k v)
pairsWithBy matching keyed f query value [] = [MkPair (keyed query) value]
pairsWithBy matching keyed f query value (MkPair k2 v2 :: rest) =
  if matching k2 query then MkPair k2 (f value v2) :: rest
  else MkPair k2 v2 :: pairsWithBy matching keyed f query value rest

-- | `update` of the key a view stands for (`KeyView`): the key made of
-- | it only where it is new to the map, so that counting the parts of a
-- | string (`slice`), most of them there already, makes no string for
-- | those.
-- | >>> lookup (updateBy (fromList [MkPair "ab" 1]) (slice "xaby" 1 3) 5 (\new old -> new + old)) "ab"
-- | Just 6
-- | >>> toList (updateBy (empty : HashMap String Int) (slice "xaby" 1 3) 5 (\new old -> new + old))
-- | Cons (MkPair "ab" 5) Nil
updateBy : {k v q : Type}
         -> {{view : KeyView k q}}
         -> HashMap k v
         -> q
         -> v
         -> (v -> v -> v)
         -> HashMap k v
updateBy (MkHashMap n t) query value f =
  let walked : Walked k v Int =
    insertByAt view.matches view.keyOf (view.hashOf query) 0 t Array.empty
  in (case walked of
      MkWalked changed d _ -> MkHashMap (n + d) changed)
  where
  -- (`updateBy` at a node `s` bits down, `holed` handed down and back as
  -- `insertAt`'s)
  insertByAt : (k -> q -> Bool)
             -> (q -> k)
             -> Int
             -> Int
             -> Trie k v
             -> Array (Trie k v)
             -> Walked k v Int
  insertByAt matching keyed h s (Branch bm children) holed =
    let j = trieSlot bm h s
    in if j < 0
    then MkWalked
        (Branch
           (or bm (bitAt h s))
           (childAdded children (-1 - j) (Leaf h (keyed query) value)))
        1
        holed
    else (let child = arrayIndex children j
          in let walked : Walked k v Int =
            insertByAt
              matching
              keyed
              h
              (s + 5)
              child
              (arraySet children j Vacant)
          in (case walked of
              MkWalked changed d rest ->
                MkWalked (Branch bm (arraySet rest j changed)) d holed))
  insertByAt matching keyed h s node holed = case putByAt node of
    MkPair changed d -> MkWalked changed d holed
    where
    -- (`updateBy` at a node `s` bits down, but a branch)
    putByAt : Trie k v -> Pair (Trie k v) Int
    putByAt Vacant = MkPair (Leaf h (keyed query) value) 1
    putByAt (Leaf h2 k2 v2) =
      if h /= h2
      then MkPair (joined s h (Leaf h (keyed query) value) h2 (Leaf h2 k2 v2)) 1
      else if matching k2 query then MkPair (Leaf h2 k2 (f value v2)) 0
      else MkPair (Collision h2 [MkPair (keyed query) value, MkPair k2 v2]) 1
    putByAt (Collision h2 ps) =
      if h /= h2
      then MkPair
          (joined s h (Leaf h (keyed query) value) h2 (Collision h2 ps))
          1
      else pairsGrown
          h2
          (List.length ps)
          (pairsWithBy matching keyed f query value ps)
    putByAt node = MkPair node 0

-- (the value of the key `query` stands for among the pairs of one hash)
pairsLookupBy : {k v q : Type}
              -> (k -> q -> Bool)
              -> q
              -> List (Pair k v)
              -> Maybe v
pairsLookupBy matching query [] = Nothing
pairsLookupBy matching query (MkPair k2 v2 :: rest) =
  if matching k2 query then Just v2 else pairsLookupBy matching query rest

-- | `lookup` of the key a view stands for (`KeyView`), no key made.
-- | >>> lookupBy (fromList [MkPair "ab" 1]) (slice "xaby" 1 3)
-- | Just 1
-- | >>> lookupBy (fromList [MkPair "ab" 1]) (slice "xaby" 1 2)
-- | Nothing
lookupBy : {k v q : Type}
         -> {{view : KeyView k q}}
         -> HashMap k v
         -> q
         -> Maybe v
lookupBy m query = lookupByAt view.matches (view.hashOf query) 0 (trieOf m)
  where
  lookupByAt : (k -> q -> Bool) -> Int -> Int -> Trie k v -> Maybe v
  lookupByAt matching h s Vacant = Nothing
  lookupByAt matching h s (Leaf h2 k2 v2) =
    if h == h2 && matching k2 query then Just v2 else Nothing
  lookupByAt matching h s (Collision h2 ps) =
    if h == h2 then pairsLookupBy matching query ps else Nothing
  lookupByAt matching h s (Branch bm children) =
    let i = trieSlot bm h s
    in if i < 0 then Nothing
    else lookupByAt matching h (s + 5) (arrayIndex children i)
