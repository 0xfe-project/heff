-- A store: one value, of a shape the program declares
-- (`(Int, Int, List String)`), and positions in it.  A position
-- (`Position s a`, an `a` in an `s`) is how it is read and how it is
-- written, and which parts of the store those are, so that two
-- positions can be told apart where they share none.  std.stm's
-- transactional variables and std.boc's cowns are positions; and green
-- threads sharing a state run here, in the language (`greenWith`).
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import std.store
--
-- type Bank = (Int, Int, List String)
--
-- -- | `(5, 7, ["paid"])`
-- moved : Bank
-- moved = replaced (both first second) (5, 7) (0, 0, ["paid"])
-- ```
--
-- A position is a part of the store, made from its pairs: `whole`,
-- `fstOf` and `sndOf`; a pair's `left` and `right`; a triple's `first`,
-- `second` and `third` (`(a, b, c)` is `((a, b), c)`).  Two positions
-- side by side, `both p q`, are one of the pair of what they hold.  A
-- position fits every store of its shape, so a program names its own,
-- at its store's type, and a position of one store is not another's:
-- the types say so.

module std.store
  ( Position
  , Part
  , whole
  , fstOf
  , sndOf
  , left
  , right
  , first
  , second
  , third
  , both
  , contents
  , replaced
  , parts
  , overlaps
  , enclosing
  , instanceEqualityPart
  , instanceOrderPart
  , greenWith
  )

import co
import green
import state

-- Positions
--------------------------------------------------------------------------------

-- (a step into a pair)
data Side = Fst | Snd

-- | A part of a store: the steps into its pairs that reach it, from the
-- | whole (and, as a number, for a part of 61 steps or fewer, the steps
-- | as bits after a 1, so that parts are told apart quickly; else 0).
data Part = MkPart Int (List Side)

-- (a step's place in the order: the first before the second)
sideRank : Side -> Int
sideRank Fst = 0
sideRank Snd = 1

-- (the number of a part a step further, `code` the part's: 0 past 61
-- steps)
stepCode : Int -> Side -> Int
stepCode code s =
  if code <= 0 || code >= 1152921504606846976 then 0 else code * 2 + sideRank s

-- (the part the steps reach)
partOf : List Side -> Part
partOf steps = MkPart (List.foldl stepCode 1 steps) steps

-- (where a position's value is: at a part, or a pair of two places)
data Place = At (List Side) | Both Place Place

-- | A position in a store of shape `s` holding an `a`: where it is, how
-- | it is read and how it is written.
data Position s a = MkPosition Place (s -> a) (a -> s -> s)

-- (the place of its first component, and of its second)
fstPlace : Place -> Place
fstPlace (At steps) = At (steps ++ [Fst])
fstPlace (Both l r) = l

sndPlace : Place -> Place
sndPlace (At steps) = At (steps ++ [Snd])
sndPlace (Both l r) = r

-- | The whole store.
whole : {s : Type} -> Position s s
whole = MkPosition (At Nil) (\st -> st) (\v st -> v)

-- | The first part of the pair at `p`.
fstOf : {s a b : Type} -> Position s (a, b) -> Position s a
fstOf (MkPosition place get set) =
  MkPosition
    (fstPlace place)
    (\st -> fst (get st))
    (\v st -> set (v, snd (get st)) st)

-- | ... its second part.
sndOf : {s a b : Type} -> Position s (a, b) -> Position s b
sndOf (MkPosition place get set) =
  MkPosition
    (sndPlace place)
    (\st -> snd (get st))
    (\v st -> set (fst (get st), v) st)

-- | A pair's first component.
left : {a b : Type} -> Position (a, b) a
left = fstOf whole

-- | ... its second.
right : {a b : Type} -> Position (a, b) b
right = sndOf whole

-- | A triple's first component.
first : {a b c : Type} -> Position (a, b, c) a
first = fstOf (fstOf whole)

-- | ... its second.
second : {a b c : Type} -> Position (a, b, c) b
second = sndOf (fstOf whole)

-- | ... its third.
third : {a b c : Type} -> Position (a, b, c) c
third = sndOf whole

-- | Both, side by side: the pair of what they hold, written the first's
-- | first.  (Of two that overlap, what the second writes is kept.)
both : {s a b : Type} -> Position s a -> Position s b -> Position s (a, b)
both (MkPosition pa geta seta) (MkPosition pb getb setb) =
  MkPosition
    (Both pa pb)
    (\st -> (geta st, getb st))
    (\v st -> setb (snd v) (seta (fst v) st))

-- | What the position holds in the store `st`.
contents : {s a : Type} -> Position s a -> s -> a
contents (MkPosition place get set) st = get st

-- | ... the store, the position holding `v` now.
replaced : {s a : Type} -> Position s a -> a -> s -> s
replaced (MkPosition place get set) v st = set v st

-- (the parts of a place)
placeParts : Place -> List Part
placeParts (At steps) = [partOf steps]
placeParts (Both l r) = placeParts l ++ placeParts r

-- | The parts of the store the position is made of: one, or one for
-- | each position `both` put side by side.
parts : {s a : Type} -> Position s a -> List Part
parts (MkPosition place get set) = placeParts place

-- (the same step)
sameSide : Side -> Side -> Bool
sameSide Fst Fst = True
sameSide Snd Snd = True
sameSide a b = False

-- (the first steps the start of the second)
startOf : List Side -> List Side -> Bool
startOf Nil steps = True
startOf (a :: rest) Nil = False
startOf (a :: rest) (b :: others) = sameSide a b && startOf rest others

-- | Do the two parts share any of the store: the same, or one inside
-- | the other.
overlaps : Part -> Part -> Bool
overlaps (MkPart c p) (MkPart d q) = startOf p q || startOf q p

-- (the parts the steps go through, from the whole, before they reach
-- their own, `taken` those taken so far, the part they reach `code`)
throughFrom : Int -> List Side -> List Side -> List Part
throughFrom code taken Nil = Nil
throughFrom code taken (s :: rest) =
  MkPart code taken :: throughFrom (stepCode code s) (taken ++ [s]) rest

-- | The parts the part is inside, from the whole on: those it overlaps
-- | other than itself and the parts inside it.
enclosing : Part -> List Part
enclosing (MkPart code steps) = throughFrom 1 Nil steps

-- (two parts' steps in order, the first that differ; a part before those
-- inside it)
compareSteps : List Side -> List Side -> Ordering
compareSteps Nil Nil = EQ
compareSteps Nil others = LT
compareSteps steps Nil = GT
compareSteps (a :: rest) (b :: others) =
  if sideRank a == sideRank b then compareSteps rest others
  else compare (sideRank a) (sideRank b)

-- (the order of parts: by their numbers, those past 61 steps after, by
-- their steps)
compareParts : Part -> Part -> Ordering
compareParts (MkPart c p) (MkPart d q) =
  if c > 0 && d > 0 then compare c d
  else if c > 0 then LT
  else if d > 0 then GT
  else compareSteps p q

-- (the same steps)
sameSteps : List Side -> List Side -> Bool
sameSteps Nil Nil = True
sameSteps (a :: rest) (b :: others) = sameSide a b && sameSteps rest others
sameSteps steps others = False

-- | Two parts the same: the same steps from the whole.
instance instanceEqualityPart : Equality Part
instanceEqualityPart =
  { equal = \p q -> case (p, q) of
      (MkPart c a, MkPart d b) ->
        if c > 0 || d > 0 then c == d else sameSteps a b
  }

-- | Parts in an order, so that a part is a key (std.ordmap's).
instance instanceOrderPart : Order Part
instanceOrderPart = orderByCompare compareParts

-- Green threads sharing a state
--------------------------------------------------------------------------------

-- (no other effect: what a computation of none comes to)
data NoneF (m : Type -> Type) x = NoneOf (NoneF m x)

none : HFunctor
none =
  { f = NoneF
  , hfmap = \m g p -> case p of
      NoneOf q -> abandon
  , hmap = \m n nt p -> case p of
      NoneOf q -> abandon
  }

noneAlg : {x : Type} -> NoneF (\y -> y) x -> x
noneAlg (NoneOf q) = noneAlg q

ranAlone : Handler none
ranAlone =
  { M = \x -> x
  , ret = \x -> x
  , bind = \m k -> k m
  , malg = \p -> noneAlg p
  }

-- | `c` and the green threads it spawns, scheduled sharing the state
-- | `st` and nothing else, in the language: main's answer, or `Nothing`
-- | where every thread waits; and the state they leave.
greenWith : {x a : Type}
          -> x
          -> ({e : HFunctor}
              -> {{gr : green <: e}}
              -> {{st : state x <: e}}
              -> Co e a)
          -> (Maybe a, x)
greenWith st c =
  handle
    ranAlone
    (runState
       st
       (scheduled
          (c (gr := _) (st := _))))
