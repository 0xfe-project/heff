-- Times of day, to the nanosecond, with no date and no zone: a time on
-- a clock on the wall, 15:04:05, which is no instant, as it comes every
-- day, at a different one in each place.  NodaTime's `LocalTime` is the
-- model.  A day here has 24 hours of 60 minutes of 60 seconds -- no leap
-- second -- from midnight, 00:00:00, to 23:59:59.999999999.  A date
-- (std.localdate) and a time of day make a std.localdatetime; a length
-- of time is std.duration's, and std.period's `addToTime` moves a time
-- round the clock.  Import it by a name,
-- `import std.localtime as LocalTime`, as its names are short.
--
-- ```haskell
-- import std.localtime as LocalTime
--
-- -- | whether the time is in the afternoon or the evening
-- -- | >>> maybe False afterNoon (LocalTime.parse "15:04:05")
-- -- | True
-- afterNoon : LocalTime.LocalTime -> Bool
-- afterNoon t = t >= LocalTime.noon
-- ```

module std.localtime
  ( LocalTime
  , make
  , withNanosecond
  , midnight
  , noon
  , hour
  , minute
  , second
  , nanosecond
  , nanosecondOfDay
  , fromNanosecondOfDay
  , parse
  , instanceEqualityLocalTime
  , instanceOrderLocalTime
  , instanceDebugLocalTime
  , instanceShowLocalTime
  )

-- | A time of day: the nanoseconds from midnight to it, 0 to
-- | 86399999999999.
data LocalTime = MkLocalTime Int

-- (the nanoseconds of a second)
nanosecondsPerSecond : Int
nanosecondsPerSecond = 1000000000

-- | The time of the hour 0 to 23, the minute 0 to 59 and the second 0 to
-- | 59, on the second; nothing if one is out of its range.
-- | >>> make 15 4 5
-- | Just (MkLocalTime 54245000000000)
-- | >>> (List.map (\t -> maybe True (\_ -> False) t) [make 24 0 0, make 0 60 0, make 0 0 60, make (-1) 0 0, make 0 (-1) 0] : List Bool)
-- | [True, True, True, True, True]
make : Int -> Int -> Int -> Maybe LocalTime
make h m s =
  if h < 0 || h > 23 || m < 0 || m > 59 || s < 0 || s > 59 then Nothing
  else Just (MkLocalTime ((h * 3600 + m * 60 + s) * nanosecondsPerSecond))

-- | Its hour, 0 to 23.
hour : LocalTime -> Int
hour (MkLocalTime n) = n / 3600000000000

-- | Its minute of the hour, 0 to 59.
minute : LocalTime -> Int
minute (MkLocalTime n) = n / 60000000000 % 60

-- | Its second of the minute, 0 to 59.
second : LocalTime -> Int
second (MkLocalTime n) = n / nanosecondsPerSecond % 60

-- | Its nanosecond of the second, 0 to 999999999.
nanosecond : LocalTime -> Int
nanosecond (MkLocalTime n) = n % nanosecondsPerSecond

-- | The nanoseconds from midnight to it, 0 to 86399999999999.
nanosecondOfDay : LocalTime -> Int
nanosecondOfDay (MkLocalTime n) = n

-- | The same time with its nanosecond of the second `n`, 0 to 999999999;
-- | nothing for one out of that range.
-- | >>> maybe Nothing (\t -> withNanosecond t 500000000) (make 15 4 5)
-- | Just (MkLocalTime 54245500000000)
-- | >>> maybe Nothing (\t -> withNanosecond t 1000000000) (make 15 4 5)
-- | Nothing
withNanosecond : LocalTime -> Int -> Maybe LocalTime
withNanosecond t n =
  if n < 0 || n >= nanosecondsPerSecond then Nothing
  else Just (MkLocalTime (nanosecondOfDay t - nanosecond t + n))

-- | 00:00:00, the start of the day.
midnight : LocalTime
midnight = MkLocalTime 0

-- | 12:00:00.
noon : LocalTime
noon = MkLocalTime 43200000000000

-- | The time `n` nanoseconds after midnight, if it is in the day, 0 to
-- | 86399999999999; nothing if not.
-- | >>> List.map fromNanosecondOfDay [0, 86399999999999, 86400000000000, -1]
-- | [Just (MkLocalTime 0), Just (MkLocalTime 86399999999999), Nothing, Nothing]
fromNanosecondOfDay : Int -> Maybe LocalTime
fromNanosecondOfDay n =
  if n < 0 || n >= nanosecondsPerDay then Nothing else Just (MkLocalTime n)
  where
  -- (the nanoseconds of a day of 24 hours)
  nanosecondsPerDay : Int
  nanosecondsPerDay = 86400000000000

-- Instances: the prelude's operators and functions at `LocalTime`
--------------------------------------------------------------------------------

-- | The same time.
instance instanceEqualityLocalTime : Equality LocalTime
instanceEqualityLocalTime =
  { equal = \x y -> nanosecondOfDay x == nanosecondOfDay y }

-- | The earlier in the day first.
-- | >>> midnight < noon && Just noon < make 12 0 1
-- | True
instance instanceOrderLocalTime : Order LocalTime
instanceOrderLocalTime =
  orderByCompare (\x y -> compare (nanosecondOfDay x) (nanosecondOfDay y))

-- (the time as ISO 8601 writes it, its fraction only if it has one)
isoText : LocalTime -> String
isoText t =
  padded 2 (hour t)
  ^ ":"
  ^ padded 2 (minute t)
  ^ ":"
  ^ padded 2 (second t)
  ^ (if nanosecond t == 0 then ""
     else "." ^ withoutTrailingZeros (padded 9 (nanosecond t)))
  where
  -- (`n`, at least 0, in decimal, with `0`s before it to `width` digits)
  padded : Int -> Int -> String
  padded width n =
    joinWith "" (List.replicate (width - strLength (showInt n)) "0") ^ showInt n

  -- (`s` without the `0`s it ends with)
  withoutTrailingZeros : String -> String
  withoutTrailingZeros s =
    if strLength s > 0 && strByteAt s (strLength s - 1) == 48
    then withoutTrailingZeros (strSlice s 0 (strLength s - 1))
    else s

-- | As `show` writes it, `15:04:05`, as NodaTime's and Rust's
-- | chrono's debug form is.
-- | >>> debug noon
-- | "12:00:00"
instance instanceDebugLocalTime : Debug LocalTime
instanceDebugLocalTime = { debug = isoText }

-- | As ISO 8601 writes it, `15:04:05`, and a fraction of the second only
-- | where there is one, without the `0`s it ends with, as Go's
-- | `RFC3339Nano` writes it.
-- | >>> List.map (\n -> maybe "" show (fromNanosecondOfDay n)) [0, 54245000000000, 54245500000000, 54245000000001, 86399999999999]
-- | ["00:00:00", "15:04:05", "15:04:05.5", "15:04:05.000000001", "23:59:59.999999999"]
instance instanceShowLocalTime : Show LocalTime
instanceShowLocalTime = { show = isoText }

-- | The time ISO 8601 writes as `s`, extended: `15:04:05`, each field in
-- | 2 digits, and perhaps a fraction of the second after a `.`, of 1 to
-- | 9 digits (`15:04:05.1`).  Nothing if it writes none, or a field is
-- | out of its range (the hour 24, the second 60: no leap second).
-- | >>> List.map (\s -> maybe "" show (parse s)) ["15:04:05", "15:04:05.1", "00:00:00.000000001", "23:59:59.999999999", "12:00:00.500"]
-- | ["15:04:05", "15:04:05.1", "00:00:00.000000001", "23:59:59.999999999", "12:00:00.5"]
-- | >>> (List.map (\s -> maybe True (\_ -> False) (parse s)) ["24:00:00", "12:60:00", "12:00:60", "12:00", "1:00:00", "12:00:00.", "12:00:00.1234567890", "12:00:00Z", "12-00-00", "12:00:00.1a", ""] : List Bool)
-- | [True, True, True, True, True, True, True, True, True, True, True]
-- | >>> List.all (\n -> maybe False (\t -> parse (show t) == Just t) (fromNanosecondOfDay n)) [0, 1, 54245500000000, 86399999999999]
-- | True
parse : String -> Maybe LocalTime
parse s =
  if strLength s < 8
     || not (strEq (strSlice s 2 3) ":")
     || not (strEq (strSlice s 5 6) ":")
     || strLength s > 8 && not (strEq (strSlice s 8 9) ".")
  then Nothing
  else (case digitsIn s 0 2 of
        Nothing -> Nothing
        Just h ->
          (case digitsIn s 3 5 of
           Nothing -> Nothing
           Just m ->
             (case digitsIn s 6 8 of
              Nothing -> Nothing
              Just sec ->
                (case make h m sec of
                 Nothing -> Nothing
                 Just whole ->
                   if strLength s == 8 then Just whole
                   else (case fractionIn (strSlice s 9 (strLength s)) of
                         Nothing -> Nothing
                         Just n -> withNanosecond whole n)))))
  where
  -- (the decimal the bytes of `text` from `from` to `to` are, if there
  -- is one of them and they are all digits)
  digitsIn : String -> Int -> Int -> Maybe Int
  digitsIn text from to =
    if from >= to then Nothing
    else if foldBytes
              (\ok c -> ok && 48 <= c && c <= 57)
              True
              (strSlice text from to)
    then parseInt (strSlice text from to)
    else Nothing

  -- (the nanoseconds a fraction of a second is, written as `digits`
  -- after its `.`: 1 to 9 digits; nothing if not)
  fractionIn : String -> Maybe Int
  fractionIn digits =
    if strLength digits > 9 then Nothing
    else (case digitsIn digits 0 (strLength digits) of
          Nothing -> Nothing
          Just value ->
            Just
              (value * List.product (List.replicate (9 - strLength digits) 10)))
