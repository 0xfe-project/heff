-- Hexadecimal (RFC 4648's base16): bytes written as text, each as two
-- digits of 16, `0`-`9` and `a`-`f`, the high four bits first, as Go's
-- `encoding/hex` writes them.  `encode` writes the letters in lower case;
-- `decode` reads either case, and gives `Nothing` where the text is an
-- odd number of digits long or has anything but digits.  Import it by a
-- name, `import std.hex as Hex`.
--
-- ```haskell
-- import bytes as Bytes
-- import std.hex as Hex
--
-- -- | >>> dump
-- -- | "4869ff"
-- dump : String
-- dump = Hex.encode b["Hi", 255]
-- ```

module std.hex (encode, decode)

import bytes as Bytes

-- | The bytes, two digits each, the letters in lower case.  RFC 4648's
-- | examples:
-- | >>> List.map (\s -> encode (Bytes.fromString s)) ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
-- | ["", "66", "666f", "666f6f", "666f6f62", "666f6f6261", "666f6f626172"]
-- | >>> encode b[0, 1, 15, 16, 127, 128, 254, 255]
-- | "00010f107f80feff"
encode : Bytes -> String
encode b = encodeFrom (Bytes.asString b) 0 ""
  where
  -- (the digit of `n`, 0 to 15, its letter in lower case)
  digitOf : Int -> String
  digitOf n = strSlice "0123456789abcdef" n (n + 1)
  -- (`acc`, then the bytes of `s` from `i` on, two digits each)
  encodeFrom : String -> Int -> String -> String
  encodeFrom s i acc =
    if i >= strLength s then acc
    else encodeFrom
        s
        (i + 1)
        (acc ^ digitOf (byteAt s i / 16) ^ digitOf (byteAt s i % 16))

-- | The bytes the digits are, their letters in either case: `Nothing`
-- | where there is an odd number of them, or anything but digits.
-- | >>> List.map decode ["", "66", "666F6f", "666f6f626172"]
-- | [Just b[], Just b["f"], Just b["foo"], Just b["foobar"]]
-- | >>> decode "00010F107f80FEff"
-- | Just b[0, 1, 15, 16, 127, 128, 254, 255]
-- |
-- | (an odd number of digits, what is not a digit, white space)
-- | >>> List.map decode ["6", "666", "6g", "zz", "66 6f", "66\n", "0x66"]
-- | [Nothing, Nothing, Nothing, Nothing, Nothing, Nothing, Nothing]
decode : String -> Maybe Bytes
decode s =
  if strLength s % 2 /= 0 then Nothing
  else maybe Nothing (\t -> Just (Bytes.fromString t)) (decodeFrom 0 "")
  where
  -- (the value of the byte `c` as a digit, 0 to 15, its letter in either
  -- case; -1 where it is none)
  digitValue : Int -> Int
  digitValue c =
    if 48 <= c && c <= 57 then c - 48
    else if 97 <= c && c <= 102 then c - 87
    else if 65 <= c && c <= 70 then c - 55
    else 0 - 1
  -- (`acc`, then the bytes of the digits of `s` from `i` on, two at a
  -- time, its length even; `Nothing` where one is not a digit)
  decodeFrom : Int -> String -> Maybe String
  decodeFrom i acc =
    let high : Int = digitValue (byteAt s i)
    in let low : Int = digitValue (byteAt s (i + 1))
    in if i >= strLength s then Just acc
    else if high < 0 || low < 0 then Nothing
    else decodeFrom (i + 2) (acc ^ byteString (high * 16 + low))
