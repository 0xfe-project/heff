-- CRC-32, the checksum of IEEE 802.3 that zlib, gzip, zip and PNG keep:
-- the bytes' remainder by the polynomial 0x04c11db7, its bits reflected
-- (0xedb88320), begun at and inverted by 0xffffffff -- Go's
-- `crc32.ChecksumIEEE`.  It finds bytes changed by accident, not on
-- purpose: anyone can make bytes of a given CRC.  Written in heff, a
-- byte at a time by a table of 256.
--
-- ```haskell
-- import bytes as Bytes
-- import std.crc32 as CRC32
--
-- -- | whether a zip entry's content is what its header says it was
-- unchanged : Bytes -> UInt32 -> Bool
-- unchanged content recorded = CRC32.checksum content == recorded
-- ```

module std.crc32 (checksum)

import array as Array
import bytes as Bytes
import uint32 as UInt32
import uint8 as UInt8

-- | The CRC-32 of the bytes: of "123456789", 0xcbf43926.
-- | >>> checksum (Bytes.fromString "123456789")
-- | 3421780262
-- | >>> checksum (Bytes.fromString "123456789") == 0xcbf43926
-- | True
-- | >>> checksum Bytes.empty
-- | 0
-- | >>> checksum (Bytes.fromString "The quick brown fox jumps over the lazy dog") == 0x414fa339
-- | True
checksum : Bytes -> UInt32
checksum m = complement (checkedFrom 0 0xffffffff)
  where
  -- (the remainder `c` after `k` more of its bits are divided by the
  -- reflected polynomial, the lowest first)
  divided : UInt32 -> Int -> UInt32
  divided c k =
    if k == 0 then c
    else if and c 1 == 1 then divided (xor (shiftR c 1) 0xedb88320) (k - 1)
    else divided (shiftR c 1) (k - 1)
  -- (the remainder of each byte's eight bits)
  table : Array UInt32
  table = Array.generate 256 (\n -> divided (UInt32.fromInt n) 8)
  -- (the remainder `c`, not yet inverted, after the bytes of `m` from `i`
  -- on)
  checkedFrom : Int -> UInt32 -> UInt32
  checkedFrom i c =
    if i >= Bytes.length m then c
    else let byte : UInt32 = UInt32.fromInt (UInt8.toInt (Bytes.bytesAt m i))
         in checkedFrom
           (i + 1)
           (xor
              (Array.arrayIndex table (UInt32.toInt (and (xor c byte) 255)))
              (shiftR c 8))
