-- MD5, the hash of RFC 1321: any bytes to 16 bytes.  It is broken (bytes
-- of the same MD5 are made at will): it is here for what still names or
-- checks things by it, not to tell bytes that may have been made to
-- collide apart -- that is `std.sha256`'s.  Written in heff, a block of
-- 64 bytes at a time.
--
-- ```haskell
-- import bytes as Bytes
-- import std.md5 as MD5
--
-- -- | whether a download is what its published MD5 says
-- intact : Bytes -> Bytes -> Bool
-- intact content published = MD5.digest content == published
-- ```

module std.md5 (digest)

import array as Array
import bytes as Bytes
import uint32 as UInt32
import uint8 as UInt8

-- | The MD5 hash of the bytes, 16 bytes.
-- | >>> digest Bytes.empty == b[0xd41d8cd98f00b204::64, 0xe9800998ecf8427e::64]
-- | True
-- | >>> digest (Bytes.fromString "a") == b[0x0cc175b9c0f1b6a8::64, 0x31c399e269772661::64]
-- | True
-- | >>> digest (Bytes.fromString "abc") == b[0x900150983cd24fb0::64, 0xd6963f7d28e17f72::64]
-- | True
-- | >>> digest (Bytes.fromString "message digest") == b[0xf96b697d7cb7938d::64, 0x525a2f31aaf161d0::64]
-- | True
-- | >>> digest (Bytes.fromString "abcdefghijklmnopqrstuvwxyz") == b[0xc3fcd3d76192e400::64, 0x7dfb496cca67e13b::64]
-- | True
-- | >>> digest (Bytes.fromString "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789") == b[0xd174ab98d277d9f5::64, 0xa5611c2c9f419d9f::64]
-- | True
-- | >>> digest (Bytes.fromString "12345678901234567890123456789012345678901234567890123456789012345678901234567890") == b[0x57edf4a22be3c955::64, 0xac49da2e2107b67a::64]
-- | True
digest : Bytes -> Bytes
digest m =
  let hs : Array UInt32 =
    blocksFrom
      padded
      0
      (Array.fromList [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476])
  in Bytes.concat
    (List.map (\x -> b[UInt32.toInt x::32-little]) (Array.toList hs))
  where
  -- (the bytes padded to whole blocks: a 1 bit, zeros, then their length
  -- in bits, 64 bits little-endian)
  padded : Bytes
  padded =
    let n : Int = Bytes.length m
    in Bytes.concat
      [ m
      , b[0x80]
      , Bytes.fromList (List.replicate ((55 - n) % 64) 0)
      , b[(n * 8)::64-little]
      ]
  -- (the hash `hs` after the blocks of `m` from `at` on)
  blocksFrom : Bytes -> Int -> Array UInt32 -> Array UInt32
  blocksFrom m at hs =
    if at >= Bytes.length m then hs
    else blocksFrom
        m
        (at + 64)
        (rounds
           0
           (Array.arrayIndex hs 0)
           (Array.arrayIndex hs 1)
           (Array.arrayIndex hs 2)
           (Array.arrayIndex hs 3))
    where
    -- (the first 32 bits of the absolute value of the sine of each of 1 to
    -- 64, a round's constant each)
    roundConstants : Array UInt32
    roundConstants =
      Array.fromList
        [ 0xd76aa478
        , 0xe8c7b756
        , 0x242070db
        , 0xc1bdceee
        , 0xf57c0faf
        , 0x4787c62a
        , 0xa8304613
        , 0xfd469501
        , 0x698098d8
        , 0x8b44f7af
        , 0xffff5bb1
        , 0x895cd7be
        , 0x6b901122
        , 0xfd987193
        , 0xa679438e
        , 0x49b40821
        , 0xf61e2562
        , 0xc040b340
        , 0x265e5a51
        , 0xe9b6c7aa
        , 0xd62f105d
        , 0x02441453
        , 0xd8a1e681
        , 0xe7d3fbc8
        , 0x21e1cde6
        , 0xc33707d6
        , 0xf4d50d87
        , 0x455a14ed
        , 0xa9e3e905
        , 0xfcefa3f8
        , 0x676f02d9
        , 0x8d2a4c8a
        , 0xfffa3942
        , 0x8771f681
        , 0x6d9d6122
        , 0xfde5380c
        , 0xa4beea44
        , 0x4bdecfa9
        , 0xf6bb4b60
        , 0xbebfbc70
        , 0x289b7ec6
        , 0xeaa127fa
        , 0xd4ef3085
        , 0x04881d05
        , 0xd9d4d039
        , 0xe6db99e5
        , 0x1fa27cf8
        , 0xc4ac5665
        , 0xf4292244
        , 0x432aff97
        , 0xab9423a7
        , 0xfc93a039
        , 0x655b59c3
        , 0x8f0ccc92
        , 0xffeff47d
        , 0x85845dd1
        , 0x6fa87e4f
        , 0xfe2ce6e0
        , 0xa3014314
        , 0x4e0811a1
        , 0xf7537e82
        , 0xbd3af235
        , 0x2ad7d2bb
        , 0xeb86d391
        ]
    -- (how far each round turns its sum left: four to each sixteen rounds,
    -- in turn)
    turns : Array Int
    turns =
      Array.fromList [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21]
    -- (the little-endian word of the four bytes from `i`)
    wordAt : Int -> UInt32
    wordAt i =
      UInt32.fromInt
        (UInt8.toInt (Bytes.bytesAt m i)
         + UInt8.toInt (Bytes.bytesAt m (i + 1)) * 256
         + UInt8.toInt (Bytes.bytesAt m (i + 2)) * 65536
         + UInt8.toInt (Bytes.bytesAt m (i + 3)) * 16777216)
    -- (the rounds from `t` of the working variables `a` to `d` over the
    -- block of `m` at `at`, then each added to the hash `hs` the block began
    -- with)
    rounds : Int -> UInt32 -> UInt32 -> UInt32 -> UInt32 -> Array UInt32
    rounds t a b c d =
      if t >= 64
      then Array.fromList
          [ Array.arrayIndex hs 0 + a
          , Array.arrayIndex hs 1 + b
          , Array.arrayIndex hs 2 + c
          , Array.arrayIndex hs 3 + d
          ]
      else let mixed : UInt32 =
             if t < 16 then or (and b c) (and (complement b) d)
             else if t < 32 then or (and d b) (and (complement d) c)
             else if t < 48 then xor (xor b c) d
             else xor c (or b (complement d))
           in let word : Int =
             if t < 16 then t
             else if t < 32 then (5 * t + 1) % 16
             else if t < 48 then (3 * t + 5) % 16
             else (7 * t) % 16
           in let sum : UInt32 =
             a
             + mixed
             + Array.arrayIndex roundConstants t
             + wordAt (at + 4 * word)
           in rounds
             (t + 1)
             d
             (b
              + UInt32.rotateLeft
                sum
                (Array.arrayIndex turns (t / 16 * 4 + t % 4)))
             b
             c
