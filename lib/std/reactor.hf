-- For outside operations begun now and finished later: what lets a
-- scheduler's threads go on while one of them waits on a socket, a name
-- being resolved or an HTTP request.  The C backend's alone (its
-- provider, and the runtime's reactor): a page's providers do not wait.
-- Import it by a name, `import std.reactor as Reactor`.  A scheduler waits
-- on the world through it -- cml's `scheduledWithReactor` -- and so does a
-- program that starts several operations itself.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import std.reactor as Reactor
-- import std.duration as Duration
-- import std.time as Time
--
-- -- | three sleeps begun at once, waited for together: in about 100 ms
-- slept : {e : HFunctor} -> {{rx : Reactor.reactor <: e}} -> {{tm : Time.time <: e}} -> Co e Int
-- slept = do
--   g <- Reactor.open
--   _ <- Reactor.start g (bind (Time.sleep (Duration.milliseconds 100)) (\u -> pure 1))
--   _ <- Reactor.start g (bind (Time.sleep (Duration.milliseconds 100)) (\u -> pure 2))
--   _ <- Reactor.start g (bind (Time.sleep (Duration.milliseconds 100)) (\u -> pure 3))
--   a <- Reactor.finished g True
--   b <- Reactor.finished g True
--   c <- Reactor.finished g True
--   Reactor.close g
--   pure (List.sum (a ++ b ++ c))
-- ```
--
-- These wait in the reactor, where they are started in a group:
--
-- - std.net's `read`, `write`, `accept` and `withConnection`;
-- - std.filesystem's reads and writes of a pipe, a terminal or a socket;
-- - std.process's `wait`, and reads and writes of a command's pipes;
-- - std.http's requests;
-- - std.time's sleep;
-- - std.signal's `wait`.
--
-- A regular file is read and written at once, the program waiting.
--
-- A group is opened, on a domain; each computation started in it -- one
-- of the world, run there until it is done or until an operation of
-- these would wait, which is then pending, the rest of the computation
-- kept with it -- and the group asked which of those pending are
-- finished, each its computation's value, run to its end once its
-- operation was done.  `finished g True` waits for the first to finish,
-- in one `poll`, or until another domain wakes it (`wake`).  A group
-- within another (`openWithin`) is pending and finishes among the
-- other's, and is closed apart, what is pending in it let go of.  Where
-- no group is being started in, an operation waits where it is, the
-- whole program with it.  Each thread of the system has its own reactor:
-- a group is its domain's, started in, asked and closed there alone, but
-- woken from any.
--
-- A computation is started between a `Begin` and an `End` of its group,
-- in the world's own course, not held by an operation: a handler between
-- the scheduler and the world -- a state -- sees what it does as it sees
-- any other operation, and keeps it.

module std.reactor

import co

-- | A group of computations started, each of which comes to a `t`.
data Group t = MkGroup Int

-- | A computation started come to its end: its value, given to what
-- | comes after its start, whatever it is.
type Ending x = (r : Type) -> ((t : Type) -> t -> (Maybe t -> x) -> r) -> r

-- | What a group's finished are given to, whatever they are.
type Finished x = (r : Type) -> ((t : Type) -> (List t -> x) -> r) -> r

endingWith : {t x : Type} -> t -> (Maybe t -> x) -> Ending x
endingWith v k = \r use -> use t v k

finishedWith : {t x : Type} -> (List t -> x) -> Finished x
finishedWith k = \r use -> use t k

-- (no operation holds a computation: a computation started is run
-- between its `Begin` and its `End`, in the world's own course, so that
-- a handler between the scheduler and the world sees it as it sees any
-- other, what it does there kept)
data ReactorF (m : Type -> Type) x
  = Open (Int -> x)
  | Begin Int (Bool -> x)
  | End Int (Ending x)
  | Finish Int Bool (Finished x)
  | Close Int x
  | Within Int (Int -> x)
  | Wake Int x
  | Pending Int (Int -> x)

-- | For host operations begun now and finished later (a transfer, a
-- | socket readable): a group opened, operations begun in it and ended,
-- | a wait for one to finish, the group closed.
reactor : HFunctor
reactor =
  { f = ReactorF
  , hfmap = \m g p -> case p of
      Open k -> Open (\i -> g (k i))
      Begin i k -> Begin i (\b -> g (k b))
      End i b -> End i (\r use -> b r (\t v k -> use t v (\w -> g (k w))))
      Finish i w f -> Finish i w (\r use -> f r (\t k -> use t (\l -> g (k l))))
      Close i x -> Close i (g x)
      Within i k -> Within i (\j -> g (k j))
      Wake i x -> Wake i (g x)
      Pending i k -> Pending i (\n -> g (k n))
  , hmap = \m n nt p -> case p of
      Open k -> Open k
      Begin i k -> Begin i k
      End i b -> End i b
      Finish i w f -> Finish i w f
      Close i x -> Close i x
      Within i k -> Within i k
      Wake i x -> Wake i x
      Pending i k -> Pending i k
  }

-- | A group of its own.
open : {e : HFunctor} -> {{rx : reactor <: e}} -> {t : Type} -> Co e (Group t)
open = bind (op (rx (Open (\i -> i))) val) (\i -> pure (MkGroup i))

-- | `c` started in the group: run until it is done, `Just` its value;
-- | or until an operation of it would wait, `Nothing`, its value to be
-- | one of the group's `finished`.  Begun (`True`), `c` is run, and
-- | ended with its value; where it waits, its start is told so
-- | (`False`), and what comes after its wait is run once that is done,
-- | up to its end, its value then one of the group's finished.
start : {e : HFunctor}
      -> {{rx : reactor <: e}}
      -> {t : Type}
      -> Group t
      -> Co e t
      -> Co e (Maybe t)
start (MkGroup i) c =
  bind
    (op (rx (Begin i (\b -> b))) val)
    (\trying ->
       if trying
       then bind c (\v -> op (rx (End i (endingWith v (\r -> r)))) val)
       else pure Nothing)

-- | The group's computations finished since it was last asked, in the
-- | order they were: where `wait`, waiting for one at least, while any
-- | of it is pending, or until the group is woken (`wake`); none where
-- | none is.
finished : {e : HFunctor}
         -> {{rx : reactor <: e}}
         -> {t : Type}
         -> Group t
         -> Bool
         -> Co e (List t)
finished (MkGroup i) wait = op (rx (Finish i wait (finishedWith (\l -> l)))) val

-- | The group closed: what of it is pending let go of, undone -- a
-- | socket being connected closed, a request let go of -- and what of it
-- | is finished and not asked for.
close : {e : HFunctor}
      -> {{rx : reactor <: e}}
      -> {t : Type}
      -> Group t
      -> Co e Unit
close (MkGroup i) = op (rx (Close i MkUnit)) val

-- | A group within `g`, of the same domain: what is started in it is
-- | among `g`'s pending, and finishes among `g`'s finished; closed, what
-- | of it is pending is let go of, undone, and `g` stays open.  So one
-- | of a group's computations started is let go of alone, in a group of
-- | its own within it.
openWithin : {e : HFunctor}
           -> {{rx : reactor <: e}}
           -> {t : Type}
           -> Group t
           -> Co e (Group t)
openWithin (MkGroup i) =
  bind (op (rx (Within i (\j -> j))) val) (\j -> pure (MkGroup j))

-- | How many of the group's computations started are pending now: of
-- | the groups within it too.
pending : {e : HFunctor}
        -> {{rx : reactor <: e}}
        -> {t : Type}
        -> Group t
        -> Co e Int
pending (MkGroup i) = op (rx (Pending i (\n -> n))) val

-- | The domain asking for the group's finished woken, from any domain:
-- | its `finished`, waiting, comes back -- with none, where none has
-- | finished -- and where it is not waiting now, its next does, at
-- | once.  A group's number is no other domain's, so the right one is
-- | woken; one closed is woken no more.
wake : {e : HFunctor}
     -> {{rx : reactor <: e}}
     -> {t : Type}
     -> Group t
     -> Co e Unit
wake (MkGroup i) = op (rx (Wake i MkUnit)) val
