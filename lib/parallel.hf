-- Parallel composition as an effect: `Par l r k` runs `l` and `r` in
-- parallel, and goes on with `k` of their answers.  A higher-order
-- operation: how its computations run -- one after the other, taking
-- turns, or truly at once -- is the handler's to say.  The types of what
-- runs in parallel are the effect's (`parOf a b`): a program that runs
-- other types in parallel too has another `parOf` in its effect.

import co

data ParF a b (m : Type -> Type) x = Par (m a) (m b) (a -> b -> x)

parOf : (a b : Type) -> HFunctor
parOf a b =
  { f = ParF a b
  , hfmap = \m g p -> case p of
      Par l r k -> Par l r (\x y -> g (k x y))
  , hmap = \m n nt p -> case p of
      Par l r k -> Par (nt l) (nt r) k
  }

-- | `l` and `r` in parallel, and both their answers, in any effect that
-- | has `parOf a b` (`inj` puts the operation there: a higher-order
-- | operation is made where it is, not lifted).  Each side is handled
-- | first, its pure work done then (lib/co.hf): a handler into `Co e`
-- | that runs a side elsewhere runs there only what comes after an
-- | operation, or after `later` -- `parIn (later (\u -> fib n)) ...`.
parIn : {a b : Type}
      -> {e : HFunctor}
      -> {{inj : parOf a b <: e}}
      -> Co e a
      -> Co e b
      -> Co e (Pair a b)
parIn l r = op (inj (Par l r (\x y -> (MkPair x y : Pair a b)))) val

-- | `Par` into `Co e`, one side after the other
inOrder : {a b x : Type} -> {e : HFunctor} -> ParF a b (Co e) x -> Co e x
inOrder (Par l r k) = bind l (\y -> bind r (\z -> val (k y z)))

-- | `Par` handled one side after the other, into `Co e`: the rest of the
-- | world left as it is
inTurn : (a b : Type) -> (e : HFunctor) -> Handler (parOf a b <+> e)
inTurn a b e = through (parOf a b) e (\p -> inOrder p)

runPar : {a b x : Type} -> ParF a b (\y -> y) x -> x
runPar (Par l r k) = k l r

-- | `Par` handled one side after the other, in no monad: the answer
turns : (a b : Type) -> Handler (parOf a b)
turns a b =
  { M = \y -> y, ret = \y -> y, bind = \m k -> k m, malg = \p -> runPar p }

-- When a side's pure work runs, `Par` handled into `Co e` (heff#37): a
-- step after a `bind`, as it is handled; after `later`, when the `Co e`
-- runs.

-- (two sides in parallel, `side 1` and `side 2`; below, a side's work
-- abandons, wherever it is done)
bothSides : (Int -> Co (parOf Int Int <+> parOf Int Int) Int)
          -> Co (parOf Int Int <+> parOf Int Int) (Pair Int Int)
bothSides side =
  parIn (inj := inl (parOf Int Int) (parOf Int Int)) (side 1) (side 2)

