-- Parallel composition as an effect: `Parallel l r k` runs `l` and `r` in
-- parallel, and goes on with `k` of their answers.  A higher-order
-- operation: how its computations run -- one after the other, taking
-- turns, or truly at once -- is the handler's to say.  The types of what
-- runs in parallel are the effect's (`parallel a b`): a program that runs
-- other types in parallel too has another `parallel` in its effect.

import co

data ParallelF a b (m : Type -> Type) x = Parallel (m a) (m b) (a -> b -> x)

parallel : (a b : Type) -> HFunctor
parallel a b =
  { f = ParallelF a b
  , hfmap = \m g p -> case p of
      Parallel l r k -> Parallel l r (\x y -> g (k x y))
  , hmap = \m n nt p -> case p of
      Parallel l r k -> Parallel (nt l) (nt r) k
  }

-- | `l` and `r` in parallel, and both their answers, in any effect that
-- | has `parallel a b` (`inj` puts the operation there: a higher-order
-- | operation is made where it is, not lifted).  Each side is handled
-- | first, its pure work done then: a handler into `Co e`
-- | that runs a side elsewhere runs there only what comes after an
-- | operation, or after `later` -- `parallelIn (later (\u -> fib n)) ...`.
parallelIn : {a b : Type}
           -> {e : HFunctor}
           -> {{inj : parallel a b <: e}}
           -> Co e a
           -> Co e b
           -> Co e (Pair a b)
parallelIn l r = op (inj (Parallel l r (\x y -> (MkPair x y : Pair a b)))) val

-- | `Parallel` into `Co e`, one side after the other
inOrder : {a b x : Type} -> {e : HFunctor} -> ParallelF a b (Co e) x -> Co e x
inOrder (Parallel l r k) = bind l (\y -> bind r (\z -> val (k y z)))

-- | `Parallel` handled one side after the other, into `Co e`: the rest of the
-- | world left as it is
inTurn : (a b : Type) -> (e : HFunctor) -> Handler (parallel a b <+> e)
inTurn a b e = through (parallel a b) e (\p -> inOrder p)

runParallel : {a b x : Type} -> ParallelF a b (\y -> y) x -> x
runParallel (Parallel l r k) = k l r

-- | `Parallel` handled one side after the other, in no monad: the answer
turns : (a b : Type) -> Handler (parallel a b)
turns a b =
  { M = \y -> y, ret = \y -> y, bind = \m k -> k m, malg = \p -> runParallel p }

-- When a side's pure work runs, `Parallel` handled into `Co e` (heff#37): a
-- step after a `bind`, as it is handled; after `later`, when the `Co e`
-- runs.

-- (two sides in parallel, `side 1` and `side 2`; below, a side's work
-- abandons, wherever it is done)
-- | >>> const "handled" (handle (inTurn Int Int (parallel Int Int)) (bothSides (\n -> bind (val n) (\m -> pure (if m > 0 then abandon else m)))))
-- | <abandoned>
-- | >>> const "handled" (handle (inTurn Int Int (parallel Int Int)) (bothSides (\n -> later (\u -> if n > 0 then abandon else n))))
-- | "handled"
-- | >>> handle (turns Int Int) (handle (inTurn Int Int (parallel Int Int)) (bothSides (\n -> later (\u -> if n > 0 then abandon else n))))
-- | <abandoned>
-- | >>> handle (turns Int Int) (handle (inTurn Int Int (parallel Int Int)) (bothSides (\n -> later (\u -> n * 10))))
-- | MkPair 10 20
bothSides : (Int -> Co (parallel Int Int <+> parallel Int Int) Int)
          -> Co (parallel Int Int <+> parallel Int Int) (Pair Int Int)
bothSides side =
  parallelIn
    (inj := inl (parallel Int Int) (parallel Int Int))
    (side 1)
    (side 2)
