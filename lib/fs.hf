-- Files as an effect (lib/co.hf): reading one, writing one.  `heff node`
-- has a handler for it.

import co
import prelude

data FsF (m : Type -> Type) x
  = ReadFile String (Maybe String -> x)
  | WriteFile String String (Bool -> x)

-- | Files as an effect.
fs : HFunctor
fs =
  { f = FsF
  , hfmap = \fm g p -> case p of
      ReadFile path k -> ReadFile path (\t -> g (k t))
      WriteFile path str k -> WriteFile path str (\ok -> g (k ok))
  , hmap = \nt p -> case p of
      ReadFile path k -> ReadFile path k
      WriteFile path str k -> WriteFile path str k
  }

-- | A file's text, if it could be read.
readFile : String -> Co fs (Maybe String)
readFile path = op (ReadFile path (\t -> t)) val

-- | Write a file (a new one, or over what it had): whether it was written.
writeFile : String -> String -> Co fs Bool
writeFile path str = op (WriteFile path str (\ok -> ok)) val
