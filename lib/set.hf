-- Sets, by an order of their elements: a map (lib/map.hf) whose values are
-- nothing.  Each function is given the order, always the same one for a
-- set.  Import it by a name, `import set as Set`.

import map as Map

type Set a = Map.Map a Unit

empty : {a : Type} -> Set a
empty = Map.empty

insert : {a : Type} -> (a -> a -> Ordering) -> a -> Set a -> Set a
insert cmp x s = Map.insert cmp x MkUnit s

member : {a : Type} -> (a -> a -> Ordering) -> a -> Set a -> Bool
member cmp x s = Map.member cmp x s

delete : {a : Type} -> (a -> a -> Ordering) -> a -> Set a -> Set a
delete cmp x s = Map.delete cmp x s

-- | The elements, in order.
toList : {a : Type} -> Set a -> List a
toList s = Map.keys s

fromList : {a : Type} -> (a -> a -> Ordering) -> List a -> Set a
fromList cmp xs = List.foldl (\s x -> insert cmp x s) empty xs

size : {a : Type} -> Set a -> Int
size s = Map.size s

union : {a : Type} -> (a -> a -> Ordering) -> Set a -> Set a -> Set a
union cmp a b = Map.union cmp a b
