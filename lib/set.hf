-- Sets, by an order of their elements: a map (lib/map.hf) whose values are
-- nothing.  The order is the elements' `Order`, found as an instance
-- argument is, always the same one for a set.  Import it by a name, `import set as Set`.

import map as Map

type Set a = Map.Map a Unit

empty : {a : Type} -> Set a
empty = Map.empty

insert : {a : Type} -> {{ord : Order a}} -> a -> Set a -> Set a
insert x s = Map.insert x MkUnit s

member : {a : Type} -> {{ord : Order a}} -> a -> Set a -> Bool
member x s = Map.member x s

delete : {a : Type} -> {{ord : Order a}} -> a -> Set a -> Set a
delete x s = Map.delete x s

-- | The elements, in order.
toList : {a : Type} -> Set a -> List a
toList s = Map.keys s

fromList : {a : Type} -> {{ord : Order a}} -> List a -> Set a
fromList xs = List.foldl (\s x -> insert x s) empty xs

size : {a : Type} -> Set a -> Int
size s = Map.size s

union : {a : Type} -> {{ord : Order a}} -> Set a -> Set a -> Set a
union a b = Map.union a b
