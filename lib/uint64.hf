-- `UInt64`: the integers from 0 to 18446744073709551615, wrapping around as the
-- machine's do: `fromInt 18446744073709551616` is 0, `fromInt (-1)` is 18446744073709551615.  A literal checked at `UInt64` is one (`(7 : UInt64)`).
-- Import it by a name, `import uint64 as U64`, as its names are the
-- prelude's: `U64.add`, `U64.fromInt`.  Its instances are the prelude's
-- operators' at `UInt64`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive uint64Add : UInt64 -> UInt64 -> UInt64
primitive uint64Sub : UInt64 -> UInt64 -> UInt64
primitive uint64Mul : UInt64 -> UInt64 -> UInt64
primitive uint64Div : UInt64 -> UInt64 -> UInt64
primitive uint64Rem : UInt64 -> UInt64 -> UInt64
primitive uint64Lt : UInt64 -> UInt64 -> Bool
primitive uint64Le : UInt64 -> UInt64 -> Bool
primitive uint64And : UInt64 -> UInt64 -> UInt64
primitive uint64Or : UInt64 -> UInt64 -> UInt64
primitive uint64Xor : UInt64 -> UInt64 -> UInt64
primitive uint64Shl : UInt64 -> UInt64 -> UInt64
primitive uint64Shr : UInt64 -> UInt64 -> UInt64
primitive uint64Show : UInt64 -> String
primitive uint64FromInt : Int -> UInt64
primitive uint64ToInt : UInt64 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt64
minBound = 0

-- | The greatest.
maxBound : UInt64
maxBound = 18446744073709551615

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt64 -> UInt64 -> UInt64
add = uint64Add

sub : UInt64 -> UInt64 -> UInt64
sub = uint64Sub

mul : UInt64 -> UInt64 -> UInt64
mul = uint64Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt64 -> UInt64 -> UInt64
div = uint64Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt64 -> UInt64 -> UInt64
rem = uint64Rem

neg : UInt64 -> UInt64
neg x = uint64Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt64 -> UInt64 -> Bool
eq = uint64Eq

lt : UInt64 -> UInt64 -> Bool
lt = uint64Lt

le : UInt64 -> UInt64 -> Bool
le = uint64Le

compare : UInt64 -> UInt64 -> Ordering
compare a b = if uint64Lt a b then LT else if uint64Eq a b then EQ else GT

min : UInt64 -> UInt64 -> UInt64
min a b = if uint64Le a b then a else b

max : UInt64 -> UInt64 -> UInt64
max a b = if uint64Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt64 -> UInt64 -> UInt64
and = uint64And

-- | The bits set in either.
or : UInt64 -> UInt64 -> UInt64
or = uint64Or

-- | The bits set in one of the two.
xor : UInt64 -> UInt64 -> UInt64
xor = uint64Xor

-- | Every bit flipped.
complement : UInt64 -> UInt64
complement x = uint64Xor x 18446744073709551615

-- | Shifted left by the second (modulo 64), the bits shifted out lost.
shiftL : UInt64 -> UInt64 -> UInt64
shiftL = uint64Shl

-- | Shifted right by the second (modulo 64), zeros shifted in.
shiftR : UInt64 -> UInt64 -> UInt64
shiftR = uint64Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt64` an integer wraps around to: equal to it modulo 2^64.
fromInt : Int -> UInt64
fromInt = uint64FromInt

toInt : UInt64 -> Int
toInt = uint64ToInt

show : UInt64 -> String
show = uint64Show

-- Instances: the prelude's operators and functions at `UInt64`
--------------------------------------------------------------------------------

instance eqUInt64 : Eq UInt64
eqUInt64 = { equal = uint64Eq }

instance ordUInt64 : Ord UInt64
ordUInt64 = { compare = compare, lt = uint64Lt, le = uint64Le }

instance addUInt64 : Add UInt64
addUInt64 = { add = uint64Add }

instance subUInt64 : Sub UInt64
subUInt64 = { sub = uint64Sub }

instance mulUInt64 : Mul UInt64
mulUInt64 = { mul = uint64Mul }

-- | >>> List.map show [7 / 2, 7 / 0]
-- | Cons "3" (Cons "0" Nil)
instance divUInt64 : Div UInt64
divUInt64 = { div = uint64Div }

-- | >>> List.map show [7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance modUInt64 : Mod UInt64
modUInt64 = { mod = uint64Rem }

instance negUInt64 : Neg UInt64
negUInt64 = { neg = neg }

instance zeroUInt64 : HasZero UInt64
zeroUInt64 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsUInt64 : Bits UInt64
bitsUInt64 =
  { and = uint64And
  , or = uint64Or
  , xor = uint64Xor
  , complement = complement
  , shiftL = uint64Shl
  , shiftR = uint64Shr
  }
