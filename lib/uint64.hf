-- `UInt64`: the integers from 0 to 18446744073709551615, wrapping around as the
-- machine's do: `fromInt 18446744073709551616` is 0, `fromInt (-1)` is 18446744073709551615.  A literal checked at `UInt64` is one (`(7 : UInt64)`).
-- Import it by a name, `import uint64 as UInt64`, as the other fixed-width
-- types' modules have the same names: `UInt64.fromInt`, `UInt64.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `UInt64`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

primitive uint64Add : UInt64 -> UInt64 -> UInt64
primitive uint64Sub : UInt64 -> UInt64 -> UInt64
primitive uint64Mul : UInt64 -> UInt64 -> UInt64
primitive uint64Div : UInt64 -> UInt64 -> UInt64
primitive uint64Rem : UInt64 -> UInt64 -> UInt64
primitive uint64Lt : UInt64 -> UInt64 -> Bool
primitive uint64Le : UInt64 -> UInt64 -> Bool
primitive uint64And : UInt64 -> UInt64 -> UInt64
primitive uint64Or : UInt64 -> UInt64 -> UInt64
primitive uint64Xor : UInt64 -> UInt64 -> UInt64
primitive uint64Shl : UInt64 -> UInt64 -> UInt64
primitive uint64Shr : UInt64 -> UInt64 -> UInt64
primitive uint64Show : UInt64 -> String
primitive uint64FromInt : Int -> UInt64
primitive uint64ToInt : UInt64 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt64
minBound = 0

-- | The greatest.
maxBound : UInt64
maxBound = 18446744073709551615

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt64 -> UInt64 -> UInt64
add = uint64Add

sub : UInt64 -> UInt64 -> UInt64
sub = uint64Sub

mul : UInt64 -> UInt64 -> UInt64
mul = uint64Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt64 -> UInt64 -> UInt64
div = uint64Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt64 -> UInt64 -> UInt64
rem = uint64Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt64 -> UInt64 -> Bool
eq = uint64Eq

lt : UInt64 -> UInt64 -> Bool
lt = uint64Lt

le : UInt64 -> UInt64 -> Bool
le = uint64Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt64` an integer wraps around to: equal to it modulo 2^64.
fromInt : Int -> UInt64
fromInt = uint64FromInt

toInt : UInt64 -> Int
toInt = uint64ToInt

-- Instances: the prelude's operators and functions at `UInt64`
--------------------------------------------------------------------------------

instance instanceEqualityUInt64 : Equality UInt64
instanceEqualityUInt64 = { equal = uint64Eq }

-- | >>> show (7 : UInt64)
-- | "7"
instance instanceShowUInt64 : Show UInt64
instanceShowUInt64 = { show = uint64Show }

-- | As `show` writes it.
instance instanceToStringUInt64 : ToString UInt64
instanceToStringUInt64 = { toString = uint64Show }

instance instanceOrderUInt64 : Order UInt64
instanceOrderUInt64 =
  { compare = \a b ->
        if uint64Lt a b then LT else if uint64Eq a b then EQ else GT
  , lt = uint64Lt
  , le = uint64Le
  }

instance instanceAdditionUInt64 : Addition UInt64
instanceAdditionUInt64 = { add = uint64Add }

instance instanceSubtractionUInt64 : Subtraction UInt64
instanceSubtractionUInt64 = { sub = uint64Sub }

instance instanceMultiplicationUInt64 : Multiplication UInt64
instanceMultiplicationUInt64 = { mul = uint64Mul }

-- | >>> List.map show ([7 / 2, 7 / 0] : List UInt64)
-- | Cons "3" (Cons "0" Nil)
instance instanceDivisionUInt64 : Division UInt64
instanceDivisionUInt64 = { div = uint64Div }

-- | >>> List.map show ([7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0] : List UInt64)
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance instanceRemainderUInt64 : Remainder UInt64
instanceRemainderUInt64 = { mod = uint64Rem }

-- | What, added to it, wraps around to 0: of 1, `maxBound`.
instance instanceNegationUInt64 : Negation UInt64
instanceNegationUInt64 = { neg = \x -> uint64Sub 0 x }

instance instanceIsZeroUInt64 : IsZero UInt64
instanceIsZeroUInt64 = { isZero = \x -> uint64Eq x 0 }

-- | The bits: shifted left by the second (modulo 64), the bits shifted out
-- | lost, and right, zeros shifted in.  The second is never negative: `0 -
-- | 1` is `maxBound`, a shift by which is one by 63.
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : UInt64)
-- | "25"
-- | >>> List.map show ([shiftL 1 (0 - 1), shiftR maxBound (0 - 1), shiftL 1 65] : List UInt64)
-- | Cons "9223372036854775808" (Cons "1" (Cons "2" Nil))
instance instanceBitwiseUInt64 : Bitwise UInt64
instanceBitwiseUInt64 =
  { and = uint64And
  , or = uint64Or
  , xor = uint64Xor
  , complement = \x -> uint64Xor x 18446744073709551615
  , shiftL = uint64Shl
  , shiftR = uint64Shr
  }
