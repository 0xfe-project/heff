-- `UInt16`: the integers from 0 to 65535, wrapping around as the
-- machine's do: `fromInt 65536` is 0, `fromInt (-1)` is 65535.  A literal checked at `UInt16` is one (`(7 : UInt16)`).
-- Import it by a name, `import uint16 as U16`, as its names are the
-- prelude's: `U16.add`, `U16.fromInt`.  Its operators, `+` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  (Another fixed-width type's value from one goes by way of an
-- `Int`: `toInt`, then the other's `fromInt`.)

import prelude

foreign import uint16Add : UInt16 -> UInt16 -> UInt16
foreign import uint16Sub : UInt16 -> UInt16 -> UInt16
foreign import uint16Mul : UInt16 -> UInt16 -> UInt16
foreign import uint16Div : UInt16 -> UInt16 -> UInt16
foreign import uint16Rem : UInt16 -> UInt16 -> UInt16
foreign import uint16Eq : UInt16 -> UInt16 -> Bool
foreign import uint16Lt : UInt16 -> UInt16 -> Bool
foreign import uint16Le : UInt16 -> UInt16 -> Bool
foreign import uint16And : UInt16 -> UInt16 -> UInt16
foreign import uint16Or : UInt16 -> UInt16 -> UInt16
foreign import uint16Xor : UInt16 -> UInt16 -> UInt16
foreign import uint16Shl : UInt16 -> UInt16 -> UInt16
foreign import uint16Shr : UInt16 -> UInt16 -> UInt16
foreign import uint16Show : UInt16 -> String
foreign import uint16FromInt : Int -> UInt16
foreign import uint16ToInt : UInt16 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt16
minBound = 0

-- | The greatest.
maxBound : UInt16
maxBound = 65535

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt16 -> UInt16 -> UInt16
add = uint16Add

sub : UInt16 -> UInt16 -> UInt16
sub = uint16Sub

mul : UInt16 -> UInt16 -> UInt16
mul = uint16Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | `abandon`.
div : UInt16 -> UInt16 -> UInt16
div = uint16Div

-- | The remainder of `div`, of the sign of the dividend; by 0, `abandon`.
rem : UInt16 -> UInt16 -> UInt16
rem = uint16Rem

neg : UInt16 -> UInt16
neg x = uint16Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt16 -> UInt16 -> Bool
eq = uint16Eq

lt : UInt16 -> UInt16 -> Bool
lt = uint16Lt

le : UInt16 -> UInt16 -> Bool
le = uint16Le

compare : UInt16 -> UInt16 -> Ordering
compare a b = if uint16Lt a b then LT else if uint16Eq a b then EQ else GT

min : UInt16 -> UInt16 -> UInt16
min a b = if uint16Le a b then a else b

max : UInt16 -> UInt16 -> UInt16
max a b = if uint16Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt16 -> UInt16 -> UInt16
and = uint16And

-- | The bits set in either.
or : UInt16 -> UInt16 -> UInt16
or = uint16Or

-- | The bits set in one of the two.
xor : UInt16 -> UInt16 -> UInt16
xor = uint16Xor

-- | Every bit flipped.
complement : UInt16 -> UInt16
complement x = uint16Xor x 65535

-- | Shifted left by the second (modulo 16), the bits shifted out lost.
shiftL : UInt16 -> UInt16 -> UInt16
shiftL = uint16Shl

-- | Shifted right by the second (modulo 16), zeros shifted in.
shiftR : UInt16 -> UInt16 -> UInt16
shiftR = uint16Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt16` an integer wraps around to: equal to it modulo 2^16.
fromInt : Int -> UInt16
fromInt = uint16FromInt

toInt : UInt16 -> Int
toInt = uint16ToInt

show : UInt16 -> String
show = uint16Show

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=
infixl + - above == /= < <= > >=
infixl * / % above + -

(+) : UInt16 -> UInt16 -> UInt16
(+) = uint16Add

(-) : UInt16 -> UInt16 -> UInt16
(-) = uint16Sub

(*) : UInt16 -> UInt16 -> UInt16
(*) = uint16Mul

(/) : UInt16 -> UInt16 -> UInt16
(/) = uint16Div

(%) : UInt16 -> UInt16 -> UInt16
(%) = uint16Rem

(==) : UInt16 -> UInt16 -> Bool
(==) = uint16Eq

(/=) : UInt16 -> UInt16 -> Bool
(/=) a b = not (uint16Eq a b)

(<) : UInt16 -> UInt16 -> Bool
(<) = uint16Lt

(<=) : UInt16 -> UInt16 -> Bool
(<=) = uint16Le

(>) : UInt16 -> UInt16 -> Bool
(>) a b = uint16Lt b a

(>=) : UInt16 -> UInt16 -> Bool
(>=) a b = uint16Le b a
