-- `UInt16`: the integers from 0 to 65535, wrapping around as the
-- machine's do: `fromInt 65536` is 0, `fromInt (-1)` is 65535.  A literal checked at `UInt16` is one (`(7 : UInt16)`).
-- Import it by a name, `import uint16 as UInt16`, as the other fixed-width
-- types' modules have the same names: `UInt16.fromInt`, `UInt16.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `UInt16`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

module uint16

primitive uint16Add : UInt16 -> UInt16 -> UInt16
primitive uint16Sub : UInt16 -> UInt16 -> UInt16
primitive uint16Mul : UInt16 -> UInt16 -> UInt16
primitive uint16Div : UInt16 -> UInt16 -> UInt16
primitive uint16Rem : UInt16 -> UInt16 -> UInt16
primitive uint16Lt : UInt16 -> UInt16 -> Bool
primitive uint16Le : UInt16 -> UInt16 -> Bool
primitive uint16And : UInt16 -> UInt16 -> UInt16
primitive uint16Or : UInt16 -> UInt16 -> UInt16
primitive uint16Xor : UInt16 -> UInt16 -> UInt16
primitive uint16Shl : UInt16 -> UInt16 -> UInt16
primitive uint16Shr : UInt16 -> UInt16 -> UInt16
primitive uint16Show : UInt16 -> String
primitive uint16FromInt : Int -> UInt16
primitive uint16ToInt : UInt16 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt16
minBound = 0

-- | The greatest.
maxBound : UInt16
maxBound = 65535

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt16 -> UInt16 -> UInt16
add = uint16Add

sub : UInt16 -> UInt16 -> UInt16
sub = uint16Sub

mul : UInt16 -> UInt16 -> UInt16
mul = uint16Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt16 -> UInt16 -> UInt16
div = uint16Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt16 -> UInt16 -> UInt16
rem = uint16Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt16 -> UInt16 -> Bool
eq = uint16Eq

lt : UInt16 -> UInt16 -> Bool
lt = uint16Lt

le : UInt16 -> UInt16 -> Bool
le = uint16Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt16` an integer wraps around to: equal to it modulo 2^16.
fromInt : Int -> UInt16
fromInt = uint16FromInt

toInt : UInt16 -> Int
toInt = uint16ToInt

-- Bits
--------------------------------------------------------------------------------

-- | The bits turned left by `n`, modulo 16: those shifted out at the top
-- | come in at the bottom, as Go's `bits.RotateLeft16` turns them; by a
-- | negative `n`, right.
-- | >>> List.map (\n -> toInt (rotateLeft 32769 n : UInt16)) [1, -1, 16]
-- | Cons 3 (Cons 49152 (Cons 32769 Nil))
rotateLeft : UInt16 -> Int -> UInt16
rotateLeft x n =
  let k : Int = n % 16
  in uint16Or
    (uint16Shl x (uint16FromInt k))
    (uint16Shr x (uint16FromInt (16 - k)))

-- | The bits turned right by `n`: `rotateLeft x (-n)`.
-- | >>> toInt (rotateRight 3 1 : UInt16)
-- | 32769
rotateRight : UInt16 -> Int -> UInt16
rotateRight x n = rotateLeft x (0 - n)

-- | How many of its bits are 1.
-- | >>> List.map (\x -> popCount (x : UInt16)) [0, 7, 65535]
-- | Cons 0 (Cons 3 (Cons 16 Nil))
popCount : UInt16 -> Int
popCount x = ones x 0
  where
  -- (how many of the bits of `y` are 1, after `acc`)
  ones : UInt16 -> Int -> Int
  ones y acc =
    if uint16Eq y 0 then acc else ones (uint16And y (uint16Sub y 1)) (acc + 1)

-- | How many bits it needs: the place of its highest 1, from 1; of 0, 0.
-- | >>> List.map (\x -> bitLength (x : UInt16)) [0, 1, 5, 65535]
-- | Cons 0 (Cons 1 (Cons 3 (Cons 16 Nil)))
bitLength : UInt16 -> Int
bitLength x = needs x 0
  where
  -- (how many bits `y` needs, after `acc`)
  needs : UInt16 -> Int -> Int
  needs y acc = if uint16Eq y 0 then acc else needs (uint16Shr y 1) (acc + 1)

-- | How many 0 bits are above its highest 1: of 0, 16.
-- | >>> List.map (\x -> leadingZeros (x : UInt16)) [0, 1, 32768]
-- | Cons 16 (Cons 15 (Cons 0 Nil))
leadingZeros : UInt16 -> Int
leadingZeros x = 16 - bitLength x

-- | How many 0 bits are below its lowest 1: of 0, 16.
-- | >>> List.map (\x -> trailingZeros (x : UInt16)) [0, 1, 12, 32768]
-- | Cons 16 (Cons 0 (Cons 2 (Cons 15 Nil)))
trailingZeros : UInt16 -> Int
trailingZeros x =
  if uint16Eq x 0 then 16
  else popCount (uint16Sub (uint16And x (uint16Sub 0 x)) 1)

-- Instances: the prelude's operators and functions at `UInt16`
--------------------------------------------------------------------------------

instance instanceEqualityUInt16 : Equality UInt16
instanceEqualityUInt16 = { equal = uint16Eq }

-- | >>> show (7 : UInt16)
-- | "7"
instance instanceShowUInt16 : Show UInt16
instanceShowUInt16 = { show = uint16Show }

-- | As `show` writes it.
instance instanceToStringUInt16 : ToString UInt16
instanceToStringUInt16 = { toString = uint16Show }

instance instanceOrderUInt16 : Order UInt16
instanceOrderUInt16 =
  { eq = instanceEqualityUInt16
  , compare = \a b ->
        if uint16Lt a b then LT else if uint16Eq a b then EQ else GT
  , lt = uint16Lt
  , le = uint16Le
  }

instance instanceAdditionUInt16 : Addition UInt16
instanceAdditionUInt16 = { add = uint16Add }

instance instanceSubtractionUInt16 : Subtraction UInt16
instanceSubtractionUInt16 = { sub = uint16Sub }

instance instanceMultiplicationUInt16 : Multiplication UInt16
instanceMultiplicationUInt16 = { mul = uint16Mul }

-- | >>> List.map show ([7 / 2, 7 / 0] : List UInt16)
-- | Cons "3" (Cons "0" Nil)
instance instanceDivisionUInt16 : Division UInt16
instanceDivisionUInt16 = { div = uint16Div }

-- | >>> List.map show ([7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0] : List UInt16)
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance instanceRemainderUInt16 : Remainder UInt16
instanceRemainderUInt16 = { mod = uint16Rem }

-- | What, added to it, wraps around to 0: of 1, `maxBound`.
instance instanceNegationUInt16 : Negation UInt16
instanceNegationUInt16 = { neg = \x -> uint16Sub 0 x }

instance instanceIsZeroUInt16 : IsZero UInt16
instanceIsZeroUInt16 = { isZero = \x -> uint16Eq x 0 }

-- | The bits: shifted left by the second (modulo 16), the bits shifted out
-- | lost, and right, zeros shifted in.
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : UInt16)
-- | "25"
instance instanceBitwiseUInt16 : Bitwise UInt16
instanceBitwiseUInt16 =
  { and = uint16And
  , or = uint16Or
  , xor = uint16Xor
  , complement = \x -> uint16Xor x 65535
  , shiftL = uint16Shl
  , shiftR = uint16Shr
  }
