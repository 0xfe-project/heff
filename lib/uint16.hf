-- `UInt16`: the integers from 0 to 65535, wrapping around as the
-- machine's do: `fromInt 65536` is 0, `fromInt (-1)` is 65535.  A literal checked at `UInt16` is one (`(7 : UInt16)`).
-- Import it by a name, `import uint16 as U16`, as its names are the
-- prelude's: `U16.add`, `U16.fromInt`.  Its instances are the prelude's
-- operators' at `UInt16`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive uint16Add : UInt16 -> UInt16 -> UInt16
primitive uint16Sub : UInt16 -> UInt16 -> UInt16
primitive uint16Mul : UInt16 -> UInt16 -> UInt16
primitive uint16Div : UInt16 -> UInt16 -> UInt16
primitive uint16Rem : UInt16 -> UInt16 -> UInt16
primitive uint16Lt : UInt16 -> UInt16 -> Bool
primitive uint16Le : UInt16 -> UInt16 -> Bool
primitive uint16And : UInt16 -> UInt16 -> UInt16
primitive uint16Or : UInt16 -> UInt16 -> UInt16
primitive uint16Xor : UInt16 -> UInt16 -> UInt16
primitive uint16Shl : UInt16 -> UInt16 -> UInt16
primitive uint16Shr : UInt16 -> UInt16 -> UInt16
primitive uint16Show : UInt16 -> String
primitive uint16FromInt : Int -> UInt16
primitive uint16ToInt : UInt16 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt16
minBound = 0

-- | The greatest.
maxBound : UInt16
maxBound = 65535

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt16 -> UInt16 -> UInt16
add = uint16Add

sub : UInt16 -> UInt16 -> UInt16
sub = uint16Sub

mul : UInt16 -> UInt16 -> UInt16
mul = uint16Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt16 -> UInt16 -> UInt16
div = uint16Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt16 -> UInt16 -> UInt16
rem = uint16Rem

neg : UInt16 -> UInt16
neg x = uint16Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt16 -> UInt16 -> Bool
eq = uint16Eq

lt : UInt16 -> UInt16 -> Bool
lt = uint16Lt

le : UInt16 -> UInt16 -> Bool
le = uint16Le

compare : UInt16 -> UInt16 -> Ordering
compare a b = if uint16Lt a b then LT else if uint16Eq a b then EQ else GT

min : UInt16 -> UInt16 -> UInt16
min a b = if uint16Le a b then a else b

max : UInt16 -> UInt16 -> UInt16
max a b = if uint16Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt16 -> UInt16 -> UInt16
and = uint16And

-- | The bits set in either.
or : UInt16 -> UInt16 -> UInt16
or = uint16Or

-- | The bits set in one of the two.
xor : UInt16 -> UInt16 -> UInt16
xor = uint16Xor

-- | Every bit flipped.
complement : UInt16 -> UInt16
complement x = uint16Xor x 65535

-- | Shifted left by the second (modulo 16), the bits shifted out lost.
shiftL : UInt16 -> UInt16 -> UInt16
shiftL = uint16Shl

-- | Shifted right by the second (modulo 16), zeros shifted in.
shiftR : UInt16 -> UInt16 -> UInt16
shiftR = uint16Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt16` an integer wraps around to: equal to it modulo 2^16.
fromInt : Int -> UInt16
fromInt = uint16FromInt

toInt : UInt16 -> Int
toInt = uint16ToInt

show : UInt16 -> String
show = uint16Show

-- Instances: the prelude's operators and functions at `UInt16`
--------------------------------------------------------------------------------

instance eqUInt16 : Eq UInt16
eqUInt16 = { equal = uint16Eq }

instance ordUInt16 : Ord UInt16
ordUInt16 = { compare = compare, lt = uint16Lt, le = uint16Le }

instance addUInt16 : Add UInt16
addUInt16 = { add = uint16Add }

instance subUInt16 : Sub UInt16
subUInt16 = { sub = uint16Sub }

instance mulUInt16 : Mul UInt16
mulUInt16 = { mul = uint16Mul }

-- | >>> List.map show [7 / 2, 7 / 0]
-- | Cons "3" (Cons "0" Nil)
instance divUInt16 : Div UInt16
divUInt16 = { div = uint16Div }

-- | >>> List.map show [7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance modUInt16 : Mod UInt16
modUInt16 = { mod = uint16Rem }

instance negUInt16 : Neg UInt16
negUInt16 = { neg = neg }

instance zeroUInt16 : HasZero UInt16
zeroUInt16 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsUInt16 : Bits UInt16
bitsUInt16 =
  { and = uint16And
  , or = uint16Or
  , xor = uint16Xor
  , complement = complement
  , shiftL = uint16Shl
  , shiftR = uint16Shr
  }
