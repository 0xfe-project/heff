-- A state as an effect: one value, got and put.

import co
import prelude

-- | The operations: each says what it gives back by a function to the rest
-- | (`x`).
data StateF s (m : Type -> Type) x = Get (s -> x) | Put s x

state : (s : Type) -> HFunctor
state s =
  { f = StateF s
  , hfmap = \fm g p -> case p of
      Get k -> Get (\st -> g (k st))
      Put st x -> Put st (g x)
  , hmap = \nt p -> case p of
      Get k -> Get k
      Put st x -> Put st x
  }

-- | The value, got: in any effect the state is in, by the evidence.
get : {s : Type} -> {e : HFunctor} -> (state s <: e) -> Co e s
get ev = op (ev (Get (\st -> st))) val

-- | ... and put.
put : {s : Type} -> {e : HFunctor} -> (state s <: e) -> s -> Co e Unit
put ev st = op (ev (Put st MkUnit)) val
