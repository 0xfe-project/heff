-- A state as an effect: one value, got and put.

module state

import co

-- | The operations: each says what it gives back by a function to the rest
-- | (`x`).
data StateF s (m : Type -> Type) x = Get (s -> x) | Put s x

state : (s : Type) -> HFunctor
state s =
  { f = StateF s
  , hfmap = \m g p -> case p of
      Get k -> Get (\st -> g (k st))
      Put st x -> Put st (g x)
  , hmap = \m n nt p -> case p of
      Get k -> Get k
      Put st x -> Put st x
  }

-- | The value, got: in any effect the state is in, by the evidence.
get : {s : Type} -> {e : HFunctor} -> {{ev : state s <: e}} -> Co e s
get = op (ev (Get (\st -> st))) val

-- | ... and put.
put : {s : Type} -> {e : HFunctor} -> {{ev : state s <: e}} -> s -> Co e Unit
put st = op (ev (Put st MkUnit)) val

-- Handled
--------------------------------------------------------------------------------

-- (a computation of the world from a state: its answer and the state it
-- leaves, as a functor)
statefulFunctor : (s : Type) -> (e : HFunctor) -> RawFunctor
statefulFunctor s e =
  { f = \x -> s -> Co e (Pair x s)
  , fmap = \g m st -> bind (m st) (\r -> val (MkPair (g (fst r)) (snd r)))
  }

-- | A handler of `state s` into the rest of the world, `e`: the state
-- | threaded from each operation to the next.  An operation of `e`'s is
-- | done as it is; one that holds a computation of its own runs it from
-- | the state there, and what that run leaves of the state is not kept.
stateful : (s : Type) -> (e : HFunctor) -> Handler (plus (state s) e)
stateful s e =
  { M = \x -> s -> Co e (Pair x s)
  , ret = \x st -> val (MkPair x st)
  , bind = \m k st -> bind (m st) (\r -> k (fst r) (snd r))
  , malg = \p st -> case p of
      InL t -> case t of
        Get k -> val (MkPair (k st) st)
        Put st2 x -> val (MkPair x st2)
      InR q ->
        op
          (e.hmap
             (statefulFunctor s e)
             (coFunctor e)
             (\m -> bind (m st) (\r -> val (fst r)))
             q)
          (\x -> val (MkPair x st))
  }

-- | `c` from the state `s0`: what it comes to, and the state it leaves.
runState : {s : Type}
         -> {e : HFunctor}
         -> {a : Type}
         -> s
         -> Co (plus (state s) e) a
         -> Co e (Pair a s)
runState s0 c = handle (stateful s e) c s0
