-- A cell of the world as an effect: made with its first value, read,
-- written.  A page's events are each a run of their own, so what they
-- share lives in the world between them -- a cell, as an element
-- (lib/dom.hf's `Node`) does.  (A state threaded through one
-- computation is lib/state.hf, handled in the language; a cell is the
-- world's, ref.provider.js.)

import co
import prelude

-- | A cell holding an `s`.  (A number the provider gives it: a program
-- | only gets one from `newRef`.)
data Ref s = MkRef Int

-- | The operations: each says what it gives back by a function to the
-- | rest (`x`).
data RefF s (m : Type -> Type) x
  = NewRef s (Ref s -> x)
  | ReadRef (Ref s) (s -> x)
  | WriteRef (Ref s) s x

ref : (s : Type) -> HFunctor
ref s =
  { f = RefF s
  , hfmap = \fm g p -> case p of
      NewRef st k -> NewRef st (\r -> g (k r))
      ReadRef r k -> ReadRef r (\st -> g (k st))
      WriteRef r st x -> WriteRef r st (g x)
  , hmap = \nt p -> case p of
      NewRef st k -> NewRef st k
      ReadRef r k -> ReadRef r k
      WriteRef r st x -> WriteRef r st x
  }

-- | A new cell, holding `st`: in any effect the cells are in, by the
-- | evidence (as lib/state.hf's `get`).
newRef : {s : Type} -> {e : HFunctor} -> (ref s <: e) -> s -> Co e (Ref s)
newRef ev st = op (ev (NewRef st (\r -> r))) val

-- | What a cell holds.
readRef : {s : Type} -> {e : HFunctor} -> (ref s <: e) -> Ref s -> Co e s
readRef ev r = op (ev (ReadRef r (\st -> st))) val

-- | ... and it holds `st` now.
writeRef : {s : Type}
         -> {e : HFunctor}
         -> (ref s <: e)
         -> Ref s
         -> s
         -> Co e Unit
writeRef ev r st = op (ev (WriteRef r st MkUnit)) val
