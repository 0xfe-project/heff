-- Failure as an effect: `throw` abandons the rest of the
-- computation with a word of why (an `err`: a message, a diagnostic),
-- and `recover` hears it.  `Catch` holds computations, so it is made where
-- it is, not lifted (parallel.hf says the same): both operations take
-- the evidence `exception err <: e`.  What happens to the world a throw
-- abandons -- kept, or rolled back -- is nowhere in here: it is each
-- handler's to say.

module exception

import co

data ExceptionF err (m : Type -> Type) x = Throw err | Catch (m x) (err -> m x)

-- | Failure as an effect, with an `err` of why (a message, a
-- | diagnostic).
exception : (err : Type) -> HFunctor
exception err =
  { f = ExceptionF err
  , hfmap = \m g p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (m.fmap g c) (\s -> m.fmap g (h s))
  , hmap = \m n nt p -> case p of
      Throw s -> Throw s
      Catch c h -> Catch (nt c) (\s -> nt (h s))
  }

-- | Abandon the rest, with a word of why.
throw : {err : Type}
      -> {e : HFunctor}
      -> {a : Type}
      -> {{ev : exception err <: e}}
      -> err
      -> Co e a
throw = \{err} {e} {a} s -> op (ev ((Throw s : ExceptionF err (Co e) a))) val

-- | `recover c h` is `c`; if `c` throws, it is `h` of what was thrown
-- | (a `do` block's `try ... catch` is this).  (Which `err` that is is
-- | found from `h`'s type: a handler that does not look at it says it,
-- | `(h : String -> Co e a)`, there being no search for evidence.)
recover : {err : Type}
        -> {e : HFunctor}
        -> {a : Type}
        -> {{ev : exception err <: e}}
        -> Co e a
        -> (err -> Co e a)
        -> Co e a
recover = \{err} {e} {a} c h ->
    op (ev ((Catch c h : ExceptionF err (Co e) a))) val

-- Division that throws
--------------------------------------------------------------------------------

-- | What `divOrThrow` and `modOrThrow` throw: the divisor was zero.
data DivByZero = MkDivByZero

-- | `x / y`, but by zero a throw, not 0 (the prelude's division is
-- | total): for a caller that would hear of it.  Whether the divisor is
-- | zero is the type's to say (`IsZero`).
divOrThrow : {a : Type}
           -> {e : HFunctor}
           -> {{div : Division a}}
           -> {{z : IsZero a}}
           -> {{ev : exception DivByZero <: e}}
           -> a
           -> a
           -> Co e a
divOrThrow x y =
  if z.isZero y then throw (MkDivByZero : DivByZero) else pure (div.div x y)

-- | `x % y`, but by zero a throw, not `x`.
modOrThrow : {a : Type}
           -> {e : HFunctor}
           -> {{mod : Remainder a}}
           -> {{z : IsZero a}}
           -> {{ev : exception DivByZero <: e}}
           -> a
           -> a
           -> Co e a
modOrThrow x y =
  if z.isZero y then throw (MkDivByZero : DivByZero) else pure (mod.mod x y)

-- Heard at last
--------------------------------------------------------------------------------

-- (a computation of the world whose answer is what it comes to, or what
-- was thrown, as a functor)
triedFunctor : (err : Type) -> (e : HFunctor) -> RawFunctor
triedFunctor err e =
  { f = \x -> Co e (Either err x)
  , fmap = \g m ->
        bind m (\r -> val (either (\s -> Left s) (\x -> Right (g x)) r))
  }

-- | A handler of `exception err` into the rest of the world, `e`: a throw no
-- | `recover` hears ends the computation, `Left` what was thrown.  An
-- | operation of `e`'s is done as it is; one that holds a computation
-- | of its own, run apart (browser.dom's `on`, an event's), has none of
-- | its throws heard here -- one no `recover` of its own hears abandons
-- | that run.
attempted : (err : Type) -> (e : HFunctor) -> Handler ((exception err) <+> e)
attempted err e =
  { M = \x -> Co e (Either err x)
  , ret = \x -> val (Right x)
  , bind = \m k -> bind m (\r -> either (\s -> val (Left s)) k r)
  , malg = \p -> case p of
      InL t -> case t of
        Throw s -> val (Left s)
        Catch c h -> bind c (\r -> either h (\x -> val (Right x)) r)
      InR q ->
        op
          (e.hmap
             (triedFunctor err e)
             (coFunctor e)
             (\m -> bind m (\r -> either (\s -> abandon) val r))
             q)
          (\x -> val (Right x))
  }

-- | `c`, its throws heard: `Right` what it comes to, or `Left` what was
-- | thrown and heard by no `recover` (remote's calls that came to
-- | no answer, for one).
attempt : (err : Type)
        -> (e : HFunctor)
        -> {a : Type}
        -> Co (exception err <+> e) a
        -> Co e (Either err a)
attempt err e c = handle (attempted err e) c
