-- The basic types and what is done with them: Nat, Bool, Unit, Empty, pairs,
-- Maybe, Either, lists; numbers and strings, by the primitives, with their
-- operators.

-- | The natural numbers.
data Nat = Zero | Succ Nat

data Bool = True | False

data Unit = MkUnit

data Empty

data Pair a b = MkPair a b

data Maybe a = Nothing | Just a

data Either a b = Left a | Right b

data List a = Nil | Cons a (List a)

-- Functions
--------------------------------------------------------------------------------

id :: {a :: Type} -> a -> a
id x = x

const :: {a b :: Type} -> a -> b -> a
const x _ = x

flip :: {a b c :: Type} -> (a -> b -> c) -> b -> a -> c
flip f y x = f x y

compose :: {a b c :: Type} -> (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)

-- The operators: `||` loosest, then `&&`, the comparisons, then `+ -` and
-- `++` (unrelated: `a + b ++ c` is refused), then `* / %`; `$` below all
--------------------------------------------------------------------------------

infixr ||
infixr && above ||
infix == /= < <= > >= above &&
infixl + - above == /= < <= > >=
infixl * / % above + -
infixr ++ above == /= < <= > >=
infixr $ below ||

-- | Application, loosest: `f $ g $ x` is `f (g x)`.
($) :: {a b :: Type} -> (a -> b) -> a -> b
($) f x = f x

-- Bool
--------------------------------------------------------------------------------

not :: Bool -> Bool
not True = False
not False = True

(&&) :: Bool -> Bool -> Bool
(&&) True b = b
(&&) False _ = False

(||) :: Bool -> Bool -> Bool
(||) True _ = True
(||) False b = b

-- Numbers (integers, unbounded)
--------------------------------------------------------------------------------

foreign import intAdd :: Int -> Int -> Int
foreign import intSub :: Int -> Int -> Int
foreign import intMul :: Int -> Int -> Int
foreign import intDiv :: Int -> Int -> Int
foreign import intMod :: Int -> Int -> Int
foreign import intEq :: Int -> Int -> Bool
foreign import intLt :: Int -> Int -> Bool
foreign import intLe :: Int -> Int -> Bool
foreign import intShow :: Int -> String

(+) :: Int -> Int -> Int
(+) = intAdd

(-) :: Int -> Int -> Int
(-) = intSub

(*) :: Int -> Int -> Int
(*) = intMul

-- | Division rounding down; by 0, `abandon`.
(/) :: Int -> Int -> Int
(/) = intDiv

-- | The remainder of `/`, of the sign of the divisor.
(%) :: Int -> Int -> Int
(%) = intMod

(==) :: Int -> Int -> Bool
(==) = intEq

(/=) :: Int -> Int -> Bool
(/=) a b = not (intEq a b)

(<) :: Int -> Int -> Bool
(<) = intLt

(<=) :: Int -> Int -> Bool
(<=) = intLe

(>) :: Int -> Int -> Bool
(>) a b = intLt b a

(>=) :: Int -> Int -> Bool
(>=) a b = intLe b a

min :: Int -> Int -> Int
min a b = if a <= b then a else b

max :: Int -> Int -> Int
max a b = if a <= b then b else a

showInt :: Int -> String
showInt = intShow

-- Strings
--------------------------------------------------------------------------------

foreign import strAppend :: String -> String -> String
foreign import strLength :: String -> Int
foreign import strSlice :: String -> Int -> Int -> String
foreign import strEq :: String -> String -> Bool
foreign import strLt :: String -> String -> Bool

(++) :: String -> String -> String
(++) = strAppend

-- Pairs, Maybe, Either
--------------------------------------------------------------------------------

fst :: {a b :: Type} -> Pair a b -> a
fst (MkPair x y) = x

snd :: {a b :: Type} -> Pair a b -> b
snd (MkPair x y) = y

maybe :: {a b :: Type} -> b -> (a -> b) -> Maybe a -> b
maybe d f Nothing = d
maybe d f (Just x) = f x

fromMaybe :: {a :: Type} -> a -> Maybe a -> a
fromMaybe d Nothing = d
fromMaybe d (Just x) = x

either :: {a b c :: Type} -> (a -> c) -> (b -> c) -> Either a b -> c
either f g (Left x) = f x
either f g (Right y) = g y

-- Lists
--------------------------------------------------------------------------------

map :: {a b :: Type} -> (a -> b) -> List a -> List b
map f Nil = Nil
map f (Cons x xs) = Cons (f x) (map f xs)

foldr :: {a b :: Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z Nil = z
foldr f z (Cons x xs) = f x (foldr f z xs)

foldl :: {a b :: Type} -> (b -> a -> b) -> b -> List a -> b
foldl f z Nil = z
foldl f z (Cons x xs) = foldl f (f z x) xs

filter :: {a :: Type} -> (a -> Bool) -> List a -> List a
filter p Nil = Nil
filter p (Cons x xs) = if p x then Cons x (filter p xs) else filter p xs

length :: {a :: Type} -> List a -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

concatList :: {a :: Type} -> List a -> List a -> List a
concatList Nil ys = ys
concatList (Cons x xs) ys = Cons x (concatList xs ys)

reverse :: {a :: Type} -> List a -> List a
reverse xs = foldl (\acc x -> Cons x acc) Nil xs

-- Nat
--------------------------------------------------------------------------------

-- | Recursion on `Nat`, non-dependent.
natrec :: {c :: Type} -> c -> (Nat -> c -> c) -> Nat -> c
natrec z s Zero = z
natrec z s (Succ n) = s n (natrec z s n)

-- >>> natrec (c := Nat) Zero (\_ n -> Succ (Succ n)) (Succ (Succ Zero))
-- Succ (Succ (Succ (Succ Zero)))

-- >>> 1 + 2 * 3 - 4 / 2
-- 5

-- >>> "count: " ++ showInt (7 % 3)
-- "count: 1"

-- >>> 1 < 2 && 2 <= 2 || False
-- True

-- >>> length (map (\x -> x * 2) (Cons 1 (Cons 2 (Cons 3 Nil))))
-- 3

-- >>> fromMaybe 0 (Just 4)
-- 4
