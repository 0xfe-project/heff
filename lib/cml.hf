-- Concurrent ML (Reppy), on std.domain: threads that meet at channels,
-- and events, their synchronous operations, composed before one of
-- them is committed.  An event is a computation run up to its commit
-- point: a `send` waits for its receiver and a `recv` for its sender,
-- each a base event; `choose` runs each of several branches up to its
-- first base event and commits one of them, what follows that base
-- event the wrap, the others abandoned -- told so where they asked, by
-- `withNack`.  The threads run on as many domains as the machine has
-- cores.  Import it by a name, `import cml as CML`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import cml as CML
-- import co
-- import std.domain as Domain
--
-- -- | what comes on `a`, one more, sent on `b`, for ever
-- ponger : {e w : HFunctor}
--        -> {{cm : CML.cml w <: e}}
--        -> CML.Chan w Int
--        -> CML.Chan w Int
--        -> Co e Unit
-- ponger a b = do
--   x <- CML.recv a
--   CML.send b (x + 1)
--   ponger a b
--
-- -- | main and one thread: 0 sent there, and 1 back
-- pinged : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Co e Int
-- pinged = do
--   a <- CML.newChan
--   b <- CML.newChan
--   CML.spawn (ponger a b)
--   CML.send a 0
--   CML.recv b
--
-- -- | `Just 1`, the threads on domains
-- pingedHere : {w : HFunctor}
--            -> {{dm : Domain.domain <: w}}
--            -> Co w (Maybe Int)
-- pingedHere = do
--   with _ := CML.threads do
--     pinged (w := w)
-- ```
--
-- Operation | What it does
-- --- | ---
-- `spawn c` | `c`, of the scheduler's world `cml w <+> Custodian.custodian <+> w`, is a thread of its own, its `with`s giving to the custodian this one's give to here; this one goes on
-- `yield` | the next thread's turn; this one's again after those ready
-- `newChan` | a channel, of what its type says
-- `send ch x` | `x` on `ch`, once a thread takes it: waits for the receiver; a base event
-- `recv ch` | what a thread sends on `ch`, once one does: waits for the sender; a base event
-- `newIVar` | an ivar, holding nothing yet
-- `putIVar iv x` | `iv` holds `x` now, its readers given it; once, a second put abandons; never waits
-- `readIVar iv` | what `iv` holds, waiting until it does; a base event
-- `never` | a base event never ready
-- `choose cs` | one of the branches: each run to its first base event, one of those committed, at random where several can be
-- `withNack f` | `f nack`, the nack `nack` ready once a `choose` is left without this branch
-- `awaitNack nack` | once `nack` is ready, its `choose` left without its branch; a base event
-- `scheduled c` | `c` and its threads run, on domains, in the scheduler's world `w`, which need name no custodian: `Just` main's answer, or `Nothing` where every thread waits; failing as the first thread that failed
-- `scheduledWithReactor c` | the same, a thread's operation of the world that would wait pending in its domain's reactor, the others going on
-- `with _ := threads do ss` | `scheduled`'s, `ss` main, a `with`: the block's world with cml and a custodian, the `with` done once its threads are
-- `with _ := threadsWithReactor do ss` | `scheduledWithReactor`'s, as a `with`
--
-- An event is a computation, and its base events are operations: a
-- `send`, a `recv`, an ivar's read, a nack's await, `never`.  Run alone, an event is
-- its first base event, committed once it can be, the thread waiting
-- until then, and what follows.  In a `choose`, each branch is run, in
-- order and on this thread, up to its first base event -- what comes
-- before it is done as it comes, a guard's work: a channel made, a
-- request sent, a thread spawned -- and that base event is the
-- branch's commit point; a branch that ends before one is ready at
-- once, its value what it ends with, and a `choose` in a branch is
-- that branch's base events, so a protocol of several messages is one
-- event, put in a `choose` with others and committed at once, which is
-- what Go's `select` cannot do.  Where one of the base events can be
-- committed now -- a sender waiting at the channel of a `recv`, a
-- receiver at the channel of a `send`, an ivar written, a branch ended
-- -- it is, one of them drawn at random where several can (as Reppy's
-- CML and Racket's `sync` choose: no branch has priority over
-- another); else the thread waits at every one of them, and goes on
-- when another thread's base event meets one.  The branch committed
-- goes on from its base event: what follows it is the wrap, as
-- effectful as any statements.  The others are abandoned at their
-- commit points, and each `withNack` met on the way to one of them,
-- not on the way to the one committed, has its nack ready: the
-- branches not chosen told so.  Under `scheduledWithReactor`, an
-- operation of the world is a base event too, where it would wait: a
-- socket read, a request, a sleep, pending in the reactor of the domain
-- that started it; in a `choose`, committed once it is done, where no
-- other base event was first, and else let go of, undone -- so a
-- branch of `Time.sleep d` is a time limit.  However a `choose` is
-- left, the branches not taken are told: a thread whose guard work in
-- a `choose` fails, after a `withNack` there, has each nack made so far
-- ready before it fails, and is counted no more; and a
-- thread the run drops before it goes on from a `choose` -- waiting
-- there, or met and not yet run again, where main is done or every
-- thread waits -- has its offer withdrawn and every nack of that
-- `choose` ready, once the domains have stopped, none failed.  No
-- thread of the run takes a turn after that, so such a nack readies
-- none of them: it is for those reading it from elsewhere, a run of
-- the scheduler inside one of the threads, or one after it.  A
-- `choose` run alone, in a computation an operation of `w` holds
-- (below), tells no nack.
--
-- The threads are the scheduler's, a handler in the language, and the
-- domains are their workers: a thread is a resumption, run by a
-- worker from where it stopped to where it next ends, gives up its
-- turn (`yield`), or waits at a base event.  A thread readied by one a
-- worker runs -- spawned, or met by its base event -- is kept in that
-- worker's slot, the next it runs, where the slot is empty, and no
-- domain is woken for it: a thread that hands a value on and then
-- waits hands its domain on to the one it readied, no domain waking
-- and no mutex taken.  The others ready are in one queue under a
-- mutex, which a worker takes from when its slot is empty, waiting on
-- a condition while the queue is empty too; a domain waiting there is
-- woken for each put in, where one waits.  A worker that has run 64
-- (`batchLimit`) from its slot in a row puts the next behind those in
-- the queue, where any are, so that they are not passed over; one with
-- nothing to do takes a thread from another's slot before it waits;
-- and a thread's slot is emptied into the queue before an operation of
-- the world's, which may hold its domain a while.  `yield` puts the
-- thread behind those ready, in its slot only where none is.  The
-- worker counts a thread's steps, each operation of it the worker
-- handles, as an engine of Chez Scheme's counts its fuel: a thread that
-- has gone on for 256 (`fuelPerRun`) since the worker took it, without
-- stopping, is put behind those ready as at a `yield` where another is
-- ready -- in the slot or the queue -- and the worker takes the next, its
-- slot's first, so that no thread is passed over for one that goes on,
-- and none needs a timer; where none is ready, it goes on, its fuel full
-- again, and a thread alone pays the count only.  A thread that waits
-- leaves an offer at each of its base events' channels and ivars: one
-- cell (`Domain.Atomic`) for all of them, claimed once, by `Domain.cas`, by
-- whichever other thread's base event meets one of them first, which readies the
-- waiting thread with what came; so a waiting thread occupies no
-- worker, and a `choose` commits one base event at most.  What a
-- readied thread does next is left to the worker that takes it (its
-- turn is a function of that worker, its continuation unapplied until
-- then): the one readying it applies nothing of another thread's, and
-- holds no mutex while a thread computes.  Committing, a thread holds the
-- mutexes of its channels and ivars, each once, in the order of their numbers,
-- from looking for a partner until its offers are left, so that no
-- thread misses a partner leaving its offer meanwhile, and none waits
-- for another round a cycle; with them held it first asks of each base
-- event whether it can be committed, claiming nothing, then draws one
-- of those that can and claims its partner -- where the partner's offer
-- was claimed meanwhile, through another channel, that one is dropped
-- and another drawn.  The offers waiting at a channel are a deque (one
-- step to put at the back, however many wait); the partner is drawn
-- from among the first few unclaimed at its front (`window`, 4), the
-- others put back before the rest in their order, so that the choice
-- among several waiting is not first come first served, yet every
-- waiter reaches the front and is met (offers found claimed are
-- dropped as they are met).  The draws are a linear congruential
-- sequence, its last kept in one cell of the scheduler's, so that in
-- JavaScript, where one domain takes turns, a program draws the same
-- each run.  `scheduled` counts the threads running or ready, one more
-- for a thread as it is readied
-- (before the one readying it may itself wait), one fewer for one that
-- waits or ends (one put behind those ready, by a `yield` or by its
-- fuel, is counted still): at none left before main is done every
-- thread waits at a base event, a deadlock, and it comes to `Nothing`.
-- Main's answer ends it all, the other threads dropped where they
-- stopped.  A thread gives up its domain at its operations alone, and
-- its fuel is counted at them: long pure work in a thread, with no
-- operation in it, cannot be stopped, and holds its domain until it
-- comes to one -- the threads there wait for it, the one in its slot
-- too, until a domain with nothing to do takes it, or the thread comes
-- to an operation of the world's.  That is the program's own to weigh:
-- a pure loop that is to give the others their turns performs `yield`
-- every so many rounds, what comes after it computed once the yield
-- has taken effect.  A computation held by an operation of `w`
-- (`Domain.tried c` holds `c`) is run alone, as the operation does
-- it: its `spawn`s, channels and ivars are the scheduler's, but a
-- base event in it has no thread to meet, and is abandoned -- unless
-- it is in a `choose` with a branch that ends before its own.
--
-- A thread is a closed computation of the scheduler's world, `cml w <+>
-- w`: `spawn c` takes `c` as it is, and none of the handlers around the
-- spawn -- a `recover`, a state, a `with`'s resource -- is around the
-- thread, which runs on, on another domain, after they are done.  What
-- a thread needs it opens itself (its own `attempt`, its own `with`), or
-- is given as a value (a channel, a socket, a nack).  So each thread is
-- under its own handlers alone, however many generations spawned it.  A
-- `choose`'s branches are not threads: they run in the choosing thread,
-- in what is around the `choose`, and so in its world.
--
-- A thread's world has a custodian of the scheduler's, `cml w <+>
-- custodian <+> w`, which covers the one outside.  The scheduler's world
-- `w` need not name one: `scheduled` connects its custodian to the
-- runtime's custodians, through the domains' (`Domain.rooted`), so a
-- `main` that starts cml names none.  A
-- thread is a user of a custodian, not one of its
-- things: what it carries is which custodian its `with`s give to, the
-- one theirs gave to where it was spawned, and no shutdown stops it.  A
-- `with k := Custodian.custody do` (or `contained`) in a thread is
-- answered by cml, as Racket's `parameterize` is: the body stays in the
-- thread -- it waits at a channel, and gives up its turn, as anywhere
-- else -- and its `with`s give to `k` for its extent, the one before
-- after it.  That is the thread's computation's, carried by its
-- continuation wherever its turns are taken, so no other thread's
-- `with`s give to `k`, and a throw that leaves the body leaves `k` with
-- it.  The custodian's other operations are passed on to the one
-- outside, `k` current there for them: a thing given it, a custodian
-- made, a release kept.  So one thread may serve each of its
-- connections in a `contained` custodian of its own.
--
-- A thread that fails -- abandons, fails in the runtime, or a throw no
-- handler of its own hears comes to the scheduler's world as a failure
-- -- is done with that, caught by the worker running it, which goes on
-- with its loop: the other threads are not stopped.  (One catch around
-- a worker's whole loop, not one around each turn; main's turns, alone,
-- each catch their own, so that a failure of main's is known as such.)
-- The scope collects it: once the run is over -- main done, or every
-- thread waiting -- and the domains stopped, the first failure of a
-- thread is the scope's, `scheduled` (or the `with`) failing as that
-- thread did, its words kept (`Domain.fail`), caught by a `Domain.tried`
-- around it as a `Left`.  A failure of main's own ends the run there, as
-- main's answer would, the other threads dropped, and is the scope's the
-- same way.
--
-- Under `scheduledWithReactor`, each worker opens a group of the reactor
-- on its domain, its threads' operations of the world started there:
-- one done at once goes on, one pending stops its thread, counted still
-- (no deadlock while the world may come), and the worker takes its step
-- once it is done, the thread readied in its slot.  A worker asks its
-- reactor, not waiting, every 8 (`roundsBetween`) rounds; with nothing
-- to take and something pending, it waits in the reactor instead of on
-- the condition, and a domain putting a turn among those ready where
-- none waits on the condition wakes it there, as it does to stop.  A
-- `choose` whose branch's operation is pending starts it in a group of
-- its own, within the worker's: committed by a partner, the choice's
-- group is closed by that worker, which the partner asks to, its
-- operations let go of on the domain whose they are.

module cml
  ( cml
  , Chan
  , IVar
  , spawn
  , yield
  , newChan
  , send
  , recv
  , newIVar
  , putIVar
  , readIVar
  , never
  , choose
  , Nack
  , withNack
  , awaitNack
  , scheduled
  , scheduledWithReactor
  , Threads
  , threads
  , ThreadsWithReactor
  , threadsWithReactor
  , instanceBinderThreads
  , instanceBinderThreadsWithReactor
  , instanceHolderThreads
  , instanceHolderThreadsWithReactor
  )

import co
import custodian as Custodian
import std.deque as Deque
import std.domain as Domain
import std.reactor as Reactor

-- Turns
--------------------------------------------------------------------------------

-- (a worker's slot, for the turn it is to take next: the worker's
-- number; whether it holds one -- `slotEmpty`, `slotHeld`, or
-- `slotChanging` while a domain puts one in or takes it out -- and the
-- turn, the thread run from where it stopped, given the worker that
-- takes it)
data Slot (w : HFunctor)
  = MkSlot Int (Domain.Atomic Int) (Domain.Atomic
                                      (Maybe
                                         (Maybe (Slot w)
                                          -> Co
                                            (w <+> Custodian.custodian)
                                            Unit)))

-- (where a thread is readied from: a worker, as its slot; or none, a
-- computation run alone or `scheduled` starting main)
type Runner (w : HFunctor) = Maybe (Slot w)

-- (a thread's turn, readied: the thread run from where it stopped,
-- given the worker that takes it)
type Turn (w : HFunctor) = Runner w -> Co (w <+> Custodian.custodian) Unit

slotEmpty : Int
slotEmpty = 0

slotHeld : Int
slotHeld = 1

slotChanging : Int
slotChanging = 2

-- (an empty slot, of the `i`th worker)
slotMade : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Int
         -> Co (w <+> Custodian.custodian) (Slot w)
slotMade i = do
  state <- Domain.newAtomic slotEmpty
  held <- Domain.newAtomic (Nothing : Maybe (Turn w))
  pure (MkSlot i state held)

-- (the number of the slot's worker)
slotNumber : {w : HFunctor} -> Slot w -> Int
slotNumber (MkSlot i state held) = i

-- (whether the slot holds a turn, as far as this domain sees now)
isHolding : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Slot w
          -> Co (w <+> Custodian.custodian) Bool
isHolding (MkSlot i state held) = do
  s <- Domain.get state
  pure (s == slotHeld)

-- (the turn kept in the slot, where it is empty: whether it was.  By
-- the slot's worker alone, so that a slot found empty stays so until
-- this fills it: the other domains only take out what a slot holds)
keptIn : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Slot w
       -> Turn w
       -> Co (w <+> Custodian.custodian) Bool
keptIn (MkSlot i state held) t = do
  s <- Domain.get state
  if s == slotEmpty
  then do
    Domain.set held (Just t)
    Domain.set state slotHeld
    pure True
  else pure False

-- (the turn the slot holds, taken out, where it holds one and no other
-- domain is taking it meanwhile)
takenFrom : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Slot w
          -> Co (w <+> Custodian.custodian) (Maybe (Turn w))
takenFrom (MkSlot i state held) = do
  ok <- Domain.cas state slotHeld slotChanging
  if ok
  then do
    t <- Domain.get held
    Domain.set held (Nothing : Maybe (Turn w))
    Domain.set state slotEmpty
    pure t
  else pure Nothing

-- Offers, channels and ivars
--------------------------------------------------------------------------------

-- (a sync's offer, as the channels and ivars it waits at hold it:
-- whether it has been claimed.  One cell for every base event of the
-- sync, so that one of them is claimed at most, by whichever party
-- claims it first.)
data Offer = MkOffer (Domain.Atomic Bool)

-- (a sender waiting at a channel: its offer, the value, and what
-- readies its thread once a receiver has taken it, given where the
-- receiver runs)
data Sender (w : HFunctor) a
  = MkSender Offer a (Runner w -> Co (w <+> Custodian.custodian) Unit)

-- (a receiver waiting at a channel or an ivar: its offer, and what
-- readies its thread, given the value and where the one giving it runs)
data Receiver (w : HFunctor) a
  = MkReceiver Offer (a -> Runner w -> Co (w <+> Custodian.custodian) Unit)

-- (those waiting at a channel or an ivar, the longest first: a deque,
-- an offer put at its back, the partner taken from among the first few
-- at its front)
type Senders (w : HFunctor) a = Domain.Atomic (Deque.Deque (Sender w a))

type Receivers (w : HFunctor) a = Domain.Atomic (Deque.Deque (Receiver w a))

-- (the offer of a sender, and of a receiver)
senderOffer : {w : HFunctor} -> {a : Type} -> Sender w a -> Offer
senderOffer (MkSender off v wake) = off

receiverOffer : {w : HFunctor} -> {a : Type} -> Receiver w a -> Offer
receiverOffer (MkReceiver off wake) = off

-- (whether the offer has been claimed)
isClaimed : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Offer
          -> Co (w <+> Custodian.custodian) Bool
isClaimed (MkOffer claimed) = Domain.get claimed

-- (the offer claimed, where it was not yet: whether it was, by this)
claimedOffer : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Offer
             -> Co (w <+> Custodian.custodian) Bool
claimedOffer (MkOffer claimed) = Domain.cas claimed False True

-- | A channel of `a`s, of threads run in the world `w`: a rendezvous,
-- | a sender and a receiver each waiting for the other.  (Its number,
-- | which orders the mutexes a sync holds; its mutex; the senders and
-- | the receivers waiting at it.)
data Chan (w : HFunctor) a
  = MkChan Int Domain.Mutex (Senders w a) (Receivers w a)

-- | An ivar: a variable of threads run in the world `w`, written once
-- | and read any number of times, each reader waiting until it is
-- | written -- a signal.  (Its number, its mutex, what it holds, and
-- | the readers waiting for it.)
data IVar (w : HFunctor) a
  = MkIVar Int Domain.Mutex (Domain.Atomic (Maybe a)) (Receivers w a)

-- Base events
--------------------------------------------------------------------------------

-- | A value of some type, the type hidden: what an operation of a type
-- | of its own holds (the effect has no parameter for it).
type Some (f : Type -> Type) = (r : Type) -> ((a : Type) -> f a -> r) -> r

-- (what it holds, changed, of whatever type)
someThen : {f g : Type -> Type}
         -> ({a : Type} -> f a -> g a)
         -> Some f
         -> Some g
someThen h s = \r use -> s r (\a v -> use a (h v))

-- (a send as a base event: the channel, the value, and what comes after
-- it, once the value is taken)
data SendOn (w : HFunctor) x a = MkSendOn (Chan w a) a (Unit -> x)

-- (a receive: the channel, and what comes after it, given the value)
data RecvOn (w : HFunctor) x a = MkRecvOn (Chan w a) (a -> x)

-- (an ivar's read: the ivar, and what comes after it, given its value)
data ReadOn (w : HFunctor) x a = MkReadOn (IVar w a) (a -> x)

sendOnThen : {w : HFunctor}
           -> {x y a : Type}
           -> (x -> y)
           -> SendOn w x a
           -> SendOn w y a
sendOnThen g (MkSendOn ch v k) = MkSendOn ch v (\u -> g (k u))

recvOnThen : {w : HFunctor}
           -> {x y a : Type}
           -> (x -> y)
           -> RecvOn w x a
           -> RecvOn w y a
recvOnThen g (MkRecvOn ch k) = MkRecvOn ch (\v -> g (k v))

readOnThen : {w : HFunctor}
           -> {x y a : Type}
           -> (x -> y)
           -> ReadOn w x a
           -> ReadOn w y a
readOnThen g (MkReadOn iv k) = MkReadOn iv (\v -> g (k v))

-- (a base event, and what comes after it, an `x`: a send, a receive, an
-- ivar's read, or a branch of a `choose` ended, ready at once.  What
-- comes after is a function in each, computed where the event commits,
-- not where a continuation is put after it: a branch ended with what
-- comes after it computed at once would compute the next `choose`'s,
-- and its branches' theirs, every branch of every choice to come)
data Base (w : HFunctor) x
  = SendBase (Some (SendOn w x))
  | RecvBase (Some (RecvOn w x))
  | ReadBase (Some (ReadOn w x))
  | AlwaysBase (Unit -> x)

baseThen : {w : HFunctor} -> {x y : Type} -> (x -> y) -> Base w x -> Base w y
baseThen g (SendBase s) = SendBase (someThen (sendOnThen g) s)
baseThen g (RecvBase s) = RecvBase (someThen (recvOnThen g) s)
baseThen g (ReadBase s) = ReadBase (someThen (readOnThen g) s)
baseThen g (AlwaysBase k) = AlwaysBase (\u -> g (k u))

-- The effect
--------------------------------------------------------------------------------

-- (a channel made: what comes after, given it)
data MakingChan (w : HFunctor) x a = MkMakingChan (Chan w a -> x)

-- (an ivar made: what comes after, given it)
data MakingIVar (w : HFunctor) x a = MkMakingIVar (IVar w a -> x)

-- (an ivar written: the ivar, the value, and what comes after -- a
-- function, computed where the write is done, not where a
-- continuation is put after it, as `Base`'s are)
data Putting (w : HFunctor) x a = MkPutting (IVar w a) a (Unit -> x)

makingChanThen : {w : HFunctor}
               -> {x y a : Type}
               -> (x -> y)
               -> MakingChan w x a
               -> MakingChan w y a
makingChanThen g (MkMakingChan k) = MkMakingChan (\ch -> g (k ch))

makingIVarThen : {w : HFunctor}
               -> {x y a : Type}
               -> (x -> y)
               -> MakingIVar w x a
               -> MakingIVar w y a
makingIVarThen g (MkMakingIVar k) = MkMakingIVar (\iv -> g (k iv))

puttingThen : {w : HFunctor}
            -> {x y a : Type}
            -> (x -> y)
            -> Putting w x a
            -> Putting w y a
puttingThen g (MkPutting iv v k) = MkPutting iv v (\u -> g (k u))

-- (a choice: its branches, each a computation run to its first base
-- event, and what comes after the one committed, given what its branch
-- came to)
data Choosing (m : Type -> Type) x a = MkChoosing (List (m a)) (a -> x)

choosingThen : {m : Type -> Type}
             -> {x y a : Type}
             -> (x -> y)
             -> Choosing m x a
             -> Choosing m y a
choosingThen g (MkChoosing bs k) = MkChoosing bs (\v -> g (k v))

choosingMapped : {m n : Type -> Type}
               -> {x a : Type}
               -> ({b : Type} -> m b -> n b)
               -> Choosing m x a
               -> Choosing n x a
choosingMapped nt (MkChoosing bs k) = MkChoosing (List.map (\b -> nt b) bs) k

-- (a thread as `spawn` hands it to the scheduler: a computation of
-- cml's world, closed -- no handler of where it was spawned is around
-- it -- written for whichever world it is put in, given where the
-- operations of `f`, cml's, and of `w`, the scheduler's world, go
-- there.  So it names cml's operations by their functor, `f`, not by
-- `cml w`, which is made of them)
type Thread (f : (Type -> Type) -> Type -> Type) (w : HFunctor) =
  (e : HFunctor)
  -> ({m : Type -> Type} -> {x : Type} -> f m x -> e.f m x)
  -> (w <: e)
  -> Co e Unit

-- (an operation of `cml`; `Settled` is the scheduler's own, no
-- program's: a thread gone on from a choice it waited at with nacks,
-- the choice's number)
data CmlF (w : HFunctor) (m : Type -> Type) x
  = Spawn (Thread (SumF (CmlF w) Custodian.CustodianF) w) (Unit -> x)
  | Yield (Unit -> x)
  | NewChan (Some (MakingChan w x))
  | NewIVar (Some (MakingIVar w x))
  | PutIVar (Some (Putting w x))
  | Sync (List (Base w x))
  | Choose (Some (Choosing m x))
  | MadeNack (IVar w Unit) (Unit -> x)
  | Settled Int (Unit -> x)

-- (what comes after an operation, changed)
stepThen : {w : HFunctor}
         -> {m : Type -> Type}
         -> {x y : Type}
         -> (x -> y)
         -> CmlF w m x
         -> CmlF w m y
stepThen g (Spawn c k) = Spawn c (\u -> g (k u))
stepThen g (Yield k) = Yield (\u -> g (k u))
stepThen g (NewChan s) = NewChan (someThen (makingChanThen g) s)
stepThen g (NewIVar s) = NewIVar (someThen (makingIVarThen g) s)
stepThen g (PutIVar s) = PutIVar (someThen (puttingThen g) s)
stepThen g (Sync bs) = Sync (List.map (baseThen g) bs)
stepThen g (Choose s) = Choose (someThen (choosingThen g) s)
stepThen g (MadeNack iv k) = MadeNack iv (\u -> g (k u))
stepThen g (Settled n k) = Settled n (\u -> g (k u))

-- | For CML threads run in the world `w`: spawned and yielding,
-- | channels and ivars made, and events synced on.  A thread's world is
-- | `cml w <+> custodian <+> w`: the custodian there is the scheduler's,
-- | which covers the one outside.
cml : HFunctor -> HFunctor
cml w =
  { f = CmlF w
  , hfmap = \m g p -> stepThen g p
  , hmap = \m n nt p -> case p of
      Spawn c k -> Spawn c k
      Yield k -> Yield k
      NewChan s -> NewChan s
      NewIVar s -> NewIVar s
      PutIVar s -> PutIVar s
      Sync bs -> Sync bs
      Choose s -> Choose (someThen (choosingMapped nt) s)
      MadeNack iv k -> MadeNack iv k
      Settled n k -> Settled n k
  }

-- (a thread as `spawn` hands it over: of cml's world, its operations
-- cml's own and the custodian's)
type Spawned (w : HFunctor) = Thread (SumF (CmlF w) Custodian.CustodianF) w

-- (a thread spawned where the `with`s give to `k`: its `with`s give to
-- `k` too, from its start)
threadIn : {w : HFunctor} -> Custodian.Custodian -> Spawned w -> Spawned w
threadIn k c t inCml inWorld =
  Custodian.custodied (cu := \p -> inCml (InR p)) k (c t inCml inWorld)

-- (... where `Nothing` is, the one outside: the thread as it is)
threadAt : {w : HFunctor} -> Maybe Custodian.Custodian -> Spawned w -> Spawned w
threadAt Nothing c = c
threadAt (Just k) c = threadIn k c

-- Threads
--------------------------------------------------------------------------------

-- (an operation of a sum put where its side's goes)
summedInto : {h k e : HFunctor} -> (h <: e) -> (k <: e) -> (h <+> k <: e)
summedInto l r (InL p) = l p
summedInto l r (InR q) = r q

-- | `c`, a thread of its own; this one goes on.  `c` is a computation
-- | of the scheduler's world, `cml w <+> Custodian.custodian <+> w`: no handler around the
-- | spawn is around it, so what it needs -- a `recover`, a state, a
-- | resource -- it opens itself, or is given as a value.
spawn : {e w : HFunctor}
      -> {{cm : cml w <: e}}
      -> Co (cml w <+> Custodian.custodian <+> w) Unit
      -> Co e Unit
spawn c =
  op
    (cm
       (Spawn
          (\t inCml inWorld ->
             lift
               (inj := summedInto
                 (h := cml w <+> Custodian.custodian)
                 (k := w)
                 (e := t)
                 inCml
                 inWorld)
               c)
          (\u -> u)))
    val

-- | The next thread's turn; this one's again after those ready.
yield : {e w : HFunctor} -> {{cm : cml w <: e}} -> Co e Unit
yield = op (cm (Yield (\u -> u))) val

-- Channels and ivars
--------------------------------------------------------------------------------

-- | A channel of `a`s.
newChan : {e w : HFunctor}
        -> {a : Type}
        -> {{cm : cml w <: e}}
        -> Co e (Chan w a)
newChan = op (cm (NewChan (\r use -> use a (MkMakingChan (\ch -> ch))))) val

-- | An ivar, holding nothing yet.
newIVar : {e w : HFunctor}
        -> {a : Type}
        -> {{cm : cml w <: e}}
        -> Co e (IVar w a)
newIVar = op (cm (NewIVar (\r use -> use a (MkMakingIVar (\iv -> iv))))) val

-- | The ivar holds `v` now, every thread waiting to read it given it;
-- | once: a second put is abandoned.  Never waits.
putIVar : {e w : HFunctor}
        -> {a : Type}
        -> {{cm : cml w <: e}}
        -> IVar w a
        -> a
        -> Co e Unit
putIVar iv v =
  op (cm (PutIVar (\r use -> use a (MkPutting iv v (\u -> u))))) val

-- Events
--------------------------------------------------------------------------------

-- | `v` sent on the channel, once a thread takes it: waits for the
-- | receiver.  A base event: in a `choose`, its branch's commit point.
send : {e w : HFunctor}
     -> {a : Type}
     -> {{cm : cml w <: e}}
     -> Chan w a
     -> a
     -> Co e Unit
send ch v =
  op (cm (Sync [SendBase (\r use -> use a (MkSendOn ch v (\u -> u)))])) val

-- | What a thread sends on the channel, once one does: waits for the
-- | sender.  A base event.
recv : {e w : HFunctor}
     -> {a : Type}
     -> {{cm : cml w <: e}}
     -> Chan w a
     -> Co e a
recv ch =
  op (cm (Sync [RecvBase (\r use -> use a (MkRecvOn ch (\v -> v)))])) val

-- | What the ivar holds, waiting until it is written.  A base event.
readIVar : {e w : HFunctor}
         -> {a : Type}
         -> {{cm : cml w <: e}}
         -> IVar w a
         -> Co e a
readIVar iv =
  op (cm (Sync [ReadBase (\r use -> use a (MkReadOn iv (\v -> v)))])) val

-- | A base event never ready: waits for ever, and in a `choose` is
-- | never the one committed.
never : {e w : HFunctor} -> {a : Type} -> {{cm : cml w <: e}} -> Co e a
never = op (cm (Sync Nil)) val

-- | One of the branches: each run, in order, up to its first base event
-- | -- what comes before it done as it comes, a guard's work -- then one
-- | of those base events committed, whichever can be, one drawn at
-- | random where several can, none with priority over another; where
-- | none can, whichever is met first.  A branch that ends before any
-- | base event is ready at once, its value what it ends with.  The
-- | branch committed goes on from its base event, what follows it the
-- | wrap; the others are abandoned there, each `withNack` of theirs
-- | told.  A `choose` in a branch is that branch's base events.
choose : {e w : HFunctor}
       -> {a : Type}
       -> {{cm : cml w <: e}}
       -> List (Co e a)
       -> Co e a
choose bs = op (cm (Choose (\r use -> use a (MkChoosing bs (\v -> v))))) val

-- | A nack, of threads run in the world `w`: ready once the `choose`
-- | its branch is in is left without that branch.  Only `withNack`
-- | makes one, and only `awaitNack` waits for it: no thread readies it,
-- | the scheduler does.  (The ivar the scheduler writes.)
data Nack (w : HFunctor) = MkNack (IVar w Unit)

-- | `f` given its nack, the computation run: `f nack`, run as the rest
-- | of its branch, and `nack` ready once the `choose` it is in is left
-- | without this branch -- another committed, its guard work failed, or
-- | its thread dropped before going on from it -- so a thread waiting
-- | for it (`awaitNack nack`, a base event) knows it was not chosen.  A
-- | value, not a computation of this thread's world, so that a thread
-- | spawned in the guard, of the scheduler's world, can be given it.
-- | Outside a `choose`, or where its branch is the one committed and its
-- | thread goes on, `nack` is never ready.
withNack : {e w : HFunctor}
         -> {a : Type}
         -> {{cm : cml w <: e}}
         -> (Nack w -> Co e a)
         -> Co e a
withNack f = do
  nack <- (newIVar : Co e (IVar w Unit))
  op (cm (MadeNack nack (\u -> u))) val
  f (MkNack nack)

-- | Once the nack is ready: its `choose` left without its branch.  A
-- | base event, as an ivar's read is.
awaitNack : {e w : HFunctor} -> {{cm : cml w <: e}} -> Nack w -> Co e Unit
awaitNack (MkNack iv) = readIVar iv

-- The handler: a thread as a resumption
--------------------------------------------------------------------------------

-- | A thread, stopped where the scheduler has a say: done; at an
-- | operation of `cml`, what comes after it a thread again; at one of
-- | the world's, to be done in the scheduler's world; or after one,
-- | what comes next left to the worker that takes the thread on, so that what the
-- | thread computes is computed in its turn, where a failure of it is
-- | caught as the thread's, never where the world's operation ended (a
-- | reactor's step).
data Res (w : HFunctor) a
  = RDone a
  | RStep (CmlF w (Res w) (Res w a))
  | RAct (Co (w <+> Custodian.custodian) (Res w a))
  | RNext (Unit -> Res w a)

thenRes : {w : HFunctor} -> {a b : Type} -> Res w a -> (a -> Res w b) -> Res w b
thenRes (RDone x) f = f x
thenRes (RStep p) f = RStep (stepThen (\r -> thenRes r f) p)
thenRes (RAct m) f = RAct (bind m (\r -> pure (RNext (\u -> thenRes r f))))
thenRes (RNext g) f = RNext (\u -> thenRes (g u) f)

resFunctor : (w : HFunctor) -> RawFunctor
resFunctor w = { f = Res w, fmap = \g r -> thenRes r (\x -> RDone (g x)) }

-- (an operation of cml's, in `k`'s custody, given what to put the
-- computations it holds there by: a thread it spawns starts in it, and
-- the branches of a choice are in it)
stepIn : {w : HFunctor}
       -> {x : Type}
       -> Custodian.Custodian
       -> ({t : Type} -> Res w t -> Res w t)
       -> CmlF w (Res w) x
       -> CmlF w (Res w) x
stepIn k under (Spawn c next) = Spawn (threadIn k c) next
stepIn k under (Choose s) = Choose (someThen (choosingMapped under) s)
stepIn k under p = p

-- (a thread's computation, `k` the custodian its `with`s give to for
-- the extent of it, as Racket's `parameterize` has it: each operation
-- of the world, and of the custodian's, done with `k` current outside,
-- each thread spawned starting with it.  It is the computation's, so it
-- goes with the thread wherever its turns are taken, and ends with it:
-- what comes after has the one before)
inCustody : {w : HFunctor}
          -> {a : Type}
          -> Custodian.Custodian
          -> Res w a
          -> Res w a
inCustody k (RDone x) = RDone x
inCustody k (RStep p) =
  RStep
    (stepIn k (\r -> inCustody k r) (stepThen (\r -> inCustody k r) p))
inCustody k (RAct m) =
  RAct
    (Custodian.custodied
       (cu := \p -> InR p)
       k
       (bind m (\r -> pure (inCustody k r))))
inCustody k (RNext g) = RNext (\u -> inCustody k (g u))

-- (what a thread's step came to: it goes on from here; or it stopped
-- -- ended, waiting, or its turn given up -- and the domain takes
-- another; or, after an operation of the world that waited in the
-- reactor, it goes on, by the turns its thread's `turnOf` makes)
data Stepped (w : HFunctor)
  = GoesOn (Res w Unit)
  | Stopped
  | Resumed (Res w Unit) ((Unit -> Res w Unit) -> Turn w)

-- The world's operations, waited on through the reactor
--------------------------------------------------------------------------------

-- (a worker's group of the reactor: what each operation of the world
-- started in it comes to is the step of the thread that did it, to be
-- taken once it is done)
type Group (w : HFunctor) =
  Reactor.Group (Co (w <+> Custodian.custodian) (Stepped w))

-- (the reactor's operations, its evidence given: where the scheduler
-- waits on the world through it)
type Outside (w : HFunctor) =
  { open : Co (w <+> Custodian.custodian) (Group w)
  , within : Group w -> Co (w <+> Custodian.custodian) (Group w)
  , start :
        Group w
        -> Co
          (w <+> Custodian.custodian)
          (Co (w <+> Custodian.custodian) (Stepped w))
        -> Co
          (w <+> Custodian.custodian)
          (Maybe (Co (w <+> Custodian.custodian) (Stepped w)))
  , finished :
        Group w
        -> Bool
        -> Co
          (w <+> Custodian.custodian)
          (List (Co (w <+> Custodian.custodian) (Stepped w)))
  , pending : Group w -> Co (w <+> Custodian.custodian) Int
  , close : Group w -> Co (w <+> Custodian.custodian) Unit
  , wake : Group w -> Co (w <+> Custodian.custodian) Unit
  }

-- (a worker's waits on the world: its group, opened by the worker on
-- its domain, whose reactor it is; whether it waits in the reactor for
-- one of them to finish, there to be woken; and what other domains ask
-- it to do on its domain, under the scheduler's mutex)
type Waits (w : HFunctor) =
  { group : Domain.Atomic (Maybe (Group w))
  , polling : Domain.Atomic Bool
  , inbox : Domain.Atomic (List (Co (w <+> Custodian.custodian) Unit))
  }

-- (a choice whose branches have operations of the world pending: the
-- group within the worker's they are started in, closed once one branch
-- is committed; the choice's offer, which an operation finished claims,
-- as a partner would; the choice's nacks, the operation's branch told
-- which to write; and the worker's slot, whose domain the group is of)
type Choice (w : HFunctor) =
  { group : Group w
  , offer : Offer
  , nacks : Domain.Atomic (List (IVar w Unit))
  , slot : Slot w
  }

-- (a choice's group, and its offer)
choiceGroup : {w : HFunctor} -> Choice w -> Group w
choiceGroup c = c.group

choiceOffer : {w : HFunctor} -> Choice w -> Offer
choiceOffer c = c.offer

-- The scheduler
--------------------------------------------------------------------------------

-- (a choice with nacks, its thread waiting at it: its number, the
-- number of its last nack made; its offer; and its nacks)
data Waiting (w : HFunctor) = MkWaiting Int Offer (List (IVar w Unit))

-- (what the domains running threads share: the next channel's or
-- ivar's number; the last draw, which the next is made from; how many
-- threads are running or ready, which is 0 only at a deadlock; the
-- turns ready that are in no worker's slot, a queue, its front and its
-- back reversed; how many domains wait for one of them; the workers'
-- slots; the mutex the turns ready are taken under, the condition the
-- domains wait on for one, and the one the caller waits on until main
-- is done or every thread waits; whether that has come; and whether the
-- domains are to stop; where it waits on the world through the reactor,
-- its operations, each worker's waits, and how many workers wait in the
-- reactor; the choices with nacks whose threads have not gone on
-- from them, for the nacks to be told should the run drop them; a
-- spawned thread's first turn; and the first failure of a thread, for
-- the run to fail with at its end)
type Sched (w : HFunctor) =
  { numbers : Domain.Atomic Int
  , draws : Domain.Atomic Int
  , live : Domain.Atomic Int
  , ready : Domain.Atomic (Pair (List (Turn w)) (List (Turn w)))
  , idle : Domain.Atomic Int
  , slots : List (Slot w)
  , mutex : Domain.Mutex
  , work : Domain.Condition
  , finished : Domain.Condition
  , done : Domain.Atomic Bool
  , stopping : Domain.Atomic Bool
  , outside : Maybe (Outside w)
  , waits : List (Waits w)
  , polling : Domain.Atomic Int
  , waiting : Domain.Atomic (List (Waiting w))
  , thread : Spawned w -> Turn w
  , failure : Domain.Atomic (Maybe String)
  }

-- (the `i`th of them, if there is one)
nth : {x : Type} -> Int -> List x -> Maybe x
nth i Nil = Nothing
nth 0 (x :: xs) = Just x
nth i (x :: xs) = nth (i - 1) xs

-- (the waits of the slot's worker, and the reactor's operations, where
-- the scheduler waits on the world through it)
waitsOf : {w : HFunctor}
        -> Sched w
        -> Slot w
        -> Maybe (Pair (Outside w) (Waits w))
waitsOf st slot = case st.outside of
  Nothing -> Nothing
  Just o -> case nth (slotNumber slot) st.waits of
    Just ws -> Just (MkPair o ws)
    Nothing -> Nothing

-- (the group of the worker of `runner`, and the reactor's operations:
-- `Nothing` where the scheduler waits on no reactor, or none runs it)
groupOn : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Runner w
        -> Co (w <+> Custodian.custodian) (Maybe (Pair (Outside w) (Group w)))
groupOn st Nothing = pure Nothing
groupOn st (Just slot) = case waitsOf st slot of
  Nothing -> pure Nothing
  Just (MkPair o ws) -> do
    g <- Domain.get ws.group
    pure (case g of
      Just grp -> Just (MkPair o grp)
      Nothing -> Nothing)

-- (a worker waiting in the reactor woken, the first found, the mutex
-- held: for a turn put among those ready where no domain waits on the
-- condition)
wokenPolling : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Outside w
             -> List (Waits w)
             -> Co (w <+> Custodian.custodian) Unit
wokenPolling o Nil = pure ()
wokenPolling o (ws :: rest) = do
  p <- Domain.get ws.polling
  g <- Domain.get ws.group
  case g of
    Just grp -> if p then o.wake grp else wokenPolling o rest
    Nothing -> wokenPolling o rest

-- (every worker waiting in the reactor woken, the mutex held: the
-- domains to stop)
wokenAllPolling : {w : HFunctor}
                -> {{dm : Domain.domain <: w}}
                -> Outside w
                -> List (Waits w)
                -> Co (w <+> Custodian.custodian) Unit
wokenAllPolling o Nil = pure ()
wokenAllPolling o (ws :: rest) = do
  p <- Domain.get ws.polling
  g <- Domain.get ws.group
  case g of
    Just grp -> if p then o.wake grp else pure ()
    Nothing -> pure ()
  wokenAllPolling o rest

-- (the turn put at the back of those ready, the mutex held, a domain
-- waiting for one woken, where one waits)
queued : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> Turn w
       -> Co (w <+> Custodian.custodian) Unit
queued st t = do
  q <- Domain.get st.ready
  Domain.set st.ready (MkPair (fst q) (t :: snd q))
  waiting <- Domain.get st.idle
  if waiting > 0 then Domain.signal st.work
  else case st.outside of
    Just o -> do
      polling <- Domain.get st.polling
      if polling > 0 then wokenPolling o st.waits else pure ()
    Nothing -> pure ()

-- (the turn put among those ready, for any domain to take)
readied : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Turn w
        -> Co (w <+> Custodian.custodian) Unit
readied st t = do
  Domain.lock st.mutex
  queued st t
  Domain.unlock st.mutex

-- (the turn readied from `runner`: kept in the worker's slot, its next,
-- where it is a worker's and the slot is empty, no domain woken for it;
-- else put among those ready)
readiedOn : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Runner w
          -> Turn w
          -> Co (w <+> Custodian.custodian) Unit
readiedOn st Nothing t = readied st t
readiedOn st (Just slot) t = do
  kept <- keptIn slot t
  if kept then pure () else readied st t

-- (the turn kept in the worker's slot, if one, put among those ready:
-- before an operation of the world's, which may hold the domain a
-- while)
unkept : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> Runner w
       -> Co (w <+> Custodian.custodian) Unit
unkept st Nothing = pure ()
unkept st (Just slot) = do
  holding <- isHolding slot
  if holding
  then do
    t <- takenFrom slot
    case t of
      Just turn -> readied st turn
      Nothing -> pure ()
  else pure ()

-- (`act` done by the slot's worker, on its domain, before it next
-- takes a turn: it woken where it waits in the reactor)
postedTo : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Slot w
         -> Co (w <+> Custodian.custodian) Unit
         -> Co (w <+> Custodian.custodian) Unit
postedTo st slot act = case waitsOf st slot of
  Nothing -> act
  Just (MkPair o ws) -> do
    Domain.lock st.mutex
    acts <- Domain.get ws.inbox
    Domain.set ws.inbox (act :: acts)
    p <- Domain.get ws.polling
    g <- Domain.get ws.group
    case g of
      Just grp -> if p then o.wake grp else pure ()
      Nothing -> pure ()
    Domain.unlock st.mutex

-- (one more thread running or ready)
counted : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Co (w <+> Custodian.custodian) Unit
counted st = do
  _ <- Domain.fetchAdd st.live 1
  pure ()

-- (the caller told that it is over: main done, or every thread waiting)
finishedWith : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> Co (w <+> Custodian.custodian) Unit
finishedWith st = do
  Domain.lock st.mutex
  Domain.set st.done True
  Domain.broadcast st.finished
  Domain.unlock st.mutex

-- (one fewer thread running or ready: it waits, or it ended.  Where
-- none is left, every thread waits in a sync -- a deadlock, unless main
-- is done -- and the caller is told.)
uncounted : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Co (w <+> Custodian.custodian) Unit
uncounted st = do
  n <- Domain.fetchAdd st.live (0 - 1)
  if n == 1 then finishedWith st else pure ()

-- (the thread's turn, waiting no more, readied from `runner`: counted,
-- and ready)
readyAgain : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Runner w
           -> Turn w
           -> Co (w <+> Custodian.custodian) Unit
readyAgain st runner t = do
  counted st
  readiedOn st runner t

-- (a number from 0 to `n - 1`, pseudo-random: the scheduler's next
-- draw, the step after the last of a linear congruential sequence,
-- Park and Miller's (the products under 2^47, so exact in JavaScript's
-- numbers too, and a program there draws the same each run).  Two
-- domains drawing at once may draw the same: the sequence is for
-- fairness, not for secrecy, so the last is read and written, not
-- swapped)
drawn : {w : HFunctor}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> Int
      -> Co (w <+> Custodian.custodian) Int
drawn st n = do
  last <- Domain.get st.draws
  let next : Int = (last * 48271) % 2147483647
  Domain.set st.draws next
  pure (next % n)

-- (the `i`th of them, if there is one, and the others in their order)
withoutIndex : {x : Type} -> Int -> List x -> Pair (Maybe x) (List x)
withoutIndex i Nil = MkPair Nothing Nil
withoutIndex 0 (y :: ys) = MkPair (Just y) ys
withoutIndex i (y :: ys) = case (withoutIndex (i - 1) ys :
                                   Pair (Maybe x) (List x)) of
  MkPair picked rest -> MkPair picked (y :: rest)

-- (a channel made)
madeChan : {w : HFunctor}
         -> {a : Type}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Co (w <+> Custodian.custodian) (Chan w a)
madeChan st = do
  n <- Domain.fetchAdd st.numbers 1
  mu <- Domain.newMutex
  senders <- Domain.newAtomic (Deque.empty : Deque.Deque (Sender w a))
  receivers <- Domain.newAtomic (Deque.empty : Deque.Deque (Receiver w a))
  pure (MkChan n mu senders receivers)

-- (an ivar made)
madeIVar : {w : HFunctor}
         -> {a : Type}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Co (w <+> Custodian.custodian) (IVar w a)
madeIVar st = do
  n <- Domain.fetchAdd st.numbers 1
  mu <- Domain.newMutex
  value <- Domain.newAtomic (Nothing : Maybe a)
  readers <- Domain.newAtomic (Deque.empty : Deque.Deque (Receiver w a))
  pure (MkIVar n mu value readers)

-- (each reader whose offer is not yet claimed, claimed and readied
-- from `runner`, given `v`: the first in the worker's slot, where it is
-- empty, the others among those ready)
wokenAll : {w : HFunctor}
         -> {a : Type}
         -> {{dm : Domain.domain <: w}}
         -> Runner w
         -> List (Receiver w a)
         -> a
         -> Co (w <+> Custodian.custodian) Unit
wokenAll runner Nil v = pure ()
wokenAll runner (MkReceiver (MkOffer claimed) wake :: rest) v = do
  ok <- Domain.cas claimed False True
  if ok then wake v runner else pure ()
  wokenAll runner rest v

-- (the ivar holds `v` now, its readers woken from `runner`; a second
-- write abandoned: what comes after)
written : {w : HFunctor}
        -> {x a : Type}
        -> {{dm : Domain.domain <: w}}
        -> Runner w
        -> Putting w x a
        -> Co (w <+> Custodian.custodian) x
written runner (MkPutting (MkIVar n mu value readers) v k) = do
  Domain.lock mu
  held <- Domain.get value
  case held of
    Just old -> do
      Domain.unlock mu
      abandon
    Nothing -> do
      Domain.set value (Just v)
      rs <- Domain.get readers
      Domain.set readers Deque.empty
      Domain.unlock mu
      wokenAll runner (Deque.toList rs) v
      later k

-- (the choice put among those whose threads have not gone on from them)
registered : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Waiting w
           -> Co (w <+> Custodian.custodian) Unit
registered st x = do
  xs <- Domain.get st.waiting
  ok <- Domain.cas st.waiting xs (x :: xs)
  if ok then pure () else registered st x

waitingNumber : {w : HFunctor} -> Waiting w -> Int
waitingNumber (MkWaiting n off nacks) = n

-- (the choice numbered `n` taken out of those, its thread gone on)
settled : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Int
        -> Co (w <+> Custodian.custodian) Unit
settled st n = do
  xs <- Domain.get st.waiting
  if List.any (\x -> waitingNumber x == n) xs
  then do
    ok <- Domain.cas st.waiting xs (List.keepIf (\x -> waitingNumber x /= n) xs)
    if ok then pure () else settled st n
  else pure ()

-- (the nack written, where it is not yet, its readers woken from
-- `runner`: told once, a second telling no write)
toldNack : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Runner w
         -> IVar w Unit
         -> Co (w <+> Custodian.custodian) Unit
toldNack runner (MkIVar n mu value readers) = do
  Domain.lock mu
  held <- Domain.get value
  case held of
    Just old -> Domain.unlock mu
    Nothing -> do
      Domain.set value (Just MkUnit)
      rs <- Domain.get readers
      Domain.set readers Deque.empty
      Domain.unlock mu
      wokenAll runner (Deque.toList rs) MkUnit

toldAll : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Runner w
        -> List (IVar w Unit)
        -> Co (w <+> Custodian.custodian) Unit
toldAll runner Nil = pure ()
toldAll runner (nack :: rest) = do
  toldNack runner nack
  toldAll runner rest

-- (the choices whose threads the run dropped, at its end, before they
-- went on from them -- waiting there, or met and not yet run again:
-- each one's offer claimed, so that no partner meets it after, and its
-- nacks told, none of its branches going on)
toldDropped : {w : HFunctor}
            -> {{dm : Domain.domain <: w}}
            -> List (Waiting w)
            -> Co (w <+> Custodian.custodian) Unit
toldDropped Nil = pure ()
toldDropped (MkWaiting n off nacks :: rest) = do
  _ <- claimedOffer (w := w) off
  toldAll Nothing nacks
  toldDropped rest

-- (the offers at the front of those waiting that are stale -- claimed
-- already, through this channel or another -- dropped, up to the first
-- that is not: whether a waiter is left)
prunedFront : {w : HFunctor}
            -> {x : Type}
            -> {{dm : Domain.domain <: w}}
            -> (x -> Offer)
            -> Domain.Atomic (Deque.Deque x)
            -> Co (w <+> Custodian.custodian) Bool
prunedFront offerOf waiting = do
  d <- Domain.get waiting
  case Deque.popFront d of
    Nothing -> pure False
    Just (MkPair x rest) -> do
      stale <- isClaimed (w := w) (offerOf x)
      if stale
      then do
        Domain.set waiting rest
        prunedFront (w := w) offerOf waiting
      else pure True

-- (how many of the waiters at the front the partner is drawn from among)
window : Int
window = 4

-- (up to `k` of those waiting, from the front, whose offers are not
-- claimed, the stale ones met dropped: the first first, and what is left
-- behind them)
unclaimedFront : {w : HFunctor}
               -> {x : Type}
               -> {{dm : Domain.domain <: w}}
               -> (x -> Offer)
               -> Int
               -> Deque.Deque x
               -> Co (w <+> Custodian.custodian) (Pair (List x) (Deque.Deque x))
unclaimedFront offerOf k d =
  if k <= 0 then pure (MkPair Nil d)
  else case Deque.popFront d of
    Nothing -> pure (MkPair Nil d)
    Just (MkPair x rest) -> do
      stale <- isClaimed (w := w) (offerOf x)
      if stale then unclaimedFront (w := w) offerOf k rest
      else do
        more <- unclaimedFront (w := w) offerOf (k - 1) rest
        pure (MkPair (x :: fst more) (snd more))

-- (the waiters put back at the front, before what is there, in their
-- order)
pushedFront : {x : Type} -> Deque.Deque x -> List x -> Deque.Deque x
pushedFront d Nil = d
pushedFront d (x :: xs) = Deque.pushFront (pushedFront d xs) x

-- (one of them, drawn at random where there are several, its offer
-- claimed: `Just` it, and the others not tried, in their order; where
-- the claim fails -- the offer claimed meanwhile, through another
-- channel -- it is dropped and another drawn, `Nothing` where every one
-- was)
claimedAmong : {w : HFunctor}
             -> {x : Type}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> (x -> Offer)
             -> List x
             -> Co (w <+> Custodian.custodian) (Pair (Maybe x) (List x))
claimedAmong st offerOf Nil = pure (MkPair Nothing Nil)
claimedAmong st offerOf (x :: Nil) = do
  ok <- claimedOffer (w := w) (offerOf x)
  pure (MkPair (if ok then Just x else Nothing) Nil)
claimedAmong st offerOf xs = do
  i <- drawn st (List.length xs)
  case withoutIndex i xs of
    MkPair (Just x) others -> do
      ok <- claimedOffer (w := w) (offerOf x)
      if ok then pure (MkPair (Just x) others)
      else claimedAmong st offerOf others
    MkPair Nothing others -> pure (MkPair Nothing others)

-- (a partner among those waiting, drawn from among the first `window`
-- whose offers are not claimed, claimed; the others put back at the
-- front in their order, the stale offers met dropped: `Just` it, if any
-- can be claimed, and those left waiting)
claimedWaiter : {w : HFunctor}
              -> {x : Type}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> (x -> Offer)
              -> Deque.Deque x
              -> Co (w <+> Custodian.custodian) (Pair (Maybe x) (Deque.Deque x))
claimedWaiter st offerOf d = do
  front <- unclaimedFront (w := w) offerOf window d
  case fst front of
    Nil -> pure (MkPair Nothing (snd front))
    candidates -> do
      c <- claimedAmong st offerOf candidates
      let rest : Deque.Deque x = pushedFront (snd front) (snd c)
      case fst c of
        Just x -> pure (MkPair (Just x) rest)
        Nothing -> claimedWaiter st offerOf rest

-- (whether the base event can be committed now, its mutex held, nothing
-- claimed: a partner waits, unclaimed, at the channel (the stale offers
-- at the front dropped), the ivar is written, or it is an always)
canCommit : {w : HFunctor}
          -> {x : Type}
          -> {{dm : Domain.domain <: w}}
          -> Base w x
          -> Co (w <+> Custodian.custodian) Bool
canCommit (AlwaysBase k) = pure True
canCommit (SendBase s) =
  s (Co (w <+> Custodian.custodian) Bool) (\a sd -> case sd of
    MkSendOn (MkChan n mu senders receivers) v k ->
      prunedFront (w := w) receiverOffer receivers)
canCommit (RecvBase s) =
  s (Co (w <+> Custodian.custodian) Bool) (\a rc -> case rc of
    MkRecvOn (MkChan n mu senders receivers) k ->
      prunedFront (w := w) senderOffer senders)
canCommit (ReadBase s) =
  s (Co (w <+> Custodian.custodian) Bool) (\a rd -> case rd of
    MkReadOn (MkIVar n mu value readers) k -> do
      held <- Domain.get value
      pure (case held of
        Just v -> True
        Nothing -> False))

-- (those of the base events that can be committed now, in their order)
readyNow : {w : HFunctor}
         -> {x : Type}
         -> {{dm : Domain.domain <: w}}
         -> List (Base w x)
         -> Co (w <+> Custodian.custodian) (List (Base w x))
readyNow Nil = pure Nil
readyNow (b :: bs) = do
  can <- canCommit b
  rest <- readyNow bs
  pure (if can then b :: rest else rest)

-- (a send committed, the channel's mutex held: a receiver waiting
-- claimed, given the value and readied from `runner`, and what comes
-- after for the thread -- `Nothing` where no receiver's offer can be
-- claimed)
committedSend : {w : HFunctor}
              -> {x a : Type}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> Runner w
              -> SendOn w x a
              -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committedSend st runner (MkSendOn (MkChan n mu senders receivers) v k) = do
  rs <- Domain.get receivers
  r <- claimedWaiter st receiverOffer rs
  Domain.set receivers (snd r)
  case fst r of
    Just (MkReceiver off wake) -> do
      wake v runner
      pure (Just k)
    Nothing -> pure Nothing

-- (a receive committed, the channel's mutex held: a sender waiting
-- claimed and readied from `runner`, and what comes after for the
-- thread, given its value -- `Nothing` where no sender's offer can be
-- claimed)
committedRecv : {w : HFunctor}
              -> {x a : Type}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> Runner w
              -> RecvOn w x a
              -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committedRecv st runner (MkRecvOn (MkChan n mu senders receivers) k) = do
  ss <- Domain.get senders
  r <- claimedWaiter st senderOffer ss
  Domain.set senders (snd r)
  case fst r of
    Just (MkSender off v wake) -> do
      wake runner
      pure (Just (\u -> k v))
    Nothing -> pure Nothing

-- (an ivar's read committed, its mutex held: what comes after for the
-- thread, given what it holds -- `Nothing` where it is not written)
committedRead : {w : HFunctor}
              -> {x a : Type}
              -> {{dm : Domain.domain <: w}}
              -> ReadOn w x a
              -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committedRead (MkReadOn (MkIVar n mu value readers) k) = do
  held <- Domain.get value
  pure (case held of
    Just v -> Just (\u -> k v)
    Nothing -> Nothing)

-- (a base event committed, its mutex held, its partner, if one, claimed
-- and readied from `runner`: `Just` what comes after it, to be computed
-- once the mutexes are let go of; `Nothing` where it cannot be now
-- after all)
committed : {w : HFunctor}
          -> {x : Type}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Runner w
          -> Base w x
          -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committed st runner (AlwaysBase k) = pure (Just k)
committed st runner (SendBase s) =
  s
    (Co (w <+> Custodian.custodian) (Maybe (Unit -> x)))
    (\a sd -> committedSend st runner sd)
committed st runner (RecvBase s) =
  s
    (Co (w <+> Custodian.custodian) (Maybe (Unit -> x)))
    (\a rc -> committedRecv st runner rc)
committed st runner (ReadBase s) =
  s
    (Co (w <+> Custodian.custodian) (Maybe (Unit -> x)))
    (\a rd -> committedRead rd)

-- (one of the base events that can be committed now, drawn at random
-- where there are several, committed: `Just` what comes after it; where
-- it cannot be after all -- its partner's offer claimed meanwhile,
-- through another channel -- it is dropped and another drawn; `Nothing`
-- where none is left)
committedAmong : {w : HFunctor}
               -> {x : Type}
               -> {{dm : Domain.domain <: w}}
               -> Sched w
               -> Runner w
               -> List (Base w x)
               -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committedAmong st runner Nil = pure Nothing
committedAmong st runner (b :: Nil) = committed st runner b
committedAmong st runner bs = do
  i <- drawn st (List.length bs)
  case withoutIndex i bs of
    MkPair (Just b) others -> do
      r <- committed st runner b
      case r of
        Just k -> pure (Just k)
        Nothing -> committedAmong st runner others
    MkPair Nothing others -> pure Nothing

-- (the base events, their mutexes held: those that can be committed now
-- found, claiming nothing, then one of them drawn and committed -- `Just`
-- what comes after it; where every one drawn could not be after all,
-- the base events are asked again; `Nothing` where none can be)
committedOne : {w : HFunctor}
             -> {x : Type}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> Runner w
             -> List (Base w x)
             -> Co (w <+> Custodian.custodian) (Maybe (Unit -> x))
committedOne st runner bs = do
  ready <- readyNow bs
  case ready of
    Nil -> pure Nothing
    _ -> do
      r <- committedAmong st runner ready
      case r of
        Just k -> pure (Just k)
        Nothing -> committedOne st runner bs

-- (the thread's offer left at the base event's channel or ivar, its
-- mutex held, with what readies the thread there, from where its
-- partner runs: its turn, `turnOf` its continuation -- left unapplied,
-- for the worker that takes the turn)
offered : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> (Runner w -> Turn w -> Co (w <+> Custodian.custodian) Unit)
        -> ((Unit -> Res w Unit) -> Turn w)
        -> Offer
        -> Base w (Res w Unit)
        -> Co (w <+> Custodian.custodian) Unit
offered again turnOf off (AlwaysBase k) = pure ()
offered again turnOf off (SendBase s) =
  s (Co (w <+> Custodian.custodian) Unit) (\a sd -> case sd of
    MkSendOn (MkChan n mu senders receivers) v k -> do
      ss <- Domain.get senders
      Domain.set
          senders
          (Deque.pushBack
             ss
             (MkSender off v (\on -> again on (turnOf k)))))
offered again turnOf off (RecvBase s) =
  s (Co (w <+> Custodian.custodian) Unit) (\a rc -> case rc of
    MkRecvOn (MkChan n mu senders receivers) k -> do
      rs <- Domain.get receivers
      Domain.set
          receivers
          (Deque.pushBack
             rs
             (MkReceiver
                off
                (\v on -> again on (turnOf (\u -> k v))))))
offered again turnOf off (ReadBase s) =
  s (Co (w <+> Custodian.custodian) Unit) (\a rd -> case rd of
    MkReadOn (MkIVar n mu value readers) k -> do
      rs <- Domain.get readers
      Domain.set
          readers
          (Deque.pushBack
             rs
             (MkReceiver
                off
                (\v on -> again on (turnOf (\u -> k v))))))

offeredAll : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> (Runner w -> Turn w -> Co (w <+> Custodian.custodian) Unit)
           -> ((Unit -> Res w Unit) -> Turn w)
           -> Offer
           -> List (Base w (Res w Unit))
           -> Co (w <+> Custodian.custodian) Unit
offeredAll again turnOf off Nil = pure ()
offeredAll again turnOf off (b :: bs) = do
  offered again turnOf off b
  offeredAll again turnOf off bs

-- (the mutex of the base event's channel or ivar, with its number)
lockOf : {w : HFunctor}
       -> {x : Type}
       -> Base w x
       -> Maybe (Pair Int Domain.Mutex)
lockOf (AlwaysBase k) = Nothing
lockOf (SendBase s) =
  s (Maybe (Pair Int Domain.Mutex)) (\a sd -> case sd of
    MkSendOn (MkChan n mu senders receivers) v k -> Just (MkPair n mu))
lockOf (RecvBase s) =
  s (Maybe (Pair Int Domain.Mutex)) (\a rc -> case rc of
    MkRecvOn (MkChan n mu senders receivers) k -> Just (MkPair n mu))
lockOf (ReadBase s) =
  s (Maybe (Pair Int Domain.Mutex)) (\a rd -> case rd of
    MkReadOn (MkIVar n mu value readers) k -> Just (MkPair n mu))

-- (the mutexes in order of their numbers, each once)
distinctLocks : List (Pair Int Domain.Mutex) -> List (Pair Int Domain.Mutex)
distinctLocks (a :: b :: rest) =
  if fst a == fst b then distinctLocks (b :: rest)
  else a :: distinctLocks (b :: rest)
distinctLocks locks = locks

-- (the mutexes of the base events' channels and ivars, each once, in
-- the order of their numbers: held in that order by every sync, so
-- that none waits for another round a cycle)
locksOf : {w : HFunctor}
        -> {x : Type}
        -> List (Base w x)
        -> List (Pair Int Domain.Mutex)
locksOf bs = distinctLocks (List.sortOn (\l -> fst l) (List.mapMaybe lockOf bs))

lockedAll : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> List (Pair Int Domain.Mutex)
          -> Co (w <+> Custodian.custodian) Unit
lockedAll Nil = pure ()
lockedAll (l :: ls) = do
  Domain.lock (snd l)
  lockedAll (w := w) ls

unlockedAll : {w : HFunctor}
            -> {{dm : Domain.domain <: w}}
            -> List (Pair Int Domain.Mutex)
            -> Co (w <+> Custodian.custodian) Unit
unlockedAll Nil = pure ()
unlockedAll (l :: ls) = do
  Domain.unlock (snd l)
  unlockedAll (w := w) ls

-- Choices
--------------------------------------------------------------------------------

-- (a choice's branches run to their commit points: each base event, with
-- the numbers of the nacks around it; every nack made, the last first;
-- where an operation of the world was started in a group of the
-- choice's own, the choice; and whether one is pending there, a base
-- event of the choice's too)
type Branches (w : HFunctor) =
  { bases : List (Pair (List Int) (Base w (Res w Unit)))
  , nacks : List (IVar w Unit)
  , outside : Maybe (Choice w)
  , pending : Bool
  }

ivarNumber : {w : HFunctor} -> {a : Type} -> IVar w a -> Int
ivarNumber (MkIVar n mu value readers) = n

-- (the thread going on as `r` says, the nacks written first: the
-- branches abandoned told)
nacking : {w : HFunctor} -> List (IVar w Unit) -> Res w Unit -> Res w Unit
nacking Nil r = r
nacking (nack :: rest) r =
  RStep
    (PutIVar
       (\t use -> use Unit (MkPutting nack MkUnit (\u -> nacking rest r))))

-- (the nacks not among `around`: those of the branches abandoned where
-- a base event the nacks `around` enclose is committed)
abandonedNacks : {w : HFunctor}
               -> List Int
               -> List (IVar w Unit)
               -> List (IVar w Unit)
abandonedNacks around Nil = Nil
abandonedNacks around (nack :: rest) =
  if List.elem (ivarNumber nack) around then abandonedNacks around rest
  else nack :: abandonedNacks around rest

-- (a choice with these nacks, its thread to wait at `off`: put among
-- those whose threads have not gone on, numbered by its last nack made)
waitedWith : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Offer
           -> List (IVar w Unit)
           -> Co (w <+> Custodian.custodian) Unit
waitedWith st off Nil = pure ()
waitedWith st off (nack :: rest) =
  registered st (MkWaiting (ivarNumber nack) off (nack :: rest))

-- (the thread going on as `r` says, once it has gone on from the choice
-- with these nacks: the choice taken out of those waiting first)
settling : {w : HFunctor}
         -> {a : Type}
         -> List (IVar w Unit)
         -> Res w a
         -> Res w a
settling Nil r = r
settling (nack :: rest) r = RStep (Settled (ivarNumber nack) (\u -> r))

-- (a branch of a choice, of whatever type: what is left of it to run
-- up to its commit point, `up` making the thread's continuation of what
-- follows that, and the numbers of the nacks enclosing it)
data Branch (w : HFunctor) a
  = MkBranch (Res w a) (Res w a -> Res w Unit) (List Int)

-- (the choice's group, within the worker's `g` -- a new one, where
-- there is none yet)
choiceFor : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Outside w
          -> Group w
          -> Slot w
          -> Maybe (Choice w)
          -> Co (w <+> Custodian.custodian) (Choice w)
choiceFor o g slot (Just c) = pure c
choiceFor o g slot Nothing = do
  sub <- o.within g
  claimed <- Domain.newAtomic False
  nacks <- Domain.newAtomic (Nil : List (IVar w Unit))
  pure { group = sub, offer = MkOffer claimed, nacks = nacks, slot = slot }

-- (a branch's operation of the world, pending, done, on the worker's
-- domain: the choice's offer claimed, where it is not yet, and the
-- branch committed -- the choice's group closed, what else is pending
-- in it let go of, and the thread going on from the operation, the
-- nacks of the others written; else nothing, another committed)
deliveredBranch : {w : HFunctor}
                -> {a : Type}
                -> {{dm : Domain.domain <: w}}
                -> Outside w
                -> ((Unit -> Res w Unit) -> Turn w)
                -> Choice w
                -> List Int
                -> (Res w a -> Res w Unit)
                -> Res w a
                -> Co (w <+> Custodian.custodian) (Stepped w)
deliveredBranch o turnOf c around up next = do
  ok <- claimedOffer (w := w) c.offer
  if ok
  then do
    o.close c.group
    nacks <- Domain.get c.nacks
    pure
        (Resumed
           (nacking (abandonedNacks around nacks) (settling nacks (up next)))
           turnOf)
  else pure Stopped

-- (a choice's guard work failed, after the nack was made: the nack
-- told, from no worker -- its readers put among those ready -- and the
-- failure going on, as it came, for the thread's turn to fail with)
failedAfter : {w : HFunctor}
            -> {{dm : Domain.domain <: w}}
            -> IVar w Unit
            -> String
            -> Co (w <+> Custodian.custodian) (Branches w)
failedAfter nack why = do
  toldNack Nothing nack
  Domain.fail why

-- (the branches, each run on `runner` up to its first base event, in
-- order: its base events, or one ready at once where it ends first,
-- put among `acc`'s.  What comes before is done here, as the thread's:
-- its spawns, channels, ivars and writes, its operations of the world,
-- a `withNack`'s nack made; a `choose` in one is more branches, each
-- going on as that one, through what comes after that `choose`, run
-- next)
branched : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> ((Unit -> Res w Unit) -> Turn w)
         -> Runner w
         -> List (Some (Branch w))
         -> Branches w
         -> Co (w <+> Custodian.custodian) (Branches w)
branched st turnOf runner Nil acc = pure acc
branched st turnOf runner (sb :: rest) acc =
  sb (Co (w <+> Custodian.custodian) (Branches w)) (\a br -> case br of
    MkBranch r up around -> case r of
      RDone x ->
        branched
          st
          turnOf
          runner
          rest
          { acc
          | bases = MkPair around (AlwaysBase (\u -> up (RDone x))) :: acc.bases
          }
      RAct m -> do
        unkept st runner
        on <- groupOn st runner
        case (on, runner) of
          (Just (MkPair o g), Just slot) -> do
            c <-
              (choiceFor o g slot acc.outside :
                 Co (w <+> Custodian.custodian) (Choice w))
            now <- Domain.newAtomic (Nothing : Maybe (Res w a))
            waited <- Domain.newAtomic False
            r <-
              o.start
                (choiceGroup c)
                (bind m (\(next : Res w a) -> do
                 pended <-
                   (Domain.get waited : Co (w <+> Custodian.custodian) Bool)
                 if pended then pure () else Domain.set now (Just next)
                 pure (deliveredBranch o turnOf c around up next)))
            case r of
              Just act -> do
                next <- Domain.get now
                case next of
                  Just n ->
                    branched
                      st
                      turnOf
                      runner
                      ((\t use -> use a (MkBranch n up around)) :: rest)
                      { acc | outside = Just c }
                  Nothing -> abandon
              Nothing -> do
                Domain.set waited True
                branched
                    st
                    turnOf
                    runner
                    rest
                    { acc | outside = Just c, pending = True }
          _ -> do
            next <- m
            branched
                st
                turnOf
                runner
                ((\t use -> use a (MkBranch next up around)) :: rest)
                acc
      RNext g ->
        branched
          st
          turnOf
          runner
          ((\t use -> use a (MkBranch (g MkUnit) up around)) :: rest)
          acc
      RStep p -> case p of
        Spawn c k -> do
          readyAgain st runner (st.thread c)
          branched
              st
              turnOf
              runner
              ((\t use -> use a (MkBranch (k MkUnit) up around)) :: rest)
              acc
        Yield k ->
          branched
            st
            turnOf
            runner
            ((\t use -> use a (MkBranch (k MkUnit) up around)) :: rest)
            acc
        NewChan s ->
          s (Co (w <+> Custodian.custodian) (Branches w)) (\c mk -> case mk of
            MkMakingChan k -> do
              ch <- madeChan st
              branched
                  st
                  turnOf
                  runner
                  ((\t use -> use a (MkBranch (k ch) up around)) :: rest)
                  acc)
        NewIVar s ->
          s (Co (w <+> Custodian.custodian) (Branches w)) (\c mk -> case mk of
            MkMakingIVar k -> do
              iv <- madeIVar st
              branched
                  st
                  turnOf
                  runner
                  ((\t use -> use a (MkBranch (k iv) up around)) :: rest)
                  acc)
        PutIVar s ->
          s (Co (w <+> Custodian.custodian) (Branches w)) (\c pt -> do
            k <- written runner pt
            branched
                st
                turnOf
                runner
                ((\t use -> use a (MkBranch k up around)) :: rest)
                acc)
        MadeNack nack k -> do
          r <-
            Domain.tried
              (branched
                 st
                 turnOf
                 runner
                 ((\t use ->
                     use
                       a
                       (MkBranch (k MkUnit) up (ivarNumber nack :: around)))
                  :: rest)
                 { acc | nacks = nack :: acc.nacks })
          case r of
            Right got -> pure got
            Left why -> failedAfter nack why
        Settled n k ->
          branched
            st
            turnOf
            runner
            ((\t use -> use a (MkBranch (k MkUnit) up around)) :: rest)
            acc
        Sync bs ->
          branched
            st
            turnOf
            runner
            rest
            { acc
            | bases =
                List.map (\b -> MkPair around (baseThen up b)) bs ++ acc.bases
            }
        Choose s ->
          s (Co (w <+> Custodian.custodian) (Branches w)) (\c ch -> case ch of
            MkChoosing bs k ->
              branched
                st
                turnOf
                runner
                (List.map
                   (\b t use ->
                      use c (MkBranch b (\q -> up (thenRes q k)) around))
                   bs
                 ++ rest)
                acc))

-- (a choice's nacks, every one made)
branchesNacks : {w : HFunctor} -> Branches w -> List (IVar w Unit)
branchesNacks br = br.nacks

-- (a choice's base events, each going on, once committed, with the
-- nacks of the branches abandoned written)
committable : {w : HFunctor} -> Branches w -> List (Base w (Res w Unit))
committable br =
  List.map
    (\p ->
       baseThen
         (\r -> nacking (abandonedNacks (fst p) br.nacks) (settling br.nacks r))
         (snd p))
    br.bases

-- (a sync, on `runner`: the mutexes of its base events held, one of
-- those that can be committed is, drawn at random where there are
-- several, its partner readied from `runner`, and the thread goes on --
-- with what comes after computed once the mutexes are let go of; where
-- none can, the thread's offer is left at each, `turnOf` making its
-- turn there, and it waits, one fewer running.  Where it is a choice
-- with operations of the world pending, `chosen`, its offer is the
-- choice's: committed now, the choice's group is closed, what is
-- pending there let go of, and its offer claimed, so that none of them
-- is committed after all; waiting, it is counted still -- the reactor
-- will come to it -- and where a partner commits it, the choice's group
-- is closed by its worker, on whose domain it is)
synced : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> ((Unit -> Res w Unit) -> Turn w)
       -> Runner w
       -> Maybe (Choice w)
       -> List (IVar w Unit)
       -> List (Base w (Res w Unit))
       -> Co (w <+> Custodian.custodian) (Stepped w)
synced st turnOf runner chosen nacks bs = do
  let locks = locksOf bs
  lockedAll (w := w) locks
  r <- committedOne st runner bs
  case r of
    Just k -> do
      unlockedAll (w := w) locks
      case (chosen, st.outside) of
        (Just c, Just o) -> do
          _ <- claimedOffer (w := w) c.offer
          o.close c.group
        _ -> pure ()
      next <- later k
      pure (GoesOn next)
    Nothing -> case (chosen, st.outside) of
      (Just c, Just o) -> do
        waitedWith st c.offer nacks
        offeredAll
            (\on t -> do
             postedTo st c.slot (o.close c.group)
             readiedOn st on t)
            turnOf
            c.offer
            bs
        unlockedAll (w := w) locks
        pure Stopped
      _ -> do
        claimed <- Domain.newAtomic False
        let off : Offer = MkOffer claimed
        waitedWith st off nacks
        offeredAll (\on t -> readyAgain st on t) turnOf off bs
        unlockedAll (w := w) locks
        uncounted st
        pure Stopped

-- (a thread's turn given up, on `runner`: the worker's next where no
-- other turn is ready -- its slot empty, and none among those ready --
-- else put behind those ready, so that they go first)
yielded : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Runner w
        -> Turn w
        -> Co (w <+> Custodian.custodian) Unit
yielded st Nothing t = readied st t
yielded st (Just slot) t = do
  Domain.lock st.mutex
  q <- Domain.get st.ready
  case q of
    MkPair Nil Nil -> do
      kept <- keptIn slot t
      if kept then pure () else queued st t
    _ -> queued st t
  Domain.unlock st.mutex

-- (the choice whose branches have operations of the world pending, if
-- any, told its nacks; where it has none pending, its group closed)
pendingChoice : {w : HFunctor}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> Branches w
              -> Co (w <+> Custodian.custodian) (Maybe (Choice w))
pendingChoice st br = case (br.outside, st.outside) of
  (Just c, Just o) ->
    if br.pending
    then do
      Domain.set c.nacks br.nacks
      pure (Just c)
    else do
      o.close c.group
      pure Nothing
  _ -> pure Nothing

-- (a thread's step, on `runner`: where it stopped, what the scheduler
-- does there, `turnOf` making the turns of the threads it readies)
stepped : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> ((Unit -> Res w Unit) -> Turn w)
        -> Runner w
        -> Res w Unit
        -> Co (w <+> Custodian.custodian) (Stepped w)
stepped st turnOf runner (RDone u) = do
  uncounted st
  pure Stopped
stepped st turnOf runner (RAct m) = do
  unkept st runner
  on <- groupOn st runner
  case on of
    Just (MkPair o g) -> do
      r <- o.start g (bind m (\next -> pure (pure (Resumed next turnOf))))
      case r of
        Just act -> act
        Nothing -> pure Stopped
    Nothing -> bind m (\r -> pure (GoesOn r))
stepped st turnOf runner (RNext g) = pure (GoesOn (g MkUnit))
stepped st turnOf runner (RStep (Spawn c k)) = do
  readyAgain st runner (st.thread c)
  next <- later k
  pure (GoesOn next)
stepped st turnOf runner (RStep (Yield k)) = do
  yielded st runner (turnOf k)
  pure Stopped
stepped st turnOf runner (RStep (NewChan s)) =
  s (Co (w <+> Custodian.custodian) (Stepped w)) (\a mk -> case mk of
    MkMakingChan k -> bind (madeChan st) (\ch -> pure (GoesOn (k ch))))
stepped st turnOf runner (RStep (NewIVar s)) =
  s (Co (w <+> Custodian.custodian) (Stepped w)) (\a mk -> case mk of
    MkMakingIVar k -> bind (madeIVar st) (\iv -> pure (GoesOn (k iv))))
stepped st turnOf runner (RStep (PutIVar s)) =
  s
    (Co (w <+> Custodian.custodian) (Stepped w))
    (\a p -> bind (written runner p) (\k -> pure (GoesOn k)))
stepped st turnOf runner (RStep (Sync bs)) =
  synced st turnOf runner Nothing Nil bs
stepped st turnOf runner (RStep (Choose s)) =
  s (Co (w <+> Custodian.custodian) (Stepped w)) (\a ch -> case ch of
    MkChoosing bs k -> do
      br <-
        (branched
           st
           turnOf
           runner
           (List.map
              (\b t use -> use a (MkBranch b (\q -> thenRes q k) Nil))
              bs)
           ({ bases = Nil, nacks = Nil, outside = Nothing, pending = False } :
              Branches w) :
           Co (w <+> Custodian.custodian) (Branches w))
      chosen <- pendingChoice st br
      synced st turnOf runner chosen (branchesNacks br) (committable br))
stepped st turnOf runner (RStep (MadeNack nack k)) = do
  next <- later k
  pure (GoesOn next)
stepped st turnOf runner (RStep (Settled n k)) = do
  settled st n
  next <- later k
  pure (GoesOn next)

-- (how many steps a thread takes in a run on a worker, each operation
-- of it the worker handles, before it is put behind the others ready,
-- as at a `yield`, where any is.  A few hundred: a step is a microsecond
-- or so, so a thread ready waits a fraction of a millisecond at most
-- behind one that goes on, and what the fuel costs beyond its count --
-- two reads, and the mutex where the thread is put behind -- comes once
-- in that many steps)
fuelPerRun : Int
fuelPerRun = 256

-- (whether a turn other than the running thread's is ready for the
-- worker: one its slot holds, or one in the queue, as far as this domain
-- sees now)
othersReady : {w : HFunctor}
            -> {{dm : Domain.domain <: w}}
            -> Sched w
            -> Runner w
            -> Co (w <+> Custodian.custodian) Bool
othersReady st Nothing = pure False
othersReady st (Just slot) = do
  holding <- isHolding slot
  if holding then pure True
  else do
    q <- Domain.get st.ready
    case q of
      MkPair Nil Nil -> pure False
      _ -> pure True

-- (a thread run, on `runner`, from where it stopped until it ends,
-- waits, or gives up its turn, `turnOf` making the turns of the threads
-- it readies; `fuel` the steps left of its run: at none, where another
-- turn is ready, it gives up its turn as at a `yield`, else it goes on
-- with its fuel full again)
ranOn : {w : HFunctor}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> ((Unit -> Res w Unit) -> Turn w)
      -> Runner w
      -> Int
      -> Res w Unit
      -> Co (w <+> Custodian.custodian) Unit
ranOn st turnOf runner fuel r = do
  s <- stepped st turnOf runner r
  case s of
    GoesOn next ->
      if fuel > 1 then ranOn st turnOf runner (fuel - 1) next
      else do
        others <- othersReady st runner
        if others then yielded st runner (turnOf (\u -> next))
        else ranOn st turnOf runner fuelPerRun next
    Resumed next mk -> ranOn st turnOf runner fuel next
    Stopped -> pure ()

-- (a thread failed, in its turn: the first failure of the run kept, the
-- others let go of; the thread counted no more; and where it is main,
-- the run over, as where main is done)
threadFailed : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> Bool
             -> String
             -> Co (w <+> Custodian.custodian) Unit
threadFailed st main why = do
  _ <- Domain.cas st.failure (Nothing : Maybe String) (Just why)
  uncounted st
  if main then finishedWith st else pure ()

-- (a thread run, on `runner`, from where it stopped until it ends,
-- waits, or gives up its turn, its fuel full; the turns of the threads
-- it readies run them so, on the worker that takes each.  A failure in
-- a thread's turn is caught by the worker's loop, which goes on
-- (`guarded`); one in main's turn, here, in the turn, so that the run
-- ends with it)
run : {w : HFunctor}
    -> {{dm : Domain.domain <: w}}
    -> Sched w
    -> Bool
    -> Runner w
    -> Res w Unit
    -> Co (w <+> Custodian.custodian) Unit
run st False runner r =
  ranOn st (\k on -> run st False on (k MkUnit)) runner fuelPerRun r
run st True runner r = do
  out <-
    Domain.tried
      (bind
         (later
            (\u ->
               ranOn
                 st
                 (\k on -> run st True on (k MkUnit))
                 runner
                 fuelPerRun
                 r))
         (\c -> c))
  case out of
    Right u -> pure ()
    Left why -> threadFailed st True why

-- (a branch of a choice run alone, of whatever type: what is left of
-- it to run up to its commit point, and `up` making what follows that)
data AloneBranch (w : HFunctor) x a = MkAloneBranch (Res w a) (Res w a -> x)

-- (the branches run alone, in order, each up to its first base event:
-- `Just` what follows the commit point of the first that commits
-- alone -- it ends first, or a `choose` in it does so -- or `Nothing`
-- where each comes to a base event, which has no thread to meet)
readyAlone : {w : HFunctor}
           -> {x : Type}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> List (Some (AloneBranch w x))
           -> Co (w <+> Custodian.custodian) (Maybe x)
readyAlone st Nil = pure Nothing
readyAlone st (sb :: rest) =
  sb (Co (w <+> Custodian.custodian) (Maybe x)) (\a br -> case br of
    MkAloneBranch r up -> case r of
      RDone v -> pure (Just (up (RDone v)))
      RAct m -> do
        next <- m
        readyAlone st ((\t use -> use a (MkAloneBranch next up)) :: rest)
      RNext g ->
        readyAlone st ((\t use -> use a (MkAloneBranch (g MkUnit) up)) :: rest)
      RStep p -> case p of
        Spawn c k -> do
          cust <- Custodian.current
          readyAgain st Nothing (st.thread (threadAt cust c))
          readyAlone
              st
              ((\t use -> use a (MkAloneBranch (k MkUnit) up)) :: rest)
        Yield k ->
          readyAlone
            st
            ((\t use -> use a (MkAloneBranch (k MkUnit) up)) :: rest)
        NewChan s ->
          s (Co (w <+> Custodian.custodian) (Maybe x)) (\c mk -> case mk of
            MkMakingChan k -> do
              ch <- madeChan st
              readyAlone
                  st
                  ((\t use -> use a (MkAloneBranch (k ch) up)) :: rest))
        NewIVar s ->
          s (Co (w <+> Custodian.custodian) (Maybe x)) (\c mk -> case mk of
            MkMakingIVar k -> do
              iv <- madeIVar st
              readyAlone
                  st
                  ((\t use -> use a (MkAloneBranch (k iv) up)) :: rest))
        PutIVar s ->
          s (Co (w <+> Custodian.custodian) (Maybe x)) (\c pt -> do
            k <- written Nothing pt
            readyAlone st ((\t use -> use a (MkAloneBranch k up)) :: rest))
        MadeNack nack k ->
          readyAlone
            st
            ((\t use -> use a (MkAloneBranch (k MkUnit) up)) :: rest)
        Settled n k ->
          readyAlone
            st
            ((\t use -> use a (MkAloneBranch (k MkUnit) up)) :: rest)
        Sync bs -> readyAlone st rest
        Choose s ->
          s (Co (w <+> Custodian.custodian) (Maybe x)) (\c ch -> case ch of
            MkChoosing bs k ->
              readyAlone
                st
                (List.map
                   (\b t use ->
                      use c (MkAloneBranch b (\q -> up (thenRes q k))))
                   bs
                 ++ rest)))

-- (a thread run alone to its end: what an operation of `w` holding
-- computations is given, as `Domain.tried c` holds `c`.  Its spawns,
-- channels and ivars are the scheduler's, the threads it readies put
-- among those ready; a base event in it has no thread to meet, and is
-- abandoned, unless a `choose` has a branch that ends first.)
alone : {w : HFunctor}
      -> {a : Type}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> Res w a
      -> Co (w <+> Custodian.custodian) a
alone st (RDone x) = pure x
alone st (RAct m) = bind m (\r -> alone st r)
alone st (RNext g) = alone st (g MkUnit)
alone st (RStep (Spawn c k)) = do
  cust <- Custodian.current
  readyAgain st Nothing (st.thread (threadAt cust c))
  alone st (k MkUnit)
alone st (RStep (Yield k)) = alone st (k MkUnit)
alone st (RStep (NewChan s)) =
  s (Co (w <+> Custodian.custodian) a) (\t mk -> case mk of
    MkMakingChan k -> bind (madeChan st) (\ch -> alone st (k ch)))
alone st (RStep (NewIVar s)) =
  s (Co (w <+> Custodian.custodian) a) (\t mk -> case mk of
    MkMakingIVar k -> bind (madeIVar st) (\iv -> alone st (k iv)))
alone st (RStep (PutIVar s)) =
  s
    (Co (w <+> Custodian.custodian) a)
    (\t p -> bind (written Nothing p) (\k -> alone st k))
alone st (RStep (Sync bs)) = abandon
alone st (RStep (MadeNack nack k)) = alone st (k MkUnit)
alone st (RStep (Settled n k)) = alone st (k MkUnit)
alone st (RStep (Choose s)) =
  s (Co (w <+> Custodian.custodian) a) (\t ch -> case ch of
    MkChoosing bs k -> do
      v <-
        readyAlone
          st
          (List.map
             (\b u use -> use t (MkAloneBranch b (\q -> thenRes q k)))
             bs)
      case v of
        Just r -> alone st r
        Nothing -> abandon)

cmlAlg : {w : HFunctor}
       -> {a : Type}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> (cml w <+> Custodian.custodian <+> w).f (Res w) a
       -> Res w a
cmlAlg st (InL (InL p)) = RStep (stepThen (\x -> RDone x) p)
cmlAlg st (InL (InR (Given (Under k s)))) =
  s (Res w a) (\b r -> case r of
    MkRunning body after -> thenRes (inCustody k body) (\v -> RDone (after v)))
cmlAlg st (InL (InR q)) =
  RAct
    (op
       (InR (Custodian.custodianBy (\r -> alone st r) q))
       (\x -> pure (RDone x)))
cmlAlg st (InR q) =
  RAct
    (op
       (InL
          (w.hmap
             (resFunctor w)
             (coFunctor (w <+> Custodian.custodian))
             (\r -> alone st r)
             q))
       (\x -> pure (RDone x)))

cmlHandler : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Handler (cml w <+> Custodian.custodian <+> w)
cmlHandler st =
  { M = Res w
  , ret = \x -> RDone x
  , bind = \m f -> thenRes m f
  , malg = \p -> cmlAlg st p
  }

-- (the scheduler's state, its spawned threads' first turns made: the
-- thread put in the scheduler's world, `cml w <+> Custodian.custodian <+> w`, and handled, in
-- its own turn)
threaded : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Sched w
threaded st =
  { st
  | thread = \c on ->
        let s : Sched w = threaded st
        in run
          s
          False
          on
          (RNext
             (\u ->
                handle
                  (cmlHandler s)
                  (c
                     (cml w <+> Custodian.custodian <+> w)
                     (inl (cml w <+> Custodian.custodian) w)
                     (inr (cml w <+> Custodian.custodian) w))))
  }

-- (how many turns in a row a worker takes from its slot, before it puts
-- the next among those ready instead, so that the turns there are not
-- passed over for ever)
batchLimit : Int
batchLimit = 64

-- (the turn taken, on the worker whose slot this is, and after it the
-- one left in its slot, and so on, `n` taken so far in a row: the
-- limit reached, the next is put among those ready, where others are,
-- to be taken after them; dropped once the domains are to stop)
ran : {w : HFunctor}
    -> {{dm : Domain.domain <: w}}
    -> Sched w
    -> Slot w
    -> Turn w
    -> Int
    -> Co (w <+> Custodian.custodian) Unit
ran st slot turn n = do
  turn (Just slot)
  next <- takenFrom slot
  case next of
    Nothing -> pure ()
    Just t ->
      if n < batchLimit then ran st slot t (n + 1)
      else do
        stop <- Domain.get st.stopping
        q <- Domain.get st.ready
        if stop then pure ()
        else case q of
          MkPair Nil Nil -> ran st slot t 1
          _ -> readied st t

-- (the first of the turns ready, taken out, the mutex held: `Nothing`
-- where none is)
dequeued : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Co (w <+> Custodian.custodian) (Maybe (Turn w))
dequeued st = do
  q <- Domain.get st.ready
  case q of
    MkPair (x :: xs) back -> do
      Domain.set st.ready (MkPair xs back)
      pure (Just x)
    MkPair Nil Nil -> pure Nothing
    MkPair Nil back -> do
      Domain.set st.ready (MkPair (List.reverse back) Nil)
      dequeued st

-- (a turn taken from one of the slots, the first found holding one)
stolen : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> List (Slot w)
       -> Co (w <+> Custodian.custodian) (Maybe (Turn w))
stolen Nil = pure Nothing
stolen (slot :: slots) = do
  holding <- isHolding slot
  if holding
  then do
    t <- takenFrom slot
    case t of
      Just turn -> pure (Just turn)
      Nothing -> stolen slots
  else stolen slots

doneAll : {w : HFunctor}
        -> List (Co (w <+> Custodian.custodian) Unit)
        -> Co (w <+> Custodian.custodian) Unit
doneAll Nil = pure ()
doneAll (act :: acts) = do
  act
  doneAll (w := w) acts

-- (what other domains asked the slot's worker to do, done, on its
-- domain, in the order asked)
inboxDone : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Slot w
          -> Co (w <+> Custodian.custodian) Unit
inboxDone st slot = case waitsOf st slot of
  Nothing -> pure ()
  Just (MkPair o ws) -> do
    asked <- Domain.get ws.inbox
    case asked of
      Nil -> pure ()
      _ -> do
        Domain.lock st.mutex
        acts <- Domain.get ws.inbox
        Domain.set ws.inbox (Nil : List (Co (w <+> Custodian.custodian) Unit))
        Domain.unlock st.mutex
        doneAll (w := w) (List.reverse acts)

-- (the steps of the threads whose operations of the world are done,
-- each taken, on the slot's worker: a thread going on readied from it)
deliveredAll : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> Slot w
             -> List (Co (w <+> Custodian.custodian) (Stepped w))
             -> Co (w <+> Custodian.custodian) Unit
deliveredAll st slot Nil = pure ()
deliveredAll st slot (act :: acts) = do
  s <- act
  case s of
    GoesOn next -> readiedOn st (Just slot) (\on -> run st False on next)
    Resumed next turnOf -> readiedOn st (Just slot) (turnOf (\u -> next))
    Stopped -> pure ()
  deliveredAll st slot acts

-- (what other domains asked of the slot's worker done, and its
-- operations of the world finished since it last asked taken -- where
-- `wait`, waiting in the reactor for one, or to be woken)
serviced : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Slot w
         -> Bool
         -> Co (w <+> Custodian.custodian) Unit
serviced st slot wait = do
  inboxDone st slot
  on <- groupOn st (Just slot)
  case on of
    Nothing -> pure ()
    Just (MkPair o g) -> do
      done <- o.finished g wait
      deliveredAll st slot done

-- (how many rounds a worker takes, each a turn and those left in its
-- slot after, between asking its reactor which of its operations of
-- the world are done, not waiting)
roundsBetween : Int
roundsBetween = 8

-- (nothing for the worker to take, the mutex held: where it has
-- operations of the world pending, it waits in the reactor for one to
-- finish, or to be woken -- for a turn ready, or what another domain
-- asks of it -- what is asked of it done first; else on the condition,
-- counted among the domains waiting there)
waitedFor : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Slot w
          -> Co (w <+> Custodian.custodian) Unit
waitedFor st slot = case waitsOf st slot of
  Just (MkPair o ws) -> do
    g <- Domain.get ws.group
    n <- case g of
      Just grp -> o.pending grp
      Nothing -> pure 0
    asked <- Domain.get ws.inbox
    case asked of
      Nil ->
        if n > 0
        then do
          Domain.set ws.polling True
          _ <- Domain.fetchAdd st.polling 1
          Domain.unlock st.mutex
          serviced st slot True
          Domain.lock st.mutex
          Domain.set ws.polling False
          _ <- Domain.fetchAdd st.polling (0 - 1)
          pure ()
        else do
          _ <- Domain.fetchAdd st.idle 1
          Domain.wait st.work st.mutex
          _ <- Domain.fetchAdd st.idle (0 - 1)
          pure ()
      _ -> do
        Domain.unlock st.mutex
        inboxDone st slot
        Domain.lock st.mutex
  Nothing -> do
    _ <- Domain.fetchAdd st.idle 1
    Domain.wait st.work st.mutex
    _ <- Domain.fetchAdd st.idle (0 - 1)
    pure ()

-- (the next turn for a worker whose slot is empty, the mutex held: the
-- first of those ready; else, `looked` not yet, one taken from a
-- worker's slot, the mutex let go of meanwhile -- one there waits for a
-- thread that goes on computing, or is held by an operation of the
-- world's; else waiting for one (`waitedFor`); `Nothing` once the
-- domains are to stop)
taken : {w : HFunctor}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> Slot w
      -> Bool
      -> Co (w <+> Custodian.custodian) (Maybe (Turn w))
taken st slot looked = do
  stop <- Domain.get st.stopping
  if stop then pure Nothing
  else do
    first <- dequeued st
    case first of
      Just t -> pure (Just t)
      Nothing ->
        if looked
        then do
          waitedFor st slot
          taken st slot False
        else do
          Domain.unlock st.mutex
          other <- stolen st.slots
          Domain.lock st.mutex
          case other of
            Just t -> pure (Just t)
            Nothing -> taken st slot True

-- (a domain running threads, each turn it takes and those left in its
-- slot after, until it is to stop; every `roundsBetween` rounds, where
-- it waits on the world through the reactor, what is asked of it done
-- and its operations finished taken, the first readied run next)
worker : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> Slot w
       -> Int
       -> Co (w <+> Custodian.custodian) Unit
worker st slot rounds = do
  own <- case st.outside of
    Just o ->
      if rounds >= roundsBetween
      then do
        serviced st slot False
        takenFrom slot
      else pure Nothing
    Nothing -> pure Nothing
  next <- case own of
    Just t -> pure (Just t)
    Nothing -> do
      Domain.lock st.mutex
      t <- taken st slot False
      Domain.unlock st.mutex
      pure t
  case next of
    Just t -> do
      ran st slot t 1
      worker st slot (if rounds >= roundsBetween then 0 else rounds + 1)
    Nothing -> pure ()

-- (a worker's loop, a thread's failure in it caught: the first failure
-- of the run kept, the thread counted no more, and the loop gone on
-- with, the other threads not stopped.  One catch for the whole loop,
-- not one for each turn; main's turns catch their own, `run`)
guarded : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Slot w
        -> Co (w <+> Custodian.custodian) Unit
guarded st slot = do
  out <- Domain.tried (bind (later (\u -> worker st slot 0)) (\c -> c))
  case out of
    Right u -> pure ()
    Left why -> do
      threadFailed st False why
      guarded st slot

-- (a worker, on its domain: where the scheduler waits on the world
-- through the reactor, its group opened there first, and closed once it
-- stops, what is pending in it let go of)
workerOn : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> Slot w
         -> Co (w <+> Custodian.custodian) Unit
workerOn st slot = case waitsOf st slot of
  Nothing -> guarded st slot
  Just (MkPair o ws) -> do
    g <- o.open
    Domain.set ws.group (Just g)
    guarded st slot
    Domain.set ws.group (Nothing : Maybe (Group w))
    o.close g

-- (a domain for each slot, its worker, spawned in the scheduler's
-- scope)
workers : {e w : HFunctor}
        -> {s : Type}
        -> {{dm : Domain.domain <: w}}
        -> {{sp : Domain.scoped (w <+> Custodian.custodian) <: e}}
        -> Domain.Scope s (w <+> Custodian.custodian)
        -> Sched w
        -> List (Slot w)
        -> Co e Unit
workers sc st Nil = pure ()
workers sc st (slot :: slots) = do
  _ <- Domain.spawn sc (workerOn st slot)
  workers sc st slots

-- (`n` empty slots, numbered from `i`)
slotsMade : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Int
          -> Int
          -> Co (w <+> Custodian.custodian) (List (Slot w))
slotsMade i n =
  if n <= 0 then pure Nil
  else do
    slot <- slotMade i
    slots <- slotsMade (i + 1) (n - 1)
    pure (slot :: slots)

-- (`n` workers' waits, none begun)
waitsMade : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Int
          -> Co (w <+> Custodian.custodian) (List (Waits w))
waitsMade n =
  if n <= 0 then pure Nil
  else do
    group <- Domain.newAtomic (Nothing : Maybe (Group w))
    polling <- Domain.newAtomic False
    inbox <- Domain.newAtomic (Nil : List (Co (w <+> Custodian.custodian) Unit))
    rest <- waitsMade (n - 1)
    pure ({ group = group, polling = polling, inbox = inbox } :: rest)

-- (waiting, the mutex held, until main is done or every thread waits)
idleUntilDone : {w : HFunctor}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> Co (w <+> Custodian.custodian) Unit
idleUntilDone st = do
  d <- Domain.get st.done
  if d then pure ()
  else do
    Domain.wait st.finished st.mutex
    idleUntilDone st

-- (the workers told to stop, once main is done or every thread waits)
stopped : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Co (w <+> Custodian.custodian) Unit
stopped st = do
  Domain.lock st.mutex
  idleUntilDone st
  Domain.set st.stopping True
  Domain.broadcast st.work
  case st.outside of
    Just o -> wokenAllPolling o st.waits
    Nothing -> pure ()
  Domain.unlock st.mutex

-- (`c` and its threads scheduled, waiting on the world through the
-- reactor where `outside` gives its operations; run in the threads'
-- world with the custodian outside them after it, which takes the
-- custodian's operations they pass on)
scheduledBy : {w : HFunctor}
            -> {a : Type}
            -> {{dm : Domain.domain <: w}}
            -> Maybe (Outside w)
            -> Co (cml w <+> Custodian.custodian <+> w) a
            -> Co (w <+> Custodian.custodian) (Maybe a)
scheduledBy outside c = do
  numbers <- Domain.newAtomic 0
  draws <- Domain.newAtomic 1
  live <- Domain.newAtomic 0
  ready <-
    Domain.newAtomic (MkPair Nil Nil : Pair (List (Turn w)) (List (Turn w)))
  idle <- Domain.newAtomic 0
  n <- Domain.cores
  slots <- slotsMade 0 n
  waits <- case outside of
    Just o -> waitsMade n
    Nothing -> pure Nil
  mutex <- Domain.newMutex
  work <- Domain.newCondition
  finished <- Domain.newCondition
  done <- Domain.newAtomic False
  stopping <- Domain.newAtomic False
  polling <- Domain.newAtomic 0
  waiting <- Domain.newAtomic (Nil : List (Waiting w))
  failure <- Domain.newAtomic (Nothing : Maybe String)
  let st0 : Sched w =
    { numbers = numbers
    , draws = draws
    , live = live
    , ready = ready
    , idle = idle
    , slots = slots
    , mutex = mutex
    , work = work
    , finished = finished
    , done = done
    , stopping = stopping
    , outside = outside
    , waits = waits
    , polling = polling
    , waiting = waiting
    , thread = \t on -> pure ()
    , failure = failure
    }
  let st = threaded st0
  answer <- Domain.newAtomic (Nothing : Maybe a)
  let main : Res w Unit =
    RNext
      (\u ->
         thenRes
           (handle (cmlHandler st) c)
           (\x ->
              RAct (do
                Domain.set answer (Just x)
                finishedWith st
                pure (RDone MkUnit))))
  readyAgain st Nothing (\on -> run st True on main)
  with sc := Domain.scope do
    workers sc st slots
    lift
        (inj := inr
          (Domain.scoped (w <+> Custodian.custodian))
          (w <+> Custodian.custodian))
        (stopped st)
  dropped <- Domain.get waiting
  toldDropped dropped
  failed <- Domain.get failure
  case failed of
    Just why -> Domain.fail why
    Nothing -> Domain.get answer

-- | `c` and the threads it spawns, run on as many domains as the
-- | machine has cores (`Domain.cores`): `Just` main's answer, the other
-- | threads dropped where they stopped; or `Nothing` where main is not
-- | done and every thread waits at a base event, a deadlock.  A
-- | thread's operation of the world is done where it is, holding its
-- | domain until it is.  A thread that fails is done with that, the
-- | others going on; once the run is over, this fails as the first one
-- | that failed did (main's failure ends the run).  It runs in the
-- | threads' world `w`, which need not name a custodian: the one in the
-- | threads' world, which their `with`s give to, has the runtime's
-- | custodians outside it, reached through the domains'
-- | (`Domain.rooted`), or, where `w` names one, the one current where
-- | this runs.
scheduled : {w : HFunctor}
          -> {a : Type}
          -> {{dm : Domain.domain <: w}}
          -> Co (cml w <+> Custodian.custodian <+> w) a
          -> Co w (Maybe a)
scheduled c = Domain.rooted (scheduledBy Nothing c)

-- | `scheduled`, each domain waiting on the world through a reactor of
-- | its own (std.reactor's, the C backend's): a thread's operation of
-- | the world that would wait -- a socket read, an accept, a request
-- | sent, a sleep -- is pending, the thread waiting, as at a base event,
-- | and the others running meanwhile; it goes on, on that domain, once
-- | the operation is done.  In a `choose`, such an operation pending in
-- | a branch is that branch's base event: committed once it is done,
-- | where no other was first, and else let go of, undone -- a request
-- | not sent, a sleep not slept -- so `choose [recv ch, Time.sleep d]`
-- | waits on the channel no longer than `d`.  A thread waiting on the
-- | world is no deadlock.
scheduledWithReactor : {w : HFunctor}
                     -> {a : Type}
                     -> {{dm : Domain.domain <: w}}
                     -> {{rx : Reactor.reactor <: w}}
                     -> Co (cml w <+> Custodian.custodian <+> w) a
                     -> Co w (Maybe a)
scheduledWithReactor c =
  Domain.rooted
    (scheduledBy
       (Just
          { open = Reactor.open
          , within = \g -> Reactor.openWithin g
          , start = \g m -> Reactor.start g m
          , finished = \g wait -> Reactor.finished g wait
          , pending = \g -> Reactor.pending g
          , close = \g -> Reactor.close g
          , wake = \g -> Reactor.wake g
          })
       c)

-- A scheduler's scope
--------------------------------------------------------------------------------

-- | The threads of a `with _ := CML.threads do`: its body cml's main
-- | thread, run as `scheduled` runs one.
data Threads = OnDomains

-- | `with _ := CML.threads do ss`: `ss` cml's main thread, in the world
-- | of the block around with cml's own (`cml w <+> custodian <+> w`,
-- | `ss` spawning, sending, choosing), it and the threads it spawns run
-- | on domains, as by `scheduled`; the `with` comes to `Just` the body's
-- | value, or `Nothing` where every thread waits.  The `with` is done
-- | once the scheduler is: no thread of it goes on after the block.  The
-- | block's world `w` need not have the custodian's effect, as under
-- | `scheduled`, and a `main` that starts its threads names none.  A body's
-- | operation whose types do not say its `w`, the block's world, is
-- | given it, `said (w := e)`, as under `scheduled`.
threads : Threads
threads = OnDomains

-- | ... and of a `with _ := CML.threadsWithReactor do`, run as
-- | `scheduledWithReactor` runs one.
data ThreadsWithReactor = OnReactors

-- | `with _ := CML.threadsWithReactor do ss`: `CML.threads`, each domain
-- | waiting on the world through a reactor of its own, as by
-- | `scheduledWithReactor`.
threadsWithReactor : ThreadsWithReactor
threadsWithReactor = OnReactors

-- | A `with` of cml's threads: no name, its body in a world with cml,
-- | and the `with` comes to what main's answer is.
instance instanceBinderThreads : Binder Threads
instanceBinderThreads =
  { Contents = \w s -> Unit
  , World = \w -> cml w <+> Custodian.custodian <+> w
  , Result = \r -> Maybe r
  }

-- | ... with a reactor.
instance instanceBinderThreadsWithReactor : Binder ThreadsWithReactor
instanceBinderThreadsWithReactor =
  { Contents = \w s -> Unit
  , World = \w -> cml w <+> Custodian.custodian <+> w
  , Result = \r -> Maybe r
  }

-- | cml's threads held by a `with`: the body scheduled, its value main's.
instance instanceHolderThreads : {e : HFunctor}
                               -> {{dm : Domain.domain <: e}}
                               -> Holder
                                 e
                                 Threads
                                 (\s -> Unit)
                                 (\w -> cml w <+> Custodian.custodian <+> w)
                                 (\r -> Maybe r)
instanceHolderThreads =
  { held = \c written body ->
        scheduled (bind (body (s := Unit) MkUnit) (\p -> pure (fst p)))
  }

-- | ... with a reactor.
instance instanceHolderThreadsWithReactor : {e : HFunctor}
                                          -> {{dm : Domain.domain <: e}}
                                          -> {{rx : Reactor.reactor <: e}}
                                          -> Holder
                                            e
                                            ThreadsWithReactor
                                            (\s -> Unit)
                                            (\w ->
                                               cml w
                                               <+> Custodian.custodian
                                               <+> w)
                                            (\r -> Maybe r)
instanceHolderThreadsWithReactor =
  { held = \c written body ->
        scheduledWithReactor
          (bind (body (s := Unit) MkUnit) (\p -> pure (fst p)))
  }
