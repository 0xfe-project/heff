-- `Int`'s bits: an integer's, as two's complement has them, its sign
-- extended for ever (as Python's are) -- the and, or and xor of two, and
-- shifts.  Import it by a name, `import int as I`: `I.and`, `I.shiftL`, as
-- the fixed-width types' modules have them (`I32.and`).  (`Int` is a
-- keyword, so no module is named by it.)

primitive intAnd : Int -> Int -> Int
primitive intOr : Int -> Int -> Int
primitive intXor : Int -> Int -> Int
primitive intShl : Int -> Int -> Int
primitive intShr : Int -> Int -> Int

-- | The bits set in both.
and : Int -> Int -> Int
and = intAnd

-- | The bits set in either.
or : Int -> Int -> Int
or = intOr

-- | The bits set in one of the two.
xor : Int -> Int -> Int
xor = intXor

-- | Every bit flipped: `-x - 1`.
complement : Int -> Int
complement x = intXor x -1

-- | Times 2 to the power `n`; a negative `n` abandons.
shiftL : Int -> Int -> Int
shiftL = intShl

-- | Divided by 2 to the power `n`, rounding down: the bits shifted out
-- | lost, the sign shifted in; a negative `n` abandons.
shiftR : Int -> Int -> Int
shiftR = intShr

-- >>> and 12 10
-- 8

-- >>> or 1536 5
-- 1541

-- >>> xor 12 10
-- 6

-- >>> List.map complement [0, 5, -1]
-- Cons (-1) (Cons (-6) (Cons 0 Nil))

-- >>> and -1 255
-- 255

-- >>> and -256 1023
-- 768

-- >>> or -8 3
-- -5

-- >>> shiftL 1 70
-- 1180591620717411303424

-- >>> List.map (\n -> shiftR n 1) [5, -5, -1]
-- Cons 2 (Cons (-3) (Cons (-1) Nil))

-- >>> shiftR 1 -1
-- <abandoned>
