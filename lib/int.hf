-- `Int`'s bits: an integer's, as two's complement has them, its sign
-- extended for ever (as Python's are) -- the and, or and xor of two, and
-- shifts.  Import it by a name, `import int as I`: `I.and`, `I.shiftL`,
-- as its names are the prelude's; its instance, `bitwiseInt`, is the
-- prelude's `and`, `shiftL` and the others' at `Int`, wherever it is
-- imported.  (`Int` is a keyword, so no module is named by it.)

primitive intAnd : Int -> Int -> Int
primitive intOr : Int -> Int -> Int
primitive intXor : Int -> Int -> Int
primitive intShl : Int -> Int -> Int
primitive intShr : Int -> Int -> Int

-- | The bits set in both.
-- | >>> and 12 10
-- | 8
-- | >>> and -1 255
-- | 255
-- | >>> and -256 1023
-- | 768
and : Int -> Int -> Int
and = intAnd

-- | The bits set in either.
-- | >>> or 1536 5
-- | 1541
-- | >>> or -8 3
-- | -5
or : Int -> Int -> Int
or = intOr

-- | The bits set in one of the two.
-- | >>> xor 12 10
-- | 6
xor : Int -> Int -> Int
xor = intXor

-- | Every bit flipped: `-x - 1`.
-- | >>> List.map complement [0, 5, -1]
-- | Cons (-1) (Cons (-6) (Cons 0 Nil))
complement : Int -> Int
complement x = intXor x -1

-- | Times 2 to the power `n`; by a negative `n`, shifted right by `-n`
-- | instead.
-- | >>> shiftL 1 70
-- | 1180591620717411303424
-- | >>> List.map (\n -> shiftL n -1) [5, -5, -1]
-- | Cons 2 (Cons (-3) (Cons (-1) Nil))
shiftL : Int -> Int -> Int
shiftL = intShl

-- | Divided by 2 to the power `n`, rounding down: the bits shifted out
-- | lost, the sign shifted in; by a negative `n`, shifted left by `-n`
-- | instead.
-- | >>> List.map (\n -> shiftR n 1) [5, -5, -1]
-- | Cons 2 (Cons (-3) (Cons (-1) Nil))
-- | >>> List.map (\n -> shiftR n -3) [1, -5, 0]
-- | Cons 8 (Cons (-40) (Cons 0 Nil))
shiftR : Int -> Int -> Int
shiftR = intShr

-- | `Int`'s bits, for what asks for a `Bitwise Int`
instance bitwiseInt : Bitwise Int
bitwiseInt =
  { and = intAnd
  , or = intOr
  , xor = intXor
  , complement = complement
  , shiftL = intShl
  , shiftR = intShr
  }
