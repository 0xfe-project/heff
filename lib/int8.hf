-- `Int8`: the integers from -128 to 127, wrapping around as the
-- machine's do (two's complement): `fromInt 128` is -128.  A literal checked at `Int8` is one (`(7 : Int8)`).
-- Import it by a name, `import int8 as I8`, as its names are the
-- prelude's: `I8.add`, `I8.fromInt`.  Its instances are the prelude's
-- operators' at `Int8`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive int8Add : Int8 -> Int8 -> Int8
primitive int8Sub : Int8 -> Int8 -> Int8
primitive int8Mul : Int8 -> Int8 -> Int8
primitive int8Div : Int8 -> Int8 -> Int8
primitive int8Rem : Int8 -> Int8 -> Int8
primitive int8Lt : Int8 -> Int8 -> Bool
primitive int8Le : Int8 -> Int8 -> Bool
primitive int8And : Int8 -> Int8 -> Int8
primitive int8Or : Int8 -> Int8 -> Int8
primitive int8Xor : Int8 -> Int8 -> Int8
primitive int8Shl : Int8 -> Int8 -> Int8
primitive int8Shr : Int8 -> Int8 -> Int8
primitive int8Show : Int8 -> String
primitive int8FromInt : Int -> Int8
primitive int8ToInt : Int8 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int8
minBound = -128

-- | The greatest.
maxBound : Int8
maxBound = 127

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int8 -> Int8 -> Int8
add = int8Add

sub : Int8 -> Int8 -> Int8
sub = int8Sub

mul : Int8 -> Int8 -> Int8
mul = int8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int8 -> Int8 -> Int8
div = int8Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int8 -> Int8 -> Int8
rem = int8Rem

neg : Int8 -> Int8
neg x = int8Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int8 -> Int8 -> Bool
eq = int8Eq

lt : Int8 -> Int8 -> Bool
lt = int8Lt

le : Int8 -> Int8 -> Bool
le = int8Le

compare : Int8 -> Int8 -> Ordering
compare a b = if int8Lt a b then LT else if int8Eq a b then EQ else GT

min : Int8 -> Int8 -> Int8
min a b = if int8Le a b then a else b

max : Int8 -> Int8 -> Int8
max a b = if int8Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int8 -> Int8 -> Int8
and = int8And

-- | The bits set in either.
or : Int8 -> Int8 -> Int8
or = int8Or

-- | The bits set in one of the two.
xor : Int8 -> Int8 -> Int8
xor = int8Xor

-- | Every bit flipped.
complement : Int8 -> Int8
complement x = int8Xor x -1

-- | Shifted left by the second (modulo 8), the bits shifted out lost.
shiftL : Int8 -> Int8 -> Int8
shiftL = int8Shl

-- | Shifted right by the second (modulo 8), the sign copied in.
shiftR : Int8 -> Int8 -> Int8
shiftR = int8Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> Int8
fromInt = int8FromInt

toInt : Int8 -> Int
toInt = int8ToInt

show : Int8 -> String
show = int8Show

-- Instances: the prelude's operators and functions at `Int8`
--------------------------------------------------------------------------------

instance eqInt8 : Eq Int8
eqInt8 = { equal = int8Eq }

instance ordInt8 : Ord Int8
ordInt8 = { compare = compare, lt = int8Lt, le = int8Le }

instance addInt8 : Add Int8
addInt8 = { add = int8Add }

instance subInt8 : Sub Int8
subInt8 = { sub = int8Sub }

instance mulInt8 : Mul Int8
mulInt8 = { mul = int8Mul }

-- | >>> List.map show [7 / 2, -7 / 2, 7 / 0, minBound / -1]
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-128" Nil)))
instance divInt8 : Div Int8
divInt8 = { div = int8Div }

-- | >>> List.map show [7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance modInt8 : Mod Int8
modInt8 = { mod = int8Rem }

instance negInt8 : Neg Int8
negInt8 = { neg = neg }

instance zeroInt8 : HasZero Int8
zeroInt8 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsInt8 : Bits Int8
bitsInt8 =
  { and = int8And
  , or = int8Or
  , xor = int8Xor
  , complement = complement
  , shiftL = int8Shl
  , shiftR = int8Shr
  }
