-- `Int8`: the integers from -128 to 127, wrapping around as the
-- machine's do (two's complement): `fromInt 128` is -128.  A literal checked at `Int8` is one (`(7 : Int8)`).
-- Import it by a name, `import int8 as I8`, as its names are the
-- prelude's: `I8.add`, `I8.fromInt`.  Its operators, `+` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  (Another fixed-width type's value from one goes by way of an
-- `Int`: `toInt`, then the other's `fromInt`.)

import prelude

foreign import int8Add : Int8 -> Int8 -> Int8
foreign import int8Sub : Int8 -> Int8 -> Int8
foreign import int8Mul : Int8 -> Int8 -> Int8
foreign import int8Div : Int8 -> Int8 -> Int8
foreign import int8Rem : Int8 -> Int8 -> Int8
foreign import int8Lt : Int8 -> Int8 -> Bool
foreign import int8Le : Int8 -> Int8 -> Bool
foreign import int8And : Int8 -> Int8 -> Int8
foreign import int8Or : Int8 -> Int8 -> Int8
foreign import int8Xor : Int8 -> Int8 -> Int8
foreign import int8Shl : Int8 -> Int8 -> Int8
foreign import int8Shr : Int8 -> Int8 -> Int8
foreign import int8Show : Int8 -> String
foreign import int8FromInt : Int -> Int8
foreign import int8ToInt : Int8 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int8
minBound = -128

-- | The greatest.
maxBound : Int8
maxBound = 127

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int8 -> Int8 -> Int8
add = int8Add

sub : Int8 -> Int8 -> Int8
sub = int8Sub

mul : Int8 -> Int8 -> Int8
mul = int8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | `abandon`.
div : Int8 -> Int8 -> Int8
div = int8Div

-- | The remainder of `div`, of the sign of the dividend; by 0, `abandon`.
rem : Int8 -> Int8 -> Int8
rem = int8Rem

neg : Int8 -> Int8
neg x = int8Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int8 -> Int8 -> Bool
eq = int8Eq

lt : Int8 -> Int8 -> Bool
lt = int8Lt

le : Int8 -> Int8 -> Bool
le = int8Le

compare : Int8 -> Int8 -> Ordering
compare a b = if int8Lt a b then LT else if int8Eq a b then EQ else GT

min : Int8 -> Int8 -> Int8
min a b = if int8Le a b then a else b

max : Int8 -> Int8 -> Int8
max a b = if int8Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int8 -> Int8 -> Int8
and = int8And

-- | The bits set in either.
or : Int8 -> Int8 -> Int8
or = int8Or

-- | The bits set in one of the two.
xor : Int8 -> Int8 -> Int8
xor = int8Xor

-- | Every bit flipped.
complement : Int8 -> Int8
complement x = int8Xor x -1

-- | Shifted left by the second (modulo 8), the bits shifted out lost.
shiftL : Int8 -> Int8 -> Int8
shiftL = int8Shl

-- | Shifted right by the second (modulo 8), the sign copied in.
shiftR : Int8 -> Int8 -> Int8
shiftR = int8Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> Int8
fromInt = int8FromInt

toInt : Int8 -> Int
toInt = int8ToInt

show : Int8 -> String
show = int8Show

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=
infixl + - above == /= < <= > >=
infixl * / % above + -

(+) : Int8 -> Int8 -> Int8
(+) = int8Add

(-) : Int8 -> Int8 -> Int8
(-) = int8Sub

(*) : Int8 -> Int8 -> Int8
(*) = int8Mul

(/) : Int8 -> Int8 -> Int8
(/) = int8Div

(%) : Int8 -> Int8 -> Int8
(%) = int8Rem

(==) : Int8 -> Int8 -> Bool
(==) = int8Eq

(/=) : Int8 -> Int8 -> Bool
(/=) a b = not (int8Eq a b)

(<) : Int8 -> Int8 -> Bool
(<) = int8Lt

(<=) : Int8 -> Int8 -> Bool
(<=) = int8Le

(>) : Int8 -> Int8 -> Bool
(>) a b = int8Lt b a

(>=) : Int8 -> Int8 -> Bool
(>=) a b = int8Le b a
