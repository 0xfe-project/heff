-- `Int8`: the integers from -128 to 127, wrapping around as the
-- machine's do (two's complement): `fromInt 128` is -128.  A literal checked at `Int8` is one (`(7 : Int8)`).
-- Import it by a name, `import int8 as Int8`, as the other fixed-width
-- types' modules have the same names: `Int8.fromInt`, `Int8.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `Int8`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

module int8

primitive int8Add : Int8 -> Int8 -> Int8
primitive int8Sub : Int8 -> Int8 -> Int8
primitive int8Mul : Int8 -> Int8 -> Int8
primitive int8Div : Int8 -> Int8 -> Int8
primitive int8Rem : Int8 -> Int8 -> Int8
primitive int8Lt : Int8 -> Int8 -> Bool
primitive int8Le : Int8 -> Int8 -> Bool
primitive int8And : Int8 -> Int8 -> Int8
primitive int8Or : Int8 -> Int8 -> Int8
primitive int8Xor : Int8 -> Int8 -> Int8
primitive int8Shl : Int8 -> Int8 -> Int8
primitive int8Shr : Int8 -> Int8 -> Int8
primitive int8Show : Int8 -> String
primitive int8FromInt : Int -> Int8
primitive int8ToInt : Int8 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int8
minBound = -128

-- | The greatest.
maxBound : Int8
maxBound = 127

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int8 -> Int8 -> Int8
add = int8Add

sub : Int8 -> Int8 -> Int8
sub = int8Sub

mul : Int8 -> Int8 -> Int8
mul = int8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int8 -> Int8 -> Int8
div = int8Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int8 -> Int8 -> Int8
rem = int8Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : Int8 -> Int8 -> Bool
eq = int8Eq

lt : Int8 -> Int8 -> Bool
lt = int8Lt

le : Int8 -> Int8 -> Bool
le = int8Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> Int8
fromInt = int8FromInt

toInt : Int8 -> Int
toInt = int8ToInt

-- Instances: the prelude's operators and functions at `Int8`
--------------------------------------------------------------------------------

instance instanceEqualityInt8 : Equality Int8
instanceEqualityInt8 = { equal = int8Eq }

-- | >>> show (7 : Int8)
-- | "7"
instance instanceShowInt8 : Show Int8
instanceShowInt8 = { show = int8Show }

-- | As `show` writes it.
instance instanceToStringInt8 : ToString Int8
instanceToStringInt8 = { toString = int8Show }

instance instanceOrderInt8 : Order Int8
instanceOrderInt8 =
  { compare = \a b -> if int8Lt a b then LT else if int8Eq a b then EQ else GT
  , lt = int8Lt
  , le = int8Le
  }

instance instanceAdditionInt8 : Addition Int8
instanceAdditionInt8 = { add = int8Add }

instance instanceSubtractionInt8 : Subtraction Int8
instanceSubtractionInt8 = { sub = int8Sub }

instance instanceMultiplicationInt8 : Multiplication Int8
instanceMultiplicationInt8 = { mul = int8Mul }

-- | >>> List.map show ([7 / 2, -7 / 2, 7 / 0, minBound / -1] : List Int8)
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-128" Nil)))
instance instanceDivisionInt8 : Division Int8
instanceDivisionInt8 = { div = int8Div }

-- | >>> List.map show ([7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0] : List Int8)
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance instanceRemainderInt8 : Remainder Int8
instanceRemainderInt8 = { mod = int8Rem }

-- | The integer of the other sign, wrapped around: of `minBound`, itself.
instance instanceNegationInt8 : Negation Int8
instanceNegationInt8 = { neg = \x -> int8Sub 0 x }

instance instanceIsZeroInt8 : IsZero Int8
instanceIsZeroInt8 = { isZero = \x -> int8Eq x 0 }

-- | The bits, as two's complement has them: shifted left by the second
-- | (modulo 8), the bits shifted out lost, and right, the sign copied in;
-- | by a negative second, the other way (`shiftL x -n` is `shiftR x n`).
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : Int8)
-- | "25"
-- | >>> List.map show ([shiftL 3 -1, shiftR 3 -2, shiftL -128 -9, shiftL 1 9] : List Int8)
-- | Cons "1" (Cons "12" (Cons "-64" (Cons "2" Nil)))
instance instanceBitwiseInt8 : Bitwise Int8
instanceBitwiseInt8 =
  { and = int8And
  , or = int8Or
  , xor = int8Xor
  , complement = \x -> int8Xor x -1
  , shiftL = int8Shl
  , shiftR = int8Shr
  }
