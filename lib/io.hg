-- A program's world as an effect (lib/co.hg): its output, its input, its
-- arguments and environment, files, and how it ends.  A program is a
-- computation with it, `Co io Unit`: `heff node` writes it as a Node.js
-- program, whose handler is written in JavaScript (its monad: the
-- continuation monad, so what Node does asynchronously is plain `do` here).

import co
import prelude

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`)
data IoF (m :: Type -> Type) x
  = Write String x
  | WriteErr String x
  | ReadStdin (String -> x)
  | Args (List String -> x)
  | GetEnv String (Maybe String -> x)
  | ReadFile String (Maybe String -> x)
  | WriteFile String String (Bool -> x)
  | Exit Int x

-- | A program's world as an effect.
io :: HFunctor
io =
  { f = IoF
  , hmap = \nt p -> case p of
      Write str x -> Write str x
      WriteErr str x -> WriteErr str x
      ReadStdin k -> ReadStdin k
      Args k -> Args k
      GetEnv name k -> GetEnv name k
      ReadFile path k -> ReadFile path k
      WriteFile path str k -> WriteFile path str k
      Exit code x -> Exit code x
  }

-- | Write to the standard output, as it is.
write :: String -> Co io Unit
write str = op (Write str MkUnit) val

-- | Write a line to the standard output.
print :: String -> Co io Unit
print str = write (str ++ "\n")

-- | Write a line to the standard error.
printErr :: String -> Co io Unit
printErr str = op (WriteErr (str ++ "\n") MkUnit) val

-- | All of the standard input, when it has ended.
readStdin :: Co io String
readStdin = op (ReadStdin (\s -> s)) val

-- | The program's arguments (not Node's, nor the program's own path).
args :: Co io (List String)
args = op (Args (\a -> a)) val

-- | An environment variable, if it is set.
getEnv :: String -> Co io (Maybe String)
getEnv name = op (GetEnv name (\v -> v)) val

-- | A file's text, if it could be read.
readFile :: String -> Co io (Maybe String)
readFile path = op (ReadFile path (\t -> t)) val

-- | Write a file (a new one, or over what it had): whether it was written.
writeFile :: String -> String -> Co io Bool
writeFile path str = op (WriteFile path str (\ok -> ok)) val

-- | End the program, with a status (0: it went well); nothing after it runs.
exit :: Int -> Co io Unit
exit code = op (Exit code MkUnit) val
