-- `Int16`: the integers from -32768 to 32767, wrapping around as the
-- machine's do (two's complement): `fromInt 32768` is -32768.  A literal checked at `Int16` is one (`(7 : Int16)`).
-- Import it by a name, `import int16 as I16`, as its names are the
-- prelude's: `I16.add`, `I16.fromInt`.  Its instances are the prelude's
-- operators' at `Int16`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive int16Add : Int16 -> Int16 -> Int16
primitive int16Sub : Int16 -> Int16 -> Int16
primitive int16Mul : Int16 -> Int16 -> Int16
primitive int16Div : Int16 -> Int16 -> Int16
primitive int16Rem : Int16 -> Int16 -> Int16
primitive int16Lt : Int16 -> Int16 -> Bool
primitive int16Le : Int16 -> Int16 -> Bool
primitive int16And : Int16 -> Int16 -> Int16
primitive int16Or : Int16 -> Int16 -> Int16
primitive int16Xor : Int16 -> Int16 -> Int16
primitive int16Shl : Int16 -> Int16 -> Int16
primitive int16Shr : Int16 -> Int16 -> Int16
primitive int16Show : Int16 -> String
primitive int16FromInt : Int -> Int16
primitive int16ToInt : Int16 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int16
minBound = -32768

-- | The greatest.
maxBound : Int16
maxBound = 32767

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int16 -> Int16 -> Int16
add = int16Add

sub : Int16 -> Int16 -> Int16
sub = int16Sub

mul : Int16 -> Int16 -> Int16
mul = int16Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int16 -> Int16 -> Int16
div = int16Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int16 -> Int16 -> Int16
rem = int16Rem

neg : Int16 -> Int16
neg x = int16Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int16 -> Int16 -> Bool
eq = int16Eq

lt : Int16 -> Int16 -> Bool
lt = int16Lt

le : Int16 -> Int16 -> Bool
le = int16Le

compare : Int16 -> Int16 -> Ordering
compare a b = if int16Lt a b then LT else if int16Eq a b then EQ else GT

min : Int16 -> Int16 -> Int16
min a b = if int16Le a b then a else b

max : Int16 -> Int16 -> Int16
max a b = if int16Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int16 -> Int16 -> Int16
and = int16And

-- | The bits set in either.
or : Int16 -> Int16 -> Int16
or = int16Or

-- | The bits set in one of the two.
xor : Int16 -> Int16 -> Int16
xor = int16Xor

-- | Every bit flipped.
complement : Int16 -> Int16
complement x = int16Xor x -1

-- | Shifted left by the second (modulo 16), the bits shifted out lost.
shiftL : Int16 -> Int16 -> Int16
shiftL = int16Shl

-- | Shifted right by the second (modulo 16), the sign copied in.
shiftR : Int16 -> Int16 -> Int16
shiftR = int16Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int16` an integer wraps around to: equal to it modulo 2^16.
fromInt : Int -> Int16
fromInt = int16FromInt

toInt : Int16 -> Int
toInt = int16ToInt

show : Int16 -> String
show = int16Show

-- Instances: the prelude's operators and functions at `Int16`
--------------------------------------------------------------------------------

instance eqInt16 : Eq Int16
eqInt16 = { equal = int16Eq }

instance ordInt16 : Ord Int16
ordInt16 = { compare = compare, lt = int16Lt, le = int16Le }

instance addInt16 : Add Int16
addInt16 = { add = int16Add }

instance subInt16 : Sub Int16
subInt16 = { sub = int16Sub }

instance mulInt16 : Mul Int16
mulInt16 = { mul = int16Mul }

-- | >>> List.map show [7 / 2, -7 / 2, 7 / 0, minBound / -1]
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-32768" Nil)))
instance divInt16 : Div Int16
divInt16 = { div = int16Div }

-- | >>> List.map show [7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance modInt16 : Mod Int16
modInt16 = { mod = int16Rem }

instance negInt16 : Neg Int16
negInt16 = { neg = neg }

instance zeroInt16 : HasZero Int16
zeroInt16 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsInt16 : Bits Int16
bitsInt16 =
  { and = int16And
  , or = int16Or
  , xor = int16Xor
  , complement = complement
  , shiftL = int16Shl
  , shiftR = int16Shr
  }
