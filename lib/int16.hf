-- `Int16`: the integers from -32768 to 32767, wrapping around as the
-- machine's do (two's complement): `fromInt 32768` is -32768.  A literal checked at `Int16` is one (`(7 : Int16)`).
-- Import it by a name, `import int16 as Int16`, as the other fixed-width
-- types' modules have the same names: `Int16.fromInt`, `Int16.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `Int16`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

module int16

primitive int16Add : Int16 -> Int16 -> Int16
primitive int16Sub : Int16 -> Int16 -> Int16
primitive int16Mul : Int16 -> Int16 -> Int16
primitive int16Div : Int16 -> Int16 -> Int16
primitive int16Rem : Int16 -> Int16 -> Int16
primitive int16Lt : Int16 -> Int16 -> Bool
primitive int16Le : Int16 -> Int16 -> Bool
primitive int16And : Int16 -> Int16 -> Int16
primitive int16Or : Int16 -> Int16 -> Int16
primitive int16Xor : Int16 -> Int16 -> Int16
primitive int16Shl : Int16 -> Int16 -> Int16
primitive int16Shr : Int16 -> Int16 -> Int16
primitive int16Show : Int16 -> String
primitive int16FromInt : Int -> Int16
primitive int16ToInt : Int16 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int16
minBound = -32768

-- | The greatest.
maxBound : Int16
maxBound = 32767

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int16 -> Int16 -> Int16
add = int16Add

sub : Int16 -> Int16 -> Int16
sub = int16Sub

mul : Int16 -> Int16 -> Int16
mul = int16Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int16 -> Int16 -> Int16
div = int16Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int16 -> Int16 -> Int16
rem = int16Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : Int16 -> Int16 -> Bool
eq = int16Eq

lt : Int16 -> Int16 -> Bool
lt = int16Lt

le : Int16 -> Int16 -> Bool
le = int16Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int16` an integer wraps around to: equal to it modulo 2^16.
fromInt : Int -> Int16
fromInt = int16FromInt

toInt : Int16 -> Int
toInt = int16ToInt

-- Instances: the prelude's operators and functions at `Int16`
--------------------------------------------------------------------------------

instance instanceEqualityInt16 : Equality Int16
instanceEqualityInt16 = { equal = int16Eq }

-- | >>> debug (7 : Int16)
-- | "7"
instance instanceDebugInt16 : Debug Int16
instanceDebugInt16 = { debug = int16Show }

-- | As `debug` writes it.
instance instanceShowInt16 : Show Int16
instanceShowInt16 = { show = int16Show }

instance instanceOrderInt16 : Order Int16
instanceOrderInt16 =
  { eq = instanceEqualityInt16
  , compare = \a b -> if int16Lt a b then LT else if int16Eq a b then EQ else GT
  , lt = int16Lt
  , le = int16Le
  }

instance instanceAdditionInt16 : Addition Int16
instanceAdditionInt16 = { add = int16Add }

instance instanceSubtractionInt16 : Subtraction Int16
instanceSubtractionInt16 = { sub = int16Sub }

instance instanceMultiplicationInt16 : Multiplication Int16
instanceMultiplicationInt16 = { mul = int16Mul }

-- | >>> List.map debug ([7 / 2, -7 / 2, 7 / 0, minBound / -1] : List Int16)
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-32768" Nil)))
instance instanceDivisionInt16 : Division Int16
instanceDivisionInt16 = { div = int16Div }

-- | >>> List.map debug ([7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0] : List Int16)
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance instanceRemainderInt16 : Remainder Int16
instanceRemainderInt16 = { mod = int16Rem }

-- | The integer of the other sign, wrapped around: of `minBound`, itself.
instance instanceNegationInt16 : Negation Int16
instanceNegationInt16 = { neg = \x -> int16Sub 0 x }

instance instanceIsZeroInt16 : IsZero Int16
instanceIsZeroInt16 = { isZero = \x -> int16Eq x 0 }

-- | The bits, as two's complement has them: shifted left by the second
-- | (modulo 16), the bits shifted out lost, and right, the sign copied in;
-- | by a negative second, the other way (`shiftL x -n` is `shiftR x n`).
-- | >>> debug (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : Int16)
-- | "25"
instance instanceBitwiseInt16 : Bitwise Int16
instanceBitwiseInt16 =
  { and = int16And
  , or = int16Or
  , xor = int16Xor
  , complement = \x -> int16Xor x -1
  , shiftL = int16Shl
  , shiftR = int16Shr
  }
