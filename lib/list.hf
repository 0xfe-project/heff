-- The operations of lists, which every module has by the name `List`
-- without importing it: `List.map`, `List.foldl`, `List.length`.  The
-- type and its tags are builtin's, `[a, b]` its notation, and `x :: xs`
-- and `xs ++ ys` the prelude's.

module list

map : {a b : Type} -> (a -> b) -> List a -> List b
map f Nil = Nil
map f (x :: xs) = f x :: map f xs

foldl : {a b : Type} -> (b -> a -> b) -> b -> List a -> b
foldl f z Nil = z
foldl f z (Cons x xs) = foldl f (f z x) xs

reverse : {a : Type} -> List a -> List a
reverse xs = foldl (\acc x -> Cons x acc) Nil xs

-- | From the last element: `f x1 (f x2 (… z))`.  (By way of `reverse`, so
-- | a long list does not go as deep as it is long.)
foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z xs = foldl (\acc x -> f x acc) z (reverse xs)

keepIf : {a : Type} -> (a -> Bool) -> List a -> List a
keepIf p Nil = Nil
keepIf p (Cons x xs) = if p x then Cons x (keepIf p xs) else keepIf p xs

-- | >>> length (map (\x -> x * 2) (Cons 1 (Cons 2 (Cons 3 Nil))))
-- | 3
length : {a : Type} -> List a -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

-- | `xs ++ ys`, by a name.
-- | >>> append [1, 2] [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
append : {a : Type} -> List a -> List a -> List a
append xs ys = xs ++ ys

concatMap : {a b : Type} -> (a -> List b) -> List a -> List b
concatMap f xs = foldr (\x acc -> append (f x) acc) Nil xs

null : {a : Type} -> List a -> Bool
null Nil = True
null (Cons _ _) = False

head : {a : Type} -> List a -> Maybe a
head Nil = Nothing
head (Cons x _) = Just x

tail : {a : Type} -> List a -> Maybe (List a)
tail Nil = Nothing
tail (Cons _ xs) = Just xs

last : {a : Type} -> List a -> Maybe a
last xs = head (reverse xs)

-- | The first `n` elements (all, if there are fewer).
take : {a : Type} -> Int -> List a -> List a
take n Nil = Nil
take n (Cons x xs) = if n <= 0 then Nil else Cons x (take (n - 1) xs)

-- | What is left after the first `n`.
drop : {a : Type} -> Int -> List a -> List a
drop n Nil = Nil
drop n (Cons x xs) = if n <= 0 then Cons x xs else drop (n - 1) xs

zipWith : {a b c : Type} -> (a -> b -> c) -> List a -> List b -> List c
zipWith f (Cons x xs) (Cons y ys) = Cons (f x y) (zipWith f xs ys)
zipWith f xs ys = Nil

zip : {a b : Type} -> List a -> List b -> List (Pair a b)
zip xs ys = zipWith (\x y -> MkPair x y) xs ys

any : {a : Type} -> (a -> Bool) -> List a -> Bool
any p Nil = False
any p (Cons x xs) = if p x then True else any p xs

all : {a : Type} -> (a -> Bool) -> List a -> Bool
all p Nil = True
all p (Cons x xs) = if p x then all p xs else False

find : {a : Type} -> (a -> Bool) -> List a -> Maybe a
find p Nil = Nothing
find p (Cons x xs) = if p x then Just x else find p xs

-- | Whether `x` is in the list, by the equality given.
elemBy : {a : Type} -> (a -> a -> Bool) -> a -> List a -> Bool
elemBy eq x xs = any (eq x) xs

-- | The value paired with the first key equal to `k`, by the equality
-- | given.
lookupBy : {k v : Type} -> (k -> k -> Bool) -> k -> List (Pair k v) -> Maybe v
lookupBy eq k Nil = Nothing
lookupBy eq k (Cons (MkPair k' v) rest) =
  if eq k k' then Just v else lookupBy eq k rest

sum : List Int -> Int
sum xs = foldl (\a b -> a + b) 0 xs

product : List Int -> Int
product xs = foldl (\a b -> a * b) 1 xs

-- | `a`, `a + 1`, …, `b`.
range : Int -> Int -> List Int
range a b = if a > b then Nil else Cons a (range (a + 1) b)

replicate : {a : Type} -> Int -> a -> List a
replicate n x = if n <= 0 then Nil else Cons x (replicate (n - 1) x)

-- (whether the first of `as` goes before the first of `bs`, `as` the
-- left one of two merged if `left`: of two that go together, the left
-- one's first; either empty, true)
goesFirst : {a : Type} -> (a -> a -> Bool) -> Bool -> List a -> List a -> Bool
goesFirst le left (Cons a _) (Cons b _) = if left then le a b else not (le b a)
goesFirst le left xs ys = True

-- (two sorted lists, as one, the first of `xs` going first: `xs` the
-- left one if `left`.  Each cell is the one taken apart, where nothing
-- else holds it, so a merge makes none)
mergeFrom : {a : Type} -> (a -> a -> Bool) -> Bool -> List a -> List a -> List a
mergeFrom le left Nil ys = ys
mergeFrom le left (Cons x rest) Nil = Cons x rest
mergeFrom le left (Cons x rest) ys =
  if goesFirst le left rest ys then Cons x (mergeFrom le left rest ys)
  else Cons x (mergeFrom le (not left) ys rest)

-- (two sorted lists, as one: of two that go together, the first's
-- first)
merge : {a : Type} -> (a -> a -> Bool) -> List a -> List a -> List a
merge le xs ys =
  if goesFirst le True xs ys then mergeFrom le True xs ys
  else mergeFrom le False ys xs

-- (a run going up: `acc` the run so far, the other way round, its last
-- `x`, as long as each next goes after it or with it; the run and what
-- is left)
ascending : {a : Type}
          -> (a -> a -> Bool)
          -> a
          -> List a
          -> List a
          -> Pair (List a) (List a)
ascending le x acc Nil = MkPair (reverse acc) Nil
ascending le x acc (Cons y ys) =
  if le x y then ascending le y (Cons y acc) ys
  else MkPair (reverse acc) (Cons y ys)

-- (a run going strictly down: `acc` the run so far, the other way round,
-- so going up, its last `x`; the run and what is left -- no two of it
-- equal, so it is turned round stably)
descending : {a : Type}
           -> (a -> a -> Bool)
           -> a
           -> List a
           -> List a
           -> Pair (List a) (List a)
descending le x acc Nil = MkPair acc Nil
descending le x acc (Cons y ys) =
  if le x y then MkPair acc (Cons y ys)
  else descending le y (Cons y acc) ys

-- (the run from `x` on, up or strictly down, put going up; and what is
-- left)
runFrom : {a : Type}
        -> (a -> a -> Bool)
        -> a
        -> List a
        -> Pair (List a) (List a)
runFrom le x Nil = MkPair [x] Nil
runFrom le x (Cons y ys) =
  if le x y then ascending le y [y, x] ys else descending le y [y, x] ys

-- (a run put on the runs before it, the last on top, each with how many
-- runs it was made of as a power of 2: merged with the one under it while
-- that was made of as many)
pushRun : {a : Type}
        -> (a -> a -> Bool)
        -> Int
        -> List a
        -> List (Pair Int (List a))
        -> List (Pair Int (List a))
pushRun le k run Nil = [MkPair k run]
pushRun le k run (Cons (MkPair j below) rest) =
  if j == k then pushRun le (k + 1) (merge le below run) rest
  else Cons (MkPair k run) (Cons (MkPair j below) rest)

-- (the last run merged with those under it, from the top)
collapse : {a : Type}
         -> (a -> a -> Bool)
         -> List a
         -> List (Pair Int (List a))
         -> List a
collapse le run Nil = run
collapse le run (Cons (MkPair j below) rest) =
  collapse le (merge le below run) rest

-- (the runs of what is left, from the run before it, each merged as it
-- comes with those before it: two by two, as runs of runs are, but each
-- two as soon as they are read, while they are near in memory)
mergeRuns : {a : Type}
          -> (a -> a -> Bool)
          -> List (Pair Int (List a))
          -> Pair (List a) (List a)
          -> List a
mergeRuns le stack (MkPair run Nil) = collapse le run stack
mergeRuns le stack (MkPair run (Cons x xs)) =
  mergeRuns le (pushRun le 0 run stack) (runFrom le x xs)

-- | Sorted by `le` (whether one goes before, or with, another), stably:
-- | the runs it has, going up or strictly down, merged two by two, each
-- | two as soon as they are read (a sorted list is one run, so is gone
-- | through once).
-- | >>> sortBy (\a b -> fst a <= fst b) [MkPair 2 "a", MkPair 1 "b", MkPair 2 "c", MkPair 1 "d"]
-- | Cons (MkPair 1 "b") (Cons (MkPair 1 "d") (Cons (MkPair 2 "a") (Cons (MkPair 2 "c") Nil)))
-- | >>> sortBy (\a b -> a >= b) [1, 3, 2, 3, 5, 4]
-- | Cons 5 (Cons 4 (Cons 3 (Cons 3 (Cons 2 (Cons 1 Nil)))))
sortBy : {a : Type} -> (a -> a -> Bool) -> List a -> List a
sortBy le Nil = Nil
sortBy le (Cons x xs) = mergeRuns le Nil (runFrom le x xs)

-- | Sorted by the elements' `Order`, stably.
-- | >>> sort [3, 1, 2, 1]
-- | Cons 1 (Cons 1 (Cons 2 (Cons 3 Nil)))
sort : {a : Type} -> {{ord : Order a}} -> List a -> List a
sort xs = sortBy (\a b -> a <= b) xs
