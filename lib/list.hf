-- The operations of lists, which every module has by the name `List`
-- without importing it: `List.map`, `List.foldl`, `List.length`.  The
-- type and its tags are builtin's, `[a, b]` its notation, and `x :: xs`
-- and `xs ++ ys` the prelude's.

module list
  ( map
  , foldl
  , reverse
  , foldr
  , keepIf
  , length
  , append
  , concatMap
  , null
  , head
  , tail
  , last
  , init
  , take
  , drop
  , zipWith
  , zip
  , any
  , all
  , find
  , elem
  , lookup
  , sum
  , product
  , range
  , replicate
  , sortOn
  , sort
  , concat
  , index
  , indexed
  , indexWhere
  , count
  , mapMaybe
  , partition
  , takeWhile
  , dropWhile
  , span
  , split
  , group
  , unique
  , intersperse
  , unzip
  , scanl
  , minimum
  , maximum
  )

map : {a b : Type} -> (a -> b) -> List a -> List b
map f [] = Nil
map f (x :: xs) = f x :: map f xs

foldl : {a b : Type} -> (b -> a -> b) -> b -> List a -> b
foldl f z [] = z
foldl f z (x :: xs) = foldl f (f z x) xs

reverse : {a : Type} -> List a -> List a
reverse xs = foldl (\acc x -> x :: acc) Nil xs

-- | From the last element: `f x1 (f x2 (… z))`.  (By way of `reverse`, so
-- | a long list does not go as deep as it is long.)
foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z xs = foldl (\acc x -> f x acc) z (reverse xs)

keepIf : {a : Type} -> (a -> Bool) -> List a -> List a
keepIf p [] = Nil
keepIf p (x :: xs) = if p x then x :: keepIf p xs else keepIf p xs

-- | >>> length (map (\x -> x * 2) [1, 2, 3])
-- | 3
length : {a : Type} -> List a -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

-- | `xs ++ ys`, by a name.
-- | >>> append [1, 2] [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
append : {a : Type} -> List a -> List a -> List a
append xs ys = xs ++ ys

concatMap : {a b : Type} -> (a -> List b) -> List a -> List b
concatMap f xs = foldr (\x acc -> append (f x) acc) Nil xs

null : {a : Type} -> List a -> Bool
null [] = True
null (_ :: _) = False

head : {a : Type} -> List a -> Maybe a
head [] = Nothing
head (x :: _) = Just x

tail : {a : Type} -> List a -> Maybe (List a)
tail [] = Nothing
tail (_ :: xs) = Just xs

last : {a : Type} -> List a -> Maybe a
last xs = head (reverse xs)

-- | All but the last element, if there is one: `last` the other way.
-- | >>> map init [[1, 2, 3], []]
-- | Cons (Just (Cons 1 (Cons 2 Nil))) (Cons Nothing Nil)
init : {a : Type} -> List a -> Maybe (List a)
init [] = Nothing
init (x :: xs) = case reverse (x :: xs) of
  _ :: rest -> Just (reverse rest)
  [] -> Nothing

-- | The first `n` elements (all, if there are fewer).
take : {a : Type} -> Int -> List a -> List a
take n [] = Nil
take n (x :: xs) = if n <= 0 then Nil else x :: take (n - 1) xs

-- | What is left after the first `n`.
drop : {a : Type} -> Int -> List a -> List a
drop n [] = Nil
drop n (x :: xs) = if n <= 0 then x :: xs else drop (n - 1) xs

zipWith : {a b c : Type} -> (a -> b -> c) -> List a -> List b -> List c
zipWith f (x :: xs) (y :: ys) = f x y :: zipWith f xs ys
zipWith f xs ys = Nil

zip : {a b : Type} -> List a -> List b -> List (Pair a b)
zip xs ys = zipWith (\x y -> MkPair x y) xs ys

any : {a : Type} -> (a -> Bool) -> List a -> Bool
any p [] = False
any p (x :: xs) = if p x then True else any p xs

all : {a : Type} -> (a -> Bool) -> List a -> Bool
all p [] = True
all p (x :: xs) = if p x then all p xs else False

find : {a : Type} -> (a -> Bool) -> List a -> Maybe a
find p [] = Nothing
find p (x :: xs) = if p x then Just x else find p xs

-- | Whether `x` is in the list.
-- | >>> elem 2 [1, 2, 3] && not (elem "d" ["a", "b", "c"])
-- | True
elem : {a : Type} -> {{eq : Equality a}} -> a -> List a -> Bool
elem x xs = any (\y -> x == y) xs

-- | The value paired with the first key equal to `k`.
-- | >>> lookup "b" [MkPair "a" 1, MkPair "b" 2]
-- | Just 2
lookup : {k v : Type} -> {{eq : Equality k}} -> k -> List (Pair k v) -> Maybe v
lookup k [] = Nothing
lookup k (MkPair k' v :: rest) = if k == k' then Just v else lookup k rest

sum : List Int -> Int
sum xs = foldl (\a b -> a + b) 0 xs

product : List Int -> Int
product xs = foldl (\a b -> a * b) 1 xs

-- | `a`, `a + 1`, …, `b`.
range : Int -> Int -> List Int
range a b = if a > b then Nil else a :: range (a + 1) b

replicate : {a : Type} -> Int -> a -> List a
replicate n x = if n <= 0 then Nil else x :: replicate (n - 1) x

-- (whether the first of `as` goes before the first of `bs`, `as` the
-- left one of two merged if `left`: of two that go together, the left
-- one's first; either empty, true)
goesFirst : {a : Type} -> (a -> a -> Bool) -> Bool -> List a -> List a -> Bool
goesFirst le left (a :: _) (b :: _) = if left then le a b else not (le b a)
goesFirst le left xs ys = True

-- (two sorted lists, as one: of two that go together, the first's
-- first)
merge : {a : Type} -> (a -> a -> Bool) -> List a -> List a -> List a
merge le xs ys =
  if goesFirst le True xs ys then mergeFrom True xs ys
  else mergeFrom False ys xs
  where
  -- (two sorted lists, as one, the first of `xs` going first: `xs` the
  -- left one if `left`.  Each cell is the one taken apart, where nothing
  -- else holds it, so a merge makes none)
  mergeFrom : Bool -> List a -> List a -> List a
  mergeFrom left [] ys = ys
  mergeFrom left (x :: rest) [] = x :: rest
  mergeFrom left (x :: rest) ys =
    if goesFirst le left rest ys then x :: mergeFrom left rest ys
    else x :: mergeFrom (not left) ys rest

-- (a run going up: `acc` the run so far, the other way round, its last
-- `x`, as long as each next goes after it or with it; the run and what
-- is left)
ascending : {a : Type}
          -> (a -> a -> Bool)
          -> a
          -> List a
          -> List a
          -> Pair (List a) (List a)
ascending le x acc [] = MkPair (reverse acc) Nil
ascending le x acc (y :: ys) =
  if le x y then ascending le y (y :: acc) ys
  else MkPair (reverse acc) (y :: ys)

-- (a run going strictly down: `acc` the run so far, the other way round,
-- so going up, its last `x`; the run and what is left -- no two of it
-- equal, so it is turned round stably)
descending : {a : Type}
           -> (a -> a -> Bool)
           -> a
           -> List a
           -> List a
           -> Pair (List a) (List a)
descending le x acc [] = MkPair acc Nil
descending le x acc (y :: ys) =
  if le x y then MkPair acc (y :: ys)
  else descending le y (y :: acc) ys

-- (the run from `x` on, up or strictly down, put going up; and what is
-- left)
runFrom : {a : Type}
        -> (a -> a -> Bool)
        -> a
        -> List a
        -> Pair (List a) (List a)
runFrom le x [] = MkPair [x] Nil
runFrom le x (y :: ys) =
  if le x y then ascending le y [y, x] ys else descending le y [y, x] ys

-- (a run put on the runs before it, the last on top, each with how many
-- runs it was made of as a power of 2: merged with the one under it while
-- that was made of as many)
pushRun : {a : Type}
        -> (a -> a -> Bool)
        -> Int
        -> List a
        -> List (Pair Int (List a))
        -> List (Pair Int (List a))
pushRun le k run [] = [MkPair k run]
pushRun le k run (MkPair j below :: rest) =
  if j == k then pushRun le (k + 1) (merge le below run) rest
  else MkPair k run :: MkPair j below :: rest

-- (the last run merged with those under it, from the top)
collapse : {a : Type}
         -> (a -> a -> Bool)
         -> List a
         -> List (Pair Int (List a))
         -> List a
collapse le run [] = run
collapse le run (MkPair j below :: rest) = collapse le (merge le below run) rest

-- (the runs of what is left, from the run before it, each merged as it
-- comes with those before it: two by two, as runs of runs are, but each
-- two as soon as they are read, while they are near in memory)
mergeRuns : {a : Type}
          -> (a -> a -> Bool)
          -> List (Pair Int (List a))
          -> Pair (List a) (List a)
          -> List a
mergeRuns le stack (MkPair run []) = collapse le run stack
mergeRuns le stack (MkPair run (x :: xs)) =
  mergeRuns le (pushRun le 0 run stack) (runFrom le x xs)

-- | Sorted by `key`'s `Order`, stably: of two whose keys are equal, the
-- | first first.  The runs it has, going up or strictly down, merged two
-- | by two, each two as soon as they are read (a sorted list is one run,
-- | so is gone through once).
-- | >>> sortOn (\p -> fst p) [MkPair 2 "a", MkPair 1 "b", MkPair 2 "c", MkPair 1 "d"]
-- | Cons (MkPair 1 "b") (Cons (MkPair 1 "d") (Cons (MkPair 2 "a") (Cons (MkPair 2 "c") Nil)))
-- | >>> sortOn (\x -> 0 - x) [1, 3, 2, 3, 5, 4]
-- | Cons 5 (Cons 4 (Cons 3 (Cons 3 (Cons 2 (Cons 1 Nil)))))
sortOn : {a k : Type} -> {{ord : Order k}} -> (a -> k) -> List a -> List a
sortOn key [] = Nil
sortOn key (x :: xs) =
  mergeRuns (\a b -> key a <= key b) Nil (runFrom (\a b -> key a <= key b) x xs)

-- | Sorted by the elements' `Order`, stably.
-- | >>> sort [3, 1, 2, 1]
-- | Cons 1 (Cons 1 (Cons 2 (Cons 3 Nil)))
sort : {a : Type} -> {{ord : Order a}} -> List a -> List a
sort [] = Nil
sort (x :: xs) = mergeRuns (\a b -> a <= b) Nil (runFrom (\a b -> a <= b) x xs)

-- | `xs ++ ys ++ …`, each list in turn.
-- | >>> concat [[1, 2], [], [3]]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
concat : {a : Type} -> List (List a) -> List a
concat xss = concatMap (\xs -> xs) xss

-- | The element at `i`, from 0, if there is one.
-- | >>> map (index [10, 20, 30]) [0, 2, 3, -1]
-- | Cons (Just 10) (Cons (Just 30) (Cons Nothing (Cons Nothing Nil)))
index : {a : Type} -> List a -> Int -> Maybe a
index [] i = Nothing
index (x :: xs) i =
  if i < 0 then Nothing else if i == 0 then Just x else index xs (i - 1)

-- | Each element with its index, from 0.
-- | >>> indexed ["a", "b"]
-- | Cons (MkPair 0 "a") (Cons (MkPair 1 "b") Nil)
indexed : {a : Type} -> List a -> List (Pair Int a)
indexed xs = zip (range 0 (length xs - 1)) xs

-- | Where the first element `p` holds of is, from 0, if one is.
-- | >>> indexWhere (\x -> x > 1) [1, 2, 3]
-- | Just 1
indexWhere : {a : Type} -> (a -> Bool) -> List a -> Maybe Int
indexWhere p xs = indexFrom 0 xs
  where
  indexFrom : Int -> List a -> Maybe Int
  indexFrom i [] = Nothing
  indexFrom i (y :: ys) = if p y then Just i else indexFrom (i + 1) ys

-- | How many elements `p` holds of.
-- | >>> count (\x -> x % 2 == 0) [1, 2, 3, 4]
-- | 2
count : {a : Type} -> (a -> Bool) -> List a -> Int
count p xs = foldl (\n x -> if p x then n + 1 else n) 0 xs

-- | What `f` gives `Just` of, in order: `keepIf` and `map` at once.
-- | >>> mapMaybe (\x -> if x > 1 then Just (x * 10) else Nothing) [1, 2, 3]
-- | Cons 20 (Cons 30 Nil)
mapMaybe : {a b : Type} -> (a -> Maybe b) -> List a -> List b
mapMaybe f [] = Nil
mapMaybe f (x :: xs) = case f x of
  Just y -> y :: mapMaybe f xs
  Nothing -> mapMaybe f xs

-- | Those `p` holds of, and those it does not, each in order.
-- | >>> partition (\x -> x % 2 == 0) [1, 2, 3, 4, 5]
-- | MkPair (Cons 2 (Cons 4 Nil)) (Cons 1 (Cons 3 (Cons 5 Nil)))
partition : {a : Type} -> (a -> Bool) -> List a -> Pair (List a) (List a)
partition p xs = MkPair (keepIf p xs) (keepIf (\x -> not (p x)) xs)

-- | The elements up to the first `p` does not hold of.
-- | >>> takeWhile (\x -> x < 3) [1, 2, 3, 1]
-- | Cons 1 (Cons 2 Nil)
takeWhile : {a : Type} -> (a -> Bool) -> List a -> List a
takeWhile p [] = Nil
takeWhile p (x :: xs) = if p x then x :: takeWhile p xs else Nil

-- | What is left from the first element `p` does not hold of.
-- | >>> dropWhile (\x -> x < 3) [1, 2, 3, 1]
-- | Cons 3 (Cons 1 Nil)
dropWhile : {a : Type} -> (a -> Bool) -> List a -> List a
dropWhile p [] = Nil
dropWhile p (x :: xs) = if p x then dropWhile p xs else x :: xs

-- | `takeWhile p xs` and `dropWhile p xs`, gone through once.
-- | >>> span (\x -> x < 3) [1, 2, 3, 1]
-- | MkPair (Cons 1 (Cons 2 Nil)) (Cons 3 (Cons 1 Nil))
span : {a : Type} -> (a -> Bool) -> List a -> Pair (List a) (List a)
span p xs = spanFrom Nil xs
  where
  spanFrom : List a -> List a -> Pair (List a) (List a)
  spanFrom acc [] = MkPair (reverse acc) Nil
  spanFrom acc (y :: ys) =
    if p y then spanFrom (y :: acc) ys else MkPair (reverse acc) (y :: ys)

-- | `take at xs` and `drop at xs`, gone through once.
-- | >>> split 2 [1, 2, 3]
-- | MkPair (Cons 1 (Cons 2 Nil)) (Cons 3 Nil)
split : {a : Type} -> (at : Int) -> List a -> Pair (List a) (List a)
split at xs = splitFrom at Nil xs
  where
  splitFrom : Int -> List a -> List a -> Pair (List a) (List a)
  splitFrom k acc [] = MkPair (reverse acc) Nil
  splitFrom k acc (y :: ys) =
    if k <= 0 then MkPair (reverse acc) (y :: ys)
    else splitFrom (k - 1) (y :: acc) ys

-- | The runs of equal elements next to each other, in order.
-- | >>> group [1, 1, 2, 3, 3, 1]
-- | Cons (Cons 1 (Cons 1 Nil)) (Cons (Cons 2 Nil) (Cons (Cons 3 (Cons 3 Nil)) (Cons (Cons 1 Nil) Nil)))
group : {a : Type} -> {{eq : Equality a}} -> List a -> List (List a)
group xs = groupsFrom Nil xs
  where
  groupsFrom : List (List a) -> List a -> List (List a)
  groupsFrom acc [] = reverse acc
  groupsFrom acc (y :: ys) = case span (\z -> y == z) ys of
    MkPair run rest -> groupsFrom ((y :: run) :: acc) rest

-- | The elements, each but the first of those equal left out, in order
-- | (by as many comparisons as the length times the elements kept).
-- | >>> unique [3, 1, 3, 2, 1]
-- | Cons 3 (Cons 1 (Cons 2 Nil))
unique : {a : Type} -> {{eq : Equality a}} -> List a -> List a
unique xs = uniqueFrom Nil xs
  where
  uniqueFrom : List a -> List a -> List a
  uniqueFrom seen [] = reverse seen
  uniqueFrom seen (y :: ys) =
    if any (\z -> y == z) seen then uniqueFrom seen ys
    else uniqueFrom (y :: seen) ys

-- | The elements, with `sep` between each two.
-- | >>> intersperse 0 [1, 2, 3]
-- | Cons 1 (Cons 0 (Cons 2 (Cons 0 (Cons 3 Nil))))
intersperse : {a : Type} -> a -> List a -> List a
intersperse sep [] = Nil
intersperse sep (x :: xs) = x :: concatMap (\y -> [sep, y]) xs

-- | The firsts and the seconds, `zip` undone.
-- | >>> unzip [MkPair 1 "a", MkPair 2 "b"]
-- | MkPair (Cons 1 (Cons 2 Nil)) (Cons "a" (Cons "b" Nil))
unzip : {a b : Type} -> List (Pair a b) -> Pair (List a) (List b)
unzip ps = MkPair (map (\p -> fst p) ps) (map (\p -> snd p) ps)

-- | `z` and each step of `foldl f z xs`, in order.
-- | >>> scanl (\a b -> a + b) 0 [1, 2, 3]
-- | Cons 0 (Cons 1 (Cons 3 (Cons 6 Nil)))
scanl : {a b : Type} -> (b -> a -> b) -> b -> List a -> List b
scanl f z xs = scanFrom z [z] xs
  where
  scanFrom : b -> List b -> List a -> List b
  scanFrom acc out [] = reverse out
  scanFrom acc out (y :: ys) = scanFrom (f acc y) (f acc y :: out) ys

-- | The first of the least, by the elements' `Order`, if there are any.
-- | >>> minimum [3, 1, 2]
-- | Just 1
minimum : {a : Type} -> {{ord : Order a}} -> List a -> Maybe a
minimum [] = Nothing
minimum (x :: xs) = Just (foldl (\m y -> if m <= y then m else y) x xs)

-- | The first of the greatest, by the elements' `Order`, if there are
-- | any.
-- | >>> map maximum [[1, 3, 2], []]
-- | Cons (Just 3) (Cons Nothing Nil)
maximum : {a : Type} -> {{ord : Order a}} -> List a -> Maybe a
maximum [] = Nothing
maximum (x :: xs) = Just (foldl (\m y -> if y <= m then m else y) x xs)
