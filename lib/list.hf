-- The operations of lists, which every module has by the name `List`
-- without importing it: `List.map`, `List.foldl`, `List.length`.  The
-- type and its tags are builtin's, `[a, b]` its notation, and `x :: xs`
-- and `xs ++ ys` the prelude's.

map : {a b : Type} -> (a -> b) -> List a -> List b
map f Nil = Nil
map f (x :: xs) = f x :: map f xs

foldl : {a b : Type} -> (b -> a -> b) -> b -> List a -> b
foldl f z Nil = z
foldl f z (Cons x xs) = foldl f (f z x) xs

reverse : {a : Type} -> List a -> List a
reverse xs = foldl (\acc x -> Cons x acc) Nil xs

-- | From the last element: `f x1 (f x2 (… z))`.  (By way of `reverse`, so
-- | a long list does not go as deep as it is long.)
foldr : {a b : Type} -> (a -> b -> b) -> b -> List a -> b
foldr f z xs = foldl (\acc x -> f x acc) z (reverse xs)

filter : {a : Type} -> (a -> Bool) -> List a -> List a
filter p Nil = Nil
filter p (Cons x xs) = if p x then Cons x (filter p xs) else filter p xs

-- | >>> length (map (\x -> x * 2) (Cons 1 (Cons 2 (Cons 3 Nil))))
-- | 3
length : {a : Type} -> List a -> Int
length xs = foldl (\n _ -> n + 1) 0 xs

-- | `xs ++ ys`, by a name.
-- | >>> append [1, 2] [3]
-- | Cons 1 (Cons 2 (Cons 3 Nil))
append : {a : Type} -> List a -> List a -> List a
append xs ys = xs ++ ys

concatMap : {a b : Type} -> (a -> List b) -> List a -> List b
concatMap f xs = foldr (\x acc -> append (f x) acc) Nil xs

null : {a : Type} -> List a -> Bool
null Nil = True
null (Cons _ _) = False

head : {a : Type} -> List a -> Maybe a
head Nil = Nothing
head (Cons x _) = Just x

tail : {a : Type} -> List a -> Maybe (List a)
tail Nil = Nothing
tail (Cons _ xs) = Just xs

last : {a : Type} -> List a -> Maybe a
last xs = head (reverse xs)

-- | The first `n` elements (all, if there are fewer).
take : {a : Type} -> Int -> List a -> List a
take n Nil = Nil
take n (Cons x xs) = if n <= 0 then Nil else Cons x (take (n - 1) xs)

-- | What is left after the first `n`.
drop : {a : Type} -> Int -> List a -> List a
drop n Nil = Nil
drop n (Cons x xs) = if n <= 0 then Cons x xs else drop (n - 1) xs

zipWith : {a b c : Type} -> (a -> b -> c) -> List a -> List b -> List c
zipWith f (Cons x xs) (Cons y ys) = Cons (f x y) (zipWith f xs ys)
zipWith f xs ys = Nil

zip : {a b : Type} -> List a -> List b -> List (Pair a b)
zip xs ys = zipWith (\x y -> MkPair x y) xs ys

any : {a : Type} -> (a -> Bool) -> List a -> Bool
any p Nil = False
any p (Cons x xs) = if p x then True else any p xs

all : {a : Type} -> (a -> Bool) -> List a -> Bool
all p Nil = True
all p (Cons x xs) = if p x then all p xs else False

find : {a : Type} -> (a -> Bool) -> List a -> Maybe a
find p Nil = Nothing
find p (Cons x xs) = if p x then Just x else find p xs

-- | Whether `x` is in the list, by the equality given.
elemBy : {a : Type} -> (a -> a -> Bool) -> a -> List a -> Bool
elemBy eq x xs = any (eq x) xs

-- | The value paired with the first key equal to `k`, by the equality
-- | given.
lookupBy : {k v : Type} -> (k -> k -> Bool) -> k -> List (Pair k v) -> Maybe v
lookupBy eq k Nil = Nothing
lookupBy eq k (Cons (MkPair k' v) rest) =
  if eq k k' then Just v else lookupBy eq k rest

sum : List Int -> Int
sum xs = foldl (\a b -> a + b) 0 xs

product : List Int -> Int
product xs = foldl (\a b -> a * b) 1 xs

-- | `a`, `a + 1`, …, `b`.
range : Int -> Int -> List Int
range a b = if a > b then Nil else Cons a (range (a + 1) b)

replicate : {a : Type} -> Int -> a -> List a
replicate n x = if n <= 0 then Nil else Cons x (replicate (n - 1) x)

-- (two sorted lists, as one)
merge : {a : Type} -> (a -> a -> Bool) -> List a -> List a -> List a
merge le Nil ys = ys
merge le xs Nil = xs
merge le (Cons x xs) (Cons y ys) =
  if le x y then Cons x (merge le xs (Cons y ys))
  else Cons y (merge le (Cons x xs) ys)

-- | Sorted by `le` (whether one goes before, or with, another), stably.
sortBy : {a : Type} -> (a -> a -> Bool) -> List a -> List a
sortBy le Nil = Nil
sortBy le [x] = [x]
sortBy le xs =
  merge
    le
    (sortBy le (take (length xs / 2) xs))
    (sortBy le (drop (length xs / 2) xs))
