-- The network as an effect (lib/co.hf): what is at a URL.  `heff node`
-- has a handler for it.  (dom has a `fetchText` too: import one of them
-- `as`.)

import co
import prelude

data NetF (m : Type -> Type) x = Fetch String (String -> x)

-- | The network as an effect.
net : HFunctor
net =
  { f = NetF
  , hfmap = \fm g p -> case p of
      Fetch url k -> Fetch url (\t -> g (k t))
  , hmap = \nt p -> case p of
      Fetch url k -> Fetch url k
  }

-- | What is at a URL, as text (or what went wrong, if nothing is there).
fetchText : String -> Co net String
fetchText url = op (Fetch url (\t -> t)) val
