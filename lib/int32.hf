-- `Int32`: the integers from -2147483648 to 2147483647, wrapping around as the
-- machine's do (two's complement): `fromInt 2147483648` is -2147483648.  A literal checked at `Int32` is one (`(7 : Int32)`).
-- Import it by a name, `import int32 as I32`, as its names are the
-- prelude's: `I32.add`, `I32.fromInt`.  Its instances are the prelude's
-- operators' at `Int32`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive int32Add : Int32 -> Int32 -> Int32
primitive int32Sub : Int32 -> Int32 -> Int32
primitive int32Mul : Int32 -> Int32 -> Int32
primitive int32Div : Int32 -> Int32 -> Int32
primitive int32Rem : Int32 -> Int32 -> Int32
primitive int32Lt : Int32 -> Int32 -> Bool
primitive int32Le : Int32 -> Int32 -> Bool
primitive int32And : Int32 -> Int32 -> Int32
primitive int32Or : Int32 -> Int32 -> Int32
primitive int32Xor : Int32 -> Int32 -> Int32
primitive int32Shl : Int32 -> Int32 -> Int32
primitive int32Shr : Int32 -> Int32 -> Int32
primitive int32Show : Int32 -> String
primitive int32FromInt : Int -> Int32
primitive int32ToInt : Int32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int32
minBound = -2147483648

-- | The greatest.
maxBound : Int32
maxBound = 2147483647

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int32 -> Int32 -> Int32
add = int32Add

sub : Int32 -> Int32 -> Int32
sub = int32Sub

mul : Int32 -> Int32 -> Int32
mul = int32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int32 -> Int32 -> Int32
div = int32Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int32 -> Int32 -> Int32
rem = int32Rem

neg : Int32 -> Int32
neg x = int32Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int32 -> Int32 -> Bool
eq = int32Eq

lt : Int32 -> Int32 -> Bool
lt = int32Lt

le : Int32 -> Int32 -> Bool
le = int32Le

compare : Int32 -> Int32 -> Ordering
compare a b = if int32Lt a b then LT else if int32Eq a b then EQ else GT

min : Int32 -> Int32 -> Int32
min a b = if int32Le a b then a else b

max : Int32 -> Int32 -> Int32
max a b = if int32Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int32 -> Int32 -> Int32
and = int32And

-- | The bits set in either.
or : Int32 -> Int32 -> Int32
or = int32Or

-- | The bits set in one of the two.
xor : Int32 -> Int32 -> Int32
xor = int32Xor

-- | Every bit flipped.
complement : Int32 -> Int32
complement x = int32Xor x -1

-- | Shifted left by the second (modulo 32), the bits shifted out lost.
shiftL : Int32 -> Int32 -> Int32
shiftL = int32Shl

-- | Shifted right by the second (modulo 32), the sign copied in.
shiftR : Int32 -> Int32 -> Int32
shiftR = int32Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> Int32
fromInt = int32FromInt

toInt : Int32 -> Int
toInt = int32ToInt

show : Int32 -> String
show = int32Show

-- Instances: the prelude's operators and functions at `Int32`
--------------------------------------------------------------------------------

instance eqInt32 : Eq Int32
eqInt32 = { equal = int32Eq }

instance ordInt32 : Ord Int32
ordInt32 = { compare = compare, lt = int32Lt, le = int32Le }

instance addInt32 : Add Int32
addInt32 = { add = int32Add }

instance subInt32 : Sub Int32
subInt32 = { sub = int32Sub }

instance mulInt32 : Mul Int32
mulInt32 = { mul = int32Mul }

-- | >>> List.map show [7 / 2, -7 / 2, 7 / 0, minBound / -1]
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-2147483648" Nil)))
instance divInt32 : Div Int32
divInt32 = { div = int32Div }

-- | >>> List.map show [7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance modInt32 : Mod Int32
modInt32 = { mod = int32Rem }

instance negInt32 : Neg Int32
negInt32 = { neg = neg }

instance zeroInt32 : HasZero Int32
zeroInt32 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsInt32 : Bits Int32
bitsInt32 =
  { and = int32And
  , or = int32Or
  , xor = int32Xor
  , complement = complement
  , shiftL = int32Shl
  , shiftR = int32Shr
  }
