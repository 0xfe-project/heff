-- `Int32`: the integers from -2147483648 to 2147483647, wrapping around as the
-- machine's do (two's complement): `fromInt 2147483648` is -2147483648.  A literal checked at `Int32` is one (`(7 : Int32)`).
-- Import it by a name, `import int32 as I32`, as the other fixed-width
-- types' modules have the same names: `I32.fromInt`, `I32.show`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `Int32`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

primitive int32Add : Int32 -> Int32 -> Int32
primitive int32Sub : Int32 -> Int32 -> Int32
primitive int32Mul : Int32 -> Int32 -> Int32
primitive int32Div : Int32 -> Int32 -> Int32
primitive int32Rem : Int32 -> Int32 -> Int32
primitive int32Lt : Int32 -> Int32 -> Bool
primitive int32Le : Int32 -> Int32 -> Bool
primitive int32And : Int32 -> Int32 -> Int32
primitive int32Or : Int32 -> Int32 -> Int32
primitive int32Xor : Int32 -> Int32 -> Int32
primitive int32Shl : Int32 -> Int32 -> Int32
primitive int32Shr : Int32 -> Int32 -> Int32
primitive int32Show : Int32 -> String
primitive int32FromInt : Int -> Int32
primitive int32ToInt : Int32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int32
minBound = -2147483648

-- | The greatest.
maxBound : Int32
maxBound = 2147483647

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int32 -> Int32 -> Int32
add = int32Add

sub : Int32 -> Int32 -> Int32
sub = int32Sub

mul : Int32 -> Int32 -> Int32
mul = int32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int32 -> Int32 -> Int32
div = int32Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int32 -> Int32 -> Int32
rem = int32Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : Int32 -> Int32 -> Bool
eq = int32Eq

lt : Int32 -> Int32 -> Bool
lt = int32Lt

le : Int32 -> Int32 -> Bool
le = int32Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> Int32
fromInt = int32FromInt

toInt : Int32 -> Int
toInt = int32ToInt

show : Int32 -> String
show = int32Show

-- Instances: the prelude's operators and functions at `Int32`
--------------------------------------------------------------------------------

instance equalityInt32 : Equality Int32
equalityInt32 = { equal = int32Eq }

instance orderInt32 : Order Int32
orderInt32 =
  { compare = \a b -> if int32Lt a b then LT else if int32Eq a b then EQ else GT
  , lt = int32Lt
  , le = int32Le
  }

instance additionInt32 : Addition Int32
additionInt32 = { add = int32Add }

instance subtractionInt32 : Subtraction Int32
subtractionInt32 = { sub = int32Sub }

instance multiplicationInt32 : Multiplication Int32
multiplicationInt32 = { mul = int32Mul }

-- | >>> List.map show [7 / 2, -7 / 2, 7 / 0, minBound / -1]
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-2147483648" Nil)))
instance divisionInt32 : Division Int32
divisionInt32 = { div = int32Div }

-- | >>> List.map show [7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance remainderInt32 : Remainder Int32
remainderInt32 = { mod = int32Rem }

-- | The integer of the other sign, wrapped around: of `minBound`, itself.
instance negationInt32 : Negation Int32
negationInt32 = { neg = \x -> int32Sub 0 x }

instance isZeroInt32 : IsZero Int32
isZeroInt32 = { isZero = \x -> int32Eq x 0 }

-- | The bits, as two's complement has them: shifted left by the second
-- | (modulo 32), the bits shifted out lost, and right, the sign copied in;
-- | by a negative second, the other way (`shiftL x -n` is `shiftR x n`).
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitwiseInt32 : Bitwise Int32
bitwiseInt32 =
  { and = int32And
  , or = int32Or
  , xor = int32Xor
  , complement = \x -> int32Xor x -1
  , shiftL = int32Shl
  , shiftR = int32Shr
  }
