-- JSON (RFC 8259), written in heff: a value, read from its text
-- (`parse`), written back (`stringify`, as JavaScript's `JSON.stringify`
-- writes it), read into (`field`, `at`, `str`, ...) and built (`obj`,
-- `kv`, `num`, `jstr`).  Import it by a name, `import json as JSON`, as
-- its `at`, `int` and `str` are short.
--
-- ```haskell
-- import json as JSON
--
-- -- | >>> uri "{\"params\": {\"textDocument\": {\"uri\": \"file:///a.hf\"}}}"
-- -- | Just ("file:///a.hf")
-- uri : String -> Maybe String
-- uri body =
--   either (\e -> Nothing) (\j -> JSON.str ["params", "textDocument", "uri"] j) (JSON.parse body)
-- ```
--
-- A number without a fraction or an exponent is a `JInt`, of any size, as
-- an `Int` is; one with either, a `JFloat`, the float nearest it (as C's
-- `strtod` reads it), written so that it is read back the very float --
-- but an infinity or NaN, which JSON has no number for, written `null`,
-- as JavaScript writes them.  An object keeps its fields in order, and a
-- key given twice twice.  A string is text: an escape of a surrogate not
-- in a pair is U+FFFD, as what is not UTF-8 is in a string heff reads.

module json

import rune as Rune
import std.math as Math

-- | A JSON value: a number without a fraction or an exponent a `JInt`,
-- | with either a `JFloat`; an object its fields in order, a key given
-- | twice twice.
data Json
  = JNull
  | JBool Bool
  | JInt Int
  | JFloat Float64
  | JString String
  | JArray (List Json)
  | JObject (List (Pair String Json))

-- Writing
--------------------------------------------------------------------------------

hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

hex2 : Int -> String
hex2 c = hexDigit (c / 16) ^ hexDigit (c % 16)

-- (an ASCII byte JSON writes escaped: its escape)
escapeOf : Int -> String
escapeOf c =
  if c == 34 then "\\\""
  else if c == 92 then "\\\\"
  else if c == 10 then "\\n"
  else if c == 13 then "\\r"
  else if c == 9 then "\\t"
  else if c == 8 then "\\b"
  else if c == 12 then "\\f"
  else "\\u00" ^ hex2 c

-- (a rune not ASCII's: how many of its bytes are written as they are,
-- all of them, or none where they are not UTF-8)
keptWidth : RuneAt -> Int
keptWidth r =
  if Rune.toInt r.rune == Rune.toInt Rune.replacement then 0 else r.width

-- (a byte written as it is: printable ASCII, but `"` and `\`)
isPlainByte : Int -> Bool
isPlainByte c = 32 <= c && c < 128 && c /= 34 && c /= 92

-- (the end of the characters from `i` on written as they are: plain
-- bytes, and runes not ASCII's whose bytes are UTF-8)
plainEnd : String -> Int -> Int
plainEnd s i =
  if isPlainByte (byteAt s i) then plainEnd s (i + 1)
  else if byteAt s i >= 128 && keptWidth (runeAt s i) > 0
  then plainEnd s (i + keptWidth (runeAt s i))
  else i

-- (the character at `i` not written as it is: what is written instead, an
-- ASCII byte's escape or U+FFFD, and how many bytes it takes)
escapedText : String -> Int -> String
escapedText s i =
  if byteAt s i < 128 then escapeOf (byteAt s i) else ofRunes [Rune.replacement]

escapedWidth : String -> Int -> Int
escapedWidth s i = if byteAt s i < 128 then 1 else (runeAt s i).width

-- (`acc`, then `s` from `i` on: from 0, `s` itself, not a copy)
tailInto : String -> String -> Int -> String
tailInto acc s i = if i == 0 then acc ^ s else acc ^ strSlice s i (strLength s)

-- (`acc`, then the text of `s` from `i` on as the inside of a JSON string:
-- what is written as it is a run of bytes at a time)
escapeInto : String -> String -> Int -> String
escapeInto acc s i =
  let j : Int = plainEnd s i
  in if j >= strLength s then tailInto acc s i
  else escapeInto
      (acc ^ strSlice s i j ^ escapedText s j)
      s
      (j + escapedWidth s j)

-- (`acc`, then a string as JSON writes it)
quotedInto : String -> String -> String
quotedInto acc s = escapeInto (acc ^ "\"") s 0 ^ "\""

-- (`acc`, then each element after the first, `sep` before it)
restInto : {a : Type}
         -> String
         -> (String -> a -> String)
         -> String
         -> List a
         -> String
restInto sep write acc Nil = acc
restInto sep write acc (Cons x xs) = restInto sep write (write (acc ^ sep) x) xs

-- (`acc`, then the elements, `sep` between them)
joinInto : {a : Type}
         -> String
         -> (String -> a -> String)
         -> String
         -> List a
         -> String
joinInto sep write acc Nil = acc
joinInto sep write acc (Cons x xs) = restInto sep write (write acc x) xs

-- (`acc`, then a field as JSON writes it, its value by `write`)
fieldInto : (String -> Json -> String) -> String -> Pair String Json -> String
fieldInto write acc (MkPair k v) = write (quotedInto acc k ^ ":") v

-- (a float as `stringify` writes it: as `show` does; one not finite,
-- which JSON has no number for, `null`, as JavaScript's `JSON.stringify`
-- writes it)
floatText : Float64 -> String
floatText x = if not (x - x == 0.0) then "null" else show x

-- (`acc`, then a value as `stringify` writes it: each part appended to
-- the one text, not made apart and joined)
writeInto : String -> Json -> String
writeInto acc JNull = acc ^ "null"
writeInto acc (JBool b) = acc ^ (if b then "true" else "false")
writeInto acc (JInt i) = acc ^ show i
writeInto acc (JFloat x) = acc ^ floatText x
writeInto acc (JString s) = quotedInto acc s
writeInto acc (JArray xs) = joinInto "," writeInto (acc ^ "[") xs ^ "]"
writeInto acc (JObject fs) =
  joinInto "," (fieldInto writeInto) (acc ^ "{") fs ^ "}"

-- | The text of a value, as JavaScript's `JSON.stringify` writes it: no
-- | space, an object's fields in their order.
-- | >>> stringify (JObject [MkPair "a" (JInt 1), MkPair "b" (JArray [JString "x\n", JNull, JBool True])])
-- | "{\"a\":1,\"b\":[\"x\\n\",null,true]}"
-- |
-- | (a float as `show` writes it, -0.0 with its sign, so that `parse`
-- | reads back the very float; an infinity or NaN, which JSON has no
-- | number for, `null`, as JavaScript writes them)
-- | >>> stringify (JArray [JFloat 1.0e300, JFloat (neg 0.0), JFloat (1.0 /. 0.0), JFloat (0.0 /. 0.0)])
-- | "[1e+300,-0.0,null,null]"
-- |
-- | (a string's text: what is not UTF-8 in it, U+FFFD)
-- | >>> stringify (JString ("é😀" ^ strSlice "😀" 0 1 ^ "\t"))
-- | "\"é😀\u{FFFD}\\t\""
stringify : Json -> String
stringify j = writeInto "" j

-- (`acc`, then a field as the source writes it)
reprFieldInto : (String -> Json -> String)
              -> String
              -> Pair String Json
              -> String
reprFieldInto repr acc (MkPair k v) =
  repr (acc ^ "MkPair " ^ show k ^ " (") v ^ ")"

-- (`acc`, then a value as the source writes it)
reprInto : String -> Json -> String
reprInto acc JNull = acc ^ "JNull"
reprInto acc (JBool b) = acc ^ "JBool " ^ show b
reprInto acc (JInt i) =
  acc ^ "JInt " ^ (if i < 0 then "(" ^ show i ^ ")" else show i)
reprInto acc (JFloat x) =
  acc
  ^ "JFloat "
  ^ (if startsWith "-" (show x) then "(" ^ show x ^ ")" else show x)
reprInto acc (JString s) = acc ^ "JString " ^ show s
reprInto acc (JArray xs) = joinInto ", " reprInto (acc ^ "JArray [") xs ^ "]"
reprInto acc (JObject fs) =
  joinInto ", " (reprFieldInto reprInto) (acc ^ "JObject [") fs ^ "]"

repr : Json -> String
repr j = reprInto "" j

-- | A value as the source writes it.
-- | >>> show (JArray [JInt -1, JString "a", JObject [MkPair "b" JNull]] : Json)
-- | "JArray [JInt (-1), JString \"a\", JObject [MkPair \"b\" (JNull)]]"
instance instanceShowJson : Show Json
instanceShowJson = { show = repr }

-- | A value as JSON writes it, `stringify`.
instance instanceToStringJson : ToString Json
instanceToStringJson = { toString = stringify }

-- Parsing
--------------------------------------------------------------------------------

-- | Where the text is not JSON: the byte at which it is not, and what
-- | was expected there.
data ParseError = Expected Int String

showParseError : ParseError -> String
showParseError (Expected i what) = "Expected " ^ show i ^ " " ^ show what

-- | >>> show (Expected 3 "a value" : ParseError)
-- | "Expected 3 \"a value\""
instance instanceShowParseError : Show ParseError
instanceShowParseError = { show = showParseError }

-- | What a parse error says: `at byte 3: expected a value`.
describe : ParseError -> String
describe (Expected i what) = "at byte " ^ show i ^ ": expected " ^ what

isSpaceByte : Int -> Bool
isSpaceByte c = c == 32 || c == 10 || c == 13 || c == 9

-- (the first byte from `i` on that is not white space)
skipSpace : String -> Int -> Int
skipSpace s i = if isSpaceByte (byteAt s i) then skipSpace s (i + 1) else i

isDigitByte : Int -> Bool
isDigitByte c = 48 <= c && c <= 57

-- (the end of the digits from `i` on)
digitsEnd : String -> Int -> Int
digitsEnd s i = if isDigitByte (byteAt s i) then digitsEnd s (i + 1) else i

-- (the integer of the digits from `i` up to `j`, after `acc`)
digitsValue : String -> Int -> Int -> Int -> Int
digitsValue s i j acc =
  if i >= j then acc else digitsValue s (i + 1) j (acc * 10 + byteAt s i - 48)

-- (the exponent's part of a number from `i`, `e` or `E` there: its end,
-- and its value, or -1 where it has no digits)
exponentEnd : String -> Int -> Int
exponentEnd s i =
  if byteAt s i == 43 || byteAt s i == 45 then digitsEnd s (i + 1)
  else digitsEnd s i

exponentValue : String -> Int -> Int -> Int
exponentValue s i j =
  if byteAt s i == 45 then 0 - digitsValue s (i + 1) j 0
  else if byteAt s i == 43 then digitsValue s (i + 1) j 0
  else digitsValue s i j 0

-- (a number's text from `start`, its digits from `d` up to `p` -- the
-- point, or where the fraction would be -- its fraction's up to `f`, and
-- its exponent from `f` up to `end`; a float)
floatOf : String -> Int -> Int -> Int -> Int -> Int -> Float64
floatOf s start d p f end =
  let whole : Int = digitsValue s d p 0
  in let m : Int = if f > p then digitsValue s (p + 1) f whole else whole
  in let places : Int = if f > p then f - p - 1 else 0
  in let e : Int = if end > f then exponentValue s (f + 1) end else 0
  in if byteAt s start == 45 then neg (Math.fromDecimal m (e - places))
  else Math.fromDecimal m (e - places)

-- (a number's text, from `start`, its integer's digits from `d` up to
-- `p`, then perhaps a fraction and an exponent)
numberAfterDigits : String
                  -> Int
                  -> Int
                  -> Int
                  -> Either ParseError (Pair Json Int)
numberAfterDigits s start d p =
  let f : Int = if byteAt s p == 46 then digitsEnd s (p + 1) else p
  in let hasExponent : Bool = byteAt s f == 101 || byteAt s f == 69
  in let end : Int = if hasExponent then exponentEnd s (f + 1) else f
  in if f == p + 1 then Left (Expected f "a digit")
  else if hasExponent && not (isDigitByte (byteAt s (end - 1)))
  then Left (Expected end "a digit")
  else if f == p && not hasExponent
  then (let n : Int = digitsValue s d p 0
        in Right
          (MkPair (JInt (if byteAt s start == 45 then 0 - n else n)) end))
  else Right (MkPair (JFloat (floatOf s start d p f end)) end)

-- (a number at `i`, and where it ends)
numberAt : String -> Int -> Either ParseError (Pair Json Int)
numberAt s i =
  let d : Int = if byteAt s i == 45 then i + 1 else i
  in if byteAt s d == 48 then numberAfterDigits s i d (d + 1)
  else if isDigitByte (byteAt s d) then numberAfterDigits s i d (digitsEnd s d)
  else Left (Expected d (if d == i then "a value" else "a digit"))

hexValue : Int -> Int
hexValue c =
  if 48 <= c && c <= 57 then c - 48
  else if 97 <= c && c <= 102 then c - 87
  else if 65 <= c && c <= 70 then c - 55
  else 0 - 65536

-- (the four hexadecimal digits at `i`: their value, or below 0)
hex4 : String -> Int -> Int
hex4 s i =
  hexValue (byteAt s i) * 4096
  + hexValue (byteAt s (i + 1)) * 256
  + hexValue (byteAt s (i + 2)) * 16
  + hexValue (byteAt s (i + 3))

-- (a `\u` escape's text, the escape's `u` at `i`: a surrogate pair's
-- rune, the second's escape right after the first; one not in a pair,
-- U+FFFD)
unicodeEscape : String -> Int -> Either ParseError (Pair String Int)
unicodeEscape s i =
  let c : Int = hex4 s (i + 1)
  in let lo : Int = hex4 s (i + 7)
  in if c < 0 then Left (Expected (i + 1) "four hexadecimal digits")
  else if 55296 <= c
          && c < 56320
          && byteAt s (i + 5) == 92
          && byteAt s (i + 6) == 117
          && 56320 <= lo
          && lo < 57344
  then Right
      (MkPair
         (ofRunes [Rune.fromInt (65536 + (c - 55296) * 1024 + (lo - 56320))])
         (i + 11))
  else Right (MkPair (ofRunes [Rune.fromInt c]) (i + 5))

-- (an escape's text, its letter at `i`, and where it ends)
escapeText : String -> Int -> Either ParseError (Pair String Int)
escapeText s i =
  let c : Int = byteAt s i
  in if c == 34 then Right (MkPair "\"" (i + 1))
  else if c == 92 then Right (MkPair "\\" (i + 1))
  else if c == 47 then Right (MkPair "/" (i + 1))
  else if c == 110 then Right (MkPair "\n" (i + 1))
  else if c == 116 then Right (MkPair "\t" (i + 1))
  else if c == 114 then Right (MkPair "\r" (i + 1))
  else if c == 98 then Right (MkPair "\x08" (i + 1))
  else if c == 102 then Right (MkPair "\x0c" (i + 1))
  else if c == 117 then unicodeEscape s i
  else Left (Expected i "an escape")

-- (a string's text, read from `i` on: what is read so far `acc`, then
-- the bytes from `start` up to `i`)
stringFrom : String
           -> Int
           -> Int
           -> String
           -> Either ParseError (Pair String Int)
stringFrom s start i acc =
  let c : Int = byteAt s i
  in if c == 34 then Right (MkPair (acc ^ strSlice s start i) (i + 1))
  else if c == 92
  then (case escapeText s (i + 1) of
        Right (MkPair t j) -> stringFrom s j j (acc ^ strSlice s start i ^ t)
        Left e -> Left e)
  else if c < 0 then Left (Expected i "'\"'")
  else if c < 32 then Left (Expected i "a character, or an escape of it")
  else stringFrom s start (i + 1) acc

-- (a string, its `"` at `i`, and where it ends)
stringAt : String -> Int -> Either ParseError (Pair String Int)
stringAt s i =
  if byteAt s i == 34 then stringFrom s (i + 1) (i + 1) ""
  else Left (Expected i "a string")

-- What is being read: an array, its elements so far (the last first), or
-- an object, its fields so far and the key of the one being read
data Frame
  = InArray (List Json)
  | InObject (List (Pair String Json)) String

-- A step of the parse: a value to read at a byte, inside the frames; a
-- value read, up to a byte; or the end
data Step
  = Value Int (List Frame)
  | Got Json Int (List Frame)
  | Finished Json
  | Failed ParseError

-- (after a field's key, `k`, read up to `j`: its `:`, then its value
-- inside the object, its fields so far `fs`)
colonThen : String
          -> List (Pair String Json)
          -> List Frame
          -> Either ParseError (Pair String Int)
          -> Step
colonThen s fs frames (Right (MkPair k j)) =
  let c : Int = skipSpace s j
  in if byteAt s c == 58 then Value (c + 1) (Cons (InObject fs k) frames)
  else Failed (Expected c "':'")
colonThen s fs frames (Left e) = Failed e

-- (a field's key from `i`, its `:`, then its value)
keyThen : String -> Int -> List (Pair String Json) -> List Frame -> Step
keyThen s i fs frames =
  if byteAt s i == 34 then colonThen s fs frames (stringAt s i)
  else Failed (Expected i "a string")

-- (a word, `null`, `true` or `false`, at `i`)
word : String -> Int -> String -> Json -> List Frame -> Step
word s i w v frames =
  if strEq (strSlice s i (i + strLength w)) w
  then Got v (i + strLength w) frames
  else Failed (Expected i "a value")

-- (what a reading of a number or a string makes)
read : {a : Type}
     -> (a -> Json)
     -> List Frame
     -> Either ParseError (Pair a Int)
     -> Step
read make frames (Right (MkPair x j)) = Got (make x) j frames
read make frames (Left e) = Failed e

-- (a value, at `i`)
valueAt : String -> Int -> List Frame -> Step
valueAt s i frames =
  let c : Int = byteAt s i
  in if c == 34 then read (\(x : String) -> JString x) frames (stringAt s i)
  else if c == 123
  then (let j : Int = skipSpace s (i + 1)
        in if byteAt s j == 125 then Got (JObject Nil) (j + 1) frames
        else keyThen s j Nil frames)
  else if c == 91
  then (let j : Int = skipSpace s (i + 1)
        in if byteAt s j == 93 then Got (JArray Nil) (j + 1) frames
        else Value j (Cons (InArray Nil) frames))
  else if c == 110 then word s i "null" JNull frames
  else if c == 116 then word s i "true" (JBool True) frames
  else if c == 102 then word s i "false" (JBool False) frames
  else read (\(v : Json) -> v) frames (numberAt s i)

-- (a value read, `v`, up to `i`, inside a frame)
gotIn : String -> Json -> Int -> Frame -> List Frame -> Step
gotIn s v i (InArray xs) frames =
  if byteAt s i == 44 then Value (i + 1) (Cons (InArray (Cons v xs)) frames)
  else if byteAt s i == 93
  then Got (JArray (List.reverse (Cons v xs))) (i + 1) frames
  else Failed (Expected i "',' or ']'")
gotIn s v i (InObject fs k) frames =
  if byteAt s i == 44
  then keyThen s (skipSpace s (i + 1)) (Cons (MkPair k v) fs) frames
  else if byteAt s i == 125
  then Got (JObject (List.reverse (Cons (MkPair k v) fs))) (i + 1) frames
  else Failed (Expected i "',' or '}'")

-- (a value read, `v`, up to `i`)
gotAt : String -> Json -> Int -> List Frame -> Step
gotAt s v i Nil =
  if i >= strLength s then Finished v else Failed (Expected i "the end")
gotAt s v i (Cons f frames) = gotIn s v i f frames

steps : String -> Step -> Either ParseError Json
steps s (Value i frames) = steps s (valueAt s (skipSpace s i) frames)
steps s (Got v i frames) = steps s (gotAt s v (skipSpace s i) frames)
steps s (Finished v) = Right v
steps s (Failed e) = Left e

-- | The value a text is, white space around it; or where it is not one.
-- | It reads as it goes, a value inside another kept on a list, not on
-- | the stack, so that however deep the text it does not overflow.
-- | >>> parse " {\"a\": [1, -2.5e1, \"\\u00e9\\ud83d\\ude00\"], \"b\": null} "
-- | Right (JObject [MkPair "a" (JArray [JInt 1, JFloat (-25.0), JString "é😀"]), MkPair "b" (JNull)])
-- | >>> parse "[1, 2"
-- | Left (Expected 5 "',' or ']'")
parse : String -> Either ParseError Json
parse s = steps s (Value 0 Nil)

-- Reading
--------------------------------------------------------------------------------

-- | A field of an object.
field : String -> Json -> Maybe Json
field k (JObject fs) = case List.find
    (\(p : Pair String Json) -> strEq (fst p) k)
    fs of
  Just p -> Just (snd p)
  Nothing -> Nothing
field k _ = Nothing

-- | The value at a path of fields.
-- | >>> at ["a", "b"] (JObject [MkPair "a" (JObject [MkPair "b" (JInt 1)])])
-- | Just (JInt 1)
at : List String -> Json -> Maybe Json
at Nil j = Just j
at (Cons k ks) j = case field k j of
  Just v -> at ks v
  Nothing -> Nothing

-- | A string at a path; `Nothing` where it is missing or of another
-- | kind, as each reading at a path is.
-- | >>> either (\e -> Nothing) (\j -> str ["params", "textDocument", "uri"] j) (parse "{\"params\": {\"textDocument\": {\"uri\": \"file:///a.hf\"}}}")
-- | Just ("file:///a.hf")
str : List String -> Json -> Maybe String
str ks j = case at ks j of
  Just (JString s) -> Just s
  _ -> Nothing

-- | An integer at a path: a float's, rounded down.
int : List String -> Json -> Maybe Int
int ks j = case at ks j of
  Just (JInt i) -> Just i
  Just (JFloat x) -> Just (floor x)
  _ -> Nothing

-- | A boolean at a path.
bool : List String -> Json -> Maybe Bool
bool ks j = case at ks j of
  Just (JBool b) -> Just b
  _ -> Nothing

-- | An array at a path: its elements.
arr : List String -> Json -> Maybe (List Json)
arr ks j = case at ks j of
  Just (JArray xs) -> Just xs
  _ -> Nothing

-- Making
--------------------------------------------------------------------------------

-- | An object, of its fields in order.
obj : List (Pair String Json) -> Json
obj fs = JObject fs

-- | A field of an object: its key and its value.
kv : String -> Json -> Pair String Json
kv k v = MkPair k v

-- | An integer.
num : Int -> Json
num i = JInt i

-- | A string.
jstr : String -> Json
jstr s = JString s
