-- Software transactional memory (Harris, Marlow, Peyton Jones, Herlihy),
-- on std.domain: variables threads share (`TVar`), read and written in
-- transactions (`Co (transaction w)`), each run by `atomically` as if
-- alone -- what it read is what it was when it committed, or it is run
-- again.  A transaction that cannot go on yet (`retry`) waits, taking
-- no domain, until a variable it read is written; `orElse` tries
-- another where the first retries.  The threads run on as many
-- domains as the machine has cores.  Import it by a name, `import stm
-- as STM`.
--
-- > [!CAUTION]
-- > Unstable: concurrency in heff is not settled. What this module offers
-- > may change, or go, in any release.
--
-- ```haskell
-- import co
-- import std.domain as Domain
-- import stm as STM
--
-- -- | `n` moved from one account to the other, once the first has it
-- paid : {w : HFunctor}
--      -> STM.TVar w Int
--      -> STM.TVar w Int
--      -> Int
--      -> Co (STM.transaction w) Unit
-- paid from to n = do
--   have <- STM.readTVar from
--   STM.check (have >= n)
--   STM.writeTVar from (have - n)
--   STM.modifyTVar to (\m -> m + n)
--
-- -- | a thread paying 5 once alice has it, and alice given 10: what
-- -- | bob has once he is paid, 5
-- bobs : {e w : HFunctor} -> {{sm : STM.stm w <: e}} -> Co e Int
-- bobs = do
--   alice <- STM.newTVar 0
--   bob <- STM.newTVar 0
--   STM.spawn (STM.atomically (paid alice bob 5))
--   STM.atomically (STM.writeTVar alice 10)
--   STM.atomically (do
--     m <- STM.readTVar bob
--     STM.check (m > 0)
--     pure m)
--
-- -- | `Just 5`, the threads on domains
-- bobsHere : {w : HFunctor}
--          -> {{dm : Domain.domain <: w}}
--          -> Co w (Maybe Int)
-- bobsHere = STM.scheduled (bobs (w := w) (sm := _))
-- ```
--
-- Operation | What it does
-- --- | ---
-- `spawn c` | `c` is a thread of its own; this one goes on
-- `newTVar v` | a variable holding `v`, for every thread
-- `atomically t` | the transaction `t` run as if alone, this thread waiting where it retries: what it comes to
-- `readTVar v` | what the variable holds
-- `writeTVar v x` | ... and it holds `x` now
-- `modifyTVar v f` | ... and it holds `f` of what it held
-- `retry` | the transaction undone, to run again once a variable it read is written
-- `orElse l r` | `l`; where `l` retries, `r` instead, from where `l` began
-- `check b` | nothing where `b`, else `retry`
-- `scheduled c` | `c` and its threads run, on domains: `Just` main's answer, or `Nothing` where every thread waits
--
-- A transaction is a `Co (transaction w)`: it reads and writes
-- variables and nothing else, since it may be run more than once.
-- What `atomically` gives back is one transaction's, run as if no
-- other ran meanwhile: every variable it read held, as it committed,
-- what it read, else it is run again, from the start, its writes
-- undone.  Where it retries, the thread waits until another
-- transaction writes a variable it read, and runs it again then.
-- `orElse l r` runs `l`; where `l` retries, `l`'s writes are undone
-- and `r` runs instead; where both retry, the whole does.  What a
-- variable holds is a value: a transaction writing a `List` or a `Map`
-- replaces it whole, and two transactions writing the same variable
-- are run one after the other.
--
-- The variables are versioned (Dice, Shalev, Shavit's TL2): a
-- variable holds its value and the version it was written at, from a
-- clock the transactions share, read as a transaction begins.  A read
-- of a version past that is a read of a later world, and the
-- transaction starts again; so what a transaction sees is consistent
-- all along, and one that only reads commits without a look back.
-- One that writes holds, at its commit, the mutexes of the variables
-- it writes, in the order of their numbers (so that no two wait for
-- each other), marks them its own, takes the clock's next version,
-- checks that each variable it read holds the version it read and is
-- no other transaction's, writes, and lets go.  What a transaction has
-- written and not yet committed is kept at the variable, by the
-- transaction's number, so that it reads its own writes back and no
-- other transaction sees them.
--
-- The threads are the scheduler's, a handler in the language, and the
-- domains are their workers: a thread is a resumption, run by a worker
-- from where it stopped to where it next ends or waits, its
-- transactions run on the worker's domain, and the worker takes the
-- next thread ready (one queue under a mutex, the workers waiting on a
-- condition while it is empty).  A thread whose transaction retries
-- leaves itself, once, at each variable the transaction read, under
-- their mutexes, after a last look that none has changed; a commit
-- writing one of them wakes it, and it runs the transaction again.
-- `scheduled` counts the threads running or ready: at none left before
-- main is done every thread waits in a `retry`, a deadlock, and it
-- comes to `Nothing`.  Main's answer ends it all, the other threads
-- dropped where they stopped.  A thread gives up its domain at its
-- operations alone: long pure work in a thread, in a transaction or
-- out of it, holds its domain until it comes to one.  A computation
-- held by an operation of `w` (`Domain.spawn c` holds `c`) is run
-- alone, as the operation does it: its spawns and variables are the
-- scheduler's, but a transaction in it has no thread to wait, and a
-- `retry` there is abandoned.  A thread that fails fails its worker,
-- which `scheduled` says once main is done; what its transaction
-- wrote and did not commit stays at the variables, unseen.

module stm
  ( stm
  , transaction
  , TVar
  , spawn
  , newTVar
  , atomically
  , readTVar
  , writeTVar
  , modifyTVar
  , retry
  , orElse
  , check
  , scheduled
  )

import co
import std.domain as Domain

-- Variables
--------------------------------------------------------------------------------

-- (a thread waiting for a variable it read to be written: whether it
-- has been woken, one cell for every variable it waits at, so that it
-- is woken once; and what readies it)
data Waiter (w : HFunctor) = MkWaiter (Domain.Atomic Bool) (Co w Unit)

-- (what a variable holds: the version it was written at, and the value)
data Versioned a = MkVersioned Int a

-- (a transaction's write of a variable, not yet committed: the
-- transaction's number, and the value)
data Pending a = MkPending Int a

-- (what transactions have written to a variable and not yet committed)
type Pendings a = Domain.Atomic (List (Pending a))

-- (a variable apart from its value: its number, which orders the
-- mutexes a commit holds; its mutex; the number of the transaction
-- committing it, 0 while none is; and the threads waiting for it to be
-- written)
data Key (w : HFunctor)
  = MkKey Int Domain.Mutex (Domain.Atomic Int) (Domain.Atomic (List (Waiter w)))

-- | A variable holding an `a`, of threads run in the world `w`, read
-- | and written in transactions.  (Its key; what it holds, with its
-- | version; and what transactions have written to it and not yet
-- | committed.)
data TVar (w : HFunctor) a
  = MkTVar (Key w) (Domain.Atomic (Versioned a)) (Pendings a)

numberOf : {w : HFunctor} -> Key w -> Int
numberOf (MkKey n mu owner waiters) = n

mutexOf : {w : HFunctor} -> Key w -> Domain.Mutex
mutexOf (MkKey n mu owner waiters) = mu

ownerOf : {w : HFunctor} -> Key w -> Domain.Atomic Int
ownerOf (MkKey n mu owner waiters) = owner

waitersOf : {w : HFunctor} -> Key w -> Domain.Atomic (List (Waiter w))
waitersOf (MkKey n mu owner waiters) = waiters

-- (the transaction's own write among those pending, if one)
ownPending : {a : Type} -> Int -> List (Pending a) -> Maybe a
ownPending me Nil = Nothing
ownPending me (MkPending t v :: rest) =
  if t == me then Just v else ownPending me rest

-- (those pending but the transaction's own)
withoutOwn : {a : Type} -> Int -> List (Pending a) -> List (Pending a)
withoutOwn me Nil = Nil
withoutOwn me (MkPending t v :: rest) =
  if t == me then withoutOwn me rest else MkPending t v :: withoutOwn me rest

-- Transactions, the effect
--------------------------------------------------------------------------------

-- | A value of some type, the type hidden: what an operation of a type
-- | of its own holds (the effect has no parameter for it).
type Some (f : Type -> Type) = (r : Type) -> ((a : Type) -> f a -> r) -> r

-- (what it holds, changed, of whatever type)
someThen : {f g : Type -> Type}
         -> ({a : Type} -> f a -> g a)
         -> Some f
         -> Some g
someThen h s = \r use -> s r (\a v -> use a (h v))

-- (a variable read: the variable, and what comes after, given its value)
data ReadOf (w : HFunctor) x a = MkReadOf (TVar w a) (a -> x)

-- (a variable written: the variable, the value, and what comes after)
data WriteOf (w : HFunctor) x a = MkWriteOf (TVar w a) a x

readOfThen : {w : HFunctor}
           -> {x y a : Type}
           -> (x -> y)
           -> ReadOf w x a
           -> ReadOf w y a
readOfThen g (MkReadOf v k) = MkReadOf v (\x -> g (k x))

writeOfThen : {w : HFunctor}
            -> {x y a : Type}
            -> (x -> y)
            -> WriteOf w x a
            -> WriteOf w y a
writeOfThen g (MkWriteOf v x k) = MkWriteOf v x (g k)

data TransactionF (w : HFunctor) (m : Type -> Type) x
  = Read (Some (ReadOf w x))
  | Write (Some (WriteOf w x))
  | Retry
  | OrElse (m x) (m x)

-- | A transaction on the variables of threads run in the world `w`, as
-- | an effect: a variable read, one written, a retry, and an
-- | `orElse`'s two transactions.
transaction : HFunctor -> HFunctor
transaction w =
  { f = TransactionF w
  , hfmap = \m g p -> case p of
      Read s -> Read (someThen (readOfThen g) s)
      Write s -> Write (someThen (writeOfThen g) s)
      Retry -> Retry
      OrElse l r -> OrElse (m.fmap g l) (m.fmap g r)
  , hmap = \m n nt p -> case p of
      Read s -> Read s
      Write s -> Write s
      Retry -> Retry
      OrElse l r -> OrElse (nt l) (nt r)
  }

-- | What the variable holds.
readTVar : {w : HFunctor} -> {a : Type} -> TVar w a -> Co (transaction w) a
readTVar v = op (Read (\r use -> use a (MkReadOf v (\x -> x)))) val

-- | ... and it holds `x` now.
writeTVar : {w : HFunctor}
          -> {a : Type}
          -> TVar w a
          -> a
          -> Co (transaction w) Unit
writeTVar v x = op (Write (\r use -> use a (MkWriteOf v x MkUnit))) val

-- | ... and it holds `f` of what it held.
modifyTVar : {w : HFunctor}
           -> {a : Type}
           -> TVar w a
           -> (a -> a)
           -> Co (transaction w) Unit
modifyTVar v f = do
  x <- readTVar v
  writeTVar v (f x)

-- | The transaction undone, to run again once a variable it read is
-- | written.
retry : {w : HFunctor} -> {a : Type} -> Co (transaction w) a
retry = op Retry val

-- | `l`; where it retries, `r` instead, from where `l` began (what `l`
-- | wrote undone).  Where both retry, the whole retries.
orElse : {w : HFunctor}
       -> {a : Type}
       -> Co (transaction w) a
       -> Co (transaction w) a
       -> Co (transaction w) a
orElse l r = op (OrElse l r) val

-- | Nothing, where `b`; else the transaction retried.
check : {w : HFunctor} -> Bool -> Co (transaction w) Unit
check b = if b then pure () else retry

-- Threads, the effect
--------------------------------------------------------------------------------

-- (a variable made: the value, and what comes after, given it)
data Making (w : HFunctor) x a = MkMaking a (TVar w a -> x)

-- (a transaction run: the transaction, and what comes after, given
-- what it comes to)
data Transacting (w : HFunctor) x a
  = MkTransacting (Co (transaction w) a) (a -> x)

makingThen : {w : HFunctor}
           -> {x y a : Type}
           -> (x -> y)
           -> Making w x a
           -> Making w y a
makingThen g (MkMaking v k) = MkMaking v (\tv -> g (k tv))

transactingThen : {w : HFunctor}
                -> {x y a : Type}
                -> (x -> y)
                -> Transacting w x a
                -> Transacting w y a
transactingThen g (MkTransacting c k) = MkTransacting c (\x -> g (k x))

data StmF (w : HFunctor) (m : Type -> Type) x
  = Spawn (m Unit) x
  | NewTVar (Some (Making w x))
  | Atomically (Some (Transacting w x))

-- (what comes after an operation, changed)
stepThen : {w : HFunctor}
         -> {m : Type -> Type}
         -> {x y : Type}
         -> (x -> y)
         -> StmF w m x
         -> StmF w m y
stepThen g (Spawn c x) = Spawn c (g x)
stepThen g (NewTVar s) = NewTVar (someThen (makingThen g) s)
stepThen g (Atomically s) = Atomically (someThen (transactingThen g) s)

-- | Threads sharing variables in the world `w`, as an effect.
stm : HFunctor -> HFunctor
stm w =
  { f = StmF w
  , hfmap = \m g p -> stepThen g p
  , hmap = \m n nt p -> case p of
      Spawn c x -> Spawn (nt c) x
      NewTVar s -> NewTVar s
      Atomically s -> Atomically s
  }

-- | `c`, a thread of its own; this one goes on.
spawn : {e w : HFunctor} -> {{sm : stm w <: e}} -> Co e Unit -> Co e Unit
spawn c = op (sm (Spawn c MkUnit)) val

-- | A variable holding `v`, for every thread.
newTVar : {e w : HFunctor}
        -> {a : Type}
        -> {{sm : stm w <: e}}
        -> a
        -> Co e (TVar w a)
newTVar v = op (sm (NewTVar (\r use -> use a (MkMaking v (\tv -> tv))))) val

-- | The transaction run as if alone, this thread waiting where it
-- | retries until a variable it read is written: what it comes to.
atomically : {e w : HFunctor}
           -> {a : Type}
           -> {{sm : stm w <: e}}
           -> Co (transaction w) a
           -> Co e a
atomically c =
  op (sm (Atomically (\r use -> use a (MkTransacting c (\x -> x))))) val

-- The handler: a thread as a resumption
--------------------------------------------------------------------------------

-- | A thread, stopped where the scheduler has a say: done; at an
-- | operation of `stm`, what comes after it a thread again; or at one
-- | of the world's, to be done in `Co w`.
data Res (w : HFunctor) a
  = RDone a
  | RStep (StmF w (Res w) (Res w a))
  | RAct (Co w (Res w a))

thenRes : {w : HFunctor} -> {a b : Type} -> Res w a -> (a -> Res w b) -> Res w b
thenRes (RDone x) f = f x
thenRes (RStep p) f = RStep (stepThen (\r -> thenRes r f) p)
thenRes (RAct m) f = RAct (bind m (\r -> pure (thenRes r f)))

resFunctor : (w : HFunctor) -> RawFunctor
resFunctor w = { f = Res w, fmap = \g r -> thenRes r (\x -> RDone (g x)) }

-- The scheduler
--------------------------------------------------------------------------------

-- (what the domains running threads share: the next variable's or
-- transaction's number; the clock, the version of the last commit; how
-- many threads are running or ready, which is 0 only at a deadlock;
-- the threads ready, a queue, its front and its back reversed; the
-- mutex they are taken under, the condition the domains wait on for
-- one, and the one the caller waits on until main is done or every
-- thread waits; whether that has come; and whether the domains are to
-- stop)
type Sched (w : HFunctor) =
  { numbers : Domain.Atomic Int
  , clock : Domain.Atomic Int
  , live : Domain.Atomic Int
  , ready : Domain.Atomic (Pair (List (Res w Unit)) (List (Res w Unit)))
  , mutex : Domain.Mutex
  , work : Domain.Condition
  , finished : Domain.Condition
  , done : Domain.Atomic Bool
  , stopping : Domain.Atomic Bool
  }

-- (the thread put among those ready, a domain waiting for one woken)
readied : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Res w Unit
        -> Co w Unit
readied st r = do
  Domain.lock st.mutex
  q <- Domain.get st.ready
  Domain.set st.ready (MkPair (fst q) (r :: snd q))
  Domain.signal st.work
  Domain.unlock st.mutex

-- (one more thread running or ready)
counted : {w : HFunctor} -> {{dm : Domain.domain <: w}} -> Sched w -> Co w Unit
counted st = do
  _ <- Domain.fetchAdd st.live 1
  pure ()

-- (the caller told that it is over: main done, or every thread waiting)
finishedWith : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> Sched w
             -> Co w Unit
finishedWith st = do
  Domain.lock st.mutex
  Domain.set st.done True
  Domain.broadcast st.finished
  Domain.unlock st.mutex

-- (one fewer thread running or ready: it waits, or it ended.  Where
-- none is left, every thread waits in a retry -- a deadlock, unless
-- main is done -- and the caller is told.)
uncounted : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Co w Unit
uncounted st = do
  n <- Domain.fetchAdd st.live (0 - 1)
  if n == 1 then finishedWith st else pure ()

-- (the thread, waiting no more: counted, and among those ready)
readyAgain : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Res w Unit
           -> Co w Unit
readyAgain st r = do
  counted st
  readied st r

-- (a number no variable or transaction has: from 1)
numbered : {w : HFunctor} -> {{dm : Domain.domain <: w}} -> Sched w -> Co w Int
numbered st = do
  n <- Domain.fetchAdd st.numbers 1
  pure (n + 1)

-- (a variable made, holding `v` at version 0)
madeTVar : {w : HFunctor}
         -> {a : Type}
         -> {{dm : Domain.domain <: w}}
         -> Sched w
         -> a
         -> Co w (TVar w a)
madeTVar st v = do
  n <- numbered st
  mu <- Domain.newMutex
  owner <- Domain.newAtomic 0
  waiters <- Domain.newAtomic (Nil : List (Waiter w))
  cell <- Domain.newAtomic (MkVersioned 0 v)
  pending <- Domain.newAtomic (Nil : List (Pending a))
  pure (MkTVar (MkKey n mu owner waiters) cell pending)

-- Running a transaction
--------------------------------------------------------------------------------

-- (a variable a transaction observed: its key, the version read, and
-- how its version is read again)
data Observed (w : HFunctor) = MkObserved (Key w) Int (Co w Int)

-- (a variable a transaction staged a write of: its key; how the write
-- is committed, given the version; and how it is undone)
data Staged (w : HFunctor) = MkStaged (Key w) (Int -> Co w Unit) (Co w Unit)

-- (a transaction's log: the variables observed, and the writes staged,
-- the latest first)
type Log (w : HFunctor) =
  { reads : List (Observed w), writes : List (Staged w) }

-- (what a transaction came to: its answer; a retry; or a read of a
-- version past the one it began at, so that it starts again -- each
-- with the log)
data Outcome (w : HFunctor) x
  = Done x (Log w)
  | Retried (Log w)
  | Stale (Log w)

-- (a transaction's computations: given the log, in the world)
type Tx (w : HFunctor) x = Log w -> Co w (Outcome w x)

thenTx : {w : HFunctor} -> {x y : Type} -> Tx w x -> (x -> Tx w y) -> Tx w y
thenTx m k log =
  bind (m log) (\o -> case o of
    Done x after -> k x after
    Retried after -> pure (Retried after)
    Stale after -> pure (Stale after))

-- (the variable's version now)
versionOf : {w : HFunctor}
          -> {a : Type}
          -> {{dm : Domain.domain <: w}}
          -> Domain.Atomic (Versioned a)
          -> Co w Int
versionOf cell = do
  held <- Domain.get cell
  case held of
    MkVersioned ver v -> pure ver

-- (a variable read by the transaction `me`, begun at the version `rv`:
-- its own write where it has one; else what it holds, where that is of
-- a version up to `rv`, the read logged; else the transaction is stale)
readIn : {w : HFunctor}
       -> {x a : Type}
       -> {{dm : Domain.domain <: w}}
       -> Int
       -> Int
       -> ReadOf w x a
       -> Tx w x
readIn me rv (MkReadOf (MkTVar key cell pending) k) log = do
  ps <- Domain.get pending
  case ownPending me ps of
    Just v -> pure (Done (k v) log)
    Nothing -> do
      held <- Domain.get cell
      case held of
        MkVersioned ver v ->
          if ver > rv then pure (Stale log)
          else do
            let seen : Observed w = MkObserved key ver (versionOf cell)
            pure (Done (k v) { log | reads = seen :: log.reads })

-- (what the variable holds, of the transaction `me`, pending: `v` now,
-- under the variable's mutex)
pendingSet : {w : HFunctor}
           -> {a : Type}
           -> {{dm : Domain.domain <: w}}
           -> Int
           -> Domain.Mutex
           -> Pendings a
           -> Maybe a
           -> Co w Unit
pendingSet me mu pending v = do
  Domain.lock mu
  ps <- Domain.get pending
  let others = withoutOwn me ps
  Domain.set pending (case v of
    Just x -> MkPending me x :: others
    Nothing -> others)
  Domain.unlock mu

-- (a variable written by the transaction `me`: the write pending at
-- the variable, where the transaction reads it back, and logged with
-- how it is committed -- what is pending then written at the given
-- version, the variable's mutex held by the commit -- and how it is
-- undone, what was pending before put back)
writtenIn : {w : HFunctor}
          -> {x a : Type}
          -> {{dm : Domain.domain <: w}}
          -> Int
          -> WriteOf w x a
          -> Tx w x
writtenIn me (MkWriteOf (MkTVar key cell pending) v k) log = do
  Domain.lock (mutexOf key)
  ps <- Domain.get pending
  let before = ownPending me ps
  Domain.set pending (MkPending me v :: withoutOwn me ps)
  Domain.unlock (mutexOf key)
  let commit : Int -> Co w Unit = \wv -> do
    now <- Domain.get pending
    case ownPending me now of
      Just x -> do
        Domain.set cell (MkVersioned wv x)
        Domain.set pending (withoutOwn me now)
      Nothing -> pure ()
  let undo : Co w Unit = pendingSet me (mutexOf key) pending before
  pure (Done k { log | writes = MkStaged key commit undo :: log.writes })

-- (the writes undone, the latest first)
undoneAll : {w : HFunctor} -> List (Staged w) -> Co w Unit
undoneAll Nil = pure ()
undoneAll (MkStaged key commit undo :: rest) = do
  undo
  undoneAll rest

-- (`l`; where it retries, its writes undone and `r` instead, with the
-- variables `l` read still logged, since what `r` runs on was decided
-- by them)
orElseIn : {w : HFunctor}
         -> {x : Type}
         -> Tx w x
         -> Tx w x
         -> Tx w x
orElseIn l r log = do
  o <- l { reads = log.reads, writes = Nil }
  case o of
    Done x inner ->
      pure (Done x { reads = inner.reads, writes = log.writes ++ inner.writes })
    Stale inner ->
      pure (Stale { reads = inner.reads, writes = log.writes ++ inner.writes })
    Retried inner -> do
      undoneAll inner.writes
      r { reads = inner.reads, writes = log.writes }

txAlg : {w : HFunctor}
      -> {x : Type}
      -> {{dm : Domain.domain <: w}}
      -> Int
      -> Int
      -> TransactionF w (Tx w) x
      -> Tx w x
txAlg me rv (Read s) = s (Tx w x) (\a rd -> readIn me rv rd)
txAlg me rv (Write s) = s (Tx w x) (\a wr -> writtenIn me wr)
txAlg me rv Retry = \log -> pure (Retried log)
txAlg me rv (OrElse l r) = orElseIn l r

-- (transactions run in the language, by the transaction `me`, begun at
-- the version `rv`)
txHandler : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Int
          -> Int
          -> Handler (transaction w)
txHandler me rv =
  { M = Tx w
  , ret = \x log -> pure (Done x log)
  , bind = \m k -> thenTx m k
  , malg = \p -> txAlg me rv p
  }

-- Committing
--------------------------------------------------------------------------------

-- (the keys in order of their numbers, each once)
distinctKeys : {w : HFunctor} -> List (Key w) -> List (Key w)
distinctKeys (a :: b :: rest) =
  if numberOf a == numberOf b then distinctKeys (b :: rest)
  else a :: distinctKeys (b :: rest)
distinctKeys keys = keys

-- (the keys, each once, in the order of their numbers: held in that
-- order by every commit and every retry, so that none waits for
-- another round a cycle)
orderedKeys : {w : HFunctor} -> List (Key w) -> List (Key w)
orderedKeys keys = distinctKeys (List.sortOn (\k -> numberOf k) keys)

keyOfRead : {w : HFunctor} -> Observed w -> Key w
keyOfRead (MkObserved key ver again) = key

keyOfWrite : {w : HFunctor} -> Staged w -> Key w
keyOfWrite (MkStaged key commit undo) = key

lockedAll : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> List (Key w)
          -> Co w Unit
lockedAll Nil = pure ()
lockedAll (k :: ks) = do
  Domain.lock (mutexOf k)
  lockedAll ks

unlockedAll : {w : HFunctor}
            -> {{dm : Domain.domain <: w}}
            -> List (Key w)
            -> Co w Unit
unlockedAll Nil = pure ()
unlockedAll (k :: ks) = do
  Domain.unlock (mutexOf k)
  unlockedAll ks

-- (each variable marked the transaction's, 0 for none, its mutex held)
ownedAll : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Int
         -> List (Key w)
         -> Co w Unit
ownedAll me Nil = pure ()
ownedAll me (k :: ks) = do
  Domain.set (ownerOf k) me
  ownedAll me ks

-- (whether each variable read holds the version read, and is no other
-- transaction's: the transaction `me` holding the mutexes of the
-- variables it writes, which it marked its own first, so that two
-- committing at once, each reading what the other writes, do not both
-- pass)
validAll : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> Int
         -> List (Observed w)
         -> Co w Bool
validAll me Nil = pure True
validAll me (MkObserved key seen again :: rest) = do
  owner <- Domain.get (ownerOf key)
  if owner /= 0 && owner /= me then pure False
  else do
    ver <- again
    if ver /= seen then pure False else validAll me rest

-- (the writes committed at the version `wv`, their mutexes held)
committedAll : {w : HFunctor} -> Int -> List (Staged w) -> Co w Unit
committedAll wv Nil = pure ()
committedAll wv (MkStaged key commit undo :: rest) = do
  commit wv
  committedAll wv rest

-- (the threads waiting at the variables, taken, their mutexes held)
takenWaiters : {w : HFunctor}
             -> {{dm : Domain.domain <: w}}
             -> List (Key w)
             -> Co w (List (Waiter w))
takenWaiters Nil = pure Nil
takenWaiters (k :: ks) = do
  ws <- Domain.get (waitersOf k)
  Domain.set (waitersOf k) Nil
  rest <- takenWaiters ks
  pure (ws ++ rest)

-- (each thread not yet woken, woken: readied, once)
wokenAll : {w : HFunctor}
         -> {{dm : Domain.domain <: w}}
         -> List (Waiter w)
         -> Co w Unit
wokenAll Nil = pure ()
wokenAll (MkWaiter woken wake :: rest) = do
  ok <- Domain.cas woken False True
  if ok then wake else pure ()
  wokenAll rest

-- (the transaction `me` committed, where it can be: one that wrote
-- nothing is done, what it read of versions up to the one it began at;
-- one that wrote holds the mutexes of the variables it writes, marks
-- them its own, takes the next version, checks what it read, writes
-- and lets go, the threads waiting at them woken.  Whether it was; else
-- its writes are undone, for it to run again.)
committed : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> Sched w
          -> Int
          -> Log w
          -> Co w Bool
committed st me log = case log.writes of
  Nil -> pure True
  writes -> do
    let keys = orderedKeys (List.map keyOfWrite writes)
    lockedAll keys
    ownedAll me keys
    was <- Domain.fetchAdd st.clock 1
    ok <- validAll me log.reads
    if ok
    then do
      committedAll (was + 1) writes
      ws <- takenWaiters keys
      ownedAll 0 keys
      unlockedAll keys
      wokenAll ws
      pure True
    else do
      ownedAll 0 keys
      unlockedAll keys
      undoneAll writes
      pure False

-- (the thread left waiting at each variable the transaction read,
-- their mutexes held)
leftAt : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Waiter w
       -> List (Key w)
       -> Co w Unit
leftAt waiter Nil = pure ()
leftAt waiter (k :: ks) = do
  ws <- Domain.get (waitersOf k)
  Domain.set (waitersOf k) (ws ++ [waiter])
  leftAt waiter ks

-- (the transaction `me` retried, its writes undone: the thread left
-- waiting at every variable it read, under their mutexes, after a last
-- look that each holds the version read, and one fewer running --
-- whether it was; else, a variable having changed meanwhile, the
-- transaction is to run again now.  One that read nothing waits for
-- good.)
waited : {w : HFunctor}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> Int
       -> Log w
       -> Res w Unit
       -> Co w Bool
waited st me log again = do
  undoneAll log.writes
  let keys = orderedKeys (List.map keyOfRead log.reads)
  lockedAll keys
  ok <- validAll me log.reads
  if ok
  then do
    woken <- Domain.newAtomic False
    leftAt (MkWaiter woken (readyAgain st again)) keys
    unlockedAll keys
    uncounted st
    pure True
  else do
    unlockedAll keys
    pure False

-- (what a thread's step came to: it goes on from here; or it stopped
-- -- ended or waiting -- and the domain takes another)
data Stepped (w : HFunctor) = GoesOn (Res w Unit) | Stopped

-- (the transaction run by the thread, `again` the thread as it is run
-- again where the transaction retries and is woken: committed, the
-- thread goes on with its answer; run again at once where it read a
-- later version or what it read changed before it committed; waiting
-- where it retries)
transacted : {w : HFunctor}
           -> {a : Type}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Res w Unit
           -> Transacting w (Res w Unit) a
           -> Co w (Stepped w)
transacted st again (MkTransacting c k) = do
  me <- numbered st
  rv <- Domain.get st.clock
  o <- handle (txHandler me rv) c { reads = Nil, writes = Nil }
  case o of
    Done x log -> do
      ok <- committed st me log
      if ok then pure (GoesOn (k x))
      else transacted st again (MkTransacting c k)
    Stale log -> do
      undoneAll log.writes
      transacted st again (MkTransacting c k)
    Retried log -> do
      waiting <- waited st me log again
      if waiting then pure Stopped else transacted st again (MkTransacting c k)

-- (the transaction run with no thread to wait: committed, its answer;
-- run again where it must; a retry abandoned)
transactedAlone : {w : HFunctor}
                -> {a : Type}
                -> {{dm : Domain.domain <: w}}
                -> Sched w
                -> Co (transaction w) a
                -> Co w a
transactedAlone st c = do
  me <- numbered st
  rv <- Domain.get st.clock
  o <- handle (txHandler me rv) c { reads = Nil, writes = Nil }
  case o of
    Done x log -> do
      ok <- committed st me log
      if ok then pure x else transactedAlone st c
    Stale log -> do
      undoneAll log.writes
      transactedAlone st c
    Retried log -> do
      undoneAll log.writes
      abandon

-- Threads run
--------------------------------------------------------------------------------

-- (a thread run alone to its end: what an operation of `w` holding
-- computations is given, as `Domain.spawn c` holds `c`.  Its spawns
-- and variables are the scheduler's; a transaction in it that retries
-- is abandoned.)
alone : {w : HFunctor}
      -> {a : Type}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> Res w a
      -> Co w a
alone st (RDone x) = pure x
alone st (RAct m) = bind m (\r -> alone st r)
alone st (RStep (Spawn c k)) = do
  readyAgain st c
  alone st k
alone st (RStep (NewTVar s)) =
  s (Co w a) (\t mk -> case mk of
    MkMaking v k -> bind (madeTVar st v) (\tv -> alone st (k tv)))
alone st (RStep (Atomically s)) =
  s (Co w a) (\t tr -> case tr of
    MkTransacting c k -> bind (transactedAlone st c) (\x -> alone st (k x)))

stmAlg : {w : HFunctor}
       -> {a : Type}
       -> {{dm : Domain.domain <: w}}
       -> Sched w
       -> (stm w <+> w).f (Res w) a
       -> Res w a
stmAlg st (InL p) = RStep (stepThen (\x -> RDone x) p)
stmAlg st (InR q) =
  RAct
    (op
       (w.hmap (resFunctor w) (coFunctor w) (\r -> alone st r) q)
       (\x -> pure (RDone x)))

stmHandler : {w : HFunctor}
           -> {{dm : Domain.domain <: w}}
           -> Sched w
           -> Handler (stm w <+> w)
stmHandler st =
  { M = Res w
  , ret = \x -> RDone x
  , bind = \m f -> thenRes m f
  , malg = \p -> stmAlg st p
  }

-- (a thread's step: where it stopped, what the scheduler does there)
stepped : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Res w Unit
        -> Co w (Stepped w)
stepped st (RDone u) = do
  uncounted st
  pure Stopped
stepped st (RAct m) = bind m (\r -> pure (GoesOn r))
stepped st (RStep (Spawn c k)) = do
  readyAgain st c
  pure (GoesOn k)
stepped st (RStep (NewTVar s)) =
  s (Co w (Stepped w)) (\a mk -> case mk of
    MkMaking v k -> bind (madeTVar st v) (\tv -> pure (GoesOn (k tv))))
stepped st (RStep (Atomically s)) =
  s (Co w (Stepped w)) (\a tr -> transacted st (RStep (Atomically s)) tr)

-- (a thread run from where it stopped until it ends or waits)
run : {w : HFunctor}
    -> {{dm : Domain.domain <: w}}
    -> Sched w
    -> Res w Unit
    -> Co w Unit
run st r = do
  s <- stepped st r
  case s of
    GoesOn next -> run st next
    Stopped -> pure ()

-- (the next thread ready, the mutex held: waiting for one while none
-- is; `Nothing` once the domains are to stop and none is left)
taken : {w : HFunctor}
      -> {{dm : Domain.domain <: w}}
      -> Sched w
      -> Co w (Maybe (Res w Unit))
taken st = do
  q <- Domain.get st.ready
  case q of
    MkPair (x :: xs) back -> do
      Domain.set st.ready (MkPair xs back)
      pure (Just x)
    MkPair Nil Nil -> do
      stop <- Domain.get st.stopping
      if stop then pure Nothing
      else do
        Domain.wait st.work st.mutex
        taken st
    MkPair Nil back -> do
      Domain.set st.ready (MkPair (List.reverse back) Nil)
      taken st

-- (a domain running threads, each ready one it takes, until it is to
-- stop)
worker : {w : HFunctor} -> {{dm : Domain.domain <: w}} -> Sched w -> Co w Unit
worker st = do
  Domain.lock st.mutex
  next <- taken st
  Domain.unlock st.mutex
  case next of
    Just r -> do
      run st r
      worker st
    Nothing -> pure ()

workers : {w : HFunctor}
        -> {{dm : Domain.domain <: w}}
        -> Sched w
        -> Int
        -> Co w (List (Domain.Domain Unit))
workers st n =
  if n <= 0 then pure Nil
  else do
    d <- Domain.spawn (worker st)
    ds <- workers st (n - 1)
    pure (d :: ds)

joinedAll : {w : HFunctor}
          -> {{dm : Domain.domain <: w}}
          -> List (Domain.Domain Unit)
          -> Co w Unit
joinedAll Nil = pure ()
joinedAll (d :: ds) = do
  Domain.join d
  joinedAll ds

-- (waiting, the mutex held, until main is done or every thread waits)
idleUntilDone : {w : HFunctor}
              -> {{dm : Domain.domain <: w}}
              -> Sched w
              -> Co w Unit
idleUntilDone st = do
  d <- Domain.get st.done
  if d then pure ()
  else do
    Domain.wait st.finished st.mutex
    idleUntilDone st

-- | `c` and the threads it spawns, run on as many domains as the
-- | machine has cores (`Domain.cores`): `Just` main's answer, the other
-- | threads dropped where they stopped; or `Nothing` where main is not
-- | done and every thread waits in a `retry`, a deadlock.  A thread
-- | that fails fails the domain running it, which fails this once main
-- | is done.
scheduled : {w : HFunctor}
          -> {a : Type}
          -> {{dm : Domain.domain <: w}}
          -> Co (stm w <+> w) a
          -> Co w (Maybe a)
scheduled c = do
  numbers <- Domain.newAtomic 0
  clock <- Domain.newAtomic 0
  live <- Domain.newAtomic 0
  ready <-
    Domain.newAtomic
      (MkPair Nil Nil : Pair (List (Res w Unit)) (List (Res w Unit)))
  mutex <- Domain.newMutex
  work <- Domain.newCondition
  finished <- Domain.newCondition
  done <- Domain.newAtomic False
  stopping <- Domain.newAtomic False
  let st : Sched w =
    { numbers = numbers
    , clock = clock
    , live = live
    , ready = ready
    , mutex = mutex
    , work = work
    , finished = finished
    , done = done
    , stopping = stopping
    }
  answer <- Domain.newAtomic (Nothing : Maybe a)
  let main : Res w Unit =
    thenRes
      (handle (stmHandler st) c)
      (\x ->
         RAct (do
           Domain.set answer (Just x)
           finishedWith st
           pure (RDone MkUnit)))
  readyAgain st main
  n <- Domain.cores
  ds <- workers st n
  Domain.lock mutex
  idleUntilDone st
  Domain.set stopping True
  Domain.broadcast work
  Domain.unlock mutex
  joinedAll ds
  Domain.get answer
