-- Arrays: a fixed number of elements, each reached at once by its index
-- (from 0).  Import it by a name, `import array as Array`: `Array.length`,
-- `Array.index`, as `length` and `map` are the prelude's lists' too.
--
-- An array is a value and never changes: `set` gives another.  Where
-- nothing else holds the array, though, `set` writes in place, and so does
-- everything here made of it (`modify`, `swap`, `fill`, `reverse`); held
-- elsewhere too, it is copied first, once.  So an array passed from one
-- step of a loop to the next is changed in place, as a mutable one is.
-- It grows so too: an array held only there keeps room after its
-- elements, which `push`, `append` and `insertAt` write into, and grows
-- it, twice as much, where there is none -- an array built a `push` at a
-- time is copied a few times, not once a push.  `pop` and `removeAt` take
-- an element off, the room kept, and `reserve` makes room ahead.
--
-- ```haskell
-- import array as Array
--
-- -- | the primes below `n`, by a sieve
-- -- | >>> primes 20
-- -- | [2, 3, 5, 7, 11, 13, 17, 19]
-- primes : Int -> List Int
-- primes n = List.keepIf (\i -> Array.index sieve i == Just 1) (List.range 2 (n - 1))
--   where
--   cross : Int -> Int -> Array Int -> Array Int
--   cross p j xs = if j >= n then xs else cross p (j + p) (Array.set xs j 0)
--
--   sift : Int -> Array Int -> Array Int
--   sift p xs = if p * p >= n then xs else sift (p + 1) (cross p (p * p) xs)
--
--   sieve : Array Int
--   sieve = sift 2 (Array.replicate n 1)
-- ```
--
-- An array of a number's type (`Float64`, `Int64`, `UInt8`, ...) is kept
-- flat where it is built knowing the type, as C's array of it: an `Array
-- Float64` is `double`s, an `Array UInt8` bytes.  In JavaScript, an array
-- of numbers is a `Float64Array`.

module array
  ( arrayLength
  , arrayIndex
  , arraySet
  , arrayGenerate
  , arrayReplicate
  , arrayFromList
  , arrayToList
  , arraySlice
  , arrayAppend
  , arrayInsertAt
  , arrayRemoveAt
  , arrayPush
  , arrayReserve
  , length
  , instanceIterateArray
  , index
  , set
  , generate
  , replicate
  , fromList
  , toList
  , empty
  , modify
  , swap
  , fill
  , slice
  , append
  , push
  , pop
  , reserve
  , insertAt
  , removeAt
  , map
  , foldl
  , foldr
  , reverse
  , sort
  , sortOn
  , search
  , null
  , keepIf
  , indexWhere
  , find
  , any
  , all
  )

primitive arrayLength : {a : Type} -> Array a -> Int
primitive arrayIndex : {a : Type} -> Array a -> Int -> a
primitive arraySet : {a : Type} -> Array a -> Int -> a -> Array a
primitive arrayGenerate : {a : Type} -> Int -> (Int -> a) -> Array a
primitive arrayReplicate : {a : Type} -> Int -> a -> Array a
primitive arrayFromList : {a : Type} -> List a -> Array a
primitive arrayToList : {a : Type} -> Array a -> List a
primitive arraySlice : {a : Type} -> Array a -> Int -> Int -> Array a
primitive arrayAppend : {a : Type} -> Array a -> Array a -> Array a
primitive arrayInsertAt : {a : Type} -> Array a -> Int -> a -> Array a
primitive arrayRemoveAt : {a : Type} -> Array a -> Int -> Array a
primitive arrayPush : {a : Type} -> Array a -> a -> Array a
primitive arrayReserve : {a : Type} -> Array a -> Int -> Array a

-- | How many elements it has.
-- | >>> length (arrayFromList ["a", "b"])
-- | 2
length : {a : Type} -> Array a -> Int
length = arrayLength

-- | An array, from its first element: `for x in xs` goes through it by
-- | its index (the cursor is the array and the index).
instance instanceIterateArray : {a : Type} -> Iterate (Array a)
instanceIterateArray =
  { Elem = a, Cursor = Pair (Array a) Int, start = begin, next = step }
  where
  begin : Array a -> Pair (Array a) Int
  begin xs = MkPair xs 0
  step : Pair (Array a) Int -> Maybe (Pair a (Pair (Array a) Int))
  step (MkPair xs i) =
    if i < arrayLength xs
    then Just (MkPair (arrayIndex xs i) (MkPair xs (i + 1)))
    else Nothing

-- | The element at `i`, if there is one: out of range, `Nothing`.
-- | >>> index (arrayFromList ["a", "b"]) 1
-- | Just "b"
-- | >>> index (arrayFromList ["a", "b"]) 2
-- | Nothing
-- | >>> index (arrayFromList ["a", "b"]) -1
-- | Nothing
index : {a : Type} -> Array a -> Int -> Maybe a
index xs i =
  if 0 <= i && i < arrayLength xs then Just (arrayIndex xs i) else Nothing

-- | Another array, with `x` at `i`; out of range, the array as it is.
-- | Written in place where nothing else holds the array, else a copy.
-- | >>> arrayToList (set (arrayFromList [1, 2]) 0 7)
-- | Cons 7 (Cons 2 Nil)
-- | >>> arrayToList (set (arrayFromList [1, 2]) 2 7)
-- | Cons 1 (Cons 2 Nil)
-- | >>> arrayToList (set (arrayFromList [1, 2]) -1 7)
-- | Cons 1 (Cons 2 Nil)
set : {a : Type} -> Array a -> Int -> a -> Array a
set = arraySet

-- | `n` elements, the one at `i` being `f i`.
generate : {a : Type} -> Int -> (Int -> a) -> Array a
generate = arrayGenerate

-- | `n` elements, each `x`; fewer than none, none.
-- | >>> arrayToList (replicate 3 'a')
-- | Cons 'a' (Cons 'a' (Cons 'a' Nil))
-- | >>> length (replicate -1 0.5)
-- | 0
replicate : {a : Type} -> Int -> a -> Array a
replicate = arrayReplicate

-- | A list's elements, in its order.
fromList : {a : Type} -> List a -> Array a
fromList = arrayFromList

-- | The elements, in order, as a list.
toList : {a : Type} -> Array a -> List a
toList = arrayToList

-- | An array of no elements.
-- | >>> length (empty : Array Int)
-- | 0
empty : {a : Type} -> Array a
empty = arrayGenerate 0 (\_ -> abandon)

-- | The element at `i` made `f` of it; out of range, the array as it is.
-- | >>> toList (modify (fromList [1, 2, 3]) 1 (\x -> x * 10))
-- | Cons 1 (Cons 20 (Cons 3 Nil))
-- | >>> toList (modify (fromList [1, 2, 3]) 3 (\x -> x * 10))
-- | Cons 1 (Cons 2 (Cons 3 Nil))
modify : {a : Type} -> Array a -> Int -> (a -> a) -> Array a
modify xs i f =
  if 0 <= i && i < arrayLength xs then arraySet xs i (f (arrayIndex xs i))
  else xs

-- | The elements at `i` and `j` swapped; either out of range, the array
-- | as it is.
-- | >>> toList (swap (fromList ["a", "b", "c"]) 0 2)
-- | Cons "c" (Cons "b" (Cons "a" Nil))
-- | >>> toList (swap (fromList ["a", "b", "c"]) 0 3)
-- | Cons "a" (Cons "b" (Cons "c" Nil))
swap : {a : Type} -> Array a -> Int -> Int -> Array a
swap xs i j =
  if 0 <= i && i < arrayLength xs && 0 <= j && j < arrayLength xs
  then let x = arrayIndex xs i
       in let y = arrayIndex xs j
       in arraySet (arraySet xs i y) j x
  else xs

-- | Each element `x`.
-- | >>> toList (fill (fromList [1, 2, 3]) 0)
-- | Cons 0 (Cons 0 (Cons 0 Nil))
fill : {a : Type} -> Array a -> a -> Array a
fill xs x = fillFrom 0 xs
  where
  -- (from the element at `i` on, each `x`)
  fillFrom : Int -> Array a -> Array a
  fillFrom i ys =
    if i < arrayLength ys then fillFrom (i + 1) (arraySet ys i x) else ys

-- | The elements from `i` up to `j`, `j` not among them, each where it is
-- | clamped to them, and a negative one counted from the end, as a
-- | string's slice is.
-- | >>> List.map toList [slice (fromList [1, 2, 3, 4]) 1 3, slice (fromList [1, 2, 3, 4]) 2 9, slice (fromList [1, 2, 3, 4]) -1 4]
-- | Cons (Cons 2 (Cons 3 Nil)) (Cons (Cons 3 (Cons 4 Nil)) (Cons (Cons 4 Nil) Nil))
slice : {a : Type} -> Array a -> Int -> Int -> Array a
slice = arraySlice

-- | The elements of one, then of the other: the first's room grown, in
-- | place, where nothing else holds it.
-- | >>> toList (append (fromList [1, 2]) (fromList [3]))
-- | Cons 1 (Cons 2 (Cons 3 Nil))
append : {a : Type} -> Array a -> Array a -> Array a
append = arrayAppend

-- | `x` after the last element.  In place where nothing else holds the
-- | array and it has room; where it has none, its room is doubled first.
-- | Held elsewhere too, a copy, with room.
-- | >>> toList (push (fromList [1, 2]) 3)
-- | Cons 1 (Cons 2 (Cons 3 Nil))
-- | >>> toList (push empty "a")
-- | Cons "a" Nil
push : {a : Type} -> Array a -> a -> Array a
push = arrayPush

-- | The last element and the others, if there is one; of none,
-- | `Nothing`.  Where nothing else holds the array, it is shortened in
-- | place, its room kept for the next `push`.  A match on it where it is
-- | called builds neither the `Just` nor the pair: it is inlined, a test
-- | of the length, and the match chooses in each of its ways.
-- | >>> pop (fromList [1, 2, 3])
-- | Just (MkPair [1, 2] 3)
-- | >>> pop (empty : Array Int)
-- | Nothing
pop : {a : Type} -> Array a -> Maybe (Pair (Array a) a)
pop xs =
  let n = arrayLength xs
  in if n == 0 then Nothing
  else let x = arrayIndex xs (n - 1)
       in Just (MkPair (arrayRemoveAt xs (n - 1)) x)

-- | The same elements, with room for at least `k` more, so that so many
-- | `push`es are not grown; fewer than none, none.  In place where
-- | nothing else holds the array, else a copy.
-- | >>> toList (push (reserve (fromList [1]) 100) 2)
-- | Cons 1 (Cons 2 Nil)
reserve : {a : Type} -> Array a -> Int -> Array a
reserve = arrayReserve

-- | `x` put in at `i` -- clamped to them, from 0 up to the length -- the
-- | elements from there one further on.  In place where nothing else
-- | holds the array and it has room.
-- | >>> toList (insertAt (fromList ["a", "c"]) 1 "b")
-- | Cons "a" (Cons "b" (Cons "c" Nil))
-- | >>> toList (insertAt (fromList ["a", "b"]) 9 "c")
-- | Cons "a" (Cons "b" (Cons "c" Nil))
insertAt : {a : Type} -> Array a -> Int -> a -> Array a
insertAt = arrayInsertAt

-- | The element at `i` taken out, those after it one nearer; out of
-- | range, the array as it is.  In place where nothing else holds the
-- | array, its room kept, as `pop` keeps it.
-- | >>> toList (removeAt (fromList ["a", "b", "c"]) 1)
-- | Cons "a" (Cons "c" Nil)
-- | >>> toList (removeAt (fromList ["a", "b"]) 2)
-- | Cons "a" (Cons "b" Nil)
removeAt : {a : Type} -> Array a -> Int -> Array a
removeAt = arrayRemoveAt

-- | Each element, `f` of it: another array.
-- | >>> toList (map (\x -> x * 2) (fromList [1, 2]))
-- | Cons 2 (Cons 4 Nil)
map : {a b : Type} -> (a -> b) -> Array a -> Array b
map f xs = arrayGenerate (arrayLength xs) (\i -> f (arrayIndex xs i))

-- | The elements, from the first, into `z`.
foldl : {a b : Type} -> (b -> a -> b) -> b -> Array a -> b
foldl f z xs = foldlFrom 0 z
  where
  -- (from the element at `i` on)
  foldlFrom : Int -> b -> b
  foldlFrom i acc =
    if i < arrayLength xs then foldlFrom (i + 1) (f acc (arrayIndex xs i))
    else acc

-- | The elements, from the last, into `z`: `foldr f z` of `[a, b]` is
-- | `f a (f b z)`.
-- | >>> foldr (\x s -> s ^ x) "" (fromList ["a", "b", "c"])
-- | "cba"
foldr : {a b : Type} -> (a -> b -> b) -> b -> Array a -> b
foldr f z xs = foldrFrom (arrayLength xs) z
  where
  -- (from the element before `i` back)
  foldrFrom : Int -> b -> b
  foldrFrom i acc =
    if i > 0 then foldrFrom (i - 1) (f (arrayIndex xs (i - 1)) acc) else acc

-- (the elements from `i` up to `j`, `j` among them, the other way round)
reverseIn : {a : Type} -> Int -> Int -> Array a -> Array a
reverseIn i j xs = if i < j then reverseIn (i + 1) (j - 1) (swap xs i j) else xs

-- | The elements the other way round.
-- | >>> toList (reverse (fromList [1, 2, 3]))
-- | Cons 3 (Cons 2 (Cons 1 Nil))
reverse : {a : Type} -> Array a -> Array a
reverse xs = reverseIn 0 (arrayLength xs - 1) xs

-- (`x` put in at `j` or before, among the elements from `lo` up to `j`,
-- sorted: each that goes after it, by `le`, moved on one)
insertDown : {a : Type}
           -> (a -> a -> Bool)
           -> Int
           -> a
           -> Int
           -> Array a
           -> Array a
insertDown le lo x j xs =
  if j > lo && not (le (arrayIndex xs (j - 1)) x)
  then insertDown le lo x (j - 1) (arraySet xs j (arrayIndex xs (j - 1)))
  else arraySet xs j x

-- (the elements from `lo` up to `hi` sorted, by insertion, those before
-- `i` already)
insertionIn : {a : Type}
            -> (a -> a -> Bool)
            -> Int
            -> Int
            -> Int
            -> Array a
            -> Array a
insertionIn le lo i hi xs =
  if i < hi
  then insertionIn le lo (i + 1) hi (insertDown le lo (arrayIndex xs i) i xs)
  else xs

-- (from `lo` on, each two of `src`'s sorted runs of `w`, merged into
-- `dst`)
mergePass : {a : Type}
          -> (a -> a -> Bool)
          -> Int
          -> Array a
          -> Int
          -> Array a
          -> Array a
mergePass le w src lo dst =
  if lo < arrayLength src
  then mergePass
      le
      w
      src
      (lo + 2 * w)
      (mergeInto
         lo
         (min (lo + w) (arrayLength src))
         (min (lo + w) (arrayLength src))
         (min (lo + 2 * w) (arrayLength src))
         lo
         dst)
  else dst
  where
  -- (`src`'s sorted elements from `i` up to `mid` and from `j` up to
  -- `hi`, merged into `ys` from `k`: of two that go together, the first's
  -- first)
  mergeInto : Int -> Int -> Int -> Int -> Int -> Array a -> Array a
  mergeInto i mid j hi k ys =
    if i >= mid then copyInto j hi k ys
    else if j >= hi then copyInto i mid k ys
    else if le (arrayIndex src i) (arrayIndex src j)
    then mergeInto (i + 1) mid j hi (k + 1) (arraySet ys k (arrayIndex src i))
    else mergeInto i mid (j + 1) hi (k + 1) (arraySet ys k (arrayIndex src j))
    where
    -- (`src`'s elements from `i` up to `hi`, put in `ys` from `k`)
    copyInto : Int -> Int -> Int -> Array a -> Array a
    copyInto i2 hi2 k2 zs =
      if i2 < hi2
      then copyInto (i2 + 1) hi2 (k2 + 1) (arraySet zs k2 (arrayIndex src i2))
      else zs

-- (`src`'s sorted runs of `w` merged, two by two, until one is left, by
-- way of `dst` and back)
mergePasses : {a : Type}
            -> (a -> a -> Bool)
            -> Int
            -> Array a
            -> Array a
            -> Array a
mergePasses le w src dst =
  if w >= arrayLength src then src
  else mergePasses le (2 * w) (mergePass le w src 0 dst) src

-- (sorted by `le`, whether one goes before, or with, another, stably,
-- as a list is: runs of 16 sorted by insertion, then merged two by two,
-- into an array as long and back.  Where nothing else holds the array,
-- it is sorted in place, the other array the only one made)
sortedBy : {a : Type} -> (a -> a -> Bool) -> Array a -> Array a
sortedBy le xs =
  if arrayLength xs < 2 then xs
  else mergePasses
      le
      16
      (runsFrom 16 0 xs)
      (arrayReplicate (arrayLength xs) (arrayIndex xs 0))
  where
  -- (from `lo` on, each `w` elements sorted, by insertion)
  runsFrom : Int -> Int -> Array a -> Array a
  runsFrom w lo ys =
    if lo < arrayLength ys
    then runsFrom
        w
        (lo + w)
        (insertionIn le lo (lo + 1) (min (lo + w) (arrayLength ys)) ys)
    else ys

-- | Sorted by the elements' `Order`, stably.
-- | >>> toList (sort (fromList ["b", "c", "a"]))
-- | Cons "a" (Cons "b" (Cons "c" Nil))
sort : {a : Type} -> {{ord : Order a}} -> Array a -> Array a
sort xs = sortedBy (\a b -> a <= b) xs

-- | Sorted by `key`'s `Order`, stably, as `List.sortOn` is: of two whose
-- | keys are equal, the first first.  Where nothing else holds the array,
-- | it is sorted in place, one other array made.
-- | >>> List.map snd (toList (sortOn (\p -> fst p) (fromList (List.map (\i -> MkPair (i % 3) i) (List.range 1 40)))))
-- | [3, 6, 9, 12, 15, 18, 21, 24, 27, 30, 33, 36, 39, 1, 4, 7, 10, 13, 16, 19, 22, 25, 28, 31, 34, 37, 40, 2, 5, 8, 11, 14, 17, 20, 23, 26, 29, 32, 35, 38]
-- | >>> toList (sortOn (\x -> 0 - x) (fromList [3, 1, 2]))
-- | Cons 3 (Cons 2 (Cons 1 Nil))
sortOn : {a k : Type} -> {{ord : Order k}} -> (a -> k) -> Array a -> Array a
sortOn key xs = sortedBy (\a b -> key a <= key b) xs

-- (the least index from `lo` up to `hi` where `p` holds, `hi` if none:
-- `p` holding from some index on, as `search` asks)
searchBetween : {a : Type} -> (a -> Bool) -> Array a -> Int -> Int -> Int
searchBetween p xs lo hi =
  if lo >= hi then lo
  else (let mid : Int = lo + (hi - lo) / 2
        in if p (arrayIndex xs mid) then searchBetween p xs lo mid
        else searchBetween p xs (mid + 1) hi)

-- | The least index whose element `p` holds of, the length if none, by
-- | halving: `p` must hold, if at all, from some index to the end -- of
-- | an array sorted going up, `\x -> x >= y` finds where `y` is, or
-- | would go (Go's `sort.Search`).
-- | >>> List.map (\y -> search (\x -> x >= y) (fromList [1, 3, 3, 7])) [0, 3, 4, 8]
-- | Cons 0 (Cons 1 (Cons 3 (Cons 4 Nil)))
search : {a : Type} -> (a -> Bool) -> Array a -> Int
search p xs = searchBetween p xs 0 (arrayLength xs)

-- | Whether it has no elements.
-- | >>> List.map null [empty, fromList [1]]
-- | Cons True (Cons False Nil)
null : {a : Type} -> Array a -> Bool
null xs = arrayLength xs == 0

-- | Those `p` holds of, in order.
-- | >>> toList (keepIf (\x -> x % 2 == 1) (fromList [1, 2, 3]))
-- | Cons 1 (Cons 3 Nil)
keepIf : {a : Type} -> (a -> Bool) -> Array a -> Array a
keepIf p xs = foldl (\acc x -> if p x then push acc x else acc) empty xs

-- | Where the first element `p` holds of is, if one is.
-- | >>> List.map (\y -> indexWhere (\x -> x > y) (fromList [1, 3, 5])) [2, 9]
-- | Cons (Just 1) (Cons Nothing Nil)
indexWhere : {a : Type} -> (a -> Bool) -> Array a -> Maybe Int
indexWhere p xs = from 0
  where
  -- (the first index from `i` on whose element `p` holds of)
  from : Int -> Maybe Int
  from i =
    if i >= arrayLength xs then Nothing
    else if p (arrayIndex xs i) then Just i
    else from (i + 1)

-- | The first element `p` holds of, if one does.
-- | >>> find (\x -> x > 2) (fromList [1, 3, 5])
-- | Just 3
find : {a : Type} -> (a -> Bool) -> Array a -> Maybe a
find p xs = case indexWhere p xs of
  Just i -> Just (arrayIndex xs i)
  Nothing -> Nothing

-- | Whether `p` holds of some element.
-- | >>> any (\x -> x > 4) (fromList [1, 3, 5])
-- | True
any : {a : Type} -> (a -> Bool) -> Array a -> Bool
any p xs = case indexWhere p xs of
  Just _ -> True
  Nothing -> False

-- | Whether `p` holds of every element (of none, it does).
-- | >>> List.map (all (\x -> x > 0)) [fromList [1, 3], fromList [1, 0], empty]
-- | Cons True (Cons False (Cons True Nil))
all : {a : Type} -> (a -> Bool) -> Array a -> Bool
all p xs = not (any (\x -> not (p x)) xs)
