-- Arrays: a fixed number of elements, each reached at once by its index
-- (from 0).  An array is not changed: `set` makes another.  Import it by a
-- name, `import array as A`: `A.length`, `A.index`, as `length` and `map`
-- are the prelude's lists' too.

import prelude

foreign import arrayLength :: {a :: Type} -> Array a -> Int
foreign import arrayIndex :: {a :: Type} -> Array a -> Int -> a
foreign import arraySet :: {a :: Type} -> Array a -> Int -> a -> Array a
foreign import arrayGenerate :: {a :: Type} -> Int -> (Int -> a) -> Array a
foreign import arrayFromList :: {a :: Type} -> List a -> Array a
foreign import arrayToList :: {a :: Type} -> Array a -> List a

length :: {a :: Type} -> Array a -> Int
length = arrayLength

-- | The element at `i`; out of range, `abandon`.
index :: {a :: Type} -> Array a -> Int -> a
index = arrayIndex

-- | The element at `i`, if there is one.
at :: {a :: Type} -> Array a -> Int -> Maybe a
at xs i =
  if 0 <= i && i < arrayLength xs then Just (arrayIndex xs i) else Nothing

-- | Another array, with `x` at `i` (a copy); out of range, `abandon`.
set :: {a :: Type} -> Array a -> Int -> a -> Array a
set = arraySet

-- | `n` elements, the one at `i` being `f i`.
generate :: {a :: Type} -> Int -> (Int -> a) -> Array a
generate = arrayGenerate

fromList :: {a :: Type} -> List a -> Array a
fromList = arrayFromList

toList :: {a :: Type} -> Array a -> List a
toList = arrayToList

empty :: {a :: Type} -> Array a
empty = arrayGenerate 0 (\_ -> abandon)

map :: {a b :: Type} -> (a -> b) -> Array a -> Array b
map f xs = arrayGenerate (arrayLength xs) (\i -> f (arrayIndex xs i))

-- (from the element at `i` on)
foldlFrom :: {a b :: Type} -> (b -> a -> b) -> Int -> b -> Array a -> b
foldlFrom f i acc xs =
  if i < arrayLength xs
    then foldlFrom f (i + 1) (f acc (arrayIndex xs i)) xs
    else acc

-- | The elements, from the first, into `z`.
foldl :: {a b :: Type} -> (b -> a -> b) -> b -> Array a -> b
foldl f z xs = foldlFrom f 0 z xs
