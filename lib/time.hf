-- Time as an effect (lib/co.hf): waiting.  `heff node` has a handler for
-- it.  (dom has a `sleep` too: import one of them `as`.)

import co
import prelude

data TimeF (m : Type -> Type) x = Sleep Int x

-- | Time as an effect.
time : HFunctor
time =
  { f = TimeF
  , hfmap = \fm g p -> case p of
      Sleep ms x -> Sleep ms (g x)
  , hmap = \nt p -> case p of
      Sleep ms x -> Sleep ms x
  }

-- | Wait: the rest runs when the time has passed, in any effect the
-- | time is in, by the evidence.
sleep : {e : HFunctor} -> {{ev : time <: e}} -> Int -> Co e Unit
sleep ms = op (ev (Sleep ms MkUnit)) val
