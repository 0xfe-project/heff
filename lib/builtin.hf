-- The types the language answers with itself: every other module
-- imports this one without writing it.

module builtin
  ( Bool(..)
  , Unit(..)
  , List(..)
  , Lazy
  , force
  , int8Eq
  , int16Eq
  , int32Eq
  , int64Eq
  , uint8Eq
  , uint16Eq
  , uint32Eq
  , uint64Eq
  , float32Eq
  , runeEq
  )

-- | what a comparison answers, and what `if`, `&&` and `||` take
data Bool = True | False

-- | what a thunk is forced with
data Unit = MkUnit

-- | what `[a, b]` is, and what an array is made from and turned into
data List a = Nil | Cons a (List a)

-- | what `~A` is: an `A` computed only where it is forced, `force`, and
-- | once, kept for the next time; `~e` delays `e`.  Its tag is no one
-- | else's: a `Lazy` is made by `~e` alone
data Lazy a = MkLazy (Unit -> a)

-- (what `~e` is made by, given `\_ -> e`)
delay : {a : Type} -> (Unit -> a) -> Lazy a
delay f = MkLazy f

-- | the value, computed the first time it is forced and kept: where an
-- | `a` is expected, a `Lazy a` given is forced without saying so (the
-- | prelude's `Coe (Lazy a) a`)
force : {a : Type} -> Lazy a -> a
force (MkLazy f) = f MkUnit

-- (IEEE 754's double is the built-in type `Float64`, named by its width as
-- `Float32` is)

-- | the equalities of the fixed-width types: what a literal pattern of
-- | one is matched by (as one of an `Int` is by the prelude's `intEq`),
-- | and what their modules (int32 and the others) name
primitive int8Eq : Int8 -> Int8 -> Bool
primitive int16Eq : Int16 -> Int16 -> Bool
primitive int32Eq : Int32 -> Int32 -> Bool
primitive int64Eq : Int64 -> Int64 -> Bool
primitive uint8Eq : UInt8 -> UInt8 -> Bool
primitive uint16Eq : UInt16 -> UInt16 -> Bool
primitive uint32Eq : UInt32 -> UInt32 -> Bool
primitive uint64Eq : UInt64 -> UInt64 -> Bool
primitive float32Eq : Float32 -> Float32 -> Bool

-- | the equality of runes, by code point: what a rune literal pattern is
-- | matched by, and what rune names
primitive runeEq : Rune -> Rune -> Bool
