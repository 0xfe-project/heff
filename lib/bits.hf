-- `Bits`, the prelude's: a bitstring of any length, not changed once
-- made -- a type of its own beside `Bytes`, which are whole bytes.  A C
-- program keeps them as bytes and how many bits of them there are, a
-- JavaScript one as a `Uint8Array` whose `bits` is their length.  Import
-- it by a name, `import bits as Bits`, as its names are the prelude's
-- lists' too: `Bits.length`, `Bits.toBytes`.  A binary writes them,
-- `b[5::3]`, and takes them apart; their
-- equality, `instanceEqualityBits`, is the prelude's, as `==` is, and so
-- are their `Show`, `instanceShowBits`, which writes them as a binary
-- does, and their `ToString`, `instanceToStringBits`, which writes each
-- bit, `0` or `1`.

module bits

-- Read
--------------------------------------------------------------------------------

-- | How many bits.
-- | >>> length b[5::3, "a"]
-- | 11
length : Bits -> Int
length = bitsLength

-- | The bit at `i`, if there is one (`True` is 1): out of range,
-- | `Nothing`.
-- | >>> List.map (index b[5::3]) [0, 1, 2, 3]
-- | [Just True, Just False, Just True, Nothing]
index : Bits -> Int -> Maybe Bool
index b i =
  if 0 <= i && i < bitsLength b then Just (bitsIntAt b i 1 0 == 1)
  else Nothing

-- | Each bit, `True` where it is 1.
-- | >>> toList b[6::3]
-- | [True, True, False]
toList : Bits -> List Bool
toList b =
  List.map (\i -> bitsIntAt b i 1 0 == 1) (List.range 0 (bitsLength b - 1))

-- | Bits that are whole bytes, as `Bytes`: of a length that is no
-- | multiple of 8, `Nothing`.
-- | >>> toBytes b[1::4, 2::4, b[]::bits]
-- | Just b[18]
-- | >>> toBytes b[1::4]
-- | Nothing
toBytes : Bits -> Maybe Bytes
toBytes b = if bitsLength b % 8 == 0 then Just (bitsBytes b) else Nothing

-- Made
--------------------------------------------------------------------------------

-- | None.
-- | >>> length empty
-- | 0
empty : Bits
empty = bitsConcat Nil

-- | Bytes as bits, 8 to a byte.
-- | >>> ofBytes b["a"] == b[97::8, b[]::bits]
-- | True
ofBytes : Bytes -> Bits
ofBytes = bitsOfBytes

-- | A bit each, 1 where it is `True`.
-- | >>> fromList [True, False, True]
-- | b[5::3]
fromList : List Bool -> Bits
fromList bs =
  bitsConcat (List.map (\x -> bitsOfInt 1 0 (if x then 1 else 0)) bs)

-- | The integer `v`'s low `n` bits, 0 to 64, the most significant first,
-- | as `v::n` writes them: of another `n`, abandoned.
-- | >>> ofInt 3 13
-- | b[5::3]
ofInt : Int -> Int -> Bits
ofInt n v = bitsOfInt n 0 v

-- Taken apart and put together
--------------------------------------------------------------------------------

-- | The bits from `i` up to `j`, `j` not among them, each clamped to
-- | them.
-- | >>> List.map toString [slice (ofBytes b[0x5a]) 1 4, slice (ofBytes b[0x5a]) 6 20, slice (ofBytes b[0x5a]) 5 2]
-- | ["101", "10", ""]
slice : Bits -> Int -> Int -> Bits
slice b i j =
  bitsSlice
    b
    (clamp 0 (bitsLength b) i)
    (max 0 (clamp 0 (bitsLength b) j - clamp 0 (bitsLength b) i))
  where
  clamp : Int -> Int -> Int -> Int
  clamp lo hi x = if x < lo then lo else if x > hi then hi else x

-- | The bits of `a`, then those of `b`.
-- | >>> append b[1::1] b[2::2]
-- | b[6::3]
append : Bits -> Bits -> Bits
append a b = bitsConcat [a, b]

-- | Each one's bits, one after another, made at once.
-- | >>> concat [b[1::1], empty, b[1::2], ofBytes b[255]]
-- | b[191, 7::3]
concat : List Bits -> Bits
concat = bitsConcat

-- Compared
--------------------------------------------------------------------------------

-- | Whether they are the same bits, as `==` says (the prelude's
-- | `instanceEqualityBits`).
-- | >>> eq b[5::3] (fromList [True, False, True])
-- | True
eq : Bits -> Bits -> Bool
eq = bitsEq
