-- Scopes, as an effect of the world: what is acquired is released
-- however the scope is left -- at its end, by a throw of any type, or
-- because a handler between did not go on (it dropped the continuation
-- that would have left the scope).  A handler between cannot say so to
-- the world: its monad still goes on to the world's continuation (a
-- throw's `Left`), and a computation an operation of the world holds is
-- forwarded to it by a natural transformation, which has nothing for a
-- throw but `abandon`.  What is left of a scope a handler gave up on is
-- its continuation, dropped; so the world arms a token with the scope's
-- release, the continuation holds it, and the world releases where the
-- token's last reference goes while it is armed.  A `do` block's `try
-- ... finally` is `scoped`; a resource held in a scope is too.

import co

-- | What the world arms a scope with: the C provider's, a foreign value
-- | the scope's continuation holds.
data Armed

-- | A scope's token, given by `enter`, taken back by `leave`: armed by
-- | the C provider (`Held`), or numbered by a world handled in the
-- | language (`Numbered`, `endScopes`).
data Token = Numbered Int | Held Armed

-- | The operations: `Enter release` arms a token with `release`, run by
-- | the world should the token's last reference go before `Leave` of it
-- | disarms it.
data ScopeF (m : Type -> Type) x = Enter (m Unit) (Token -> x) | Leave Token x

-- | Scopes, as an effect.
scope : HFunctor
scope =
  { f = ScopeF
  , hfmap = \m g p -> case p of
      Enter r k -> Enter r (\t -> g (k t))
      Leave t x -> Leave t (g x)
  , hmap = \m n nt p -> case p of
      Enter r k -> Enter (nt r) k
      Leave t x -> Leave t x
  }

-- | A token armed with `release`: the world runs it should the token be
-- | dropped before it is left.  (`release`, an operation's computation,
-- | is forwarded to the world by each handler between, as any is: a
-- | throw of it heard by none there abandons.)
enter : {e : HFunctor} -> {{sc : scope <: e}} -> Co e Unit -> Co e Token
enter release = op (sc (Enter release (\t -> t))) val

-- | The token disarmed: the scope left, its release the program's own.
leave : {e : HFunctor} -> {{sc : scope <: e}} -> Token -> Co e Unit
leave t = op (sc (Leave t MkUnit)) val

-- | A scope: `acquire`, then `use` of what it gave, then `release` of
-- | that, however `use` ends.  At its end, the token disarmed, `release`
-- | runs as the program's (a throw of it goes on as any); left otherwise
-- | -- a throw of any type heard outside the scope, a handler between
-- | dropping the continuation -- the world runs it, where the
-- | continuation is dropped (the C backend's providers: at once, by the
-- | count; JavaScript's: when the collector finds it; a world handled in
-- | the language, `endScopes`: when it ends).  Scopes are released by
-- | nesting, the innermost first; an `abandon` ends the program, and no
-- | release runs.  A `do` block's `try ... finally f` is this, acquiring
-- | nothing and released by `f`; its jumps (`return`, `break`,
-- | `continue`) leave it as the scope's answer, what to do once it is
-- | left (co's `leaveScope`), so each scope between is released on the
-- | way, a tail call each.  A continuation taken in a scope and resumed
-- | more than once releases it each time it is left at its end; dropped
-- | by all before any leaves it so, by the world once.
scoped : {e : HFunctor}
       -> {r a : Type}
       -> {{sc : scope <: e}}
       -> Co e r
       -> (r -> Co e Unit)
       -> (r -> Co e a)
       -> Co e a
scoped acquire release use =
  bind
    acquire
    (\x ->
       bind
         (enter (release x))
         (\t ->
            bind
              (use x)
              (\v -> bind (leave t) (\_ -> bind (release x) (\_ -> pure v)))))

-- A world handled in the language
--------------------------------------------------------------------------------

-- (the scopes a world handled in the language holds armed: the next
-- token's number, and each armed one's number and release, the newest
-- first)
data Armory (e : HFunctor) = MkArmory Int (List (Pair Int (Co e Unit)))

-- (a scope's release, taken out where it is left)
disarmed : {e : HFunctor}
         -> Int
         -> List (Pair Int (Co e Unit))
         -> List (Pair Int (Co e Unit))
disarmed n Nil = Nil
disarmed n (Cons (MkPair m r) rest) =
  if n == m then rest else Cons (MkPair m r) (disarmed n rest)

tokenNumber : Token -> Int
tokenNumber (Numbered n) = n
tokenNumber (Held _) = 0 - 1

-- (the armory after a token is armed with `r`, and what comes of the
-- token)
armedWith : {e : HFunctor}
          -> {x : Type}
          -> Co e Unit
          -> (Token -> x)
          -> Armory e
          -> Pair (Armory e) x
armedWith r k (MkArmory n rs) =
  MkPair (MkArmory (n + 1) (Cons (MkPair n r) rs)) (k (Numbered n))

-- (... and disarmed)
leftOf : {e : HFunctor} -> Token -> Armory e -> Armory e
leftOf t (MkArmory n rs) = MkArmory n (disarmed (tokenNumber t) rs)

-- (the releases still armed, run, the newest first)
releasedAll : {e : HFunctor} -> List (Pair Int (Co e Unit)) -> Co e Unit
releasedAll Nil = pure MkUnit
releasedAll (Cons (MkPair _ r) rest) = bind r (\_ -> releasedAll rest)

-- (what a computation came to, the scopes it left unfinished released)
endedWith : {e : HFunctor} -> {a : Type} -> Pair (Armory e) a -> Co e a
endedWith (MkPair (MkArmory _ rs) x) = bind (releasedAll rs) (\_ -> pure x)

-- (a computation of the world, its armory threaded through, as a functor)
armoredFunctor : (e : HFunctor) -> RawFunctor
armoredFunctor e =
  { f = \x -> Armory e -> Co e (Pair (Armory e) x)
  , fmap = \g m s -> bind (m s) (\p -> val (MkPair (fst p) (g (snd p))))
  }

-- (what an operation of `scope` does to the armory)
armoryAlg : (e : HFunctor)
          -> {a : Type}
          -> ScopeF (\x -> Armory e -> Co e (Pair (Armory e) x)) a
          -> Armory e
          -> Co e (Pair (Armory e) a)
armoryAlg e (Enter r k) s = val (armedWith (bind (r s) (\_ -> pure MkUnit)) k s)
armoryAlg e (Leave t x) s = val (MkPair (leftOf t s) x)

-- | A handler of `scope` into the rest of the world, `e`, in the
-- | language: it cannot see a continuation dropped, so the scopes left
-- | unfinished are released when the computation ends, the newest first.
-- | A release, armed, is run with the armory as it was where it was armed.
scopesHandler : (e : HFunctor) -> Handler (plus scope e)
scopesHandler e =
  { M = \x -> Armory e -> Co e (Pair (Armory e) x)
  , ret = \x s -> val (MkPair s x)
  , bind = \m k s -> bind (m s) (\p -> k (snd p) (fst p))
  , malg = \p s -> case p of
      InL t -> armoryAlg e t s
      InR q ->
        op
          (e.hmap
             (armoredFunctor e)
             (coFunctor e)
             (\m -> bind (m s) (\p -> val (snd p)))
             q)
          (\x -> val (MkPair s x))
  }

-- | `c`, its scopes handled in the language: those left unfinished
-- | released as it ends, the newest first.
endScopes : (e : HFunctor) -> {a : Type} -> Co (plus scope e) a -> Co e a
endScopes e c =
  bind (handle (scopesHandler e) c (MkArmory 0 Nil)) (\p -> endedWith p)
