-- More of strings than the prelude's: what is replaced in one, what is
-- cut from either end, cases, padding, and integers and floats written
-- in other ways than `debug` writes them (another base, a fixed number
-- of places).  The prelude has the rest (`split`, `joinWith`, `trim`,
-- `indexOf`, `startsWith`, `parseInt`).  Import it by a name, `import
-- string as String`, as its names are common ones: `String.replace`,
-- `String.repeat` (the alias comes before the type, so `String` alone
-- still names the type).  As in the prelude, the string worked on comes
-- last: `String.replace "a" "b" s`.
--
-- Cases are ASCII's, as rune's `toUpper` has them; a width, a padding's,
-- is counted in runes, as rune's `count` counts them.

module string
  ( replace
  , repeat
  , cut
  , lastIndexOf
  , occurrences
  , trimPrefix
  , trimSuffix
  , trimStart
  , trimEnd
  , padStart
  , padEnd
  , toUpper
  , toLower
  , equalIgnoringCase
  , showIntBase
  , parseIntBase
  , showFixed
  )

import int as Int
import rune as Rune

-- Replaced and cut
--------------------------------------------------------------------------------

-- | `s` with each `old` in it, from the first, `new`, none of them
-- | overlapping (Go's `strings.ReplaceAll`); an empty `old`, `s` as it
-- | is.
-- | >>> replace "ab" "x" "abcabab"
-- | "xcxx"
-- | >>> replace "aa" "b" "aaa"
-- | "ba"
-- | >>> replace "" "x" "abc"
-- | "abc"
replace : String -> String -> String -> String
replace old new s = if strLength old == 0 then s else replacedFrom 0 ""
  where
  -- (`s` from `i` on, each `old` in it `new`, after `acc`)
  replacedFrom : Int -> String -> String
  replacedFrom i acc =
    let j : Int = strFind old s i
    in if j < 0 then acc ^ strSlice s i (strLength s)
    else replacedFrom (j + strLength old) (acc ^ strSlice s i j ^ new)

-- | `n` of `s`, one after another; fewer than none, none.
-- | >>> List.map (\n -> repeat n "ab") [3, 0, -1]
-- | Cons "ababab" (Cons "" (Cons "" Nil))
repeat : Int -> String -> String
repeat n s = onto n ""
  where
  -- (`k` more of `s` after `acc`)
  onto : Int -> String -> String
  onto k acc = if k <= 0 then acc else onto (k - 1) (acc ^ s)

-- | What is before the first `sep` in `s` and what is after it, if `sep`
-- | is in it (Go's `strings.Cut`).
-- | >>> cut "=" "key=value=more"
-- | Just (MkPair "key" "value=more")
-- | >>> cut "=" "key"
-- | Nothing
cut : String -> String -> Maybe (Pair String String)
cut sep s = case indexOf sep s 0 of
  Just j ->
    Just
      (MkPair (strSlice s 0 j) (strSlice s (j + strLength sep) (strLength s)))
  Nothing -> Nothing

-- | Where `needle` is last in `s`, if it is.
-- | >>> lastIndexOf "ab" "abcab"
-- | Just 3
-- | >>> lastIndexOf "" "abc"
-- | Just 3
-- | >>> lastIndexOf "x" "abc"
-- | Nothing
lastIndexOf : String -> String -> Maybe Int
lastIndexOf needle s = lastFrom 0 Nothing
  where
  -- (where `needle` is last in `s`, from `i` on, `found` where it was
  -- last found so far)
  lastFrom : Int -> Maybe Int -> Maybe Int
  lastFrom i found =
    let j : Int = strFind needle s i
    in if j < 0 then found else lastFrom (j + 1) (Just j)

-- | How many `needle`s are in `s`, none overlapping (Go's
-- | `strings.Count`): of an empty one, one more than its runes, as
-- | there is one before each and one at the end.
-- | >>> List.map (\n -> occurrences n "cheese") ["e", "ee", ""]
-- | Cons 3 (Cons 1 (Cons 7 Nil))
occurrences : String -> String -> Int
occurrences needle s =
  if strLength needle == 0 then Rune.count s + 1
  else countFrom 0 0
  where
  -- (how many `needle`s, none overlapping, are in `s` from `i` on, after
  -- `n`)
  countFrom : Int -> Int -> Int
  countFrom i n =
    let j : Int = strFind needle s i
    in if j < 0 then n else countFrom (j + strLength needle) (n + 1)

-- Either end
--------------------------------------------------------------------------------

-- | `s` without `prefix` at its start, if it is there; else as it is.
-- | >>> List.map (trimPrefix "--") ["--all", "-a"]
-- | Cons "all" (Cons "-a" Nil)
trimPrefix : String -> String -> String
trimPrefix prefix s =
  if startsWith prefix s then strSlice s (strLength prefix) (strLength s) else s

-- | `s` without `suffix` at its end, if it is there; else as it is.
-- | >>> trimSuffix ".hf" "main.hf"
-- | "main"
trimSuffix : String -> String -> String
trimSuffix suffix s =
  if endsWith suffix s then strSlice s 0 (strLength s - strLength suffix) else s

-- | Without the spaces at its start, as `trim` takes those at either
-- | end.
-- | >>> trimStart "  a b  "
-- | "a b  "
trimStart : String -> String
trimStart s = strSlice s (skipSpaces s 0 1) (strLength s)

-- | Without the spaces at its end.
-- | >>> trimEnd "  a b  "
-- | "  a b"
trimEnd : String -> String
trimEnd s = strSlice s 0 (skipSpaces s (strLength s - 1) (0 - 1) + 1)

-- | Of at least `width` runes: `fill` put before it as many times as it
-- | is short.
-- | >>> List.map (padStart 3 '0') ["7", "1234"]
-- | Cons "007" (Cons "1234" Nil)
padStart : Int -> Rune -> String -> String
padStart width fill s = repeat (width - Rune.count s) (fromRunes [fill]) ^ s

-- | Of at least `width` runes: `fill` put after it as many times as it is
-- | short.
-- | >>> padEnd 4 '.' "h\u{e9}"
-- | "h\u{e9}.."
padEnd : Int -> Rune -> String -> String
padEnd width fill s = s ^ repeat (width - Rune.count s) (fromRunes [fill])

-- Cases
--------------------------------------------------------------------------------

-- | Each of `a` to `z` in upper case, any other rune as it is.
-- | >>> toUpper "heff, \u{e9}!"
-- | "HEFF, \u{e9}!"
toUpper : String -> String
toUpper s = mapRunes Rune.toUpper s

-- | Each of `A` to `Z` in lower case, any other rune as it is.
-- | >>> toLower "HeFF"
-- | "heff"
toLower : String -> String
toLower s = mapRunes Rune.toLower s

-- | Whether they are the same but for the cases of `a` to `z`.
-- | >>> equalIgnoringCase "Heff" "hEFF" && not (equalIgnoringCase "heff" "hef")
-- | True
equalIgnoringCase : String -> String -> Bool
equalIgnoringCase a b = strEq (toLower a) (toLower b)

-- Integers in a base
--------------------------------------------------------------------------------

-- | `n` in `base`, from 2 to 36, its digits after 9 `a` to `z`, a `-`
-- | before it if it is below 0 (Go's `strconv.FormatInt`); of another
-- | base, in base 10.
-- | >>> List.map (\b -> showIntBase 255 b) [2, 16, 36, 1]
-- | Cons "11111111" (Cons "ff" (Cons "73" (Cons "255" Nil)))
-- | >>> showIntBase (-4096) (base := 16)
-- | "-1000"
showIntBase : Int -> (base : Int) -> String
showIntBase n base =
  if base < 2 || base > 36 then showInt n
  else if n == 0 then "0"
  else if n < 0 then "-" ^ digitsInto (0 - n) ""
  else digitsInto n ""
  where
  -- (the digit of `d`, from 0 to 35: `0` to `9`, then `a` to `z`)
  digitOf : Int -> String
  digitOf d = if d < 10 then byteString (48 + d) else byteString (87 + d)
  -- (the digits of `m`, above 0, in `base`, before `acc`)
  digitsInto : Int -> String -> String
  digitsInto m acc =
    if m == 0 then acc else digitsInto (m / base) (digitOf (m % base) ^ acc)

-- | The integer `s` is, whole, in `base`, from 2 to 36 -- digits of
-- | either case, perhaps a `-` before them, as `showIntBase` writes it;
-- | of another base, `Nothing`.
-- | >>> List.map (\s -> parseIntBase s 16) ["ff", "-FF", "", "-", "fg"]
-- | Cons (Just 255) (Cons (Just (-255)) (Cons Nothing (Cons Nothing (Cons Nothing Nil))))
-- | >>> parseIntBase "101" (base := 2)
-- | Just 5
parseIntBase : String -> (base : Int) -> Maybe Int
parseIntBase s base =
  if base < 2 || base > 36 || strLength s == 0 then Nothing
  else if startsWith "-" s
  then (if strLength s == 1 then Nothing
        else maybe Nothing (\n -> Just (0 - n)) (digitsFrom 1 0))
  else digitsFrom 0 0
  where
  -- (the value of the digit `c`, a byte, in any base up to 36, either
  -- case; 36 if it is none)
  digitValue : Int -> Int
  digitValue c =
    if 48 <= c && c <= 57 then c - 48
    else if 97 <= c && c <= 122 then c - 87
    else if 65 <= c && c <= 90 then c - 55
    else 36
  -- (the digits of `s` from `i` on, after `n` so far)
  digitsFrom : Int -> Int -> Maybe Int
  digitsFrom i n =
    if i >= strLength s then Just n
    else if digitValue (strByteAt s i) < base
    then digitsFrom (i + 1) (n * base + digitValue (strByteAt s i))
    else Nothing

-- Floats to a fixed number of places
--------------------------------------------------------------------------------

-- | `x` with `places` digits after its point (none, of fewer than
-- | none), exactly: the decimal of so many places nearest it, a tie to
-- | the even (Go's `strconv.FormatFloat(x, 'f', places, 64)`); a `-`
-- | before a negative one, even one that is 0 to so many places; of what
-- | is not finite, as `debug` writes it.
-- | >>> List.map (\x -> showFixed x 2) [3.14159, 2.5, -0.001, 1.0e21]
-- | Cons "3.14" (Cons "2.50" (Cons "-0.00" (Cons "1000000000000000000000.00" Nil)))
-- | >>> List.map (\p -> showFixed 0.125 p) [0, 1, 2, 3, -1]
-- | Cons "0" (Cons "0.1" (Cons "0.12" (Cons "0.125" (Cons "0" Nil))))
-- | >>> List.map (\x -> showFixed x (places := 1)) [0.05, 0.15, 0.25]
-- | Cons "0.1" (Cons "0.1" (Cons "0.2" Nil))
-- | >>> List.map (\x -> showFixed x 1) [1.0 /. 0.0, 0.0 /. 0.0]
-- | Cons "Infinity" (Cons "NaN" Nil)
showFixed : Float64 -> (places : Int) -> String
showFixed x places =
  let bits : Int = floatBits 64 x
  in let exponent : Int = and (shiftR bits 52) 2047
  in let fraction : Int = and bits (shiftL 1 52 - 1)
  in let sign : String = if and (shiftR bits 63) 1 == 1 then "-" else ""
  in let kept : Int = if places < 0 then 0 else places
  in let mantissa : Int =
    if exponent == 0 then fraction else fraction + shiftL 1 52
  in let power : Int = (if exponent == 0 then 1 else exponent) - 1075
  in if exponent == 2047 then debug x
  else if power >= 0
  then sign ^ pointed kept (shiftL mantissa power * powerOfTen kept)
  else sign
    ^ pointed
      kept
      (dividedHalfEven (mantissa * powerOfTen kept) (shiftL 1 (0 - power)))
  where
  -- (10 to the power `k`, `k` at least 0)
  powerOfTen : Int -> Int
  powerOfTen k = if k <= 0 then 1 else 10 * powerOfTen (k - 1)
  -- (`q` divided by `d`, above 0, rounded to the nearest, a tie to the
  -- even)
  dividedHalfEven : Int -> Int -> Int
  dividedHalfEven q d =
    let r : Int = q % d
    in if 2 * r > d || (2 * r == d && (q / d) % 2 == 1) then q / d + 1
    else q / d
  -- (`digits`, at least 0, as a decimal with `n` of them after its point)
  pointed : Int -> Int -> String
  pointed n digits =
    let shown : String = padStart (n + 1) '0' (showInt digits)
    in if n == 0 then shown
    else strSlice shown 0 (strLength shown - n)
      ^ "."
      ^ strSlice shown (strLength shown - n) (strLength shown)
