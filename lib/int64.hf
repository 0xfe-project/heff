-- `Int64`: the integers from -9223372036854775808 to 9223372036854775807, wrapping around as the
-- machine's do (two's complement): `fromInt 9223372036854775808` is -9223372036854775808.  A literal checked at `Int64` is one (`(7 : Int64)`).
-- Import it by a name, `import int64 as I64`, as its names are the
-- prelude's: `I64.add`, `I64.fromInt`.  Its operators, `+` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  (Another fixed-width type's value from one goes by way of an
-- `Int`: `toInt`, then the other's `fromInt`.)

foreign import int64Add : Int64 -> Int64 -> Int64
foreign import int64Sub : Int64 -> Int64 -> Int64
foreign import int64Mul : Int64 -> Int64 -> Int64
foreign import int64Div : Int64 -> Int64 -> Int64
foreign import int64Rem : Int64 -> Int64 -> Int64
foreign import int64Lt : Int64 -> Int64 -> Bool
foreign import int64Le : Int64 -> Int64 -> Bool
foreign import int64And : Int64 -> Int64 -> Int64
foreign import int64Or : Int64 -> Int64 -> Int64
foreign import int64Xor : Int64 -> Int64 -> Int64
foreign import int64Shl : Int64 -> Int64 -> Int64
foreign import int64Shr : Int64 -> Int64 -> Int64
foreign import int64Show : Int64 -> String
foreign import int64FromInt : Int -> Int64
foreign import int64ToInt : Int64 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int64
minBound = -9223372036854775808

-- | The greatest.
maxBound : Int64
maxBound = 9223372036854775807

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int64 -> Int64 -> Int64
add = int64Add

sub : Int64 -> Int64 -> Int64
sub = int64Sub

mul : Int64 -> Int64 -> Int64
mul = int64Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | `abandon`.
div : Int64 -> Int64 -> Int64
div = int64Div

-- | The remainder of `div`, of the sign of the dividend; by 0, `abandon`.
rem : Int64 -> Int64 -> Int64
rem = int64Rem

neg : Int64 -> Int64
neg x = int64Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int64 -> Int64 -> Bool
eq = int64Eq

lt : Int64 -> Int64 -> Bool
lt = int64Lt

le : Int64 -> Int64 -> Bool
le = int64Le

compare : Int64 -> Int64 -> Ordering
compare a b = if int64Lt a b then LT else if int64Eq a b then EQ else GT

min : Int64 -> Int64 -> Int64
min a b = if int64Le a b then a else b

max : Int64 -> Int64 -> Int64
max a b = if int64Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int64 -> Int64 -> Int64
and = int64And

-- | The bits set in either.
or : Int64 -> Int64 -> Int64
or = int64Or

-- | The bits set in one of the two.
xor : Int64 -> Int64 -> Int64
xor = int64Xor

-- | Every bit flipped.
complement : Int64 -> Int64
complement x = int64Xor x -1

-- | Shifted left by the second (modulo 64), the bits shifted out lost.
shiftL : Int64 -> Int64 -> Int64
shiftL = int64Shl

-- | Shifted right by the second (modulo 64), the sign copied in.
shiftR : Int64 -> Int64 -> Int64
shiftR = int64Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int64` an integer wraps around to: equal to it modulo 2^64.
fromInt : Int -> Int64
fromInt = int64FromInt

toInt : Int64 -> Int
toInt = int64ToInt

show : Int64 -> String
show = int64Show

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=
infixl + - above == /= < <= > >=
infixl * / % above + -

(+) : Int64 -> Int64 -> Int64
(+) = int64Add

(-) : Int64 -> Int64 -> Int64
(-) = int64Sub

(*) : Int64 -> Int64 -> Int64
(*) = int64Mul

(/) : Int64 -> Int64 -> Int64
(/) = int64Div

(%) : Int64 -> Int64 -> Int64
(%) = int64Rem

(==) : Int64 -> Int64 -> Bool
(==) = int64Eq

(/=) : Int64 -> Int64 -> Bool
(/=) a b = not (int64Eq a b)

(<) : Int64 -> Int64 -> Bool
(<) = int64Lt

(<=) : Int64 -> Int64 -> Bool
(<=) = int64Le

(>) : Int64 -> Int64 -> Bool
(>) a b = int64Lt b a

(>=) : Int64 -> Int64 -> Bool
(>=) a b = int64Le b a
