-- `Int64`: the integers from -9223372036854775808 to 9223372036854775807, wrapping around as the
-- machine's do (two's complement): `fromInt 9223372036854775808` is -9223372036854775808.  A literal checked at `Int64` is one (`(7 : Int64)`).
-- Import it by a name, `import int64 as Int64`, as the other fixed-width
-- types' modules have the same names: `Int64.fromInt`, `Int64.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `Int64`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

primitive int64Add : Int64 -> Int64 -> Int64
primitive int64Sub : Int64 -> Int64 -> Int64
primitive int64Mul : Int64 -> Int64 -> Int64
primitive int64Div : Int64 -> Int64 -> Int64
primitive int64Rem : Int64 -> Int64 -> Int64
primitive int64Lt : Int64 -> Int64 -> Bool
primitive int64Le : Int64 -> Int64 -> Bool
primitive int64And : Int64 -> Int64 -> Int64
primitive int64Or : Int64 -> Int64 -> Int64
primitive int64Xor : Int64 -> Int64 -> Int64
primitive int64Shl : Int64 -> Int64 -> Int64
primitive int64Shr : Int64 -> Int64 -> Int64
primitive int64Show : Int64 -> String
primitive int64FromInt : Int -> Int64
primitive int64ToInt : Int64 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int64
minBound = -9223372036854775808

-- | The greatest.
maxBound : Int64
maxBound = 9223372036854775807

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int64 -> Int64 -> Int64
add = int64Add

sub : Int64 -> Int64 -> Int64
sub = int64Sub

mul : Int64 -> Int64 -> Int64
mul = int64Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int64 -> Int64 -> Int64
div = int64Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int64 -> Int64 -> Int64
rem = int64Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : Int64 -> Int64 -> Bool
eq = int64Eq

lt : Int64 -> Int64 -> Bool
lt = int64Lt

le : Int64 -> Int64 -> Bool
le = int64Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int64` an integer wraps around to: equal to it modulo 2^64.
fromInt : Int -> Int64
fromInt = int64FromInt

toInt : Int64 -> Int
toInt = int64ToInt

-- Instances: the prelude's operators and functions at `Int64`
--------------------------------------------------------------------------------

instance equalityInt64 : Equality Int64
equalityInt64 = { equal = int64Eq }

-- | >>> show (7 : Int64)
-- | "7"
instance showInt64 : Show Int64
showInt64 = { show = int64Show }

-- | As `show` writes it.
instance toStringInt64 : ToString Int64
toStringInt64 = { toString = int64Show }

instance orderInt64 : Order Int64
orderInt64 =
  { compare = \a b -> if int64Lt a b then LT else if int64Eq a b then EQ else GT
  , lt = int64Lt
  , le = int64Le
  }

instance additionInt64 : Addition Int64
additionInt64 = { add = int64Add }

instance subtractionInt64 : Subtraction Int64
subtractionInt64 = { sub = int64Sub }

instance multiplicationInt64 : Multiplication Int64
multiplicationInt64 = { mul = int64Mul }

-- | >>> List.map show ([7 / 2, -7 / 2, 7 / 0, minBound / -1] : List Int64)
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-9223372036854775808" Nil)))
instance divisionInt64 : Division Int64
divisionInt64 = { div = int64Div }

-- | >>> List.map show ([7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0] : List Int64)
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance remainderInt64 : Remainder Int64
remainderInt64 = { mod = int64Rem }

-- | The integer of the other sign, wrapped around: of `minBound`, itself.
instance negationInt64 : Negation Int64
negationInt64 = { neg = \x -> int64Sub 0 x }

instance isZeroInt64 : IsZero Int64
isZeroInt64 = { isZero = \x -> int64Eq x 0 }

-- | The bits, as two's complement has them: shifted left by the second
-- | (modulo 64), the bits shifted out lost, and right, the sign copied in;
-- | by a negative second, the other way (`shiftL x -n` is `shiftR x n`).
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : Int64)
-- | "25"
instance bitwiseInt64 : Bitwise Int64
bitwiseInt64 =
  { and = int64And
  , or = int64Or
  , xor = int64Xor
  , complement = \x -> int64Xor x -1
  , shiftL = int64Shl
  , shiftR = int64Shr
  }
