-- `Int64`: the integers from -9223372036854775808 to 9223372036854775807, wrapping around as the
-- machine's do (two's complement): `fromInt 9223372036854775808` is -9223372036854775808.  A literal checked at `Int64` is one (`(7 : Int64)`).
-- Import it by a name, `import int64 as I64`, as its names are the
-- prelude's: `I64.add`, `I64.fromInt`.  Its instances are the prelude's
-- operators' at `Int64`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive int64Add : Int64 -> Int64 -> Int64
primitive int64Sub : Int64 -> Int64 -> Int64
primitive int64Mul : Int64 -> Int64 -> Int64
primitive int64Div : Int64 -> Int64 -> Int64
primitive int64Rem : Int64 -> Int64 -> Int64
primitive int64Lt : Int64 -> Int64 -> Bool
primitive int64Le : Int64 -> Int64 -> Bool
primitive int64And : Int64 -> Int64 -> Int64
primitive int64Or : Int64 -> Int64 -> Int64
primitive int64Xor : Int64 -> Int64 -> Int64
primitive int64Shl : Int64 -> Int64 -> Int64
primitive int64Shr : Int64 -> Int64 -> Int64
primitive int64Show : Int64 -> String
primitive int64FromInt : Int -> Int64
primitive int64ToInt : Int64 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : Int64
minBound = -9223372036854775808

-- | The greatest.
maxBound : Int64
maxBound = 9223372036854775807

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : Int64 -> Int64 -> Int64
add = int64Add

sub : Int64 -> Int64 -> Int64
sub = int64Sub

mul : Int64 -> Int64 -> Int64
mul = int64Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.  By -1 it is a negation, wrapping around: of `minBound`, itself.
div : Int64 -> Int64 -> Int64
div = int64Div

-- | The remainder of `div`, of the sign of the dividend; by 0, the
-- | dividend, so that `add (mul (div x y) y) (rem x y)` is `x` whatever `y`
-- | is.
rem : Int64 -> Int64 -> Int64
rem = int64Rem

neg : Int64 -> Int64
neg x = int64Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : Int64 -> Int64 -> Bool
eq = int64Eq

lt : Int64 -> Int64 -> Bool
lt = int64Lt

le : Int64 -> Int64 -> Bool
le = int64Le

compare : Int64 -> Int64 -> Ordering
compare a b = if int64Lt a b then LT else if int64Eq a b then EQ else GT

min : Int64 -> Int64 -> Int64
min a b = if int64Le a b then a else b

max : Int64 -> Int64 -> Int64
max a b = if int64Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : Int64 -> Int64 -> Int64
and = int64And

-- | The bits set in either.
or : Int64 -> Int64 -> Int64
or = int64Or

-- | The bits set in one of the two.
xor : Int64 -> Int64 -> Int64
xor = int64Xor

-- | Every bit flipped.
complement : Int64 -> Int64
complement x = int64Xor x -1

-- | Shifted left by the second (modulo 64), the bits shifted out lost.
shiftL : Int64 -> Int64 -> Int64
shiftL = int64Shl

-- | Shifted right by the second (modulo 64), the sign copied in.
shiftR : Int64 -> Int64 -> Int64
shiftR = int64Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `Int64` an integer wraps around to: equal to it modulo 2^64.
fromInt : Int -> Int64
fromInt = int64FromInt

toInt : Int64 -> Int
toInt = int64ToInt

show : Int64 -> String
show = int64Show

-- Instances: the prelude's operators and functions at `Int64`
--------------------------------------------------------------------------------

instance eqInt64 : Eq Int64
eqInt64 = { equal = int64Eq }

instance ordInt64 : Ord Int64
ordInt64 = { compare = compare, lt = int64Lt, le = int64Le }

instance addInt64 : Add Int64
addInt64 = { add = int64Add }

instance subInt64 : Sub Int64
subInt64 = { sub = int64Sub }

instance mulInt64 : Mul Int64
mulInt64 = { mul = int64Mul }

-- | >>> List.map show [7 / 2, -7 / 2, 7 / 0, minBound / -1]
-- | Cons "3" (Cons "-3" (Cons "0" (Cons "-9223372036854775808" Nil)))
instance divInt64 : Div Int64
divInt64 = { div = int64Div }

-- | >>> List.map show [7 % 2, -7 % 2, 7 % 0, minBound % -1, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "-1" (Cons "7" (Cons "0" (Cons "7" Nil))))
instance modInt64 : Mod Int64
modInt64 = { mod = int64Rem }

instance negInt64 : Neg Int64
negInt64 = { neg = neg }

instance zeroInt64 : HasZero Int64
zeroInt64 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsInt64 : Bits Int64
bitsInt64 =
  { and = int64And
  , or = int64Or
  , xor = int64Xor
  , complement = complement
  , shiftL = int64Shl
  , shiftR = int64Shr
  }
