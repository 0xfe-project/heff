-- The DOM world as an effect (lib/co.hf): its operations, and handlers --
-- the JavaScript one of `heff app`, or one written here, for tests.  An app is
-- a computation with the
-- DOM's effect and a state's (lib/state.hf), as one:
-- `Co (dom <+> (state s)) Unit`.

import co
import prelude
import state

-- | An element of the page.  (A number the page's handler gives it: an app
-- | only gets nodes from the operations -- it makes them, or finds them on
-- | the page, `select` and `xpath`: where it goes on the page is the app's
-- | to say.)
data Node = MkNode Int

-- the operations: each takes what it needs, and says what it gives back by
-- a function to the rest (`x`); `On` takes a computation, run at each event
data DomF (m : Type -> Type) x
  = Create String (Node -> x)
  | Text Node String x
  | Attr Node String String x
  | Append Node Node x
  | Clear Node x
  | Value Node (String -> x)
  | On Node String (String -> m Unit) x
  | Select String (Maybe Node -> x)
  | XPath String (Maybe Node -> x)
  | Sleep Int x
  | Fetch String (String -> x)

-- | The DOM as an effect.
dom : HFunctor
dom =
  { f = DomF
  , hfmap = \fm g p -> case p of
      Create t k -> Create t (\n -> g (k n))
      Text n str x -> Text n str (g x)
      Attr n a v x -> Attr n a v (g x)
      Append p c x -> Append p c (g x)
      Clear n x -> Clear n (g x)
      Value n k -> Value n (\v -> g (k v))
      On n e h x -> On n e h (g x)
      Select q k -> Select q (\n -> g (k n))
      XPath q k -> XPath q (\n -> g (k n))
      Sleep ms x -> Sleep ms (g x)
      Fetch url k -> Fetch url (\t -> g (k t))
  , hmap = \nt p -> case p of
      Create t k -> Create t k
      Text n str x -> Text n str x
      Attr n a v x -> Attr n a v x
      Append p c x -> Append p c x
      Clear n x -> Clear n x
      Value n k -> Value n k
      On n e h x -> On n e (\v -> nt (h v)) x
      Select q k -> Select q k
      XPath q k -> XPath q k
      Sleep ms x -> Sleep ms x
      Fetch url k -> Fetch url k
  }

create : {s : Type} -> String -> Co (dom <+> (state s)) Node
create tag = op (InL (Create tag (\n -> n))) val

text : {s : Type} -> Node -> String -> Co (dom <+> (state s)) Unit
text n str = op (InL (Text n str MkUnit)) val

attr : {s : Type} -> Node -> String -> String -> Co (dom <+> (state s)) Unit
attr n a v = op (InL (Attr n a v MkUnit)) val

append : {s : Type} -> Node -> Node -> Co (dom <+> (state s)) Unit
append parent child = op (InL (Append parent child MkUnit)) val

clear : {s : Type} -> Node -> Co (dom <+> (state s)) Unit
clear n = op (InL (Clear n MkUnit)) val

value : {s : Type} -> Node -> Co (dom <+> (state s)) String
value n = op (InL (Value n (\v -> v))) val

on : {s : Type}
   -> Node
   -> String
   -> (String -> Co (dom <+> (state s)) Unit)
   -> Co (dom <+> (state s)) Unit
on n event h = op (InL (On n event h MkUnit)) val

-- | The first element of the page a CSS selector matches (`#out`,
-- | `ul > li.done`), if one does.
select : {s : Type} -> String -> Co (dom <+> (state s)) (Maybe Node)
select q = op (InL (Select q (\n -> n))) val

-- | The first element of the page an XPath matches
-- | (`//button[text()='Go']`), if one does.
xpath : {s : Type} -> String -> Co (dom <+> (state s)) (Maybe Node)
xpath q = op (InL (XPath q (\n -> n))) val

-- | Go on with an element, if it was found.
found : {s : Type}
      -> Maybe Node
      -> (Node -> Co (dom <+> (state s)) Unit)
      -> Co (dom <+> (state s)) Unit
found Nothing _ = pure MkUnit
found (Just n) k = k n

-- | The app's state, among the page's effects: the evidence an app
-- | passes to state.hf's `get` and `put`.
onState : {s : Type} -> (state s <: (dom <+> state s))
onState = \{s} -> inr dom (state s)

-- (asynchronous, in the page: the rest runs when it is done)
-- | Wait: in the page, the rest runs when the time has passed.
sleep : {s : Type} -> Int -> Co (dom <+> (state s)) Unit
sleep ms = op (InL (Sleep ms MkUnit)) val

fetchText : {s : Type} -> String -> Co (dom <+> (state s)) String
fetchText url = op (InL (Fetch url (\t -> t))) val

-- an element with some text in it, put in a parent
textIn : {s : Type} -> Node -> String -> String -> Co (dom <+> (state s)) Node
textIn parent tag str = do
  n <- create tag
  text n str
  append parent n
  pure n
