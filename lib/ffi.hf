-- C's types as values, and an effect's operations that C functions do:
-- a description, which the compiler reads where it compiles the
-- program for C, and makes the provider's side of -- how an operation's
-- fields are given to the function, what its result is made into, and
-- the dispatch -- in place of the same written by hand in the module's
-- `M.provider.c`.  The C compiler is given, with the glue, the types
-- described, held to the function's own as its header declares it: a
-- function described as taking an `int` where it takes a `size_t` does
-- not build.
--
-- This is how a module gives the program the host's types -- what a
-- `FILE *` is to it, with what lets it go -- and nothing more: an
-- operation stays an effect's, done when a handler handles it; the
-- program itself never calls C.  A function of no effect (libm's `sin`,
-- a hash) is a primitive of the runtime's or the library's, not
-- described here: C cannot be trusted to say it is pure.
--
-- A description is a definition of type `Described` in the effect's
-- module (`std.time`'s `timeInC`), of the operations C does: each a
-- constructor's name, and the function, with its C type as values of
-- `CType`, as Racket's ffi has them.  An operation `Op a b (r -> x)`
-- described `fun "f" [ta, tb] (Gives tr)` is `f(a, b)`, its result
-- made an `r` as `tr` says; one whose last field is `x` itself gives
-- `void`.  What the module's `M.provider.c` does by hand is still its
-- own: its `heff_provider_M` hands an operation it does not do to
-- `heff_described_M`, the glue; a module all of whose operations are
-- described needs no `M.provider.c`.  In JavaScript a description means
-- nothing: the module's `M.provider.js` is the whole of the effect there.

-- | A C type, by what crosses as it:
-- |
-- | - `CInteger "int"`, an integer type by its C name (`int`, `int64_t`,
-- |   `size_t`, `mode_t`: a typedef's name, so that its width is the
-- |   system's, not guessed), of an `Int`;
-- | - `CDouble`, a `Float64`; `CBool`, a `Bool` (C's `bool`);
-- | - `CString`, `const char *`: a `String`'s bytes, a NUL after them (a
-- |   path, content); `CText`, the same made valid UTF-8 (a name);
-- |   `COwnedString`, a result only: a `char *` malloc'd by C, copied and
-- |   freed;
-- | - `CPointer "FILE" "fclose"`, a pointer to the named type (`FILE *`),
-- |   held by the program as a foreign value of whatever type the
-- |   operation says (a `data` of no constructors), and let go of by the
-- |   named function when the program drops its last reference;
-- | - `CSharedPointer "HeffChan" "heff_chan_drop" "heff_chan_hold"`, the
-- |   same, for a thing that crosses places (std.place's channels): the
-- |   type, what lets it go, and what holds it once more -- called as it
-- |   crosses to a place, which then holds it as its own, each place
-- |   letting it go as it drops its last reference, the last to do so
-- |   freeing it.  (In JavaScript there are no places, and a description
-- |   means nothing there anyway: the share is nothing.)
-- | - `CVoid`, a result only: `Unit`.
data CType
  = CInteger String
  | CDouble
  | CBool
  | CString
  | CText
  | COwnedString
  | CPointer String String
  | CSharedPointer String String String
  | CVoid

-- | What a function's result is made into:
-- |
-- | - `Gives t`, the result as the operation's answer (of `CVoid`, the
-- |   operation's `x` itself, or `MkUnit` to its function);
-- | - `GivesOrErrno t`, `Either Errno a`: the system's way of failing,
-- |   `-1` of an integer or `NULL` of a string or a pointer with `errno`
-- |   set, `Left` of it, else `Right` the result;
-- | - `DoneOrErrno`, `Either Errno Unit`: an `int`, 0 or `-1` with
-- |   `errno`.
data CResult = Gives CType | GivesOrErrno CType | DoneOrErrno

-- | Why a call of the system failed: errno, its name (`ENOENT`,
-- | `EACCES`; the same on every system, where the number is not), and
-- | what the system says of it.  (std.filesystem's `FileError` is one.)
type Errno = { code : Int, name : String, message : String }

-- | A C function: its name, as the header the module includes declares
-- | it (or as the module's `M.provider.c` defines it), what it takes,
-- | and what it gives.
type Function = { name : String, args : List CType, result : CResult }

-- | An operation done by a C function: the constructor's name, and the
-- | function, which is given the operation's fields but its last, in
-- | order.
type Operation = { op : String, fun : Function }

-- | An effect's operations in C: the headers the functions are declared
-- | in (`"<stdio.h>"`, as written after `#include`; none for a function
-- | of `M.provider.c`), and the operations.
data Described = Describe (List String) (List Operation)

-- | `int`.
int : CType
int = CInteger "int"

-- | `int64_t`.
int64 : CType
int64 = CInteger "int64_t"

-- | `long`.
long : CType
long = CInteger "long"

-- | `size_t`.
size : CType
size = CInteger "size_t"

-- | An integer type by its C name: `integer "mode_t"`.
integer : String -> CType
integer name = CInteger name

-- | `double`.
double : CType
double = CDouble

-- | `bool`.
bool : CType
bool = CBool

-- | `const char *`, a string's bytes.
string : CType
string = CString

-- | `const char *`, text.
text : CType
text = CText

-- | `char *` malloc'd by C, a result.
ownedString : CType
ownedString = COwnedString

-- | A pointer to the named type, let go of by the named function:
-- | `pointer "FILE" "fclose"`.
pointer : String -> String -> CType
pointer type_ release = CPointer type_ release

-- | A pointer to the named type that crosses places, let go of by the
-- | first named function, held once more by the second as it crosses:
-- | `sharedPointer "HeffChan" "heff_chan_drop" "heff_chan_hold"`.
sharedPointer : String -> String -> String -> CType
sharedPointer type_ release share = CSharedPointer type_ release share

-- | `void`, a result.
void : CType
void = CVoid

-- | The result as the answer.
gives : CType -> CResult
gives t = Gives t

-- | The result, or `Left` errno where it is `-1` or `NULL`.
givesOrErrno : CType -> CResult
givesOrErrno t = GivesOrErrno t

-- | `Right MkUnit` of 0, `Left` errno otherwise.
doneOrErrno : CResult
doneOrErrno = DoneOrErrno

-- | A C function described.
-- | >>> (fun "chmod" [string, integer "mode_t"] doneOrErrno).name
-- | "chmod"
fun : String -> List CType -> CResult -> Function
fun name args result = { name = name, args = args, result = result }

-- | An operation done by a function.
-- | >>> (operation "Sleep" (fun "heff_sleep_ms" [int64] (gives void))).op
-- | "Sleep"
operation : String -> Function -> Operation
operation name f = { op = name, fun = f }

-- | The operations C does, with the headers their functions are declared
-- | in.
describe : List String -> List Operation -> Described
describe includes ops = Describe includes ops

-- | As a system's tools say it: the name, and what it is.
-- | >>> showErrno { code = 2, name = "ENOENT", message = "No such file or directory" }
-- | "ENOENT: No such file or directory"
showErrno : Errno -> String
showErrno err = err.name ^ ": " ^ err.message
