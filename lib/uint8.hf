-- `UInt8`: the integers from 0 to 255, wrapping around as the
-- machine's do: `fromInt 256` is 0, `fromInt (-1)` is 255.  A literal checked at `UInt8` is one (`(7 : UInt8)`).
-- Import it by a name, `import uint8 as U8`, as its names are the
-- prelude's: `U8.add`, `U8.fromInt`.  Its instances are the prelude's
-- operators' at `UInt8`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive uint8Add : UInt8 -> UInt8 -> UInt8
primitive uint8Sub : UInt8 -> UInt8 -> UInt8
primitive uint8Mul : UInt8 -> UInt8 -> UInt8
primitive uint8Div : UInt8 -> UInt8 -> UInt8
primitive uint8Rem : UInt8 -> UInt8 -> UInt8
primitive uint8Lt : UInt8 -> UInt8 -> Bool
primitive uint8Le : UInt8 -> UInt8 -> Bool
primitive uint8And : UInt8 -> UInt8 -> UInt8
primitive uint8Or : UInt8 -> UInt8 -> UInt8
primitive uint8Xor : UInt8 -> UInt8 -> UInt8
primitive uint8Shl : UInt8 -> UInt8 -> UInt8
primitive uint8Shr : UInt8 -> UInt8 -> UInt8
primitive uint8Show : UInt8 -> String
primitive uint8FromInt : Int -> UInt8
primitive uint8ToInt : UInt8 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt8
minBound = 0

-- | The greatest.
maxBound : UInt8
maxBound = 255

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt8 -> UInt8 -> UInt8
add = uint8Add

sub : UInt8 -> UInt8 -> UInt8
sub = uint8Sub

mul : UInt8 -> UInt8 -> UInt8
mul = uint8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt8 -> UInt8 -> UInt8
div = uint8Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt8 -> UInt8 -> UInt8
rem = uint8Rem

neg : UInt8 -> UInt8
neg x = uint8Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt8 -> UInt8 -> Bool
eq = uint8Eq

lt : UInt8 -> UInt8 -> Bool
lt = uint8Lt

le : UInt8 -> UInt8 -> Bool
le = uint8Le

compare : UInt8 -> UInt8 -> Ordering
compare a b = if uint8Lt a b then LT else if uint8Eq a b then EQ else GT

min : UInt8 -> UInt8 -> UInt8
min a b = if uint8Le a b then a else b

max : UInt8 -> UInt8 -> UInt8
max a b = if uint8Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt8 -> UInt8 -> UInt8
and = uint8And

-- | The bits set in either.
or : UInt8 -> UInt8 -> UInt8
or = uint8Or

-- | The bits set in one of the two.
xor : UInt8 -> UInt8 -> UInt8
xor = uint8Xor

-- | Every bit flipped.
complement : UInt8 -> UInt8
complement x = uint8Xor x 255

-- | Shifted left by the second (modulo 8), the bits shifted out lost.
shiftL : UInt8 -> UInt8 -> UInt8
shiftL = uint8Shl

-- | Shifted right by the second (modulo 8), zeros shifted in.
shiftR : UInt8 -> UInt8 -> UInt8
shiftR = uint8Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> UInt8
fromInt = uint8FromInt

toInt : UInt8 -> Int
toInt = uint8ToInt

show : UInt8 -> String
show = uint8Show

-- Instances: the prelude's operators and functions at `UInt8`
--------------------------------------------------------------------------------

instance eqUInt8 : Eq UInt8
eqUInt8 = { equal = uint8Eq }

instance ordUInt8 : Ord UInt8
ordUInt8 = { compare = compare, lt = uint8Lt, le = uint8Le }

instance addUInt8 : Add UInt8
addUInt8 = { add = uint8Add }

instance subUInt8 : Sub UInt8
subUInt8 = { sub = uint8Sub }

instance mulUInt8 : Mul UInt8
mulUInt8 = { mul = uint8Mul }

-- | >>> List.map show [7 / 2, 7 / 0]
-- | Cons "3" (Cons "0" Nil)
instance divUInt8 : Div UInt8
divUInt8 = { div = uint8Div }

-- | >>> List.map show [7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance modUInt8 : Mod UInt8
modUInt8 = { mod = uint8Rem }

instance negUInt8 : Neg UInt8
negUInt8 = { neg = neg }

instance zeroUInt8 : HasZero UInt8
zeroUInt8 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsUInt8 : Bits UInt8
bitsUInt8 =
  { and = uint8And
  , or = uint8Or
  , xor = uint8Xor
  , complement = complement
  , shiftL = uint8Shl
  , shiftR = uint8Shr
  }
