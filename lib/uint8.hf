-- `UInt8`: the integers from 0 to 255, wrapping around as the
-- machine's do: `fromInt 256` is 0, `fromInt (-1)` is 255.  A literal checked at `UInt8` is one (`(7 : UInt8)`).
-- Import it by a name, `import uint8 as U8`, as its names are the
-- prelude's: `U8.add`, `U8.fromInt`.  Its operators, `+` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  (Another fixed-width type's value from one goes by way of an
-- `Int`: `toInt`, then the other's `fromInt`.)

import prelude

foreign import uint8Add : UInt8 -> UInt8 -> UInt8
foreign import uint8Sub : UInt8 -> UInt8 -> UInt8
foreign import uint8Mul : UInt8 -> UInt8 -> UInt8
foreign import uint8Div : UInt8 -> UInt8 -> UInt8
foreign import uint8Rem : UInt8 -> UInt8 -> UInt8
foreign import uint8Eq : UInt8 -> UInt8 -> Bool
foreign import uint8Lt : UInt8 -> UInt8 -> Bool
foreign import uint8Le : UInt8 -> UInt8 -> Bool
foreign import uint8And : UInt8 -> UInt8 -> UInt8
foreign import uint8Or : UInt8 -> UInt8 -> UInt8
foreign import uint8Xor : UInt8 -> UInt8 -> UInt8
foreign import uint8Shl : UInt8 -> UInt8 -> UInt8
foreign import uint8Shr : UInt8 -> UInt8 -> UInt8
foreign import uint8Show : UInt8 -> String
foreign import uint8FromInt : Int -> UInt8
foreign import uint8ToInt : UInt8 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt8
minBound = 0

-- | The greatest.
maxBound : UInt8
maxBound = 255

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt8 -> UInt8 -> UInt8
add = uint8Add

sub : UInt8 -> UInt8 -> UInt8
sub = uint8Sub

mul : UInt8 -> UInt8 -> UInt8
mul = uint8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | `abandon`.
div : UInt8 -> UInt8 -> UInt8
div = uint8Div

-- | The remainder of `div`, of the sign of the dividend; by 0, `abandon`.
rem : UInt8 -> UInt8 -> UInt8
rem = uint8Rem

neg : UInt8 -> UInt8
neg x = uint8Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt8 -> UInt8 -> Bool
eq = uint8Eq

lt : UInt8 -> UInt8 -> Bool
lt = uint8Lt

le : UInt8 -> UInt8 -> Bool
le = uint8Le

compare : UInt8 -> UInt8 -> Ordering
compare a b = if uint8Lt a b then LT else if uint8Eq a b then EQ else GT

min : UInt8 -> UInt8 -> UInt8
min a b = if uint8Le a b then a else b

max : UInt8 -> UInt8 -> UInt8
max a b = if uint8Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt8 -> UInt8 -> UInt8
and = uint8And

-- | The bits set in either.
or : UInt8 -> UInt8 -> UInt8
or = uint8Or

-- | The bits set in one of the two.
xor : UInt8 -> UInt8 -> UInt8
xor = uint8Xor

-- | Every bit flipped.
complement : UInt8 -> UInt8
complement x = uint8Xor x 255

-- | Shifted left by the second (modulo 8), the bits shifted out lost.
shiftL : UInt8 -> UInt8 -> UInt8
shiftL = uint8Shl

-- | Shifted right by the second (modulo 8), zeros shifted in.
shiftR : UInt8 -> UInt8 -> UInt8
shiftR = uint8Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> UInt8
fromInt = uint8FromInt

toInt : UInt8 -> Int
toInt = uint8ToInt

show : UInt8 -> String
show = uint8Show

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=
infixl + - above == /= < <= > >=
infixl * / % above + -

(+) : UInt8 -> UInt8 -> UInt8
(+) = uint8Add

(-) : UInt8 -> UInt8 -> UInt8
(-) = uint8Sub

(*) : UInt8 -> UInt8 -> UInt8
(*) = uint8Mul

(/) : UInt8 -> UInt8 -> UInt8
(/) = uint8Div

(%) : UInt8 -> UInt8 -> UInt8
(%) = uint8Rem

(==) : UInt8 -> UInt8 -> Bool
(==) = uint8Eq

(/=) : UInt8 -> UInt8 -> Bool
(/=) a b = not (uint8Eq a b)

(<) : UInt8 -> UInt8 -> Bool
(<) = uint8Lt

(<=) : UInt8 -> UInt8 -> Bool
(<=) = uint8Le

(>) : UInt8 -> UInt8 -> Bool
(>) a b = uint8Lt b a

(>=) : UInt8 -> UInt8 -> Bool
(>=) a b = uint8Le b a
