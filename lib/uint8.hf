-- `UInt8`: the integers from 0 to 255, wrapping around as the
-- machine's do: `fromInt 256` is 0, `fromInt (-1)` is 255.  A literal checked at `UInt8` is one (`(7 : UInt8)`).
-- Import it by a name, `import uint8 as UInt8`, as the other fixed-width
-- types' modules have the same names: `UInt8.fromInt`, `UInt8.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `UInt8`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

module uint8

primitive uint8Add : UInt8 -> UInt8 -> UInt8
primitive uint8Sub : UInt8 -> UInt8 -> UInt8
primitive uint8Mul : UInt8 -> UInt8 -> UInt8
primitive uint8Div : UInt8 -> UInt8 -> UInt8
primitive uint8Rem : UInt8 -> UInt8 -> UInt8
primitive uint8Lt : UInt8 -> UInt8 -> Bool
primitive uint8Le : UInt8 -> UInt8 -> Bool
primitive uint8And : UInt8 -> UInt8 -> UInt8
primitive uint8Or : UInt8 -> UInt8 -> UInt8
primitive uint8Xor : UInt8 -> UInt8 -> UInt8
primitive uint8Shl : UInt8 -> UInt8 -> UInt8
primitive uint8Shr : UInt8 -> UInt8 -> UInt8
primitive uint8Show : UInt8 -> String

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt8
minBound = 0

-- | The greatest.
maxBound : UInt8
maxBound = 255

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt8 -> UInt8 -> UInt8
add = uint8Add

sub : UInt8 -> UInt8 -> UInt8
sub = uint8Sub

mul : UInt8 -> UInt8 -> UInt8
mul = uint8Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt8 -> UInt8 -> UInt8
div = uint8Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt8 -> UInt8 -> UInt8
rem = uint8Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt8 -> UInt8 -> Bool
eq = uint8Eq

lt : UInt8 -> UInt8 -> Bool
lt = uint8Lt

le : UInt8 -> UInt8 -> Bool
le = uint8Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt8` an integer wraps around to: equal to it modulo 2^8.
fromInt : Int -> UInt8
fromInt = uint8FromInt

toInt : UInt8 -> Int
toInt = uint8ToInt

-- Instances: the prelude's operators and functions at `UInt8`
--------------------------------------------------------------------------------

instance instanceEqualityUInt8 : Equality UInt8
instanceEqualityUInt8 = { equal = uint8Eq }

-- | >>> show (7 : UInt8)
-- | "7"
instance instanceShowUInt8 : Show UInt8
instanceShowUInt8 = { show = uint8Show }

-- | As `show` writes it.
instance instanceToStringUInt8 : ToString UInt8
instanceToStringUInt8 = { toString = uint8Show }

instance instanceOrderUInt8 : Order UInt8
instanceOrderUInt8 =
  { eq = instanceEqualityUInt8
  , compare = \a b -> if uint8Lt a b then LT else if uint8Eq a b then EQ else GT
  , lt = uint8Lt
  , le = uint8Le
  }

instance instanceAdditionUInt8 : Addition UInt8
instanceAdditionUInt8 = { add = uint8Add }

instance instanceSubtractionUInt8 : Subtraction UInt8
instanceSubtractionUInt8 = { sub = uint8Sub }

instance instanceMultiplicationUInt8 : Multiplication UInt8
instanceMultiplicationUInt8 = { mul = uint8Mul }

-- | >>> List.map show ([7 / 2, 7 / 0] : List UInt8)
-- | Cons "3" (Cons "0" Nil)
instance instanceDivisionUInt8 : Division UInt8
instanceDivisionUInt8 = { div = uint8Div }

-- | >>> List.map show ([7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0] : List UInt8)
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance instanceRemainderUInt8 : Remainder UInt8
instanceRemainderUInt8 = { mod = uint8Rem }

-- | What, added to it, wraps around to 0: of 1, `maxBound`.
instance instanceNegationUInt8 : Negation UInt8
instanceNegationUInt8 = { neg = \x -> uint8Sub 0 x }

instance instanceIsZeroUInt8 : IsZero UInt8
instanceIsZeroUInt8 = { isZero = \x -> uint8Eq x 0 }

-- | The bits: shifted left by the second (modulo 8), the bits shifted out
-- | lost, and right, zeros shifted in.
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : UInt8)
-- | "25"
instance instanceBitwiseUInt8 : Bitwise UInt8
instanceBitwiseUInt8 =
  { and = uint8And
  , or = uint8Or
  , xor = uint8Xor
  , complement = \x -> uint8Xor x 255
  , shiftL = uint8Shl
  , shiftR = uint8Shr
  }
