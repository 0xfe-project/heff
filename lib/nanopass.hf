-- Nanopass compilers, as handlers.  A compiler is many small passes, each
-- from one language to the next; this is how they are written in heff,
-- and the little that is the same for every compiler.
--
-- A language is a theory: its sorts, types, and its productions,
-- functions between them -- a handler of the language, an algebra:
--
--   theory Core where
--     E : Type                          -- expressions
--     P : Type                          -- patterns
--     lam : String -> E -> E
--     match : E -> P -> E -> E
--     ...
--
-- So a language has as many sorts as it says, each a type: expressions,
-- patterns, declarations, calling one another, with no data type to
-- declare for any of them.
--
-- A term of a language is what any handler of it gives a value for: a
-- term of `Core` is `(l : Core) -> l.E`, as a computation of `lib/co.hf`
-- is what any handler gives an answer for.
--
-- A language is another one with more productions by holding it, the
-- productions added beside it:
--
--   theory WithLet where
--     core : Core
--     letIn : String -> core.E -> core.E -> core.E
--
-- A pass is a handler: of its source language, whose sorts are terms of
-- its target.  What the two languages have in common is handed through
-- whole -- `core = l` -- and the pass says only what it changes:
--
--   removeLet : ((l : WithLet) -> l.core.E) -> ((l : Core) -> l.E)
--   removeLet t = \l -> t
--     { core = l
--     , letIn = \x e body -> l.app (l.lam x body) e
--     }
--
-- A production the target does not have is one the pass must say what
-- becomes of: no term of the target can use it, by its type.
--
-- A handler sees one layer: what each production is given, its parts as
-- the handler made them.  So what a pass needs of its parts is what its
-- sorts are:
--
-- * to know what a part is (`add (int 1) (int 2)`, to fold it), a sort
--   holds what the pass needs to know of it beside the term it becomes:
--   `E = { term : ..., asInt : Maybe Int }`;
-- * to know where it is (the names in scope), a sort is a function of
--   it: `E = Env -> ...`;
-- * to have an effect (a fresh name, an error), a sort is a computation:
--   `E = Co e (...)` -- `fresh` below, and any effect of `lib/co.hf`.  A
--   part is then bound in a `do` block, and its type is inferred only
--   later: what is asked of it is asked through a function, whose argument
--   says what it is (`test/surface/nanopass.hf`, `ltermOf`).
--
-- A term is a function: each handler given it computes it again, each
-- part as often as it occurs.  A term asked many things is made into what
-- a handler makes it, once, and that asked.
--
-- What is the same for every compiler is below: fresh names, and the
-- stages of a pipeline -- each pass's name and what it gives, to be shown
-- or not, by the handler.

import co
import prelude

-- Fresh names
--------------------------------------------------------------------------------

-- | The operation: a name, from a stem, not given before.
data FreshF (m : Type -> Type) x = Fresh String (String -> x)

fresh : HFunctor
fresh =
  { f = FreshF
  , hfmap = \fm g p -> case p of
      Fresh s k -> Fresh s (\n -> g (k n))
  , hmap = \nt p -> case p of
      Fresh s k -> Fresh s k
  }

-- | A name not given before, from `stem`: in any effect `fresh` is in, by
-- | the evidence.
freshName : {e : HFunctor} -> {{ev : fresh <: e}} -> String -> Co e String
freshName stem = op (ev (Fresh stem (\n -> n))) val

-- | Names, counted: `stem` and how many were given before it (`x%0`,
-- | `x%1`, ...: no name of a program has a `%`).
counting : Handler fresh
counting =
  { M = \a -> Int -> Pair a Int
  , ret = \x n -> MkPair x n
  , bind = \m k n -> case m n of
      MkPair x n2 -> k x n2
  , malg = \p n -> case p of
      Fresh stem k -> MkPair (k (stem ++ "%" ++ showInt n)) (n + 1)
  }

-- | A computation of fresh names, its value.
named : {a : Type} -> Co fresh a -> a
named c = fst (handle counting c 0)

-- Stages
--------------------------------------------------------------------------------

-- | The operation: a pass done, its name, and what it gave -- shown, when
-- | asked (a handler that does not ask shows nothing).
data StageF (m : Type -> Type) x = Stage String (Unit -> String) x

stages : HFunctor
stages =
  { f = StageF
  , hfmap = \fm g p -> case p of
      Stage s shown x -> Stage s shown (g x)
  , hmap = \nt p -> case p of
      Stage s shown x -> Stage s shown x
  }

-- | A stage done, what it gave as given (computed once: arguments are
-- | computed before they are passed).
done : {e : HFunctor}
     -> {b : Type}
     -> {{ev : stages <: e}}
     -> String
     -> (b -> String)
     -> b
     -> Co e b
done name show out =
  op (ev (Stage name (\_ -> show out) (MkUnit : Unit))) (\_ -> val out)

-- | A pass of a pipeline: `run` it on `input`, and say that it is done --
-- | its name, and how to show what it gave.
pass : {e : HFunctor}
     -> {a b : Type}
     -> {{ev : stages <: e}}
     -> String
     -> (b -> String)
     -> (a -> b)
     -> a
     -> Co e b
pass name show run input = done name show (run input)

-- | The stages, unasked: the pipeline's result alone.
quietly : Handler stages
quietly =
  { M = \a -> a
  , ret = \x -> x
  , bind = \m k -> k m
  , malg = \p -> case p of
      Stage s shown x -> x
  }

-- | Each stage's name, and what it gave, in order: then the result.
dumping : Handler stages
dumping =
  { M = \a -> Pair (List String) a
  , ret = \x -> MkPair Nil x
  , bind = \m k -> case m of
      MkPair d1 x -> case k x of
        MkPair d2 y -> MkPair (concatList d1 d2) y
  , malg = \p -> case p of
      Stage s shown x -> MkPair [s ++ ": " ++ shown MkUnit] x
  }
