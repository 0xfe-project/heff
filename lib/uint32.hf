-- `UInt32`: the integers from 0 to 4294967295, wrapping around as the
-- machine's do: `fromInt 4294967296` is 0, `fromInt (-1)` is 4294967295.  A literal checked at `UInt32` is one (`(7 : UInt32)`).
-- Import it by a name, `import uint32 as U32`, as the other fixed-width
-- types' modules have the same names: `U32.fromInt`, `U32.show`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `UInt32`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

primitive uint32Add : UInt32 -> UInt32 -> UInt32
primitive uint32Sub : UInt32 -> UInt32 -> UInt32
primitive uint32Mul : UInt32 -> UInt32 -> UInt32
primitive uint32Div : UInt32 -> UInt32 -> UInt32
primitive uint32Rem : UInt32 -> UInt32 -> UInt32
primitive uint32Lt : UInt32 -> UInt32 -> Bool
primitive uint32Le : UInt32 -> UInt32 -> Bool
primitive uint32And : UInt32 -> UInt32 -> UInt32
primitive uint32Or : UInt32 -> UInt32 -> UInt32
primitive uint32Xor : UInt32 -> UInt32 -> UInt32
primitive uint32Shl : UInt32 -> UInt32 -> UInt32
primitive uint32Shr : UInt32 -> UInt32 -> UInt32
primitive uint32Show : UInt32 -> String
primitive uint32FromInt : Int -> UInt32
primitive uint32ToInt : UInt32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt32
minBound = 0

-- | The greatest.
maxBound : UInt32
maxBound = 4294967295

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt32 -> UInt32 -> UInt32
add = uint32Add

sub : UInt32 -> UInt32 -> UInt32
sub = uint32Sub

mul : UInt32 -> UInt32 -> UInt32
mul = uint32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt32 -> UInt32 -> UInt32
div = uint32Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt32 -> UInt32 -> UInt32
rem = uint32Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt32 -> UInt32 -> Bool
eq = uint32Eq

lt : UInt32 -> UInt32 -> Bool
lt = uint32Lt

le : UInt32 -> UInt32 -> Bool
le = uint32Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> UInt32
fromInt = uint32FromInt

toInt : UInt32 -> Int
toInt = uint32ToInt

show : UInt32 -> String
show = uint32Show

-- Instances: the prelude's operators and functions at `UInt32`
--------------------------------------------------------------------------------

instance equalityUInt32 : Equality UInt32
equalityUInt32 = { equal = uint32Eq }

instance orderUInt32 : Order UInt32
orderUInt32 =
  { compare = \a b ->
        if uint32Lt a b then LT else if uint32Eq a b then EQ else GT
  , lt = uint32Lt
  , le = uint32Le
  }

instance additionUInt32 : Addition UInt32
additionUInt32 = { add = uint32Add }

instance subtractionUInt32 : Subtraction UInt32
subtractionUInt32 = { sub = uint32Sub }

instance multiplicationUInt32 : Multiplication UInt32
multiplicationUInt32 = { mul = uint32Mul }

-- | >>> List.map show [7 / 2, 7 / 0]
-- | Cons "3" (Cons "0" Nil)
instance divisionUInt32 : Division UInt32
divisionUInt32 = { div = uint32Div }

-- | >>> List.map show [7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance remainderUInt32 : Remainder UInt32
remainderUInt32 = { mod = uint32Rem }

-- | What, added to it, wraps around to 0: of 1, `maxBound`.
instance negationUInt32 : Negation UInt32
negationUInt32 = { neg = \x -> uint32Sub 0 x }

instance isZeroUInt32 : IsZero UInt32
isZeroUInt32 = { isZero = \x -> uint32Eq x 0 }

-- | The bits: shifted left by the second (modulo 32), the bits shifted out
-- | lost, and right, zeros shifted in.
-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitwiseUInt32 : Bitwise UInt32
bitwiseUInt32 =
  { and = uint32And
  , or = uint32Or
  , xor = uint32Xor
  , complement = \x -> uint32Xor x 4294967295
  , shiftL = uint32Shl
  , shiftR = uint32Shr
  }
