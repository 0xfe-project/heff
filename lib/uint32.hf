-- `UInt32`: the integers from 0 to 4294967295, wrapping around as the
-- machine's do: `fromInt 4294967296` is 0, `fromInt (-1)` is 4294967295.  A literal checked at `UInt32` is one (`(7 : UInt32)`).
-- Import it by a name, `import uint32 as U32`, as its names are the
-- prelude's: `U32.add`, `U32.fromInt`.  Its instances are the prelude's
-- operators' at `UInt32`, wherever it is imported, by a name or not: `x + 1`,
-- `x / y`, `-x`, `x < y`, `max x y`, `and x y`.  (Another fixed-width
-- type's value from one goes by way of an `Int`: `toInt`, then the
-- other's `fromInt`.)

primitive uint32Add : UInt32 -> UInt32 -> UInt32
primitive uint32Sub : UInt32 -> UInt32 -> UInt32
primitive uint32Mul : UInt32 -> UInt32 -> UInt32
primitive uint32Div : UInt32 -> UInt32 -> UInt32
primitive uint32Rem : UInt32 -> UInt32 -> UInt32
primitive uint32Lt : UInt32 -> UInt32 -> Bool
primitive uint32Le : UInt32 -> UInt32 -> Bool
primitive uint32And : UInt32 -> UInt32 -> UInt32
primitive uint32Or : UInt32 -> UInt32 -> UInt32
primitive uint32Xor : UInt32 -> UInt32 -> UInt32
primitive uint32Shl : UInt32 -> UInt32 -> UInt32
primitive uint32Shr : UInt32 -> UInt32 -> UInt32
primitive uint32Show : UInt32 -> String
primitive uint32FromInt : Int -> UInt32
primitive uint32ToInt : UInt32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt32
minBound = 0

-- | The greatest.
maxBound : UInt32
maxBound = 4294967295

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt32 -> UInt32 -> UInt32
add = uint32Add

sub : UInt32 -> UInt32 -> UInt32
sub = uint32Sub

mul : UInt32 -> UInt32 -> UInt32
mul = uint32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt32 -> UInt32 -> UInt32
div = uint32Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt32 -> UInt32 -> UInt32
rem = uint32Rem

neg : UInt32 -> UInt32
neg x = uint32Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt32 -> UInt32 -> Bool
eq = uint32Eq

lt : UInt32 -> UInt32 -> Bool
lt = uint32Lt

le : UInt32 -> UInt32 -> Bool
le = uint32Le

compare : UInt32 -> UInt32 -> Ordering
compare a b = if uint32Lt a b then LT else if uint32Eq a b then EQ else GT

min : UInt32 -> UInt32 -> UInt32
min a b = if uint32Le a b then a else b

max : UInt32 -> UInt32 -> UInt32
max a b = if uint32Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt32 -> UInt32 -> UInt32
and = uint32And

-- | The bits set in either.
or : UInt32 -> UInt32 -> UInt32
or = uint32Or

-- | The bits set in one of the two.
xor : UInt32 -> UInt32 -> UInt32
xor = uint32Xor

-- | Every bit flipped.
complement : UInt32 -> UInt32
complement x = uint32Xor x 4294967295

-- | Shifted left by the second (modulo 32), the bits shifted out lost.
shiftL : UInt32 -> UInt32 -> UInt32
shiftL = uint32Shl

-- | Shifted right by the second (modulo 32), zeros shifted in.
shiftR : UInt32 -> UInt32 -> UInt32
shiftR = uint32Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> UInt32
fromInt = uint32FromInt

toInt : UInt32 -> Int
toInt = uint32ToInt

show : UInt32 -> String
show = uint32Show

-- Instances: the prelude's operators and functions at `UInt32`
--------------------------------------------------------------------------------

instance eqUInt32 : Eq UInt32
eqUInt32 = { equal = uint32Eq }

instance ordUInt32 : Ord UInt32
ordUInt32 = { compare = compare, lt = uint32Lt, le = uint32Le }

instance addUInt32 : Add UInt32
addUInt32 = { add = uint32Add }

instance subUInt32 : Sub UInt32
subUInt32 = { sub = uint32Sub }

instance mulUInt32 : Mul UInt32
mulUInt32 = { mul = uint32Mul }

-- | >>> List.map show [7 / 2, 7 / 0]
-- | Cons "3" (Cons "0" Nil)
instance divUInt32 : Div UInt32
divUInt32 = { div = uint32Div }

-- | >>> List.map show [7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0]
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance modUInt32 : Mod UInt32
modUInt32 = { mod = uint32Rem }

instance negUInt32 : Neg UInt32
negUInt32 = { neg = neg }

instance zeroUInt32 : HasZero UInt32
zeroUInt32 = { zero = 0 }

-- | >>> show (and (shiftL 1 3 + 1) (complement 0) * 3 - 2)
-- | "25"
instance bitsUInt32 : Bits UInt32
bitsUInt32 =
  { and = uint32And
  , or = uint32Or
  , xor = uint32Xor
  , complement = complement
  , shiftL = uint32Shl
  , shiftR = uint32Shr
  }
