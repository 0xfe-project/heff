-- `UInt32`: the integers from 0 to 4294967295, wrapping around as the
-- machine's do: `fromInt 4294967296` is 0, `fromInt (-1)` is 4294967295.  A literal checked at `UInt32` is one (`(7 : UInt32)`).
-- Import it by a name, `import uint32 as UInt32`, as the other fixed-width
-- types' modules have the same names: `UInt32.fromInt`, `UInt32.minBound`.  None
-- of them is the prelude's: its instances are the prelude's operators
-- and functions at `UInt32`, wherever it is imported, by a name or not --
-- `x + 1`, `x / y`, `-x`, `x < y`, `max x y`, `and x y` -- so that,
-- opened, it is in the way of none of them at another type.  (Another
-- fixed-width type's value from one goes by way of an `Int`: `toInt`,
-- then the other's `fromInt`.)

module uint32

primitive uint32Add : UInt32 -> UInt32 -> UInt32
primitive uint32Sub : UInt32 -> UInt32 -> UInt32
primitive uint32Mul : UInt32 -> UInt32 -> UInt32
primitive uint32Div : UInt32 -> UInt32 -> UInt32
primitive uint32Rem : UInt32 -> UInt32 -> UInt32
primitive uint32Lt : UInt32 -> UInt32 -> Bool
primitive uint32Le : UInt32 -> UInt32 -> Bool
primitive uint32And : UInt32 -> UInt32 -> UInt32
primitive uint32Or : UInt32 -> UInt32 -> UInt32
primitive uint32Xor : UInt32 -> UInt32 -> UInt32
primitive uint32Shl : UInt32 -> UInt32 -> UInt32
primitive uint32Shr : UInt32 -> UInt32 -> UInt32
primitive uint32Show : UInt32 -> String
primitive uint32FromInt : Int -> UInt32
primitive uint32ToInt : UInt32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt32
minBound = 0

-- | The greatest.
maxBound : UInt32
maxBound = 4294967295

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt32 -> UInt32 -> UInt32
add = uint32Add

sub : UInt32 -> UInt32 -> UInt32
sub = uint32Sub

mul : UInt32 -> UInt32 -> UInt32
mul = uint32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | 0.
div : UInt32 -> UInt32 -> UInt32
div = uint32Div

-- | The remainder of `div`; by 0, the dividend, so that `add (mul (div x
-- | y) y) (rem x y)` is `x` whatever `y` is.
rem : UInt32 -> UInt32 -> UInt32
rem = uint32Rem

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt32 -> UInt32 -> Bool
eq = uint32Eq

lt : UInt32 -> UInt32 -> Bool
lt = uint32Lt

le : UInt32 -> UInt32 -> Bool
le = uint32Le

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> UInt32
fromInt = uint32FromInt

toInt : UInt32 -> Int
toInt = uint32ToInt

-- Bits
--------------------------------------------------------------------------------

-- | The bits turned left by `n`, modulo 32: those shifted out at the top
-- | come in at the bottom, as Go's `bits.RotateLeft32` turns them; by a
-- | negative `n`, right.
-- | >>> List.map (\n -> toInt (rotateLeft 2147483649 n : UInt32)) [1, -1, 32]
-- | Cons 3 (Cons 3221225472 (Cons 2147483649 Nil))
rotateLeft : UInt32 -> Int -> UInt32
rotateLeft x n =
  let k : Int = n % 32
  in uint32Or
    (uint32Shl x (uint32FromInt k))
    (uint32Shr x (uint32FromInt (32 - k)))

-- | The bits turned right by `n`: `rotateLeft x (-n)`.
-- | >>> toInt (rotateRight 3 1 : UInt32)
-- | 2147483649
rotateRight : UInt32 -> Int -> UInt32
rotateRight x n = rotateLeft x (0 - n)

-- | How many of its bits are 1.
-- | >>> List.map (\x -> popCount (x : UInt32)) [0, 7, 4294967295]
-- | Cons 0 (Cons 3 (Cons 32 Nil))
popCount : UInt32 -> Int
popCount x = ones x 0
  where
  -- (how many of the bits of `y` are 1, after `acc`)
  ones : UInt32 -> Int -> Int
  ones y acc =
    if uint32Eq y 0 then acc else ones (uint32And y (uint32Sub y 1)) (acc + 1)

-- | How many bits it needs: the place of its highest 1, from 1; of 0, 0.
-- | >>> List.map (\x -> bitLength (x : UInt32)) [0, 1, 5, 4294967295]
-- | Cons 0 (Cons 1 (Cons 3 (Cons 32 Nil)))
bitLength : UInt32 -> Int
bitLength x = needs x 0
  where
  -- (how many bits `y` needs, after `acc`)
  needs : UInt32 -> Int -> Int
  needs y acc = if uint32Eq y 0 then acc else needs (uint32Shr y 1) (acc + 1)

-- | How many 0 bits are above its highest 1: of 0, 32.
-- | >>> List.map (\x -> leadingZeros (x : UInt32)) [0, 1, 2147483648]
-- | Cons 32 (Cons 31 (Cons 0 Nil))
leadingZeros : UInt32 -> Int
leadingZeros x = 32 - bitLength x

-- | How many 0 bits are below its lowest 1: of 0, 32.
-- | >>> List.map (\x -> trailingZeros (x : UInt32)) [0, 1, 12, 2147483648]
-- | Cons 32 (Cons 0 (Cons 2 (Cons 31 Nil)))
trailingZeros : UInt32 -> Int
trailingZeros x =
  if uint32Eq x 0 then 32
  else popCount (uint32Sub (uint32And x (uint32Sub 0 x)) 1)

-- Instances: the prelude's operators and functions at `UInt32`
--------------------------------------------------------------------------------

instance instanceEqualityUInt32 : Equality UInt32
instanceEqualityUInt32 = { equal = uint32Eq }

-- | >>> debug (7 : UInt32)
-- | "7"
instance instanceDebugUInt32 : Debug UInt32
instanceDebugUInt32 = { debug = uint32Show }

-- | As `debug` writes it.
instance instanceShowUInt32 : Show UInt32
instanceShowUInt32 = { show = uint32Show }

instance instanceOrderUInt32 : Order UInt32
instanceOrderUInt32 =
  { eq = instanceEqualityUInt32
  , compare = \a b ->
        if uint32Lt a b then LT else if uint32Eq a b then EQ else GT
  , lt = uint32Lt
  , le = uint32Le
  }

instance instanceAdditionUInt32 : Addition UInt32
instanceAdditionUInt32 = { add = uint32Add }

instance instanceSubtractionUInt32 : Subtraction UInt32
instanceSubtractionUInt32 = { sub = uint32Sub }

instance instanceMultiplicationUInt32 : Multiplication UInt32
instanceMultiplicationUInt32 = { mul = uint32Mul }

-- | >>> List.map debug ([7 / 2, 7 / 0] : List UInt32)
-- | Cons "3" (Cons "0" Nil)
instance instanceDivisionUInt32 : Division UInt32
instanceDivisionUInt32 = { div = uint32Div }

-- | >>> List.map debug ([7 % 2, 7 % 0, (7 / 0) * 0 + 7 % 0] : List UInt32)
-- | Cons "1" (Cons "7" (Cons "7" Nil))
instance instanceRemainderUInt32 : Remainder UInt32
instanceRemainderUInt32 = { mod = uint32Rem }

-- | What, added to it, wraps around to 0: of 1, `maxBound`.
instance instanceNegationUInt32 : Negation UInt32
instanceNegationUInt32 = { neg = \x -> uint32Sub 0 x }

instance instanceIsZeroUInt32 : IsZero UInt32
instanceIsZeroUInt32 = { isZero = \x -> uint32Eq x 0 }

-- | The bits: shifted left by the second (modulo 32), the bits shifted out
-- | lost, and right, zeros shifted in.
-- | >>> debug (and (shiftL 1 3 + 1) (complement 0) * 3 - 2 : UInt32)
-- | "25"
instance instanceBitwiseUInt32 : Bitwise UInt32
instanceBitwiseUInt32 =
  { and = uint32And
  , or = uint32Or
  , xor = uint32Xor
  , complement = \x -> uint32Xor x 4294967295
  , shiftL = uint32Shl
  , shiftR = uint32Shr
  }
