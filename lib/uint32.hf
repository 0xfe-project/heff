-- `UInt32`: the integers from 0 to 4294967295, wrapping around as the
-- machine's do: `fromInt 4294967296` is 0, `fromInt (-1)` is 4294967295.  A literal checked at `UInt32` is one (`(7 : UInt32)`).
-- Import it by a name, `import uint32 as U32`, as its names are the
-- prelude's: `U32.add`, `U32.fromInt`.  Its operators, `+` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  (Another fixed-width type's value from one goes by way of an
-- `Int`: `toInt`, then the other's `fromInt`.)

foreign import uint32Add : UInt32 -> UInt32 -> UInt32
foreign import uint32Sub : UInt32 -> UInt32 -> UInt32
foreign import uint32Mul : UInt32 -> UInt32 -> UInt32
foreign import uint32Div : UInt32 -> UInt32 -> UInt32
foreign import uint32Rem : UInt32 -> UInt32 -> UInt32
foreign import uint32Lt : UInt32 -> UInt32 -> Bool
foreign import uint32Le : UInt32 -> UInt32 -> Bool
foreign import uint32And : UInt32 -> UInt32 -> UInt32
foreign import uint32Or : UInt32 -> UInt32 -> UInt32
foreign import uint32Xor : UInt32 -> UInt32 -> UInt32
foreign import uint32Shl : UInt32 -> UInt32 -> UInt32
foreign import uint32Shr : UInt32 -> UInt32 -> UInt32
foreign import uint32Show : UInt32 -> String
foreign import uint32FromInt : Int -> UInt32
foreign import uint32ToInt : UInt32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

-- | The least.
minBound : UInt32
minBound = 0

-- | The greatest.
maxBound : UInt32
maxBound = 4294967295

-- | The sum, wrapped around: `add maxBound 1` is `minBound`.
add : UInt32 -> UInt32 -> UInt32
add = uint32Add

sub : UInt32 -> UInt32 -> UInt32
sub = uint32Sub

mul : UInt32 -> UInt32 -> UInt32
mul = uint32Mul

-- | Division rounding toward zero (as C's, not as an `Int`'s `/`); by 0,
-- | `abandon`.
div : UInt32 -> UInt32 -> UInt32
div = uint32Div

-- | The remainder of `div`, of the sign of the dividend; by 0, `abandon`.
rem : UInt32 -> UInt32 -> UInt32
rem = uint32Rem

neg : UInt32 -> UInt32
neg x = uint32Sub 0 x

-- Comparisons
--------------------------------------------------------------------------------

eq : UInt32 -> UInt32 -> Bool
eq = uint32Eq

lt : UInt32 -> UInt32 -> Bool
lt = uint32Lt

le : UInt32 -> UInt32 -> Bool
le = uint32Le

compare : UInt32 -> UInt32 -> Ordering
compare a b = if uint32Lt a b then LT else if uint32Eq a b then EQ else GT

min : UInt32 -> UInt32 -> UInt32
min a b = if uint32Le a b then a else b

max : UInt32 -> UInt32 -> UInt32
max a b = if uint32Le a b then b else a

-- Bits
--------------------------------------------------------------------------------

-- | The bits set in both.
and : UInt32 -> UInt32 -> UInt32
and = uint32And

-- | The bits set in either.
or : UInt32 -> UInt32 -> UInt32
or = uint32Or

-- | The bits set in one of the two.
xor : UInt32 -> UInt32 -> UInt32
xor = uint32Xor

-- | Every bit flipped.
complement : UInt32 -> UInt32
complement x = uint32Xor x 4294967295

-- | Shifted left by the second (modulo 32), the bits shifted out lost.
shiftL : UInt32 -> UInt32 -> UInt32
shiftL = uint32Shl

-- | Shifted right by the second (modulo 32), zeros shifted in.
shiftR : UInt32 -> UInt32 -> UInt32
shiftR = uint32Shr

-- Conversions
--------------------------------------------------------------------------------

-- | The `UInt32` an integer wraps around to: equal to it modulo 2^32.
fromInt : Int -> UInt32
fromInt = uint32FromInt

toInt : UInt32 -> Int
toInt = uint32ToInt

show : UInt32 -> String
show = uint32Show

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=
infixl + - above == /= < <= > >=
infixl * / % above + -

(+) : UInt32 -> UInt32 -> UInt32
(+) = uint32Add

(-) : UInt32 -> UInt32 -> UInt32
(-) = uint32Sub

(*) : UInt32 -> UInt32 -> UInt32
(*) = uint32Mul

(/) : UInt32 -> UInt32 -> UInt32
(/) = uint32Div

(%) : UInt32 -> UInt32 -> UInt32
(%) = uint32Rem

(==) : UInt32 -> UInt32 -> Bool
(==) = uint32Eq

(/=) : UInt32 -> UInt32 -> Bool
(/=) a b = not (uint32Eq a b)

(<) : UInt32 -> UInt32 -> Bool
(<) = uint32Lt

(<=) : UInt32 -> UInt32 -> Bool
(<=) = uint32Le

(>) : UInt32 -> UInt32 -> Bool
(>) a b = uint32Lt b a

(>=) : UInt32 -> UInt32 -> Bool
(>=) a b = uint32Le b a
