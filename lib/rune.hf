-- `Rune`: a code point of Unicode, a 32-bit value, as Go's `rune` is.
-- A literal is written in quotes -- `'a'`, `'é'`, `'😀'`, a string's
-- escapes (`'\n'`, `'\''`, `'\\'`) or `'\u{1F600}'` -- and is a Unicode
-- scalar value: from U+0000 to U+10FFFF, but the surrogates, U+D800 to
-- U+DFFF.  A rune made of an integer may be any 32-bit value (`fromInt`,
-- as Go's `rune(n)`); one that is no scalar value is U+FFFD,
-- `replacement`, in a string made of it (the prelude's `ofRunes`), as
-- what is not UTF-8 is where a string's runes are read (`runes`).
-- Import it by a name, `import rune as Rune`, as its names are the
-- prelude's: `Rune.compare`, `Rune.max`.  Its operators, `==` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  Its classes and cases are ASCII's: `isAlpha 'é'` is `False`.

primitive runeLt : Rune -> Rune -> Bool
primitive runeLe : Rune -> Rune -> Bool
primitive strRuneCount : String -> Int

-- Conversions
--------------------------------------------------------------------------------

-- | Its code point.
toInt : Rune -> Int
toInt = runeToInt

-- | The rune of an integer, wrapped around to 32 bits as an `Int32` is:
-- | `fromInt 233` is `'é'`.
fromInt : Int -> Rune
fromInt = runeFromInt

-- | U+FFFD, what a string has for a rune that is none (Go's
-- | `utf8.RuneError`).
replacement : Rune
replacement = '\u{FFFD}'

-- | The last code point, U+10FFFF.
-- | >>> List.map toInt ['a', 'é', '😀', maxRune, fromInt 4294967361]
-- | [97, 233, 128512, 1114111, 65]
maxRune : Rune
maxRune = '\u{10FFFF}'

-- (a code point that is a scalar value)
validCode : Int -> Bool
validCode n = 0 <= n && n <= 1114111 && not (55296 <= n && n <= 57343)

-- | Whether it is a Unicode scalar value: what a literal is, and what a
-- | string keeps as it is (Go's `utf8.ValidRune`).
-- | >>> List.map isValid [fromInt 55296, fromInt 1114112, fromInt -1, 'a']
-- | [False, False, False, True]
isValid : Rune -> Bool
isValid c = validCode (runeToInt c)

-- In a string: its bytes, UTF-8
--------------------------------------------------------------------------------

-- | How many bytes it is in a string: 1 to 4 (one that is no scalar
-- | value 3, as U+FFFD is; Go's `utf8.RuneLen`).
-- | >>> List.map width ['a', 'é', '中', '😀', fromInt 55296]
-- | [1, 2, 3, 4, 3]
width : Rune -> Int
width c =
  if not (isValid c) then 3
  else if runeToInt c < 128 then 1
  else if runeToInt c < 2048 then 2
  else if runeToInt c < 65536 then 3
  else 4

-- | How many runes a string has, `List.length (runes s)` (Go's
-- | `utf8.RuneCountInString`).
-- | >>> List.map count ["", "héllo", "a😀", "\xffa"]
-- | [0, 5, 2, 2]
count : String -> Int
count = strRuneCount

-- (from `i` on, its runes, each at where it starts, into `acc`)
foldlFrom : {a : Type} -> (a -> Int -> Rune -> a) -> String -> Int -> a -> a
foldlFrom f s i acc =
  if i >= strLength s then acc
  else foldlFrom f s (i + (runeAt s i).width) (f acc i (runeAt s i).rune)

-- | Its runes, each with where its bytes start, from the first (Go's
-- | `for i, r := range s`).
-- | >>> foldl (\acc i c -> acc ^ show i ^ toString c) "" "aé😀"
-- | "0a1é3😀"
foldl : {a : Type} -> (a -> Int -> Rune -> a) -> a -> String -> a
foldl f z s = foldlFrom f s 0 z

-- (from `i` on, whether it is UTF-8: no U+FFFD read but where its bytes
-- are its own)
validFrom : String -> Int -> Bool
validFrom s i =
  if i >= strLength s then True
  else if runeEq (runeAt s i).rune replacement
  && not (strEq (strSlice s i (i + 3)) (toString replacement))
  then False
  else validFrom s (i + (runeAt s i).width)

-- | Whether a string is UTF-8, each of its runes' bytes (Go's
-- | `utf8.ValidString`).
-- | >>> List.map validString ["", "héllo", "\u{FFFD}", "\xe9", "\xc3"]
-- | [True, True, True, False, False]
validString : String -> Bool
validString s = validFrom s 0

-- | The string, what is not UTF-8 in it U+FFFD, as `runes` reads it:
-- | `ofRunes (runes s)`.
-- | >>> runes (toValid "a\xffb")
-- | ['a', '\u{FFFD}', 'b']
toValid : String -> String
toValid s = if validString s then s else ofRunes (runes s)

-- Comparisons, by code point
--------------------------------------------------------------------------------

eq : Rune -> Rune -> Bool
eq = runeEq

lt : Rune -> Rune -> Bool
lt = runeLt

le : Rune -> Rune -> Bool
le = runeLe

compare : Rune -> Rune -> Ordering
compare a b = if runeLt a b then LT else if runeEq a b then EQ else GT

min : Rune -> Rune -> Rune
min a b = if runeLe a b then a else b

max : Rune -> Rune -> Rune
max a b = if runeLe a b then b else a

-- Classes and cases: ASCII's
--------------------------------------------------------------------------------

-- (between the two, both in)
within : Rune -> Rune -> Rune -> Bool
within lo hi c = runeLe lo c && runeLe c hi

isAscii : Rune -> Bool
isAscii c = within '\u{0}' '\u{7F}' c

-- | `'0'` to `'9'`.
isDigit : Rune -> Bool
isDigit c = within '0' '9' c

-- | A digit, or `'a'` to `'f'`, `'A'` to `'F'`.
isHexDigit : Rune -> Bool
isHexDigit c = isDigit c || within 'a' 'f' c || within 'A' 'F' c

isUpper : Rune -> Bool
isUpper c = within 'A' 'Z' c

isLower : Rune -> Bool
isLower c = within 'a' 'z' c

-- | A letter of ASCII's, upper or lower case.
isAlpha : Rune -> Bool
isAlpha c = isUpper c || isLower c

isAlphaNum : Rune -> Bool
isAlphaNum c = isAlpha c || isDigit c

-- | A space, a tab, a line feed, a carriage return, a vertical tab or a
-- | form feed.
-- | >>> List.map isSpace (runes " \t\nx")
-- | [True, True, True, False]
isSpace : Rune -> Bool
isSpace ' ' = True
isSpace '\t' = True
isSpace '\n' = True
isSpace '\r' = True
isSpace '\u{B}' = True
isSpace '\u{C}' = True
isSpace _ = False

-- | A control character: C0's, DEL, C1's.
isControl : Rune -> Bool
isControl c = within '\u{0}' '\u{1F}' c || within '\u{7F}' '\u{9F}' c

-- | `'a'` to `'z'` in upper case; any other as it is.
-- | >>> ofRunes (List.map toUpper (runes "héllo, wörld"))
-- | "HéLLO, WöRLD"
toUpper : Rune -> Rune
toUpper c = if isLower c then runeFromInt (runeToInt c - 32) else c

-- | `'A'` to `'Z'` in lower case; any other as it is.
toLower : Rune -> Rune
toLower c = if isUpper c then runeFromInt (runeToInt c + 32) else c

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=

(==) : Rune -> Rune -> Bool
(==) = runeEq

(/=) : Rune -> Rune -> Bool
(/=) a b = not (runeEq a b)

(<) : Rune -> Rune -> Bool
(<) = runeLt

(<=) : Rune -> Rune -> Bool
(<=) = runeLe

(>) : Rune -> Rune -> Bool
(>) a b = runeLt b a

(>=) : Rune -> Rune -> Bool
(>=) a b = runeLe b a
