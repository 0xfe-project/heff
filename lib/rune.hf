-- `Rune`: a code point of Unicode, a 32-bit value, as Go's `rune` is.
-- A literal is written in quotes -- `'a'`, `'é'`, `'😀'`, a string's
-- escapes (`'\n'`, `'\''`, `'\\'`) or `'\u{1F600}'` -- and is a Unicode
-- scalar value: from U+0000 to U+10FFFF, but the surrogates, U+D800 to
-- U+DFFF.  A rune made of an integer may be any 32-bit value (`fromInt`,
-- as Go's `rune(n)`); one that is no scalar value is U+FFFD,
-- `replacement`, in a string made of it (the prelude's `ofRunes`), as a
-- surrogate not in a pair is where a string's runes are read (`runes`).
-- Import it by a name, `import rune as R`, as its names are the
-- prelude's: `R.compare`, `R.show`.  Its operators, `==` to `>=`, are
-- these too, for a module that imports it as it is and the prelude by a
-- name.  Its classes and cases are ASCII's: `isAlpha 'é'` is `False`.

primitive runeLt : Rune -> Rune -> Bool
primitive runeLe : Rune -> Rune -> Bool
primitive runeToInt : Rune -> Int
primitive runeFromInt : Int -> Rune

-- Conversions
--------------------------------------------------------------------------------

-- | Its code point.
toInt : Rune -> Int
toInt = runeToInt

-- | The rune of an integer, wrapped around to 32 bits as an `Int32` is:
-- | `fromInt 233` is `'é'`.
fromInt : Int -> Rune
fromInt = runeFromInt

-- | U+FFFD, what a string has for a rune that is none (Go's
-- | `utf8.RuneError`).
replacement : Rune
replacement = '\u{FFFD}'

-- | The last code point, U+10FFFF.
maxRune : Rune
maxRune = '\u{10FFFF}'

-- (a code point that is a scalar value)
validCode : Int -> Bool
validCode n = 0 <= n && n <= 1114111 && not (55296 <= n && n <= 57343)

-- | Whether it is a Unicode scalar value: what a literal is, and what a
-- | string keeps as it is (Go's `utf8.ValidRune`).
isValid : Rune -> Bool
isValid c = validCode (runeToInt c)

-- | The string of it alone, `ofRunes [c]` (Go's `string(c)`).
toString : Rune -> String
toString c = ofRunes [c]

-- Comparisons, by code point
--------------------------------------------------------------------------------

eq : Rune -> Rune -> Bool
eq = runeEq

lt : Rune -> Rune -> Bool
lt = runeLt

le : Rune -> Rune -> Bool
le = runeLe

compare : Rune -> Rune -> Ordering
compare a b = if runeLt a b then LT else if runeEq a b then EQ else GT

min : Rune -> Rune -> Rune
min a b = if runeLe a b then a else b

max : Rune -> Rune -> Rune
max a b = if runeLe a b then b else a

-- Classes and cases: ASCII's
--------------------------------------------------------------------------------

-- (between the two, both in)
within : Rune -> Rune -> Rune -> Bool
within lo hi c = runeLe lo c && runeLe c hi

isAscii : Rune -> Bool
isAscii c = within '\u{0}' '\u{7F}' c

-- | `'0'` to `'9'`.
isDigit : Rune -> Bool
isDigit c = within '0' '9' c

-- | A digit, or `'a'` to `'f'`, `'A'` to `'F'`.
isHexDigit : Rune -> Bool
isHexDigit c = isDigit c || within 'a' 'f' c || within 'A' 'F' c

isUpper : Rune -> Bool
isUpper c = within 'A' 'Z' c

isLower : Rune -> Bool
isLower c = within 'a' 'z' c

-- | A letter of ASCII's, upper or lower case.
isAlpha : Rune -> Bool
isAlpha c = isUpper c || isLower c

isAlphaNum : Rune -> Bool
isAlphaNum c = isAlpha c || isDigit c

-- | A space, a tab, a line feed, a carriage return, a vertical tab or a
-- | form feed.
isSpace : Rune -> Bool
isSpace ' ' = True
isSpace '\t' = True
isSpace '\n' = True
isSpace '\r' = True
isSpace '\u{B}' = True
isSpace '\u{C}' = True
isSpace _ = False

-- | A control character: C0's, DEL, C1's.
isControl : Rune -> Bool
isControl c = within '\u{0}' '\u{1F}' c || within '\u{7F}' '\u{9F}' c

-- | `'a'` to `'z'` in upper case; any other as it is.
toUpper : Rune -> Rune
toUpper c = if isLower c then runeFromInt (runeToInt c - 32) else c

-- | `'A'` to `'Z'` in lower case; any other as it is.
toLower : Rune -> Rune
toLower c = if isUpper c then runeFromInt (runeToInt c + 32) else c

-- Shown
--------------------------------------------------------------------------------

hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

hex : Int -> String
hex n = if n < 16 then hexDigit n else hex (n / 16) ^ hexDigit (n % 16)

-- (between the quotes)
quoted : Rune -> String
quoted '\'' = "\\'"
quoted '\\' = "\\\\"
quoted '\n' = "\\n"
quoted '\t' = "\\t"
quoted '\r' = "\\r"
quoted c =
  if not (isValid c) then toString replacement
  else if isControl c then "\\u{" ^ hex (runeToInt c) ^ "}"
  else toString c

-- | As a literal writes it: `show 'a'` is `"'a'"`, `show '\n'` is
-- | `"'\\n'"`, a control character an escape, `"'\\u{1b}'"`; one that is
-- | no scalar value as U+FFFD (as Go's `%q`).
show : Rune -> String
show c = "'" ^ quoted c ^ "'"

-- Operators
--------------------------------------------------------------------------------

infix == /= < <= > >=

(==) : Rune -> Rune -> Bool
(==) = runeEq

(/=) : Rune -> Rune -> Bool
(/=) a b = not (runeEq a b)

(<) : Rune -> Rune -> Bool
(<) = runeLt

(<=) : Rune -> Rune -> Bool
(<=) = runeLe

(>) : Rune -> Rune -> Bool
(>) a b = runeLt b a

(>=) : Rune -> Rune -> Bool
(>=) a b = runeLe b a

-- >>> List.map show ['a', '\'', '\\', '\n', '\u{1b}', 'é', '😀', fromInt 55296, fromInt -1]
-- ["'a'", "'\\''", "'\\\\'", "'\\n'", "'\\u{1b}'", "'é'", "'😀'", "'�'", "'�'"]

-- >>> List.map toInt ['a', 'é', '😀', maxRune, fromInt 4294967361]
-- [97, 233, 128512, 1114111, 65]

-- >>> List.map isValid [fromInt 55296, fromInt 1114112, fromInt -1, 'a']
-- [False, False, False, True]

-- >>> ofRunes (List.map toUpper (runes "héllo, wörld"))
-- "HéLLO, WöRLD"

-- >>> List.map isSpace (runes " \t\nx")
-- [True, True, True, False]
