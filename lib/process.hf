-- The process as an effect (lib/co.hf): its arguments, its environment,
-- where its program is, and how it ends.  `heff compile --backend=node`
-- has a handler for it.

import co
import prelude

data ProcessF (m : Type -> Type) x
  = Args (List String -> x)
  | GetEnv String (Maybe String -> x)
  | ProgramPath (String -> x)
  | Exit Int x
  | Exec String (List String) x

-- | The process as an effect.
process : HFunctor
process =
  { f = ProcessF
  , hfmap = \fm g p -> case p of
      Args k -> Args (\a -> g (k a))
      GetEnv name k -> GetEnv name (\v -> g (k v))
      ProgramPath k -> ProgramPath (\s -> g (k s))
      Exit code x -> Exit code (g x)
      Exec cmd as x -> Exec cmd as (g x)
  , hmap = \nt p -> case p of
      Args k -> Args k
      GetEnv name k -> GetEnv name k
      ProgramPath k -> ProgramPath k
      Exit code x -> Exit code x
      Exec cmd as x -> Exec cmd as x
  }

-- | The program's arguments (not Node's, nor the program's own path):
-- | in any effect the process is in, by the evidence.
args : {e : HFunctor} -> {{ev : process <: e}} -> Co e (List String)
args = op (ev (Args (\a -> a))) val

-- | An environment variable, if it is set.
getEnv : {e : HFunctor}
       -> {{ev : process <: e}}
       -> String
       -> Co e (Maybe String)
getEnv name = op (ev (GetEnv name (\v -> v))) val

-- | The path of the program's own file.
programPath : {e : HFunctor} -> {{ev : process <: e}} -> Co e String
programPath = op (ev (ProgramPath (\s -> s))) val

-- | End the program, with a status (0: it went well); nothing after it runs.
exit : {e : HFunctor} -> {{ev : process <: e}} -> Int -> Co e Unit
exit code = op (ev (Exit code MkUnit)) val

-- | End the program, and run the command with the arguments in its place:
-- | its input is the program's, and its status is the program's status.
exec : {e : HFunctor}
     -> {{ev : process <: e}}
     -> String
     -> List String
     -> Co e Unit
exec cmd as = op (ev (Exec cmd as MkUnit)) val
