-- `Float32`: IEEE 754's single precision, 24 bits of precision, from
-- about 1.4e-45 to 3.4e38 -- each operation's result rounded to one, as
-- C's `float` and JavaScript's `Math.fround` round.  A float literal
-- checked at `Float32` is the one nearest it (`(0.1 : Float32)`).
-- Import it by a name, `import float32 as Float32`, as some of its names are
-- the prelude's of a `Float64` (`sqrt`, `floor`, `toFloat`): `Float32.sqrt`,
-- `Float32.floor`.  Its instances are the prelude's operators and functions
-- at `Float32`, wherever it is imported, by a name or not: `x + 1.5`,
-- `-x`, `x /. y`, `x < y`, `max x y` -- but no `/`, as a float has none.
-- (`Float64` is the double: `toFloat` and `fromFloat` go between them.)

module float32

import std.math as Math

primitive float32Add : Float32 -> Float32 -> Float32
primitive float32Sub : Float32 -> Float32 -> Float32
primitive float32Mul : Float32 -> Float32 -> Float32
primitive float32Div : Float32 -> Float32 -> Float32
primitive float32Lt : Float32 -> Float32 -> Bool
primitive float32Le : Float32 -> Float32 -> Bool
primitive float32Sqrt : Float32 -> Float32
primitive float32Show : Float32 -> String
primitive float32FromFloat : Float64 -> Float32
primitive float32ToFloat : Float32 -> Float64
primitive float32FromInt : Int -> Float32
primitive float32Floor : Float32 -> Int

-- Arithmetic
--------------------------------------------------------------------------------

add : Float32 -> Float32 -> Float32
add = float32Add

sub : Float32 -> Float32 -> Float32
sub = float32Sub

mul : Float32 -> Float32 -> Float32
mul = float32Mul

-- | Division; by 0, an infinity (or not a number, of 0 by 0).
div : Float32 -> Float32 -> Float32
div = float32Div

sqrt : Float32 -> Float32
sqrt = float32Sqrt

-- Comparisons
--------------------------------------------------------------------------------

-- | Equal (what is not a number is equal to nothing, itself too).
eq : Float32 -> Float32 -> Bool
eq = float32Eq

lt : Float32 -> Float32 -> Bool
lt = float32Lt

le : Float32 -> Float32 -> Bool
le = float32Le

isNaN : Float32 -> Bool
isNaN x = not (float32Eq x x)

-- Conversions
--------------------------------------------------------------------------------

-- | The `Float32` nearest the float.
fromFloat : Float64 -> Float32
fromFloat = float32FromFloat

-- | The same number, as a float (every `Float32` is one).
toFloat : Float32 -> Float64
toFloat = float32ToFloat

-- | The `Float32` nearest the float nearest the integer.
fromInt : Int -> Float32
fromInt = float32FromInt

-- | The greatest integer not above; of an infinity, or what is not a
-- | number, 0.
-- | >>> List.map floor [2.5, -2.5, div 1.0 0.0, div -1.0 0.0, div 0.0 0.0]
-- | Cons 2 (Cons (-3) (Cons 0 (Cons 0 (Cons 0 Nil))))
floor : Float32 -> Int
floor = float32Floor

-- Instances: the prelude's operators and functions at `Float32`
--------------------------------------------------------------------------------

-- (IEEE's: NaN is no float's equal, its own neither)
instance instanceEqualityFloat32 : Equality Float32
instanceEqualityFloat32 = { equal = float32Eq }

-- | The fewest digits that read back as the same `Float32`: `debug 0.1`
-- | is `"0.1"`, though the `Float32` is 0.100000001490116...
-- | >>> debug (7.5 : Float32)
-- | "7.5"
instance instanceDebugFloat32 : Debug Float32
instanceDebugFloat32 = { debug = float32Show }

-- | As `debug` writes it.
instance instanceShowFloat32 : Show Float32
instanceShowFloat32 = { show = float32Show }

instance instanceOrderFloat32 : Order Float32
instanceOrderFloat32 =
  { eq = instanceEqualityFloat32
  , compare = \a b ->
        if float32Lt a b then LT else if float32Eq a b then EQ else GT
  , lt = float32Lt
  , le = float32Le
  }

instance instanceAdditionFloat32 : Addition Float32
instanceAdditionFloat32 = { add = float32Add }

instance instanceSubtractionFloat32 : Subtraction Float32
instanceSubtractionFloat32 = { sub = float32Sub }

instance instanceMultiplicationFloat32 : Multiplication Float32
instanceMultiplicationFloat32 = { mul = float32Mul }

-- | The float of the other sign, 0.0's too: what `-x` is.
-- | >>> debug (-(2.5 * 3.0 - 0.0) + max 1.0 0.5 : Float32)
-- | "-6.5"
instance instanceNegationFloat32 : Negation Float32
instanceNegationFloat32 = { neg = \x -> float32Mul (-1.0) x }

-- | Division, IEEE's: what `/.` is (`div`, its own name).
-- | >>> List.map debug ([1.0 /. 4.0, 1.0 /. -(0.0), 0.0 /. 0.0] : List Float32)
-- | Cons "0.25" (Cons "-Infinity" (Cons "NaN" Nil))
instance instanceFloatDivisionFloat32 : FloatDivision Float32
instanceFloatDivisionFloat32 = { divide = float32Div }

-- Decimals
--------------------------------------------------------------------------------

-- | `m` times 10 to the power `e`, correctly rounded: the `Float32`
-- | nearest it, a tie to the even, rounded once, not first to a
-- | `Float64` -- beyond the greatest, an infinity, and below half the
-- | least, 0.0 (with the sign of `m`) -- as a float literal at `Float32`
-- | is.
-- | >>> fromDecimal 10000000596046448 (0 - 16)
-- | 1.0000001
-- | >>> toFloat (fromDecimal 10000000596046448 (0 - 16))
-- | 1.0000001192092896
-- | >>> fromDecimal 1 (0 - 45)
-- | 1.0e-45
-- | >>> fromDecimal 34028236 31
-- | Infinity
fromDecimal : Int -> Int -> Float32
fromDecimal m e =
  if m < 0 then neg (fromDecimal (0 - m) e)
  else if m == 0 then 0.0
  else if 0 <= e && e <= 22 && m * Math.tenTo e < 9007199254740992
  then fromFloat (floatFromInt (m * Math.tenTo e))
  else fromFloat (floatOfBits 32 (Math.nearestBits Math.binary32 m e))

-- | The `Float32` nearest the decimal `s` is, whole (`2.5`, `-1e-7`), as
-- | the prelude's `floatOfDecimal` reads one, if it is one: rounded once,
-- | not first to a `Float64`, as `fromDecimal` rounds.
-- | >>> parseFloat32 "1.0000000596046448"
-- | Just 1.0000001
-- | >>> parseFloat32 "1.00000005960464477539"
-- | Just 1.0
-- | >>> parseFloat32 "3.4028236e38"
-- | Just Infinity
-- | >>> parseFloat32 "x"
-- | Nothing
parseFloat32 : String -> Maybe Float32
parseFloat32 s =
  let x : Float64 = floatOfDecimal 32 s 0 (strLength s)
  in if x == x then Just (fromFloat x) else Nothing
