-- `heff test` runs the tests of every file of test/ (and src/): the
-- definitions of type `Test` (lib/check.hf), after the watches and doc
-- tests.

module test.tree

import check
import co
import exception
import fs_tree.tree
import std.filesystem
import std.path

-- (a project's files, in `demo/` of the test's directory)
made : {e : HFunctor}
     -> {{fs : filesystem <: e}}
     -> {{ex : exception FileError <: e}}
     -> Co e Unit
made = do
  makeDirectory "demo/src/lib"
  makeDirectory "demo/docs"
  writeFile "demo/README.md" "# demo\n"
  writeFile "demo/src/main.hf" ""
  writeFile "demo/src/lib/a.hf" ""
  writeFile "demo/docs/guide.md" ""
  writeFile "demo/.hidden" ""

drawsWhatIsThere : Test
drawsWhatIsThere =
  integration "a directory drawn" (do
  made
  t <- buildTree defaultOptions 0 "demo"
  assertEqual
      (drawn "demo" t)
      [ "demo"
      , "├── docs"
      , "│\u{a0}\u{a0} └── guide.md"
      , "├── README.md"
      , "└── src"
      , "    ├── lib"
      , "    │\u{a0}\u{a0} └── a.hf"
      , "    └── main.hf"
      ]
  assertEqual (summary defaultOptions t) "4 directories, 4 files")

drawsAsAsked : Test
drawsAsAsked =
  integration "hidden entries, directories only, levels" (do
  made
  hidden <- buildTree { defaultOptions | all = True } 0 "demo"
  assertEqual (summary defaultOptions hidden) "4 directories, 5 files"
  dirs <- buildTree { defaultOptions | dirsOnly = True } 0 "demo"
  assertEqual
      (drawn "demo" dirs)
      ["demo", "├── docs", "└── src", "    └── lib"]
  assertEqual
      (summary { defaultOptions | dirsOnly = True } dirs)
      "4 directories"
  one <- buildTree { defaultOptions | level = Just 1 } 0 "demo"
  assertEqual
      (drawn "demo" one)
      ["demo", "├── docs", "├── README.md", "└── src"]
  missing <- buildTree defaultOptions 0 "nowhere"
  assertEqual (drawn "nowhere" missing) ["nowhere  [error opening dir]"]
  assertEqual (summary defaultOptions missing) "0 directories, 0 files")
