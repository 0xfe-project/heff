-- A greeting, written into a page that is already there: the input and the
-- paragraph are the page's own, found by a CSS selector and by an XPath
-- in the page's document, had at the top by `withDocument`.

module app.greet.main

import co
import browser.dom
import custodian

greeting : String -> String
greeting name =
  if strEq name "" then "Hello, whoever you are." else "Hello, " ^ name ^ "!"

main : Co (dom <+> custodian) Unit
main = do
  with withDocument as doc do
    out <- xpath doc "//p[@id='greeting']"
    name <- select doc "#name"
    found out (\o -> do
      text o (greeting "")
      found name (\n -> on n "input" (\v -> text o (greeting v))))
