-- Vector addition on the GPU (pages.vecadd), in the page's `#vecadd`:
-- the sums computed and checked, the verdict shown -- `ok`, or the first
-- index where they differ.  Where the browser has no WebGPU, the page
-- says so.  The device is opened once, at the top, by `withDevice`, and
-- closed when the page is done with it.

import co
import browser.dom
import gpu as Gpu
import pages.vecadd as VecAdd

world : HFunctor
world = dom <+> Gpu.gpu

program : {e : HFunctor}
        -> {{page : dom <: e}}
        -> {{card : Gpu.gpu <: e}}
        -> Co e Unit
program = do
  _ <-
    withDocument (\doc -> do
    place <- select doc "#vecadd"
    found place (\r -> do
      label <- textIn doc r "p" "adding"
      result <- Gpu.withDevice (\d -> VecAdd.sums d)
      text label (VecAdd.verdictOf (VecAdd.flattened result))))
  pure MkUnit

-- where the world is: each sub-effect's evidence, given
main : Co world Unit
main = program (page := inl dom Gpu.gpu) (card := inr dom Gpu.gpu)
