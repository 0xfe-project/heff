-- Vector addition on the GPU (pages.vecadd), in the page's `#vecadd`:
-- the sums computed and checked, the verdict shown -- `ok`, or the first
-- index where they differ.  Where the browser has no WebGPU, the page
-- says so: no GPU is thrown by `withDevice`, and heard here.  The
-- device is opened once, at the top, by `withDevice`, and closed when
-- the page is done with it.

module app.vecadd.main

import co
import browser.dom
import exception
import browser.gpu as GPU
import pages.vecadd as VecAdd

program : {e : HFunctor}
        -> {{page : dom <: e}}
        -> {{card : GPU.gpu <: e}}
        -> {{ex : exception GPU.GpuError <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    place <- select doc "#vecadd"
    found place (\r -> do
      label <- textIn doc r "p" "adding"
      try
        result <- GPU.withDevice (\d -> VecAdd.sums d)
        text label (VecAdd.verdictOf result)
      catch (err : GPU.GpuError) ->
        text label (GPU.showError err))

-- where the world is: each sub-effect's evidence, found; a throw no
-- one heard ends the program
main : Co (dom <+> GPU.gpu) Unit
main =
  bind
    (attempt
       GPU.GpuError
       (program
          (page := _)
          (card := _)
          (ex := _)))
    (\r -> pure MkUnit)
