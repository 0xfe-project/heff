-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page
-- (the JavaScript handler's monad is the continuation monad), yet the
-- program is plain `do`.

module app.clock.main

import co
import browser.dom
import custodian

tick : {e : HFunctor} -> {{page : dom <: e}} -> Element -> Int -> Co e Unit
tick label n = do
  sleep 100
  text label (debug n ^ " ticks")
  tick label (n + 1)

main : Co (dom <+> custodian) Unit
main = do
  with withDocument as doc do
    place <- select doc "#clock"
    found place (\r -> do
      label <- textIn doc r "p" "0 ticks"
      tick label 1)
