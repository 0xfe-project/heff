-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page
-- (the JavaScript handler's monad is the continuation monad), yet the
-- program is plain `do`.

import co
import browser.dom

tick : {{page : dom <: dom}} -> Element -> Int -> Co dom Unit
tick label n = do
  sleep 100
  text label (show n ^ " ticks")
  tick label (n + 1)

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  _ <-
    withDocument (\doc -> do
    place <- select doc "#clock"
    found place (\r -> do
      label <- textIn doc r "p" "0 ticks"
      tick label 1))
  pure MkUnit

main : Co dom Unit
main = program (page := here dom)
