-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page
-- (the JavaScript handler's monad is the continuation monad), yet the
-- program is plain `do`.

import co
import browser.dom

tick : {{page : dom <: dom}} -> Node -> Int -> Co dom Unit
tick label n = do
  sleep 100
  text label (show n ^ " ticks")
  tick label (n + 1)

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  place <- select "#clock"
  found place (\r -> do
    label <- textIn r "p" "0 ticks"
    tick label 1)

main : Co dom Unit
main = program (page := here dom)
