-- A counter, in the page's `#counter`.  Each click is a run of its own,
-- so the count lives in the world between them: a cell (std.reference),
-- made with its first value.  The page's document is had at the top,
-- by `withDocument`; the elements are the page's own, passed by value.

module app.counter.main

import co
import browser.dom
import custodian
import std.reference

showCount : Int -> String
showCount n = "count: " ^ debug n

-- (the count moved by `delta`, and shown)
step : {e : HFunctor}
     -> {{page : dom <: e}}
     -> {{cell : reference Int <: e}}
     -> Int
     -> Reference Int
     -> Element
     -> Co e Unit
step delta count label = do
  n <- readReference count
  writeReference count (n + delta)
  text label (showCount (n + delta))

main : Co (dom <+> reference Int <+> custodian) Unit
main = do
  count <- newReference 0
  with withDocument as doc do
    place <- select doc "#counter"
    found place (\r -> do
      label <- textIn doc r "p" (showCount 0)
      iBtn <- textIn doc r "button" "+1"
      on iBtn "click" (\_ -> step 1 count label)
      dBtn <- textIn doc r "button" "-1"
      on dBtn "click" (\_ -> step (-1) count label))
