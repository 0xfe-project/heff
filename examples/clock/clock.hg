-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page (the JavaScript handler's
-- monad is the continuation monad), yet the program is plain `do`.
-- Open index.html; `npm run examples` builds clock.js again.

import co
import dom
import prelude
import state

tick :: Node -> Int -> Co (dom <+> (state Int)) Unit
tick label n = do
  sleep 100
  text label (showInt n ++ " ticks")
  tick label (n + 1)

clock :: Co (dom <+> (state Int)) Unit
clock = do
  place <- select "#clock"
  found
      place
      (\r -> do
       label <- textIn r "p" "0 ticks"
       tick label 1)
