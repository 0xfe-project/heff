-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page (the JavaScript handler's
-- monad is the continuation monad), yet the program is plain `do`.
-- `npm run examples` builds clock.js; then open index.html.

import co
import dom
import prelude

page : (dom <: dom)
page = here dom

tick : Node -> Int -> Co dom Unit
tick label n = do
  sleep page 100
  text page label (showInt n ++ " ticks")
  tick label (n + 1)

clock : Co dom Unit
clock = do
  place <- select page "#clock"
  found place (\r -> do
    label <- textIn page r "p" "0 ticks"
    tick label 1)
