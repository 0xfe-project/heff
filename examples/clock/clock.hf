-- A clock, in the page's `#clock`: `sleep` is asynchronous in the page (the JavaScript handler's
-- monad is the continuation monad), yet the program is plain `do`.
-- `npm run examples` builds clock.js; then open index.html.

import co
import dom
import prelude

tick : {{page : dom <: dom}} -> Node -> Int -> Co dom Unit
tick label n = do
  sleep 100
  text label (showInt n ++ " ticks")
  tick label (n + 1)

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  place <- select "#clock"
  found place (\r -> do
    label <- textIn r "p" "0 ticks"
    tick label 1)

clock : Co dom Unit
clock = program (page := here dom)
