-- A counter: `hg app examples/counter.hg counter.js`.

import co
import dom

foreign import intAdd :: Int -> Int -> Int
foreign import intShow :: Int -> String
foreign import strAppend :: String -> String -> String

showCount :: Int -> String
showCount n = strAppend "count: " (intShow n)

increment :: Int -> Co (dom Int) Unit
increment label = do
  n <- get
  put (intAdd n 1)
  text label (showCount (intAdd n 1))

counter :: Co (dom Int) Unit
counter = do
  put 0
  r <- root
  label <- textIn r "p" (showCount 0)
  b <- textIn r "button" "+1"
  on b "click" (\_ -> increment label)
