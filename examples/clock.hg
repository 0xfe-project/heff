-- A clock: `sleep` is asynchronous in the page (the JavaScript handler's
-- monad is the continuation monad), yet the program is plain `do`.
-- `hg app examples/clock.hg clock.js`

import co
import dom
import examples.counter

tick :: Int -> Int -> Co (dom Int) Unit
tick label n = do
  sleep 100
  text label (strAppend (intShow n) " ticks")
  tick label (intAdd n 1)

clock :: Co (dom Int) Unit
clock = do
  r <- root
  label <- textIn r "p" "0 ticks"
  tick label 1
