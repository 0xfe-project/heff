-- The program collatz: the steps of each number of its arguments (6, 7
-- and 27 where it is given none), reported through the logger, and the
-- most of them.  Here the logger's lines are printed; the tests keep
-- them instead.
--
--   collatz 6 7 27

import co
import collatz.logger
import collatz.steps
import std.io
import std.process

world : HFunctor
world = stdio <+> process

-- (the arguments that are numbers; 6, 7 and 27 where there are none)
numbers : List String -> List Int
numbers Nil = [6, 7, 27]
numbers as = List.concatMap (\a -> maybe Nil (\n -> [n]) (parseInt a)) as

program : {e : HFunctor}
        -> {{io : stdio <: e}}
        -> {{sys : process <: e}}
        -> {{lg : logger <: e}}
        -> Co e Unit
program = do
  as <- args
  most <- report (numbers as)
  print ("most steps: " ^ show most)

-- | The logger handled first, printed; then the world: each effect's
-- | evidence, given.
main : Co world Unit
main =
  printed
    (io := \p -> InL p)
    (program
       (io := \p -> InR (InL p))
       (sys := \p -> InR (InR p))
       (lg := \p -> InL p))
