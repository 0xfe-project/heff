-- A logger, an effect of the program's own: one operation, a line said.
-- What saying it does is the handler's to decide -- printed, for real,
-- or kept, for a test to look at -- and the code that says it does not
-- change.

module collatz.logger

import co
import std.io

-- | The operations: a line said, then the rest (`x`).
data LoggerF (m : Type -> Type) x = Say String x

-- | For lines said as the program goes.
logger : HFunctor
logger =
  { f = LoggerF
  , hfmap = \m g p -> case p of
      Say line x -> Say line (g x)
  , hmap = \m n nt p -> case p of
      Say line x -> Say line x
  }

-- | A line said, in any world the logger is in.
say : {e : HFunctor} -> {{lg : logger <: e}} -> String -> Co e Unit
say line = op (lg (Say line MkUnit)) val

-- (a line said, printed)
printedLine : {m : Type -> Type}
            -> {e : HFunctor}
            -> {a : Type}
            -> {{io : stdio <: e}}
            -> LoggerF m a
            -> Co e a
printedLine (Say line x) = bind (print line) (\_ -> val x)

-- | The real handler: each line printed on the standard output, the
-- | rest of the world left as it is.
printed : {e : HFunctor}
        -> {a : Type}
        -> {{io : stdio <: e}}
        -> Co (logger <+> e) a
        -> Co e a
printed = \{e} {a} c -> handle (through logger e (\p -> printedLine p)) c

-- | A test's handler: nothing printed, the lines kept in the order said,
-- | beside the answer.
kept : Handler logger
kept =
  { M = \a -> Pair a (List String)
  , ret = \x -> MkPair x Nil
  , bind = \m k -> case m of
      MkPair x said -> case k x of
        MkPair y more -> MkPair y (List.append said more)
  , malg = \p -> case p of
      Say line x -> MkPair x [line]
  }
