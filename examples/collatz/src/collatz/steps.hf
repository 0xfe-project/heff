-- The Collatz steps of a number -- halved when it is even, tripled and
-- one added when it is odd, until it is 1 -- and a report of them, said
-- through the logger.  Both are written as statements: the steps pure
-- code, by `run do`; the report a computation, by plain `do`.

module collatz.steps

import co
import collatz.logger

-- | how many steps `n`, 1 or more, takes to 1
-- | >>> steps 6
-- | 8
-- | >>> steps 1
-- | 0
steps : Int -> Int
steps n0 = run do
  let mut n = n0
  let mut count = 0
  while n /= 1 do
    if n % 2 == 0 then n := n / 2 else n := 3 * n + 1
    count := count + 1
  return count

-- | each number's steps said, a line each, and the most of them; a
-- | number below 1, which never comes to 1, said and the end
report : {e : HFunctor} -> {{lg : logger <: e}} -> List Int -> Co e Int
report ns = do
  let mut most = 0
  for n in ns do
    if n < 1
    then do
      say (show n ^ ": never comes to 1")
      return most
    let s = steps n
    say (show n ^ ": " ^ show s ^ " steps")
    if s > most then most := s
  return most
