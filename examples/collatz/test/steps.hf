-- The steps and the report: a few numbers by hand, a property of every
-- number, and the report's lines, kept by the logger's test handler
-- instead of printed.  `heff test` runs them.

import check
import co
import collatz.logger
import collatz.steps
import generator as Generator

-- (a report, its lines kept: its answer, and what it said)
reported : List Int -> Pair Int (List String)
reported ns = handle kept (report (lg := here logger) ns)

collatz : Test
collatz =
  group
    "collatz"
    [ unit "6 takes 8 steps" (assertEqual (steps 6) 8)
    , unit "27 takes 111" (assertEqual (steps 27) 111)
    , unit
      "a line for each number"
      (assertEqual (snd (reported [6, 7])) ["6: 8 steps", "7: 16 steps"])
    , unit "the most steps" (assertEqual (fst (reported [6, 7])) 16)
    , unit
      "the report stops below 1"
      (assertEqual
         (snd (reported [3, 0, 6]))
         ["3: 7 steps", "0: never comes to 1"])
    , property "an even number takes a step more than its half" (do
        n <- forAll (Generator.int 1 100000)
        assertEqual (steps (2 * n)) (steps n + 1))
    ]
