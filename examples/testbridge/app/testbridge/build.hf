-- main.hf's `main`, compiled through C (by `zig cc`): `heff build` builds
-- it to .heff/bin/testbridge, for the machine it is on.  It does its work
-- on Linux only; its C parts (.heff/build/testbridge/) cross-compile, as
-- `zig cc -target aarch64-linux-musl`.

import manifest

build : Build
build = { backend = C, run = "main" }
