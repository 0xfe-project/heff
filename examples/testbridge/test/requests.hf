-- The requests' bytes, each checked by hand against the kernel's
-- structs: struct nlmsghdr { u32 len; u16 type; u16 flags; u32 seq; u32
-- pid }, struct ifinfomsg { u8 family, pad; u16 type; s32 index; u32
-- flags, change }, struct ifaddrmsg { u8 family, prefixlen, flags, scope;
-- u32 index }, struct rtmsg { u8 family, dst_len, src_len, tos, table,
-- protocol, scope, type; u32 flags }, struct rtattr { u16 len, type },
-- every number little-endian, every attribute padded to 4 bytes.  The
-- flags 05 06 are 0x605: NLM_F_REQUEST 1, NLM_F_ACK 4, NLM_F_EXCL 0x200,
-- NLM_F_CREATE 0x400.

import check
import testbridge.bytes
import testbridge.ip
import testbridge.requests

-- (the lines of a request's bytes, as one)
bytesOf : List String -> String
bytesOf ls = joinWith " " ls

-- fmt: skip
newBridge : String
newBridge = bytesOf
  [ "40 00 00 00  10 00  05 06  01 00 00 00  00 00 00 00"   -- 64 bytes, RTM_NEWLINK, seq 1, port 0
  , "00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00"   -- ifinfomsg, AF_UNSPEC, all 0
  , "10 00 12 00"                                         -- IFLA_LINKINFO, 16 bytes
  , "0a 00 01 00  62 72 69 64 67 65 00 00"                --   IFLA_INFO_KIND "bridge", no NUL, 2 of padding
  , "10 00 03 00  6b 75 62 65 2d 62 72 69 64 67 65 00"    -- IFLA_IFNAME "kube-bridge\0"
  ]

-- fmt: skip
bridgeAddr : String
bridgeAddr = bytesOf
  [ "28 00 00 00  14 00  05 06  02 00 00 00  00 00 00 00"   -- 40 bytes, RTM_NEWADDR, seq 2
  , "02 18 00 00  03 00 00 00"                            -- ifaddrmsg: AF_INET, /24, link 3
  , "08 00 02 00  0a f0 00 01"                            -- IFA_LOCAL 10.240.0.1
  , "08 00 01 00  0a f0 00 01"                            -- IFA_ADDRESS 10.240.0.1
  ]

-- fmt: skip
bridgeUp : String
bridgeUp = bytesOf
  [ "20 00 00 00  10 00  05 00  03 00 00 00  00 00 00 00"   -- 32 bytes, RTM_NEWLINK, REQUEST|ACK, seq 3
  , "00 00 00 00  03 00 00 00  01 00 00 00  01 00 00 00"   -- ifinfomsg: link 3, flags IFF_UP, change IFF_UP
  ]

-- fmt: skip
vethPairBytes : String
vethPairBytes = bytesOf
  [ "74 00 00 00  10 00  05 06  04 00 00 00  00 00 00 00"   -- 116 bytes, RTM_NEWLINK, seq 4
  , "00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00"   -- ifinfomsg, all 0
  , "0d 00 03 00  74 65 73 74 76 65 74 68 00  00 00 00"    -- IFLA_IFNAME "testveth\0", 3 of padding
  , "08 00 0d 00  00 00 00 00"                            -- IFLA_TXQLEN 0
  , "3c 00 12 00"                                         -- IFLA_LINKINFO, 60 bytes
  , "09 00 01 00  76 65 74 68 00  00 00 00"               --   IFLA_INFO_KIND "veth\0"
  , "2c 00 02 00"                                         --   IFLA_INFO_DATA, 44 bytes
  , "28 00 01 00"                                         --     VETH_INFO_PEER, 40 bytes
  , "00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00"   --       ifinfomsg, all 0
  , "09 00 03 00  6b 6e 69 30 00  00 00 00"               --       IFLA_IFNAME "kni0\0"
  , "08 00 0d 00  00 00 00 00"                            --       IFLA_TXQLEN 0
  ]

-- fmt: skip
enslave : String
enslave = bytesOf
  [ "28 00 00 00  13 00  05 00  06 00 00 00  00 00 00 00"   -- 40 bytes, RTM_SETLINK, REQUEST|ACK, seq 6
  , "00 00 13 00  04 00 00 00  01 00 00 00  ff ff ff ff"   -- ifinfomsg: type RTM_SETLINK, link 4, flags 1 (IFF_UP), change ~0
  , "08 00 0a 00  03 00 00 00"                            -- IFLA_MASTER 3
  ]

-- fmt: skip
route : String
route = bytesOf
  [ "2c 00 00 00  18 00  05 06  07 00 00 00  00 00 00 00"   -- 44 bytes, RTM_NEWROUTE, seq 7
  , "02 00 00 00  fe 03 00 01  00 00 00 00"               -- rtmsg: AF_INET, /0, main, boot, universe, unicast
  , "08 00 05 00  0a f0 00 01"                            -- RTA_GATEWAY 10.240.0.1
  , "08 00 04 00  04 00 00 00"                            -- RTA_OIF 4
  ]

-- fmt: skip
lookup : String
lookup = bytesOf
  [ "30 00 00 00  12 00  01 00  01 00 00 00  00 00 00 00"   -- 48 bytes, RTM_GETLINK, REQUEST only, seq 1
  , "00 00 00 00  00 00 00 00  00 00 00 00  00 00 00 00"   -- ifinfomsg, all 0
  , "0d 00 03 00  74 65 73 74 76 65 74 68 00  00 00 00"    -- IFLA_IFNAME "testveth\0"
  ]

-- (the bytes, in hexadecimal, as the lines above have them)
shown : Bytes -> String
shown bs = hex bs

-- (the lines above, their spaces made one)
expected : String -> String
expected s = joinWith " " (words s)

-- (no address)
nowhere : Cidr
nowhere = { ip = [], prefix = 0 }

-- (an address the test writes)
cidr : String -> Cidr
cidr s = either (\_ -> nowhere) (\c -> c) (parseCidr s)

requests : Test
requests =
  group
    "requests"
    [ unit
      "RTM_NEWLINK, a bridge"
      (assertEqual
         showString
         (shown (newLink 1 "kube-bridge" "bridge"))
         (expected newBridge))
    , unit
      "RTM_NEWADDR"
      (assertEqual
         showString
         (shown (newAddr 2 3 (cidr "10.240.0.1/24")))
         (expected bridgeAddr))
    , unit
      "RTM_NEWLINK, up"
      (assertEqual showString (shown (linkUp 3 3)) (expected bridgeUp))
    , unit
      "RTM_NEWLINK, a veth pair"
      (assertEqual
         showString
         (shown (vethPair 4 "testveth" "kni0" 0))
         (expected vethPairBytes))
    , unit
      "RTM_SETLINK, a master"
      (assertEqual showString (shown (setMaster 6 4 3)) (expected enslave))
    , unit
      "RTM_NEWROUTE, a default route"
      (assertEqual
         showString
         (shown (defaultRoute 7 [10, 240, 0, 1] 4))
         (expected route))
    , unit
      "RTM_GETLINK, by name"
      (assertEqual showString (shown (getLink 1 "testveth")) (expected lookup))
    ]
