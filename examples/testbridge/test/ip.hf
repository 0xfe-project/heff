-- Addresses and CIDRs, as Go's net.ParseCIDR reads them: what is
-- written is read back, a network is its address with the bits past its
-- prefix 0, and what is not an address is said so.

module test.ip

import check
import co
import generator as Generator
import testbridge.bytes
import testbridge.ip

showCidrOr : Either String Cidr -> String
showCidrOr (Left why) = why
showCidrOr (Right c) = showCidr c

-- (a CIDR drawn, shown as it is written)
instance instanceShowCidr : Show Cidr
instanceShowCidr = { show = showCidr }

-- (an address and a prefix, drawn: shrinks to 0.0.0.0/0)
anyCidr : Generator.Generator Cidr
anyCidr =
  Generator.bind
    (Generator.pair
       (Generator.pair (Generator.int 0 255) (Generator.int 0 255))
       (Generator.pair (Generator.int 0 255) (Generator.int 0 255)))
    (\p ->
       Generator.map
         (\n ->
            ({ ip = [fst (fst p), snd (fst p), fst (snd p), snd (snd p)]
             , prefix = n
             } :
               Cidr))
         (Generator.int 0 32))

-- (an address as one number, its first byte the most significant)
number : Bytes -> Int
number ip = le (List.reverse ip)

ips : Test
ips =
  group
    "ip"
    [ unit
      "10.240.0.1/24"
      (assertEqual (showCidrOr (parseCidr "10.240.0.1/24")) "10.240.0.1/24")
    , unit
      "its network"
      (assertEqual
         (either
            (\e -> e)
            (\c -> showIp (network c))
            (parseCidr "10.240.0.1/24"))
         "10.240.0.0")
    , unit
      "its address's bytes, as an attribute has them"
      (assertEqual
         (either
            (\e -> e)
            (\(c : Cidr) -> hex c.ip)
            (parseCidr "10.240.0.1/24"))
         "0a f0 00 01")
    , unit
      "not an address"
      (assertEqual
         (showCidrOr (parseCidr "10.240.0.1/24/8"))
         "invalid CIDR address: 10.240.0.1/24/8")
    , property "written, then read" (do
        c <- forAll anyCidr
        assertEqual (showCidrOr (parseCidr (showCidr c))) (showCidr c))
    , property "a network is its address, the bits past its prefix 0" (do
        c <- forAll anyCidr
        label
            (if c.prefix == 0 || c.prefix == 32 then "no prefix, or all"
             else "a prefix")
        assert
            "the network's bits past the prefix are 0"
            (number (network c) % pow2 (32 - c.prefix) == 0)
        assert
            "the address is in the network"
            (0 <= number c.ip - number (network c)
             && number c.ip - number (network c) < pow2 (32 - c.prefix)))
    ]
