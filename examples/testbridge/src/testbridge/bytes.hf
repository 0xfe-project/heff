-- Bytes as the kernel reads and writes them.  A byte is an `Int` from 0
-- to 255 and a buffer is a `List Int`: built by putting pieces one
-- after another, read by taking from its front, which is what a list
-- does.
--
-- The kernel's structs are in the host's byte order, and the hosts this
-- program is for, x86_64 and aarch64 Linux, are little-endian: the least
-- significant byte first.  (The addresses in an attribute are in the
-- network's order, big-endian, as written: 10.240.0.1 is 10, 240, 0, 1.)

import prelude

-- | a buffer: each element a byte, 0 to 255
type Bytes = List Int

-- | the pieces, one after another
cat : List Bytes -> Bytes
cat xss = concatMap id xss

-- | `n`, as one byte
u8 : Int -> Bytes
u8 n = [n % 256]

-- | `n`, as two bytes, little-endian
u16 : Int -> Bytes
u16 n = [n % 256, n / 256 % 256]

-- | `n`, as four bytes, little-endian (a negative one as two's
-- | complement: `%` takes the divisor's sign)
u32 : Int -> Bytes
u32 n = [n % 256, n / 256 % 256, n / 65536 % 256, n / 16777216 % 256]

-- >>> u32 1541
-- [5, 6, 0, 0]
-- >>> u32 (0 - 1)
-- [255, 255, 255, 255]

-- | the number the bytes are, little-endian
le : Bytes -> Int
le bs = foldr (\b acc -> b + 256 * acc) 0 bs

-- | the unsigned number of `n` bytes at `i`
at : Int -> Int -> Bytes -> Int
at n i bs = le (take n (drop i bs))

-- | an unsigned 32-bit number read as a signed one
signed32 : Int -> Int
signed32 n = if n >= 2147483648 then n - 4294967296 else n

-- >>> at 4 0 (u32 (0 - 17))
-- 4294967279
-- >>> signed32 (at 4 0 (u32 (0 - 17)))
-- -17

-- | `n` rounded up to a multiple of 4 (NLMSG_ALIGN, RTA_ALIGN)
align : Int -> Int
align n = (n + 3) / 4 * 4

-- | the zeros that bring `n` bytes up to a multiple of 4
padding : Int -> Bytes
padding n = replicate (align n - n) 0

-- | an ASCII string's bytes (an interface's name is ASCII)
ascii : String -> Bytes
ascii s = map (charCode s) (range 0 (strLength s - 1))

-- | ... with a NUL after them, as C's strings have
cstring : String -> Bytes
cstring s = concatList (ascii s) [0]

-- (the bytes before the first NUL)
beforeNul : Bytes -> Bytes
beforeNul Nil = Nil
beforeNul (Cons b rest) = if b == 0 then Nil else Cons b (beforeNul rest)

-- | the string a C string's bytes are, to its NUL
text : Bytes -> String
text bs = foldl (\s b -> s ++ fromCharCode b) "" (beforeNul bs)

-- >>> text (cstring "kni0")
-- "kni0"

-- (a digit of a hexadecimal number)
hexDigit : Int -> String
hexDigit d = strSlice "0123456789abcdef" d (d + 1)

-- | the bytes in hexadecimal, a space between each two: what a test
-- | holds a request to, and what `xxd` shows
hex : Bytes -> String
hex bs = joinWith " " (map (\b -> hexDigit (b / 16) ++ hexDigit (b % 16)) bs)

-- >>> hex (u16 1541)
-- "05 06"
