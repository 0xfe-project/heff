-- IPv4 addresses, and a CIDR's: Go's net.ParseIP and net.ParseCIDR, for
-- the four-byte addresses this program has.  An address is its four
-- bytes, in the network's order (as an attribute carries it).

import int as I
import testbridge.bytes

-- | an address with the length of its network's prefix: `10.240.0.1/24`
-- | (the address as written; `network` is its network's)
type Cidr = { ip : Bytes, prefix : Int }

-- (a byte of an address: 1 to 3 digits, at most 255)
octet : String -> Maybe Int
octet s =
  if strLength s < 1 || strLength s > 3 || startsWith "-" s then Nothing
  else maybe Nothing (\n -> if n <= 255 then Just n else Nothing) (parseInt s)

-- (the bytes, if each is one)
octets : List String -> Maybe Bytes
octets Nil = Just Nil
octets (Cons s rest) =
  maybe
    Nothing
    (\b -> maybe Nothing (\bs -> Just (Cons b bs)) (octets rest))
    (octet s)

-- | an address written `a.b.c.d`, if `s` is one (net.ParseIP)
parseIp : String -> Maybe Bytes
parseIp s =
  if List.length (split "." s) == 4 then octets (split "." s) else Nothing

-- >>> parseIp "10.240.0.1"
-- Just [10, 240, 0, 1]
-- >>> parseIp "10.240.0.256"
-- Nothing
-- >>> parseIp "10.240.0"
-- Nothing

-- (a prefix's length: 0 to 32)
prefixLen : String -> Maybe Int
prefixLen s =
  if strLength s < 1 || startsWith "-" s then Nothing
  else maybe Nothing (\n -> if n <= 32 then Just n else Nothing) (parseInt s)

-- (the address and the prefix, if both are there)
cidrOf : Maybe Bytes -> Maybe Int -> Maybe Cidr
cidrOf (Just ip) (Just n) = Just { ip = ip, prefix = n }
cidrOf _ _ = Nothing

-- (an address and a prefix, split at the `/`)
cidrParts : String -> List String -> Either String Cidr
cidrParts s [a, n] =
  maybe
    (Left ("invalid CIDR address: " ^ s))
    (\c -> Right c)
    (cidrOf (parseIp a) (prefixLen n))
cidrParts s _ = Left ("invalid CIDR address: " ^ s)

-- | an address and its prefix, `a.b.c.d/n`, or why `s` is not one
-- | (net.ParseCIDR, its error as Go says it)
parseCidr : String -> Either String Cidr
parseCidr s = cidrParts s (split "/" s)

-- | an address as it is written
showIp : Bytes -> String
showIp ip = joinWith "." (List.map showInt ip)

-- (2 to the `n`)
pow2 : Int -> Int
pow2 n = shiftL 1 (max 0 n)

-- (the byte `i` of an address, its bits past the prefix `n` cleared: its
-- low `8 - (n - 8 * i)` bits, none to all eight)
masked : Int -> Int -> Int -> Int
masked n i b = and b (shiftL -1 (8 - max 0 (min 8 (n - 8 * i))))

-- | the address's network: the bits past the prefix cleared (what Go's
-- | ParseCIDR gives as its IPNet's IP)
network : Cidr -> Bytes
network c = List.zipWith (masked c.prefix) (List.range 0 3) c.ip

-- | an address and prefix as written
showCidr : Cidr -> String
showCidr c = showIp c.ip ^ "/" ^ showInt c.prefix

-- >>> either (\e -> e) showCidr (parseCidr "10.240.0.1/24")
-- "10.240.0.1/24"
-- >>> either (\e -> e) (\c -> showIp (network c)) (parseCidr "10.240.0.1/24")
-- "10.240.0.0"
-- >>> either (\e -> e) (\c -> showIp (network c)) (parseCidr "10.240.0.130/25")
-- "10.240.0.128"
-- >>> either (\e -> e) showCidr (parseCidr "10.240.0.1/33")
-- "invalid CIDR address: 10.240.0.1/33"
-- >>> either (\e -> e) showCidr (parseCidr "10.240.0.1")
-- "invalid CIDR address: 10.240.0.1"
