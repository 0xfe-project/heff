-- The world's side of testbridge, as thin as it goes: a socket's POSIX
-- calls as an effect, each as the system has it -- its
-- arguments plain numbers and bytes, its answer what the call returns
-- (`Right`), or the errno it failed with (`Left`).  What the numbers
-- mean is the program's (testbridge.netlink has the constants), so the
-- C side (sys.provider.c) knows nothing of netlink, and compiles on any
-- POSIX system.  A socket is its file descriptor, an `Int`: the
-- kernel's number for it, in the kernel's table already -- not a
-- std.handle `Handle`, the world's number for a thing it holds, which
-- would hold a number for a number; and a descriptor closed, or never
-- opened, is EBADF, an errno as any other.

import co
import testbridge.bytes

data SysF (m : Type -> Type) x
  = Socket Int Int Int (Either Int Int -> x)
  | Send Int Bytes (Either Int Int -> x)
  | Recv Int Int (Either Int Bytes -> x)
  | Close Int (Either Int Unit -> x)

-- | A socket's calls, as an effect.
sys : HFunctor
sys =
  { f = SysF
  , hfmap = \m g p -> case p of
      Socket d t pr k -> Socket d t pr (\r -> g (k r))
      Send fd bs k -> Send fd bs (\r -> g (k r))
      Recv fd n k -> Recv fd n (\r -> g (k r))
      Close fd k -> Close fd (\r -> g (k r))
  , hmap = \m n nt p -> case p of
      Socket d t pr k -> Socket d t pr k
      Send fd bs k -> Send fd bs k
      Recv fd n k -> Recv fd n k
      Close fd k -> Close fd k
  }

-- | socket(domain, type, protocol): a new socket's descriptor
socket : {e : HFunctor}
       -> {{ev : sys <: e}}
       -> Int
       -> Int
       -> Int
       -> Co e (Either Int Int)
socket d t pr = op (ev (Socket d t pr (\r -> r))) val

-- | send(fd, bytes, 0): how many of the bytes were sent
send : {e : HFunctor}
     -> {{ev : sys <: e}}
     -> Int
     -> Bytes
     -> Co e (Either Int Int)
send fd bs = op (ev (Send fd bs (\r -> r))) val

-- | recv(fd, buffer, max, 0): a datagram, its first `max` bytes at most
recv : {e : HFunctor}
     -> {{ev : sys <: e}}
     -> Int
     -> Int
     -> Co e (Either Int Bytes)
recv fd n = op (ev (Recv fd n (\r -> r))) val

-- | close(fd)
close : {e : HFunctor} -> {{ev : sys <: e}} -> Int -> Co e (Either Int Unit)
close fd = op (ev (Close fd (\r -> r))) val
