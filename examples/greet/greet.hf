-- A greeting, written into a page that is already there: the input and the
-- paragraph are index.html's, found by a CSS selector and by an XPath.
-- `npm run examples` builds greet.js; then open index.html.

import co
import dom
import prelude
import state

greeting : String -> String
greeting name =
  if strEq name "" then "Hello, whoever you are." else "Hello, " ++ name ++ "!"

greet : Co (dom <+> (state Unit)) Unit
greet = do
  out <- xpath "//p[@id='greeting']"
  name <- select "#name"
  found out (\o -> do
    text o (greeting "")
    found name (\n -> on n "input" (\v -> text o (greeting v))))
