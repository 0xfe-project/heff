-- A greeting, written into a page that is already there: the input and the
-- paragraph are the page's own, found by a CSS selector and by an XPath.
-- The examples' build makes its script; its page opens beside it.

import co
import browser.dom

greeting : String -> String
greeting name =
  if strEq name "" then "Hello, whoever you are." else "Hello, " ^ name ^ "!"

program : {{page : dom <: dom}} -> Co dom Unit
program = do
  out <- xpath "//p[@id='greeting']"
  name <- select "#name"
  found out (\o -> do
    text o (greeting "")
    found name (\n -> on n "input" (\v -> text o (greeting v))))

-- the page is the only world here: its evidence, given
greet : Co dom Unit
greet = program (page := here dom)
