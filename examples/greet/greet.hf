-- A greeting, written into a page that is already there: the input and the
-- paragraph are index.html's, found by a CSS selector and by an XPath.
-- `npm run examples` builds greet.js; then open index.html.

import co
import dom
import prelude

greeting : String -> String
greeting name =
  if strEq name "" then "Hello, whoever you are." else "Hello, " ++ name ++ "!"

-- the page is the only world here: its evidence, said once
page : (dom <: dom)
page = here dom

greet : Co dom Unit
greet = do
  out <- xpath page "//p[@id='greeting']"
  name <- select page "#name"
  found out (\o -> do
    text page o (greeting "")
    found name (\n -> on page n "input" (\v -> text page o (greeting v))))
