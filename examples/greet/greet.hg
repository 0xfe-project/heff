-- A greeting, written into a page that is already there: the input and the
-- paragraph are index.html's, found by a CSS selector and by an XPath.
-- Open index.html; `npm run examples` builds greet.js again.

import co
import dom
import prelude
import state

greeting :: String -> String
greeting name = if strEq name "" then "Hello, whoever you are." else "Hello, " ++ name ++ "!"

-- | Go on with an element, if it was found.
found :: {s :: Type} -> Maybe Int -> (Int -> Co (plus dom (state s)) Unit) -> Co (plus dom (state s)) Unit
found Nothing _ = pure MkUnit
found (Just n) k = k n

greet :: Co (plus dom (state Unit)) Unit
greet = do
  out <- xpath "//p[@id='greeting']"
  name <- select "#name"
  found out (\o -> do
    text o (greeting "")
    found name (\n -> on n "input" (\v -> text o (greeting v))))
