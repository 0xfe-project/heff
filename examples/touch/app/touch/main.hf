-- The program touch: each path given made an empty file, where nothing
-- is; a path that cannot be made is said, and touch fails.
--
--   touch PATH...

module app.touch.main

import co
import std.io
import std.filesystem
import std.file as File
import std.path
import exception
import std.process as Process

touched : {e : HFunctor}
        -> {{fs : filesystem <: e}}
        -> {{ex : exception FileError <: e}}
        -> Path
        -> Co e Unit
touched p = do
  if <- exists p
  then pure ()
  else do
    f <- File.open (access := Write {}) p
    File.close f

allTouched : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> {{fs : filesystem <: e}}
           -> List String
           -> Co e Bool
allTouched paths = do
  oks <- for x in paths do
    case <- attempt FileError (touched (fs := _) (ex := _) x) of
      Right () -> pure True
      Left err -> do
        printErr ("touch: " ^ show err)
        pure False
  pure (List.all (\ok -> ok) oks)

main : Co (stdio <+> filesystem <+> Process.process) Unit
main = do
  paths <- Process.args
  if paths == []
  then do
    printErr "touch: missing file operand"
    Process.exit 1
  else do
    ok <- allTouched paths
    if ok then pure ()
    else Process.exit 1
