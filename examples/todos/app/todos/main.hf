module app.todos.main

import co
import todos.cursor
import todos.todo
import todos.tree
import std.io
import std.terminal as Terminal
import std.terminal.widget as Widget

toggle : Todo -> Todo
toggle t = if pending t.status then finish t else { t | status = Open }

-- | what a key does at the cursor
act : {e : HFunctor} -> {{cur : cursor <: e}} -> Widget.Key -> Co e Unit
act ArrowRight = do
  _ <- down
  pure MkUnit
act ArrowLeft = do
  _ <- up
  pure MkUnit
act ArrowDown = do
  _ <- next
  pure MkUnit
act (Char ' ') = change toggle
act _ = pure MkUnit

step : Widget.Key -> Zipper Todo -> Widget.Step (Zipper Todo) (List (Tree Todo))
step (Char 'q') z = Done (forest z)
step k z = Continue (runCursor (act (cur := here cursor) k) z)

-- (each tree's rows, the one in focus shown inverse)
rowsOf : Int -> Tree (Pair Bool Todo) -> List Widget.Row
rowsOf depth (Node (MkPair on t) cs) =
  [shown (joinWith "" (List.replicate depth "  ") ^ toString t)]
  :: List.concatMap (rowsOf (depth + 1)) cs
  where
  shown : String -> Widget.Span
  shown s = if on then Widget.inverse s else Widget.plain s

unmarked : Tree Todo -> Tree (Pair Bool Todo)
unmarked t = mapTree (\x -> MkPair False x) t

unmarkedCrumb : Crumb Todo -> Crumb (Pair Bool Todo)
unmarkedCrumb c =
  { before = List.map unmarked c.before
  , parent = MkPair False c.parent
  , after = List.map unmarked c.after
  }

-- | all the trees, the one in focus marked
marked : Zipper Todo -> List (Tree (Pair Bool Todo))
marked z =
  forest
    { focus = case z.focus of
        Node x cs -> Node (MkPair True x) (List.map unmarked cs)
    , before = List.map unmarked z.before
    , after = List.map unmarked z.after
    , path = List.map unmarkedCrumb z.path
    }

view : Widget.Size -> Zipper Todo -> Widget.Frame
view size z =
  { rows =
      Widget.fill (size.rows - 1) (List.concatMap (rowsOf 0) (marked z))
      ++ [Widget.status size.columns "→ in  ← out  ↓ next  space done  q quit"]
  , cursor = Nothing
  }

start : Zipper Todo
start =
  { focus =
      Node
        (todo "write the tutorial")
        [Node (todo "chapter 4") [], Node (todo "chapter 5") []]
  , before = []
  , after = [Node (todo "read the reference") []]
  , path = []
  }

app : Widget.App (Zipper Todo) (List (Tree Todo))
app = { start = start, step = step, view = view }

program : {e : HFunctor}
        -> {{con : Terminal.console <: e}}
        -> {{io : stdio <: e}}
        -> Co e Unit
program = do
  r <- Terminal.interact app
  case r of
    Just ts ->
      print
        (joinWith
           "\n"
           (List.map
              Widget.rowText
              (List.concatMap (rowsOf 0) (List.map unmarked ts))))
    Nothing -> pure MkUnit

main : Co (Terminal.console <+> stdio) Unit
main = program (con := \p -> InL p) (io := \p -> InR p)
