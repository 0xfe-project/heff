-- The app on keys given, as std.terminal.widget's `shownAfter` runs it:
-- what it shows after them.

module test.app

import app.todos.main as Main
import check
import std.terminal.widget as Widget

-- | down to the second todo, and marked done
marked : Test
marked =
  unit
    "a todo marked done"
    (assertEqual
       (Widget.shownAfter
          Main.app
          { columns = 30, rows = 5 }
          [ArrowDown, Char ' '])
       [ "[ ] write the tutorial"
       , "[x] read the reference"
       , "[ ] test the examples"
       , ""
       , "↑↓ move  space done  q quit   "
       ])
