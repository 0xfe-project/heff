-- The app on keys given, as std.terminal.widget's `shownAfter` runs it:
-- what it shows after them.

module test.app

import app.todos.main as Main
import check
import std.terminal.widget as Widget

-- | into the first todo, to its second subtask, and marked done
marked : Test
marked =
  unit
    "a subtask marked done"
    (assertEqual
       (Widget.shownAfter
          Main.app
          { columns = 40, rows = 6 }
          [ArrowRight, ArrowDown, Char ' '])
       [ "[ ] write the tutorial"
       , "  [ ] chapter 4"
       , "  [x] chapter 5"
       , "[ ] read the reference"
       , ""
       , "→ in  ← out  ↓ next  space done  q quit "
       ])
