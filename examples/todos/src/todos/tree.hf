module todos.tree

-- | a value and the trees under it
data Tree a = Node a (List (Tree a))

label : {a : Type} -> Tree a -> a
label (Node x cs) = x

relabel : {a : Type} -> (a -> a) -> Tree a -> Tree a
relabel f (Node x cs) = Node (f x) cs

mapTree : {a b : Type} -> (a -> b) -> Tree a -> Tree b
mapTree f (Node x cs) = Node (f x) (List.map (mapTree f) cs)

-- | one level up from the focus: the trees before it (nearest first),
-- | the value above it, and the trees after it
type Crumb a = { before : List (Tree a), parent : a, after : List (Tree a) }

-- | a list of trees, one of them in focus
type Zipper a =
  { focus : Tree a
  , before : List (Tree a)
  , after : List (Tree a)
  , path : List (Crumb a)
  }

downZ : {a : Type} -> Zipper a -> Maybe (Zipper a)
downZ z = case z.focus of
  Node x [] -> Nothing
  Node x (c :: cs) ->
    Just
      { focus = c
      , before = []
      , after = cs
      , path = { before = z.before, parent = x, after = z.after } :: z.path
      }

prevZ : {a : Type} -> Zipper a -> Maybe (Zipper a)
prevZ z = case z.before of
  [] -> Nothing
  n :: rest -> Just { z | focus = n, before = rest, after = z.focus :: z.after }

nextZ : {a : Type} -> Zipper a -> Maybe (Zipper a)
nextZ z = case z.after of
  [] -> Nothing
  n :: rest ->
    Just { z | focus = n, before = z.focus :: z.before, after = rest }

upZ : {a : Type} -> Zipper a -> Maybe (Zipper a)
upZ z = case z.path of
  [] -> Nothing
  c :: ps ->
    Just
      { focus = Node c.parent (List.reverse z.before ++ (z.focus :: z.after))
      , before = c.before
      , after = c.after
      , path = ps
      }

-- | all the trees, the focus put back
forest : {a : Type} -> Zipper a -> List (Tree a)
forest z = case upZ z of
  Just p -> forest p
  Nothing -> List.reverse z.before ++ (z.focus :: z.after)
