-- A counter.  Open index.html; `npm run examples` builds counter.js again.

import co
import dom
import prelude
import state

showCount :: Int -> String
showCount n = "count: " ++ showInt n

increment :: Int -> Co (plus dom (state Int)) Unit
increment label = do
  n <- get
  put (n + 1)
  text label (showCount (n + 1))

counter :: Co (plus dom (state Int)) Unit
counter = do
  put 0
  r <- root
  label <- textIn r "p" (showCount 0)
  b <- textIn r "button" "+1"
  on b "click" (\_ -> increment label)
