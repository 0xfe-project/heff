-- A counter, in the page's `#counter`.  `npm run examples` builds counter.js; then open index.html.

import co
import dom
import prelude
import state

showCount : Int -> String
showCount n = "count: " ++ showInt n

increment : Node -> Co (dom <+> (state Int)) Unit
increment label = do
  n <- get
  put (n + 1)
  text label (showCount (n + 1))

decrement : Node -> Co (dom <+> (state Int)) Unit
decrement label = do
  n <- get
  put (n - 1)
  text label (showCount (n - 1))

counter : Co (dom <+> (state Int)) Unit
counter = do
  put 0
  place <- select "#counter"
  found place (\r -> do
    label <- textIn r "p" (showCount 0)
    iBtn <- textIn r "button" "+1"
    on iBtn "click" (\_ -> increment label)
    dBtn <- textIn r "button" "-1"
    on dBtn "click" (\_ -> decrement label))
