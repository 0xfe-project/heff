-- A counter, in the page's `#counter`.  Each click is a run of its own,
-- so the count lives in the world between them: a cell (std.reference),
-- made with its first value.  `node examples/build.mjs` builds it to
-- .heff/examples/counter/: open its index.html there.

import co
import browser.dom
import std.reference

world : HFunctor
world = dom <+> (reference Int)

showCount : Int -> String
showCount n = "count: " ^ show n

increment : {e : HFunctor}
          -> {{page : dom <: e}}
          -> {{cell : reference Int <: e}}
          -> Reference Int
          -> Node
          -> Co e Unit
increment count label = do
  n <- readReference count
  writeReference count (n + 1)
  text label (showCount (n + 1))

decrement : {e : HFunctor}
          -> {{page : dom <: e}}
          -> {{cell : reference Int <: e}}
          -> Reference Int
          -> Node
          -> Co e Unit
decrement count label = do
  n <- readReference count
  writeReference count (n - 1)
  text label (showCount (n - 1))

program : {e : HFunctor}
        -> {{page : dom <: e}}
        -> {{cell : reference Int <: e}}
        -> Co e Unit
program = do
  count <- newReference 0
  place <- select "#counter"
  found place (\r -> do
    label <- textIn r "p" (showCount 0)
    iBtn <- textIn r "button" "+1"
    on iBtn "click" (\_ -> increment count label)
    dBtn <- textIn r "button" "-1"
    on dBtn "click" (\_ -> decrement count label))

-- where the world is: each sub-effect's evidence, given
counter : Co world Unit
counter =
  program (page := inl dom (reference Int)) (cell := inr dom (reference Int))
