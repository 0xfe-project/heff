-- A counter, in the page's `#counter`.  Each click is a run of its own,
-- so the count lives in the world between them: a cell (std.ref),
-- made with its first value.  `node examples/build.mjs` builds counter.js;
-- then open index.html.

import co
import prelude
import std.dom
import std.ref

world : HFunctor
world = dom <+> (ref Int)

showCount : Int -> String
showCount n = "count: " ++ showInt n

increment : {e : HFunctor}
          -> {{page : dom <: e}}
          -> {{cell : ref Int <: e}}
          -> Ref Int
          -> Node
          -> Co e Unit
increment count label = do
  n <- readRef count
  writeRef count (n + 1)
  text label (showCount (n + 1))

decrement : {e : HFunctor}
          -> {{page : dom <: e}}
          -> {{cell : ref Int <: e}}
          -> Ref Int
          -> Node
          -> Co e Unit
decrement count label = do
  n <- readRef count
  writeRef count (n - 1)
  text label (showCount (n - 1))

program : {e : HFunctor}
        -> {{page : dom <: e}}
        -> {{cell : ref Int <: e}}
        -> Co e Unit
program = do
  count <- newRef 0
  place <- select "#counter"
  found place (\r -> do
    label <- textIn r "p" (showCount 0)
    iBtn <- textIn r "button" "+1"
    on iBtn "click" (\_ -> increment count label)
    dBtn <- textIn r "button" "-1"
    on dBtn "click" (\_ -> decrement count label))

-- where the world is: each sub-effect's evidence, given
counter : Co world Unit
counter = program (page := inl dom (ref Int)) (cell := inr dom (ref Int))
