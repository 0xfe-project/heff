-- A counter, in the page's `#counter`.  Each click is a run of its own,
-- so the count lives in the world between them: a cell (lib/ref.hf),
-- made with its first value.  `npm run examples` builds counter.js;
-- then open index.html.

import co
import dom
import prelude
import ref

world : HFunctor
world = dom <+> (ref Int)

-- the evidence, once per world (as test/node/echo.hf's)
page : (dom <: world)
page = inl dom (ref Int)

cell : (ref Int <: world)
cell = inr dom (ref Int)

-- the program's own theory of its world: evidence paid once, here
type CounterM =
  { select : String -> Co world (Maybe Node)
  , textIn : Node -> String -> String -> Co world Node
  , text : Node -> String -> Co world Unit
  , on : Node -> String -> (String -> Co world Unit) -> Co world Unit
  , newRef : Int -> Co world (Ref Int)
  , readRef : Ref Int -> Co world Int
  , writeRef : Ref Int -> Int -> Co world Unit
  }

counterM : CounterM
counterM =
  { select = select page
  , textIn = textIn page
  , text = text page
  , on = on page
  , newRef = newRef cell
  , readRef = readRef cell
  , writeRef = writeRef cell
  }

showCount : Int -> String
showCount n = "count: " ++ showInt n

increment : Ref Int -> Node -> Co world Unit
increment count label = do
  n <- counterM.readRef count
  counterM.writeRef count (n + 1)
  counterM.text label (showCount (n + 1))

decrement : Ref Int -> Node -> Co world Unit
decrement count label = do
  n <- counterM.readRef count
  counterM.writeRef count (n - 1)
  counterM.text label (showCount (n - 1))

counter : Co world Unit
counter = do
  count <- counterM.newRef 0
  place <- counterM.select "#counter"
  found place (\r -> do
    label <- counterM.textIn r "p" (showCount 0)
    iBtn <- counterM.textIn r "button" "+1"
    counterM.on iBtn "click" (\_ -> increment count label)
    dBtn <- counterM.textIn r "button" "-1"
    counterM.on dBtn "click" (\_ -> decrement count label))
