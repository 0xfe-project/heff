-- The notes' server: the API (notes.api) answered at `/api`, by its real
-- handler, the notes in a cell of the world; the page at `/`, and its
-- script at `/client.js`, as `heff build` makes it.  Each connection is
-- a thread of its own, cml's, waiting on the world through each domain's
-- reactor.  Run from the project's root:
--
--   .heff/bin/server [PORT]      (8080 where none is given)

module app.server.main

import bytes as Bytes
import co
import exception
import cml as CML
import notes.api
import std.filesystem
import std.http as HTTP
import std.http.server as Server
import std.io
import std.net as Net
import std.path as Path
import std.domain as Domain
import std.process
import std.reactor as Reactor
import std.reference
import std.remote as RemoteHTTP
import resource

-- (the notes kept, read)
notesIn : {e : HFunctor}
        -> {{cell : reference (List Note) <: e}}
        -> Reference (List Note)
        -> Co e (List Note)
notesIn r = readReference r

-- (the notes kept, changed by `f`: what it says of them)
changed : {e : HFunctor}
        -> {{cell : reference (List Note) <: e}}
        -> {b : Type}
        -> Reference (List Note)
        -> (List Note -> Pair b (List Note))
        -> Co e b
changed r f = do
  ns <- notesIn r
  let p = f ns
  writeReference r (snd p)
  pure (fst p)

-- | The API's real handler: the notes in the cell.
kept : {e : HFunctor}
     -> {{cell : reference (List Note) <: e}}
     -> Reference (List Note)
     -> {a : Type}
     -> NotesF (Co e) a
     -> Co e a
kept r (Add t k) = bind (changed r (added t)) (\n -> pure (k n))
kept r (Toggle i k) = bind (changed r (toggled i)) (\ok -> pure (k ok))
kept r (Every k) = bind (notesIn r) (\ns -> pure (k ns))

-- (a file of the project's, of a kind: 404 where there is none)
file : {e : HFunctor}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> String
     -> String
     -> Co e HTTP.Response
file path kind =
  recover
    (bind
       (readFile path)
       (\body ->
          pure
            { status = 200
            , headers = [MkPair "Content-Type" kind]
            , body = Bytes.fromString body
            }))
    (\(_ : FileError) ->
       pure (Server.plain 404 ("no " ^ path ^ ": build the client first\n")))

-- (the page, and its script, by their paths)
pageAt : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> String
       -> Co e HTTP.Response
pageAt "/" = file "app/client/index.html" "text/html; charset=utf-8"
pageAt "/client.js" =
  file ".heff/bin/client.js" "text/javascript; charset=utf-8"
pageAt _ = pure (Server.plain 404 "no such page\n")

-- (what is not the API's: the page)
page : {e : HFunctor}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> Server.Request
     -> Co e HTTP.Response
page r = pageAt (RemoteHTTP.pathOf r.target)

-- (cml's threads, as std.http.server's `serveConcurrently` asks: a
-- signal an ivar)
threads : {e w : HFunctor} -> {{cm : CML.cml w <: e}} -> Server.Threads e
threads =
  { spawn = \c -> CML.spawn c
  , Signal = CML.IVar w Unit
  , signal = CML.newIVar
  , give = \sg -> CML.putIVar sg MkUnit
  , awaited = \sg -> CML.readIVar sg
  }

-- (the listener's connections served, each a thread of its own, until
-- one cannot be accepted)
listening : {e w : HFunctor}
          -> {s : Type}
          -> {{cm : CML.cml w <: e}}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> {{disk : filesystem <: e}}
          -> {{fx : exception FileError <: e}}
          -> {{cell : reference (List Note) <: e}}
          -> Reference (List Note)
          -> With s Net.TcpListener
          -> Co e Unit
listening r l = do
  at <- Net.local l
  print
      ("listening on http://127.0.0.1:"
       ^ either (\err -> "?") (\(a : Net.Address) -> debug a.port) at)
  Server.serveConcurrently
      (th := threads)
      l
      (RemoteHTTP.routed "/api" notesApi (kept r) page)
  printErr "server: a connection could not be accepted"

-- (the port the arguments say, 8080 where they say none)
portOf : List String -> Int
portOf (p :: rest) = fromMaybe 8080 (parseInt p)
portOf Nil = 8080

program : {e w : HFunctor}
        -> {{cm : CML.cml w <: e}}
        -> {{io : stdio <: e}}
        -> {{nt : Net.net <: e}}
        -> {{sys : process <: e}}
        -> {{disk : filesystem <: e}}
        -> {{fx : exception FileError <: e}}
        -> {{cell : reference (List Note) <: e}}
        -> {{ex : exception Net.NetError <: e}}
        -> Co e Unit
program = do
  argv <- args
  let port = portOf argv
  r <- newReference (Nil : List Note)
  try
    Net.withListener { host = "127.0.0.1", port = port } 128 (listening r)
  catch (err : Net.NetError) ->
    printErr ("server: cannot listen: " ^ show err)

-- (the throws heard inside the schedule, before the threads are made
-- of it: a `try` of the program's then holds its spawns)
main : Co
       (stdio
        <+> Net.net
        <+> Reactor.reactor
        <+> process
        <+> filesystem
        <+> reference (List Note)
        <+> Domain.domain)
       Unit
main = do
  done <-
    CML.scheduledWithReactor
      (dm := _)
      (rx := _)
      (attempt
         Net.NetError
         (attempt
            FileError
            (program
               (w := stdio
               <+> Net.net
               <+> Reactor.reactor
               <+> process
               <+> filesystem
               <+> reference (List Note)
               <+> Domain.domain)
               (cm := _)
               (io := _)
               (nt := _)
               (sys := _)
               (disk := _)
               (fx := _)
               (cell := _)
               (ex := _))))
  pure MkUnit
