-- The notes' server: the API (notes.api) answered at `/api`, by its real
-- handler, the notes in a cell of the world; the page at `/`, and its
-- script at `/client.js`, as `heff build` makes it.  Served by
-- std.http.bocserver, on boc's pool: each request a behaviour on its
-- connection's cown, each wait an act awaited in a worker's reactor.  Run from the project's root:
--
--   .heff/bin/server [PORT]      (8080 where none is given)

module app.server.main

import boc as BOC
import bytes as Bytes
import co
import custodian as Custodian
import exception
import notes.api
import std.filesystem
import std.http as HTTP
import std.http.bocserver as BocServer
import std.http.server as Server
import std.io
import std.net as Net
import std.path as Path
import std.process
import std.reference
import std.remote as RemoteHTTP
import std.time as Time
import resource

-- (the notes kept, read)
notesIn : {e : HFunctor}
        -> {{cell : reference (List Note) <: e}}
        -> Reference (List Note)
        -> Co e (List Note)
notesIn r = readReference r

-- (the notes kept, changed by `f`: what it says of them)
changed : {e : HFunctor}
        -> {{cell : reference (List Note) <: e}}
        -> {b : Type}
        -> Reference (List Note)
        -> (List Note -> Pair b (List Note))
        -> Co e b
changed r f = do
  ns <- notesIn r
  let p = f ns
  writeReference r (snd p)
  pure (fst p)

-- | The API's real handler: the notes in the cell.
kept : {e : HFunctor}
     -> {{cell : reference (List Note) <: e}}
     -> Reference (List Note)
     -> {a : Type}
     -> NotesF (Co e) a
     -> Co e a
kept r (Add t k) = bind (changed r (added t)) (\n -> pure (k n))
kept r (Toggle i k) = bind (changed r (toggled i)) (\ok -> pure (k ok))
kept r (Every k) = bind (notesIn r) (\ns -> pure (k ns))

-- (a file of the project's, of a kind: 404 where there is none)
file : {e : HFunctor}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> String
     -> String
     -> Co e HTTP.Response
file path kind =
  recover
    (bind
       (readFile path)
       (\body ->
          pure
            { status = 200
            , headers = [MkPair "Content-Type" kind]
            , body = Bytes.fromString body
            }))
    (\(_ : FileError) ->
       pure (Server.plain 404 ("no " ^ path ^ ": build the client first\n")))

-- (the page, and its script, by their paths)
pageAt : {e : HFunctor}
       -> {{disk : filesystem <: e}}
       -> {{fx : exception FileError <: e}}
       -> String
       -> Co e HTTP.Response
pageAt "/" = file "app/client/index.html" "text/html; charset=utf-8"
pageAt "/client.js" =
  file ".heff/bin/client.js" "text/javascript; charset=utf-8"
pageAt _ = pure (Server.plain 404 "no such page\n")

-- (what is not the API's: the page)
page : {e : HFunctor}
     -> {{disk : filesystem <: e}}
     -> {{fx : exception FileError <: e}}
     -> Server.Request
     -> Co e HTTP.Response
page r = pageAt (RemoteHTTP.pathOf r.target)

-- (a request answered: the API's, or the page)
answered : {e : HFunctor}
         -> {{bc : BOC.boc <: e}}
         -> {{disk : filesystem <: e}}
         -> {{cell : reference (List Note) <: e}}
         -> Reference (List Note)
         -> Server.Request
         -> BocServer.Responder
         -> Co (exception FileError <+> e) Unit
answered r req respond = do
  res <- RemoteHTTP.routed "/api" notesApi (kept r) page req
  respond res

-- (the listener's connections served, as many at once as come, until
-- the program is ended)
listening : {e : HFunctor}
          -> {s : Type}
          -> {{bc : BOC.boc <: e}}
          -> {{io : stdio <: e}}
          -> {{nt : Net.net <: e}}
          -> {{clock : Time.time <: e}}
          -> {{disk : filesystem <: e}}
          -> {{cell : reference (List Note) <: e}}
          -> Reference (List Note)
          -> With s Net.TcpListener
          -> Co e Unit
listening r l = do
  at <- Net.local l
  print
      ("listening on http://127.0.0.1:"
       ^ either (\err -> "?") (\(a : Net.Address) -> debug a.port) at)
  flush
  BocServer.serve FileError l (answered (e := e) r)

-- (a port not listened on, said)
listenedOr : {e : HFunctor}
           -> {{io : stdio <: e}}
           -> Either Net.NetError Unit
           -> Co e Unit
listenedOr (Left err) = printErr ("server: cannot listen: " ^ show err)
listenedOr (Right u) = pure MkUnit

-- (the port the arguments say, 8080 where they say none)
portOf : List String -> Int
portOf (p :: rest) = fromMaybe 8080 (parseInt p)
portOf [] = 8080

-- (a request's throws heard by the server, which closes its connection)
main : Co
       (BOC.boc
        <+> Custodian.custodian
        <+> stdio
        <+> Net.net
        <+> Time.time
        <+> process
        <+> filesystem
        <+> reference (List Note))
       Unit
main = do
  argv <- args
  r <- newReference (Nil : List Note)
  listened <-
    Net.withListener
      { host = "127.0.0.1", port = portOf argv }
      128
      (listening r)
  listenedOr listened
