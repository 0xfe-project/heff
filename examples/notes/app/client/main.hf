-- The notes' page: its script, which `heff build` makes and the page
-- beside it loads, both served by the notes' server.  The notes are the server's: each operation
-- of the API (notes.api) is sent to it, a `POST` of `/api`, and the page
-- goes on with its answer.  A call that comes to no answer throws
-- (`exception RemoteError`): the page says why, and is as it was.

module app.client.main

import browser.dom
import browser.http as HTTP
import browser.remote as RemoteHTTP
import co
import exception
import notes.api
import remote as Remote
import resource

page : HFunctor
page = dom <+> HTTP.http

-- (a note as a line: whether it is done, and its text)
line : Note -> String
line n = (if n.done then "[x] " else "[ ] ") ^ n.text

-- (`c`, where a call of it comes to no answer, said in `status`)
guarded : {e : HFunctor}
        -> {{failed : exception Remote.RemoteError <: e}}
        -> {{ui : dom <: e}}
        -> Element
        -> Co e Unit
        -> Co e Unit
guarded status c =
  recover
    c
    ((\err -> text status (Remote.showRemoteError err)) :
       Remote.RemoteError -> Co e Unit)

-- (the notes, as the server has them, shown: each a line of the list,
-- with a button that toggles it and shows them again)
refresh : {e : HFunctor}
        -> {s : Type}
        -> {{api : notes <: e}}
        -> {{failed : exception Remote.RemoteError <: e}}
        -> {{ui : dom <: e}}
        -> With s Document
        -> Element
        -> Element
        -> Co e Unit
refresh doc list status = do
  ns <- everyNote
  clear list
  for n in ns do
    item <- textIn doc list "li" (line n)
    b <- textIn doc item "button" "toggle"
    let toggle = bind (toggleNote n.id) (\_ -> refresh doc list status)
    on b "click" (\_ -> guarded status toggle)
  text status (show (List.length ns) ^ " notes")

-- (a note of the input's text added, and the notes shown)
adding : {e : HFunctor}
       -> {s : Type}
       -> {{api : notes <: e}}
       -> {{failed : exception Remote.RemoteError <: e}}
       -> {{ui : dom <: e}}
       -> With s Document
       -> Element
       -> Element
       -> Element
       -> Co e Unit
adding doc input list status = do
  t <- value input
  n <- addNote t
  refresh doc list status

-- | The page: an input, a button that adds a note of its text, the
-- | notes, and a line of what happened, in `#notes`.
program : {e : HFunctor}
        -> {{api : notes <: e}}
        -> {{failed : exception Remote.RemoteError <: e}}
        -> {{ui : dom <: e}}
        -> Co e Unit
program = do
  with withDocument as doc do
    box <- select doc "#notes"
    found box (\root -> do
      input <- create doc "input"
      attr input "id" "text"
      append root input
      add <- textIn doc root "button" "add"
      list <- create doc "ul"
      append root list
      status <- textIn doc root "p" ""
      on add "click" (\_ -> guarded status (adding doc input list status))
      guarded status (refresh doc list status))

-- | The page's world handles what is not its own: the notes, sent to the
-- | server at `/api`, and what no `recover` heard of them.
main : Co page Unit
main = do
  r <-
    attempt
      Remote.RemoteError
      (Remote.remotely
         notes
         (exception Remote.RemoteError <+> page)
         (failed := _)
         notesApi
         (RemoteHTTP.posted (web := _) "/api")
         (program
            (api := _)
            (failed := _)
            (ui := \p -> InR (InR (InL p)))))
  pure MkUnit
